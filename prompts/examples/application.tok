tok 1.0 "Application handling"

pool office "Office"
  lane customer "Customer"
    start needed "Application needed"
    task submit "Submit the application"
  lane clerk "Clerk"
    task check "Check the application"
    xor complete "Application complete?"
    task approve "Approve the application"
    task request "Request the missing documents"
    and notify
    task inform "Inform the customer"
    task archive "Archive the application"
    and notified
    end handled "Application handled"
    end returned "Application returned"

flow needed -> submit -> check -> complete
flow complete -> approve "yes"
flow complete -> request "no"
flow approve -> notify
flow notify -> inform
flow notify -> archive
flow inform -> notified
flow archive -> notified
flow notified -> handled
flow request -> returned
