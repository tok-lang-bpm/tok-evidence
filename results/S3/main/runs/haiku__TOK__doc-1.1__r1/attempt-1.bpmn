<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customized bicycle order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Bicycle manufacturer" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customized bicycle order" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>informed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkQty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>itemsDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Order received" />
    <bpmn:exclusiveGateway id="accepted" name="Order accepted?" />
    <bpmn:task id="reject" name="Reject the order" />
    <bpmn:task id="accept" name="Accept the order" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:task id="ship" name="Ship the bicycle to the customer" />
    <bpmn:endEvent id="shipped" name="Process instance finished" />
    <bpmn:parallelGateway id="informed" name="Storehouse and engineering informed" />
    <bpmn:task id="processParts" name="Process the part list of the order" />
    <bpmn:task id="checkQty" name="Check the required quantity of each part" />
    <bpmn:exclusiveGateway id="available" name="Part available in-house?" />
    <bpmn:task id="reserve" name="Reserve the part" />
    <bpmn:task id="backorder" name="Back-order the part" />
    <bpmn:exclusiveGateway id="itemsDone" name="Every item on the part list processed?" />
    <bpmn:parallelGateway id="ready" name="Storehouse and preparation complete" />
    <bpmn:task id="prepare" name="Prepare everything for the assembling" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:sequenceFlow id="f-received-accepted" sourceRef="received" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accepted-accept" name="yes" sourceRef="accepted" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-informed" sourceRef="accept" targetRef="informed" />
    <bpmn:sequenceFlow id="f-informed-processParts" sourceRef="informed" targetRef="processParts" />
    <bpmn:sequenceFlow id="f-processParts-checkQty" sourceRef="processParts" targetRef="checkQty" />
    <bpmn:sequenceFlow id="f-checkQty-available" sourceRef="checkQty" targetRef="available" />
    <bpmn:sequenceFlow id="f-available-reserve" name="yes" sourceRef="available" targetRef="reserve" />
    <bpmn:sequenceFlow id="f-available-backorder" name="no" sourceRef="available" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-reserve-itemsDone" sourceRef="reserve" targetRef="itemsDone" />
    <bpmn:sequenceFlow id="f-backorder-itemsDone" sourceRef="backorder" targetRef="itemsDone" />
    <bpmn:sequenceFlow id="f-itemsDone-checkQty" name="no" sourceRef="itemsDone" targetRef="checkQty" />
    <bpmn:sequenceFlow id="f-itemsDone-ready" name="yes" sourceRef="itemsDone" targetRef="ready" />
    <bpmn:sequenceFlow id="f-informed-prepare" sourceRef="informed" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-ready" sourceRef="prepare" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-assemble" sourceRef="ready" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-shipped" sourceRef="ship" targetRef="shipped" />
  </bpmn:process>
</bpmn:definitions>
