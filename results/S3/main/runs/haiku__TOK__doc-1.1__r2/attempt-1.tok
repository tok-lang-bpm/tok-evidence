tok 1.0 "Customized bicycle order"

pool company "Bicycle manufacturer"
  lane sales "Sales department"
    start received "Order received"
    task decide "Accept or reject the order for the customized bike"
    xor accepted "Order accepted?"
    end rejected "Order rejected"
    task inform "Inform the storehouse and the engineering department"
    and fork
    task ship "Ship the bicycle to the customer"
    end shipped "Bicycle shipped"
  lane storehouse "Storehouse"
    task partlist "Process the part list of the order"
    task check "Check the required quantity of the part"
    xor available "Part available in-house?"
    task reserve "Reserve the part"
    task backorder "Back-order the part"
    xor merged
    xor more "More items on the part list?"
  lane engineering "Engineering department"
    task prepare "Prepare everything for the assembling of the bicycle"
    and ready
    task assemble "Assemble the bicycle"

flow received -> decide -> accepted
flow accepted -> rejected "no"
flow accepted -> inform "yes"
flow inform -> fork
flow fork -> partlist
flow fork -> prepare
flow partlist -> check -> available
flow available -> reserve "yes"
flow available -> backorder "no"
flow reserve -> merged
flow backorder -> merged
flow merged -> more
flow more -> check "yes"
flow more -> ready "no"
flow prepare -> ready
flow ready -> assemble -> ship -> shipped
