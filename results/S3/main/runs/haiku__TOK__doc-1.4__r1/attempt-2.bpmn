<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public with underwriters" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Going public with underwriters" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="management" name="Management">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkstates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>abandoned</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decide" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="checkstates" name="Check compliance with the blue-sky laws of each state" />
    <bpmn:task id="roadshow" name="Arrange a road show for potential investors" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:exclusiveGateway id="clearance" name="SEC clearance received?" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:task id="buy" name="Enter into a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to offer found?" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="offered" name="Stock offered to the public" />
    <bpmn:endEvent id="abandoned" name="Offering abandoned" />
    <bpmn:sequenceFlow id="f-decide-select" sourceRef="decide" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-advise" sourceRef="select" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-prepare" sourceRef="advise" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-register" sourceRef="prepare" targetRef="register" />
    <bpmn:sequenceFlow id="f-prepare-checkstates" sourceRef="prepare" targetRef="checkstates" />
    <bpmn:sequenceFlow id="f-register-roadshow" sourceRef="register" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-checkstates-roadshow" sourceRef="checkstates" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-roadshow-firm" sourceRef="roadshow" targetRef="firm" />
    <bpmn:sequenceFlow id="f-firm-clearance" sourceRef="firm" targetRef="clearance" />
    <bpmn:sequenceFlow id="f-clearance-fix" name="yes" sourceRef="clearance" targetRef="fix" />
    <bpmn:sequenceFlow id="f-clearance-firm" name="no" sourceRef="clearance" targetRef="firm" />
    <bpmn:sequenceFlow id="f-fix-buy" sourceRef="fix" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-reason" sourceRef="buy" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-abandoned" name="yes" sourceRef="reason" targetRef="abandoned" />
    <bpmn:sequenceFlow id="f-reason-offer" name="no" sourceRef="reason" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-offered" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
