<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Going public" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="management" name="Company management">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bluesky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decide" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="bluesky" name="Check compliance with blue-sky laws" />
    <bpmn:task id="price" name="Firm up the issue price" />
    <bpmn:task id="roadshow" name="Arrange a road show for potential investors" />
    <bpmn:parallelGateway id="joined1" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:task id="commit" name="Enter a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to offer found?" />
    <bpmn:task id="withdraw" name="Withdraw the offering" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="withdrawn" name="Offering withdrawn" />
    <bpmn:endEvent id="offered" name="Stock offered to the public" />
    <bpmn:task id="approve" name="Approve the registration statement" />
    <bpmn:sequenceFlow id="f-decide-select" sourceRef="decide" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-advise" sourceRef="select" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-prepare" sourceRef="advise" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-split1" sourceRef="prepare" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-register" sourceRef="split1" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-approve" sourceRef="register" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-joined1" sourceRef="approve" targetRef="joined1" />
    <bpmn:sequenceFlow id="f-split1-bluesky" sourceRef="split1" targetRef="bluesky" />
    <bpmn:sequenceFlow id="f-bluesky-joined1" sourceRef="bluesky" targetRef="joined1" />
    <bpmn:sequenceFlow id="f-split1-price" sourceRef="split1" targetRef="price" />
    <bpmn:sequenceFlow id="f-price-joined1" sourceRef="price" targetRef="joined1" />
    <bpmn:sequenceFlow id="f-split1-roadshow" sourceRef="split1" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-roadshow-joined1" sourceRef="roadshow" targetRef="joined1" />
    <bpmn:sequenceFlow id="f-joined1-fix" sourceRef="joined1" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-commit" sourceRef="fix" targetRef="commit" />
    <bpmn:sequenceFlow id="f-commit-reason" sourceRef="commit" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-withdraw" name="yes" sourceRef="reason" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-reason-offer" name="no" sourceRef="reason" targetRef="offer" />
    <bpmn:sequenceFlow id="f-withdraw-withdrawn" sourceRef="withdraw" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f-offer-offered" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
