tok 1.0 "Fault handling"

pool mpo "Measuring organisation"
  lane detector "Fault detector"
    start failure "Failure occurs"
    task report "Report the failure to the MPO"
  lane mpo "MPO"
    start suspicion "MPO suspects own fault"
    xor gathered
    task examine "Examine the failure"
    xor confirmed "Failure confirmed?"
    end rejected "Failure rejected"
    task informstart "Inform the GO and the MSP of the confirmed failure"
    task fix "Fix the fault at the measuring device"
    task share "Share the results of the repairs with the fault detector"
    and resolve
    task informgo "Inform the GO about the resolution of the interference"
    task informmsp "Inform the MSP about the resolution of the interference"
    and resolved
    end done "Interference resolved"

flow failure -> report -> gathered
flow suspicion -> gathered
flow gathered -> examine -> confirmed
flow confirmed -> rejected "rejected" default
flow confirmed -> informstart "confirmed"
flow informstart -> fix -> share -> resolve
flow resolve -> informgo -> resolved
flow resolve -> informmsp -> resolved
flow resolved -> done
