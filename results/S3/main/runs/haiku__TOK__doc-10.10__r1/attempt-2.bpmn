<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Fault handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="mpo" name="Measuring organisation" processRef="mpo-process" />
  </bpmn:collaboration>
  <bpmn:process id="mpo-process" name="Fault handling" isExecutable="false">
    <bpmn:laneSet id="mpo-lanes">
      <bpmn:lane id="detector" name="Fault detector">
        <bpmn:flowNodeRef>failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoteam" name="MPO">
        <bpmn:flowNodeRef>suspicion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gathered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="failure" name="Failure occurs" />
    <bpmn:task id="report" name="Report the failure to the MPO" />
    <bpmn:startEvent id="suspicion" name="MPO suspects own fault" />
    <bpmn:exclusiveGateway id="gathered" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="confirmed" name="Failure confirmed?" default="f-confirmed-rejected" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:task id="informstart" name="Inform the GO and the MSP of the confirmed failure" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="share" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="resolve" />
    <bpmn:task id="informgo" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="informmsp" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="resolved" />
    <bpmn:endEvent id="done" name="Interference resolved" />
    <bpmn:sequenceFlow id="f-failure-report" sourceRef="failure" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-gathered" sourceRef="report" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-suspicion-gathered" sourceRef="suspicion" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-gathered-examine" sourceRef="gathered" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-confirmed" sourceRef="examine" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-rejected" name="rejected" sourceRef="confirmed" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirmed-informstart" name="confirmed" sourceRef="confirmed" targetRef="informstart" />
    <bpmn:sequenceFlow id="f-informstart-fix" sourceRef="informstart" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-resolve" sourceRef="share" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-informgo" sourceRef="resolve" targetRef="informgo" />
    <bpmn:sequenceFlow id="f-informgo-resolved" sourceRef="informgo" targetRef="resolved" />
    <bpmn:sequenceFlow id="f-resolve-informmsp" sourceRef="resolve" targetRef="informmsp" />
    <bpmn:sequenceFlow id="f-informmsp-resolved" sourceRef="informmsp" targetRef="resolved" />
    <bpmn:sequenceFlow id="f-resolved-done" sourceRef="resolved" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
