<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Interference handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Interference handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="detector" name="Fault detector">
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>suspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repairs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="detected" name="Failure reported" />
    <bpmn:task id="report" name="Report the failure to the MPO" />
    <bpmn:startEvent id="suspect" name="Own fault suspected" />
    <bpmn:exclusiveGateway id="failure" name="Failure to examine" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="verdict" name="Failure confirmed?" />
    <bpmn:task id="reject" name="Reject the failure of the fault detector" />
    <bpmn:task id="confirm" name="Confirm the failure of the fault detector" />
    <bpmn:task id="informstart" name="Inform the GO and the MSP about the failure" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:parallelGateway id="repairs" name="Repairs carried out" />
    <bpmn:task id="share" name="Share the results of the repairs with the fault detector" />
    <bpmn:task id="informgo" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="informmsp" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="resolved" name="Interference resolved" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:endEvent id="done" name="Interference resolved" />
    <bpmn:sequenceFlow id="f-detected-report" sourceRef="detected" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-failure" sourceRef="report" targetRef="failure" />
    <bpmn:sequenceFlow id="f-suspect-failure" sourceRef="suspect" targetRef="failure" />
    <bpmn:sequenceFlow id="f-failure-examine" sourceRef="failure" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-verdict" sourceRef="examine" targetRef="verdict" />
    <bpmn:sequenceFlow id="f-verdict-reject" name="rejects" sourceRef="verdict" targetRef="reject" />
    <bpmn:sequenceFlow id="f-verdict-confirm" name="confirms" sourceRef="verdict" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-informstart" sourceRef="confirm" targetRef="informstart" />
    <bpmn:sequenceFlow id="f-informstart-fix" sourceRef="informstart" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-repairs" sourceRef="fix" targetRef="repairs" />
    <bpmn:sequenceFlow id="f-repairs-share" sourceRef="repairs" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-resolved" sourceRef="share" targetRef="resolved" />
    <bpmn:sequenceFlow id="f-repairs-informgo" sourceRef="repairs" targetRef="informgo" />
    <bpmn:sequenceFlow id="f-informgo-resolved" sourceRef="informgo" targetRef="resolved" />
    <bpmn:sequenceFlow id="f-repairs-informmsp" sourceRef="repairs" targetRef="informmsp" />
    <bpmn:sequenceFlow id="f-informmsp-resolved" sourceRef="informmsp" targetRef="resolved" />
    <bpmn:sequenceFlow id="f-resolved-done" sourceRef="resolved" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
