<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measurement request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reading</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failinform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Measurements needed" />
    <bpmn:task id="request" name="Request the measurements" />
    <bpmn:task id="process" name="Process the measured values" />
    <bpmn:task id="changed" name="Send the changed values to the MSP" />
    <bpmn:task id="readings" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="done" name="Readings transmitted" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="accepted" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny the request of the GO" />
    <bpmn:endEvent id="denied" name="Request denied" />
    <bpmn:task id="measure" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="reading" name="Reading successful?" />
    <bpmn:task id="failinform" name="Inform the GO about the failure of the reading" />
    <bpmn:endEvent id="failed" name="Reading failed" />
    <bpmn:task id="transmit" name="Transmit the measured values to the GO" />
    <bpmn:sequenceFlow id="f-needed-request" sourceRef="needed" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-check" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-accepted" sourceRef="check" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-measure" name="yes" sourceRef="accepted" targetRef="measure" />
    <bpmn:sequenceFlow id="f-accepted-deny" name="no" sourceRef="accepted" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-denied" sourceRef="deny" targetRef="denied" />
    <bpmn:sequenceFlow id="f-measure-reading" sourceRef="measure" targetRef="reading" />
    <bpmn:sequenceFlow id="f-reading-transmit" name="yes" sourceRef="reading" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-reading-failinform" name="no" sourceRef="reading" targetRef="failinform" />
    <bpmn:sequenceFlow id="f-failinform-failed" sourceRef="failinform" targetRef="failed" />
    <bpmn:sequenceFlow id="f-transmit-process" sourceRef="transmit" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-changed" sourceRef="process" targetRef="changed" />
    <bpmn:sequenceFlow id="f-changed-readings" sourceRef="changed" targetRef="readings" />
    <bpmn:sequenceFlow id="f-readings-done" sourceRef="readings" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
