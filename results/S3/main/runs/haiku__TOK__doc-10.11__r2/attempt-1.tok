tok 1.0 "Measurement request"

pool org "Organisation"
  lane go "GO"
    start needed "Measurements needed"
    task request "Request the measurements"
    task process "Process the measured values"
    task changed "Send the changed values to the MSP"
    task readings "Transmit the readings to the SP"
    end done "Readings transmitted"
  lane msp "MSP"
    task check "Check the received request"
    xor accepted "Request accepted?"
    task deny "Deny the request of the GO"
    end denied "Request denied"
    task measure "Perform the measurement"
    xor reading "Reading successful?"
    task failinform "Inform the GO about the failure of the reading"
    end failed "Reading failed"
    task transmit "Transmit the measured values to the GO"

flow needed -> request -> check -> accepted
flow accepted -> measure "yes"
flow accepted -> deny "no"
flow deny -> denied
flow measure -> reading
flow reading -> transmit "yes"
flow reading -> failinform "no"
flow failinform -> failed
flow transmit -> process -> changed -> readings -> done
