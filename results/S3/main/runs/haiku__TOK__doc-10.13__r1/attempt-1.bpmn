<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Transaction data request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Transaction data request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Transaction data request needed" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request of the INQ" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome of the examination?" />
    <bpmn:task id="transmitData" name="Answer the question of the INQ by transmitting the data" />
    <bpmn:task id="reject" name="Answer the question of the INQ by rejecting the request" />
    <bpmn:endEvent id="answered" name="Data transmitted" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f-requested-transmit" sourceRef="requested" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-check" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-outcome" sourceRef="check" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-transmitData" name="data" sourceRef="outcome" targetRef="transmitData" />
    <bpmn:sequenceFlow id="f-outcome-reject" name="rejection" sourceRef="outcome" targetRef="reject" />
    <bpmn:sequenceFlow id="f-transmitData-answered" sourceRef="transmitData" targetRef="answered" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
