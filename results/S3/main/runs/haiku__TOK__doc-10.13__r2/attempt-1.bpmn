<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Transaction data request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Transaction data request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answerData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answerReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Transaction data request needed" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request of the INQ" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome of the examination?" />
    <bpmn:task id="answerData" name="Answer the question with transmission of data" />
    <bpmn:task id="answerReject" name="Answer the question with rejection" />
    <bpmn:endEvent id="sent" name="Data transmitted" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f-requested-transmit" sourceRef="requested" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-check" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-outcome" sourceRef="check" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-answerData" name="data transmission" sourceRef="outcome" targetRef="answerData" />
    <bpmn:sequenceFlow id="f-outcome-answerReject" name="rejection" sourceRef="outcome" targetRef="answerReject" />
    <bpmn:sequenceFlow id="f-answerData-sent" sourceRef="answerData" targetRef="sent" />
    <bpmn:sequenceFlow id="f-answerReject-rejected" sourceRef="answerReject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
