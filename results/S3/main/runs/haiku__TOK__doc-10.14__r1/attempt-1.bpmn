<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice handling for metering point operations" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="market" name="Organisation" processRef="market-process" />
  </bpmn:collaboration>
  <bpmn:process id="market-process" name="Invoice handling for metering point operations" isExecutable="false">
    <bpmn:laneSet id="market-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>which</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_mpoo_temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_mpoo_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>send_mspo_temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_mspo_read</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>exam_temp_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_temp_ms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_go_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>exam_mpon_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_mpon</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Billing started" />
    <bpmn:exclusiveGateway id="which" name="Which bill is sent?" />
    <bpmn:task id="send_mpoo_temp" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="send_mpoo_equip" name="Send the bill for the equipment acquisition" />
    <bpmn:exclusiveGateway id="equip_split" name="Examined by MPON or GO?" />
    <bpmn:task id="send_mspo_temp" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="send_mspo_read" name="Send the bill for additional readings" />
    <bpmn:task id="exam_temp_mpo" name="Examine the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="exam_temp_ms" name="Examine the bill for the temporary continuation of the measurement" />
    <bpmn:task id="exam_read" name="Examine the bill for additional readings" />
    <bpmn:task id="exam_go_equip" name="Examine the bill for the equipment acquisition" />
    <bpmn:exclusiveGateway id="examined" name="Bill examined" />
    <bpmn:exclusiveGateway id="decide" name="Invoice confirmed or rejected?" />
    <bpmn:task id="confirm_go" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject_go" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:endEvent id="ok_end" name="Invoice confirmed" />
    <bpmn:endEvent id="rej_end" name="Invoice rejected" />
    <bpmn:task id="exam_mpon_equip" name="Examine the bill for the equipment acquisition" />
    <bpmn:task id="confirm_mpon" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject_mpon" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:sequenceFlow id="f-begin-which" sourceRef="begin" targetRef="which" />
    <bpmn:sequenceFlow id="f-which-send_mpoo_temp" name="temporary continuation of the metering point operations" sourceRef="which" targetRef="send_mpoo_temp" />
    <bpmn:sequenceFlow id="f-which-send_mspo_temp" name="temporary continuation of the measurement" sourceRef="which" targetRef="send_mspo_temp" />
    <bpmn:sequenceFlow id="f-which-send_mspo_read" name="additional readings" sourceRef="which" targetRef="send_mspo_read" />
    <bpmn:sequenceFlow id="f-which-send_mpoo_equip" name="equipment acquisition" sourceRef="which" targetRef="send_mpoo_equip" />
    <bpmn:sequenceFlow id="f-send_mpoo_temp-exam_temp_mpo" sourceRef="send_mpoo_temp" targetRef="exam_temp_mpo" />
    <bpmn:sequenceFlow id="f-exam_temp_mpo-examined" sourceRef="exam_temp_mpo" targetRef="examined" />
    <bpmn:sequenceFlow id="f-send_mspo_temp-exam_temp_ms" sourceRef="send_mspo_temp" targetRef="exam_temp_ms" />
    <bpmn:sequenceFlow id="f-exam_temp_ms-examined" sourceRef="exam_temp_ms" targetRef="examined" />
    <bpmn:sequenceFlow id="f-send_mspo_read-exam_read" sourceRef="send_mspo_read" targetRef="exam_read" />
    <bpmn:sequenceFlow id="f-exam_read-examined" sourceRef="exam_read" targetRef="examined" />
    <bpmn:sequenceFlow id="f-send_mpoo_equip-equip_split" sourceRef="send_mpoo_equip" targetRef="equip_split" />
    <bpmn:sequenceFlow id="f-equip_split-exam_mpon_equip" sourceRef="equip_split" targetRef="exam_mpon_equip" />
    <bpmn:sequenceFlow id="f-exam_mpon_equip-examined" sourceRef="exam_mpon_equip" targetRef="examined" />
    <bpmn:sequenceFlow id="f-equip_split-exam_go_equip" sourceRef="equip_split" targetRef="exam_go_equip" />
    <bpmn:sequenceFlow id="f-exam_go_equip-examined" sourceRef="exam_go_equip" targetRef="examined" />
    <bpmn:sequenceFlow id="f-examined-decide" sourceRef="examined" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-confirm_go" name="confirmed by GO" sourceRef="decide" targetRef="confirm_go" />
    <bpmn:sequenceFlow id="f-decide-confirm_mpon" name="confirmed by MPON" sourceRef="decide" targetRef="confirm_mpon" />
    <bpmn:sequenceFlow id="f-decide-reject_go" name="rejected by GO" sourceRef="decide" targetRef="reject_go" />
    <bpmn:sequenceFlow id="f-decide-reject_mpon" name="rejected by MPON" sourceRef="decide" targetRef="reject_mpon" />
    <bpmn:sequenceFlow id="f-confirm_go-ok_end" sourceRef="confirm_go" targetRef="ok_end" />
    <bpmn:sequenceFlow id="f-confirm_mpon-ok_end" sourceRef="confirm_mpon" targetRef="ok_end" />
    <bpmn:sequenceFlow id="f-reject_go-rej_end" sourceRef="reject_go" targetRef="rej_end" />
    <bpmn:sequenceFlow id="f-reject_mpon-rej_end" sourceRef="reject_mpon" targetRef="rej_end" />
  </bpmn:process>
</bpmn:definitions>
