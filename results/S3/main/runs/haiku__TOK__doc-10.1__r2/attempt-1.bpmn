<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Dismissal needed" />
    <bpmn:task id="send" name="Send the dismissal to the MPOO" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decide" name="Dismissal opposed or confirmed?" />
    <bpmn:task id="oppose" name="Oppose the dismissal" />
    <bpmn:task id="confirm" name="Confirm the dismissal" />
    <bpmn:endEvent id="opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-needed-send" sourceRef="needed" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-oppose" name="opposed" sourceRef="decide" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="confirmed" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-oppose-opposed" sourceRef="oppose" targetRef="opposed" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
