<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Meter operation registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Failure_of_the_entire_process" name="Failure of the entire process" />
  <bpmn:message id="Message_Successful_completion_of_the_entire_process" name="Successful completion of the entire process" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Meter operation registration" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meter operation registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eqsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eqjoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOO1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPO1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>succrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failtx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOOf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPOf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOOa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPOa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Meter operation to report" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:inclusiveGateway id="eqsplit" name="Equipment acquisition and/or changes?" default="f-eqsplit-acquire" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:inclusiveGateway id="eqjoin" name="Equipment work done" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="review" name="Application confirmed?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:task id="informMPOO1" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="informMSPO1" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:eventBasedGateway id="wait" name="Report received before the deadline?" />
    <bpmn:intermediateCatchEvent id="failrep" name="MPON informs the GO about the failure of the entire process">
      <bpmn:messageEventDefinition id="failrep-def" messageRef="Message_Failure_of_the_entire_process" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="succrep" name="MPON informs the GO about the successful completion of the entire process">
      <bpmn:messageEventDefinition id="succrep-def" messageRef="Message_Successful_completion_of_the_entire_process" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="Maximum time limit exceeded">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="failtx" name="Inform the MPON about the failure of the overall transaction" />
    <bpmn:task id="confirmfail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="informMPOOf" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="informMSPOf" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confirmassign" name="Confirm the assignment to the MPON" />
    <bpmn:task id="informMPOOa" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="informMSPOa" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="informSP" name="Inform the SP about the assignment of the MPON" />
    <bpmn:endEvent id="endRej" name="Application rejected" />
    <bpmn:endEvent id="endFail" name="Registration failed" />
    <bpmn:endEvent id="endTimeout" name="Overall transaction failed by deadline" />
    <bpmn:endEvent id="endOk" name="Registration assigned" />
    <bpmn:task id="changes" name="Perform the equipment changes" />
    <bpmn:sequenceFlow id="f-needed-report" sourceRef="needed" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-examine" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-review" sourceRef="examine" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-reject" name="nie" sourceRef="review" targetRef="reject" />
    <bpmn:sequenceFlow id="f-review-confirm" name="tak" sourceRef="review" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-endRej" sourceRef="reject" targetRef="endRej" />
    <bpmn:sequenceFlow id="f-confirm-informMPOO1" sourceRef="confirm" targetRef="informMPOO1" />
    <bpmn:sequenceFlow id="f-informMPOO1-informMSPO1" sourceRef="informMPOO1" targetRef="informMSPO1" />
    <bpmn:sequenceFlow id="f-informMSPO1-eqsplit" sourceRef="informMSPO1" targetRef="eqsplit" />
    <bpmn:sequenceFlow id="f-eqsplit-acquire" name="akwizycja" sourceRef="eqsplit" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-eqsplit-changes" name="zmiany" sourceRef="eqsplit" targetRef="changes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">zmiany_wymagane = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-acquire-eqjoin" sourceRef="acquire" targetRef="eqjoin" />
    <bpmn:sequenceFlow id="f-changes-eqjoin" sourceRef="changes" targetRef="eqjoin" />
    <bpmn:sequenceFlow id="f-eqjoin-wait" sourceRef="eqjoin" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-failrep" sourceRef="wait" targetRef="failrep" />
    <bpmn:sequenceFlow id="f-wait-succrep" sourceRef="wait" targetRef="succrep" />
    <bpmn:sequenceFlow id="f-wait-timeout" sourceRef="wait" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-failrep-confirmfail" sourceRef="failrep" targetRef="confirmfail" />
    <bpmn:sequenceFlow id="f-confirmfail-informMPOOf" sourceRef="confirmfail" targetRef="informMPOOf" />
    <bpmn:sequenceFlow id="f-informMPOOf-informMSPOf" sourceRef="informMPOOf" targetRef="informMSPOf" />
    <bpmn:sequenceFlow id="f-informMSPOf-endFail" sourceRef="informMSPOf" targetRef="endFail" />
    <bpmn:sequenceFlow id="f-timeout-failtx" sourceRef="timeout" targetRef="failtx" />
    <bpmn:sequenceFlow id="f-failtx-endTimeout" sourceRef="failtx" targetRef="endTimeout" />
    <bpmn:sequenceFlow id="f-succrep-assign" sourceRef="succrep" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-confirmassign" sourceRef="assign" targetRef="confirmassign" />
    <bpmn:sequenceFlow id="f-confirmassign-informMPOOa" sourceRef="confirmassign" targetRef="informMPOOa" />
    <bpmn:sequenceFlow id="f-informMPOOa-informMSPOa" sourceRef="informMPOOa" targetRef="informMSPOa" />
    <bpmn:sequenceFlow id="f-informMSPOa-informSP" sourceRef="informMSPOa" targetRef="informSP" />
    <bpmn:sequenceFlow id="f-informSP-endOk" sourceRef="informSP" targetRef="endOk" />
  </bpmn:process>
</bpmn:definitions>
