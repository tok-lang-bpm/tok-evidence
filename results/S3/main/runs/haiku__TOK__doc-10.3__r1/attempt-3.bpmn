<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Deregistration of the MPOO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="goorg" name="GO" processRef="goorg-process" />
  </bpmn:collaboration>
  <bpmn:process id="goorg-process" name="Deregistration of the MPOO" isExecutable="false">
    <bpmn:laneSet id="goorg-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmcont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preconfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eqsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eqjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Deregistration requested" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="confirmcont" name="Confirm the continuation" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="valid" name="Deregistration valid?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:task id="preconfirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige" name="Oblige the MPOO to continue the operations?" />
    <bpmn:task id="bind" name="Bind the MPOO to continue the operation" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:inclusiveGateway id="eqsplit" name="Equipment acquisition and/or changes?" default="f-eqsplit-eqjoin" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:task id="change" name="Perform the equipment changes" />
    <bpmn:inclusiveGateway id="eqjoin" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="informmpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="informmspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informsp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="done" name="Deregistration completed" />
    <bpmn:sequenceFlow id="f-requested-deregister" sourceRef="requested" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-valid" sourceRef="verify" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-reject" name="no" sourceRef="valid" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-valid-preconfirm" name="yes" sourceRef="valid" targetRef="preconfirm" />
    <bpmn:sequenceFlow id="f-preconfirm-prepare" sourceRef="preconfirm" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige" sourceRef="prepare" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige-bind" name="yes" sourceRef="oblige" targetRef="bind" />
    <bpmn:sequenceFlow id="f-bind-confirmcont" sourceRef="bind" targetRef="confirmcont" />
    <bpmn:sequenceFlow id="f-confirmcont-merged" sourceRef="confirmcont" targetRef="merged" />
    <bpmn:sequenceFlow id="f-oblige-merged" name="no" sourceRef="oblige" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-eqsplit" sourceRef="merged" targetRef="eqsplit" />
    <bpmn:sequenceFlow id="f-eqsplit-acquire" name="acquisition" sourceRef="eqsplit" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-eqsplit-change" name="changes" sourceRef="eqsplit" targetRef="change" />
    <bpmn:sequenceFlow id="f-eqsplit-eqjoin" name="neither" sourceRef="eqsplit" targetRef="eqjoin" />
    <bpmn:sequenceFlow id="f-acquire-eqjoin" sourceRef="acquire" targetRef="eqjoin" />
    <bpmn:sequenceFlow id="f-change-eqjoin" sourceRef="change" targetRef="eqjoin" />
    <bpmn:sequenceFlow id="f-eqjoin-assign" sourceRef="eqjoin" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-informmpoo" sourceRef="assign" targetRef="informmpoo" />
    <bpmn:sequenceFlow id="f-informmpoo-informmspo" sourceRef="informmpoo" targetRef="informmspo" />
    <bpmn:sequenceFlow id="f-informmspo-informsp" sourceRef="informmspo" targetRef="informsp" />
    <bpmn:sequenceFlow id="f-informsp-done" sourceRef="informsp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
