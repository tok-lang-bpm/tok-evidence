tok 1.0 "Deregistration of the MPOO"

pool goorg "GO"
  lane mpoo "MPOO"
    start requested "Deregistration requested"
    task deregister "Deregister at the GO"
    task confirmcont "Confirm the continuation"
  lane go "GO"
    task verify "Verify the deregistration"
    xor valid "Deregistration valid?"
    task reject "Reject the deregistration of the MPOO"
    end rejected "Deregistration rejected"
    task preconfirm "Preliminarily confirm the deregistration of the MPOO"
    task prepare "Prepare the readmission of the measuring point"
    xor oblige "Oblige the MPOO to continue the operations?"
    task bind "Bind the MPOO to continue the operation"
    xor merged
    or eqsplit "Equipment acquisition and/or changes?"
    task acquire "Perform the equipment acquisition"
    task change "Perform the equipment changes"
    or eqjoin
    task assign "Assign the GO as MPO"
    task informmpoo "Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO"
    task informmspo "Inform the MSPO about the assignment of the GO"
    task informsp "Inform the SP about the assignment of the GO"
    end done "Deregistration completed"

flow requested -> deregister -> verify -> valid
flow valid -> reject "no"
flow reject -> rejected
flow valid -> preconfirm "yes"
flow preconfirm -> prepare -> oblige
flow oblige -> bind "yes"
flow bind -> confirmcont -> merged
flow oblige -> merged "no"
flow merged -> eqsplit
flow eqsplit -> acquire "acquisition" when="acquisition"
flow eqsplit -> change "changes" when="changes"
flow eqsplit -> eqjoin "neither" default
flow acquire -> eqjoin
flow change -> eqjoin
flow eqjoin -> assign -> informmpoo -> informmspo -> informsp -> done
