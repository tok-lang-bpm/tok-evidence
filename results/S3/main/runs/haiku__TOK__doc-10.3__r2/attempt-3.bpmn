<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Deregistration of the measuring point" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="go" name="GO" processRef="go-process" />
  </bpmn:collaboration>
  <bpmn:process id="go-process" name="Deregistration of the measuring point" isExecutable="false">
    <bpmn:laneSet id="go-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_cont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go_op" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_obl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Deregistration needed" />
    <bpmn:task id="deregister" name="Deregister the measuring point at the GO" />
    <bpmn:task id="confirm_cont" name="Confirm the continuation to the MPOO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="accepted" name="Deregistration accepted?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:task id="prelim" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige_q" name="Oblige the MPOO to continue the operations?" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="merge_obl" />
    <bpmn:inclusiveGateway id="equip_q" name="Equipment acquisition and/or equipment changes?" default="f-equip_q-equip_join" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:task id="change" name="Perform the equipment changes" />
    <bpmn:inclusiveGateway id="equip_join" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="done" name="Assignment of the GO completed" />
    <bpmn:sequenceFlow id="f-needed-deregister" sourceRef="needed" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-accepted" sourceRef="verify" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accepted-prelim" name="yes" sourceRef="accepted" targetRef="prelim" />
    <bpmn:sequenceFlow id="f-prelim-prepare" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige_q" sourceRef="prepare" targetRef="oblige_q" />
    <bpmn:sequenceFlow id="f-oblige_q-oblige" name="yes" sourceRef="oblige_q" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige_q-merge_obl" name="no" sourceRef="oblige_q" targetRef="merge_obl" />
    <bpmn:sequenceFlow id="f-oblige-confirm_cont" sourceRef="oblige" targetRef="confirm_cont" />
    <bpmn:sequenceFlow id="f-confirm_cont-merge_obl" sourceRef="confirm_cont" targetRef="merge_obl" />
    <bpmn:sequenceFlow id="f-merge_obl-equip_q" sourceRef="merge_obl" targetRef="equip_q" />
    <bpmn:sequenceFlow id="f-equip_q-acquire" name="acquisition" sourceRef="equip_q" targetRef="acquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">acquisition_needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equip_q-change" name="changes" sourceRef="equip_q" targetRef="change">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">changes_needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equip_q-equip_join" name="none" sourceRef="equip_q" targetRef="equip_join" />
    <bpmn:sequenceFlow id="f-acquire-equip_join" sourceRef="acquire" targetRef="equip_join" />
    <bpmn:sequenceFlow id="f-change-equip_join" sourceRef="change" targetRef="equip_join" />
    <bpmn:sequenceFlow id="f-equip_join-assign" sourceRef="equip_join" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mpoo" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f-inform_mpoo-inform_mspo" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-inform_mspo-inform_sp" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-done" sourceRef="inform_sp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
