<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>intention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readMpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountMpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readInstalled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellGo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>splitSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountMpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>notifyMsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="intention" name="Equipment change intention" />
    <bpmn:task id="notifyMpoo" name="Notify the MPOO about equipment change intentions" />
    <bpmn:task id="readMpon" name="Perform the final reading" />
    <bpmn:task id="dismountMpon" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="readInstalled" name="Read the meter count from the installed meter" />
    <bpmn:task id="sendFinal" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tellGo" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="splitSelf" name="Self-dismounting announced?" />
    <bpmn:task id="announce" name="Announce self dismounting to the MPON" />
    <bpmn:task id="noSelf" name="Notify the MPON about no self-dismounting" />
    <bpmn:task id="readMpoo" name="Perform the final reading" />
    <bpmn:task id="dismountMpoo" name="Dismount the old equipment" />
    <bpmn:task id="notifyMsp" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="done" name="Equipment change recorded" />
    <bpmn:sequenceFlow id="f-intention-notifyMpoo" sourceRef="intention" targetRef="notifyMpoo" />
    <bpmn:sequenceFlow id="f-notifyMpoo-splitSelf" sourceRef="notifyMpoo" targetRef="splitSelf" />
    <bpmn:sequenceFlow id="f-splitSelf-announce" name="yes" sourceRef="splitSelf" targetRef="announce" />
    <bpmn:sequenceFlow id="f-announce-readMpoo" sourceRef="announce" targetRef="readMpoo" />
    <bpmn:sequenceFlow id="f-readMpoo-dismountMpoo" sourceRef="readMpoo" targetRef="dismountMpoo" />
    <bpmn:sequenceFlow id="f-dismountMpoo-merged" sourceRef="dismountMpoo" targetRef="merged" />
    <bpmn:sequenceFlow id="f-splitSelf-noSelf" name="no" sourceRef="splitSelf" targetRef="noSelf" />
    <bpmn:sequenceFlow id="f-noSelf-readMpon" sourceRef="noSelf" targetRef="readMpon" />
    <bpmn:sequenceFlow id="f-readMpon-dismountMpon" sourceRef="readMpon" targetRef="dismountMpon" />
    <bpmn:sequenceFlow id="f-dismountMpon-merged" sourceRef="dismountMpon" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-mount" sourceRef="merged" targetRef="mount" />
    <bpmn:sequenceFlow id="f-mount-readInstalled" sourceRef="mount" targetRef="readInstalled" />
    <bpmn:sequenceFlow id="f-readInstalled-sendFinal" sourceRef="readInstalled" targetRef="sendFinal" />
    <bpmn:sequenceFlow id="f-sendFinal-tellGo" sourceRef="sendFinal" targetRef="tellGo" />
    <bpmn:sequenceFlow id="f-tellGo-notifyMsp" sourceRef="tellGo" targetRef="notifyMsp" />
    <bpmn:sequenceFlow id="f-notifyMsp-done" sourceRef="notifyMsp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
