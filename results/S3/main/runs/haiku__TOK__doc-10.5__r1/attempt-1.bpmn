<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Device takeover bid" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Device takeover bid" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Bid needed" />
    <bpmn:task id="request" name="Request the device takeover bid" />
    <bpmn:task id="order" name="Place the order" />
    <bpmn:task id="tender" name="Send the tender for the equipment takeover" />
    <bpmn:task id="confirm" name="Confirm the order" />
    <bpmn:task id="master" name="Send the master data" />
    <bpmn:endEvent id="done" name="Order confirmed" />
    <bpmn:sequenceFlow id="f-begin-request" sourceRef="begin" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-tender" sourceRef="request" targetRef="tender" />
    <bpmn:sequenceFlow id="f-tender-order" sourceRef="tender" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-confirm" sourceRef="order" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-master" sourceRef="confirm" targetRef="master" />
    <bpmn:sequenceFlow id="f-master-done" sourceRef="master" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
