tok 1.0 "Device takeover bid"

pool org "Organisation"
  lane mpon "MPON"
    start begin "Bid needed"
    task request "Request the device takeover bid"
    task order "Place the order"
  lane mpoo "MPOO"
    task tender "Send the tender for the equipment takeover"
    task confirm "Confirm the order"
    task master "Send the master data"
    end done "Order confirmed"

flow begin -> request -> tender -> order -> confirm -> master -> done
