<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="MSP" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="msn" name="MSPN">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mso" name="MSPO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Dismissal needed" />
    <bpmn:task id="send" name="Send the dismissal" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decide" name="Decision?" />
    <bpmn:task id="reject" name="Reject the dismissal" />
    <bpmn:task id="confirm" name="Confirm the dismissal" />
    <bpmn:endEvent id="rejected" name="Dismissal rejected" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-needed-send" sourceRef="needed" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="rejects" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="confirms" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
