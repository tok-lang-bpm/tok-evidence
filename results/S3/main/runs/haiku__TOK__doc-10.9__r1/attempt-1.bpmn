<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="requester" name="SP / PU / GO">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>mpoStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implemented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Change requested" />
    <bpmn:task id="request" name="Request the change to the MPO" />
    <bpmn:startEvent id="mpoStart" name="Change caused by the MPO" />
    <bpmn:task id="cause" name="Cause a change of the measuring point" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="decide" name="Change request confirmed?" />
    <bpmn:task id="confirm" name="Confirm the request of the SP / PU / GO" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="outcome" name="Implementation successful?" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notifyFail" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="implemented" name="Change implemented" />
    <bpmn:endEvent id="failed" name="Changes failed" />
    <bpmn:sequenceFlow id="f-requested-request" sourceRef="requested" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-merged" sourceRef="request" targetRef="merged" />
    <bpmn:sequenceFlow id="f-mpoStart-cause" sourceRef="mpoStart" targetRef="cause" />
    <bpmn:sequenceFlow id="f-cause-merged" sourceRef="cause" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-review" sourceRef="merged" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="yes" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decide-reject" name="no" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-perform" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-perform-outcome" sourceRef="perform" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-report" name="yes" sourceRef="outcome" targetRef="report" />
    <bpmn:sequenceFlow id="f-outcome-notifyFail" name="no" sourceRef="outcome" targetRef="notifyFail" />
    <bpmn:sequenceFlow id="f-report-implemented" sourceRef="report" targetRef="implemented" />
    <bpmn:sequenceFlow id="f-notifyFail-failed" sourceRef="notifyFail" targetRef="failed" />
  </bpmn:process>
</bpmn:definitions>
