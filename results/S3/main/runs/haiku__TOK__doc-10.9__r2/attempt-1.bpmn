<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="requester" name="SP / PU / GO">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Change of the measuring point needed" />
    <bpmn:exclusiveGateway id="initiated" name="Who initiates the change?" />
    <bpmn:task id="request" name="Request changes to the MPO" />
    <bpmn:task id="cause" name="Cause a change" />
    <bpmn:exclusiveGateway id="merged" name="Change initiated" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="decision" name="Request confirmed?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:task id="confirm" name="Confirm the request of the SP / PU / GO" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="outcome" name="Change implemented?" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notify" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:endEvent id="done" name="Change implemented" />
    <bpmn:endEvent id="failed" name="Change failed" />
    <bpmn:sequenceFlow id="f-needed-initiated" sourceRef="needed" targetRef="initiated" />
    <bpmn:sequenceFlow id="f-initiated-request" name="SP / PU / GO request changes" sourceRef="initiated" targetRef="request" />
    <bpmn:sequenceFlow id="f-initiated-cause" name="MPO causes a change" sourceRef="initiated" targetRef="cause" />
    <bpmn:sequenceFlow id="f-request-merged" sourceRef="request" targetRef="merged" />
    <bpmn:sequenceFlow id="f-cause-merged" sourceRef="cause" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-review" sourceRef="merged" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="yes" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-perform" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f-perform-outcome" sourceRef="perform" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-report" name="implemented" sourceRef="outcome" targetRef="report" />
    <bpmn:sequenceFlow id="f-outcome-notify" name="failed" sourceRef="outcome" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-done" sourceRef="report" targetRef="done" />
    <bpmn:sequenceFlow id="f-notify-failed" sourceRef="notify" targetRef="failed" />
  </bpmn:process>
</bpmn:definitions>
