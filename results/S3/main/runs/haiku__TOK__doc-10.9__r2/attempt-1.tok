tok 1.0 "Measuring point change"

pool org "Organisation"
  lane requester "SP / PU / GO"
    start needed "Change of the measuring point needed"
    xor initiated "Who initiates the change?"
    task request "Request changes to the MPO"
  lane mpo "MPO"
    task cause "Cause a change"
    xor merged "Change initiated"
    task review "Review the change request"
    xor decision "Request confirmed?"
    task reject "Reject the change of the measuring point"
    task confirm "Confirm the request of the SP / PU / GO"
    task perform "Perform the measuring point change"
    xor outcome "Change implemented?"
    task report "Report the implementation to the SP / PU / GO"
    task notify "Notify the SP / PU / GO about the failure of the changes"
    end rejected "Change rejected"
    end done "Change implemented"
    end failed "Change failed"

flow needed -> initiated
flow initiated -> request "SP / PU / GO request changes"
flow initiated -> cause "MPO causes a change"
flow request -> merged
flow cause -> merged
flow merged -> review -> decision
flow decision -> reject "no"
flow decision -> confirm "yes"
flow reject -> rejected
flow confirm -> perform -> outcome
flow outcome -> report "implemented"
flow outcome -> notify "failed"
flow report -> done
flow notify -> failed
