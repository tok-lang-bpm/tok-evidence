<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Police_report" name="Police report" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Small Claims Registry Operations" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Warrant possession request handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieveFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeExpanded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Warrant possession request needed" />
    <bpmn:task id="send" name="Send the warrant possession request" />
    <bpmn:task id="receive" name="Receive the request" />
    <bpmn:task id="retrieve" name="Retrieve the SCT file" />
    <bpmn:task id="forward" name="Forward the SCT warrant possession to Queensland Police" />
    <bpmn:task id="store" name="Store the SCT physical file awaiting report" />
    <bpmn:intermediateCatchEvent id="report" name="Report received">
      <bpmn:messageEventDefinition id="report-def" messageRef="Message_Police_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="retrieveFile" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach" name="Attach the new SCT document" />
    <bpmn:task id="storeExpanded" name="Store the expanded SCT physical file" />
    <bpmn:endEvent id="handed" name="SCT physical file handed to internal staff" />
    <bpmn:sequenceFlow id="f-requested-send" sourceRef="requested" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-receive" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-retrieve" sourceRef="receive" targetRef="retrieve" />
    <bpmn:sequenceFlow id="f-retrieve-forward" sourceRef="retrieve" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-store" sourceRef="forward" targetRef="store" />
    <bpmn:sequenceFlow id="f-store-report" sourceRef="store" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-retrieveFile" sourceRef="report" targetRef="retrieveFile" />
    <bpmn:sequenceFlow id="f-retrieveFile-attach" sourceRef="retrieveFile" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-storeExpanded" sourceRef="attach" targetRef="storeExpanded" />
    <bpmn:sequenceFlow id="f-storeExpanded-handed" sourceRef="storeExpanded" targetRef="handed" />
  </bpmn:process>
</bpmn:definitions>
