tok 1.0 "Warrant possession request handling"

pool org "Small Claims Registry Operations"
  lane party "Party"
    start requested "Warrant possession request needed"
    task send "Send the warrant possession request"
  lane backoffice "Client Service Back Office"
    task receive "Receive the request"
    task retrieve "Retrieve the SCT file"
    task forward "Forward the SCT warrant possession to Queensland Police"
    task store "Store the SCT physical file awaiting report"
    catch report "Report received" message="Police report"
    task retrieveFile "Retrieve the respective SCT file"
    task attach "Attach the new SCT document"
    task storeExpanded "Store the expanded SCT physical file"
    end handed "SCT physical file handed to internal staff"

flow requested -> send -> receive -> retrieve -> forward -> store -> report -> retrieveFile -> attach -> storeExpanded -> handed
