<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Warrant_possession_request" name="Warrant possession request" />
  <bpmn:message id="Message_Warrant_possession" name="Warrant possession" />
  <bpmn:message id="Message_Police_report" name="Police report" />
  <bpmn:message id="Message_Physical_SCT_file" name="Physical SCT file" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="party" name="Party" />
    <bpmn:participant id="police" name="Queensland Police" />
    <bpmn:participant id="staff" name="MC internal staff" />
    <bpmn:participant id="office" name="Small Claims Registry Operations" processRef="office-process" />
    <bpmn:messageFlow id="m-party-requested" name="Warrant possession request" sourceRef="party" targetRef="requested" messageRef="Message_Warrant_possession_request" />
    <bpmn:messageFlow id="m-forward-police" name="Warrant possession" sourceRef="forward" targetRef="police" messageRef="Message_Warrant_possession" />
    <bpmn:messageFlow id="m-police-report" name="Police report" sourceRef="police" targetRef="report" messageRef="Message_Police_report" />
    <bpmn:messageFlow id="m-handover-staff" name="Physical SCT file" sourceRef="handover" targetRef="staff" messageRef="Message_Physical_SCT_file" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Warrant possession request handling" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="back" name="Client Service Back Office">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-expanded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Warrant possession request received">
      <bpmn:messageEventDefinition id="requested-def" messageRef="Message_Warrant_possession_request" />
    </bpmn:startEvent>
    <bpmn:task id="receive" name="Receive the request" />
    <bpmn:task id="retrieve" name="Retrieve the SCT file" />
    <bpmn:task id="forward" name="Forward the SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store" name="Store the SCT physical file awaiting the police report" />
    <bpmn:intermediateCatchEvent id="report" name="Police report received">
      <bpmn:messageEventDefinition id="report-def" messageRef="Message_Police_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="retrieve-report" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach" name="Attach the new SCT document" />
    <bpmn:task id="store-expanded" name="Store the expanded SCT physical file" />
    <bpmn:task id="handover" name="Hand over the physical SCT file to other MC internal staff" />
    <bpmn:endEvent id="done" name="SCT file handed over" />
    <bpmn:sequenceFlow id="f-requested-receive" sourceRef="requested" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-retrieve" sourceRef="receive" targetRef="retrieve" />
    <bpmn:sequenceFlow id="f-retrieve-forward" sourceRef="retrieve" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-store" sourceRef="forward" targetRef="store" />
    <bpmn:sequenceFlow id="f-store-report" sourceRef="store" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-retrieve-report" sourceRef="report" targetRef="retrieve-report" />
    <bpmn:sequenceFlow id="f-retrieve-report-attach" sourceRef="retrieve-report" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-store-expanded" sourceRef="attach" targetRef="store-expanded" />
    <bpmn:sequenceFlow id="f-store-expanded-handover" sourceRef="store-expanded" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-done" sourceRef="handover" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
