<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court file preparation before directions hearings" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court file preparation before directions hearings" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bench" name="Court hearing">
        <bpmn:flowNodeRef>hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Each morning" />
    <bpmn:task id="check" name="Check the files yet to be processed" />
    <bpmn:exclusiveGateway id="missing" name="Files missing?" />
    <bpmn:task id="search" name="Initiate a search for the missing files" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="track" name="Physically track the files to the intended location" />
    <bpmn:parallelGateway id="ready" />
    <bpmn:task id="handover" name="Hand the files over to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="hearings" name="Conduct the directions hearings" />
    <bpmn:endEvent id="done" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f-morning-check" sourceRef="morning" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-merged" name="no" sourceRef="missing" targetRef="merged" />
    <bpmn:sequenceFlow id="f-search-merged" sourceRef="search" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-track" sourceRef="merged" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-handover" sourceRef="ready" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-joined" sourceRef="handover" targetRef="joined" />
    <bpmn:sequenceFlow id="f-ready-distribute" sourceRef="ready" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-joined" sourceRef="distribute" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-hearings" sourceRef="joined" targetRef="hearings" />
    <bpmn:sequenceFlow id="f-hearings-done" sourceRef="hearings" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
