<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="clerk" name="Claims officer">
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repeat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>markNotOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="registered" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="recommend" name="Write the settlement recommendation" />
    <bpmn:task id="repeat" name="Repeat the recommendation" />
    <bpmn:task id="check" name="Check the recommendation" />
    <bpmn:exclusiveGateway id="verdict" name="Claim OK?" />
    <bpmn:task id="mark" name="Mark the claim as OK" />
    <bpmn:task id="markNotOk" name="Mark the claim as Not OK" />
    <bpmn:endEvent id="proceed" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-registered-examine" sourceRef="registered" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-recommend" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-check" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-verdict" sourceRef="check" targetRef="verdict" />
    <bpmn:sequenceFlow id="f-verdict-mark" name="yes" sourceRef="verdict" targetRef="mark" />
    <bpmn:sequenceFlow id="f-verdict-markNotOk" name="no" sourceRef="verdict" targetRef="markNotOk" />
    <bpmn:sequenceFlow id="f-markNotOk-repeat" sourceRef="markNotOk" targetRef="repeat" />
    <bpmn:sequenceFlow id="f-repeat-check" sourceRef="repeat" targetRef="check" />
    <bpmn:sequenceFlow id="f-mark-proceed" sourceRef="mark" targetRef="proceed" />
  </bpmn:process>
</bpmn:definitions>
