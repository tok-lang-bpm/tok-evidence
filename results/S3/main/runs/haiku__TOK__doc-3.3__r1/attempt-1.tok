tok 1.0 "Claim handling"

pool insurer "Insurer"
  lane clerk "Claims officer"
    start registered "Claim registered"
    task examine "Examine the claim"
    task recommend "Write the settlement recommendation"
    task repeat "Repeat the recommendation"
  lane senior "Senior claims officer"
    task check "Check the recommendation"
    xor verdict "Claim OK?"
    task mark "Mark the claim as OK"
    task markNotOk "Mark the claim as Not OK"
    end proceed "Claim handling proceeds"

flow registered -> examine -> recommend -> check -> verdict
flow verdict -> mark "yes"
flow verdict -> markNotOk "no"
flow markNotOk -> repeat -> check
flow mark -> proceed
