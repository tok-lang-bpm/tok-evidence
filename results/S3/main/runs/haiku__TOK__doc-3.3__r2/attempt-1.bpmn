<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="officer" name="Claims officer">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Claim to be handled" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="recommend" name="Write the settlement recommendation" />
    <bpmn:task id="check" name="Check the settlement recommendation" />
    <bpmn:exclusiveGateway id="decide" name="Claim marked OK?" />
    <bpmn:endEvent id="proceed" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-begin-register" sourceRef="begin" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-examine" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-recommend" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-check" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-decide" sourceRef="check" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-proceed" name="OK" sourceRef="decide" targetRef="proceed" />
    <bpmn:sequenceFlow id="f-decide-recommend" name="Not OK" sourceRef="decide" targetRef="recommend" />
  </bpmn:process>
</bpmn:definitions>
