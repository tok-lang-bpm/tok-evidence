<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court mail handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="registry" name="Court Registry" processRef="registry-process" />
  </bpmn:collaboration>
  <bpmn:process id="registry-process" name="Court mail handling" isExecutable="false">
    <bpmn:laneSet id="registry-lanes">
      <bpmn:lane id="mailunit" name="Mail Processing Unit">
        <bpmn:flowNodeRef>collected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry_l" name="Registry">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>group</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>partydetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="collected" name="Mail collected from the party" />
    <bpmn:task id="sort" name="Sort the unopened mail into business areas" />
    <bpmn:task id="receive" name="Receive the mail" />
    <bpmn:task id="open" name="Open the mail" />
    <bpmn:task id="group" name="Sort the mail into groups for distribution" />
    <bpmn:task id="register" name="Register the mail in the manual incoming Mail Register" />
    <bpmn:task id="qc" name="Perform the quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="reject" name="Compile a list of requisition with the reason for rejection" />
    <bpmn:task id="sendback" name="Send the list of requisition back to the party" />
    <bpmn:task id="capture" name="Capture the matter details (types of action)" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="provide" name="Provide the matter details to the Cashier" />
    <bpmn:task id="fees" name="Take the applicable fees attached to the mail" />
    <bpmn:task id="envelope" name="Put the receipt and copied documents into an envelope" />
    <bpmn:task id="post" name="Post the envelope to the party" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:endEvent id="returned" name="Mail returned to the party" />
    <bpmn:endEvent id="done" name="Mail processed and posted to the party" />
    <bpmn:task id="partydetails" name="Capture the Party Details" />
    <bpmn:task id="print" name="Print the Physical Court File" />
    <bpmn:sequenceFlow id="f-collected-sort" sourceRef="collected" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-receive" sourceRef="sort" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-open" sourceRef="receive" targetRef="open" />
    <bpmn:sequenceFlow id="f-open-group" sourceRef="open" targetRef="group" />
    <bpmn:sequenceFlow id="f-group-register" sourceRef="group" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-qc" sourceRef="register" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-compliant" sourceRef="qc" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-reject" name="no" sourceRef="compliant" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-sendback" sourceRef="reject" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-returned" sourceRef="sendback" targetRef="returned" />
    <bpmn:sequenceFlow id="f-compliant-capture" name="yes" sourceRef="compliant" targetRef="capture" />
    <bpmn:sequenceFlow id="f-capture-split" sourceRef="capture" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-provide" sourceRef="split" targetRef="provide" />
    <bpmn:sequenceFlow id="f-split-partydetails" sourceRef="split" targetRef="partydetails" />
    <bpmn:sequenceFlow id="f-provide-fees" sourceRef="provide" targetRef="fees" />
    <bpmn:sequenceFlow id="f-fees-envelope" sourceRef="fees" targetRef="envelope" />
    <bpmn:sequenceFlow id="f-envelope-post" sourceRef="envelope" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-joined" sourceRef="post" targetRef="joined" />
    <bpmn:sequenceFlow id="f-partydetails-print" sourceRef="partydetails" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-joined" sourceRef="print" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-done" sourceRef="joined" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
