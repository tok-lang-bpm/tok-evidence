<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims notification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claims notification" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="claimant" name="Claimant">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnUpdated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="clerk" name="Claims department">
        <bpmn:flowNodeRef>checkInsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSimple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>formsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informUpdate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Claims Management system">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Claim received" />
    <bpmn:task id="returnForms" name="Return the forms" />
    <bpmn:task id="updateForms" name="Update the forms" />
    <bpmn:task id="returnUpdated" name="Return the updated forms" />
    <bpmn:task id="checkInsured" name="Check whether the claimant is insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" />
    <bpmn:task id="informReject" name="Inform the claimant that the claim must be rejected" />
    <bpmn:endEvent id="rejected" name="Claim rejected" />
    <bpmn:task id="evaluate" name="Evaluate the severity of the claim" />
    <bpmn:exclusiveGateway id="severity" name="Simple or complex claim?" />
    <bpmn:task id="sendSimple" name="Send the forms for a simple claim" />
    <bpmn:task id="sendComplex" name="Send the forms for a complex claim" />
    <bpmn:exclusiveGateway id="sentMerge" />
    <bpmn:exclusiveGateway id="formsReceived" />
    <bpmn:task id="checkForms" name="Check the forms for completeness" />
    <bpmn:exclusiveGateway id="complete" name="Forms complete?" />
    <bpmn:task id="informUpdate" name="Inform the claimant to update the forms" />
    <bpmn:task id="register" name="Register the claim in the Claims Management system" />
    <bpmn:endEvent id="registered" name="Claims Notification process ended" />
    <bpmn:sequenceFlow id="f-received-checkInsured" sourceRef="received" targetRef="checkInsured" />
    <bpmn:sequenceFlow id="f-checkInsured-insured" sourceRef="checkInsured" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-informReject" name="no" sourceRef="insured" targetRef="informReject" />
    <bpmn:sequenceFlow id="f-informReject-rejected" sourceRef="informReject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-insured-evaluate" name="yes" sourceRef="insured" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-severity" sourceRef="evaluate" targetRef="severity" />
    <bpmn:sequenceFlow id="f-severity-sendSimple" name="simple" sourceRef="severity" targetRef="sendSimple" />
    <bpmn:sequenceFlow id="f-severity-sendComplex" name="complex" sourceRef="severity" targetRef="sendComplex" />
    <bpmn:sequenceFlow id="f-sendSimple-sentMerge" sourceRef="sendSimple" targetRef="sentMerge" />
    <bpmn:sequenceFlow id="f-sendComplex-sentMerge" sourceRef="sendComplex" targetRef="sentMerge" />
    <bpmn:sequenceFlow id="f-sentMerge-returnForms" sourceRef="sentMerge" targetRef="returnForms" />
    <bpmn:sequenceFlow id="f-returnForms-formsReceived" sourceRef="returnForms" targetRef="formsReceived" />
    <bpmn:sequenceFlow id="f-formsReceived-checkForms" sourceRef="formsReceived" targetRef="checkForms" />
    <bpmn:sequenceFlow id="f-checkForms-complete" sourceRef="checkForms" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-register" name="yes" sourceRef="complete" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-registered" sourceRef="register" targetRef="registered" />
    <bpmn:sequenceFlow id="f-complete-informUpdate" name="no" sourceRef="complete" targetRef="informUpdate" />
    <bpmn:sequenceFlow id="f-informUpdate-updateForms" sourceRef="informUpdate" targetRef="updateForms" />
    <bpmn:sequenceFlow id="f-updateForms-returnUpdated" sourceRef="updateForms" targetRef="returnUpdated" />
    <bpmn:sequenceFlow id="f-returnUpdated-formsReceived" sourceRef="returnUpdated" targetRef="formsReceived" />
  </bpmn:process>
</bpmn:definitions>
