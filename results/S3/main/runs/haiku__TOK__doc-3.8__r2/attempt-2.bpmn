<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car insurance claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car insurance claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>check_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone_garage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Claim submitted" />
    <bpmn:task id="submit" name="Submit a claim with relevant documentation" />
    <bpmn:endEvent id="complete" name="Process complete" />
    <bpmn:task id="check_docs" name="Check the documents for completeness" />
    <bpmn:exclusiveGateway id="complete_docs" name="Documents complete?" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="reject_docs" name="Request the missing documents" />
    <bpmn:task id="check_ins" name="Check the insurance" />
    <bpmn:task id="assess" name="Perform an assessment" />
    <bpmn:exclusiveGateway id="positive" name="Assessment positive?" />
    <bpmn:task id="phone_garage" name="Phone the garage to authorise the repairs" />
    <bpmn:task id="schedule_pay" name="Schedule the payment" />
    <bpmn:task id="reject" name="Reject the claim" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome known" />
    <bpmn:task id="letter" name="Send a letter to the customer" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check_docs" sourceRef="submit" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f-check_docs-complete_docs" sourceRef="check_docs" targetRef="complete_docs" />
    <bpmn:sequenceFlow id="f-complete_docs-register" name="yes" sourceRef="complete_docs" targetRef="register" />
    <bpmn:sequenceFlow id="f-complete_docs-reject_docs" name="no" sourceRef="complete_docs" targetRef="reject_docs" />
    <bpmn:sequenceFlow id="f-reject_docs-check_docs" sourceRef="reject_docs" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f-register-check_ins" sourceRef="register" targetRef="check_ins" />
    <bpmn:sequenceFlow id="f-check_ins-assess" sourceRef="check_ins" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-positive" sourceRef="assess" targetRef="positive" />
    <bpmn:sequenceFlow id="f-positive-phone_garage" name="yes" sourceRef="positive" targetRef="phone_garage" />
    <bpmn:sequenceFlow id="f-positive-reject" name="no" sourceRef="positive" targetRef="reject" />
    <bpmn:sequenceFlow id="f-phone_garage-schedule_pay" sourceRef="phone_garage" targetRef="schedule_pay" />
    <bpmn:sequenceFlow id="f-schedule_pay-outcome" sourceRef="schedule_pay" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-reject-outcome" sourceRef="reject" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-letter" sourceRef="outcome" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-complete" sourceRef="letter" targetRef="complete" />
  </bpmn:process>
</bpmn:definitions>
