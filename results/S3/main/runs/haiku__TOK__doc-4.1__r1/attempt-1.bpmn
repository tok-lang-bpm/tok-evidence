<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake workflow of the mental health care institute" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Medical_file_copy" name="Medical file copy" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="inst" name="Mental health care institute" processRef="inst-process" />
  </bpmn:collaboration>
  <bpmn:process id="inst-process" name="Intake workflow of the mental health care institute" isExecutable="false">
    <bpmn:laneSet id="inst-lanes">
      <bpmn:lane id="fd" name="Family doctor">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="Secretarial office">
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>connect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>med_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copy_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_med</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type_tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_tape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nurse" name="Nursing officer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_in</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tl" name="Team-leader">
        <bpmn:flowNodeRef>meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fi" name="First intaker (social-medical worker)">
        <bpmn:flowNodeRef>plan1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notebook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notes_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checklist_file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="si" name="Second intaker (physician)">
        <bpmn:flowNodeRef>plan2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dict</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="notice" name="Patient in need of mental treatment" />
    <bpmn:task id="notify" name="Give notice by telephone" />
    <bpmn:task id="inquire" name="Inquire after the name and residence of the patient" />
    <bpmn:task id="connect" name="Put the family doctor through to the nursing officer" />
    <bpmn:task id="store_info" name="Store the information from the form in the information system" />
    <bpmn:task id="print_info" name="Print the information from the information system" />
    <bpmn:exclusiveGateway id="new_patient" name="New patient?" />
    <bpmn:task id="create_file" name="Create a patient file" />
    <bpmn:exclusiveGateway id="merge_file" />
    <bpmn:task id="file_form" name="Store the registration form and the print in the patient file" />
    <bpmn:task id="cards" name="Produce two registration cards" />
    <bpmn:task id="add_notice" name="Add the new patient to the list of new notices" />
    <bpmn:task id="store_assign" name="Store the assignment of each patient in the information system" />
    <bpmn:task id="pass_cards" name="Pass the registration cards to the first and second intaker" />
    <bpmn:parallelGateway id="split_cards" />
    <bpmn:exclusiveGateway id="med_req" name="Medical file required?" />
    <bpmn:task id="letter" name="Prepare and send a letter requesting a copy of the medical file" />
    <bpmn:intermediateCatchEvent id="copy_rec" name="Copy of the medical file received">
      <bpmn:messageEventDefinition id="copy_rec-def" messageRef="Message_Medical_file_copy" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inform2" name="Inform the second intaker" />
    <bpmn:task id="add_copy" name="Add the copy to the patient file" />
    <bpmn:exclusiveGateway id="merge_med" />
    <bpmn:task id="type_tapes" name="Type out the dictaphone tapes" />
    <bpmn:task id="add_tape" name="Add the information from the tapes to the patient file" />
    <bpmn:parallelGateway id="join_meet" />
    <bpmn:task id="status_list" name="Put the patient on the list of patients that reach this status" />
    <bpmn:task id="provide" name="Provide the team-leader with a list of these patients" />
    <bpmn:task id="inquiry" name="Make a full inquiry into the mental, health and social state of the patient" />
    <bpmn:task id="record" name="Record the information on the registration form" />
    <bpmn:task id="hand_in" name="Hand in the registration form at the secretarial office" />
    <bpmn:task id="meeting" name="Hold the staff meeting of the medical team on Wednesday" />
    <bpmn:task id="assign" name="Assign the new patients to members of the team" />
    <bpmn:task id="determine" name="Determine whether the medical file is required" />
    <bpmn:task id="record_assign" name="Record the assignments on the assignment list" />
    <bpmn:task id="hand_list" name="Hand the assignment list to the secretarial office" />
    <bpmn:task id="treatment" name="Formulate the treatment plan">
      <bpmn:documentation>Together with the first and second intaker and the attending psychiatrist</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="done" name="Intake procedure completed" />
    <bpmn:task id="plan1" name="Plan a meeting with the patient as soon as possible" />
    <bpmn:task id="meet1" name="Hold the first meeting with the patient" />
    <bpmn:task id="exam1" name="Examine the patient using the standard checklist" />
    <bpmn:task id="fill1" name="Fill out the standard checklist" />
    <bpmn:task id="notebook" name="Register additional observations in a personal notebook" />
    <bpmn:task id="notes_file" name="Put a copy of the notes in the patient file" />
    <bpmn:task id="checklist_file" name="Add the standard checklist to the patient file" />
    <bpmn:task id="plan2" name="Plan the first meeting with the patient" />
    <bpmn:task id="meet2" name="Hold the first meeting with the patient" />
    <bpmn:task id="dict" name="Record observations on a dictaphone" />
    <bpmn:sequenceFlow id="f-notice-notify" sourceRef="notice" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-inquire" sourceRef="notify" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-connect" sourceRef="inquire" targetRef="connect" />
    <bpmn:sequenceFlow id="f-connect-inquiry" sourceRef="connect" targetRef="inquiry" />
    <bpmn:sequenceFlow id="f-inquiry-record" sourceRef="inquiry" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-hand_in" sourceRef="record" targetRef="hand_in" />
    <bpmn:sequenceFlow id="f-hand_in-store_info" sourceRef="hand_in" targetRef="store_info" />
    <bpmn:sequenceFlow id="f-store_info-print_info" sourceRef="store_info" targetRef="print_info" />
    <bpmn:sequenceFlow id="f-print_info-new_patient" sourceRef="print_info" targetRef="new_patient" />
    <bpmn:sequenceFlow id="f-new_patient-create_file" name="yes" sourceRef="new_patient" targetRef="create_file" />
    <bpmn:sequenceFlow id="f-create_file-merge_file" sourceRef="create_file" targetRef="merge_file" />
    <bpmn:sequenceFlow id="f-new_patient-merge_file" name="no" sourceRef="new_patient" targetRef="merge_file" />
    <bpmn:sequenceFlow id="f-merge_file-file_form" sourceRef="merge_file" targetRef="file_form" />
    <bpmn:sequenceFlow id="f-file_form-cards" sourceRef="file_form" targetRef="cards" />
    <bpmn:sequenceFlow id="f-cards-add_notice" sourceRef="cards" targetRef="add_notice" />
    <bpmn:sequenceFlow id="f-add_notice-meeting" sourceRef="add_notice" targetRef="meeting" />
    <bpmn:sequenceFlow id="f-meeting-assign" sourceRef="meeting" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-determine" sourceRef="assign" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-record_assign" sourceRef="determine" targetRef="record_assign" />
    <bpmn:sequenceFlow id="f-record_assign-hand_list" sourceRef="record_assign" targetRef="hand_list" />
    <bpmn:sequenceFlow id="f-hand_list-store_assign" sourceRef="hand_list" targetRef="store_assign" />
    <bpmn:sequenceFlow id="f-store_assign-pass_cards" sourceRef="store_assign" targetRef="pass_cards" />
    <bpmn:sequenceFlow id="f-pass_cards-split_cards" sourceRef="pass_cards" targetRef="split_cards" />
    <bpmn:sequenceFlow id="f-split_cards-plan1" sourceRef="split_cards" targetRef="plan1" />
    <bpmn:sequenceFlow id="f-plan1-meet1" sourceRef="plan1" targetRef="meet1" />
    <bpmn:sequenceFlow id="f-meet1-exam1" sourceRef="meet1" targetRef="exam1" />
    <bpmn:sequenceFlow id="f-exam1-fill1" sourceRef="exam1" targetRef="fill1" />
    <bpmn:sequenceFlow id="f-fill1-notebook" sourceRef="fill1" targetRef="notebook" />
    <bpmn:sequenceFlow id="f-notebook-notes_file" sourceRef="notebook" targetRef="notes_file" />
    <bpmn:sequenceFlow id="f-notes_file-checklist_file" sourceRef="notes_file" targetRef="checklist_file" />
    <bpmn:sequenceFlow id="f-checklist_file-join_meet" sourceRef="checklist_file" targetRef="join_meet" />
    <bpmn:sequenceFlow id="f-split_cards-med_req" sourceRef="split_cards" targetRef="med_req" />
    <bpmn:sequenceFlow id="f-med_req-letter" name="yes" sourceRef="med_req" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-copy_rec" sourceRef="letter" targetRef="copy_rec" />
    <bpmn:sequenceFlow id="f-copy_rec-inform2" sourceRef="copy_rec" targetRef="inform2" />
    <bpmn:sequenceFlow id="f-inform2-add_copy" sourceRef="inform2" targetRef="add_copy" />
    <bpmn:sequenceFlow id="f-add_copy-merge_med" sourceRef="add_copy" targetRef="merge_med" />
    <bpmn:sequenceFlow id="f-med_req-merge_med" name="no" sourceRef="med_req" targetRef="merge_med" />
    <bpmn:sequenceFlow id="f-merge_med-plan2" sourceRef="merge_med" targetRef="plan2" />
    <bpmn:sequenceFlow id="f-plan2-meet2" sourceRef="plan2" targetRef="meet2" />
    <bpmn:sequenceFlow id="f-meet2-dict" sourceRef="meet2" targetRef="dict" />
    <bpmn:sequenceFlow id="f-dict-type_tapes" sourceRef="dict" targetRef="type_tapes" />
    <bpmn:sequenceFlow id="f-type_tapes-add_tape" sourceRef="type_tapes" targetRef="add_tape" />
    <bpmn:sequenceFlow id="f-add_tape-join_meet" sourceRef="add_tape" targetRef="join_meet" />
    <bpmn:sequenceFlow id="f-join_meet-status_list" sourceRef="join_meet" targetRef="status_list" />
    <bpmn:sequenceFlow id="f-status_list-provide" sourceRef="status_list" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-treatment" sourceRef="provide" targetRef="treatment" />
    <bpmn:sequenceFlow id="f-treatment-done" sourceRef="treatment" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
