<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="fam" name="Family doctor">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>telephone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_copy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="Secretarial office">
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>connect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newpat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>medreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_med</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_dict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type_tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_typed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_dict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list_meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nurse" name="Nursing officer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_form</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lead" name="Team leader">
        <bpmn:flowNodeRef>staff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_tp_team</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first" name="First intaker (social-medical worker)">
        <bpmn:flowNodeRef>plan_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notebook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_checklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_tp_first</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second" name="Second intaker (physician)">
        <bpmn:flowNodeRef>plan_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_tp_second</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psych" name="Psychiatrist">
        <bpmn:flowNodeRef>plan_tp_psych</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="notice" name="Patient needs mental treatment" />
    <bpmn:task id="telephone" name="Give notice by telephone" />
    <bpmn:task id="send_copy" name="Send copy of medical file" />
    <bpmn:task id="inquire" name="Inquire after name and residence of patient" />
    <bpmn:task id="connect" name="Put doctor through to responsible nursing officer" />
    <bpmn:task id="store_info" name="Store information in information system" />
    <bpmn:task id="print_info" name="Print information from information system" />
    <bpmn:exclusiveGateway id="newpat" name="New patient?" />
    <bpmn:task id="create_file" name="Create patient file" />
    <bpmn:exclusiveGateway id="merge_file" />
    <bpmn:task id="file_forms" name="Store registration form and print in patient file" />
    <bpmn:task id="cards" name="Produce two registration cards" />
    <bpmn:task id="add_list" name="Add new patient to list of new notices" />
    <bpmn:task id="store_assign" name="Store assignments in information system" />
    <bpmn:task id="pass_cards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="s1" />
    <bpmn:exclusiveGateway id="medreq" name="Medical file required?" />
    <bpmn:task id="letter" name="Prepare and send letter requesting copy of medical file" />
    <bpmn:task id="receive_copy" name="Receive copy of medical file" />
    <bpmn:task id="inform_second" name="Inform second intaker" />
    <bpmn:task id="add_copy" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="merge_med" />
    <bpmn:parallelGateway id="s_dict" />
    <bpmn:task id="type_tapes" name="Type out dictaphone tapes" />
    <bpmn:task id="add_typed" name="Add typed information to patient file" />
    <bpmn:endEvent id="end_dict" name="Dictaphone record filed" />
    <bpmn:parallelGateway id="join_meet" />
    <bpmn:task id="list_meet" name="Put patient on list of patients reaching this status" />
    <bpmn:task id="give_list" name="Give list of these patients to team leader" />
    <bpmn:parallelGateway id="s2" />
    <bpmn:parallelGateway id="join_plan" />
    <bpmn:endEvent id="ended" name="Intake procedure ended" />
    <bpmn:task id="inquiry" name="Make full inquiry into mental, health and social state of patient" />
    <bpmn:task id="record" name="Record information on registration form" />
    <bpmn:task id="hand_form" name="Hand in registration form at secretarial office" />
    <bpmn:task id="staff" name="Hold staff meeting of medical team on Wednesday" />
    <bpmn:task id="assign_first" name="Assign social-medical worker as first intaker" />
    <bpmn:task id="assign_second" name="Assign physician as second intaker" />
    <bpmn:task id="determine" name="Determine whether medical file is required" />
    <bpmn:task id="record_assign" name="Record assignments on assignment list" />
    <bpmn:task id="hand_list" name="Hand assignment list to secretarial office" />
    <bpmn:task id="plan_tp_team" name="Formulate treatment plan" />
    <bpmn:task id="plan_first" name="Plan first meeting with patient as soon as possible" />
    <bpmn:task id="examine" name="Examine patient using standard checklist" />
    <bpmn:task id="fill" name="Fill out standard checklist" />
    <bpmn:task id="notebook" name="Register additional observations in personal notebook" />
    <bpmn:task id="put_notes" name="Put copy of notes in patient file" />
    <bpmn:task id="add_checklist" name="Add standard checklist to patient file" />
    <bpmn:task id="plan_tp_first" name="Formulate treatment plan" />
    <bpmn:task id="plan_second" name="Plan first meeting with patient" />
    <bpmn:task id="meet_second" name="Hold first meeting with patient" />
    <bpmn:task id="dictaphone" name="Record observations on dictaphone" />
    <bpmn:task id="plan_tp_second" name="Formulate treatment plan" />
    <bpmn:task id="plan_tp_psych" name="Formulate treatment plan" />
    <bpmn:sequenceFlow id="f-notice-telephone" sourceRef="notice" targetRef="telephone" />
    <bpmn:sequenceFlow id="f-telephone-inquire" sourceRef="telephone" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-connect" sourceRef="inquire" targetRef="connect" />
    <bpmn:sequenceFlow id="f-connect-inquiry" sourceRef="connect" targetRef="inquiry" />
    <bpmn:sequenceFlow id="f-inquiry-record" sourceRef="inquiry" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-hand_form" sourceRef="record" targetRef="hand_form" />
    <bpmn:sequenceFlow id="f-hand_form-store_info" sourceRef="hand_form" targetRef="store_info" />
    <bpmn:sequenceFlow id="f-store_info-print_info" sourceRef="store_info" targetRef="print_info" />
    <bpmn:sequenceFlow id="f-print_info-newpat" sourceRef="print_info" targetRef="newpat" />
    <bpmn:sequenceFlow id="f-newpat-create_file" name="yes" sourceRef="newpat" targetRef="create_file" />
    <bpmn:sequenceFlow id="f-newpat-merge_file" name="no" sourceRef="newpat" targetRef="merge_file" />
    <bpmn:sequenceFlow id="f-create_file-merge_file" sourceRef="create_file" targetRef="merge_file" />
    <bpmn:sequenceFlow id="f-merge_file-file_forms" sourceRef="merge_file" targetRef="file_forms" />
    <bpmn:sequenceFlow id="f-file_forms-cards" sourceRef="file_forms" targetRef="cards" />
    <bpmn:sequenceFlow id="f-cards-add_list" sourceRef="cards" targetRef="add_list" />
    <bpmn:sequenceFlow id="f-add_list-staff" sourceRef="add_list" targetRef="staff" />
    <bpmn:sequenceFlow id="f-staff-assign_first" sourceRef="staff" targetRef="assign_first" />
    <bpmn:sequenceFlow id="f-assign_first-assign_second" sourceRef="assign_first" targetRef="assign_second" />
    <bpmn:sequenceFlow id="f-assign_second-determine" sourceRef="assign_second" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-record_assign" sourceRef="determine" targetRef="record_assign" />
    <bpmn:sequenceFlow id="f-record_assign-hand_list" sourceRef="record_assign" targetRef="hand_list" />
    <bpmn:sequenceFlow id="f-hand_list-store_assign" sourceRef="hand_list" targetRef="store_assign" />
    <bpmn:sequenceFlow id="f-store_assign-pass_cards" sourceRef="store_assign" targetRef="pass_cards" />
    <bpmn:sequenceFlow id="f-pass_cards-s1" sourceRef="pass_cards" targetRef="s1" />
    <bpmn:sequenceFlow id="f-s1-plan_first" sourceRef="s1" targetRef="plan_first" />
    <bpmn:sequenceFlow id="f-plan_first-examine" sourceRef="plan_first" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-fill" sourceRef="examine" targetRef="fill" />
    <bpmn:sequenceFlow id="f-fill-notebook" sourceRef="fill" targetRef="notebook" />
    <bpmn:sequenceFlow id="f-notebook-put_notes" sourceRef="notebook" targetRef="put_notes" />
    <bpmn:sequenceFlow id="f-put_notes-add_checklist" sourceRef="put_notes" targetRef="add_checklist" />
    <bpmn:sequenceFlow id="f-add_checklist-join_meet" sourceRef="add_checklist" targetRef="join_meet" />
    <bpmn:sequenceFlow id="f-s1-medreq" sourceRef="s1" targetRef="medreq" />
    <bpmn:sequenceFlow id="f-medreq-letter" name="yes" sourceRef="medreq" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-send_copy" sourceRef="letter" targetRef="send_copy" />
    <bpmn:sequenceFlow id="f-send_copy-receive_copy" sourceRef="send_copy" targetRef="receive_copy" />
    <bpmn:sequenceFlow id="f-receive_copy-inform_second" sourceRef="receive_copy" targetRef="inform_second" />
    <bpmn:sequenceFlow id="f-inform_second-add_copy" sourceRef="inform_second" targetRef="add_copy" />
    <bpmn:sequenceFlow id="f-add_copy-merge_med" sourceRef="add_copy" targetRef="merge_med" />
    <bpmn:sequenceFlow id="f-medreq-merge_med" name="no" sourceRef="medreq" targetRef="merge_med" />
    <bpmn:sequenceFlow id="f-merge_med-plan_second" sourceRef="merge_med" targetRef="plan_second" />
    <bpmn:sequenceFlow id="f-plan_second-meet_second" sourceRef="plan_second" targetRef="meet_second" />
    <bpmn:sequenceFlow id="f-meet_second-dictaphone" sourceRef="meet_second" targetRef="dictaphone" />
    <bpmn:sequenceFlow id="f-dictaphone-s_dict" sourceRef="dictaphone" targetRef="s_dict" />
    <bpmn:sequenceFlow id="f-s_dict-join_meet" sourceRef="s_dict" targetRef="join_meet" />
    <bpmn:sequenceFlow id="f-s_dict-type_tapes" sourceRef="s_dict" targetRef="type_tapes" />
    <bpmn:sequenceFlow id="f-type_tapes-add_typed" sourceRef="type_tapes" targetRef="add_typed" />
    <bpmn:sequenceFlow id="f-add_typed-end_dict" sourceRef="add_typed" targetRef="end_dict" />
    <bpmn:sequenceFlow id="f-join_meet-list_meet" sourceRef="join_meet" targetRef="list_meet" />
    <bpmn:sequenceFlow id="f-list_meet-give_list" sourceRef="list_meet" targetRef="give_list" />
    <bpmn:sequenceFlow id="f-give_list-s2" sourceRef="give_list" targetRef="s2" />
    <bpmn:sequenceFlow id="f-s2-plan_tp_first" sourceRef="s2" targetRef="plan_tp_first" />
    <bpmn:sequenceFlow id="f-s2-plan_tp_second" sourceRef="s2" targetRef="plan_tp_second" />
    <bpmn:sequenceFlow id="f-s2-plan_tp_team" sourceRef="s2" targetRef="plan_tp_team" />
    <bpmn:sequenceFlow id="f-s2-plan_tp_psych" sourceRef="s2" targetRef="plan_tp_psych" />
    <bpmn:sequenceFlow id="f-plan_tp_first-join_plan" sourceRef="plan_tp_first" targetRef="join_plan" />
    <bpmn:sequenceFlow id="f-plan_tp_second-join_plan" sourceRef="plan_tp_second" targetRef="join_plan" />
    <bpmn:sequenceFlow id="f-plan_tp_team-join_plan" sourceRef="plan_tp_team" targetRef="join_plan" />
    <bpmn:sequenceFlow id="f-plan_tp_psych-join_plan" sourceRef="plan_tp_psych" targetRef="join_plan" />
    <bpmn:sequenceFlow id="f-join_plan-ended" sourceRef="join_plan" targetRef="ended" />
  </bpmn:process>
</bpmn:definitions>
