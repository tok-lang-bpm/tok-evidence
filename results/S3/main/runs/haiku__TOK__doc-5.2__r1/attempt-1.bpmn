<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnapp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Vacation needed" />
    <bpmn:task id="submit" name="Submit the vacation request" />
    <bpmn:task id="register" name="Register the vacation request" />
    <bpmn:task id="review" name="Review the rejection reasons" />
    <bpmn:endEvent id="returned" name="Application returned to the employee" />
    <bpmn:task id="receive" name="Receive the vacation request" />
    <bpmn:exclusiveGateway id="decide" name="Request approved?" />
    <bpmn:task id="approve" name="Approve the vacation request" />
    <bpmn:task id="reject" name="Reject the vacation request" />
    <bpmn:task id="returnapp" name="Return the application to the employee" />
    <bpmn:task id="notify" name="Generate the notification to the Human Resources Representative" />
    <bpmn:task id="complete" name="Complete the management procedures" />
    <bpmn:endEvent id="done" name="Vacation request processed" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decide" sourceRef="receive" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-approve" name="yes" sourceRef="decide" targetRef="approve" />
    <bpmn:sequenceFlow id="f-decide-reject" name="no" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-approve-notify" sourceRef="approve" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-complete" sourceRef="notify" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-done" sourceRef="complete" targetRef="done" />
    <bpmn:sequenceFlow id="f-reject-returnapp" sourceRef="reject" targetRef="returnapp" />
    <bpmn:sequenceFlow id="f-returnapp-review" sourceRef="returnapp" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-returned" sourceRef="review" targetRef="returned" />
  </bpmn:process>
</bpmn:definitions>
