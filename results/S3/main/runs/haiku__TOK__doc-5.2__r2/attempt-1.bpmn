<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-back</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Vacation request needed" />
    <bpmn:task id="submit" name="Submit the vacation request" />
    <bpmn:task id="review" name="Review the rejection reasons" />
    <bpmn:endEvent id="returned" name="Vacation request returned" />
    <bpmn:task id="register" name="Register the vacation request" />
    <bpmn:task id="notify" name="Generate the notification" />
    <bpmn:task id="recv" name="Receive the vacation request" />
    <bpmn:task id="decide" name="Approve or reject the request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" />
    <bpmn:task id="give-back" name="Return the application to the employee" />
    <bpmn:task id="complete" name="Complete the management procedures" />
    <bpmn:endEvent id="handled" name="Vacation request processed" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-recv" sourceRef="register" targetRef="recv" />
    <bpmn:sequenceFlow id="f-recv-decide" sourceRef="recv" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-approved" sourceRef="decide" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-notify" name="yes" sourceRef="approved" targetRef="notify" />
    <bpmn:sequenceFlow id="f-approved-give-back" name="no" sourceRef="approved" targetRef="give-back" />
    <bpmn:sequenceFlow id="f-notify-complete" sourceRef="notify" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-handled" sourceRef="complete" targetRef="handled" />
    <bpmn:sequenceFlow id="f-give-back-review" sourceRef="give-back" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-returned" sourceRef="review" targetRef="returned" />
  </bpmn:process>
</bpmn:definitions>
