tok 1.0 "Vacations Request"

pool org "Organization"
  lane employee "Employee"
    start needed "Vacation request needed"
    task submit "Submit the vacation request"
    task review "Review the rejection reasons"
    end returned "Vacation request returned"
  lane system "System"
    task register "Register the vacation request"
    task notify "Generate the notification"
  lane supervisor "Immediate supervisor"
    task recv "Receive the vacation request"
    task decide "Approve or reject the request"
    xor approved "Request approved?"
    task give-back "Return the application to the employee"
  lane hr "Human Resources Representative"
    task complete "Complete the management procedures"
    end handled "Vacation request processed"

flow needed -> submit -> register -> recv -> decide -> approved
flow approved -> notify "yes"
flow approved -> give-back "no"
flow notify -> complete -> handled
flow give-back -> review -> returned
