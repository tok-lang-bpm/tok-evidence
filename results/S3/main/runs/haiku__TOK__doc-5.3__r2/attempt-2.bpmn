<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Office supply request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Office supply request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>genOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="purchase" name="Purchase department">
        <bpmn:flowNodeRef>quotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Office supply needed" />
    <bpmn:task id="submit" name="Submit an office supply request" />
    <bpmn:task id="review" name="Review the comments for the change" />
    <bpmn:endEvent id="changed" name="Change requested" />
    <bpmn:task id="register" name="Register the requirement" />
    <bpmn:task id="notifyChange" name="Notify the user of the change request" />
    <bpmn:task id="notifyReject" name="Notify the user of the rejection" />
    <bpmn:task id="notifyApproval" name="Notify the user of the approval" />
    <bpmn:task id="genOrder" name="Generate the purchase order" />
    <bpmn:task id="sendOrder" name="Send the purchase order" />
    <bpmn:task id="notifyResult" name="Notify the user of the result" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="completed" name="Request completed" />
    <bpmn:task id="receive" name="Receive the office supply request" />
    <bpmn:exclusiveGateway id="decide" name="Approve, request a change or reject?" />
    <bpmn:task id="approve" name="Approve the request" />
    <bpmn:task id="requestChange" name="Request a change" />
    <bpmn:task id="reject" name="Reject the request" />
    <bpmn:subProcess id="quotes" name="Make the quotations">
      <bpmn:startEvent id="quoteNeeded" name="Quotations needed" />
      <bpmn:task id="requestQuotes" name="Request the vendor quotations" />
      <bpmn:endEvent id="quotesDone" name="Quotations made" />
      <bpmn:sequenceFlow id="f-quoteNeeded-requestQuotes" sourceRef="quoteNeeded" targetRef="requestQuotes" />
      <bpmn:sequenceFlow id="f-requestQuotes-quotesDone" sourceRef="requestQuotes" targetRef="quotesDone" />
    </bpmn:subProcess>
    <bpmn:task id="select" name="Select a vendor" />
    <bpmn:exclusiveGateway id="valid" name="Vendor valid in the system?" />
    <bpmn:task id="choose" name="Choose a different vendor" />
    <bpmn:task id="confirm" name="Confirm the selected vendor" />
    <bpmn:parallelGateway id="dispatch" />
    <bpmn:task id="deliver" name="Receive the delivered product" />
    <bpmn:task id="invoice" name="Receive the invoice" />
    <bpmn:parallelGateway id="received" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decide" sourceRef="receive" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-approve" name="approved" sourceRef="decide" targetRef="approve" />
    <bpmn:sequenceFlow id="f-decide-requestChange" name="change required" sourceRef="decide" targetRef="requestChange" />
    <bpmn:sequenceFlow id="f-decide-reject" name="rejected" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-approve-notifyApproval" sourceRef="approve" targetRef="notifyApproval" />
    <bpmn:sequenceFlow id="f-notifyApproval-quotes" sourceRef="notifyApproval" targetRef="quotes" />
    <bpmn:sequenceFlow id="f-requestChange-notifyChange" sourceRef="requestChange" targetRef="notifyChange" />
    <bpmn:sequenceFlow id="f-notifyChange-review" sourceRef="notifyChange" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-changed" sourceRef="review" targetRef="changed" />
    <bpmn:sequenceFlow id="f-reject-notifyReject" sourceRef="reject" targetRef="notifyReject" />
    <bpmn:sequenceFlow id="f-notifyReject-rejected" sourceRef="notifyReject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-quotes-select" sourceRef="quotes" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-valid" sourceRef="select" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-confirm" name="yes" sourceRef="valid" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-valid-choose" name="no" sourceRef="valid" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-valid" sourceRef="choose" targetRef="valid" />
    <bpmn:sequenceFlow id="f-confirm-genOrder" sourceRef="confirm" targetRef="genOrder" />
    <bpmn:sequenceFlow id="f-genOrder-sendOrder" sourceRef="genOrder" targetRef="sendOrder" />
    <bpmn:sequenceFlow id="f-sendOrder-dispatch" sourceRef="sendOrder" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-deliver" sourceRef="dispatch" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-received" sourceRef="deliver" targetRef="received" />
    <bpmn:sequenceFlow id="f-dispatch-invoice" sourceRef="dispatch" targetRef="invoice" />
    <bpmn:sequenceFlow id="f-invoice-received" sourceRef="invoice" targetRef="received" />
    <bpmn:sequenceFlow id="f-received-notifyResult" sourceRef="received" targetRef="notifyResult" />
    <bpmn:sequenceFlow id="f-notifyResult-completed" sourceRef="notifyResult" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
