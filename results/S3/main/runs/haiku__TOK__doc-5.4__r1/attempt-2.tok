tok 1.0 "Expense report handling"

pool org "Organisation"
  lane employee "Employee"
    start needed "Product or service required"
    task purchase "Purchase the product or service"
    task submit "Submit the expense report with the list of items and receipts"
    task edit "Edit the expense report"
  lane supervisor "Supervisor"
    xor rules "Expense rules decide on first inspection?"
    task decide "Accept or reject the report by expense rules"
    task review "Review the expense report"
    xor approved "Report approved?"
  lane treasurer "Treasurer"
    task check "Check that all receipts are submitted and match the items"
    xor complete "All receipts submitted and matching?"
    task accept "Accept the expenses for processing"
    task sendback "Send the report back to the employee"
  lane payment "Payment system"
    service pay "Link the report to the payment system"
    catch confirmed "Payment confirmed" message="Payment confirmed"
    end done "Process ended"

flow needed -> purchase -> submit -> rules
flow rules -> decide "yes" when="rules_decide = true"
flow rules -> review "no" default
flow decide -> approved
flow review -> approved
flow approved -> check "yes"
flow approved -> edit "no"
flow check -> complete
flow complete -> accept "yes"
flow complete -> sendback "no"
flow accept -> pay
flow pay -> confirmed -> done
flow sendback -> edit
flow edit -> review
