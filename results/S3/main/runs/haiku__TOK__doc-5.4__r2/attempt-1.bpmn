<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense report approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Payment_confirmed" name="Payment confirmed" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense report approval" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmitted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payments" name="Payment system">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase the required product or service" />
    <bpmn:task id="submit" name="Submit the expense report with the item list and receipts" />
    <bpmn:task id="edit" name="Edit the expense report" />
    <bpmn:exclusiveGateway id="resubmitted" />
    <bpmn:exclusiveGateway id="rules" name="Expense rules decide on first inspection?" />
    <bpmn:task id="inspect" name="Accept or reject the report on first inspection" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:task id="decide" name="Approve or reject the expense report" />
    <bpmn:exclusiveGateway id="decided" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:task id="check" name="Check that all receipts are submitted and match the items" />
    <bpmn:exclusiveGateway id="inorder" name="Receipts complete and matching?" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:task id="return" name="Send the report back to the employee" />
    <bpmn:serviceTask id="pay" name="Link the report to the payment system" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Payment confirmed">
      <bpmn:messageEventDefinition id="confirmed-def" messageRef="Message_Payment_confirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="paid" name="Expenses paid" />
    <bpmn:sequenceFlow id="f-needed-purchase" sourceRef="needed" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-resubmitted" sourceRef="submit" targetRef="resubmitted" />
    <bpmn:sequenceFlow id="f-resubmitted-rules" sourceRef="resubmitted" targetRef="rules" />
    <bpmn:sequenceFlow id="f-rules-inspect" name="yes" sourceRef="rules" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-rules-review" name="no" sourceRef="rules" targetRef="review" />
    <bpmn:sequenceFlow id="f-inspect-decided" sourceRef="inspect" targetRef="decided" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-decided" sourceRef="decide" targetRef="decided" />
    <bpmn:sequenceFlow id="f-decided-approved" sourceRef="decided" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-check" name="yes" sourceRef="approved" targetRef="check" />
    <bpmn:sequenceFlow id="f-approved-edit" name="no" sourceRef="approved" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-resubmitted" sourceRef="edit" targetRef="resubmitted" />
    <bpmn:sequenceFlow id="f-check-inorder" sourceRef="check" targetRef="inorder" />
    <bpmn:sequenceFlow id="f-inorder-accept" name="yes" sourceRef="inorder" targetRef="accept" />
    <bpmn:sequenceFlow id="f-inorder-return" name="no" sourceRef="inorder" targetRef="return" />
    <bpmn:sequenceFlow id="f-return-edit" sourceRef="return" targetRef="edit" />
    <bpmn:sequenceFlow id="f-accept-pay" sourceRef="accept" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-confirmed" sourceRef="pay" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-paid" sourceRef="confirmed" targetRef="paid" />
  </bpmn:process>
</bpmn:definitions>
