<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="ACME invoice processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="ACME invoice processing" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>startInv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveInv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardAcc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createInst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noteCC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDocket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consultQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolvedAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardComm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaintRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payInstr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closeInst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ccm" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>okQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveAP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectAP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnAccRej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mail" name="Internal mail">
        <bpmn:flowNodeRef>routedQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnAcc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaintQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvePay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amountQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sigMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnSig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>fourEyes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startInv" name="Invoice received on paper or by fax" />
    <bpmn:task id="receiveInv" name="Receive the invoice in the central inbox" />
    <bpmn:task id="inspect" name="Inspect the invoice visually" />
    <bpmn:task id="forwardAcc" name="Forward the invoice to an accounting employee" />
    <bpmn:task id="identify" name="Identify the charging suppliers" />
    <bpmn:task id="createInst" name="Create a new invoice instance in ACME Financial Accounting" />
    <bpmn:task id="checkItems" name="Check the invoice items" />
    <bpmn:task id="noteCC" name="Note the cost center and cost center managers for each position on the docket" />
    <bpmn:task id="sendDocket" name="Send the docket and copy of the invoice to the first cost center manager" />
    <bpmn:task id="clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:exclusiveGateway id="consultQ" name="Consult cost center managers?" />
    <bpmn:task id="consult" name="Consult the cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="resolvedAll" />
    <bpmn:task id="resend" name="Send the copy of the invoice to the cost center managers again" />
    <bpmn:task id="forwardComm" name="Forward the copy of the invoice to the commercial manager" />
    <bpmn:task id="complaintRes" name="Resolve the complaint with the supplier" />
    <bpmn:task id="payInstr" name="Give payment instructions" />
    <bpmn:task id="closeInst" name="Close the instance in ACME Financial Accounting" />
    <bpmn:endEvent id="endDone" name="Invoice processed" />
    <bpmn:task id="review" name="Review the content for accuracy" />
    <bpmn:exclusiveGateway id="okQ" name="Everything in order?" />
    <bpmn:task id="approveAP" name="Note the AP code on the docket" />
    <bpmn:task id="rejectAP" name="Reject the AP with note and explanation on the docket" />
    <bpmn:task id="returnMail" name="Return the copy of the invoice to internal mail" />
    <bpmn:task id="returnAccRej" name="Send the copy of the invoice back to accounting" />
    <bpmn:exclusiveGateway id="routedQ" name="All positions marked AP?" />
    <bpmn:task id="passNext" name="Pass the copy of the invoice to the next cost center manager on the docket" />
    <bpmn:task id="returnAcc" name="Send the copy of the invoice back to accounting" />
    <bpmn:task id="audit" name="Make the commercial audit" />
    <bpmn:exclusiveGateway id="complaintQ" name="Complaint raised?" />
    <bpmn:task id="approvePay" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="amountQ" name="Amount above EUR 20?" />
    <bpmn:exclusiveGateway id="sigMerge" />
    <bpmn:task id="returnSig" name="Return the copy of the invoice and docket to accounting in the signature file" />
    <bpmn:task id="fourEyes" name="Check the invoice again (4-eyes principle)" />
    <bpmn:sequenceFlow id="f-startInv-receiveInv" sourceRef="startInv" targetRef="receiveInv" />
    <bpmn:sequenceFlow id="f-receiveInv-inspect" sourceRef="receiveInv" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forwardAcc" sourceRef="inspect" targetRef="forwardAcc" />
    <bpmn:sequenceFlow id="f-forwardAcc-identify" sourceRef="forwardAcc" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-createInst" sourceRef="identify" targetRef="createInst" />
    <bpmn:sequenceFlow id="f-createInst-checkItems" sourceRef="createInst" targetRef="checkItems" />
    <bpmn:sequenceFlow id="f-checkItems-noteCC" sourceRef="checkItems" targetRef="noteCC" />
    <bpmn:sequenceFlow id="f-noteCC-sendDocket" sourceRef="noteCC" targetRef="sendDocket" />
    <bpmn:sequenceFlow id="f-sendDocket-review" sourceRef="sendDocket" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-okQ" sourceRef="review" targetRef="okQ" />
    <bpmn:sequenceFlow id="f-okQ-approveAP" name="yes" sourceRef="okQ" targetRef="approveAP" />
    <bpmn:sequenceFlow id="f-okQ-rejectAP" name="no" sourceRef="okQ" targetRef="rejectAP" />
    <bpmn:sequenceFlow id="f-approveAP-returnMail" sourceRef="approveAP" targetRef="returnMail" />
    <bpmn:sequenceFlow id="f-returnMail-routedQ" sourceRef="returnMail" targetRef="routedQ" />
    <bpmn:sequenceFlow id="f-routedQ-passNext" name="no" sourceRef="routedQ" targetRef="passNext" />
    <bpmn:sequenceFlow id="f-passNext-review" sourceRef="passNext" targetRef="review" />
    <bpmn:sequenceFlow id="f-routedQ-returnAcc" name="yes" sourceRef="routedQ" targetRef="returnAcc" />
    <bpmn:sequenceFlow id="f-returnAcc-forwardComm" sourceRef="returnAcc" targetRef="forwardComm" />
    <bpmn:sequenceFlow id="f-rejectAP-returnAccRej" sourceRef="rejectAP" targetRef="returnAccRej" />
    <bpmn:sequenceFlow id="f-returnAccRej-clarify" sourceRef="returnAccRej" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consultQ" sourceRef="clarify" targetRef="consultQ" />
    <bpmn:sequenceFlow id="f-consultQ-consult" name="yes" sourceRef="consultQ" targetRef="consult" />
    <bpmn:sequenceFlow id="f-consultQ-resolvedAll" name="no" sourceRef="consultQ" targetRef="resolvedAll" />
    <bpmn:sequenceFlow id="f-consult-resolvedAll" sourceRef="consult" targetRef="resolvedAll" />
    <bpmn:sequenceFlow id="f-resolvedAll-resend" sourceRef="resolvedAll" targetRef="resend" />
    <bpmn:sequenceFlow id="f-resend-review" sourceRef="resend" targetRef="review" />
    <bpmn:sequenceFlow id="f-forwardComm-audit" sourceRef="forwardComm" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaintQ" sourceRef="audit" targetRef="complaintQ" />
    <bpmn:sequenceFlow id="f-complaintQ-complaintRes" name="yes" sourceRef="complaintQ" targetRef="complaintRes" />
    <bpmn:sequenceFlow id="f-complaintRes-audit" sourceRef="complaintRes" targetRef="audit" />
    <bpmn:sequenceFlow id="f-complaintQ-approvePay" name="no" sourceRef="complaintQ" targetRef="approvePay" />
    <bpmn:sequenceFlow id="f-approvePay-amountQ" sourceRef="approvePay" targetRef="amountQ" />
    <bpmn:sequenceFlow id="f-amountQ-fourEyes" name="yes" sourceRef="amountQ" targetRef="fourEyes" />
    <bpmn:sequenceFlow id="f-amountQ-sigMerge" name="no" sourceRef="amountQ" targetRef="sigMerge" />
    <bpmn:sequenceFlow id="f-fourEyes-sigMerge" sourceRef="fourEyes" targetRef="sigMerge" />
    <bpmn:sequenceFlow id="f-sigMerge-returnSig" sourceRef="sigMerge" targetRef="returnSig" />
    <bpmn:sequenceFlow id="f-returnSig-payInstr" sourceRef="returnSig" targetRef="payInstr" />
    <bpmn:sequenceFlow id="f-payInstr-closeInst" sourceRef="payInstr" targetRef="closeInst" />
    <bpmn:sequenceFlow id="f-closeInst-endDone" sourceRef="closeInst" targetRef="endDone" />
  </bpmn:process>
</bpmn:definitions>
