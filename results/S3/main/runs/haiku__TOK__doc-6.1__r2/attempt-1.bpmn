<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice processing at ACME AG" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice processing at ACME AG" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="sec" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Accounting employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consultq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolvedq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cc" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>okq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>markap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nextq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passnext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retacc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cm" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaintq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amountq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>boardcheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnsig</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received on paper or fax" />
    <bpmn:task id="inbox" name="Receive the invoice in the central inbox" />
    <bpmn:task id="inspect" name="Inspect the invoice visually" />
    <bpmn:task id="forward" name="Forward the invoice to an accounting employee" />
    <bpmn:task id="identify" name="Identify the charging suppliers" />
    <bpmn:task id="create" name="Create a new invoice instance in ACME Financial Accounting" />
    <bpmn:task id="checkitems" name="Check the invoice items" />
    <bpmn:task id="note" name="Note the cost center and cost center managers for each position on the docket" />
    <bpmn:task id="sendmail" name="Send the docket and invoice copy to internal mail" />
    <bpmn:task id="clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:exclusiveGateway id="consultq" name="Consultation necessary?" />
    <bpmn:task id="consult" name="Consult the cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="resolvedq" name="Inconsistencies resolved?" />
    <bpmn:task id="resend" name="Send the invoice copy again to the cost center managers" />
    <bpmn:task id="commercial" name="Forward the invoice copy to the commercial manager" />
    <bpmn:task id="complaint" name="Resolve the complaint with the supplier" />
    <bpmn:task id="instr" name="Give payment instructions" />
    <bpmn:task id="close" name="Close the instance in ACME Financial Accounting" />
    <bpmn:endEvent id="closed" name="Invoice closed" />
    <bpmn:task id="review" name="Review the invoice content for accuracy" />
    <bpmn:exclusiveGateway id="okq" name="Everything in order?" />
    <bpmn:task id="markap" name="Mark the position as accurate (AP) on the docket" />
    <bpmn:task id="retmail" name="Return the invoice copy to internal mail" />
    <bpmn:exclusiveGateway id="nextq" name="Further cost center manager on the docket?" />
    <bpmn:task id="passnext" name="Pass the invoice copy on to the next cost center manager" />
    <bpmn:task id="toacc" name="Send the invoice copy back to accounting" />
    <bpmn:task id="reject" name="Reject the position with a note and explanation on the docket" />
    <bpmn:task id="retacc" name="Send the invoice copy back to accounting directly" />
    <bpmn:task id="audit" name="Perform the commercial audit" />
    <bpmn:exclusiveGateway id="complaintq" name="Complaint raised?" />
    <bpmn:task id="approve" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="amountq" name="Amount above EUR 20?" />
    <bpmn:task id="boardcheck" name="Check the invoice again (four-eyes principle)" />
    <bpmn:task id="returnsig" name="Return the invoice copy with the docket to accounting in the signature file" />
    <bpmn:sequenceFlow id="f-received-inbox" sourceRef="received" targetRef="inbox" />
    <bpmn:sequenceFlow id="f-inbox-inspect" sourceRef="inbox" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-identify" sourceRef="forward" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-checkitems" sourceRef="create" targetRef="checkitems" />
    <bpmn:sequenceFlow id="f-checkitems-note" sourceRef="checkitems" targetRef="note" />
    <bpmn:sequenceFlow id="f-note-sendmail" sourceRef="note" targetRef="sendmail" />
    <bpmn:sequenceFlow id="f-sendmail-review" sourceRef="sendmail" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-okq" sourceRef="review" targetRef="okq" />
    <bpmn:sequenceFlow id="f-okq-markap" name="yes" sourceRef="okq" targetRef="markap" />
    <bpmn:sequenceFlow id="f-okq-reject" name="no" sourceRef="okq" targetRef="reject" />
    <bpmn:sequenceFlow id="f-markap-retmail" sourceRef="markap" targetRef="retmail" />
    <bpmn:sequenceFlow id="f-retmail-nextq" sourceRef="retmail" targetRef="nextq" />
    <bpmn:sequenceFlow id="f-nextq-passnext" name="yes" sourceRef="nextq" targetRef="passnext" />
    <bpmn:sequenceFlow id="f-nextq-toacc" name="no" sourceRef="nextq" targetRef="toacc" />
    <bpmn:sequenceFlow id="f-passnext-review" sourceRef="passnext" targetRef="review" />
    <bpmn:sequenceFlow id="f-toacc-commercial" sourceRef="toacc" targetRef="commercial" />
    <bpmn:sequenceFlow id="f-reject-retacc" sourceRef="reject" targetRef="retacc" />
    <bpmn:sequenceFlow id="f-retacc-clarify" sourceRef="retacc" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consultq" sourceRef="clarify" targetRef="consultq" />
    <bpmn:sequenceFlow id="f-consultq-consult" name="yes" sourceRef="consultq" targetRef="consult" />
    <bpmn:sequenceFlow id="f-consultq-resolvedq" name="no" sourceRef="consultq" targetRef="resolvedq" />
    <bpmn:sequenceFlow id="f-consult-resolvedq" sourceRef="consult" targetRef="resolvedq" />
    <bpmn:sequenceFlow id="f-resolvedq-resend" name="yes" sourceRef="resolvedq" targetRef="resend" />
    <bpmn:sequenceFlow id="f-resolvedq-clarify" name="no" sourceRef="resolvedq" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-resend-review" sourceRef="resend" targetRef="review" />
    <bpmn:sequenceFlow id="f-commercial-audit" sourceRef="commercial" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaintq" sourceRef="audit" targetRef="complaintq" />
    <bpmn:sequenceFlow id="f-complaintq-complaint" name="yes" sourceRef="complaintq" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaintq-approve" name="no" sourceRef="complaintq" targetRef="approve" />
    <bpmn:sequenceFlow id="f-complaint-audit" sourceRef="complaint" targetRef="audit" />
    <bpmn:sequenceFlow id="f-approve-amountq" sourceRef="approve" targetRef="amountq" />
    <bpmn:sequenceFlow id="f-amountq-boardcheck" name="yes" sourceRef="amountq" targetRef="boardcheck" />
    <bpmn:sequenceFlow id="f-amountq-instr" name="no" sourceRef="amountq" targetRef="instr" />
    <bpmn:sequenceFlow id="f-boardcheck-returnsig" sourceRef="boardcheck" targetRef="returnsig" />
    <bpmn:sequenceFlow id="f-returnsig-instr" sourceRef="returnsig" targetRef="instr" />
    <bpmn:sequenceFlow id="f-instr-close" sourceRef="instr" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-closed" sourceRef="close" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
