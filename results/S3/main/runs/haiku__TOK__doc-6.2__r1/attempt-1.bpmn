<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Monthly product parts ordering" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Order" name="Order" />
  <bpmn:message id="Message_Invoice" name="Invoice" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="assembler" name="Assembler AG" processRef="assembler-process" />
  </bpmn:collaboration>
  <bpmn:process id="assembler-process" name="Monthly product parts ordering" isExecutable="false">
    <bpmn:laneSet id="assembler-lanes">
      <bpmn:lane id="buyer" name="Assembler AG">
        <bpmn:flowNodeRef>monthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendinvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthly" name="Process starts on the first of each month">
      <bpmn:timerEventDefinition id="monthly-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="place" name="Place the order with the supplier" />
    <bpmn:sendTask id="order" name="Send the order to the supplier" messageRef="Message_Order" />
    <bpmn:receiveTask id="invoice" name="Receive the invoice" messageRef="Message_Invoice" />
    <bpmn:endEvent id="done" name="Order cycle completed" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:sendTask id="sendinvoice" name="Send the invoice to Assembler AG" messageRef="Message_Invoice" />
    <bpmn:sequenceFlow id="f-monthly-place" sourceRef="monthly" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-order" sourceRef="place" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-process" sourceRef="order" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-sendinvoice" sourceRef="process" targetRef="sendinvoice" />
    <bpmn:sequenceFlow id="f-sendinvoice-invoice" sourceRef="sendinvoice" targetRef="invoice" />
    <bpmn:sequenceFlow id="f-invoice-done" sourceRef="invoice" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
