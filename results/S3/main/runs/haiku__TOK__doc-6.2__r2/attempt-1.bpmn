<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Monthly order and invoice" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="assembler" name="Assembler AG and supplier" processRef="assembler-process" />
  </bpmn:collaboration>
  <bpmn:process id="assembler-process" name="Monthly order and invoice" isExecutable="false">
    <bpmn:laneSet id="assembler-lanes">
      <bpmn:lane id="buyer" name="Assembler AG">
        <bpmn:flowNodeRef>monthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveinvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>processorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendinvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthly" name="First of each month">
      <bpmn:timerEventDefinition id="monthly-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="sendorder" name="Send the order to the supplier" />
    <bpmn:task id="receiveinvoice" name="Receive the invoice" />
    <bpmn:endEvent id="received" name="Invoice received" />
    <bpmn:task id="processorder" name="Process the order" />
    <bpmn:task id="sendinvoice" name="Send the invoice to Assembler AG" />
    <bpmn:sequenceFlow id="f-monthly-sendorder" sourceRef="monthly" targetRef="sendorder" />
    <bpmn:sequenceFlow id="f-sendorder-processorder" sourceRef="sendorder" targetRef="processorder" />
    <bpmn:sequenceFlow id="f-processorder-sendinvoice" sourceRef="processorder" targetRef="sendinvoice" />
    <bpmn:sequenceFlow id="f-sendinvoice-receiveinvoice" sourceRef="sendinvoice" targetRef="receiveinvoice" />
    <bpmn:sequenceFlow id="f-receiveinvoice-received" sourceRef="receiveinvoice" targetRef="received" />
  </bpmn:process>
</bpmn:definitions>
