tok 1.0 "Monthly order and invoice"

pool assembler "Assembler AG and supplier"
  lane buyer "Assembler AG"
    start monthly "First of each month" timer=P1M
    task sendorder "Send the order to the supplier"
    task receiveinvoice "Receive the invoice"
    end received "Invoice received"
  lane supplier "Supplier"
    task processorder "Process the order"
    task sendinvoice "Send the invoice to Assembler AG"

flow monthly -> sendorder -> processorder -> sendinvoice -> receiveinvoice -> received
