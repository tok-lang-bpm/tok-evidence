<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Sales process for potential customers" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_contacts_us" name="Customer contacts us" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Company" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Sales process for potential customers" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquaintance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cameback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tooLong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quotemerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endint</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>salespres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>techpres</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Contact details of potential customers needed" />
    <bpmn:exclusiveGateway id="source" name="Which way to get the contact details?" />
    <bpmn:task id="buy" name="Buy contact details for cold calls" />
    <bpmn:task id="acquaintance" name="Get contact details of an acquaintance interested in the product" />
    <bpmn:exclusiveGateway id="found" name="Contact details obtained" />
    <bpmn:exclusiveGateway id="presplit" name="Which presentation?" />
    <bpmn:exclusiveGateway id="presdone" name="Presentation given" />
    <bpmn:eventBasedGateway id="wait" name="Customer comes back?" />
    <bpmn:intermediateCatchEvent id="cameback" name="Customer comes back">
      <bpmn:messageEventDefinition id="cameback-def" messageRef="Message_Customer_contacts_us" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tooLong" name="No contact within 2 weeks">
      <bpmn:timerEventDefinition id="tooLong-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="quotemerge" name="Customer contacted" />
    <bpmn:task id="quote" name="Create a quotation" />
    <bpmn:endEvent id="finished" name="Quotation created" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="call" name="Call the potential customer" />
    <bpmn:task id="determine" name="Determine the contact person and the budget" />
    <bpmn:task id="ask" name="Ask whether the customer is generally interested" />
    <bpmn:exclusiveGateway id="gen" name="Generally interested?" />
    <bpmn:exclusiveGateway id="huge" name="Potential budget huge?" />
    <bpmn:task id="leave" name="Leave the customer alone" />
    <bpmn:exclusiveGateway id="ready" name="Customer interested?" />
    <bpmn:endEvent id="gone" name="Customer left alone" />
    <bpmn:task id="acquire" name="Acquire the customer personally" />
    <bpmn:exclusiveGateway id="endint" name="Customer interested in the end?" />
    <bpmn:task id="salespres" name="Give detailed online presentation" />
    <bpmn:task id="callback" name="Call the customer" />
    <bpmn:task id="techpres" name="Give detailed technical online presentation" />
    <bpmn:sequenceFlow id="f-needed-source" sourceRef="needed" targetRef="source" />
    <bpmn:sequenceFlow id="f-source-buy" name="cold calls" sourceRef="source" targetRef="buy" />
    <bpmn:sequenceFlow id="f-source-exhibit" name="exhibitions" sourceRef="source" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-source-acquaintance" name="acquaintance" sourceRef="source" targetRef="acquaintance" />
    <bpmn:sequenceFlow id="f-buy-found" sourceRef="buy" targetRef="found" />
    <bpmn:sequenceFlow id="f-exhibit-found" sourceRef="exhibit" targetRef="found" />
    <bpmn:sequenceFlow id="f-acquaintance-found" sourceRef="acquaintance" targetRef="found" />
    <bpmn:sequenceFlow id="f-found-call" sourceRef="found" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-determine" sourceRef="call" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-ask" sourceRef="determine" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-gen" sourceRef="ask" targetRef="gen" />
    <bpmn:sequenceFlow id="f-gen-ready" name="yes" sourceRef="gen" targetRef="ready" />
    <bpmn:sequenceFlow id="f-gen-huge" name="no" sourceRef="gen" targetRef="huge" />
    <bpmn:sequenceFlow id="f-huge-acquire" name="yes" sourceRef="huge" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-huge-leave" name="no" sourceRef="huge" targetRef="leave" />
    <bpmn:sequenceFlow id="f-acquire-endint" sourceRef="acquire" targetRef="endint" />
    <bpmn:sequenceFlow id="f-endint-ready" name="yes" sourceRef="endint" targetRef="ready" />
    <bpmn:sequenceFlow id="f-endint-leave" name="no" sourceRef="endint" targetRef="leave" />
    <bpmn:sequenceFlow id="f-leave-gone" sourceRef="leave" targetRef="gone" />
    <bpmn:sequenceFlow id="f-ready-presplit" sourceRef="ready" targetRef="presplit" />
    <bpmn:sequenceFlow id="f-presplit-salespres" name="standard" sourceRef="presplit" targetRef="salespres" />
    <bpmn:sequenceFlow id="f-presplit-techpres" name="technical" sourceRef="presplit" targetRef="techpres" />
    <bpmn:sequenceFlow id="f-salespres-presdone" sourceRef="salespres" targetRef="presdone" />
    <bpmn:sequenceFlow id="f-techpres-presdone" sourceRef="techpres" targetRef="presdone" />
    <bpmn:sequenceFlow id="f-presdone-wait" sourceRef="presdone" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-cameback" sourceRef="wait" targetRef="cameback" />
    <bpmn:sequenceFlow id="f-wait-tooLong" sourceRef="wait" targetRef="tooLong" />
    <bpmn:sequenceFlow id="f-cameback-quotemerge" sourceRef="cameback" targetRef="quotemerge" />
    <bpmn:sequenceFlow id="f-tooLong-callback" sourceRef="tooLong" targetRef="callback" />
    <bpmn:sequenceFlow id="f-callback-quotemerge" sourceRef="callback" targetRef="quotemerge" />
    <bpmn:sequenceFlow id="f-quotemerge-quote" sourceRef="quotemerge" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-finished" sourceRef="quote" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
