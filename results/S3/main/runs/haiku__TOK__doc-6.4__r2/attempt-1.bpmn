<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="sales" name="Sales organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>known</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sourced</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="headdev" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Sales representative / pre-sales employee">
        <bpmn:flowNodeRef>kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>online</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>techonline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lost</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Potential customer needed" />
    <bpmn:exclusiveGateway id="source" name="Contact source?" />
    <bpmn:task id="buy" name="Buy contact details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="known" name="Obtain contact via acquaintance" />
    <bpmn:exclusiveGateway id="sourced" name="Contact details obtained" />
    <bpmn:task id="call" name="Call the customer" />
    <bpmn:task id="determine" name="Determine contact person and available budget" />
    <bpmn:task id="ask" name="Ask whether the customer is generally interested" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="budget" name="Potential project budget huge?" default="f-budget-lost" />
    <bpmn:task id="leave" name="Leave the customer alone" />
    <bpmn:task id="acquire" name="Personally acquire the customer" />
    <bpmn:exclusiveGateway id="kind" name="Technical presentation?" />
    <bpmn:task id="online" name="Give detailed online presentation (sales representative)" />
    <bpmn:task id="techonline" name="Give detailed technical online presentation (pre-sales employee)" />
    <bpmn:exclusiveGateway id="back" name="Customer contacted us within 2 weeks?" default="f-back-recall" />
    <bpmn:task id="recall" name="Call the customer" />
    <bpmn:task id="quote" name="Create a quotation" />
    <bpmn:endEvent id="done" name="Quotation created" />
    <bpmn:endEvent id="lost" name="Customer not pursued" />
    <bpmn:sequenceFlow id="f-needed-source" sourceRef="needed" targetRef="source" />
    <bpmn:sequenceFlow id="f-source-buy" name="cold calls" sourceRef="source" targetRef="buy" />
    <bpmn:sequenceFlow id="f-source-exhibit" name="exhibitions" sourceRef="source" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-source-known" name="acquaintance" sourceRef="source" targetRef="known" />
    <bpmn:sequenceFlow id="f-buy-sourced" sourceRef="buy" targetRef="sourced" />
    <bpmn:sequenceFlow id="f-exhibit-sourced" sourceRef="exhibit" targetRef="sourced" />
    <bpmn:sequenceFlow id="f-known-sourced" sourceRef="known" targetRef="sourced" />
    <bpmn:sequenceFlow id="f-sourced-call" sourceRef="sourced" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-determine" sourceRef="call" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-ask" sourceRef="determine" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-interested" sourceRef="ask" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-leave" name="no" sourceRef="interested" targetRef="leave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-interested-kind" name="yes" sourceRef="interested" targetRef="kind">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-leave-budget" sourceRef="leave" targetRef="budget" />
    <bpmn:sequenceFlow id="f-budget-acquire" name="yes" sourceRef="budget" targetRef="acquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-budget-lost" name="no" sourceRef="budget" targetRef="lost" />
    <bpmn:sequenceFlow id="f-acquire-kind" sourceRef="acquire" targetRef="kind" />
    <bpmn:sequenceFlow id="f-kind-online" name="sales representative" sourceRef="kind" targetRef="online" />
    <bpmn:sequenceFlow id="f-kind-techonline" name="pre-sales employee" sourceRef="kind" targetRef="techonline" />
    <bpmn:sequenceFlow id="f-online-back" sourceRef="online" targetRef="back" />
    <bpmn:sequenceFlow id="f-techonline-back" sourceRef="techonline" targetRef="back" />
    <bpmn:sequenceFlow id="f-back-quote" name="yes" sourceRef="back" targetRef="quote">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-back-recall" name="no" sourceRef="back" targetRef="recall" />
    <bpmn:sequenceFlow id="f-recall-quote" sourceRef="recall" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-done" sourceRef="quote" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
