<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Lead processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="sales" name="Sales department" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" name="Lead processing" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="review" name="Lead review needed" />
    <bpmn:task id="check" name="Check the open leads" />
    <bpmn:task id="select" name="Select the top five leads" />
    <bpmn:task id="instruct" name="Tell the Sales Assistant to call the contacts" />
    <bpmn:task id="process" name="Process the lead" />
    <bpmn:endEvent id="processed" name="Lead processed" />
    <bpmn:endEvent id="next" name="Next customer called" />
    <bpmn:task id="call" name="Call the customer" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="note" name="Send a note to the Manager" />
    <bpmn:sequenceFlow id="f-review-check" sourceRef="review" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-instruct" sourceRef="select" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-call" sourceRef="instruct" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-interested" sourceRef="call" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-note" name="yes" sourceRef="interested" targetRef="note" />
    <bpmn:sequenceFlow id="f-note-process" sourceRef="note" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-processed" sourceRef="process" targetRef="processed" />
    <bpmn:sequenceFlow id="f-interested-next" name="no" sourceRef="interested" targetRef="next" />
  </bpmn:process>
</bpmn:definitions>
