<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Post filling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Post filling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Functional department">
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestFill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkApps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="applicants" name="Applicants">
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="demand" name="Demand to fill a post" />
    <bpmn:task id="requestFill" name="Request to fill the post" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="checkApps" name="Check the applications" />
    <bpmn:task id="fill" name="Fill the post" />
    <bpmn:task id="contract" name="Conclude a contract of employment" />
    <bpmn:endEvent id="filled" name="Post filled" />
    <bpmn:task id="apply" name="Apply for the post" />
    <bpmn:sequenceFlow id="f-demand-requestFill" sourceRef="demand" targetRef="requestFill" />
    <bpmn:sequenceFlow id="f-requestFill-advertise" sourceRef="requestFill" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-apply" sourceRef="advertise" targetRef="apply" />
    <bpmn:sequenceFlow id="f-apply-checkApps" sourceRef="apply" targetRef="checkApps" />
    <bpmn:sequenceFlow id="f-checkApps-fill" sourceRef="checkApps" targetRef="fill" />
    <bpmn:sequenceFlow id="f-fill-contract" sourceRef="fill" targetRef="contract" />
    <bpmn:sequenceFlow id="f-contract-filled" sourceRef="contract" targetRef="filled" />
  </bpmn:process>
</bpmn:definitions>
