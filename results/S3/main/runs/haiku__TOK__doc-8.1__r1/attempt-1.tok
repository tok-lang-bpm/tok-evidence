tok 1.0 "Post filling"

pool org "Organisation"
  lane dept "Functional department"
    start demand "Demand to fill a post"
    task requestFill "Request to fill the post"
  lane hr "HR"
    task advertise "Advertise the post"
    task checkApps "Check the applications"
    task fill "Fill the post"
    task contract "Conclude a contract of employment"
    end filled "Post filled"
  lane applicants "Applicants"
    task apply "Apply for the post"

flow demand -> requestFill -> advertise -> apply -> checkApps -> fill -> contract -> filled
