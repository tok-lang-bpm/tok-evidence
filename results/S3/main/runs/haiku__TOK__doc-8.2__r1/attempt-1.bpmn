<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job posting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job posting" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>vacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="clerk" name="HR clerk">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confusing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="vacancy" name="Vacancy reported" />
    <bpmn:task id="report" name="Report the vacancy" />
    <bpmn:exclusiveGateway id="submitted" />
    <bpmn:task id="consider" name="Consider the job description" />
    <bpmn:exclusiveGateway id="approved" name="Description approved?" default="f-approved-request" />
    <bpmn:task id="request" name="Request a correction" />
    <bpmn:task id="create" name="Create the job description" />
    <bpmn:exclusiveGateway id="confusing" name="Message still confusing?" default="f-confusing-clarified" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:exclusiveGateway id="clarified" />
    <bpmn:task id="submit" name="Submit the job description for consideration" />
    <bpmn:task id="correct" name="Correct the job description" />
    <bpmn:task id="resubmit" name="Submit the job description again for consideration" />
    <bpmn:task id="post" name="Post the job" />
    <bpmn:endEvent id="posted" name="Job posted" />
    <bpmn:sequenceFlow id="f-vacancy-report" sourceRef="vacancy" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-create" sourceRef="report" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-confusing" sourceRef="create" targetRef="confusing" />
    <bpmn:sequenceFlow id="f-confusing-ask" name="yes" sourceRef="confusing" targetRef="ask" />
    <bpmn:sequenceFlow id="f-confusing-clarified" name="no" sourceRef="confusing" targetRef="clarified" />
    <bpmn:sequenceFlow id="f-ask-clarified" sourceRef="ask" targetRef="clarified" />
    <bpmn:sequenceFlow id="f-clarified-submit" sourceRef="clarified" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-submitted" sourceRef="submit" targetRef="submitted" />
    <bpmn:sequenceFlow id="f-submitted-consider" sourceRef="submitted" targetRef="consider" />
    <bpmn:sequenceFlow id="f-consider-approved" sourceRef="consider" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-post" name="yes" sourceRef="approved" targetRef="post" />
    <bpmn:sequenceFlow id="f-approved-request" name="no" sourceRef="approved" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-correct" sourceRef="request" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-resubmit" sourceRef="correct" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f-resubmit-submitted" sourceRef="resubmit" targetRef="submitted" />
    <bpmn:sequenceFlow id="f-post-posted" sourceRef="post" targetRef="posted" />
  </bpmn:process>
</bpmn:definitions>
