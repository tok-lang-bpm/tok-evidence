tok 1.0 "Job posting"

pool org "Organisation"
  lane dept "Department"
    start vacancy "Vacancy reported"
    task report "Report the vacancy"
    xor submitted
    task consider "Consider the job description"
    xor approved "Description approved?"
    task request "Request a correction"
  lane clerk "HR clerk"
    task create "Create the job description"
    xor confusing "Message still confusing?"
    task ask "Ask the Department again"
    xor clarified
    task submit "Submit the job description for consideration"
    task correct "Correct the job description"
    task resubmit "Submit the job description again for consideration"
    task post "Post the job"
    end posted "Job posted"

flow vacancy -> report -> create -> confusing
flow confusing -> ask "yes"
flow confusing -> clarified "no" default
flow ask -> clarified
flow clarified -> submit -> submitted
flow submitted -> consider -> approved
flow approved -> post "yes"
flow approved -> request "no" default
flow request -> correct -> resubmit -> submitted
flow post -> posted
