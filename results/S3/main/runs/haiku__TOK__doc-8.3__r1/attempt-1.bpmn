<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Job description approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job description approval" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Personnel requirements detected" />
    <bpmn:task id="detect" name="Detect personnel requirements" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:task id="answer" name="Answer questions about tasks and requirements" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corrections" name="Corrections needed?" default="f-corrections-approve" />
    <bpmn:task id="request" name="Request corrections to the job description" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:exclusiveGateway id="questions" name="Questions about tasks and requirements?" default="f-questions-qmerge" />
    <bpmn:task id="ask" name="Ask questions about tasks and requirements" />
    <bpmn:exclusiveGateway id="qmerge" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="advertise" name="Advertise the job" />
    <bpmn:endEvent id="advertised" name="Job advertised" />
    <bpmn:sequenceFlow id="f-needed-detect" sourceRef="needed" targetRef="detect" />
    <bpmn:sequenceFlow id="f-detect-report" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-questions" sourceRef="report" targetRef="questions" />
    <bpmn:sequenceFlow id="f-questions-ask" name="yes" sourceRef="questions" targetRef="ask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">questions = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-questions-qmerge" name="no" sourceRef="questions" targetRef="qmerge" />
    <bpmn:sequenceFlow id="f-ask-answer" sourceRef="ask" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-qmerge" sourceRef="answer" targetRef="qmerge" />
    <bpmn:sequenceFlow id="f-qmerge-describe" sourceRef="qmerge" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-review" sourceRef="describe" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corrections" sourceRef="review" targetRef="corrections" />
    <bpmn:sequenceFlow id="f-corrections-request" name="yes" sourceRef="corrections" targetRef="request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrections = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-corrections-approve" name="no" sourceRef="corrections" targetRef="approve" />
    <bpmn:sequenceFlow id="f-request-describe" sourceRef="request" targetRef="describe" />
    <bpmn:sequenceFlow id="f-approve-advertise" sourceRef="approve" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-advertised" sourceRef="advertise" targetRef="advertised" />
  </bpmn:process>
</bpmn:definitions>
