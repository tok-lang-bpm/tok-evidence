tok 1.0 "Job description approval"

pool org "Organisation"
  lane head "Head of the functional department"
    start needed "Personnel requirements detected"
    task detect "Detect personnel requirements"
    task report "Report the vacancy to the Personnel Department"
    task answer "Answer questions about tasks and requirements"
    task review "Review the job description"
    xor corrections "Corrections needed?"
    task request "Request corrections to the job description"
    task approve "Approve the job description"
  lane hr "Personnel Department"
    xor questions "Questions about tasks and requirements?"
    task ask "Ask questions about tasks and requirements"
    xor qmerge
    task describe "Describe the job"
    task advertise "Advertise the job"
    end advertised "Job advertised"

flow needed -> detect -> report -> questions
flow questions -> ask "yes" when="questions = true"
flow questions -> qmerge "no" default
flow ask -> answer -> qmerge
flow qmerge -> describe -> review -> corrections
flow corrections -> request "yes" when="corrections = true"
flow corrections -> approve "no" default
flow request -> describe
flow approve -> advertise -> advertised
