<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job vacancy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job vacancy" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivejd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestcorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>receivev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Personnel requirements arise" />
    <bpmn:task id="detect" name="Detect the number of personnel requirements" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:task id="receivejd" name="Receive the job description" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corr" name="Corrections needed?" />
    <bpmn:task id="requestcorr" name="Request corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:task id="answer" name="Answer the questions about tasks and requirements" />
    <bpmn:task id="receivev" name="Receive the vacancy report" />
    <bpmn:exclusiveGateway id="clarq" name="Questions about tasks and requirements?" />
    <bpmn:task id="askq" name="Ask questions about tasks and requirements" />
    <bpmn:exclusiveGateway id="clarmerge" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="submit" name="Submit the job description" />
    <bpmn:task id="revise" name="Revise the job description" />
    <bpmn:task id="advertise" name="Advertise the job description" />
    <bpmn:endEvent id="done" name="Job advertised" />
    <bpmn:sequenceFlow id="f-need-detect" sourceRef="need" targetRef="detect" />
    <bpmn:sequenceFlow id="f-detect-report" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-receivev" sourceRef="report" targetRef="receivev" />
    <bpmn:sequenceFlow id="f-receivev-clarq" sourceRef="receivev" targetRef="clarq" />
    <bpmn:sequenceFlow id="f-clarq-askq" name="yes" sourceRef="clarq" targetRef="askq" />
    <bpmn:sequenceFlow id="f-clarq-clarmerge" name="no" sourceRef="clarq" targetRef="clarmerge" />
    <bpmn:sequenceFlow id="f-askq-answer" sourceRef="askq" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-clarmerge" sourceRef="answer" targetRef="clarmerge" />
    <bpmn:sequenceFlow id="f-clarmerge-describe" sourceRef="clarmerge" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-submit" sourceRef="describe" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-receivejd" sourceRef="submit" targetRef="receivejd" />
    <bpmn:sequenceFlow id="f-receivejd-review" sourceRef="receivejd" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corr" sourceRef="review" targetRef="corr" />
    <bpmn:sequenceFlow id="f-corr-requestcorr" name="yes" sourceRef="corr" targetRef="requestcorr" />
    <bpmn:sequenceFlow id="f-corr-approve" name="no" sourceRef="corr" targetRef="approve" />
    <bpmn:sequenceFlow id="f-requestcorr-revise" sourceRef="requestcorr" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-submit" sourceRef="revise" targetRef="submit" />
    <bpmn:sequenceFlow id="f-approve-advertise" sourceRef="approve" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-done" sourceRef="advertise" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
