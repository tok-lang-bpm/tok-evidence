tok 1.0 "Job vacancy"

pool org "Organisation"
  lane head "Head of the functional department"
    start need "Personnel requirements arise"
    task detect "Detect the number of personnel requirements"
    task report "Report the vacancy to the Personnel Department"
    task receivejd "Receive the job description"
    task review "Review the job description"
    xor corr "Corrections needed?"
    task requestcorr "Request corrections"
    task approve "Approve the job description"
    task answer "Answer the questions about tasks and requirements"
  lane hr "Personnel Department"
    task receivev "Receive the vacancy report"
    xor clarq "Questions about tasks and requirements?"
    task askq "Ask questions about tasks and requirements"
    xor clarmerge
    task describe "Describe the job"
    task submit "Submit the job description"
    task revise "Revise the job description"
    task advertise "Advertise the job description"
    end done "Job advertised"

flow need -> detect -> report -> receivev -> clarq
flow clarq -> askq "yes"
flow clarq -> clarmerge "no"
flow askq -> answer
flow answer -> clarmerge
flow clarmerge -> describe -> submit -> receivejd -> review -> corr
flow corr -> requestcorr "yes"
flow corr -> approve "no"
flow requestcorr -> revise -> submit
flow approve -> advertise -> done
