<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Daily defaulter processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Daily defaulter processing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sys" name="Reporting system">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordsDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCrm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newReturns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noReturns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCrm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newReturns2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noReturns2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>messageSup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Weekday morning" />
    <bpmn:task id="backup" name="Back up the database" />
    <bpmn:task id="checkTable" name="Check the Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="newRecords" name="New records found?" />
    <bpmn:endEvent id="recordsDone" name="Records processed" />
    <bpmn:task id="checkCrm" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="newReturns" name="New returns filed?" />
    <bpmn:endEvent id="noReturns" name="No new returns" />
    <bpmn:task id="register" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="advised" name="Defaulting client codes previously advised?" />
    <bpmn:task id="produceTable" name="Produce a table of defaulting accounts" />
    <bpmn:task id="sendTable" name="Send the table to account management" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:exclusiveGateway id="deadline1" name="Completed by 2:30 pm?" />
    <bpmn:task id="alert" name="Send an alert to the supervisor" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:task id="checkCrm2" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="newReturns2" name="New returns filed?" />
    <bpmn:endEvent id="noReturns2" name="No new returns" />
    <bpmn:task id="reconcile" name="Reconcile with the existing Account Defaulter table" />
    <bpmn:exclusiveGateway id="deadline2" name="Completed by 4:00 pm?" />
    <bpmn:task id="messageSup" name="Send a message to the supervisor" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:endEvent id="late" name="Supervisor informed of late completion" />
    <bpmn:sequenceFlow id="f-morning-backup" sourceRef="morning" targetRef="backup" />
    <bpmn:sequenceFlow id="f-backup-checkTable" sourceRef="backup" targetRef="checkTable" />
    <bpmn:sequenceFlow id="f-checkTable-newRecords" sourceRef="checkTable" targetRef="newRecords" />
    <bpmn:sequenceFlow id="f-newRecords-recordsDone" name="yes" sourceRef="newRecords" targetRef="recordsDone" />
    <bpmn:sequenceFlow id="f-newRecords-checkCrm" name="no" sourceRef="newRecords" targetRef="checkCrm" />
    <bpmn:sequenceFlow id="f-checkCrm-newReturns" sourceRef="checkCrm" targetRef="newReturns" />
    <bpmn:sequenceFlow id="f-newReturns-noReturns" name="no" sourceRef="newReturns" targetRef="noReturns" />
    <bpmn:sequenceFlow id="f-newReturns-register" name="yes" sourceRef="newReturns" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-advised" sourceRef="register" targetRef="advised" />
    <bpmn:sequenceFlow id="f-advised-produceTable" name="yes" sourceRef="advised" targetRef="produceTable" />
    <bpmn:sequenceFlow id="f-advised-merge1" name="no" sourceRef="advised" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-produceTable-sendTable" sourceRef="produceTable" targetRef="sendTable" />
    <bpmn:sequenceFlow id="f-sendTable-merge1" sourceRef="sendTable" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-deadline1" sourceRef="merge1" targetRef="deadline1" />
    <bpmn:sequenceFlow id="f-deadline1-merge2" name="yes" sourceRef="deadline1" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-deadline1-alert" name="no" sourceRef="deadline1" targetRef="alert" />
    <bpmn:sequenceFlow id="f-alert-merge2" sourceRef="alert" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-merge2-checkCrm2" sourceRef="merge2" targetRef="checkCrm2" />
    <bpmn:sequenceFlow id="f-checkCrm2-newReturns2" sourceRef="checkCrm2" targetRef="newReturns2" />
    <bpmn:sequenceFlow id="f-newReturns2-reconcile" name="yes" sourceRef="newReturns2" targetRef="reconcile" />
    <bpmn:sequenceFlow id="f-newReturns2-noReturns2" name="no" sourceRef="newReturns2" targetRef="noReturns2" />
    <bpmn:sequenceFlow id="f-reconcile-deadline2" sourceRef="reconcile" targetRef="deadline2" />
    <bpmn:sequenceFlow id="f-deadline2-done" name="yes" sourceRef="deadline2" targetRef="done" />
    <bpmn:sequenceFlow id="f-deadline2-messageSup" name="no" sourceRef="deadline2" targetRef="messageSup" />
    <bpmn:sequenceFlow id="f-messageSup-late" sourceRef="messageSup" targetRef="late" />
  </bpmn:process>
</bpmn:definitions>
