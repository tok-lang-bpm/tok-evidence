tok 1.0 "Mortgage offer handling"

pool org "Mortgage company"
  lane csr "Customer Service Representative"
    start opened "Mortgage case started"
    task send "Send the mortgage offer"
    xor merge "Mortgage declined or no answer?"
    task update "Update the case details"
    task archive "Archive the work"
    task cancel "Cancel the case"
    end cancelled "Case cancelled"
    xor docs "All prerequisite documents provided?"
    task move "Move the case to administration"
    task request "Send a message requesting the outstanding documents"
    end requested "Outstanding documents requested"
  lane customer "Customer"
    task receive "Receive the mortgage offer"
    boundary timeout "No answer after 2 weeks" on=receive timer=P14D
    xor reply "Customer replies?"
    task decline "Decline the mortgage"
    task return "Return the completed offer documents with all prerequisite documents"
  lane admin "Administration"
    task complete "Complete the case"
    end done "Case completed"

flow opened -> send -> receive -> reply
flow reply -> decline "declines"
flow reply -> return "returns the offer documents"
flow decline -> merge
flow timeout -> merge
flow merge -> update -> archive -> cancel -> cancelled
flow return -> docs
flow docs -> request "no"
flow docs -> move "yes"
flow request -> requested
flow move -> complete -> done
