<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meeting schedule planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Town Planning Authority" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Meeting schedule planning" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>november</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>checkdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>diaryconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="november" name="November of each year" />
    <bpmn:task id="draft" name="Draft the schedule of meetings for the next calendar year" />
    <bpmn:task id="adddates" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="conflicts" name="Look for potential conflicts" />
    <bpmn:task id="send" name="Send the final schedule of meeting dates by email" />
    <bpmn:task id="checkdates" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="diaries" name="Check their diaries" />
    <bpmn:exclusiveGateway id="diaryconf" name="Conflicts in diary?" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of the conflicts" />
    <bpmn:endEvent id="confirmed" name="Diaries checked, no conflicts" />
    <bpmn:endEvent id="reported" name="Conflicts reported to the Coordination Unit" />
    <bpmn:sequenceFlow id="f-november-draft" sourceRef="november" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-adddates" sourceRef="draft" targetRef="adddates" />
    <bpmn:sequenceFlow id="f-adddates-checkdates" sourceRef="adddates" targetRef="checkdates" />
    <bpmn:sequenceFlow id="f-checkdates-suggest" sourceRef="checkdates" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-conflicts" sourceRef="recheck" targetRef="conflicts" />
    <bpmn:sequenceFlow id="f-conflicts-send" sourceRef="conflicts" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-diaries" sourceRef="send" targetRef="diaries" />
    <bpmn:sequenceFlow id="f-diaries-diaryconf" sourceRef="diaries" targetRef="diaryconf" />
    <bpmn:sequenceFlow id="f-diaryconf-advise" name="yes" sourceRef="diaryconf" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-reported" sourceRef="advise" targetRef="reported" />
    <bpmn:sequenceFlow id="f-diaryconf-confirmed" name="no" sourceRef="diaryconf" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
