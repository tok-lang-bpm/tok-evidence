tok 1.0 "Meeting schedule planning"

pool office "Town Planning Authority"
  lane coord "Coordination Unit"
    start november "November of each year"
    task draft "Draft the schedule of meetings for the next calendar year"
    task adddates "Add draft dates to all calendars"
    task recheck "Recheck all dates"
    task conflicts "Look for potential conflicts"
    task send "Send the final schedule of meeting dates by email"
  lane support "Support Officer"
    task checkdates "Check the dates"
    task suggest "Suggest modifications"
  lane committee "Committee Members"
    task diaries "Check their diaries"
    xor diaryconf "Conflicts in diary?"
    task advise "Advise the Coordination Unit of the conflicts"
    end confirmed "Diaries checked, no conflicts"
    end reported "Conflicts reported to the Coordination Unit"

flow november -> draft -> adddates -> checkdates -> suggest -> recheck -> conflicts -> send
flow send -> diaries -> diaryconf
flow diaryconf -> advise "yes"
flow advise -> reported
flow diaryconf -> confirmed "no"
