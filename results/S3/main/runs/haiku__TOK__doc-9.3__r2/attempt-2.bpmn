<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Annual meeting schedule" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Annual meeting schedule" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addcal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendsched</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>modq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>modmerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="November of each year" />
    <bpmn:task id="draft" name="Draft the schedule of meetings for the next calendar year" />
    <bpmn:task id="addcal" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="conflicts" name="Look for potential conflicts" />
    <bpmn:task id="sendsched" name="Send the final schedule of meeting dates to all Committee Members by email" />
    <bpmn:task id="check" name="Check the dates" />
    <bpmn:exclusiveGateway id="modq" name="Modifications suggested?" default="f-modq-modmerge" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:exclusiveGateway id="modmerge" />
    <bpmn:task id="diaries" name="Check their diaries" />
    <bpmn:exclusiveGateway id="confq" name="Conflicts found?" default="f-confq-noconf" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of conflicts" />
    <bpmn:endEvent id="noconf" name="No conflicts" />
    <bpmn:endEvent id="done" name="Conflicts reported to the Coordination Unit" />
    <bpmn:sequenceFlow id="f-begin-draft" sourceRef="begin" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-addcal" sourceRef="draft" targetRef="addcal" />
    <bpmn:sequenceFlow id="f-addcal-check" sourceRef="addcal" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-modq" sourceRef="check" targetRef="modq" />
    <bpmn:sequenceFlow id="f-modq-suggest" name="yes" sourceRef="modq" targetRef="suggest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">modifications_suggested = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-suggest-modmerge" sourceRef="suggest" targetRef="modmerge" />
    <bpmn:sequenceFlow id="f-modq-modmerge" name="no" sourceRef="modq" targetRef="modmerge" />
    <bpmn:sequenceFlow id="f-modmerge-recheck" sourceRef="modmerge" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-conflicts" sourceRef="recheck" targetRef="conflicts" />
    <bpmn:sequenceFlow id="f-conflicts-sendsched" sourceRef="conflicts" targetRef="sendsched" />
    <bpmn:sequenceFlow id="f-sendsched-diaries" sourceRef="sendsched" targetRef="diaries" />
    <bpmn:sequenceFlow id="f-diaries-confq" sourceRef="diaries" targetRef="confq" />
    <bpmn:sequenceFlow id="f-confq-advise" name="yes" sourceRef="confq" targetRef="advise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">conflicts_found = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-advise-done" sourceRef="advise" targetRef="done" />
    <bpmn:sequenceFlow id="f-confq-noconf" name="no" sourceRef="confq" targetRef="noconf" />
  </bpmn:process>
</bpmn:definitions>
