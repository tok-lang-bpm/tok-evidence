<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting administration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting administration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="dates" name="Dates to be finalized" />
    <bpmn:task id="finalize" name="Finalize the dates" />
    <bpmn:task id="qa" name="Conduct a QA check on the minutes" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="calendars" name="Update all group calendars" />
    <bpmn:task id="folders" name="Create a meeting folder for each meeting" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="upload" name="Ensure all appropriate documents are uploaded to the system" />
    <bpmn:task id="advise" name="Advise Committee Members a week before each meeting" />
    <bpmn:task id="produce" name="Produce the minutes including any Action Points for each Committee Member" />
    <bpmn:task id="send" name="Send the minutes to all Committee Members" />
    <bpmn:task id="records" name="Update all departmental records" />
    <bpmn:endEvent id="done" name="Records updated" />
    <bpmn:task id="read" name="Read all related documents" />
    <bpmn:task id="hold" name="Hold the meeting" />
    <bpmn:sequenceFlow id="f-dates-finalize" sourceRef="dates" targetRef="finalize" />
    <bpmn:sequenceFlow id="f-finalize-split" sourceRef="finalize" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-calendars" sourceRef="split" targetRef="calendars" />
    <bpmn:sequenceFlow id="f-calendars-joined" sourceRef="calendars" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-folders" sourceRef="split" targetRef="folders" />
    <bpmn:sequenceFlow id="f-folders-joined" sourceRef="folders" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-upload" sourceRef="joined" targetRef="upload" />
    <bpmn:sequenceFlow id="f-upload-advise" sourceRef="upload" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-read" sourceRef="advise" targetRef="read" />
    <bpmn:sequenceFlow id="f-read-hold" sourceRef="read" targetRef="hold" />
    <bpmn:sequenceFlow id="f-hold-produce" sourceRef="hold" targetRef="produce" />
    <bpmn:sequenceFlow id="f-produce-qa" sourceRef="produce" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send" sourceRef="qa" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-records" sourceRef="send" targetRef="records" />
    <bpmn:sequenceFlow id="f-records-done" sourceRef="records" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
