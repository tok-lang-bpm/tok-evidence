tok 1.0 "Committee meeting administration"

pool org "Organisation"
  lane coord "Coordination Unit"
    start dates "Dates to be finalized"
    task finalize "Finalize the dates"
    task qa "Conduct a QA check on the minutes"
  lane support "Support Officer"
    and split
    task calendars "Update all group calendars"
    task folders "Create a meeting folder for each meeting"
    and joined
    task upload "Ensure all appropriate documents are uploaded to the system"
    task advise "Advise Committee Members a week before each meeting"
    task produce "Produce the minutes including any Action Points for each Committee Member"
    task send "Send the minutes to all Committee Members"
    task records "Update all departmental records"
    end done "Records updated"
  lane committee "Committee Members"
    task read "Read all related documents"
    task hold "Hold the meeting"

flow dates -> finalize -> split
flow split -> calendars -> joined
flow split -> folders -> joined
flow joined -> upload -> advise -> read -> hold -> produce -> qa -> send -> records -> done
