<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cu" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="so" name="Support Officer">
        <bpmn:flowNodeRef>prep_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cm" name="Committee Members">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Meeting dates to be finalized" />
    <bpmn:task id="finalize" name="Finalize the dates" />
    <bpmn:task id="qa" name="Conduct a QA check on the minutes within 5 working days" />
    <bpmn:parallelGateway id="prep_split" />
    <bpmn:task id="calendars" name="Update all group calendars" />
    <bpmn:task id="folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="upload" name="Upload all appropriate documents to the system" />
    <bpmn:parallelGateway id="prep_join" />
    <bpmn:task id="advise" name="Advise Committee Members a week before each meeting" />
    <bpmn:task id="produce" name="Produce the minutes including any Action Points for each Committee Member" />
    <bpmn:task id="send" name="Send the minutes to all Committee Members" />
    <bpmn:task id="records" name="Update all departmental records" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:task id="read" name="Read all related documents" />
    <bpmn:task id="hold" name="Hold the meeting" />
    <bpmn:sequenceFlow id="f-s-finalize" sourceRef="s" targetRef="finalize" />
    <bpmn:sequenceFlow id="f-finalize-prep_split" sourceRef="finalize" targetRef="prep_split" />
    <bpmn:sequenceFlow id="f-prep_split-calendars" sourceRef="prep_split" targetRef="calendars" />
    <bpmn:sequenceFlow id="f-prep_split-folders" sourceRef="prep_split" targetRef="folders" />
    <bpmn:sequenceFlow id="f-prep_split-upload" sourceRef="prep_split" targetRef="upload" />
    <bpmn:sequenceFlow id="f-calendars-prep_join" sourceRef="calendars" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-folders-prep_join" sourceRef="folders" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-upload-prep_join" sourceRef="upload" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-prep_join-advise" sourceRef="prep_join" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-read" sourceRef="advise" targetRef="read" />
    <bpmn:sequenceFlow id="f-read-hold" sourceRef="read" targetRef="hold" />
    <bpmn:sequenceFlow id="f-hold-produce" sourceRef="hold" targetRef="produce" />
    <bpmn:sequenceFlow id="f-produce-qa" sourceRef="produce" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send" sourceRef="qa" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-records" sourceRef="send" targetRef="records" />
    <bpmn:sequenceFlow id="f-records-done" sourceRef="records" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
