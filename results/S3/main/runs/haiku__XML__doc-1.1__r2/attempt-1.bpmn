<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Bicycle manufacturer" processRef="bicycle-process" />
  </bpmn:collaboration>
  <bpmn:process id="bicycle-process" isExecutable="false">
    <bpmn:laneSet id="bicycle-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>order-received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-storehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-engineering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>process-part-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-quantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>item-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more-items</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order-received" name="Order received" />
    <bpmn:task id="decide" name="Decide on the order" />
    <bpmn:exclusiveGateway id="accepted" name="Order accepted?" />
    <bpmn:task id="reject" name="Reject the order" />
    <bpmn:endEvent id="end-rejected" name="Process instance finished" />
    <bpmn:task id="accept" name="Accept the order" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="inform-storehouse" name="Inform the storehouse" />
    <bpmn:task id="inform-engineering" name="Inform the engineering department" />
    <bpmn:task id="process-part-list" name="Process the part list of the order" />
    <bpmn:task id="check-quantity" name="Check the required quantity of the part" />
    <bpmn:exclusiveGateway id="available" name="Part available in-house?" />
    <bpmn:task id="reserve" name="Reserve the part" />
    <bpmn:task id="back-order" name="Back-order the part" />
    <bpmn:exclusiveGateway id="item-merge" />
    <bpmn:exclusiveGateway id="more-items" name="More items on the part list?" />
    <bpmn:task id="prepare" name="Prepare the assembly of the bicycle" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:task id="ship" name="Ship the bicycle to the customer" />
    <bpmn:endEvent id="end-shipped" name="Process instance finished" />
    <bpmn:sequenceFlow id="s1" sourceRef="order-received" targetRef="decide" />
    <bpmn:sequenceFlow id="s2" sourceRef="decide" targetRef="accepted" />
    <bpmn:sequenceFlow id="s3" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="s4" sourceRef="reject" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="s5" name="yes" sourceRef="accepted" targetRef="accept" />
    <bpmn:sequenceFlow id="s6" sourceRef="accept" targetRef="fork" />
    <bpmn:sequenceFlow id="s7" sourceRef="fork" targetRef="inform-storehouse" />
    <bpmn:sequenceFlow id="s8" sourceRef="fork" targetRef="inform-engineering" />
    <bpmn:sequenceFlow id="s9" sourceRef="inform-storehouse" targetRef="process-part-list" />
    <bpmn:sequenceFlow id="s10" sourceRef="process-part-list" targetRef="check-quantity" />
    <bpmn:sequenceFlow id="s11" sourceRef="check-quantity" targetRef="available" />
    <bpmn:sequenceFlow id="s12" name="yes" sourceRef="available" targetRef="reserve" />
    <bpmn:sequenceFlow id="s13" name="no" sourceRef="available" targetRef="back-order" />
    <bpmn:sequenceFlow id="s14" sourceRef="reserve" targetRef="item-merge" />
    <bpmn:sequenceFlow id="s15" sourceRef="back-order" targetRef="item-merge" />
    <bpmn:sequenceFlow id="s16" sourceRef="item-merge" targetRef="more-items" />
    <bpmn:sequenceFlow id="s17" name="yes" sourceRef="more-items" targetRef="check-quantity" />
    <bpmn:sequenceFlow id="s18" name="no" sourceRef="more-items" targetRef="join" />
    <bpmn:sequenceFlow id="s19" sourceRef="inform-engineering" targetRef="prepare" />
    <bpmn:sequenceFlow id="s20" sourceRef="prepare" targetRef="join" />
    <bpmn:sequenceFlow id="s21" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="s22" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="s23" sourceRef="ship" targetRef="end-shipped" />
  </bpmn:process>
</bpmn:definitions>
