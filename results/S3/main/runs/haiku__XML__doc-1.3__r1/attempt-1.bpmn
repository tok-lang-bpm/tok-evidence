<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="room-service-process" />
  </bpmn:collaboration>
  <bpmn:process id="room-service-process" isExecutable="false">
    <bpmn:laneSet id="room-service-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>takeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveWineOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcoholCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>readyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareNonalcoholic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billingDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="call" name="Guest calls room service" />
    <bpmn:task id="takeOrder" name="Take down the order" />
    <bpmn:task id="submitTicket" name="Submit an order ticket to the kitchen" />
    <bpmn:task id="giveWineOrder" name="Give an order to the sommelier" />
    <bpmn:exclusiveGateway id="alcoholCheck" name="Order includes alcoholic beverage?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="assignOrder" name="Assign the order to the waiter" />
    <bpmn:task id="prepareFood" name="Prepare the food" />
    <bpmn:task id="fetchWine" name="Fetch wine from the cellar" />
    <bpmn:task id="prepareAlcohol" name="Prepare other alcoholic beverages" />
    <bpmn:task id="readyCart" name="Ready the cart" />
    <bpmn:task id="prepareNonalcoholic" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="readyJoin" />
    <bpmn:task id="deliver" name="Deliver the food, wine and cart to the guest's room" />
    <bpmn:task id="returnToStation" name="Return to the room-service station" />
    <bpmn:task id="debitAccount" name="Debit the guest's account" />
    <bpmn:exclusiveGateway id="billingDecision" name="Waiter has another order to prepare or deliver?" />
    <bpmn:endEvent id="orderDone" name="Order handled" />
    <bpmn:endEvent id="billingDone" name="Order billed" />
    <bpmn:sequenceFlow id="f1" sourceRef="call" targetRef="takeOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="takeOrder" targetRef="submitTicket" />
    <bpmn:sequenceFlow id="f3" sourceRef="submitTicket" targetRef="giveWineOrder" />
    <bpmn:sequenceFlow id="f4" sourceRef="giveWineOrder" targetRef="alcoholCheck" />
    <bpmn:sequenceFlow id="f5" name="yes (80% of orders)" sourceRef="alcoholCheck" targetRef="split" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="alcoholCheck" targetRef="assignOrder" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="assignOrder" />
    <bpmn:sequenceFlow id="f8" sourceRef="assignOrder" targetRef="prepareFood" />
    <bpmn:sequenceFlow id="f9" sourceRef="assignOrder" targetRef="fetchWine" />
    <bpmn:sequenceFlow id="f10" sourceRef="fetchWine" targetRef="prepareAlcohol" />
    <bpmn:sequenceFlow id="f11" sourceRef="assignOrder" targetRef="readyCart" />
    <bpmn:sequenceFlow id="f12" sourceRef="assignOrder" targetRef="prepareNonalcoholic" />
    <bpmn:sequenceFlow id="f13" sourceRef="prepareFood" targetRef="readyJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepareAlcohol" targetRef="readyJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="readyCart" targetRef="readyJoin" />
    <bpmn:sequenceFlow id="f16" sourceRef="prepareNonalcoholic" targetRef="readyJoin" />
    <bpmn:sequenceFlow id="f17" sourceRef="readyJoin" targetRef="deliver" />
    <bpmn:sequenceFlow id="f18" sourceRef="deliver" targetRef="returnToStation" />
    <bpmn:sequenceFlow id="f19" sourceRef="returnToStation" targetRef="debitAccount" />
    <bpmn:sequenceFlow id="f20" sourceRef="debitAccount" targetRef="billingDecision" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="billingDecision" targetRef="billingDone" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="billingDecision" targetRef="orderDone" />
  </bpmn:process>
</bpmn:definitions>
