<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="MSG_CALL" name="Room service call" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="HOTEL" name="The Evanstonian" processRef="room-service-process" />
    <bpmn:participant id="GUEST" name="Guest" />
    <bpmn:messageFlow id="MF_CALL" name="calls room service" sourceRef="GUEST" targetRef="S_CALL" />
  </bpmn:collaboration>
  <bpmn:process id="room-service-process" isExecutable="false">
    <bpmn:laneSet id="room-service-lanes">
      <bpmn:lane id="LANE_MANAGER" name="Room-service manager">
        <bpmn:flowNodeRef>S_CALL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TAKE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SUBMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ALC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GIVE_SOMM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ALC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ASSIGN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_FORK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_JOIN</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_KITCHEN" name="Kitchen">
        <bpmn:flowNodeRef>T_PREP_FOOD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SOMM" name="Sommelier">
        <bpmn:flowNodeRef>G_SOMM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_FETCH_WINE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PREP_ALC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_SOMM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_WAITER" name="Waiter">
        <bpmn:flowNodeRef>T_TABLECLOTH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SILVERWARE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NONALC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DELIVER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RETURN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ANOTHER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DEFER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_BILL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DEBIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_CALL" name="Guest calls room service">
      <bpmn:messageEventDefinition messageRef="MSG_CALL" />
    </bpmn:startEvent>
    <bpmn:task id="T_TAKE" name="Take down the order" />
    <bpmn:task id="T_SUBMIT" name="Submit the order ticket to the kitchen" />
    <bpmn:exclusiveGateway id="G_ALC" name="Order includes alcoholic beverage?" />
    <bpmn:task id="T_GIVE_SOMM" name="Give the order to the sommelier" />
    <bpmn:exclusiveGateway id="M_ALC" />
    <bpmn:task id="T_ASSIGN" name="Assign the order to the waiter" />
    <bpmn:parallelGateway id="P_FORK" />
    <bpmn:task id="T_PREP_FOOD" name="Prepare the food" />
    <bpmn:exclusiveGateway id="G_SOMM" name="Order includes alcoholic beverage?" />
    <bpmn:task id="T_FETCH_WINE" name="Fetch wine from the cellar" />
    <bpmn:task id="T_PREP_ALC" name="Prepare other alcoholic beverages" />
    <bpmn:exclusiveGateway id="M_SOMM" />
    <bpmn:task id="T_TABLECLOTH" name="Put a tablecloth on the cart" />
    <bpmn:task id="T_SILVERWARE" name="Gather silverware" />
    <bpmn:task id="T_NONALC" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="P_JOIN" />
    <bpmn:task id="T_DELIVER" name="Deliver the food, wine and cart to the guest's room" />
    <bpmn:task id="T_RETURN" name="Return to the room-service station" />
    <bpmn:exclusiveGateway id="G_ANOTHER" name="Another order to prepare or deliver?" />
    <bpmn:task id="T_DEFER" name="Defer the billing" />
    <bpmn:exclusiveGateway id="M_BILL" />
    <bpmn:task id="T_DEBIT" name="Debit the guest's account" />
    <bpmn:endEvent id="E_END" name="Order billed" />
    <bpmn:sequenceFlow id="F1" sourceRef="S_CALL" targetRef="T_TAKE" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_TAKE" targetRef="T_SUBMIT" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_SUBMIT" targetRef="G_ALC" />
    <bpmn:sequenceFlow id="F4" name="yes" sourceRef="G_ALC" targetRef="T_GIVE_SOMM" />
    <bpmn:sequenceFlow id="F5" name="no" sourceRef="G_ALC" targetRef="M_ALC" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_GIVE_SOMM" targetRef="M_ALC" />
    <bpmn:sequenceFlow id="F7" sourceRef="M_ALC" targetRef="T_ASSIGN" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_ASSIGN" targetRef="P_FORK" />
    <bpmn:sequenceFlow id="F9" sourceRef="P_FORK" targetRef="T_PREP_FOOD" />
    <bpmn:sequenceFlow id="F10" sourceRef="P_FORK" targetRef="G_SOMM" />
    <bpmn:sequenceFlow id="F11" sourceRef="P_FORK" targetRef="T_TABLECLOTH" />
    <bpmn:sequenceFlow id="F12" sourceRef="P_FORK" targetRef="T_NONALC" />
    <bpmn:sequenceFlow id="F13" name="yes" sourceRef="G_SOMM" targetRef="T_FETCH_WINE" />
    <bpmn:sequenceFlow id="F14" name="no" sourceRef="G_SOMM" targetRef="M_SOMM" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_FETCH_WINE" targetRef="T_PREP_ALC" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_PREP_ALC" targetRef="M_SOMM" />
    <bpmn:sequenceFlow id="F17" sourceRef="M_SOMM" targetRef="P_JOIN" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_PREP_FOOD" targetRef="P_JOIN" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_TABLECLOTH" targetRef="T_SILVERWARE" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_SILVERWARE" targetRef="P_JOIN" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_NONALC" targetRef="P_JOIN" />
    <bpmn:sequenceFlow id="F22" sourceRef="P_JOIN" targetRef="T_DELIVER" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_DELIVER" targetRef="T_RETURN" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_RETURN" targetRef="G_ANOTHER" />
    <bpmn:sequenceFlow id="F25" name="yes" sourceRef="G_ANOTHER" targetRef="T_DEFER" />
    <bpmn:sequenceFlow id="F26" name="no" sourceRef="G_ANOTHER" targetRef="M_BILL" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_DEFER" targetRef="M_BILL" />
    <bpmn:sequenceFlow id="F28" sourceRef="M_BILL" targetRef="T_DEBIT" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_DEBIT" targetRef="E_END" />
  </bpmn:process>
</bpmn:definitions>
