<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" isExecutable="false">
    <bpmn:laneSet id="ipo-lanes">
      <bpmn:lane id="management" name="Company management">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterCommitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoIpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endIpo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReputation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerSec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkBlueSky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinSec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwReputation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwReason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="Securities and Exchange Commission">
        <bpmn:flowNodeRef>reviewSec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="startDecision" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="checkReputation" name="Check that the facts have been presented fairly" />
    <bpmn:exclusiveGateway id="gwReputation" name="Facts presented fairly?" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:task id="reviewSec" name="Review the registration statement" />
    <bpmn:parallelGateway id="splitStart" />
    <bpmn:task id="registerSec" name="Register the issue with the SEC" />
    <bpmn:task id="checkBlueSky" name="Check compliance with blue-sky laws" />
    <bpmn:parallelGateway id="joinSec" />
    <bpmn:exclusiveGateway id="gwApproved" name="SEC approval received?" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="roadShow" name="Arrange a road show with potential investors" />
    <bpmn:task id="clearance" name="Grant clearance" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:task id="enterCommitment" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="buy" name="Buy the issue" />
    <bpmn:exclusiveGateway id="gwReason" name="Any reason not to offer the issue?" />
    <bpmn:task id="offer" name="Resell the issue to the public" />
    <bpmn:endEvent id="endNoIpo" name="Offering abandoned" />
    <bpmn:endEvent id="endIpo" name="Issue sold to the public" />

    <bpmn:sequenceFlow id="f1" sourceRef="startDecision" targetRef="select" />
    <bpmn:sequenceFlow id="f2" sourceRef="select" targetRef="advise" />
    <bpmn:sequenceFlow id="f3" sourceRef="advise" targetRef="checkReputation" />
    <bpmn:sequenceFlow id="f4" sourceRef="checkReputation" targetRef="gwReputation" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="gwReputation" targetRef="prepare" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="gwReputation" targetRef="endNoIpo" />
    <bpmn:sequenceFlow id="f7" sourceRef="prepare" targetRef="reviewSec" />
    <bpmn:sequenceFlow id="f8" sourceRef="reviewSec" targetRef="splitStart" />
    <bpmn:sequenceFlow id="f9" sourceRef="splitStart" targetRef="registerSec" />
    <bpmn:sequenceFlow id="f10" sourceRef="splitStart" targetRef="checkBlueSky" />
    <bpmn:sequenceFlow id="f11" sourceRef="splitStart" targetRef="firm" />
    <bpmn:sequenceFlow id="f12" sourceRef="firm" targetRef="roadShow" />
    <bpmn:sequenceFlow id="f13" sourceRef="registerSec" targetRef="joinSec" />
    <bpmn:sequenceFlow id="f14" sourceRef="checkBlueSky" targetRef="joinSec" />
    <bpmn:sequenceFlow id="f15" sourceRef="joinSec" targetRef="gwApproved" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="gwApproved" targetRef="clearance" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="gwApproved" targetRef="reviewSec" />
    <bpmn:sequenceFlow id="f18" sourceRef="clearance" targetRef="fix" />
    <bpmn:sequenceFlow id="f19" sourceRef="fix" targetRef="enterCommitment" />
    <bpmn:sequenceFlow id="f20" sourceRef="enterCommitment" targetRef="buy" />
    <bpmn:sequenceFlow id="f21" sourceRef="buy" targetRef="gwReason" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="gwReason" targetRef="offer" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="gwReason" targetRef="endNoIpo" />
    <bpmn:sequenceFlow id="f24" sourceRef="offer" targetRef="endIpo" />
  </bpmn:process>
</bpmn:definitions>
