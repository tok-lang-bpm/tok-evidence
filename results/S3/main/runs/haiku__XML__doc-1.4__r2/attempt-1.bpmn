<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" isExecutable="false">
    <bpmn:laneSet id="ipo-lanes">
      <bpmn:lane id="company-lane" name="Company">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriter-lane" name="Underwriters">
        <bpmn:flowNodeRef>factsGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blueSky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decide" name="Decision to go public made" />
    <bpmn:task id="selectUnderwriters" name="Select the underwriters" />
    <bpmn:exclusiveGateway id="factsGw" name="Facts presented fairly?" />
    <bpmn:endEvent id="declined" name="Underwriting declined" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="splitA" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:intermediateCatchEvent id="clearance" name="SEC clearance received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fixPrice" name="Fix the issue price" />
    <bpmn:task id="blueSky" name="Check the issue complies with the blue-sky laws of each state" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="roadShow" name="Arrange a road show to talk to potential investors" />
    <bpmn:parallelGateway id="joinA" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="buy" name="Buy the issue" />
    <bpmn:exclusiveGateway id="withdrawGw" name="Reason not to offer found?" />
    <bpmn:endEvent id="withdrawn" name="Offer withdrawn" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="done" name="Issue offered to the public" />
    <bpmn:sequenceFlow id="f1" sourceRef="decide" targetRef="selectUnderwriters" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectUnderwriters" targetRef="factsGw" />
    <bpmn:sequenceFlow id="f3" name="no" sourceRef="factsGw" targetRef="declined" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="factsGw" targetRef="advise" />
    <bpmn:sequenceFlow id="f5" sourceRef="advise" targetRef="prepare" />
    <bpmn:sequenceFlow id="f6" sourceRef="prepare" targetRef="splitA" />
    <bpmn:sequenceFlow id="f7" sourceRef="splitA" targetRef="register" />
    <bpmn:sequenceFlow id="f8" sourceRef="splitA" targetRef="blueSky" />
    <bpmn:sequenceFlow id="f9" sourceRef="splitA" targetRef="firm" />
    <bpmn:sequenceFlow id="f10" sourceRef="register" targetRef="clearance" />
    <bpmn:sequenceFlow id="f11" sourceRef="clearance" targetRef="fixPrice" />
    <bpmn:sequenceFlow id="f12" sourceRef="firm" targetRef="roadShow" />
    <bpmn:sequenceFlow id="f13" sourceRef="blueSky" targetRef="joinA" />
    <bpmn:sequenceFlow id="f14" sourceRef="fixPrice" targetRef="joinA" />
    <bpmn:sequenceFlow id="f15" sourceRef="roadShow" targetRef="joinA" />
    <bpmn:sequenceFlow id="f16" sourceRef="joinA" targetRef="commit" />
    <bpmn:sequenceFlow id="f17" sourceRef="commit" targetRef="buy" />
    <bpmn:sequenceFlow id="f18" sourceRef="buy" targetRef="withdrawGw" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="withdrawGw" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="withdrawGw" targetRef="offer" />
    <bpmn:sequenceFlow id="f21" sourceRef="offer" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
