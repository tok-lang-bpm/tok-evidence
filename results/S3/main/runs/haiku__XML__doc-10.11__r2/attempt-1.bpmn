<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="measurement-process" />
  </bpmn:collaboration>
  <bpmn:process id="measurement-process" isExecutable="false">
    <bpmn:laneSet id="measurement-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-readings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-go-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-go-failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-outcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sp" name="SP">
        <bpmn:flowNodeRef>receive-readings</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Measurements needed" />
    <bpmn:task id="request" name="Request the measurements" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="decide" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny the request" />
    <bpmn:task id="measure" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:exclusiveGateway id="split-outcome" name="Reading successful?" />
    <bpmn:task id="inform-failure" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="transmit-values" name="Transmit the measured values to the GO" />
    <bpmn:task id="process-values" name="Process the measured values" />
    <bpmn:task id="send-changed" name="Send the changed values to the MSP" />
    <bpmn:task id="transmit-readings" name="Transmit the readings to the SP" />
    <bpmn:task id="receive-readings" name="Receive the readings" />
    <bpmn:endEvent id="end-go-failure" name="Reading failed" />
    <bpmn:endEvent id="end-go-done" name="Values processed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request" />
    <bpmn:sequenceFlow id="f2" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="decide" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="decide" targetRef="deny" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="decide" targetRef="measure" />
    <bpmn:sequenceFlow id="f6" sourceRef="deny" targetRef="end-go-failure" />
    <bpmn:sequenceFlow id="f7" sourceRef="measure" targetRef="split-outcome" />
    <bpmn:sequenceFlow id="f8" name="failed" sourceRef="split-outcome" targetRef="inform-failure" />
    <bpmn:sequenceFlow id="f9" name="succeeded" sourceRef="split-outcome" targetRef="transmit-values" />
    <bpmn:sequenceFlow id="f10" sourceRef="inform-failure" targetRef="end-go-failure" />
    <bpmn:sequenceFlow id="f11" sourceRef="transmit-values" targetRef="process-values" />
    <bpmn:sequenceFlow id="f12" sourceRef="process-values" targetRef="send-changed" />
    <bpmn:sequenceFlow id="f13" sourceRef="send-changed" targetRef="transmit-readings" />
    <bpmn:sequenceFlow id="f14" sourceRef="transmit-readings" targetRef="receive-readings" />
    <bpmn:sequenceFlow id="f15" sourceRef="receive-readings" targetRef="end-go-done" />
  </bpmn:process>
</bpmn:definitions>
