<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="master-data-process" />
  </bpmn:collaboration>
  <bpmn:process id="master-data-process" isExecutable="false">
    <bpmn:laneSet id="master-data-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>change-reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell-inq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>notify-ip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check-change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes-confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes-rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="change-reported" name="Change of master data occurs" />
    <bpmn:task id="tell-inq" name="Tell the INQ about the change of master data" />
    <bpmn:task id="notify-ip" name="Notify the IP of the change" />
    <bpmn:task id="check-change" name="Check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="decide" name="Change possible at the desired time?" />
    <bpmn:task id="confirm-changes" name="Confirm the changes of the INQ" />
    <bpmn:task id="reject-changes" name="Reject the changes of the INQ" />
    <bpmn:endEvent id="changes-confirmed" name="Changes confirmed" />
    <bpmn:endEvent id="changes-rejected" name="Changes rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="change-reported" targetRef="tell-inq" />
    <bpmn:sequenceFlow id="f2" sourceRef="tell-inq" targetRef="notify-ip" />
    <bpmn:sequenceFlow id="f3" sourceRef="notify-ip" targetRef="check-change" />
    <bpmn:sequenceFlow id="f4" sourceRef="check-change" targetRef="decide" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="decide" targetRef="confirm-changes" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="decide" targetRef="reject-changes" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm-changes" targetRef="changes-confirmed" />
    <bpmn:sequenceFlow id="f8" sourceRef="reject-changes" targetRef="changes-rejected" />
  </bpmn:process>
</bpmn:definitions>
