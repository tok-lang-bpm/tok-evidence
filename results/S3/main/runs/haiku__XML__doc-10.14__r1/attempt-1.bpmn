<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="MPOO_LANE" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTempMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendEquipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO_LANE" name="MSPO">
        <bpmn:flowNodeRef>sendTempMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendAdditional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO_LANE" name="GO">
        <bpmn:flowNodeRef>examineTempMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examineTempMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examineAdditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examineEquipmentGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endGO1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endGO2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPON_LANE" name="MPON">
        <bpmn:flowNodeRef>examineEquipmentMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endMPON1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endMPON2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Bill needed" />
    <bpmn:exclusiveGateway id="g1" name="Which bill is sent?" />
    <bpmn:task id="sendTempMPOO" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="sendTempMSPO" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="sendAdditional" name="Send the bill for additional readings" />
    <bpmn:task id="sendEquipment" name="Send the bill for the equipment acquisition" />
    <bpmn:exclusiveGateway id="g2" name="MPON or GO?" />
    <bpmn:task id="examineTempMPOO" name="Examine the bill" />
    <bpmn:task id="examineTempMSPO" name="Examine the bill" />
    <bpmn:task id="examineAdditional" name="Examine the bill" />
    <bpmn:task id="examineEquipmentGO" name="Examine the bill" />
    <bpmn:task id="examineEquipmentMPON" name="Examine the bill" />
    <bpmn:exclusiveGateway id="g3" name="Bill examined" />
    <bpmn:exclusiveGateway id="g4" name="Confirmed or rejected?" />
    <bpmn:task id="confirmGO" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="rejectGO" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:endEvent id="endGO1" name="Invoice confirmed" />
    <bpmn:endEvent id="endGO2" name="Invoice rejected" />
    <bpmn:exclusiveGateway id="g5" name="Confirmed or rejected?" />
    <bpmn:task id="confirmMPON" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="rejectMPON" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:endEvent id="endMPON1" name="Invoice confirmed" />
    <bpmn:endEvent id="endMPON2" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="g1" />
    <bpmn:sequenceFlow id="f2" name="temporary continuation of the metering point operations" sourceRef="g1" targetRef="sendTempMPOO" />
    <bpmn:sequenceFlow id="f3" name="temporary continuation of the measurement" sourceRef="g1" targetRef="sendTempMSPO" />
    <bpmn:sequenceFlow id="f4" name="additional readings" sourceRef="g1" targetRef="sendAdditional" />
    <bpmn:sequenceFlow id="f5" name="equipment acquisition" sourceRef="g1" targetRef="sendEquipment" />
    <bpmn:sequenceFlow id="f6" sourceRef="sendTempMPOO" targetRef="examineTempMPOO" />
    <bpmn:sequenceFlow id="f7" sourceRef="sendTempMSPO" targetRef="examineTempMSPO" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendAdditional" targetRef="examineAdditional" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendEquipment" targetRef="g2" />
    <bpmn:sequenceFlow id="f10" name="MPON" sourceRef="g2" targetRef="examineEquipmentMPON" />
    <bpmn:sequenceFlow id="f11" name="GO" sourceRef="g2" targetRef="examineEquipmentGO" />
    <bpmn:sequenceFlow id="f12" sourceRef="examineEquipmentMPON" targetRef="g5" />
    <bpmn:sequenceFlow id="f13" sourceRef="examineTempMPOO" targetRef="g3" />
    <bpmn:sequenceFlow id="f14" sourceRef="examineTempMSPO" targetRef="g3" />
    <bpmn:sequenceFlow id="f15" sourceRef="examineAdditional" targetRef="g3" />
    <bpmn:sequenceFlow id="f16" sourceRef="examineEquipmentGO" targetRef="g3" />
    <bpmn:sequenceFlow id="f17" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f18" name="confirmed" sourceRef="g4" targetRef="confirmGO" />
    <bpmn:sequenceFlow id="f19" name="rejected" sourceRef="g4" targetRef="rejectGO" />
    <bpmn:sequenceFlow id="f20" sourceRef="confirmGO" targetRef="endGO1" />
    <bpmn:sequenceFlow id="f21" sourceRef="rejectGO" targetRef="endGO2" />
    <bpmn:sequenceFlow id="f22" name="confirmed" sourceRef="g5" targetRef="confirmMPON" />
    <bpmn:sequenceFlow id="f23" name="rejected" sourceRef="g5" targetRef="rejectMPON" />
    <bpmn:sequenceFlow id="f24" sourceRef="confirmMPON" targetRef="endMPON1" />
    <bpmn:sequenceFlow id="f25" sourceRef="rejectMPON" targetRef="endMPON2" />
  </bpmn:process>
</bpmn:definitions>
