<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="dismissal-process" />
  </bpmn:collaboration>
  <bpmn:process id="dismissal-process" isExecutable="false">
    <bpmn:laneSet id="dismissal-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposed-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Dismissal to be decided" />
    <bpmn:task id="send" name="Send the dismissal to the MPOO" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal opposed or confirmed?" />
    <bpmn:task id="oppose" name="Oppose the dismissal of the MPON" />
    <bpmn:task id="confirm" name="Confirm the dismissal of the MPON" />
    <bpmn:endEvent id="opposed-end" name="Dismissal opposed" />
    <bpmn:endEvent id="confirmed-end" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f2" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f3" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="opposed" sourceRef="decision" targetRef="oppose" />
    <bpmn:sequenceFlow id="f5" name="confirmed" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="oppose" targetRef="opposed-end" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="confirmed-end" />
  </bpmn:process>
</bpmn:definitions>
