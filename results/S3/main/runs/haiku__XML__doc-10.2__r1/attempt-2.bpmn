<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="meter-operation-process" />
  </bpmn:collaboration>
  <bpmn:process id="meter-operation-process" isExecutable="false">
    <bpmn:laneSet id="meter-operation-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mponOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mponMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOOConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPOConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadlineTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadlineEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mponMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkMPONOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOOFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPOFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failureEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOOAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPOAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>successEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Meter operation to be reported" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="decide" name="Application confirmed or rejected?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:endEvent id="rejectedEnd" name="Application rejected" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="splitConfirm" />
    <bpmn:task id="informMPOOConfirm" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="informMSPOConfirm" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:task id="acquire" name="Perform equipment acquisition and/or equipment changes" />
    <bpmn:parallelGateway id="joinConfirm" />
    <bpmn:exclusiveGateway id="mponOutcome" name="Failure or successful completion?" />
    <bpmn:task id="informFailure" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="informSuccess" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:exclusiveGateway id="mponMerge" />
    <bpmn:eventBasedGateway id="waitMPON" name="MPON message or deadline" />
    <bpmn:intermediateCatchEvent id="deadlineTimer" name="Maximum time limit reached">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="informDeadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="deadlineEnd" name="Overall transaction failed by deadline" />
    <bpmn:intermediateCatchEvent id="mponMessage" name="Message of the MPON received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="checkMPONOutcome" name="Failure or successful completion?" />
    <bpmn:task id="confirmFailure" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="informMPOOFailure" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="informMSPOFailure" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:endEvent id="failureEnd" name="Assignment failed" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confirmAssignment" name="Confirm the assignment to the MPON" />
    <bpmn:parallelGateway id="splitAssignment" />
    <bpmn:task id="informMPOOAssignment" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="informMSPOAssignment" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="informSP" name="Inform the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="joinAssignment" />
    <bpmn:endEvent id="successEnd" name="Assignment completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f3" sourceRef="examine" targetRef="decide" />
    <bpmn:sequenceFlow id="f4" name="rejected" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="confirmed" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="rejectedEnd" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="splitConfirm" />
    <bpmn:sequenceFlow id="f8" sourceRef="splitConfirm" targetRef="informMPOOConfirm" />
    <bpmn:sequenceFlow id="f9" sourceRef="splitConfirm" targetRef="informMSPOConfirm" />
    <bpmn:sequenceFlow id="f10" sourceRef="splitConfirm" targetRef="acquire" />
    <bpmn:sequenceFlow id="f11" sourceRef="informMPOOConfirm" targetRef="joinConfirm" />
    <bpmn:sequenceFlow id="f12" sourceRef="informMSPOConfirm" targetRef="joinConfirm" />
    <bpmn:sequenceFlow id="f13" sourceRef="acquire" targetRef="joinConfirm" />
    <bpmn:sequenceFlow id="f14" sourceRef="joinConfirm" targetRef="mponOutcome" />
    <bpmn:sequenceFlow id="f15" name="failure" sourceRef="mponOutcome" targetRef="informFailure" />
    <bpmn:sequenceFlow id="f16" name="successful completion" sourceRef="mponOutcome" targetRef="informSuccess" />
    <bpmn:sequenceFlow id="f17" sourceRef="informFailure" targetRef="mponMerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="informSuccess" targetRef="mponMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="mponMerge" targetRef="waitMPON" />
    <bpmn:sequenceFlow id="f20" sourceRef="waitMPON" targetRef="deadlineTimer" />
    <bpmn:sequenceFlow id="f21" sourceRef="deadlineTimer" targetRef="informDeadline" />
    <bpmn:sequenceFlow id="f22" sourceRef="informDeadline" targetRef="deadlineEnd" />
    <bpmn:sequenceFlow id="f23" sourceRef="waitMPON" targetRef="mponMessage" />
    <bpmn:sequenceFlow id="f24" sourceRef="mponMessage" targetRef="checkMPONOutcome" />
    <bpmn:sequenceFlow id="f25" name="failure" sourceRef="checkMPONOutcome" targetRef="confirmFailure" />
    <bpmn:sequenceFlow id="f26" name="successful completion" sourceRef="checkMPONOutcome" targetRef="assign" />
    <bpmn:sequenceFlow id="f27" sourceRef="confirmFailure" targetRef="informMPOOFailure" />
    <bpmn:sequenceFlow id="f28" sourceRef="informMPOOFailure" targetRef="informMSPOFailure" />
    <bpmn:sequenceFlow id="f29" sourceRef="informMSPOFailure" targetRef="failureEnd" />
    <bpmn:sequenceFlow id="f30" sourceRef="assign" targetRef="confirmAssignment" />
    <bpmn:sequenceFlow id="f31" sourceRef="confirmAssignment" targetRef="splitAssignment" />
    <bpmn:sequenceFlow id="f32" sourceRef="splitAssignment" targetRef="informMPOOAssignment" />
    <bpmn:sequenceFlow id="f33" sourceRef="splitAssignment" targetRef="informMSPOAssignment" />
    <bpmn:sequenceFlow id="f34" sourceRef="splitAssignment" targetRef="informSP" />
    <bpmn:sequenceFlow id="f35" sourceRef="informMPOOAssignment" targetRef="joinAssignment" />
    <bpmn:sequenceFlow id="f36" sourceRef="informMSPOAssignment" targetRef="joinAssignment" />
    <bpmn:sequenceFlow id="f37" sourceRef="informSP" targetRef="joinAssignment" />
    <bpmn:sequenceFlow id="f38" sourceRef="joinAssignment" targetRef="successEnd" />
  </bpmn:process>
</bpmn:definitions>
