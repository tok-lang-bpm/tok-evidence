<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="meter-operation-process" />
  </bpmn:collaboration>
  <bpmn:process id="meter-operation-process" isExecutable="false">
    <bpmn:laneSet id="meter-operation-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mpon_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_success_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_failure_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_mpon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>t_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mpoo_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mspo_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_timeout_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mpoo_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mspo_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mpoo_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mspo_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_sp_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_assigned</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_report" name="Meter operation to be reported" />
    <bpmn:task id="t_report" name="Report the meter operation to the GO" />
    <bpmn:task id="t_examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="g_decision" name="Application confirmed?" />
    <bpmn:task id="t_reject" name="Reject the application of the MPON" />
    <bpmn:endEvent id="e_rejected" name="Application rejected" />
    <bpmn:task id="t_confirm" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="p_split" />
    <bpmn:task id="t_inform_mpoo_reg" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="t_inform_mspo_reg" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:task id="t_equipment" name="Perform the equipment acquisition and/or equipment changes" />
    <bpmn:parallelGateway id="p_join" />
    <bpmn:exclusiveGateway id="g_mpon_outcome" name="Entire process completed successfully?" />
    <bpmn:task id="t_success_report" name="Report the successful completion of the entire process to the GO" />
    <bpmn:task id="t_failure_report" name="Report the failure of the entire process to the GO" />
    <bpmn:exclusiveGateway id="m_mpon" />
    <bpmn:eventBasedGateway id="ev_wait" name="Report received or deadline?" />
    <bpmn:intermediateCatchEvent id="catch_msg" name="Report of the MPON received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_timer" name="Maximum time limit elapsed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_timeout_inform" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="e_timeout" name="Transaction failed by deadline" />
    <bpmn:exclusiveGateway id="g_outcome" name="Failure reported?" />
    <bpmn:task id="t_confirm_failure" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="t_inform_mpoo_fail" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="t_inform_mspo_fail" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:endEvent id="e_failed" name="Assignment failed" />
    <bpmn:task id="t_assign" name="Assign the MPON" />
    <bpmn:task id="t_confirm_assign" name="Confirm the assignment to the MPON" />
    <bpmn:task id="t_inform_mpoo_assign" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="t_inform_mspo_assign" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="t_inform_sp_assign" name="Inform the SP about the assignment of the MPON" />
    <bpmn:endEvent id="e_assigned" name="MPON assigned" />

    <bpmn:sequenceFlow id="f01" sourceRef="start_report" targetRef="t_report" />
    <bpmn:sequenceFlow id="f02" sourceRef="t_report" targetRef="t_examine" />
    <bpmn:sequenceFlow id="f03" sourceRef="t_examine" targetRef="g_decision" />
    <bpmn:sequenceFlow id="f04" name="rejected" sourceRef="g_decision" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f05" name="confirmed" sourceRef="g_decision" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f06" sourceRef="t_reject" targetRef="e_rejected" />
    <bpmn:sequenceFlow id="f07" sourceRef="t_confirm" targetRef="p_split" />
    <bpmn:sequenceFlow id="f08" sourceRef="p_split" targetRef="t_inform_mpoo_reg" />
    <bpmn:sequenceFlow id="f09" sourceRef="p_split" targetRef="t_inform_mspo_reg" />
    <bpmn:sequenceFlow id="f10" sourceRef="p_split" targetRef="t_equipment" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_inform_mpoo_reg" targetRef="p_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_inform_mspo_reg" targetRef="p_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_equipment" targetRef="p_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="p_join" targetRef="g_mpon_outcome" />
    <bpmn:sequenceFlow id="f15" name="successful" sourceRef="g_mpon_outcome" targetRef="t_success_report" />
    <bpmn:sequenceFlow id="f16" name="failed" sourceRef="g_mpon_outcome" targetRef="t_failure_report" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_success_report" targetRef="m_mpon" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_failure_report" targetRef="m_mpon" />
    <bpmn:sequenceFlow id="f19" sourceRef="m_mpon" targetRef="ev_wait" />
    <bpmn:sequenceFlow id="f20" sourceRef="ev_wait" targetRef="catch_msg" />
    <bpmn:sequenceFlow id="f21" sourceRef="ev_wait" targetRef="catch_timer" />
    <bpmn:sequenceFlow id="f22" sourceRef="catch_timer" targetRef="t_timeout_inform" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_timeout_inform" targetRef="e_timeout" />
    <bpmn:sequenceFlow id="f24" sourceRef="catch_msg" targetRef="g_outcome" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="g_outcome" targetRef="t_confirm_failure" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="g_outcome" targetRef="t_assign" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_confirm_failure" targetRef="t_inform_mpoo_fail" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_inform_mpoo_fail" targetRef="t_inform_mspo_fail" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_inform_mspo_fail" targetRef="e_failed" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_assign" targetRef="t_confirm_assign" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_confirm_assign" targetRef="t_inform_mpoo_assign" />
    <bpmn:sequenceFlow id="f32" sourceRef="t_inform_mpoo_assign" targetRef="t_inform_mspo_assign" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_inform_mspo_assign" targetRef="t_inform_sp_assign" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_inform_sp_assign" targetRef="e_assigned" />
  </bpmn:process>
</bpmn:definitions>
