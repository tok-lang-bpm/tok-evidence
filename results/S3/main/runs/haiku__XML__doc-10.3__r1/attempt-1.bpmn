<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="deregistration-process" />
  </bpmn:collaboration>
  <bpmn:process id="deregistration-process" isExecutable="false">
    <bpmn:laneSet id="deregistration-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmContinuation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmPreliminarily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareReadmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideContinuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obligeContinuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeContinuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performEquipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignGoAsMpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitInform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpooEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinInform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Deregistration requested" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="decideDeregistration" name="Deregistration verified?" />
    <bpmn:task id="rejectDeregistration" name="Reject the deregistration of the MPOO" />
    <bpmn:task id="confirmPreliminarily" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepareReadmission" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="decideContinuation" name="Oblige the MPOO to continue the operations?" />
    <bpmn:task id="obligeContinuation" name="Oblige the MPOO to continue the operations" />
    <bpmn:task id="confirmContinuation" name="Confirm the continuation to the MPOO" />
    <bpmn:exclusiveGateway id="mergeContinuation" />
    <bpmn:task id="performEquipment" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assignGoAsMpo" name="Assign the GO as MPO" />
    <bpmn:parallelGateway id="splitInform" />
    <bpmn:task id="informMpooEnd" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="informMspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informSp" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="joinInform" />
    <bpmn:endEvent id="endRejected" name="Deregistration rejected" />
    <bpmn:endEvent id="endCompleted" name="Deregistration completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="deregister" />
    <bpmn:sequenceFlow id="f2" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f3" sourceRef="verify" targetRef="decideDeregistration" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="decideDeregistration" targetRef="rejectDeregistration" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="decideDeregistration" targetRef="confirmPreliminarily" />
    <bpmn:sequenceFlow id="f6" sourceRef="rejectDeregistration" targetRef="endRejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirmPreliminarily" targetRef="prepareReadmission" />
    <bpmn:sequenceFlow id="f8" sourceRef="prepareReadmission" targetRef="decideContinuation" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="decideContinuation" targetRef="obligeContinuation" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="decideContinuation" targetRef="mergeContinuation" />
    <bpmn:sequenceFlow id="f11" sourceRef="obligeContinuation" targetRef="confirmContinuation" />
    <bpmn:sequenceFlow id="f12" sourceRef="confirmContinuation" targetRef="mergeContinuation" />
    <bpmn:sequenceFlow id="f13" sourceRef="mergeContinuation" targetRef="performEquipment" />
    <bpmn:sequenceFlow id="f14" sourceRef="performEquipment" targetRef="assignGoAsMpo" />
    <bpmn:sequenceFlow id="f15" sourceRef="assignGoAsMpo" targetRef="splitInform" />
    <bpmn:sequenceFlow id="f16" sourceRef="splitInform" targetRef="informMpooEnd" />
    <bpmn:sequenceFlow id="f17" sourceRef="splitInform" targetRef="informMspo" />
    <bpmn:sequenceFlow id="f18" sourceRef="splitInform" targetRef="informSp" />
    <bpmn:sequenceFlow id="f19" sourceRef="informMpooEnd" targetRef="joinInform" />
    <bpmn:sequenceFlow id="f20" sourceRef="informMspo" targetRef="joinInform" />
    <bpmn:sequenceFlow id="f21" sourceRef="informSp" targetRef="joinInform" />
    <bpmn:sequenceFlow id="f22" sourceRef="joinInform" targetRef="endCompleted" />
  </bpmn:process>
</bpmn:definitions>
