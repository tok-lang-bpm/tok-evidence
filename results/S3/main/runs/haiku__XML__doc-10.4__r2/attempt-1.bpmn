<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="metering" name="Metering" processRef="metering-process" />
  </bpmn:collaboration>
  <bpmn:process id="metering-process" isExecutable="false">
    <bpmn:laneSet id="metering-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalReadMpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountMpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellGo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>gwSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalReadMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountMpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>notifyMsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Equipment change intention" />
    <bpmn:task id="notifyMpoo" name="Notify the MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="gwSelf" name="Self-dismounting?" />
    <bpmn:task id="announce" name="Announce self-dismounting to the MPON" />
    <bpmn:task id="noSelf" name="Notify the MPON about no self-dismounting" />
    <bpmn:task id="finalReadMpoo" name="Perform the final reading" />
    <bpmn:task id="dismountMpoo" name="Dismount the old equipment" />
    <bpmn:task id="finalReadMpon" name="Perform the final reading" />
    <bpmn:task id="dismountMpon" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="gwMerge" name="Old equipment dismounted" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="readMeter" name="Read the meter count from the installed meter" />
    <bpmn:parallelGateway id="parSplit" name="Split" />
    <bpmn:task id="sendFinal" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tellGo" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:parallelGateway id="parJoin" name="Join" />
    <bpmn:task id="notifyMsp" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="end" name="Metering process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="notifyMpoo" />
    <bpmn:sequenceFlow id="f2" sourceRef="notifyMpoo" targetRef="gwSelf" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gwSelf" targetRef="announce" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gwSelf" targetRef="noSelf" />
    <bpmn:sequenceFlow id="f5" sourceRef="announce" targetRef="finalReadMpoo" />
    <bpmn:sequenceFlow id="f6" sourceRef="finalReadMpoo" targetRef="dismountMpoo" />
    <bpmn:sequenceFlow id="f7" sourceRef="dismountMpoo" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="noSelf" targetRef="finalReadMpon" />
    <bpmn:sequenceFlow id="f9" sourceRef="finalReadMpon" targetRef="dismountMpon" />
    <bpmn:sequenceFlow id="f10" sourceRef="dismountMpon" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f11" sourceRef="gwMerge" targetRef="mount" />
    <bpmn:sequenceFlow id="f12" sourceRef="mount" targetRef="readMeter" />
    <bpmn:sequenceFlow id="f13" sourceRef="readMeter" targetRef="parSplit" />
    <bpmn:sequenceFlow id="f14" sourceRef="parSplit" targetRef="sendFinal" />
    <bpmn:sequenceFlow id="f15" sourceRef="parSplit" targetRef="tellGo" />
    <bpmn:sequenceFlow id="f16" sourceRef="sendFinal" targetRef="parJoin" />
    <bpmn:sequenceFlow id="f17" sourceRef="tellGo" targetRef="parJoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="parJoin" targetRef="notifyMsp" />
    <bpmn:sequenceFlow id="f19" sourceRef="notifyMsp" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
