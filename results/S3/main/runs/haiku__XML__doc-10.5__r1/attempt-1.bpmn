<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="device-takeover-process" />
  </bpmn:collaboration>
  <bpmn:process id="device-takeover-process" isExecutable="false">
    <bpmn:laneSet id="device-takeover-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-bid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>send-tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-master-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Device takeover needed" />
    <bpmn:task id="request-bid" name="Request a device takeover bid of the MPOO" />
    <bpmn:task id="send-tender" name="Send a tender for the equipment takeover to the MPON" />
    <bpmn:task id="place-order" name="Place an order at the MPOO" />
    <bpmn:task id="confirm-order" name="Confirm the order of the MPON" />
    <bpmn:task id="send-master-data" name="Send the master data" />
    <bpmn:endEvent id="end" name="Device takeover handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request-bid" />
    <bpmn:sequenceFlow id="f2" sourceRef="request-bid" targetRef="send-tender" />
    <bpmn:sequenceFlow id="f3" sourceRef="send-tender" targetRef="place-order" />
    <bpmn:sequenceFlow id="f4" sourceRef="place-order" targetRef="confirm-order" />
    <bpmn:sequenceFlow id="f5" sourceRef="confirm-order" targetRef="send-master-data" />
    <bpmn:sequenceFlow id="f6" sourceRef="send-master-data" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
