<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="takeover-process" />
  </bpmn:collaboration>
  <bpmn:process id="takeover-process" isExecutable="false">
    <bpmn:laneSet id="takeover-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestBid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>sendTender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMasterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Takeover started" />
    <bpmn:task id="requestBid" name="Request a device takeover bid" />
    <bpmn:task id="sendTender" name="Send a tender for the equipment takeover" />
    <bpmn:task id="placeOrder" name="Place an order" />
    <bpmn:task id="confirmOrder" name="Confirm the order" />
    <bpmn:task id="sendMasterData" name="Send the master data" />
    <bpmn:endEvent id="end" name="Takeover completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="requestBid" />
    <bpmn:sequenceFlow id="f2" sourceRef="requestBid" targetRef="sendTender" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendTender" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="f4" sourceRef="placeOrder" targetRef="confirmOrder" />
    <bpmn:sequenceFlow id="f5" sourceRef="confirmOrder" targetRef="sendMasterData" />
    <bpmn:sequenceFlow id="f6" sourceRef="sendMasterData" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
