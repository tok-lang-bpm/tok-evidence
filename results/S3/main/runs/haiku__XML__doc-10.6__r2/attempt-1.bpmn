<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="dismissal-process" />
  </bpmn:collaboration>
  <bpmn:process id="dismissal-process" isExecutable="false">
    <bpmn:laneSet id="dismissal-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Dismissal needed" />
    <bpmn:task id="send-dismissal" name="Send the dismissal" />
    <bpmn:task id="review-dismissal" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decide" name="Dismissal rejected or confirmed?" />
    <bpmn:task id="reject-dismissal" name="Reject the dismissal of the MSPN" />
    <bpmn:task id="confirm-dismissal" name="Confirm the dismissal of the MSPN" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:endEvent id="end" name="Dismissal handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send-dismissal" />
    <bpmn:sequenceFlow id="f2" sourceRef="send-dismissal" targetRef="review-dismissal" />
    <bpmn:sequenceFlow id="f3" sourceRef="review-dismissal" targetRef="decide" />
    <bpmn:sequenceFlow id="f4" name="rejected" sourceRef="decide" targetRef="reject-dismissal" />
    <bpmn:sequenceFlow id="f5" name="confirmed" sourceRef="decide" targetRef="confirm-dismissal" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject-dismissal" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm-dismissal" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="merge" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
