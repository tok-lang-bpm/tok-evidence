<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mspn-lane" name="MSPN">
        <bpmn:flowNodeRef>measurement-available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-measurement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go-lane" name="GO">
        <bpmn:flowNodeRef>examine-application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>application-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-mspn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>application-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignment-informed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="measurement-available" name="Measurement available" />
    <bpmn:task id="register-measurement" name="Register the measurement at the GO" />
    <bpmn:task id="examine-application" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="application-decision" name="Application rejected or confirmed?" />
    <bpmn:task id="reject-application" name="Reject the application of the MSPN" />
    <bpmn:task id="confirm-application" name="Confirm the application of the MSPN" />
    <bpmn:task id="assign-mspn" name="Assign the MSPN" />
    <bpmn:task id="inform-mspo" name="Inform the MSPO about the assignment of the MSPN" />
    <bpmn:task id="inform-mpo" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="inform-sp" name="Inform the SP about the assignment of the MSPN" />
    <bpmn:endEvent id="application-rejected" name="Application rejected" />
    <bpmn:endEvent id="assignment-informed" name="Assignment informed" />
    <bpmn:sequenceFlow id="f1" sourceRef="measurement-available" targetRef="register-measurement" />
    <bpmn:sequenceFlow id="f2" sourceRef="register-measurement" targetRef="examine-application" />
    <bpmn:sequenceFlow id="f3" sourceRef="examine-application" targetRef="application-decision" />
    <bpmn:sequenceFlow id="f4" name="rejected" sourceRef="application-decision" targetRef="reject-application" />
    <bpmn:sequenceFlow id="f5" name="confirmed" sourceRef="application-decision" targetRef="confirm-application" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject-application" targetRef="application-rejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm-application" targetRef="assign-mspn" />
    <bpmn:sequenceFlow id="f8" sourceRef="assign-mspn" targetRef="inform-mspo" />
    <bpmn:sequenceFlow id="f9" sourceRef="inform-mspo" targetRef="inform-mpo" />
    <bpmn:sequenceFlow id="f10" sourceRef="inform-mpo" targetRef="inform-sp" />
    <bpmn:sequenceFlow id="f11" sourceRef="inform-sp" targetRef="assignment-informed" />
  </bpmn:process>
</bpmn:definitions>
