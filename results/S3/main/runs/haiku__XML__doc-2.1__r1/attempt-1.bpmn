<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="TELECO" name="TELECO" processRef="service-degradation-process" />
  </bpmn:collaboration>
  <bpmn:process id="service-degradation-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>start_perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_send_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_customer_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-cs" name="Customer Service">
        <bpmn:flowNodeRef>cs_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_reprio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_cs_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cs_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-es" name="Electronic Service">
        <bpmn:flowNodeRef>es_significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-sm" name="Service Management">
        <bpmn:flowNodeRef>sm_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_to_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_actual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_bc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_wait_tshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_sm_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>rp_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_rp_include</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_include</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_send_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_rcv_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rp_terminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_tshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_tshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rp_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>b_adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_billing_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Customer -->
    <bpmn:startEvent id="start_perceive" name="Service degradation perceived" />
    <bpmn:task id="c_send_list" name="Send the list of problem parameters to Customer Service" />
    <bpmn:task id="c_receive_report" name="Receive the report on service performance and problem resolution" />
    <bpmn:endEvent id="e_customer_end" name="Customer process ends" />

    <!-- Customer Service -->
    <bpmn:task id="cs_enter" name="Enter the problem report into system T" />
    <bpmn:task id="cs_compare" name="Compare the problem report with the customer SLA" />
    <bpmn:task id="cs_counter" name="Determine the necessary counter measures and their priorities" />
    <bpmn:exclusiveGateway id="g_premium" name="Customer premium?" />
    <bpmn:callActivity id="cs_extra" name="Link to the extra problem fix process" calledElement="extra-problem-fix-process" />
    <bpmn:exclusiveGateway id="m_premium" />
    <bpmn:exclusiveGateway id="g_significance" name="Significance affects counter measures?" />
    <bpmn:task id="cs_reprio" name="Re-prioritise the counter measures" />
    <bpmn:exclusiveGateway id="m_significance" />
    <bpmn:task id="cs_detailed" name="Create the detailed problem report" />
    <bpmn:task id="cs_send_detailed" name="Send the detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="m_cs_received" name="Service performance or problem resolution report received" />
    <bpmn:parallelGateway id="p_final" />
    <bpmn:task id="cs_report" name="Create the report for the customer detailing the service performance and the problem resolution" />
    <bpmn:task id="cs_send_report" name="Send the report to the customer" />
    <bpmn:parallelGateway id="p_send" />
    <bpmn:task id="cs_rebate" name="Report the SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="p_rebate" />
    <bpmn:parallelGateway id="j_final" />
    <bpmn:endEvent id="e_cs_end" name="Customer Service process ends" />

    <!-- Electronic Service -->
    <bpmn:serviceTask id="es_significance" name="Determine the significance of the customer" />

    <!-- Service Management -->
    <bpmn:task id="sm_investigate" name="Investigate whether the problem is analyzable by Service Management" />
    <bpmn:exclusiveGateway id="g_analyzable" name="Analyzable by Service Management?" />
    <bpmn:task id="sm_send_to_rp" name="Send the detailed problem report to Resource Provisioning" />
    <bpmn:task id="sm_analyse" name="Analyse the problem" />
    <bpmn:task id="sm_trouble" name="Create the trouble report indicating the type of problem" />
    <bpmn:exclusiveGateway id="m_status" />
    <bpmn:task id="sm_prepare" name="Prepare the final status report" />
    <bpmn:task id="sm_determine" name="Determine the counter measures based on the final status report" />
    <bpmn:exclusiveGateway id="g_counter" name="Counter measures required?" />
    <bpmn:task id="sm_send_actual" name="Send the actual service performance to Customer Service" />
    <bpmn:parallelGateway id="p_a" />
    <bpmn:task id="sm_minor" name="Undertake minor corrective actions" />
    <bpmn:exclusiveGateway id="m_resolution" />
    <bpmn:task id="sm_resolution" name="Create the problem resolution report" />
    <bpmn:task id="sm_send_resolution" name="Send the problem resolution report to Customer Service" />
    <bpmn:parallelGateway id="p_bc" />
    <bpmn:task id="sm_req" name="Create the request for automatic resource restoration" />
    <bpmn:task id="sm_send_req" name="Send the request for automatic resource restoration to Resource Provisioning" />
    <bpmn:parallelGateway id="p_req" />
    <bpmn:intermediateCatchEvent id="sm_wait_tshoot" name="Trouble-shooting report received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_sm_end" name="Service Management path ends" />

    <!-- Resource Provisioning -->
    <bpmn:task id="rp_check" name="Check whether there are any possible problems" />
    <bpmn:exclusiveGateway id="g_problem" name="Problem detected?" />
    <bpmn:task id="rp_notify" name="Create the notification about the normal service execution" />
    <bpmn:task id="rp_analyse" name="Analyse the problem" />
    <bpmn:task id="rp_trouble" name="Create the trouble report" />
    <bpmn:exclusiveGateway id="m_rp_include" />
    <bpmn:task id="rp_include" name="Include the trouble report or the normal execution notification in the status report" />
    <bpmn:task id="rp_send_status" name="Send the status report to Service Management" />
    <bpmn:parallelGateway id="p_rp" />
    <bpmn:eventBasedGateway id="rp_wait" name="Restoration request received within 2 days?" />
    <bpmn:intermediateCatchEvent id="rp_rcv_request" name="Restoration request received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="rp_timeout" name="Two days elapsed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_rp_terminated" name="Resource Provisioning terminates the process" />
    <bpmn:task id="rp_track" name="Track all possible errors" />
    <bpmn:task id="rp_correct" name="Undertake all necessary corrective actions" />
    <bpmn:task id="rp_tshoot" name="Create the trouble-shooting report" />
    <bpmn:parallelGateway id="p_tshoot" />
    <bpmn:endEvent id="e_rp_end" name="Resource Provisioning process ends" />

    <!-- Billing &amp; Collections -->
    <bpmn:task id="b_adjust" name="Adjust the billing" />
    <bpmn:endEvent id="e_billing_end" name="Billing adjusted" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f01" sourceRef="start_perceive" targetRef="c_send_list" />
    <bpmn:sequenceFlow id="f02" sourceRef="c_send_list" targetRef="cs_enter" />
    <bpmn:sequenceFlow id="f03" sourceRef="cs_enter" targetRef="cs_compare" />
    <bpmn:sequenceFlow id="f04" sourceRef="cs_compare" targetRef="cs_counter" />
    <bpmn:sequenceFlow id="f05" sourceRef="cs_counter" targetRef="es_significance" />
    <bpmn:sequenceFlow id="f06" sourceRef="es_significance" targetRef="g_premium" />
    <bpmn:sequenceFlow id="f07" name="yes" sourceRef="g_premium" targetRef="cs_extra" />
    <bpmn:sequenceFlow id="f08" name="no" sourceRef="g_premium" targetRef="m_premium" />
    <bpmn:sequenceFlow id="f09" sourceRef="cs_extra" targetRef="m_premium" />
    <bpmn:sequenceFlow id="f10" sourceRef="m_premium" targetRef="g_significance" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="g_significance" targetRef="cs_reprio" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="g_significance" targetRef="m_significance" />
    <bpmn:sequenceFlow id="f13" sourceRef="cs_reprio" targetRef="m_significance" />
    <bpmn:sequenceFlow id="f14" sourceRef="m_significance" targetRef="cs_detailed" />
    <bpmn:sequenceFlow id="f15" sourceRef="cs_detailed" targetRef="cs_send_detailed" />
    <bpmn:sequenceFlow id="f16" sourceRef="cs_send_detailed" targetRef="sm_investigate" />
    <bpmn:sequenceFlow id="f17" sourceRef="sm_investigate" targetRef="g_analyzable" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="g_analyzable" targetRef="sm_analyse" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="g_analyzable" targetRef="sm_send_to_rp" />
    <bpmn:sequenceFlow id="f20" sourceRef="sm_send_to_rp" targetRef="rp_check" />
    <bpmn:sequenceFlow id="f21" sourceRef="rp_check" targetRef="g_problem" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="g_problem" targetRef="rp_notify" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="g_problem" targetRef="rp_analyse" />
    <bpmn:sequenceFlow id="f24" sourceRef="rp_analyse" targetRef="rp_trouble" />
    <bpmn:sequenceFlow id="f25" sourceRef="rp_notify" targetRef="m_rp_include" />
    <bpmn:sequenceFlow id="f26" sourceRef="rp_trouble" targetRef="m_rp_include" />
    <bpmn:sequenceFlow id="f27" sourceRef="m_rp_include" targetRef="rp_include" />
    <bpmn:sequenceFlow id="f28" sourceRef="rp_include" targetRef="rp_send_status" />
    <bpmn:sequenceFlow id="f29" sourceRef="rp_send_status" targetRef="p_rp" />
    <bpmn:sequenceFlow id="f30" sourceRef="p_rp" targetRef="m_status" />
    <bpmn:sequenceFlow id="f31" sourceRef="p_rp" targetRef="rp_wait" />
    <bpmn:sequenceFlow id="f32" sourceRef="sm_analyse" targetRef="sm_trouble" />
    <bpmn:sequenceFlow id="f33" sourceRef="sm_trouble" targetRef="m_status" />
    <bpmn:sequenceFlow id="f34" sourceRef="m_status" targetRef="sm_prepare" />
    <bpmn:sequenceFlow id="f35" sourceRef="sm_prepare" targetRef="sm_determine" />
    <bpmn:sequenceFlow id="f36" sourceRef="sm_determine" targetRef="g_counter" />
    <bpmn:sequenceFlow id="f37" name="No problem detected" sourceRef="g_counter" targetRef="sm_send_actual" />
    <bpmn:sequenceFlow id="f38" name="Minor corrective actions required" sourceRef="g_counter" targetRef="sm_minor" />
    <bpmn:sequenceFlow id="f39" name="Automatic resource restoration required" sourceRef="g_counter" targetRef="sm_req" />
    <bpmn:sequenceFlow id="f40" sourceRef="sm_send_actual" targetRef="p_a" />
    <bpmn:sequenceFlow id="f41" sourceRef="p_a" targetRef="m_cs_received" />
    <bpmn:sequenceFlow id="f42" sourceRef="p_a" targetRef="e_sm_end" />
    <bpmn:sequenceFlow id="f43" sourceRef="sm_minor" targetRef="m_resolution" />
    <bpmn:sequenceFlow id="f44" sourceRef="m_resolution" targetRef="sm_resolution" />
    <bpmn:sequenceFlow id="f45" sourceRef="sm_resolution" targetRef="sm_send_resolution" />
    <bpmn:sequenceFlow id="f46" sourceRef="sm_send_resolution" targetRef="p_bc" />
    <bpmn:sequenceFlow id="f47" sourceRef="p_bc" targetRef="m_cs_received" />
    <bpmn:sequenceFlow id="f48" sourceRef="p_bc" targetRef="e_sm_end" />
    <bpmn:sequenceFlow id="f49" sourceRef="sm_req" targetRef="sm_send_req" />
    <bpmn:sequenceFlow id="f50" sourceRef="sm_send_req" targetRef="p_req" />
    <bpmn:sequenceFlow id="f51" sourceRef="p_req" targetRef="rp_rcv_request" />
    <bpmn:sequenceFlow id="f52" sourceRef="p_req" targetRef="sm_wait_tshoot" />
    <bpmn:sequenceFlow id="f53" sourceRef="sm_wait_tshoot" targetRef="m_resolution" />
    <bpmn:sequenceFlow id="f54" sourceRef="rp_wait" targetRef="rp_rcv_request" />
    <bpmn:sequenceFlow id="f55" sourceRef="rp_wait" targetRef="rp_timeout" />
    <bpmn:sequenceFlow id="f56" sourceRef="rp_timeout" targetRef="e_rp_terminated" />
    <bpmn:sequenceFlow id="f57" sourceRef="rp_rcv_request" targetRef="rp_track" />
    <bpmn:sequenceFlow id="f58" sourceRef="rp_track" targetRef="rp_correct" />
    <bpmn:sequenceFlow id="f59" sourceRef="rp_correct" targetRef="rp_tshoot" />
    <bpmn:sequenceFlow id="f60" sourceRef="rp_tshoot" targetRef="p_tshoot" />
    <bpmn:sequenceFlow id="f61" sourceRef="p_tshoot" targetRef="sm_wait_tshoot" />
    <bpmn:sequenceFlow id="f62" sourceRef="p_tshoot" targetRef="e_rp_end" />
    <bpmn:sequenceFlow id="f63" sourceRef="m_cs_received" targetRef="p_final" />
    <bpmn:sequenceFlow id="f64" sourceRef="p_final" targetRef="cs_report" />
    <bpmn:sequenceFlow id="f65" sourceRef="p_final" targetRef="cs_rebate" />
    <bpmn:sequenceFlow id="f66" sourceRef="cs_report" targetRef="cs_send_report" />
    <bpmn:sequenceFlow id="f67" sourceRef="cs_send_report" targetRef="p_send" />
    <bpmn:sequenceFlow id="f68" sourceRef="p_send" targetRef="j_final" />
    <bpmn:sequenceFlow id="f69" sourceRef="p_send" targetRef="c_receive_report" />
    <bpmn:sequenceFlow id="f70" sourceRef="cs_rebate" targetRef="p_rebate" />
    <bpmn:sequenceFlow id="f71" sourceRef="p_rebate" targetRef="j_final" />
    <bpmn:sequenceFlow id="f72" sourceRef="p_rebate" targetRef="b_adjust" />
    <bpmn:sequenceFlow id="f73" sourceRef="b_adjust" targetRef="e_billing_end" />
    <bpmn:sequenceFlow id="f74" sourceRef="j_final" targetRef="e_cs_end" />
    <bpmn:sequenceFlow id="f75" sourceRef="c_receive_report" targetRef="e_customer_end" />
  </bpmn:process>
</bpmn:definitions>
