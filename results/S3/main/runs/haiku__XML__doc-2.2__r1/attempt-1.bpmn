<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="switch-process" />
    <bpmn:participant id="grid" name="Grid operator" />
    <bpmn:participant id="oldsupplier" name="Old supplier" />
  </bpmn:collaboration>
  <bpmn:process id="switch-process" isExecutable="false">
    <bpmn:laneSet id="switch-lanes">
      <bpmn:lane id="customerLane" name="Customer">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customerService" name="Customer service">
        <bpmn:flowNodeRef>receiveData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterCrm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compareData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dataComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>existsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCustomerObject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkContractDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzeIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regenerateDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendGridRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCisContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptanceGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>importMeterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawnService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveMeterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinMeterData</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gridLane" name="Grid operator">
        <bpmn:flowNodeRef>checkSupplierConcurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrenceDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolveConflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminateOldContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMeterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>computeFinalBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gridEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gridRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="oldSupplierLane" name="Old supplier">
        <bpmn:flowNodeRef>sendFinalBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveOldBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oldSupplierEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="request" name="Switch-over request received" />
    <bpmn:task id="transmitData" name="Transmit customer data to customer service" />
    <bpmn:task id="receiveData" name="Receive customer data" />
    <bpmn:task id="enterCrm" name="Enter customer data object into CRM system" />
    <bpmn:task id="compareData" name="Compare customer data with internal customer database" />
    <bpmn:exclusiveGateway id="dataComplete" name="Data complete and plausible?" />
    <bpmn:task id="correctErrors" name="Correct errors on the basis of error list" />
    <bpmn:exclusiveGateway id="existsCheck" name="Customer exists in database?" />
    <bpmn:task id="createCustomerObject" name="Create new customer object" />
    <bpmn:task id="prepareContract" name="Prepare contract documents for supplier switch" />
    <bpmn:task id="checkContractDocs" name="Check contract documents automatically in CIS" />
    <bpmn:exclusiveGateway id="docsOk" name="Contract documents generated successfully?" />
    <bpmn:task id="analyzeIssues" name="Analyze and resolve causing issues" />
    <bpmn:task id="regenerateDocs" name="Generate contract documents again" />
    <bpmn:task id="sendConfirmation" name="Send confirmation document to customer" />
    <bpmn:task id="sendGridRequest" name="Send switch-over request to grid operator" />
    <bpmn:task id="checkSupplierConcurrence" name="Check switch-over request for supplier concurrence" />
    <bpmn:exclusiveGateway id="concurrenceDecision" name="Supplier concurrence?" />
    <bpmn:task id="resolveConflict" name="Inform suppliers and demand resolution of conflict" />
    <bpmn:task id="terminateOldContract" name="Terminate sales agreement with old supplier" />
    <bpmn:task id="createCisContract" name="Create CIS contract" />
    <bpmn:task id="receiveOldBilling" name="Receive confirmation of old supplier termination" />
    <bpmn:exclusiveGateway id="acceptanceGate" name="Customer withdraws within 7 days?" />
    <bpmn:task id="withdrawContract" name="Withdraw from switch contract" />
    <bpmn:task id="decideContract" name="Check contract details and decide" />
    <bpmn:task id="confirmContract" name="Confirm switch contract" />
    <bpmn:task id="sendMeterReport" name="Transmit meter data as services consumption report" />
    <bpmn:task id="receiveMeterData" name="Receive meter data" />
    <bpmn:parallelGateway id="joinMeterData" />
    <bpmn:task id="importMeterData" name="Import meter data into systems" />
    <bpmn:task id="computeFinalBilling" name="Compute final billing from meter data" />
    <bpmn:task id="sendFinalBilling" name="Send final billing to old supplier" />
    <bpmn:task id="createFinalBillingCustomer" name="Create and send final billing to customer" />
    <bpmn:endEvent id="withdrawn" name="Switch withdrawn" />
    <bpmn:endEvent id="processEnd" name="Customer acquisition ended" />
    <bpmn:endEvent id="withdrawnService" name="Switch withdrawn at customer service" />
    <bpmn:endEvent id="gridEnd" name="Grid operator process ended" />
    <bpmn:endEvent id="gridRejected" name="Switch rejected by grid operator" />
    <bpmn:endEvent id="oldSupplierEnd" name="Old supplier process ended" />
    <bpmn:endEvent id="endCustomer" name="Customer process ended" />

    <bpmn:sequenceFlow id="f1" sourceRef="request" targetRef="transmitData" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmitData" targetRef="receiveData" />
    <bpmn:sequenceFlow id="f3" sourceRef="receiveData" targetRef="enterCrm" />
    <bpmn:sequenceFlow id="f4" sourceRef="enterCrm" targetRef="compareData" />
    <bpmn:sequenceFlow id="f5" sourceRef="compareData" targetRef="dataComplete" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="dataComplete" targetRef="correctErrors" />
    <bpmn:sequenceFlow id="f7" sourceRef="correctErrors" targetRef="compareData" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="dataComplete" targetRef="existsCheck" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="existsCheck" targetRef="createCustomerObject" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="existsCheck" targetRef="prepareContract" />
    <bpmn:sequenceFlow id="f11" sourceRef="createCustomerObject" targetRef="prepareContract" />
    <bpmn:sequenceFlow id="f12" sourceRef="prepareContract" targetRef="checkContractDocs" />
    <bpmn:sequenceFlow id="f13" sourceRef="checkContractDocs" targetRef="docsOk" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="docsOk" targetRef="analyzeIssues" />
    <bpmn:sequenceFlow id="f15" sourceRef="analyzeIssues" targetRef="regenerateDocs" />
    <bpmn:sequenceFlow id="f16" sourceRef="regenerateDocs" targetRef="checkContractDocs" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="docsOk" targetRef="sendConfirmation" />
    <bpmn:sequenceFlow id="f18" sourceRef="sendConfirmation" targetRef="sendGridRequest" />
    <bpmn:sequenceFlow id="f19" sourceRef="sendGridRequest" targetRef="checkSupplierConcurrence" />
    <bpmn:sequenceFlow id="f20" sourceRef="checkSupplierConcurrence" targetRef="concurrenceDecision" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="concurrenceDecision" targetRef="resolveConflict" />
    <bpmn:sequenceFlow id="f22" sourceRef="resolveConflict" targetRef="gridRejected" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="concurrenceDecision" targetRef="terminateOldContract" />
    <bpmn:sequenceFlow id="f24" sourceRef="terminateOldContract" targetRef="receiveOldBilling" />
    <bpmn:sequenceFlow id="f25" sourceRef="receiveOldBilling" targetRef="createCisContract" />
    <bpmn:sequenceFlow id="f26" sourceRef="createCisContract" targetRef="decideContract" />
    <bpmn:sequenceFlow id="f27" sourceRef="decideContract" targetRef="acceptanceGate" />
    <bpmn:sequenceFlow id="f28" name="withdraw" sourceRef="acceptanceGate" targetRef="withdrawContract" />
    <bpmn:sequenceFlow id="f29" sourceRef="withdrawContract" targetRef="withdrawnService" />
    <bpmn:sequenceFlow id="f30" name="confirm" sourceRef="decideContract" targetRef="confirmContract" />
    <bpmn:sequenceFlow id="f31" sourceRef="confirmContract" targetRef="acceptanceGate" />
    <bpmn:sequenceFlow id="f32" name="accepted" sourceRef="acceptanceGate" targetRef="sendMeterReport" />
    <bpmn:sequenceFlow id="f33" sourceRef="sendMeterReport" targetRef="receiveMeterData" />
    <bpmn:sequenceFlow id="f34" sourceRef="sendMeterReport" targetRef="computeFinalBilling" />
    <bpmn:sequenceFlow id="f35" sourceRef="receiveMeterData" targetRef="joinMeterData" />
    <bpmn:sequenceFlow id="f36" sourceRef="computeFinalBilling" targetRef="joinMeterData" />
    <bpmn:sequenceFlow id="f37" sourceRef="joinMeterData" targetRef="importMeterData" />
    <bpmn:sequenceFlow id="f38" sourceRef="importMeterData" targetRef="processEnd" />
    <bpmn:sequenceFlow id="f39" sourceRef="computeFinalBilling" targetRef="sendFinalBilling" />
    <bpmn:sequenceFlow id="f40" sourceRef="sendFinalBilling" targetRef="receiveOldBilling" />
    <bpmn:sequenceFlow id="f41" sourceRef="sendFinalBilling" targetRef="createFinalBillingCustomer" />
    <bpmn:sequenceFlow id="f42" sourceRef="createFinalBillingCustomer" targetRef="endCustomer" />
    <bpmn:sequenceFlow id="f43" sourceRef="withdrawContract" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f44" sourceRef="resolveConflict" targetRef="gridEnd" />
  </bpmn:process>
</bpmn:definitions>
