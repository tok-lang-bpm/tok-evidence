<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="warrant-process" />
    <bpmn:participant id="party" name="Party" />
    <bpmn:participant id="police" name="Queensland Police" />
  </bpmn:collaboration>
  <bpmn:process id="warrant-process" isExecutable="false">
    <bpmn:laneSet id="warrant-lanes">
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward-police</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-file-awaiting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-file-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach-document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-expanded-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-over-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-handed-over</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-request" name="Warrant possession request received" />
    <bpmn:task id="receive-request" name="Receive the warrant possession request" />
    <bpmn:task id="retrieve-file" name="Retrieve the SCT file" />
    <bpmn:task id="forward-police" name="Forward the SCT warrant possession to Queensland Police" />
    <bpmn:task id="store-file-awaiting" name="Store the SCT physical file awaiting report" />
    <bpmn:intermediateCatchEvent id="wait-report" name="Police report received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="retrieve-file-report" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach-document" name="Attach the new SCT document" />
    <bpmn:task id="store-expanded-file" name="Store the expanded SCT physical file" />
    <bpmn:task id="hand-over-file" name="Hand over the physical SCT file to other MC internal staff" />
    <bpmn:endEvent id="end-handed-over" name="SCT file handed over" />
    <bpmn:sequenceFlow id="f1" sourceRef="start-request" targetRef="receive-request" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive-request" targetRef="retrieve-file" />
    <bpmn:sequenceFlow id="f3" sourceRef="retrieve-file" targetRef="forward-police" />
    <bpmn:sequenceFlow id="f4" sourceRef="forward-police" targetRef="store-file-awaiting" />
    <bpmn:sequenceFlow id="f5" sourceRef="store-file-awaiting" targetRef="wait-report" />
    <bpmn:sequenceFlow id="f6" sourceRef="wait-report" targetRef="retrieve-file-report" />
    <bpmn:sequenceFlow id="f7" sourceRef="retrieve-file-report" targetRef="attach-document" />
    <bpmn:sequenceFlow id="f8" sourceRef="attach-document" targetRef="store-expanded-file" />
    <bpmn:sequenceFlow id="f9" sourceRef="store-expanded-file" targetRef="hand-over-file" />
    <bpmn:sequenceFlow id="f10" sourceRef="hand-over-file" targetRef="end-handed-over" />
    <bpmn:messageFlow id="m1" sourceRef="party" targetRef="receive-request" />
    <bpmn:messageFlow id="m2" sourceRef="forward-police" targetRef="police" />
    <bpmn:messageFlow id="m3" sourceRef="police" targetRef="wait-report" />
  </bpmn:process>
</bpmn:definitions>
