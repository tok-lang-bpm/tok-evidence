<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Court Registry" processRef="hearing-preparation" />
  </bpmn:collaboration>
  <bpmn:process id="hearing-preparation" isExecutable="false">
    <bpmn:laneSet id="hearing-lanes">
      <bpmn:lane id="registry" name="Registry staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="court" name="Court">
        <bpmn:flowNodeRef>hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Each morning" />
    <bpmn:task id="checkFiles" name="Check the files yet to be processed for the court hearing that day" />
    <bpmn:exclusiveGateway id="gwMissing" name="Files missing?" default="f4" />
    <bpmn:task id="search" name="Initiate a search for the missing files" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="track" name="Track the files physically to the intended location" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="handover" name="Hand the files to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="hearings" name="Conduct the directions hearings" />
    <bpmn:endEvent id="end" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkFiles" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkFiles" targetRef="gwMissing" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gwMissing" targetRef="search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">missingFiles = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gwMissing" targetRef="merge" />
    <bpmn:sequenceFlow id="f5" sourceRef="search" targetRef="merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="merge" targetRef="track" />
    <bpmn:sequenceFlow id="f7" sourceRef="track" targetRef="split" />
    <bpmn:sequenceFlow id="f8" sourceRef="split" targetRef="handover" />
    <bpmn:sequenceFlow id="f9" sourceRef="split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f10" sourceRef="handover" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="distribute" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="join" targetRef="hearings" />
    <bpmn:sequenceFlow id="f13" sourceRef="hearings" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
