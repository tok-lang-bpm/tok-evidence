<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="claim-process" />
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="claim-lanes">
      <bpmn:lane id="claims-officer" name="Claims Officer">
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-recommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repeat-recommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior-claims-officer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>check-recommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-ok-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark-not-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-back</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="registered" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="write-recommendation" name="Write the settlement recommendation" />
    <bpmn:task id="check-recommendation" name="Check the settlement recommendation" />
    <bpmn:exclusiveGateway id="claim-ok-decision" name="Claim OK?" />
    <bpmn:task id="mark-ok" name="Mark the claim as OK" />
    <bpmn:task id="mark-not-ok" name="Mark the claim as Not OK" />
    <bpmn:task id="send-back" name="Send the claim back to the claims officer" />
    <bpmn:task id="repeat-recommendation" name="Repeat the settlement recommendation" />
    <bpmn:endEvent id="proceed" name="Claim handling process proceeds" />
    <bpmn:sequenceFlow id="f1" sourceRef="registered" targetRef="examine" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine" targetRef="write-recommendation" />
    <bpmn:sequenceFlow id="f3" sourceRef="write-recommendation" targetRef="check-recommendation" />
    <bpmn:sequenceFlow id="f4" sourceRef="check-recommendation" targetRef="claim-ok-decision" />
    <bpmn:sequenceFlow id="f5" name="OK" sourceRef="claim-ok-decision" targetRef="mark-ok" />
    <bpmn:sequenceFlow id="f6" name="Not OK" sourceRef="claim-ok-decision" targetRef="mark-not-ok" />
    <bpmn:sequenceFlow id="f7" sourceRef="mark-not-ok" targetRef="send-back" />
    <bpmn:sequenceFlow id="f8" sourceRef="send-back" targetRef="repeat-recommendation" />
    <bpmn:sequenceFlow id="f9" sourceRef="repeat-recommendation" targetRef="check-recommendation" />
    <bpmn:sequenceFlow id="f10" sourceRef="mark-ok" targetRef="proceed" />
  </bpmn:process>
</bpmn:definitions>
