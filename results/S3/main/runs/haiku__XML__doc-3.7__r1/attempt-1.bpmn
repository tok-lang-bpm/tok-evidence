<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Insurance Organisation" processRef="claim-process" />
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="claim-lanes">
      <bpmn:lane id="clerk-lane" name="Claims Administration">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-police-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile-file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handler-lane" name="Claims Handler">
        <bpmn:flowNodeRef>calculate-estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-action-plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager-lane" name="Claims Manager">
        <bpmn:flowNodeRef>negotiate-settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-claimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Claim received" />
    <bpmn:task id="search-police-report" name="Search the Police Report database for the Police Report" />
    <bpmn:task id="compile-file" name="Put the Police Report and the Claim Documentation in a file" />
    <bpmn:task id="calculate-estimate" name="Calculate the initial claim estimate" />
    <bpmn:task id="create-action-plan" name="Create the Action Plan based on the Action Plan Checklist" />
    <bpmn:task id="negotiate-settlement" name="Negotiate a settlement on the claim estimate" />
    <bpmn:task id="inform-claimant" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="end" name="Process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="search-police-report" />
    <bpmn:sequenceFlow id="f2" sourceRef="search-police-report" targetRef="compile-file" />
    <bpmn:sequenceFlow id="f3" sourceRef="compile-file" targetRef="calculate-estimate" />
    <bpmn:sequenceFlow id="f4" sourceRef="calculate-estimate" targetRef="create-action-plan" />
    <bpmn:sequenceFlow id="f5" sourceRef="create-action-plan" targetRef="negotiate-settlement" />
    <bpmn:sequenceFlow id="f6" sourceRef="negotiate-settlement" targetRef="inform-claimant" />
    <bpmn:sequenceFlow id="f7" sourceRef="inform-claimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
