<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="claim-process" />
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="claim-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification Department">
        <bpmn:flowNodeRef>check-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs-complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling Department">
        <bpmn:flowNodeRef>pick-up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positive-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone-garage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter-merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Claim started" />
    <bpmn:task id="submit" name="Submit the claim with relevant documentation" />
    <bpmn:task id="check-docs" name="Check the documents for completeness" />
    <bpmn:exclusiveGateway id="docs-complete" name="Documents complete?" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="pick-up" name="Pick up the claim" />
    <bpmn:task id="check-insurance" name="Check the insurance" />
    <bpmn:task id="assess" name="Perform the assessment" />
    <bpmn:exclusiveGateway id="positive-decision" name="Assessment positive?" />
    <bpmn:task id="phone-garage" name="Phone the garage to authorise the repairs" />
    <bpmn:task id="schedule-payment" name="Schedule the payment" />
    <bpmn:task id="reject" name="Reject the claim" />
    <bpmn:task id="send-letter" name="Send a letter to the customer" />
    <bpmn:exclusiveGateway id="letter-merge" />
    <bpmn:task id="receive-letter" name="Receive the letter" />
    <bpmn:endEvent id="end" name="Claim process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="check-docs" />
    <bpmn:sequenceFlow id="f3" sourceRef="check-docs" targetRef="docs-complete" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="docs-complete" targetRef="register" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="docs-complete" targetRef="submit" />
    <bpmn:sequenceFlow id="f6" sourceRef="register" targetRef="pick-up" />
    <bpmn:sequenceFlow id="f7" sourceRef="pick-up" targetRef="check-insurance" />
    <bpmn:sequenceFlow id="f8" sourceRef="check-insurance" targetRef="assess" />
    <bpmn:sequenceFlow id="f9" sourceRef="assess" targetRef="positive-decision" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="positive-decision" targetRef="phone-garage" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="positive-decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f12" sourceRef="phone-garage" targetRef="schedule-payment" />
    <bpmn:sequenceFlow id="f13" sourceRef="schedule-payment" targetRef="letter-merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="reject" targetRef="letter-merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="letter-merge" targetRef="send-letter" />
    <bpmn:sequenceFlow id="f16" sourceRef="send-letter" targetRef="receive-letter" />
    <bpmn:sequenceFlow id="f17" sourceRef="receive-letter" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
