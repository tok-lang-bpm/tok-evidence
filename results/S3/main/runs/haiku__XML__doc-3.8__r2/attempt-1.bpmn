<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="claim-process" />
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="claim-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>claimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>checkDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>pickUpClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessmentPositive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeMerged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claimReceived" name="Customer has a claim" />
    <bpmn:task id="submitClaim" name="Submit claim with relevant documentation" />
    <bpmn:task id="checkDocuments" name="Check the documents for completeness" />
    <bpmn:task id="registerClaim" name="Register the claim" />
    <bpmn:task id="pickUpClaim" name="Pick up the claim" />
    <bpmn:task id="checkInsurance" name="Check the insurance" />
    <bpmn:task id="performAssessment" name="Perform the assessment" />
    <bpmn:exclusiveGateway id="assessmentPositive" name="Assessment positive?" />
    <bpmn:task id="phoneGarage" name="Phone the garage to authorise the repairs" />
    <bpmn:task id="schedulePayment" name="Schedule the payment" />
    <bpmn:task id="rejectClaim" name="Reject the claim" />
    <bpmn:exclusiveGateway id="outcomeMerged" />
    <bpmn:task id="sendLetter" name="Send a letter to the customer" />
    <bpmn:endEvent id="processComplete" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="claimReceived" targetRef="submitClaim" />
    <bpmn:sequenceFlow id="f2" sourceRef="submitClaim" targetRef="checkDocuments" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkDocuments" targetRef="registerClaim" />
    <bpmn:sequenceFlow id="f4" sourceRef="registerClaim" targetRef="pickUpClaim" />
    <bpmn:sequenceFlow id="f5" sourceRef="pickUpClaim" targetRef="checkInsurance" />
    <bpmn:sequenceFlow id="f6" sourceRef="checkInsurance" targetRef="performAssessment" />
    <bpmn:sequenceFlow id="f7" sourceRef="performAssessment" targetRef="assessmentPositive" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="assessmentPositive" targetRef="phoneGarage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">assessment = positive</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" sourceRef="phoneGarage" targetRef="schedulePayment" />
    <bpmn:sequenceFlow id="f10" sourceRef="schedulePayment" targetRef="outcomeMerged" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="assessmentPositive" targetRef="rejectClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">assessment = negative</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f12" sourceRef="rejectClaim" targetRef="outcomeMerged" />
    <bpmn:sequenceFlow id="f13" sourceRef="outcomeMerged" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f14" sourceRef="sendLetter" targetRef="processComplete" />
  </bpmn:process>
</bpmn:definitions>
