<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="loan-approval-process" />
  </bpmn:collaboration>
  <bpmn:process id="loan-approval-process" isExecutable="false">
    <bpmn:laneSet id="loan-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>request-received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback-received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Loan System">
        <bpmn:flowNodeRef>assess-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve-loan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny-loan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-to-approver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-outcomes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Loan request started" />
    <bpmn:task id="request-received" name="Receive the customer request for a loan amount" />
    <bpmn:task id="assess-request" name="Invoke the risk assessment Web service to assess the request" />
    <bpmn:exclusiveGateway id="review-needed" name="Further review needed or amount of 10,000 or more?" />
    <bpmn:exclusiveGateway id="risk-decision" name="Small loan and low risk customer?" />
    <bpmn:task id="send-to-approver" name="Send the request to the approver Web service" />
    <bpmn:task id="approve-loan" name="Approve the loan" />
    <bpmn:task id="deny-loan" name="Deny the loan" />
    <bpmn:exclusiveGateway id="merge-outcomes" name="Merge outcomes" />
    <bpmn:task id="receive-feedback" name="Receive feedback from the assessor or approver" />
    <bpmn:task id="feedback-received" name="Feedback received by the customer" />
    <bpmn:endEvent id="end" name="Loan request handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request-received" />
    <bpmn:sequenceFlow id="f2" sourceRef="request-received" targetRef="assess-request" />
    <bpmn:sequenceFlow id="f3" sourceRef="assess-request" targetRef="review-needed" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="review-needed" targetRef="send-to-approver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">further review needed or amount &gt;= 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="review-needed" targetRef="risk-decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no further review needed and amount &lt; 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" name="small and low risk" sourceRef="risk-decision" targetRef="approve-loan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">loan is small and customer is low risk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" name="high risk" sourceRef="risk-decision" targetRef="deny-loan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customer is high risk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="otherwise" sourceRef="risk-decision" targetRef="send-to-approver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customer is neither low risk nor high risk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" sourceRef="send-to-approver" targetRef="merge-outcomes" />
    <bpmn:sequenceFlow id="f10" sourceRef="approve-loan" targetRef="merge-outcomes" />
    <bpmn:sequenceFlow id="f11" sourceRef="deny-loan" targetRef="merge-outcomes" />
    <bpmn:sequenceFlow id="f12" sourceRef="merge-outcomes" targetRef="receive-feedback" />
    <bpmn:sequenceFlow id="f13" sourceRef="receive-feedback" targetRef="feedback-received" />
    <bpmn:sequenceFlow id="f14" sourceRef="feedback-received" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
