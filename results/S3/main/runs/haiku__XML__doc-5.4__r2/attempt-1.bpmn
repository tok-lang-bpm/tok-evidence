<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <bpmn:laneSet id="expense-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>expense-needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rules-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check-receipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipts-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-back</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment-system" name="Payment system">
        <bpmn:flowNodeRef>payment-task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment-confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expenses-paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="expense-needed" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase the product or service" />
    <bpmn:task id="submit" name="Submit the expense report with a list of items and receipts" />
    <bpmn:task id="inspect" name="Inspect the expense report" />
    <bpmn:exclusiveGateway id="rules-gw" name="Expense rules decide the report on first inspection?" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:exclusiveGateway id="merge-review" />
    <bpmn:exclusiveGateway id="approval-gw" name="Approve or reject the report?" />
    <bpmn:task id="approve" name="Approve the expense report" />
    <bpmn:task id="reject" name="Reject the expense report" />
    <bpmn:task id="edit" name="Edit the expense report" />
    <bpmn:task id="check-receipts" name="Check the receipts against the list of items" />
    <bpmn:exclusiveGateway id="receipts-gw" name="Receipts submitted and matching the items?" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:task id="send-back" name="Send the expense report back to the employee" />
    <bpmn:serviceTask id="payment-task" name="Process the payment in the payment system" />
    <bpmn:intermediateCatchEvent id="payment-confirmed" name="Payment confirmed">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="expenses-paid" name="Expenses paid" />
    <bpmn:sequenceFlow id="f1" sourceRef="expense-needed" targetRef="purchase" />
    <bpmn:sequenceFlow id="f2" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f3" sourceRef="submit" targetRef="inspect" />
    <bpmn:sequenceFlow id="f4" sourceRef="inspect" targetRef="rules-gw" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="rules-gw" targetRef="merge-review" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="rules-gw" targetRef="review" />
    <bpmn:sequenceFlow id="f7" sourceRef="review" targetRef="merge-review" />
    <bpmn:sequenceFlow id="f8" sourceRef="merge-review" targetRef="approval-gw" />
    <bpmn:sequenceFlow id="f9" name="approve" sourceRef="approval-gw" targetRef="approve" />
    <bpmn:sequenceFlow id="f10" name="reject" sourceRef="approval-gw" targetRef="reject" />
    <bpmn:sequenceFlow id="f11" sourceRef="approve" targetRef="check-receipts" />
    <bpmn:sequenceFlow id="f12" sourceRef="check-receipts" targetRef="receipts-gw" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="receipts-gw" targetRef="accept" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="receipts-gw" targetRef="send-back" />
    <bpmn:sequenceFlow id="f15" sourceRef="accept" targetRef="payment-task" />
    <bpmn:sequenceFlow id="f16" sourceRef="payment-task" targetRef="payment-confirmed" />
    <bpmn:sequenceFlow id="f17" sourceRef="payment-confirmed" targetRef="expenses-paid" />
    <bpmn:sequenceFlow id="f18" sourceRef="send-back" targetRef="edit" />
    <bpmn:sequenceFlow id="f19" sourceRef="reject" targetRef="edit" />
    <bpmn:sequenceFlow id="f20" sourceRef="edit" targetRef="submit" />
  </bpmn:process>
</bpmn:definitions>
