<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-invoice-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-invoice-process" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_forward_acc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting employee">
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_note_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_forward_commercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resolve_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="costcenter" name="Cost center manager">
        <bpmn:flowNodeRef>m_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pass_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_return_acc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial manager">
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge_amt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>t_board</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="s_start" name="Invoice received on paper or fax" />
    <bpmn:task id="t_receive" name="Receive invoice in central inbox" />
    <bpmn:task id="t_inspect" name="Inspect invoice visually" />
    <bpmn:task id="t_forward_acc" name="Forward invoice to accounting employee" />

    <bpmn:task id="t_create" name="Identify charging supplier and create new invoice instance in ACME Financial Accounting" />
    <bpmn:task id="t_check_items" name="Check invoice items" />
    <bpmn:task id="t_note_cc" name="Note cost center and cost center managers for each position on docket" />
    <bpmn:task id="t_send_docket" name="Send docket and copy of invoice to internal mail" />
    <bpmn:task id="t_clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="g_consult" name="Consult cost center managers necessary?" />
    <bpmn:task id="t_consult" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="g_resolved" name="All inconsistencies resolved?" />
    <bpmn:task id="t_resend" name="Resend copy of invoice to cost center managers" />
    <bpmn:exclusiveGateway id="g_all" name="All positions marked AP?" />
    <bpmn:task id="t_forward_commercial" name="Forward copy of invoice to commercial manager" />
    <bpmn:task id="t_resolve_complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="t_file" name="Receive copy of invoice and docket in appropriate signature file" />
    <bpmn:task id="t_pay" name="Give payment instructions" />
    <bpmn:task id="t_close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="e_closed" name="Invoice closed" />

    <bpmn:exclusiveGateway id="m_cc" name="Copy of invoice received" />
    <bpmn:task id="t_review" name="Review invoice copy content for accuracy" />
    <bpmn:exclusiveGateway id="g_ok" name="Position in order?" />
    <bpmn:task id="t_ap" name="Note AP on docket" />
    <bpmn:task id="t_reject" name="Reject AP with note and explanatory statement on docket" />
    <bpmn:exclusiveGateway id="g_next" name="Further cost center managers on docket?" />
    <bpmn:task id="t_pass_next" name="Pass copy of invoice to next cost center manager via internal mail" />
    <bpmn:task id="t_return_acc" name="Send copy of invoice back to accounting" />

    <bpmn:task id="t_audit" name="Perform commercial audit" />
    <bpmn:exclusiveGateway id="g_complaint" name="Complaint during commercial audit?" />
    <bpmn:task id="t_approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="g_amount" name="Bill amount exceeds EUR 20?" />
    <bpmn:exclusiveGateway id="g_merge_amt" name="Invoice checked" />
    <bpmn:task id="t_board" name="Check invoice again (four-eyes principle)" />

    <bpmn:sequenceFlow id="f01" sourceRef="s_start" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f02" sourceRef="t_receive" targetRef="t_inspect" />
    <bpmn:sequenceFlow id="f03" sourceRef="t_inspect" targetRef="t_forward_acc" />
    <bpmn:sequenceFlow id="f04" sourceRef="t_forward_acc" targetRef="t_create" />
    <bpmn:sequenceFlow id="f05" sourceRef="t_create" targetRef="t_check_items" />
    <bpmn:sequenceFlow id="f06" sourceRef="t_check_items" targetRef="t_note_cc" />
    <bpmn:sequenceFlow id="f07" sourceRef="t_note_cc" targetRef="t_send_docket" />
    <bpmn:sequenceFlow id="f08" sourceRef="t_send_docket" targetRef="m_cc" />
    <bpmn:sequenceFlow id="f09" sourceRef="m_cc" targetRef="t_review" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_review" targetRef="g_ok" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="g_ok" targetRef="t_ap" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="g_ok" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_ap" targetRef="g_next" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="g_next" targetRef="t_pass_next" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_pass_next" targetRef="m_cc" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="g_next" targetRef="t_return_acc" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_return_acc" targetRef="g_all" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="g_all" targetRef="t_forward_commercial" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="g_all" targetRef="t_clarify" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_reject" targetRef="t_clarify" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_clarify" targetRef="g_consult" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="g_consult" targetRef="t_consult" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="g_consult" targetRef="g_resolved" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_consult" targetRef="g_resolved" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="g_resolved" targetRef="t_clarify" />
    <bpmn:sequenceFlow id="f26" name="yes" sourceRef="g_resolved" targetRef="t_resend" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_resend" targetRef="m_cc" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_forward_commercial" targetRef="t_audit" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_audit" targetRef="g_complaint" />
    <bpmn:sequenceFlow id="f30" name="yes" sourceRef="g_complaint" targetRef="t_resolve_complaint" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_resolve_complaint" targetRef="t_audit" />
    <bpmn:sequenceFlow id="f32" name="no" sourceRef="g_complaint" targetRef="t_approve" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_approve" targetRef="g_amount" />
    <bpmn:sequenceFlow id="f34" name="yes" sourceRef="g_amount" targetRef="t_board" />
    <bpmn:sequenceFlow id="f35" name="no" sourceRef="g_amount" targetRef="g_merge_amt" />
    <bpmn:sequenceFlow id="f36" sourceRef="t_board" targetRef="g_merge_amt" />
    <bpmn:sequenceFlow id="f37" sourceRef="g_merge_amt" targetRef="t_file" />
    <bpmn:sequenceFlow id="f38" sourceRef="t_file" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f39" sourceRef="t_pay" targetRef="t_close" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_close" targetRef="e_closed" />
  </bpmn:process>
</bpmn:definitions>
