<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-invoice" />
  </bpmn:collaboration>
  <bpmn:process id="acme-invoice" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting Employee">
        <bpmn:flowNodeRef>a_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consult_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cost_manager" name="Cost Center Manager">
        <bpmn:flowNodeRef>g_review_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_mark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_all_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_return_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_return_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial Manager">
        <bpmn:flowNodeRef>m_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_amount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>b_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_return</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Invoice received" />
    <bpmn:task id="s_receive" name="Receive invoice in central inbox" />
    <bpmn:task id="s_inspect" name="Inspect invoice visually" />
    <bpmn:task id="s_forward" name="Forward invoice to accounting employee" />

    <bpmn:task id="a_identify" name="Identify charging suppliers" />
    <bpmn:task id="a_create" name="Create new instance (invoice) in ACME Financial Accounting" />
    <bpmn:task id="a_check" name="Check invoice items" />
    <bpmn:task id="a_note" name="Note cost center and cost center managers for each position on docket" />
    <bpmn:task id="a_send" name="Send docket and copy of invoice to first cost center manager via internal mail" />
    <bpmn:exclusiveGateway id="g_review_in" />
    <bpmn:task id="c_review" name="Review invoice content for accuracy" />
    <bpmn:exclusiveGateway id="g_content" name="Content in order?" />
    <bpmn:task id="c_mark" name="Mark position AP on docket" />
    <bpmn:exclusiveGateway id="g_all_ap" name="All positions marked AP?" />
    <bpmn:task id="c_pass" name="Return copy of invoice to internal mail and pass it to next cost center manager" />
    <bpmn:task id="c_return_ap" name="Return copy of invoice to accounting" />
    <bpmn:task id="c_reject" name="Reject AP with note and explanation on docket" />
    <bpmn:task id="c_return_reject" name="Return copy of invoice to accounting directly" />

    <bpmn:task id="a_clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="g_consult" name="Consultation needed?" />
    <bpmn:task id="a_consult" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="g_consult_merge" />
    <bpmn:exclusiveGateway id="g_resolved" name="All inconsistencies resolved?" />
    <bpmn:task id="a_resend" name="Send copy of invoice to cost center managers again" />

    <bpmn:task id="a_forward" name="Forward copy of invoice to commercial manager" />
    <bpmn:task id="m_audit" name="Perform commercial audit" />
    <bpmn:exclusiveGateway id="g_complaint" name="Complaint during audit?" />
    <bpmn:task id="a_resolve" name="Resolve complaint with supplier" />
    <bpmn:task id="m_approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="g_amount" name="Amount exceeds EUR 20?" />
    <bpmn:task id="b_check" name="Check invoice again (four-eyes principle)" />
    <bpmn:task id="b_return" name="Return copy of invoice and docket to accounting in signature file" />
    <bpmn:exclusiveGateway id="g_pay" />
    <bpmn:task id="a_pay" name="Give payment instructions" />
    <bpmn:task id="a_close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="end" name="Invoice processed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="s_receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="s_receive" targetRef="s_inspect" />
    <bpmn:sequenceFlow id="f3" sourceRef="s_inspect" targetRef="s_forward" />
    <bpmn:sequenceFlow id="f4" sourceRef="s_forward" targetRef="a_identify" />
    <bpmn:sequenceFlow id="f5" sourceRef="a_identify" targetRef="a_create" />
    <bpmn:sequenceFlow id="f6" sourceRef="a_create" targetRef="a_check" />
    <bpmn:sequenceFlow id="f7" sourceRef="a_check" targetRef="a_note" />
    <bpmn:sequenceFlow id="f8" sourceRef="a_note" targetRef="a_send" />
    <bpmn:sequenceFlow id="f9" sourceRef="a_send" targetRef="g_review_in" />
    <bpmn:sequenceFlow id="f10" sourceRef="a_resend" targetRef="g_review_in" />
    <bpmn:sequenceFlow id="f11" sourceRef="c_pass" targetRef="g_review_in" />
    <bpmn:sequenceFlow id="f12" sourceRef="g_review_in" targetRef="c_review" />
    <bpmn:sequenceFlow id="f13" sourceRef="c_review" targetRef="g_content" />
    <bpmn:sequenceFlow id="f14" name="Yes" sourceRef="g_content" targetRef="c_mark" />
    <bpmn:sequenceFlow id="f15" name="No" sourceRef="g_content" targetRef="c_reject" />
    <bpmn:sequenceFlow id="f16" sourceRef="c_mark" targetRef="g_all_ap" />
    <bpmn:sequenceFlow id="f17" name="No" sourceRef="g_all_ap" targetRef="c_pass" />
    <bpmn:sequenceFlow id="f18" name="Yes" sourceRef="g_all_ap" targetRef="c_return_ap" />
    <bpmn:sequenceFlow id="f19" sourceRef="c_return_ap" targetRef="a_forward" />
    <bpmn:sequenceFlow id="f20" sourceRef="c_reject" targetRef="c_return_reject" />
    <bpmn:sequenceFlow id="f21" sourceRef="c_return_reject" targetRef="a_clarify" />
    <bpmn:sequenceFlow id="f22" sourceRef="a_clarify" targetRef="g_consult" />
    <bpmn:sequenceFlow id="f23" name="Yes" sourceRef="g_consult" targetRef="a_consult" />
    <bpmn:sequenceFlow id="f24" name="No" sourceRef="g_consult" targetRef="g_consult_merge" />
    <bpmn:sequenceFlow id="f25" sourceRef="a_consult" targetRef="g_consult_merge" />
    <bpmn:sequenceFlow id="f26" sourceRef="g_consult_merge" targetRef="g_resolved" />
    <bpmn:sequenceFlow id="f27" name="No" sourceRef="g_resolved" targetRef="a_clarify" />
    <bpmn:sequenceFlow id="f28" name="Yes" sourceRef="g_resolved" targetRef="a_resend" />
    <bpmn:sequenceFlow id="f29" sourceRef="a_forward" targetRef="m_audit" />
    <bpmn:sequenceFlow id="f30" sourceRef="m_audit" targetRef="g_complaint" />
    <bpmn:sequenceFlow id="f31" name="Yes" sourceRef="g_complaint" targetRef="a_resolve" />
    <bpmn:sequenceFlow id="f32" name="No" sourceRef="g_complaint" targetRef="m_approve" />
    <bpmn:sequenceFlow id="f33" sourceRef="a_resolve" targetRef="m_audit" />
    <bpmn:sequenceFlow id="f34" sourceRef="m_approve" targetRef="g_amount" />
    <bpmn:sequenceFlow id="f35" name="Yes" sourceRef="g_amount" targetRef="b_check" />
    <bpmn:sequenceFlow id="f36" name="No" sourceRef="g_amount" targetRef="g_pay" />
    <bpmn:sequenceFlow id="f37" sourceRef="b_check" targetRef="b_return" />
    <bpmn:sequenceFlow id="f38" sourceRef="b_return" targetRef="g_pay" />
    <bpmn:sequenceFlow id="f39" sourceRef="g_pay" targetRef="a_pay" />
    <bpmn:sequenceFlow id="f40" sourceRef="a_pay" targetRef="a_close" />
    <bpmn:sequenceFlow id="f41" sourceRef="a_close" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
