<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Product parts procurement" processRef="procurement-process" />
  </bpmn:collaboration>
  <bpmn:process id="procurement-process" isExecutable="false">
    <bpmn:laneSet id="procurement-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>monthly-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procurement-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthly-start" name="First of each month">
      <bpmn:timerEventDefinition id="monthly-timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="place-order" name="Place order for product parts" />
    <bpmn:sendTask id="send-order" name="Send the order to the supplier" />
    <bpmn:task id="process-order" name="Process the order" />
    <bpmn:sendTask id="send-invoice" name="Send the invoice to Assembler AG" />
    <bpmn:receiveTask id="receive-invoice" name="Receive the invoice" />
    <bpmn:endEvent id="procurement-end" name="Invoice received" />
    <bpmn:sequenceFlow id="f1" sourceRef="monthly-start" targetRef="place-order" />
    <bpmn:sequenceFlow id="f2" sourceRef="place-order" targetRef="send-order" />
    <bpmn:sequenceFlow id="f3" sourceRef="send-order" targetRef="process-order" />
    <bpmn:sequenceFlow id="f4" sourceRef="process-order" targetRef="send-invoice" />
    <bpmn:sequenceFlow id="f5" sourceRef="send-invoice" targetRef="receive-invoice" />
    <bpmn:sequenceFlow id="f6" sourceRef="receive-invoice" targetRef="procurement-end" />
  </bpmn:process>
</bpmn:definitions>
