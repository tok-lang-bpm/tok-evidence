<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Assembler AG" processRef="order-process" />
    <bpmn:participant id="supplier" name="Supplier" />
  </bpmn:collaboration>
  <bpmn:process id="order-process" isExecutable="false">
    <bpmn:laneSet id="order-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>monthStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplierLane" name="Supplier">
        <bpmn:flowNodeRef>processOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthStart" name="First of each month">
      <bpmn:timerEventDefinition id="monthTimer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">0 0 0 1 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="placeOrder" name="Place an order to request more product parts" />
    <bpmn:task id="sendOrder" name="Send the order to the supplier" />
    <bpmn:task id="processOrder" name="Process the order" />
    <bpmn:task id="sendInvoice" name="Send an invoice to Assembler AG" />
    <bpmn:task id="receiveInvoice" name="Receive the invoice" />
    <bpmn:endEvent id="orderDone" name="Invoice received" />
    <bpmn:sequenceFlow id="f1" sourceRef="monthStart" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="placeOrder" targetRef="sendOrder" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendOrder" targetRef="processOrder" />
    <bpmn:sequenceFlow id="f4" sourceRef="processOrder" targetRef="sendInvoice" />
    <bpmn:sequenceFlow id="f5" sourceRef="sendInvoice" targetRef="receiveInvoice" />
    <bpmn:sequenceFlow id="f6" sourceRef="receiveInvoice" targetRef="orderDone" />
  </bpmn:process>
</bpmn:definitions>
