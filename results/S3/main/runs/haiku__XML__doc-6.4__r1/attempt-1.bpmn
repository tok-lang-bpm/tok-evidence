<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-channels-merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave-alone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-interested-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-not-interested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head-dev" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>present-sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>follow-up-call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-contacted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-contacted-merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pre-sales" name="Pre-sales employee">
        <bpmn:flowNodeRef>present-technical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales-quote" name="Sales representative or staff">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-quoted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Potential customer identified" />
    <bpmn:task id="determine" name="Determine contact details of potential customers" />
    <bpmn:exclusiveGateway id="gw-channel" name="Acquisition channel?" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:exclusiveGateway id="gw-channels-merge" />
    <bpmn:task id="call" name="Start calling the customer" />
    <bpmn:task id="determine-contact" name="Determine the contact person" />
    <bpmn:task id="ask-interest" name="Ask whether the customer is generally interested" />
    <bpmn:exclusiveGateway id="gw-interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="gw-budget" name="Potential project budget huge?" />
    <bpmn:task id="acquire" name="Personally acquire the customer" />
    <bpmn:task id="leave-alone" name="Leave the customer alone" />
    <bpmn:exclusiveGateway id="gw-interested-merge" />
    <bpmn:endEvent id="end-not-interested" name="Customer not pursued" />
    <bpmn:task id="present-sales" name="Give detailed online presentation" />
    <bpmn:task id="present-technical" name="Give detailed online technical presentation" />
    <bpmn:exclusiveGateway id="gw-presentation" name="Technical presentation?" />
    <bpmn:exclusiveGateway id="gw-contacted" name="Customer contacted us within 2 weeks?" />
    <bpmn:task id="follow-up-call" name="Call the customer" />
    <bpmn:exclusiveGateway id="gw-contacted-merge" />
    <bpmn:task id="quote" name="Create a quotation" />
    <bpmn:endEvent id="end-quoted" name="Quotation created" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="determine" />
    <bpmn:sequenceFlow id="f2" sourceRef="determine" targetRef="gw-channel" />
    <bpmn:sequenceFlow id="f3" name="purchased" sourceRef="gw-channel" targetRef="buy" />
    <bpmn:sequenceFlow id="f4" name="exhibition" sourceRef="gw-channel" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f5" name="acquaintance" sourceRef="gw-channel" targetRef="call" />
    <bpmn:sequenceFlow id="f6" sourceRef="buy" targetRef="gw-channels-merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="exhibit" targetRef="gw-channels-merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="gw-channels-merge" targetRef="call" />
    <bpmn:sequenceFlow id="f9" sourceRef="call" targetRef="determine-contact" />
    <bpmn:sequenceFlow id="f10" sourceRef="determine-contact" targetRef="ask-interest" />
    <bpmn:sequenceFlow id="f11" sourceRef="ask-interest" targetRef="gw-interested" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gw-interested" targetRef="gw-budget" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="gw-interested" targetRef="present-sales" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gw-budget" targetRef="leave-alone" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="gw-budget" targetRef="acquire" />
    <bpmn:sequenceFlow id="f16" sourceRef="leave-alone" targetRef="end-not-interested" />
    <bpmn:sequenceFlow id="f17" sourceRef="acquire" targetRef="gw-interested-merge" />
    <bpmn:sequenceFlow id="f18" sourceRef="gw-interested-merge" targetRef="present-sales" />
    <bpmn:sequenceFlow id="f19" name="general" sourceRef="present-sales" targetRef="gw-presentation" />
    <bpmn:sequenceFlow id="f20" name="technical" sourceRef="gw-presentation" targetRef="present-technical" />
    <bpmn:sequenceFlow id="f21" name="standard" sourceRef="gw-presentation" targetRef="gw-contacted" />
    <bpmn:sequenceFlow id="f22" sourceRef="present-technical" targetRef="gw-contacted" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="gw-contacted" targetRef="gw-contacted-merge" />
    <bpmn:sequenceFlow id="f24" name="no" sourceRef="gw-contacted" targetRef="follow-up-call" />
    <bpmn:sequenceFlow id="f25" sourceRef="follow-up-call" targetRef="gw-contacted-merge" />
    <bpmn:sequenceFlow id="f26" sourceRef="gw-contacted-merge" targetRef="quote" />
    <bpmn:sequenceFlow id="f27" sourceRef="quote" targetRef="end-quoted" />
  </bpmn:process>
</bpmn:definitions>
