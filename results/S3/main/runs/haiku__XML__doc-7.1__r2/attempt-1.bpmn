<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-leads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-leads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct-assistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call-next-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all-called</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-processed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales-assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-note</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Open leads available" />
    <bpmn:task id="check-leads" name="Check the open leads" />
    <bpmn:task id="select-leads" name="Select the top five leads" />
    <bpmn:task id="instruct-assistant" name="Tell the Sales Assistant to call the contact persons of the leads" />
    <bpmn:task id="call-customer" name="Call the customer" />
    <bpmn:exclusiveGateway id="interested-decision" name="Someone interested?" />
    <bpmn:task id="send-note" name="Send a note to the Manager" />
    <bpmn:task id="process-lead" name="Process the lead" />
    <bpmn:task id="call-next-customer" name="Call the next customer" />
    <bpmn:exclusiveGateway id="all-called" name="All customers called?" />
    <bpmn:endEvent id="end-processed" name="Lead processed" />
    <bpmn:endEvent id="end-done" name="All customers called" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check-leads" />
    <bpmn:sequenceFlow id="f2" sourceRef="check-leads" targetRef="select-leads" />
    <bpmn:sequenceFlow id="f3" sourceRef="select-leads" targetRef="instruct-assistant" />
    <bpmn:sequenceFlow id="f4" sourceRef="instruct-assistant" targetRef="call-customer" />
    <bpmn:sequenceFlow id="f5" sourceRef="call-customer" targetRef="interested-decision" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="interested-decision" targetRef="send-note" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="interested-decision" targetRef="call-next-customer" />
    <bpmn:sequenceFlow id="f8" sourceRef="send-note" targetRef="process-lead" />
    <bpmn:sequenceFlow id="f9" sourceRef="process-lead" targetRef="end-processed" />
    <bpmn:sequenceFlow id="f10" sourceRef="call-next-customer" targetRef="all-called" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="all-called" targetRef="call-customer" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="all-called" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
