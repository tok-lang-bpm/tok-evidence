<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="hr-process" />
  </bpmn:collaboration>
  <bpmn:process id="hr-process" isExecutable="false">
    <bpmn:laneSet id="hr-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>vacancy-reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer-question</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consider-jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-jd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR clerk">
        <bpmn:flowNodeRef>create-jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>still-confused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-department</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-clarified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct-jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post-job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>job-posted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="vacancy-reported" name="Vacancy reported" />
    <bpmn:task id="create-jd" name="Create the job description" />
    <bpmn:exclusiveGateway id="still-confused" name="Message still confused?" />
    <bpmn:task id="ask-department" name="Ask the Department again" />
    <bpmn:task id="answer-question" name="Answer the question" />
    <bpmn:exclusiveGateway id="merge-clarified" />
    <bpmn:exclusiveGateway id="merge-submit" />
    <bpmn:task id="submit-jd" name="Submit the job description for consideration" />
    <bpmn:task id="consider-jd" name="Consider the job description" />
    <bpmn:exclusiveGateway id="approved" name="Job description approved?" />
    <bpmn:task id="reject-jd" name="Reject the job description and request a correction" />
    <bpmn:task id="correct-jd" name="Correct the job description" />
    <bpmn:task id="post-job" name="Post the job" />
    <bpmn:endEvent id="job-posted" name="Job posted" />
    <bpmn:sequenceFlow id="f1" sourceRef="vacancy-reported" targetRef="create-jd" />
    <bpmn:sequenceFlow id="f2" sourceRef="create-jd" targetRef="still-confused" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="still-confused" targetRef="ask-department" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="still-confused" targetRef="merge-clarified" />
    <bpmn:sequenceFlow id="f5" sourceRef="ask-department" targetRef="answer-question" />
    <bpmn:sequenceFlow id="f6" sourceRef="answer-question" targetRef="merge-clarified" />
    <bpmn:sequenceFlow id="f7" sourceRef="merge-clarified" targetRef="merge-submit" />
    <bpmn:sequenceFlow id="f8" sourceRef="merge-submit" targetRef="submit-jd" />
    <bpmn:sequenceFlow id="f9" sourceRef="submit-jd" targetRef="consider-jd" />
    <bpmn:sequenceFlow id="f10" sourceRef="consider-jd" targetRef="approved" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="approved" targetRef="post-job" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="approved" targetRef="reject-jd" />
    <bpmn:sequenceFlow id="f13" sourceRef="reject-jd" targetRef="correct-jd" />
    <bpmn:sequenceFlow id="f14" sourceRef="correct-jd" targetRef="merge-submit" />
    <bpmn:sequenceFlow id="f15" sourceRef="post-job" targetRef="job-posted" />
  </bpmn:process>
</bpmn:definitions>
