<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="recruitment-process" />
  </bpmn:collaboration>
  <bpmn:process id="recruitment-process" isExecutable="false">
    <bpmn:laneSet id="recruitment-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>vacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr-clerk" name="HR Clerk">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-clarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confusing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="vacancy" name="Vacancy to be filled" />
    <bpmn:task id="report" name="Report the vacancy" />
    <bpmn:task id="create" name="Create the job description from the information" />
    <bpmn:exclusiveGateway id="merge-clarification" />
    <bpmn:exclusiveGateway id="confusing" name="Message still confusing?" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:task id="submit" name="Submit the job description for consideration" />
    <bpmn:task id="consider" name="Consider the job description" />
    <bpmn:exclusiveGateway id="decision" name="Approved?" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:task id="reject" name="Reject the job description and request a correction" />
    <bpmn:task id="correct" name="Correct the job description" />
    <bpmn:task id="resubmit" name="Submit the corrected job description again for consideration" />
    <bpmn:task id="post" name="Post the job" />
    <bpmn:endEvent id="end" name="Job posted" />
    <bpmn:sequenceFlow id="f1" sourceRef="vacancy" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="create" />
    <bpmn:sequenceFlow id="f3" sourceRef="create" targetRef="merge-clarification" />
    <bpmn:sequenceFlow id="f4" sourceRef="merge-clarification" targetRef="confusing" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="confusing" targetRef="ask" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="confusing" targetRef="submit" />
    <bpmn:sequenceFlow id="f7" sourceRef="ask" targetRef="merge-clarification" />
    <bpmn:sequenceFlow id="f8" sourceRef="submit" targetRef="consider" />
    <bpmn:sequenceFlow id="f9" sourceRef="consider" targetRef="decision" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="decision" targetRef="approve" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f12" sourceRef="approve" targetRef="post" />
    <bpmn:sequenceFlow id="f13" sourceRef="post" targetRef="end" />
    <bpmn:sequenceFlow id="f14" sourceRef="reject" targetRef="correct" />
    <bpmn:sequenceFlow id="f15" sourceRef="correct" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f16" sourceRef="resubmit" targetRef="consider" />
  </bpmn:process>
</bpmn:definitions>
