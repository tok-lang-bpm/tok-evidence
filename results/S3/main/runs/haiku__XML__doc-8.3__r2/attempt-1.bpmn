<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="vacancy-process" />
  </bpmn:collaboration>
  <bpmn:process id="vacancy-process" isExecutable="false">
    <bpmn:laneSet id="vacancy-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>start_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_clar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv_jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>recv_vacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_req" name="Personnel requirements arise" />
    <bpmn:task id="detect" name="Detect personnel requirements" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:task id="recv_vacancy" name="Receive the vacancy report" />
    <bpmn:exclusiveGateway id="g_q" name="Questions about tasks and requirements?" />
    <bpmn:task id="ask_q" name="Ask questions about tasks and requirements" />
    <bpmn:task id="provide_clar" name="Provide clarifications" />
    <bpmn:exclusiveGateway id="g_desc" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:sendTask id="send_jd" name="Send the job description" />
    <bpmn:exclusiveGateway id="g_send" />
    <bpmn:receiveTask id="recv_jd" name="Receive the job description" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="g_corr" name="Corrections needed?" />
    <bpmn:task id="req_corr" name="Request corrections" />
    <bpmn:task id="correct" name="Correct the job description" />
    <bpmn:sendTask id="send_corr" name="Send the corrected job description" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:task id="advertise" name="Advertise the job" />
    <bpmn:endEvent id="end_done" name="Job advertised" />
    <bpmn:sequenceFlow id="f1" sourceRef="start_req" targetRef="detect" />
    <bpmn:sequenceFlow id="f2" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f3" sourceRef="report" targetRef="recv_vacancy" />
    <bpmn:sequenceFlow id="f4" sourceRef="recv_vacancy" targetRef="g_q" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="g_q" targetRef="ask_q" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="g_q" targetRef="g_desc" />
    <bpmn:sequenceFlow id="f7" sourceRef="ask_q" targetRef="provide_clar" />
    <bpmn:sequenceFlow id="f8" sourceRef="provide_clar" targetRef="g_desc" />
    <bpmn:sequenceFlow id="f9" sourceRef="g_desc" targetRef="describe" />
    <bpmn:sequenceFlow id="f10" sourceRef="describe" targetRef="send_jd" />
    <bpmn:sequenceFlow id="f11" sourceRef="send_jd" targetRef="g_send" />
    <bpmn:sequenceFlow id="f12" sourceRef="g_send" targetRef="recv_jd" />
    <bpmn:sequenceFlow id="f13" sourceRef="recv_jd" targetRef="review" />
    <bpmn:sequenceFlow id="f14" sourceRef="review" targetRef="g_corr" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="g_corr" targetRef="req_corr" />
    <bpmn:sequenceFlow id="f16" sourceRef="req_corr" targetRef="correct" />
    <bpmn:sequenceFlow id="f17" sourceRef="correct" targetRef="send_corr" />
    <bpmn:sequenceFlow id="f18" sourceRef="send_corr" targetRef="g_send" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="g_corr" targetRef="approve" />
    <bpmn:sequenceFlow id="f20" sourceRef="approve" targetRef="advertise" />
    <bpmn:sequenceFlow id="f21" sourceRef="advertise" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
