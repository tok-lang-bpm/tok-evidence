<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="defaulter-process" />
  </bpmn:collaboration>
  <bpmn:process id="defaulter-process" isExecutable="false">
    <bpmn:laneSet id="defaulter-lanes">
      <bpmn:lane id="reporting-system" name="Reporting system">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCrm1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newReturns1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinAdvised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCrm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newReturns2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTableCurrent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoReturns1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoReturns2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endLate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Weekday morning" />
    <bpmn:task id="backup" name="Back up the database" />
    <bpmn:task id="checkTable" name="Check the Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="newRecords" name="New records found?" />
    <bpmn:task id="checkCrm1" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="newReturns1" name="New returns filed?" />
    <bpmn:task id="register" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="advised" name="Defaulting client codes previously advised?" />
    <bpmn:task id="produceTable" name="Produce another table of defaulting accounts" />
    <bpmn:task id="sendTable" name="Send the table to account management" />
    <bpmn:exclusiveGateway id="joinAdvised" />
    <bpmn:exclusiveGateway id="deadline1" name="Completed by 2:30 pm?" />
    <bpmn:task id="alert1" name="Send an alert to the supervisor" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:task id="checkCrm2" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="newReturns2" name="New returns filed?" />
    <bpmn:task id="reconcile" name="Reconcile with the existing Account Defaulter table" />
    <bpmn:exclusiveGateway id="deadline2" name="Completed by 4:00 pm?" />
    <bpmn:task id="message" name="Send a message to the supervisor" />
    <bpmn:endEvent id="endTableCurrent" name="Defaulter table already current" />
    <bpmn:endEvent id="endNoReturns1" name="No new returns" />
    <bpmn:endEvent id="endNoReturns2" name="No new returns" />
    <bpmn:endEvent id="endDone" name="Defaulting account report completed" />
    <bpmn:endEvent id="endLate" name="Supervisor messaged about late reconciliation" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="backup" />
    <bpmn:sequenceFlow id="f2" sourceRef="backup" targetRef="checkTable" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkTable" targetRef="newRecords" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="newRecords" targetRef="endTableCurrent" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="newRecords" targetRef="checkCrm1" />
    <bpmn:sequenceFlow id="f6" sourceRef="checkCrm1" targetRef="newReturns1" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="newReturns1" targetRef="endNoReturns1" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="newReturns1" targetRef="register" />
    <bpmn:sequenceFlow id="f9" sourceRef="register" targetRef="advised" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="advised" targetRef="produceTable" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="advised" targetRef="joinAdvised" />
    <bpmn:sequenceFlow id="f12" sourceRef="produceTable" targetRef="sendTable" />
    <bpmn:sequenceFlow id="f13" sourceRef="sendTable" targetRef="joinAdvised" />
    <bpmn:sequenceFlow id="f14" sourceRef="joinAdvised" targetRef="deadline1" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="deadline1" targetRef="merge1" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="deadline1" targetRef="alert1" />
    <bpmn:sequenceFlow id="f17" sourceRef="alert1" targetRef="merge1" />
    <bpmn:sequenceFlow id="f18" sourceRef="merge1" targetRef="checkCrm2" />
    <bpmn:sequenceFlow id="f19" sourceRef="checkCrm2" targetRef="newReturns2" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="newReturns2" targetRef="endNoReturns2" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="newReturns2" targetRef="reconcile" />
    <bpmn:sequenceFlow id="f22" sourceRef="reconcile" targetRef="deadline2" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="deadline2" targetRef="endDone" />
    <bpmn:sequenceFlow id="f24" name="no" sourceRef="deadline2" targetRef="message" />
    <bpmn:sequenceFlow id="f25" sourceRef="message" targetRef="endLate" />
  </bpmn:process>
</bpmn:definitions>
