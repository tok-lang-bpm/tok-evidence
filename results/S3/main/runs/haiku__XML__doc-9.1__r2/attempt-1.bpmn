<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="defaulters-process" />
  </bpmn:collaboration>
  <bpmn:process id="defaulters-process" isExecutable="false">
    <bpmn:laneSet id="defaulters-lanes">
      <bpmn:lane id="reporting-system" name="Reporting System (Database and CRM)">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-table</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-new-records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-crm-1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-new-returns-1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-no-returns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-previously-advised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce-table</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-table</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-2-30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert-supervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-alerted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-crm-2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-new-returns-2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-4-00</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message-supervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-reconciled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-supervisor-messaged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-no-reconciliation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Weekday morning" />
    <bpmn:task id="backup" name="Back up the database" />
    <bpmn:task id="check-table" name="Check the Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="gw-new-records" name="New records found?" />
    <bpmn:exclusiveGateway id="merge-register" name="Merge" />
    <bpmn:task id="check-crm-1" name="Check the CRM system to see whether new returns have been filed" />
    <bpmn:exclusiveGateway id="gw-new-returns-1" name="New returns filed?" />
    <bpmn:endEvent id="end-no-returns" name="No new returns" />
    <bpmn:task id="register" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="gw-previously-advised" name="Defaulting client codes previously advised?" />
    <bpmn:task id="produce-table" name="Produce another table of defaulting accounts" />
    <bpmn:sendTask id="send-table" name="Send the table to account management" />
    <bpmn:exclusiveGateway id="merge-report" name="Merge" />
    <bpmn:exclusiveGateway id="gw-2-30" name="Completed by 2:30 pm?" />
    <bpmn:sendTask id="alert-supervisor" name="Send an alert to the supervisor" />
    <bpmn:endEvent id="end-alerted" name="Deadline missed, supervisor alerted" />
    <bpmn:task id="check-crm-2" name="Check the CRM system to see whether new returns have been filed" />
    <bpmn:exclusiveGateway id="gw-new-returns-2" name="New returns filed?" />
    <bpmn:task id="reconcile" name="Reconcile with the existing account defaulters table" />
    <bpmn:exclusiveGateway id="gw-4-00" name="Completed by 4:00 pm?" />
    <bpmn:sendTask id="message-supervisor" name="Send a message to the supervisor" />
    <bpmn:endEvent id="end-reconciled" name="Reconciliation complete" />
    <bpmn:endEvent id="end-supervisor-messaged" name="Supervisor messaged" />
    <bpmn:endEvent id="end-no-reconciliation" name="No new returns to reconcile" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="backup" />
    <bpmn:sequenceFlow id="f2" sourceRef="backup" targetRef="check-table" />
    <bpmn:sequenceFlow id="f3" sourceRef="check-table" targetRef="gw-new-records" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gw-new-records" targetRef="merge-register" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gw-new-records" targetRef="check-crm-1" />
    <bpmn:sequenceFlow id="f6" sourceRef="check-crm-1" targetRef="gw-new-returns-1" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gw-new-returns-1" targetRef="merge-register" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gw-new-returns-1" targetRef="end-no-returns" />
    <bpmn:sequenceFlow id="f9" sourceRef="merge-register" targetRef="register" />
    <bpmn:sequenceFlow id="f10" sourceRef="register" targetRef="gw-previously-advised" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gw-previously-advised" targetRef="merge-report" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gw-previously-advised" targetRef="produce-table" />
    <bpmn:sequenceFlow id="f13" sourceRef="produce-table" targetRef="send-table" />
    <bpmn:sequenceFlow id="f14" sourceRef="send-table" targetRef="merge-report" />
    <bpmn:sequenceFlow id="f15" sourceRef="merge-report" targetRef="gw-2-30" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gw-2-30" targetRef="alert-supervisor" />
    <bpmn:sequenceFlow id="f17" sourceRef="alert-supervisor" targetRef="end-alerted" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="gw-2-30" targetRef="check-crm-2" />
    <bpmn:sequenceFlow id="f19" sourceRef="check-crm-2" targetRef="gw-new-returns-2" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="gw-new-returns-2" targetRef="reconcile" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="gw-new-returns-2" targetRef="end-no-reconciliation" />
    <bpmn:sequenceFlow id="f22" sourceRef="reconcile" targetRef="gw-4-00" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="gw-4-00" targetRef="end-reconciled" />
    <bpmn:sequenceFlow id="f24" name="no" sourceRef="gw-4-00" targetRef="message-supervisor" />
    <bpmn:sequenceFlow id="f25" sourceRef="message-supervisor" targetRef="end-supervisor-messaged" />
  </bpmn:process>
</bpmn:definitions>
