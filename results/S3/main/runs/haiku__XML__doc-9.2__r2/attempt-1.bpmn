<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="mortgage-process" />
  </bpmn:collaboration>
  <bpmn:process id="mortgage-process" isExecutable="false">
    <bpmn:laneSet id="mortgage-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moveAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admin" name="Administration">
        <bpmn:flowNodeRef>completeCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>caseCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Mortgage offer ready" />
    <bpmn:sendTask id="sendOffer" name="Send the mortgage offer to the customer" />
    <bpmn:eventBasedGateway id="waitReply" name="Wait for the customer reply" />
    <bpmn:intermediateCatchEvent id="declined" name="Customer declines the mortgage">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="returned" name="Customer returns the completed offer documents">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="No answer received after 2 weeks">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="docsCheck" name="All prerequisite documents provided?" default="f14" />
    <bpmn:task id="moveAdmin" name="Move the case to administration" />
    <bpmn:task id="completeCase" name="Complete the case" />
    <bpmn:endEvent id="caseCompleted" name="Case completed" />
    <bpmn:sendTask id="requestDocs" name="Generate a message requesting outstanding documents" />
    <bpmn:endEvent id="docsRequested" name="Outstanding documents requested" />
    <bpmn:exclusiveGateway id="merge" name="Declined or no answer" />
    <bpmn:task id="updateCase" name="Update the case details" />
    <bpmn:task id="archive" name="Archive the work" />
    <bpmn:task id="cancel" name="Cancel the case" />
    <bpmn:endEvent id="cancelled" name="Mortgage cancelled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendOffer" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendOffer" targetRef="waitReply" />
    <bpmn:sequenceFlow id="f3" sourceRef="waitReply" targetRef="declined" />
    <bpmn:sequenceFlow id="f4" sourceRef="waitReply" targetRef="returned" />
    <bpmn:sequenceFlow id="f5" sourceRef="waitReply" targetRef="timeout" />
    <bpmn:sequenceFlow id="f6" sourceRef="declined" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="timeout" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="merge" targetRef="updateCase" />
    <bpmn:sequenceFlow id="f9" sourceRef="updateCase" targetRef="archive" />
    <bpmn:sequenceFlow id="f10" sourceRef="archive" targetRef="cancel" />
    <bpmn:sequenceFlow id="f11" sourceRef="cancel" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f12" sourceRef="returned" targetRef="docsCheck" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="docsCheck" targetRef="moveAdmin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allPrerequisiteDocumentsProvided</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="docsCheck" targetRef="requestDocs" />
    <bpmn:sequenceFlow id="f15" sourceRef="moveAdmin" targetRef="completeCase" />
    <bpmn:sequenceFlow id="f16" sourceRef="completeCase" targetRef="caseCompleted" />
    <bpmn:sequenceFlow id="f17" sourceRef="requestDocs" targetRef="docsRequested" />
  </bpmn:process>
</bpmn:definitions>
