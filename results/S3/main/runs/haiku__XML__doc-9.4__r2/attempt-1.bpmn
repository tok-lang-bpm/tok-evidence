<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="meeting-process" />
  </bpmn:collaboration>
  <bpmn:process id="meeting-process" isExecutable="false">
    <bpmn:laneSet id="meeting-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qaCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>updateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>readDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>holdMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Dates to be finalized" />
    <bpmn:task id="finalize" name="Finalize the dates" />
    <bpmn:task id="updateCalendars" name="Update all group calendars" />
    <bpmn:task id="createFolders" name="Create meeting folders for each meeting" />
    <bpmn:task id="uploadDocuments" name="Upload all appropriate documents to the system" />
    <bpmn:task id="adviseMembers" name="Advise Committee Members to read all related documents" />
    <bpmn:task id="readDocuments" name="Read all related documents" />
    <bpmn:task id="holdMeeting" name="Hold the meeting" />
    <bpmn:task id="produceMinutes" name="Produce the minutes including action points for each Committee Member" />
    <bpmn:task id="qaCheck" name="Conduct a QA check on the minutes" />
    <bpmn:task id="sendMinutes" name="Send the minutes to all Committee Members" />
    <bpmn:task id="updateRecords" name="Update all departmental records" />
    <bpmn:endEvent id="end" name="Minutes distributed and records updated" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="finalize" />
    <bpmn:sequenceFlow id="f2" sourceRef="finalize" targetRef="updateCalendars" />
    <bpmn:sequenceFlow id="f3" sourceRef="updateCalendars" targetRef="createFolders" />
    <bpmn:sequenceFlow id="f4" sourceRef="createFolders" targetRef="uploadDocuments" />
    <bpmn:sequenceFlow id="f5" sourceRef="uploadDocuments" targetRef="adviseMembers" />
    <bpmn:sequenceFlow id="f6" sourceRef="adviseMembers" targetRef="readDocuments" />
    <bpmn:sequenceFlow id="f7" sourceRef="readDocuments" targetRef="holdMeeting" />
    <bpmn:sequenceFlow id="f8" sourceRef="holdMeeting" targetRef="produceMinutes" />
    <bpmn:sequenceFlow id="f9" sourceRef="produceMinutes" targetRef="qaCheck" />
    <bpmn:sequenceFlow id="f10" sourceRef="qaCheck" targetRef="sendMinutes" />
    <bpmn:sequenceFlow id="f11" sourceRef="sendMinutes" targetRef="updateRecords" />
    <bpmn:sequenceFlow id="f12" sourceRef="updateRecords" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
