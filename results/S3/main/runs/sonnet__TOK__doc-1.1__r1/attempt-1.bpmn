<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customized bicycle order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Bicycle manufacturer" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customized bicycle order" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEng</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>partList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkQty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Order received" />
    <bpmn:task id="review" name="Review the order" />
    <bpmn:exclusiveGateway id="accepted" name="Order accepted?" />
    <bpmn:task id="reject" name="Reject the order" />
    <bpmn:endEvent id="rejectedEnd" name="Order rejected" />
    <bpmn:parallelGateway id="inform" name="Inform" />
    <bpmn:task id="informStore" name="Inform the storehouse" />
    <bpmn:task id="informEng" name="Inform the engineering department" />
    <bpmn:task id="ship" name="Ship the bicycle to the customer" />
    <bpmn:endEvent id="shipped" name="Process finished" />
    <bpmn:task id="partList" name="Process the part list" />
    <bpmn:task id="checkQty" name="Check the required quantity of the part" />
    <bpmn:exclusiveGateway id="available" name="Part available in-house?" />
    <bpmn:task id="reserve" name="Reserve the part" />
    <bpmn:task id="backorder" name="Back-order the part" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:exclusiveGateway id="more" name="More items on the part list?" />
    <bpmn:task id="prepare" name="Prepare the assembling of the bicycle" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:sequenceFlow id="f-received-review" sourceRef="received" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accepted" sourceRef="review" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="reject" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-accepted-inform" name="accept" sourceRef="accepted" targetRef="inform" />
    <bpmn:sequenceFlow id="f-reject-rejectedEnd" sourceRef="reject" targetRef="rejectedEnd" />
    <bpmn:sequenceFlow id="f-inform-informStore" sourceRef="inform" targetRef="informStore" />
    <bpmn:sequenceFlow id="f-inform-informEng" sourceRef="inform" targetRef="informEng" />
    <bpmn:sequenceFlow id="f-informStore-partList" sourceRef="informStore" targetRef="partList" />
    <bpmn:sequenceFlow id="f-partList-checkQty" sourceRef="partList" targetRef="checkQty" />
    <bpmn:sequenceFlow id="f-checkQty-available" sourceRef="checkQty" targetRef="available" />
    <bpmn:sequenceFlow id="f-available-reserve" name="yes" sourceRef="available" targetRef="reserve" />
    <bpmn:sequenceFlow id="f-available-backorder" name="no" sourceRef="available" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-reserve-merged" sourceRef="reserve" targetRef="merged" />
    <bpmn:sequenceFlow id="f-backorder-merged" sourceRef="backorder" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-more" sourceRef="merged" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-checkQty" name="yes" sourceRef="more" targetRef="checkQty" />
    <bpmn:sequenceFlow id="f-more-joined" name="no" sourceRef="more" targetRef="joined" />
    <bpmn:sequenceFlow id="f-informEng-prepare" sourceRef="informEng" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-joined" sourceRef="prepare" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-assemble" sourceRef="joined" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-shipped" sourceRef="ship" targetRef="shipped" />
  </bpmn:process>
</bpmn:definitions>
