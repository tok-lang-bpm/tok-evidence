<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customized bicycle order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Bicycle company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customized bicycle order" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informstore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informeng</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Order received" />
    <bpmn:exclusiveGateway id="decision" name="Accept the order?" />
    <bpmn:task id="reject" name="Reject the order" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:task id="accept" name="Accept the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="informstore" name="Inform the storehouse" />
    <bpmn:task id="informeng" name="Inform the engineering department" />
    <bpmn:task id="ship" name="Ship the bicycle to the customer" />
    <bpmn:endEvent id="shipped" name="Bicycle shipped" />
    <bpmn:subProcess id="parts" name="Process the part list">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="item" name="Part list item" />
      <bpmn:task id="checkqty" name="Check the required quantity of the part" />
      <bpmn:exclusiveGateway id="avail" name="Part available in-house?" />
      <bpmn:task id="reserve" name="Reserve the part" />
      <bpmn:task id="backorder" name="Back-order the part" />
      <bpmn:exclusiveGateway id="availjoin" />
      <bpmn:endEvent id="itemdone" name="Item processed" />
      <bpmn:sequenceFlow id="f-item-checkqty" sourceRef="item" targetRef="checkqty" />
      <bpmn:sequenceFlow id="f-checkqty-avail" sourceRef="checkqty" targetRef="avail" />
      <bpmn:sequenceFlow id="f-avail-reserve" name="yes" sourceRef="avail" targetRef="reserve" />
      <bpmn:sequenceFlow id="f-avail-backorder" name="no" sourceRef="avail" targetRef="backorder" />
      <bpmn:sequenceFlow id="f-reserve-availjoin" sourceRef="reserve" targetRef="availjoin" />
      <bpmn:sequenceFlow id="f-backorder-availjoin" sourceRef="backorder" targetRef="availjoin" />
      <bpmn:sequenceFlow id="f-availjoin-itemdone" sourceRef="availjoin" targetRef="itemdone" />
    </bpmn:subProcess>
    <bpmn:task id="prepare" name="Prepare the assembling of the bicycle" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:sequenceFlow id="f-received-decision" sourceRef="received" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="reject" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-accept" name="accept" sourceRef="decision" targetRef="accept" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-split" sourceRef="accept" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-informstore" sourceRef="split" targetRef="informstore" />
    <bpmn:sequenceFlow id="f-split-informeng" sourceRef="split" targetRef="informeng" />
    <bpmn:sequenceFlow id="f-informstore-parts" sourceRef="informstore" targetRef="parts" />
    <bpmn:sequenceFlow id="f-informeng-prepare" sourceRef="informeng" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-parts-join" sourceRef="parts" targetRef="join" />
    <bpmn:sequenceFlow id="f-prepare-join" sourceRef="prepare" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-assemble" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-shipped" sourceRef="ship" targetRef="shipped" />
  </bpmn:process>
</bpmn:definitions>
