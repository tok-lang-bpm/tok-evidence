<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>called</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepfood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepbev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="called" name="Guest calls room service" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="submit" name="Submit the order ticket to the kitchen" />
    <bpmn:exclusiveGateway id="alcohol" name="Order includes alcoholic beverages?" default="f-alcohol-merge" />
    <bpmn:task id="give" name="Give the order to the sommelier" />
    <bpmn:task id="assign" name="Assign the order to the waiter" />
    <bpmn:task id="prepfood" name="Prepare the food" />
    <bpmn:task id="fetch" name="Fetch wine from the cellar" />
    <bpmn:task id="prepbev" name="Prepare other alcoholic beverages" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="cart" name="Ready the cart" />
    <bpmn:task id="drinks" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="back" name="Return to the room-service station" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="done" name="Order delivered and billed" />
    <bpmn:sequenceFlow id="f-called-take" sourceRef="called" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-split" sourceRef="take" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-submit" sourceRef="split" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-prepfood" sourceRef="submit" targetRef="prepfood" />
    <bpmn:sequenceFlow id="f-prepfood-join" sourceRef="prepfood" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-alcohol" sourceRef="split" targetRef="alcohol" />
    <bpmn:sequenceFlow id="f-alcohol-give" name="yes" sourceRef="alcohol" targetRef="give" />
    <bpmn:sequenceFlow id="f-alcohol-merge" name="no" sourceRef="alcohol" targetRef="merge" />
    <bpmn:sequenceFlow id="f-give-fetch" sourceRef="give" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-prepbev" sourceRef="fetch" targetRef="prepbev" />
    <bpmn:sequenceFlow id="f-prepbev-merge" sourceRef="prepbev" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-join" sourceRef="merge" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-assign" sourceRef="split" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-cart" sourceRef="assign" targetRef="cart" />
    <bpmn:sequenceFlow id="f-cart-drinks" sourceRef="cart" targetRef="drinks" />
    <bpmn:sequenceFlow id="f-drinks-join" sourceRef="drinks" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-deliver" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-back" sourceRef="deliver" targetRef="back" />
    <bpmn:sequenceFlow id="f-back-debit" sourceRef="back" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-done" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
