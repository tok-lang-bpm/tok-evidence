<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Room service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>called</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcoholDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>soft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="called" name="Guest calls room service" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:task id="submit" name="Submit the order ticket to the kitchen" />
    <bpmn:task id="give" name="Give the order to the sommelier" />
    <bpmn:task id="assign" name="Assign the order to the waiter" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="food" name="Prepare the food" />
    <bpmn:exclusiveGateway id="alcohol" name="Order includes alcoholic beverages?" default="f-alcohol-alcoholDone" />
    <bpmn:task id="wine" name="Fetch wine from the cellar" />
    <bpmn:task id="drinks" name="Prepare other alcoholic beverages" />
    <bpmn:exclusiveGateway id="alcoholDone" />
    <bpmn:task id="cart" name="Ready the cart" />
    <bpmn:task id="soft" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="back" name="Return to the room-service station" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="done" name="Order delivered and billed" />
    <bpmn:sequenceFlow id="f-called-take" sourceRef="called" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-submit" sourceRef="take" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-give" sourceRef="submit" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-assign" sourceRef="give" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-split" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-food" sourceRef="split" targetRef="food" />
    <bpmn:sequenceFlow id="f-split-alcohol" sourceRef="split" targetRef="alcohol" />
    <bpmn:sequenceFlow id="f-split-cart" sourceRef="split" targetRef="cart" />
    <bpmn:sequenceFlow id="f-alcohol-wine" name="yes" sourceRef="alcohol" targetRef="wine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">includesAlcohol = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-alcohol-alcoholDone" name="no" sourceRef="alcohol" targetRef="alcoholDone" />
    <bpmn:sequenceFlow id="f-wine-drinks" sourceRef="wine" targetRef="drinks" />
    <bpmn:sequenceFlow id="f-drinks-alcoholDone" sourceRef="drinks" targetRef="alcoholDone" />
    <bpmn:sequenceFlow id="f-cart-soft" sourceRef="cart" targetRef="soft" />
    <bpmn:sequenceFlow id="f-food-join" sourceRef="food" targetRef="join" />
    <bpmn:sequenceFlow id="f-alcoholDone-join" sourceRef="alcoholDone" targetRef="join" />
    <bpmn:sequenceFlow id="f-soft-join" sourceRef="soft" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-deliver" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-back" sourceRef="deliver" targetRef="back" />
    <bpmn:sequenceFlow id="f-back-debit" sourceRef="back" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-done" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
