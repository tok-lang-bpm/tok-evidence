tok 1.0 "Room service at The Evanstonian"

pool hotel "The Evanstonian"
  lane manager "Room-service manager"
    start called "Guest calls room service"
    task take "Take down the order"
    task submit "Submit the order ticket to the kitchen"
    task give "Give the order to the sommelier"
    task assign "Assign the order to the waiter"
    and split
  lane kitchen "Kitchen"
    task food "Prepare the food"
  lane sommelier "Sommelier"
    xor alcohol "Order includes alcoholic beverages?"
    task wine "Fetch wine from the cellar"
    task drinks "Prepare other alcoholic beverages"
    xor alcoholDone
  lane waiter "Waiter"
    task cart "Ready the cart"
    task soft "Prepare nonalcoholic drinks"
    and join
    task deliver "Deliver the order to the guest's room"
    task back "Return to the room-service station"
    task debit "Debit the guest's account"
    end done "Order delivered and billed"

flow called -> take -> submit -> give -> assign -> split
flow split -> food
flow split -> alcohol
flow split -> cart
flow alcohol -> wine "yes" when="includesAlcohol = true"
flow alcohol -> alcoholDone "no" default
flow wine -> drinks -> alcoholDone
flow cart -> soft
flow food -> join
flow alcoholDone -> join
flow soft -> join
flow join -> deliver -> back -> debit -> done
