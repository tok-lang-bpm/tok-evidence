<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ipo" name="Going public" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" name="Going public" isExecutable="false">
    <bpmn:laneSet id="ipo-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="uw" name="Underwriters">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decided" name="Decision to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="check" name="Check compliance with the blue-sky laws" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="roadshow" name="Arrange a road show" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to offer the stock?" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="sold" name="Stock offered to the public" />
    <bpmn:endEvent id="stopped" name="Stock not offered" />
    <bpmn:task id="approve" name="Approve the registration statement" />
    <bpmn:sequenceFlow id="f-decided-select" sourceRef="decided" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-prepare" sourceRef="select" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-split" sourceRef="prepare" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-register" sourceRef="split" targetRef="register" />
    <bpmn:sequenceFlow id="f-split-check" sourceRef="split" targetRef="check" />
    <bpmn:sequenceFlow id="f-split-firm" sourceRef="split" targetRef="firm" />
    <bpmn:sequenceFlow id="f-register-approve" sourceRef="register" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-join" sourceRef="approve" targetRef="join" />
    <bpmn:sequenceFlow id="f-check-join" sourceRef="check" targetRef="join" />
    <bpmn:sequenceFlow id="f-firm-roadshow" sourceRef="firm" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-roadshow-join" sourceRef="roadshow" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-fix" sourceRef="join" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-commit" sourceRef="fix" targetRef="commit" />
    <bpmn:sequenceFlow id="f-commit-reason" sourceRef="commit" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-stopped" name="yes" sourceRef="reason" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-reason-offer" name="no" sourceRef="reason" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-sold" sourceRef="offer" targetRef="sold" />
  </bpmn:process>
</bpmn:definitions>
