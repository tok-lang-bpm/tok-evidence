<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public: underwriting of a new issue" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ipo" name="Issue of shares" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" name="Going public: underwriting of a new issue" isExecutable="false">
    <bpmn:laneSet id="ipo-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firmup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notoffered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decided" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="check" name="Check compliance with the blue-sky laws" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="firmup" name="Firm up the issue price" />
    <bpmn:task id="roadshow" name="Arrange a road show" />
    <bpmn:task id="clearance" name="Receive clearance from the SEC" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:exclusiveGateway id="reason" name="Any reason not to offer the issue?" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="offered" name="Stock offered to the public" />
    <bpmn:endEvent id="notoffered" name="Issue not offered" />
    <bpmn:sequenceFlow id="f-decided-select" sourceRef="decided" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-prepare" sourceRef="select" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-split1" sourceRef="prepare" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-register" sourceRef="split1" targetRef="register" />
    <bpmn:sequenceFlow id="f-split1-check" sourceRef="split1" targetRef="check" />
    <bpmn:sequenceFlow id="f-register-join1" sourceRef="register" targetRef="join1" />
    <bpmn:sequenceFlow id="f-check-join1" sourceRef="check" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-split2" sourceRef="join1" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-firmup" sourceRef="split2" targetRef="firmup" />
    <bpmn:sequenceFlow id="f-split2-roadshow" sourceRef="split2" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-split2-clearance" sourceRef="split2" targetRef="clearance" />
    <bpmn:sequenceFlow id="f-firmup-join2" sourceRef="firmup" targetRef="join2" />
    <bpmn:sequenceFlow id="f-roadshow-join2" sourceRef="roadshow" targetRef="join2" />
    <bpmn:sequenceFlow id="f-clearance-join2" sourceRef="clearance" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-fix" sourceRef="join2" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-reason" sourceRef="fix" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-commit" name="no" sourceRef="reason" targetRef="commit" />
    <bpmn:sequenceFlow id="f-reason-notoffered" name="yes" sourceRef="reason" targetRef="notoffered" />
    <bpmn:sequenceFlow id="f-commit-offer" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-offered" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
