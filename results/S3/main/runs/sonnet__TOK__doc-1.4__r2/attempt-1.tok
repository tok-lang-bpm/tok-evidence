tok 1.0 "Going public: underwriting of a new issue"

pool ipo "Issue of shares"
  lane company "Company"
    start decided "Company decides to go public"
    task select "Select the underwriters"
  lane underwriters "Underwriters"
    task prepare "Prepare the registration statement"
    and split1
    task register "Register the issue with the SEC"
    task check "Check compliance with the blue-sky laws"
    and join1
    and split2
    task firmup "Firm up the issue price"
    task roadshow "Arrange a road show"
    task clearance "Receive clearance from the SEC"
    and join2
    task fix "Fix the issue price"
    xor reason "Any reason not to offer the issue?"
    task commit "Enter into a firm commitment to buy the stock"
    task offer "Offer the stock to the public"
    end offered "Stock offered to the public"
    end notoffered "Issue not offered"

flow decided -> select -> prepare -> split1
flow split1 -> register
flow split1 -> check
flow register -> join1
flow check -> join1
flow join1 -> split2
flow split2 -> firmup
flow split2 -> roadshow
flow split2 -> clearance
flow firmup -> join2
flow roadshow -> join2
flow clearance -> join2
flow join2 -> fix -> reason
flow reason -> commit "no"
flow reason -> notoffered "yes"
flow commit -> offer -> offered
