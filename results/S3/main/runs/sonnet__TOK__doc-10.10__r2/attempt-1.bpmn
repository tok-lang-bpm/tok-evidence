<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Fault handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Fault handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="detector" name="Fault detector">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>suspected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informed1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resmsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informed2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Failure detected" />
    <bpmn:task id="report" name="Report the failure to the MPO" />
    <bpmn:startEvent id="suspected" name="Own fault suspected" />
    <bpmn:task id="suspect" name="Suspect own fault" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="valid" name="Failure confirmed?" />
    <bpmn:task id="reject" name="Reject the failure of the fault detector" />
    <bpmn:task id="confirm" name="Confirm the failure of the fault detector" />
    <bpmn:parallelGateway id="inform1" />
    <bpmn:task id="informgo" name="Inform the GO" />
    <bpmn:task id="informmsp" name="Inform the MSP" />
    <bpmn:parallelGateway id="informed1" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="share" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="inform2" />
    <bpmn:task id="resgo" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="resmsp" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="informed2" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:endEvent id="resolved" name="Fault resolved" />
    <bpmn:sequenceFlow id="f-reported-report" sourceRef="reported" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-merge" sourceRef="report" targetRef="merge" />
    <bpmn:sequenceFlow id="f-suspected-suspect" sourceRef="suspected" targetRef="suspect" />
    <bpmn:sequenceFlow id="f-suspect-merge" sourceRef="suspect" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-examine" sourceRef="merge" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-valid" sourceRef="examine" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-reject" name="no" sourceRef="valid" targetRef="reject" />
    <bpmn:sequenceFlow id="f-valid-confirm" name="yes" sourceRef="valid" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-inform1" sourceRef="confirm" targetRef="inform1" />
    <bpmn:sequenceFlow id="f-inform1-informgo" sourceRef="inform1" targetRef="informgo" />
    <bpmn:sequenceFlow id="f-inform1-informmsp" sourceRef="inform1" targetRef="informmsp" />
    <bpmn:sequenceFlow id="f-informgo-informed1" sourceRef="informgo" targetRef="informed1" />
    <bpmn:sequenceFlow id="f-informmsp-informed1" sourceRef="informmsp" targetRef="informed1" />
    <bpmn:sequenceFlow id="f-informed1-fix" sourceRef="informed1" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-inform2" sourceRef="share" targetRef="inform2" />
    <bpmn:sequenceFlow id="f-inform2-resgo" sourceRef="inform2" targetRef="resgo" />
    <bpmn:sequenceFlow id="f-inform2-resmsp" sourceRef="inform2" targetRef="resmsp" />
    <bpmn:sequenceFlow id="f-resgo-informed2" sourceRef="resgo" targetRef="informed2" />
    <bpmn:sequenceFlow id="f-resmsp-informed2" sourceRef="resmsp" targetRef="informed2" />
    <bpmn:sequenceFlow id="f-informed2-resolved" sourceRef="informed2" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
