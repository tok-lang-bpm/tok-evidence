<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measurement request handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendchanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitvalues</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Measurements needed" />
    <bpmn:task id="request" name="Request the measurements" />
    <bpmn:task id="process" name="Process the measured values" />
    <bpmn:task id="sendchanged" name="Send the changed values to the MSP" />
    <bpmn:task id="transmit" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="done" name="Readings transmitted" />
    <bpmn:endEvent id="denied" name="Request denied" />
    <bpmn:endEvent id="failed" name="Failure reported" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="accepted" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny the request" />
    <bpmn:task id="measure" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="success" name="Reading successful?" />
    <bpmn:task id="inform" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="transmitvalues" name="Transmit the measured values to the GO" />
    <bpmn:sequenceFlow id="f-begin-request" sourceRef="begin" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-check" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-accepted" sourceRef="check" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-deny" name="no" sourceRef="accepted" targetRef="deny" />
    <bpmn:sequenceFlow id="f-accepted-measure" name="yes" sourceRef="accepted" targetRef="measure" />
    <bpmn:sequenceFlow id="f-deny-denied" sourceRef="deny" targetRef="denied" />
    <bpmn:sequenceFlow id="f-measure-success" sourceRef="measure" targetRef="success" />
    <bpmn:sequenceFlow id="f-success-inform" name="no" sourceRef="success" targetRef="inform" />
    <bpmn:sequenceFlow id="f-success-transmitvalues" name="yes" sourceRef="success" targetRef="transmitvalues" />
    <bpmn:sequenceFlow id="f-inform-failed" sourceRef="inform" targetRef="failed" />
    <bpmn:sequenceFlow id="f-transmitvalues-process" sourceRef="transmitvalues" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-sendchanged" sourceRef="process" targetRef="sendchanged" />
    <bpmn:sequenceFlow id="f-sendchanged-transmit" sourceRef="sendchanged" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-done" sourceRef="transmit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
