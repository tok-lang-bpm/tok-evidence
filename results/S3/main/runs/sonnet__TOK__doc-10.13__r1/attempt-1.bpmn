<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Transaction data request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Transaction data request handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Transaction data needed" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:endEvent id="done" name="Request answered" />
    <bpmn:task id="check" name="Check the request of the INQ" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome of the examination?" />
    <bpmn:task id="send" name="Transmit the data" />
    <bpmn:task id="reject" name="Reject the request" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:sequenceFlow id="f-needed-transmit" sourceRef="needed" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-check" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-outcome" sourceRef="check" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-send" name="data can be transmitted" sourceRef="outcome" targetRef="send" />
    <bpmn:sequenceFlow id="f-outcome-reject" name="request rejected" sourceRef="outcome" targetRef="reject" />
    <bpmn:sequenceFlow id="f-send-merge" sourceRef="send" targetRef="merge" />
    <bpmn:sequenceFlow id="f-reject-merge" sourceRef="reject" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-done" sourceRef="merge" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
