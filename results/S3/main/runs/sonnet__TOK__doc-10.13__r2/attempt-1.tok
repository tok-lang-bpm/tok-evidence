tok 1.0 "Transaction data request handling"

pool org "Organisation"
  lane inq "INQ"
    start needed "Transaction data needed"
    task transmit "Transmit the transaction data request"
    end done "Request answered"
  lane ip "IP"
    task check "Check the request of the INQ"
    xor outcome "Outcome of the examination?"
    task send "Transmit the data"
    task reject "Reject the request"
    xor joined
    task answer "Answer the question of the INQ"

flow needed -> transmit -> check -> outcome
flow outcome -> send "data can be transmitted"
flow outcome -> reject "request rejected"
flow send -> joined
flow reject -> joined
flow joined -> answer -> done
