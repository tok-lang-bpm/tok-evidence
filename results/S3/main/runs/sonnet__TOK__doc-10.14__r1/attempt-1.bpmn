<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill examination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Metering organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Bill examination" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>send_meas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_read</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>exam_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_meas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>exam_equip</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Bill to be sent" />
    <bpmn:exclusiveGateway id="kind" name="Which bill?" />
    <bpmn:task id="send_cont" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="send_equip" name="Send the bill for the equipment acquisition" />
    <bpmn:task id="send_meas" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="send_read" name="Send the bill for additional readings" />
    <bpmn:task id="exam_cont" name="Examine the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="exam_meas" name="Examine the bill for the temporary continuation of the measurement" />
    <bpmn:task id="exam_read" name="Examine the bill for additional readings" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:exclusiveGateway id="ok" name="Invoice acceptable?" />
    <bpmn:task id="confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject" name="Reject the invoice" />
    <bpmn:endEvent id="confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="rejected" name="Invoice rejected" />
    <bpmn:task id="exam_equip" name="Examine the bill for the equipment acquisition" />
    <bpmn:sequenceFlow id="f-begin-kind" sourceRef="begin" targetRef="kind" />
    <bpmn:sequenceFlow id="f-kind-send_cont" name="temporary continuation of operations" sourceRef="kind" targetRef="send_cont" />
    <bpmn:sequenceFlow id="f-kind-send_meas" name="temporary continuation of measurement" sourceRef="kind" targetRef="send_meas" />
    <bpmn:sequenceFlow id="f-kind-send_read" name="additional readings" sourceRef="kind" targetRef="send_read" />
    <bpmn:sequenceFlow id="f-kind-send_equip" name="equipment acquisition" sourceRef="kind" targetRef="send_equip" />
    <bpmn:sequenceFlow id="f-send_cont-exam_cont" sourceRef="send_cont" targetRef="exam_cont" />
    <bpmn:sequenceFlow id="f-exam_cont-merged" sourceRef="exam_cont" targetRef="merged" />
    <bpmn:sequenceFlow id="f-send_meas-exam_meas" sourceRef="send_meas" targetRef="exam_meas" />
    <bpmn:sequenceFlow id="f-exam_meas-merged" sourceRef="exam_meas" targetRef="merged" />
    <bpmn:sequenceFlow id="f-send_read-exam_read" sourceRef="send_read" targetRef="exam_read" />
    <bpmn:sequenceFlow id="f-exam_read-merged" sourceRef="exam_read" targetRef="merged" />
    <bpmn:sequenceFlow id="f-send_equip-exam_equip" sourceRef="send_equip" targetRef="exam_equip" />
    <bpmn:sequenceFlow id="f-exam_equip-merged" sourceRef="exam_equip" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-ok" sourceRef="merged" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-confirm" name="yes" sourceRef="ok" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
