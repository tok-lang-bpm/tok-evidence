tok 1.0 "Bill examination"

pool org "Metering organisation"
  lane mpoo "MPOO"
    start begin "Bill to be sent"
    xor kind "Which bill?"
    task send_cont "Send the bill for the temporary continuation of the metering point operations"
    task send_equip "Send the bill for the equipment acquisition"
  lane mspo "MSPO"
    task send_meas "Send the bill for the temporary continuation of the measurement"
    task send_read "Send the bill for additional readings"
  lane go "GO"
    task exam_cont "Examine the bill for the temporary continuation of the metering point operations"
    task exam_meas "Examine the bill for the temporary continuation of the measurement"
    task exam_read "Examine the bill for additional readings"
    xor merged
    xor ok "Invoice acceptable?"
    task confirm "Confirm the invoice with payment advice"
    task reject "Reject the invoice"
    end confirmed "Invoice confirmed"
    end rejected "Invoice rejected"
  lane mpon "MPON"
    task exam_equip "Examine the bill for the equipment acquisition"

flow begin -> kind
flow kind -> send_cont "temporary continuation of operations"
flow kind -> send_meas "temporary continuation of measurement"
flow kind -> send_read "additional readings"
flow kind -> send_equip "equipment acquisition"
flow send_cont -> exam_cont -> merged
flow send_meas -> exam_meas -> merged
flow send_read -> exam_read -> merged
flow send_equip -> exam_equip -> merged
flow merged -> ok
flow ok -> confirm "yes"
flow ok -> reject "no"
flow confirm -> confirmed
flow reject -> rejected
