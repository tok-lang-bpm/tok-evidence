<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill examination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Metering organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Bill examination" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendEquip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>sendMeas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>mergeGo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examineGo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>who</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>examineMpon</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Bill to be sent" />
    <bpmn:exclusiveGateway id="kind" name="Which bill?" />
    <bpmn:task id="sendOps" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="sendEquip" name="Send the bill for the equipment acquisition" />
    <bpmn:task id="sendMeas" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="sendRead" name="Send the bill for additional readings" />
    <bpmn:exclusiveGateway id="mergeGo" />
    <bpmn:task id="examineGo" name="Examine the bill (GO)" />
    <bpmn:exclusiveGateway id="who" name="Who examines the bill?" />
    <bpmn:exclusiveGateway id="examined" />
    <bpmn:exclusiveGateway id="ok" name="Invoice acceptable?" />
    <bpmn:task id="confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject" name="Reject the invoice" />
    <bpmn:endEvent id="confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="rejected" name="Invoice rejected" />
    <bpmn:task id="examineMpon" name="Examine the bill (MPON)" />
    <bpmn:sequenceFlow id="f-begin-kind" sourceRef="begin" targetRef="kind" />
    <bpmn:sequenceFlow id="f-kind-sendOps" name="continuation of metering point operations" sourceRef="kind" targetRef="sendOps" />
    <bpmn:sequenceFlow id="f-kind-sendMeas" name="continuation of measurement" sourceRef="kind" targetRef="sendMeas" />
    <bpmn:sequenceFlow id="f-kind-sendRead" name="additional readings" sourceRef="kind" targetRef="sendRead" />
    <bpmn:sequenceFlow id="f-kind-sendEquip" name="equipment acquisition" sourceRef="kind" targetRef="sendEquip" />
    <bpmn:sequenceFlow id="f-sendOps-mergeGo" sourceRef="sendOps" targetRef="mergeGo" />
    <bpmn:sequenceFlow id="f-sendMeas-mergeGo" sourceRef="sendMeas" targetRef="mergeGo" />
    <bpmn:sequenceFlow id="f-sendRead-mergeGo" sourceRef="sendRead" targetRef="mergeGo" />
    <bpmn:sequenceFlow id="f-mergeGo-examineGo" sourceRef="mergeGo" targetRef="examineGo" />
    <bpmn:sequenceFlow id="f-sendEquip-who" sourceRef="sendEquip" targetRef="who" />
    <bpmn:sequenceFlow id="f-who-mergeGo" name="GO" sourceRef="who" targetRef="mergeGo" />
    <bpmn:sequenceFlow id="f-who-examineMpon" name="MPON" sourceRef="who" targetRef="examineMpon" />
    <bpmn:sequenceFlow id="f-examineGo-examined" sourceRef="examineGo" targetRef="examined" />
    <bpmn:sequenceFlow id="f-examineMpon-examined" sourceRef="examineMpon" targetRef="examined" />
    <bpmn:sequenceFlow id="f-examined-ok" sourceRef="examined" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-confirm" name="yes" sourceRef="ok" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
