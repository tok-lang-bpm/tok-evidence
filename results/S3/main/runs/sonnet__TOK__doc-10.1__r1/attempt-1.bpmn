<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Dismissal to be sent" />
    <bpmn:task id="send" name="Send the dismissal to the MPOO" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal confirmed?" />
    <bpmn:task id="confirm" name="Confirm the dismissal of the MPON" />
    <bpmn:task id="oppose" name="Oppose the dismissal of the MPON" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:endEvent id="done" name="Dismissal handled" />
    <bpmn:sequenceFlow id="f-begin-send" sourceRef="begin" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="yes" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decision-oppose" name="no" sourceRef="decision" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-confirm-merge" sourceRef="confirm" targetRef="merge" />
    <bpmn:sequenceFlow id="f-oppose-merge" sourceRef="oppose" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-done" sourceRef="merge" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
