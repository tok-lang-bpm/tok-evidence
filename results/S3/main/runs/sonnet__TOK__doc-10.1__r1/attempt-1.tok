tok 1.0 "Dismissal handling"

pool org "Organisation"
  lane mpon "MPON"
    start begin "Dismissal to be sent"
    task send "Send the dismissal to the MPOO"
  lane mpoo "MPOO"
    task review "Review the dismissal"
    xor decision "Dismissal confirmed?"
    task confirm "Confirm the dismissal of the MPON"
    task oppose "Oppose the dismissal of the MPON"
    xor merge
    end done "Dismissal handled"

flow begin -> send -> review -> decision
flow decision -> confirm "yes"
flow decision -> oppose "no"
flow confirm -> merge
flow oppose -> merge
flow merge -> done
