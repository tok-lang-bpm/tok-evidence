<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Meter operation registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Failure_of_the_entire_process" name="Failure of the entire process" />
  <bpmn:message id="Message_Successful_completion_of_the_entire_process" name="Successful completion of the entire process" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meter operation registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipN</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>okMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timedOut</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>equipO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Meter operation to be reported" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="equipN" name="Perform the equipment acquisition and / or equipment changes (MPON)" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:task id="informOO" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="informSO" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:eventBasedGateway id="outcome" />
    <bpmn:intermediateCatchEvent id="failMsg" name="Failure of the entire process reported by the MPON">
      <bpmn:messageEventDefinition id="failMsg-def" messageRef="Message_Failure_of_the_entire_process" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="okMsg" name="Successful completion of the entire process reported by the MPON">
      <bpmn:messageEventDefinition id="okMsg-def" messageRef="Message_Successful_completion_of_the_entire_process" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="deadline" name="Maximum time limit passed">
      <bpmn:timerEventDefinition id="deadline-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="confirmFail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="failOO" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="failSO" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confirmAssign" name="Confirm the assignment to the MPON" />
    <bpmn:task id="assignOO" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="assignSO" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="informSP" name="Inform the SP about the assignment of the MPON" />
    <bpmn:task id="informDeadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="failed" name="Assignment failed" />
    <bpmn:endEvent id="assigned" name="MPON assigned" />
    <bpmn:endEvent id="timedOut" name="Transaction failed by deadline" />
    <bpmn:task id="equipO" name="Perform the equipment acquisition and / or equipment changes (MPOO)" />
    <bpmn:sequenceFlow id="f-begin-report" sourceRef="begin" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-examine" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-accepted" sourceRef="examine" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-accepted-confirm" name="yes" sourceRef="accepted" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-informOO" sourceRef="confirm" targetRef="informOO" />
    <bpmn:sequenceFlow id="f-informOO-informSO" sourceRef="informOO" targetRef="informSO" />
    <bpmn:sequenceFlow id="f-informSO-split" sourceRef="informSO" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-equipN" sourceRef="split" targetRef="equipN" />
    <bpmn:sequenceFlow id="f-split-equipO" sourceRef="split" targetRef="equipO" />
    <bpmn:sequenceFlow id="f-equipN-joined" sourceRef="equipN" targetRef="joined" />
    <bpmn:sequenceFlow id="f-equipO-joined" sourceRef="equipO" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-outcome" sourceRef="joined" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-failMsg" sourceRef="outcome" targetRef="failMsg" />
    <bpmn:sequenceFlow id="f-outcome-okMsg" sourceRef="outcome" targetRef="okMsg" />
    <bpmn:sequenceFlow id="f-outcome-deadline" sourceRef="outcome" targetRef="deadline" />
    <bpmn:sequenceFlow id="f-failMsg-confirmFail" sourceRef="failMsg" targetRef="confirmFail" />
    <bpmn:sequenceFlow id="f-confirmFail-failOO" sourceRef="confirmFail" targetRef="failOO" />
    <bpmn:sequenceFlow id="f-failOO-failSO" sourceRef="failOO" targetRef="failSO" />
    <bpmn:sequenceFlow id="f-failSO-failed" sourceRef="failSO" targetRef="failed" />
    <bpmn:sequenceFlow id="f-okMsg-assign" sourceRef="okMsg" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-confirmAssign" sourceRef="assign" targetRef="confirmAssign" />
    <bpmn:sequenceFlow id="f-confirmAssign-assignOO" sourceRef="confirmAssign" targetRef="assignOO" />
    <bpmn:sequenceFlow id="f-assignOO-assignSO" sourceRef="assignOO" targetRef="assignSO" />
    <bpmn:sequenceFlow id="f-assignSO-informSP" sourceRef="assignSO" targetRef="informSP" />
    <bpmn:sequenceFlow id="f-informSP-assigned" sourceRef="informSP" targetRef="assigned" />
    <bpmn:sequenceFlow id="f-deadline-informDeadline" sourceRef="deadline" targetRef="informDeadline" />
    <bpmn:sequenceFlow id="f-informDeadline-timedOut" sourceRef="informDeadline" targetRef="timedOut" />
  </bpmn:process>
</bpmn:definitions>
