<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPOO deregistration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="market" name="Market" processRef="market-process" />
  </bpmn:collaboration>
  <bpmn:process id="market-process" name="MPOO deregistration" isExecutable="false">
    <bpmn:laneSet id="market-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preconfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Deregistration needed" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="confirm" name="Confirm the continuation" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="accepted" name="Deregistration accepted?" default="f-accepted-reject" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:task id="preconfirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige" name="Continue operations required?" default="f-oblige-merge" />
    <bpmn:task id="bind" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:parallelGateway id="inform" />
    <bpmn:task id="informmpoo" name="Inform the MPOO about the end of its assignment and the beginning of the assignment of the GO" />
    <bpmn:task id="informmspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informsp" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="informed" />
    <bpmn:endEvent id="done" name="Deregistration completed" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:sequenceFlow id="f-requested-deregister" sourceRef="requested" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-accepted" sourceRef="verify" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-preconfirm" name="yes" sourceRef="accepted" targetRef="preconfirm" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-preconfirm-prepare" sourceRef="preconfirm" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige" sourceRef="prepare" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige-bind" name="yes" sourceRef="oblige" targetRef="bind" />
    <bpmn:sequenceFlow id="f-oblige-merge" name="no" sourceRef="oblige" targetRef="merge" />
    <bpmn:sequenceFlow id="f-bind-confirm" sourceRef="bind" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-merge" sourceRef="confirm" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-acquire" sourceRef="merge" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-acquire-assign" sourceRef="acquire" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform" sourceRef="assign" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-informmpoo" sourceRef="inform" targetRef="informmpoo" />
    <bpmn:sequenceFlow id="f-inform-informmspo" sourceRef="inform" targetRef="informmspo" />
    <bpmn:sequenceFlow id="f-inform-informsp" sourceRef="inform" targetRef="informsp" />
    <bpmn:sequenceFlow id="f-informmpoo-informed" sourceRef="informmpoo" targetRef="informed" />
    <bpmn:sequenceFlow id="f-informmspo-informed" sourceRef="informmspo" targetRef="informed" />
    <bpmn:sequenceFlow id="f-informsp-informed" sourceRef="informsp" targetRef="informed" />
    <bpmn:sequenceFlow id="f-informed-done" sourceRef="informed" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
