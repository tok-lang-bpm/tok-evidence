<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Deregistration of the MPOO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Deregistration of the MPOO" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preconfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Deregistration needed" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="confirm" name="Confirm the continuation" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="verified" name="Deregistration accepted?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:task id="preconfirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige" name="Continue operations required?" />
    <bpmn:task id="bind" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="merge" name="" />
    <bpmn:task id="equipment" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="informmpoo" name="Inform the MPOO about the end of its assignment and the beginning of the assignment of the GO" />
    <bpmn:task id="informmspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informsp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="done" name="Deregistration completed" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:sequenceFlow id="f-begin-deregister" sourceRef="begin" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-verified" sourceRef="verify" targetRef="verified" />
    <bpmn:sequenceFlow id="f-verified-reject" name="no" sourceRef="verified" targetRef="reject" />
    <bpmn:sequenceFlow id="f-verified-preconfirm" name="yes" sourceRef="verified" targetRef="preconfirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-preconfirm-prepare" sourceRef="preconfirm" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige" sourceRef="prepare" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige-bind" name="yes" sourceRef="oblige" targetRef="bind" />
    <bpmn:sequenceFlow id="f-oblige-merge" name="no" sourceRef="oblige" targetRef="merge" />
    <bpmn:sequenceFlow id="f-bind-confirm" sourceRef="bind" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-merge" sourceRef="confirm" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-equipment" sourceRef="merge" targetRef="equipment" />
    <bpmn:sequenceFlow id="f-equipment-assign" sourceRef="equipment" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-informmpoo" sourceRef="assign" targetRef="informmpoo" />
    <bpmn:sequenceFlow id="f-informmpoo-informmspo" sourceRef="informmpoo" targetRef="informmspo" />
    <bpmn:sequenceFlow id="f-informmspo-informsp" sourceRef="informmspo" targetRef="informsp" />
    <bpmn:sequenceFlow id="f-informsp-done" sourceRef="informsp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
