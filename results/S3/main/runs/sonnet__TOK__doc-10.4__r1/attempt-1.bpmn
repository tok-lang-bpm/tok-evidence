<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="process" name="Equipment change" processRef="process-process" />
  </bpmn:collaboration>
  <bpmn:process id="process-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="process-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellGo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>selfd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noSelf</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>notifyMsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Equipment change intended" />
    <bpmn:task id="intend" name="Notify the MPOO about equipment change intentions" />
    <bpmn:task id="finalN" name="Perform the final reading" />
    <bpmn:task id="dismountN" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="readCount" name="Read the meter count from the installed meter" />
    <bpmn:task id="sendValues" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tellGo" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="selfd" name="Self dismounting by the MPOO?" />
    <bpmn:task id="announce" name="Announce self dismounting to the MPON" />
    <bpmn:task id="finalO" name="Perform the final reading by the MPOO" />
    <bpmn:task id="dismountO" name="Dismount the old equipment by the MPOO" />
    <bpmn:task id="noSelf" name="Notify the MPON about no self-dismounting" />
    <bpmn:task id="notifyMsp" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="done" name="MSP notified" />
    <bpmn:sequenceFlow id="f-begin-intend" sourceRef="begin" targetRef="intend" />
    <bpmn:sequenceFlow id="f-intend-selfd" sourceRef="intend" targetRef="selfd" />
    <bpmn:sequenceFlow id="f-selfd-announce" name="yes" sourceRef="selfd" targetRef="announce" />
    <bpmn:sequenceFlow id="f-selfd-noSelf" name="no" sourceRef="selfd" targetRef="noSelf" />
    <bpmn:sequenceFlow id="f-announce-finalO" sourceRef="announce" targetRef="finalO" />
    <bpmn:sequenceFlow id="f-finalO-dismountO" sourceRef="finalO" targetRef="dismountO" />
    <bpmn:sequenceFlow id="f-dismountO-merged" sourceRef="dismountO" targetRef="merged" />
    <bpmn:sequenceFlow id="f-noSelf-finalN" sourceRef="noSelf" targetRef="finalN" />
    <bpmn:sequenceFlow id="f-finalN-dismountN" sourceRef="finalN" targetRef="dismountN" />
    <bpmn:sequenceFlow id="f-dismountN-merged" sourceRef="dismountN" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-mount" sourceRef="merged" targetRef="mount" />
    <bpmn:sequenceFlow id="f-mount-readCount" sourceRef="mount" targetRef="readCount" />
    <bpmn:sequenceFlow id="f-readCount-sendValues" sourceRef="readCount" targetRef="sendValues" />
    <bpmn:sequenceFlow id="f-sendValues-tellGo" sourceRef="sendValues" targetRef="tellGo" />
    <bpmn:sequenceFlow id="f-tellGo-notifyMsp" sourceRef="tellGo" targetRef="notifyMsp" />
    <bpmn:sequenceFlow id="f-notifyMsp-done" sourceRef="notifyMsp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
