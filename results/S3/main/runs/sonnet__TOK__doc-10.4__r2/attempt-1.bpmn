<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Metering organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readingN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReading</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>selfCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readingO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>notifyMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Equipment change intended" />
    <bpmn:task id="notifyIntent" name="Notify the MPOO about equipment change intentions" />
    <bpmn:task id="readingN" name="Perform the final reading" />
    <bpmn:task id="dismountN" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="readMeter" name="Read the meter count from the installed meter" />
    <bpmn:task id="sendReading" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tellGO" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="selfCheck" name="Self dismounting?" />
    <bpmn:task id="announce" name="Announce self dismounting to the MPON" />
    <bpmn:task id="noSelf" name="Notify the MPON about no self-dismounting" />
    <bpmn:task id="readingO" name="Perform the final reading by the MPOO" />
    <bpmn:task id="dismountO" name="Dismount the old equipment by the MPOO" />
    <bpmn:task id="notifyMSP" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="done" name="MSP notified" />
    <bpmn:sequenceFlow id="f-begin-notifyIntent" sourceRef="begin" targetRef="notifyIntent" />
    <bpmn:sequenceFlow id="f-notifyIntent-selfCheck" sourceRef="notifyIntent" targetRef="selfCheck" />
    <bpmn:sequenceFlow id="f-selfCheck-announce" name="yes" sourceRef="selfCheck" targetRef="announce" />
    <bpmn:sequenceFlow id="f-selfCheck-noSelf" name="no" sourceRef="selfCheck" targetRef="noSelf" />
    <bpmn:sequenceFlow id="f-announce-readingO" sourceRef="announce" targetRef="readingO" />
    <bpmn:sequenceFlow id="f-readingO-dismountO" sourceRef="readingO" targetRef="dismountO" />
    <bpmn:sequenceFlow id="f-dismountO-merge" sourceRef="dismountO" targetRef="merge" />
    <bpmn:sequenceFlow id="f-noSelf-readingN" sourceRef="noSelf" targetRef="readingN" />
    <bpmn:sequenceFlow id="f-readingN-dismountN" sourceRef="readingN" targetRef="dismountN" />
    <bpmn:sequenceFlow id="f-dismountN-merge" sourceRef="dismountN" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-mount" sourceRef="merge" targetRef="mount" />
    <bpmn:sequenceFlow id="f-mount-readMeter" sourceRef="mount" targetRef="readMeter" />
    <bpmn:sequenceFlow id="f-readMeter-sendReading" sourceRef="readMeter" targetRef="sendReading" />
    <bpmn:sequenceFlow id="f-sendReading-tellGO" sourceRef="sendReading" targetRef="tellGO" />
    <bpmn:sequenceFlow id="f-tellGO-notifyMSP" sourceRef="tellGO" targetRef="notifyMSP" />
    <bpmn:sequenceFlow id="f-notifyMSP-done" sourceRef="notifyMSP" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
