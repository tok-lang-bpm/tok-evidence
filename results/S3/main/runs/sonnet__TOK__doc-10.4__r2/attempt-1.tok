tok 1.0 "Equipment change"

pool org "Metering organisation"
  lane mpon "MPON"
    start begin "Equipment change intended"
    task notifyIntent "Notify the MPOO about equipment change intentions"
    task readingN "Perform the final reading"
    task dismountN "Dismount the old equipment"
    xor merge
    task mount "Mount the new device"
    task readMeter "Read the meter count from the installed meter"
    task sendReading "Send the values of the final reading to the GO"
    task tellGO "Tell the GO about the device changes, the master data and the meter count at installation"
  lane mpoo "MPOO"
    xor selfCheck "Self dismounting?"
    task announce "Announce self dismounting to the MPON"
    task noSelf "Notify the MPON about no self-dismounting"
    task readingO "Perform the final reading by the MPOO"
    task dismountO "Dismount the old equipment by the MPOO"
  lane go "GO"
    task notifyMSP "Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation"
    end done "MSP notified"

flow begin -> notifyIntent -> selfCheck
flow selfCheck -> announce "yes"
flow selfCheck -> noSelf "no"
flow announce -> readingO -> dismountO -> merge
flow noSelf -> readingN -> dismountN -> merge
flow merge -> mount -> readMeter -> sendReading -> tellGO -> notifyMSP -> done
