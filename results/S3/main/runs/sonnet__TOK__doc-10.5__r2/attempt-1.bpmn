<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Device takeover" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Device takeover" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestbid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>sendtender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendmaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Takeover needed" />
    <bpmn:task id="requestbid" name="Request a device takeover bid" />
    <bpmn:task id="placeorder" name="Place an order" />
    <bpmn:task id="sendtender" name="Send a tender for the equipment takeover" />
    <bpmn:task id="confirm" name="Confirm the order" />
    <bpmn:task id="sendmaster" name="Send the master data" />
    <bpmn:endEvent id="done" name="Order confirmed" />
    <bpmn:sequenceFlow id="f-begin-requestbid" sourceRef="begin" targetRef="requestbid" />
    <bpmn:sequenceFlow id="f-requestbid-sendtender" sourceRef="requestbid" targetRef="sendtender" />
    <bpmn:sequenceFlow id="f-sendtender-placeorder" sourceRef="sendtender" targetRef="placeorder" />
    <bpmn:sequenceFlow id="f-placeorder-confirm" sourceRef="placeorder" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-sendmaster" sourceRef="confirm" targetRef="sendmaster" />
    <bpmn:sequenceFlow id="f-sendmaster-done" sourceRef="sendmaster" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
