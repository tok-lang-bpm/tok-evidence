tok 1.0 "Device takeover"

pool org "Organisation"
  lane mpon "MPON"
    start begin "Takeover needed"
    task requestbid "Request a device takeover bid"
    task placeorder "Place an order"
  lane mpoo "MPOO"
    task sendtender "Send a tender for the equipment takeover"
    task confirm "Confirm the order"
    task sendmaster "Send the master data"
    end done "Order confirmed"

flow begin -> requestbid -> sendtender -> placeorder -> confirm -> sendmaster -> done
