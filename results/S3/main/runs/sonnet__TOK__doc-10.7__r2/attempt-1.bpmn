<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement registration and assignment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measurement registration and assignment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Measurement to register" />
    <bpmn:task id="register" name="Register the measurement at the GO" />
    <bpmn:task id="examine" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="decision" name="Application confirmed?" />
    <bpmn:task id="reject" name="Reject the application of the MSPN" />
    <bpmn:task id="confirm" name="Confirm the application of the MSPN" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="informmspo" name="Inform the MSPO about the assignment of the MSPN" />
    <bpmn:task id="informmpo" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="informsp" name="Inform the SP about the assignment of the MSPN" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:endEvent id="done" name="MSPN assigned and parties informed" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:sequenceFlow id="f-begin-register" sourceRef="begin" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-examine" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-decision" sourceRef="examine" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="yes" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-assign" sourceRef="confirm" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-split" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-informmspo" sourceRef="split" targetRef="informmspo" />
    <bpmn:sequenceFlow id="f-split-informmpo" sourceRef="split" targetRef="informmpo" />
    <bpmn:sequenceFlow id="f-split-informsp" sourceRef="split" targetRef="informsp" />
    <bpmn:sequenceFlow id="f-informmspo-joined" sourceRef="informmspo" targetRef="joined" />
    <bpmn:sequenceFlow id="f-informmpo-joined" sourceRef="informmpo" targetRef="joined" />
    <bpmn:sequenceFlow id="f-informsp-joined" sourceRef="informsp" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-done" sourceRef="joined" targetRef="done" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
