<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Restoration_request" name="Restoration request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="Service degradation handling" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>perceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivereport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customerdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>enterreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extrafix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premiumjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>affects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reprioritize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>affectsjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createdetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>senddetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csfork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createcustreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendcustreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sentfork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportrebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csjoinall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="eservice" name="Electronic service">
        <bpmn:flowNodeRef>significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendtorp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smtrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendperformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createresolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendresolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createrestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendrestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pathsjoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>checkprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rptrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statusreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitrestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>restorereceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trackerrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpcorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="perceived" name="Service degradation perceived" />
    <bpmn:task id="sendlist" name="Send list of problem parameters" />
    <bpmn:task id="receivereport" name="Receive report about service performance and problem resolution" />
    <bpmn:endEvent id="customerdone" name="Customer process ended" />
    <bpmn:task id="enterreport" name="Enter problem report into system T" />
    <bpmn:task id="compare" name="Compare problem report to customer SLA" />
    <bpmn:task id="determine" name="Determine counter measures and priorities" />
    <bpmn:exclusiveGateway id="premium" name="Customer premium?" />
    <bpmn:task id="extrafix" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="premiumjoin" />
    <bpmn:exclusiveGateway id="affects" name="Significance affects counter measures?" />
    <bpmn:task id="reprioritize" name="Re-prioritize counter measures" />
    <bpmn:exclusiveGateway id="affectsjoin" />
    <bpmn:task id="createdetailed" name="Create detailed problem report" />
    <bpmn:task id="senddetailed" name="Send detailed problem report to Service Management" />
    <bpmn:parallelGateway id="csfork" />
    <bpmn:task id="createcustreport" name="Create report for customer" />
    <bpmn:task id="sendcustreport" name="Send report to customer" />
    <bpmn:parallelGateway id="sentfork" />
    <bpmn:task id="reportrebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="csjoinall" />
    <bpmn:endEvent id="csdone" name="Customer Service process ended" />
    <bpmn:task id="significance" name="Determine significance of customer" />
    <bpmn:task id="investigate" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="analyzable" name="Problem analyzable by Service Management?" />
    <bpmn:task id="sendtorp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="smanalyze" name="Analyze problem" />
    <bpmn:task id="smtrouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="smjoin" />
    <bpmn:task id="finalstatus" name="Prepare final status report" />
    <bpmn:task id="decide" name="Determine counter measures" />
    <bpmn:exclusiveGateway id="paths" name="Which counter measure is required?" />
    <bpmn:task id="sendperformance" name="Send actual service performance to Customer Service" />
    <bpmn:task id="minor" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="resjoin" />
    <bpmn:task id="createresolution" name="Create problem resolution report" />
    <bpmn:task id="sendresolution" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="createrestore" name="Create request for automatic resource restoration" />
    <bpmn:task id="sendrestore" name="Send request to Resource Provisioning" />
    <bpmn:task id="receivets" name="Receive trouble-shooting report" />
    <bpmn:exclusiveGateway id="pathsjoin" />
    <bpmn:task id="checkprob" name="Check whether there are any possible problems" />
    <bpmn:exclusiveGateway id="detected" name="Problem detected?" />
    <bpmn:task id="normal" name="Create notification about normal service execution" />
    <bpmn:task id="rpanalyze" name="Analyze problem" />
    <bpmn:task id="rptrouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="rpjoin" />
    <bpmn:task id="statusreport" name="Include report in status report" />
    <bpmn:task id="sendstatus" name="Send status report to Service Management" />
    <bpmn:eventBasedGateway id="waitrestore" />
    <bpmn:intermediateCatchEvent id="restorereceived" name="Restoration request received">
      <bpmn:messageEventDefinition id="restorereceived-def" messageRef="Message_Restoration_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="2 days passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="terminated" name="Process terminated" />
    <bpmn:task id="trackerrors" name="Track all possible errors" />
    <bpmn:task id="rpcorrect" name="Undertake necessary corrective actions" />
    <bpmn:task id="createts" name="Create trouble-shooting report" />
    <bpmn:task id="sendts" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="rpdone" name="Resource Provisioning process ended" />
    <bpmn:task id="adjust" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-perceived-sendlist" sourceRef="perceived" targetRef="sendlist" />
    <bpmn:sequenceFlow id="f-sendlist-enterreport" sourceRef="sendlist" targetRef="enterreport" />
    <bpmn:sequenceFlow id="f-enterreport-compare" sourceRef="enterreport" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-determine" sourceRef="compare" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-significance" sourceRef="determine" targetRef="significance" />
    <bpmn:sequenceFlow id="f-significance-premium" sourceRef="significance" targetRef="premium" />
    <bpmn:sequenceFlow id="f-premium-extrafix" name="yes" sourceRef="premium" targetRef="extrafix" />
    <bpmn:sequenceFlow id="f-premium-premiumjoin" name="no" sourceRef="premium" targetRef="premiumjoin" />
    <bpmn:sequenceFlow id="f-extrafix-premiumjoin" sourceRef="extrafix" targetRef="premiumjoin" />
    <bpmn:sequenceFlow id="f-premiumjoin-affects" sourceRef="premiumjoin" targetRef="affects" />
    <bpmn:sequenceFlow id="f-affects-reprioritize" name="yes" sourceRef="affects" targetRef="reprioritize" />
    <bpmn:sequenceFlow id="f-affects-affectsjoin" name="no" sourceRef="affects" targetRef="affectsjoin" />
    <bpmn:sequenceFlow id="f-reprioritize-affectsjoin" sourceRef="reprioritize" targetRef="affectsjoin" />
    <bpmn:sequenceFlow id="f-affectsjoin-createdetailed" sourceRef="affectsjoin" targetRef="createdetailed" />
    <bpmn:sequenceFlow id="f-createdetailed-senddetailed" sourceRef="createdetailed" targetRef="senddetailed" />
    <bpmn:sequenceFlow id="f-senddetailed-investigate" sourceRef="senddetailed" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-analyzable" sourceRef="investigate" targetRef="analyzable" />
    <bpmn:sequenceFlow id="f-analyzable-sendtorp" name="no" sourceRef="analyzable" targetRef="sendtorp" />
    <bpmn:sequenceFlow id="f-analyzable-smanalyze" name="yes" sourceRef="analyzable" targetRef="smanalyze" />
    <bpmn:sequenceFlow id="f-smanalyze-smtrouble" sourceRef="smanalyze" targetRef="smtrouble" />
    <bpmn:sequenceFlow id="f-smtrouble-smjoin" sourceRef="smtrouble" targetRef="smjoin" />
    <bpmn:sequenceFlow id="f-sendtorp-checkprob" sourceRef="sendtorp" targetRef="checkprob" />
    <bpmn:sequenceFlow id="f-checkprob-detected" sourceRef="checkprob" targetRef="detected" />
    <bpmn:sequenceFlow id="f-detected-normal" name="no" sourceRef="detected" targetRef="normal" />
    <bpmn:sequenceFlow id="f-detected-rpanalyze" name="yes" sourceRef="detected" targetRef="rpanalyze" />
    <bpmn:sequenceFlow id="f-rpanalyze-rptrouble" sourceRef="rpanalyze" targetRef="rptrouble" />
    <bpmn:sequenceFlow id="f-rptrouble-rpjoin" sourceRef="rptrouble" targetRef="rpjoin" />
    <bpmn:sequenceFlow id="f-normal-rpjoin" sourceRef="normal" targetRef="rpjoin" />
    <bpmn:sequenceFlow id="f-rpjoin-statusreport" sourceRef="rpjoin" targetRef="statusreport" />
    <bpmn:sequenceFlow id="f-statusreport-sendstatus" sourceRef="statusreport" targetRef="sendstatus" />
    <bpmn:sequenceFlow id="f-sendstatus-smjoin" sourceRef="sendstatus" targetRef="smjoin" />
    <bpmn:sequenceFlow id="f-smjoin-finalstatus" sourceRef="smjoin" targetRef="finalstatus" />
    <bpmn:sequenceFlow id="f-finalstatus-decide" sourceRef="finalstatus" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-paths" sourceRef="decide" targetRef="paths" />
    <bpmn:sequenceFlow id="f-paths-sendperformance" name="no problem detected" sourceRef="paths" targetRef="sendperformance" />
    <bpmn:sequenceFlow id="f-paths-minor" name="minor corrective actions" sourceRef="paths" targetRef="minor" />
    <bpmn:sequenceFlow id="f-paths-createrestore" name="automatic restoration required" sourceRef="paths" targetRef="createrestore" />
    <bpmn:sequenceFlow id="f-minor-resjoin" sourceRef="minor" targetRef="resjoin" />
    <bpmn:sequenceFlow id="f-receivets-resjoin" sourceRef="receivets" targetRef="resjoin" />
    <bpmn:sequenceFlow id="f-resjoin-createresolution" sourceRef="resjoin" targetRef="createresolution" />
    <bpmn:sequenceFlow id="f-createresolution-sendresolution" sourceRef="createresolution" targetRef="sendresolution" />
    <bpmn:sequenceFlow id="f-sendresolution-pathsjoin" sourceRef="sendresolution" targetRef="pathsjoin" />
    <bpmn:sequenceFlow id="f-sendperformance-pathsjoin" sourceRef="sendperformance" targetRef="pathsjoin" />
    <bpmn:sequenceFlow id="f-pathsjoin-csfork" sourceRef="pathsjoin" targetRef="csfork" />
    <bpmn:sequenceFlow id="f-createrestore-sendrestore" sourceRef="createrestore" targetRef="sendrestore" />
    <bpmn:sequenceFlow id="f-sendrestore-waitrestore" sourceRef="sendrestore" targetRef="waitrestore" />
    <bpmn:sequenceFlow id="f-waitrestore-restorereceived" sourceRef="waitrestore" targetRef="restorereceived" />
    <bpmn:sequenceFlow id="f-waitrestore-timeout" sourceRef="waitrestore" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-timeout-terminated" sourceRef="timeout" targetRef="terminated" />
    <bpmn:sequenceFlow id="f-restorereceived-trackerrors" sourceRef="restorereceived" targetRef="trackerrors" />
    <bpmn:sequenceFlow id="f-trackerrors-rpcorrect" sourceRef="trackerrors" targetRef="rpcorrect" />
    <bpmn:sequenceFlow id="f-rpcorrect-createts" sourceRef="rpcorrect" targetRef="createts" />
    <bpmn:sequenceFlow id="f-createts-sendts" sourceRef="createts" targetRef="sendts" />
    <bpmn:sequenceFlow id="f-sendts-rpdone" sourceRef="sendts" targetRef="rpdone" />
    <bpmn:sequenceFlow id="f-sendts-receivets" sourceRef="sendts" targetRef="receivets" />
    <bpmn:sequenceFlow id="f-csfork-createcustreport" sourceRef="csfork" targetRef="createcustreport" />
    <bpmn:sequenceFlow id="f-createcustreport-sendcustreport" sourceRef="createcustreport" targetRef="sendcustreport" />
    <bpmn:sequenceFlow id="f-sendcustreport-sentfork" sourceRef="sendcustreport" targetRef="sentfork" />
    <bpmn:sequenceFlow id="f-csfork-reportrebate" sourceRef="csfork" targetRef="reportrebate" />
    <bpmn:sequenceFlow id="f-reportrebate-adjust" sourceRef="reportrebate" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjust-csjoinall" sourceRef="adjust" targetRef="csjoinall" />
    <bpmn:sequenceFlow id="f-sentfork-receivereport" sourceRef="sentfork" targetRef="receivereport" />
    <bpmn:sequenceFlow id="f-receivereport-customerdone" sourceRef="receivereport" targetRef="customerdone" />
    <bpmn:sequenceFlow id="f-sentfork-csjoinall" sourceRef="sentfork" targetRef="csjoinall" />
    <bpmn:sequenceFlow id="f-csjoinall-csdone" sourceRef="csjoinall" targetRef="csdone" />
  </bpmn:process>
</bpmn:definitions>
