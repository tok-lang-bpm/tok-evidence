<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:signal id="Signal_Restoration_request" name="Restoration request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="Service degradation handling" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>perceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiverep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixproc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>senddetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendcust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cjoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Electronic service">
        <bpmn:flowNodeRef>significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smtrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendrp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendperf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sigreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqsent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rptrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mrp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statusrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqrcv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tmo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpfix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendshoot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="perceived" name="Service degradation perceived" />
    <bpmn:task id="sendlist" name="Send list of problem parameters" />
    <bpmn:task id="receiverep" name="Receive report on service performance and problem resolution" />
    <bpmn:endEvent id="custdone" name="Customer process ended" />
    <bpmn:task id="enter" name="Enter problem report into system T" />
    <bpmn:task id="compare" name="Compare problem report to customer SLA" />
    <bpmn:task id="measures" name="Determine counter measures and priorities" />
    <bpmn:exclusiveGateway id="premium" name="Customer premium?" />
    <bpmn:task id="fixproc" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="pmerge" />
    <bpmn:exclusiveGateway id="signif" name="Significance affects counter measures?" />
    <bpmn:task id="detailed" name="Create detailed problem report" />
    <bpmn:task id="senddetailed" name="Send detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:parallelGateway id="csplit" />
    <bpmn:task id="custreport" name="Create report for customer" />
    <bpmn:task id="sendcust" name="Send report to customer" />
    <bpmn:task id="rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="cjoin" />
    <bpmn:task id="significance" name="Determine significance of customer" />
    <bpmn:task id="investigate" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="analyzable" name="Analyzable by Service Management?" />
    <bpmn:task id="smanalyze" name="Analyze problem" />
    <bpmn:task id="smtrouble" name="Create trouble report" />
    <bpmn:task id="sendrp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="finalrep" name="Prepare final status report" />
    <bpmn:task id="decide" name="Determine counter measures from final status report" />
    <bpmn:exclusiveGateway id="outcome" name="Which path is required?" />
    <bpmn:task id="sendperf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="minor" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="mres" />
    <bpmn:task id="resolution" name="Create problem resolution report" />
    <bpmn:task id="sendres" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="createreq" name="Create request for automatic resource restoration" />
    <bpmn:intermediateThrowEvent id="sigreq" name="Send restoration request">
      <bpmn:signalEventDefinition id="sigreq-def" signalRef="Signal_Restoration_request" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="reqsent" name="Request sent" />
    <bpmn:task id="check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="detected" name="Problem detected?" />
    <bpmn:task id="normal" name="Create notification about normal service execution" />
    <bpmn:task id="rpanalyze" name="Analyze problem" />
    <bpmn:task id="rptrouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="mrp" />
    <bpmn:task id="statusrep" name="Include report in status report" />
    <bpmn:task id="sendstatus" name="Send status report to Service Management" />
    <bpmn:parallelGateway id="rpsplit" />
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="reqrcv" name="Restoration request received">
      <bpmn:signalEventDefinition id="reqrcv-def" signalRef="Signal_Restoration_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tmo" name="2 days passed">
      <bpmn:timerEventDefinition id="tmo-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="terminated" name="Process terminated">
      <bpmn:terminateEventDefinition id="terminated-def" />
    </bpmn:endEvent>
    <bpmn:task id="track" name="Track all possible errors" />
    <bpmn:task id="rpfix" name="Undertake necessary corrective actions" />
    <bpmn:task id="shoot" name="Create trouble-shooting report" />
    <bpmn:task id="sendshoot" name="Send trouble-shooting report to Service Management" />
    <bpmn:task id="adjust" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-perceived-sendlist" sourceRef="perceived" targetRef="sendlist" />
    <bpmn:sequenceFlow id="f-sendlist-enter" sourceRef="sendlist" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-compare" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-measures" sourceRef="compare" targetRef="measures" />
    <bpmn:sequenceFlow id="f-measures-significance" sourceRef="measures" targetRef="significance" />
    <bpmn:sequenceFlow id="f-significance-premium" sourceRef="significance" targetRef="premium" />
    <bpmn:sequenceFlow id="f-premium-fixproc" name="yes" sourceRef="premium" targetRef="fixproc" />
    <bpmn:sequenceFlow id="f-premium-pmerge" name="no" sourceRef="premium" targetRef="pmerge" />
    <bpmn:sequenceFlow id="f-fixproc-pmerge" sourceRef="fixproc" targetRef="pmerge" />
    <bpmn:sequenceFlow id="f-pmerge-signif" sourceRef="pmerge" targetRef="signif" />
    <bpmn:sequenceFlow id="f-signif-measures" name="yes" sourceRef="signif" targetRef="measures" />
    <bpmn:sequenceFlow id="f-signif-detailed" name="no" sourceRef="signif" targetRef="detailed" />
    <bpmn:sequenceFlow id="f-detailed-senddetailed" sourceRef="detailed" targetRef="senddetailed" />
    <bpmn:sequenceFlow id="f-senddetailed-investigate" sourceRef="senddetailed" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-analyzable" sourceRef="investigate" targetRef="analyzable" />
    <bpmn:sequenceFlow id="f-analyzable-smanalyze" name="yes" sourceRef="analyzable" targetRef="smanalyze" />
    <bpmn:sequenceFlow id="f-analyzable-sendrp" name="no" sourceRef="analyzable" targetRef="sendrp" />
    <bpmn:sequenceFlow id="f-smanalyze-smtrouble" sourceRef="smanalyze" targetRef="smtrouble" />
    <bpmn:sequenceFlow id="f-smtrouble-m1" sourceRef="smtrouble" targetRef="m1" />
    <bpmn:sequenceFlow id="f-sendrp-check" sourceRef="sendrp" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-detected" sourceRef="check" targetRef="detected" />
    <bpmn:sequenceFlow id="f-detected-normal" name="no" sourceRef="detected" targetRef="normal" />
    <bpmn:sequenceFlow id="f-detected-rpanalyze" name="yes" sourceRef="detected" targetRef="rpanalyze" />
    <bpmn:sequenceFlow id="f-rpanalyze-rptrouble" sourceRef="rpanalyze" targetRef="rptrouble" />
    <bpmn:sequenceFlow id="f-rptrouble-mrp" sourceRef="rptrouble" targetRef="mrp" />
    <bpmn:sequenceFlow id="f-normal-mrp" sourceRef="normal" targetRef="mrp" />
    <bpmn:sequenceFlow id="f-mrp-statusrep" sourceRef="mrp" targetRef="statusrep" />
    <bpmn:sequenceFlow id="f-statusrep-sendstatus" sourceRef="statusrep" targetRef="sendstatus" />
    <bpmn:sequenceFlow id="f-sendstatus-rpsplit" sourceRef="sendstatus" targetRef="rpsplit" />
    <bpmn:sequenceFlow id="f-rpsplit-m1" sourceRef="rpsplit" targetRef="m1" />
    <bpmn:sequenceFlow id="f-rpsplit-wait" sourceRef="rpsplit" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-reqrcv" sourceRef="wait" targetRef="reqrcv" />
    <bpmn:sequenceFlow id="f-reqrcv-track" sourceRef="reqrcv" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-rpfix" sourceRef="track" targetRef="rpfix" />
    <bpmn:sequenceFlow id="f-rpfix-shoot" sourceRef="rpfix" targetRef="shoot" />
    <bpmn:sequenceFlow id="f-shoot-sendshoot" sourceRef="shoot" targetRef="sendshoot" />
    <bpmn:sequenceFlow id="f-sendshoot-mres" sourceRef="sendshoot" targetRef="mres" />
    <bpmn:sequenceFlow id="f-wait-tmo" sourceRef="wait" targetRef="tmo" />
    <bpmn:sequenceFlow id="f-tmo-terminated" sourceRef="tmo" targetRef="terminated" />
    <bpmn:sequenceFlow id="f-m1-finalrep" sourceRef="m1" targetRef="finalrep" />
    <bpmn:sequenceFlow id="f-finalrep-decide" sourceRef="finalrep" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-outcome" sourceRef="decide" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-sendperf" name="no problem detected" sourceRef="outcome" targetRef="sendperf" />
    <bpmn:sequenceFlow id="f-outcome-minor" name="minor corrective actions" sourceRef="outcome" targetRef="minor" />
    <bpmn:sequenceFlow id="f-outcome-createreq" name="automatic restoration required" sourceRef="outcome" targetRef="createreq" />
    <bpmn:sequenceFlow id="f-minor-mres" sourceRef="minor" targetRef="mres" />
    <bpmn:sequenceFlow id="f-mres-resolution" sourceRef="mres" targetRef="resolution" />
    <bpmn:sequenceFlow id="f-resolution-sendres" sourceRef="resolution" targetRef="sendres" />
    <bpmn:sequenceFlow id="f-sendres-m2" sourceRef="sendres" targetRef="m2" />
    <bpmn:sequenceFlow id="f-sendperf-m2" sourceRef="sendperf" targetRef="m2" />
    <bpmn:sequenceFlow id="f-createreq-sigreq" sourceRef="createreq" targetRef="sigreq" />
    <bpmn:sequenceFlow id="f-sigreq-reqsent" sourceRef="sigreq" targetRef="reqsent" />
    <bpmn:sequenceFlow id="f-m2-csplit" sourceRef="m2" targetRef="csplit" />
    <bpmn:sequenceFlow id="f-csplit-custreport" sourceRef="csplit" targetRef="custreport" />
    <bpmn:sequenceFlow id="f-custreport-sendcust" sourceRef="custreport" targetRef="sendcust" />
    <bpmn:sequenceFlow id="f-sendcust-cjoin" sourceRef="sendcust" targetRef="cjoin" />
    <bpmn:sequenceFlow id="f-csplit-rebate" sourceRef="csplit" targetRef="rebate" />
    <bpmn:sequenceFlow id="f-rebate-adjust" sourceRef="rebate" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjust-cjoin" sourceRef="adjust" targetRef="cjoin" />
    <bpmn:sequenceFlow id="f-cjoin-receiverep" sourceRef="cjoin" targetRef="receiverep" />
    <bpmn:sequenceFlow id="f-receiverep-custdone" sourceRef="receiverep" targetRef="custdone" />
  </bpmn:process>
</bpmn:definitions>
