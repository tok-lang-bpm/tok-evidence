<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Winning a new customer: power supplier switch" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Confirmation" name="Confirmation" />
  <bpmn:message id="Message_Withdrawal" name="Withdrawal" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Power supplier" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Winning a new customer: power supplier switch" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>existsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptedMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>importMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>checkDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regenerate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid operator">
        <bpmn:flowNodeRef>checkConcurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSuppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meterSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>computeBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBilling</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old" name="Old supplier">
        <bpmn:flowNodeRef>createBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Switch-over request" />
    <bpmn:task id="transmit" name="Transmit customer data" />
    <bpmn:task id="checkContract" name="Check the contract details" />
    <bpmn:eventBasedGateway id="decide" />
    <bpmn:intermediateCatchEvent id="confirm" name="Contract confirmed">
      <bpmn:messageEventDefinition id="confirm-def" messageRef="Message_Confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="withdraw" name="Contract withdrawn">
      <bpmn:messageEventDefinition id="withdraw-def" messageRef="Message_Withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="7 days passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="withdrawn" name="Customer withdrew from the contract" />
    <bpmn:task id="receive" name="Receive the customer data" />
    <bpmn:task id="enter" name="Enter the customer data object into the CRM system" />
    <bpmn:task id="compare" name="Compare the customer data with the customer data base" />
    <bpmn:exclusiveGateway id="errors" name="Errors found?" />
    <bpmn:task id="correct" name="Correct the errors using the error list" />
    <bpmn:exclusiveGateway id="exists" name="Customer exists in the data base?" />
    <bpmn:task id="createCustomer" name="Create a new customer object" />
    <bpmn:exclusiveGateway id="existsMerge" />
    <bpmn:task id="prepare" name="Prepare the contract documents" />
    <bpmn:task id="sendConfirmation" name="Send the confirmation document to the customer" />
    <bpmn:task id="createContract" name="Create the CIS contract" />
    <bpmn:exclusiveGateway id="acceptedMerge" />
    <bpmn:task id="importMeter" name="Import the meter data to the systems" />
    <bpmn:parallelGateway id="billingJoin" />
    <bpmn:endEvent id="done" name="New customer won" />
    <bpmn:task id="checkDocs" name="Check the contract documents" />
    <bpmn:exclusiveGateway id="docsOk" name="Contract documents generated correctly?" />
    <bpmn:task id="analyze" name="Analyze and resolve the issues" />
    <bpmn:task id="regenerate" name="Generate the contract documents again" />
    <bpmn:task id="sendRequest" name="Send the request to the grid operator" />
    <bpmn:task id="checkConcurrence" name="Check the switch-over request for supplier concurrence" />
    <bpmn:task id="comment" name="Transmit the response comment" />
    <bpmn:exclusiveGateway id="concurrence" name="Supplier concurrence?" />
    <bpmn:task id="informSuppliers" name="Inform all involved suppliers and demand the resolution of the conflict" />
    <bpmn:endEvent id="conflict" name="Conflict handed to the suppliers" />
    <bpmn:task id="terminate" name="Terminate the sales agreement with the old supplier" />
    <bpmn:task id="transmitMeter" name="Transmit the meter data" />
    <bpmn:parallelGateway id="meterSplit" />
    <bpmn:task id="computeBilling" name="Compute the final billing" />
    <bpmn:task id="sendBilling" name="Send the final billing to the old supplier" />
    <bpmn:task id="createBilling" name="Create the final billing" />
    <bpmn:task id="sendFinal" name="Send the final billing to the customer" />
    <bpmn:sequenceFlow id="f-requested-transmit" sourceRef="requested" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-receive" sourceRef="transmit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-enter" sourceRef="receive" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-compare" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-errors" sourceRef="compare" targetRef="errors" />
    <bpmn:sequenceFlow id="f-errors-correct" name="yes" sourceRef="errors" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-compare" sourceRef="correct" targetRef="compare" />
    <bpmn:sequenceFlow id="f-errors-exists" name="no" sourceRef="errors" targetRef="exists" />
    <bpmn:sequenceFlow id="f-exists-createCustomer" name="no" sourceRef="exists" targetRef="createCustomer" />
    <bpmn:sequenceFlow id="f-exists-existsMerge" name="yes" sourceRef="exists" targetRef="existsMerge" />
    <bpmn:sequenceFlow id="f-createCustomer-existsMerge" sourceRef="createCustomer" targetRef="existsMerge" />
    <bpmn:sequenceFlow id="f-existsMerge-prepare" sourceRef="existsMerge" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-checkDocs" sourceRef="prepare" targetRef="checkDocs" />
    <bpmn:sequenceFlow id="f-checkDocs-docsOk" sourceRef="checkDocs" targetRef="docsOk" />
    <bpmn:sequenceFlow id="f-docsOk-analyze" name="no" sourceRef="docsOk" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-regenerate" sourceRef="analyze" targetRef="regenerate" />
    <bpmn:sequenceFlow id="f-regenerate-checkDocs" sourceRef="regenerate" targetRef="checkDocs" />
    <bpmn:sequenceFlow id="f-docsOk-sendConfirmation" name="yes" sourceRef="docsOk" targetRef="sendConfirmation" />
    <bpmn:sequenceFlow id="f-sendConfirmation-sendRequest" sourceRef="sendConfirmation" targetRef="sendRequest" />
    <bpmn:sequenceFlow id="f-sendRequest-checkConcurrence" sourceRef="sendRequest" targetRef="checkConcurrence" />
    <bpmn:sequenceFlow id="f-checkConcurrence-comment" sourceRef="checkConcurrence" targetRef="comment" />
    <bpmn:sequenceFlow id="f-comment-concurrence" sourceRef="comment" targetRef="concurrence" />
    <bpmn:sequenceFlow id="f-concurrence-informSuppliers" name="yes" sourceRef="concurrence" targetRef="informSuppliers" />
    <bpmn:sequenceFlow id="f-informSuppliers-conflict" sourceRef="informSuppliers" targetRef="conflict" />
    <bpmn:sequenceFlow id="f-concurrence-terminate" name="no" sourceRef="concurrence" targetRef="terminate" />
    <bpmn:sequenceFlow id="f-terminate-createContract" sourceRef="terminate" targetRef="createContract" />
    <bpmn:sequenceFlow id="f-createContract-checkContract" sourceRef="createContract" targetRef="checkContract" />
    <bpmn:sequenceFlow id="f-checkContract-decide" sourceRef="checkContract" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-confirm" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decide-withdraw" sourceRef="decide" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-decide-timeout" sourceRef="decide" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-withdraw-withdrawn" sourceRef="withdraw" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f-confirm-acceptedMerge" sourceRef="confirm" targetRef="acceptedMerge" />
    <bpmn:sequenceFlow id="f-timeout-acceptedMerge" sourceRef="timeout" targetRef="acceptedMerge" />
    <bpmn:sequenceFlow id="f-acceptedMerge-transmitMeter" sourceRef="acceptedMerge" targetRef="transmitMeter" />
    <bpmn:sequenceFlow id="f-transmitMeter-meterSplit" sourceRef="transmitMeter" targetRef="meterSplit" />
    <bpmn:sequenceFlow id="f-meterSplit-computeBilling" sourceRef="meterSplit" targetRef="computeBilling" />
    <bpmn:sequenceFlow id="f-computeBilling-sendBilling" sourceRef="computeBilling" targetRef="sendBilling" />
    <bpmn:sequenceFlow id="f-sendBilling-createBilling" sourceRef="sendBilling" targetRef="createBilling" />
    <bpmn:sequenceFlow id="f-createBilling-sendFinal" sourceRef="createBilling" targetRef="sendFinal" />
    <bpmn:sequenceFlow id="f-sendFinal-billingJoin" sourceRef="sendFinal" targetRef="billingJoin" />
    <bpmn:sequenceFlow id="f-meterSplit-importMeter" sourceRef="meterSplit" targetRef="importMeter" />
    <bpmn:sequenceFlow id="f-importMeter-billingJoin" sourceRef="importMeter" targetRef="billingJoin" />
    <bpmn:sequenceFlow id="f-billingJoin-done" sourceRef="billingJoin" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
