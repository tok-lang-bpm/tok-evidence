<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Winning a new customer: power supplier switch" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Withdrawal" name="Withdrawal" />
  <bpmn:message id="Message_Confirmation" name="Confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Winning a new customer: power supplier switch" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkcontract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivebill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkdata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>existsmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createcis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>checkdocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid operator">
        <bpmn:flowNodeRef>checkreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitmeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendbill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old" name="Old supplier">
        <bpmn:flowNodeRef>createbill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendcust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Switch-over request initiated" />
    <bpmn:task id="transmit" name="Transmit customer data" />
    <bpmn:task id="checkcontract" name="Check contract details" />
    <bpmn:eventBasedGateway id="decide" />
    <bpmn:intermediateCatchEvent id="withdraw" name="Withdrawal received">
      <bpmn:messageEventDefinition id="withdraw-def" messageRef="Message_Withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="confirm" name="Confirmation received">
      <bpmn:messageEventDefinition id="confirm-def" messageRef="Message_Confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="wait7" name="7 days passed">
      <bpmn:timerEventDefinition id="wait7-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="receivebill" name="Receive final billing" />
    <bpmn:task id="receive" name="Receive customer data" />
    <bpmn:task id="enter" name="Enter customer data object into CRM system" />
    <bpmn:task id="compare" name="Compare customer data with customer data base" />
    <bpmn:task id="checkdata" name="Check customer data for completeness and plausibility" />
    <bpmn:exclusiveGateway id="errors" name="Errors found?" default="f-errors-exists" />
    <bpmn:task id="correct" name="Correct errors using error list" />
    <bpmn:exclusiveGateway id="exists" name="Customer exists in data base?" default="f-exists-create" />
    <bpmn:task id="create" name="Create new customer object" />
    <bpmn:exclusiveGateway id="existsmerge" />
    <bpmn:exclusiveGateway id="prepmerge" />
    <bpmn:task id="prepare" name="Prepare contract documents" />
    <bpmn:task id="sendconf" name="Send confirmation document to customer" />
    <bpmn:task id="createcis" name="Create CIS contract" />
    <bpmn:exclusiveGateway id="accepted" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="import" name="Import meter data to systems" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="done" name="New customer won" />
    <bpmn:endEvent id="withdrawn" name="Process ended by withdrawal" />
    <bpmn:task id="checkdocs" name="Check contract documents" />
    <bpmn:exclusiveGateway id="generated" name="Contract documents generated successfully?" default="f-generated-analyze" />
    <bpmn:task id="analyze" name="Analyze and resolve issues" />
    <bpmn:task id="sendreq" name="Send request to grid operator" />
    <bpmn:task id="checkreq" name="Check switch-over request for supplier concurrence" />
    <bpmn:exclusiveGateway id="concurrence" name="Supplier concurrence?" default="f-concurrence-terminate" />
    <bpmn:task id="informsup" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:task id="terminate" name="Terminate sales agreement with old supplier" />
    <bpmn:task id="transmitmeter" name="Transmit power meter data" />
    <bpmn:task id="compute" name="Compute final billing" />
    <bpmn:task id="sendbill" name="Send final billing to old supplier" />
    <bpmn:endEvent id="rejected" name="Switch-over rejected" />
    <bpmn:task id="createbill" name="Create final billing" />
    <bpmn:task id="sendcust" name="Send final billing to customer" />
    <bpmn:sequenceFlow id="f-requested-transmit" sourceRef="requested" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-receive" sourceRef="transmit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-enter" sourceRef="receive" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-compare" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-checkdata" sourceRef="compare" targetRef="checkdata" />
    <bpmn:sequenceFlow id="f-checkdata-errors" sourceRef="checkdata" targetRef="errors" />
    <bpmn:sequenceFlow id="f-errors-correct" name="yes" sourceRef="errors" targetRef="correct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">errorsFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-correct-checkdata" sourceRef="correct" targetRef="checkdata" />
    <bpmn:sequenceFlow id="f-errors-exists" name="no" sourceRef="errors" targetRef="exists" />
    <bpmn:sequenceFlow id="f-exists-create" name="no" sourceRef="exists" targetRef="create" />
    <bpmn:sequenceFlow id="f-exists-existsmerge" name="yes" sourceRef="exists" targetRef="existsmerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerExists = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-create-existsmerge" sourceRef="create" targetRef="existsmerge" />
    <bpmn:sequenceFlow id="f-existsmerge-prepmerge" sourceRef="existsmerge" targetRef="prepmerge" />
    <bpmn:sequenceFlow id="f-prepmerge-prepare" sourceRef="prepmerge" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-checkdocs" sourceRef="prepare" targetRef="checkdocs" />
    <bpmn:sequenceFlow id="f-checkdocs-generated" sourceRef="checkdocs" targetRef="generated" />
    <bpmn:sequenceFlow id="f-generated-analyze" name="no" sourceRef="generated" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-prepmerge" sourceRef="analyze" targetRef="prepmerge" />
    <bpmn:sequenceFlow id="f-generated-sendconf" name="yes" sourceRef="generated" targetRef="sendconf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsGenerated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sendconf-sendreq" sourceRef="sendconf" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-checkreq" sourceRef="sendreq" targetRef="checkreq" />
    <bpmn:sequenceFlow id="f-checkreq-concurrence" sourceRef="checkreq" targetRef="concurrence" />
    <bpmn:sequenceFlow id="f-concurrence-informsup" name="yes" sourceRef="concurrence" targetRef="informsup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supplierConcurrence = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-informsup-rejected" sourceRef="informsup" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-concurrence-terminate" name="no" sourceRef="concurrence" targetRef="terminate" />
    <bpmn:sequenceFlow id="f-terminate-createcis" sourceRef="terminate" targetRef="createcis" />
    <bpmn:sequenceFlow id="f-createcis-checkcontract" sourceRef="createcis" targetRef="checkcontract" />
    <bpmn:sequenceFlow id="f-checkcontract-decide" sourceRef="checkcontract" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-withdraw" sourceRef="decide" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-decide-confirm" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decide-wait7" sourceRef="decide" targetRef="wait7" />
    <bpmn:sequenceFlow id="f-withdraw-withdrawn" sourceRef="withdraw" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f-confirm-accepted" sourceRef="confirm" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-wait7-accepted" sourceRef="wait7" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-split" sourceRef="accepted" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-transmitmeter" sourceRef="split" targetRef="transmitmeter" />
    <bpmn:sequenceFlow id="f-transmitmeter-import" sourceRef="transmitmeter" targetRef="import" />
    <bpmn:sequenceFlow id="f-import-join" sourceRef="import" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-compute" sourceRef="split" targetRef="compute" />
    <bpmn:sequenceFlow id="f-compute-sendbill" sourceRef="compute" targetRef="sendbill" />
    <bpmn:sequenceFlow id="f-sendbill-createbill" sourceRef="sendbill" targetRef="createbill" />
    <bpmn:sequenceFlow id="f-createbill-sendcust" sourceRef="createbill" targetRef="sendcust" />
    <bpmn:sequenceFlow id="f-sendcust-receivebill" sourceRef="sendcust" targetRef="receivebill" />
    <bpmn:sequenceFlow id="f-receivebill-join" sourceRef="receivebill" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-done" sourceRef="join" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
