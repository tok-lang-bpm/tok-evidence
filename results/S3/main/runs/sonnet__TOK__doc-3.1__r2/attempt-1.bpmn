<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="registry" name="Small Claims Registry Operations" processRef="registry-process" />
  </bpmn:collaboration>
  <bpmn:process id="registry-process" name="Warrant possession request handling" isExecutable="false">
    <bpmn:laneSet id="registry-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>awaitreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Warrant release needed" />
    <bpmn:task id="send" name="Send the warrant possession request" />
    <bpmn:task id="receive" name="Receive the request" />
    <bpmn:task id="retrieve1" name="Retrieve the SCT file" />
    <bpmn:task id="forward" name="Forward the SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store1" name="Store the SCT physical file" />
    <bpmn:task id="awaitreport" name="Receive the report from the Police" />
    <bpmn:task id="retrieve2" name="Retrieve the SCT file" />
    <bpmn:task id="attach" name="Attach the new SCT document" />
    <bpmn:task id="store2" name="Store the expanded SCT physical file" />
    <bpmn:task id="handover" name="Hand over the physical SCT file to MC internal staff" />
    <bpmn:endEvent id="done" name="SCT file handed over" />
    <bpmn:sequenceFlow id="f-needed-send" sourceRef="needed" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-receive" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-retrieve1" sourceRef="receive" targetRef="retrieve1" />
    <bpmn:sequenceFlow id="f-retrieve1-forward" sourceRef="retrieve1" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-store1" sourceRef="forward" targetRef="store1" />
    <bpmn:sequenceFlow id="f-store1-awaitreport" sourceRef="store1" targetRef="awaitreport" />
    <bpmn:sequenceFlow id="f-awaitreport-retrieve2" sourceRef="awaitreport" targetRef="retrieve2" />
    <bpmn:sequenceFlow id="f-retrieve2-attach" sourceRef="retrieve2" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-store2" sourceRef="attach" targetRef="store2" />
    <bpmn:sequenceFlow id="f-store2-handover" sourceRef="store2" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-done" sourceRef="handover" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
