tok 1.0 "Warrant possession request handling"

pool registry "Small Claims Registry Operations"
  lane party "Party"
    start needed "Warrant release needed"
    task send "Send the warrant possession request"
  lane backoffice "Client Service Back Office"
    task receive "Receive the request"
    task retrieve1 "Retrieve the SCT file"
    task forward "Forward the SCT Warrant Possession to Queensland Police"
    task store1 "Store the SCT physical file"
    task awaitreport "Receive the report from the Police"
    task retrieve2 "Retrieve the SCT file"
    task attach "Attach the new SCT document"
    task store2 "Store the expanded SCT physical file"
    task handover "Hand over the physical SCT file to MC internal staff"
    end done "SCT file handed over"

flow needed -> send -> receive -> retrieve1 -> forward -> store1 -> awaitreport -> retrieve2 -> attach -> store2 -> handover -> done
