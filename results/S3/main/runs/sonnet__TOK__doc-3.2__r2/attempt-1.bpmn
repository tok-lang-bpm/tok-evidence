<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court hearing file preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court hearing file preparation" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="registry" name="Court registry">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Morning of the court hearing" />
    <bpmn:task id="check" name="Check the files yet to be processed" />
    <bpmn:exclusiveGateway id="missing" name="Are some files missing?" default="f-missing-track" />
    <bpmn:task id="search" name="Initiate a search for the missing files" />
    <bpmn:task id="track" name="Physically track the files to the intended location" />
    <bpmn:exclusiveGateway id="ready" name="Files ready" />
    <bpmn:parallelGateway id="prepared" />
    <bpmn:task id="handover" name="Hand the files to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="done" />
    <bpmn:task id="conduct" name="Conduct the directions hearings" />
    <bpmn:endEvent id="finished" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f-morning-check" sourceRef="morning" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-prepared" sourceRef="ready" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prepared-handover" sourceRef="prepared" targetRef="handover" />
    <bpmn:sequenceFlow id="f-prepared-distribute" sourceRef="prepared" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-handover-done" sourceRef="handover" targetRef="done" />
    <bpmn:sequenceFlow id="f-distribute-done" sourceRef="distribute" targetRef="done" />
    <bpmn:sequenceFlow id="f-done-conduct" sourceRef="done" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-finished" sourceRef="conduct" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
