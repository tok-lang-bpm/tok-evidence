tok 1.0 "Court hearing file preparation"

pool court "Court"
  lane registry "Court registry"
    start morning "Morning of the court hearing"
    task check "Check the files yet to be processed"
    xor missing "Are some files missing?"
    task search "Initiate a search for the missing files"
    task track "Physically track the files to the intended location"
    xor ready "Files ready"
    and prepared
    task handover "Hand the files to the Associate"
    task distribute "Distribute the Judge's Lawlist to the relevant people"
    and done
    task conduct "Conduct the directions hearings"
    end finished "Directions hearings conducted"

flow morning -> check -> missing
flow missing -> search "yes"
flow missing -> track "no" default
flow search -> ready
flow track -> ready
flow ready -> prepared
flow prepared -> handover
flow prepared -> distribute
flow handover -> done
flow distribute -> done
flow done -> conduct -> finished
