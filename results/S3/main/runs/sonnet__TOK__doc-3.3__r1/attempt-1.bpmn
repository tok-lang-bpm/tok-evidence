<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="officer" name="Claims officer">
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="registered" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="write" name="Write a settlement recommendation" />
    <bpmn:task id="check" name="Check the recommendation" />
    <bpmn:exclusiveGateway id="verdict" name="Claim OK?" />
    <bpmn:endEvent id="proceeds" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-registered-examine" sourceRef="registered" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-write" sourceRef="examine" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-check" sourceRef="write" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-verdict" sourceRef="check" targetRef="verdict" />
    <bpmn:sequenceFlow id="f-verdict-proceeds" name="OK" sourceRef="verdict" targetRef="proceeds" />
    <bpmn:sequenceFlow id="f-verdict-write" name="Not OK" sourceRef="verdict" targetRef="write" />
  </bpmn:process>
</bpmn:definitions>
