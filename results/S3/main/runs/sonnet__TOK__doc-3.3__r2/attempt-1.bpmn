<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="officer" name="Claims officer">
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="registered" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="recommend" name="Write a settlement recommendation" />
    <bpmn:task id="check" name="Check the recommendation" />
    <bpmn:exclusiveGateway id="ok" name="Claim OK?" default="f-ok-recommend" />
    <bpmn:endEvent id="proceed" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-registered-examine" sourceRef="registered" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-recommend" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-check" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-proceed" name="OK" sourceRef="ok" targetRef="proceed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ok = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-recommend" name="Not OK" sourceRef="ok" targetRef="recommend" />
  </bpmn:process>
</bpmn:definitions>
