<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Incoming mail handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Incoming mail handling" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="unit" name="Mail Processing Unit">
        <bpmn:flowNodeRef>daily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="clerk" name="Mail Clerk">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>group</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="daily" name="Daily mail collection">
      <bpmn:timerEventDefinition id="daily-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="collect" name="Collect the mail from the party" />
    <bpmn:task id="sort" name="Sort the unopened mail into business areas" />
    <bpmn:task id="distribute" name="Distribute the mail" />
    <bpmn:task id="open" name="Open the mail" />
    <bpmn:task id="group" name="Sort the mail into groups for distribution" />
    <bpmn:task id="register" name="Register the mail in the incoming Mail Register" />
    <bpmn:task id="quality" name="Perform a quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="compile" name="Compile a list of requisition" />
    <bpmn:task id="sendback" name="Send the list of requisition back to the party" />
    <bpmn:task id="capture" name="Capture the matter details" />
    <bpmn:task id="provide" name="Provide the matter details to the Cashier" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="envelope" name="Put the receipt and copied documents into an envelope" />
    <bpmn:task id="post" name="Post the envelope to the party" />
    <bpmn:parallelGateway id="merge" />
    <bpmn:endEvent id="rejected" name="Mail rejected" />
    <bpmn:endEvent id="done" name="Mail processed" />
    <bpmn:task id="fees" name="Take the applicable fees" />
    <bpmn:task id="details" name="Capture the Party Details" />
    <bpmn:task id="print" name="Print the Physical Court File" />
    <bpmn:sequenceFlow id="f-daily-collect" sourceRef="daily" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sort" sourceRef="collect" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-distribute" sourceRef="sort" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-open" sourceRef="distribute" targetRef="open" />
    <bpmn:sequenceFlow id="f-open-group" sourceRef="open" targetRef="group" />
    <bpmn:sequenceFlow id="f-group-register" sourceRef="group" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-quality" sourceRef="register" targetRef="quality" />
    <bpmn:sequenceFlow id="f-quality-compliant" sourceRef="quality" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-compile" name="no" sourceRef="compliant" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compliant-capture" name="yes" sourceRef="compliant" targetRef="capture" />
    <bpmn:sequenceFlow id="f-compile-sendback" sourceRef="compile" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-rejected" sourceRef="sendback" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-capture-provide" sourceRef="capture" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-fees" sourceRef="provide" targetRef="fees" />
    <bpmn:sequenceFlow id="f-fees-split" sourceRef="fees" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-envelope" sourceRef="split" targetRef="envelope" />
    <bpmn:sequenceFlow id="f-envelope-post" sourceRef="envelope" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-merge" sourceRef="post" targetRef="merge" />
    <bpmn:sequenceFlow id="f-split-details" sourceRef="split" targetRef="details" />
    <bpmn:sequenceFlow id="f-details-print" sourceRef="details" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-merge" sourceRef="print" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-done" sourceRef="merge" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
