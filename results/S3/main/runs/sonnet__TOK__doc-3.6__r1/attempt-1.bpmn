<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims Notification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Returned_forms" name="Returned forms" />
  <bpmn:message id="Message_Updated_forms" name="Updated forms" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claims Notification" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="handler" name="Claims handler">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informrej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendsimple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendcomplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinforms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getforms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkforms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informupd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getupdated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Claims Management system">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Claim received" />
    <bpmn:task id="checkins" name="Check whether the claimant is insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" />
    <bpmn:task id="informrej" name="Inform the claimant that the claim must be rejected" />
    <bpmn:endEvent id="rejected" name="Claim rejected" />
    <bpmn:task id="evaluate" name="Evaluate the severity of the claim" />
    <bpmn:exclusiveGateway id="severity" name="Simple or complex claim?" />
    <bpmn:task id="sendsimple" name="Send simple claim forms to the claimant" />
    <bpmn:task id="sendcomplex" name="Send complex claim forms to the claimant" />
    <bpmn:exclusiveGateway id="joinforms" />
    <bpmn:receiveTask id="getforms" name="Receive the returned forms" messageRef="Message_Returned_forms" />
    <bpmn:task id="checkforms" name="Check the forms for completeness" />
    <bpmn:exclusiveGateway id="complete" name="Forms complete?" />
    <bpmn:task id="informupd" name="Inform the claimant to update the forms" />
    <bpmn:receiveTask id="getupdated" name="Receive the updated forms" messageRef="Message_Updated_forms" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:endEvent id="done" name="Claim registered" />
    <bpmn:sequenceFlow id="f-received-checkins" sourceRef="received" targetRef="checkins" />
    <bpmn:sequenceFlow id="f-checkins-insured" sourceRef="checkins" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-informrej" name="no" sourceRef="insured" targetRef="informrej" />
    <bpmn:sequenceFlow id="f-insured-evaluate" name="yes" sourceRef="insured" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-informrej-rejected" sourceRef="informrej" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-evaluate-severity" sourceRef="evaluate" targetRef="severity" />
    <bpmn:sequenceFlow id="f-severity-sendsimple" name="simple" sourceRef="severity" targetRef="sendsimple" />
    <bpmn:sequenceFlow id="f-severity-sendcomplex" name="complex" sourceRef="severity" targetRef="sendcomplex" />
    <bpmn:sequenceFlow id="f-sendsimple-joinforms" sourceRef="sendsimple" targetRef="joinforms" />
    <bpmn:sequenceFlow id="f-sendcomplex-joinforms" sourceRef="sendcomplex" targetRef="joinforms" />
    <bpmn:sequenceFlow id="f-joinforms-getforms" sourceRef="joinforms" targetRef="getforms" />
    <bpmn:sequenceFlow id="f-getforms-checkforms" sourceRef="getforms" targetRef="checkforms" />
    <bpmn:sequenceFlow id="f-checkforms-complete" sourceRef="checkforms" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-register" name="yes" sourceRef="complete" targetRef="register" />
    <bpmn:sequenceFlow id="f-complete-informupd" name="no" sourceRef="complete" targetRef="informupd" />
    <bpmn:sequenceFlow id="f-register-done" sourceRef="register" targetRef="done" />
    <bpmn:sequenceFlow id="f-informupd-getupdated" sourceRef="informupd" targetRef="getupdated" />
    <bpmn:sequenceFlow id="f-getupdated-checkforms" sourceRef="getupdated" targetRef="checkforms" />
  </bpmn:process>
</bpmn:definitions>
