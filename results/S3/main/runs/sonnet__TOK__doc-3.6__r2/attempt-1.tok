tok 1.0 "Claims notification"

pool org "Organization"
  lane handling "Claims handling"
    start received "Claim received"
    task checkins "Check whether the claimant is insured"
    xor insured "Claimant insured?"
    task informrej "Inform the claimant that the claim must be rejected"
    end rejected "Claim rejected"
    task evaluate "Evaluate the severity of the claim"
    xor severity "Simple or complex claim?"
    task sendsimple "Send the simple claim forms to the claimant"
    task sendcomplex "Send the complex claim forms to the claimant"
    xor formsent
    task receive "Receive the returned forms"
    task checkforms "Check the forms for completeness"
    xor complete "Forms complete?"
    task register "Register the claim in the Claims Management system"
    end registered "Claim registered"
    task informupd "Inform the claimant to update the forms"
    task receiveupd "Receive the updated forms"

flow received -> checkins -> insured
flow insured -> informrej "no"
flow informrej -> rejected
flow insured -> evaluate "yes"
flow evaluate -> severity
flow severity -> sendsimple "simple"
flow severity -> sendcomplex "complex"
flow sendsimple -> formsent
flow sendcomplex -> formsent
flow formsent -> receive -> checkforms -> complete
flow complete -> register "yes"
flow register -> registered
flow complete -> informupd "no"
flow informupd -> receiveupd -> checkforms
