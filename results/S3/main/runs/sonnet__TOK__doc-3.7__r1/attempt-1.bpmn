<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Car accident claim handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="clerk" name="Claims clerk">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handler" name="Claims handler">
        <bpmn:flowNodeRef>estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dms" name="Document Management system" />
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Car accident claim received" />
    <bpmn:task id="search" name="Search the Police Report in the Police Report database" />
    <bpmn:task id="file" name="Put the Police Report in a file together with the Claim Documentation" />
    <bpmn:task id="estimate" name="Calculate the initial claim estimate" />
    <bpmn:task id="plan" name="Create the Action Plan based on the Action Plan Checklist">
      <bpmn:ioSpecification id="plan-io">
        <bpmn:dataInput id="plan-in-1" name="Action Plan Checklist" />
        <bpmn:inputSet id="plan-inputs">
          <bpmn:dataInputRefs>plan-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="plan-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="plan-dia-1">
        <bpmn:sourceRef>checklist</bpmn:sourceRef>
        <bpmn:targetRef>plan-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="negotiate" name="Negotiate a settlement on the claim estimate" />
    <bpmn:task id="inform" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="done" name="Claim handled" />
    <bpmn:sequenceFlow id="f-begin-search" sourceRef="begin" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-file" sourceRef="search" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-estimate" sourceRef="file" targetRef="estimate" />
    <bpmn:sequenceFlow id="f-estimate-plan" sourceRef="estimate" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-negotiate" sourceRef="plan" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-inform" sourceRef="negotiate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-done" sourceRef="inform" targetRef="done" />
    <bpmn:dataObject id="checklist-object" name="Action Plan Checklist" />
    <bpmn:dataObjectReference id="checklist" name="Action Plan Checklist" dataObjectRef="checklist-object" />
  </bpmn:process>
</bpmn:definitions>
