<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car insurance claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car insurance claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>check_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_letter</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Claim needed" />
    <bpmn:task id="submit" name="Submit the claim with documentation" />
    <bpmn:task id="receive_letter" name="Receive the letter" />
    <bpmn:endEvent id="done" name="Claim process complete" />
    <bpmn:task id="check_docs" name="Check the documents for completeness" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="check_ins" name="Check the insurance" />
    <bpmn:task id="assess" name="Perform the assessment" />
    <bpmn:exclusiveGateway id="positive" name="Assessment positive?" />
    <bpmn:task id="phone" name="Phone the garage to authorise the repairs" />
    <bpmn:task id="schedule" name="Schedule the payment" />
    <bpmn:task id="reject" name="Reject the claim" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="send_letter" name="Send a letter to the customer" />
    <bpmn:sequenceFlow id="f-started-submit" sourceRef="started" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check_docs" sourceRef="submit" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f-check_docs-register" sourceRef="check_docs" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-check_ins" sourceRef="register" targetRef="check_ins" />
    <bpmn:sequenceFlow id="f-check_ins-assess" sourceRef="check_ins" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-positive" sourceRef="assess" targetRef="positive" />
    <bpmn:sequenceFlow id="f-positive-phone" name="yes" sourceRef="positive" targetRef="phone" />
    <bpmn:sequenceFlow id="f-positive-reject" name="no" sourceRef="positive" targetRef="reject" />
    <bpmn:sequenceFlow id="f-phone-schedule" sourceRef="phone" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-merge" sourceRef="schedule" targetRef="merge" />
    <bpmn:sequenceFlow id="f-reject-merge" sourceRef="reject" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-send_letter" sourceRef="merge" targetRef="send_letter" />
    <bpmn:sequenceFlow id="f-send_letter-receive_letter" sourceRef="send_letter" targetRef="receive_letter" />
    <bpmn:sequenceFlow id="f-receive_letter-done" sourceRef="receive_letter" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
