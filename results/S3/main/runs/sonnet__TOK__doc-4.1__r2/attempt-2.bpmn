<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="secretary" name="Secretarial office">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putthrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isnew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storefile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passcards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivecopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addcopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filemerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typetapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addtapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statuslist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>providelist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nurse" name="Nursing officer">
        <bpmn:flowNodeRef>fullinquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teamleader" name="Team-leader">
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first" name="First intaker">
        <bpmn:flowNodeRef>planfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copynotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addchecklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second" name="Second intaker">
        <bpmn:flowNodeRef>plansecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dictate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="notice" name="Notice by telephone received" />
    <bpmn:task id="inquire" name="Inquire after the name and residence of the patient" />
    <bpmn:task id="putthrough" name="Put the doctor through to the nursing officer" />
    <bpmn:task id="storeinfo" name="Store the information in the information system" />
    <bpmn:task id="printinfo" name="Print the information" />
    <bpmn:exclusiveGateway id="isnew" name="New patient?" default="f-isnew-newmerge" />
    <bpmn:task id="createfile" name="Create a patient file" />
    <bpmn:exclusiveGateway id="newmerge" />
    <bpmn:task id="storefile" name="Store the registration form and the print in the patient file" />
    <bpmn:task id="cards" name="Produce two registration cards" />
    <bpmn:task id="addlist" name="Add the patient to the list of new notices" />
    <bpmn:task id="storeassign" name="Store the assignment in the information system" />
    <bpmn:task id="passcards" name="Pass the registration cards to the first and second intaker" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="needfile" name="Medical file required?" default="f-needfile-filemerge" />
    <bpmn:task id="letter" name="Prepare and send a letter to the family doctor" />
    <bpmn:task id="receivecopy" name="Receive the copy of the medical file" />
    <bpmn:task id="informsecond" name="Inform the second intaker" />
    <bpmn:task id="addcopy" name="Add the copy to the patient file" />
    <bpmn:exclusiveGateway id="filemerge" />
    <bpmn:task id="typetapes" name="Type out the tapes" />
    <bpmn:task id="addtapes" name="Add the typed information to the patient file" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="statuslist" name="Put the patient on the list of patients that reach this status" />
    <bpmn:task id="providelist" name="Provide the team-leader with the list of patients" />
    <bpmn:endEvent id="done" name="Intake procedure ended" />
    <bpmn:task id="fullinquiry" name="Make a full inquiry into the mental, health and social state of the patient" />
    <bpmn:task id="record" name="Record the information on a registration form" />
    <bpmn:task id="handin" name="Hand in the registration form at the secretarial office" />
    <bpmn:task id="assign" name="Assign the new patients to the first and second intaker" />
    <bpmn:task id="assignlist" name="Record the assignments on an assignment list" />
    <bpmn:task id="determine" name="Determine whether the medical file is required" />
    <bpmn:task id="handlist" name="Hand the assignment list to the secretarial office" />
    <bpmn:task id="plan" name="Formulate the treatment plan" />
    <bpmn:task id="planfirst" name="Plan a meeting with the patient" />
    <bpmn:task id="examine" name="Examine the patient using the standard checklist" />
    <bpmn:task id="notes" name="Register additional observations in a personal notebook" />
    <bpmn:task id="copynotes" name="Put a copy of the notes in the patient file" />
    <bpmn:task id="addchecklist" name="Add the standard checklist to the patient file" />
    <bpmn:task id="plansecond" name="Plan the first meeting with the patient" />
    <bpmn:task id="meet" name="Hold the meeting with the patient" />
    <bpmn:task id="dictate" name="Record the observations with a dictaphone" />
    <bpmn:sequenceFlow id="f-notice-inquire" sourceRef="notice" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-putthrough" sourceRef="inquire" targetRef="putthrough" />
    <bpmn:sequenceFlow id="f-putthrough-fullinquiry" sourceRef="putthrough" targetRef="fullinquiry" />
    <bpmn:sequenceFlow id="f-fullinquiry-record" sourceRef="fullinquiry" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-handin" sourceRef="record" targetRef="handin" />
    <bpmn:sequenceFlow id="f-handin-storeinfo" sourceRef="handin" targetRef="storeinfo" />
    <bpmn:sequenceFlow id="f-storeinfo-printinfo" sourceRef="storeinfo" targetRef="printinfo" />
    <bpmn:sequenceFlow id="f-printinfo-isnew" sourceRef="printinfo" targetRef="isnew" />
    <bpmn:sequenceFlow id="f-isnew-createfile" name="yes" sourceRef="isnew" targetRef="createfile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">newPatient = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-isnew-newmerge" name="no" sourceRef="isnew" targetRef="newmerge" />
    <bpmn:sequenceFlow id="f-createfile-newmerge" sourceRef="createfile" targetRef="newmerge" />
    <bpmn:sequenceFlow id="f-newmerge-storefile" sourceRef="newmerge" targetRef="storefile" />
    <bpmn:sequenceFlow id="f-storefile-cards" sourceRef="storefile" targetRef="cards" />
    <bpmn:sequenceFlow id="f-cards-addlist" sourceRef="cards" targetRef="addlist" />
    <bpmn:sequenceFlow id="f-addlist-assign" sourceRef="addlist" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-assignlist" sourceRef="assign" targetRef="assignlist" />
    <bpmn:sequenceFlow id="f-assignlist-determine" sourceRef="assignlist" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-handlist" sourceRef="determine" targetRef="handlist" />
    <bpmn:sequenceFlow id="f-handlist-storeassign" sourceRef="handlist" targetRef="storeassign" />
    <bpmn:sequenceFlow id="f-storeassign-passcards" sourceRef="storeassign" targetRef="passcards" />
    <bpmn:sequenceFlow id="f-passcards-split" sourceRef="passcards" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-needfile" sourceRef="split" targetRef="needfile" />
    <bpmn:sequenceFlow id="f-split-planfirst" sourceRef="split" targetRef="planfirst" />
    <bpmn:sequenceFlow id="f-needfile-letter" name="yes" sourceRef="needfile" targetRef="letter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">medicalFileRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-needfile-filemerge" name="no" sourceRef="needfile" targetRef="filemerge" />
    <bpmn:sequenceFlow id="f-letter-receivecopy" sourceRef="letter" targetRef="receivecopy" />
    <bpmn:sequenceFlow id="f-receivecopy-informsecond" sourceRef="receivecopy" targetRef="informsecond" />
    <bpmn:sequenceFlow id="f-informsecond-addcopy" sourceRef="informsecond" targetRef="addcopy" />
    <bpmn:sequenceFlow id="f-addcopy-filemerge" sourceRef="addcopy" targetRef="filemerge" />
    <bpmn:sequenceFlow id="f-filemerge-plansecond" sourceRef="filemerge" targetRef="plansecond" />
    <bpmn:sequenceFlow id="f-plansecond-meet" sourceRef="plansecond" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-dictate" sourceRef="meet" targetRef="dictate" />
    <bpmn:sequenceFlow id="f-dictate-typetapes" sourceRef="dictate" targetRef="typetapes" />
    <bpmn:sequenceFlow id="f-typetapes-addtapes" sourceRef="typetapes" targetRef="addtapes" />
    <bpmn:sequenceFlow id="f-addtapes-join" sourceRef="addtapes" targetRef="join" />
    <bpmn:sequenceFlow id="f-planfirst-examine" sourceRef="planfirst" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-notes" sourceRef="examine" targetRef="notes" />
    <bpmn:sequenceFlow id="f-notes-copynotes" sourceRef="notes" targetRef="copynotes" />
    <bpmn:sequenceFlow id="f-copynotes-addchecklist" sourceRef="copynotes" targetRef="addchecklist" />
    <bpmn:sequenceFlow id="f-addchecklist-join" sourceRef="addchecklist" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-statuslist" sourceRef="join" targetRef="statuslist" />
    <bpmn:sequenceFlow id="f-statuslist-providelist" sourceRef="statuslist" targetRef="providelist" />
    <bpmn:sequenceFlow id="f-providelist-plan" sourceRef="providelist" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-done" sourceRef="plan" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
