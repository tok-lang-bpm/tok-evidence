<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Vacation request needed" />
    <bpmn:task id="submit" name="Submit the vacation request" />
    <bpmn:task id="review" name="Review the rejection reasons" />
    <bpmn:endEvent id="reviewed" name="Request returned to employee" />
    <bpmn:task id="receive" name="Receive the vacation request" />
    <bpmn:exclusiveGateway id="decision" name="Request approved?" />
    <bpmn:task id="complete" name="Complete the management procedures" />
    <bpmn:endEvent id="done" name="Vacation request handled" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-receive" sourceRef="submit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decision" sourceRef="receive" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-review" name="no" sourceRef="decision" targetRef="review" />
    <bpmn:sequenceFlow id="f-decision-complete" name="yes" sourceRef="decision" targetRef="complete" />
    <bpmn:sequenceFlow id="f-review-reviewed" sourceRef="review" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-complete-done" sourceRef="complete" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
