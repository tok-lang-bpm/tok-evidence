<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Office Supply Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Office Supply Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="purchase" name="Purchase department">
        <bpmn:flowNodeRef>quotations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyreject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifychange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyapprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Office supplies needed" />
    <bpmn:task id="submit" name="Submit the office supply request" />
    <bpmn:task id="review" name="Review the comments for the change request" />
    <bpmn:task id="evaluate" name="Evaluate the request" />
    <bpmn:exclusiveGateway id="decision" name="Decision?" />
    <bpmn:subProcess id="quotations" name="Make quotations">
      <bpmn:startEvent id="qstart" name="Quotations needed" />
      <bpmn:task id="qrequest" name="Request quotations from vendors" />
      <bpmn:task id="qcollect" name="Collect the quotations" />
      <bpmn:endEvent id="qend" name="Quotations made" />
      <bpmn:sequenceFlow id="f-qstart-qrequest" sourceRef="qstart" targetRef="qrequest" />
      <bpmn:sequenceFlow id="f-qrequest-qcollect" sourceRef="qrequest" targetRef="qcollect" />
      <bpmn:sequenceFlow id="f-qcollect-qend" sourceRef="qcollect" targetRef="qend" />
    </bpmn:subProcess>
    <bpmn:task id="select" name="Select a vendor" />
    <bpmn:exclusiveGateway id="valid" name="Vendor valid in the system?" />
    <bpmn:task id="register" name="Register the request" />
    <bpmn:task id="notifyreject" name="Send the rejection notification" />
    <bpmn:task id="notifychange" name="Send the change request notification" />
    <bpmn:task id="notifyapprove" name="Send the approval notification" />
    <bpmn:task id="order" name="Generate and send the purchase order" />
    <bpmn:parallelGateway id="wait" />
    <bpmn:task id="delivery" name="Wait for the product to be delivered" />
    <bpmn:task id="invoice" name="Wait for the invoice to be received" />
    <bpmn:parallelGateway id="received" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-evaluate" sourceRef="register" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-decision" sourceRef="evaluate" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-notifyreject" name="rejected" sourceRef="decision" targetRef="notifyreject" />
    <bpmn:sequenceFlow id="f-decision-notifychange" name="change required" sourceRef="decision" targetRef="notifychange" />
    <bpmn:sequenceFlow id="f-decision-notifyapprove" name="approved" sourceRef="decision" targetRef="notifyapprove" />
    <bpmn:sequenceFlow id="f-notifyreject-rejected" sourceRef="notifyreject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-notifychange-review" sourceRef="notifychange" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-submit" sourceRef="review" targetRef="submit" />
    <bpmn:sequenceFlow id="f-notifyapprove-quotations" sourceRef="notifyapprove" targetRef="quotations" />
    <bpmn:sequenceFlow id="f-quotations-select" sourceRef="quotations" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-valid" sourceRef="select" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-select" name="no" sourceRef="valid" targetRef="select" />
    <bpmn:sequenceFlow id="f-valid-order" name="yes" sourceRef="valid" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-wait" sourceRef="order" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-delivery" sourceRef="wait" targetRef="delivery" />
    <bpmn:sequenceFlow id="f-wait-invoice" sourceRef="wait" targetRef="invoice" />
    <bpmn:sequenceFlow id="f-delivery-received" sourceRef="delivery" targetRef="received" />
    <bpmn:sequenceFlow id="f-invoice-received" sourceRef="invoice" targetRef="received" />
    <bpmn:sequenceFlow id="f-received-completed" sourceRef="received" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
