<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense report handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Payment_confirmation" name="Payment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Expense report handling" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>editMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>reviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment" name="Payment system">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase the product or service" />
    <bpmn:task id="submit" name="Submit the expense report" />
    <bpmn:exclusiveGateway id="editMerge" />
    <bpmn:task id="edit" name="Edit the expense report" />
    <bpmn:exclusiveGateway id="reviewMerge" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:task id="check" name="Check the receipts against the list of items" />
    <bpmn:exclusiveGateway id="inOrder" name="All in order?" />
    <bpmn:task id="sendback" name="Send the report back to the employee" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:serviceTask id="pay" name="Link to the payment system" />
    <bpmn:receiveTask id="confirmation" name="Wait for the payment confirmation" messageRef="Message_Payment_confirmation" />
    <bpmn:endEvent id="done" name="Expenses paid" />
    <bpmn:sequenceFlow id="f-needed-purchase" sourceRef="needed" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-reviewMerge" sourceRef="submit" targetRef="reviewMerge" />
    <bpmn:sequenceFlow id="f-reviewMerge-review" sourceRef="reviewMerge" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approved" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-check" name="yes" sourceRef="approved" targetRef="check" />
    <bpmn:sequenceFlow id="f-approved-editMerge" name="no" sourceRef="approved" targetRef="editMerge" />
    <bpmn:sequenceFlow id="f-check-inOrder" sourceRef="check" targetRef="inOrder" />
    <bpmn:sequenceFlow id="f-inOrder-accept" name="yes" sourceRef="inOrder" targetRef="accept" />
    <bpmn:sequenceFlow id="f-inOrder-sendback" name="no" sourceRef="inOrder" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-editMerge" sourceRef="sendback" targetRef="editMerge" />
    <bpmn:sequenceFlow id="f-editMerge-edit" sourceRef="editMerge" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-reviewMerge" sourceRef="edit" targetRef="reviewMerge" />
    <bpmn:sequenceFlow id="f-accept-pay" sourceRef="accept" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-confirmation" sourceRef="pay" targetRef="confirmation" />
    <bpmn:sequenceFlow id="f-confirmation-done" sourceRef="confirmation" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
