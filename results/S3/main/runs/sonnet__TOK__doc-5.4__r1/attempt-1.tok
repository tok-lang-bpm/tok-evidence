tok 1.0 "Expense report handling"

pool company "Company"
  lane employee "Employee"
    start needed "Product or service required"
    task purchase "Purchase the product or service"
    task submit "Submit the expense report"
    xor editMerge
    task edit "Edit the expense report"
  lane supervisor "Supervisor"
    xor reviewMerge
    task review "Review the expense report"
    xor approved "Report approved?"
  lane treasurer "Treasurer"
    task check "Check the receipts against the list of items"
    xor inOrder "All in order?"
    task sendback "Send the report back to the employee"
    task accept "Accept the expenses for processing"
  lane payment "Payment system"
    service pay "Link to the payment system"
    receive confirmation "Wait for the payment confirmation" message="Payment confirmation"
    end done "Expenses paid"

flow needed -> purchase -> submit -> reviewMerge -> review -> approved
flow approved -> check "yes"
flow approved -> editMerge "no"
flow check -> inOrder
flow inOrder -> accept "yes"
flow inOrder -> sendback "no"
flow sendback -> editMerge
flow editMerge -> edit -> reviewMerge
flow accept -> pay -> confirmation -> done
