<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="ACME invoice processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="ACME invoice processing" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consulting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consultdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendagain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardcomm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Cost center manager">
        <bpmn:flowNodeRef>mgrin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>markap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial manager">
        <bpmn:flowNodeRef>auditin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amountdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returncopy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>boardcheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received on paper or fax" />
    <bpmn:task id="receive" name="Receive invoice in central inbox" />
    <bpmn:task id="inspect" name="Inspect invoice visually" />
    <bpmn:task id="forward" name="Forward invoice to accounting employee" />
    <bpmn:task id="identify" name="Identify charging supplier" />
    <bpmn:task id="create" name="Create new invoice instance" />
    <bpmn:task id="checkitems" name="Check invoice items" />
    <bpmn:task id="note" name="Note cost center and cost center manager for each position on docket" />
    <bpmn:task id="sendfirst" name="Send docket and copy of invoice to first cost center manager" />
    <bpmn:task id="clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="consult" name="Consultation of cost center managers necessary?" default="f-consult-consultdone" />
    <bpmn:task id="consulting" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="consultdone" />
    <bpmn:task id="sendagain" name="Send copy of invoice to cost center managers again" />
    <bpmn:task id="forwardcomm" name="Forward copy of invoice to commercial manager" />
    <bpmn:task id="resolve" name="Resolve complaint with supplier" />
    <bpmn:task id="instruct" name="Give payment instructions" />
    <bpmn:task id="close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="paid" name="Invoice processed" />
    <bpmn:exclusiveGateway id="mgrin" />
    <bpmn:task id="review" name="Review content for accuracy" />
    <bpmn:exclusiveGateway id="accurate" name="Everything in order?" default="f-accurate-reject" />
    <bpmn:task id="markap" name="Note AP code on docket" />
    <bpmn:exclusiveGateway id="more" name="More cost center managers on the list?" default="f-more-forwardcomm" />
    <bpmn:task id="reject" name="Reject AP with note and explanatory statement on docket" />
    <bpmn:exclusiveGateway id="auditin" />
    <bpmn:task id="audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint?" default="f-complaint-approve" />
    <bpmn:task id="approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="amount" name="Bill amount exceeds EUR 20?" default="f-amount-amountdone" />
    <bpmn:exclusiveGateway id="amountdone" />
    <bpmn:task id="returncopy" name="Return copy of invoice and docket to accounting employee in signature file" />
    <bpmn:task id="boardcheck" name="Check invoice again" />
    <bpmn:sequenceFlow id="f-received-receive" sourceRef="received" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-identify" sourceRef="forward" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-checkitems" sourceRef="create" targetRef="checkitems" />
    <bpmn:sequenceFlow id="f-checkitems-note" sourceRef="checkitems" targetRef="note" />
    <bpmn:sequenceFlow id="f-note-sendfirst" sourceRef="note" targetRef="sendfirst" />
    <bpmn:sequenceFlow id="f-sendfirst-mgrin" sourceRef="sendfirst" targetRef="mgrin" />
    <bpmn:sequenceFlow id="f-mgrin-review" sourceRef="mgrin" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accurate" sourceRef="review" targetRef="accurate" />
    <bpmn:sequenceFlow id="f-accurate-markap" name="yes" sourceRef="accurate" targetRef="markap" />
    <bpmn:sequenceFlow id="f-accurate-reject" name="no" sourceRef="accurate" targetRef="reject" />
    <bpmn:sequenceFlow id="f-markap-more" sourceRef="markap" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-mgrin" name="yes" sourceRef="more" targetRef="mgrin" />
    <bpmn:sequenceFlow id="f-more-forwardcomm" name="no" sourceRef="more" targetRef="forwardcomm" />
    <bpmn:sequenceFlow id="f-reject-clarify" sourceRef="reject" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consult" sourceRef="clarify" targetRef="consult" />
    <bpmn:sequenceFlow id="f-consult-consulting" name="yes" sourceRef="consult" targetRef="consulting" />
    <bpmn:sequenceFlow id="f-consult-consultdone" name="no" sourceRef="consult" targetRef="consultdone" />
    <bpmn:sequenceFlow id="f-consulting-consultdone" sourceRef="consulting" targetRef="consultdone" />
    <bpmn:sequenceFlow id="f-consultdone-sendagain" sourceRef="consultdone" targetRef="sendagain" />
    <bpmn:sequenceFlow id="f-sendagain-mgrin" sourceRef="sendagain" targetRef="mgrin" />
    <bpmn:sequenceFlow id="f-forwardcomm-auditin" sourceRef="forwardcomm" targetRef="auditin" />
    <bpmn:sequenceFlow id="f-auditin-audit" sourceRef="auditin" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve" name="yes" sourceRef="complaint" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-auditin" sourceRef="resolve" targetRef="auditin" />
    <bpmn:sequenceFlow id="f-complaint-approve" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-amount" sourceRef="approve" targetRef="amount" />
    <bpmn:sequenceFlow id="f-amount-boardcheck" name="yes" sourceRef="amount" targetRef="boardcheck" />
    <bpmn:sequenceFlow id="f-amount-amountdone" name="no" sourceRef="amount" targetRef="amountdone" />
    <bpmn:sequenceFlow id="f-boardcheck-amountdone" sourceRef="boardcheck" targetRef="amountdone" />
    <bpmn:sequenceFlow id="f-amountdone-returncopy" sourceRef="amountdone" targetRef="returncopy" />
    <bpmn:sequenceFlow id="f-returncopy-instruct" sourceRef="returncopy" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-close" sourceRef="instruct" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-paid" sourceRef="close" targetRef="paid" />
  </bpmn:process>
</bpmn:definitions>
