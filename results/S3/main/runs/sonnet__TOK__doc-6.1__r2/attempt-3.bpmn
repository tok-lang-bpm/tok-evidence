<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Invoice approval at ACME AG" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice approval at ACME AG" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consulting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendagain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tocommercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Cost center manager">
        <bpmn:flowNodeRef>reviewin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>markap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial manager">
        <bpmn:flowNodeRef>auditin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnsig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>boardcheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received on paper or fax" />
    <bpmn:task id="inbox" name="Receive the invoice in the central inbox" />
    <bpmn:task id="inspect" name="Inspect the invoice visually" />
    <bpmn:task id="forward" name="Forward the invoice to an accounting employee" />
    <bpmn:task id="identify" name="Identify the charging supplier" />
    <bpmn:task id="create" name="Create a new instance in ACME Financial Accounting" />
    <bpmn:task id="checkitems" name="Check the invoice items" />
    <bpmn:task id="note" name="Note the cost centers and cost center managers on the docket" />
    <bpmn:task id="sendfirst" name="Send the docket and the copy of the invoice to the first cost center manager" />
    <bpmn:task id="sendback" name="Send the copy of the invoice back to accounting" />
    <bpmn:task id="clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:exclusiveGateway id="consult" name="Consultation with cost center managers needed?" default="f-consult-sendagain" />
    <bpmn:task id="consulting" name="Consult the cost center managers by telephone or e-mail" />
    <bpmn:task id="sendagain" name="Send the copy of the invoice to the cost center managers again" />
    <bpmn:task id="tocommercial" name="Forward the copy of the invoice to the commercial manager" />
    <bpmn:task id="resolve" name="Resolve the complaint with the supplier" />
    <bpmn:task id="instruct" name="Give payment instructions" />
    <bpmn:task id="close" name="Close the instance in ACME Financial Accounting" />
    <bpmn:endEvent id="done" name="Invoice processed" />
    <bpmn:exclusiveGateway id="reviewin" />
    <bpmn:task id="review" name="Review the content of the invoice for accuracy" />
    <bpmn:exclusiveGateway id="accurate" name="Everything in order?" default="f-accurate-reject" />
    <bpmn:task id="markap" name="Note the code AP on the docket" />
    <bpmn:task id="returnmail" name="Return the copy of the invoice to the internal mail" />
    <bpmn:exclusiveGateway id="allap" name="All positions marked AP?" default="f-allap-reviewin" />
    <bpmn:task id="reject" name="Reject the AP with a note and explanatory statement on the docket" />
    <bpmn:exclusiveGateway id="auditin" />
    <bpmn:task id="audit" name="Make the commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint during the audit?" default="f-complaint-approve" />
    <bpmn:task id="approve" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="amount" name="Bill amount exceeds EUR 20?" default="f-amount-payjoin" />
    <bpmn:exclusiveGateway id="payjoin" />
    <bpmn:task id="returnsig" name="Return the copy of the invoice and the docket to accounting in the signature file" />
    <bpmn:task id="boardcheck" name="Check the invoice again" />
    <bpmn:sequenceFlow id="f-received-inbox" sourceRef="received" targetRef="inbox" />
    <bpmn:sequenceFlow id="f-inbox-inspect" sourceRef="inbox" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-identify" sourceRef="forward" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-checkitems" sourceRef="create" targetRef="checkitems" />
    <bpmn:sequenceFlow id="f-checkitems-note" sourceRef="checkitems" targetRef="note" />
    <bpmn:sequenceFlow id="f-note-sendfirst" sourceRef="note" targetRef="sendfirst" />
    <bpmn:sequenceFlow id="f-sendfirst-reviewin" sourceRef="sendfirst" targetRef="reviewin" />
    <bpmn:sequenceFlow id="f-reviewin-review" sourceRef="reviewin" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accurate" sourceRef="review" targetRef="accurate" />
    <bpmn:sequenceFlow id="f-accurate-markap" name="yes" sourceRef="accurate" targetRef="markap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">everythingInOrder = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accurate-reject" name="no" sourceRef="accurate" targetRef="reject" />
    <bpmn:sequenceFlow id="f-markap-returnmail" sourceRef="markap" targetRef="returnmail" />
    <bpmn:sequenceFlow id="f-returnmail-allap" sourceRef="returnmail" targetRef="allap" />
    <bpmn:sequenceFlow id="f-allap-reviewin" name="no" sourceRef="allap" targetRef="reviewin" />
    <bpmn:sequenceFlow id="f-allap-tocommercial" name="yes" sourceRef="allap" targetRef="tocommercial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allPositionsAP = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reject-sendback" sourceRef="reject" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-clarify" sourceRef="sendback" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consult" sourceRef="clarify" targetRef="consult" />
    <bpmn:sequenceFlow id="f-consult-consulting" name="yes" sourceRef="consult" targetRef="consulting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">consultationNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-consulting-clarify" sourceRef="consulting" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-consult-sendagain" name="no" sourceRef="consult" targetRef="sendagain" />
    <bpmn:sequenceFlow id="f-sendagain-reviewin" sourceRef="sendagain" targetRef="reviewin" />
    <bpmn:sequenceFlow id="f-tocommercial-auditin" sourceRef="tocommercial" targetRef="auditin" />
    <bpmn:sequenceFlow id="f-auditin-audit" sourceRef="auditin" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve" name="yes" sourceRef="complaint" targetRef="resolve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complaintExists = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-resolve-auditin" sourceRef="resolve" targetRef="auditin" />
    <bpmn:sequenceFlow id="f-complaint-approve" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-amount" sourceRef="approve" targetRef="amount" />
    <bpmn:sequenceFlow id="f-amount-boardcheck" name="yes" sourceRef="amount" targetRef="boardcheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &gt; 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-amount-payjoin" name="no" sourceRef="amount" targetRef="payjoin" />
    <bpmn:sequenceFlow id="f-boardcheck-payjoin" sourceRef="boardcheck" targetRef="payjoin" />
    <bpmn:sequenceFlow id="f-payjoin-returnsig" sourceRef="payjoin" targetRef="returnsig" />
    <bpmn:sequenceFlow id="f-returnsig-instruct" sourceRef="returnsig" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-close" sourceRef="instruct" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-done" sourceRef="close" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
