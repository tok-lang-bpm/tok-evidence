<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_reply" name="Customer reply" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>way</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wayend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>callcust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hugebudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notint</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>won</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>intmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>technical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentsales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>twoweeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callagain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Customer acquisition started" />
    <bpmn:exclusiveGateway id="way" name="How are contact details determined?" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Use personal acquaintance" />
    <bpmn:exclusiveGateway id="wayend" />
    <bpmn:task id="callcust" name="Call the customer" />
    <bpmn:task id="contact" name="Determine the contact person" />
    <bpmn:task id="budget" name="Determine the available budget" />
    <bpmn:task id="askint" name="Ask whether the customer is interested" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="hugebudget" name="Budget huge?" />
    <bpmn:endEvent id="notint" name="Customer left alone" />
    <bpmn:task id="acquire" name="Acquire the customer personally" />
    <bpmn:exclusiveGateway id="won" name="Customer interested now?" />
    <bpmn:endEvent id="lost" name="Customer not acquired" />
    <bpmn:exclusiveGateway id="intmerge" />
    <bpmn:exclusiveGateway id="technical" name="More technical presentation?" />
    <bpmn:task id="presales" name="Give the online presentation (technical)" />
    <bpmn:task id="presentsales" name="Give the online presentation" />
    <bpmn:exclusiveGateway id="presend" />
    <bpmn:eventBasedGateway id="wait" name="Customer contacts us?" />
    <bpmn:intermediateCatchEvent id="back" name="Customer comes back">
      <bpmn:messageEventDefinition id="back-def" messageRef="Message_Customer_reply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="twoweeks" name="2 weeks passed">
      <bpmn:timerEventDefinition id="twoweeks-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callagain" name="Call the customer" />
    <bpmn:exclusiveGateway id="waitend" />
    <bpmn:task id="quote" name="Create the quotation" />
    <bpmn:endEvent id="done" name="Quotation created" />
    <bpmn:sequenceFlow id="f-begin-way" sourceRef="begin" targetRef="way" />
    <bpmn:sequenceFlow id="f-way-buy" name="purchase" sourceRef="way" targetRef="buy" />
    <bpmn:sequenceFlow id="f-way-exhibit" name="exhibition" sourceRef="way" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-way-know" name="acquaintance" sourceRef="way" targetRef="know" />
    <bpmn:sequenceFlow id="f-buy-wayend" sourceRef="buy" targetRef="wayend" />
    <bpmn:sequenceFlow id="f-exhibit-wayend" sourceRef="exhibit" targetRef="wayend" />
    <bpmn:sequenceFlow id="f-know-wayend" sourceRef="know" targetRef="wayend" />
    <bpmn:sequenceFlow id="f-wayend-callcust" sourceRef="wayend" targetRef="callcust" />
    <bpmn:sequenceFlow id="f-callcust-contact" sourceRef="callcust" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact-budget" sourceRef="contact" targetRef="budget" />
    <bpmn:sequenceFlow id="f-budget-askint" sourceRef="budget" targetRef="askint" />
    <bpmn:sequenceFlow id="f-askint-interested" sourceRef="askint" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-intmerge" name="yes" sourceRef="interested" targetRef="intmerge" />
    <bpmn:sequenceFlow id="f-interested-hugebudget" name="no" sourceRef="interested" targetRef="hugebudget" />
    <bpmn:sequenceFlow id="f-hugebudget-acquire" name="yes" sourceRef="hugebudget" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-hugebudget-notint" name="no" sourceRef="hugebudget" targetRef="notint" />
    <bpmn:sequenceFlow id="f-acquire-won" sourceRef="acquire" targetRef="won" />
    <bpmn:sequenceFlow id="f-won-intmerge" name="yes" sourceRef="won" targetRef="intmerge" />
    <bpmn:sequenceFlow id="f-won-lost" name="no" sourceRef="won" targetRef="lost" />
    <bpmn:sequenceFlow id="f-intmerge-technical" sourceRef="intmerge" targetRef="technical" />
    <bpmn:sequenceFlow id="f-technical-presales" name="yes" sourceRef="technical" targetRef="presales" />
    <bpmn:sequenceFlow id="f-technical-presentsales" name="no" sourceRef="technical" targetRef="presentsales" />
    <bpmn:sequenceFlow id="f-presales-presend" sourceRef="presales" targetRef="presend" />
    <bpmn:sequenceFlow id="f-presentsales-presend" sourceRef="presentsales" targetRef="presend" />
    <bpmn:sequenceFlow id="f-presend-wait" sourceRef="presend" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-back" sourceRef="wait" targetRef="back" />
    <bpmn:sequenceFlow id="f-wait-twoweeks" sourceRef="wait" targetRef="twoweeks" />
    <bpmn:sequenceFlow id="f-back-waitend" sourceRef="back" targetRef="waitend" />
    <bpmn:sequenceFlow id="f-twoweeks-callagain" sourceRef="twoweeks" targetRef="callagain" />
    <bpmn:sequenceFlow id="f-callagain-waitend" sourceRef="callagain" targetRef="waitend" />
    <bpmn:sequenceFlow id="f-waitend-quote" sourceRef="waitend" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-done" sourceRef="quote" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
