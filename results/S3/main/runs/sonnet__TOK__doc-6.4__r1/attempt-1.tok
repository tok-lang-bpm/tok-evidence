tok 1.0 "Customer acquisition"

pool company "Company"
  lane marketing "Marketing staff"
    start begin "Customer acquisition started"
    xor way "How are contact details determined?"
    task buy "Buy details for cold calls"
    task exhibit "Participate in exhibitions"
    task know "Use personal acquaintance"
    xor wayend
  lane callcenter "Call center staff"
    task callcust "Call the customer"
    task contact "Determine the contact person"
    task budget "Determine the available budget"
    task askint "Ask whether the customer is interested"
    xor interested "Customer interested?"
    xor hugebudget "Budget huge?"
    end notint "Customer left alone"
  lane head "Head of development"
    task acquire "Acquire the customer personally"
    xor won "Customer interested now?"
    end lost "Customer not acquired"
  lane sales "Sales representative"
    xor intmerge
    xor technical "More technical presentation?"
    task presales "Give the online presentation (technical)"
    task presentsales "Give the online presentation"
    xor presend
    eventgw wait "Customer contacts us?"
    catch back "Customer comes back" message="Customer reply"
    catch twoweeks "2 weeks passed" timer=P14D
    task callagain "Call the customer"
    xor waitend
    task quote "Create the quotation"
    end done "Quotation created"

flow begin -> way
flow way -> buy "purchase"
flow way -> exhibit "exhibition"
flow way -> know "acquaintance"
flow buy -> wayend
flow exhibit -> wayend
flow know -> wayend
flow wayend -> callcust -> contact -> budget -> askint -> interested
flow interested -> intmerge "yes"
flow interested -> hugebudget "no"
flow hugebudget -> acquire "yes"
flow hugebudget -> notint "no"
flow acquire -> won
flow won -> intmerge "yes"
flow won -> lost "no"
flow intmerge -> technical
flow technical -> presales "yes"
flow technical -> presentsales "no"
flow presales -> presend
flow presentsales -> presend
flow presend -> wait
flow wait -> back
flow wait -> twoweeks
flow back -> waitend
flow twoweeks -> callagain -> waitend
flow waitend -> quote -> done
