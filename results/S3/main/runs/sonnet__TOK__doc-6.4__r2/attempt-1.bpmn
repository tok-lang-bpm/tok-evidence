<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_comes_back" name="Customer comes back" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="marketing" name="Marketing">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>how</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales">
        <bpmn:flowNodeRef>presentpre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>technical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentsales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>twoweeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callagain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reacted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Contact details needed" />
    <bpmn:task id="determine" name="Determine contact details of potential customers" />
    <bpmn:exclusiveGateway id="how" name="Which way?" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Use personal contacts" />
    <bpmn:exclusiveGateway id="found" name="Details determined" />
    <bpmn:task id="call" name="Call the customer" />
    <bpmn:task id="contact" name="Determine the contact person and the budget" />
    <bpmn:task id="ask" name="Ask whether the customer is interested" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="huge" name="Project budget huge?" />
    <bpmn:endEvent id="left" name="Customer left alone" />
    <bpmn:task id="acquire" name="Acquire the customer personally" />
    <bpmn:endEvent id="acquired" name="Customer approached by head of development" />
    <bpmn:task id="presentpre" name="Give the technical online presentation" />
    <bpmn:exclusiveGateway id="technical" name="More technical presentation?" />
    <bpmn:task id="presentsales" name="Give the online presentation" />
    <bpmn:exclusiveGateway id="presented" name="Presentation given" />
    <bpmn:eventBasedGateway id="wait" name="Customer reaction?" />
    <bpmn:intermediateCatchEvent id="back" name="Customer comes back">
      <bpmn:messageEventDefinition id="back-def" messageRef="Message_Customer_comes_back" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="twoweeks" name="2 weeks without contact">
      <bpmn:timerEventDefinition id="twoweeks-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callagain" name="Call the customer again" />
    <bpmn:exclusiveGateway id="reacted" name="Customer contacted" />
    <bpmn:task id="quote" name="Create the quotation" />
    <bpmn:endEvent id="done" name="Quotation created" />
    <bpmn:sequenceFlow id="f-begin-determine" sourceRef="begin" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-how" sourceRef="determine" targetRef="how" />
    <bpmn:sequenceFlow id="f-how-buy" name="buy details" sourceRef="how" targetRef="buy" />
    <bpmn:sequenceFlow id="f-how-exhibit" name="exhibition" sourceRef="how" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-how-know" name="personal contact" sourceRef="how" targetRef="know" />
    <bpmn:sequenceFlow id="f-buy-found" sourceRef="buy" targetRef="found" />
    <bpmn:sequenceFlow id="f-exhibit-found" sourceRef="exhibit" targetRef="found" />
    <bpmn:sequenceFlow id="f-know-found" sourceRef="know" targetRef="found" />
    <bpmn:sequenceFlow id="f-found-call" sourceRef="found" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-contact" sourceRef="call" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact-ask" sourceRef="contact" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-interested" sourceRef="ask" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-technical" name="yes" sourceRef="interested" targetRef="technical" />
    <bpmn:sequenceFlow id="f-interested-huge" name="no" sourceRef="interested" targetRef="huge" />
    <bpmn:sequenceFlow id="f-huge-acquire" name="yes" sourceRef="huge" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-huge-left" name="no" sourceRef="huge" targetRef="left" />
    <bpmn:sequenceFlow id="f-acquire-acquired" sourceRef="acquire" targetRef="acquired" />
    <bpmn:sequenceFlow id="f-technical-presentpre" name="yes" sourceRef="technical" targetRef="presentpre" />
    <bpmn:sequenceFlow id="f-technical-presentsales" name="no" sourceRef="technical" targetRef="presentsales" />
    <bpmn:sequenceFlow id="f-presentpre-presented" sourceRef="presentpre" targetRef="presented" />
    <bpmn:sequenceFlow id="f-presentsales-presented" sourceRef="presentsales" targetRef="presented" />
    <bpmn:sequenceFlow id="f-presented-wait" sourceRef="presented" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-back" sourceRef="wait" targetRef="back" />
    <bpmn:sequenceFlow id="f-wait-twoweeks" sourceRef="wait" targetRef="twoweeks" />
    <bpmn:sequenceFlow id="f-twoweeks-callagain" sourceRef="twoweeks" targetRef="callagain" />
    <bpmn:sequenceFlow id="f-back-reacted" sourceRef="back" targetRef="reacted" />
    <bpmn:sequenceFlow id="f-callagain-reacted" sourceRef="callagain" targetRef="reacted" />
    <bpmn:sequenceFlow id="f-reacted-quote" sourceRef="reacted" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-done" sourceRef="quote" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
