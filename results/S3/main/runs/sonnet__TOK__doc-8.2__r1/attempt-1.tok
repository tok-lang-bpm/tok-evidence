tok 1.0 "Job vacancy posting"

pool hr "HR"
  lane clerk "HR clerk"
    start reported "Vacancy reported"
    xor m1
    task create "Create the job description"
    xor clear "Is the information clear?"
    task ask "Ask the Department again"
    xor m2
    task submit "Submit the job description for consideration"
    receive wait "Wait for the approval"
    xor approved "Is the description approved?"
    task correct "Correct the job description"
    task post "Post the job"
    end posted "Job posted"

flow reported -> m1 -> create -> clear
flow clear -> m2 "yes"
flow clear -> ask "no"
flow ask -> m1
flow m2 -> submit -> wait -> approved
flow approved -> post "yes"
flow approved -> correct "no"
flow correct -> m2
flow post -> posted
