<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job vacancy handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hr" name="HR" processRef="hr-process" />
  </bpmn:collaboration>
  <bpmn:process id="hr-process" name="Job vacancy handling" isExecutable="false">
    <bpmn:laneSet id="hr-lanes">
      <bpmn:lane id="clerk" name="HR clerk">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>info_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Vacancy reported" />
    <bpmn:exclusiveGateway id="info_merge" />
    <bpmn:task id="create" name="Create the job description" />
    <bpmn:exclusiveGateway id="clear" name="Information clear?" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:exclusiveGateway id="submit_merge" />
    <bpmn:task id="submit" name="Submit the job description for consideration" />
    <bpmn:receiveTask id="wait" name="Wait for the approval" />
    <bpmn:exclusiveGateway id="approved" name="Description approved?" />
    <bpmn:task id="correct" name="Correct the description" />
    <bpmn:task id="post" name="Post the job" />
    <bpmn:endEvent id="posted" name="Job posted" />
    <bpmn:sequenceFlow id="f-reported-info_merge" sourceRef="reported" targetRef="info_merge" />
    <bpmn:sequenceFlow id="f-info_merge-create" sourceRef="info_merge" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-clear" sourceRef="create" targetRef="clear" />
    <bpmn:sequenceFlow id="f-clear-submit_merge" name="yes" sourceRef="clear" targetRef="submit_merge" />
    <bpmn:sequenceFlow id="f-clear-ask" name="no" sourceRef="clear" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-info_merge" sourceRef="ask" targetRef="info_merge" />
    <bpmn:sequenceFlow id="f-submit_merge-submit" sourceRef="submit_merge" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-wait" sourceRef="submit" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-approved" sourceRef="wait" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-post" name="yes" sourceRef="approved" targetRef="post" />
    <bpmn:sequenceFlow id="f-approved-correct" name="no" sourceRef="approved" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-submit_merge" sourceRef="correct" targetRef="submit_merge" />
    <bpmn:sequenceFlow id="f-post-posted" sourceRef="post" targetRef="posted" />
  </bpmn:process>
</bpmn:definitions>
