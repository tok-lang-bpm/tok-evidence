<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Job description for a vacancy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Job description for a vacancy" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeDescribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="detected" name="Personnel requirements detected" />
    <bpmn:task id="detect" name="Detect the personnel requirements" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:task id="clarify" name="Clarify the tasks and requirements" />
    <bpmn:exclusiveGateway id="mergeReview" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corrections" name="Corrections needed?" default="f-corrections-approve" />
    <bpmn:task id="requestCorrections" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:endEvent id="approved" name="Job description approved" />
    <bpmn:exclusiveGateway id="questions" name="Questions about tasks and requirements?" default="f-questions-mergeDescribe" />
    <bpmn:task id="askQuestions" name="Ask questions about tasks and requirements" />
    <bpmn:exclusiveGateway id="mergeDescribe" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="sendDescription" name="Send the job description for review" />
    <bpmn:task id="revise" name="Revise the job description" />
    <bpmn:sequenceFlow id="f-detected-detect" sourceRef="detected" targetRef="detect" />
    <bpmn:sequenceFlow id="f-detect-report" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-questions" sourceRef="report" targetRef="questions" />
    <bpmn:sequenceFlow id="f-questions-askQuestions" name="yes" sourceRef="questions" targetRef="askQuestions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">questions = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-questions-mergeDescribe" name="no" sourceRef="questions" targetRef="mergeDescribe" />
    <bpmn:sequenceFlow id="f-askQuestions-clarify" sourceRef="askQuestions" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-mergeDescribe" sourceRef="clarify" targetRef="mergeDescribe" />
    <bpmn:sequenceFlow id="f-mergeDescribe-describe" sourceRef="mergeDescribe" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-sendDescription" sourceRef="describe" targetRef="sendDescription" />
    <bpmn:sequenceFlow id="f-sendDescription-mergeReview" sourceRef="sendDescription" targetRef="mergeReview" />
    <bpmn:sequenceFlow id="f-mergeReview-review" sourceRef="mergeReview" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corrections" sourceRef="review" targetRef="corrections" />
    <bpmn:sequenceFlow id="f-corrections-requestCorrections" name="yes" sourceRef="corrections" targetRef="requestCorrections">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrections = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-corrections-approve" name="no" sourceRef="corrections" targetRef="approve" />
    <bpmn:sequenceFlow id="f-requestCorrections-revise" sourceRef="requestCorrections" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-mergeReview" sourceRef="revise" targetRef="mergeReview" />
    <bpmn:sequenceFlow id="f-approve-approved" sourceRef="approve" targetRef="approved" />
  </bpmn:process>
</bpmn:definitions>
