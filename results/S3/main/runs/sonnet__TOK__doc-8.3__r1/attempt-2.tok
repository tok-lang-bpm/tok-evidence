tok 1.0 "Job description for a vacancy"

pool company "Company"
  lane head "Head of the functional department"
    start detected "Personnel requirements detected"
    task detect "Detect the personnel requirements"
    task report "Report the vacancy to the Personnel Department"
    task clarify "Clarify the tasks and requirements"
    xor mergeReview
    task review "Review the job description"
    xor corrections "Corrections needed?"
    task requestCorrections "Ask for corrections"
    task approve "Approve the job description"
    end approved "Job description approved"
  lane hr "Personnel Department"
    xor questions "Questions about tasks and requirements?"
    task askQuestions "Ask questions about tasks and requirements"
    xor mergeDescribe
    task describe "Describe the job"
    task sendDescription "Send the job description for review"
    task revise "Revise the job description"

flow detected -> detect -> report -> questions
flow questions -> askQuestions "yes" when="questions = true"
flow questions -> mergeDescribe "no" default
flow askQuestions -> clarify -> mergeDescribe
flow mergeDescribe -> describe -> sendDescription -> mergeReview
flow mergeReview -> review -> corrections
flow corrections -> requestCorrections "yes" when="corrections = true"
flow corrections -> approve "no" default
flow requestCorrections -> revise -> mergeReview
flow approve -> approved
