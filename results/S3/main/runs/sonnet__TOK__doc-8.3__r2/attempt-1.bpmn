<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job description approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Job description approval" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askcorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="detected" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:task id="clarify" name="Clarify the tasks and requirements" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corrections" name="Corrections needed?" />
    <bpmn:task id="askcorr" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:endEvent id="approved" name="Job description approved" />
    <bpmn:exclusiveGateway id="questions" name="Questions about tasks and requirements?" />
    <bpmn:task id="ask" name="Ask questions about the tasks and requirements" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="send" name="Send the job description for review" />
    <bpmn:sequenceFlow id="f-detected-report" sourceRef="detected" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-questions" sourceRef="report" targetRef="questions" />
    <bpmn:sequenceFlow id="f-questions-ask" name="yes" sourceRef="questions" targetRef="ask" />
    <bpmn:sequenceFlow id="f-questions-merge" name="no" sourceRef="questions" targetRef="merge" />
    <bpmn:sequenceFlow id="f-ask-clarify" sourceRef="ask" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-merge" sourceRef="clarify" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-describe" sourceRef="merge" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corrections" sourceRef="review" targetRef="corrections" />
    <bpmn:sequenceFlow id="f-corrections-askcorr" name="yes" sourceRef="corrections" targetRef="askcorr" />
    <bpmn:sequenceFlow id="f-corrections-approve" name="no" sourceRef="corrections" targetRef="approve" />
    <bpmn:sequenceFlow id="f-askcorr-merge" sourceRef="askcorr" targetRef="merge" />
    <bpmn:sequenceFlow id="f-approve-approved" sourceRef="approve" targetRef="approved" />
  </bpmn:process>
</bpmn:definitions>
