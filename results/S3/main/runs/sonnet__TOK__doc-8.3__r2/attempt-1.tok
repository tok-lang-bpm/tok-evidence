tok 1.0 "Job description approval"

pool company "Company"
  lane head "Head of the functional department"
    start detected "Personnel requirements detected"
    task report "Report the vacancy to the Personnel Department"
    task clarify "Clarify the tasks and requirements"
    task review "Review the job description"
    xor corrections "Corrections needed?"
    task askcorr "Ask for corrections"
    task approve "Approve the job description"
    end approved "Job description approved"
  lane hr "Personnel Department"
    xor questions "Questions about tasks and requirements?"
    task ask "Ask questions about the tasks and requirements"
    xor merge
    task describe "Describe the job"
    task send "Send the job description for review"

flow detected -> report -> questions
flow questions -> ask "yes"
flow questions -> merge "no"
flow ask -> clarify -> merge
flow merge -> describe -> send -> review -> corrections
flow corrections -> askcorr "yes"
flow corrections -> approve "no"
flow askcorr -> merge
flow approve -> approved
