<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Daily account defaulter check" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Daily account defaulter check" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="ops" name="Account defaulter process">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>part1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alerted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>part2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>messaged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Every weekday morning">
      <bpmn:timerEventDefinition id="morning-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:subProcess id="part1" name="Detect and report defaulting accounts">
      <bpmn:startEvent id="s1" name="Start checks" />
      <bpmn:task id="backup" name="Back up the database" />
      <bpmn:task id="checktbl" name="Check the Account Defaulter table for new records" />
      <bpmn:exclusiveGateway id="newrec" name="New records found?" />
      <bpmn:task id="checkcrm1" name="Check the CRM system for new returns" />
      <bpmn:exclusiveGateway id="ret1" name="New returns filed?" />
      <bpmn:task id="register" name="Register defaulting accounts and customers" />
      <bpmn:exclusiveGateway id="adv" name="Defaulting client codes previously advised?" />
      <bpmn:task id="produce" name="Produce table of defaulting accounts" />
      <bpmn:task id="sendmgmt" name="Send table to account management" />
      <bpmn:exclusiveGateway id="merge1" />
      <bpmn:endEvent id="e1" name="Report completed" />
      <bpmn:sequenceFlow id="f-s1-backup" sourceRef="s1" targetRef="backup" />
      <bpmn:sequenceFlow id="f-backup-checktbl" sourceRef="backup" targetRef="checktbl" />
      <bpmn:sequenceFlow id="f-checktbl-newrec" sourceRef="checktbl" targetRef="newrec" />
      <bpmn:sequenceFlow id="f-newrec-merge1" name="yes" sourceRef="newrec" targetRef="merge1" />
      <bpmn:sequenceFlow id="f-newrec-checkcrm1" name="no" sourceRef="newrec" targetRef="checkcrm1" />
      <bpmn:sequenceFlow id="f-checkcrm1-ret1" sourceRef="checkcrm1" targetRef="ret1" />
      <bpmn:sequenceFlow id="f-ret1-register" name="yes" sourceRef="ret1" targetRef="register" />
      <bpmn:sequenceFlow id="f-ret1-merge1" name="no" sourceRef="ret1" targetRef="merge1" />
      <bpmn:sequenceFlow id="f-register-adv" sourceRef="register" targetRef="adv" />
      <bpmn:sequenceFlow id="f-adv-merge1" name="yes" sourceRef="adv" targetRef="merge1" />
      <bpmn:sequenceFlow id="f-adv-produce" name="no" sourceRef="adv" targetRef="produce" />
      <bpmn:sequenceFlow id="f-produce-sendmgmt" sourceRef="produce" targetRef="sendmgmt" />
      <bpmn:sequenceFlow id="f-sendmgmt-merge1" sourceRef="sendmgmt" targetRef="merge1" />
      <bpmn:sequenceFlow id="f-merge1-e1" sourceRef="merge1" targetRef="e1" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="late1" name="2:30 pm reached" attachedToRef="part1" cancelActivity="false">
      <bpmn:timerEventDefinition id="late1-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="alert" name="Send alert to the supervisor" />
    <bpmn:endEvent id="alerted" name="Supervisor alerted" />
    <bpmn:subProcess id="part2" name="Reconcile defaulters">
      <bpmn:startEvent id="s2" name="Start reconciliation" />
      <bpmn:task id="checkcrm2" name="Check the CRM system for new returns" />
      <bpmn:exclusiveGateway id="ret2" name="New returns filed?" />
      <bpmn:task id="reconcile" name="Reconcile with the existing Account Defaulter table" />
      <bpmn:endEvent id="e2" name="Reconciled" />
      <bpmn:endEvent id="e3" name="No reconciliation needed" />
      <bpmn:sequenceFlow id="f-s2-checkcrm2" sourceRef="s2" targetRef="checkcrm2" />
      <bpmn:sequenceFlow id="f-checkcrm2-ret2" sourceRef="checkcrm2" targetRef="ret2" />
      <bpmn:sequenceFlow id="f-ret2-reconcile" name="yes" sourceRef="ret2" targetRef="reconcile" />
      <bpmn:sequenceFlow id="f-ret2-e3" name="no" sourceRef="ret2" targetRef="e3" />
      <bpmn:sequenceFlow id="f-reconcile-e2" sourceRef="reconcile" targetRef="e2" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="late2" name="4:00 pm reached" attachedToRef="part2" cancelActivity="false">
      <bpmn:timerEventDefinition id="late2-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="msg" name="Send message to the supervisor" />
    <bpmn:endEvent id="messaged" name="Supervisor messaged" />
    <bpmn:endEvent id="finished" name="Process completed" />
    <bpmn:sequenceFlow id="f-morning-part1" sourceRef="morning" targetRef="part1" />
    <bpmn:sequenceFlow id="f-part1-part2" sourceRef="part1" targetRef="part2" />
    <bpmn:sequenceFlow id="f-part2-finished" sourceRef="part2" targetRef="finished" />
    <bpmn:sequenceFlow id="f-late1-alert" sourceRef="late1" targetRef="alert" />
    <bpmn:sequenceFlow id="f-alert-alerted" sourceRef="alert" targetRef="alerted" />
    <bpmn:sequenceFlow id="f-late2-msg" sourceRef="late2" targetRef="msg" />
    <bpmn:sequenceFlow id="f-msg-messaged" sourceRef="msg" targetRef="messaged" />
  </bpmn:process>
</bpmn:definitions>
