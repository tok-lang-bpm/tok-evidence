<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meeting schedule planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Meeting schedule planning" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>november</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>checkdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Independent Committee Members">
        <bpmn:flowNodeRef>checkdiaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="november" name="November of each year" />
    <bpmn:task id="draft" name="Draft a schedule of meetings for the next calendar year" />
    <bpmn:task id="add" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="look" name="Look for potential conflicts" />
    <bpmn:task id="send" name="Send the final schedule of meeting dates to all Committee Members by email" />
    <bpmn:endEvent id="done" name="Schedule communicated" />
    <bpmn:task id="checkdates" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="checkdiaries" name="Check diaries" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of any conflicts" />
    <bpmn:sequenceFlow id="f-november-draft" sourceRef="november" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-add" sourceRef="draft" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-checkdates" sourceRef="add" targetRef="checkdates" />
    <bpmn:sequenceFlow id="f-checkdates-suggest" sourceRef="checkdates" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-look" sourceRef="recheck" targetRef="look" />
    <bpmn:sequenceFlow id="f-look-send" sourceRef="look" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-checkdiaries" sourceRef="send" targetRef="checkdiaries" />
    <bpmn:sequenceFlow id="f-checkdiaries-advise" sourceRef="checkdiaries" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-done" sourceRef="advise" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
