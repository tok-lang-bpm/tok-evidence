tok 1.0 "Meeting schedule planning"

pool authority "Town Planning Authority"
  lane coordination "Coordination Unit"
    start november "November of each year"
    task draft "Draft a schedule of meetings for the next calendar year"
    task add "Add draft dates to all calendars"
    task recheck "Recheck all dates"
    task look "Look for potential conflicts"
    task send "Send the final schedule of meeting dates to all Committee Members by email"
    end done "Schedule communicated"
  lane support "Support Officer"
    task checkdates "Check the dates"
    task suggest "Suggest modifications"
  lane members "Independent Committee Members"
    task checkdiaries "Check diaries"
    task advise "Advise the Coordination Unit of any conflicts"

flow november -> draft -> add -> checkdates -> suggest -> recheck -> look -> send -> checkdiaries -> advise -> done
