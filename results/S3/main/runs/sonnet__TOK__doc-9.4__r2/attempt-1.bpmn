<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting preparation and minutes" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting preparation and minutes" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>finalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>records</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="finalized" name="Dates finalized" />
    <bpmn:task id="qa" name="Conduct a QA check on the minutes" />
    <bpmn:endEvent id="done" name="Records updated" />
    <bpmn:task id="calendars" name="Update all group calendars" />
    <bpmn:task id="folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="upload" name="Upload all appropriate documents to system" />
    <bpmn:task id="minutes" name="Produce minutes including Action Points" />
    <bpmn:task id="send" name="Send the minutes to all Committee Members" />
    <bpmn:task id="records" name="Update all departmental records" />
    <bpmn:task id="advise" name="Advise Committee Members to read all related documents" />
    <bpmn:task id="meet" name="Hold the meeting" />
    <bpmn:sequenceFlow id="f-finalized-calendars" sourceRef="finalized" targetRef="calendars" />
    <bpmn:sequenceFlow id="f-calendars-folders" sourceRef="calendars" targetRef="folders" />
    <bpmn:sequenceFlow id="f-folders-upload" sourceRef="folders" targetRef="upload" />
    <bpmn:sequenceFlow id="f-upload-advise" sourceRef="upload" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-meet" sourceRef="advise" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-minutes" sourceRef="meet" targetRef="minutes" />
    <bpmn:sequenceFlow id="f-minutes-qa" sourceRef="minutes" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send" sourceRef="qa" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-records" sourceRef="send" targetRef="records" />
    <bpmn:sequenceFlow id="f-records-done" sourceRef="records" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
