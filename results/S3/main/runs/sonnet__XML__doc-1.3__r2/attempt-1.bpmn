<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="room-service" />
  </bpmn:collaboration>
  <bpmn:process id="room-service" isExecutable="false">
    <bpmn:laneSet id="room-service-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>called</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare-food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch-wine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcohol-merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ready-cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return-station</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="called" name="Guest calls room service" />
    <bpmn:task id="take-order" name="Take down the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="submit-ticket" name="Submit the order ticket to the kitchen" />
    <bpmn:task id="prepare-food" name="Prepare the food" />
    <bpmn:exclusiveGateway id="alcohol" name="Order includes alcoholic beverages?" />
    <bpmn:task id="give-order" name="Give the order to the sommelier" />
    <bpmn:task id="fetch-wine" name="Fetch the wine from the cellar" />
    <bpmn:task id="prepare-alcohol" name="Prepare the other alcoholic beverages" />
    <bpmn:exclusiveGateway id="alcohol-merge" />
    <bpmn:task id="assign-order" name="Assign the order to the waiter" />
    <bpmn:task id="ready-cart" name="Ready the cart" />
    <bpmn:task id="prepare-drinks" name="Prepare the nonalcoholic drinks" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="return-station" name="Return to the room-service station" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="done" name="Order delivered and billed" />
    <bpmn:sequenceFlow id="f1" sourceRef="called" targetRef="take-order" />
    <bpmn:sequenceFlow id="f2" sourceRef="take-order" targetRef="split" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="submit-ticket" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="alcohol" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="assign-order" />
    <bpmn:sequenceFlow id="f6" sourceRef="submit-ticket" targetRef="prepare-food" />
    <bpmn:sequenceFlow id="f7" sourceRef="prepare-food" targetRef="join" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="alcohol" targetRef="give-order" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="alcohol" targetRef="alcohol-merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="give-order" targetRef="fetch-wine" />
    <bpmn:sequenceFlow id="f11" sourceRef="fetch-wine" targetRef="prepare-alcohol" />
    <bpmn:sequenceFlow id="f12" sourceRef="prepare-alcohol" targetRef="alcohol-merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="alcohol-merge" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="assign-order" targetRef="ready-cart" />
    <bpmn:sequenceFlow id="f15" sourceRef="ready-cart" targetRef="prepare-drinks" />
    <bpmn:sequenceFlow id="f16" sourceRef="prepare-drinks" targetRef="join" />
    <bpmn:sequenceFlow id="f17" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f18" sourceRef="deliver" targetRef="return-station" />
    <bpmn:sequenceFlow id="f19" sourceRef="return-station" targetRef="debit" />
    <bpmn:sequenceFlow id="f20" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
