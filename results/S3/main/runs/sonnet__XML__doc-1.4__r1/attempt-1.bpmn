<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Underwriters" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkLaws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNot</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Decision to go public made" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="checkLaws" name="Check the compliance with the blue-sky laws" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="roadshow" name="Arrange a road show" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:intermediateCatchEvent id="clearance" name="SEC clearance received" >
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to offer found?" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="endSold" name="Stock offered" />
    <bpmn:endEvent id="endNot" name="Stock not offered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="select" />
    <bpmn:sequenceFlow id="f2" sourceRef="select" targetRef="prepare" />
    <bpmn:sequenceFlow id="f3" sourceRef="prepare" targetRef="split1" />
    <bpmn:sequenceFlow id="f4" sourceRef="split1" targetRef="register" />
    <bpmn:sequenceFlow id="f5" sourceRef="split1" targetRef="checkLaws" />
    <bpmn:sequenceFlow id="f6" sourceRef="register" targetRef="join1" />
    <bpmn:sequenceFlow id="f7" sourceRef="checkLaws" targetRef="join1" />
    <bpmn:sequenceFlow id="f8" sourceRef="join1" targetRef="split2" />
    <bpmn:sequenceFlow id="f9" sourceRef="split2" targetRef="firm" />
    <bpmn:sequenceFlow id="f10" sourceRef="split2" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f11" sourceRef="firm" targetRef="join2" />
    <bpmn:sequenceFlow id="f12" sourceRef="roadshow" targetRef="join2" />
    <bpmn:sequenceFlow id="f13" sourceRef="join2" targetRef="clearance" />
    <bpmn:sequenceFlow id="f14" sourceRef="clearance" targetRef="fix" />
    <bpmn:sequenceFlow id="f15" sourceRef="fix" targetRef="commit" />
    <bpmn:sequenceFlow id="f16" sourceRef="commit" targetRef="reason" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="reason" targetRef="offer" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="reason" targetRef="endNot" />
    <bpmn:sequenceFlow id="f19" sourceRef="offer" targetRef="endSold" />
  </bpmn:process>
</bpmn:definitions>
