<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Going public" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" isExecutable="false">
    <bpmn:laneSet id="ipo-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bluesky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firmup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notoffered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Decision to go public made" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advice" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:intermediateCatchEvent id="clearance" name="Clearance from the SEC received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="bluesky" name="Check compliance with the blue-sky laws" />
    <bpmn:task id="firmup" name="Firm up the issue price" />
    <bpmn:task id="roadshow" name="Arrange a road show" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to offer the stock found?" default="n1" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="offered" name="Stock offered" />
    <bpmn:endEvent id="notoffered" name="Stock not offered" />
    <bpmn:sequenceFlow id="s1" sourceRef="start" targetRef="select" />
    <bpmn:sequenceFlow id="s2" sourceRef="select" targetRef="advice" />
    <bpmn:sequenceFlow id="s3" sourceRef="advice" targetRef="prepare" />
    <bpmn:sequenceFlow id="s4" sourceRef="prepare" targetRef="split" />
    <bpmn:sequenceFlow id="s5" sourceRef="split" targetRef="register" />
    <bpmn:sequenceFlow id="s6" sourceRef="split" targetRef="bluesky" />
    <bpmn:sequenceFlow id="s7" sourceRef="split" targetRef="firmup" />
    <bpmn:sequenceFlow id="s8" sourceRef="register" targetRef="clearance" />
    <bpmn:sequenceFlow id="s9" sourceRef="firmup" targetRef="roadshow" />
    <bpmn:sequenceFlow id="s10" sourceRef="clearance" targetRef="join" />
    <bpmn:sequenceFlow id="s11" sourceRef="bluesky" targetRef="join" />
    <bpmn:sequenceFlow id="s12" sourceRef="roadshow" targetRef="join" />
    <bpmn:sequenceFlow id="s13" sourceRef="join" targetRef="fix" />
    <bpmn:sequenceFlow id="s14" sourceRef="fix" targetRef="reason" />
    <bpmn:sequenceFlow id="n1" name="no" sourceRef="reason" targetRef="commit" />
    <bpmn:sequenceFlow id="y1" name="yes" sourceRef="reason" targetRef="notoffered" />
    <bpmn:sequenceFlow id="s15" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="s16" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
