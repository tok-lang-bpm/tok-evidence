<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Transaction data request handling" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>checkRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Transaction data needed" />
    <bpmn:task id="transmitRequest" name="Transmit the transaction data request" />
    <bpmn:task id="checkRequest" name="Check the request of the INQ" />
    <bpmn:exclusiveGateway id="valid" name="Request accepted?" />
    <bpmn:task id="transmitData" name="Transmit the data" />
    <bpmn:task id="reject" name="Reject the request" />
    <bpmn:endEvent id="endData" name="Data transmitted" />
    <bpmn:endEvent id="endRejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="transmitRequest" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmitRequest" targetRef="checkRequest" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkRequest" targetRef="valid" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="valid" targetRef="transmitData" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="valid" targetRef="reject" />
    <bpmn:sequenceFlow id="f6" sourceRef="transmitData" targetRef="endData" />
    <bpmn:sequenceFlow id="f7" sourceRef="reject" targetRef="endRejected" />
  </bpmn:process>
</bpmn:definitions>
