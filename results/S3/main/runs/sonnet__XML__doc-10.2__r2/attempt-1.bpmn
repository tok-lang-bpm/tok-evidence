<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Meter operation registration" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneMPON" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acqN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infoFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infoSucc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneGO" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAppr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infoOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infoSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>acqO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Meter operation to be reported" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="gAppr" name="Application confirmed?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:endEvent id="endRejected" name="Application rejected" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="infoOO" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="infoSO" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="acqN" name="Perform the equipment acquisition and / or equipment changes (MPON)" />
    <bpmn:task id="acqO" name="Perform the equipment acquisition and / or equipment changes (MPOO)" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:boundaryEvent id="timer" name="Maximum time limit reached" attachedToRef="acqN" cancelActivity="true">
      <bpmn:timerEventDefinition id="timerDef">
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="deadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="endDeadline" name="Transaction failed by deadline" />
    <bpmn:exclusiveGateway id="gOk" name="Entire process successful?" />
    <bpmn:task id="infoFail" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="infoSucc" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="confFail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="failOO" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="failSO" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:endEvent id="endFail" name="Assignment failed" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confAssign" name="Confirm the assignment to the MPON" />
    <bpmn:task id="assOO" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="assSO" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="assSP" name="Inform the SP about the assignment of the MPON" />
    <bpmn:endEvent id="endOk" name="MPON assigned" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f3" sourceRef="examine" targetRef="gAppr" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gAppr" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="gAppr" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="endRejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="split1" />
    <bpmn:sequenceFlow id="f8" sourceRef="split1" targetRef="infoOO" />
    <bpmn:sequenceFlow id="f9" sourceRef="split1" targetRef="infoSO" />
    <bpmn:sequenceFlow id="f10" sourceRef="infoOO" targetRef="join1" />
    <bpmn:sequenceFlow id="f11" sourceRef="infoSO" targetRef="join1" />
    <bpmn:sequenceFlow id="f12" sourceRef="join1" targetRef="split2" />
    <bpmn:sequenceFlow id="f13" sourceRef="split2" targetRef="acqN" />
    <bpmn:sequenceFlow id="f14" sourceRef="split2" targetRef="acqO" />
    <bpmn:sequenceFlow id="f15" sourceRef="acqN" targetRef="join2" />
    <bpmn:sequenceFlow id="f16" sourceRef="acqO" targetRef="join2" />
    <bpmn:sequenceFlow id="f17" sourceRef="join2" targetRef="gOk" />
    <bpmn:sequenceFlow id="f18" sourceRef="timer" targetRef="deadline" />
    <bpmn:sequenceFlow id="f19" sourceRef="deadline" targetRef="endDeadline" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="gOk" targetRef="infoFail" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="gOk" targetRef="infoSucc" />
    <bpmn:sequenceFlow id="f22" sourceRef="infoFail" targetRef="confFail" />
    <bpmn:sequenceFlow id="f23" sourceRef="confFail" targetRef="failOO" />
    <bpmn:sequenceFlow id="f24" sourceRef="failOO" targetRef="failSO" />
    <bpmn:sequenceFlow id="f25" sourceRef="failSO" targetRef="endFail" />
    <bpmn:sequenceFlow id="f26" sourceRef="infoSucc" targetRef="assign" />
    <bpmn:sequenceFlow id="f27" sourceRef="assign" targetRef="confAssign" />
    <bpmn:sequenceFlow id="f28" sourceRef="confAssign" targetRef="assOO" />
    <bpmn:sequenceFlow id="f29" sourceRef="assOO" targetRef="assSO" />
    <bpmn:sequenceFlow id="f30" sourceRef="assSO" targetRef="assSP" />
    <bpmn:sequenceFlow id="f31" sourceRef="assSP" targetRef="endOk" />
  </bpmn:process>
</bpmn:definitions>
