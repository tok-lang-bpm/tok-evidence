<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Grid operator process" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mpoo" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_cont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_oblige_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Deregistration needed" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="gw_verify" name="Deregistration accepted?" default="f_no_accept" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="end_rejected" name="Deregistration rejected" />
    <bpmn:task id="confirm_dereg" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="gw_oblige" name="MPOO obliged to continue operations?" default="f_no_oblige" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:task id="confirm_cont" name="Confirm the continuation" />
    <bpmn:exclusiveGateway id="gw_oblige_merge" />
    <bpmn:task id="equipment" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="inform_mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="end_done" name="Assignment completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="deregister" />
    <bpmn:sequenceFlow id="f2" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f3" sourceRef="verify" targetRef="gw_verify" />
    <bpmn:sequenceFlow id="f_no_accept" name="no" sourceRef="gw_verify" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="gw_verify" targetRef="confirm_dereg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">deregistrationAccepted == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm_dereg" targetRef="prepare" />
    <bpmn:sequenceFlow id="f8" sourceRef="prepare" targetRef="gw_oblige" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gw_oblige" targetRef="oblige">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mpooObliged == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no_oblige" name="no" sourceRef="gw_oblige" targetRef="gw_oblige_merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="oblige" targetRef="confirm_cont" />
    <bpmn:sequenceFlow id="f12" sourceRef="confirm_cont" targetRef="gw_oblige_merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_oblige_merge" targetRef="equipment" />
    <bpmn:sequenceFlow id="f14" sourceRef="equipment" targetRef="assign" />
    <bpmn:sequenceFlow id="f15" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f16" sourceRef="split" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f17" sourceRef="split" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f18" sourceRef="split" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f19" sourceRef="inform_mpoo" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="inform_mspo" targetRef="join" />
    <bpmn:sequenceFlow id="f21" sourceRef="inform_sp" targetRef="join" />
    <bpmn:sequenceFlow id="f22" sourceRef="join" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
