<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Meter equipment change" processRef="change-process" />
  </bpmn:collaboration>
  <bpmn:process id="change-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read_count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mpoo" name="MPOO">
        <bpmn:flowNodeRef>g_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_oo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_oo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-go" name="GO">
        <bpmn:flowNodeRef>notify_msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Equipment change intended" />
    <bpmn:task id="notify_intent" name="Notify the MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="g_self" name="Does the MPOO dismount itself?" default="f_no" />
    <bpmn:task id="announce" name="Announce self dismounting to the MPON" />
    <bpmn:task id="final_reading_oo" name="Perform the final reading" />
    <bpmn:task id="dismount_oo" name="Dismount the old equipment" />
    <bpmn:task id="notify_no" name="Notify the MPON about no self-dismounting" />
    <bpmn:task id="final_reading_on" name="Perform the final reading" />
    <bpmn:task id="dismount_on" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="g_merge" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="read_count" name="Read the meter count from the installed meter" />
    <bpmn:task id="send_final" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tell_go" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:task id="notify_msp" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="end" name="MSP notified" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="notify_intent" />
    <bpmn:sequenceFlow id="f2" sourceRef="notify_intent" targetRef="g_self" />
    <bpmn:sequenceFlow id="f_yes" name="yes" sourceRef="g_self" targetRef="announce">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">selfDismounting == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no" name="no" sourceRef="g_self" targetRef="notify_no" />
    <bpmn:sequenceFlow id="f3" sourceRef="announce" targetRef="final_reading_oo" />
    <bpmn:sequenceFlow id="f4" sourceRef="final_reading_oo" targetRef="dismount_oo" />
    <bpmn:sequenceFlow id="f5" sourceRef="dismount_oo" targetRef="g_merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="notify_no" targetRef="final_reading_on" />
    <bpmn:sequenceFlow id="f7" sourceRef="final_reading_on" targetRef="dismount_on" />
    <bpmn:sequenceFlow id="f8" sourceRef="dismount_on" targetRef="g_merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="g_merge" targetRef="mount" />
    <bpmn:sequenceFlow id="f10" sourceRef="mount" targetRef="read_count" />
    <bpmn:sequenceFlow id="f11" sourceRef="read_count" targetRef="send_final" />
    <bpmn:sequenceFlow id="f12" sourceRef="send_final" targetRef="tell_go" />
    <bpmn:sequenceFlow id="f13" sourceRef="tell_go" targetRef="notify_msp" />
    <bpmn:sequenceFlow id="f14" sourceRef="notify_msp" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
