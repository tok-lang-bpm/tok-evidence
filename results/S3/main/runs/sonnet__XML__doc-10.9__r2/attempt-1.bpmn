<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Measuring point change" processRef="change-process" />
  </bpmn:collaboration>
  <bpmn:process id="change-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mpo" name="MPO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>who</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Change needed" />
    <bpmn:exclusiveGateway id="who" name="Who causes the change?" />
    <bpmn:task id="request" name="Request changes to the measuring point" />
    <bpmn:task id="cause" name="Cause a change of the measuring point" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="confirmed" name="Request confirmed?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="success" name="Change successful?" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notify" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="end-rejected" name="Change rejected" />
    <bpmn:endEvent id="end-done" name="Change implemented" />
    <bpmn:endEvent id="end-failed" name="Change failed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="who" />
    <bpmn:sequenceFlow id="f2" name="SP / PU / GO" sourceRef="who" targetRef="request" />
    <bpmn:sequenceFlow id="f3" name="MPO" sourceRef="who" targetRef="cause" />
    <bpmn:sequenceFlow id="f4" sourceRef="request" targetRef="review" />
    <bpmn:sequenceFlow id="f5" sourceRef="review" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="confirmed" targetRef="reject" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="confirmed" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="cause" targetRef="merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="reject" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="f10" sourceRef="merge" targetRef="perform" />
    <bpmn:sequenceFlow id="f11" sourceRef="perform" targetRef="success" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="success" targetRef="report" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="success" targetRef="notify" />
    <bpmn:sequenceFlow id="f14" sourceRef="report" targetRef="end-done" />
    <bpmn:sequenceFlow id="f15" sourceRef="notify" targetRef="end-failed" />
  </bpmn:process>
</bpmn:definitions>
