<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="TELECO" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custReceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-cs" name="Customer Service">
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPrem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callExtra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endPrem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createDet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-es" name="Electronic Service">
        <bpmn:flowNodeRef>signif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-bc" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-sm" name="Service Management">
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>troubleSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendPerf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>checkRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwProb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzeRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>troubleRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catchReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRP</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Service degradation perceived" />
    <bpmn:task id="sendlist" name="Send the list of problem parameters" />
    <bpmn:task id="enter" name="Enter the problem report into system T" />
    <bpmn:task id="compare" name="Compare the problem report to the customer SLA" />
    <bpmn:task id="measures" name="Determine the counter measures and their priorities" />
    <bpmn:task id="signif" name="Determine the significance of the customer" />
    <bpmn:exclusiveGateway id="gwPrem" name="Customer premium?" />
    <bpmn:callActivity id="callExtra" name="Link to the extra problem fix process" calledElement="extra-problem-fix-process" />
    <bpmn:endEvent id="endPrem" name="Handed over to extra problem fix process" />
    <bpmn:exclusiveGateway id="gwSig" name="Significance affects the counter measures?" />
    <bpmn:task id="createDet" name="Create the detailed problem report" />
    <bpmn:task id="sendDet" name="Send the detailed problem report to Service Management" />

    <bpmn:task id="investigate" name="Investigate whether the problem is analyzable" />
    <bpmn:exclusiveGateway id="gwAn" name="Analyzable by Service Management?" />
    <bpmn:task id="analyze" name="Perform the analysis" />
    <bpmn:task id="troubleSM" name="Create the trouble report" />
    <bpmn:task id="sendRP" name="Send the detailed problem report to Resource Provisioning" />

    <bpmn:task id="checkRP" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="gwProb" name="Problem detected?" />
    <bpmn:task id="notif" name="Create the notification about normal service execution" />
    <bpmn:task id="analyzeRP" name="Analyze the problem" />
    <bpmn:task id="troubleRP" name="Create the trouble report" />
    <bpmn:exclusiveGateway id="mergeRP" />
    <bpmn:task id="createStatus" name="Include the report in a status report" />
    <bpmn:task id="sendStatus" name="Send the status report to Service Management" />
    <bpmn:parallelGateway id="pgS" />
    <bpmn:eventBasedGateway id="evgw" />
    <bpmn:intermediateCatchEvent id="catchReq" name="Restoration request received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer" name="2 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endTimeout" name="Process terminated">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="track" name="Track all possible errors" />
    <bpmn:task id="correctRP" name="Undertake the necessary corrective actions" />
    <bpmn:task id="createTS" name="Create the trouble-shooting report" />
    <bpmn:task id="sendTS" name="Send the trouble-shooting report to Service Management" />
    <bpmn:endEvent id="endRP" name="Restoration completed" />

    <bpmn:exclusiveGateway id="smMerge" />
    <bpmn:task id="prepare" name="Prepare the final status report" />
    <bpmn:task id="decide" name="Determine the counter measures to be taken" />
    <bpmn:exclusiveGateway id="gw3" name="Which counter measure is required?" />
    <bpmn:task id="sendPerf" name="Send the actual service performance to Customer Service" />
    <bpmn:task id="correctSM" name="Undertake the corrective actions" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="createRes" name="Create the problem resolution report" />
    <bpmn:task id="sendRes" name="Send the problem resolution report to Customer Service" />
    <bpmn:task id="createReq" name="Create the request for automatic resource restoration" />
    <bpmn:task id="sendReq" name="Send the request to Resource Provisioning" />
    <bpmn:receiveTask id="receiveTS" name="Receive the trouble-shooting report" />

    <bpmn:exclusiveGateway id="csMerge" />
    <bpmn:parallelGateway id="pg1" />
    <bpmn:task id="createRep" name="Create the report for the customer" />
    <bpmn:task id="sendRep" name="Send the report to the customer" />
    <bpmn:parallelGateway id="pgs" />
    <bpmn:task id="rebate" name="Report the SLA violation rebate to Billing &amp; Collections" />
    <bpmn:task id="adjust" name="Adjust the billing" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="endCS" name="Process ended at Customer Service" />
    <bpmn:receiveTask id="custReceive" name="Receive the report about service performance and problem resolution" />
    <bpmn:endEvent id="endCust" name="Process ended at customer" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendlist" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendlist" targetRef="enter" />
    <bpmn:sequenceFlow id="f3" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f4" sourceRef="compare" targetRef="measures" />
    <bpmn:sequenceFlow id="f5" sourceRef="measures" targetRef="signif" />
    <bpmn:sequenceFlow id="f6" sourceRef="signif" targetRef="gwPrem" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gwPrem" targetRef="callExtra" />
    <bpmn:sequenceFlow id="f8" sourceRef="callExtra" targetRef="endPrem" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="gwPrem" targetRef="gwSig" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="gwSig" targetRef="measures" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="gwSig" targetRef="createDet" />
    <bpmn:sequenceFlow id="f12" sourceRef="createDet" targetRef="sendDet" />
    <bpmn:sequenceFlow id="f13" sourceRef="sendDet" targetRef="investigate" />
    <bpmn:sequenceFlow id="f14" sourceRef="investigate" targetRef="gwAn" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="gwAn" targetRef="analyze" />
    <bpmn:sequenceFlow id="f16" sourceRef="analyze" targetRef="troubleSM" />
    <bpmn:sequenceFlow id="f17" sourceRef="troubleSM" targetRef="smMerge" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="gwAn" targetRef="sendRP" />
    <bpmn:sequenceFlow id="f19" sourceRef="sendRP" targetRef="checkRP" />
    <bpmn:sequenceFlow id="f20" sourceRef="checkRP" targetRef="gwProb" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="gwProb" targetRef="notif" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="gwProb" targetRef="analyzeRP" />
    <bpmn:sequenceFlow id="f23" sourceRef="analyzeRP" targetRef="troubleRP" />
    <bpmn:sequenceFlow id="f24" sourceRef="notif" targetRef="mergeRP" />
    <bpmn:sequenceFlow id="f25" sourceRef="troubleRP" targetRef="mergeRP" />
    <bpmn:sequenceFlow id="f26" sourceRef="mergeRP" targetRef="createStatus" />
    <bpmn:sequenceFlow id="f27" sourceRef="createStatus" targetRef="sendStatus" />
    <bpmn:sequenceFlow id="f28" sourceRef="sendStatus" targetRef="pgS" />
    <bpmn:sequenceFlow id="f29" sourceRef="pgS" targetRef="smMerge" />
    <bpmn:sequenceFlow id="f30" sourceRef="pgS" targetRef="evgw" />
    <bpmn:sequenceFlow id="f31" sourceRef="evgw" targetRef="catchReq" />
    <bpmn:sequenceFlow id="f32" sourceRef="evgw" targetRef="timer" />
    <bpmn:sequenceFlow id="f33" sourceRef="timer" targetRef="endTimeout" />
    <bpmn:sequenceFlow id="f34" sourceRef="catchReq" targetRef="track" />
    <bpmn:sequenceFlow id="f35" sourceRef="track" targetRef="correctRP" />
    <bpmn:sequenceFlow id="f36" sourceRef="correctRP" targetRef="createTS" />
    <bpmn:sequenceFlow id="f37" sourceRef="createTS" targetRef="sendTS" />
    <bpmn:sequenceFlow id="f38" sourceRef="sendTS" targetRef="endRP" />
    <bpmn:sequenceFlow id="f39" sourceRef="smMerge" targetRef="prepare" />
    <bpmn:sequenceFlow id="f40" sourceRef="prepare" targetRef="decide" />
    <bpmn:sequenceFlow id="f41" sourceRef="decide" targetRef="gw3" />
    <bpmn:sequenceFlow id="f42" name="no problem detected" sourceRef="gw3" targetRef="sendPerf" />
    <bpmn:sequenceFlow id="f43" sourceRef="sendPerf" targetRef="csMerge" />
    <bpmn:sequenceFlow id="f44" name="minor corrective actions required" sourceRef="gw3" targetRef="correctSM" />
    <bpmn:sequenceFlow id="f45" sourceRef="correctSM" targetRef="m2" />
    <bpmn:sequenceFlow id="f46" sourceRef="m2" targetRef="createRes" />
    <bpmn:sequenceFlow id="f47" sourceRef="createRes" targetRef="sendRes" />
    <bpmn:sequenceFlow id="f48" sourceRef="sendRes" targetRef="csMerge" />
    <bpmn:sequenceFlow id="f49" name="automatic resource restoration required" sourceRef="gw3" targetRef="createReq" />
    <bpmn:sequenceFlow id="f50" sourceRef="createReq" targetRef="sendReq" />
    <bpmn:sequenceFlow id="f51" sourceRef="sendReq" targetRef="receiveTS" />
    <bpmn:sequenceFlow id="f52" sourceRef="receiveTS" targetRef="m2" />
    <bpmn:sequenceFlow id="f53" sourceRef="csMerge" targetRef="pg1" />
    <bpmn:sequenceFlow id="f54" sourceRef="pg1" targetRef="createRep" />
    <bpmn:sequenceFlow id="f55" sourceRef="createRep" targetRef="sendRep" />
    <bpmn:sequenceFlow id="f56" sourceRef="sendRep" targetRef="pgs" />
    <bpmn:sequenceFlow id="f57" sourceRef="pgs" targetRef="join" />
    <bpmn:sequenceFlow id="f58" sourceRef="pgs" targetRef="custReceive" />
    <bpmn:sequenceFlow id="f59" sourceRef="custReceive" targetRef="endCust" />
    <bpmn:sequenceFlow id="f60" sourceRef="pg1" targetRef="rebate" />
    <bpmn:sequenceFlow id="f61" sourceRef="rebate" targetRef="adjust" />
    <bpmn:sequenceFlow id="f62" sourceRef="adjust" targetRef="join" />
    <bpmn:sequenceFlow id="f63" sourceRef="join" targetRef="endCS" />
  </bpmn:process>
</bpmn:definitions>
