<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-cs" name="Customer Service">
        <bpmn:flowNodeRef>t_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_prio_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_signif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendDetail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_csmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-es" name="Electronic service">
        <bpmn:flowNodeRef>t_signif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-sm" name="Service Management">
        <bpmn:flowNodeRef>t_invest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_analyz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_smmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_resmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendResol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recvTS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_prob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analyzeP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_troubleRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rpmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ebg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_term</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corrRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendTS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-bc" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>t_bill</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="s" name="Service degradation perceived" />
    <bpmn:task id="t_send" name="Send list of problem parameters" />
    <bpmn:receiveTask id="t_recv" name="Receive report about service performance and problem resolution" />
    <bpmn:endEvent id="e_cust" name="Customer process ended" />

    <bpmn:task id="t_enter" name="Enter problem report into system T" />
    <bpmn:task id="t_compare" name="Compare problem report to customer SLA" />
    <bpmn:exclusiveGateway id="g_prio_merge" />
    <bpmn:task id="t_measures" name="Determine counter measures and priorities" />
    <bpmn:serviceTask id="t_signif" name="Determine significance of customer" />
    <bpmn:exclusiveGateway id="g_premium" name="Customer premium?" />
    <bpmn:callActivity id="call_extra" name="Link to extra problem fix process" calledElement="extra-fix-process" />
    <bpmn:endEvent id="e_extra" name="Extra problem fix process started" />
    <bpmn:exclusiveGateway id="g_signif" name="Significance affects counter measures?" />
    <bpmn:task id="t_detail" name="Create detailed problem report" />
    <bpmn:task id="t_sendDetail" name="Send detailed problem report to Service Management" />

    <bpmn:task id="t_invest" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="g_analyz" name="Analyzable by Service Management?" />
    <bpmn:task id="t_sendRP" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="t_analysis" name="Perform analysis" />
    <bpmn:task id="t_trouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="g_smmerge" />
    <bpmn:task id="t_final" name="Prepare final status report" />
    <bpmn:task id="t_decide" name="Determine counter measures" />
    <bpmn:exclusiveGateway id="g_measures" name="Which counter measures are required?" />
    <bpmn:task id="t_perf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="t_corr" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="g_resmerge" />
    <bpmn:task id="t_resol" name="Create problem resolution report" />
    <bpmn:task id="t_sendResol" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="t_req" name="Create request for automatic resource restoration" />
    <bpmn:task id="t_sendReq" name="Send restoration request to Resource Provisioning" />
    <bpmn:receiveTask id="t_recvTS" name="Receive trouble-shooting report" />

    <bpmn:task id="t_check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="g_prob" name="Problem detected?" />
    <bpmn:task id="t_normal" name="Create notification about normal service execution" />
    <bpmn:task id="t_analyzeP" name="Analyze problem" />
    <bpmn:task id="t_troubleRP" name="Create trouble report" />
    <bpmn:exclusiveGateway id="g_rpmerge" />
    <bpmn:task id="t_status" name="Include report in status report" />
    <bpmn:task id="t_sendStatus" name="Send status report to Service Management" />
    <bpmn:eventBasedGateway id="g_ebg" />
    <bpmn:intermediateCatchEvent id="ev_req" name="Restoration request received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev_timer" name="2 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_term" name="Process terminated">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="t_track" name="Track all possible errors" />
    <bpmn:task id="t_corrRP" name="Undertake necessary corrective actions" />
    <bpmn:task id="t_ts" name="Create trouble-shooting report" />
    <bpmn:task id="t_sendTS" name="Send trouble-shooting report to Service Management" />

    <bpmn:exclusiveGateway id="g_csmerge" />
    <bpmn:parallelGateway id="g_split" />
    <bpmn:task id="t_report" name="Create report for customer" />
    <bpmn:task id="t_sendReport" name="Send report to customer" />
    <bpmn:parallelGateway id="g_split2" />
    <bpmn:task id="t_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:task id="t_bill" name="Adjust billing" />
    <bpmn:parallelGateway id="g_join" />
    <bpmn:endEvent id="e_cs" name="Customer Service process ended" />

    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="t_send" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_send" targetRef="t_enter" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_enter" targetRef="t_compare" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_compare" targetRef="g_prio_merge" />
    <bpmn:sequenceFlow id="f5" sourceRef="g_prio_merge" targetRef="t_measures" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_measures" targetRef="t_signif" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_signif" targetRef="g_premium" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="g_premium" targetRef="call_extra" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="g_premium" targetRef="g_signif" />
    <bpmn:sequenceFlow id="f10" sourceRef="call_extra" targetRef="e_extra" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="g_signif" targetRef="g_prio_merge" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="g_signif" targetRef="t_detail" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_detail" targetRef="t_sendDetail" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_sendDetail" targetRef="t_invest" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_invest" targetRef="g_analyz" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="g_analyz" targetRef="t_sendRP" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="g_analyz" targetRef="t_analysis" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_analysis" targetRef="t_trouble" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_trouble" targetRef="g_smmerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_sendRP" targetRef="t_check" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_check" targetRef="g_prob" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="g_prob" targetRef="t_normal" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="g_prob" targetRef="t_analyzeP" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_analyzeP" targetRef="t_troubleRP" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_normal" targetRef="g_rpmerge" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_troubleRP" targetRef="g_rpmerge" />
    <bpmn:sequenceFlow id="f27" sourceRef="g_rpmerge" targetRef="t_status" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_status" targetRef="t_sendStatus" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_sendStatus" targetRef="g_smmerge" />
    <bpmn:sequenceFlow id="f30" sourceRef="g_smmerge" targetRef="t_final" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_final" targetRef="t_decide" />
    <bpmn:sequenceFlow id="f32" sourceRef="t_decide" targetRef="g_measures" />
    <bpmn:sequenceFlow id="f33" name="no problem detected" sourceRef="g_measures" targetRef="t_perf" />
    <bpmn:sequenceFlow id="f34" name="minor corrective actions" sourceRef="g_measures" targetRef="t_corr" />
    <bpmn:sequenceFlow id="f35" name="automatic resource restoration" sourceRef="g_measures" targetRef="t_req" />
    <bpmn:sequenceFlow id="f36" sourceRef="t_perf" targetRef="g_csmerge" />
    <bpmn:sequenceFlow id="f37" sourceRef="t_corr" targetRef="g_resmerge" />
    <bpmn:sequenceFlow id="f38" sourceRef="g_resmerge" targetRef="t_resol" />
    <bpmn:sequenceFlow id="f39" sourceRef="t_resol" targetRef="t_sendResol" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_sendResol" targetRef="g_csmerge" />
    <bpmn:sequenceFlow id="f41" sourceRef="t_req" targetRef="t_sendReq" />
    <bpmn:sequenceFlow id="f42" sourceRef="t_sendReq" targetRef="g_ebg" />
    <bpmn:sequenceFlow id="f43" sourceRef="g_ebg" targetRef="ev_req" />
    <bpmn:sequenceFlow id="f44" sourceRef="g_ebg" targetRef="ev_timer" />
    <bpmn:sequenceFlow id="f45" sourceRef="ev_timer" targetRef="e_term" />
    <bpmn:sequenceFlow id="f46" sourceRef="ev_req" targetRef="t_track" />
    <bpmn:sequenceFlow id="f47" sourceRef="t_track" targetRef="t_corrRP" />
    <bpmn:sequenceFlow id="f48" sourceRef="t_corrRP" targetRef="t_ts" />
    <bpmn:sequenceFlow id="f49" sourceRef="t_ts" targetRef="t_sendTS" />
    <bpmn:sequenceFlow id="f50" sourceRef="t_sendTS" targetRef="t_recvTS" />
    <bpmn:sequenceFlow id="f51" sourceRef="t_recvTS" targetRef="g_resmerge" />
    <bpmn:sequenceFlow id="f52" sourceRef="g_csmerge" targetRef="g_split" />
    <bpmn:sequenceFlow id="f53" sourceRef="g_split" targetRef="t_report" />
    <bpmn:sequenceFlow id="f54" sourceRef="g_split" targetRef="t_rebate" />
    <bpmn:sequenceFlow id="f55" sourceRef="t_report" targetRef="t_sendReport" />
    <bpmn:sequenceFlow id="f56" sourceRef="t_sendReport" targetRef="g_split2" />
    <bpmn:sequenceFlow id="f57" sourceRef="g_split2" targetRef="g_join" />
    <bpmn:sequenceFlow id="f58" sourceRef="g_split2" targetRef="t_recv" />
    <bpmn:sequenceFlow id="f59" sourceRef="t_rebate" targetRef="t_bill" />
    <bpmn:sequenceFlow id="f60" sourceRef="t_bill" targetRef="g_join" />
    <bpmn:sequenceFlow id="f61" sourceRef="g_join" targetRef="e_cs" />
    <bpmn:sequenceFlow id="f62" sourceRef="t_recv" targetRef="e_cust" />
  </bpmn:process>
</bpmn:definitions>
