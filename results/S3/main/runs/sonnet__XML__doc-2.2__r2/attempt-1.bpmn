<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Power supplier" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_checkcontract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CS" name="Customer Service">
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_exist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_newobj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ciscontract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_wd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_wd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CIS" name="CIS">
        <bpmn:flowNodeRef>t_checkdocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GO" name="Grid Operator">
        <bpmn:flowNodeRef>t_checkconc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_conc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendbill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OLD" name="Old Supplier">
        <bpmn:flowNodeRef>t_createbill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendfinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Switch-over requested" />
    <bpmn:task id="t_transmit" name="Transmit customer data to customer service" />
    <bpmn:task id="t_receive" name="Receive customer data" />
    <bpmn:task id="t_enter" name="Enter customer data object into CRM system" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t_compare" name="Compare customer data with internal customer database" />
    <bpmn:task id="t_check" name="Check data for completeness and plausibility" />
    <bpmn:exclusiveGateway id="g_err" name="Errors found?" />
    <bpmn:task id="t_correct" name="Correct errors using error list" />
    <bpmn:exclusiveGateway id="g_exist" name="Customer exists in database?" />
    <bpmn:task id="t_newobj" name="Create new customer object" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:exclusiveGateway id="m3" />
    <bpmn:task id="t_prepare" name="Prepare contract documents" />
    <bpmn:task id="t_checkdocs" name="Check contract documents automatically" />
    <bpmn:exclusiveGateway id="g_docs" name="Contract documents generated correctly?" />
    <bpmn:task id="t_analyze" name="Analyze and resolve issues" />
    <bpmn:task id="t_sendconf" name="Send confirmation document to customer" />
    <bpmn:task id="t_request" name="Send request to grid operator" />
    <bpmn:task id="t_checkconc" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="t_response" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="g_conc" name="Supplier concurrence?" />
    <bpmn:task id="t_inform" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:endEvent id="end_conflict" name="Switch-over stopped due to supplier concurrence" />
    <bpmn:task id="t_terminate" name="Terminate sales agreement with old supplier" />
    <bpmn:task id="t_ciscontract" name="Create CIS contract" />
    <bpmn:task id="t_checkcontract" name="Check contract details" />
    <bpmn:eventBasedGateway id="evg" />
    <bpmn:intermediateCatchEvent id="ev_conf" name="Confirmation received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev_wd" name="Withdrawal received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev_timer" name="7 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_wd" name="Customer withdrew from contract" />
    <bpmn:exclusiveGateway id="m4" />
    <bpmn:parallelGateway id="p_split" />
    <bpmn:task id="t_meter" name="Transmit meter data to customer service and old supplier" />
    <bpmn:task id="t_import" name="Import meter data to systems" />
    <bpmn:task id="t_compute" name="Compute final billing based on meter data" />
    <bpmn:task id="t_sendbill" name="Send final billing to old supplier" />
    <bpmn:task id="t_createbill" name="Create final billing" />
    <bpmn:task id="t_sendfinal" name="Send final billing to customer" />
    <bpmn:parallelGateway id="p_join" />
    <bpmn:endEvent id="end_ok" name="New customer won" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_transmit" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_transmit" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_receive" targetRef="t_enter" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_enter" targetRef="m1" />
    <bpmn:sequenceFlow id="f5" sourceRef="m1" targetRef="t_compare" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_compare" targetRef="t_check" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_check" targetRef="g_err" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="g_err" targetRef="t_correct" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="g_err" targetRef="g_exist" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_correct" targetRef="m1" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="g_exist" targetRef="t_newobj" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="g_exist" targetRef="m2" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_newobj" targetRef="m2" />
    <bpmn:sequenceFlow id="f14" sourceRef="m2" targetRef="m3" />
    <bpmn:sequenceFlow id="f15" sourceRef="m3" targetRef="t_prepare" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_prepare" targetRef="t_checkdocs" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_checkdocs" targetRef="g_docs" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="g_docs" targetRef="t_analyze" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="g_docs" targetRef="t_sendconf" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_analyze" targetRef="m3" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_sendconf" targetRef="t_request" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_request" targetRef="t_checkconc" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_checkconc" targetRef="t_response" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_response" targetRef="g_conc" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="g_conc" targetRef="t_inform" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="g_conc" targetRef="t_terminate" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_inform" targetRef="end_conflict" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_terminate" targetRef="t_ciscontract" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_ciscontract" targetRef="t_checkcontract" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_checkcontract" targetRef="evg" />
    <bpmn:sequenceFlow id="f31" sourceRef="evg" targetRef="ev_conf" />
    <bpmn:sequenceFlow id="f32" sourceRef="evg" targetRef="ev_wd" />
    <bpmn:sequenceFlow id="f33" sourceRef="evg" targetRef="ev_timer" />
    <bpmn:sequenceFlow id="f34" sourceRef="ev_wd" targetRef="end_wd" />
    <bpmn:sequenceFlow id="f35" sourceRef="ev_conf" targetRef="m4" />
    <bpmn:sequenceFlow id="f36" sourceRef="ev_timer" targetRef="m4" />
    <bpmn:sequenceFlow id="f37" sourceRef="m4" targetRef="p_split" />
    <bpmn:sequenceFlow id="f38" sourceRef="p_split" targetRef="t_meter" />
    <bpmn:sequenceFlow id="f39" sourceRef="p_split" targetRef="t_compute" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_meter" targetRef="t_import" />
    <bpmn:sequenceFlow id="f41" sourceRef="t_compute" targetRef="t_sendbill" />
    <bpmn:sequenceFlow id="f42" sourceRef="t_sendbill" targetRef="t_createbill" />
    <bpmn:sequenceFlow id="f43" sourceRef="t_createbill" targetRef="t_sendfinal" />
    <bpmn:sequenceFlow id="f44" sourceRef="t_import" targetRef="p_join" />
    <bpmn:sequenceFlow id="f45" sourceRef="t_sendfinal" targetRef="p_join" />
    <bpmn:sequenceFlow id="f46" sourceRef="p_join" targetRef="end_ok" />
  </bpmn:process>
</bpmn:definitions>
