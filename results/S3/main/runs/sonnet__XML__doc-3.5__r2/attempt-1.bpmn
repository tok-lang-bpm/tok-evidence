<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="registryPool" name="Court Registry Organisation" processRef="mailProcess" />
  </bpmn:collaboration>
  <bpmn:process id="mailProcess" isExecutable="false">
    <bpmn:laneSet id="mailLanes">
      <bpmn:lane id="mpuLane" name="Mail Processing Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="clerkLane" name="Mail Clerk">
        <bpmn:flowNodeRef>sortMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registryLane" name="Registry">
        <bpmn:flowNodeRef>openMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>groupMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="armLane" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>captureMatter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashierLane" name="Cashier">
        <bpmn:flowNodeRef>takeFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capturePartyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endHandled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Daily mail collection due" />
    <bpmn:task id="collect" name="Collect the mail from the party" />
    <bpmn:task id="sortMail" name="Sort the unopened mail into the business areas" />
    <bpmn:task id="distribute" name="Distribute the mail" />
    <bpmn:task id="openMail" name="Open the mail" />
    <bpmn:task id="groupMail" name="Sort the mail into groups for distribution" />
    <bpmn:task id="register" name="Register the mail in the manual incoming Mail Register" />
    <bpmn:task id="check" name="Perform a quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" default="fNo" />
    <bpmn:task id="compile" name="Compile a list of requisition explaining the reason for rejection" />
    <bpmn:task id="sendBack" name="Send the list of requisition back to the party" />
    <bpmn:endEvent id="endRejected" name="Mail rejected" />
    <bpmn:task id="captureMatter" name="Capture the matter details" />
    <bpmn:task id="provide" name="Provide the matter details to the Cashier" />
    <bpmn:task id="takeFees" name="Take the applicable fees attached to the mail" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="envelope" name="Put the receipt and copied documents into an envelope" />
    <bpmn:task id="post" name="Post the envelope to the party" />
    <bpmn:task id="capturePartyDetails" name="Capture the Party Details" />
    <bpmn:task id="printFile" name="Print the Physical Court File" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="endHandled" name="Mail handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="sortMail" />
    <bpmn:sequenceFlow id="f3" sourceRef="sortMail" targetRef="distribute" />
    <bpmn:sequenceFlow id="f4" sourceRef="distribute" targetRef="openMail" />
    <bpmn:sequenceFlow id="f5" sourceRef="openMail" targetRef="groupMail" />
    <bpmn:sequenceFlow id="f6" sourceRef="groupMail" targetRef="register" />
    <bpmn:sequenceFlow id="f7" sourceRef="register" targetRef="check" />
    <bpmn:sequenceFlow id="f8" sourceRef="check" targetRef="compliant" />
    <bpmn:sequenceFlow id="fNo" name="no" sourceRef="compliant" targetRef="compile" />
    <bpmn:sequenceFlow id="fYes" name="yes" sourceRef="compliant" targetRef="captureMatter" />
    <bpmn:sequenceFlow id="f9" sourceRef="compile" targetRef="sendBack" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendBack" targetRef="endRejected" />
    <bpmn:sequenceFlow id="f11" sourceRef="captureMatter" targetRef="provide" />
    <bpmn:sequenceFlow id="f12" sourceRef="provide" targetRef="takeFees" />
    <bpmn:sequenceFlow id="f13" sourceRef="takeFees" targetRef="split" />
    <bpmn:sequenceFlow id="f14" sourceRef="split" targetRef="envelope" />
    <bpmn:sequenceFlow id="f15" sourceRef="split" targetRef="capturePartyDetails" />
    <bpmn:sequenceFlow id="f16" sourceRef="envelope" targetRef="post" />
    <bpmn:sequenceFlow id="f17" sourceRef="capturePartyDetails" targetRef="printFile" />
    <bpmn:sequenceFlow id="f18" sourceRef="post" targetRef="join" />
    <bpmn:sequenceFlow id="f19" sourceRef="printFile" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="join" targetRef="endHandled" />
  </bpmn:process>
</bpmn:definitions>
