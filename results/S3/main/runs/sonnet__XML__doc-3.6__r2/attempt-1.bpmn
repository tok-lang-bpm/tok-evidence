<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="claims-process" />
  </bpmn:collaboration>
  <bpmn:process id="claims-process" isExecutable="false">
    <bpmn:laneSet id="claims-lanes">
      <bpmn:lane id="handler" name="Claims handler">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSimple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severityMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveUpdated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Claims Management system">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Claim received" />
    <bpmn:task id="checkInsured" name="Check whether the claimant is insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" default="f5" />
    <bpmn:task id="informReject" name="Inform the claimant that the claim must be rejected" />
    <bpmn:endEvent id="rejected" name="Claim rejected" />
    <bpmn:task id="evaluate" name="Evaluate the severity of the claim" />
    <bpmn:exclusiveGateway id="severity" name="Claim simple or complex?" default="f8" />
    <bpmn:task id="sendSimple" name="Send relevant forms for simple claim" />
    <bpmn:task id="sendComplex" name="Send relevant forms for complex claim" />
    <bpmn:exclusiveGateway id="severityMerge" />
    <bpmn:task id="receiveForms" name="Receive the returned forms" />
    <bpmn:exclusiveGateway id="checkMerge" />
    <bpmn:task id="checkForms" name="Check the forms for completeness" />
    <bpmn:exclusiveGateway id="complete" name="Forms provide all relevant details?" default="f15" />
    <bpmn:task id="informUpdate" name="Inform the claimant to update the forms" />
    <bpmn:task id="receiveUpdated" name="Receive the updated forms" />
    <bpmn:task id="register" name="Register the claim in the Claims Management system" />
    <bpmn:endEvent id="registered" name="Claim registered" />
    <bpmn:sequenceFlow id="f1" sourceRef="received" targetRef="checkInsured" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkInsured" targetRef="insured" />
    <bpmn:sequenceFlow id="f3" name="no" sourceRef="insured" targetRef="informReject" />
    <bpmn:sequenceFlow id="f4" sourceRef="informReject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="insured" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f6" sourceRef="evaluate" targetRef="severity" />
    <bpmn:sequenceFlow id="f7" name="simple" sourceRef="severity" targetRef="sendSimple" />
    <bpmn:sequenceFlow id="f8" name="complex" sourceRef="severity" targetRef="sendComplex" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendSimple" targetRef="severityMerge" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendComplex" targetRef="severityMerge" />
    <bpmn:sequenceFlow id="f11" sourceRef="severityMerge" targetRef="receiveForms" />
    <bpmn:sequenceFlow id="f12" sourceRef="receiveForms" targetRef="checkMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="checkMerge" targetRef="checkForms" />
    <bpmn:sequenceFlow id="f14" sourceRef="checkForms" targetRef="complete" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="complete" targetRef="informUpdate" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="complete" targetRef="register" />
    <bpmn:sequenceFlow id="f17" sourceRef="informUpdate" targetRef="receiveUpdated" />
    <bpmn:sequenceFlow id="f18" sourceRef="receiveUpdated" targetRef="checkMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="register" targetRef="registered" />
  </bpmn:process>
</bpmn:definitions>
