<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Loan approval" processRef="loan-process" />
  </bpmn:collaboration>
  <bpmn:process id="loan-process" isExecutable="false">
    <bpmn:laneSet id="loan-lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>receive-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-loan" name="Loan approval service">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-risk" name="Risk assessment Web service">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-approver" name="Approver Web service">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Loan request received" />
    <bpmn:task id="receive-request" name="Receive the customer request for a loan amount" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="decision" name="Which outcome of the assessment?" />
    <bpmn:task id="approve" name="Approve the loan" />
    <bpmn:task id="deny" name="Deny the loan" />
    <bpmn:task id="send-request" name="Send the request to the approver Web service" />
    <bpmn:task id="review" name="Review the request" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="receive-feedback" name="Receive the feedback" />
    <bpmn:endEvent id="end-done" name="Customer informed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive-request" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive-request" targetRef="assess" />
    <bpmn:sequenceFlow id="f3" sourceRef="assess" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="small loan and low risk" sourceRef="decision" targetRef="approve" />
    <bpmn:sequenceFlow id="f5" name="high risk" sourceRef="decision" targetRef="deny" />
    <bpmn:sequenceFlow id="f6" name="further review needed or amount $10,000 or more" sourceRef="decision" targetRef="send-request" />
    <bpmn:sequenceFlow id="f7" sourceRef="send-request" targetRef="review" />
    <bpmn:sequenceFlow id="f8" sourceRef="approve" targetRef="merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="deny" targetRef="merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="review" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="merge" targetRef="receive-feedback" />
    <bpmn:sequenceFlow id="f12" sourceRef="receive-feedback" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
