<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <bpmn:laneSet id="expense-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment-system" name="Payment system">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase the product or service" />
    <bpmn:task id="submit" name="Submit the expense report" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" default="f6" />
    <bpmn:task id="edit" name="Edit the expense report" />
    <bpmn:task id="check" name="Check the receipts against the items" />
    <bpmn:exclusiveGateway id="inorder" name="All in order?" default="f9" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:serviceTask id="pay" name="Link to the payment system" />
    <bpmn:intermediateCatchEvent id="confirmation" name="Payment confirmed">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" name="Expenses paid" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f2" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f3" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f4" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="approved" targetRef="check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reportApproved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="approved" targetRef="edit" />
    <bpmn:sequenceFlow id="f7" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f8" sourceRef="check" targetRef="inorder" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="inorder" targetRef="edit" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="inorder" targetRef="accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allInOrder == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="accept" targetRef="pay" />
    <bpmn:sequenceFlow id="f12" sourceRef="pay" targetRef="confirmation" />
    <bpmn:sequenceFlow id="f13" sourceRef="confirmation" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
