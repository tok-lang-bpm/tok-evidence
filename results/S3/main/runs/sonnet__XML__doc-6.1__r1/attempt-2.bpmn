<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting Employee">
        <bpmn:flowNodeRef>a_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_forwardcm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ccm" name="Cost Center Manager">
        <bpmn:flowNodeRef>m_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial Manager">
        <bpmn:flowNodeRef>c_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_amtmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>b_check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="s_start" name="Invoice arrived" />
    <bpmn:task id="s_receive" name="Receive invoice in central inbox" />
    <bpmn:task id="s_inspect" name="Inspect invoice visually" />
    <bpmn:task id="s_forward" name="Forward invoice to accounting employee" />

    <bpmn:task id="a_identify" name="Identify charging supplier" />
    <bpmn:task id="a_create" name="Create invoice instance" />
    <bpmn:task id="a_checkitems" name="Check invoice items" />
    <bpmn:task id="a_note" name="Note cost centers and cost center managers on docket" />
    <bpmn:task id="a_send" name="Send docket and copy of invoice to first cost center manager" />

    <bpmn:exclusiveGateway id="m_merge" />
    <bpmn:task id="m_review" name="Review content of invoice for accuracy" />
    <bpmn:exclusiveGateway id="m_acc" name="Everything in order?" default="fm_no" />
    <bpmn:task id="m_ap" name="Note AP on docket" />
    <bpmn:exclusiveGateway id="m_more" name="Further cost center managers?" default="fm_more_no" />
    <bpmn:task id="m_next" name="Pass copy of invoice to next cost center manager" />
    <bpmn:task id="m_reject" name="Reject AP with note and statement on docket" />

    <bpmn:task id="a_clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:task id="a_resend" name="Send copy of invoice to cost center managers again" />
    <bpmn:task id="a_forwardcm" name="Forward copy of invoice to commercial manager" />

    <bpmn:exclusiveGateway id="c_merge" />
    <bpmn:task id="c_audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="c_complaint" name="Complaint?" default="fc_no" />
    <bpmn:task id="a_complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="c_approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="c_amount" name="Amount exceeds EUR 20?" default="fa_no" />
    <bpmn:task id="b_check" name="Check invoice again" />
    <bpmn:exclusiveGateway id="c_amtmerge" />
    <bpmn:task id="c_return" name="Return copy of invoice and docket to accounting employee in signature file" />

    <bpmn:task id="a_pay" name="Give payment instructions" />
    <bpmn:task id="a_close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="a_end" name="Invoice processed" />

    <bpmn:sequenceFlow id="f1" sourceRef="s_start" targetRef="s_receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="s_receive" targetRef="s_inspect" />
    <bpmn:sequenceFlow id="f3" sourceRef="s_inspect" targetRef="s_forward" />
    <bpmn:sequenceFlow id="f4" sourceRef="s_forward" targetRef="a_identify" />
    <bpmn:sequenceFlow id="f5" sourceRef="a_identify" targetRef="a_create" />
    <bpmn:sequenceFlow id="f6" sourceRef="a_create" targetRef="a_checkitems" />
    <bpmn:sequenceFlow id="f7" sourceRef="a_checkitems" targetRef="a_note" />
    <bpmn:sequenceFlow id="f8" sourceRef="a_note" targetRef="a_send" />
    <bpmn:sequenceFlow id="f9" sourceRef="a_send" targetRef="m_merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="m_merge" targetRef="m_review" />
    <bpmn:sequenceFlow id="f11" sourceRef="m_review" targetRef="m_acc" />
    <bpmn:sequenceFlow id="fm_yes" name="yes" sourceRef="m_acc" targetRef="m_ap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">everythingInOrder == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fm_no" name="no" sourceRef="m_acc" targetRef="m_reject" />
    <bpmn:sequenceFlow id="f12" sourceRef="m_ap" targetRef="m_more" />
    <bpmn:sequenceFlow id="fm_more_yes" name="yes" sourceRef="m_more" targetRef="m_next">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">furtherManagers == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fm_more_no" name="no" sourceRef="m_more" targetRef="a_forwardcm" />
    <bpmn:sequenceFlow id="f13" sourceRef="m_next" targetRef="m_merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="m_reject" targetRef="a_clarify" />
    <bpmn:sequenceFlow id="f15" sourceRef="a_clarify" targetRef="a_resend" />
    <bpmn:sequenceFlow id="f16" sourceRef="a_resend" targetRef="m_merge" />
    <bpmn:sequenceFlow id="f17" sourceRef="a_forwardcm" targetRef="c_merge" />
    <bpmn:sequenceFlow id="f18" sourceRef="c_merge" targetRef="c_audit" />
    <bpmn:sequenceFlow id="f19" sourceRef="c_audit" targetRef="c_complaint" />
    <bpmn:sequenceFlow id="fc_yes" name="yes" sourceRef="c_complaint" targetRef="a_complaint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complaint == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fc_no" name="no" sourceRef="c_complaint" targetRef="c_approve" />
    <bpmn:sequenceFlow id="f20" sourceRef="a_complaint" targetRef="c_merge" />
    <bpmn:sequenceFlow id="f21" sourceRef="c_approve" targetRef="c_amount" />
    <bpmn:sequenceFlow id="fa_yes" name="yes" sourceRef="c_amount" targetRef="b_check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &gt; 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fa_no" name="no" sourceRef="c_amount" targetRef="c_amtmerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="b_check" targetRef="c_amtmerge" />
    <bpmn:sequenceFlow id="f23" sourceRef="c_amtmerge" targetRef="c_return" />
    <bpmn:sequenceFlow id="f24" sourceRef="c_return" targetRef="a_pay" />
    <bpmn:sequenceFlow id="f25" sourceRef="a_pay" targetRef="a_close" />
    <bpmn:sequenceFlow id="f26" sourceRef="a_close" targetRef="a_end" />
  </bpmn:process>
</bpmn:definitions>
