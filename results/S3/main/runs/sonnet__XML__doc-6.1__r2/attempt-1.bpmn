<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="lane-secretariat" name="Secretariat">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-accounting" name="Accounting employee">
        <bpmn:flowNodeRef>t_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consultmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fwdcomm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-ccm" name="Cost center manager">
        <bpmn:flowNodeRef>g_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_allap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-commercial" name="Commercial manager">
        <bpmn:flowNodeRef>g_auditmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_amountmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_movefile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-board" name="Board">
        <bpmn:flowNodeRef>t_boardcheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Invoice received" />
    <bpmn:task id="t_receive" name="Receive the invoice in the central inbox" />
    <bpmn:task id="t_inspect" name="Inspect the invoice visually" />
    <bpmn:task id="t_forward" name="Forward the invoice to an accounting employee" />
    <bpmn:task id="t_identify" name="Identify the charging supplier" />
    <bpmn:task id="t_create" name="Create a new invoice instance" />
    <bpmn:task id="t_checkitems" name="Check the invoice items" />
    <bpmn:task id="t_docket" name="Note cost centers and cost center managers on the docket" />
    <bpmn:task id="t_send" name="Send the docket and the copy of the invoice to the first cost center manager" />
    <bpmn:exclusiveGateway id="g_enter" />
    <bpmn:task id="t_review" name="Review the content of the invoice for accuracy" />
    <bpmn:exclusiveGateway id="g_ok" name="Everything in order?" />
    <bpmn:task id="t_ap" name="Note accurate position code on the docket" />
    <bpmn:task id="t_return" name="Return the copy of the invoice to the internal mail" />
    <bpmn:exclusiveGateway id="g_allap" name="All positions marked AP?" />
    <bpmn:task id="t_reject" name="Reject the AP with note and statement on the docket" />
    <bpmn:task id="t_clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:exclusiveGateway id="g_consult" name="Consultation of cost center managers necessary?" />
    <bpmn:task id="t_consult" name="Consult the cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="g_consultmerge" />
    <bpmn:task id="t_resend" name="Send the copy of the invoice to the cost center managers again" />
    <bpmn:task id="t_fwdcomm" name="Forward the copy of the invoice to the commercial manager" />
    <bpmn:exclusiveGateway id="g_auditmerge" />
    <bpmn:task id="t_audit" name="Make the commercial audit" />
    <bpmn:exclusiveGateway id="g_complaint" name="Complaint?" />
    <bpmn:task id="t_resolve" name="Resolve the complaint with the supplier" />
    <bpmn:task id="t_approve" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="g_amount" name="Bill amount exceeds EUR 20?" />
    <bpmn:task id="t_boardcheck" name="Check the invoice again" />
    <bpmn:exclusiveGateway id="g_amountmerge" />
    <bpmn:task id="t_movefile" name="Move the copy of the invoice and the docket back to the accounting employee" />
    <bpmn:task id="t_pay" name="Give payment instructions" />
    <bpmn:task id="t_close" name="Close the instance in ACME Financial Accounting" />
    <bpmn:endEvent id="end" name="Invoice processed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_receive" targetRef="t_inspect" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_inspect" targetRef="t_forward" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_forward" targetRef="t_identify" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_identify" targetRef="t_create" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_create" targetRef="t_checkitems" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_checkitems" targetRef="t_docket" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_docket" targetRef="t_send" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_send" targetRef="g_enter" />
    <bpmn:sequenceFlow id="f10" sourceRef="g_enter" targetRef="t_review" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_review" targetRef="g_ok" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="g_ok" targetRef="t_ap" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="g_ok" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_ap" targetRef="t_return" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_return" targetRef="g_allap" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="g_allap" targetRef="g_enter" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="g_allap" targetRef="t_fwdcomm" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_reject" targetRef="t_clarify" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_clarify" targetRef="g_consult" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="g_consult" targetRef="t_consult" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="g_consult" targetRef="g_consultmerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_consult" targetRef="g_consultmerge" />
    <bpmn:sequenceFlow id="f23" sourceRef="g_consultmerge" targetRef="t_resend" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_resend" targetRef="g_enter" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_fwdcomm" targetRef="g_auditmerge" />
    <bpmn:sequenceFlow id="f26" sourceRef="g_auditmerge" targetRef="t_audit" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_audit" targetRef="g_complaint" />
    <bpmn:sequenceFlow id="f28" name="yes" sourceRef="g_complaint" targetRef="t_resolve" />
    <bpmn:sequenceFlow id="f29" name="no" sourceRef="g_complaint" targetRef="t_approve" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_resolve" targetRef="g_auditmerge" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_approve" targetRef="g_amount" />
    <bpmn:sequenceFlow id="f32" name="yes" sourceRef="g_amount" targetRef="t_boardcheck" />
    <bpmn:sequenceFlow id="f33" name="no" sourceRef="g_amount" targetRef="g_amountmerge" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_boardcheck" targetRef="g_amountmerge" />
    <bpmn:sequenceFlow id="f35" sourceRef="g_amountmerge" targetRef="t_movefile" />
    <bpmn:sequenceFlow id="f36" sourceRef="t_movefile" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f37" sourceRef="t_pay" targetRef="t_close" />
    <bpmn:sequenceFlow id="f38" sourceRef="t_close" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
