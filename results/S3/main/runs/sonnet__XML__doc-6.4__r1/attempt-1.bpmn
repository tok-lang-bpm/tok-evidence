<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_src</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_exh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_src</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>t_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_det</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_left</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>t_acq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_lost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>m_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pres_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_callback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>t_pres_p</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Potential customer needed" />
    <bpmn:exclusiveGateway id="g_src" name="How are contact details obtained?" />
    <bpmn:task id="t_buy" name="Buy contact details for cold calls" />
    <bpmn:task id="t_exh" name="Participate in an exhibition" />
    <bpmn:task id="t_know" name="Get contact details of an interested acquaintance" />
    <bpmn:exclusiveGateway id="m_src" />

    <bpmn:task id="t_call" name="Call the customer" />
    <bpmn:task id="t_det" name="Determine the contact person and the budget" />
    <bpmn:task id="t_ask" name="Ask the customer about general interest" />
    <bpmn:exclusiveGateway id="g_int" name="Customer interested?" />
    <bpmn:exclusiveGateway id="g_budget" name="Project budget huge?" />
    <bpmn:endEvent id="end_left" name="Customer left alone" />

    <bpmn:task id="t_acq" name="Acquire the customer personally" />
    <bpmn:exclusiveGateway id="g_end" name="Customer interested in the end?" />
    <bpmn:endEvent id="end_lost" name="Customer not acquired" />

    <bpmn:exclusiveGateway id="m_pres" />
    <bpmn:exclusiveGateway id="g_tech" name="More technical presentation?" />
    <bpmn:task id="t_pres_s" name="Give the online presentation" />
    <bpmn:task id="t_pres_p" name="Give the technical online presentation" />
    <bpmn:exclusiveGateway id="m_tech" />
    <bpmn:eventBasedGateway id="g_wait" />
    <bpmn:intermediateCatchEvent id="e_msg" name="Customer contacts us">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e_timer" name="2 weeks without contact">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_callback" name="Call the customer again" />
    <bpmn:exclusiveGateway id="m_quote" />
    <bpmn:task id="t_quote" name="Create a quotation" />
    <bpmn:endEvent id="end_ok" name="Quotation created" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="g_src" />
    <bpmn:sequenceFlow id="f2" name="buy details" sourceRef="g_src" targetRef="t_buy" />
    <bpmn:sequenceFlow id="f3" name="exhibition" sourceRef="g_src" targetRef="t_exh" />
    <bpmn:sequenceFlow id="f4" name="personal acquaintance" sourceRef="g_src" targetRef="t_know" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_buy" targetRef="m_src" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_exh" targetRef="m_src" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_know" targetRef="m_src" />
    <bpmn:sequenceFlow id="f8" sourceRef="m_src" targetRef="t_call" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_call" targetRef="t_det" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_det" targetRef="t_ask" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_ask" targetRef="g_int" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="g_int" targetRef="m_pres" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="g_int" targetRef="g_budget" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="g_budget" targetRef="end_left" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="g_budget" targetRef="t_acq" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_acq" targetRef="g_end" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="g_end" targetRef="m_pres" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="g_end" targetRef="end_lost" />
    <bpmn:sequenceFlow id="f19" sourceRef="m_pres" targetRef="g_tech" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="g_tech" targetRef="t_pres_s" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="g_tech" targetRef="t_pres_p" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_pres_s" targetRef="m_tech" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_pres_p" targetRef="m_tech" />
    <bpmn:sequenceFlow id="f24" sourceRef="m_tech" targetRef="g_wait" />
    <bpmn:sequenceFlow id="f25" sourceRef="g_wait" targetRef="e_msg" />
    <bpmn:sequenceFlow id="f26" sourceRef="g_wait" targetRef="e_timer" />
    <bpmn:sequenceFlow id="f27" sourceRef="e_timer" targetRef="t_callback" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_callback" targetRef="m_quote" />
    <bpmn:sequenceFlow id="f29" sourceRef="e_msg" targetRef="m_quote" />
    <bpmn:sequenceFlow id="f30" sourceRef="m_quote" targetRef="t_quote" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_quote" targetRef="end_ok" />
  </bpmn:process>
</bpmn:definitions>
