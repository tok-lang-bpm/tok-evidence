<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="recruitment-process" />
  </bpmn:collaboration>
  <bpmn:process id="recruitment-process" isExecutable="false">
    <bpmn:laneSet id="recruitment-lanes">
      <bpmn:lane id="lane-organisation" name="Organisation">
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suitable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="demand" name="Functional department demands to fill a post" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="receive" name="Receive the applications" />
    <bpmn:task id="check" name="Check the applications" />
    <bpmn:exclusiveGateway id="suitable" name="Suitable applicant found?" default="f7" />
    <bpmn:task id="conclude" name="Conclude the contract of employment" />
    <bpmn:endEvent id="filled" name="Post filled" />
    <bpmn:sequenceFlow id="f1" sourceRef="demand" targetRef="merge" />
    <bpmn:sequenceFlow id="f2" sourceRef="merge" targetRef="advertise" />
    <bpmn:sequenceFlow id="f3" sourceRef="advertise" targetRef="receive" />
    <bpmn:sequenceFlow id="f4" sourceRef="receive" targetRef="check" />
    <bpmn:sequenceFlow id="f5" sourceRef="check" targetRef="suitable" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="suitable" targetRef="conclude" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="suitable" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="conclude" targetRef="filled" />
  </bpmn:process>
</bpmn:definitions>
