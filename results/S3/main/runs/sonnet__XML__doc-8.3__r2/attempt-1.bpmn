<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="vacancy-process" />
  </bpmn:collaboration>
  <bpmn:process id="vacancy-process" isExecutable="false">
    <bpmn:laneSet id="vacancy-lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>mergeQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeDescribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:exclusiveGateway id="mergeQuestions" />
    <bpmn:exclusiveGateway id="questions" name="Questions about tasks and requirements?" default="f5" />
    <bpmn:task id="ask" name="Ask questions about tasks and requirements" />
    <bpmn:task id="clarify" name="Clarify tasks and requirements" />
    <bpmn:exclusiveGateway id="mergeDescribe" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corrections" name="Corrections needed?" default="f11" />
    <bpmn:task id="askCorrections" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:endEvent id="end" name="Job description approved" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="mergeQuestions" />
    <bpmn:sequenceFlow id="f3" sourceRef="mergeQuestions" targetRef="questions" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="questions" targetRef="ask" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="questions" targetRef="mergeDescribe" />
    <bpmn:sequenceFlow id="f6" sourceRef="ask" targetRef="clarify" />
    <bpmn:sequenceFlow id="f7" sourceRef="clarify" targetRef="mergeQuestions" />
    <bpmn:sequenceFlow id="f8" sourceRef="mergeDescribe" targetRef="describe" />
    <bpmn:sequenceFlow id="f9" sourceRef="describe" targetRef="review" />
    <bpmn:sequenceFlow id="f10" sourceRef="review" targetRef="corrections" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="corrections" targetRef="approve" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="corrections" targetRef="askCorrections" />
    <bpmn:sequenceFlow id="f13" sourceRef="askCorrections" targetRef="mergeDescribe" />
    <bpmn:sequenceFlow id="f14" sourceRef="approve" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
