<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Account defaulter process" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE" name="Account defaulter process">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endMain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endMessage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Weekday morning">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>0 0 8 ? * MON-FRI</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:subProcess id="sp1" name="Register and report defaulting accounts">
      <bpmn:startEvent id="s1" name="Backup due" />
      <bpmn:task id="backup" name="Back up the database" />
      <bpmn:task id="checkTable" name="Check the Account Defaulter table for new records" />
      <bpmn:exclusiveGateway id="g1" name="New records found?" />
      <bpmn:task id="checkCrm1" name="Check the CRM system for new returns" />
      <bpmn:exclusiveGateway id="g2" name="New returns exist?" />
      <bpmn:exclusiveGateway id="m1" />
      <bpmn:task id="register" name="Register all defaulting accounts and customers" />
      <bpmn:exclusiveGateway id="g3" name="Defaulting client codes previously advised?" />
      <bpmn:task id="produce" name="Produce another table of defaulting accounts" />
      <bpmn:task id="send" name="Send the table to account management" />
      <bpmn:exclusiveGateway id="m2" />
      <bpmn:endEvent id="e1" name="Defaulting account report completed" />
      <bpmn:endEvent id="eNo" name="No new returns" />
      <bpmn:sequenceFlow id="a1" sourceRef="s1" targetRef="backup" />
      <bpmn:sequenceFlow id="a2" sourceRef="backup" targetRef="checkTable" />
      <bpmn:sequenceFlow id="a3" sourceRef="checkTable" targetRef="g1" />
      <bpmn:sequenceFlow id="a4" name="yes" sourceRef="g1" targetRef="m1" />
      <bpmn:sequenceFlow id="a5" name="no" sourceRef="g1" targetRef="checkCrm1" />
      <bpmn:sequenceFlow id="a6" sourceRef="checkCrm1" targetRef="g2" />
      <bpmn:sequenceFlow id="a7" name="yes" sourceRef="g2" targetRef="m1" />
      <bpmn:sequenceFlow id="a8" name="no" sourceRef="g2" targetRef="eNo" />
      <bpmn:sequenceFlow id="a9" sourceRef="m1" targetRef="register" />
      <bpmn:sequenceFlow id="a10" sourceRef="register" targetRef="g3" />
      <bpmn:sequenceFlow id="a11" name="no" sourceRef="g3" targetRef="produce" />
      <bpmn:sequenceFlow id="a12" name="yes" sourceRef="g3" targetRef="m2" />
      <bpmn:sequenceFlow id="a13" sourceRef="produce" targetRef="send" />
      <bpmn:sequenceFlow id="a14" sourceRef="send" targetRef="m2" />
      <bpmn:sequenceFlow id="a15" sourceRef="m2" targetRef="e1" />
    </bpmn:subProcess>

    <bpmn:boundaryEvent id="b1" name="2:30 pm reached" attachedToRef="sp1" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate>14:30</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="alert" name="Send an alert to the supervisor" />
    <bpmn:endEvent id="endAlert" name="Supervisor alerted" />

    <bpmn:subProcess id="sp2" name="Reconcile the defaulters table">
      <bpmn:startEvent id="s2" name="Report completed" />
      <bpmn:task id="checkCrm2" name="Check the CRM system for new returns" />
      <bpmn:exclusiveGateway id="g4" name="New returns filed?" />
      <bpmn:task id="reconcile" name="Reconcile with the existing account defaulters table" />
      <bpmn:endEvent id="e2" name="Table reconciled" />
      <bpmn:endEvent id="e3" name="No new returns filed" />
      <bpmn:sequenceFlow id="c1" sourceRef="s2" targetRef="checkCrm2" />
      <bpmn:sequenceFlow id="c2" sourceRef="checkCrm2" targetRef="g4" />
      <bpmn:sequenceFlow id="c3" name="yes" sourceRef="g4" targetRef="reconcile" />
      <bpmn:sequenceFlow id="c4" name="no" sourceRef="g4" targetRef="e3" />
      <bpmn:sequenceFlow id="c5" sourceRef="reconcile" targetRef="e2" />
    </bpmn:subProcess>

    <bpmn:boundaryEvent id="b2" name="4:00 pm reached" attachedToRef="sp2" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate>16:00</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="message" name="Send a message to the supervisor" />
    <bpmn:endEvent id="endMessage" name="Supervisor messaged" />

    <bpmn:endEvent id="endMain" name="Daily process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sp1" />
    <bpmn:sequenceFlow id="f2" sourceRef="sp1" targetRef="sp2" />
    <bpmn:sequenceFlow id="f3" sourceRef="sp2" targetRef="endMain" />
    <bpmn:sequenceFlow id="f4" sourceRef="b1" targetRef="alert" />
    <bpmn:sequenceFlow id="f5" sourceRef="alert" targetRef="endAlert" />
    <bpmn:sequenceFlow id="f6" sourceRef="b2" targetRef="message" />
    <bpmn:sequenceFlow id="f7" sourceRef="message" targetRef="endMessage" />
  </bpmn:process>
</bpmn:definitions>
