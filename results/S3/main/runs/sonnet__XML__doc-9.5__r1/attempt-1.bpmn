<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Expense reimbursement" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-system" name="Finance system">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inprogress-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-employee" name="Employee">
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Expense report received" />
    <bpmn:subProcess id="handle" name="Process the expense report">
      <bpmn:startEvent id="s-start" />
      <bpmn:exclusiveGateway id="g-account" name="Employee has an account?" />
      <bpmn:task id="create-account" name="Create a new account" />
      <bpmn:exclusiveGateway id="g-account-merge" />
      <bpmn:task id="review" name="Review the expense report for automatic approval" />
      <bpmn:exclusiveGateway id="g-amount" name="Amount under $200?" />
      <bpmn:task id="auto-approve" name="Approve the expense report automatically" />
      <bpmn:task id="sup-approve" name="Approve the expense report by the supervisor" />
      <bpmn:exclusiveGateway id="g-approved" name="Request approved?" />
      <bpmn:exclusiveGateway id="g-approval-merge" />
      <bpmn:task id="reject-notice" name="Send the rejection notice by email" />
      <bpmn:task id="reimburse" name="Reimburse the direct deposit bank account" />
      <bpmn:endEvent id="s-rejected" name="Report rejected" />
      <bpmn:endEvent id="s-reimbursed" name="Report reimbursed" />
      <bpmn:sequenceFlow id="sf1" sourceRef="s-start" targetRef="g-account" />
      <bpmn:sequenceFlow id="sf2" name="no" sourceRef="g-account" targetRef="create-account" />
      <bpmn:sequenceFlow id="sf3" name="yes" sourceRef="g-account" targetRef="g-account-merge" />
      <bpmn:sequenceFlow id="sf4" sourceRef="create-account" targetRef="g-account-merge" />
      <bpmn:sequenceFlow id="sf5" sourceRef="g-account-merge" targetRef="review" />
      <bpmn:sequenceFlow id="sf6" sourceRef="review" targetRef="g-amount" />
      <bpmn:sequenceFlow id="sf7" name="yes" sourceRef="g-amount" targetRef="auto-approve" />
      <bpmn:sequenceFlow id="sf8" name="no" sourceRef="g-amount" targetRef="sup-approve" />
      <bpmn:sequenceFlow id="sf9" sourceRef="auto-approve" targetRef="g-approval-merge" />
      <bpmn:sequenceFlow id="sf10" sourceRef="sup-approve" targetRef="g-approved" />
      <bpmn:sequenceFlow id="sf11" name="yes" sourceRef="g-approved" targetRef="g-approval-merge" />
      <bpmn:sequenceFlow id="sf12" name="no" sourceRef="g-approved" targetRef="reject-notice" />
      <bpmn:sequenceFlow id="sf13" sourceRef="g-approval-merge" targetRef="reimburse" />
      <bpmn:sequenceFlow id="sf14" sourceRef="reject-notice" targetRef="s-rejected" />
      <bpmn:sequenceFlow id="sf15" sourceRef="reimburse" targetRef="s-reimbursed" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="t7" name="7 days" attachedToRef="handle" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="t30" name="30 days" attachedToRef="handle" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="progress" name="Send the approval in progress email" />
    <bpmn:task id="cancel" name="Send the cancellation notice by email" />
    <bpmn:task id="resubmit" name="Re-submit the expense report" />
    <bpmn:endEvent id="handled" name="Expense report handled" />
    <bpmn:endEvent id="inprogress-end" name="Employee informed" />
    <bpmn:endEvent id="cancelled-end" name="Expense report re-submitted" />
    <bpmn:sequenceFlow id="f1" sourceRef="received" targetRef="handle" />
    <bpmn:sequenceFlow id="f2" sourceRef="handle" targetRef="handled" />
    <bpmn:sequenceFlow id="f3" sourceRef="t7" targetRef="progress" />
    <bpmn:sequenceFlow id="f4" sourceRef="progress" targetRef="inprogress-end" />
    <bpmn:sequenceFlow id="f5" sourceRef="t30" targetRef="cancel" />
    <bpmn:sequenceFlow id="f6" sourceRef="cancel" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f7" sourceRef="resubmit" targetRef="cancelled-end" />
  </bpmn:process>
</bpmn:definitions>
