<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Custom Bicycle Manufacturing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Custom Bicycle Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Custom Bicycle Manufacturing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sales" name="Sales Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_storehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_engineering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>process_part_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_quantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>part_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>part_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering Department">
        <bpmn:flowNodeRef>prepare_assembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Receive order" />
    <bpmn:exclusiveGateway id="decision" name="Order accepted?" />
    <bpmn:task id="reject" name="Reject order" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:task id="accept" name="Accept order" />
    <bpmn:task id="inform_storehouse" name="Inform storehouse" />
    <bpmn:task id="inform_engineering" name="Inform engineering" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="ship" name="Ship bicycle" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:task id="process_part_list" name="Process part list" />
    <bpmn:task id="check_quantity" name="Check required quantity" default="f-check_quantity-part_done" />
    <bpmn:exclusiveGateway id="part_available" name="Part available?" />
    <bpmn:task id="reserve" name="Reserve part" />
    <bpmn:task id="back_order" name="Back-order part" />
    <bpmn:task id="part_done" name="Part processing completed" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="prepare_assembly" name="Prepare assembling" />
    <bpmn:task id="assemble" name="Assemble bicycle" />
    <bpmn:sequenceFlow id="f-start-decision" sourceRef="start" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="Reject" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-accept" name="Accept" sourceRef="decision" targetRef="accept" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-inform_storehouse" sourceRef="accept" targetRef="inform_storehouse" />
    <bpmn:sequenceFlow id="f-inform_storehouse-inform_engineering" sourceRef="inform_storehouse" targetRef="inform_engineering" />
    <bpmn:sequenceFlow id="f-inform_engineering-split" sourceRef="inform_engineering" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-process_part_list" sourceRef="split" targetRef="process_part_list" />
    <bpmn:sequenceFlow id="f-split-prepare_assembly" sourceRef="split" targetRef="prepare_assembly" />
    <bpmn:sequenceFlow id="f-process_part_list-check_quantity" sourceRef="process_part_list" targetRef="check_quantity" />
    <bpmn:sequenceFlow id="f-check_quantity-part_available" sourceRef="check_quantity" targetRef="part_available" />
    <bpmn:sequenceFlow id="f-part_available-reserve" name="yes" sourceRef="part_available" targetRef="reserve" />
    <bpmn:sequenceFlow id="f-part_available-back_order" name="no" sourceRef="part_available" targetRef="back_order" />
    <bpmn:sequenceFlow id="f-reserve-check_quantity" sourceRef="reserve" targetRef="check_quantity" />
    <bpmn:sequenceFlow id="f-back_order-check_quantity" sourceRef="back_order" targetRef="check_quantity" />
    <bpmn:sequenceFlow id="f-check_quantity-part_done" sourceRef="check_quantity" targetRef="part_done" />
    <bpmn:sequenceFlow id="f-part_done-join" sourceRef="part_done" targetRef="join" />
    <bpmn:sequenceFlow id="f-prepare_assembly-join" sourceRef="prepare_assembly" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-assemble" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-completed" sourceRef="ship" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
