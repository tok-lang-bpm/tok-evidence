<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Custom Bicycle Manufacturing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Small Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Custom Bicycle Manufacturing" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales Department">
        <bpmn:flowNodeRef>start_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship_bicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>part_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve_part</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder_part</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more_items</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering Department">
        <bpmn:flowNodeRef>inform_engineering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_assembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble_bicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_order" name="Order received" />
    <bpmn:exclusiveGateway id="decision_accept" name="Order accepted?" />
    <bpmn:task id="reject_order" name="Reject order" />
    <bpmn:task id="accept_order" name="Accept order" />
    <bpmn:parallelGateway id="split" name="Parallel split" />
    <bpmn:task id="ship_bicycle" name="Ship bicycle to customer" />
    <bpmn:endEvent id="process_completed" name="Process completed" />
    <bpmn:exclusiveGateway id="part_available" name="Part available?" />
    <bpmn:task id="reserve_part" name="Reserve part" />
    <bpmn:task id="backorder_part" name="Back-order part" />
    <bpmn:exclusiveGateway id="more_items" name="More items?" />
    <bpmn:task id="inform_engineering" name="Inform engineering" />
    <bpmn:task id="prepare_assembly" name="Prepare assembly" />
    <bpmn:parallelGateway id="join" name="Parallel join" />
    <bpmn:task id="assemble_bicycle" name="Assemble bicycle" />
    <bpmn:sequenceFlow id="f-start_order-decision_accept" sourceRef="start_order" targetRef="decision_accept" />
    <bpmn:sequenceFlow id="f-decision_accept-reject_order" name="no" sourceRef="decision_accept" targetRef="reject_order" />
    <bpmn:sequenceFlow id="f-reject_order-process_completed" sourceRef="reject_order" targetRef="process_completed" />
    <bpmn:sequenceFlow id="f-decision_accept-accept_order" name="yes" sourceRef="decision_accept" targetRef="accept_order" />
    <bpmn:sequenceFlow id="f-accept_order-split" sourceRef="accept_order" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-part_available" sourceRef="split" targetRef="part_available" />
    <bpmn:sequenceFlow id="f-split-inform_engineering" sourceRef="split" targetRef="inform_engineering" />
    <bpmn:sequenceFlow id="f-inform_engineering-prepare_assembly" sourceRef="inform_engineering" targetRef="prepare_assembly" />
    <bpmn:sequenceFlow id="f-prepare_assembly-join" sourceRef="prepare_assembly" targetRef="join" />
    <bpmn:sequenceFlow id="f-part_available-reserve_part" name="yes" sourceRef="part_available" targetRef="reserve_part" />
    <bpmn:sequenceFlow id="f-part_available-backorder_part" name="no" sourceRef="part_available" targetRef="backorder_part" />
    <bpmn:sequenceFlow id="f-reserve_part-more_items" sourceRef="reserve_part" targetRef="more_items" />
    <bpmn:sequenceFlow id="f-backorder_part-more_items" sourceRef="backorder_part" targetRef="more_items" />
    <bpmn:sequenceFlow id="f-more_items-part_available" name="yes" sourceRef="more_items" targetRef="part_available" />
    <bpmn:sequenceFlow id="f-more_items-join" name="no" sourceRef="more_items" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-assemble_bicycle" sourceRef="join" targetRef="assemble_bicycle" />
    <bpmn:sequenceFlow id="f-assemble_bicycle-ship_bicycle" sourceRef="assemble_bicycle" targetRef="ship_bicycle" />
    <bpmn:sequenceFlow id="f-ship_bicycle-process_completed" sourceRef="ship_bicycle" targetRef="process_completed" />
  </bpmn:process>
</bpmn:definitions>
