<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room Service Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room Service Process" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room‑Service Manager">
        <bpmn:flowNodeRef>start_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_waiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_parallel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare_food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>wine_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch_wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ready_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sync_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill_now</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_call" name="Guest calls room service" />
    <bpmn:task id="take_order" name="Take down the order" />
    <bpmn:task id="submit_ticket" name="Submit order ticket to kitchen" />
    <bpmn:task id="give_order" name="Give order to sommelier" />
    <bpmn:task id="assign_waiter" name="Assign order to waiter" />
    <bpmn:parallelGateway id="split_parallel" name="Parallel split" />
    <bpmn:task id="prepare_food" name="Prepare food" />
    <bpmn:exclusiveGateway id="wine_needed" name="Wine or alcoholic beverage needed?" />
    <bpmn:task id="fetch_wine" name="Fetch wine and prepare alcoholic beverages" />
    <bpmn:task id="ready_cart" name="Ready cart and prepare non‑alcoholic drinks" />
    <bpmn:parallelGateway id="sync_ready" name="Sync after tasks" />
    <bpmn:task id="deliver" name="Deliver food, wine, and cart to guest room" />
    <bpmn:exclusiveGateway id="bill_now" name="Bill now?" />
    <bpmn:task id="wait_billing" name="Wait for next order before billing" />
    <bpmn:task id="debit_account" name="Debit guest account" />
    <bpmn:endEvent id="end_process" name="Room service completed" />
    <bpmn:sequenceFlow id="f-start_call-take_order" sourceRef="start_call" targetRef="take_order" />
    <bpmn:sequenceFlow id="f-take_order-submit_ticket" sourceRef="take_order" targetRef="submit_ticket" />
    <bpmn:sequenceFlow id="f-submit_ticket-give_order" sourceRef="submit_ticket" targetRef="give_order" />
    <bpmn:sequenceFlow id="f-give_order-assign_waiter" sourceRef="give_order" targetRef="assign_waiter" />
    <bpmn:sequenceFlow id="f-assign_waiter-split_parallel" sourceRef="assign_waiter" targetRef="split_parallel" />
    <bpmn:sequenceFlow id="f-split_parallel-prepare_food" sourceRef="split_parallel" targetRef="prepare_food" />
    <bpmn:sequenceFlow id="f-split_parallel-ready_cart" sourceRef="split_parallel" targetRef="ready_cart" />
    <bpmn:sequenceFlow id="f-split_parallel-wine_needed" sourceRef="split_parallel" targetRef="wine_needed" />
    <bpmn:sequenceFlow id="f-wine_needed-fetch_wine" name="yes" sourceRef="wine_needed" targetRef="fetch_wine" />
    <bpmn:sequenceFlow id="f-wine_needed-sync_ready" name="no" sourceRef="wine_needed" targetRef="sync_ready" />
    <bpmn:sequenceFlow id="f-fetch_wine-sync_ready" sourceRef="fetch_wine" targetRef="sync_ready" />
    <bpmn:sequenceFlow id="f-prepare_food-sync_ready" sourceRef="prepare_food" targetRef="sync_ready" />
    <bpmn:sequenceFlow id="f-ready_cart-sync_ready" sourceRef="ready_cart" targetRef="sync_ready" />
    <bpmn:sequenceFlow id="f-sync_ready-deliver" sourceRef="sync_ready" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-bill_now" sourceRef="deliver" targetRef="bill_now" />
    <bpmn:sequenceFlow id="f-bill_now-debit_account" name="yes" sourceRef="bill_now" targetRef="debit_account" />
    <bpmn:sequenceFlow id="f-bill_now-wait_billing" name="no" sourceRef="bill_now" targetRef="wait_billing" />
    <bpmn:sequenceFlow id="f-wait_billing-debit_account" sourceRef="wait_billing" targetRef="debit_account" />
    <bpmn:sequenceFlow id="f-debit_account-end_process" sourceRef="debit_account" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
