<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room Service Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room Service Process" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>T_take_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_submit_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_give_to_sommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_assign_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>K_prepare_food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>SM_fetch_wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>W_ready_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_wait_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="guest calls room service" />
    <bpmn:task id="T_take_order" name="take down the order" />
    <bpmn:task id="T_submit_ticket" name="submit order ticket to kitchen" />
    <bpmn:task id="T_give_to_sommelier" name="give order to sommelier" />
    <bpmn:task id="T_assign_order" name="assign order to waiter" />
    <bpmn:task id="K_prepare_food" name="prepare food" />
    <bpmn:task id="SM_fetch_wine" name="fetch wine and prepare alcoholic beverages" />
    <bpmn:task id="W_ready_cart" name="ready cart and prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="PG_split" name="Parallel split" />
    <bpmn:parallelGateway id="PG_join" name="Parallel join" />
    <bpmn:task id="W_deliver" name="deliver food, wine and cart to guest's room" />
    <bpmn:task id="W_return" name="return to room-service station" />
    <bpmn:exclusiveGateway id="G_pending" name="another order pending?" />
    <bpmn:task id="W_wait_billing" name="wait to do billing" />
    <bpmn:task id="W_debit" name="debit guest's account" />
    <bpmn:endEvent id="E_end" name="order completed" />
    <bpmn:sequenceFlow id="f-S0-T_take_order" sourceRef="S0" targetRef="T_take_order" />
    <bpmn:sequenceFlow id="f-T_take_order-T_submit_ticket" sourceRef="T_take_order" targetRef="T_submit_ticket" />
    <bpmn:sequenceFlow id="f-T_submit_ticket-T_give_to_sommelier" sourceRef="T_submit_ticket" targetRef="T_give_to_sommelier" />
    <bpmn:sequenceFlow id="f-T_give_to_sommelier-T_assign_order" sourceRef="T_give_to_sommelier" targetRef="T_assign_order" />
    <bpmn:sequenceFlow id="f-T_assign_order-PG_split" sourceRef="T_assign_order" targetRef="PG_split" />
    <bpmn:sequenceFlow id="f-PG_split-K_prepare_food" sourceRef="PG_split" targetRef="K_prepare_food" />
    <bpmn:sequenceFlow id="f-PG_split-SM_fetch_wine" sourceRef="PG_split" targetRef="SM_fetch_wine" />
    <bpmn:sequenceFlow id="f-PG_split-W_ready_cart" sourceRef="PG_split" targetRef="W_ready_cart" />
    <bpmn:sequenceFlow id="f-K_prepare_food-PG_join" sourceRef="K_prepare_food" targetRef="PG_join" />
    <bpmn:sequenceFlow id="f-SM_fetch_wine-PG_join" sourceRef="SM_fetch_wine" targetRef="PG_join" />
    <bpmn:sequenceFlow id="f-W_ready_cart-PG_join" sourceRef="W_ready_cart" targetRef="PG_join" />
    <bpmn:sequenceFlow id="f-PG_join-W_deliver" sourceRef="PG_join" targetRef="W_deliver" />
    <bpmn:sequenceFlow id="f-W_deliver-W_return" sourceRef="W_deliver" targetRef="W_return" />
    <bpmn:sequenceFlow id="f-W_return-G_pending" sourceRef="W_return" targetRef="G_pending" />
    <bpmn:sequenceFlow id="f-G_pending-W_wait_billing" name="yes" sourceRef="G_pending" targetRef="W_wait_billing" />
    <bpmn:sequenceFlow id="f-W_wait_billing-W_debit" sourceRef="W_wait_billing" targetRef="W_debit" />
    <bpmn:sequenceFlow id="f-G_pending-W_debit" name="no" sourceRef="G_pending" targetRef="W_debit" />
    <bpmn:sequenceFlow id="f-W_debit-E_end" sourceRef="W_debit" targetRef="E_end" />
  </bpmn:process>
</bpmn:definitions>
