<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IPO Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Company" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="IPO Process" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="c" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="u" name="Underwriters">
        <bpmn:flowNodeRef>t_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_blue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_not_handled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_non_compliant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Decision to go public" />
    <bpmn:task id="t_select" name="Select underwriters" />
    <bpmn:task id="t_assess" name="Assess facts fairness" />
    <bpmn:exclusiveGateway id="g_fair" name="Facts presented fairly?" />
    <bpmn:task id="t_advice" name="Provide procedural and financial advice" />
    <bpmn:task id="t_prepare" name="Prepare registration statement" />
    <bpmn:parallelGateway id="g_split" name="Parallel split after registration" />
    <bpmn:task id="t_register" name="Register with SEC" />
    <bpmn:task id="t_await" name="Await SEC clearance" />
    <bpmn:task id="t_fix" name="Fix issue price" />
    <bpmn:parallelGateway id="g_join" name="Parallel join before commitment" />
    <bpmn:task id="t_check" name="Check blue-sky compliance" />
    <bpmn:exclusiveGateway id="g_blue" name="Blue-sky compliance?" />
    <bpmn:task id="t_roadshow" name="Arrange road show" />
    <bpmn:task id="t_commit" name="Enter firm commitment to buy stock" />
    <bpmn:task id="t_offer" name="Offer to public" />
    <bpmn:endEvent id="e_offered" name="Issue offered to public" />
    <bpmn:endEvent id="e_not_handled" name="Issue not handled" />
    <bpmn:endEvent id="e_non_compliant" name="Non‑compliant" />
    <bpmn:sequenceFlow id="f-s-t_select" sourceRef="s" targetRef="t_select" />
    <bpmn:sequenceFlow id="f-t_select-t_assess" sourceRef="t_select" targetRef="t_assess" />
    <bpmn:sequenceFlow id="f-t_assess-g_fair" sourceRef="t_assess" targetRef="g_fair" />
    <bpmn:sequenceFlow id="f-g_fair-t_advice" name="yes" sourceRef="g_fair" targetRef="t_advice" />
    <bpmn:sequenceFlow id="f-g_fair-e_not_handled" name="no" sourceRef="g_fair" targetRef="e_not_handled" />
    <bpmn:sequenceFlow id="f-t_advice-t_prepare" sourceRef="t_advice" targetRef="t_prepare" />
    <bpmn:sequenceFlow id="f-t_prepare-g_split" sourceRef="t_prepare" targetRef="g_split" />
    <bpmn:sequenceFlow id="f-g_split-t_register" sourceRef="g_split" targetRef="t_register" />
    <bpmn:sequenceFlow id="f-g_split-t_check" sourceRef="g_split" targetRef="t_check" />
    <bpmn:sequenceFlow id="f-g_split-t_roadshow" sourceRef="g_split" targetRef="t_roadshow" />
    <bpmn:sequenceFlow id="f-t_register-t_await" sourceRef="t_register" targetRef="t_await" />
    <bpmn:sequenceFlow id="f-t_await-t_fix" sourceRef="t_await" targetRef="t_fix" />
    <bpmn:sequenceFlow id="f-t_fix-g_join" sourceRef="t_fix" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-t_check-g_blue" sourceRef="t_check" targetRef="g_blue" />
    <bpmn:sequenceFlow id="f-g_blue-g_join" name="yes" sourceRef="g_blue" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_blue-e_non_compliant" name="no" sourceRef="g_blue" targetRef="e_non_compliant" />
    <bpmn:sequenceFlow id="f-t_roadshow-g_join" sourceRef="t_roadshow" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_join-t_commit" sourceRef="g_join" targetRef="t_commit" />
    <bpmn:sequenceFlow id="f-t_commit-t_offer" sourceRef="t_commit" targetRef="t_offer" />
    <bpmn:sequenceFlow id="f-t_offer-e_offered" sourceRef="t_offer" targetRef="e_offered" />
  </bpmn:process>
</bpmn:definitions>
