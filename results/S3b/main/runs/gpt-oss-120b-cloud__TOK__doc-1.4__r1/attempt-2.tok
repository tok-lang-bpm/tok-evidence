tok 1.0 "IPO Process"

pool p "Company"
  lane c "Company"
    start s "Decision to go public"
    task t_select "Select underwriters"
  lane u "Underwriters"
    task t_assess "Assess facts fairness"
    xor g_fair "Facts presented fairly?"
    task t_advice "Provide procedural and financial advice"
    task t_prepare "Prepare registration statement"
    and g_split "Parallel split after registration"
    task t_register "Register with SEC"
    task t_await "Await SEC clearance"
    task t_fix "Fix issue price"
    and g_join "Parallel join before commitment"
    task t_check "Check blue-sky compliance"
    xor g_blue "Blue-sky compliance?"
    task t_roadshow "Arrange road show"
    task t_commit "Enter firm commitment to buy stock"
    task t_offer "Offer to public"
    end e_offered "Issue offered to public"
    end e_not_handled "Issue not handled"
    end e_non_compliant "Non‑compliant"

flow s -> t_select
flow t_select -> t_assess
flow t_assess -> g_fair
flow g_fair -> t_advice "yes"
flow g_fair -> e_not_handled "no"
flow t_advice -> t_prepare
flow t_prepare -> g_split
flow g_split -> t_register
flow g_split -> t_check
flow g_split -> t_roadshow
flow t_register -> t_await
flow t_await -> t_fix
flow t_fix -> g_join
flow t_check -> g_blue
flow g_blue -> g_join "yes"
flow g_blue -> e_non_compliant "no"
flow t_roadshow -> g_join
flow g_join -> t_commit
flow t_commit -> t_offer
flow t_offer -> e_offered
