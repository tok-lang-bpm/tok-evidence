<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IPO Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="IPO Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>facts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_handled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixprice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>abort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Decision to go public" />
    <bpmn:task id="select" name="Select underwriters" />
    <bpmn:exclusiveGateway id="facts" name="Facts presented fairly?" />
    <bpmn:endEvent id="not_handled" name="Underwriters refuse to handle issue" />
    <bpmn:task id="advice" name="Provide procedural and financial advice" />
    <bpmn:task id="buy" name="Buy the issue" />
    <bpmn:task id="resell" name="Resell the issue to public" />
    <bpmn:task id="prepare" name="Prepare registration statement" />
    <bpmn:task id="submit" name="Submit registration statement to SEC" />
    <bpmn:parallelGateway id="split" name="Parallel after submission" />
    <bpmn:task id="roadshow" name="Arrange road show" />
    <bpmn:task id="check" name="Check blue-sky law compliance" />
    <bpmn:parallelGateway id="join" name="Wait for all preparations" />
    <bpmn:task id="fixprice" name="Fix issue price" />
    <bpmn:exclusiveGateway id="reason" name="Any reason not to proceed?" />
    <bpmn:endEvent id="abort" name="Process aborted" />
    <bpmn:task id="commit" name="Enter firm commitment to buy stock" />
    <bpmn:task id="offer" name="Offer stock to public" />
    <bpmn:endEvent id="completed" name="IPO process completed" />
    <bpmn:task id="approve" name="Approve registration statement" />
    <bpmn:sequenceFlow id="f-start-select" sourceRef="start" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-facts" sourceRef="select" targetRef="facts" />
    <bpmn:sequenceFlow id="f-facts-not_handled" name="no" sourceRef="facts" targetRef="not_handled" />
    <bpmn:sequenceFlow id="f-facts-advice" name="yes" sourceRef="facts" targetRef="advice" />
    <bpmn:sequenceFlow id="f-advice-buy" sourceRef="advice" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-resell" sourceRef="buy" targetRef="resell" />
    <bpmn:sequenceFlow id="f-resell-prepare" sourceRef="resell" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-submit" sourceRef="prepare" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-split" sourceRef="submit" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-roadshow" sourceRef="split" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-split-approve" sourceRef="split" targetRef="approve" />
    <bpmn:sequenceFlow id="f-split-check" sourceRef="split" targetRef="check" />
    <bpmn:sequenceFlow id="f-roadshow-join" sourceRef="roadshow" targetRef="join" />
    <bpmn:sequenceFlow id="f-approve-join" sourceRef="approve" targetRef="join" />
    <bpmn:sequenceFlow id="f-check-join" sourceRef="check" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-fixprice" sourceRef="join" targetRef="fixprice" />
    <bpmn:sequenceFlow id="f-fixprice-reason" sourceRef="fixprice" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-abort" name="yes" sourceRef="reason" targetRef="abort" />
    <bpmn:sequenceFlow id="f-reason-commit" name="no" sourceRef="reason" targetRef="commit" />
    <bpmn:sequenceFlow id="f-commit-offer" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-completed" sourceRef="offer" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
