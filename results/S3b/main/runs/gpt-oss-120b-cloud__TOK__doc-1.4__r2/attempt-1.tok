tok 1.0 "IPO Process"

pool org "Organization"
  lane company "Company"
    start start "Decision to go public"
    task select "Select underwriters"
    xor facts "Facts presented fairly?"
    end not_handled "Underwriters refuse to handle issue"

  lane underwriters "Underwriters"
    task advice "Provide procedural and financial advice"
    task buy "Buy the issue"
    task resell "Resell the issue to public"
    task prepare "Prepare registration statement"
    task submit "Submit registration statement to SEC"
    and split "Parallel after submission"
    task roadshow "Arrange road show"
    task check "Check blue-sky law compliance"
    and join "Wait for all preparations"
    task fixprice "Fix issue price"
    xor reason "Any reason not to proceed?"
    end abort "Process aborted"
    task commit "Enter firm commitment to buy stock"
    task offer "Offer stock to public"
    end completed "IPO process completed"

  lane sec "SEC"
    task approve "Approve registration statement"

flow start -> select
flow select -> facts
flow facts -> not_handled "no"
flow facts -> advice "yes"
flow advice -> buy
flow buy -> resell
flow resell -> prepare
flow prepare -> submit
flow submit -> split
flow split -> roadshow
flow split -> approve
flow split -> check
flow roadshow -> join
flow approve -> join
flow check -> join
flow join -> fixprice
flow fixprice -> reason
flow reason -> abort "yes"
flow reason -> commit "no"
flow commit -> offer
flow offer -> completed
