tok 1.0 "Fault detection and resolution process"

pool organisation "Organisation"
  lane fault_detector "Fault Detector"
    start start "Failure reported or suspicion"
    task report_failure "Report failure to MPO"
  lane mpo "MPO"
    task examine_failure "Examine the failure"
    xor decision_confirm "Confirm or reject failure?"
    # Reject path
    end rejected "Failure rejected"
    # Confirm path
    and inform_failure
    task inform_GO_failure "Inform GO about failure"
    task inform_MSP_failure "Inform MSP about failure"
    and informed_failure
    task fix_fault "Fix the fault at the measuring device"
    task share_results "Share repair results with fault detector"
    and inform_resolution
    task inform_GO_resolution "Inform GO about resolution of the interference"
    task inform_MSP_resolution "Inform MSP about resolution of the interference"
    and informed_resolution
    end resolved "Fault resolved"
  lane go "GO"
    # receiving tasks are placed in GO lane
    task inform_GO_failure "Inform GO about failure"
    task inform_GO_resolution "Inform GO about resolution of the interference"
  lane msp "MSP"
    # receiving tasks are placed in MSP lane
    task inform_MSP_failure "Inform MSP about failure"
    task inform_MSP_resolution "Inform MSP about resolution of the interference"

# Sequence flows
flow start -> report_failure
flow report_failure -> examine_failure
flow examine_failure -> decision_confirm
flow decision_confirm -> rejected "reject"
flow decision_confirm -> inform_failure "confirm"

flow inform_failure -> inform_GO_failure
flow inform_failure -> inform_MSP_failure
flow inform_GO_failure -> informed_failure
flow inform_MSP_failure -> informed_failure

flow informed_failure -> fix_fault
flow fix_fault -> share_results
flow share_results -> inform_resolution

flow inform_resolution -> inform_GO_resolution
flow inform_resolution -> inform_MSP_resolution
flow inform_GO_resolution -> informed_resolution
flow inform_MSP_resolution -> informed_resolution

flow informed_resolution -> resolved
