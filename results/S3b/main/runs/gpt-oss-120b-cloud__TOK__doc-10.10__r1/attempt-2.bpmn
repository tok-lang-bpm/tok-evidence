<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Fault detection and resolution process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Fault detection and resolution process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="fault_detector" name="Fault Detector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>examine_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork_notify_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_GO_failure_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_MSP_failure_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_notify_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_fault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share_results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork_notify_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_GO_resolution_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_MSP_resolution_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_notify_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>receive_GO_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_GO_resolution</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>receive_MSP_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_MSP_resolution</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Failure reported or suspicion" />
    <bpmn:task id="report_failure" name="Report failure to MPO" />
    <bpmn:task id="examine_failure" name="Examine the failure" />
    <bpmn:exclusiveGateway id="decision_confirm" name="Confirm or reject failure?" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:parallelGateway id="fork_notify_failure" />
    <bpmn:task id="inform_GO_failure_mpo" name="Inform GO about failure" />
    <bpmn:task id="inform_MSP_failure_mpo" name="Inform MSP about failure" />
    <bpmn:parallelGateway id="join_notify_failure" />
    <bpmn:task id="fix_fault" name="Fix the fault at the measuring device" />
    <bpmn:task id="share_results" name="Share repair results with fault detector" />
    <bpmn:parallelGateway id="fork_notify_resolution" />
    <bpmn:task id="inform_GO_resolution_mpo" name="Inform GO about resolution of the interference" />
    <bpmn:task id="inform_MSP_resolution_mpo" name="Inform MSP about resolution of the interference" />
    <bpmn:parallelGateway id="join_notify_resolution" />
    <bpmn:endEvent id="resolved" name="Fault resolved" />
    <bpmn:task id="receive_GO_failure" name="Receive failure information" />
    <bpmn:task id="receive_GO_resolution" name="Receive resolution information" />
    <bpmn:task id="receive_MSP_failure" name="Receive failure information" />
    <bpmn:task id="receive_MSP_resolution" name="Receive resolution information" />
    <bpmn:sequenceFlow id="f-start-report_failure" sourceRef="start" targetRef="report_failure" />
    <bpmn:sequenceFlow id="f-report_failure-examine_failure" sourceRef="report_failure" targetRef="examine_failure" />
    <bpmn:sequenceFlow id="f-examine_failure-decision_confirm" sourceRef="examine_failure" targetRef="decision_confirm" />
    <bpmn:sequenceFlow id="f-decision_confirm-rejected" name="reject" sourceRef="decision_confirm" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-decision_confirm-fork_notify_failure" name="confirm" sourceRef="decision_confirm" targetRef="fork_notify_failure" />
    <bpmn:sequenceFlow id="f-fork_notify_failure-inform_GO_failure_mpo" sourceRef="fork_notify_failure" targetRef="inform_GO_failure_mpo" />
    <bpmn:sequenceFlow id="f-fork_notify_failure-inform_MSP_failure_mpo" sourceRef="fork_notify_failure" targetRef="inform_MSP_failure_mpo" />
    <bpmn:sequenceFlow id="f-inform_GO_failure_mpo-receive_GO_failure" sourceRef="inform_GO_failure_mpo" targetRef="receive_GO_failure" />
    <bpmn:sequenceFlow id="f-receive_GO_failure-join_notify_failure" sourceRef="receive_GO_failure" targetRef="join_notify_failure" />
    <bpmn:sequenceFlow id="f-inform_MSP_failure_mpo-receive_MSP_failure" sourceRef="inform_MSP_failure_mpo" targetRef="receive_MSP_failure" />
    <bpmn:sequenceFlow id="f-receive_MSP_failure-join_notify_failure" sourceRef="receive_MSP_failure" targetRef="join_notify_failure" />
    <bpmn:sequenceFlow id="f-join_notify_failure-fix_fault" sourceRef="join_notify_failure" targetRef="fix_fault" />
    <bpmn:sequenceFlow id="f-fix_fault-share_results" sourceRef="fix_fault" targetRef="share_results" />
    <bpmn:sequenceFlow id="f-share_results-fork_notify_resolution" sourceRef="share_results" targetRef="fork_notify_resolution" />
    <bpmn:sequenceFlow id="f-fork_notify_resolution-inform_GO_resolution_mpo" sourceRef="fork_notify_resolution" targetRef="inform_GO_resolution_mpo" />
    <bpmn:sequenceFlow id="f-fork_notify_resolution-inform_MSP_resolution_mpo" sourceRef="fork_notify_resolution" targetRef="inform_MSP_resolution_mpo" />
    <bpmn:sequenceFlow id="f-inform_GO_resolution_mpo-receive_GO_resolution" sourceRef="inform_GO_resolution_mpo" targetRef="receive_GO_resolution" />
    <bpmn:sequenceFlow id="f-receive_GO_resolution-join_notify_resolution" sourceRef="receive_GO_resolution" targetRef="join_notify_resolution" />
    <bpmn:sequenceFlow id="f-inform_MSP_resolution_mpo-receive_MSP_resolution" sourceRef="inform_MSP_resolution_mpo" targetRef="receive_MSP_resolution" />
    <bpmn:sequenceFlow id="f-receive_MSP_resolution-join_notify_resolution" sourceRef="receive_MSP_resolution" targetRef="join_notify_resolution" />
    <bpmn:sequenceFlow id="f-join_notify_resolution-resolved" sourceRef="join_notify_resolution" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
