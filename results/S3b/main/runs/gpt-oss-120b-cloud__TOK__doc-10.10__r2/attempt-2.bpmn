<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Fault handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Fault handling process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="fault_detector" name="Fault Detector">
        <bpmn:flowNodeRef>start_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>examine_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_initial_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_GO_initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_MSP_initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_initial_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_fault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share_results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_resolution_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_GO_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_MSP_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_resolution_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_failure" name="Failure reported or suspected" />
    <bpmn:task id="examine_failure" name="Examine the failure" />
    <bpmn:exclusiveGateway id="confirm_failure" name="Failure confirmed?" />
    <bpmn:task id="reject_failure" name="Reject the failure" />
    <bpmn:parallelGateway id="start_initial_inform" />
    <bpmn:task id="inform_GO_initial" name="Inform GO" />
    <bpmn:task id="inform_MSP_initial" name="Inform MSP" />
    <bpmn:parallelGateway id="end_initial_inform" />
    <bpmn:task id="fix_fault" name="Fix the fault at the measuring device" />
    <bpmn:task id="share_results" name="Share repair results with fault detector" />
    <bpmn:parallelGateway id="start_resolution_inform" />
    <bpmn:task id="inform_GO_resolution" name="Inform GO about resolution" />
    <bpmn:task id="inform_MSP_resolution" name="Inform MSP about resolution" />
    <bpmn:parallelGateway id="end_resolution_inform" />
    <bpmn:endEvent id="resolved" name="Resolution handled" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:sequenceFlow id="f-start_failure-examine_failure" sourceRef="start_failure" targetRef="examine_failure" />
    <bpmn:sequenceFlow id="f-examine_failure-confirm_failure" sourceRef="examine_failure" targetRef="confirm_failure" />
    <bpmn:sequenceFlow id="f-confirm_failure-reject_failure" name="reject" sourceRef="confirm_failure" targetRef="reject_failure" />
    <bpmn:sequenceFlow id="f-confirm_failure-start_initial_inform" name="confirm" sourceRef="confirm_failure" targetRef="start_initial_inform" />
    <bpmn:sequenceFlow id="f-reject_failure-rejected" sourceRef="reject_failure" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-start_initial_inform-inform_GO_initial" sourceRef="start_initial_inform" targetRef="inform_GO_initial" />
    <bpmn:sequenceFlow id="f-start_initial_inform-inform_MSP_initial" sourceRef="start_initial_inform" targetRef="inform_MSP_initial" />
    <bpmn:sequenceFlow id="f-inform_GO_initial-end_initial_inform" sourceRef="inform_GO_initial" targetRef="end_initial_inform" />
    <bpmn:sequenceFlow id="f-inform_MSP_initial-end_initial_inform" sourceRef="inform_MSP_initial" targetRef="end_initial_inform" />
    <bpmn:sequenceFlow id="f-end_initial_inform-fix_fault" sourceRef="end_initial_inform" targetRef="fix_fault" />
    <bpmn:sequenceFlow id="f-fix_fault-share_results" sourceRef="fix_fault" targetRef="share_results" />
    <bpmn:sequenceFlow id="f-share_results-start_resolution_inform" sourceRef="share_results" targetRef="start_resolution_inform" />
    <bpmn:sequenceFlow id="f-start_resolution_inform-inform_GO_resolution" sourceRef="start_resolution_inform" targetRef="inform_GO_resolution" />
    <bpmn:sequenceFlow id="f-start_resolution_inform-inform_MSP_resolution" sourceRef="start_resolution_inform" targetRef="inform_MSP_resolution" />
    <bpmn:sequenceFlow id="f-inform_GO_resolution-end_resolution_inform" sourceRef="inform_GO_resolution" targetRef="end_resolution_inform" />
    <bpmn:sequenceFlow id="f-inform_MSP_resolution-end_resolution_inform" sourceRef="inform_MSP_resolution" targetRef="end_resolution_inform" />
    <bpmn:sequenceFlow id="f-end_resolution_inform-resolved" sourceRef="end_resolution_inform" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
