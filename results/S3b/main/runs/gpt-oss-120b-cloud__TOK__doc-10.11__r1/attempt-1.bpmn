<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Measurement Request Process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PROC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_FAIL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_SUCCESS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSP" name="MSP">
        <bpmn:flowNodeRef>CHK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DEC1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DENY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MEAS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DEC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FAIL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRANS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SP" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:task id="REQ" name="GO requests the measurements to the MSP" />
    <bpmn:task id="PROC" name="GO processes the measured values" />
    <bpmn:task id="SEND" name="GO sends the changed values to the MSP" />
    <bpmn:task id="TRAN" name="GO transmits the readings to the SP" />
    <bpmn:endEvent id="END_FAIL" name="Process ended after failure" />
    <bpmn:endEvent id="END_SUCCESS" name="Process ended after success" />
    <bpmn:task id="CHK" name="MSP checks the received request" />
    <bpmn:exclusiveGateway id="DEC1" name="Request denied?" />
    <bpmn:task id="DENY" name="MSP denies the request of the GO" />
    <bpmn:task id="MEAS" name="MSP performs the measurement" />
    <bpmn:exclusiveGateway id="DEC2" name="Measurement failure?" />
    <bpmn:task id="FAIL" name="MSP informs the GO about the failure of the reading" />
    <bpmn:task id="TRANS" name="MSP transmits the measured values to the GO" />
    <bpmn:sequenceFlow id="f-S-REQ" sourceRef="S" targetRef="REQ" />
    <bpmn:sequenceFlow id="f-REQ-CHK" sourceRef="REQ" targetRef="CHK" />
    <bpmn:sequenceFlow id="f-CHK-DEC1" sourceRef="CHK" targetRef="DEC1" />
    <bpmn:sequenceFlow id="f-DEC1-DENY" name="deny" sourceRef="DEC1" targetRef="DENY" />
    <bpmn:sequenceFlow id="f-DEC1-MEAS" name="perform" sourceRef="DEC1" targetRef="MEAS" />
    <bpmn:sequenceFlow id="f-DENY-FAIL" sourceRef="DENY" targetRef="FAIL" />
    <bpmn:sequenceFlow id="f-MEAS-DEC2" sourceRef="MEAS" targetRef="DEC2" />
    <bpmn:sequenceFlow id="f-DEC2-FAIL" name="failure" sourceRef="DEC2" targetRef="FAIL" />
    <bpmn:sequenceFlow id="f-DEC2-TRANS" name="success" sourceRef="DEC2" targetRef="TRANS" />
    <bpmn:sequenceFlow id="f-TRANS-PROC" sourceRef="TRANS" targetRef="PROC" />
    <bpmn:sequenceFlow id="f-PROC-SEND" sourceRef="PROC" targetRef="SEND" />
    <bpmn:sequenceFlow id="f-SEND-TRAN" sourceRef="SEND" targetRef="TRAN" />
    <bpmn:sequenceFlow id="f-TRAN-END_SUCCESS" sourceRef="TRAN" targetRef="END_SUCCESS" />
    <bpmn:sequenceFlow id="f-FAIL-END_FAIL" sourceRef="FAIL" targetRef="END_FAIL" />
  </bpmn:process>
</bpmn:definitions>
