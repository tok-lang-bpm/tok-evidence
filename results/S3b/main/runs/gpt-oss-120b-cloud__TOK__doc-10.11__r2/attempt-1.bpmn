<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Measurement Request Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSP" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_values</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SP" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="request" name="request the measurements" />
    <bpmn:task id="process" name="process the measured values" />
    <bpmn:task id="send_changed" name="send the changed values to the MSP" />
    <bpmn:task id="transmit_SP" name="transmit the readings to the SP" />
    <bpmn:endEvent id="end_success" name="Process completed" />
    <bpmn:endEvent id="end_failure" name="Process ended with failure" />
    <bpmn:task id="check" name="check the received request" />
    <bpmn:exclusiveGateway id="response" name="Request denied or performed?" />
    <bpmn:task id="deny" name="deny the request" />
    <bpmn:task id="perform" name="perform the measurement" />
    <bpmn:task id="inform_failure" name="inform the GO about the failure of the reading" />
    <bpmn:task id="transmit_values" name="transmit the measured values to the GO" />
    <bpmn:sequenceFlow id="f-start-request" sourceRef="start" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-check" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-response" sourceRef="check" targetRef="response" />
    <bpmn:sequenceFlow id="f-response-deny" name="deny" sourceRef="response" targetRef="deny" />
    <bpmn:sequenceFlow id="f-response-perform" name="perform" sourceRef="response" targetRef="perform" />
    <bpmn:sequenceFlow id="f-deny-inform_failure" sourceRef="deny" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="f-inform_failure-end_failure" sourceRef="inform_failure" targetRef="end_failure" />
    <bpmn:sequenceFlow id="f-perform-transmit_values" sourceRef="perform" targetRef="transmit_values" />
    <bpmn:sequenceFlow id="f-transmit_values-process" sourceRef="transmit_values" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-send_changed" sourceRef="process" targetRef="send_changed" />
    <bpmn:sequenceFlow id="f-send_changed-transmit_SP" sourceRef="send_changed" targetRef="transmit_SP" />
    <bpmn:sequenceFlow id="f-transmit_SP-end_success" sourceRef="transmit_SP" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>
