<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Master Data Change Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Master Data Change Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="EC" name="EC">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="tell" name="Tell INQ about change of master data" />
    <bpmn:task id="notify" name="Notify IP of the change" />
    <bpmn:task id="check" name="Check whether master data can be changed at desired time" />
    <bpmn:exclusiveGateway id="decision" name="Can change at desired time?" />
    <bpmn:task id="confirm" name="Confirm changes of INQ" />
    <bpmn:task id="reject" name="Reject changes of INQ" />
    <bpmn:endEvent id="confirmed" name="Changes confirmed" />
    <bpmn:endEvent id="rejected" name="Changes rejected" />
    <bpmn:sequenceFlow id="f-start-tell" sourceRef="start" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-notify" sourceRef="tell" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-check" sourceRef="notify" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-decision" sourceRef="check" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="yes" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
