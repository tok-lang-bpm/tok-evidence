tok 1.0 "Master Data Change Process"

pool org "Organisation"
  lane EC "EC"
    start start "Start"
    task tell "Tell INQ about change of master data"
  lane INQ "INQ"
    task notify "Notify IP of the change"
  lane IP "IP"
    task check "Check whether master data can be changed at desired time"
    xor decision "Can change at desired time?"
    task confirm "Confirm changes of INQ"
    task reject "Reject changes of INQ"
    end confirmed "Changes confirmed"
    end rejected "Changes rejected"

flow start -> tell -> notify -> check -> decision
flow decision -> confirm "yes"
flow decision -> reject "no"
flow confirm -> confirmed
flow reject -> rejected
