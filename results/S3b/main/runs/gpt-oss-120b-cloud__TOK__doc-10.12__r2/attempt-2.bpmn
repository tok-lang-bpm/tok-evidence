<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Master Data Change Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Master Data Change Process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="EC" name="EC">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1" name="Tell INQ about change of master data" />
    <bpmn:task id="t2" name="Notify IP of change" />
    <bpmn:task id="t3" name="Check whether master data can be changed at desired time" />
    <bpmn:exclusiveGateway id="gx" name="Can master data be changed at desired time?" />
    <bpmn:task id="t4" name="Confirm changes of INQ" />
    <bpmn:task id="t5" name="Reject changes of INQ" />
    <bpmn:endEvent id="e1" name="Changes confirmed" />
    <bpmn:endEvent id="e2" name="Changes rejected" />
    <bpmn:sequenceFlow id="f-start-t1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-gx" sourceRef="t3" targetRef="gx" />
    <bpmn:sequenceFlow id="f-gx-t4" name="yes" sourceRef="gx" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-e1" sourceRef="t4" targetRef="e1" />
    <bpmn:sequenceFlow id="f-gx-t5" name="no" sourceRef="gx" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-e2" sourceRef="t5" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
