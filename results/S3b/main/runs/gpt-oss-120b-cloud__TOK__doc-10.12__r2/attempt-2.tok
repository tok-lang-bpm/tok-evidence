tok 1.0 "Master Data Change Process"

pool organisation "Organisation"
  lane EC "EC"
    start start "Start"
    task t1 "Tell INQ about change of master data"
  lane INQ "INQ"
    task t2 "Notify IP of change"
  lane IP "IP"
    task t3 "Check whether master data can be changed at desired time"
    xor gx "Can master data be changed at desired time?"
    task t4 "Confirm changes of INQ"
    task t5 "Reject changes of INQ"
    end e1 "Changes confirmed"
    end e2 "Changes rejected"

flow start -> t1 -> t2 -> t3 -> gx
flow gx -> t4 "yes"
flow t4 -> e1
flow gx -> t5 "no"
flow t5 -> e2
