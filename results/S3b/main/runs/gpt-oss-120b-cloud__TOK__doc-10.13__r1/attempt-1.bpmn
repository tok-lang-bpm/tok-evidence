<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="INQ to IP transaction" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="INQ to IP transaction" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request" />
    <bpmn:exclusiveGateway id="outcome" name="Examination outcome?" />
    <bpmn:task id="transmit_data" name="Transmit data" />
    <bpmn:task id="reject" name="Reject" />
    <bpmn:endEvent id="end_success" name="Data transmitted" />
    <bpmn:endEvent id="end_failure" name="Request rejected" />
    <bpmn:sequenceFlow id="f-start-transmit" sourceRef="start" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-check" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-outcome" sourceRef="check" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-transmit_data" name="Data" sourceRef="outcome" targetRef="transmit_data" />
    <bpmn:sequenceFlow id="f-outcome-reject" name="Reject" sourceRef="outcome" targetRef="reject" />
    <bpmn:sequenceFlow id="f-transmit_data-end_success" sourceRef="transmit_data" targetRef="end_success" />
    <bpmn:sequenceFlow id="f-reject-end_failure" sourceRef="reject" targetRef="end_failure" />
  </bpmn:process>
</bpmn:definitions>
