<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="INQ to IP transaction handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="INQ to IP transaction handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t1" name="Transmit transaction data request" />
    <bpmn:task id="t2" name="Check the request" />
    <bpmn:exclusiveGateway id="g1" name="Request outcome?" />
    <bpmn:task id="t3" name="Transmit data" />
    <bpmn:task id="t4" name="Reject" />
    <bpmn:endEvent id="e1" name="Transaction completed" />
    <bpmn:endEvent id="e2" name="Transaction rejected" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t3" name="Transmit data" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-g1-t4" name="Reject" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t3-e1" sourceRef="t3" targetRef="e1" />
    <bpmn:sequenceFlow id="f-t4-e2" sourceRef="t4" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
