<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Billing Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Billing Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="process" name="Process">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRMED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJECTED</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>SEND_TEMP_CONT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_EQUIP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>SEND_TEMP_MEAS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_ADDIT_READINGS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>EXAMINE_GO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_GO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_INVOICE_GO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJECT_INVOICE_GO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>EXAMINE_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_INVOICE_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJECT_INVOICE_MPON</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:exclusiveGateway id="X1" name="Bill type sent?" />
    <bpmn:exclusiveGateway id="X2" name="Recipient of equipment acquisition bill?" />
    <bpmn:endEvent id="CONFIRMED" name="Invoice confirmed" />
    <bpmn:endEvent id="REJECTED" name="Invoice rejected" />
    <bpmn:task id="SEND_TEMP_CONT" name="send bill for temporary continuation of metering point operations" />
    <bpmn:task id="SEND_EQUIP" name="send bill for equipment acquisition" />
    <bpmn:task id="SEND_TEMP_MEAS" name="send bill for temporary continuation of measurement" />
    <bpmn:task id="SEND_ADDIT_READINGS" name="send bill for additional readings" />
    <bpmn:task id="EXAMINE_GO" name="examine bill" />
    <bpmn:exclusiveGateway id="CONFIRM_GO" name="Confirm invoice?" />
    <bpmn:task id="CONFIRM_INVOICE_GO" name="confirm invoice with payment advice" />
    <bpmn:task id="REJECT_INVOICE_GO" name="reject invoice" />
    <bpmn:task id="EXAMINE_MPON" name="examine bill" />
    <bpmn:exclusiveGateway id="CONFIRM_MPON" name="Confirm invoice?" />
    <bpmn:task id="CONFIRM_INVOICE_MPON" name="confirm invoice with payment advice" />
    <bpmn:task id="REJECT_INVOICE_MPON" name="reject invoice" />
    <bpmn:sequenceFlow id="f-S-X1" sourceRef="S" targetRef="X1" />
    <bpmn:sequenceFlow id="f-X1-SEND_TEMP_CONT" name="temp continuation" sourceRef="X1" targetRef="SEND_TEMP_CONT" />
    <bpmn:sequenceFlow id="f-X1-SEND_TEMP_MEAS" name="temp measurement" sourceRef="X1" targetRef="SEND_TEMP_MEAS" />
    <bpmn:sequenceFlow id="f-X1-SEND_ADDIT_READINGS" name="additional readings" sourceRef="X1" targetRef="SEND_ADDIT_READINGS" />
    <bpmn:sequenceFlow id="f-X1-SEND_EQUIP" name="equipment acquisition" sourceRef="X1" targetRef="SEND_EQUIP" />
    <bpmn:sequenceFlow id="f-SEND_TEMP_CONT-EXAMINE_GO" sourceRef="SEND_TEMP_CONT" targetRef="EXAMINE_GO" />
    <bpmn:sequenceFlow id="f-SEND_TEMP_MEAS-EXAMINE_GO" sourceRef="SEND_TEMP_MEAS" targetRef="EXAMINE_GO" />
    <bpmn:sequenceFlow id="f-SEND_ADDIT_READINGS-EXAMINE_GO" sourceRef="SEND_ADDIT_READINGS" targetRef="EXAMINE_GO" />
    <bpmn:sequenceFlow id="f-SEND_EQUIP-X2" sourceRef="SEND_EQUIP" targetRef="X2" />
    <bpmn:sequenceFlow id="f-X2-EXAMINE_GO" name="to GO" sourceRef="X2" targetRef="EXAMINE_GO" />
    <bpmn:sequenceFlow id="f-X2-EXAMINE_MPON" name="to MPON" sourceRef="X2" targetRef="EXAMINE_MPON" />
    <bpmn:sequenceFlow id="f-EXAMINE_GO-CONFIRM_GO" sourceRef="EXAMINE_GO" targetRef="CONFIRM_GO" />
    <bpmn:sequenceFlow id="f-EXAMINE_MPON-CONFIRM_MPON" sourceRef="EXAMINE_MPON" targetRef="CONFIRM_MPON" />
    <bpmn:sequenceFlow id="f-CONFIRM_GO-CONFIRM_INVOICE_GO" name="confirm" sourceRef="CONFIRM_GO" targetRef="CONFIRM_INVOICE_GO" />
    <bpmn:sequenceFlow id="f-CONFIRM_GO-REJECT_INVOICE_GO" name="reject" sourceRef="CONFIRM_GO" targetRef="REJECT_INVOICE_GO" />
    <bpmn:sequenceFlow id="f-CONFIRM_MPON-CONFIRM_INVOICE_MPON" name="confirm" sourceRef="CONFIRM_MPON" targetRef="CONFIRM_INVOICE_MPON" />
    <bpmn:sequenceFlow id="f-CONFIRM_MPON-REJECT_INVOICE_MPON" name="reject" sourceRef="CONFIRM_MPON" targetRef="REJECT_INVOICE_MPON" />
    <bpmn:sequenceFlow id="f-CONFIRM_INVOICE_GO-CONFIRMED" sourceRef="CONFIRM_INVOICE_GO" targetRef="CONFIRMED" />
    <bpmn:sequenceFlow id="f-REJECT_INVOICE_GO-REJECTED" sourceRef="REJECT_INVOICE_GO" targetRef="REJECTED" />
    <bpmn:sequenceFlow id="f-CONFIRM_INVOICE_MPON-CONFIRMED" sourceRef="CONFIRM_INVOICE_MPON" targetRef="CONFIRMED" />
    <bpmn:sequenceFlow id="f-REJECT_INVOICE_MPON-REJECTED" sourceRef="REJECT_INVOICE_MPON" targetRef="REJECTED" />
  </bpmn:process>
</bpmn:definitions>
