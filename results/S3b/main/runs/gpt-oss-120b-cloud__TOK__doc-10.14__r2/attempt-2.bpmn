<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice Processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Invoice Processing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="start" name="Start">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill_type</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>send_mpoo_temp_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_mpoo_equip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>send_mspo_temp_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_mspo_add_read</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="decision" name="Decision">
        <bpmn:flowNodeRef>equip_recipient</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>examine_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>examine_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_mpon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="end_lane" name="End">
        <bpmn:flowNodeRef>end_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="bill_type" name="Bill type?" />
    <bpmn:task id="send_mpoo_temp_cont" name="Send bill for temporary continuation of metering point operations" />
    <bpmn:task id="send_mpoo_equip" name="Send bill for equipment acquisition" />
    <bpmn:task id="send_mspo_temp_cont" name="Send bill for temporary continuation of measurement" />
    <bpmn:task id="send_mspo_add_read" name="Send bill for additional readings" />
    <bpmn:exclusiveGateway id="equip_recipient" name="Recipient of equipment acquisition bill?" />
    <bpmn:task id="examine_go" name="Examine bill" />
    <bpmn:exclusiveGateway id="decision_go" name="Confirm invoice?" />
    <bpmn:task id="confirm_go" name="Confirm invoice with payment advice" />
    <bpmn:task id="reject_go" name="Reject invoice" />
    <bpmn:task id="examine_mpon" name="Examine bill" />
    <bpmn:exclusiveGateway id="decision_mpon" name="Confirm invoice?" />
    <bpmn:task id="confirm_mpon" name="Confirm invoice with payment advice" />
    <bpmn:task id="reject_mpon" name="Reject invoice" />
    <bpmn:endEvent id="end_confirm" name="Invoice confirmed" />
    <bpmn:endEvent id="end_reject" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f-s-bill_type" sourceRef="s" targetRef="bill_type" />
    <bpmn:sequenceFlow id="f-bill_type-send_mpoo_temp_cont" name="MPOO temp continuation" sourceRef="bill_type" targetRef="send_mpoo_temp_cont" />
    <bpmn:sequenceFlow id="f-bill_type-send_mspo_temp_cont" name="MSPO temp continuation" sourceRef="bill_type" targetRef="send_mspo_temp_cont" />
    <bpmn:sequenceFlow id="f-bill_type-send_mspo_add_read" name="MSPO additional readings" sourceRef="bill_type" targetRef="send_mspo_add_read" />
    <bpmn:sequenceFlow id="f-bill_type-send_mpoo_equip" name="MPOO equipment acquisition" sourceRef="bill_type" targetRef="send_mpoo_equip" />
    <bpmn:sequenceFlow id="f-send_mpoo_temp_cont-examine_go" sourceRef="send_mpoo_temp_cont" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_mspo_temp_cont-examine_go" sourceRef="send_mspo_temp_cont" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_mspo_add_read-examine_go" sourceRef="send_mspo_add_read" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_mpoo_equip-equip_recipient" sourceRef="send_mpoo_equip" targetRef="equip_recipient" />
    <bpmn:sequenceFlow id="f-equip_recipient-examine_go" name="to GO" sourceRef="equip_recipient" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-equip_recipient-examine_mpon" name="to MPON" sourceRef="equip_recipient" targetRef="examine_mpon" />
    <bpmn:sequenceFlow id="f-examine_go-decision_go" sourceRef="examine_go" targetRef="decision_go" />
    <bpmn:sequenceFlow id="f-decision_go-confirm_go" name="confirm" sourceRef="decision_go" targetRef="confirm_go" />
    <bpmn:sequenceFlow id="f-confirm_go-end_confirm" sourceRef="confirm_go" targetRef="end_confirm" />
    <bpmn:sequenceFlow id="f-decision_go-reject_go" name="reject" sourceRef="decision_go" targetRef="reject_go" />
    <bpmn:sequenceFlow id="f-reject_go-end_reject" sourceRef="reject_go" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-examine_mpon-decision_mpon" sourceRef="examine_mpon" targetRef="decision_mpon" />
    <bpmn:sequenceFlow id="f-decision_mpon-confirm_mpon" name="confirm" sourceRef="decision_mpon" targetRef="confirm_mpon" />
    <bpmn:sequenceFlow id="f-confirm_mpon-end_confirm" sourceRef="confirm_mpon" targetRef="end_confirm" />
    <bpmn:sequenceFlow id="f-decision_mpon-reject_mpon" name="reject" sourceRef="decision_mpon" targetRef="reject_mpon" />
    <bpmn:sequenceFlow id="f-reject_mpon-end_reject" sourceRef="reject_mpon" targetRef="end_reject" />
  </bpmn:process>
</bpmn:definitions>
