<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>review_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send_dismissal" name="Send the dismissal" />
    <bpmn:task id="review_dismissal" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Oppose or confirm dismissal?" />
    <bpmn:task id="oppose_dismissal" name="Oppose the dismissal" />
    <bpmn:task id="confirm_dismissal" name="Confirm the dismissal" />
    <bpmn:endEvent id="opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-s-send_dismissal" sourceRef="s" targetRef="send_dismissal" />
    <bpmn:sequenceFlow id="f-send_dismissal-review_dismissal" sourceRef="send_dismissal" targetRef="review_dismissal" />
    <bpmn:sequenceFlow id="f-review_dismissal-decision" sourceRef="review_dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-oppose_dismissal" name="oppose" sourceRef="decision" targetRef="oppose_dismissal" />
    <bpmn:sequenceFlow id="f-decision-confirm_dismissal" name="confirm" sourceRef="decision" targetRef="confirm_dismissal" />
    <bpmn:sequenceFlow id="f-oppose_dismissal-opposed" sourceRef="oppose_dismissal" targetRef="opposed" />
    <bpmn:sequenceFlow id="f-confirm_dismissal-confirmed" sourceRef="confirm_dismissal" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
