tok 1.0 "Dismissal process"

pool org "Organisation"
  lane MPON "MPON"
    start s "Start"
    task send_dismissal "Send the dismissal"
  lane MPOO "MPOO"
    task review_dismissal "Review the dismissal"
    xor decision "Oppose or confirm dismissal?"
    task oppose_dismissal "Oppose the dismissal"
    task confirm_dismissal "Confirm the dismissal"
    end opposed "Dismissal opposed"
    end confirmed "Dismissal confirmed"

flow s -> send_dismissal -> review_dismissal -> decision
flow decision -> oppose_dismissal "oppose"
flow decision -> confirm_dismissal "confirm"
flow oppose_dismissal -> opposed
flow confirm_dismissal -> confirmed
