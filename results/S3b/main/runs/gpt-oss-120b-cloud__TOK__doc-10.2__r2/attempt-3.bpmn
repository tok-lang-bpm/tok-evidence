<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPON Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPON Process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_equipMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infSucc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>t_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_appDec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_informMPOOReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_informMSPOReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_andReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_andRegJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_andEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_andEquipJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_eqAfterEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recvFailInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recvSuccInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confFailAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assignMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_andFailAssignInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_andAssignInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_assignInfoJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infMPOOFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infMSPOFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infMPOOAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infMSPOAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_infSPAssign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>t_equipMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recvMPOOFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recvMPOOAssign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>t_recvMSPOFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recvMSPOAssign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SP" name="SP">
        <bpmn:flowNodeRef>t_recvSPAssign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t_report" name="Report the meter operation to the GO" />
    <bpmn:task id="t_equipMPON" name="Perform equipment acquisition and/or changes" />
    <bpmn:task id="t_infFail" name="Inform GO about the failure of the entire process" />
    <bpmn:task id="t_infSucc" name="Inform GO about the successful completion of the entire process" />
    <bpmn:endEvent id="endReject" name="Process rejected" />
    <bpmn:endEvent id="endSuccess" name="Process completed successfully" />
    <bpmn:task id="t_examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="g_appDec" name="Reject or confirm application?" />
    <bpmn:task id="t_reject" name="Reject the application of the MPON" />
    <bpmn:task id="t_confirm" name="Confirm the application of the MPON" />
    <bpmn:task id="t_informMPOOReg" name="Inform MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="t_informMSPOReg" name="Inform MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="g_andReg" name="Registration notifications split" />
    <bpmn:parallelGateway id="g_andRegJoin" name="After registration notifications join" />
    <bpmn:parallelGateway id="g_andEquip" name="Equipment tasks split" />
    <bpmn:parallelGateway id="g_andEquipJoin" name="After equipment tasks join" />
    <bpmn:exclusiveGateway id="g_eqAfterEquip" name="Failure or success after equipment" />
    <bpmn:task id="t_recvFailInfo" name="Receive failure information from MPON" />
    <bpmn:task id="t_recvSuccInfo" name="Receive successful completion information from MPON" />
    <bpmn:task id="t_infDeadline" name="Inform MPON about the failure of the overall transaction by deadline" />
    <bpmn:task id="t_confFailAssign" name="Confirm failure of the assignment to the MPON" />
    <bpmn:task id="t_assignMPON" name="Assign the MPON" />
    <bpmn:task id="t_confAssign" name="Confirm assignment to the MPON" />
    <bpmn:parallelGateway id="g_andFailAssignInfo" name="Inform failure of assignment split" />
    <bpmn:parallelGateway id="g_andAssignInfo" name="Inform assignment split" />
    <bpmn:parallelGateway id="g_assignInfoJoin" name="After assignment notifications join" />
    <bpmn:task id="t_infMPOOFail" name="Inform MPOO about the failure of assignment of the MPON" />
    <bpmn:task id="t_infMSPOFail" name="Inform MSPO about the failure of assignment of the MPON" />
    <bpmn:task id="t_infMPOOAssign" name="Inform MPOO about the assignment of the MPON" />
    <bpmn:task id="t_infMSPOAssign" name="Inform MSPO about the assignment of the MPON" />
    <bpmn:task id="t_infSPAssign" name="Inform SP about the assignment of the MPON" />
    <bpmn:task id="t_equipMPOO" name="Perform equipment acquisition and/or changes" />
    <bpmn:task id="t_recvMPOOFail" name="Receive failure of assignment of the MPON" />
    <bpmn:task id="t_recvMPOOAssign" name="Receive assignment of the MPON" />
    <bpmn:task id="t_recvMSPOFail" name="Receive failure of assignment of the MPON" />
    <bpmn:task id="t_recvMSPOAssign" name="Receive assignment of the MPON" />
    <bpmn:task id="t_recvSPAssign" name="Receive assignment of the MPON" />
    <bpmn:sequenceFlow id="f-s-t_report" sourceRef="s" targetRef="t_report" />
    <bpmn:sequenceFlow id="f-t_report-t_examine" sourceRef="t_report" targetRef="t_examine" />
    <bpmn:sequenceFlow id="f-t_examine-g_appDec" sourceRef="t_examine" targetRef="g_appDec" />
    <bpmn:sequenceFlow id="f-g_appDec-t_reject" name="reject" sourceRef="g_appDec" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f-g_appDec-t_confirm" name="confirm" sourceRef="g_appDec" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f-t_reject-endReject" sourceRef="t_reject" targetRef="endReject" />
    <bpmn:sequenceFlow id="f-t_confirm-g_andReg" sourceRef="t_confirm" targetRef="g_andReg" />
    <bpmn:sequenceFlow id="f-g_andReg-t_informMPOOReg" sourceRef="g_andReg" targetRef="t_informMPOOReg" />
    <bpmn:sequenceFlow id="f-g_andReg-t_informMSPOReg" sourceRef="g_andReg" targetRef="t_informMSPOReg" />
    <bpmn:sequenceFlow id="f-t_informMPOOReg-g_andRegJoin" sourceRef="t_informMPOOReg" targetRef="g_andRegJoin" />
    <bpmn:sequenceFlow id="f-t_informMSPOReg-g_andRegJoin" sourceRef="t_informMSPOReg" targetRef="g_andRegJoin" />
    <bpmn:sequenceFlow id="f-g_andRegJoin-g_andEquip" sourceRef="g_andRegJoin" targetRef="g_andEquip" />
    <bpmn:sequenceFlow id="f-g_andEquip-t_equipMPON" sourceRef="g_andEquip" targetRef="t_equipMPON" />
    <bpmn:sequenceFlow id="f-g_andEquip-t_equipMPOO" sourceRef="g_andEquip" targetRef="t_equipMPOO" />
    <bpmn:sequenceFlow id="f-t_equipMPON-g_andEquipJoin" sourceRef="t_equipMPON" targetRef="g_andEquipJoin" />
    <bpmn:sequenceFlow id="f-t_equipMPOO-g_andEquipJoin" sourceRef="t_equipMPOO" targetRef="g_andEquipJoin" />
    <bpmn:sequenceFlow id="f-g_andEquipJoin-g_eqAfterEquip" sourceRef="g_andEquipJoin" targetRef="g_eqAfterEquip" />
    <bpmn:sequenceFlow id="f-g_eqAfterEquip-t_recvFailInfo" name="failure" sourceRef="g_eqAfterEquip" targetRef="t_recvFailInfo" />
    <bpmn:sequenceFlow id="f-g_eqAfterEquip-t_recvSuccInfo" name="success" sourceRef="g_eqAfterEquip" targetRef="t_recvSuccInfo" />
    <bpmn:sequenceFlow id="f-t_recvFailInfo-t_infFail" sourceRef="t_recvFailInfo" targetRef="t_infFail" />
    <bpmn:sequenceFlow id="f-t_infFail-t_infDeadline" sourceRef="t_infFail" targetRef="t_infDeadline" />
    <bpmn:sequenceFlow id="f-t_infDeadline-t_confFailAssign" sourceRef="t_infDeadline" targetRef="t_confFailAssign" />
    <bpmn:sequenceFlow id="f-t_confFailAssign-g_andFailAssignInfo" sourceRef="t_confFailAssign" targetRef="g_andFailAssignInfo" />
    <bpmn:sequenceFlow id="f-g_andFailAssignInfo-t_infMPOOFail" sourceRef="g_andFailAssignInfo" targetRef="t_infMPOOFail" />
    <bpmn:sequenceFlow id="f-g_andFailAssignInfo-t_infMSPOFail" sourceRef="g_andFailAssignInfo" targetRef="t_infMSPOFail" />
    <bpmn:sequenceFlow id="f-t_infMPOOFail-endReject" sourceRef="t_infMPOOFail" targetRef="endReject" />
    <bpmn:sequenceFlow id="f-t_infMSPOFail-endReject" sourceRef="t_infMSPOFail" targetRef="endReject" />
    <bpmn:sequenceFlow id="f-t_recvSuccInfo-t_assignMPON" sourceRef="t_recvSuccInfo" targetRef="t_assignMPON" />
    <bpmn:sequenceFlow id="f-t_assignMPON-t_confAssign" sourceRef="t_assignMPON" targetRef="t_confAssign" />
    <bpmn:sequenceFlow id="f-t_confAssign-g_andAssignInfo" sourceRef="t_confAssign" targetRef="g_andAssignInfo" />
    <bpmn:sequenceFlow id="f-g_andAssignInfo-t_infMPOOAssign" sourceRef="g_andAssignInfo" targetRef="t_infMPOOAssign" />
    <bpmn:sequenceFlow id="f-g_andAssignInfo-t_infMSPOAssign" sourceRef="g_andAssignInfo" targetRef="t_infMSPOAssign" />
    <bpmn:sequenceFlow id="f-g_andAssignInfo-t_infSPAssign" sourceRef="g_andAssignInfo" targetRef="t_infSPAssign" />
    <bpmn:sequenceFlow id="f-t_infMPOOAssign-t_recvMPOOAssign" sourceRef="t_infMPOOAssign" targetRef="t_recvMPOOAssign" />
    <bpmn:sequenceFlow id="f-t_infMSPOAssign-t_recvMSPOAssign" sourceRef="t_infMSPOAssign" targetRef="t_recvMSPOAssign" />
    <bpmn:sequenceFlow id="f-t_infSPAssign-t_recvSPAssign" sourceRef="t_infSPAssign" targetRef="t_recvSPAssign" />
    <bpmn:sequenceFlow id="f-t_recvMPOOAssign-g_assignInfoJoin" sourceRef="t_recvMPOOAssign" targetRef="g_assignInfoJoin" />
    <bpmn:sequenceFlow id="f-t_recvMSPOAssign-g_assignInfoJoin" sourceRef="t_recvMSPOAssign" targetRef="g_assignInfoJoin" />
    <bpmn:sequenceFlow id="f-t_recvSPAssign-g_assignInfoJoin" sourceRef="t_recvSPAssign" targetRef="g_assignInfoJoin" />
    <bpmn:sequenceFlow id="f-g_assignInfoJoin-endSuccess" sourceRef="g_assignInfoJoin" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>
