<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPOO deregistration process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MPOO deregistration process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>t_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_obligation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mpoo_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_equipment_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_equipment_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_inform_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_inform_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO" />
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Start deregistration" />
    <bpmn:task id="t_deregister" name="MPOO deregisters at the GO" />
    <bpmn:endEvent id="e_end" name="Process completed" />
    <bpmn:task id="t_verify" name="GO verifies the deregistration" />
    <bpmn:exclusiveGateway id="g_decision" name="GO decision on deregistration" />
    <bpmn:task id="t_reject" name="GO rejects the deregistration of the MPOO" />
    <bpmn:endEvent id="e_reject" name="Deregistration rejected" />
    <bpmn:task id="t_confirm" name="GO preliminarily confirms the deregistration of the MPOO" />
    <bpmn:task id="t_prepare" name="GO prepares the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="g_obligation" name="GO obliges MPOO to continue?" />
    <bpmn:task id="t_bind" name="GO binds the MPOO to continue the operation" />
    <bpmn:task id="t_mpoo_confirm" name="MPOO confirms the continuation to the MPOO" />
    <bpmn:parallelGateway id="g_equipment_split" name="Equipment activities" />
    <bpmn:task id="t_acquire" name="GO performs equipment acquisition" />
    <bpmn:task id="t_change" name="GO performs equipment changes" />
    <bpmn:parallelGateway id="g_equipment_join" name="Equipment join" />
    <bpmn:task id="t_assign" name="GO assigns the GO as MPO" />
    <bpmn:task id="t_inform_mpoo" name="GO informs the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:parallelGateway id="g_inform_split" name="Inform parties" />
    <bpmn:task id="t_inform_mspo" name="GO informs the MSPO about the assignment of the GO" />
    <bpmn:task id="t_inform_sp" name="GO informs the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="g_inform_join" name="Inform join" />
    <bpmn:endEvent id="e_complete" name="Process completed" />
    <bpmn:sequenceFlow id="f-s_start-t_deregister" sourceRef="s_start" targetRef="t_deregister" />
    <bpmn:sequenceFlow id="f-t_deregister-t_verify" sourceRef="t_deregister" targetRef="t_verify" />
    <bpmn:sequenceFlow id="f-t_verify-g_decision" sourceRef="t_verify" targetRef="g_decision" />
    <bpmn:sequenceFlow id="f-g_decision-t_reject" sourceRef="g_decision" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f-t_reject-e_reject" sourceRef="t_reject" targetRef="e_reject" />
    <bpmn:sequenceFlow id="f-g_decision-t_confirm" sourceRef="g_decision" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f-t_confirm-t_prepare" sourceRef="t_confirm" targetRef="t_prepare" />
    <bpmn:sequenceFlow id="f-t_prepare-g_obligation" sourceRef="t_prepare" targetRef="g_obligation" />
    <bpmn:sequenceFlow id="f-g_obligation-t_bind" sourceRef="g_obligation" targetRef="t_bind" />
    <bpmn:sequenceFlow id="f-t_bind-t_mpoo_confirm" sourceRef="t_bind" targetRef="t_mpoo_confirm" />
    <bpmn:sequenceFlow id="f-t_mpoo_confirm-g_equipment_split" sourceRef="t_mpoo_confirm" targetRef="g_equipment_split" />
    <bpmn:sequenceFlow id="f-g_obligation-g_equipment_split" name="no" sourceRef="g_obligation" targetRef="g_equipment_split" />
    <bpmn:sequenceFlow id="f-g_equipment_split-t_acquire" sourceRef="g_equipment_split" targetRef="t_acquire" />
    <bpmn:sequenceFlow id="f-t_acquire-g_equipment_join" sourceRef="t_acquire" targetRef="g_equipment_join" />
    <bpmn:sequenceFlow id="f-g_equipment_split-t_change" sourceRef="g_equipment_split" targetRef="t_change" />
    <bpmn:sequenceFlow id="f-t_change-g_equipment_join" sourceRef="t_change" targetRef="g_equipment_join" />
    <bpmn:sequenceFlow id="f-g_equipment_join-t_assign" sourceRef="g_equipment_join" targetRef="t_assign" />
    <bpmn:sequenceFlow id="f-t_assign-t_inform_mpoo" sourceRef="t_assign" targetRef="t_inform_mpoo" />
    <bpmn:sequenceFlow id="f-t_inform_mpoo-g_inform_split" sourceRef="t_inform_mpoo" targetRef="g_inform_split" />
    <bpmn:sequenceFlow id="f-g_inform_split-t_inform_mspo" sourceRef="g_inform_split" targetRef="t_inform_mspo" />
    <bpmn:sequenceFlow id="f-t_inform_mspo-g_inform_join" sourceRef="t_inform_mspo" targetRef="g_inform_join" />
    <bpmn:sequenceFlow id="f-g_inform_split-t_inform_sp" sourceRef="g_inform_split" targetRef="t_inform_sp" />
    <bpmn:sequenceFlow id="f-t_inform_sp-g_inform_join" sourceRef="t_inform_sp" targetRef="g_inform_join" />
    <bpmn:sequenceFlow id="f-g_inform_join-e_complete" sourceRef="g_inform_join" targetRef="e_complete" />
  </bpmn:process>
</bpmn:definitions>
