<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPOO deregistration process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPOO deregistration process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dreg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mopoconfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_obligation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO" />
      <bpmn:lane id="SP" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="dreg" name="MPOO deregisters at the GO" />
    <bpmn:task id="verify" name="GO verifies the deregistration" />
    <bpmn:exclusiveGateway id="decision1" name="Deregistration decision" />
    <bpmn:task id="reject" name="GO rejects the deregistration of the MPOO" />
    <bpmn:endEvent id="reject_end" name="Deregistration rejected" />
    <bpmn:task id="confirm" name="GO preliminarily confirms the deregistration of the MPOO" />
    <bpmn:task id="readmit" name="GO prepares the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="decision2" name="Obligation to continue?" />
    <bpmn:task id="bind" name="GO binds the MPOO to continue the operation" />
    <bpmn:task id="mopoconfirm" name="MPOO confirms the continuation to the GO" />
    <bpmn:exclusiveGateway id="join_obligation" name="Obligation join" />
    <bpmn:parallelGateway id="split_equip" name="Equipment activities split" />
    <bpmn:task id="acquire" name="GO performs equipment acquisition" />
    <bpmn:task id="change" name="GO performs equipment changes" />
    <bpmn:parallelGateway id="join_equip" name="Equipment activities join" />
    <bpmn:task id="assign" name="GO assigns the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="GO informs the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="GO informs the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="GO informs the SP about the assignment of the GO" />
    <bpmn:endEvent id="end_process" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-dreg" sourceRef="start" targetRef="dreg" />
    <bpmn:sequenceFlow id="f-dreg-verify" sourceRef="dreg" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-decision1" sourceRef="verify" targetRef="decision1" />
    <bpmn:sequenceFlow id="f-decision1-reject" name="reject" sourceRef="decision1" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-reject_end" sourceRef="reject" targetRef="reject_end" />
    <bpmn:sequenceFlow id="f-decision1-confirm" name="confirm" sourceRef="decision1" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-readmit" sourceRef="confirm" targetRef="readmit" />
    <bpmn:sequenceFlow id="f-readmit-decision2" sourceRef="readmit" targetRef="decision2" />
    <bpmn:sequenceFlow id="f-decision2-bind" name="bind" sourceRef="decision2" targetRef="bind" />
    <bpmn:sequenceFlow id="f-bind-mopoconfirm" sourceRef="bind" targetRef="mopoconfirm" />
    <bpmn:sequenceFlow id="f-mopoconfirm-join_obligation" sourceRef="mopoconfirm" targetRef="join_obligation" />
    <bpmn:sequenceFlow id="f-decision2-join_obligation" name="no bind" sourceRef="decision2" targetRef="join_obligation" />
    <bpmn:sequenceFlow id="f-join_obligation-split_equip" sourceRef="join_obligation" targetRef="split_equip" />
    <bpmn:sequenceFlow id="f-split_equip-acquire" sourceRef="split_equip" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-acquire-join_equip" sourceRef="acquire" targetRef="join_equip" />
    <bpmn:sequenceFlow id="f-split_equip-change" sourceRef="split_equip" targetRef="change" />
    <bpmn:sequenceFlow id="f-change-join_equip" sourceRef="change" targetRef="join_equip" />
    <bpmn:sequenceFlow id="f-join_equip-assign" sourceRef="join_equip" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mpoo" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f-inform_mpoo-inform_mspo" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-inform_mspo-inform_sp" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-end_process" sourceRef="inform_sp" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
