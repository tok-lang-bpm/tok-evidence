<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment Change Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment Change Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gj1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gj2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gj3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>notif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSP" name="MSP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="n1" name="Notify MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="g1" name="Self dismounting decision?" />
    <bpmn:exclusiveGateway id="gj1" name="Self dismounting merge" />
    <bpmn:exclusiveGateway id="g2" name="Who performs final reading?" />
    <bpmn:exclusiveGateway id="gj2" name="Final reading merge" />
    <bpmn:exclusiveGateway id="g3" name="Who dismounts old equipment?" />
    <bpmn:exclusiveGateway id="gj3" name="Old equipment dismount merge" />
    <bpmn:task id="f1" name="Perform final reading" />
    <bpmn:task id="d1" name="Dismount old equipment" />
    <bpmn:task id="m1" name="Mount new device" />
    <bpmn:task id="r1" name="Read meter count from installed meter" />
    <bpmn:task id="s1" name="Send final reading values to GO" />
    <bpmn:task id="t1" name="Tell GO about device changes, master data and meter count at installation" />
    <bpmn:task id="a1" name="Announce self dismounting to MPON" />
    <bpmn:task id="a2" name="Notify MPON about no self-dismounting of MPOO" />
    <bpmn:task id="f2" name="Perform final reading" />
    <bpmn:task id="d2" name="Dismount old equipment" />
    <bpmn:task id="notif" name="Notify MSP about device changes, master data, meter count at dismounting and installation" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-n1" sourceRef="s" targetRef="n1" />
    <bpmn:sequenceFlow id="f-n1-g1" sourceRef="n1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-a1" name="self dismounting" sourceRef="g1" targetRef="a1" />
    <bpmn:sequenceFlow id="f-g1-a2" name="no self dismounting" sourceRef="g1" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a1-gj1" sourceRef="a1" targetRef="gj1" />
    <bpmn:sequenceFlow id="f-a2-gj1" sourceRef="a2" targetRef="gj1" />
    <bpmn:sequenceFlow id="f-gj1-g2" sourceRef="gj1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-f1" name="MPON" sourceRef="g2" targetRef="f1" />
    <bpmn:sequenceFlow id="f-g2-f2" name="MPOO" sourceRef="g2" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f1-gj2" sourceRef="f1" targetRef="gj2" />
    <bpmn:sequenceFlow id="f-f2-gj2" sourceRef="f2" targetRef="gj2" />
    <bpmn:sequenceFlow id="f-gj2-g3" sourceRef="gj2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-d1" name="MPON" sourceRef="g3" targetRef="d1" />
    <bpmn:sequenceFlow id="f-g3-d2" name="MPOO" sourceRef="g3" targetRef="d2" />
    <bpmn:sequenceFlow id="f-d1-gj3" sourceRef="d1" targetRef="gj3" />
    <bpmn:sequenceFlow id="f-d2-gj3" sourceRef="d2" targetRef="gj3" />
    <bpmn:sequenceFlow id="f-gj3-m1" sourceRef="gj3" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-r1" sourceRef="m1" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-s1" sourceRef="r1" targetRef="s1" />
    <bpmn:sequenceFlow id="f-s1-t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-notif" sourceRef="t1" targetRef="notif" />
    <bpmn:sequenceFlow id="f-notif-e" sourceRef="notif" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
