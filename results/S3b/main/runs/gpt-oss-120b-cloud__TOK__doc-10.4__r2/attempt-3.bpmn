<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment Change Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment Change Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self_dismount_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_old_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_final_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>announce_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_no_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_old_mpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>notify_msp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="notify_intent" name="Notify MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="self_dismount_gate" name="Self dismounting decision" />
    <bpmn:exclusiveGateway id="final_reading_gate" name="Final reading performer" />
    <bpmn:task id="final_reading_mpon" name="Perform final reading" />
    <bpmn:exclusiveGateway id="final_reading_join" name="Final reading join" />
    <bpmn:exclusiveGateway id="dismount_gate" name="Old equipment dismount performer" />
    <bpmn:task id="dismount_old_mpon" name="Dismount old equipment" />
    <bpmn:exclusiveGateway id="dismount_join" name="Old equipment dismount join" />
    <bpmn:task id="mount_new" name="Mount new device" />
    <bpmn:task id="read_meter" name="Read meter count from installed meter" />
    <bpmn:task id="send_final_values" name="Send final reading values to GO" />
    <bpmn:task id="tell_go" name="Tell GO about device changes, master data and meter count at installation" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="announce_self" name="Announce self dismounting to MPON" />
    <bpmn:task id="notify_no_self" name="Notify MPON about no self-dismounting of MPOO" />
    <bpmn:task id="final_reading_mpoo" name="Perform final reading" />
    <bpmn:task id="dismount_old_mpoo" name="Dismount old equipment" />
    <bpmn:task id="notify_msp" name="Notify MSP about device changes, master data, meter count at dismounting and meter count at installation" />
    <bpmn:sequenceFlow id="f-start-notify_intent" sourceRef="start" targetRef="notify_intent" />
    <bpmn:sequenceFlow id="f-notify_intent-self_dismount_gate" sourceRef="notify_intent" targetRef="self_dismount_gate" />
    <bpmn:sequenceFlow id="f-self_dismount_gate-announce_self" name="self-dismount" sourceRef="self_dismount_gate" targetRef="announce_self" />
    <bpmn:sequenceFlow id="f-self_dismount_gate-notify_no_self" name="no-self-dismount" sourceRef="self_dismount_gate" targetRef="notify_no_self" />
    <bpmn:sequenceFlow id="f-announce_self-final_reading_gate" sourceRef="announce_self" targetRef="final_reading_gate" />
    <bpmn:sequenceFlow id="f-notify_no_self-final_reading_gate" sourceRef="notify_no_self" targetRef="final_reading_gate" />
    <bpmn:sequenceFlow id="f-final_reading_gate-final_reading_mpon" name="MPON" sourceRef="final_reading_gate" targetRef="final_reading_mpon" />
    <bpmn:sequenceFlow id="f-final_reading_gate-final_reading_mpoo" name="MPOO" sourceRef="final_reading_gate" targetRef="final_reading_mpoo" />
    <bpmn:sequenceFlow id="f-final_reading_mpon-final_reading_join" sourceRef="final_reading_mpon" targetRef="final_reading_join" />
    <bpmn:sequenceFlow id="f-final_reading_mpoo-final_reading_join" sourceRef="final_reading_mpoo" targetRef="final_reading_join" />
    <bpmn:sequenceFlow id="f-final_reading_join-dismount_gate" sourceRef="final_reading_join" targetRef="dismount_gate" />
    <bpmn:sequenceFlow id="f-dismount_gate-dismount_old_mpon" name="MPON" sourceRef="dismount_gate" targetRef="dismount_old_mpon" />
    <bpmn:sequenceFlow id="f-dismount_gate-dismount_old_mpoo" name="MPOO" sourceRef="dismount_gate" targetRef="dismount_old_mpoo" />
    <bpmn:sequenceFlow id="f-dismount_old_mpon-dismount_join" sourceRef="dismount_old_mpon" targetRef="dismount_join" />
    <bpmn:sequenceFlow id="f-dismount_old_mpoo-dismount_join" sourceRef="dismount_old_mpoo" targetRef="dismount_join" />
    <bpmn:sequenceFlow id="f-dismount_join-mount_new" sourceRef="dismount_join" targetRef="mount_new" />
    <bpmn:sequenceFlow id="f-mount_new-read_meter" sourceRef="mount_new" targetRef="read_meter" />
    <bpmn:sequenceFlow id="f-read_meter-send_final_values" sourceRef="read_meter" targetRef="send_final_values" />
    <bpmn:sequenceFlow id="f-send_final_values-tell_go" sourceRef="send_final_values" targetRef="tell_go" />
    <bpmn:sequenceFlow id="f-tell_go-notify_msp" sourceRef="tell_go" targetRef="notify_msp" />
    <bpmn:sequenceFlow id="f-notify_msp-end" sourceRef="notify_msp" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
