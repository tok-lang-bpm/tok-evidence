tok 1.0 "Equipment Change Process"

pool org "Organisation"
  lane MPON "MPON"
    start start "Start"
    task notify_intent "Notify MPOO about equipment change intentions"
    xor self_dismount_gate "Self dismounting decision"
    xor final_reading_gate "Final reading performer"
    task final_reading_mpon "Perform final reading"
    xor final_reading_join "Final reading join"
    xor dismount_gate "Old equipment dismount performer"
    task dismount_old_mpon "Dismount old equipment"
    xor dismount_join "Old equipment dismount join"
    task mount_new "Mount new device"
    task read_meter "Read meter count from installed meter"
    task send_final_values "Send final reading values to GO"
    task tell_go "Tell GO about device changes, master data and meter count at installation"
    end end "End"

  lane MPOO "MPOO"
    task announce_self "Announce self dismounting to MPON"
    task notify_no_self "Notify MPON about no self-dismounting of MPOO"
    task final_reading_mpoo "Perform final reading"
    task dismount_old_mpoo "Dismount old equipment"

  lane GO "GO"
    task notify_msp "Notify MSP about device changes, master data, meter count at dismounting and meter count at installation"

flow start -> notify_intent
flow notify_intent -> self_dismount_gate
flow self_dismount_gate -> announce_self "self-dismount"
flow self_dismount_gate -> notify_no_self "no-self-dismount"
flow announce_self -> final_reading_gate
flow notify_no_self -> final_reading_gate
flow final_reading_gate -> final_reading_mpon "MPON"
flow final_reading_gate -> final_reading_mpoo "MPOO"
flow final_reading_mpon -> final_reading_join
flow final_reading_mpoo -> final_reading_join
flow final_reading_join -> dismount_gate
flow dismount_gate -> dismount_old_mpon "MPON"
flow dismount_gate -> dismount_old_mpoo "MPOO"
flow dismount_old_mpon -> dismount_join
flow dismount_old_mpoo -> dismount_join
flow dismount_join -> mount_new
flow mount_new -> read_meter
flow read_meter -> send_final_values
flow send_final_values -> tell_go
flow tell_go -> notify_msp
flow notify_msp -> end
