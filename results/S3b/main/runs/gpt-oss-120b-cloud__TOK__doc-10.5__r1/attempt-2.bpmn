<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Device takeover process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Device takeover process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req_bid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>send_tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_master_data</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="req_bid" name="Requests a device takeover bid" />
    <bpmn:task id="place_order" name="Places an order" />
    <bpmn:endEvent id="e" name="Process completed" />
    <bpmn:task id="send_tender" name="Sends a tender for the equipment takeover" />
    <bpmn:task id="confirm_order" name="Confirms the order" />
    <bpmn:task id="send_master_data" name="Sends the master data" />
    <bpmn:sequenceFlow id="f-s-req_bid" sourceRef="s" targetRef="req_bid" />
    <bpmn:sequenceFlow id="f-req_bid-send_tender" sourceRef="req_bid" targetRef="send_tender" />
    <bpmn:sequenceFlow id="f-send_tender-place_order" sourceRef="send_tender" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-confirm_order" sourceRef="place_order" targetRef="confirm_order" />
    <bpmn:sequenceFlow id="f-confirm_order-send_master_data" sourceRef="confirm_order" targetRef="send_master_data" />
    <bpmn:sequenceFlow id="f-send_master_data-e" sourceRef="send_master_data" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
