tok 1.0 "Device takeover process"

pool org "Organization"
  lane MPON "MPON"
    start start1 "Start"
    task request_bid "Request device takeover bid"
    task place_order "Place order"
    end end1 "Process completed"
  lane MPOO "MPOO"
    task send_tender "Send tender for equipment takeover"
    task confirm_order "Confirm order"
    task send_master_data "Send master data"

flow start1 -> request_bid
flow request_bid -> send_tender
flow send_tender -> place_order
flow place_order -> confirm_order
flow confirm_order -> send_master_data
flow send_master_data -> end1
