<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN measurement registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN measurement registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ms_po" name="MSPO" />
      <bpmn:lane id="mpo" name="MPO" />
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="r" name="register the measurement at the GO" />
    <bpmn:task id="e" name="examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="d" name="application of the MSPN?" />
    <bpmn:task id="re" name="reject the application of the MSPN" />
    <bpmn:task id="c" name="confirm the application of the MSPN" />
    <bpmn:task id="a" name="assign the MSPN" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:task id="i1" name="inform MSPO about the assignment of MSPN" />
    <bpmn:task id="i2" name="inform MPO about the assignment of MSPN" />
    <bpmn:task id="i3" name="inform SP about the assignment of MSPN" />
    <bpmn:parallelGateway id="p2" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-r" sourceRef="s" targetRef="r" />
    <bpmn:sequenceFlow id="f-r-e" sourceRef="r" targetRef="e" />
    <bpmn:sequenceFlow id="f-e-d" sourceRef="e" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-re" name="reject" sourceRef="d" targetRef="re" />
    <bpmn:sequenceFlow id="f-d-c" name="confirm" sourceRef="d" targetRef="c" />
    <bpmn:sequenceFlow id="f-re-done" sourceRef="re" targetRef="done" />
    <bpmn:sequenceFlow id="f-c-a" sourceRef="c" targetRef="a" />
    <bpmn:sequenceFlow id="f-a-p1" sourceRef="a" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-i1" sourceRef="p1" targetRef="i1" />
    <bpmn:sequenceFlow id="f-p1-i2" sourceRef="p1" targetRef="i2" />
    <bpmn:sequenceFlow id="f-p1-i3" sourceRef="p1" targetRef="i3" />
    <bpmn:sequenceFlow id="f-i1-p2" sourceRef="i1" targetRef="p2" />
    <bpmn:sequenceFlow id="f-i2-p2" sourceRef="i2" targetRef="p2" />
    <bpmn:sequenceFlow id="f-i3-p2" sourceRef="i3" targetRef="p2" />
    <bpmn:sequenceFlow id="f-p2-done" sourceRef="p2" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
