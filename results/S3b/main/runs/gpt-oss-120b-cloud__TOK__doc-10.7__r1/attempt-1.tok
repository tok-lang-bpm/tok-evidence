tok 1.0 "MSPN measurement registration"

pool org "Organisation"
  lane mspn "MSPN"
    start s "Start"
    task r "register the measurement at the GO"
  lane go "GO"
    task e "examine the application of the MSPN"
    xor d "application of the MSPN?"
    task re "reject the application of the MSPN"
    task c "confirm the application of the MSPN"
    task a "assign the MSPN"
    and p1
    task i1 "inform MSPO about the assignment of MSPN"
    task i2 "inform MPO about the assignment of MSPN"
    task i3 "inform SP about the assignment of MSPN"
    and p2
    end done "Process completed"
  lane ms_po "MSPO"
    # receiving information
  lane mpo "MPO"
    # receiving information
  lane sp "SP"
    # receiving information

flow s -> r -> e -> d
flow d -> re "reject"
flow d -> c "confirm"
flow re -> done
flow c -> a -> p1
flow p1 -> i1
flow p1 -> i2
flow p1 -> i3
flow i1 -> p2
flow i2 -> p2
flow i3 -> p2
flow p2 -> done
