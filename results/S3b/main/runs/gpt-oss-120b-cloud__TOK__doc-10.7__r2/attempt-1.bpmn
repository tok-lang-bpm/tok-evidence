<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN measurement registration process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN measurement registration process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ER</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:task id="R" name="registers the measurement" />
    <bpmn:task id="E" name="examines the application" />
    <bpmn:exclusiveGateway id="D" name="Application approved?" />
    <bpmn:task id="Rj" name="rejects the application" />
    <bpmn:task id="C" name="confirms the application" />
    <bpmn:task id="A" name="assigns the MSPN" />
    <bpmn:parallelGateway id="G1" name="Notify parties" />
    <bpmn:task id="I1" name="informs the MSPO about the assignment" />
    <bpmn:task id="I2" name="informs the MPO about the assignment" />
    <bpmn:task id="I3" name="informs the SP about the assignment" />
    <bpmn:parallelGateway id="G2" name="All notifications done" />
    <bpmn:endEvent id="EC" name="Assignment communicated" />
    <bpmn:endEvent id="ER" name="Application rejected" />
    <bpmn:sequenceFlow id="f-S-R" sourceRef="S" targetRef="R" />
    <bpmn:sequenceFlow id="f-R-E" sourceRef="R" targetRef="E" />
    <bpmn:sequenceFlow id="f-E-D" sourceRef="E" targetRef="D" />
    <bpmn:sequenceFlow id="f-D-Rj" name="reject" sourceRef="D" targetRef="Rj" />
    <bpmn:sequenceFlow id="f-D-C" name="confirm" sourceRef="D" targetRef="C" />
    <bpmn:sequenceFlow id="f-Rj-ER" sourceRef="Rj" targetRef="ER" />
    <bpmn:sequenceFlow id="f-C-A" sourceRef="C" targetRef="A" />
    <bpmn:sequenceFlow id="f-A-G1" sourceRef="A" targetRef="G1" />
    <bpmn:sequenceFlow id="f-G1-I1" sourceRef="G1" targetRef="I1" />
    <bpmn:sequenceFlow id="f-G1-I2" sourceRef="G1" targetRef="I2" />
    <bpmn:sequenceFlow id="f-G1-I3" sourceRef="G1" targetRef="I3" />
    <bpmn:sequenceFlow id="f-I1-G2" sourceRef="I1" targetRef="G2" />
    <bpmn:sequenceFlow id="f-I2-G2" sourceRef="I2" targetRef="G2" />
    <bpmn:sequenceFlow id="f-I3-G2" sourceRef="I3" targetRef="G2" />
    <bpmn:sequenceFlow id="f-G2-EC" sourceRef="G2" targetRef="EC" />
  </bpmn:process>
</bpmn:definitions>
