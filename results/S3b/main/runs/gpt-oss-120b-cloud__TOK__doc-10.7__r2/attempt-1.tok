tok 1.0 "MSPN measurement registration process"

pool org "Organization"
  lane mspn "MSPN"
    start S "Start"
    task R "registers the measurement"
  lane go "GO"
    task E "examines the application"
    xor D "Application approved?"
    task Rj "rejects the application"
    task C "confirms the application"
    task A "assigns the MSPN"
    and G1 "Notify parties"
    task I1 "informs the MSPO about the assignment"
    task I2 "informs the MPO about the assignment"
    task I3 "informs the SP about the assignment"
    and G2 "All notifications done"
    end EC "Assignment communicated"
    end ER "Application rejected"

flow S -> R -> E -> D
flow D -> Rj "reject"
flow D -> C "confirm"
flow Rj -> ER
flow C -> A -> G1
flow G1 -> I1
flow G1 -> I2
flow G1 -> I3
flow I1 -> G2
flow I2 -> G2
flow I3 -> G2
flow G2 -> EC
