tok 1.0 "MPO Change Request Process"

pool organisation "Organisation"
  lane sp "SP"
    task sp_req "SP request change"
  lane pu "PU"
    task pu_req "PU request change"
  lane go "GO"
    task go_req "GO request change"
  lane mpo "MPO"
    task mpo_self "MPO causes change"
    task review "MPO reviews the change request"
    task reject "MPO rejects the change"
    task perform "MPO performs the measuring point change"
    task report "MPO reports implementation to SP / PU / GO"
    task notify "MPO notifies SP / PU / GO about failure"

start s "Start"
xor g1 "Who initiates change?"
xor g2 "MPO decision"
xor g3 "Result of change"

end e_reject "Change rejected"
end e_success "Implementation reported"
end e_failure "Failure notified"

flow s -> g1
flow g1 -> sp_req
flow g1 -> pu_req
flow g1 -> go_req
flow g1 -> mpo_self

flow sp_req -> review
flow pu_req -> review
flow go_req -> review
flow mpo_self -> review

flow review -> g2

flow g2 -> reject "reject"
flow g2 -> perform "confirm"

flow reject -> e_reject

flow perform -> g3

flow g3 -> report "success"
flow g3 -> notify "failure"

flow report -> e_success
flow notify -> e_failure
