<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPO Change Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPO Change Request Process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="initiator" name="Initiator">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_init</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sp" name="SP">
        <bpmn:flowNodeRef>sp_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pu" name="PU">
        <bpmn:flowNodeRef>pu_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>go_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>mpo_cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="g_init" name="Who initiates change?" />
    <bpmn:task id="sp_request" name="SP request changes to MPO" />
    <bpmn:task id="pu_request" name="PU request changes to MPO" />
    <bpmn:task id="go_request" name="GO request changes to MPO" />
    <bpmn:task id="mpo_cause" name="MPO causes a change" />
    <bpmn:task id="review" name="MPO reviews the change request" />
    <bpmn:exclusiveGateway id="g_mpo" name="MPO decision" />
    <bpmn:task id="reject" name="MPO rejects the change" />
    <bpmn:task id="perform" name="MPO performs the measuring point change" />
    <bpmn:exclusiveGateway id="g_out" name="Change outcome" />
    <bpmn:task id="report" name="MPO reports implementation to SP/PU/GO" />
    <bpmn:task id="notify" name="MPO notifies SP/PU/GO about failure" />
    <bpmn:endEvent id="end_reject" name="Change rejected" />
    <bpmn:endEvent id="end_success" name="Implementation reported" />
    <bpmn:endEvent id="end_failure" name="Failure notified" />
    <bpmn:sequenceFlow id="f-s-g_init" sourceRef="s" targetRef="g_init" />
    <bpmn:sequenceFlow id="f-g_init-sp_request" name="SP" sourceRef="g_init" targetRef="sp_request" />
    <bpmn:sequenceFlow id="f-g_init-pu_request" name="PU" sourceRef="g_init" targetRef="pu_request" />
    <bpmn:sequenceFlow id="f-g_init-go_request" name="GO" sourceRef="g_init" targetRef="go_request" />
    <bpmn:sequenceFlow id="f-g_init-mpo_cause" name="MPO self" sourceRef="g_init" targetRef="mpo_cause" />
    <bpmn:sequenceFlow id="f-sp_request-review" sourceRef="sp_request" targetRef="review" />
    <bpmn:sequenceFlow id="f-pu_request-review" sourceRef="pu_request" targetRef="review" />
    <bpmn:sequenceFlow id="f-go_request-review" sourceRef="go_request" targetRef="review" />
    <bpmn:sequenceFlow id="f-mpo_cause-review" sourceRef="mpo_cause" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g_mpo" sourceRef="review" targetRef="g_mpo" />
    <bpmn:sequenceFlow id="f-g_mpo-reject" name="reject" sourceRef="g_mpo" targetRef="reject" />
    <bpmn:sequenceFlow id="f-g_mpo-perform" name="confirm" sourceRef="g_mpo" targetRef="perform" />
    <bpmn:sequenceFlow id="f-reject-end_reject" sourceRef="reject" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-perform-g_out" sourceRef="perform" targetRef="g_out" />
    <bpmn:sequenceFlow id="f-g_out-report" name="success" sourceRef="g_out" targetRef="report" />
    <bpmn:sequenceFlow id="f-g_out-notify" name="failure" sourceRef="g_out" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-end_success" sourceRef="report" targetRef="end_success" />
    <bpmn:sequenceFlow id="f-notify-end_failure" sourceRef="notify" targetRef="end_failure" />
  </bpmn:process>
</bpmn:definitions>
