<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Measuring point change process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="requester" name="SP / PU / GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>cause_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_implementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Change request initiated" />
    <bpmn:exclusiveGateway id="initiator" name="Initiator" />
    <bpmn:task id="request_change" name="Request change" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:task id="cause_change" name="Cause change" />
    <bpmn:task id="review" name="Review change request" />
    <bpmn:exclusiveGateway id="approval" name="Approval?" />
    <bpmn:task id="perform_change" name="Perform measuring point change" />
    <bpmn:exclusiveGateway id="outcome" name="Implementation outcome?" />
    <bpmn:task id="report_implementation" name="Report implementation to requester" />
    <bpmn:task id="notify_failure" name="Notify failure to requester" />
    <bpmn:endEvent id="success" name="Change succeeded" />
    <bpmn:endEvent id="failure" name="Change failed" />
    <bpmn:sequenceFlow id="f-start-initiator" sourceRef="start" targetRef="initiator" />
    <bpmn:sequenceFlow id="f-initiator-request_change" name="SP/PU/GO request" sourceRef="initiator" targetRef="request_change" />
    <bpmn:sequenceFlow id="f-initiator-cause_change" name="MPO causes" sourceRef="initiator" targetRef="cause_change" />
    <bpmn:sequenceFlow id="f-request_change-review" sourceRef="request_change" targetRef="review" />
    <bpmn:sequenceFlow id="f-cause_change-review" sourceRef="cause_change" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approval" sourceRef="review" targetRef="approval" />
    <bpmn:sequenceFlow id="f-approval-perform_change" name="confirm" sourceRef="approval" targetRef="perform_change" />
    <bpmn:sequenceFlow id="f-approval-rejected" name="reject" sourceRef="approval" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-perform_change-outcome" sourceRef="perform_change" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-report_implementation" name="success" sourceRef="outcome" targetRef="report_implementation" />
    <bpmn:sequenceFlow id="f-outcome-notify_failure" name="failure" sourceRef="outcome" targetRef="notify_failure" />
    <bpmn:sequenceFlow id="f-report_implementation-success" sourceRef="report_implementation" targetRef="success" />
    <bpmn:sequenceFlow id="f-notify_failure-failure" sourceRef="notify_failure" targetRef="failure" />
  </bpmn:process>
</bpmn:definitions>
