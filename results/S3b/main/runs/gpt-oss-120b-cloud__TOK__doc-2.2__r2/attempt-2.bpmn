<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Switch‑over Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Switch‑over Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid Operator">
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old" name="Old Supplier">
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Switch‑over request" />
    <bpmn:task id="T1" name="Transmit customer data" />
    <bpmn:task id="T2" name="Receive customer data" />
    <bpmn:task id="T3" name="Enter customer data into CRM" />
    <bpmn:task id="T4" name="Compare data and check completeness" />
    <bpmn:exclusiveGateway id="G1" name="Data errors?" />
    <bpmn:task id="T5" name="Correct data errors" />
    <bpmn:exclusiveGateway id="G2" name="Customer exists?" />
    <bpmn:task id="T6" name="Create new customer object" />
    <bpmn:task id="T7" name="Prepare contract documents" />
    <bpmn:task id="T10" name="Send confirmation document to customer" />
    <bpmn:task id="T14" name="Create CIS contract" />
    <bpmn:task id="T15" name="Customer checks contract details" />
    <bpmn:exclusiveGateway id="G5" name="Customer withdraws?" />
    <bpmn:endEvent id="E1" name="Process withdrawn" />
    <bpmn:task id="T16" name="Wait for acceptance (7 days)" />
    <bpmn:task id="T17" name="Switch date reached" />
    <bpmn:task id="T23" name="Import meter data into systems" />
    <bpmn:endEvent id="E2" name="Process completed" />
    <bpmn:task id="T8" name="Automated contract check" />
    <bpmn:exclusiveGateway id="G3" name="Contract documents valid?" />
    <bpmn:task id="T9" name="Analyze and resolve contract issues" />
    <bpmn:task id="T11" name="Send switch request to Grid Operator" />
    <bpmn:exclusiveGateway id="G4" name="Supplier concurrence?" />
    <bpmn:parallelGateway id="P1" name="Concurrence handling" />
    <bpmn:task id="T12" name="Inform all suppliers" />
    <bpmn:task id="T13" name="Terminate old supplier agreement" />
    <bpmn:parallelGateway id="P1_end" name="Concurrence handling join" />
    <bpmn:inclusiveGateway id="G6" name="Proceed to customer check" />
    <bpmn:parallelGateway id="P2" name="Parallel after switch date" />
    <bpmn:task id="T18" name="Send meter data to Customer Service" />
    <bpmn:task id="T19" name="Send meter data to Old Supplier" />
    <bpmn:task id="T20" name="Compute final billing and send to Old Supplier" />
    <bpmn:parallelGateway id="G_end" name="Final join" />
    <bpmn:task id="T21" name="Create final billing for customer" />
    <bpmn:task id="T22" name="Send final billing to customer" />
    <bpmn:sequenceFlow id="f-S-T1" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="f-T1-T2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="f-T2-T3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="f-T3-T4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="f-T4-G1" sourceRef="T4" targetRef="G1" />
    <bpmn:sequenceFlow id="f-G1-T5" sourceRef="G1" targetRef="T5" />
    <bpmn:sequenceFlow id="f-T5-T4" sourceRef="T5" targetRef="T4" />
    <bpmn:sequenceFlow id="f-G1-G2" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="f-G2-T6" sourceRef="G2" targetRef="T6" />
    <bpmn:sequenceFlow id="f-G2-T7" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="f-T6-T7" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="f-T7-T8" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="f-T8-G3" sourceRef="T8" targetRef="G3" />
    <bpmn:sequenceFlow id="f-G3-T9" sourceRef="G3" targetRef="T9" />
    <bpmn:sequenceFlow id="f-T9-T7" sourceRef="T9" targetRef="T7" />
    <bpmn:sequenceFlow id="f-G3-T10" sourceRef="G3" targetRef="T10" />
    <bpmn:sequenceFlow id="f-T10-T11" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="f-T11-G4" sourceRef="T11" targetRef="G4" />
    <bpmn:sequenceFlow id="f-G4-P1" sourceRef="G4" targetRef="P1" />
    <bpmn:sequenceFlow id="f-G4-T14" sourceRef="G4" targetRef="T14" />
    <bpmn:sequenceFlow id="f-P1-T12" sourceRef="P1" targetRef="T12" />
    <bpmn:sequenceFlow id="f-P1-T13" sourceRef="P1" targetRef="T13" />
    <bpmn:sequenceFlow id="f-T12-P1_end" sourceRef="T12" targetRef="P1_end" />
    <bpmn:sequenceFlow id="f-T13-P1_end" sourceRef="T13" targetRef="P1_end" />
    <bpmn:sequenceFlow id="f-P1_end-G6" sourceRef="P1_end" targetRef="G6" />
    <bpmn:sequenceFlow id="f-T14-G6" sourceRef="T14" targetRef="G6" />
    <bpmn:sequenceFlow id="f-G6-T15" sourceRef="G6" targetRef="T15" />
    <bpmn:sequenceFlow id="f-T15-G5" sourceRef="T15" targetRef="G5" />
    <bpmn:sequenceFlow id="f-G5-E1" sourceRef="G5" targetRef="E1" />
    <bpmn:sequenceFlow id="f-G5-T16" sourceRef="G5" targetRef="T16" />
    <bpmn:sequenceFlow id="f-T16-T17" sourceRef="T16" targetRef="T17" />
    <bpmn:sequenceFlow id="f-T17-P2" sourceRef="T17" targetRef="P2" />
    <bpmn:sequenceFlow id="f-P2-T18" sourceRef="P2" targetRef="T18" />
    <bpmn:sequenceFlow id="f-P2-T19" sourceRef="P2" targetRef="T19" />
    <bpmn:sequenceFlow id="f-P2-T20" sourceRef="P2" targetRef="T20" />
    <bpmn:sequenceFlow id="f-T18-T23" sourceRef="T18" targetRef="T23" />
    <bpmn:sequenceFlow id="f-T23-G_end" sourceRef="T23" targetRef="G_end" />
    <bpmn:sequenceFlow id="f-T19-G_end" sourceRef="T19" targetRef="G_end" />
    <bpmn:sequenceFlow id="f-T20-T21" sourceRef="T20" targetRef="T21" />
    <bpmn:sequenceFlow id="f-T21-T22" sourceRef="T21" targetRef="T22" />
    <bpmn:sequenceFlow id="f-T22-G_end" sourceRef="T22" targetRef="G_end" />
    <bpmn:sequenceFlow id="f-G_end-E2" sourceRef="G_end" targetRef="E2" />
  </bpmn:process>
</bpmn:definitions>
