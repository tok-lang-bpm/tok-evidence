tok 1.0 "Switch‑over Process"

pool org "Company"
  lane customer "Customer"
    start S "Switch‑over request"
    task T1 "Transmit customer data"
  lane cs "Customer Service"
    task T2 "Receive customer data"
    task T3 "Enter customer data into CRM"
    task T4 "Compare data and check completeness"
    xor G1 "Data errors?"
    task T5 "Correct data errors"
    xor G2 "Customer exists?"
    task T6 "Create new customer object"
    task T7 "Prepare contract documents"
    task T10 "Send confirmation document to customer"
    task T14 "Create CIS contract"
    task T15 "Customer checks contract details"
    xor G5 "Customer withdraws?"
    end E1 "Process withdrawn"
    task T16 "Wait for acceptance (7 days)"
    task T17 "Switch date reached"
    task T23 "Import meter data into systems"
    end E2 "Process completed"
  lane cis "CIS"
    task T8 "Automated contract check"
    xor G3 "Contract documents valid?"
    task T9 "Analyze and resolve contract issues"
    task T11 "Send switch request to Grid Operator"
  lane grid "Grid Operator"
    xor G4 "Supplier concurrence?"
    and P1 "Concurrence handling"
    task T12 "Inform all suppliers"
    task T13 "Terminate old supplier agreement"
    and P1_end "Concurrence handling join"
    or G6 "Proceed to customer check"
    and P2 "Parallel after switch date"
    task T18 "Send meter data to Customer Service"
    task T19 "Send meter data to Old Supplier"
    task T20 "Compute final billing and send to Old Supplier"
    and G_end "Final join"
  lane old "Old Supplier"
    task T21 "Create final billing for customer"
    task T22 "Send final billing to customer"

# Sequence flows
flow S -> T1
flow T1 -> T2
flow T2 -> T3
flow T3 -> T4
flow T4 -> G1
flow G1 -> T5        # when errors
flow T5 -> T4
flow G1 -> G2        # when no errors
flow G2 -> T6        # when not existing
flow G2 -> T7        # when existing
flow T6 -> T7
flow T7 -> T8
flow T8 -> G3
flow G3 -> T9        # invalid
flow T9 -> T7
flow G3 -> T10       # valid
flow T10 -> T11
flow T11 -> G4
flow G4 -> P1        # supplier concurrence
flow G4 -> T14       # no concurrence
flow P1 -> T12
flow P1 -> T13
flow T12 -> P1_end
flow T13 -> P1_end
flow P1_end -> G6
flow T14 -> G6
flow G6 -> T15
flow T15 -> G5
flow G5 -> E1        # withdraw
flow G5 -> T16       # accept / auto‑accept
flow T16 -> T17
flow T17 -> P2
flow P2 -> T18
flow P2 -> T19
flow P2 -> T20
flow T18 -> T23
flow T23 -> G_end
flow T19 -> G_end
flow T20 -> T21
flow T21 -> T22
flow T22 -> G_end
flow G_end -> E2
