tok 1.0 "Warrant Possession Process"

pool org "Organisation"
  lane party "Party"
    start s1 "Warrant possession request sent"
    task send "Send warrant possession request"

  lane backoffice "Client Service Back Office"
    task receive_retrieve "Receive request and retrieve SCT file"
    task forward "Forward SCT Warrant Possession to Queensland Police"
    task store_wait "Store SCT physical file awaiting report"
    task receive_report "Receive report from Police"
    task retrieve_file "Retrieve SCT file"
    task attach_store "Attach new SCT document and store expanded SCT physical file"
    end e_done "Process completed"

  lane police "Queensland Police"
    task receive_forward "Receive SCT Warrant Possession"
    task send_report "Send report to Back Office"

flow s1 -> send
flow send -> receive_retrieve
flow receive_retrieve -> forward
flow forward -> and1
and and1 "Split"
flow and1 -> store_wait
flow and1 -> receive_forward
flow receive_forward -> send_report
flow send_report -> and2
flow store_wait -> and2
and and2 "Join"
flow and2 -> receive_report
flow receive_report -> retrieve_file
flow retrieve_file -> attach_store
flow attach_store -> e_done
