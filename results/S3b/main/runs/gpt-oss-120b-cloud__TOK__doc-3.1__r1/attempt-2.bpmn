<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant Possession Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Warrant Possession Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_store_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_attach_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>t_pol_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pol_send_report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Warrant possession request sent" />
    <bpmn:task id="t_send" name="Send warrant possession request" />
    <bpmn:task id="t_receive" name="Receive request and retrieve SCT file" />
    <bpmn:task id="t_forward" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:parallelGateway id="split1" name="Parallel split" />
    <bpmn:task id="t_store_wait" name="Store SCT physical file awaiting report" />
    <bpmn:task id="t_receive_report" name="Receive report from Police" />
    <bpmn:task id="t_retrieve" name="Retrieve SCT file" />
    <bpmn:task id="t_attach_store" name="Attach new SCT document and store expanded SCT physical file" />
    <bpmn:endEvent id="e_done" name="Process completed" />
    <bpmn:task id="t_pol_receive" name="Receive SCT Warrant Possession" />
    <bpmn:task id="t_pol_send_report" name="Send report to Back Office" />
    <bpmn:sequenceFlow id="f-s1-t_send" sourceRef="s1" targetRef="t_send" />
    <bpmn:sequenceFlow id="f-t_send-t_receive" sourceRef="t_send" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f-t_receive-t_forward" sourceRef="t_receive" targetRef="t_forward" />
    <bpmn:sequenceFlow id="f-t_forward-split1" sourceRef="t_forward" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-t_store_wait" sourceRef="split1" targetRef="t_store_wait" />
    <bpmn:sequenceFlow id="f-split1-t_pol_receive" sourceRef="split1" targetRef="t_pol_receive" />
    <bpmn:sequenceFlow id="f-t_pol_receive-t_pol_send_report" sourceRef="t_pol_receive" targetRef="t_pol_send_report" />
    <bpmn:sequenceFlow id="f-t_pol_send_report-split1" sourceRef="t_pol_send_report" targetRef="split1" />
    <bpmn:sequenceFlow id="f-t_store_wait-split1" sourceRef="t_store_wait" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-t_receive_report" sourceRef="split1" targetRef="t_receive_report" />
    <bpmn:sequenceFlow id="f-t_receive_report-t_retrieve" sourceRef="t_receive_report" targetRef="t_retrieve" />
    <bpmn:sequenceFlow id="f-t_retrieve-t_attach_store" sourceRef="t_retrieve" targetRef="t_attach_store" />
    <bpmn:sequenceFlow id="f-t_attach_store-e_done" sourceRef="t_attach_store" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>
