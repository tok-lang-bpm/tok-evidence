<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant Possession Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Warrant Possession Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office (Small Claims Registry Operations)">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeawait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieveSCT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeExpanded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>receiveWarrant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReport</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="send" name="Party sends warrant possession request" />
    <bpmn:task id="receive" name="Receive warrant possession request" />
    <bpmn:task id="retrieve" name="Retrieve SCT file" />
    <bpmn:task id="forward" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="storeawait" name="Store SCT physical file awaiting report" />
    <bpmn:task id="receiveReport" name="Receive report from Queensland Police" />
    <bpmn:task id="retrieveSCT" name="Retrieve respective SCT file" />
    <bpmn:task id="attach" name="Attach new SCT document" />
    <bpmn:task id="storeExpanded" name="Store expanded SCT physical file" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:task id="receiveWarrant" name="Receive SCT Warrant Possession" />
    <bpmn:task id="sendReport" name="Send report" />
    <bpmn:sequenceFlow id="f-send-receive" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-retrieve" sourceRef="receive" targetRef="retrieve" />
    <bpmn:sequenceFlow id="f-retrieve-forward" sourceRef="retrieve" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-storeawait" sourceRef="forward" targetRef="storeawait" />
    <bpmn:sequenceFlow id="f-storeawait-receiveWarrant" sourceRef="storeawait" targetRef="receiveWarrant" />
    <bpmn:sequenceFlow id="f-receiveWarrant-sendReport" sourceRef="receiveWarrant" targetRef="sendReport" />
    <bpmn:sequenceFlow id="f-sendReport-receiveReport" sourceRef="sendReport" targetRef="receiveReport" />
    <bpmn:sequenceFlow id="f-receiveReport-retrieveSCT" sourceRef="receiveReport" targetRef="retrieveSCT" />
    <bpmn:sequenceFlow id="f-retrieveSCT-attach" sourceRef="retrieveSCT" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-storeExpanded" sourceRef="attach" targetRef="storeExpanded" />
    <bpmn:sequenceFlow id="f-storeExpanded-done" sourceRef="storeExpanded" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
