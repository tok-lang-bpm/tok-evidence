tok 1.0 "Morning file processing and hearings" [executable]

pool court "Court" [executable]
  lane clerk "Clerk"
    start start "Morning start"
    task check "Check files not yet processed"
    xor xor_missing "Missing files?"
    task search "Initiate search for missing files"
    task track "Track files to intended location"
    xor join_missing "Merge missing file branches"
    and and_split "Parallel actions start"
    task hand "Hand files to Associate"
    end end_process "Process completed"

  lane system "System"
    task distribute "Distribute Judge's Lawlist to relevant people"

  lane judge "Judge"
    task hearings "Conduct directions hearings"

flow start -> check -> xor_missing
flow xor_missing -> search "missing"
flow xor_missing -> track "available"
flow search -> join_missing
flow track -> join_missing
flow join_missing -> and_split
flow and_split -> hand
flow and_split -> distribute
flow hand -> hearings
flow distribute -> hearings
flow hearings -> end_process
