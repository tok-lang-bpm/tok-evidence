<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Morning file processing and hearings" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Morning file processing and hearings" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="clerk" name="Clerk">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>hearings</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Morning start" />
    <bpmn:task id="check" name="Check unprocessed files" />
    <bpmn:exclusiveGateway id="missing" name="Missing files?" />
    <bpmn:task id="search" name="Search for missing files" />
    <bpmn:task id="track" name="Track files to intended location" />
    <bpmn:parallelGateway id="parallel_split" name="Parallel split" />
    <bpmn:task id="hand" name="Hand files to Associate" />
    <bpmn:parallelGateway id="parallel_join" name="Parallel join" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:task id="distribute" name="Distribute Judge's Lawlist to relevant people" />
    <bpmn:task id="hearings" name="Conduct directions hearings" />
    <bpmn:sequenceFlow id="f-start-check" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-parallel_split" sourceRef="search" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f-track-parallel_split" sourceRef="track" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f-parallel_split-hand" sourceRef="parallel_split" targetRef="hand" />
    <bpmn:sequenceFlow id="f-parallel_split-distribute" sourceRef="parallel_split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-parallel_join" sourceRef="hand" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-distribute-parallel_join" sourceRef="distribute" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-parallel_join-hearings" sourceRef="parallel_join" targetRef="hearings" />
    <bpmn:sequenceFlow id="f-hearings-end" sourceRef="hearings" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
