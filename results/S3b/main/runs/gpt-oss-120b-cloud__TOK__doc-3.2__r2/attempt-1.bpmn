<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court Files Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Court Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Court Files Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="clerk" name="Clerk">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Morning start" />
    <bpmn:task id="check" name="Check files" />
    <bpmn:exclusiveGateway id="missing" name="Missing files?" />
    <bpmn:task id="search" name="Search for missing files" />
    <bpmn:task id="track" name="Track files to location" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="hand" name="Hand files to Associate" />
    <bpmn:task id="distribute" name="Distribute Judgeis Lawlist" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="conduct" name="Conduct directions hearings" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-check" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-track" sourceRef="search" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-split" sourceRef="track" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-hand" sourceRef="split" targetRef="hand" />
    <bpmn:sequenceFlow id="f-split-distribute" sourceRef="split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-join" sourceRef="hand" targetRef="join" />
    <bpmn:sequenceFlow id="f-distribute-join" sourceRef="distribute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-conduct" sourceRef="join" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-end" sourceRef="conduct" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
