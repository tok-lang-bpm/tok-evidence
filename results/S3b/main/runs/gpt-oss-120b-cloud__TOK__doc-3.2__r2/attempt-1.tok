tok 1.0 "Court Files Process"

pool org "Court Organisation"
  lane clerk "Clerk"
    start start "Morning start"
    task check "Check files"
    xor missing "Missing files?"
    task search "Search for missing files"
    task track "Track files to location"
    and split
    task hand "Hand files to Associate"
    task distribute "Distribute Judgeis Lawlist"
    and join

  lane judge "Judge"
    task conduct "Conduct directions hearings"
    end end "Process completed"

flow start -> check -> missing
flow missing -> search "yes"
flow missing -> track "no"
flow search -> track
flow track -> split
flow split -> hand
flow split -> distribute
flow hand -> join
flow distribute -> join
flow join -> conduct -> end
