<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claim handling process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="claims_officer" name="Claims Officer">
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior_officer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reg" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="write" name="Write settlement recommendation" />
    <bpmn:task id="check" name="Check settlement recommendation" />
    <bpmn:exclusiveGateway id="ok" name="Recommendation OK?" />
    <bpmn:endEvent id="done" name="Claim handling completed" />
    <bpmn:sequenceFlow id="f-reg-examine" sourceRef="reg" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-write" sourceRef="examine" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-check" sourceRef="write" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-done" name="yes" sourceRef="ok" targetRef="done" />
    <bpmn:sequenceFlow id="f-ok-write" name="no" sourceRef="ok" targetRef="write" />
  </bpmn:process>
</bpmn:definitions>
