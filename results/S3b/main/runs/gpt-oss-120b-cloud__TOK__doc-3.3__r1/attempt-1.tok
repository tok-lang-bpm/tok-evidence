tok 1.0 "Claim handling process"

pool org "Organization"
  lane claims_officer "Claims Officer"
    start reg "Claim registered"
    task examine "Examine the claim"
    task write "Write settlement recommendation"
  lane senior_officer "Senior Claims Officer"
    task check "Check settlement recommendation"
    xor ok "Recommendation OK?"
    end done "Claim handling completed"

flow reg -> examine -> write -> check -> ok
flow ok -> done "yes"
flow ok -> write "no"
