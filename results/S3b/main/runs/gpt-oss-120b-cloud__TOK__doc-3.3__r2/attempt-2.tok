tok 1.0 "Claim handling"

pool org "Organization"
  lane officer "Claims Officer"
    start registered "Claim registered"
    task examine "Examine the claim"
    task write "Write settlement recommendation"
  lane senior "Senior Claims Officer"
    task check "Check the recommendation"
    xor decision "Recommendation OK?"
    end completed "Claim handling completed"

flow registered -> examine -> write -> check -> decision
flow decision -> completed "OK"
flow decision -> write "Not OK"
