<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Mail processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Mail processing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mail_processing" name="Mail Processing Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort_unopened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open_sort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quality_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>take_fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture_party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_file</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Mail collected" />
    <bpmn:task id="collect" name="Collect mail from the party" />
    <bpmn:task id="sort_unopened" name="Sort unopened mail into business areas" />
    <bpmn:task id="distribute" name="Distribute mail" />
    <bpmn:task id="receive" name="Receive mail" />
    <bpmn:task id="open_sort" name="Open and sort mail into groups" />
    <bpmn:task id="register" name="Register mail in manual incoming Mail Register" />
    <bpmn:task id="quality_check" name="Perform quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="compile_rejection" name="Compile rejection list" />
    <bpmn:task id="send_rejection" name="Send rejection list to party" />
    <bpmn:task id="capture_details" name="Capture matter details and provide to Cashier" />
    <bpmn:parallelGateway id="split" name="Parallel split" />
    <bpmn:task id="prepare_envelope" name="Prepare envelope with receipt and documents and post to party" />
    <bpmn:parallelGateway id="join" name="Parallel join" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:endEvent id="rejected" name="Process ended – mail rejected" />
    <bpmn:task id="take_fees" name="Take applicable fees" />
    <bpmn:task id="capture_party" name="Capture Party Details" />
    <bpmn:task id="print_file" name="Print Physical Court File" />
    <bpmn:sequenceFlow id="f-start-collect" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sort_unopened" sourceRef="collect" targetRef="sort_unopened" />
    <bpmn:sequenceFlow id="f-sort_unopened-distribute" sourceRef="sort_unopened" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-receive" sourceRef="distribute" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-open_sort" sourceRef="receive" targetRef="open_sort" />
    <bpmn:sequenceFlow id="f-open_sort-register" sourceRef="open_sort" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-quality_check" sourceRef="register" targetRef="quality_check" />
    <bpmn:sequenceFlow id="f-quality_check-compliant" sourceRef="quality_check" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-capture_details" name="yes" sourceRef="compliant" targetRef="capture_details" />
    <bpmn:sequenceFlow id="f-compliant-compile_rejection" name="no" sourceRef="compliant" targetRef="compile_rejection" />
    <bpmn:sequenceFlow id="f-compile_rejection-send_rejection" sourceRef="compile_rejection" targetRef="send_rejection" />
    <bpmn:sequenceFlow id="f-send_rejection-rejected" sourceRef="send_rejection" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-capture_details-split" sourceRef="capture_details" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-take_fees" sourceRef="split" targetRef="take_fees" />
    <bpmn:sequenceFlow id="f-split-prepare_envelope" sourceRef="split" targetRef="prepare_envelope" />
    <bpmn:sequenceFlow id="f-take_fees-capture_party" sourceRef="take_fees" targetRef="capture_party" />
    <bpmn:sequenceFlow id="f-capture_party-print_file" sourceRef="capture_party" targetRef="print_file" />
    <bpmn:sequenceFlow id="f-print_file-join" sourceRef="print_file" targetRef="join" />
    <bpmn:sequenceFlow id="f-prepare_envelope-join" sourceRef="prepare_envelope" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-completed" sourceRef="join" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
