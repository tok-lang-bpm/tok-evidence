tok 1.0 "Claims Notification Process"

pool org "Organization"
  lane claims_dept "Claims Department"
    start s "Claim received"
    task check_insured "Check claimant insured"
    xor insured "Is claimant insured?"
    task inform_rejection "Inform claimant of rejection"
    end end_rejected "Claim rejected"
    task evaluate_severity "Evaluate claim severity"
    xor claim_type "Is claim simple?"
    task send_simple_forms "Send simple forms to claimant"
    task send_complex_forms "Send complex forms to claimant"
    task check_forms "Check forms completeness"
    xor forms_complete "Forms complete?"
    task register_claim "Register claim in Claims Management system"
    task inform_update "Inform claimant to update forms"
    end end_processed "Claims Notification process completed"

  lane claimant "Claimant"
    task return_forms "Return forms"
    task return_updated_forms "Return updated forms"

flow s -> check_insured -> insured
flow insured -> evaluate_severity "yes"
flow insured -> inform_rejection "no"
flow inform_rejection -> end_rejected
flow evaluate_severity -> claim_type
flow claim_type -> send_simple_forms "simple"
flow claim_type -> send_complex_forms "complex"
flow send_simple_forms -> return_forms
flow send_complex_forms -> return_forms
flow return_forms -> check_forms
flow check_forms -> forms_complete
flow forms_complete -> register_claim "yes"
flow forms_complete -> inform_update "no"
flow inform_update -> return_updated_forms
flow return_updated_forms -> check_forms
flow register_claim -> end_processed
