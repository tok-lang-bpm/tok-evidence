<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims Notification Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Claims Notification Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="claimant" name="Claimant">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_updated_forms</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims_dept" name="Claims Department">
        <bpmn:flowNodeRef>check_insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_simple_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_complex_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forms_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_registered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Claim received" />
    <bpmn:task id="return_forms" name="Return forms" />
    <bpmn:task id="return_updated_forms" name="Return updated forms" />
    <bpmn:task id="check_insured" name="Check claimant insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" />
    <bpmn:task id="inform_rejection" name="Inform claimant claim must be rejected" />
    <bpmn:task id="evaluate_severity" name="Evaluate claim severity" />
    <bpmn:exclusiveGateway id="severity" name="Simple or complex claim?" />
    <bpmn:task id="send_simple_forms" name="Send simple claim forms" />
    <bpmn:task id="send_complex_forms" name="Send complex claim forms" />
    <bpmn:task id="check_forms" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="forms_complete" name="Forms complete?" />
    <bpmn:task id="register_claim" name="Register claim in Claims Management system" />
    <bpmn:task id="inform_update" name="Inform claimant to update forms" />
    <bpmn:endEvent id="end_rejected" name="Claim rejected" />
    <bpmn:endEvent id="end_registered" name="Claim registered" />
    <bpmn:sequenceFlow id="f-start1-check_insured" sourceRef="start1" targetRef="check_insured" />
    <bpmn:sequenceFlow id="f-check_insured-insured" sourceRef="check_insured" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-evaluate_severity" name="yes" sourceRef="insured" targetRef="evaluate_severity" />
    <bpmn:sequenceFlow id="f-insured-inform_rejection" name="no" sourceRef="insured" targetRef="inform_rejection" />
    <bpmn:sequenceFlow id="f-inform_rejection-end_rejected" sourceRef="inform_rejection" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f-evaluate_severity-severity" sourceRef="evaluate_severity" targetRef="severity" />
    <bpmn:sequenceFlow id="f-severity-send_simple_forms" name="simple" sourceRef="severity" targetRef="send_simple_forms" />
    <bpmn:sequenceFlow id="f-severity-send_complex_forms" name="complex" sourceRef="severity" targetRef="send_complex_forms" />
    <bpmn:sequenceFlow id="f-send_simple_forms-return_forms" sourceRef="send_simple_forms" targetRef="return_forms" />
    <bpmn:sequenceFlow id="f-send_complex_forms-return_forms" sourceRef="send_complex_forms" targetRef="return_forms" />
    <bpmn:sequenceFlow id="f-return_forms-check_forms" sourceRef="return_forms" targetRef="check_forms" />
    <bpmn:sequenceFlow id="f-check_forms-forms_complete" sourceRef="check_forms" targetRef="forms_complete" />
    <bpmn:sequenceFlow id="f-forms_complete-register_claim" name="yes" sourceRef="forms_complete" targetRef="register_claim" />
    <bpmn:sequenceFlow id="f-register_claim-end_registered" sourceRef="register_claim" targetRef="end_registered" />
    <bpmn:sequenceFlow id="f-forms_complete-inform_update" name="no" sourceRef="forms_complete" targetRef="inform_update" />
    <bpmn:sequenceFlow id="f-inform_update-return_updated_forms" sourceRef="inform_update" targetRef="return_updated_forms" />
    <bpmn:sequenceFlow id="f-return_updated_forms-check_forms" sourceRef="return_updated_forms" targetRef="check_forms" />
  </bpmn:process>
</bpmn:definitions>
