<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claims handling process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system_police" name="Police Report System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handler" name="Claims Handler">
        <bpmn:flowNodeRef>calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims Manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claimant" name="Claimant">
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="search" name="Search Police Report in database" />
    <bpmn:task id="file" name="Create file with Police Report and Claim Documentation" />
    <bpmn:task id="calculate" name="Calculate initial claim estimate" />
    <bpmn:task id="create_plan" name="Create Action Plan based on Action Plan Checklist" />
    <bpmn:task id="negotiate" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="inform" name="Inform claimant of outcome" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="f-start-search" sourceRef="start" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-file" sourceRef="search" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-calculate" sourceRef="file" targetRef="calculate" />
    <bpmn:sequenceFlow id="f-calculate-create_plan" sourceRef="calculate" targetRef="create_plan" />
    <bpmn:sequenceFlow id="f-create_plan-negotiate" sourceRef="create_plan" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-inform" sourceRef="negotiate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-end" sourceRef="inform" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
