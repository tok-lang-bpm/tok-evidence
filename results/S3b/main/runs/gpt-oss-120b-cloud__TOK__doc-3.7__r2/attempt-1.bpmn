<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car Accident Claim Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurance" name="Insurance Company" processRef="insurance-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurance-process" name="Car Accident Claim Process" isExecutable="false">
    <bpmn:laneSet id="insurance-lanes">
      <bpmn:lane id="handler" name="Claims Handler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims Manager">
        <bpmn:flowNodeRef>n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="s1" name="Search Police Report" />
    <bpmn:task id="s2" name="Create File with Claim Documentation" />
    <bpmn:task id="s3" name="Calculate Initial Claim Estimate" />
    <bpmn:task id="s4" name="Create Action Plan" />
    <bpmn:task id="n1" name="Negotiate Settlement" />
    <bpmn:task id="n2" name="Inform Claimant" />
    <bpmn:endEvent id="end" name="Process End" />
    <bpmn:sequenceFlow id="f-start-s1" sourceRef="start" targetRef="s1" />
    <bpmn:sequenceFlow id="f-s1-s2" sourceRef="s1" targetRef="s2" />
    <bpmn:sequenceFlow id="f-s2-s3" sourceRef="s2" targetRef="s3" />
    <bpmn:sequenceFlow id="f-s3-s4" sourceRef="s3" targetRef="s4" />
    <bpmn:sequenceFlow id="f-s4-n1" sourceRef="s4" targetRef="n1" />
    <bpmn:sequenceFlow id="f-n1-n2" sourceRef="n1" targetRef="n2" />
    <bpmn:sequenceFlow id="f-n2-end" sourceRef="n2" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
