tok 1.0 "Car Accident Claim Process"

pool insurance "Insurance Company"
  lane handler "Claims Handler"
    start start "Start"
    task s1 "Search Police Report"
    task s2 "Create File with Claim Documentation"
    task s3 "Calculate Initial Claim Estimate"
    task s4 "Create Action Plan"
    flow start -> s1 -> s2 -> s3 -> s4

  lane manager "Claims Manager"
    task n1 "Negotiate Settlement"
    task n2 "Inform Claimant"
    end end "Process End"
    flow s4 -> n1 -> n2 -> end
