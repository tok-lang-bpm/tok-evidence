<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling process" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification Department">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling Department">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer submits claim" />
    <bpmn:task id="check" name="Check documents" />
    <bpmn:task id="register" name="Register claim" />
    <bpmn:task id="pick" name="Pick up claim" />
    <bpmn:task id="insure" name="Check insurance" />
    <bpmn:task id="assess" name="Perform assessment" />
    <bpmn:exclusiveGateway id="decision" name="Assessment positive?" />
    <bpmn:task id="phone" name="Phone garage to authorise repairs" />
    <bpmn:task id="schedule" name="Schedule payment" />
    <bpmn:task id="reject" name="Reject claim" />
    <bpmn:exclusiveGateway id="join" name="Outcome processed" />
    <bpmn:task id="letter" name="Send letter to customer" />
    <bpmn:endEvent id="end" name="Process complete" />
    <bpmn:sequenceFlow id="f-start-check" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-register" sourceRef="check" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-pick" sourceRef="register" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-insure" sourceRef="pick" targetRef="insure" />
    <bpmn:sequenceFlow id="f-insure-assess" sourceRef="insure" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-decision" sourceRef="assess" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-phone" name="yes" sourceRef="decision" targetRef="phone" />
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-phone-schedule" sourceRef="phone" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-join" sourceRef="schedule" targetRef="join" />
    <bpmn:sequenceFlow id="f-reject-join" sourceRef="reject" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-letter" sourceRef="join" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-end" sourceRef="letter" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
