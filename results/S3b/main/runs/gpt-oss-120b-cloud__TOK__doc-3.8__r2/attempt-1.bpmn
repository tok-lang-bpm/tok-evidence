<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling process" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notif" name="Notification department">
        <bpmn:flowNodeRef>t_checkDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hand" name="Handling department">
        <bpmn:flowNodeRef>t_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_checkInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Process start" />
    <bpmn:task id="t_submit" name="Submit claim" />
    <bpmn:task id="t_checkDocs" name="Check documents" />
    <bpmn:task id="t_registerClaim" name="Register claim" />
    <bpmn:task id="t_pickup" name="Pick up claim" />
    <bpmn:task id="t_checkInsurance" name="Check insurance" />
    <bpmn:task id="t_assess" name="Perform assessment" />
    <bpmn:exclusiveGateway id="d_assessment" name="Assessment positive?" />
    <bpmn:task id="t_phoneGarage" name="Phone garage to authorise repairs" />
    <bpmn:task id="t_schedulePayment" name="Schedule payment" />
    <bpmn:task id="t_reject" name="Reject claim" />
    <bpmn:task id="t_sendLetter" name="Send letter to customer" />
    <bpmn:endEvent id="e_done" name="Process complete" />
    <bpmn:sequenceFlow id="f-s1-t_submit" sourceRef="s1" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f-t_submit-t_checkDocs" sourceRef="t_submit" targetRef="t_checkDocs" />
    <bpmn:sequenceFlow id="f-t_checkDocs-t_registerClaim" sourceRef="t_checkDocs" targetRef="t_registerClaim" />
    <bpmn:sequenceFlow id="f-t_registerClaim-t_pickup" sourceRef="t_registerClaim" targetRef="t_pickup" />
    <bpmn:sequenceFlow id="f-t_pickup-t_checkInsurance" sourceRef="t_pickup" targetRef="t_checkInsurance" />
    <bpmn:sequenceFlow id="f-t_checkInsurance-t_assess" sourceRef="t_checkInsurance" targetRef="t_assess" />
    <bpmn:sequenceFlow id="f-t_assess-d_assessment" sourceRef="t_assess" targetRef="d_assessment" />
    <bpmn:sequenceFlow id="f-d_assessment-t_phoneGarage" name="yes" sourceRef="d_assessment" targetRef="t_phoneGarage" />
    <bpmn:sequenceFlow id="f-d_assessment-t_reject" name="no" sourceRef="d_assessment" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f-t_phoneGarage-t_schedulePayment" sourceRef="t_phoneGarage" targetRef="t_schedulePayment" />
    <bpmn:sequenceFlow id="f-t_schedulePayment-t_sendLetter" sourceRef="t_schedulePayment" targetRef="t_sendLetter" />
    <bpmn:sequenceFlow id="f-t_reject-t_sendLetter" sourceRef="t_reject" targetRef="t_sendLetter" />
    <bpmn:sequenceFlow id="f-t_sendLetter-e_done" sourceRef="t_sendLetter" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>
