<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental Health Care Institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="family_doctor" name="Family Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fd_notice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>sec_inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_connect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_new_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_cards_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_produce_card1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_produce_card2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_cards_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_new_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>team_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>team_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>team_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_medical_required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_prepare_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_receive_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_medical_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after_medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_pass_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_intake_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_type_dictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_typed_notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_intake_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_put_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_provide_status</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing_officer" name="Nursing Officer">
        <bpmn:flowNodeRef>nurse_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nurse_hand_over</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team_leader" name="Team Leader">
        <bpmn:flowNodeRef>team_formulate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_proc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first_intaker" name="First Intaker">
        <bpmn:flowNodeRef>fi_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fi_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fi_observations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fi_store</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second_inticer" name="Second Intaker">
        <bpmn:flowNodeRef>si_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>si_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>si_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Psychiatrist">
        <bpmn:flowNodeRef>psy_participate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Notice by telephone" />
    <bpmn:task id="fd_notice" name="Give notice by telephone" />
    <bpmn:task id="sec_inquire" name="Inquire patient name and residence" />
    <bpmn:task id="sec_connect" name="Connect to nursing officer" />
    <bpmn:task id="sec_store_info" name="Store information in information system" />
    <bpmn:task id="sec_print" name="Print registration form" />
    <bpmn:exclusiveGateway id="g_new_patient" name="New patient?" />
    <bpmn:task id="sec_create_file" name="Create patient file" />
    <bpmn:task id="sec_store_form" name="Store registration form and print in patient file" />
    <bpmn:parallelGateway id="pg_cards_start" name="Start producing registration cards" />
    <bpmn:task id="sec_produce_card1" name="Produce first registration card" />
    <bpmn:task id="sec_produce_card2" name="Produce second registration card" />
    <bpmn:parallelGateway id="pg_cards_end" name="Registration cards produced" />
    <bpmn:task id="sec_add_new_notice" name="Add patient to new notices list" />
    <bpmn:task id="team_meeting" name="Staff meeting (Wednesday)" />
    <bpmn:task id="team_assign" name="Assign new patients to intakers" />
    <bpmn:task id="team_record" name="Record assignment list" />
    <bpmn:exclusiveGateway id="g_medical_required" name="Medical file required?" />
    <bpmn:task id="sec_prepare_letter" name="Prepare and send letter to family doctor" />
    <bpmn:task id="sec_receive_medical" name="Receive medical file copy" />
    <bpmn:task id="sec_inform_second" name="Inform second intaker of received medical file" />
    <bpmn:task id="sec_add_medical_copy" name="Add medical file copy to patient file" />
    <bpmn:exclusiveGateway id="after_medical" name="After medical handling" />
    <bpmn:task id="sec_pass_cards" name="Pass registration cards to intakers" />
    <bpmn:parallelGateway id="pg_intake_start" name="Start intake meetings" />
    <bpmn:task id="sec_type_dictaphone" name="Type dictaphone notes" />
    <bpmn:task id="sec_add_typed_notes" name="Add typed notes to patient file" />
    <bpmn:parallelGateway id="pg_intake_end" name="Intake meetings completed" />
    <bpmn:task id="sec_put_status" name="Put patient on status list" />
    <bpmn:task id="sec_provide_status" name="Provide status list to team leader" />
    <bpmn:task id="nurse_inquiry" name="Conduct full inquiry and record on registration form" />
    <bpmn:task id="nurse_hand_over" name="Hand registration form to secretarial office" />
    <bpmn:task id="team_formulate" name="Formulate treatment plan" />
    <bpmn:endEvent id="end_proc" name="Intake procedure completed" />
    <bpmn:task id="fi_plan" name="Plan meeting with patient" />
    <bpmn:task id="fi_meeting" name="Conduct first meeting and complete checklist" />
    <bpmn:task id="fi_observations" name="Register additional observations" />
    <bpmn:task id="fi_store" name="Store notes and checklist in patient file" />
    <bpmn:task id="si_plan" name="Plan meeting with patient" />
    <bpmn:task id="si_meeting" name="Conduct second meeting" />
    <bpmn:task id="si_record" name="Record observations with dictaphone" />
    <bpmn:task id="psy_participate" name="Participate in treatment plan formulation" />
    <bpmn:sequenceFlow id="f-start-fd_notice" sourceRef="start" targetRef="fd_notice" />
    <bpmn:sequenceFlow id="f-fd_notice-sec_inquire" sourceRef="fd_notice" targetRef="sec_inquire" />
    <bpmn:sequenceFlow id="f-sec_inquire-sec_connect" sourceRef="sec_inquire" targetRef="sec_connect" />
    <bpmn:sequenceFlow id="f-sec_connect-nurse_inquiry" sourceRef="sec_connect" targetRef="nurse_inquiry" />
    <bpmn:sequenceFlow id="f-nurse_inquiry-nurse_hand_over" sourceRef="nurse_inquiry" targetRef="nurse_hand_over" />
    <bpmn:sequenceFlow id="f-nurse_hand_over-sec_store_info" sourceRef="nurse_hand_over" targetRef="sec_store_info" />
    <bpmn:sequenceFlow id="f-sec_store_info-sec_print" sourceRef="sec_store_info" targetRef="sec_print" />
    <bpmn:sequenceFlow id="f-sec_print-g_new_patient" sourceRef="sec_print" targetRef="g_new_patient" />
    <bpmn:sequenceFlow id="f-g_new_patient-sec_create_file" sourceRef="g_new_patient" targetRef="sec_create_file" />
    <bpmn:sequenceFlow id="f-sec_create_file-sec_store_form" sourceRef="sec_create_file" targetRef="sec_store_form" />
    <bpmn:sequenceFlow id="f-g_new_patient-pg_cards_start" sourceRef="g_new_patient" targetRef="pg_cards_start" />
    <bpmn:sequenceFlow id="f-sec_store_form-pg_cards_start" sourceRef="sec_store_form" targetRef="pg_cards_start" />
    <bpmn:sequenceFlow id="f-pg_cards_start-sec_produce_card1" sourceRef="pg_cards_start" targetRef="sec_produce_card1" />
    <bpmn:sequenceFlow id="f-pg_cards_start-sec_produce_card2" sourceRef="pg_cards_start" targetRef="sec_produce_card2" />
    <bpmn:sequenceFlow id="f-sec_produce_card1-pg_cards_end" sourceRef="sec_produce_card1" targetRef="pg_cards_end" />
    <bpmn:sequenceFlow id="f-sec_produce_card2-pg_cards_end" sourceRef="sec_produce_card2" targetRef="pg_cards_end" />
    <bpmn:sequenceFlow id="f-pg_cards_end-sec_add_new_notice" sourceRef="pg_cards_end" targetRef="sec_add_new_notice" />
    <bpmn:sequenceFlow id="f-sec_add_new_notice-team_meeting" sourceRef="sec_add_new_notice" targetRef="team_meeting" />
    <bpmn:sequenceFlow id="f-team_meeting-team_assign" sourceRef="team_meeting" targetRef="team_assign" />
    <bpmn:sequenceFlow id="f-team_assign-team_record" sourceRef="team_assign" targetRef="team_record" />
    <bpmn:sequenceFlow id="f-team_record-g_medical_required" sourceRef="team_record" targetRef="g_medical_required" />
    <bpmn:sequenceFlow id="f-g_medical_required-sec_prepare_letter" sourceRef="g_medical_required" targetRef="sec_prepare_letter" />
    <bpmn:sequenceFlow id="f-sec_prepare_letter-sec_receive_medical" sourceRef="sec_prepare_letter" targetRef="sec_receive_medical" />
    <bpmn:sequenceFlow id="f-sec_receive_medical-sec_inform_second" sourceRef="sec_receive_medical" targetRef="sec_inform_second" />
    <bpmn:sequenceFlow id="f-sec_receive_medical-sec_add_medical_copy" sourceRef="sec_receive_medical" targetRef="sec_add_medical_copy" />
    <bpmn:sequenceFlow id="f-sec_inform_second-after_medical" sourceRef="sec_inform_second" targetRef="after_medical" />
    <bpmn:sequenceFlow id="f-sec_add_medical_copy-after_medical" sourceRef="sec_add_medical_copy" targetRef="after_medical" />
    <bpmn:sequenceFlow id="f-g_medical_required-after_medical" sourceRef="g_medical_required" targetRef="after_medical" />
    <bpmn:sequenceFlow id="f-after_medical-sec_pass_cards" sourceRef="after_medical" targetRef="sec_pass_cards" />
    <bpmn:sequenceFlow id="f-sec_pass_cards-pg_intake_start" sourceRef="sec_pass_cards" targetRef="pg_intake_start" />
    <bpmn:sequenceFlow id="f-pg_intake_start-fi_plan" sourceRef="pg_intake_start" targetRef="fi_plan" />
    <bpmn:sequenceFlow id="f-pg_intake_start-si_plan" sourceRef="pg_intake_start" targetRef="si_plan" />
    <bpmn:sequenceFlow id="f-fi_plan-fi_meeting" sourceRef="fi_plan" targetRef="fi_meeting" />
    <bpmn:sequenceFlow id="f-fi_meeting-fi_observations" sourceRef="fi_meeting" targetRef="fi_observations" />
    <bpmn:sequenceFlow id="f-fi_observations-fi_store" sourceRef="fi_observations" targetRef="fi_store" />
    <bpmn:sequenceFlow id="f-fi_store-pg_intake_end" sourceRef="fi_store" targetRef="pg_intake_end" />
    <bpmn:sequenceFlow id="f-si_plan-si_meeting" sourceRef="si_plan" targetRef="si_meeting" />
    <bpmn:sequenceFlow id="f-si_meeting-si_record" sourceRef="si_meeting" targetRef="si_record" />
    <bpmn:sequenceFlow id="f-si_record-sec_type_dictaphone" sourceRef="si_record" targetRef="sec_type_dictaphone" />
    <bpmn:sequenceFlow id="f-sec_type_dictaphone-sec_add_typed_notes" sourceRef="sec_type_dictaphone" targetRef="sec_add_typed_notes" />
    <bpmn:sequenceFlow id="f-sec_add_typed_notes-pg_intake_end" sourceRef="sec_add_typed_notes" targetRef="pg_intake_end" />
    <bpmn:sequenceFlow id="f-pg_intake_end-sec_put_status" sourceRef="pg_intake_end" targetRef="sec_put_status" />
    <bpmn:sequenceFlow id="f-sec_put_status-sec_provide_status" sourceRef="sec_put_status" targetRef="sec_provide_status" />
    <bpmn:sequenceFlow id="f-sec_provide_status-psy_participate" sourceRef="sec_provide_status" targetRef="psy_participate" />
    <bpmn:sequenceFlow id="f-psy_participate-team_formulate" sourceRef="psy_participate" targetRef="team_formulate" />
    <bpmn:sequenceFlow id="f-team_formulate-end_proc" sourceRef="team_formulate" targetRef="end_proc" />
  </bpmn:process>
</bpmn:definitions>
