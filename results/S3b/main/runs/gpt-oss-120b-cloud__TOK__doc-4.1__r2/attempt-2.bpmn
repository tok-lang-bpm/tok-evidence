<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake Workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental Health Care Institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake Workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="family_doctor" name="Family Doctor">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fd_notice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>sec_inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_record_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_hand_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_system</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_new_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cards_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_produce_card_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_produce_card_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cards_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_to_new_notices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_staff_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_pass_card_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_pass_card_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_medical_file_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_prepare_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_wait_medical_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_inform_second_intaker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_medical_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_type_dictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_meetings_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_update_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_provide_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing" name="Nursing Officer">
        <bpmn:flowNodeRef>nursing_inquiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team_leader" name="Team Leader">
        <bpmn:flowNodeRef>tl_assign_intakers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tl_form_treatment_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first_intaker" name="First Intaker (Social‑Medical Worker)">
        <bpmn:flowNodeRef>fi_plan_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fi_conduct_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fi_fill_checklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fi_add_notes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second_intaker" name="Second Intaker (Physician)">
        <bpmn:flowNodeRef>si_plan_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>si_conduct_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>si_record_dictaphone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Psychiatrist" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Intake notice by telephone" />
    <bpmn:task id="fd_notice" name="Family doctor gives notice by telephone" />
    <bpmn:task id="sec_inquire" name="Secretarial worker inquires name and residence" />
    <bpmn:task id="sec_record_form" name="Record information on registration form" />
    <bpmn:task id="sec_hand_form" name="Hand registration form to secretarial office" />
    <bpmn:task id="sec_store_system" name="Store information in information system" />
    <bpmn:task id="sec_print" name="Print registration form" />
    <bpmn:exclusiveGateway id="g_new_patient" name="Is patient new?" />
    <bpmn:task id="sec_create_file" name="Create patient file" />
    <bpmn:task id="sec_store_form" name="Store registration form and print in patient file" />
    <bpmn:parallelGateway id="g_cards_start" />
    <bpmn:task id="sec_produce_card_first" name="Produce registration card for first intaker" />
    <bpmn:task id="sec_produce_card_second" name="Produce registration card for second intaker" />
    <bpmn:parallelGateway id="g_cards_end" />
    <bpmn:task id="sec_add_to_new_notices" name="Add patient to list of new notices" />
    <bpmn:task id="sec_staff_meeting" name="Staff meeting (Wednesday) – medical team" />
    <bpmn:task id="sec_store_assignment" name="Store assignment in information system" />
    <bpmn:task id="sec_pass_card_first" name="Pass registration card to first intaker" />
    <bpmn:task id="sec_pass_card_second" name="Pass registration card to second intaker" />
    <bpmn:exclusiveGateway id="g_medical_file_needed" name="Is medical file required?" />
    <bpmn:task id="sec_prepare_letter" name="Prepare and send letter to family doctor" />
    <bpmn:task id="sec_wait_medical_file" name="Wait for medical file copy" />
    <bpmn:task id="sec_inform_second_intaker" name="Inform second intaker of received medical file" />
    <bpmn:task id="sec_add_medical_copy" name="Add medical file copy to patient file" />
    <bpmn:task id="sec_type_dictaphone" name="Type out dictaphone recordings" />
    <bpmn:parallelGateway id="pg_meetings_done" />
    <bpmn:task id="sec_update_status" name="Update status list of patients with completed intake" />
    <bpmn:task id="sec_provide_list" name="Provide list of ready patients to team leader" />
    <bpmn:endEvent id="e_end" name="Intake completed" />
    <bpmn:task id="nursing_inquiry" name="Nursing officer makes full inquiry into mental, health, and social state" />
    <bpmn:task id="tl_assign_intakers" name="Team leader assigns first and second intakers and records on assignment list" />
    <bpmn:task id="tl_form_treatment_plan" name="Formulate treatment plan with intakers and psychiatrist" />
    <bpmn:task id="fi_plan_meeting" name="First intaker plans meeting with patient" />
    <bpmn:task id="fi_conduct_meeting" name="First intaker conducts first meeting and examines using checklist" />
    <bpmn:task id="fi_fill_checklist" name="First intaker fills checklist" />
    <bpmn:task id="fi_add_notes" name="First intaker adds notes and checklist to patient file" />
    <bpmn:task id="si_plan_meeting" name="Second intaker plans first meeting (after medical file received)" />
    <bpmn:task id="si_conduct_meeting" name="Second intaker conducts meeting with patient" />
    <bpmn:task id="si_record_dictaphone" name="Physician records observations with dictaphone" />
    <bpmn:sequenceFlow id="f-s0-fd_notice" sourceRef="s0" targetRef="fd_notice" />
    <bpmn:sequenceFlow id="f-fd_notice-sec_inquire" sourceRef="fd_notice" targetRef="sec_inquire" />
    <bpmn:sequenceFlow id="f-sec_inquire-nursing_inquiry" sourceRef="sec_inquire" targetRef="nursing_inquiry" />
    <bpmn:sequenceFlow id="f-nursing_inquiry-sec_record_form" sourceRef="nursing_inquiry" targetRef="sec_record_form" />
    <bpmn:sequenceFlow id="f-sec_record_form-sec_hand_form" sourceRef="sec_record_form" targetRef="sec_hand_form" />
    <bpmn:sequenceFlow id="f-sec_hand_form-sec_store_system" sourceRef="sec_hand_form" targetRef="sec_store_system" />
    <bpmn:sequenceFlow id="f-sec_store_system-sec_print" sourceRef="sec_store_system" targetRef="sec_print" />
    <bpmn:sequenceFlow id="f-sec_print-g_new_patient" sourceRef="sec_print" targetRef="g_new_patient" />
    <bpmn:sequenceFlow id="f-g_new_patient-sec_create_file" name="yes" sourceRef="g_new_patient" targetRef="sec_create_file" />
    <bpmn:sequenceFlow id="f-g_new_patient-sec_store_form" name="no" sourceRef="g_new_patient" targetRef="sec_store_form" />
    <bpmn:sequenceFlow id="f-sec_create_file-sec_store_form" sourceRef="sec_create_file" targetRef="sec_store_form" />
    <bpmn:sequenceFlow id="f-sec_store_form-g_cards_start" sourceRef="sec_store_form" targetRef="g_cards_start" />
    <bpmn:sequenceFlow id="f-g_cards_start-sec_produce_card_first" sourceRef="g_cards_start" targetRef="sec_produce_card_first" />
    <bpmn:sequenceFlow id="f-g_cards_start-sec_produce_card_second" sourceRef="g_cards_start" targetRef="sec_produce_card_second" />
    <bpmn:sequenceFlow id="f-sec_produce_card_first-g_cards_end" sourceRef="sec_produce_card_first" targetRef="g_cards_end" />
    <bpmn:sequenceFlow id="f-sec_produce_card_second-g_cards_end" sourceRef="sec_produce_card_second" targetRef="g_cards_end" />
    <bpmn:sequenceFlow id="f-g_cards_end-sec_add_to_new_notices" sourceRef="g_cards_end" targetRef="sec_add_to_new_notices" />
    <bpmn:sequenceFlow id="f-sec_add_to_new_notices-sec_staff_meeting" sourceRef="sec_add_to_new_notices" targetRef="sec_staff_meeting" />
    <bpmn:sequenceFlow id="f-sec_staff_meeting-tl_assign_intakers" sourceRef="sec_staff_meeting" targetRef="tl_assign_intakers" />
    <bpmn:sequenceFlow id="f-tl_assign_intakers-sec_store_assignment" sourceRef="tl_assign_intakers" targetRef="sec_store_assignment" />
    <bpmn:sequenceFlow id="f-sec_store_assignment-sec_pass_card_first" sourceRef="sec_store_assignment" targetRef="sec_pass_card_first" />
    <bpmn:sequenceFlow id="f-sec_store_assignment-sec_pass_card_second" sourceRef="sec_store_assignment" targetRef="sec_pass_card_second" />
    <bpmn:sequenceFlow id="f-sec_pass_card_first-fi_plan_meeting" sourceRef="sec_pass_card_first" targetRef="fi_plan_meeting" />
    <bpmn:sequenceFlow id="f-sec_pass_card_second-g_medical_file_needed" sourceRef="sec_pass_card_second" targetRef="g_medical_file_needed" />
    <bpmn:sequenceFlow id="f-g_medical_file_needed-sec_prepare_letter" name="yes" sourceRef="g_medical_file_needed" targetRef="sec_prepare_letter" />
    <bpmn:sequenceFlow id="f-g_medical_file_needed-si_plan_meeting" name="no" sourceRef="g_medical_file_needed" targetRef="si_plan_meeting" />
    <bpmn:sequenceFlow id="f-sec_prepare_letter-sec_wait_medical_file" sourceRef="sec_prepare_letter" targetRef="sec_wait_medical_file" />
    <bpmn:sequenceFlow id="f-sec_wait_medical_file-sec_inform_second_intaker" sourceRef="sec_wait_medical_file" targetRef="sec_inform_second_intaker" />
    <bpmn:sequenceFlow id="f-sec_inform_second_intaker-sec_add_medical_copy" sourceRef="sec_inform_second_intaker" targetRef="sec_add_medical_copy" />
    <bpmn:sequenceFlow id="f-sec_add_medical_copy-sec_type_dictaphone" sourceRef="sec_add_medical_copy" targetRef="sec_type_dictaphone" />
    <bpmn:sequenceFlow id="f-sec_type_dictaphone-pg_meetings_done" sourceRef="sec_type_dictaphone" targetRef="pg_meetings_done" />
    <bpmn:sequenceFlow id="f-fi_plan_meeting-fi_conduct_meeting" sourceRef="fi_plan_meeting" targetRef="fi_conduct_meeting" />
    <bpmn:sequenceFlow id="f-fi_conduct_meeting-fi_fill_checklist" sourceRef="fi_conduct_meeting" targetRef="fi_fill_checklist" />
    <bpmn:sequenceFlow id="f-fi_fill_checklist-fi_add_notes" sourceRef="fi_fill_checklist" targetRef="fi_add_notes" />
    <bpmn:sequenceFlow id="f-fi_add_notes-pg_meetings_done" sourceRef="fi_add_notes" targetRef="pg_meetings_done" />
    <bpmn:sequenceFlow id="f-si_plan_meeting-si_conduct_meeting" sourceRef="si_plan_meeting" targetRef="si_conduct_meeting" />
    <bpmn:sequenceFlow id="f-si_conduct_meeting-si_record_dictaphone" sourceRef="si_conduct_meeting" targetRef="si_record_dictaphone" />
    <bpmn:sequenceFlow id="f-si_record_dictaphone-sec_type_dictaphone" sourceRef="si_record_dictaphone" targetRef="sec_type_dictaphone" />
    <bpmn:sequenceFlow id="f-pg_meetings_done-sec_update_status" sourceRef="pg_meetings_done" targetRef="sec_update_status" />
    <bpmn:sequenceFlow id="f-sec_update_status-sec_provide_list" sourceRef="sec_update_status" targetRef="sec_provide_list" />
    <bpmn:sequenceFlow id="f-sec_provide_list-tl_form_treatment_plan" sourceRef="sec_provide_list" targetRef="tl_form_treatment_plan" />
    <bpmn:sequenceFlow id="f-tl_form_treatment_plan-e_end" sourceRef="tl_form_treatment_plan" targetRef="e_end" />
  </bpmn:process>
</bpmn:definitions>
