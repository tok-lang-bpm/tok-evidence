<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Loan approval process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Loan approval process" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="risk_service" name="Risk Assessment Service">
        <bpmn:flowNodeRef>invoke_risk_assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve_loan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny_loan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="approver" name="Approver Service">
        <bpmn:flowNodeRef>send_to_approver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approver_approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="receive" name="Receive customer request" />
    <bpmn:task id="receive_feedback" name="Customer receives feedback" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:task id="invoke_risk_assessment" name="Invoke risk assessment Web service" />
    <bpmn:exclusiveGateway id="assess_decision" name="Assess decision?" />
    <bpmn:task id="approve_loan" name="Approve loan" />
    <bpmn:task id="deny_loan" name="Deny loan" />
    <bpmn:task id="send_to_approver" name="Send request to approver Web service" />
    <bpmn:task id="approver_approve" name="Approver approves loan" />
    <bpmn:sequenceFlow id="f-receive-invoke_risk_assessment" sourceRef="receive" targetRef="invoke_risk_assessment" />
    <bpmn:sequenceFlow id="f-invoke_risk_assessment-assess_decision" sourceRef="invoke_risk_assessment" targetRef="assess_decision" />
    <bpmn:sequenceFlow id="f-assess_decision-approve_loan" name="small &amp; low risk" sourceRef="assess_decision" targetRef="approve_loan" />
    <bpmn:sequenceFlow id="f-assess_decision-deny_loan" name="high risk" sourceRef="assess_decision" targetRef="deny_loan" />
    <bpmn:sequenceFlow id="f-assess_decision-send_to_approver" name="needs review or amount ≥ 10000" sourceRef="assess_decision" targetRef="send_to_approver" />
    <bpmn:sequenceFlow id="f-approve_loan-receive_feedback" sourceRef="approve_loan" targetRef="receive_feedback" />
    <bpmn:sequenceFlow id="f-deny_loan-receive_feedback" sourceRef="deny_loan" targetRef="receive_feedback" />
    <bpmn:sequenceFlow id="f-send_to_approver-approver_approve" sourceRef="send_to_approver" targetRef="approver_approve" />
    <bpmn:sequenceFlow id="f-approver_approve-receive_feedback" sourceRef="approver_approve" targetRef="receive_feedback" />
    <bpmn:sequenceFlow id="f-receive_feedback-completed" sourceRef="receive_feedback" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
