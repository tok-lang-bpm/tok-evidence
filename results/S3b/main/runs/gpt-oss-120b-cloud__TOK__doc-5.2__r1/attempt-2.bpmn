<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Submit vacation request" />
    <bpmn:task id="t_register" name="Register vacation request" />
    <bpmn:task id="t_review" name="Review rejection reasons" />
    <bpmn:endEvent id="e_rejected" name="Vacation request rejected" />
    <bpmn:task id="t_receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="g_approve" name="Approve request?" />
    <bpmn:task id="t_reject" name="Return application to employee" />
    <bpmn:task id="t_notify" name="Generate notification to HR" />
    <bpmn:task id="t_complete" name="Complete management procedures" />
    <bpmn:endEvent id="e_approved" name="Vacation request approved" />
    <bpmn:sequenceFlow id="f-s1-t_register" sourceRef="s1" targetRef="t_register" />
    <bpmn:sequenceFlow id="f-t_register-t_receive" sourceRef="t_register" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f-t_receive-g_approve" sourceRef="t_receive" targetRef="g_approve" />
    <bpmn:sequenceFlow id="f-g_approve-t_reject" name="no" sourceRef="g_approve" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f-g_approve-t_notify" name="yes" sourceRef="g_approve" targetRef="t_notify" />
    <bpmn:sequenceFlow id="f-t_reject-t_review" sourceRef="t_reject" targetRef="t_review" />
    <bpmn:sequenceFlow id="f-t_review-e_rejected" sourceRef="t_review" targetRef="e_rejected" />
    <bpmn:sequenceFlow id="f-t_notify-t_complete" sourceRef="t_notify" targetRef="t_complete" />
    <bpmn:sequenceFlow id="f-t_complete-e_approved" sourceRef="t_complete" targetRef="e_approved" />
  </bpmn:process>
</bpmn:definitions>
