tok 1.0 "Vacations Request"

pool org "Organization"
  lane employee "Employee"
    start s1 "Submit vacation request"
    task t_register "Register vacation request"
    task t_review "Review rejection reasons"
    end e_rejected "Vacation request rejected"
  lane supervisor "Supervisor"
    task t_receive "Receive vacation request"
    xor g_approve "Approve request?"
    task t_reject "Return application to employee"
  lane hr "Human Resources Representative"
    task t_notify "Generate notification to HR"
    task t_complete "Complete management procedures"
    end e_approved "Vacation request approved"

flow s1 -> t_register -> t_receive -> g_approve
flow g_approve -> t_reject "no"
flow g_approve -> t_notify "yes"
flow t_reject -> t_review -> e_rejected
flow t_notify -> t_complete -> e_approved
