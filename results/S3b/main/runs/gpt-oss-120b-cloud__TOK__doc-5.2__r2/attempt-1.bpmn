<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacation Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacation Request Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Vacation request submitted" />
    <bpmn:task id="register" name="Register vacation request" />
    <bpmn:task id="review" name="Review rejection reasons" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:task id="receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="decision" name="Approve request?" />
    <bpmn:task id="approve" name="Approve vacation request" />
    <bpmn:task id="reject" name="Reject vacation request" />
    <bpmn:task id="notify" name="Generate notification to HR" />
    <bpmn:task id="manage" name="Complete management procedures" />
    <bpmn:endEvent id="approved" name="Request approved" />
    <bpmn:sequenceFlow id="f-start-register" sourceRef="start" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decision" sourceRef="receive" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-approve" name="yes" sourceRef="decision" targetRef="approve" />
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-approve-notify" sourceRef="approve" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-manage" sourceRef="notify" targetRef="manage" />
    <bpmn:sequenceFlow id="f-manage-approved" sourceRef="manage" targetRef="approved" />
    <bpmn:sequenceFlow id="f-reject-review" sourceRef="reject" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-rejected" sourceRef="review" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
