tok 1.0 "Vacation Request Process"

pool org "Organization"
  lane employee "Employee"
    start start "Vacation request submitted"
    task register "Register vacation request"
    task review "Review rejection reasons"
    end rejected "Request rejected"

  lane supervisor "Supervisor"
    task receive "Receive vacation request"
    xor decision "Approve request?"
    task approve "Approve vacation request"
    task reject "Reject vacation request"

  lane hr "Human Resources Representative"
    task notify "Generate notification to HR"
    task manage "Complete management procedures"
    end approved "Request approved"

flow start -> register -> receive -> decision
flow decision -> approve "yes"
flow decision -> reject "no"
flow approve -> notify -> manage -> approved
flow reject -> review -> rejected
