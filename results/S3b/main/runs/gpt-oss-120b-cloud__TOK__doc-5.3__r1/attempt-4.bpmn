<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Office Supply Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Office Supply Request Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_requirement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>employee_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sup_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="purchase" name="Purchase Department">
        <bpmn:flowNodeRef>make_quotations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vendor_valid_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose_different_vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_delivery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>send_notification_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_notification_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_notification_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_notification_completion</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Office supply request submitted" />
    <bpmn:task id="submit_request" name="Submit office supply request" />
    <bpmn:task id="register_requirement" name="Register requirement" />
    <bpmn:task id="employee_review" name="Review change request" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="completed" name="Request completed" />
    <bpmn:task id="receive_request" name="Receive request" />
    <bpmn:exclusiveGateway id="sup_dec" name="Supervisor decision?" />
    <bpmn:task id="approve_request" name="Approve request" />
    <bpmn:task id="ask_change" name="Ask for change" />
    <bpmn:task id="reject_request" name="Reject request" />
    <bpmn:subProcess id="make_quotations" name="Make quotations" />
    <bpmn:task id="select_vendor" name="Select vendor" />
    <bpmn:exclusiveGateway id="vendor_valid_gw" name="Vendor valid?" />
    <bpmn:task id="choose_different_vendor" name="Choose different vendor" />
    <bpmn:task id="generate_po" name="Generate and send purchase order" />
    <bpmn:task id="wait_delivery" name="Wait for product delivery and invoice receipt" />
    <bpmn:task id="send_notification_approval" name="Send approval notification" />
    <bpmn:task id="send_notification_rejection" name="Send rejection notification" />
    <bpmn:task id="send_notification_change" name="Send change request notification" />
    <bpmn:task id="send_notification_completion" name="Send completion notification" />
    <bpmn:sequenceFlow id="f-start_event-submit_request" sourceRef="start_event" targetRef="submit_request" />
    <bpmn:sequenceFlow id="f-submit_request-register_requirement" sourceRef="submit_request" targetRef="register_requirement" />
    <bpmn:sequenceFlow id="f-register_requirement-receive_request" sourceRef="register_requirement" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f-receive_request-sup_dec" sourceRef="receive_request" targetRef="sup_dec" />
    <bpmn:sequenceFlow id="f-sup_dec-approve_request" name="approve" sourceRef="sup_dec" targetRef="approve_request" />
    <bpmn:sequenceFlow id="f-sup_dec-ask_change" name="change" sourceRef="sup_dec" targetRef="ask_change" />
    <bpmn:sequenceFlow id="f-sup_dec-reject_request" name="reject" sourceRef="sup_dec" targetRef="reject_request" />
    <bpmn:sequenceFlow id="f-approve_request-send_notification_approval" sourceRef="approve_request" targetRef="send_notification_approval" />
    <bpmn:sequenceFlow id="f-send_notification_approval-make_quotations" sourceRef="send_notification_approval" targetRef="make_quotations" />
    <bpmn:sequenceFlow id="f-make_quotations-select_vendor" sourceRef="make_quotations" targetRef="select_vendor" />
    <bpmn:sequenceFlow id="f-select_vendor-vendor_valid_gw" sourceRef="select_vendor" targetRef="vendor_valid_gw" />
    <bpmn:sequenceFlow id="f-vendor_valid_gw-select_vendor" name="valid" sourceRef="vendor_valid_gw" targetRef="select_vendor" />
    <bpmn:sequenceFlow id="f-vendor_valid_gw-choose_different_vendor" name="invalid" sourceRef="vendor_valid_gw" targetRef="choose_different_vendor" />
    <bpmn:sequenceFlow id="f-choose_different_vendor-select_vendor" sourceRef="choose_different_vendor" targetRef="select_vendor" />
    <bpmn:sequenceFlow id="f-select_vendor-generate_po" sourceRef="select_vendor" targetRef="generate_po" />
    <bpmn:sequenceFlow id="f-generate_po-wait_delivery" sourceRef="generate_po" targetRef="wait_delivery" />
    <bpmn:sequenceFlow id="f-reject_request-send_notification_rejection" sourceRef="reject_request" targetRef="send_notification_rejection" />
    <bpmn:sequenceFlow id="f-send_notification_rejection-rejected" sourceRef="send_notification_rejection" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-ask_change-send_notification_change" sourceRef="ask_change" targetRef="send_notification_change" />
    <bpmn:sequenceFlow id="f-send_notification_change-employee_review" sourceRef="send_notification_change" targetRef="employee_review" />
    <bpmn:sequenceFlow id="f-employee_review-sup_dec" sourceRef="employee_review" targetRef="sup_dec" />
    <bpmn:sequenceFlow id="f-wait_delivery-send_notification_completion" sourceRef="wait_delivery" targetRef="send_notification_completion" />
    <bpmn:sequenceFlow id="f-send_notification_completion-completed" sourceRef="send_notification_completion" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
