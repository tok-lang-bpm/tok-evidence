<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense Reimbursement Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense Reimbursement Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sup_dec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tre_dec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Payment System">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="pu" name="Purchase product or service" />
    <bpmn:task id="sub" name="Submit expense report" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="rev" name="Review expense report" />
    <bpmn:exclusiveGateway id="sup_dec" name="Supervisor approves?" />
    <bpmn:task id="chk" name="Check receipts" />
    <bpmn:exclusiveGateway id="tre_dec" name="All receipts match?" />
    <bpmn:task id="link" name="Link to payment system" />
    <bpmn:task id="wait" name="Wait for payment confirmation" />
    <bpmn:endEvent id="e" name="Process end" />
    <bpmn:sequenceFlow id="f-s-pu" sourceRef="s" targetRef="pu" />
    <bpmn:sequenceFlow id="f-pu-sub" sourceRef="pu" targetRef="sub" />
    <bpmn:sequenceFlow id="f-sub-rev" sourceRef="sub" targetRef="rev" />
    <bpmn:sequenceFlow id="f-rev-sup_dec" sourceRef="rev" targetRef="sup_dec" />
    <bpmn:sequenceFlow id="f-sup_dec-chk" name="yes" sourceRef="sup_dec" targetRef="chk" />
    <bpmn:sequenceFlow id="f-sup_dec-edit" name="no" sourceRef="sup_dec" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-rev" sourceRef="edit" targetRef="rev" />
    <bpmn:sequenceFlow id="f-chk-tre_dec" sourceRef="chk" targetRef="tre_dec" />
    <bpmn:sequenceFlow id="f-tre_dec-link" name="yes" sourceRef="tre_dec" targetRef="link" />
    <bpmn:sequenceFlow id="f-tre_dec-edit" name="no" sourceRef="tre_dec" targetRef="edit" />
    <bpmn:sequenceFlow id="f-link-wait" sourceRef="link" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-e" sourceRef="wait" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
