<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense Report Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Expense Report Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sup_decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipts_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="sup_decision" name="Report approved?" />
    <bpmn:task id="check" name="Check receipts" />
    <bpmn:exclusiveGateway id="receipts_decision" name="Receipts complete?" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:task id="link" name="Link to payment system" />
    <bpmn:task id="wait" name="Wait for payment confirmation" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-purchase" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-sup_decision" sourceRef="review" targetRef="sup_decision" />
    <bpmn:sequenceFlow id="f-sup_decision-check" name="approve" sourceRef="sup_decision" targetRef="check" />
    <bpmn:sequenceFlow id="f-sup_decision-edit" name="reject" sourceRef="sup_decision" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-review" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f-check-receipts_decision" sourceRef="check" targetRef="receipts_decision" />
    <bpmn:sequenceFlow id="f-receipts_decision-accept" name="yes" sourceRef="receipts_decision" targetRef="accept" />
    <bpmn:sequenceFlow id="f-receipts_decision-edit" name="no" sourceRef="receipts_decision" targetRef="edit" />
    <bpmn:sequenceFlow id="f-accept-link" sourceRef="accept" targetRef="link" />
    <bpmn:sequenceFlow id="f-link-wait" sourceRef="link" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-end" sourceRef="wait" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
