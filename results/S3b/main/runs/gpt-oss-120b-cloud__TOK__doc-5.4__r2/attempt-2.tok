tok 1.0 "Expense Report Process"

pool organization "Organization"
  lane employee "Employee"
    start start "Start"
    task purchase "Purchase product or service"
    task submit "Submit expense report"
    task edit "Edit expense report"
  lane supervisor "Supervisor"
    task review "Review expense report"
    xor sup_decision "Report approved?"
  lane treasurer "Treasurer"
    task check "Check receipts"
    xor receipts_decision "Receipts complete?"
    task accept "Accept expenses for processing"
  lane system "System"
    task link "Link to payment system"
    task wait "Wait for payment confirmation"
    end end "End"

flow start -> purchase -> submit -> review -> sup_decision
flow sup_decision -> check "approve"
flow sup_decision -> edit "reject"
flow edit -> review
flow check -> receipts_decision
flow receipts_decision -> accept "yes"
flow receipts_decision -> edit "no"
flow accept -> link -> wait -> end
