<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice Processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ACME_AG" name="ACME AG" processRef="ACME_AG-process" />
  </bpmn:collaboration>
  <bpmn:process id="ACME_AG-process" name="Invoice Processing" isExecutable="false">
    <bpmn:laneSet id="ACME_AG-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting Employee">
        <bpmn:flowNodeRef>i3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ft14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rb20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gp21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e22</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Cost Center Manager">
        <bpmn:flowNodeRef>rev6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ma8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sn11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial Manager">
        <bpmn:flowNodeRef>pa15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hc17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>br19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>approve_board</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Invoices received" />
    <bpmn:task id="r1" name="Receive invoice on paper or fax" />
    <bpmn:task id="f2" name="Forward invoice after visual inspection to accounting employee" />
    <bpmn:task id="i3" name="Identify charging suppliers and create invoice instance" />
    <bpmn:task id="c4" name="Check invoice items and note cost centers and managers on docket" />
    <bpmn:task id="s5" name="Send docket and copy of invoice to internal mail" />
    <bpmn:task id="cl13" name="Clarify inconsistencies with vendor (consult managers if needed)" />
    <bpmn:task id="ft14" name="Forward copy of invoice to commercial manager" />
    <bpmn:task id="rb20" name="Receive reviewed copy from board" />
    <bpmn:task id="gp21" name="Give payment instructions and close invoice" />
    <bpmn:endEvent id="e22" name="Process completed" />
    <bpmn:task id="rev6" name="Review invoice for accuracy" />
    <bpmn:exclusiveGateway id="g7" name="Is position accurate?" />
    <bpmn:task id="ma8" name="Mark position as accurate (AP)" />
    <bpmn:task id="rp9" name="Reject position with note" />
    <bpmn:exclusiveGateway id="g10" name="All positions marked accurate?" />
    <bpmn:task id="sn11" name="Send docket and copy to next cost center manager" />
    <bpmn:task id="rt12" name="Return copy to accounting" />
    <bpmn:task id="pa15" name="Perform commercial audit" />
    <bpmn:exclusiveGateway id="g16" name="Complaint during audit?" />
    <bpmn:task id="hc17" name="Handle complaint with supplier" />
    <bpmn:exclusiveGateway id="g18" name="Amount &gt; EUR 20?" />
    <bpmn:task id="br19" name="Board review" />
    <bpmn:task id="approve_board" name="Approve invoice" />
    <bpmn:sequenceFlow id="f-s0-r1" sourceRef="s0" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-f2" sourceRef="r1" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-i3" sourceRef="f2" targetRef="i3" />
    <bpmn:sequenceFlow id="f-i3-c4" sourceRef="i3" targetRef="c4" />
    <bpmn:sequenceFlow id="f-c4-s5" sourceRef="c4" targetRef="s5" />
    <bpmn:sequenceFlow id="f-s5-rev6" sourceRef="s5" targetRef="rev6" />
    <bpmn:sequenceFlow id="f-rev6-g7" sourceRef="rev6" targetRef="g7" />
    <bpmn:sequenceFlow id="f-g7-ma8" name="yes" sourceRef="g7" targetRef="ma8" />
    <bpmn:sequenceFlow id="f-g7-rp9" name="no" sourceRef="g7" targetRef="rp9" />
    <bpmn:sequenceFlow id="f-ma8-g10" sourceRef="ma8" targetRef="g10" />
    <bpmn:sequenceFlow id="f-rp9-cl13" sourceRef="rp9" targetRef="cl13" />
    <bpmn:sequenceFlow id="f-cl13-s5" sourceRef="cl13" targetRef="s5" />
    <bpmn:sequenceFlow id="f-g10-sn11" name="no" sourceRef="g10" targetRef="sn11" />
    <bpmn:sequenceFlow id="f-g10-rt12" name="yes" sourceRef="g10" targetRef="rt12" />
    <bpmn:sequenceFlow id="f-sn11-rev6" sourceRef="sn11" targetRef="rev6" />
    <bpmn:sequenceFlow id="f-rt12-ft14" sourceRef="rt12" targetRef="ft14" />
    <bpmn:sequenceFlow id="f-ft14-pa15" sourceRef="ft14" targetRef="pa15" />
    <bpmn:sequenceFlow id="f-pa15-g16" sourceRef="pa15" targetRef="g16" />
    <bpmn:sequenceFlow id="f-g16-hc17" name="yes" sourceRef="g16" targetRef="hc17" />
    <bpmn:sequenceFlow id="f-hc17-pa15" sourceRef="hc17" targetRef="pa15" />
    <bpmn:sequenceFlow id="f-g16-g18" name="no" sourceRef="g16" targetRef="g18" />
    <bpmn:sequenceFlow id="f-g18-br19" name="yes" sourceRef="g18" targetRef="br19" />
    <bpmn:sequenceFlow id="f-g18-approve_board" name="no" sourceRef="g18" targetRef="approve_board" />
    <bpmn:sequenceFlow id="f-br19-approve_board" sourceRef="br19" targetRef="approve_board" />
    <bpmn:sequenceFlow id="f-approve_board-rb20" sourceRef="approve_board" targetRef="rb20" />
    <bpmn:sequenceFlow id="f-rb20-gp21" sourceRef="rb20" targetRef="gp21" />
    <bpmn:sequenceFlow id="f-gp21-e22" sourceRef="gp21" targetRef="e22" />
  </bpmn:process>
</bpmn:definitions>
