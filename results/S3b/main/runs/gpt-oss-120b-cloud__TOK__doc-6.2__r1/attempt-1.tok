tok 1.0 "Monthly order process"

pool supply "Supply Chain"
  lane assembler "Assembler AG"
    start start1 "Monthly start" timer=P1M
    task send_order "Send order to supplier"
    task receive_invoice "Receive invoice"
    end end1 "Process complete"
  lane supplier "Supplier"
    task process_order "Process the order"
    task send_invoice "Send invoice to Assembler AG"

flow start1 -> send_order -> process_order -> send_invoice -> receive_invoice -> end1
