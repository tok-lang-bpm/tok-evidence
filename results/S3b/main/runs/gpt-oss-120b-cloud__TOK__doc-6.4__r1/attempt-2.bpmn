<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customer acquisition process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="determination" name="Determination">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>methodChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>personalReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>afterMethod</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="call_center" name="Call Center">
        <bpmn:flowNodeRef>startCalling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budgetHugeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>headAcquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leaveAlone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>presentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preSalesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>responseDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesFollowupCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createQuotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no_response</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:exclusiveGateway id="methodChoice" name="Determine contact details method?" />
    <bpmn:task id="buyDetails" name="Buy contact details" />
    <bpmn:task id="exhibition" name="Participate in exhibitions" />
    <bpmn:task id="personalReferral" name="Use personal referral" />
    <bpmn:exclusiveGateway id="afterMethod" name="Method selected" />
    <bpmn:task id="startCalling" name="Start calling the customer" />
    <bpmn:task id="determineContactPerson" name="Determine contact person" />
    <bpmn:task id="determineBudget" name="Determine budget" />
    <bpmn:task id="askInterest" name="Ask if generally interested" />
    <bpmn:exclusiveGateway id="interestDecision" name="Customer interested?" />
    <bpmn:exclusiveGateway id="budgetHugeDecision" name="Budget huge?" />
    <bpmn:task id="headAcquire" name="Head of development tries to acquire the customer" />
    <bpmn:task id="leaveAlone" name="Leave customer alone" />
    <bpmn:exclusiveGateway id="presentationType" name="Presentation type?" />
    <bpmn:task id="salesPresentation" name="Sales representative gives detailed online presentation" />
    <bpmn:task id="preSalesPresentation" name="Pre‑sales employee gives technical online presentation" />
    <bpmn:task id="waitResponse" name="Wait for customer response (2 weeks)" />
    <bpmn:exclusiveGateway id="responseDecision" name="Customer responded within 2 weeks?" />
    <bpmn:task id="salesFollowupCall" name="Sales representative calls the customer" />
    <bpmn:task id="createQuotation" name="Create quotation" />
    <bpmn:endEvent id="success" name="Quotation created" />
    <bpmn:endEvent id="not_interested" name="Process not interested" />
    <bpmn:endEvent id="no_response" name="No response – process ends" />
    <bpmn:sequenceFlow id="f-start-methodChoice" sourceRef="start" targetRef="methodChoice" />
    <bpmn:sequenceFlow id="f-methodChoice-buyDetails" sourceRef="methodChoice" targetRef="buyDetails" />
    <bpmn:sequenceFlow id="f-methodChoice-exhibition" sourceRef="methodChoice" targetRef="exhibition" />
    <bpmn:sequenceFlow id="f-methodChoice-personalReferral" sourceRef="methodChoice" targetRef="personalReferral" />
    <bpmn:sequenceFlow id="f-buyDetails-afterMethod" sourceRef="buyDetails" targetRef="afterMethod" />
    <bpmn:sequenceFlow id="f-exhibition-afterMethod" sourceRef="exhibition" targetRef="afterMethod" />
    <bpmn:sequenceFlow id="f-personalReferral-afterMethod" sourceRef="personalReferral" targetRef="afterMethod" />
    <bpmn:sequenceFlow id="f-afterMethod-startCalling" sourceRef="afterMethod" targetRef="startCalling" />
    <bpmn:sequenceFlow id="f-startCalling-determineContactPerson" sourceRef="startCalling" targetRef="determineContactPerson" />
    <bpmn:sequenceFlow id="f-determineContactPerson-determineBudget" sourceRef="determineContactPerson" targetRef="determineBudget" />
    <bpmn:sequenceFlow id="f-determineBudget-askInterest" sourceRef="determineBudget" targetRef="askInterest" />
    <bpmn:sequenceFlow id="f-askInterest-interestDecision" sourceRef="askInterest" targetRef="interestDecision" />
    <bpmn:sequenceFlow id="f-interestDecision-presentationType" name="yes" sourceRef="interestDecision" targetRef="presentationType" />
    <bpmn:sequenceFlow id="f-interestDecision-budgetHugeDecision" name="no" sourceRef="interestDecision" targetRef="budgetHugeDecision" />
    <bpmn:sequenceFlow id="f-budgetHugeDecision-headAcquire" name="yes" sourceRef="budgetHugeDecision" targetRef="headAcquire" />
    <bpmn:sequenceFlow id="f-budgetHugeDecision-leaveAlone" name="no" sourceRef="budgetHugeDecision" targetRef="leaveAlone" />
    <bpmn:sequenceFlow id="f-headAcquire-presentationType" sourceRef="headAcquire" targetRef="presentationType" />
    <bpmn:sequenceFlow id="f-leaveAlone-not_interested" sourceRef="leaveAlone" targetRef="not_interested" />
    <bpmn:sequenceFlow id="f-presentationType-salesPresentation" name="sales" sourceRef="presentationType" targetRef="salesPresentation" />
    <bpmn:sequenceFlow id="f-presentationType-preSalesPresentation" name="tech" sourceRef="presentationType" targetRef="preSalesPresentation" />
    <bpmn:sequenceFlow id="f-salesPresentation-waitResponse" sourceRef="salesPresentation" targetRef="waitResponse" />
    <bpmn:sequenceFlow id="f-preSalesPresentation-waitResponse" sourceRef="preSalesPresentation" targetRef="waitResponse" />
    <bpmn:sequenceFlow id="f-waitResponse-responseDecision" sourceRef="waitResponse" targetRef="responseDecision" />
    <bpmn:sequenceFlow id="f-responseDecision-createQuotation" name="yes" sourceRef="responseDecision" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f-responseDecision-salesFollowupCall" name="no" sourceRef="responseDecision" targetRef="salesFollowupCall" />
    <bpmn:sequenceFlow id="f-salesFollowupCall-createQuotation" sourceRef="salesFollowupCall" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f-createQuotation-success" sourceRef="createQuotation" targetRef="success" />
  </bpmn:process>
</bpmn:definitions>
