tok 1.0 "Customer acquisition process"

pool org "Organization"
  lane determination "Determination"
    start start "Process start"
    xor methodChoice "Determine contact details method?"
    task buyDetails "Buy contact details"
    task exhibition "Participate in exhibitions"
    task personalReferral "Use personal referral"
    xor afterMethod "Method selected"
  lane call_center "Call Center"
    task startCalling "Start calling the customer"
    task determineContactPerson "Determine contact person"
    task determineBudget "Determine budget"
    task askInterest "Ask if generally interested"
    xor interestDecision "Customer interested?"
    xor budgetHugeDecision "Budget huge?"
    task headAcquire "Head of development tries to acquire the customer"
    task leaveAlone "Leave customer alone"
  lane sales "Sales"
    xor presentationType "Presentation type?"
    task salesPresentation "Sales representative gives detailed online presentation"
    task preSalesPresentation "Pre‑sales employee gives technical online presentation"
    task waitResponse "Wait for customer response (2 weeks)"
    xor responseDecision "Customer responded within 2 weeks?"
    task salesFollowupCall "Sales representative calls the customer"
    task createQuotation "Create quotation"
    end success "Quotation created"
    end not_interested "Process not interested"
    end no_response "No response – process ends"

flow start -> methodChoice
flow methodChoice -> buyDetails
flow methodChoice -> exhibition
flow methodChoice -> personalReferral
flow buyDetails -> afterMethod
flow exhibition -> afterMethod
flow personalReferral -> afterMethod
flow afterMethod -> startCalling
flow startCalling -> determineContactPerson -> determineBudget -> askInterest
flow askInterest -> interestDecision
flow interestDecision -> presentationType "yes"
flow interestDecision -> budgetHugeDecision "no"
flow budgetHugeDecision -> headAcquire "yes"
flow budgetHugeDecision -> leaveAlone "no"
flow headAcquire -> presentationType
flow leaveAlone -> not_interested
flow presentationType -> salesPresentation "sales"
flow presentationType -> preSalesPresentation "tech"
flow salesPresentation -> waitResponse
flow preSalesPresentation -> waitResponse
flow waitResponse -> responseDecision
flow responseDecision -> createQuotation "yes"
flow responseDecision -> salesFollowupCall "no"
flow salesFollowupCall -> createQuotation
flow createQuotation -> success
