<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customer acquisition process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>participate_exhibitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_known_prospect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call Center staff">
        <bpmn:flowNodeRef>start_calling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_contact_person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_project_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_general_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget_huge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="headdev" name="Head of Development">
        <bpmn:flowNodeRef>head_acquire_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Representative">
        <bpmn:flowNodeRef>presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sales_online_presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_customer_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sales_rep_call_after_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_quotation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre‑sales Employee">
        <bpmn:flowNodeRef>presales_online_presentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="endlane" name="End">
        <bpmn:flowNodeRef>leave_alone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="method" name="Determine contact details method?" />
    <bpmn:task id="buy_details" name="Buy contact details" />
    <bpmn:task id="participate_exhibitions" name="Participate in exhibitions" />
    <bpmn:task id="identify_known_prospect" name="Identify known prospect" />
    <bpmn:task id="start_calling" name="Start calling the customer" />
    <bpmn:parallelGateway id="split_contact" name="Gather contact information" />
    <bpmn:task id="determine_contact_person" name="Determine contact person" />
    <bpmn:task id="determine_project_budget" name="Determine project budget" />
    <bpmn:task id="ask_general_interest" name="Ask if generally interested" />
    <bpmn:parallelGateway id="join_contact" name="Contact information gathered" />
    <bpmn:exclusiveGateway id="interest" name="Is customer generally interested?" />
    <bpmn:exclusiveGateway id="budget_huge" name="Is project budget huge?" />
    <bpmn:task id="head_acquire_customer" name="Head of development tries to acquire the customer" />
    <bpmn:exclusiveGateway id="presentation" name="Which presentation type?" />
    <bpmn:task id="sales_online_presentation" name="Sales representative gives detailed online presentation" />
    <bpmn:task id="wait_customer_response" name="Wait for customer response" />
    <bpmn:exclusiveGateway id="response" name="Customer responded within 2 weeks?" />
    <bpmn:task id="sales_rep_call_after_wait" name="Sales representative calls the customer" />
    <bpmn:task id="create_quotation" name="Create quotation" />
    <bpmn:task id="presales_online_presentation" name="Pre‑sales employee gives technical online presentation" />
    <bpmn:endEvent id="leave_alone" name="Customer left alone" />
    <bpmn:endEvent id="process_end" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-method" sourceRef="start" targetRef="method" />
    <bpmn:sequenceFlow id="f-method-buy_details" name="Buy" sourceRef="method" targetRef="buy_details" />
    <bpmn:sequenceFlow id="f-method-participate_exhibitions" name="Exhibit" sourceRef="method" targetRef="participate_exhibitions" />
    <bpmn:sequenceFlow id="f-method-identify_known_prospect" name="Known" sourceRef="method" targetRef="identify_known_prospect" />
    <bpmn:sequenceFlow id="f-buy_details-start_calling" sourceRef="buy_details" targetRef="start_calling" />
    <bpmn:sequenceFlow id="f-participate_exhibitions-start_calling" sourceRef="participate_exhibitions" targetRef="start_calling" />
    <bpmn:sequenceFlow id="f-identify_known_prospect-start_calling" sourceRef="identify_known_prospect" targetRef="start_calling" />
    <bpmn:sequenceFlow id="f-start_calling-split_contact" sourceRef="start_calling" targetRef="split_contact" />
    <bpmn:sequenceFlow id="f-split_contact-determine_contact_person" sourceRef="split_contact" targetRef="determine_contact_person" />
    <bpmn:sequenceFlow id="f-split_contact-determine_project_budget" sourceRef="split_contact" targetRef="determine_project_budget" />
    <bpmn:sequenceFlow id="f-split_contact-ask_general_interest" sourceRef="split_contact" targetRef="ask_general_interest" />
    <bpmn:sequenceFlow id="f-determine_contact_person-join_contact" sourceRef="determine_contact_person" targetRef="join_contact" />
    <bpmn:sequenceFlow id="f-determine_project_budget-join_contact" sourceRef="determine_project_budget" targetRef="join_contact" />
    <bpmn:sequenceFlow id="f-ask_general_interest-join_contact" sourceRef="ask_general_interest" targetRef="join_contact" />
    <bpmn:sequenceFlow id="f-join_contact-interest" sourceRef="join_contact" targetRef="interest" />
    <bpmn:sequenceFlow id="f-interest-presentation" name="yes" sourceRef="interest" targetRef="presentation" />
    <bpmn:sequenceFlow id="f-interest-budget_huge" name="no" sourceRef="interest" targetRef="budget_huge" />
    <bpmn:sequenceFlow id="f-budget_huge-head_acquire_customer" name="huge" sourceRef="budget_huge" targetRef="head_acquire_customer" />
    <bpmn:sequenceFlow id="f-budget_huge-leave_alone" name="not huge" sourceRef="budget_huge" targetRef="leave_alone" />
    <bpmn:sequenceFlow id="f-head_acquire_customer-presentation" sourceRef="head_acquire_customer" targetRef="presentation" />
    <bpmn:sequenceFlow id="f-presentation-sales_online_presentation" name="sales" sourceRef="presentation" targetRef="sales_online_presentation" />
    <bpmn:sequenceFlow id="f-presentation-presales_online_presentation" name="technical" sourceRef="presentation" targetRef="presales_online_presentation" />
    <bpmn:sequenceFlow id="f-sales_online_presentation-wait_customer_response" sourceRef="sales_online_presentation" targetRef="wait_customer_response" />
    <bpmn:sequenceFlow id="f-presales_online_presentation-wait_customer_response" sourceRef="presales_online_presentation" targetRef="wait_customer_response" />
    <bpmn:sequenceFlow id="f-wait_customer_response-response" sourceRef="wait_customer_response" targetRef="response" />
    <bpmn:sequenceFlow id="f-response-create_quotation" name="within 2 weeks" sourceRef="response" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-response-sales_rep_call_after_wait" name="no response" sourceRef="response" targetRef="sales_rep_call_after_wait" />
    <bpmn:sequenceFlow id="f-sales_rep_call_after_wait-create_quotation" sourceRef="sales_rep_call_after_wait" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-create_quotation-process_end" sourceRef="create_quotation" targetRef="process_end" />
  </bpmn:process>
</bpmn:definitions>
