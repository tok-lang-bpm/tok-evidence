<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lead handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Lead handling process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="check" name="Check open leads" />
    <bpmn:task id="select" name="Select top five leads" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call contacts" />
    <bpmn:task id="process" name="Process lead" />
    <bpmn:endEvent id="processed" name="Lead processed" />
    <bpmn:task id="call" name="Call customers" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" default="f-interested-call" />
    <bpmn:task id="send" name="Send note to Manager" />
    <bpmn:sequenceFlow id="f-start-check" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-interested" sourceRef="call" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-send" name="yes" sourceRef="interested" targetRef="send">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-send-process" sourceRef="send" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-processed" sourceRef="process" targetRef="processed" />
    <bpmn:sequenceFlow id="f-interested-call" name="no" sourceRef="interested" targetRef="call" />
  </bpmn:process>
</bpmn:definitions>
