<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Lead Management Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Lead Management Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="check" name="Check open leads" />
    <bpmn:task id="select" name="Select top five leads" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call contacts" />
    <bpmn:task id="process" name="Process the lead" />
    <bpmn:endEvent id="end1" name="Lead processed" />
    <bpmn:task id="call" name="Call customer" />
    <bpmn:exclusiveGateway id="interest" name="Customer interested?" />
    <bpmn:task id="send_note" name="Send note to Manager" />
    <bpmn:task id="call_next" name="Call next customer" />
    <bpmn:sequenceFlow id="f-start1-check" sourceRef="start1" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-interest" sourceRef="call" targetRef="interest" />
    <bpmn:sequenceFlow id="f-interest-send_note" name="yes" sourceRef="interest" targetRef="send_note" />
    <bpmn:sequenceFlow id="f-interest-call_next" name="no" sourceRef="interest" targetRef="call_next" />
    <bpmn:sequenceFlow id="f-send_note-process" sourceRef="send_note" targetRef="process" />
    <bpmn:sequenceFlow id="f-call_next-call" sourceRef="call_next" targetRef="call" />
    <bpmn:sequenceFlow id="f-process-end1" sourceRef="process" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
