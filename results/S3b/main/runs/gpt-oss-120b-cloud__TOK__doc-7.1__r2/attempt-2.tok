tok 1.0 "Lead Management Process"

pool org "Organization"
  lane manager "Manager"
    start start1 "Start"
    task check "Check open leads"
    task select "Select top five leads"
    task tell "Tell Sales Assistant to call contacts"
    task process "Process the lead"
    end end1 "Lead processed"
  lane assistant "Sales Assistant"
    task call "Call customer"
    xor interest "Customer interested?"
    task send_note "Send note to Manager"
    task call_next "Call next customer"

flow start1 -> check -> select -> tell -> call
flow call -> interest
flow interest -> send_note "yes"
flow interest -> call_next "no"
flow send_note -> process
flow call_next -> call
flow process -> end1
