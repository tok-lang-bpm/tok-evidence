<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Post recruitment process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Post recruitment process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="functional_department" name="Functional Department">
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="demand" name="Demand to fill a post" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="check" name="Check the applications" />
    <bpmn:task id="fill" name="Fill the post" />
    <bpmn:task id="conclude" name="Conclude contract of employment" />
    <bpmn:endEvent id="filled" name="Post filled" />
    <bpmn:task id="apply" name="Apply for the post" />
    <bpmn:sequenceFlow id="f-demand-advertise" sourceRef="demand" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-apply" sourceRef="advertise" targetRef="apply" />
    <bpmn:sequenceFlow id="f-apply-check" sourceRef="apply" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-fill" sourceRef="check" targetRef="fill" />
    <bpmn:sequenceFlow id="f-fill-conclude" sourceRef="fill" targetRef="conclude" />
    <bpmn:sequenceFlow id="f-conclude-filled" sourceRef="conclude" targetRef="filled" />
  </bpmn:process>
</bpmn:definitions>
