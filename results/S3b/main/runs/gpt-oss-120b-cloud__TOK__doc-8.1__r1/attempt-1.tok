tok 1.0 "Post recruitment process"

pool org "Organization"
  lane functional_department "Functional Department"
    start demand "Demand to fill a post"

  lane hr "HR"
    task advertise "Advertise the post"
    task check "Check the applications"
    task fill "Fill the post"
    task conclude "Conclude contract of employment"
    end filled "Post filled"

  lane applicant "Applicant"
    task apply "Apply for the post"

flow demand -> advertise -> apply -> check -> fill -> conclude -> filled
