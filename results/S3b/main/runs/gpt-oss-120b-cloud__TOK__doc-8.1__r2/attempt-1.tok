tok 1.0 "Post Filling Process"

pool org "Organisation"
  lane functional_department "Functional Department"
    start start_demand "Demand to fill a post"
    task advertise "Advertise the post"
  lane applicant "Applicant"
    task apply "Apply for the post"
  lane hr "HR"
    task check "Check applications"
    task fill "Fill the post"
    task conclude "Conclude employment contract"
    end end_filled "Post filled"

flow start_demand -> advertise -> apply -> check -> fill -> conclude -> end_filled
