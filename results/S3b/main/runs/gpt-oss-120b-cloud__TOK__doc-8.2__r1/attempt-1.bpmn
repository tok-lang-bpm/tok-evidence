<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="HR vacancy handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="HR vacancy handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="clerk" name="HR clerk">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_dept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Vacancy reported" />
    <bpmn:task id="create_desc" name="Create job description" />
    <bpmn:exclusiveGateway id="confusion" name="Message confusion?" />
    <bpmn:task id="ask_dept" name="Ask the Department again" />
    <bpmn:task id="submit_desc" name="Submit job description for consideration" />
    <bpmn:exclusiveGateway id="approved" name="Description approved?" />
    <bpmn:task id="correct_desc" name="Correct description" />
    <bpmn:task id="post_job" name="Post the job" />
    <bpmn:endEvent id="posted" name="Job posted" />
    <bpmn:sequenceFlow id="f-start-create_desc" sourceRef="start" targetRef="create_desc" />
    <bpmn:sequenceFlow id="f-create_desc-confusion" sourceRef="create_desc" targetRef="confusion" />
    <bpmn:sequenceFlow id="f-confusion-ask_dept" name="yes" sourceRef="confusion" targetRef="ask_dept" />
    <bpmn:sequenceFlow id="f-ask_dept-create_desc" sourceRef="ask_dept" targetRef="create_desc" />
    <bpmn:sequenceFlow id="f-confusion-submit_desc" name="no" sourceRef="confusion" targetRef="submit_desc" />
    <bpmn:sequenceFlow id="f-submit_desc-approved" sourceRef="submit_desc" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-post_job" name="yes" sourceRef="approved" targetRef="post_job" />
    <bpmn:sequenceFlow id="f-approved-correct_desc" name="no" sourceRef="approved" targetRef="correct_desc" />
    <bpmn:sequenceFlow id="f-correct_desc-submit_desc" sourceRef="correct_desc" targetRef="submit_desc" />
    <bpmn:sequenceFlow id="f-post_job-posted" sourceRef="post_job" targetRef="posted" />
  </bpmn:process>
</bpmn:definitions>
