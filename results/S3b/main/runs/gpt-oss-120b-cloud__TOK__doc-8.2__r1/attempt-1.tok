tok 1.0 "HR vacancy handling"

pool org "Organization"
  lane clerk "HR clerk"
    start start "Vacancy reported"
    task create_desc "Create job description"
    xor confusion "Message confusion?"
    task ask_dept "Ask the Department again"
    task submit_desc "Submit job description for consideration"
    xor approved "Description approved?"
    task correct_desc "Correct description"
    task post_job "Post the job"
    end posted "Job posted"

    flow start -> create_desc -> confusion
    flow confusion -> ask_dept "yes"
    flow ask_dept -> create_desc
    flow confusion -> submit_desc "no"
    flow submit_desc -> approved
    flow approved -> post_job "yes"
    flow approved -> correct_desc "no"
    flow correct_desc -> submit_desc
    flow post_job -> posted
