<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job posting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Job posting process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="hr_clerk" name="HR Clerk">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Vacancy reported" />
    <bpmn:task id="t1" name="Create job description" />
    <bpmn:exclusiveGateway id="g1" name="Confusion in message?" />
    <bpmn:task id="t2" name="Ask Department again" />
    <bpmn:task id="t3" name="Submit job description for consideration" />
    <bpmn:task id="t4" name="Correct description" />
    <bpmn:task id="t5" name="Post the job" />
    <bpmn:endEvent id="e1" name="Job posted" />
    <bpmn:task id="d1" name="Review job description" />
    <bpmn:exclusiveGateway id="g2" name="Approved?" />
    <bpmn:task id="d2" name="Approve description" />
    <bpmn:task id="d3" name="Reject and request correction" />
    <bpmn:sequenceFlow id="f-s1-t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t2" name="yes" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-g1-t3" name="no" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-d1" sourceRef="t3" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-g2" sourceRef="d1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-d2" name="yes" sourceRef="g2" targetRef="d2" />
    <bpmn:sequenceFlow id="f-g2-d3" name="no" sourceRef="g2" targetRef="d3" />
    <bpmn:sequenceFlow id="f-d2-t5" sourceRef="d2" targetRef="t5" />
    <bpmn:sequenceFlow id="f-d3-t4" sourceRef="d3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t3" sourceRef="t4" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t5-e1" sourceRef="t5" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
