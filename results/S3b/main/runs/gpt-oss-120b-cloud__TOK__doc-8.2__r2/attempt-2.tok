tok 1.0 "Job posting process"

pool organization "Organization"
  lane hr_clerk "HR Clerk"
    start s1 "Vacancy reported"
    task t1 "Create job description"
    xor g1 "Confusion in message?"
    task t2 "Ask Department again"
    task t3 "Submit job description for consideration"
    task t4 "Correct description"
    task t5 "Post the job"
    end e1 "Job posted"

  lane department "Department"
    task d1 "Review job description"
    xor g2 "Approved?"
    task d2 "Approve description"
    task d3 "Reject and request correction"

flow s1 -> t1
flow t1 -> g1
flow g1 -> t2 "yes"
flow g1 -> t3 "no"
flow t2 -> t3
flow t3 -> d1
flow d1 -> g2
flow g2 -> d2 "yes"
flow g2 -> d3 "no"
flow d2 -> t5
flow d3 -> t4
flow t4 -> t3
flow t5 -> e1
