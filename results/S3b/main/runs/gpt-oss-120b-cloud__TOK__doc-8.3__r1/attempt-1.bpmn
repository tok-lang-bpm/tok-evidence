<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job description processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job description processing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hrq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="detect" name="Detect personnel requirements" />
    <bpmn:task id="report" name="Report vacancy to Personnel Department" />
    <bpmn:task id="wait" name="Wait to receive job description" />
    <bpmn:exclusiveGateway id="hrq" name="HR has questions?" />
    <bpmn:task id="clarify" name="Provide clarifications to HR" />
    <bpmn:exclusiveGateway id="corr" name="Corrections needed?" />
    <bpmn:task id="ask_corr" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:endEvent id="finish" name="Process end" />
    <bpmn:sequenceFlow id="f-start-detect" sourceRef="start" targetRef="detect" />
    <bpmn:sequenceFlow id="f-detect-report" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-wait" sourceRef="report" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-hrq" sourceRef="wait" targetRef="hrq" />
    <bpmn:sequenceFlow id="f-hrq-clarify" name="yes" sourceRef="hrq" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-hrq-corr" name="no" sourceRef="hrq" targetRef="corr" />
    <bpmn:sequenceFlow id="f-clarify-corr" sourceRef="clarify" targetRef="corr" />
    <bpmn:sequenceFlow id="f-corr-ask_corr" name="yes" sourceRef="corr" targetRef="ask_corr" />
    <bpmn:sequenceFlow id="f-corr-approve" name="no" sourceRef="corr" targetRef="approve" />
    <bpmn:sequenceFlow id="f-ask_corr-wait" sourceRef="ask_corr" targetRef="wait" />
    <bpmn:sequenceFlow id="f-approve-finish" sourceRef="approve" targetRef="finish" />
  </bpmn:process>
</bpmn:definitions>
