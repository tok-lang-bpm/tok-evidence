<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vacancy handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Vacancy handling process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="head" name="Head of Functional Department">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="personnel" name="Personnel Department">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR Department">
        <bpmn:flowNodeRef>hrq</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:task id="d1" name="Detect personnel requirements" />
    <bpmn:task id="r1" name="Report vacancy to Personnel Department" />
    <bpmn:task id="w1" name="Wait for job description" />
    <bpmn:exclusiveGateway id="g1" name="HR has questions?" default="f-g1-g2" />
    <bpmn:task id="clar" name="Provide clarifications" />
    <bpmn:exclusiveGateway id="g2" name="Job description needs corrections?" default="f-g2-appr" />
    <bpmn:task id="corr" name="Ask for corrections again" />
    <bpmn:task id="appr" name="Approve job description" />
    <bpmn:endEvent id="e" name="Process completed" />
    <bpmn:task id="prep" name="Prepare job description" />
    <bpmn:task id="hrq" name="Ask questions about tasks and requirements" />
    <bpmn:sequenceFlow id="f-S-d1" sourceRef="S" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-r1" sourceRef="d1" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-w1" sourceRef="r1" targetRef="w1" />
    <bpmn:sequenceFlow id="f-w1-g1" sourceRef="w1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-hrq" name="yes" sourceRef="g1" targetRef="hrq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasQuestions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-hrq-clar" sourceRef="hrq" targetRef="clar" />
    <bpmn:sequenceFlow id="f-clar-g2" sourceRef="clar" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g1-g2" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-corr" name="yes" sourceRef="g2" targetRef="corr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsCorrections</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-corr-prep" sourceRef="corr" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-w1" sourceRef="prep" targetRef="w1" />
    <bpmn:sequenceFlow id="f-g2-appr" name="no" sourceRef="g2" targetRef="appr" />
    <bpmn:sequenceFlow id="f-appr-e" sourceRef="appr" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
