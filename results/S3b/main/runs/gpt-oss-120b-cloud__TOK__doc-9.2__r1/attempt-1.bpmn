<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Mortgage Offer Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Mortgage Process" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Mortgage Offer Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move_admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_noreply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_noreply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send" name="Send mortgage offer" />
    <bpmn:task id="receive" name="Receive customer reply" />
    <bpmn:exclusiveGateway id="response" name="Customer response?" />
    <bpmn:task id="update_decline" name="Update case details" />
    <bpmn:task id="archive_decline" name="Archive case" />
    <bpmn:endEvent id="cancelled" name="Case cancelled" />
    <bpmn:task id="move_admin" name="Move case to administration" />
    <bpmn:endEvent id="moved" name="Case moved to administration" />
    <bpmn:task id="request_docs" name="Generate request for outstanding documents" />
    <bpmn:endEvent id="requested" name="Outstanding documents requested" />
    <bpmn:task id="update_noreply" name="Update case details" />
    <bpmn:task id="archive_noreply" name="Archive case" />
    <bpmn:endEvent id="cancelled_no" name="Case cancelled" />
    <bpmn:sequenceFlow id="f-start-send" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-receive" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-response" sourceRef="receive" targetRef="response" />
    <bpmn:sequenceFlow id="f-response-update_decline" name="decline" sourceRef="response" targetRef="update_decline" />
    <bpmn:sequenceFlow id="f-response-move_admin" name="all docs provided" sourceRef="response" targetRef="move_admin" />
    <bpmn:sequenceFlow id="f-response-request_docs" name="missing docs" sourceRef="response" targetRef="request_docs" />
    <bpmn:sequenceFlow id="f-response-update_noreply" name="no reply" sourceRef="response" targetRef="update_noreply" />
    <bpmn:sequenceFlow id="f-update_decline-archive_decline" sourceRef="update_decline" targetRef="archive_decline" />
    <bpmn:sequenceFlow id="f-archive_decline-cancelled" sourceRef="archive_decline" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-move_admin-moved" sourceRef="move_admin" targetRef="moved" />
    <bpmn:sequenceFlow id="f-request_docs-requested" sourceRef="request_docs" targetRef="requested" />
    <bpmn:sequenceFlow id="f-update_noreply-archive_noreply" sourceRef="update_noreply" targetRef="archive_noreply" />
    <bpmn:sequenceFlow id="f-archive_noreply-cancelled_no" sourceRef="archive_noreply" targetRef="cancelled_no" />
  </bpmn:process>
</bpmn:definitions>
