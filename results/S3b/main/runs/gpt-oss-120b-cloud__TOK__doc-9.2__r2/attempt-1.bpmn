<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mortgage Offer Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Mortgage Offer Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reply_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_details_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move_admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_details_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_timeout</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="send_offer" name="Send Mortgage offer and wait for reply" />
    <bpmn:boundaryEvent id="timeout" attachedToRef="send_offer">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2W</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="reply_type" name="Customer reply?" />
    <bpmn:task id="update_details_decline" name="Update case details (decline)" />
    <bpmn:task id="archive_decline" name="Archive work (decline)" />
    <bpmn:task id="cancel_decline" name="Cancel case (decline)" />
    <bpmn:endEvent id="end_decline" name="Case cancelled after decline" />
    <bpmn:task id="move_admin" name="Move case to administration for completion" />
    <bpmn:endEvent id="end_accept" name="Case moved to administration" />
    <bpmn:task id="request_docs" name="Generate message requesting outstanding documents" />
    <bpmn:endEvent id="end_missing" name="Requested missing documents" />
    <bpmn:task id="update_details_timeout" name="Update case details (no reply)" />
    <bpmn:task id="archive_timeout" name="Archive case (no reply)" />
    <bpmn:task id="cancel_timeout" name="Cancel case (no reply)" />
    <bpmn:endEvent id="end_timeout" name="Case cancelled due to no reply" />
    <bpmn:sequenceFlow id="f-start-send_offer" sourceRef="start" targetRef="send_offer" />
    <bpmn:sequenceFlow id="f-send_offer-reply_type" sourceRef="send_offer" targetRef="reply_type" />
    <bpmn:sequenceFlow id="f-reply_type-update_details_decline" name="decline" sourceRef="reply_type" targetRef="update_details_decline" />
    <bpmn:sequenceFlow id="f-reply_type-move_admin" name="accept all docs" sourceRef="reply_type" targetRef="move_admin" />
    <bpmn:sequenceFlow id="f-reply_type-request_docs" name="missing docs" sourceRef="reply_type" targetRef="request_docs" />
    <bpmn:sequenceFlow id="f-update_details_decline-archive_decline" sourceRef="update_details_decline" targetRef="archive_decline" />
    <bpmn:sequenceFlow id="f-archive_decline-cancel_decline" sourceRef="archive_decline" targetRef="cancel_decline" />
    <bpmn:sequenceFlow id="f-cancel_decline-end_decline" sourceRef="cancel_decline" targetRef="end_decline" />
    <bpmn:sequenceFlow id="f-move_admin-end_accept" sourceRef="move_admin" targetRef="end_accept" />
    <bpmn:sequenceFlow id="f-request_docs-end_missing" sourceRef="request_docs" targetRef="end_missing" />
    <bpmn:sequenceFlow id="f-timeout-update_details_timeout" sourceRef="timeout" targetRef="update_details_timeout" />
    <bpmn:sequenceFlow id="f-update_details_timeout-archive_timeout" sourceRef="update_details_timeout" targetRef="archive_timeout" />
    <bpmn:sequenceFlow id="f-archive_timeout-cancel_timeout" sourceRef="archive_timeout" targetRef="cancel_timeout" />
    <bpmn:sequenceFlow id="f-cancel_timeout-end_timeout" sourceRef="cancel_timeout" targetRef="end_timeout" />
  </bpmn:process>
</bpmn:definitions>
