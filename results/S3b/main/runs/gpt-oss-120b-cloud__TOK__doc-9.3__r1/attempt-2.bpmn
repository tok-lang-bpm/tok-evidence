<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual meeting schedule drafting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Annual meeting schedule drafting" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start November scheduling" />
    <bpmn:task id="draft" name="draft schedule of meetings for the next calendar year and add draft dates to all calendars" />
    <bpmn:task id="recheck" name="recheck all dates and look for potential conflicts" />
    <bpmn:task id="send" name="send final schedule of meeting dates to all the independent Committee Members by email" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:task id="check" name="check the dates and suggest modifications" />
    <bpmn:task id="advise" name="check diaries and advise the Coordination Unit of any conflicts" />
    <bpmn:sequenceFlow id="f-start-draft" sourceRef="start" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-check" sourceRef="draft" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-recheck" sourceRef="check" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-send" sourceRef="recheck" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-advise" sourceRef="send" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-done" sourceRef="advise" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
