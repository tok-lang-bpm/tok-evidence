<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual Meeting Schedule" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Annual Meeting Schedule" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Z</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>C</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start scheduling" />
    <bpmn:task id="D" name="Draft schedule of meetings and add draft dates to all calendars" />
    <bpmn:task id="R" name="Recheck all dates and look for potential conflicts" />
    <bpmn:task id="E" name="Send final schedule of meeting dates by email" />
    <bpmn:endEvent id="Z" name="Scheduling process completed" />
    <bpmn:task id="C" name="Check dates and suggest modifications" />
    <bpmn:task id="A" name="Check diaries and advise Coordination Unit of conflicts" />
    <bpmn:sequenceFlow id="f-S-D" sourceRef="S" targetRef="D" />
    <bpmn:sequenceFlow id="f-D-C" sourceRef="D" targetRef="C" />
    <bpmn:sequenceFlow id="f-C-R" sourceRef="C" targetRef="R" />
    <bpmn:sequenceFlow id="f-R-E" sourceRef="R" targetRef="E" />
    <bpmn:sequenceFlow id="f-E-A" sourceRef="E" targetRef="A" />
    <bpmn:sequenceFlow id="f-A-Z" sourceRef="A" targetRef="Z" />
  </bpmn:process>
</bpmn:definitions>
