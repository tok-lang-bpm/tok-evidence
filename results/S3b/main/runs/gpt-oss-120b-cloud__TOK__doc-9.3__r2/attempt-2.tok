tok 1.0 "Annual Meeting Schedule"

pool authority "Town Planning Authority"
  lane coordination "Coordination Unit"
    start S "Start scheduling"
    task D "Draft schedule of meetings and add draft dates to all calendars"
    task R "Recheck all dates and look for potential conflicts"
    task E "Send final schedule of meeting dates by email"
    end Z "Scheduling process completed"
  lane support "Support Officer"
    task C "Check dates and suggest modifications"
  lane committee "Committee Members"
    task A "Check diaries and advise Coordination Unit of conflicts"

flow S -> D -> C -> R -> E -> A -> Z
