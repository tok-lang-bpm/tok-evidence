<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>update_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_records</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>read_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold_meeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="finalize" name="Finalize dates" />
    <bpmn:task id="qa_check" name="Conduct QA check on minutes" />
    <bpmn:endEvent id="end_process" name="Process end" />
    <bpmn:task id="update_cal" name="Update group calendars" />
    <bpmn:task id="create_folders" name="Create meeting folders" />
    <bpmn:task id="upload_docs" name="Upload documents to system" />
    <bpmn:task id="advise" name="Advise Committee Members" />
    <bpmn:task id="produce_minutes" name="Produce minutes" />
    <bpmn:task id="send_minutes" name="Send minutes to Committee Members" />
    <bpmn:task id="update_records" name="Update departmental records" />
    <bpmn:task id="read_docs" name="Read related documents" />
    <bpmn:task id="hold_meeting" name="Hold meeting" />
    <bpmn:sequenceFlow id="f-start-finalize" sourceRef="start" targetRef="finalize" />
    <bpmn:sequenceFlow id="f-finalize-update_cal" sourceRef="finalize" targetRef="update_cal" />
    <bpmn:sequenceFlow id="f-update_cal-create_folders" sourceRef="update_cal" targetRef="create_folders" />
    <bpmn:sequenceFlow id="f-create_folders-upload_docs" sourceRef="create_folders" targetRef="upload_docs" />
    <bpmn:sequenceFlow id="f-upload_docs-advise" sourceRef="upload_docs" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-read_docs" sourceRef="advise" targetRef="read_docs" />
    <bpmn:sequenceFlow id="f-read_docs-hold_meeting" sourceRef="read_docs" targetRef="hold_meeting" />
    <bpmn:sequenceFlow id="f-hold_meeting-produce_minutes" sourceRef="hold_meeting" targetRef="produce_minutes" />
    <bpmn:sequenceFlow id="f-produce_minutes-qa_check" sourceRef="produce_minutes" targetRef="qa_check" />
    <bpmn:sequenceFlow id="f-qa_check-send_minutes" sourceRef="qa_check" targetRef="send_minutes" />
    <bpmn:sequenceFlow id="f-send_minutes-update_records" sourceRef="send_minutes" targetRef="update_records" />
    <bpmn:sequenceFlow id="f-update_records-end_process" sourceRef="update_records" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
