tok 1.0 "Committee meeting process"

pool organization "Organization"
  lane coordination "Coordination Unit"
    start start "Process start"
    task finalize "Finalize dates"
    task qa_check "Conduct QA check on minutes"
    end end_process "Process end"
  lane support "Support Officer"
    task update_cal "Update group calendars"
    task create_folders "Create meeting folders"
    task upload_docs "Upload documents to system"
    task advise "Advise Committee Members"
    task produce_minutes "Produce minutes"
    task send_minutes "Send minutes to Committee Members"
    task update_records "Update departmental records"
  lane committee "Committee Members"
    task read_docs "Read related documents"
    task hold_meeting "Hold meeting"

flow start -> finalize -> update_cal -> create_folders -> upload_docs -> advise -> read_docs -> hold_meeting -> produce_minutes -> qa_check -> send_minutes -> update_records -> end_process
