<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qaCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>updateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>holdMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Dates finalized" />
    <bpmn:task id="qaCheck" name="Conduct QA check on the minutes" />
    <bpmn:task id="updateCalendars" name="Update group calendars and create meeting folders and upload documents" />
    <bpmn:task id="adviseMembers" name="Advise Committee Members a week before each meeting to read all related documents" />
    <bpmn:task id="produceMinutes" name="Produce minutes including any Action Points for each Committee Member" />
    <bpmn:task id="sendMinutes" name="Send minutes to all Committee Members" />
    <bpmn:task id="updateRecords" name="Update departmental records" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:task id="holdMeeting" name="Hold the meeting" />
    <bpmn:sequenceFlow id="f-start-updateCalendars" sourceRef="start" targetRef="updateCalendars" />
    <bpmn:sequenceFlow id="f-updateCalendars-adviseMembers" sourceRef="updateCalendars" targetRef="adviseMembers" />
    <bpmn:sequenceFlow id="f-adviseMembers-holdMeeting" sourceRef="adviseMembers" targetRef="holdMeeting" />
    <bpmn:sequenceFlow id="f-holdMeeting-produceMinutes" sourceRef="holdMeeting" targetRef="produceMinutes" />
    <bpmn:sequenceFlow id="f-produceMinutes-qaCheck" sourceRef="produceMinutes" targetRef="qaCheck" />
    <bpmn:sequenceFlow id="f-qaCheck-sendMinutes" sourceRef="qaCheck" targetRef="sendMinutes" />
    <bpmn:sequenceFlow id="f-sendMinutes-updateRecords" sourceRef="sendMinutes" targetRef="updateRecords" />
    <bpmn:sequenceFlow id="f-updateRecords-end" sourceRef="updateRecords" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
