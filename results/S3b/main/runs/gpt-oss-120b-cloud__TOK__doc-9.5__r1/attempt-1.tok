tok 1.0 "Expense Report Processing" [executable]

pool org "Organization"
  lane employee "Employee"
    task resubmit "Employee re-submit expense report"
  lane system "System"
    start S "Expense report received"
    task chkAcc "Check employee account"
    xor hasAcc "Employee has account?"
    task createAcc "Create new account"
    task review "Review report for automatic approval"
    xor amountCheck "Amount under $200?"
    task autoApprove "Auto approve"
    task reimburse "Reimburse to direct deposit"
    task sendProg "Send approval in progress email"
    task sendCancel "Send cancellation email"
    end success "Process completed"
    end rejected "Process terminated"
    end cancelled "Process cancelled"
    boundary prog on=reimburse timer=P7D [noninterrupting]
    boundary canc on=reimburse timer=P30D [noninterrupting]
  lane supervisor "Supervisor"
    task supApprove "Supervisor approval"
    xor supDecision "Supervisor approves?"
    task sendRej "Send rejection email"

flow S -> chkAcc
flow chkAcc -> hasAcc
flow hasAcc -> createAcc "no"
flow hasAcc -> review "yes"
flow createAcc -> review
flow review -> amountCheck
flow amountCheck -> autoApprove "yes"
flow amountCheck -> supApprove "no"
flow autoApprove -> reimburse
flow supApprove -> supDecision
flow supDecision -> reimburse "yes"
flow supDecision -> sendRej "no"
flow sendRej -> rejected
flow reimburse -> success
flow prog -> sendProg
flow sendProg -> success
flow canc -> sendCancel
flow sendCancel -> resubmit
flow resubmit -> S
