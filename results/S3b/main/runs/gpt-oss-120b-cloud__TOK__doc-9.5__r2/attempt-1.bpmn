<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Expense Report Processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Expense Report Processing" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>create1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_email1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>progress_email1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_email1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reimburse1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer30</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>approve1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Expense report received" />
    <bpmn:endEvent id="end1" name="Rejection notice sent" />
    <bpmn:endEvent id="end2" name="Reimbursement completed" />
    <bpmn:endEvent id="end3" name="Process cancelled" />
    <bpmn:endEvent id="end4" name="Approval in progress email sent" />
    <bpmn:task id="create1" name="Create new account" />
    <bpmn:task id="review1" name="Review expense report" />
    <bpmn:task id="reject_email1" name="Send rejection email" />
    <bpmn:task id="progress_email1" name="Send approval in progress email" />
    <bpmn:task id="cancel_email1" name="Send cancellation email" />
    <bpmn:task id="reimburse1" name="Reimburse employee via direct deposit" />
    <bpmn:exclusiveGateway id="xor1" name="Employee has account?" />
    <bpmn:exclusiveGateway id="xor2" name="Amount &lt; 200?" />
    <bpmn:exclusiveGateway id="xor3" name="Supervisor approval?" />
    <bpmn:boundaryEvent id="timer7" name="7‑day timer" attachedToRef="review1" cancelActivity="false">
      <bpmn:timerEventDefinition id="timer7-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="timer30" name="30‑day timer" attachedToRef="review1">
      <bpmn:timerEventDefinition id="timer30-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="approve1" name="Supervisor approves expense report" />
    <bpmn:sequenceFlow id="f-start1-xor1" sourceRef="start1" targetRef="xor1" />
    <bpmn:sequenceFlow id="f-xor1-review1" name="yes" sourceRef="xor1" targetRef="review1" />
    <bpmn:sequenceFlow id="f-xor1-create1" name="no" sourceRef="xor1" targetRef="create1" />
    <bpmn:sequenceFlow id="f-create1-review1" sourceRef="create1" targetRef="review1" />
    <bpmn:sequenceFlow id="f-review1-xor2" sourceRef="review1" targetRef="xor2" />
    <bpmn:sequenceFlow id="f-xor2-reimburse1" name="yes" sourceRef="xor2" targetRef="reimburse1" />
    <bpmn:sequenceFlow id="f-xor2-approve1" name="no" sourceRef="xor2" targetRef="approve1" />
    <bpmn:sequenceFlow id="f-approve1-xor3" sourceRef="approve1" targetRef="xor3" />
    <bpmn:sequenceFlow id="f-xor3-reimburse1" name="approved" sourceRef="xor3" targetRef="reimburse1" />
    <bpmn:sequenceFlow id="f-xor3-reject_email1" name="rejected" sourceRef="xor3" targetRef="reject_email1" />
    <bpmn:sequenceFlow id="f-reject_email1-end1" sourceRef="reject_email1" targetRef="end1" />
    <bpmn:sequenceFlow id="f-reimburse1-end2" sourceRef="reimburse1" targetRef="end2" />
    <bpmn:sequenceFlow id="f-timer7-progress_email1" sourceRef="timer7" targetRef="progress_email1" />
    <bpmn:sequenceFlow id="f-progress_email1-end4" sourceRef="progress_email1" targetRef="end4" />
    <bpmn:sequenceFlow id="f-timer30-cancel_email1" sourceRef="timer30" targetRef="cancel_email1" />
    <bpmn:sequenceFlow id="f-cancel_email1-end3" sourceRef="cancel_email1" targetRef="end3" />
  </bpmn:process>
</bpmn:definitions>
