<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>

  <bpmn:process id="hotel-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_manager" name="Room‑service Manager">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_WineDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>TK1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sommelier" name="Sommelier">
        <bpmn:flowNodeRef>TS1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_waiter" name="Waiter">
        <bpmn:flowNodeRef>TW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TW3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BillingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TW4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="S1" name="Guest calls room service" />
    <bpmn:task id="T1" name="Take down the order" />
    <bpmn:parallelGateway id="PG1" />
    <bpmn:exclusiveGateway id="GW_WineDecision" name="Alcoholic beverage required?" />
    <bpmn:task id="TK1" name="Prepare food" />
    <bpmn:task id="TS1" name="Fetch wine and other alcoholic beverages" />
    <bpmn:task id="TW1" name="Ready cart and non‑alcoholic drinks" />
    <bpmn:parallelGateway id="PG2" />
    <bpmn:task id="TW2" name="Deliver food, wine and cart to guest room" />
    <bpmn:task id="TW3" name="Return to room‑service station" />
    <bpmn:exclusiveGateway id="GW_BillingDecision" name="Bill now?" />
    <bpmn:task id="TW4" name="Debit guest account" />
    <bpmn:endEvent id="END_COMPLETED" name="Order completed" />
    <bpmn:endEvent id="END_PENDING" name="Order pending billing" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="PG1" />
    <bpmn:sequenceFlow id="F3" sourceRef="PG1" targetRef="TK1" />
    <bpmn:sequenceFlow id="F4" sourceRef="PG1" targetRef="GW_WineDecision" />
    <bpmn:sequenceFlow id="F5" sourceRef="PG1" targetRef="TW1" />
    <bpmn:sequenceFlow id="F6" name="yes" sourceRef="GW_WineDecision" targetRef="TS1" />
    <bpmn:sequenceFlow id="F7" name="no" sourceRef="GW_WineDecision" targetRef="PG2" />
    <bpmn:sequenceFlow id="F8" sourceRef="TS1" targetRef="PG2" />
    <bpmn:sequenceFlow id="F9" sourceRef="TK1" targetRef="PG2" />
    <bpmn:sequenceFlow id="F10" sourceRef="TW1" targetRef="PG2" />
    <bpmn:sequenceFlow id="F11" sourceRef="PG2" targetRef="TW2" />
    <bpmn:sequenceFlow id="F12" sourceRef="TW2" targetRef="TW3" />
    <bpmn:sequenceFlow id="F13" sourceRef="TW3" targetRef="GW_BillingDecision" />
    <bpmn:sequenceFlow id="F14" name="yes" sourceRef="GW_BillingDecision" targetRef="TW4" />
    <bpmn:sequenceFlow id="F15" name="no" sourceRef="GW_BillingDecision" targetRef="END_PENDING" />
    <bpmn:sequenceFlow id="F16" sourceRef="TW4" targetRef="END_COMPLETED" />
  </bpmn:process>
</bpmn:definitions>
