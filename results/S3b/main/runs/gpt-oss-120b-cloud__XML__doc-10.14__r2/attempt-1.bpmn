<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1"/>
  </bpmn:collaboration>

  <bpmn:process id="process1" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_process" name="Process">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpoo" name="MPOO">
        <bpmn:flowNodeRef>send_temp_mpoo_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equip_mpoo_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equip_mpoo_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mspo" name="MSPO">
        <bpmn:flowNodeRef>send_temp_mspo_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_addreadings_mspo_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_go" name="GO">
        <bpmn:flowNodeRef>examine_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpon" name="MPON">
        <bpmn:flowNodeRef>examine_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpon_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpon_reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Process start"/>
    <bpmn:exclusiveGateway id="gateway_decision" name="Which bill is sent?"/>
    
    <bpmn:task id="send_temp_mpoo_go"
               name="MPOO sends bill for temporary continuation of the metering point operations to GO"/>
    <bpmn:task id="send_temp_mspo_go"
               name="MSPO sends bill for temporary continuation of the measurement to GO"/>
    <bpmn:task id="send_addreadings_mspo_go"
               name="MSPO sends bill for additional readings to GO"/>
    <bpmn:task id="send_equip_mpoo_mpon"
               name="MPOO sends bill for equipment acquisition to MPON"/>
    <bpmn:task id="send_equip_mpoo_go"
               name="MPOO sends bill for equipment acquisition to GO"/>
    
    <bpmn:task id="examine_go" name="GO examines the bill"/>
    <bpmn:task id="examine_mpon" name="MPON examines the bill"/>
    
    <bpmn:exclusiveGateway id="gateway_result" name="Result of examination"/>
    
    <bpmn:task id="go_confirm"
               name="GO confirms the invoice with payment advice to the MPOO or the MSPO"/>
    <bpmn:task id="go_reject"
               name="GO rejects the invoice of the MPOO or the MSPO"/>
    <bpmn:task id="mpon_confirm"
               name="MPON confirms the invoice with payment advice to the MPOO or the MSPO"/>
    <bpmn:task id="mpon_reject"
               name="MPON rejects the invoice of the MPOO or the MSPO"/>
    
    <bpmn:endEvent id="end_confirm" name="Invoice confirmed"/>
    <bpmn:endEvent id="end_reject" name="Invoice rejected"/>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow_start_to_decision" sourceRef="start" targetRef="gateway_decision"/>
    
    <bpmn:sequenceFlow id="flow_decision_to_send_temp_mpoo_go"
                      sourceRef="gateway_decision" targetRef="send_temp_mpoo_go"/>
    <bpmn:sequenceFlow id="flow_decision_to_send_temp_mspo_go"
                      sourceRef="gateway_decision" targetRef="send_temp_mspo_go"/>
    <bpmn:sequenceFlow id="flow_decision_to_send_addreadings_mspo_go"
                      sourceRef="gateway_decision" targetRef="send_addreadings_mspo_go"/>
    <bpmn:sequenceFlow id="flow_decision_to_send_equip_mpoo_mpon"
                      sourceRef="gateway_decision" targetRef="send_equip_mpoo_mpon"/>
    <bpmn:sequenceFlow id="flow_decision_to_send_equip_mpoo_go"
                      sourceRef="gateway_decision" targetRef="send_equip_mpoo_go"/>

    <bpmn:sequenceFlow id="flow_send_temp_mpoo_go_to_examine_go"
                      sourceRef="send_temp_mpoo_go" targetRef="examine_go"/>
    <bpmn:sequenceFlow id="flow_send_temp_mspo_go_to_examine_go"
                      sourceRef="send_temp_mspo_go" targetRef="examine_go"/>
    <bpmn:sequenceFlow id="flow_send_addreadings_mspo_go_to_examine_go"
                      sourceRef="send_addreadings_mspo_go" targetRef="examine_go"/>
    <bpmn:sequenceFlow id="flow_send_equip_mpoo_go_to_examine_go"
                      sourceRef="send_equip_mpoo_go" targetRef="examine_go"/>
    <bpmn:sequenceFlow id="flow_send_equip_mpoo_mpon_to_examine_mpon"
                      sourceRef="send_equip_mpoo_mpon" targetRef="examine_mpon"/>

    <bpmn:sequenceFlow id="flow_examine_go_to_result"
                      sourceRef="examine_go" targetRef="gateway_result"/>
    <bpmn:sequenceFlow id="flow_examine_mpon_to_result"
                      sourceRef="examine_mpon" targetRef="gateway_result"/>

    <bpmn:sequenceFlow id="flow_result_to_go_confirm"
                      sourceRef="gateway_result" targetRef="go_confirm"/>
    <bpmn:sequenceFlow id="flow_result_to_go_reject"
                      sourceRef="gateway_result" targetRef="go_reject"/>
    <bpmn:sequenceFlow id="flow_result_to_mpon_confirm"
                      sourceRef="gateway_result" targetRef="mpon_confirm"/>
    <bpmn:sequenceFlow id="flow_result_to_mpon_reject"
                      sourceRef="gateway_result" targetRef="mpon_reject"/>

    <bpmn:sequenceFlow id="flow_go_confirm_to_end" sourceRef="go_confirm" targetRef="end_confirm"/>
    <bpmn:sequenceFlow id="flow_mpon_confirm_to_end" sourceRef="mpon_confirm" targetRef="end_confirm"/>
    <bpmn:sequenceFlow id="flow_go_reject_to_end" sourceRef="go_reject" targetRef="end_reject"/>
    <bpmn:sequenceFlow id="flow_mpon_reject_to_end" sourceRef="mpon_reject" targetRef="end_reject"/>
  </bpmn:process>
</bpmn:definitions>
