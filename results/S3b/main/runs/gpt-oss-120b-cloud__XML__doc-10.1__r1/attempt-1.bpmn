<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneMPON" name="MPON">
        <bpmn:flowNodeRef>sendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>reviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposeDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Process started" />
    <bpmn:task id="sendDismissal" name="Send dismissal" />
    <bpmn:task id="reviewDismissal" name="Review dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal decision" />
    <bpmn:task id="opposeDismissal" name="Oppose dismissal of MPON" />
    <bpmn:task id="confirmDismissal" name="Confirm dismissal of MPON" />
    <bpmn:endEvent id="endOppose" name="Dismissal opposed" />
    <bpmn:endEvent id="endConfirm" name="Dismissal confirmed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendDismissal" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendDismissal" targetRef="reviewDismissal" />
    <bpmn:sequenceFlow id="f3" sourceRef="reviewDismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="oppose" sourceRef="decision" targetRef="opposeDismissal" />
    <bpmn:sequenceFlow id="f5" name="confirm" sourceRef="decision" targetRef="confirmDismissal" />
    <bpmn:sequenceFlow id="f6" sourceRef="opposeDismissal" targetRef="endOppose" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirmDismissal" targetRef="endConfirm" />
  </bpmn:process>
</bpmn:definitions>
