<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>

  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneMPON" name="MPON">
        <bpmn:flowNodeRef>sendDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>reviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposeDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="sendDismissal" name="Send dismissal to MPOO" />
    <bpmn:task id="reviewDismissal" name="Review dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal outcome?" />
    <bpmn:task id="opposeDismissal" name="Oppose dismissal of MPON" />
    <bpmn:task id="confirmDismissal" name="Confirm dismissal of MPON" />
    <bpmn:endEvent id="endOppose" name="Opposition handled" />
    <bpmn:endEvent id="endConfirm" name="Dismissal confirmed" />

    <bpmn:sequenceFlow id="f_start_send" sourceRef="start" targetRef="sendDismissal" />
    <bpmn:sequenceFlow id="f_send_review" sourceRef="sendDismissal" targetRef="reviewDismissal" />
    <bpmn:sequenceFlow id="f_review_decision" sourceRef="reviewDismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f_decision_oppose" name="oppose" sourceRef="decision" targetRef="opposeDismissal" />
    <bpmn:sequenceFlow id="f_decision_confirm" name="confirm" sourceRef="decision" targetRef="confirmDismissal" />
    <bpmn:sequenceFlow id="f_oppose_end" sourceRef="opposeDismissal" targetRef="endOppose" />
    <bpmn:sequenceFlow id="f_confirm_end" sourceRef="confirmDismissal" targetRef="endConfirm" />
  </bpmn:process>
</bpmn:definitions>
