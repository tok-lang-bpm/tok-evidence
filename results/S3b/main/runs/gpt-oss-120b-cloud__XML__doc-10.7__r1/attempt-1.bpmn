<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="ORG_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="ORG_PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANESET_1">
      <bpmn:lane id="LANE_MSPN" name="MSPN">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>t_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_MSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_MPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="s_start" name="Start" />
    <bpmn:task id="t_register" name="registers the measurement at the GO" />
    <bpmn:task id="t_examine" name="examines the application of the MSPN" />
    <bpmn:exclusiveGateway id="g_decision" name="Application approved?" />
    <bpmn:task id="t_reject" name="rejects the application of the MSPN" />
    <bpmn:endEvent id="e_reject" name="Application rejected">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="t_confirm" name="confirms the application of the MSPN" />
    <bpmn:task id="t_assign" name="assigns the MSPN" />
    <bpmn:parallelGateway id="g_parallel_split" />
    <bpmn:task id="t_inform_MSPO" name="informs the MSPO about the assignment of MSPN" />
    <bpmn:task id="t_inform_MPO" name="informs the MPO about the assignment of the MSPN" />
    <bpmn:task id="t_inform_SP" name="informs the SP about the assignment of MSPN" />
    <bpmn:parallelGateway id="g_parallel_join" />
    <bpmn:endEvent id="e_success" name="Process completed" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="s_start" targetRef="t_register" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_register" targetRef="t_examine" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_examine" targetRef="g_decision" />
    <bpmn:sequenceFlow id="f4" name="reject" sourceRef="g_decision" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f5" name="confirm" sourceRef="g_decision" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_reject" targetRef="e_reject" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_confirm" targetRef="t_assign" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_assign" targetRef="g_parallel_split" />
    <bpmn:sequenceFlow id="f9" sourceRef="g_parallel_split" targetRef="t_inform_MSPO" />
    <bpmn:sequenceFlow id="f10" sourceRef="g_parallel_split" targetRef="t_inform_MPO" />
    <bpmn:sequenceFlow id="f11" sourceRef="g_parallel_split" targetRef="t_inform_SP" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_inform_MSPO" targetRef="g_parallel_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_inform_MPO" targetRef="g_parallel_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_inform_SP" targetRef="g_parallel_join" />
    <bpmn:sequenceFlow id="f15" sourceRef="g_parallel_join" targetRef="e_success" />
  </bpmn:process>
</bpmn:definitions>
