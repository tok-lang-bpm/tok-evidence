<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="MPO-process" />
  </bpmn:collaboration>
  <bpmn:process id="MPO-process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="SPPU_GO" name="SP / PU / GO">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPO" name="MPO">
        <bpmn:flowNodeRef>Cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PerformChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReportSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndFailure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Start" />
    <bpmn:exclusiveGateway id="G1" name="Request source?" />
    <bpmn:task id="Request" name="Request changes to MPO" />
    <bpmn:task id="Cause" name="Cause change" />
    <bpmn:parallelGateway id="Join1" />
    <bpmn:task id="Review" name="Review change request" />
    <bpmn:exclusiveGateway id="Decision" name="Reject or confirm?" />
    <bpmn:task id="NotifyFailure" name="Notify SP / PU / GO about failure" />
    <bpmn:task id="PerformChange" name="Perform measuring point change" />
    <bpmn:task id="ReportSuccess" name="Report implementation to SP / PU / GO" />
    <bpmn:endEvent id="EndSuccess" name="Process completed successfully" />
    <bpmn:endEvent id="EndFailure" name="Process ended with failure" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="G1" />
    <bpmn:sequenceFlow id="F2" name="request" sourceRef="G1" targetRef="Request" />
    <bpmn:sequenceFlow id="F3" name="direct" sourceRef="G1" targetRef="Cause" />
    <bpmn:sequenceFlow id="F4" sourceRef="Request" targetRef="Join1" />
    <bpmn:sequenceFlow id="F5" sourceRef="Cause" targetRef="Join1" />
    <bpmn:sequenceFlow id="F6" sourceRef="Join1" targetRef="Review" />
    <bpmn:sequenceFlow id="F7" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="F8" name="reject" sourceRef="Decision" targetRef="NotifyFailure" />
    <bpmn:sequenceFlow id="F9" name="confirm" sourceRef="Decision" targetRef="PerformChange" />
    <bpmn:sequenceFlow id="F10" sourceRef="PerformChange" targetRef="ReportSuccess" />
    <bpmn:sequenceFlow id="F11" sourceRef="ReportSuccess" targetRef="EndSuccess" />
    <bpmn:sequenceFlow id="F12" sourceRef="NotifyFailure" targetRef="EndFailure" />
  </bpmn:process>
</bpmn:definitions>
