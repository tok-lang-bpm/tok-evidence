<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="orgPool" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneRequester" name="Requester">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestTask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPO" name="MPO">
        <bpmn:flowNodeRef>selfInitiateTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyFailureTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="initGateway" name="Who initiates request?" />
    <bpmn:task id="requestTask" name="Requester requests changes to MPO" />
    <bpmn:task id="selfInitiateTask" name="MPO initiates change" />
    <bpmn:task id="reviewTask" name="MPO reviews the change request" />
    <bpmn:exclusiveGateway id="outcomeGateway" name="Review outcome" />
    <bpmn:task id="rejectTask" name="MPO rejects the change of the measuring point" />
    <bpmn:task id="notifyFailureTask" name="MPO notifies requester about failure" />
    <bpmn:task id="confirmTask" name="MPO confirms the request" />
    <bpmn:task id="performTask" name="MPO performs the measuring point change" />
    <bpmn:task id="reportTask" name="MPO reports implementation to requester" />
    <bpmn:endEvent id="endReject" name="Process ended after rejection" />
    <bpmn:endEvent id="endSuccess" name="Process ended after successful change" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f_start_to_init" sourceRef="start" targetRef="initGateway" />
    <bpmn:sequenceFlow id="f_init_to_request" name="Requester" sourceRef="initGateway" targetRef="requestTask" />
    <bpmn:sequenceFlow id="f_init_to_self" name="MPO" sourceRef="initGateway" targetRef="selfInitiateTask" />
    <bpmn:sequenceFlow id="f_request_to_review" sourceRef="requestTask" targetRef="reviewTask" />
    <bpmn:sequenceFlow id="f_self_to_review" sourceRef="selfInitiateTask" targetRef="reviewTask" />
    <bpmn:sequenceFlow id="f_review_to_outcome" sourceRef="reviewTask" targetRef="outcomeGateway" />
    <bpmn:sequenceFlow id="f_outcome_to_reject" name="Reject" sourceRef="outcomeGateway" targetRef="rejectTask" />
    <bpmn:sequenceFlow id="f_outcome_to_confirm" name="Confirm" sourceRef="outcomeGateway" targetRef="confirmTask" />
    <bpmn:sequenceFlow id="f_reject_to_notify" sourceRef="rejectTask" targetRef="notifyFailureTask" />
    <bpmn:sequenceFlow id="f_notify_to_endReject" sourceRef="notifyFailureTask" targetRef="endReject" />
    <bpmn:sequenceFlow id="f_confirm_to_perform" sourceRef="confirmTask" targetRef="performTask" />
    <bpmn:sequenceFlow id="f_perform_to_report" sourceRef="performTask" targetRef="reportTask" />
    <bpmn:sequenceFlow id="f_report_to_endSuccess" sourceRef="reportTask" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>
