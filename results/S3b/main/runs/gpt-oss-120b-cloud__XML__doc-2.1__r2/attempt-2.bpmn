<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="TELECO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendParams</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customerEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCS" name="Customer Service">
        <bpmn:flowNodeRef>enterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compareSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineMeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineSignificance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayPremium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>linkExtraFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewaySignificance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createDetailedReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDetailedReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveActualPerf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveResolutionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgSplitCS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCustomerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendCustomerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgJoinCS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSM" name="Service Management">
        <bpmn:flowNodeRef>gatewayAnalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createTroubleReportSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createStatusReportSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReportToRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareFinalStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideCounterMeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendActualPerfToCS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertakeMinorActions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createProblemResolutionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendProblemResolutionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createRestorationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRestorationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTroubleshootingReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneRP" name="Resource Provisioning">
        <bpmn:flowNodeRef>receiveReportFromSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayProblemDetected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createNormalNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzeProblemCreateTroubleReportRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createStatusReportRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendStatusReportToSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgRestorationWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer2Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminationEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveRestorationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trackErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertakeCorrectiveActionsRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createTroubleshootingReportRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTroubleshootingReportToSM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneBilling" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>reportSLARebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjustBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgSplitBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billingEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <!-- Customer -->
    <bpmn:startEvent id="start" name="Service degradation perceived by customer" />
    <bpmn:task id="sendParams" name="Send problem parameters to Customer Service" />
    <bpmn:endEvent id="customerEnd" name="Customer receives final report" />

    <!-- Customer Service -->
    <bpmn:task id="enterReport" name="Enter problem report into system T.." />
    <bpmn:task id="compareSLA" name="Compare problem report to customer SLA" />
    <bpmn:task id="determineMeasures" name="Determine necessary counter measures and priorities" />
    <bpmn:task id="determineSignificance" name="Determine customer significance" />
    <bpmn:exclusiveGateway id="gatewayPremium" name="Customer premium?" />
    <bpmn:task id="linkExtraFix" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="gatewaySignificance" name="Significant affecting measures?" />
    <bpmn:task id="createDetailedReport" name="Create detailed problem report" />
    <bpmn:task id="sendDetailedReport" name="Send detailed problem report to Service Management" />
    <bpmn:task id="receiveActualPerf" name="Receive actual service performance" />
    <bpmn:task id="receiveResolutionReport" name="Receive problem resolution report" />
    <bpmn:parallelGateway id="pgSplitCS" name="Parallel split for CS" />
    <bpmn:task id="createCustomerReport" name="Create report for customer" />
    <bpmn:task id="sendCustomerReport" name="Send report to customer" />
    <bpmn:parallelGateway id="pgJoinCS" name="Parallel join for CS" />

    <!-- Service Management -->
    <bpmn:exclusiveGateway id="gatewayAnalyze" name="Problem analyzable by Service Management?" />
    <bpmn:task id="performAnalysis" name="Perform analysis" />
    <bpmn:task id="createTroubleReportSM" name="Create trouble report (SM)" />
    <bpmn:task id="createStatusReportSM" name="Create status report (SM)" />
    <bpmn:task id="sendReportToRP" name="Send detailed report to Resource Provisioning" />
    <bpmn:task id="receiveStatusReport" name="Receive status report from Resource Provisioning" />
    <bpmn:task id="prepareFinalStatusReport" name="Prepare final status report" />
    <bpmn:task id="decideCounterMeasures" name="Determine counter measures" />
    <bpmn:exclusiveGateway id="gatewayOutcome" name="Outcome decision" />
    <bpmn:task id="sendActualPerfToCS" name="Send actual service performance to Customer Service" />
    <bpmn:task id="undertakeMinorActions" name="Undertake minor corrective actions" />
    <bpmn:task id="createProblemResolutionReport" name="Create problem resolution report" />
    <bpmn:task id="sendProblemResolutionReport" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="createRestorationRequest" name="Create request for automatic resource restoration" />
    <bpmn:task id="sendRestorationRequest" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="receiveTroubleshootingReport" name="Receive troubleshooting report from Resource Provisioning" />

    <!-- Resource Provisioning -->
    <bpmn:task id="receiveReportFromSM" name="Receive detailed report from Service Management" />
    <bpmn:task id="checkProblems" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="gatewayProblemDetected" name="Problem detected?" />
    <bpmn:task id="createNormalNotification" name="Create normal execution notification" />
    <bpmn:task id="analyzeProblemCreateTroubleReportRP" name="Analyze problem and create trouble report" />
    <bpmn:task id="createStatusReportRP" name="Create status report (RP)" />
    <bpmn:task id="sendStatusReportToSM" name="Send status report to Service Management" />
    <bpmn:parallelGateway id="pgRestorationWait" name="Wait for restoration request (or timeout)" />
    <bpmn:intermediateCatchEvent id="timer2Days" name="2‑day timer">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gatewayTimeout" name="Timeout?" />
    <bpmn:endEvent id="terminationEnd" name="Process terminated">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="receiveRestorationRequest" name="Receive restoration request" />
    <bpmn:task id="trackErrors" name="Track all possible errors" />
    <bpmn:task id="undertakeCorrectiveActionsRP" name="Undertake corrective actions" />
    <bpmn:task id="createTroubleshootingReportRP" name="Create troubleshooting report" />
    <bpmn:task id="sendTroubleshootingReportToSM" name="Send troubleshooting report to Service Management" />

    <!-- Billing & Collections -->
    <bpmn:task id="reportSLARebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:task id="adjustBilling" name="Adjust billing" />
    <bpmn:parallelGateway id="pgSplitBilling" name="Parallel split after billing" />
    <bpmn:endEvent id="billingEnd" name="Billing adjustment completed" />

    <!-- Sequence flows -->
    <!-- Customer -> Customer Service -->
    <bpmn:sequenceFlow id="sf1" sourceRef="start" targetRef="sendParams" />
    <bpmn:sequenceFlow id="sf2" sourceRef="sendParams" targetRef="enterReport" />
    <!-- Customer Service internal flow -->
    <bpmn:sequenceFlow id="sf3" sourceRef="enterReport" targetRef="compareSLA" />
    <bpmn:sequenceFlow id="sf4" sourceRef="compareSLA" targetRef="determineMeasures" />
    <bpmn:sequenceFlow id="sf5" sourceRef="determineMeasures" targetRef="determineSignificance" />
    <bpmn:sequenceFlow id="sf6" sourceRef="determineSignificance" targetRef="gatewayPremium" />
    <bpmn:sequenceFlow id="sf7" sourceRef="gatewayPremium" targetRef="linkExtraFix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">premium == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf8" sourceRef="gatewayPremium" targetRef="gatewaySignificance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">premium == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf9" sourceRef="linkExtraFix" targetRef="gatewaySignificance" />
    <bpmn:sequenceFlow id="sf10" sourceRef="gatewaySignificance" targetRef="determineMeasures">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">significant == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf11" sourceRef="gatewaySignificance" targetRef="createDetailedReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">significant == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf12" sourceRef="createDetailedReport" targetRef="sendDetailedReport" />
    <!-- Service Management analysis decision -->
    <bpmn:sequenceFlow id="sf13" sourceRef="sendDetailedReport" targetRef="gatewayAnalyze" />
    <bpmn:sequenceFlow id="sf14" sourceRef="gatewayAnalyze" targetRef="performAnalysis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">analyzable == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf15" sourceRef="gatewayAnalyze" targetRef="sendReportToRP">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">analyzable == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Analyzable path -->
    <bpmn:sequenceFlow id="sf16" sourceRef="performAnalysis" targetRef="createTroubleReportSM" />
    <bpmn:sequenceFlow id="sf17" sourceRef="createTroubleReportSM" targetRef="createStatusReportSM" />
    <bpmn:sequenceFlow id="sf18" sourceRef="createStatusReportSM" targetRef="prepareFinalStatusReport" />
    <!-- Not analyzable path (via RP) -->
    <bpmn:sequenceFlow id="sf19" sourceRef="sendReportToRP" targetRef="receiveReportFromSM" />
    <bpmn:sequenceFlow id="sf20" sourceRef="receiveReportFromSM" targetRef="checkProblems" />
    <bpmn:sequenceFlow id="sf21" sourceRef="checkProblems" targetRef="gatewayProblemDetected" />
    <bpmn:sequenceFlow id="sf22" sourceRef="gatewayProblemDetected" targetRef="createNormalNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">problemDetected == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf23" sourceRef="gatewayProblemDetected" targetRef="analyzeProblemCreateTroubleReportRP">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">problemDetected == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf24" sourceRef="createNormalNotification" targetRef="createStatusReportRP" />
    <bpmn:sequenceFlow id="sf25" sourceRef="analyzeProblemCreateTroubleReportRP" targetRef="createStatusReportRP" />
    <bpmn:sequenceFlow id="sf26" sourceRef="createStatusReportRP" targetRef="sendStatusReportToSM" />
    <bpmn:sequenceFlow id="sf27" sourceRef="sendStatusReportToSM" targetRef="receiveStatusReport" />
    <!-- Merge back to final status report -->
    <bpmn:sequenceFlow id="sf28" sourceRef="receiveStatusReport" targetRef="prepareFinalStatusReport" />
    <bpmn:sequenceFlow id="sf29" sourceRef="prepareFinalStatusReport" targetRef="decideCounterMeasures" />
    <bpmn:sequenceFlow id="sf30" sourceRef="decideCounterMeasures" targetRef="gatewayOutcome" />
    <!-- Outcome alternatives -->
    <bpmn:sequenceFlow id="sf31" sourceRef="gatewayOutcome" targetRef="sendActualPerfToCS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'noProblem'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf32" sourceRef="gatewayOutcome" targetRef="undertakeMinorActions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf33" sourceRef="gatewayOutcome" targetRef="createRestorationRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'autoRestore'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Path A -->
    <bpmn:sequenceFlow id="sf34" sourceRef="sendActualPerfToCS" targetRef="receiveActualPerf" />
    <!-- Path B -->
    <bpmn:sequenceFlow id="sf35" sourceRef="undertakeMinorActions" targetRef="createProblemResolutionReport" />
    <!-- Path C -->
    <bpmn:sequenceFlow id="sf36" sourceRef="createRestorationRequest" targetRef="sendRestorationRequest" />
    <bpmn:sequenceFlow id="sf37" sourceRef="sendRestorationRequest" targetRef="pgRestorationWait" />
    <!-- Restoration wait split -->
    <bpmn:sequenceFlow id="sf38" sourceRef="pgRestorationWait" targetRef="timer2Days" />
    <bpmn:sequenceFlow id="sf39" sourceRef="pgRestorationWait" targetRef="receiveRestorationRequest" />
    <bpmn:sequenceFlow id="sf40" sourceRef="timer2Days" targetRef="gatewayTimeout" />
    <bpmn:sequenceFlow id="sf41" sourceRef="gatewayTimeout" targetRef="terminationEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">timeout == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf42" sourceRef="gatewayTimeout" targetRef="trackErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">timeout == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Continue after restoration request received -->
    <bpmn:sequenceFlow id="sf43" sourceRef="receiveRestorationRequest" targetRef="trackErrors" />
    <bpmn:sequenceFlow id="sf44" sourceRef="trackErrors" targetRef="undertakeCorrectiveActionsRP" />
    <bpmn:sequenceFlow id="sf45" sourceRef="undertakeCorrectiveActionsRP" targetRef="createTroubleshootingReportRP" />
    <bpmn:sequenceFlow id="sf46" sourceRef="createTroubleshootingReportRP" targetRef="sendTroubleshootingReportToSM" />
    <bpmn:sequenceFlow id="sf47" sourceRef="sendTroubleshootingReportToSM" targetRef="receiveTroubleshootingReport" />
    <!-- After receiving troubleshooting report (or after minor actions) -->
    <bpmn:sequenceFlow id="sf48" sourceRef="receiveTroubleshootingReport" targetRef="createProblemResolutionReport" />
    <bpmn:sequenceFlow id="sf49" sourceRef="createProblemResolutionReport" targetRef="sendProblemResolutionReport" />
    <bpmn:sequenceFlow id="sf50" sourceRef="sendProblemResolutionReport" targetRef="receiveResolutionReport" />
    <!-- Customer Service parallel split -->
    <bpmn:sequenceFlow id="sf51" sourceRef="receiveActualPerf" targetRef="pgSplitCS" />
    <bpmn:sequenceFlow id="sf52" sourceRef="receiveResolutionReport" targetRef="pgSplitCS" />
    <bpmn:sequenceFlow id="sf53" sourceRef="pgSplitCS" targetRef="createCustomerReport" />
    <bpmn:sequenceFlow id="sf54" sourceRef="pgSplitCS" targetRef="reportSLARebate" />
    <bpmn:sequenceFlow id="sf55" sourceRef="reportSLARebate" targetRef="adjustBilling" />
    <bpmn:sequenceFlow id="sf55b" sourceRef="adjustBilling" targetRef="pgSplitBilling" />
    <bpmn:sequenceFlow id="sf56" sourceRef="pgSplitBilling" targetRef="pgJoinCS" />
    <bpmn:sequenceFlow id="sf57" sourceRef="pgSplitBilling" targetRef="billingEnd" />
    <bpmn:sequenceFlow id="sf58" sourceRef="createCustomerReport" targetRef="pgJoinCS" />
    <bpmn:sequenceFlow id="sf59" sourceRef="pgJoinCS" targetRef="sendCustomerReport" />
    <bpmn:sequenceFlow id="sf60" sourceRef="sendCustomerReport" targetRef="customerEnd" />
  </bpmn:process>
</bpmn:definitions>
