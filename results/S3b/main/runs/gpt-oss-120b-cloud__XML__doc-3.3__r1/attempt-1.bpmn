<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="claim-process"/>
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeRecAgain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSenior" name="Senior Claims Officer">
        <bpmn:flowNodeRef>checkRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Claim registered"/>
    <bpmn:task id="examine" name="Examine claim"/>
    <bpmn:task id="writeRec" name="Write settlement recommendation"/>
    <bpmn:task id="checkRec" name="Check settlement recommendation"/>
    <bpmn:exclusiveGateway id="gwDecision" name="Recommendation OK?"/>
    <bpmn:task id="writeRecAgain" name="Write settlement recommendation"/>
    <bpmn:endEvent id="end" name="Claim handling proceeds"/>

    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="examine"/>
    <bpmn:sequenceFlow id="flow2" sourceRef="examine" targetRef="writeRec"/>
    <bpmn:sequenceFlow id="flow3" sourceRef="writeRec" targetRef="checkRec"/>
    <bpmn:sequenceFlow id="flow4" sourceRef="checkRec" targetRef="gwDecision"/>
    <bpmn:sequenceFlow id="flow5" name="OK" sourceRef="gwDecision" targetRef="end"/>
    <bpmn:sequenceFlow id="flow6" name="Not OK" sourceRef="gwDecision" targetRef="writeRecAgain"/>
    <bpmn:sequenceFlow id="flow7" sourceRef="writeRecAgain" targetRef="checkRec"/>
  </bpmn:process>
</bpmn:definitions>
