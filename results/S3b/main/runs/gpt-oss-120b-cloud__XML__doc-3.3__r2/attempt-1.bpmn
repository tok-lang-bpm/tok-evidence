<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="claim-process" />
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="claimsOfficerLane" name="Claims Officer">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeRec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="seniorOfficerLane" name="Senior Claims Officer">
        <bpmn:flowNodeRef>checkRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Claim registered" />
    <bpmn:task id="examine" name="Examine claim" />
    <bpmn:task id="writeRec" name="Write settlement recommendation" />
    <bpmn:task id="checkRec" name="Check recommendation" />
    <bpmn:exclusiveGateway id="gateway" name="Recommendation OK?" />
    <bpmn:task id="sendBack" name="Send back to claims officer" />
    <bpmn:endEvent id="end" name="Claim handling completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="examine" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine" targetRef="writeRec" />
    <bpmn:sequenceFlow id="f3" sourceRef="writeRec" targetRef="checkRec" />
    <bpmn:sequenceFlow id="f4" sourceRef="checkRec" targetRef="gateway" />
    <bpmn:sequenceFlow id="f5" name="Not OK" sourceRef="gateway" targetRef="sendBack" />
    <bpmn:sequenceFlow id="f6" name="OK" sourceRef="gateway" targetRef="end" />
    <bpmn:sequenceFlow id="f7" sourceRef="sendBack" targetRef="writeRec" />
  </bpmn:process>
</bpmn:definitions>
