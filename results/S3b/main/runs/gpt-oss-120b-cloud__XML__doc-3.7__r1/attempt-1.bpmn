<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Insurance Organisation" processRef="insurance-process" />
  </bpmn:collaboration>

  <bpmn:process id="insurance-process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>searchFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handler" name="Claims Handler">
        <bpmn:flowNodeRef>calculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims Manager">
        <bpmn:flowNodeRef>negotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="searchFile" name="Search Police Report and assemble file" />
    <bpmn:task id="calculateEstimate" name="Calculate initial claim estimate" />
    <bpmn:task id="createActionPlan" name="Create Action Plan" />
    <bpmn:task id="negotiateSettlement" name="Negotiate settlement" />
    <bpmn:task id="informClaimant" name="Inform claimant of outcome" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="searchFile" />
    <bpmn:sequenceFlow id="f2" sourceRef="searchFile" targetRef="calculateEstimate" />
    <bpmn:sequenceFlow id="f3" sourceRef="calculateEstimate" targetRef="createActionPlan" />
    <bpmn:sequenceFlow id="f4" sourceRef="createActionPlan" targetRef="negotiateSettlement" />
    <bpmn:sequenceFlow id="f5" sourceRef="negotiateSettlement" targetRef="informClaimant" />
    <bpmn:sequenceFlow id="f6" sourceRef="informClaimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
