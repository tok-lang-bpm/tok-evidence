<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insuranceOrg" name="Insurance Organisation" processRef="claims-process" />
  </bpmn:collaboration>
  <bpmn:process id="claims-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="handlerLane" name="Claims Handler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>searchAndFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="managerLane" name="Claims Manager">
        <bpmn:flowNodeRef>negotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="searchAndFile" name="Search Police Report and create file with Claim Documentation" />
    <bpmn:task id="calculateEstimate" name="Calculate initial claim estimate" />
    <bpmn:task id="createActionPlan" name="Create Action Plan" />
    <bpmn:task id="negotiateSettlement" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="informClaimant" name="Inform claimant of outcome" />
    <bpmn:endEvent id="end" name="Process end" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="searchAndFile" />
    <bpmn:sequenceFlow id="f2" sourceRef="searchAndFile" targetRef="calculateEstimate" />
    <bpmn:sequenceFlow id="f3" sourceRef="calculateEstimate" targetRef="createActionPlan" />
    <bpmn:sequenceFlow id="f4" sourceRef="createActionPlan" targetRef="negotiateSettlement" />
    <bpmn:sequenceFlow id="f5" sourceRef="negotiateSettlement" targetRef="informClaimant" />
    <bpmn:sequenceFlow id="f6" sourceRef="informClaimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
