<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="CarInsurer" name="Car Insurer" processRef="car-insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="car-insurer-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneNotification" name="Notification Department">
        <bpmn:flowNodeRef>checkRegister</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneHandling" name="Handling Department">
        <bpmn:flowNodeRef>pickCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Events -->
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:endEvent id="end" name="Process complete" />

    <!-- Tasks -->
    <bpmn:task id="submit" name="Submit claim" />
    <bpmn:task id="checkRegister" name="Check documents and register claim" />
    <bpmn:task id="pickCheck" name="Pick up claim and check insurance" />
    <bpmn:task id="assess" name="Perform assessment" />
    <bpmn:task id="phoneGarage" name="Phone garage to authorise repairs" />
    <bpmn:task id="schedulePayment" name="Schedule payment" />
    <bpmn:task id="rejectClaim" name="Reject claim" />
    <bpmn:task id="sendLetter" name="Send letter to customer" />

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="assessDecision" name="Assessment positive?" />
    <bpmn:exclusiveGateway id="mergeDecision" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="checkRegister" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkRegister" targetRef="pickCheck" />
    <bpmn:sequenceFlow id="f4" sourceRef="pickCheck" targetRef="assess" />
    <bpmn:sequenceFlow id="f5" sourceRef="assess" targetRef="assessDecision" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="assessDecision" targetRef="phoneGarage" />
    <bpmn:sequenceFlow id="f7" sourceRef="phoneGarage" targetRef="schedulePayment" />
    <bpmn:sequenceFlow id="f8" sourceRef="schedulePayment" targetRef="mergeDecision" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="assessDecision" targetRef="rejectClaim" />
    <bpmn:sequenceFlow id="f10" sourceRef="rejectClaim" targetRef="mergeDecision" />
    <bpmn:sequenceFlow id="f11" sourceRef="mergeDecision" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f12" sourceRef="sendLetter" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
