<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="insurer-process" />
  </bpmn:collaboration>

  <bpmn:process id="insurer-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_notification" name="Notification Department">
        <bpmn:flowNodeRef>t_checkDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_handling" name="Handling Department">
        <bpmn:flowNodeRef>t_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_checkInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_assessPos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="s1" name="Customer submits claim" />
    <bpmn:task id="t_submit" name="Submit claim with documentation" />

    <bpmn:task id="t_checkDocs" name="Check documents for completeness" />
    <bpmn:task id="t_registerClaim" name="Register the claim" />

    <bpmn:task id="t_pickup" name="Pick up claim" />
    <bpmn:task id="t_checkInsurance" name="Check insurance" />
    <bpmn:task id="t_assessment" name="Perform assessment" />

    <bpmn:exclusiveGateway id="g_assessPos" name="Assessment positive?" />

    <bpmn:task id="t_phoneGarage" name="Phone garage to authorise repairs" />
    <bpmn:task id="t_schedulePayment" name="Schedule payment" />

    <bpmn:task id="t_reject" name="Reject claim" />

    <bpmn:exclusiveGateway id="g_merge" name="Merge outcomes" />

    <bpmn:task id="t_sendLetter" name="Send letter to customer" />
    <bpmn:endEvent id="e_complete" name="Process complete" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_submit" targetRef="t_checkDocs" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_checkDocs" targetRef="t_registerClaim" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_registerClaim" targetRef="t_pickup" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_pickup" targetRef="t_checkInsurance" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_checkInsurance" targetRef="t_assessment" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_assessment" targetRef="g_assessPos" />

    <bpmn:sequenceFlow id="f8_yes" name="yes" sourceRef="g_assessPos" targetRef="t_phoneGarage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">positive</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9_no" name="no" sourceRef="g_assessPos" targetRef="t_reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">negative</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f10" sourceRef="t_phoneGarage" targetRef="t_schedulePayment" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_schedulePayment" targetRef="g_merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_reject" targetRef="g_merge" />

    <bpmn:sequenceFlow id="f13" sourceRef="g_merge" targetRef="t_sendLetter" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_sendLetter" targetRef="e_complete" />
  </bpmn:process>
</bpmn:definitions>
