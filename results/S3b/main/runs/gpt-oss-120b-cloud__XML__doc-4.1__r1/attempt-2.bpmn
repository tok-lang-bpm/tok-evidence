<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Mental Health Care Institute" processRef="intake-process" />
  </bpmn:collaboration>
  <bpmn:process id="intake-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneFamilyDoctor" name="Family Doctor">
        <bpmn:flowNodeRef>callNotice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSecretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>inquirePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>connectDoctor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeInSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createPatientFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeFormAndPrint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addToNewNotices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSecondIntaker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addToReachedList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transcribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addTranscription</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneNursingOfficer" name="Nursing Officer">
        <bpmn:flowNodeRef>makeFullInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordOnForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handInForm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneTeamLeader" name="Team Leader">
        <bpmn:flowNodeRef>staffMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignPatients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwFileReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>formulateTreatmentPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneFirstIntaker" name="First Intaker">
        <bpmn:flowNodeRef>firstPlanMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firstMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addFirstNotes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSecondIntaker" name="Second Intaker">
        <bpmn:flowNodeRef>secondPlanMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>secondMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordDictaphone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lanePsychiatrist" name="Psychiatrist">
        <bpmn:flowNodeRef>formulateTreatmentPlan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Intake workflow starts" />
    <bpmn:task id="callNotice" name="Notice by telephone" />
    <bpmn:task id="inquirePatient" name="Inquire name and residence" />
    <bpmn:task id="connectDoctor" name="Put doctor through to nursing officer" />
    <bpmn:task id="makeFullInquiry" name="Make full inquiry into mental, health, and social state" />
    <bpmn:task id="recordOnForm" name="Record information on registration form" />
    <bpmn:task id="handInForm" name="Hand registration form to secretarial office" />
    <bpmn:task id="storeInSystem" name="Store information in information system" />
    <bpmn:task id="printForm" name="Print registration form" />
    <bpmn:exclusiveGateway id="gwNewPatient" name="New patient?" />
    <bpmn:task id="createPatientFile" name="Create patient file" />
    <bpmn:task id="storeFormAndPrint" name="Store form and print in patient file" />
    <bpmn:task id="produceCards" name="Produce two registration cards" />
    <bpmn:task id="addToNewNotices" name="Add patient to list of new notices" />
    <bpmn:task id="staffMeeting" name="Staff meeting (Wednesday)" />
    <bpmn:task id="assignPatients" name="Assign patients to team members" />
    <bpmn:task id="storeAssignment" name="Store assignment in information system" />
    <bpmn:exclusiveGateway id="gwFileReq" name="Medical file required?" />
    <bpmn:task id="sendLetter" name="Send letter to family doctor requesting medical file" />
    <bpmn:task id="receiveCopy" name="Receive medical file copy" />
    <bpmn:task id="informSecondIntaker" name="Inform second intaker of received file" />
    <bpmn:task id="passCards" name="Pass registration cards to intakers" />
    <bpmn:parallelGateway id="pgSplit" />
    <bpmn:task id="firstPlanMeeting" name="First intaker plans meeting with patient" />
    <bpmn:task id="firstMeeting" name="First meeting - examine patient with checklist" />
    <bpmn:task id="addFirstNotes" name="Add notes and checklist to patient file" />
    <bpmn:task id="secondPlanMeeting" name="Second intaker plans meeting (after file received)" />
    <bpmn:task id="secondMeeting" name="Second meeting - record observations on dictaphone" />
    <bpmn:task id="recordDictaphone" name="Record observations on dictaphone" />
    <bpmn:task id="transcribe" name="Transcribe dictaphone tape" />
    <bpmn:task id="addTranscription" name="Add transcription to patient file" />
    <bpmn:parallelGateway id="pgJoin" />
    <bpmn:task id="addToReachedList" name="Add patient to reached status list" />
    <bpmn:task id="provideList" name="Provide list to team leader" />
    <bpmn:task id="formulateTreatmentPlan" name="Formulate treatment plan (team & psychiatrist)" />
    <bpmn:endEvent id="end" name="Intake procedure completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="callNotice" />
    <bpmn:sequenceFlow id="f2" sourceRef="callNotice" targetRef="inquirePatient" />
    <bpmn:sequenceFlow id="f3" sourceRef="inquirePatient" targetRef="connectDoctor" />
    <bpmn:sequenceFlow id="f4" sourceRef="connectDoctor" targetRef="makeFullInquiry" />
    <bpmn:sequenceFlow id="f5" sourceRef="makeFullInquiry" targetRef="recordOnForm" />
    <bpmn:sequenceFlow id="f6" sourceRef="recordOnForm" targetRef="handInForm" />
    <bpmn:sequenceFlow id="f7" sourceRef="handInForm" targetRef="storeInSystem" />
    <bpmn:sequenceFlow id="f8" sourceRef="storeInSystem" targetRef="printForm" />
    <bpmn:sequenceFlow id="f9" sourceRef="printForm" targetRef="gwNewPatient" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="gwNewPatient" targetRef="createPatientFile" />
    <bpmn:sequenceFlow id="f11" sourceRef="createPatientFile" targetRef="storeFormAndPrint" />
    <bpmn:sequenceFlow id="f12" sourceRef="storeFormAndPrint" targetRef="produceCards" />
    <bpmn:sequenceFlow id="f13" sourceRef="produceCards" targetRef="addToNewNotices" />
    <bpmn:sequenceFlow id="f14" sourceRef="addToNewNotices" targetRef="staffMeeting" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="gwNewPatient" targetRef="staffMeeting" />
    <bpmn:sequenceFlow id="f16" sourceRef="staffMeeting" targetRef="assignPatients" />
    <bpmn:sequenceFlow id="f17" sourceRef="assignPatients" targetRef="storeAssignment" />
    <bpmn:sequenceFlow id="f18" sourceRef="storeAssignment" targetRef="gwFileReq" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="gwFileReq" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f20" sourceRef="sendLetter" targetRef="receiveCopy" />
    <bpmn:sequenceFlow id="f21" sourceRef="receiveCopy" targetRef="informSecondIntaker" />
    <bpmn:sequenceFlow id="f22" sourceRef="informSecondIntaker" targetRef="passCards" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="gwFileReq" targetRef="passCards" />
    <bpmn:sequenceFlow id="f24" sourceRef="passCards" targetRef="pgSplit" />
    <bpmn:sequenceFlow id="f25" sourceRef="pgSplit" targetRef="firstPlanMeeting" />
    <bpmn:sequenceFlow id="f26" sourceRef="pgSplit" targetRef="secondPlanMeeting" />
    <bpmn:sequenceFlow id="f27" sourceRef="firstPlanMeeting" targetRef="firstMeeting" />
    <bpmn:sequenceFlow id="f28" sourceRef="firstMeeting" targetRef="addFirstNotes" />
    <bpmn:sequenceFlow id="f29" sourceRef="addFirstNotes" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f30" sourceRef="secondPlanMeeting" targetRef="secondMeeting" />
    <bpmn:sequenceFlow id="f31" sourceRef="secondMeeting" targetRef="recordDictaphone" />
    <bpmn:sequenceFlow id="f32" sourceRef="recordDictaphone" targetRef="transcribe" />
    <bpmn:sequenceFlow id="f33" sourceRef="transcribe" targetRef="addTranscription" />
    <bpmn:sequenceFlow id="f34" sourceRef="addTranscription" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f35" sourceRef="pgJoin" targetRef="addToReachedList" />
    <bpmn:sequenceFlow id="f36" sourceRef="addToReachedList" targetRef="provideList" />
    <bpmn:sequenceFlow id="f37" sourceRef="provideList" targetRef="formulateTreatmentPlan" />
    <bpmn:sequenceFlow id="f38" sourceRef="formulateTreatmentPlan" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
