<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Mental Health Care Institute" processRef="PROCESS" />
  </bpmn:collaboration>

  <bpmn:process id="PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_familyDoctor" name="Family Doctor">
        <bpmn:flowNodeRef>task_doctorCall</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_secretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_putThrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_handInForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_storePrint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_createFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_storeFormPrintInFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_produceCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_addToNewNotices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_recordAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_passCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_medicalFileReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_informSecondIntaker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_addNotesToFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_addChecklistToFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_updateStatusList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_formTreatmentPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_nursingOfficer" name="Nursing Officer">
        <bpmn:flowNodeRef>task_nursingInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_recordForm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_firstIntaker" name="First Intaker (Social‑Medical Worker)">
        <bpmn:flowNodeRef>task_firstPlanMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_firstMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_fillChecklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_secondIntaker" name="Second Intaker (Physician)">
        <bpmn:flowNodeRef>task_secondPlanMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_secondMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_dictaphoneRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_transcribeDictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_addPhysicianInfoToFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_teamLeader" name="Team Leader">
        <bpmn:flowNodeRef>task_staffMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_assignPatients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_formTreatmentPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_psychiatrist" name="Psychiatrist">
        <bpmn:flowNodeRef>task_formTreatmentPlan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Notice by telephone (secretarial office)" />

    <bpmn:task id="task_doctorCall" name="Family doctor gives notice by telephone" />
    <bpmn:task id="task_inquire" name="Secretarial worker inquires name and residence" />
    <bpmn:task id="task_putThrough" name="Put doctor through to nursing officer" />
    <bpmn:task id="task_nursingInquiry" name="Nursing officer makes full inquiry" />
    <bpmn:task id="task_recordForm" name="Record information on registration form" />
    <bpmn:task id="task_handInForm" name="Hand registration form to secretarial office" />
    <bpmn:task id="task_storePrint" name="Store information in system and print" />

    <bpmn:exclusiveGateway id="g_isNewPatient" name="Is new patient?" />
    <bpmn:task id="task_createFile" name="Create patient file" />
    <bpmn:task id="task_storeFormPrintInFile" name="Store form and print in patient file" />
    <bpmn:task id="task_produceCards" name="Produce two registration cards" />
    <bpmn:task id="task_addToNewNotices" name="Add patient to list of new notices" />

    <bpmn:task id="task_staffMeeting" name="Weekly staff meeting (Wednesday)" />
    <bpmn:task id="task_assignPatients" name="Team leader assigns new patients to intakers" />
    <bpmn:task id="task_recordAssignment" name="Record assignments on assignment list" />
    <bpmn:exclusiveGateway id="g_medicalFileRequired" name="Medical file required?" />
    <bpmn:task id="task_sendLetter" name="Prepare and send letter to family doctor" />
    <bpmn:intermediateCatchEvent id="catch_medicalFileReceived" name="Medical file copy received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_informSecondIntaker" name="Inform second intaker and add copy to file" />

    <bpmn:task id="task_passCards" name="Pass registration cards to first and second intaker" />

    <!-- First intaker branch -->
    <bpmn:task id="task_firstPlanMeeting" name="First intaker plans meeting with patient" />
    <bpmn:task id="task_firstMeeting" name="First intaker meets patient" />
    <bpmn:task id="task_fillChecklist" name="Fill out standard checklist and register observations" />
    <bpmn:task id="task_addNotesToFile" name="Add first intaker notes to patient file" />
    <bpmn:task id="task_addChecklistToFile" name="Add checklist to patient file" />

    <!-- Second intaker branch -->
    <bpmn:task id="task_secondPlanMeeting" name="Second intaker plans meeting with patient" />
    <bpmn:task id="task_secondMeeting" name="Second intaker meets patient" />
    <bpmn:task id="task_dictaphoneRecord" name="Physician records observations on dictaphone" />
    <bpmn:task id="task_transcribeDictaphone" name="Secretarial types out dictaphone tapes" />
    <bpmn:task id="task_addPhysicianInfoToFile" name="Add transcription to patient file" />

    <bpmn:parallelGateway id="pg_meetings_split" name="Split after cards passed" />
    <bpmn:parallelGateway id="pg_meetings_join" name="Join after both meetings" />

    <bpmn:task id="task_updateStatusList" name="Put patient on list of completed intake status" />
    <bpmn:task id="task_formTreatmentPlan" name="Form treatment plan (team leader, intakers, psychiatrist)" />

    <bpmn:endEvent id="end" name="Intake procedure completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f_start_to_call" sourceRef="start" targetRef="task_doctorCall" />
    <bpmn:sequenceFlow id="f_call_to_inquire" sourceRef="task_doctorCall" targetRef="task_inquire" />
    <bpmn:sequenceFlow id="f_inquire_to_putThrough" sourceRef="task_inquire" targetRef="task_putThrough" />
    <bpmn:sequenceFlow id="f_putThrough_to_nursing" sourceRef="task_putThrough" targetRef="task_nursingInquiry" />
    <bpmn:sequenceFlow id="f_nursing_to_recordForm" sourceRef="task_nursingInquiry" targetRef="task_recordForm" />
    <bpmn:sequenceFlow id="f_recordForm_to_handIn" sourceRef="task_recordForm" targetRef="task_handInForm" />
    <bpmn:sequenceFlow id="f_handIn_to_storePrint" sourceRef="task_handInForm" targetRef="task_storePrint" />
    <bpmn:sequenceFlow id="f_storePrint_to_isNewPatient" sourceRef="task_storePrint" targetRef="g_isNewPatient" />

    <bpmn:sequenceFlow id="f_isNew_yes" sourceRef="g_isNewPatient" targetRef="task_createFile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_createFile_to_storeFormPrint" sourceRef="task_createFile" targetRef="task_storeFormPrintInFile" />
    <bpmn:sequenceFlow id="f_storeFormPrint_to_produceCards" sourceRef="task_storeFormPrintInFile" targetRef="task_produceCards" />
    <bpmn:sequenceFlow id="f_produceCards_to_addNotices" sourceRef="task_produceCards" targetRef="task_addToNewNotices" />
    <bpmn:sequenceFlow id="f_isNew_no" sourceRef="g_isNewPatient" targetRef="task_produceCards">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f_addNotices_to_staffMeeting" sourceRef="task_addToNewNotices" targetRef="task_staffMeeting" />
    <bpmn:sequenceFlow id="f_staffMeeting_to_assign" sourceRef="task_staffMeeting" targetRef="task_assignPatients" />
    <bpmn:sequenceFlow id="f_assign_to_recordAssignment" sourceRef="task_assignPatients" targetRef="task_recordAssignment" />
    <bpmn:sequenceFlow id="f_recordAssignment_to_medicalFileReq" sourceRef="task_recordAssignment" targetRef="g_medicalFileRequired" />

    <bpmn:sequenceFlow id="f_medFile_yes" sourceRef="g_medicalFileRequired" targetRef="task_sendLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_sendLetter_to_catch" sourceRef="task_sendLetter" targetRef="catch_medicalFileReceived" />
    <bpmn:sequenceFlow id="f_catch_to_inform" sourceRef="catch_medicalFileReceived" targetRef="task_informSecondIntaker" />
    <bpmn:sequenceFlow id="f_inform_to_passCards" sourceRef="task_informSecondIntaker" targetRef="task_passCards" />

    <bpmn:sequenceFlow id="f_medFile_no" sourceRef="g_medicalFileRequired" targetRef="task_passCards">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Split to parallel branches after cards are passed -->
    <bpmn:sequenceFlow id="f_passCards_to_split" sourceRef="task_passCards" targetRef="pg_meetings_split" />

    <!-- First intaker branch -->
    <bpmn:sequenceFlow id="f_split_to_firstPlan" sourceRef="pg_meetings_split" targetRef="task_firstPlanMeeting" />
    <bpmn:sequenceFlow id="f_firstPlan_to_meeting" sourceRef="task_firstPlanMeeting" targetRef="task_firstMeeting" />
    <bpmn:sequenceFlow id="f_firstMeeting_to_checklist" sourceRef="task_firstMeeting" targetRef="task_fillChecklist" />
    <bpmn:sequenceFlow id="f_checklist_to_addNotes" sourceRef="task_fillChecklist" targetRef="task_addNotesToFile" />
    <bpmn:sequenceFlow id="f_addNotes_to_addChecklist" sourceRef="task_addNotesToFile" targetRef="task_addChecklistToFile" />
    <bpmn:sequenceFlow id="f_addChecklist_to_join" sourceRef="task_addChecklistToFile" targetRef="pg_meetings_join" />

    <!-- Second intaker branch (includes medical file handling) -->
    <bpmn:sequenceFlow id="f_split_to_secondPlan" sourceRef="pg_meetings_split" targetRef="task_secondPlanMeeting" />
    <bpmn:sequenceFlow id="f_secondPlan_to_meeting" sourceRef="task_secondPlanMeeting" targetRef="task_secondMeeting" />
    <bpmn:sequenceFlow id="f_secondMeeting_to_dictaphone" sourceRef="task_secondMeeting" targetRef="task_dictaphoneRecord" />
    <bpmn:sequenceFlow id="f_dictaphone_to_transcribe" sourceRef="task_dictaphoneRecord" targetRef="task_transcribeDictaphone" />
    <bpmn:sequenceFlow id="f_transcribe_to_addInfo" sourceRef="task_transcribeDictaphone" targetRef="task_addPhysicianInfoToFile" />
    <bpmn:sequenceFlow id="f_addInfo_to_join" sourceRef="task_addPhysicianInfoToFile" targetRef="pg_meetings_join" />

    <!-- After both meetings -->
    <bpmn:sequenceFlow id="f_join_to_updateStatus" sourceRef="pg_meetings_join" targetRef="task_updateStatusList" />
    <bpmn:sequenceFlow id="f_updateStatus_to_treatmentPlan" sourceRef="task_updateStatusList" targetRef="task_formTreatmentPlan" />
    <bpmn:sequenceFlow id="f_treatmentPlan_to_end" sourceRef="task_formTreatmentPlan" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
