<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="loan-process" />
  </bpmn:collaboration>
  <bpmn:process id="loan-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="laneSet1">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneRiskService" name="Risk Assessment Web Service">
        <bpmn:flowNodeRef>invokeRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveLoan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denyLoan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendToApprover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneApproverService" name="Approver Web Service">
        <bpmn:flowNodeRef>invokeApprover</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Receive customer request for a loan" />
    <bpmn:task id="invokeRisk" name="Invoke risk assessment Web service" />
    <bpmn:exclusiveGateway id="gwDecision" name="Risk assessment decision" />
    <bpmn:task id="approveLoan" name="Approve loan" />
    <bpmn:task id="denyLoan" name="Deny loan" />
    <bpmn:task id="sendToApprover" name="Send request to approver Web service" />
    <bpmn:task id="invokeApprover" name="Invoke approver Web service" />
    <bpmn:task id="receiveFeedback" name="Customer receives feedback" />
    <bpmn:endEvent id="end" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="F1" sourceRef="start" targetRef="invokeRisk" />
    <bpmn:sequenceFlow id="F2" sourceRef="invokeRisk" targetRef="gwDecision" />

    <bpmn:sequenceFlow id="F3" name="small &amp; low risk" sourceRef="gwDecision" targetRef="approveLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">small and lowRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F4" name="high risk" sourceRef="gwDecision" targetRef="denyLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">highRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F5" name="needs review or amount≥10000" sourceRef="gwDecision" targetRef="sendToApprover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">needsReview or amount >= 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F6" sourceRef="approveLoan" targetRef="receiveFeedback" />
    <bpmn:sequenceFlow id="F7" sourceRef="denyLoan" targetRef="receiveFeedback" />
    <bpmn:sequenceFlow id="F8" sourceRef="sendToApprover" targetRef="invokeApprover" />
    <bpmn:sequenceFlow id="F9" sourceRef="invokeApprover" targetRef="receiveFeedback" />
    <bpmn:sequenceFlow id="F10" sourceRef="receiveFeedback" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
