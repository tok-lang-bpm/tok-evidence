<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organization" processRef="vacation-request-process" />
  </bpmn:collaboration>
  <bpmn:process id="vacation-request-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_employee" name="Employee">
        <bpmn:flowNodeRef>submit_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_rejection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_hr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>complete_management</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Vacation request process starts" />
    <bpmn:task id="submit_request" name="Submit vacation request" />
    <bpmn:task id="receive_request" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="gateway_approval" name="Approve request?" />
    <bpmn:task id="review_rejection" name="Review rejection reasons" />
    <bpmn:endEvent id="end_rejection" name="Process ends after rejection" />
    <bpmn:task id="notify_hr" name="Notify HR Representative" />
    <bpmn:task id="complete_management" name="Complete management procedures" />
    <bpmn:endEvent id="end_approval" name="Process ends after approval" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit_request" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit_request" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive_request" targetRef="gateway_approval" />
    <bpmn:sequenceFlow id="f4" name="reject" sourceRef="gateway_approval" targetRef="review_rejection" />
    <bpmn:sequenceFlow id="f5" sourceRef="review_rejection" targetRef="end_rejection" />
    <bpmn:sequenceFlow id="f6" name="approve" sourceRef="gateway_approval" targetRef="notify_hr" />
    <bpmn:sequenceFlow id="f7" sourceRef="notify_hr" targetRef="complete_management" />
    <bpmn:sequenceFlow id="f8" sourceRef="complete_management" targetRef="end_approval" />
  </bpmn:process>
</bpmn:definitions>
