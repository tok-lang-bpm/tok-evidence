<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organization" processRef="vacation-process" />
  </bpmn:collaboration>
  <bpmn:process id="vacation-process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_emp" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sup" name="Immediate Supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_hr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>hr_procedure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Vacation request submitted" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="register" name="Register vacation request" />
    <bpmn:task id="receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="gw_decision" name="Supervisor approval decision" />
    <bpmn:task id="reject" name="Reject vacation request" />
    <bpmn:task id="return" name="Return request to employee" />
    <bpmn:task id="review" name="Employee reviews rejection reasons" />
    <bpmn:endEvent id="end_rejected" name="Request rejected" />
    <bpmn:task id="notify_hr" name="Notify Human Resources Representative" />
    <bpmn:task id="hr_procedure" name="HR Representative completes management procedures" />
    <bpmn:endEvent id="end_approved" name="Vacation request processed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f3" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f4" sourceRef="receive" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="f5" name="approve" sourceRef="gw_decision" targetRef="notify_hr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">decision == 'approve'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" name="reject" sourceRef="gw_decision" targetRef="reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">decision == 'reject'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" sourceRef="reject" targetRef="return" />
    <bpmn:sequenceFlow id="f8" sourceRef="return" targetRef="review" />
    <bpmn:sequenceFlow id="f9" sourceRef="review" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f10" sourceRef="notify_hr" targetRef="hr_procedure" />
    <bpmn:sequenceFlow id="f11" sourceRef="hr_procedure" targetRef="end_approved" />
  </bpmn:process>
</bpmn:definitions>
