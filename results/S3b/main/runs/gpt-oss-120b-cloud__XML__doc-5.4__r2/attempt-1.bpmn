<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gSupervisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-treasurer" name="Treasurer">
        <bpmn:flowNodeRef>checkReceipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gTreasurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBack</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-system" name="System">
        <bpmn:flowNodeRef>linkPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="gSupervisor" name="Supervisor decision" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="checkReceipts" name="Check receipts" />
    <bpmn:exclusiveGateway id="gTreasurer" name="Treasurer decision" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:task id="sendBack" name="Send report back to employee" />
    <bpmn:task id="linkPayment" name="Link to payment system" />
    <bpmn:intermediateCatchEvent id="waitPayment" name="Payment confirmation">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" name="Process end" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f2" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f3" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f4" sourceRef="review" targetRef="gSupervisor" />
    <bpmn:sequenceFlow id="f5" name="reject" sourceRef="gSupervisor" targetRef="edit" />
    <bpmn:sequenceFlow id="f6" name="approve" sourceRef="gSupervisor" targetRef="checkReceipts" />
    <bpmn:sequenceFlow id="f7" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f8" sourceRef="checkReceipts" targetRef="gTreasurer" />
    <bpmn:sequenceFlow id="f9" name="all in order" sourceRef="gTreasurer" targetRef="accept" />
    <bpmn:sequenceFlow id="f10" name="missing/mismatch" sourceRef="gTreasurer" targetRef="sendBack" />
    <bpmn:sequenceFlow id="f11" sourceRef="accept" targetRef="linkPayment" />
    <bpmn:sequenceFlow id="f12" sourceRef="linkPayment" targetRef="waitPayment" />
    <bpmn:sequenceFlow id="f13" sourceRef="waitPayment" targetRef="end" />
    <bpmn:sequenceFlow id="f14" sourceRef="sendBack" targetRef="edit" />
  </bpmn:process>
</bpmn:definitions>
