<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_marketing" name="Marketing">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibitionGathering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>personalReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presenterGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>responseGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customerResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noResponseTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNotInterested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_callcenter" name="Call Center">
        <bpmn:flowNodeRef>callCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineContactPersonAndBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askGeneralInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budgetHugeGateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_headdev" name="Head of Development">
        <bpmn:flowNodeRef>headDevTryAcquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_salesrep" name="Sales Representative">
        <bpmn:flowNodeRef>presentationSales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesCallAfterWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createQuotation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_presales" name="Pre‑sales Employee">
        <bpmn:flowNodeRef>presentationTech</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="start" name="Start process" />
    
    <!-- Determine contact details (method) -->
    <bpmn:exclusiveGateway id="determineMethod" name="How to determine contact details?" />
    <bpmn:task id="buyDetails" name="Buy contact details" />
    <bpmn:task id="exhibitionGathering" name="Gather contacts at exhibitions" />
    <bpmn:task id="personalReferral" name="Obtain personal referral" />
    <bpmn:exclusiveGateway id="determineMerge" name="Details obtained" />

    <!-- Call centre activities -->
    <bpmn:task id="callCustomer" name="Call the customer" />
    <bpmn:task id="determineContactPersonAndBudget" name="Determine contact person and budget" />
    <bpmn:task id="askGeneralInterest" name="Ask if generally interested" />
    <bpmn:exclusiveGateway id="interestGateway" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="budgetHugeGateway" name="Potential project budget huge?" />
    <bpmn:endEvent id="endNotInterested" name="Leave him alone" />

    <!-- Head of development -->
    <bpmn:task id="headDevTryAcquire" name="Head of development tries to acquire the customer" />

    <!-- Presentation -->
    <bpmn:exclusiveGateway id="presenterGateway" name="Select presenter" />
    <bpmn:task id="presentationSales" name="Give detailed online presentation (sales representative)" />
    <bpmn:task id="presentationTech" name="Give detailed online presentation (pre‑sales employee)" />
    <bpmn:exclusiveGateway id="presentationMerge" name="Presentation done" />

    <!-- Waiting for response -->
    <bpmn:eventBasedGateway id="responseGateway" name="Wait for customer response" />
    <bpmn:intermediateCatchEvent id="customerResponse" name="Customer response received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="noResponseTimer" name="No response within 2 weeks">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT336H</bpmn:timeDuration> <!-- 14 days -->
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <!-- Follow‑up call after timeout -->
    <bpmn:task id="salesCallAfterWait" name="Sales representative calls the customer" />

    <!-- Quotation -->
    <bpmn:task id="createQuotation" name="Create quotation" />
    <bpmn:endEvent id="endDone" name="Process completed" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="determineMethod" />
    <bpmn:sequenceFlow id="f2" sourceRef="determineMethod" targetRef="buyDetails">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == 'buy'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3" sourceRef="determineMethod" targetRef="exhibitionGathering">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == 'exhibition'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="determineMethod" targetRef="personalReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == 'referral'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" sourceRef="buyDetails" targetRef="determineMerge" />
    <bpmn:sequenceFlow id="f6" sourceRef="exhibitionGathering" targetRef="determineMerge" />
    <bpmn:sequenceFlow id="f7" sourceRef="personalReferral" targetRef="determineMerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="determineMerge" targetRef="callCustomer" />
    <bpmn:sequenceFlow id="f9" sourceRef="callCustomer" targetRef="determineContactPersonAndBudget" />
    <bpmn:sequenceFlow id="f10" sourceRef="determineContactPersonAndBudget" targetRef="askGeneralInterest" />
    <bpmn:sequenceFlow id="f11" sourceRef="askGeneralInterest" targetRef="interestGateway" />
    <bpmn:sequenceFlow id="f12" sourceRef="interestGateway" targetRef="presenterGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" sourceRef="interestGateway" targetRef="budgetHugeGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="budgetHugeGateway" targetRef="headDevTryAcquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">budgetHuge == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f15" sourceRef="budgetHugeGateway" targetRef="endNotInterested">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">budgetHuge == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16" sourceRef="headDevTryAcquire" targetRef="presenterGateway" />
    <bpmn:sequenceFlow id="f17" sourceRef="presenterGateway" targetRef="presentationSales">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">presenter == 'sales'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" sourceRef="presenterGateway" targetRef="presentationTech">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">presenter == 'tech'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f19" sourceRef="presentationSales" targetRef="presentationMerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="presentationTech" targetRef="presentationMerge" />
    <bpmn:sequenceFlow id="f21" sourceRef="presentationMerge" targetRef="responseGateway" />
    <bpmn:sequenceFlow id="f22" sourceRef="responseGateway" targetRef="customerResponse" />
    <bpmn:sequenceFlow id="f23" sourceRef="responseGateway" targetRef="noResponseTimer" />
    <bpmn:sequenceFlow id="f24" sourceRef="customerResponse" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f25" sourceRef="noResponseTimer" targetRef="salesCallAfterWait" />
    <bpmn:sequenceFlow id="f26" sourceRef="salesCallAfterWait" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f27" sourceRef="createQuotation" targetRef="endDone" />
  </bpmn:process>
</bpmn:definitions>
