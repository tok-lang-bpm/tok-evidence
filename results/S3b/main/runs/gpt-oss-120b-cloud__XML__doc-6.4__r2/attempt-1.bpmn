<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>

  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneMarketing" name="Marketing staff">
        <bpmn:flowNodeRef>gwMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>marketingExhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>personalReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMethodJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCallCenter" name="Call center staff">
        <bpmn:flowNodeRef>startCalling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwBudgetHuge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endLeave</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneHeadDev" name="Head of Development">
        <bpmn:flowNodeRef>headAcquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSalesRep" name="Sales representative">
        <bpmn:flowNodeRef>gwPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPresentationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesCallBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lanePreSales" name="Pre‑sales employee">
        <bpmn:flowNodeRef>preSalesPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="start" name="Start process" />

    <!-- Determine contact details – alternative ways -->
    <bpmn:exclusiveGateway id="gwMethod" name="How to obtain contact details?" />
    <bpmn:task id="buyDetails" name="Buy details for cold calls" />
    <bpmn:task id="marketingExhibition" name="Marketing staff participates in exhibitions" />
    <bpmn:task id="personalReferral" name="Personal referral of interested person" />
    <bpmn:exclusiveGateway id="gwMethodJoin" name="Details obtained" />

    <!-- Call the customer -->
    <bpmn:task id="startCalling" name="Start calling the customer" />
    <bpmn:task id="detContactPerson" name="Determine contact person" />
    <bpmn:task id="detBudget" name="Determine potential project budget" />
    <bpmn:task id="askInterest" name="Ask if generally interested" />

    <!-- Decision on interest -->
    <bpmn:exclusiveGateway id="gwInterest" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="gwBudgetHuge" name="Budget huge?" />
    <bpmn:task id="headAcquire" name="Head of development tries to acquire the customer" />
    <bpmn:endEvent id="endLeave" name="Leave the customer alone" />

    <!-- Presentation selection -->
    <bpmn:exclusiveGateway id="gwPresentation" name="Select presenter for online presentation" />
    <bpmn:task id="salesPresentation" name="Sales representative gives detailed online presentation" />
    <bpmn:task id="preSalesPresentation" name="Pre‑sales employee gives detailed technical presentation" />
    <bpmn:exclusiveGateway id="gwPresentationJoin" name="Presentation done" />

    <!-- Waiting for response -->
    <bpmn:task id="waitResponse" name="Wait for customer response (2 weeks)" />
    <bpmn:exclusiveGateway id="gwResponse" name="Customer responded within 2 weeks?" />
    <bpmn:task id="salesCallBack" name="Sales representative calls the customer" />

    <!-- Quotation -->
    <bpmn:task id="createQuote" name="Create quotation" />
    <bpmn:endEvent id="end" name="Process completed" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gwMethod" />
    <bpmn:sequenceFlow id="f2" sourceRef="gwMethod" targetRef="buyDetails">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == 'buy'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3" sourceRef="gwMethod" targetRef="marketingExhibition">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == 'exhibition'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="gwMethod" targetRef="personalReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method == 'referral'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" sourceRef="buyDetails" targetRef="gwMethodJoin" />
    <bpmn:sequenceFlow id="f6" sourceRef="marketingExhibition" targetRef="gwMethodJoin" />
    <bpmn:sequenceFlow id="f7" sourceRef="personalReferral" targetRef="gwMethodJoin" />
    <bpmn:sequenceFlow id="f8" sourceRef="gwMethodJoin" targetRef="startCalling" />
    <bpmn:sequenceFlow id="f9" sourceRef="startCalling" targetRef="detContactPerson" />
    <bpmn:sequenceFlow id="f10" sourceRef="detContactPerson" targetRef="detBudget" />
    <bpmn:sequenceFlow id="f11" sourceRef="detBudget" targetRef="askInterest" />
    <bpmn:sequenceFlow id="f12" sourceRef="askInterest" targetRef="gwInterest" />
    <bpmn:sequenceFlow id="f13" sourceRef="gwInterest" targetRef="gwPresentation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interest == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="gwInterest" targetRef="gwBudgetHuge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interest == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f15" sourceRef="gwBudgetHuge" targetRef="headAcquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">budget == 'huge'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16" sourceRef="gwBudgetHuge" targetRef="endLeave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">budget != 'huge'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f17" sourceRef="headAcquire" targetRef="gwPresentation" />
    <bpmn:sequenceFlow id="f18" sourceRef="gwPresentation" targetRef="salesPresentation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">presenter == 'sales'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f19" sourceRef="gwPresentation" targetRef="preSalesPresentation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">presenter == 'pre‑sales'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f20" sourceRef="salesPresentation" targetRef="gwPresentationJoin" />
    <bpmn:sequenceFlow id="f21" sourceRef="preSalesPresentation" targetRef="gwPresentationJoin" />
    <bpmn:sequenceFlow id="f22" sourceRef="gwPresentationJoin" targetRef="waitResponse" />
    <bpmn:sequenceFlow id="f23" sourceRef="waitResponse" targetRef="gwResponse" />
    <bpmn:sequenceFlow id="f24" sourceRef="gwResponse" targetRef="createQuote">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">responseWithinTwoWeeks == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f25" sourceRef="gwResponse" targetRef="salesCallBack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">responseWithinTwoWeeks == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f26" sourceRef="salesCallBack" targetRef="createQuote" />
    <bpmn:sequenceFlow id="f27" sourceRef="createQuote" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
