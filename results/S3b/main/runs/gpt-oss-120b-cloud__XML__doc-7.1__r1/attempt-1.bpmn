<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="lead-process"/>
  </bpmn:collaboration>

  <bpmn:process id="lead-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-manager" name="Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>callCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callNextCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Process start"/>
    <bpmn:task id="checkLeads" name="Checks the open leads"/>
    <bpmn:task id="selectTopFive" name="Selects the top five leads"/>
    <bpmn:task id="tellAssistant" name="Tells Sales Assistant to call contacts"/>
    <bpmn:task id="callCustomer" name="Calls each customer"/>
    <bpmn:exclusiveGateway id="interest" name="Customer interested?"/>
    <bpmn:task id="sendNote" name="Sends a note to the Manager"/>
    <bpmn:task id="processLead" name="Processes the lead"/>
    <bpmn:task id="callNextCustomer" name="Calls the next customer"/>
    <bpmn:endEvent id="end" name="Process completed"/>
    
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkLeads"/>
    <bpmn:sequenceFlow id="f2" sourceRef="checkLeads" targetRef="selectTopFive"/>
    <bpmn:sequenceFlow id="f3" sourceRef="selectTopFive" targetRef="tellAssistant"/>
    <bpmn:sequenceFlow id="f4" sourceRef="tellAssistant" targetRef="callCustomer"/>
    <bpmn:sequenceFlow id="f5" sourceRef="callCustomer" targetRef="interest"/>
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="interest" targetRef="sendNote"/>
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="interest" targetRef="callNextCustomer"/>
    <bpmn:sequenceFlow id="f8" sourceRef="sendNote" targetRef="processLead"/>
    <bpmn:sequenceFlow id="f9" sourceRef="processLead" targetRef="end"/>
    <bpmn:sequenceFlow id="f10" sourceRef="callNextCustomer" targetRef="interest"/>
  </bpmn:process>
</bpmn:definitions>
