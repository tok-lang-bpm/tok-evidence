<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>

  <bpmn:process id="org-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-functional" name="Functional Department">
        <bpmn:flowNodeRef>startDemand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-hr" name="HR">
        <bpmn:flowNodeRef>advertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applicantsApply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concludeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFilled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="startDemand" name="Demand to fill a post" />
    <bpmn:task id="advertisePost" name="Advertise the post" />
    <bpmn:task id="applicantsApply" name="Applicants apply" />
    <bpmn:task id="checkApplications" name="Check the applications" />
    <bpmn:task id="concludeContract" name="Conclude contract of employment" />
    <bpmn:endEvent id="endFilled" name="Post filled" />

    <bpmn:sequenceFlow id="flow1" sourceRef="startDemand" targetRef="advertisePost" />
    <bpmn:sequenceFlow id="flow2" sourceRef="advertisePost" targetRef="applicantsApply" />
    <bpmn:sequenceFlow id="flow3" sourceRef="applicantsApply" targetRef="checkApplications" />
    <bpmn:sequenceFlow id="flow4" sourceRef="checkApplications" targetRef="concludeContract" />
    <bpmn:sequenceFlow id="flow5" sourceRef="concludeContract" targetRef="endFilled" />
  </bpmn:process>
</bpmn:definitions>
