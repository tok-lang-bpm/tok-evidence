<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="HR-process" />
  </bpmn:collaboration>
  <bpmn:process id="HR-process" isExecutable="false">
    <bpmn:laneSet id="ORG-lanes">
      <bpmn:lane id="HR" name="HR Clerk">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gConfusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tAsk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tSubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tPost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="DEP" name="Department">
        <bpmn:flowNodeRef>tReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gApproval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="s1" name="Vacancy reported" />
    <bpmn:task id="tCreate" name="Create job description" />
    <bpmn:exclusiveGateway id="gConfusion" name="Message clear?" />
    <bpmn:task id="tAsk" name="Ask Department again" />
    <bpmn:task id="tSubmit" name="Submit job description for consideration" />
    <bpmn:task id="tReview" name="Review job description" />
    <bpmn:exclusiveGateway id="gApproval" name="Job description approved?" />
    <bpmn:task id="tCorrect" name="Correct job description" />
    <bpmn:task id="tPost" name="Post the job" />
    <bpmn:endEvent id="eEnd" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="tCreate" />
    <bpmn:sequenceFlow id="f2" sourceRef="tCreate" targetRef="gConfusion" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gConfusion" targetRef="tSubmit" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gConfusion" targetRef="tAsk" />
    <bpmn:sequenceFlow id="f5" sourceRef="tAsk" targetRef="tCreate" />
    <bpmn:sequenceFlow id="f6" sourceRef="tSubmit" targetRef="tReview" />
    <bpmn:sequenceFlow id="f7" sourceRef="tReview" targetRef="gApproval" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="gApproval" targetRef="tPost" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="gApproval" targetRef="tCorrect" />
    <bpmn:sequenceFlow id="f10" sourceRef="tCorrect" targetRef="tSubmit" />
    <bpmn:sequenceFlow id="f11" sourceRef="tPost" targetRef="eEnd" />
  </bpmn:process>
</bpmn:definitions>
