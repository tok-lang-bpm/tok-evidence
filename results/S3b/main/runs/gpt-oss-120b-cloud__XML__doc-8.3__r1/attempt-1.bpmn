<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="laneSet1">
      <bpmn:lane id="lane_head" name="Head of Functional Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askCorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hr" name="Personnel Department (HR)">
        <bpmn:flowNodeRef>prepareJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendJD</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Personnel requirements detected" />
    <bpmn:task id="detect" name="Detect personnel requirements" />
    <bpmn:task id="report" name="Report vacancy to Personnel Department" />
    <bpmn:task id="prepareJD" name="Prepare job description" />
    <bpmn:task id="sendJD" name="Send job description" />
    <bpmn:task id="receiveJD" name="Receive job description" />
    <bpmn:exclusiveGateway id="gw_questions" name="HR has questions?" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:exclusiveGateway id="gw_corrections" name="Need corrections?" />
    <bpmn:task id="askCorr" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:endEvent id="end" name="Job description approved" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="detect" />
    <bpmn:sequenceFlow id="flow2" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="flow3" sourceRef="report" targetRef="prepareJD" />
    <bpmn:sequenceFlow id="flow4" sourceRef="prepareJD" targetRef="sendJD" />
    <bpmn:sequenceFlow id="flow5" sourceRef="sendJD" targetRef="receiveJD" />
    <bpmn:sequenceFlow id="flow6" sourceRef="receiveJD" targetRef="gw_questions" />

    <bpmn:sequenceFlow id="flow7_yes" name="yes" sourceRef="gw_questions" targetRef="clarify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">HR_has_questions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow7_no" name="no" sourceRef="gw_questions" targetRef="gw_corrections">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!HR_has_questions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Clarifications loop back to prepare job description -->
    <bpmn:sequenceFlow id="flow8" sourceRef="clarify" targetRef="prepareJD" />

    <bpmn:sequenceFlow id="flow9_yes" name="yes" sourceRef="gw_corrections" targetRef="askCorr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">needs_corrections</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow9_no" name="no" sourceRef="gw_corrections" targetRef="approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!needs_corrections</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Loop after asking for corrections -->
    <bpmn:sequenceFlow id="flow10" sourceRef="askCorr" targetRef="prepareJD" />

    <bpmn:sequenceFlow id="flow11" sourceRef="approve" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
