<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>

  <bpmn:process id="PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_DB" name="Database">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backupDb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkDefaulterTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNewRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CRM" name="CRM System">
        <bpmn:flowNodeRef>checkCrmReturns1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNewReturns1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCrmReturns2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNewReturns2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_OP" name="Operations">
        <bpmn:flowNodeRef>registerDefaults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwClientAdvised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwBy2330</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwBy1600</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_AM" name="Account Management">
        <bpmn:flowNodeRef>sendToAM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SUP" name="Supervisor">
        <bpmn:flowNodeRef>alertSupervisor1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alertSupervisor2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Weekday morning start" />
    <bpmn:task id="backupDb" name="Backup the database" />
    <bpmn:task id="checkDefaulterTable" name="Check Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="gwNewRecords" name="New records in defaulter table?" />
    <bpmn:task id="checkCrmReturns1" name="Check CRM system for new returns" />
    <bpmn:exclusiveGateway id="gwNewReturns1" name="New returns filed?" />
    <bpmn:task id="registerDefaults" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="gwClientAdvised" name="Client codes previously advised?" />
    <bpmn:task id="produceTable" name="Produce another table of defaulting accounts" />
    <bpmn:task id="sendToAM" name="Send defaulting accounts table to account management" />
    <bpmn:exclusiveGateway id="gwBy2330" name="Completed by 2:30 pm?" />
    <bpmn:task id="alertSupervisor1" name="Send alert to supervisor" />
    <bpmn:task id="checkCrmReturns2" name="Check CRM system for new returns (second)" />
    <bpmn:exclusiveGateway id="gwNewReturns2" name="New returns filed (second)?" />
    <bpmn:task id="reconcile" name="Reconcile with existing account defaulters table" />
    <bpmn:exclusiveGateway id="gwBy1600" name="Completed by 4:00 pm?" />
    <bpmn:task id="alertSupervisor2" name="Send message to supervisor" />
    <bpmn:endEvent id="endNoReturns1" name="No new returns (first check) – process ends" />
    <bpmn:endEvent id="endNoReturns2" name="No new returns (second check) – process ends" />
    <bpmn:endEvent id="endAlert1" name="Alert sent – process ends" />
    <bpmn:endEvent id="endAlert2" name="Alert sent after 4:00 pm – process ends" />
    <bpmn:endEvent id="endReconciled" name="Reconciliation completed – process ends" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="backupDb" />
    <bpmn:sequenceFlow id="f2" sourceRef="backupDb" targetRef="checkDefaulterTable" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkDefaulterTable" targetRef="gwNewRecords" />

    <!-- New records = yes -->
    <bpmn:sequenceFlow id="f4_yes" name="yes" sourceRef="gwNewRecords" targetRef="registerDefaults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">newRecords == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- New records = no -->
    <bpmn:sequenceFlow id="f4_no" name="no" sourceRef="gwNewRecords" targetRef="checkCrmReturns1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">newRecords == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f5" sourceRef="checkCrmReturns1" targetRef="gwNewReturns1" />
    <!-- New returns = yes -->
    <bpmn:sequenceFlow id="f6_yes" name="yes" sourceRef="gwNewReturns1" targetRef="registerDefaults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">newReturns == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- New returns = no -->
    <bpmn:sequenceFlow id="f6_no" name="no" sourceRef="gwNewReturns1" targetRef="endNoReturns1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">newReturns == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f7" sourceRef="registerDefaults" targetRef="gwClientAdvised" />

    <!-- Client advised = yes -->
    <bpmn:sequenceFlow id="f8_yes" name="yes" sourceRef="gwClientAdvised" targetRef="gwBy2330">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">advised == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Client advised = no -->
    <bpmn:sequenceFlow id="f8_no" name="no" sourceRef="gwClientAdvised" targetRef="produceTable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">advised == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f9" sourceRef="produceTable" targetRef="sendToAM" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendToAM" targetRef="gwBy2330" />

    <!-- Deadline 2:30 check -->
    <bpmn:sequenceFlow id="f11_onTime" sourceRef="gwBy2330" targetRef="checkCrmReturns2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">time &lt;= '14:30'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11_late" sourceRef="gwBy2330" targetRef="alertSupervisor1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">time &gt; '14:30'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f12" sourceRef="alertSupervisor1" targetRef="endAlert1" />
    <bpmn:sequenceFlow id="f13" sourceRef="checkCrmReturns2" targetRef="gwNewReturns2" />

    <!-- Second new returns decision -->
    <bpmn:sequenceFlow id="f14_yes" name="yes" sourceRef="gwNewReturns2" targetRef="reconcile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">newReturns == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14_no" name="no" sourceRef="gwNewReturns2" targetRef="endNoReturns2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">newReturns == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f15" sourceRef="reconcile" targetRef="gwBy1600" />

    <!-- Deadline 4:00 check -->
    <bpmn:sequenceFlow id="f16_onTime" sourceRef="gwBy1600" targetRef="endReconciled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">time &lt;= '16:00'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16_late" sourceRef="gwBy1600" targetRef="alertSupervisor2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">time &gt; '16:00'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f17" sourceRef="alertSupervisor2" targetRef="endAlert2" />
  </bpmn:process>
</bpmn:definitions>
