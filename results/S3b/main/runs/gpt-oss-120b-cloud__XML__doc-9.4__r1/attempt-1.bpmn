<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>

  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneCoordination" name="Coordination Unit">
        <bpmn:flowNodeRef>qaCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSupport" name="Support Officer">
        <bpmn:flowNodeRef>updateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adviseCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateDeptRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCommittee" name="Committee Members">
        <bpmn:flowNodeRef>holdMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Dates finalized" />
    <bpmn:task id="updateCalendars" name="Update all group calendars" />
    <bpmn:task id="createFolders" name="Create meeting folders for each meeting" />
    <bpmn:task id="uploadDocuments" name="Upload all appropriate documents to system" />
    <bpmn:task id="adviseCommittee" name="Advise Committee Members a week before meeting" />
    <bpmn:task id="holdMeeting" name="Hold meeting" />
    <bpmn:task id="produceMinutes" name="Produce minutes including Action Points" />
    <bpmn:task id="qaCheck" name="Conduct QA check on the minutes" />
    <bpmn:task id="sendMinutes" name="Send minutes to all Committee Members" />
    <bpmn:task id="updateDeptRecords" name="Update all departmental records" />
    <bpmn:endEvent id="end" name="Process complete" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="updateCalendars" />
    <bpmn:sequenceFlow id="f2" sourceRef="updateCalendars" targetRef="createFolders" />
    <bpmn:sequenceFlow id="f3" sourceRef="createFolders" targetRef="uploadDocuments" />
    <bpmn:sequenceFlow id="f4" sourceRef="uploadDocuments" targetRef="adviseCommittee" />
    <bpmn:sequenceFlow id="f5" sourceRef="adviseCommittee" targetRef="holdMeeting" />
    <bpmn:sequenceFlow id="f6" sourceRef="holdMeeting" targetRef="produceMinutes" />
    <bpmn:sequenceFlow id="f7" sourceRef="produceMinutes" targetRef="qaCheck" />
    <bpmn:sequenceFlow id="f8" sourceRef="qaCheck" targetRef="sendMinutes" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendMinutes" targetRef="updateDeptRecords" />
    <bpmn:sequenceFlow id="f10" sourceRef="updateDeptRecords" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
