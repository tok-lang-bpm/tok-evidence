<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="laneSet1">
      <bpmn:lane id="laneCoord" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qaCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSupport" name="Support Officer">
        <bpmn:flowNodeRef>updateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCommittee" name="Committee Members">
        <bpmn:flowNodeRef>readDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>holdMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Dates finalized" />
    <bpmn:task id="updateCalendars" name="Update group calendars, create meeting folders, upload documents" />
    <bpmn:task id="adviseMembers" name="Advise Committee Members to read documents" />
    <bpmn:task id="readDocuments" name="Read related documents" />
    <bpmn:task id="holdMeeting" name="Hold meeting" />
    <bpmn:task id="produceMinutes" name="Produce minutes with Action Points" />
    <bpmn:task id="qaCheck" name="QA check minutes" />
    <bpmn:task id="sendMinutes" name="Send minutes to Committee Members" />
    <bpmn:task id="updateRecords" name="Update departmental records" />
    <bpmn:endEvent id="end" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="updateCalendars" />
    <bpmn:sequenceFlow id="f2" sourceRef="updateCalendars" targetRef="adviseMembers" />
    <bpmn:sequenceFlow id="f3" sourceRef="adviseMembers" targetRef="readDocuments" />
    <bpmn:sequenceFlow id="f4" sourceRef="readDocuments" targetRef="holdMeeting" />
    <bpmn:sequenceFlow id="f5" sourceRef="holdMeeting" targetRef="produceMinutes" />
    <bpmn:sequenceFlow id="f6" sourceRef="produceMinutes" targetRef="qaCheck" />
    <bpmn:sequenceFlow id="f7" sourceRef="qaCheck" targetRef="sendMinutes" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendMinutes" targetRef="updateRecords" />
    <bpmn:sequenceFlow id="f9" sourceRef="updateRecords" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
