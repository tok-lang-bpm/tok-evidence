tok 1.0 "Custom Bicycle Manufacturing"

pool company "Small Company"
  lane sales "Sales Department"
    start start-order "Order received"
    task receive-order "Receive order"
    xor decision-order "Order accepted?"
    and split "Parallel processing"
    end end-process "Process completed"
    flow start-order -> receive-order
    flow receive-order -> decision-order
    flow decision-order -> end-process "Reject" when="false"
    flow decision-order -> split "Accept" when="true"
    flow split -> check-part "Check part quantity"
    flow split -> prepare-assembly "Prepare assembly"
  lane storehouse "Storehouse"
    task check-part "Check part quantity"
    xor part-available "Part available?"
    task reserve-part "Reserve part"
    task backorder-part "Back-order part"
    task storehouse-done "Storehouse completed"
    flow check-part -> part-available
    flow part-available -> reserve-part "yes" when="true"
    flow part-available -> backorder-part "no" default
    flow reserve-part -> storehouse-done
    flow backorder-part -> storehouse-done
  lane engineering "Engineering Department"
    task prepare-assembly "Prepare assembly"
    task assemble "Assemble bicycle"
    task ship "Ship bicycle"
    and join "Join"
    flow prepare-assembly -> join
    flow storehouse-done -> join
    flow join -> assemble
    flow assemble -> ship
    flow ship -> end-process
