<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="evanstonian" name="The Evanstonian" processRef="evanstonian-process" />
  </bpmn:collaboration>
  <bpmn:process id="evanstonian-process" name="The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="evanstonian-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take_down_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_order_to_kitchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_order_to_sommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_order_to_waiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wine_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare_food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch_wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ready_cart_and_drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit_account</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Guest calls room service" />
    <bpmn:task id="take_down_order" name="Take down order" />
    <bpmn:task id="submit_order_to_kitchen" name="Submit order ticket to kitchen" />
    <bpmn:task id="give_order_to_sommelier" name="Give order to sommelier" />
    <bpmn:task id="assign_order_to_waiter" name="Assign order to waiter" />
    <bpmn:parallelGateway id="after_assign" name="Parallel split after assign" />
    <bpmn:exclusiveGateway id="wine_decision" name="Alcoholic beverage?" default="f-wine_decision-join_ready" />
    <bpmn:parallelGateway id="join_ready" name="Parallel join" />
    <bpmn:endEvent id="end_process" name="End" />
    <bpmn:task id="prepare_food" name="Prepare food" />
    <bpmn:task id="fetch_wine" name="Fetch wine and prepare alcoholic beverages" />
    <bpmn:task id="ready_cart_and_drinks" name="Ready cart and prepare nonalcoholic drinks" />
    <bpmn:task id="deliver_order" name="Deliver order to guest room" />
    <bpmn:task id="debit_account" name="Debit guest account" />
    <bpmn:sequenceFlow id="f-start-take_down_order" sourceRef="start" targetRef="take_down_order" />
    <bpmn:sequenceFlow id="f-take_down_order-submit_order_to_kitchen" sourceRef="take_down_order" targetRef="submit_order_to_kitchen" />
    <bpmn:sequenceFlow id="f-submit_order_to_kitchen-give_order_to_sommelier" sourceRef="submit_order_to_kitchen" targetRef="give_order_to_sommelier" />
    <bpmn:sequenceFlow id="f-give_order_to_sommelier-assign_order_to_waiter" sourceRef="give_order_to_sommelier" targetRef="assign_order_to_waiter" />
    <bpmn:sequenceFlow id="f-assign_order_to_waiter-after_assign" sourceRef="assign_order_to_waiter" targetRef="after_assign" />
    <bpmn:sequenceFlow id="f-after_assign-prepare_food" sourceRef="after_assign" targetRef="prepare_food" />
    <bpmn:sequenceFlow id="f-after_assign-ready_cart_and_drinks" sourceRef="after_assign" targetRef="ready_cart_and_drinks" />
    <bpmn:sequenceFlow id="f-after_assign-wine_decision" sourceRef="after_assign" targetRef="wine_decision" />
    <bpmn:sequenceFlow id="f-wine_decision-fetch_wine" sourceRef="wine_decision" targetRef="fetch_wine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">includes_alcoholic = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wine_decision-join_ready" sourceRef="wine_decision" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f-prepare_food-join_ready" sourceRef="prepare_food" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f-ready_cart_and_drinks-join_ready" sourceRef="ready_cart_and_drinks" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f-fetch_wine-join_ready" sourceRef="fetch_wine" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f-join_ready-deliver_order" sourceRef="join_ready" targetRef="deliver_order" />
    <bpmn:sequenceFlow id="f-deliver_order-debit_account" sourceRef="deliver_order" targetRef="debit_account" />
    <bpmn:sequenceFlow id="f-debit_account-end_process" sourceRef="debit_account" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
