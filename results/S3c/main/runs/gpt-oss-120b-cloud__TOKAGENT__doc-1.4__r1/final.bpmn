<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_underwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fair_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_fair</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>prepare_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_bluesky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>sec_clear</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Go public decision" />
    <bpmn:task id="select_underwriters" name="Select underwriters" />
    <bpmn:exclusiveGateway id="fair_check" name="Facts presented fairly?" />
    <bpmn:endEvent id="reject_fair" name="End (facts not fair)" />
    <bpmn:task id="prepare_reg" name="Prepare registration statement" />
    <bpmn:task id="check_bluesky" name="Check blue‑sky law compliance" />
    <bpmn:task id="submit_reg" name="Submit registration to SEC" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="roadshow" name="Arrange road show" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="fix_price" name="Fix issue price" />
    <bpmn:exclusiveGateway id="reason_check" name="Any reason not to proceed?" />
    <bpmn:endEvent id="reject_reason" name="End (reason found)" />
    <bpmn:task id="commit" name="Enter firm commitment to buy stock" />
    <bpmn:task id="offer" name="Offer issue to public" />
    <bpmn:endEvent id="success_end" name="Process completed" />
    <bpmn:task id="sec_clear" name="Receive SEC clearance" />
    <bpmn:sequenceFlow id="f-start-select_underwriters" sourceRef="start" targetRef="select_underwriters" />
    <bpmn:sequenceFlow id="f-select_underwriters-fair_check" sourceRef="select_underwriters" targetRef="fair_check" />
    <bpmn:sequenceFlow id="f-fair_check-prepare_reg" name="yes" sourceRef="fair_check" targetRef="prepare_reg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">factsFair = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fair_check-reject_fair" name="no" sourceRef="fair_check" targetRef="reject_fair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">factsFair = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-prepare_reg-check_bluesky" sourceRef="prepare_reg" targetRef="check_bluesky" />
    <bpmn:sequenceFlow id="f-check_bluesky-submit_reg" sourceRef="check_bluesky" targetRef="submit_reg" />
    <bpmn:sequenceFlow id="f-submit_reg-split" sourceRef="submit_reg" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-roadshow" sourceRef="split" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-split-sec_clear" sourceRef="split" targetRef="sec_clear" />
    <bpmn:sequenceFlow id="f-roadshow-join" sourceRef="roadshow" targetRef="join" />
    <bpmn:sequenceFlow id="f-sec_clear-join" sourceRef="sec_clear" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-fix_price" sourceRef="join" targetRef="fix_price" />
    <bpmn:sequenceFlow id="f-fix_price-reason_check" sourceRef="fix_price" targetRef="reason_check" />
    <bpmn:sequenceFlow id="f-reason_check-reject_reason" name="yes" sourceRef="reason_check" targetRef="reject_reason">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reason_check-commit" name="no" sourceRef="reason_check" targetRef="commit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-commit-offer" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-success_end" sourceRef="offer" targetRef="success_end" />
  </bpmn:process>
</bpmn:definitions>
