<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="fault_detector" name="Fault Detector">
        <bpmn:flowNodeRef>report-failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-suspicion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-examine-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-reject-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-confirm-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-fix-fault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-share-results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-inform-go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-inform-msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-inform-go-resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpo-inform-msp-resolution</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO" />
      <bpmn:lane id="msp" name="MSP" />
    </bpmn:laneSet>
    <bpmn:task id="report-failure" name="fault detector reports failure" />
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:exclusiveGateway id="start_decision" name="Fault reported or suspicion?" />
    <bpmn:exclusiveGateway id="exam_merge" name="Merge reports" />
    <bpmn:exclusiveGateway id="confirm_decision" name="Reject or confirm?" />
    <bpmn:parallelGateway id="split_initial" name="Initial parallel actions" />
    <bpmn:parallelGateway id="join_initial" name="Join initial actions" />
    <bpmn:parallelGateway id="split_resolution" name="Resolution informs" />
    <bpmn:parallelGateway id="join_resolution" name="Join resolution informs" />
    <bpmn:task id="mpo-suspicion" name="MPO has suspicion of own fault" />
    <bpmn:task id="mpo-examine-failure" name="MPO examine failure" />
    <bpmn:task id="mpo-reject-failure" name="MPO reject failure of fault detector" />
    <bpmn:task id="mpo-confirm-failure" name="MPO confirm failure of fault detector" />
    <bpmn:task id="mpo-fix-fault" name="MPO fix fault at measuring device" />
    <bpmn:task id="mpo-share-results" name="MPO share results of repairs with fault detector" />
    <bpmn:task id="mpo-inform-go" name="MPO inform GO" />
    <bpmn:task id="mpo-inform-msp" name="MPO inform MSP" />
    <bpmn:task id="mpo-inform-go-resolution" name="MPO inform GO about resolution of interference" />
    <bpmn:task id="mpo-inform-msp-resolution" name="MPO inform MSP about resolution of interference" />
    <bpmn:sequenceFlow id="f-s-start_decision" sourceRef="s" targetRef="start_decision" />
    <bpmn:sequenceFlow id="f-start_decision-report-failure" name="report" sourceRef="start_decision" targetRef="report-failure" />
    <bpmn:sequenceFlow id="f-start_decision-mpo-suspicion" name="suspicion" sourceRef="start_decision" targetRef="mpo-suspicion" />
    <bpmn:sequenceFlow id="f-report-failure-exam_merge" sourceRef="report-failure" targetRef="exam_merge" />
    <bpmn:sequenceFlow id="f-mpo-suspicion-exam_merge" sourceRef="mpo-suspicion" targetRef="exam_merge" />
    <bpmn:sequenceFlow id="f-exam_merge-mpo-examine-failure" sourceRef="exam_merge" targetRef="mpo-examine-failure" />
    <bpmn:sequenceFlow id="f-mpo-examine-failure-confirm_decision" sourceRef="mpo-examine-failure" targetRef="confirm_decision" />
    <bpmn:sequenceFlow id="f-confirm_decision-mpo-reject-failure" name="reject" sourceRef="confirm_decision" targetRef="mpo-reject-failure" />
    <bpmn:sequenceFlow id="f-confirm_decision-mpo-confirm-failure" name="confirm" sourceRef="confirm_decision" targetRef="mpo-confirm-failure" />
    <bpmn:sequenceFlow id="f-mpo-reject-failure-e" sourceRef="mpo-reject-failure" targetRef="e" />
    <bpmn:sequenceFlow id="f-mpo-confirm-failure-split_initial" sourceRef="mpo-confirm-failure" targetRef="split_initial" />
    <bpmn:sequenceFlow id="f-split_initial-mpo-inform-go" sourceRef="split_initial" targetRef="mpo-inform-go" />
    <bpmn:sequenceFlow id="f-split_initial-mpo-inform-msp" sourceRef="split_initial" targetRef="mpo-inform-msp" />
    <bpmn:sequenceFlow id="f-split_initial-mpo-fix-fault" sourceRef="split_initial" targetRef="mpo-fix-fault" />
    <bpmn:sequenceFlow id="f-mpo-inform-go-join_initial" sourceRef="mpo-inform-go" targetRef="join_initial" />
    <bpmn:sequenceFlow id="f-mpo-inform-msp-join_initial" sourceRef="mpo-inform-msp" targetRef="join_initial" />
    <bpmn:sequenceFlow id="f-mpo-fix-fault-join_initial" sourceRef="mpo-fix-fault" targetRef="join_initial" />
    <bpmn:sequenceFlow id="f-join_initial-mpo-share-results" sourceRef="join_initial" targetRef="mpo-share-results" />
    <bpmn:sequenceFlow id="f-mpo-share-results-split_resolution" sourceRef="mpo-share-results" targetRef="split_resolution" />
    <bpmn:sequenceFlow id="f-split_resolution-mpo-inform-go-resolution" sourceRef="split_resolution" targetRef="mpo-inform-go-resolution" />
    <bpmn:sequenceFlow id="f-split_resolution-mpo-inform-msp-resolution" sourceRef="split_resolution" targetRef="mpo-inform-msp-resolution" />
    <bpmn:sequenceFlow id="f-mpo-inform-go-resolution-join_resolution" sourceRef="mpo-inform-go-resolution" targetRef="join_resolution" />
    <bpmn:sequenceFlow id="f-mpo-inform-msp-resolution-join_resolution" sourceRef="mpo-inform-msp-resolution" targetRef="join_resolution" />
    <bpmn:sequenceFlow id="f-join_resolution-e" sourceRef="join_resolution" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
