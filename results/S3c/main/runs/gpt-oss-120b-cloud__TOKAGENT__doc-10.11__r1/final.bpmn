<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-measurements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-measured-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-changed-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-readings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check-received-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform-measurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-measured-values</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="request-measurements" name="request measurements" />
    <bpmn:task id="inform-failure" name="inform GO about failure of reading" />
    <bpmn:task id="process-measured-values" name="process measured values" />
    <bpmn:task id="send-changed-values" name="send changed values" />
    <bpmn:task id="transmit-readings" name="transmit readings" />
    <bpmn:endEvent id="end" />
    <bpmn:task id="check-received-request" name="check received request" />
    <bpmn:exclusiveGateway id="request-decision" name="perform measurement?" />
    <bpmn:task id="deny-request" name="deny request" />
    <bpmn:task id="perform-measurement" name="perform measurement" />
    <bpmn:task id="transmit-measured-values" name="transmit measured values" />
    <bpmn:sequenceFlow id="f-start-request-measurements" sourceRef="start" targetRef="request-measurements" />
    <bpmn:sequenceFlow id="f-request-measurements-check-received-request" sourceRef="request-measurements" targetRef="check-received-request" />
    <bpmn:sequenceFlow id="f-check-received-request-request-decision" sourceRef="check-received-request" targetRef="request-decision" />
    <bpmn:sequenceFlow id="f-request-decision-deny-request" name="deny" sourceRef="request-decision" targetRef="deny-request" />
    <bpmn:sequenceFlow id="f-request-decision-perform-measurement" name="perform" sourceRef="request-decision" targetRef="perform-measurement" />
    <bpmn:sequenceFlow id="f-deny-request-inform-failure" sourceRef="deny-request" targetRef="inform-failure" />
    <bpmn:sequenceFlow id="f-inform-failure-end" sourceRef="inform-failure" targetRef="end" />
    <bpmn:sequenceFlow id="f-perform-measurement-transmit-measured-values" sourceRef="perform-measurement" targetRef="transmit-measured-values" />
    <bpmn:sequenceFlow id="f-transmit-measured-values-process-measured-values" sourceRef="transmit-measured-values" targetRef="process-measured-values" />
    <bpmn:sequenceFlow id="f-process-measured-values-send-changed-values" sourceRef="process-measured-values" targetRef="send-changed-values" />
    <bpmn:sequenceFlow id="f-send-changed-values-transmit-readings" sourceRef="send-changed-values" targetRef="transmit-readings" />
    <bpmn:sequenceFlow id="f-transmit-readings-end" sourceRef="transmit-readings" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
