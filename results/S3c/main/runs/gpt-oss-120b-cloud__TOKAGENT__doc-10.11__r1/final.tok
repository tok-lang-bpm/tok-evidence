tok 1.0

pool org "Organisation"
  lane go "GO"
    start start
    task request-measurements "request measurements"
    task inform-failure "inform GO about failure of reading"
    task process-measured-values "process measured values"
    task send-changed-values "send changed values"
    task transmit-readings "transmit readings"
    end end
  lane msp "MSP"
    task check-received-request "check received request"
    xor request-decision "perform measurement?"
    task deny-request "deny request"
    task perform-measurement "perform measurement"
    task transmit-measured-values "transmit measured values"
  lane sp "SP"
    # no tasks

flow start -> request-measurements
flow request-measurements -> check-received-request
flow check-received-request -> request-decision
flow request-decision -> deny-request "deny"
flow request-decision -> perform-measurement "perform"
flow deny-request -> inform-failure
flow inform-failure -> end
flow perform-measurement -> transmit-measured-values
flow transmit-measured-values -> process-measured-values
flow process-measured-values -> send-changed-values
flow send-changed-values -> transmit-readings
flow transmit-readings -> end
