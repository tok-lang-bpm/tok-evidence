tok 1.0

pool org "Organisation" {
  lane go "GO"
  lane msp "MSP"
  lane sp "SP"
}

start start
task request-measurements go "request measurements"
task check-received-request msp "check received request"
xor request-decision "request decision"
task deny-request msp "deny request"
task inform-failure go "inform GO about failure of reading"
task perform-measurement msp "perform measurement"
task transmit-measured-values msp "transmit measured values"
task process-measured-values go "process measured values"
task send-changed-values go "send changed values"
task transmit-readings go "transmit readings"
end end

flow start -> request-measurements
flow request-measurements -> check-received-request
flow check-received-request -> request-decision
flow request-decision -> deny-request "deny"
flow request-decision -> perform-measurement "perform"
flow deny-request -> inform-failure
flow inform-failure -> end
flow perform-measurement -> transmit-measured-values
flow transmit-measured-values -> process-measured-values
flow process-measured-values -> send-changed-values
flow send-changed-values -> transmit-readings
flow transmit-readings -> end