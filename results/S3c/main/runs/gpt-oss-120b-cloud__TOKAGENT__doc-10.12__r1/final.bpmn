<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell-change</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>notify-ip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check-change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="tell-change" name="EC tells INQ about the change of his master data" />
    <bpmn:task id="notify-ip" name="INQ notifies IP of the change" />
    <bpmn:task id="check-change" name="IP checks whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="decision" name="Can master data be changed at desired time?" default="f-decision-reject" />
    <bpmn:task id="confirm" name="IP confirms the changes of INQ" />
    <bpmn:task id="reject" name="IP rejects the changes of INQ" />
    <bpmn:endEvent id="end-confirm" />
    <bpmn:endEvent id="end-reject" />
    <bpmn:sequenceFlow id="f-start-tell-change" sourceRef="start" targetRef="tell-change" />
    <bpmn:sequenceFlow id="f-tell-change-notify-ip" sourceRef="tell-change" targetRef="notify-ip" />
    <bpmn:sequenceFlow id="f-notify-ip-check-change" sourceRef="notify-ip" targetRef="check-change" />
    <bpmn:sequenceFlow id="f-check-change-decision" sourceRef="check-change" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="yes" sourceRef="decision" targetRef="confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-end-confirm" sourceRef="confirm" targetRef="end-confirm" />
    <bpmn:sequenceFlow id="f-reject-end-reject" sourceRef="reject" targetRef="end-reject" />
  </bpmn:process>
</bpmn:definitions>
