tok 1.0

pool org "Organisation"
  lane ec "EC"
    start start
    task tell-change "EC tells INQ about the change of his master data"
  lane inq "INQ"
    task notify-ip "INQ notifies IP of the change"
  lane ip "IP"
    task check-change "IP checks whether the master data can be changed at the desired time"
    xor decision "Can master data be changed at desired time?"
    task confirm "IP confirms the changes of INQ"
    task reject "IP rejects the changes of INQ"
    end end-confirm
    end end-reject

flow start -> tell-change
flow tell-change -> notify-ip
flow notify-ip -> check-change
flow check-change -> decision
flow decision -> confirm "yes" when="true"
flow decision -> reject "no" default
flow confirm -> end-confirm
flow reject -> end-reject
