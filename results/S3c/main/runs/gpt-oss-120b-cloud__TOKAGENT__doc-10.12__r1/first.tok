tok 1.0

pool org "Organisation" {
  lane ec "EC"
  lane inq "INQ"
  lane ip "IP"
}

start start

task tell-change "EC tells INQ about the change of his master data" ec

task notify-ip "INQ notifies IP of the change" inq

task check-change "IP checks whether the master data can be changed at the desired time" ip

gateway decision xor "Can master data be changed at desired time?" ip

task confirm "IP confirms the changes of INQ" ip

task reject "IP rejects the changes of INQ" ip

end end1
end end2

flow start -> tell-change
flow tell-change -> notify-ip
flow notify-ip -> check-change
flow check-change -> decision
flow decision -> confirm "yes" when="true"
flow decision -> reject "no" default
flow confirm -> end1
flow reject -> end2
