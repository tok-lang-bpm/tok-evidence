tok 1.0

pool org "Organization" {
  lane inq "INQ" {
    task transmit-request "INQ transmits the transaction data request"
  }
  lane ip "IP" {
    task check-request "IP checks the request of the INQ"
    task transmit-data "IP transmits data"
    task reject "IP rejects the request"
  }
}

start start
end end1
end end2

xor decision "Examination outcome"

flow start -> transmit-request
flow transmit-request -> check-request
flow check-request -> decision
flow decision -> transmit-data "Transmission of data" when="transmission"
flow decision -> reject "Rejection" default
flow transmit-data -> end1
flow reject -> end2
