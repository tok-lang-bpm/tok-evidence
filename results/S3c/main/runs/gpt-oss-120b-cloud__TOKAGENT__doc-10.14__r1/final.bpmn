<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="proc" name="Process">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>send-mpoo-temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-mpoo-eq-go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-mpoo-eq-mpon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>send-mspo-temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-mspo-add</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine-go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>examine-mpon</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="g1" name="Which bill is sent?" />
    <bpmn:exclusiveGateway id="g2" name="Confirm invoice?" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="send-mpoo-temp" name="MPOO sends the bill for the temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="send-mpoo-eq-go" name="MPOO sends the bill for equipment acquisition to the GO" />
    <bpmn:task id="send-mpoo-eq-mpon" name="MPOO sends the bill for equipment acquisition to the MPON" />
    <bpmn:task id="send-mspo-temp" name="MSPO sends the bill for the temporary continuation of the measurement to the GO" />
    <bpmn:task id="send-mspo-add" name="MSPO sends the bill for additional readings to the GO" />
    <bpmn:task id="examine-go" name="GO examines the bill" />
    <bpmn:task id="confirm" name="GO confirms the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject" name="GO rejects the invoice of the MPOO or the MSPO" />
    <bpmn:task id="examine-mpon" name="MPON examines the bill" />
    <bpmn:sequenceFlow id="f-s-g1" sourceRef="s" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-send-mpoo-temp" name="MPOO temp continuation" sourceRef="g1" targetRef="send-mpoo-temp" />
    <bpmn:sequenceFlow id="f-g1-send-mspo-temp" name="MSPO temp continuation" sourceRef="g1" targetRef="send-mspo-temp" />
    <bpmn:sequenceFlow id="f-g1-send-mspo-add" name="MSPO additional readings" sourceRef="g1" targetRef="send-mspo-add" />
    <bpmn:sequenceFlow id="f-g1-send-mpoo-eq-go" name="MPOO equipment acquisition GO" sourceRef="g1" targetRef="send-mpoo-eq-go" />
    <bpmn:sequenceFlow id="f-g1-send-mpoo-eq-mpon" name="MPOO equipment acquisition MPON" sourceRef="g1" targetRef="send-mpoo-eq-mpon" />
    <bpmn:sequenceFlow id="f-send-mpoo-temp-examine-go" sourceRef="send-mpoo-temp" targetRef="examine-go" />
    <bpmn:sequenceFlow id="f-send-mspo-temp-examine-go" sourceRef="send-mspo-temp" targetRef="examine-go" />
    <bpmn:sequenceFlow id="f-send-mspo-add-examine-go" sourceRef="send-mspo-add" targetRef="examine-go" />
    <bpmn:sequenceFlow id="f-send-mpoo-eq-go-examine-go" sourceRef="send-mpoo-eq-go" targetRef="examine-go" />
    <bpmn:sequenceFlow id="f-send-mpoo-eq-mpon-examine-mpon" sourceRef="send-mpoo-eq-mpon" targetRef="examine-mpon" />
    <bpmn:sequenceFlow id="f-examine-go-g2" sourceRef="examine-go" targetRef="g2" />
    <bpmn:sequenceFlow id="f-examine-mpon-g2" sourceRef="examine-mpon" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-confirm" name="confirm" sourceRef="g2" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-g2-reject" name="reject" sourceRef="g2" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-e" sourceRef="confirm" targetRef="e" />
    <bpmn:sequenceFlow id="f-reject-e" sourceRef="reject" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
