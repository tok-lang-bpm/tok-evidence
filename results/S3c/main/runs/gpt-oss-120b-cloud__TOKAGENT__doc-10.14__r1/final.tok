tok 1.0
pool org "Organisation"
  lane proc "Process"
    start s "Start"
    xor g1 "Which bill is sent?"
    xor g2 "Confirm invoice?"
    end e "End"
  lane mpoo "MPOO"
    task send-mpoo-temp "MPOO sends the bill for the temporary continuation of the metering point operations to the GO"
    task send-mpoo-eq-go "MPOO sends the bill for equipment acquisition to the GO"
    task send-mpoo-eq-mpon "MPOO sends the bill for equipment acquisition to the MPON"
  lane mspo "MSPO"
    task send-mspo-temp "MSPO sends the bill for the temporary continuation of the measurement to the GO"
    task send-mspo-add "MSPO sends the bill for additional readings to the GO"
  lane go "GO"
    task examine-go "GO examines the bill"
    task confirm "GO confirms the invoice with payment advice to the MPOO or the MSPO"
    task reject "GO rejects the invoice of the MPOO or the MSPO"
  lane mpon "MPON"
    task examine-mpon "MPON examines the bill"
flow s -> g1
flow g1 -> send-mpoo-temp "MPOO temp continuation"
flow g1 -> send-mspo-temp "MSPO temp continuation"
flow g1 -> send-mspo-add "MSPO additional readings"
flow g1 -> send-mpoo-eq-go "MPOO equipment acquisition GO"
flow g1 -> send-mpoo-eq-mpon "MPOO equipment acquisition MPON"
flow send-mpoo-temp -> examine-go
flow send-mspo-temp -> examine-go
flow send-mspo-add -> examine-go
flow send-mpoo-eq-go -> examine-go
flow send-mpoo-eq-mpon -> examine-mpon
flow examine-go -> g2
flow examine-mpon -> g2
flow g2 -> confirm "confirm"
flow g2 -> reject "reject"
flow confirm -> e
flow reject -> e
