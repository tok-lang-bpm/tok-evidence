<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send-dismissal" name="MPON sends dismissal to MPOO" />
    <bpmn:task id="review-dismissal" name="MPOO reviews dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal decision?" />
    <bpmn:task id="oppose-dismissal" name="MPOO opposes dismissal" />
    <bpmn:task id="confirm-dismissal" name="MPOO confirms dismissal" />
    <bpmn:endEvent id="end-oppose" name="Dismissal Opposed" />
    <bpmn:endEvent id="end-confirm" name="Dismissal Confirmed" />
    <bpmn:sequenceFlow id="f-start-send-dismissal" sourceRef="start" targetRef="send-dismissal" />
    <bpmn:sequenceFlow id="f-send-dismissal-review-dismissal" sourceRef="send-dismissal" targetRef="review-dismissal" />
    <bpmn:sequenceFlow id="f-review-dismissal-decision" sourceRef="review-dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-oppose-dismissal" name="oppose" sourceRef="decision" targetRef="oppose-dismissal" />
    <bpmn:sequenceFlow id="f-decision-confirm-dismissal" name="confirm" sourceRef="decision" targetRef="confirm-dismissal" />
    <bpmn:sequenceFlow id="f-oppose-dismissal-end-oppose" sourceRef="oppose-dismissal" targetRef="end-oppose" />
    <bpmn:sequenceFlow id="f-confirm-dismissal-end-confirm" sourceRef="confirm-dismissal" targetRef="end-confirm" />
  </bpmn:process>
</bpmn:definitions>
