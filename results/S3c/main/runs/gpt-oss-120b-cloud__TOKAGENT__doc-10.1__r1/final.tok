tok 1.0

pool org "Organisation"
  lane mpon "MPON"
    start start "Start"
    task send-dismissal "MPON sends dismissal to MPOO"
  lane mpoo "MPOO"
    task review-dismissal "MPOO reviews dismissal"
    xor decision "Dismissal decision?"
    task oppose-dismissal "MPOO opposes dismissal"
    task confirm-dismissal "MPOO confirms dismissal"
    end end-oppose "Dismissal Opposed"
    end end-confirm "Dismissal Confirmed"

flow start -> send-dismissal -> review-dismissal -> decision
flow decision -> oppose-dismissal "oppose"
flow decision -> confirm-dismissal "confirm"
flow oppose-dismissal -> end-oppose
flow confirm-dismissal -> end-confirm
