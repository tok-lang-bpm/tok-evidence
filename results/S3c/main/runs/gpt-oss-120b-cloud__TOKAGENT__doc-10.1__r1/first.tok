tok 1.0

pool org "Organisation" {
  lane mpon "MPON"
  lane mpoo "MPOO"
}

start start in mpon "Start"

task send-dismissal in mpon "MPON sends dismissal to MPOO"

task review-dismissal in mpoo "MPOO reviews dismissal"

xor decision in mpoo "Dismissal decision"

task oppose-dismissal in mpoo "MPOO opposes dismissal"

task confirm-dismissal in mpoo "MPOO confirms dismissal"

end end-oppose in mpoo "Dismissal Opposed"
end end-confirm in mpoo "Dismissal Confirmed"

flow start -> send-dismissal
flow send-dismissal -> review-dismissal
flow review-dismissal -> decision
flow decision -> oppose-dismissal "oppose"
flow decision -> confirm-dismissal "confirm"
flow oppose-dismissal -> end-oppose
flow confirm-dismissal -> end-confirm
