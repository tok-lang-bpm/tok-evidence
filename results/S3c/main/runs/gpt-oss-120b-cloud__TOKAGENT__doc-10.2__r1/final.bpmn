<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>report_meter_operation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_acquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eq_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eq_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fail_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fail_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_mp_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpontimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout_boundary</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>equip_acquisition_mpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO" />
      <bpmn:lane id="SP" name="SP" />
    </bpmn:laneSet>
    <bpmn:task id="report_meter_operation" name="reports the meter operation" />
    <bpmn:task id="equip_acquisition" name="performs equipment acquisition and/or equipment changes" />
    <bpmn:task id="inform_failure" name="informs GO about failure of the entire process" />
    <bpmn:task id="inform_success" name="informs GO about successful completion of the entire process" />
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:endEvent id="end_reject" name="End (Rejected)" />
    <bpmn:endEvent id="end_failure" name="End (Failure)" />
    <bpmn:endEvent id="end_success" name="End (Success)" />
    <bpmn:endEvent id="end_timeout" name="End (Timeout)" />
    <bpmn:exclusiveGateway id="gw_examine" name="Application approved?" />
    <bpmn:exclusiveGateway id="gw_message" name="Process outcome?" />
    <bpmn:parallelGateway id="inform_split" name="Registration inform split" />
    <bpmn:parallelGateway id="inform_join" name="Registration inform join" />
    <bpmn:parallelGateway id="eq_split" name="Equipment acquisition split" />
    <bpmn:parallelGateway id="eq_join" name="Equipment acquisition join" />
    <bpmn:parallelGateway id="fail_split" name="Failure inform split" />
    <bpmn:parallelGateway id="fail_join" name="Failure inform join" />
    <bpmn:parallelGateway id="success_split" name="Success inform split" />
    <bpmn:parallelGateway id="success_join" name="Success inform join" />
    <bpmn:task id="examine_application" name="examines the application" />
    <bpmn:task id="reject_application" name="rejects the application" />
    <bpmn:task id="confirm_application" name="confirms the application" />
    <bpmn:task id="inform_mpoo_reg" name="informs MPOO about registration confirmation" />
    <bpmn:task id="inform_mspo_reg" name="informs MSPO about registration confirmation" />
    <bpmn:task id="await_mp_message" name="await MPON message" />
    <bpmn:task id="inform_mpontimeout" name="informs MPON about failure of the overall transaction" />
    <bpmn:task id="confirm_failure_assignment" name="confirms failure of the assignment to MPON" />
    <bpmn:task id="assign_mp" name="assigns MPON" />
    <bpmn:task id="confirm_assignment" name="confirms assignment to MPON" />
    <bpmn:task id="inform_mpoo_failure" name="informs MPOO about failure of the assignment" />
    <bpmn:task id="inform_mspo_failure" name="informs MSPO about failure of the assignment" />
    <bpmn:task id="inform_mpoo_assignment" name="informs MPOO about assignment" />
    <bpmn:task id="inform_mspo_assignment" name="informs MSPO about assignment" />
    <bpmn:task id="inform_sp_assignment" name="informs SP about assignment" />
    <bpmn:boundaryEvent id="timeout_boundary" attachedToRef="await_mp_message">
      <bpmn:timerEventDefinition id="timeout_boundary-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="equip_acquisition_mpoo" name="performs equipment acquisition and/or equipment changes" />
    <bpmn:sequenceFlow id="f-start-report_meter_operation" name="" sourceRef="start" targetRef="report_meter_operation" />
    <bpmn:sequenceFlow id="f-report_meter_operation-examine_application" name="" sourceRef="report_meter_operation" targetRef="examine_application" />
    <bpmn:sequenceFlow id="f-examine_application-gw_examine" name="" sourceRef="examine_application" targetRef="gw_examine" />
    <bpmn:sequenceFlow id="f-gw_examine-reject_application" name="reject" sourceRef="gw_examine" targetRef="reject_application" />
    <bpmn:sequenceFlow id="f-reject_application-end_reject" name="" sourceRef="reject_application" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-gw_examine-confirm_application" name="confirm" sourceRef="gw_examine" targetRef="confirm_application" />
    <bpmn:sequenceFlow id="f-confirm_application-inform_split" name="" sourceRef="confirm_application" targetRef="inform_split" />
    <bpmn:sequenceFlow id="f-inform_split-inform_mpoo_reg" name="" sourceRef="inform_split" targetRef="inform_mpoo_reg" />
    <bpmn:sequenceFlow id="f-inform_split-inform_mspo_reg" name="" sourceRef="inform_split" targetRef="inform_mspo_reg" />
    <bpmn:sequenceFlow id="f-inform_mpoo_reg-inform_join" name="" sourceRef="inform_mpoo_reg" targetRef="inform_join" />
    <bpmn:sequenceFlow id="f-inform_mspo_reg-inform_join" name="" sourceRef="inform_mspo_reg" targetRef="inform_join" />
    <bpmn:sequenceFlow id="f-inform_join-eq_split" name="" sourceRef="inform_join" targetRef="eq_split" />
    <bpmn:sequenceFlow id="f-eq_split-equip_acquisition" name="" sourceRef="eq_split" targetRef="equip_acquisition" />
    <bpmn:sequenceFlow id="f-eq_split-equip_acquisition_mpoo" name="" sourceRef="eq_split" targetRef="equip_acquisition_mpoo" />
    <bpmn:sequenceFlow id="f-equip_acquisition-eq_join" name="" sourceRef="equip_acquisition" targetRef="eq_join" />
    <bpmn:sequenceFlow id="f-equip_acquisition_mpoo-eq_join" name="" sourceRef="equip_acquisition_mpoo" targetRef="eq_join" />
    <bpmn:sequenceFlow id="f-eq_join-await_mp_message" name="" sourceRef="eq_join" targetRef="await_mp_message" />
    <bpmn:sequenceFlow id="f-await_mp_message-gw_message" name="" sourceRef="await_mp_message" targetRef="gw_message" />
    <bpmn:sequenceFlow id="f-timeout_boundary-inform_mpontimeout" name="" sourceRef="timeout_boundary" targetRef="inform_mpontimeout" />
    <bpmn:sequenceFlow id="f-inform_mpontimeout-end_timeout" name="" sourceRef="inform_mpontimeout" targetRef="end_timeout" />
    <bpmn:sequenceFlow id="f-gw_message-inform_failure" name="failure" sourceRef="gw_message" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="f-gw_message-inform_success" name="success" sourceRef="gw_message" targetRef="inform_success" />
    <bpmn:sequenceFlow id="f-inform_failure-confirm_failure_assignment" name="" sourceRef="inform_failure" targetRef="confirm_failure_assignment" />
    <bpmn:sequenceFlow id="f-confirm_failure_assignment-fail_split" name="" sourceRef="confirm_failure_assignment" targetRef="fail_split" />
    <bpmn:sequenceFlow id="f-fail_split-inform_mpoo_failure" name="" sourceRef="fail_split" targetRef="inform_mpoo_failure" />
    <bpmn:sequenceFlow id="f-fail_split-inform_mspo_failure" name="" sourceRef="fail_split" targetRef="inform_mspo_failure" />
    <bpmn:sequenceFlow id="f-inform_mpoo_failure-fail_join" name="" sourceRef="inform_mpoo_failure" targetRef="fail_join" />
    <bpmn:sequenceFlow id="f-inform_mspo_failure-fail_join" name="" sourceRef="inform_mspo_failure" targetRef="fail_join" />
    <bpmn:sequenceFlow id="f-fail_join-end_failure" name="" sourceRef="fail_join" targetRef="end_failure" />
    <bpmn:sequenceFlow id="f-inform_success-assign_mp" name="" sourceRef="inform_success" targetRef="assign_mp" />
    <bpmn:sequenceFlow id="f-assign_mp-confirm_assignment" name="" sourceRef="assign_mp" targetRef="confirm_assignment" />
    <bpmn:sequenceFlow id="f-confirm_assignment-success_split" name="" sourceRef="confirm_assignment" targetRef="success_split" />
    <bpmn:sequenceFlow id="f-success_split-inform_mpoo_assignment" name="" sourceRef="success_split" targetRef="inform_mpoo_assignment" />
    <bpmn:sequenceFlow id="f-success_split-inform_mspo_assignment" name="" sourceRef="success_split" targetRef="inform_mspo_assignment" />
    <bpmn:sequenceFlow id="f-success_split-inform_sp_assignment" name="" sourceRef="success_split" targetRef="inform_sp_assignment" />
    <bpmn:sequenceFlow id="f-inform_mpoo_assignment-success_join" name="" sourceRef="inform_mpoo_assignment" targetRef="success_join" />
    <bpmn:sequenceFlow id="f-inform_mspo_assignment-success_join" name="" sourceRef="inform_mspo_assignment" targetRef="success_join" />
    <bpmn:sequenceFlow id="f-inform_sp_assignment-success_join" name="" sourceRef="inform_sp_assignment" targetRef="success_join" />
    <bpmn:sequenceFlow id="f-success_join-end_success" name="" sourceRef="success_join" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>
