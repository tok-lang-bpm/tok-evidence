tok 1.0

pool org "Organization" {
  lane MPON "MPON" {
    task report_meter_operation "reports the meter operation"
    task equip_acquisition "performs equipment acquisition and/or equipment changes"
    task inform_failure "informs GO about failure of the entire process"
    task inform_success "informs GO about successful completion of the entire process"
  }
  lane GO "GO" {
    task examine_application "examines the application"
    task reject_application "rejects the application"
    task confirm_application "confirms the application"
    task inform_mpoo_reg "informs MPOO about registration confirmation"
    task inform_mspo_reg "informs MSPO about registration confirmation"
    task await_mp_message "await MPON message"
    task inform_mpontimeout "informs MPON about failure of the overall transaction"
    task confirm_failure_assignment "confirms failure of the assignment to MPON"
    task assign_mp "assigns MPON"
    task confirm_assignment "confirms assignment to MPON"
    task inform_mpoo_failure "informs MPOO about failure of the assignment"
    task inform_mspo_failure "informs MSPO about failure of the assignment"
    task inform_mpoo_assignment "informs MPOO about assignment"
    task inform_mspo_assignment "informs MSPO about assignment"
    task inform_sp_assignment "informs SP about assignment"
  }
  lane MPOO "MPOO" {
    task equip_acquisition_mpoo "performs equipment acquisition and/or equipment changes"
  }
  lane MSPO "MSPO" {}
  lane SP "SP" {}
}

start start "Start"
end end_reject "End (Rejected)"
end end_failure "End (Failure)"
end end_success "End (Success)"
end end_timeout "End (Timeout)"

xor gw_examine "Application approved?"

xor gw_message "Process outcome?"

and gw_equip "Equipment acquisition"

and gw_inform_assign "Inform assignment"

flow start -> report_meter_operation ""
flow report_meter_operation -> examine_application ""
flow examine_application -> gw_examine ""
flow gw_examine -> reject_application "reject"
flow reject_application -> end_reject ""
flow gw_examine -> confirm_application "confirm"
flow confirm_application -> inform_mpoo_reg ""
flow confirm_application -> inform_mspo_reg ""
flow inform_mpoo_reg -> gw_equip ""
flow inform_mspo_reg -> gw_equip ""
flow gw_equip -> equip_acquisition ""
flow gw_equip -> equip_acquisition_mpoo ""
flow equip_acquisition -> await_mp_message ""
flow equip_acquisition_mpoo -> await_mp_message ""
flow await_mp_message -> gw_message ""
boundary timeout_boundary on=await_mp_message timer=P3D
flow timeout_boundary -> inform_mpontimeout ""
flow inform_mpontimeout -> end_timeout ""
flow gw_message -> inform_failure "failure"
flow inform_failure -> confirm_failure_assignment ""
flow confirm_failure_assignment -> gw_inform_assign ""
flow gw_inform_assign -> inform_mpoo_failure ""
flow gw_inform_assign -> inform_mspo_failure ""
flow inform_mpoo_failure -> end_failure ""
flow inform_mspo_failure -> end_failure ""
flow gw_message -> inform_success "success"
flow inform_success -> assign_mp ""
flow assign_mp -> confirm_assignment ""
flow confirm_assignment -> gw_inform_assign ""
flow gw_inform_assign -> inform_mpoo_assignment ""
flow gw_inform_assign -> inform_mspo_assignment ""
flow gw_inform_assign -> inform_sp_assignment ""
flow inform_mpoo_assignment -> end_success ""
flow inform_mspo_assignment -> end_success ""
flow inform_sp_assignment -> end_success ""
