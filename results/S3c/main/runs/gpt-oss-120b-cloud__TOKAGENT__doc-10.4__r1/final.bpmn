<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>start0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfDismountChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfDismountJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalReadingChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final-reading-MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalReadingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount-old-MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount-new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read-meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell-go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>announce-self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-no-self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final-reading-MPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount-old-MPOO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>notify-msp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSP" name="MSP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start0" name="Start" />
    <bpmn:task id="notify-intent" name="notify MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="selfDismountChoice" />
    <bpmn:exclusiveGateway id="selfDismountJoin" />
    <bpmn:exclusiveGateway id="finalReadingChoice" />
    <bpmn:task id="final-reading-MPON" name="perform final reading" />
    <bpmn:exclusiveGateway id="finalReadingJoin" />
    <bpmn:exclusiveGateway id="dismountChoice" />
    <bpmn:task id="dismount-old-MPON" name="dismount old equipment" />
    <bpmn:exclusiveGateway id="dismountJoin" />
    <bpmn:task id="mount-new" name="mount new device" />
    <bpmn:task id="read-meter" name="read meter count from installed meter" />
    <bpmn:task id="send-values" name="send values of the final reading to GO" />
    <bpmn:task id="tell-go" name="tell GO about device changes, master data and meter count at installation" />
    <bpmn:endEvent id="end0" name="End" />
    <bpmn:task id="announce-self" name="announce self dismounting to MPON" />
    <bpmn:task id="notify-no-self" name="notify MPON about no self-dismounting of the MPOO" />
    <bpmn:task id="final-reading-MPOO" name="perform final reading" />
    <bpmn:task id="dismount-old-MPOO" name="dismount old equipment" />
    <bpmn:task id="notify-msp" name="notify MSP about device changes, master data, meter count at dismounting and meter count at installation" />
    <bpmn:sequenceFlow id="f-start0-notify-intent" sourceRef="start0" targetRef="notify-intent" />
    <bpmn:sequenceFlow id="f-notify-intent-selfDismountChoice" sourceRef="notify-intent" targetRef="selfDismountChoice" />
    <bpmn:sequenceFlow id="f-selfDismountChoice-announce-self" name="self dismounting" sourceRef="selfDismountChoice" targetRef="announce-self">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-selfDismountChoice-notify-no-self" name="no self dismounting" sourceRef="selfDismountChoice" targetRef="notify-no-self">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-announce-self-selfDismountJoin" sourceRef="announce-self" targetRef="selfDismountJoin" />
    <bpmn:sequenceFlow id="f-notify-no-self-selfDismountJoin" sourceRef="notify-no-self" targetRef="selfDismountJoin" />
    <bpmn:sequenceFlow id="f-selfDismountJoin-finalReadingChoice" sourceRef="selfDismountJoin" targetRef="finalReadingChoice" />
    <bpmn:sequenceFlow id="f-finalReadingChoice-final-reading-MPON" name="MPON" sourceRef="finalReadingChoice" targetRef="final-reading-MPON">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-finalReadingChoice-final-reading-MPOO" name="MPOO" sourceRef="finalReadingChoice" targetRef="final-reading-MPOO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-final-reading-MPON-finalReadingJoin" sourceRef="final-reading-MPON" targetRef="finalReadingJoin" />
    <bpmn:sequenceFlow id="f-final-reading-MPOO-finalReadingJoin" sourceRef="final-reading-MPOO" targetRef="finalReadingJoin" />
    <bpmn:sequenceFlow id="f-finalReadingJoin-dismountChoice" sourceRef="finalReadingJoin" targetRef="dismountChoice" />
    <bpmn:sequenceFlow id="f-dismountChoice-dismount-old-MPON" name="MPON" sourceRef="dismountChoice" targetRef="dismount-old-MPON">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-dismountChoice-dismount-old-MPOO" name="MPOO" sourceRef="dismountChoice" targetRef="dismount-old-MPOO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-dismount-old-MPON-dismountJoin" sourceRef="dismount-old-MPON" targetRef="dismountJoin" />
    <bpmn:sequenceFlow id="f-dismount-old-MPOO-dismountJoin" sourceRef="dismount-old-MPOO" targetRef="dismountJoin" />
    <bpmn:sequenceFlow id="f-dismountJoin-mount-new" sourceRef="dismountJoin" targetRef="mount-new" />
    <bpmn:sequenceFlow id="f-mount-new-read-meter" sourceRef="mount-new" targetRef="read-meter" />
    <bpmn:sequenceFlow id="f-read-meter-send-values" sourceRef="read-meter" targetRef="send-values" />
    <bpmn:sequenceFlow id="f-send-values-tell-go" sourceRef="send-values" targetRef="tell-go" />
    <bpmn:sequenceFlow id="f-tell-go-notify-msp" sourceRef="tell-go" targetRef="notify-msp" />
    <bpmn:sequenceFlow id="f-notify-msp-end0" sourceRef="notify-msp" targetRef="end0" />
  </bpmn:process>
</bpmn:definitions>
