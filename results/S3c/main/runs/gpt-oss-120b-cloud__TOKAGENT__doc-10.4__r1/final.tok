tok 1.0

pool org "Organisation"
  lane MPON "MPON"
    start start0 "Start"
    task notify-intent "notify MPOO about equipment change intentions"
    xor selfDismountChoice
    xor selfDismountJoin
    xor finalReadingChoice
    task final-reading-MPON "perform final reading"
    xor finalReadingJoin
    xor dismountChoice
    task dismount-old-MPON "dismount old equipment"
    xor dismountJoin
    task mount-new "mount new device"
    task read-meter "read meter count from installed meter"
    task send-values "send values of the final reading to GO"
    task tell-go "tell GO about device changes, master data and meter count at installation"
    end end0 "End"
  lane MPOO "MPOO"
    task announce-self "announce self dismounting to MPON"
    task notify-no-self "notify MPON about no self-dismounting of the MPOO"
    task final-reading-MPOO "perform final reading"
    task dismount-old-MPOO "dismount old equipment"
  lane GO "GO"
    task notify-msp "notify MSP about device changes, master data, meter count at dismounting and meter count at installation"
  lane MSP "MSP"
    # no tasks needed in this lane

flow start0 -> notify-intent
flow notify-intent -> selfDismountChoice
flow selfDismountChoice -> announce-self "self dismounting" when="true"
flow selfDismountChoice -> notify-no-self "no self dismounting" when="false"
flow announce-self -> selfDismountJoin
flow notify-no-self -> selfDismountJoin
flow selfDismountJoin -> finalReadingChoice
flow finalReadingChoice -> final-reading-MPON "MPON" when="true"
flow finalReadingChoice -> final-reading-MPOO "MPOO" when="false"
flow final-reading-MPON -> finalReadingJoin
flow final-reading-MPOO -> finalReadingJoin
flow finalReadingJoin -> dismountChoice
flow dismountChoice -> dismount-old-MPON "MPON" when="true"
flow dismountChoice -> dismount-old-MPOO "MPOO" when="false"
flow dismount-old-MPON -> dismountJoin
flow dismount-old-MPOO -> dismountJoin
flow dismountJoin -> mount-new
flow mount-new -> read-meter
flow read-meter -> send-values
flow send-values -> tell-go
flow tell-go -> notify-msp
flow notify-msp -> end0
