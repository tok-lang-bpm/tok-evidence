<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-bid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>send-tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="request-bid" name="requests a device takeover bid of the MPOO" />
    <bpmn:task id="place-order" name="places an order at the MPOO" />
    <bpmn:task id="send-tender" name="sends a tender for the equipment takeover" />
    <bpmn:task id="confirm-order" name="confirms the order of the MPON and sends the master data" />
    <bpmn:endEvent id="e" />
    <bpmn:sequenceFlow id="f-s-request-bid" sourceRef="s" targetRef="request-bid" />
    <bpmn:sequenceFlow id="f-request-bid-send-tender" sourceRef="request-bid" targetRef="send-tender" />
    <bpmn:sequenceFlow id="f-send-tender-place-order" sourceRef="send-tender" targetRef="place-order" />
    <bpmn:sequenceFlow id="f-place-order-confirm-order" sourceRef="place-order" targetRef="confirm-order" />
    <bpmn:sequenceFlow id="f-confirm-order-e" sourceRef="confirm-order" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
