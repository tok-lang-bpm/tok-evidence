tok 1.0

pool org "Organization"
  lane MPON "MPON"
    start s
    task request-bid "requests a device takeover bid of the MPOO"
    task place-order "places an order at the MPOO"
  lane MPOO "MPOO"
    task send-tender "sends a tender for the equipment takeover"
    task confirm-order "confirms the order of the MPON and sends the master data"
    end e

flow s -> request-bid -> send-tender -> place-order -> confirm-order -> e
