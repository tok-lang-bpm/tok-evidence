<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send-dismissal" name="send dismissal" />
    <bpmn:task id="review-dismissal" name="review dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal rejected?" />
    <bpmn:task id="reject-dismissal" name="reject dismissal" />
    <bpmn:task id="confirm-dismissal" name="confirm dismissal" />
    <bpmn:endEvent id="end-reject" name="End" />
    <bpmn:endEvent id="end-confirm" name="End" />
    <bpmn:sequenceFlow id="f-start-send-dismissal" sourceRef="start" targetRef="send-dismissal" />
    <bpmn:sequenceFlow id="f-send-dismissal-review-dismissal" sourceRef="send-dismissal" targetRef="review-dismissal" />
    <bpmn:sequenceFlow id="f-review-dismissal-decision" sourceRef="review-dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject-dismissal" name="reject" sourceRef="decision" targetRef="reject-dismissal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-confirm-dismissal" name="confirm" sourceRef="decision" targetRef="confirm-dismissal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reject-dismissal-end-reject" sourceRef="reject-dismissal" targetRef="end-reject" />
    <bpmn:sequenceFlow id="f-confirm-dismissal-end-confirm" sourceRef="confirm-dismissal" targetRef="end-confirm" />
  </bpmn:process>
</bpmn:definitions>
