tok 1.0
pool org "Organisation"
  lane mspn "MSPN"
    start start "Start"
    task send-dismissal "send dismissal"
  lane mspo "MSPO"
    task review-dismissal "review dismissal"
    xor decision "Dismissal rejected?"
    task reject-dismissal "reject dismissal"
    task confirm-dismissal "confirm dismissal"
    end end-reject "End"
    end end-confirm "End"
flow start -> send-dismissal
flow send-dismissal -> review-dismissal
flow review-dismissal -> decision
flow decision -> reject-dismissal "reject" when="rejected"
flow decision -> confirm-dismissal "confirm" when="confirmed"
flow reject-dismissal -> end-reject
flow confirm-dismissal -> end-confirm
