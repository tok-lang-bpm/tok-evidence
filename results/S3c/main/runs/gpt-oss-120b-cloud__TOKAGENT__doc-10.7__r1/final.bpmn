<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="MSPN Assignment Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN Assignment Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_measurement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_mspn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="register_measurement" name="The MSPN registers the measurement at the GO" />
    <bpmn:task id="examine_application" name="The GO examines the application of the MSPN" />
    <bpmn:exclusiveGateway id="decision_approve" name="Application approved?" default="f-decision_approve-reject_application" />
    <bpmn:task id="reject_application" name="The GO rejects the application of the MSPN" />
    <bpmn:task id="assign_mspn" name="The GO assigns the MSPN" />
    <bpmn:parallelGateway id="parallel_inform" name="Inform parties" />
    <bpmn:task id="inform_mspo" name="The GO informs the MSPO about the assignment of MSPN" />
    <bpmn:task id="inform_mpo" name="The GO informs the MPO about the assignment of the MSPN" />
    <bpmn:task id="inform_sp" name="The GO informs the SP about the assignment of MSPN" />
    <bpmn:parallelGateway id="join_inform" name="Join informs" />
    <bpmn:endEvent id="end_success" name="End" />
    <bpmn:endEvent id="end_reject" name="End" />
    <bpmn:sequenceFlow id="f-start1-register_measurement" sourceRef="start1" targetRef="register_measurement" />
    <bpmn:sequenceFlow id="f-register_measurement-examine_application" sourceRef="register_measurement" targetRef="examine_application" />
    <bpmn:sequenceFlow id="f-examine_application-decision_approve" sourceRef="examine_application" targetRef="decision_approve" />
    <bpmn:sequenceFlow id="f-decision_approve-reject_application" name="reject" sourceRef="decision_approve" targetRef="reject_application" />
    <bpmn:sequenceFlow id="f-decision_approve-assign_mspn" name="confirm" sourceRef="decision_approve" targetRef="assign_mspn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-assign_mspn-parallel_inform" sourceRef="assign_mspn" targetRef="parallel_inform" />
    <bpmn:sequenceFlow id="f-parallel_inform-inform_mspo" sourceRef="parallel_inform" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-parallel_inform-inform_mpo" sourceRef="parallel_inform" targetRef="inform_mpo" />
    <bpmn:sequenceFlow id="f-parallel_inform-inform_sp" sourceRef="parallel_inform" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_mspo-join_inform" sourceRef="inform_mspo" targetRef="join_inform" />
    <bpmn:sequenceFlow id="f-inform_mpo-join_inform" sourceRef="inform_mpo" targetRef="join_inform" />
    <bpmn:sequenceFlow id="f-inform_sp-join_inform" sourceRef="inform_sp" targetRef="join_inform" />
    <bpmn:sequenceFlow id="f-join_inform-end_success" sourceRef="join_inform" targetRef="end_success" />
    <bpmn:sequenceFlow id="f-reject_application-end_reject" sourceRef="reject_application" targetRef="end_reject" />
  </bpmn:process>
</bpmn:definitions>
