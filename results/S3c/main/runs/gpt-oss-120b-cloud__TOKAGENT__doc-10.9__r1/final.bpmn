<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Change Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Change Request Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sp" name="SP/PU/GO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_fail1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_fail2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="g1" name="Who initiates?" />
    <bpmn:task id="req" name="request changes to MPO" />
    <bpmn:task id="cause" name="MPO causes change" />
    <bpmn:task id="review" name="MPO reviews the change request" />
    <bpmn:exclusiveGateway id="g2" name="Reject or confirm?" />
    <bpmn:task id="reject" name="MPO rejects the change" />
    <bpmn:task id="notify_fail1" name="notify SP/PU/GO about the failure of the changes" />
    <bpmn:task id="confirm" name="MPO confirms the request" />
    <bpmn:task id="change" name="MPO performs the measuring point change" />
    <bpmn:exclusiveGateway id="g3" name="Report outcome?" />
    <bpmn:task id="report_success" name="MPO reports the implementation to SP/PU/GO" />
    <bpmn:task id="notify_fail2" name="notify SP/PU/GO about the failure of the changes" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:sequenceFlow id="f-s-g1" sourceRef="s" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-req" name="SP initiates" sourceRef="g1" targetRef="req" />
    <bpmn:sequenceFlow id="f-g1-cause" name="MPO initiates" sourceRef="g1" targetRef="cause" />
    <bpmn:sequenceFlow id="f-req-review" sourceRef="req" targetRef="review" />
    <bpmn:sequenceFlow id="f-cause-review" sourceRef="cause" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g2" sourceRef="review" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-reject" name="reject" sourceRef="g2" targetRef="reject" />
    <bpmn:sequenceFlow id="f-g2-confirm" name="confirm" sourceRef="g2" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-notify_fail1" sourceRef="reject" targetRef="notify_fail1" />
    <bpmn:sequenceFlow id="f-confirm-change" sourceRef="confirm" targetRef="change" />
    <bpmn:sequenceFlow id="f-change-g3" sourceRef="change" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-report_success" name="success" sourceRef="g3" targetRef="report_success" />
    <bpmn:sequenceFlow id="f-g3-notify_fail2" name="failure" sourceRef="g3" targetRef="notify_fail2" />
    <bpmn:sequenceFlow id="f-notify_fail1-e1" sourceRef="notify_fail1" targetRef="e1" />
    <bpmn:sequenceFlow id="f-notify_fail2-e1" sourceRef="notify_fail2" targetRef="e1" />
    <bpmn:sequenceFlow id="f-report_success-e1" sourceRef="report_success" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
