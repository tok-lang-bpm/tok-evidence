tok 1.0 "Change Request Process"

pool org "Organisation"
  lane sp "SP/PU/GO"
    start s "Start"
    xor g1 "Who initiates?"
    task req "request changes to MPO"
  lane mpo "MPO"
    task cause "MPO causes change"
    task review "MPO reviews the change request"
    xor g2 "Reject or confirm?"
    task reject "MPO rejects the change"
    task notify_fail1 "notify SP/PU/GO about the failure of the changes"
    task confirm "MPO confirms the request"
    task change "MPO performs the measuring point change"
    xor g3 "Report outcome?"
    task report_success "MPO reports the implementation to SP/PU/GO"
    task notify_fail2 "notify SP/PU/GO about the failure of the changes"
    end e1 "End"

flow s -> g1
flow g1 -> req "SP initiates"
flow g1 -> cause "MPO initiates"
flow req -> review
flow cause -> review
flow review -> g2
flow g2 -> reject "reject"
flow g2 -> confirm "confirm"
flow reject -> notify_fail1
flow confirm -> change
flow change -> g3
flow g3 -> report_success "success"
flow g3 -> notify_fail2 "failure"
flow notify_fail1 -> e1
flow notify_fail2 -> e1
flow report_success -> e1
