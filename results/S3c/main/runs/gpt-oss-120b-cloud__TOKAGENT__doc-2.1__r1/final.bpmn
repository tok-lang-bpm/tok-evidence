<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="TELECO" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_sla_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_customer_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>enter_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_detailed_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_detailed_to_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_detailed_to_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_problem_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_actual_performance_to_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_before_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>prepare_final_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extra_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minor_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_restoration_request_to_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_problem_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_problem_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_alt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>rp_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>problems_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normal_notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_receive_restoration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_troubleshooting_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_troubleshooting_to_sm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bc" name="Billing \u0026 Collections" />
      <bpmn:lane id="es" name="Electronic Service">
        <bpmn:flowNodeRef>determine_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>significance_gw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Service degradation perceived" />
    <bpmn:task id="send_params" name="Send problem parameters list to Customer Service" />
    <bpmn:task id="create_customer_report" name="Create report for the customer" />
    <bpmn:task id="report_sla_rebate" name="Report SLA violation rebate to Billing \u0026 Collections" />
    <bpmn:task id="send_customer_report" name="Send customer report to Customer" />
    <bpmn:task id="enter_report" name="Enter problem report into system T" />
    <bpmn:task id="compare_sla" name="Compare problem report to customer SLA" />
    <bpmn:task id="determine_measures" name="Determine counter measures and priorities" />
    <bpmn:task id="create_detailed_report" name="Create detailed problem report" />
    <bpmn:task id="send_detailed_to_sm" name="Send detailed problem report to Service Management" />
    <bpmn:task id="send_detailed_to_rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="send_problem_resolution" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="send_actual_performance_to_cs" name="Send actual service performance to Customer Service" />
    <bpmn:exclusiveGateway id="join_before_parallel" name="Join before parallel activities" />
    <bpmn:parallelGateway id="parallel_start" name="Parallel activities start" />
    <bpmn:parallelGateway id="parallel_end" name="Parallel activities end" />
    <bpmn:endEvent id="end" name="Process ends" />
    <bpmn:task id="prepare_final_status" name="Prepare final status report" />
    <bpmn:task id="extra_fix" name="Extra problem fix process" />
    <bpmn:task id="minor_corrective" name="Undertake minor corrective actions" />
    <bpmn:task id="create_restoration_request" name="Create request for automatic resource restoration" />
    <bpmn:task id="send_restoration_request_to_rp" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="sm_create_problem_resolution" name="Create problem resolution report" />
    <bpmn:task id="sm_send_problem_resolution" name="Send problem resolution report to Customer Service" />
    <bpmn:exclusiveGateway id="premium_gw" name="Is customer premium?" />
    <bpmn:exclusiveGateway id="analyzable_gw" name="Is problem analyzable by Service Management?" />
    <bpmn:exclusiveGateway id="final_alt" name="What is the final status?" />
    <bpmn:task id="rp_receive" name="Receive detailed problem report" />
    <bpmn:task id="check_problems" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="problems_gw" name="Problems detected?" />
    <bpmn:task id="normal_notification" name="Create normal service execution notification" />
    <bpmn:task id="rp_analyze" name="Analyze problem and create trouble report" />
    <bpmn:task id="send_status" name="Include report in status report and send to Service Management" />
    <bpmn:task id="rp_receive_restoration" name="Receive restoration request" />
    <bpmn:task id="track_errors" name="Track all possible errors" />
    <bpmn:task id="rp_corrective" name="Undertake corrective actions" />
    <bpmn:task id="create_troubleshooting_report" name="Create trouble-shooting report" />
    <bpmn:task id="send_troubleshooting_to_sm" name="Send trouble-shooting report to Service Management" />
    <bpmn:task id="determine_significance" name="Determine customer significance" />
    <bpmn:exclusiveGateway id="significance_gw" name="Is significance affecting counter measures?" />
    <bpmn:sequenceFlow id="f-start-send_params" sourceRef="start" targetRef="send_params" />
    <bpmn:sequenceFlow id="f-send_params-enter_report" sourceRef="send_params" targetRef="enter_report" />
    <bpmn:sequenceFlow id="f-enter_report-compare_sla" sourceRef="enter_report" targetRef="compare_sla" />
    <bpmn:sequenceFlow id="f-compare_sla-determine_measures" sourceRef="compare_sla" targetRef="determine_measures" />
    <bpmn:sequenceFlow id="f-determine_measures-determine_significance" sourceRef="determine_measures" targetRef="determine_significance" />
    <bpmn:sequenceFlow id="f-determine_significance-premium_gw" sourceRef="determine_significance" targetRef="premium_gw" />
    <bpmn:sequenceFlow id="f-premium_gw-extra_fix" name="yes" sourceRef="premium_gw" targetRef="extra_fix" />
    <bpmn:sequenceFlow id="f-premium_gw-significance_gw" name="no" sourceRef="premium_gw" targetRef="significance_gw" />
    <bpmn:sequenceFlow id="f-extra_fix-significance_gw" sourceRef="extra_fix" targetRef="significance_gw" />
    <bpmn:sequenceFlow id="f-significance_gw-determine_measures" name="yes" sourceRef="significance_gw" targetRef="determine_measures" />
    <bpmn:sequenceFlow id="f-significance_gw-create_detailed_report" name="no" sourceRef="significance_gw" targetRef="create_detailed_report" />
    <bpmn:sequenceFlow id="f-create_detailed_report-send_detailed_to_sm" sourceRef="create_detailed_report" targetRef="send_detailed_to_sm" />
    <bpmn:sequenceFlow id="f-send_detailed_to_sm-analyzable_gw" sourceRef="send_detailed_to_sm" targetRef="analyzable_gw" />
    <bpmn:sequenceFlow id="f-analyzable_gw-rp_receive" name="no" sourceRef="analyzable_gw" targetRef="rp_receive" />
    <bpmn:sequenceFlow id="f-analyzable_gw-send_detailed_to_rp" name="yes" sourceRef="analyzable_gw" targetRef="send_detailed_to_rp" />
    <bpmn:sequenceFlow id="f-send_detailed_to_rp-rp_receive" sourceRef="send_detailed_to_rp" targetRef="rp_receive" />
    <bpmn:sequenceFlow id="f-rp_receive-check_problems" sourceRef="rp_receive" targetRef="check_problems" />
    <bpmn:sequenceFlow id="f-check_problems-problems_gw" sourceRef="check_problems" targetRef="problems_gw" />
    <bpmn:sequenceFlow id="f-problems_gw-normal_notification" name="no" sourceRef="problems_gw" targetRef="normal_notification" />
    <bpmn:sequenceFlow id="f-problems_gw-rp_analyze" name="yes" sourceRef="problems_gw" targetRef="rp_analyze" />
    <bpmn:sequenceFlow id="f-normal_notification-send_status" sourceRef="normal_notification" targetRef="send_status" />
    <bpmn:sequenceFlow id="f-rp_analyze-send_status" sourceRef="rp_analyze" targetRef="send_status" />
    <bpmn:sequenceFlow id="f-send_status-prepare_final_status" sourceRef="send_status" targetRef="prepare_final_status" />
    <bpmn:sequenceFlow id="f-prepare_final_status-final_alt" sourceRef="prepare_final_status" targetRef="final_alt" />
    <bpmn:sequenceFlow id="f-final_alt-send_actual_performance_to_cs" name="no problem" sourceRef="final_alt" targetRef="send_actual_performance_to_cs" />
    <bpmn:sequenceFlow id="f-final_alt-minor_corrective" name="minor corrective" sourceRef="final_alt" targetRef="minor_corrective" />
    <bpmn:sequenceFlow id="f-final_alt-create_restoration_request" name="auto restoration" sourceRef="final_alt" targetRef="create_restoration_request" />
    <bpmn:sequenceFlow id="f-send_actual_performance_to_cs-join_before_parallel" sourceRef="send_actual_performance_to_cs" targetRef="join_before_parallel" />
    <bpmn:sequenceFlow id="f-minor_corrective-sm_create_problem_resolution" sourceRef="minor_corrective" targetRef="sm_create_problem_resolution" />
    <bpmn:sequenceFlow id="f-sm_create_problem_resolution-sm_send_problem_resolution" sourceRef="sm_create_problem_resolution" targetRef="sm_send_problem_resolution" />
    <bpmn:sequenceFlow id="f-sm_send_problem_resolution-send_problem_resolution" sourceRef="sm_send_problem_resolution" targetRef="send_problem_resolution" />
    <bpmn:sequenceFlow id="f-send_problem_resolution-join_before_parallel" sourceRef="send_problem_resolution" targetRef="join_before_parallel" />
    <bpmn:sequenceFlow id="f-create_restoration_request-send_restoration_request_to_rp" sourceRef="create_restoration_request" targetRef="send_restoration_request_to_rp" />
    <bpmn:sequenceFlow id="f-send_restoration_request_to_rp-rp_receive_restoration" sourceRef="send_restoration_request_to_rp" targetRef="rp_receive_restoration" />
    <bpmn:sequenceFlow id="f-rp_receive_restoration-track_errors" sourceRef="rp_receive_restoration" targetRef="track_errors" />
    <bpmn:sequenceFlow id="f-track_errors-rp_corrective" sourceRef="track_errors" targetRef="rp_corrective" />
    <bpmn:sequenceFlow id="f-rp_corrective-create_troubleshooting_report" sourceRef="rp_corrective" targetRef="create_troubleshooting_report" />
    <bpmn:sequenceFlow id="f-create_troubleshooting_report-send_troubleshooting_to_sm" sourceRef="create_troubleshooting_report" targetRef="send_troubleshooting_to_sm" />
    <bpmn:sequenceFlow id="f-send_troubleshooting_to_sm-sm_create_problem_resolution" sourceRef="send_troubleshooting_to_sm" targetRef="sm_create_problem_resolution" />
    <bpmn:sequenceFlow id="f-join_before_parallel-parallel_start" sourceRef="join_before_parallel" targetRef="parallel_start" />
    <bpmn:sequenceFlow id="f-parallel_start-create_customer_report" sourceRef="parallel_start" targetRef="create_customer_report" />
    <bpmn:sequenceFlow id="f-parallel_start-report_sla_rebate" sourceRef="parallel_start" targetRef="report_sla_rebate" />
    <bpmn:sequenceFlow id="f-parallel_start-send_customer_report" sourceRef="parallel_start" targetRef="send_customer_report" />
    <bpmn:sequenceFlow id="f-create_customer_report-parallel_end" sourceRef="create_customer_report" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-report_sla_rebate-parallel_end" sourceRef="report_sla_rebate" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-send_customer_report-parallel_end" sourceRef="send_customer_report" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-parallel_end-end" sourceRef="parallel_end" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
