<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="SCT Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="SCT Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-warrant-request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-sct-file1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward-warrant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-physical-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-sct-file2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach-new-doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-expanded-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>receive-report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send-warrant-request" name="send warrant possession request" />
    <bpmn:task id="receive-request" name="receive request" />
    <bpmn:task id="retrieve-sct-file1" name="retrieve SCT file" />
    <bpmn:task id="forward-warrant" name="forward SCT Warrant Possession" />
    <bpmn:task id="store-physical-file" name="store SCT physical file" />
    <bpmn:task id="retrieve-sct-file2" name="retrieve SCT file" />
    <bpmn:task id="attach-new-doc" name="attach new SCT document" />
    <bpmn:task id="store-expanded-file" name="store expanded SCT physical file" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="receive-report" name="receive report" />
    <bpmn:sequenceFlow id="f-s-send-warrant-request" sourceRef="s" targetRef="send-warrant-request" />
    <bpmn:sequenceFlow id="f-send-warrant-request-receive-request" sourceRef="send-warrant-request" targetRef="receive-request" />
    <bpmn:sequenceFlow id="f-receive-request-retrieve-sct-file1" sourceRef="receive-request" targetRef="retrieve-sct-file1" />
    <bpmn:sequenceFlow id="f-retrieve-sct-file1-forward-warrant" sourceRef="retrieve-sct-file1" targetRef="forward-warrant" />
    <bpmn:sequenceFlow id="f-forward-warrant-store-physical-file" sourceRef="forward-warrant" targetRef="store-physical-file" />
    <bpmn:sequenceFlow id="f-store-physical-file-receive-report" sourceRef="store-physical-file" targetRef="receive-report" />
    <bpmn:sequenceFlow id="f-receive-report-retrieve-sct-file2" sourceRef="receive-report" targetRef="retrieve-sct-file2" />
    <bpmn:sequenceFlow id="f-retrieve-sct-file2-attach-new-doc" sourceRef="retrieve-sct-file2" targetRef="attach-new-doc" />
    <bpmn:sequenceFlow id="f-attach-new-doc-store-expanded-file" sourceRef="attach-new-doc" targetRef="store-expanded-file" />
    <bpmn:sequenceFlow id="f-store-expanded-file-e" sourceRef="store-expanded-file" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
