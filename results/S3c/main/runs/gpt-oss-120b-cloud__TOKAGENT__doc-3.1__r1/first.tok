tok 1.0
pool org "SCT Organisation" {
  lane party "Party"
  lane backoffice "Client Service Back Office"
  lane police "Queensland Police"
}
start s "Start"
task send-warrant-request "send warrant possession request" lane=party
task receive-request "receive request" lane=backoffice
task retrieve-sct-file1 "retrieve SCT file" lane=backoffice
task forward-warrant "forward SCT Warrant Possession" lane=backoffice
task store-physical-file "store SCT physical file" lane=backoffice
task receive-report "receive report" lane=police
task retrieve-sct-file2 "retrieve SCT file" lane=backoffice
task attach-new-doc "attach new SCT document" lane=backoffice
task store-expanded-file "store expanded SCT physical file" lane=backoffice
end e "End"
flow s -> send-warrant-request
flow send-warrant-request -> receive-request
flow receive-request -> retrieve-sct-file1
flow retrieve-sct-file1 -> forward-warrant
flow forward-warrant -> store-physical-file
flow store-physical-file -> receive-report
flow receive-report -> retrieve-sct-file2
flow retrieve-sct-file2 -> attach-new-doc
flow attach-new-doc -> store-expanded-file
flow store-expanded-file -> e