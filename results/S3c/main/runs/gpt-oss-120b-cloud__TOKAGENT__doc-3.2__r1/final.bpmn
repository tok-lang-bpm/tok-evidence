<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court Process" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court Process" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="staff" name="Staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision-missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute-lawlist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="associate" name="Associate">
        <bpmn:flowNodeRef>hand-files</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>conduct-hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="check-files" name="Check pending files" />
    <bpmn:exclusiveGateway id="decision-missing" name="Files missing?" />
    <bpmn:task id="search-files" name="Initiate file search" />
    <bpmn:task id="track-files" name="Track files to location" />
    <bpmn:exclusiveGateway id="ready-join" name="Ready join" />
    <bpmn:task id="distribute-lawlist" name="Distribute Judgeis Lawlist" />
    <bpmn:task id="hand-files" name="Hand files to Associate" />
    <bpmn:task id="conduct-hearings" name="Conduct directions hearings" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-check-files" sourceRef="start" targetRef="check-files" />
    <bpmn:sequenceFlow id="f-check-files-decision-missing" sourceRef="check-files" targetRef="decision-missing" />
    <bpmn:sequenceFlow id="f-decision-missing-search-files" name="yes" sourceRef="decision-missing" targetRef="search-files">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">missing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-missing-track-files" name="no" sourceRef="decision-missing" targetRef="track-files">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">missing = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-search-files-ready-join" sourceRef="search-files" targetRef="ready-join" />
    <bpmn:sequenceFlow id="f-track-files-ready-join" sourceRef="track-files" targetRef="ready-join" />
    <bpmn:sequenceFlow id="f-ready-join-hand-files" sourceRef="ready-join" targetRef="hand-files" />
    <bpmn:sequenceFlow id="f-hand-files-distribute-lawlist" sourceRef="hand-files" targetRef="distribute-lawlist" />
    <bpmn:sequenceFlow id="f-distribute-lawlist-conduct-hearings" sourceRef="distribute-lawlist" targetRef="conduct-hearings" />
    <bpmn:sequenceFlow id="f-conduct-hearings-end" sourceRef="conduct-hearings" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
