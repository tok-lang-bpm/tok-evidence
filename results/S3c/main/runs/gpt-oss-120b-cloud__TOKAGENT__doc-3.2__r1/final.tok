tok 1.0

pool court "Court Process"
  lane staff "Staff"
    start start "Start"
    task check-files "Check pending files"
    xor decision-missing "Files missing?"
    task search-files "Initiate file search"
    task track-files "Track files to location"
    xor ready-join "Ready join"
    task distribute-lawlist "Distribute Judgeis Lawlist"
  lane associate "Associate"
    task hand-files "Hand files to Associate"
  lane judge "Judge"
    task conduct-hearings "Conduct directions hearings"
    end end "End"

  flow start -> check-files
  flow check-files -> decision-missing
  flow decision-missing -> search-files "yes" when="missing = true"
  flow decision-missing -> track-files "no" when="missing = false"
  flow search-files -> ready-join
  flow track-files -> ready-join
  flow ready-join -> hand-files
  flow hand-files -> distribute-lawlist
  flow distribute-lawlist -> conduct-hearings
  flow conduct-hearings -> end
