<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="co" name="Claims Officer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sco" name="Senior Claims Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="examine" name="Examine claim" />
    <bpmn:task id="write" name="Write settlement recommendation" />
    <bpmn:task id="check" name="Check settlement recommendation" />
    <bpmn:exclusiveGateway id="decision" name="OK or Not OK?" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-examine" sourceRef="start" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-write" sourceRef="examine" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-check" sourceRef="write" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-decision" sourceRef="check" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-end" sourceRef="decision" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-write" sourceRef="decision" targetRef="write">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
