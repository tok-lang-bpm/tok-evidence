tok 1.0

pool org "Organisation"
  lane co "Claims Officer"
    start start "Start"
    task examine "Examine claim"
    task write "Write settlement recommendation"
  lane sco "Senior Claims Officer"
    task check "Check settlement recommendation"
    xor decision "OK or Not OK?"
    end end "End"

flow start -> examine
flow examine -> write
flow write -> check
flow check -> decision
flow decision -> end when="true"
flow decision -> write when="false"
