<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurance" name="Insurance Company" processRef="insurance-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurance-process" name="Insurance Company" isExecutable="false">
    <bpmn:laneSet id="insurance-lanes">
      <bpmn:lane id="police_db" name="Police Database">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-police-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble-file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handler" name="Claims Handler">
        <bpmn:flowNodeRef>calculate-estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-action-plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims Manager">
        <bpmn:flowNodeRef>negotiate-settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-claimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="search-police-report" name="search Police Report in Police Report database" />
    <bpmn:task id="assemble-file" name="assemble file with Claim Documentation" />
    <bpmn:task id="calculate-estimate" name="calculate initial claim estimate" />
    <bpmn:task id="create-action-plan" name="create Action Plan based on Action Plan Checklist" />
    <bpmn:task id="negotiate-settlement" name="negotiate settlement on claim estimate" />
    <bpmn:task id="inform-claimant" name="inform claimant of the outcome" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-search-police-report" sourceRef="start" targetRef="search-police-report" />
    <bpmn:sequenceFlow id="f-search-police-report-assemble-file" sourceRef="search-police-report" targetRef="assemble-file" />
    <bpmn:sequenceFlow id="f-assemble-file-calculate-estimate" sourceRef="assemble-file" targetRef="calculate-estimate" />
    <bpmn:sequenceFlow id="f-calculate-estimate-create-action-plan" sourceRef="calculate-estimate" targetRef="create-action-plan" />
    <bpmn:sequenceFlow id="f-create-action-plan-negotiate-settlement" sourceRef="create-action-plan" targetRef="negotiate-settlement" />
    <bpmn:sequenceFlow id="f-negotiate-settlement-inform-claimant" sourceRef="negotiate-settlement" targetRef="inform-claimant" />
    <bpmn:sequenceFlow id="f-inform-claimant-end" sourceRef="inform-claimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
