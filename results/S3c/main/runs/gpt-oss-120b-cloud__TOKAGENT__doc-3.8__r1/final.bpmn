<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car Insurer" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="notification" name="Notification Department">
        <bpmn:flowNodeRef>start_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling Department">
        <bpmn:flowNodeRef>pick-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule-payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="garage" name="Garage">
        <bpmn:flowNodeRef>phone-garage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_claim" name="Customer submits claim" />
    <bpmn:task id="check-docs" name="Checks documents for completeness and registers claim" />
    <bpmn:task id="send-letter" name="Letter is sent to customer" />
    <bpmn:endEvent id="end_process" name="Process complete" />
    <bpmn:task id="pick-claim" name="Picks up claim and checks insurance" />
    <bpmn:task id="assessment" name="Assessment is performed" />
    <bpmn:exclusiveGateway id="decision" name="Assessment positive?" default="f-decision-send-letter" />
    <bpmn:task id="schedule-payment" name="Payment is scheduled" />
    <bpmn:task id="phone-garage" name="Garage is phoned to authorise repairs" />
    <bpmn:sequenceFlow id="f-start_claim-check-docs" sourceRef="start_claim" targetRef="check-docs" />
    <bpmn:sequenceFlow id="f-check-docs-pick-claim" sourceRef="check-docs" targetRef="pick-claim" />
    <bpmn:sequenceFlow id="f-pick-claim-assessment" sourceRef="pick-claim" targetRef="assessment" />
    <bpmn:sequenceFlow id="f-assessment-decision" sourceRef="assessment" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-phone-garage" name="yes" sourceRef="decision" targetRef="phone-garage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-send-letter" name="no" sourceRef="decision" targetRef="send-letter" />
    <bpmn:sequenceFlow id="f-phone-garage-schedule-payment" sourceRef="phone-garage" targetRef="schedule-payment" />
    <bpmn:sequenceFlow id="f-schedule-payment-send-letter" sourceRef="schedule-payment" targetRef="send-letter" />
    <bpmn:sequenceFlow id="f-send-letter-end_process" sourceRef="send-letter" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
