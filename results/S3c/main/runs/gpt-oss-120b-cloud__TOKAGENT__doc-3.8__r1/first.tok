tok 1.0
pool insurer "Car Insurer" {
  lane notification "Notification Department"
  lane handling "Handling Department"
  lane garage "Garage"
}
start start_claim "Customer submits claim"
task check-docs "Checks documents for completeness and registers claim" lane=notification
task pick-claim "Picks up claim and checks insurance" lane=handling
task assessment "Assessment is performed" lane=handling
xor decision "Assessment positive?"
task phone-garage "Garage is phoned to authorise repairs" lane=garage
task schedule-payment "Payment is scheduled" lane=handling
task send-letter "Letter is sent to customer" lane=notification
end end_process "Process complete"
flow start_claim -> check-docs
flow check-docs -> pick-claim
flow pick-claim -> assessment
flow assessment -> decision
flow decision -> phone-garage "yes" when="true"
flow decision -> send-letter "no" default
flow phone-garage -> schedule-payment
flow schedule-payment -> send-letter
flow send-letter -> end_process