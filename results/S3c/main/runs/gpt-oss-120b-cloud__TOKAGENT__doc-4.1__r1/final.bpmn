<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental Health Care Institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Mental Health Care Institute" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="secretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire_name_residence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_doctor_through</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_info_and_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_patient_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_form_and_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_registration_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_to_new_notices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_until_wednesday</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_assignment_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_assignment_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="family_doctor" name="Family Doctor">
        <bpmn:flowNodeRef>notice_by_telephone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing_officer" name="Nursing Officer">
        <bpmn:flowNodeRef>full_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_registration_form</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first_intaker" name="First Intaker (Social-Medical Worker)">
        <bpmn:flowNodeRef>plan_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_first_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second_intaker" name="Second Intaker (Physician)">
        <bpmn:flowNodeRef>plan_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_dictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typeout_dictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_second_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team_leader" name="Team Leader">
        <bpmn:flowNodeRef>staff_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_intakers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>treatment_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Psychiatrist" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Intake workflow starts" />
    <bpmn:task id="inquire_name_residence" name="Inquire name and residence" />
    <bpmn:task id="put_doctor_through" name="Put doctor through to nursing officer" />
    <bpmn:task id="hand_form" name="Hand registration form to secretarial office" />
    <bpmn:task id="store_info_and_print" name="Store info in system and print" />
    <bpmn:task id="create_patient_file" name="Create patient file for new patient" />
    <bpmn:task id="store_form_and_print" name="Store form and print in patient file" />
    <bpmn:task id="produce_registration_cards" name="Produce two registration cards" />
    <bpmn:task id="add_to_new_notices" name="Add patient to list of new notices" />
    <bpmn:task id="wait_until_wednesday" name="Wait until Wednesday staff meeting" />
    <bpmn:task id="record_assignment_list" name="Record assignment list" />
    <bpmn:task id="hand_assignment_list" name="Hand assignment list to secretarial office" />
    <bpmn:task id="prepare_letter" name="Prepare and send letter to family doctor" />
    <bpmn:task id="receive_copy" name="Receive copy of medical file" />
    <bpmn:task id="inform_second" name="Inform second intaker and add copy to file" />
    <bpmn:parallelGateway id="p_split" />
    <bpmn:parallelGateway id="p_join" />
    <bpmn:task id="record_completed" name="Record patient on completed intake list" />
    <bpmn:task id="provide_list" name="Provide completed list to team leader for staff meeting" />
    <bpmn:endEvent id="e0" name="Intake procedure ends" />
    <bpmn:task id="notice_by_telephone" name="Give telephone notice" />
    <bpmn:task id="full_inquiry" name="Make full inquiry" />
    <bpmn:task id="record_registration_form" name="Record information on registration form" />
    <bpmn:task id="plan_first" name="Plan meeting" />
    <bpmn:task id="first_meeting" name="Conduct meeting and fill checklist" />
    <bpmn:task id="add_first_docs" name="Add notes and checklist to patient file" />
    <bpmn:task id="plan_second" name="Plan meeting" />
    <bpmn:task id="second_meeting" name="Conduct meeting" />
    <bpmn:task id="record_dictaphone" name="Record dictaphone" />
    <bpmn:task id="typeout_dictaphone" name="Type out dictaphone and add to file" />
    <bpmn:task id="add_second_docs" name="Add second intaker documents to patient file" />
    <bpmn:task id="staff_meeting" name="Staff meeting of medical team" />
    <bpmn:task id="assign_intakers" name="Assign intakers" />
    <bpmn:task id="treatment_plan" name="Formulate treatment plan" />
    <bpmn:sequenceFlow id="f-s0-notice_by_telephone" sourceRef="s0" targetRef="notice_by_telephone" />
    <bpmn:sequenceFlow id="f-notice_by_telephone-inquire_name_residence" sourceRef="notice_by_telephone" targetRef="inquire_name_residence" />
    <bpmn:sequenceFlow id="f-inquire_name_residence-put_doctor_through" sourceRef="inquire_name_residence" targetRef="put_doctor_through" />
    <bpmn:sequenceFlow id="f-put_doctor_through-full_inquiry" sourceRef="put_doctor_through" targetRef="full_inquiry" />
    <bpmn:sequenceFlow id="f-full_inquiry-record_registration_form" sourceRef="full_inquiry" targetRef="record_registration_form" />
    <bpmn:sequenceFlow id="f-record_registration_form-hand_form" sourceRef="record_registration_form" targetRef="hand_form" />
    <bpmn:sequenceFlow id="f-hand_form-store_info_and_print" sourceRef="hand_form" targetRef="store_info_and_print" />
    <bpmn:sequenceFlow id="f-store_info_and_print-create_patient_file" sourceRef="store_info_and_print" targetRef="create_patient_file" />
    <bpmn:sequenceFlow id="f-create_patient_file-store_form_and_print" sourceRef="create_patient_file" targetRef="store_form_and_print" />
    <bpmn:sequenceFlow id="f-store_form_and_print-produce_registration_cards" sourceRef="store_form_and_print" targetRef="produce_registration_cards" />
    <bpmn:sequenceFlow id="f-produce_registration_cards-add_to_new_notices" sourceRef="produce_registration_cards" targetRef="add_to_new_notices" />
    <bpmn:sequenceFlow id="f-add_to_new_notices-wait_until_wednesday" sourceRef="add_to_new_notices" targetRef="wait_until_wednesday" />
    <bpmn:sequenceFlow id="f-wait_until_wednesday-staff_meeting" sourceRef="wait_until_wednesday" targetRef="staff_meeting" />
    <bpmn:sequenceFlow id="f-staff_meeting-assign_intakers" sourceRef="staff_meeting" targetRef="assign_intakers" />
    <bpmn:sequenceFlow id="f-assign_intakers-record_assignment_list" sourceRef="assign_intakers" targetRef="record_assignment_list" />
    <bpmn:sequenceFlow id="f-record_assignment_list-hand_assignment_list" sourceRef="record_assignment_list" targetRef="hand_assignment_list" />
    <bpmn:sequenceFlow id="f-hand_assignment_list-prepare_letter" sourceRef="hand_assignment_list" targetRef="prepare_letter" />
    <bpmn:sequenceFlow id="f-prepare_letter-receive_copy" sourceRef="prepare_letter" targetRef="receive_copy" />
    <bpmn:sequenceFlow id="f-receive_copy-inform_second" sourceRef="receive_copy" targetRef="inform_second" />
    <bpmn:sequenceFlow id="f-inform_second-p_split" sourceRef="inform_second" targetRef="p_split" />
    <bpmn:sequenceFlow id="f-p_split-plan_first" sourceRef="p_split" targetRef="plan_first" />
    <bpmn:sequenceFlow id="f-p_split-plan_second" sourceRef="p_split" targetRef="plan_second" />
    <bpmn:sequenceFlow id="f-plan_first-first_meeting" sourceRef="plan_first" targetRef="first_meeting" />
    <bpmn:sequenceFlow id="f-first_meeting-add_first_docs" sourceRef="first_meeting" targetRef="add_first_docs" />
    <bpmn:sequenceFlow id="f-add_first_docs-p_join" sourceRef="add_first_docs" targetRef="p_join" />
    <bpmn:sequenceFlow id="f-plan_second-second_meeting" sourceRef="plan_second" targetRef="second_meeting" />
    <bpmn:sequenceFlow id="f-second_meeting-record_dictaphone" sourceRef="second_meeting" targetRef="record_dictaphone" />
    <bpmn:sequenceFlow id="f-record_dictaphone-typeout_dictaphone" sourceRef="record_dictaphone" targetRef="typeout_dictaphone" />
    <bpmn:sequenceFlow id="f-typeout_dictaphone-add_second_docs" sourceRef="typeout_dictaphone" targetRef="add_second_docs" />
    <bpmn:sequenceFlow id="f-add_second_docs-p_join" sourceRef="add_second_docs" targetRef="p_join" />
    <bpmn:sequenceFlow id="f-p_join-record_completed" sourceRef="p_join" targetRef="record_completed" />
    <bpmn:sequenceFlow id="f-record_completed-provide_list" sourceRef="record_completed" targetRef="provide_list" />
    <bpmn:sequenceFlow id="f-provide_list-treatment_plan" sourceRef="provide_list" targetRef="treatment_plan" />
    <bpmn:sequenceFlow id="f-treatment_plan-e0" sourceRef="treatment_plan" targetRef="e0" />
  </bpmn:process>
</bpmn:definitions>
