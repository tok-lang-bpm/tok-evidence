tok 1.0

pool institute "Mental Health Care Institute"
  lane secretarial "Secretarial Office"
    start s0 "Intake workflow starts"
    task inquire_name_residence "Inquire name and residence"
    task put_doctor_through "Put doctor through to nursing officer"
    task hand_form "Hand registration form to secretarial office"
    task store_info_and_print "Store info in system and print"
    task create_patient_file "Create patient file for new patient"
    task store_form_and_print "Store form and print in patient file"
    task produce_registration_cards "Produce two registration cards"
    task add_to_new_notices "Add patient to list of new notices"
    task wait_until_wednesday "Wait until Wednesday staff meeting"
    task record_assignment_list "Record assignment list"
    task hand_assignment_list "Hand assignment list to secretarial office"
    task prepare_letter "Prepare and send letter to family doctor"
    task receive_copy "Receive copy of medical file"
    task inform_second "Inform second intaker and add copy to file"
    and p_split
    and p_join
    task record_completed "Record patient on completed intake list"
    task provide_list "Provide completed list to team leader for staff meeting"
    end e0 "Intake procedure ends"
  lane family_doctor "Family Doctor"
    task notice_by_telephone "Give telephone notice"
  lane nursing_officer "Nursing Officer"
    task full_inquiry "Make full inquiry"
    task record_registration_form "Record information on registration form"
  lane first_intaker "First Intaker (Social-Medical Worker)"
    task plan_first "Plan meeting"
    task first_meeting "Conduct meeting and fill checklist"
    task add_first_docs "Add notes and checklist to patient file"
  lane second_intaker "Second Intaker (Physician)"
    task plan_second "Plan meeting"
    task second_meeting "Conduct meeting"
    task record_dictaphone "Record dictaphone"
    task typeout_dictaphone "Type out dictaphone and add to file"
    task add_second_docs "Add second intaker documents to patient file"
  lane team_leader "Team Leader"
    task staff_meeting "Staff meeting of medical team"
    task assign_intakers "Assign intakers"
    task treatment_plan "Formulate treatment plan"
  lane psychiatrist "Psychiatrist"
    # no specific tasks

flow s0 -> notice_by_telephone
flow notice_by_telephone -> inquire_name_residence
flow inquire_name_residence -> put_doctor_through
flow put_doctor_through -> full_inquiry
flow full_inquiry -> record_registration_form
flow record_registration_form -> hand_form
flow hand_form -> store_info_and_print
flow store_info_and_print -> create_patient_file
flow create_patient_file -> store_form_and_print
flow store_form_and_print -> produce_registration_cards
flow produce_registration_cards -> add_to_new_notices
flow add_to_new_notices -> wait_until_wednesday
flow wait_until_wednesday -> staff_meeting
flow staff_meeting -> assign_intakers
flow assign_intakers -> record_assignment_list
flow record_assignment_list -> hand_assignment_list
flow hand_assignment_list -> prepare_letter
flow prepare_letter -> receive_copy
flow receive_copy -> inform_second
flow inform_second -> p_split
flow p_split -> plan_first
flow p_split -> plan_second
flow plan_first -> first_meeting
flow first_meeting -> add_first_docs
flow add_first_docs -> p_join
flow plan_second -> second_meeting
flow second_meeting -> record_dictaphone
flow record_dictaphone -> typeout_dictaphone
flow typeout_dictaphone -> add_second_docs
flow add_second_docs -> p_join
flow p_join -> record_completed
flow record_completed -> provide_list
flow provide_list -> treatment_plan
flow treatment_plan -> e0
