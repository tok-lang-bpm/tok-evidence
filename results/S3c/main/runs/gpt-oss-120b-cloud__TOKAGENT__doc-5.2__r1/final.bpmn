<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR Representative">
        <bpmn:flowNodeRef>complete_hr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="reject_review" name="Review rejection reasons" />
    <bpmn:endEvent id="end_reject" name="End" />
    <bpmn:task id="receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="dec" name="Approve request?" />
    <bpmn:task id="generate" name="Generate notification to HR" />
    <bpmn:endEvent id="end_approve" name="End" />
    <bpmn:task id="complete_hr" name="Complete management procedures" />
    <bpmn:sequenceFlow id="f-s-submit" sourceRef="s" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-receive" sourceRef="submit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-dec" sourceRef="receive" targetRef="dec" />
    <bpmn:sequenceFlow id="f-dec-reject_review" sourceRef="dec" targetRef="reject_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-dec-generate" sourceRef="dec" targetRef="generate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reject_review-end_reject" sourceRef="reject_review" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-generate-complete_hr" sourceRef="generate" targetRef="complete_hr" />
    <bpmn:sequenceFlow id="f-complete_hr-end_approve" sourceRef="complete_hr" targetRef="end_approve" />
  </bpmn:process>
</bpmn:definitions>
