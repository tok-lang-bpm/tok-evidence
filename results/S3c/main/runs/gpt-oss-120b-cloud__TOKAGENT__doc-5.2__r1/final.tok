tok 1.0
pool org "Organization"
  lane employee "Employee"
    start s "Start"
    task submit "Submit vacation request"
    task reject_review "Review rejection reasons"
    end end_reject "End"
  lane supervisor "Supervisor"
    task receive "Receive vacation request"
    xor dec "Approve request?"
    task generate "Generate notification to HR"
    end end_approve "End"
  lane hr "HR Representative"
    task complete_hr "Complete management procedures"
flow s -> submit
flow submit -> receive
flow receive -> dec
flow dec -> reject_review when="approval = false"
flow dec -> generate when="approval = true"
flow reject_review -> end_reject
flow generate -> complete_hr
flow complete_hr -> end_approve
