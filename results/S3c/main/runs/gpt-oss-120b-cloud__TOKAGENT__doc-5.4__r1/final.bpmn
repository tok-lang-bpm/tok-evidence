<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sup_dec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check_receipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tre_dec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Payment System">
        <bpmn:flowNodeRef>link_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_payment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit_report" name="Submit expense report" />
    <bpmn:task id="edit_report" name="Edit expense report" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="review_report" name="Review expense report" />
    <bpmn:exclusiveGateway id="sup_dec" name="Supervisor approves?" />
    <bpmn:task id="check_receipts" name="Check receipts" />
    <bpmn:exclusiveGateway id="tre_dec" name="All receipts ok?" />
    <bpmn:task id="link_payment" name="Link to payment system" />
    <bpmn:task id="wait_payment" name="Wait for payment confirmation" />
    <bpmn:sequenceFlow id="f-start-purchase" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit_report" sourceRef="purchase" targetRef="submit_report" />
    <bpmn:sequenceFlow id="f-submit_report-review_report" sourceRef="submit_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-review_report-sup_dec" sourceRef="review_report" targetRef="sup_dec" />
    <bpmn:sequenceFlow id="f-sup_dec-check_receipts" name="approve" sourceRef="sup_dec" targetRef="check_receipts" />
    <bpmn:sequenceFlow id="f-sup_dec-edit_report" name="reject" sourceRef="sup_dec" targetRef="edit_report" />
    <bpmn:sequenceFlow id="f-edit_report-review_report" sourceRef="edit_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-check_receipts-tre_dec" sourceRef="check_receipts" targetRef="tre_dec" />
    <bpmn:sequenceFlow id="f-tre_dec-link_payment" name="receipts ok" sourceRef="tre_dec" targetRef="link_payment" />
    <bpmn:sequenceFlow id="f-tre_dec-edit_report" name="receipts missing" sourceRef="tre_dec" targetRef="edit_report" />
    <bpmn:sequenceFlow id="f-link_payment-wait_payment" sourceRef="link_payment" targetRef="wait_payment" />
    <bpmn:sequenceFlow id="f-wait_payment-end" sourceRef="wait_payment" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
