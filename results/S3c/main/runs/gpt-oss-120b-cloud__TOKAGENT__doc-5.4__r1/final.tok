tok 1.0

pool org "Organization"
  lane employee "Employee"
    start start "Start"
    task purchase "Purchase product or service"
    task submit_report "Submit expense report"
    task edit_report "Edit expense report"
    end end "End"
  lane supervisor "Supervisor"
    task review_report "Review expense report"
    xor sup_dec "Supervisor approves?"
  lane treasurer "Treasurer"
    task check_receipts "Check receipts"
    xor tre_dec "All receipts ok?"
  lane system "Payment System"
    task link_payment "Link to payment system"
    task wait_payment "Wait for payment confirmation"

flow start -> purchase -> submit_report -> review_report -> sup_dec
flow sup_dec -> check_receipts "approve"
flow sup_dec -> edit_report "reject"
flow edit_report -> review_report
flow check_receipts -> tre_dec
flow tre_dec -> link_payment "receipts ok"
flow tre_dec -> edit_report "receipts missing"
flow link_payment -> wait_payment -> end
