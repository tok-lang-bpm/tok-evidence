<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Assembler AG" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Assembler AG" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1">
      <bpmn:timerEventDefinition id="start1-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="send-order" name="send order to supplier" />
    <bpmn:task id="receive-invoice" name="receive invoice" />
    <bpmn:endEvent id="end1" />
    <bpmn:task id="process-order" name="process order" />
    <bpmn:task id="send-invoice" name="send invoice to Assembler AG" />
    <bpmn:sequenceFlow id="f-start1-send-order" sourceRef="start1" targetRef="send-order" />
    <bpmn:sequenceFlow id="f-send-order-process-order" sourceRef="send-order" targetRef="process-order" />
    <bpmn:sequenceFlow id="f-process-order-send-invoice" sourceRef="process-order" targetRef="send-invoice" />
    <bpmn:sequenceFlow id="f-send-invoice-receive-invoice" sourceRef="send-invoice" targetRef="receive-invoice" />
    <bpmn:sequenceFlow id="f-receive-invoice-end1" sourceRef="receive-invoice" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
