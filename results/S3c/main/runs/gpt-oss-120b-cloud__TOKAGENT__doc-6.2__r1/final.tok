tok 1.0

pool org "Assembler AG"
  lane assembler "Assembler AG"
    start start1 timer=P1M
    task send-order "send order to supplier"
    task receive-invoice "receive invoice"
    end end1
  lane supplier "Supplier"
    task process-order "process order"
    task send-invoice "send invoice to Assembler AG"

flow start1 -> send-order -> process-order -> send-invoice -> receive-invoice -> end1
