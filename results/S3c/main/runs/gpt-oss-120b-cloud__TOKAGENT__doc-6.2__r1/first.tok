tok 1.0
pool org "Assembler AG" {
  lane assembler "Assembler AG"
  lane supplier "Supplier"
}
start start1 timer=P1M
task send-order "send order to supplier" lane=assembler
task process-order "process order" lane=supplier
task send-invoice "send invoice to Assembler AG" lane=supplier
task receive-invoice "receive invoice" lane=assembler
end end1

flow start1 -> send-order
flow send-order -> process-order
flow process-order -> send-invoice
flow send-invoice -> receive-invoice
flow receive-invoice -> end1
