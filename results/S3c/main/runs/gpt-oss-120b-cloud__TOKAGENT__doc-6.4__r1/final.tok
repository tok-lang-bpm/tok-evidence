tok 1.0 "Customer Acquisition Process"

pool org "Organization" {
  lane marketing "Marketing Staff"
    task buy-details "Buy details for cold calls"
    task exhibitions "Marketing staff participates in exhibitions"
    task personal-referral "Personal referral knows interested person"

  lane call_center "Call Center"
    start s "Start"
    task determine-contact-details "Determine contact details of potential customers"
    task call-customer "Call customer"
    task determine-person-contact-budget "Determine contact person and budget"
    task ask-interest "Ask customer whether generally interested"
    end e "End"

  lane head_dev "Head of Development"
    task head-acquire "Head of development tries to acquire the customer"

  lane sales_rep "Sales Representative"
    task sales-presentation "Detailed online presentation by sales representative"
    task sales-call "Sales representative calls the customer"
    task create-quotation "Creation of a quotation"

  lane pre_sales "Pre‑sales Employee"
    task pre_sales-presentation "Detailed online presentation by pre‑sales employee"

  xor method-choice "Method to obtain contact details"
  xor interest-check "Is customer generally interested?"
  xor budget-huge "Is potential project budget huge?"
  xor presentation-choice "Select presentation type"
  xor response-check "Did customer respond within 2 weeks?"
}

# Sequence flows
flow s -> determine-contact-details
flow determine-contact-details -> method-choice

flow method-choice -> buy-details "Buy details"
flow method-choice -> exhibitions "Exhibition"
flow method-choice -> personal-referral "Referral"

flow buy-details -> call-customer
flow exhibitions -> call-customer
flow personal-referral -> call-customer

flow call-customer -> determine-person-contact-budget
flow determine-person-contact-budget -> ask-interest
flow ask-interest -> interest-check

flow interest-check -> presentation-choice "yes"
flow interest-check -> budget-huge "no"

flow budget-huge -> head-acquire "yes"
flow budget-huge -> e "no"

flow head-acquire -> presentation-choice

flow presentation-choice -> sales-presentation "sales"
flow presentation-choice -> pre_sales-presentation "technical"

flow sales-presentation -> response-check
flow pre_sales-presentation -> response-check

flow response-check -> create-quotation "yes"
flow response-check -> sales-call "no"

flow sales-call -> create-quotation

flow create-quotation -> e
