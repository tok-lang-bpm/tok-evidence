<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_leads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_top_five</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_assistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_note</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="check_leads" name="checks the open leads" />
    <bpmn:task id="select_top_five" name="selects the top five leads" />
    <bpmn:task id="tell_assistant" name="tells Sales Assistant to call the contact person of the leads" />
    <bpmn:task id="process_lead" name="processes the lead" />
    <bpmn:endEvent id="e" />
    <bpmn:task id="call_customer" name="calls each customer" />
    <bpmn:exclusiveGateway id="decision_interested" name="Is customer interested?" default="f-decision_interested-call_customer" />
    <bpmn:task id="send_note" name="sends a note to the Manager" />
    <bpmn:sequenceFlow id="f-s-check_leads" sourceRef="s" targetRef="check_leads" />
    <bpmn:sequenceFlow id="f-check_leads-select_top_five" sourceRef="check_leads" targetRef="select_top_five" />
    <bpmn:sequenceFlow id="f-select_top_five-tell_assistant" sourceRef="select_top_five" targetRef="tell_assistant" />
    <bpmn:sequenceFlow id="f-tell_assistant-call_customer" sourceRef="tell_assistant" targetRef="call_customer" />
    <bpmn:sequenceFlow id="f-call_customer-decision_interested" sourceRef="call_customer" targetRef="decision_interested" />
    <bpmn:sequenceFlow id="f-decision_interested-send_note" sourceRef="decision_interested" targetRef="send_note">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision_interested-call_customer" sourceRef="decision_interested" targetRef="call_customer" />
    <bpmn:sequenceFlow id="f-send_note-process_lead" sourceRef="send_note" targetRef="process_lead" />
    <bpmn:sequenceFlow id="f-process_lead-e" sourceRef="process_lead" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
