tok 1.0

pool org "Organization" {
  lane manager "Manager" {
    start s
    task check_leads "checks the open leads"
    task select_top_five "selects the top five leads"
    task tell_assistant "tells Sales Assistant to call the contact person of the leads"
    task process_lead "processes the lead"
    end e
  }
  lane assistant "Sales Assistant" {
    task call_customer "calls each customer"
    xor decision_interested "Is customer interested?"
    task send_note "sends a note to the Manager"
  }
}

flow s -> check_leads
flow check_leads -> select_top_five
flow select_top_five -> tell_assistant
flow tell_assistant -> call_customer
flow call_customer -> decision_interested
flow decision_interested -> send_note when="interested"
flow decision_interested -> call_customer default
flow send_note -> process_lead
flow process_lead -> e