<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="functional_department" name="Functional Department">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Demand for post" />
    <bpmn:task id="advertise" name="Advertise post" />
    <bpmn:task id="receive" name="Receive applications" />
    <bpmn:task id="check" name="Check applications" />
    <bpmn:task id="fill" name="Fill post" />
    <bpmn:task id="conclude" name="Conclude employment contract" />
    <bpmn:endEvent id="end1" name="Post filled" />
    <bpmn:sequenceFlow id="f-start1-advertise" sourceRef="start1" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-receive" sourceRef="advertise" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-check" sourceRef="receive" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-fill" sourceRef="check" targetRef="fill" />
    <bpmn:sequenceFlow id="f-fill-conclude" sourceRef="fill" targetRef="conclude" />
    <bpmn:sequenceFlow id="f-conclude-end1" sourceRef="conclude" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
