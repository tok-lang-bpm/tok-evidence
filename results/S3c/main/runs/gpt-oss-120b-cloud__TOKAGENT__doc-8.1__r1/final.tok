tok 1.0

pool org "Organisation"
  lane functional_department "Functional Department"
    start start1 "Demand for post"
  lane hr "HR"
    task advertise "Advertise post"
    task receive "Receive applications"
    task check "Check applications"
    task fill "Fill post"
    task conclude "Conclude employment contract"
    end end1 "Post filled"

flow start1 -> advertise
flow advertise -> receive
flow receive -> check
flow check -> fill
flow fill -> conclude
flow conclude -> end1
