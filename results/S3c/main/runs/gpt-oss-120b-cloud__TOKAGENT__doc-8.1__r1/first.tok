tok 1.0

pool org "Organisation" {
  lane functional_department "Functional Department"
  lane hr "HR"
}

start start1 "Demand for post" lane=functional_department

task advertise "Advertise post" lane=hr
task receive "Receive applications" lane=hr
task check "Check applications" lane=hr
task fill "Fill post" lane=hr
task conclude "Conclude employment contract" lane=hr

end end1 "Post filled" lane=hr

flow start1 -> advertise
flow advertise -> receive
flow receive -> check
flow check -> fill
flow fill -> conclude
flow conclude -> end1
