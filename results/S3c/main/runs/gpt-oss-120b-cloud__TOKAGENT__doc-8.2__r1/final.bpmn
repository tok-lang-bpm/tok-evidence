<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="hr" name="HR Clerk">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_vacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_confusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_dept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_clarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>correction_req</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="receive_vacancy" name="receive vacancy report" />
    <bpmn:task id="create_desc" name="create job description" />
    <bpmn:exclusiveGateway id="g_confusion" name="confusion in message?" />
    <bpmn:task id="ask_dept" name="ask Department again" />
    <bpmn:task id="receive_clarification" name="receive clarification" />
    <bpmn:task id="submit_desc" name="submit job description" />
    <bpmn:exclusiveGateway id="g_approval" name="approved?" />
    <bpmn:task id="post_job" name="post job" />
    <bpmn:task id="correct_desc" name="correct description" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="correction_req" name="receive correction request" />
    <bpmn:sequenceFlow id="f-s-receive_vacancy" sourceRef="s" targetRef="receive_vacancy" />
    <bpmn:sequenceFlow id="f-receive_vacancy-create_desc" sourceRef="receive_vacancy" targetRef="create_desc" />
    <bpmn:sequenceFlow id="f-create_desc-g_confusion" sourceRef="create_desc" targetRef="g_confusion" />
    <bpmn:sequenceFlow id="f-g_confusion-ask_dept" name="yes" sourceRef="g_confusion" targetRef="ask_dept" />
    <bpmn:sequenceFlow id="f-ask_dept-receive_clarification" sourceRef="ask_dept" targetRef="receive_clarification" />
    <bpmn:sequenceFlow id="f-receive_clarification-create_desc" sourceRef="receive_clarification" targetRef="create_desc" />
    <bpmn:sequenceFlow id="f-g_confusion-submit_desc" name="no" sourceRef="g_confusion" targetRef="submit_desc" />
    <bpmn:sequenceFlow id="f-submit_desc-g_approval" sourceRef="submit_desc" targetRef="g_approval" />
    <bpmn:sequenceFlow id="f-g_approval-post_job" name="yes" sourceRef="g_approval" targetRef="post_job" />
    <bpmn:sequenceFlow id="f-post_job-e" sourceRef="post_job" targetRef="e" />
    <bpmn:sequenceFlow id="f-g_approval-correction_req" name="no" sourceRef="g_approval" targetRef="correction_req" />
    <bpmn:sequenceFlow id="f-correction_req-correct_desc" name="correction received" sourceRef="correction_req" targetRef="correct_desc" />
    <bpmn:sequenceFlow id="f-correct_desc-submit_desc" sourceRef="correct_desc" targetRef="submit_desc" />
  </bpmn:process>
</bpmn:definitions>
