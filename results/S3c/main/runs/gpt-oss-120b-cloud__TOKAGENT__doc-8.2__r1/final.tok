tok 1.0

pool org "Organization"
  lane hr "HR Clerk"
    start s "Start"
    task receive_vacancy "receive vacancy report"
    task create_desc "create job description"
    xor g_confusion "confusion in message?"
    task ask_dept "ask Department again"
    task receive_clarification "receive clarification"
    task submit_desc "submit job description"
    xor g_approval "approved?"
    task post_job "post job"
    task correct_desc "correct description"
    end e "End"
  lane dept "Department"
    task correction_req "receive correction request"

flow s -> receive_vacancy
flow receive_vacancy -> create_desc
flow create_desc -> g_confusion
flow g_confusion -> ask_dept "yes"
flow ask_dept -> receive_clarification
flow receive_clarification -> create_desc
flow g_confusion -> submit_desc "no"
flow submit_desc -> g_approval
flow g_approval -> post_job "yes"
flow post_job -> e
flow g_approval -> correction_req "no"
flow correction_req -> correct_desc "correction received"
flow correct_desc -> submit_desc
