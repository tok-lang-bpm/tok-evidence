<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of Functional Department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_clar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="personnel" name="Personnel Department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR Department">
        <bpmn:flowNodeRef>hr_q</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="detect" name="detect personnel requirements" />
    <bpmn:task id="report" name="report vacancy to Personnel Department" />
    <bpmn:task id="receive" name="receive job description" />
    <bpmn:exclusiveGateway id="decision1" name="Is job description ready?" default="f-decision1-approve" />
    <bpmn:task id="ask_corr" name="ask for corrections again" />
    <bpmn:task id="provide_clar" name="provide clarifications" />
    <bpmn:task id="approve" name="approve job description" />
    <bpmn:endEvent id="e" />
    <bpmn:task id="prepare" name="prepare job description" />
    <bpmn:task id="revise" name="revise job description" />
    <bpmn:task id="hr_q" name="ask clarification questions" />
    <bpmn:sequenceFlow id="f-s-detect" sourceRef="s" targetRef="detect" />
    <bpmn:sequenceFlow id="f-detect-report" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-prepare" sourceRef="report" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-receive" sourceRef="prepare" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decision1" sourceRef="receive" targetRef="decision1" />
    <bpmn:sequenceFlow id="f-decision1-ask_corr" sourceRef="decision1" targetRef="ask_corr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsCorrection</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision1-provide_clar" sourceRef="decision1" targetRef="provide_clar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hrHasQuestions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision1-approve" sourceRef="decision1" targetRef="approve" />
    <bpmn:sequenceFlow id="f-ask_corr-revise" sourceRef="ask_corr" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-receive" sourceRef="revise" targetRef="receive" />
    <bpmn:sequenceFlow id="f-provide_clar-hr_q" sourceRef="provide_clar" targetRef="hr_q" />
    <bpmn:sequenceFlow id="f-hr_q-receive" sourceRef="hr_q" targetRef="receive" />
    <bpmn:sequenceFlow id="f-approve-e" sourceRef="approve" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
