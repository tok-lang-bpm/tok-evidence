tok 1.0
pool org "Organization"
  lane head "Head of Functional Department"
    start s
    task detect "detect personnel requirements"
    task report "report vacancy to Personnel Department"
    task receive "receive job description"
    xor decision1 "Is job description ready?"
    task ask_corr "ask for corrections again"
    task provide_clar "provide clarifications"
    task approve "approve job description"
    end e
  lane personnel "Personnel Department"
    task prepare "prepare job description"
    task revise "revise job description"
  lane hr "HR Department"
    task hr_q "ask clarification questions"
flow s -> detect
flow detect -> report
flow report -> prepare
flow prepare -> receive
flow receive -> decision1
flow decision1 -> ask_corr when="needsCorrection"
flow decision1 -> provide_clar when="hrHasQuestions"
flow decision1 -> approve default
flow ask_corr -> revise
flow revise -> receive
flow provide_clar -> hr_q
flow hr_q -> receive
flow approve -> e
