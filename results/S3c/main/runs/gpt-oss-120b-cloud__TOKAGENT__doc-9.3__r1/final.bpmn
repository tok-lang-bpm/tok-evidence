<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="tpa" name="Town Planning Authority" processRef="tpa-process" />
  </bpmn:collaboration>
  <bpmn:process id="tpa-process" name="Town Planning Authority" isExecutable="false">
    <bpmn:laneSet id="tpa-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft-schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck-dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check-dates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>committee-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="draft-schedule" name="draft schedule and add draft dates to calendars" />
    <bpmn:task id="recheck-dates" name="recheck dates and look for potential conflicts" />
    <bpmn:task id="send-final" name="send final schedule to Committee Members" />
    <bpmn:task id="check-dates" name="check dates and suggest modifications" />
    <bpmn:task id="committee-review" name="check diaries and advise Coordination Unit of conflicts" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-draft-schedule" sourceRef="s" targetRef="draft-schedule" />
    <bpmn:sequenceFlow id="f-draft-schedule-check-dates" sourceRef="draft-schedule" targetRef="check-dates" />
    <bpmn:sequenceFlow id="f-check-dates-recheck-dates" sourceRef="check-dates" targetRef="recheck-dates" />
    <bpmn:sequenceFlow id="f-recheck-dates-send-final" sourceRef="recheck-dates" targetRef="send-final" />
    <bpmn:sequenceFlow id="f-send-final-committee-review" sourceRef="send-final" targetRef="committee-review" />
    <bpmn:sequenceFlow id="f-committee-review-e" sourceRef="committee-review" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
