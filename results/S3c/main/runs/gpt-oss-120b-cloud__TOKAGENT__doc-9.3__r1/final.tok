tok 1.0

pool tpa "Town Planning Authority"
  lane coordination "Coordination Unit"
    start s "Start"
    task draft-schedule "draft schedule and add draft dates to calendars"
    task recheck-dates "recheck dates and look for potential conflicts"
    task send-final "send final schedule to Committee Members"
  lane support "Support Officer"
    task check-dates "check dates and suggest modifications"
  lane committee "Committee Members"
    task committee-review "check diaries and advise Coordination Unit of conflicts"
    end e "End"

flow s -> draft-schedule
flow draft-schedule -> check-dates
flow check-dates -> recheck-dates
flow recheck-dates -> send-final
flow send-final -> committee-review
flow committee-review -> e
