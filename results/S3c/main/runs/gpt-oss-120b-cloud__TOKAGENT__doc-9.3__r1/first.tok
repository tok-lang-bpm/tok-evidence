tok 1.0

pool tpa "Town Planning Authority" {
  lane coordination "Coordination Unit"
  lane support "Support Officer"
  lane committee "Committee Members"
}

task draft-schedule "draft schedule and add draft dates to calendars" lane=coordination
task check-dates "check dates and suggest modifications" lane=support
task recheck-dates "recheck dates and look for potential conflicts" lane=coordination
task send-final "send final schedule to Committee Members" lane=coordination
task committee-review "check diaries and advise Coordination Unit of conflicts" lane=committee

start
end

flow start -> draft-schedule
flow draft-schedule -> check-dates
flow check-dates -> recheck-dates
flow recheck-dates -> send-final
flow send-final -> committee-review
flow committee-review -> end
