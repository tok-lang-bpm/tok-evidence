<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize-dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>update-calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise-committee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce-minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-records</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>read-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold-meeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="finalize-dates" name="Finalize dates" />
    <bpmn:task id="qa-check" name="Conduct QA check on minutes" />
    <bpmn:task id="send-minutes" name="Send minutes to Committee Members" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="update-calendars" name="Update calendars, create meeting folders and upload documents" />
    <bpmn:task id="advise-committee" name="Advise Committee Members" />
    <bpmn:task id="produce-minutes" name="Produce minutes with action points" />
    <bpmn:task id="update-records" name="Update departmental records" />
    <bpmn:task id="read-documents" name="Read related documents" />
    <bpmn:task id="hold-meeting" name="Hold meeting" />
    <bpmn:sequenceFlow id="f-s-finalize-dates" sourceRef="s" targetRef="finalize-dates" />
    <bpmn:sequenceFlow id="f-finalize-dates-update-calendars" sourceRef="finalize-dates" targetRef="update-calendars" />
    <bpmn:sequenceFlow id="f-update-calendars-advise-committee" sourceRef="update-calendars" targetRef="advise-committee" />
    <bpmn:sequenceFlow id="f-advise-committee-read-documents" sourceRef="advise-committee" targetRef="read-documents" />
    <bpmn:sequenceFlow id="f-read-documents-hold-meeting" sourceRef="read-documents" targetRef="hold-meeting" />
    <bpmn:sequenceFlow id="f-hold-meeting-produce-minutes" sourceRef="hold-meeting" targetRef="produce-minutes" />
    <bpmn:sequenceFlow id="f-produce-minutes-qa-check" sourceRef="produce-minutes" targetRef="qa-check" />
    <bpmn:sequenceFlow id="f-qa-check-send-minutes" sourceRef="qa-check" targetRef="send-minutes" />
    <bpmn:sequenceFlow id="f-send-minutes-update-records" sourceRef="send-minutes" targetRef="update-records" />
    <bpmn:sequenceFlow id="f-update-records-e" sourceRef="update-records" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
