tok 1.0

pool org "Organisation"
  lane coordination "Coordination Unit"
    start s "Start"
    task finalize-dates "Finalize dates"
    task qa-check "Conduct QA check on minutes"
    task send-minutes "Send minutes to Committee Members"
    end e "End"
  lane support "Support Officer"
    task update-calendars "Update calendars, create meeting folders and upload documents"
    task advise-committee "Advise Committee Members"
    task produce-minutes "Produce minutes with action points"
    task update-records "Update departmental records"
  lane committee "Committee Members"
    task read-documents "Read related documents"
    task hold-meeting "Hold meeting"

flow s -> finalize-dates
flow finalize-dates -> update-calendars
flow update-calendars -> advise-committee
flow advise-committee -> read-documents
flow read-documents -> hold-meeting
flow hold-meeting -> produce-minutes
flow produce-minutes -> qa-check
flow qa-check -> send-minutes
flow send-minutes -> update-records
flow update-records -> e
