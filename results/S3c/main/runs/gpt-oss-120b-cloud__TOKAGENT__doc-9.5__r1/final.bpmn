<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Company" name="Company" processRef="Company-process" />
  </bpmn:collaboration>
  <bpmn:process id="Company-process" name="Company" isExecutable="false">
    <bpmn:laneSet id="Company-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>check-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auto-approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-supervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>supervisor-approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-progress-email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-cancellation-email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reimbursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer30</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="receive-report" name="Receive Expense Report" />
    <bpmn:exclusiveGateway id="check-account" name="Employee has account?" />
    <bpmn:exclusiveGateway id="amount-decision" name="Amount under $200?" />
    <bpmn:exclusiveGateway id="approval-decision" name="Supervisor approves?" />
    <bpmn:task id="create-account" name="Create New Account" />
    <bpmn:task id="review-report" name="Review Expense Report for Automatic Approval" />
    <bpmn:task id="auto-approve" name="Automatically Approve Expense Report" />
    <bpmn:task id="request-supervisor" name="Request Supervisor Approval" />
    <bpmn:task id="supervisor-approval" name="Supervisor Approves Expense Report" />
    <bpmn:task id="send-progress-email" name="Send Approval In Progress Email" />
    <bpmn:task id="send-cancellation-email" name="Send Cancellation Notice Email" />
    <bpmn:task id="resubmit-report" name="Resubmit Expense Report" />
    <bpmn:task id="rejection-email" name="Send Rejection Notice Email" />
    <bpmn:task id="reimbursement" name="Reimburse to Direct Deposit" />
    <bpmn:endEvent id="end-success" name="End" />
    <bpmn:endEvent id="end-reject" name="End" />
    <bpmn:endEvent id="end-cancel" name="End" />
    <bpmn:boundaryEvent id="timer7" attachedToRef="supervisor-approval" cancelActivity="false">
      <bpmn:timerEventDefinition id="timer7-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="timer30" attachedToRef="supervisor-approval">
      <bpmn:timerEventDefinition id="timer30-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f-start-receive-report" sourceRef="start" targetRef="receive-report" />
    <bpmn:sequenceFlow id="f-receive-report-check-account" sourceRef="receive-report" targetRef="check-account" />
    <bpmn:sequenceFlow id="f-check-account-create-account" name="no" sourceRef="check-account" targetRef="create-account" />
    <bpmn:sequenceFlow id="f-check-account-review-report" name="yes" sourceRef="check-account" targetRef="review-report" />
    <bpmn:sequenceFlow id="f-create-account-review-report" sourceRef="create-account" targetRef="review-report" />
    <bpmn:sequenceFlow id="f-review-report-amount-decision" sourceRef="review-report" targetRef="amount-decision" />
    <bpmn:sequenceFlow id="f-amount-decision-auto-approve" name="yes" sourceRef="amount-decision" targetRef="auto-approve" />
    <bpmn:sequenceFlow id="f-amount-decision-request-supervisor" name="no" sourceRef="amount-decision" targetRef="request-supervisor" />
    <bpmn:sequenceFlow id="f-auto-approve-reimbursement" sourceRef="auto-approve" targetRef="reimbursement" />
    <bpmn:sequenceFlow id="f-request-supervisor-supervisor-approval" sourceRef="request-supervisor" targetRef="supervisor-approval" />
    <bpmn:sequenceFlow id="f-supervisor-approval-approval-decision" sourceRef="supervisor-approval" targetRef="approval-decision" />
    <bpmn:sequenceFlow id="f-approval-decision-rejection-email" name="reject" sourceRef="approval-decision" targetRef="rejection-email" />
    <bpmn:sequenceFlow id="f-rejection-email-end-reject" sourceRef="rejection-email" targetRef="end-reject" />
    <bpmn:sequenceFlow id="f-approval-decision-reimbursement" name="approve" sourceRef="approval-decision" targetRef="reimbursement" />
    <bpmn:sequenceFlow id="f-reimbursement-end-success" sourceRef="reimbursement" targetRef="end-success" />
    <bpmn:sequenceFlow id="f-timer7-send-progress-email" sourceRef="timer7" targetRef="send-progress-email" />
    <bpmn:sequenceFlow id="f-send-progress-email-supervisor-approval" sourceRef="send-progress-email" targetRef="supervisor-approval" />
    <bpmn:sequenceFlow id="f-timer30-send-cancellation-email" sourceRef="timer30" targetRef="send-cancellation-email" />
    <bpmn:sequenceFlow id="f-send-cancellation-email-resubmit-report" sourceRef="send-cancellation-email" targetRef="resubmit-report" />
    <bpmn:sequenceFlow id="f-resubmit-report-end-cancel" sourceRef="resubmit-report" targetRef="end-cancel" />
  </bpmn:process>
</bpmn:definitions>
