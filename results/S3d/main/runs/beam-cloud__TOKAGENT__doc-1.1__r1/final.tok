tok 1.0 "Customized bicycles"

pool company "Small company"
  lane sales "Sales department"
    start orderReceived "Order received"
    xor orderDecision "Order accepted?"
    and split "Inform departments"
    and join "All work done"
    task shipBicycle "Ship bicycle"
    end orderRejected "Order rejected"
    end orderShipped "Order shipped"
  lane storehouse "Storehouse"
    sub processParts "Process part list" sequential
      start partStart "Start part"
      task checkQuantity "Check required quantity"
      xor partAvailable "Part available?"
      task reservePart "Reserve part"
      task backOrderPart "Back-order part"
      end partEnd "Part processed"
  lane engineering "Engineering department"
    task prepareAssembly "Prepare assembling"
    task assembleBicycle "Assemble bicycle"

flow orderReceived -> orderDecision
flow orderDecision -> orderRejected "no" default
flow orderDecision -> split "yes" when=""
flow split -> processParts
flow split -> prepareAssembly
flow processParts -> join
flow prepareAssembly -> join -> assembleBicycle -> shipBicycle -> orderShipped

flow partStart -> checkQuantity -> partAvailable
flow partAvailable -> reservePart "yes" when=""
flow partAvailable -> backOrderPart "no" default
flow reservePart -> partEnd
flow backOrderPart -> partEnd
