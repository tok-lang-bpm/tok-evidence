<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Test" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="P" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Test" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="l" name="L">
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:subProcess id="sp" name="Process part">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">i &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
      <bpmn:startEvent id="s" name="S" />
      <bpmn:task id="t" name="Check" />
      <bpmn:endEvent id="e" name="E" />
      <bpmn:sequenceFlow id="f-s-t" sourceRef="s" targetRef="t" />
      <bpmn:sequenceFlow id="f-t-e" sourceRef="t" targetRef="e" />
    </bpmn:subProcess>
  </bpmn:process>
</bpmn:definitions>
