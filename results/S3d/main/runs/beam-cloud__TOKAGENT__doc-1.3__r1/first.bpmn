<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Room service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="evanstonian" name="The Evanstonian" processRef="evanstonian-process" />
  </bpmn:collaboration>
  <bpmn:process id="evanstonian-process" name="Room service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="evanstonian-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>start-call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-order-sommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handoff-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-waiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no-handoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare-food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch-wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ready-cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-nonalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-call" name="Guest calls room service" />
    <bpmn:task id="take-order" name="Take down order" />
    <bpmn:task id="submit-ticket" name="Submit order ticket to the kitchen" />
    <bpmn:exclusiveGateway id="gw-alcohol" name="Includes alcoholic beverage?" default="f-gw-alcohol-no-handoff" />
    <bpmn:task id="give-order-sommelier" name="Give order to sommelier" />
    <bpmn:parallelGateway id="handoff-gw" name="Hand off to sommelier and waiter" />
    <bpmn:task id="assign-waiter" name="Assign order to waiter" />
    <bpmn:parallelGateway id="no-handoff" name="Prepare no-alcohol branch" />
    <bpmn:task id="prepare-food" name="Prepare food" />
    <bpmn:task id="fetch-wine" name="Fetch wine from cellar and prepare alcoholic beverages" />
    <bpmn:task id="ready-cart" name="Ready a cart" />
    <bpmn:task id="prepare-nonalc" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="gw-join" name="Food, wine and cart ready" />
    <bpmn:task id="deliver" name="Deliver to guest's room" />
    <bpmn:task id="debit" name="Debit guest's account" />
    <bpmn:endEvent id="end-done" name="Service completed" />
    <bpmn:sequenceFlow id="f-start-call-take-order" sourceRef="start-call" targetRef="take-order" />
    <bpmn:sequenceFlow id="f-take-order-submit-ticket" sourceRef="take-order" targetRef="submit-ticket" />
    <bpmn:sequenceFlow id="f-submit-ticket-prepare-food" sourceRef="submit-ticket" targetRef="prepare-food" />
    <bpmn:sequenceFlow id="f-submit-ticket-gw-alcohol" sourceRef="submit-ticket" targetRef="gw-alcohol" />
    <bpmn:sequenceFlow id="f-gw-alcohol-give-order-sommelier" name="Yes" sourceRef="gw-alcohol" targetRef="give-order-sommelier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-give-order-sommelier-handoff-gw" sourceRef="give-order-sommelier" targetRef="handoff-gw" />
    <bpmn:sequenceFlow id="f-handoff-gw-fetch-wine" sourceRef="handoff-gw" targetRef="fetch-wine" />
    <bpmn:sequenceFlow id="f-handoff-gw-assign-waiter" sourceRef="handoff-gw" targetRef="assign-waiter" />
    <bpmn:sequenceFlow id="f-gw-alcohol-no-handoff" name="No" sourceRef="gw-alcohol" targetRef="no-handoff" />
    <bpmn:sequenceFlow id="f-no-handoff-assign-waiter" sourceRef="no-handoff" targetRef="assign-waiter" />
    <bpmn:sequenceFlow id="f-no-handoff-gw-join" sourceRef="no-handoff" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-assign-waiter-ready-cart" sourceRef="assign-waiter" targetRef="ready-cart" />
    <bpmn:sequenceFlow id="f-ready-cart-prepare-nonalc" sourceRef="ready-cart" targetRef="prepare-nonalc" />
    <bpmn:sequenceFlow id="f-prepare-nonalc-gw-join" sourceRef="prepare-nonalc" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-prepare-food-gw-join" sourceRef="prepare-food" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-fetch-wine-gw-join" sourceRef="fetch-wine" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-gw-join-deliver" sourceRef="gw-join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-debit" sourceRef="deliver" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-end-done" sourceRef="debit" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
