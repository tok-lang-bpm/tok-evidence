tok 1.0 "Room service at The Evanstonian"

pool evanstonian "The Evanstonian"
  lane manager "Room-service manager"
    start start-call "Guest calls room service"
    task take-order "Take down order"
    task submit-ticket "Submit order ticket to the kitchen"
    xor gw-alcohol "Includes alcoholic beverage?"
    task give-order-sommelier "Give order to sommelier"
    and handoff-gw "Hand off to sommelier and waiter"
    task assign-waiter "Assign order to waiter"
    and no-handoff "Prepare no-alcohol branch"
  lane kitchen "Kitchen"
    task prepare-food "Prepare food"
  lane sommelier "Sommelier"
    task fetch-wine "Fetch wine from cellar and prepare alcoholic beverages"
  lane waiter "Waiter"
    task ready-cart "Ready a cart"
    task prepare-nonalc "Prepare nonalcoholic drinks"
    and gw-join "Food, wine and cart ready"
    task deliver "Deliver to guest's room"
    task debit "Debit guest's account"
    end end-done "Service completed"

flow start-call -> take-order
flow take-order -> submit-ticket
flow submit-ticket -> prepare-food
flow submit-ticket -> gw-alcohol
flow gw-alcohol -> give-order-sommelier "Yes" when=""
flow give-order-sommelier -> handoff-gw
flow handoff-gw -> fetch-wine
flow handoff-gw -> assign-waiter
flow gw-alcohol -> no-handoff "No" default
flow no-handoff -> assign-waiter
flow no-handoff -> gw-join
flow assign-waiter -> ready-cart
flow ready-cart -> prepare-nonalc
flow prepare-nonalc -> gw-join
flow prepare-food -> gw-join
flow fetch-wine -> gw-join
flow gw-join -> deliver
flow deliver -> debit
flow debit -> end-done