<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="IPO process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Company going public" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="IPO process" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-underwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>provide-advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>facts-fair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-sec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blue-sky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-reg-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm-price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>road-show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-prep-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix-price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm-commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-public</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>approve-reg</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Decision to go public" />
    <bpmn:task id="select-underwriters" name="Select underwriters" />
    <bpmn:task id="provide-advice" name="Provide procedural and financial advice" />
    <bpmn:exclusiveGateway id="facts-fair" name="Facts presented fairly?" default="f-facts-fair-e-declined" />
    <bpmn:task id="prepare-reg" name="Prepare registration statement" />
    <bpmn:parallelGateway id="g-work" name="Parallel registration and preparation" />
    <bpmn:parallelGateway id="g-reg" name="Register and check compliance" />
    <bpmn:task id="register-sec" name="Register issue with SEC" />
    <bpmn:task id="blue-sky" name="Check blue-sky laws compliance" />
    <bpmn:parallelGateway id="g-reg-join" name="Registration and compliance done" />
    <bpmn:parallelGateway id="g-prep" name="Prepare while awaiting approval" />
    <bpmn:task id="firm-price" name="Firm up issue price" />
    <bpmn:task id="road-show" name="Arrange road show" />
    <bpmn:parallelGateway id="g-prep-join" name="Price and road show ready" />
    <bpmn:parallelGateway id="g-ready" name="Ready to proceed" />
    <bpmn:task id="fix-price" name="Fix issue price" />
    <bpmn:exclusiveGateway id="reasons" name="Any reason not to proceed?" default="f-reasons-e-cancelled" />
    <bpmn:task id="firm-commit" name="Enter firm commitment to buy stock" />
    <bpmn:task id="offer-public" name="Offer stock to public" />
    <bpmn:endEvent id="e-declined" name="Issue not handled" />
    <bpmn:endEvent id="e-cancelled" name="Offering withdrawn" />
    <bpmn:endEvent id="e-done" name="Stock offered to public" />
    <bpmn:task id="approve-reg" name="Approve registration statement" />
    <bpmn:sequenceFlow id="f-s-select-underwriters" sourceRef="s" targetRef="select-underwriters" />
    <bpmn:sequenceFlow id="f-select-underwriters-provide-advice" sourceRef="select-underwriters" targetRef="provide-advice" />
    <bpmn:sequenceFlow id="f-provide-advice-facts-fair" sourceRef="provide-advice" targetRef="facts-fair" />
    <bpmn:sequenceFlow id="f-facts-fair-prepare-reg" name="Yes" sourceRef="facts-fair" targetRef="prepare-reg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-facts-fair-e-declined" name="No" sourceRef="facts-fair" targetRef="e-declined" />
    <bpmn:sequenceFlow id="f-prepare-reg-g-work" sourceRef="prepare-reg" targetRef="g-work" />
    <bpmn:sequenceFlow id="f-g-work-g-reg" sourceRef="g-work" targetRef="g-reg" />
    <bpmn:sequenceFlow id="f-g-work-g-prep" sourceRef="g-work" targetRef="g-prep" />
    <bpmn:sequenceFlow id="f-g-reg-register-sec" sourceRef="g-reg" targetRef="register-sec" />
    <bpmn:sequenceFlow id="f-g-reg-blue-sky" sourceRef="g-reg" targetRef="blue-sky" />
    <bpmn:sequenceFlow id="f-register-sec-approve-reg" sourceRef="register-sec" targetRef="approve-reg" />
    <bpmn:sequenceFlow id="f-approve-reg-g-reg-join" sourceRef="approve-reg" targetRef="g-reg-join" />
    <bpmn:sequenceFlow id="f-blue-sky-g-reg-join" sourceRef="blue-sky" targetRef="g-reg-join" />
    <bpmn:sequenceFlow id="f-g-prep-firm-price" sourceRef="g-prep" targetRef="firm-price" />
    <bpmn:sequenceFlow id="f-g-prep-road-show" sourceRef="g-prep" targetRef="road-show" />
    <bpmn:sequenceFlow id="f-firm-price-g-prep-join" sourceRef="firm-price" targetRef="g-prep-join" />
    <bpmn:sequenceFlow id="f-road-show-g-prep-join" sourceRef="road-show" targetRef="g-prep-join" />
    <bpmn:sequenceFlow id="f-g-reg-join-g-ready" sourceRef="g-reg-join" targetRef="g-ready" />
    <bpmn:sequenceFlow id="f-g-prep-join-g-ready" sourceRef="g-prep-join" targetRef="g-ready" />
    <bpmn:sequenceFlow id="f-g-ready-fix-price" sourceRef="g-ready" targetRef="fix-price" />
    <bpmn:sequenceFlow id="f-fix-price-reasons" sourceRef="fix-price" targetRef="reasons" />
    <bpmn:sequenceFlow id="f-reasons-firm-commit" name="No" sourceRef="reasons" targetRef="firm-commit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reasons-e-cancelled" name="Yes" sourceRef="reasons" targetRef="e-cancelled" />
    <bpmn:sequenceFlow id="f-firm-commit-offer-public" sourceRef="firm-commit" targetRef="offer-public" />
    <bpmn:sequenceFlow id="f-offer-public-e-done" sourceRef="offer-public" targetRef="e-done" />
  </bpmn:process>
</bpmn:definitions>
