tok 1.0 "IPO process"

pool p "Company going public"
  lane company "Company"
    start s "Decision to go public"
    task select-underwriters "Select underwriters"
  lane underwriters "Underwriters"
    task provide-advice "Provide procedural and financial advice"
    xor facts-fair "Facts presented fairly?"
    task prepare-reg "Prepare registration statement"
    and g-work "Parallel registration and preparation"
    and g-reg "Register and check compliance"
    task register-sec "Register issue with SEC"
    task blue-sky "Check blue-sky laws compliance"
    and g-reg-join "Registration and compliance done"
    and g-prep "Prepare while awaiting approval"
    task firm-price "Firm up issue price"
    task road-show "Arrange road show"
    and g-prep-join "Price and road show ready"
    and g-ready "Ready to proceed"
    task fix-price "Fix issue price"
    xor reasons "Any reason not to proceed?"
    task firm-commit "Enter firm commitment to buy stock"
    task offer-public "Offer stock to public"
    end e-declined "Issue not handled"
    end e-cancelled "Offering withdrawn"
    end e-done "Stock offered to public"
  lane sec "SEC"
    task approve-reg "Approve registration statement"

flow s -> select-underwriters
flow select-underwriters -> provide-advice
flow provide-advice -> facts-fair
flow facts-fair -> prepare-reg "Yes" when=""
flow facts-fair -> e-declined "No" default
flow prepare-reg -> g-work
flow g-work -> g-reg
flow g-work -> g-prep
flow g-reg -> register-sec
flow g-reg -> blue-sky
flow register-sec -> approve-reg
flow approve-reg -> g-reg-join
flow blue-sky -> g-reg-join
flow g-prep -> firm-price
flow g-prep -> road-show
flow firm-price -> g-prep-join
flow road-show -> g-prep-join
flow g-reg-join -> g-ready
flow g-prep-join -> g-ready
flow g-ready -> fix-price
flow fix-price -> reasons
flow reasons -> firm-commit "No" when=""
flow reasons -> e-cancelled "Yes" default
flow firm-commit -> offer-public
flow offer-public -> e-done
