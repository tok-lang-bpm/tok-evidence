<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="P" name="Fault processing" processRef="P-process" />
  </bpmn:collaboration>
  <bpmn:process id="P-process" name="Fault processing" isExecutable="false">
    <bpmn:laneSet id="P-lanes">
      <bpmn:lane id="FD" name="Fault detector">
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPO" name="MPO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_go_msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="report" name="Report failure" />
    <bpmn:startEvent id="s" name="Failure reported or suspected" />
    <bpmn:exclusiveGateway id="g0" name="Fault source?" />
    <bpmn:task id="examine" name="Examine failure" />
    <bpmn:exclusiveGateway id="g1" name="Failure confirmed?" />
    <bpmn:task id="inform_go_msp" name="Inform GO and MSP about failure" />
    <bpmn:task id="fix" name="Fix fault at measuring device" />
    <bpmn:task id="share" name="Share repair results with fault detector" />
    <bpmn:task id="inform_go" name="Inform GO about resolution" />
    <bpmn:task id="inform_msp" name="Inform MSP about resolution" />
    <bpmn:endEvent id="end_ok" name="Interference resolved" />
    <bpmn:endEvent id="end_rejected" name="Failure rejected" />
    <bpmn:sequenceFlow id="f-s-g0" sourceRef="s" targetRef="g0" />
    <bpmn:sequenceFlow id="f-g0-report" name="Reported by fault detector" sourceRef="g0" targetRef="report" />
    <bpmn:sequenceFlow id="f-g0-examine" name="MPO suspicion" sourceRef="g0" targetRef="examine" />
    <bpmn:sequenceFlow id="f-report-examine" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-g1" sourceRef="examine" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-inform_go_msp" name="Confirmed" sourceRef="g1" targetRef="inform_go_msp" />
    <bpmn:sequenceFlow id="f-g1-end_rejected" name="Rejected" sourceRef="g1" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f-inform_go_msp-fix" sourceRef="inform_go_msp" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-inform_go" sourceRef="share" targetRef="inform_go" />
    <bpmn:sequenceFlow id="f-inform_go-inform_msp" sourceRef="inform_go" targetRef="inform_msp" />
    <bpmn:sequenceFlow id="f-inform_msp-end_ok" sourceRef="inform_msp" targetRef="end_ok" />
  </bpmn:process>
</bpmn:definitions>
