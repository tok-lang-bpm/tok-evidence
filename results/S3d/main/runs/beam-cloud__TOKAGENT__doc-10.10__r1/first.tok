tok 1.0
pool P "Fault processing"
  lane FD "Fault detector"
    task report "Report failure"
  lane MPO "MPO"
    start s "Failure reported or suspected"
    xor g0 "Fault source?"
    task examine "Examine failure"
    xor g1 "Failure confirmed?"
    task inform_go_msp "Inform GO and MSP about failure"
    task fix "Fix fault at measuring device"
    task share "Share repair results with fault detector"
    task inform_go "Inform GO about resolution"
    task inform_msp "Inform MSP about resolution"
    end end_ok "Interference resolved"
    end end_rejected "Failure rejected"
flow s -> g0
flow g0 -> report "Reported by fault detector"
flow g0 -> examine "MPO suspicion"
flow report -> examine
flow examine -> g1
flow g1 -> inform_go_msp "Confirmed"
flow g1 -> end_rejected "Rejected"
flow inform_go_msp -> fix
flow fix -> share
flow share -> inform_go
flow inform_go -> inform_msp
flow inform_msp -> end_ok
