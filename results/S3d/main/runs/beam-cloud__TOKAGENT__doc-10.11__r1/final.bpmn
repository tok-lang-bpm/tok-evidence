<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="GO MSP SP process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="GO MSP SP process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_measurements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_measured_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_changed_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_readings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_measurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="request_measurements" name="Request measurements" />
    <bpmn:task id="process_measured_values" name="Process measured values" />
    <bpmn:task id="send_changed_values" name="Send changed values to MSP" />
    <bpmn:task id="transmit_readings" name="Transmit readings to SP" />
    <bpmn:endEvent id="e_success" name="End" />
    <bpmn:task id="check_request" name="Check received request" />
    <bpmn:exclusiveGateway id="decide" name="Deny request or perform measurement?" />
    <bpmn:task id="deny_request" name="Deny request" />
    <bpmn:task id="perform_measurement" name="Perform measurement" />
    <bpmn:task id="inform_failure" name="Inform GO about failure of reading" />
    <bpmn:task id="transmit_values" name="Transmit measured values to GO" />
    <bpmn:endEvent id="e_failure" name="End" />
    <bpmn:sequenceFlow id="f-s-request_measurements" sourceRef="s" targetRef="request_measurements" />
    <bpmn:sequenceFlow id="f-request_measurements-check_request" sourceRef="request_measurements" targetRef="check_request" />
    <bpmn:sequenceFlow id="f-check_request-decide" sourceRef="check_request" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-deny_request" name="Deny request" sourceRef="decide" targetRef="deny_request" />
    <bpmn:sequenceFlow id="f-decide-perform_measurement" name="Perform measurement" sourceRef="decide" targetRef="perform_measurement" />
    <bpmn:sequenceFlow id="f-deny_request-inform_failure" sourceRef="deny_request" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="f-inform_failure-e_failure" sourceRef="inform_failure" targetRef="e_failure" />
    <bpmn:sequenceFlow id="f-perform_measurement-transmit_values" sourceRef="perform_measurement" targetRef="transmit_values" />
    <bpmn:sequenceFlow id="f-transmit_values-process_measured_values" sourceRef="transmit_values" targetRef="process_measured_values" />
    <bpmn:sequenceFlow id="f-process_measured_values-send_changed_values" sourceRef="process_measured_values" targetRef="send_changed_values" />
    <bpmn:sequenceFlow id="f-send_changed_values-transmit_readings" sourceRef="send_changed_values" targetRef="transmit_readings" />
    <bpmn:sequenceFlow id="f-transmit_readings-e_success" sourceRef="transmit_readings" targetRef="e_success" />
  </bpmn:process>
</bpmn:definitions>
