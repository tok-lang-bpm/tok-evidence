<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Master data change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Master data change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ec_tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>inq_notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>ip_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ip_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ip_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ip_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="ec_tell" name="tell the INQ about the change of his master data" />
    <bpmn:task id="inq_notify" name="notify the IP of the change" />
    <bpmn:task id="ip_check" name="check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="ip_decision" name="Can master data be changed at the desired time?" default="f-ip_decision-ip_reject" />
    <bpmn:task id="ip_confirm" name="confirm the changes of the INQ" />
    <bpmn:task id="ip_reject" name="reject the changes of the INQ" />
    <bpmn:endEvent id="e_confirm" name="End" />
    <bpmn:endEvent id="e_reject" name="End" />
    <bpmn:sequenceFlow id="f-s-ec_tell" sourceRef="s" targetRef="ec_tell" />
    <bpmn:sequenceFlow id="f-ec_tell-inq_notify" sourceRef="ec_tell" targetRef="inq_notify" />
    <bpmn:sequenceFlow id="f-inq_notify-ip_check" sourceRef="inq_notify" targetRef="ip_check" />
    <bpmn:sequenceFlow id="f-ip_check-ip_decision" sourceRef="ip_check" targetRef="ip_decision" />
    <bpmn:sequenceFlow id="f-ip_decision-ip_confirm" name="yes" sourceRef="ip_decision" targetRef="ip_confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">canChange = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ip_decision-ip_reject" name="no" sourceRef="ip_decision" targetRef="ip_reject" />
    <bpmn:sequenceFlow id="f-ip_confirm-e_confirm" sourceRef="ip_confirm" targetRef="e_confirm" />
    <bpmn:sequenceFlow id="f-ip_reject-e_reject" sourceRef="ip_reject" targetRef="e_reject" />
  </bpmn:process>
</bpmn:definitions>
