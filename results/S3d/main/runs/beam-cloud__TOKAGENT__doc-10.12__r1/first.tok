tok 1.0 "Master data change"

pool org "Organisation"
  lane ec "EC"
    start s "Start"
    task ec_tell "tell the INQ about the change of his master data"
  lane inq "INQ"
    task inq_notify "notify the IP of the change"
  lane ip "IP"
    task ip_check "check whether the master data can be changed at the desired time"
    xor ip_decision "Can master data be changed at the desired time?"
    task ip_confirm "confirm the changes of the INQ"
    task ip_reject "reject the changes of the INQ"
    end e_confirm "End"
    end e_reject "End"

flow s -> ec_tell
flow ec_tell -> inq_notify
flow inq_notify -> ip_check
flow ip_check -> ip_decision
flow ip_decision -> ip_confirm "yes" default
flow ip_decision -> ip_reject "no"
flow ip_confirm -> e_confirm
flow ip_reject -> e_reject
