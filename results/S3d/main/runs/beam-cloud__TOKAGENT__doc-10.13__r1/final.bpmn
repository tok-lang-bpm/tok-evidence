<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="INQ transaction data request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="INQ transaction data request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t1" name="Transmit transaction data request" />
    <bpmn:task id="t2" name="Check request of the INQ" />
    <bpmn:exclusiveGateway id="g" name="Outcome of examination?" default="f-g-t4" />
    <bpmn:task id="t3" name="Transmission of data" />
    <bpmn:task id="t4" name="Rejection" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:endEvent id="e2" name="End" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-g" sourceRef="t2" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-t3" name="Transmission of data" sourceRef="g" targetRef="t3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-t4" name="Rejection" sourceRef="g" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t3-e1" sourceRef="t3" targetRef="e1" />
    <bpmn:sequenceFlow id="f-t4-e2" sourceRef="t4" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
