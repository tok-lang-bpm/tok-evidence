tok 1.0 "INQ transaction data request"

pool org "Organisation"
  lane inq "INQ"
    start s "Start"
    task t1 "Transmit transaction data request"
  lane ip "IP"
    task t2 "Check request of the INQ"
    xor g "Outcome of examination?"
    task t3 "Transmission of data"
    task t4 "Rejection"
    end e1 "End"
    end e2 "End"

flow s -> t1 -> t2 -> g
flow g -> t3 "Transmission of data" when=""
flow g -> t4 "Rejection" default
flow t3 -> e1
flow t4 -> e2
