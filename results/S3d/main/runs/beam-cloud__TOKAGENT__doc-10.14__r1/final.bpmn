<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Invoice Handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Invoice Handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>send2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>ex_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gdec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>ex_mp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send1" name="send bill for temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="send4" name="send bill for equipment acquisition to the MPON or the GO" />
    <bpmn:exclusiveGateway id="g0" name="Which bill scenario?" default="f-g0-send4" />
    <bpmn:exclusiveGateway id="grec" name="Recipient of equipment bill?" default="f-grec-ex_mp" />
    <bpmn:task id="send2" name="send bill for temporary continuation of the measurement to the GO" />
    <bpmn:task id="send3" name="send bill for additional readings to the GO" />
    <bpmn:task id="ex_go" name="examine the bill" />
    <bpmn:task id="conf" name="GO or MPON confirms the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="rej" name="GO or MPON rejects the invoice of the MPOO or the MSPO" />
    <bpmn:exclusiveGateway id="gjoin" name="Join" />
    <bpmn:exclusiveGateway id="gdec" name="Confirm or reject?" default="f-gdec-rej" />
    <bpmn:endEvent id="e_conf" name="End" />
    <bpmn:endEvent id="e_rej" name="End" />
    <bpmn:task id="ex_mp" name="examine the bill" />
    <bpmn:sequenceFlow id="f-s-g0" sourceRef="s" targetRef="g0" />
    <bpmn:sequenceFlow id="f-g0-send1" sourceRef="g0" targetRef="send1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g0-send2" sourceRef="g0" targetRef="send2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g0-send3" sourceRef="g0" targetRef="send3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g0-send4" sourceRef="g0" targetRef="send4" />
    <bpmn:sequenceFlow id="f-send1-ex_go" sourceRef="send1" targetRef="ex_go" />
    <bpmn:sequenceFlow id="f-send2-ex_go" sourceRef="send2" targetRef="ex_go" />
    <bpmn:sequenceFlow id="f-send3-ex_go" sourceRef="send3" targetRef="ex_go" />
    <bpmn:sequenceFlow id="f-send4-grec" sourceRef="send4" targetRef="grec" />
    <bpmn:sequenceFlow id="f-grec-ex_go" sourceRef="grec" targetRef="ex_go">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-grec-ex_mp" sourceRef="grec" targetRef="ex_mp" />
    <bpmn:sequenceFlow id="f-ex_go-gjoin" sourceRef="ex_go" targetRef="gjoin" />
    <bpmn:sequenceFlow id="f-ex_mp-gjoin" sourceRef="ex_mp" targetRef="gjoin" />
    <bpmn:sequenceFlow id="f-gjoin-gdec" sourceRef="gjoin" targetRef="gdec" />
    <bpmn:sequenceFlow id="f-gdec-conf" sourceRef="gdec" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gdec-rej" sourceRef="gdec" targetRef="rej" />
    <bpmn:sequenceFlow id="f-conf-e_conf" sourceRef="conf" targetRef="e_conf" />
    <bpmn:sequenceFlow id="f-rej-e_rej" sourceRef="rej" targetRef="e_rej" />
  </bpmn:process>
</bpmn:definitions>
