tok 1.0 "Invoice Handling"
pool organisation "Organisation"
  lane MPOO "MPOO"
    start s "Start"
    task send1 "send bill for temporary continuation of the metering point operations to the GO"
    task send4 "send bill for equipment acquisition to the MPON or the GO"
    xor g0 "Which bill scenario?"
    xor grec "Recipient of equipment bill?"
  lane MSPO "MSPO"
    task send2 "send bill for temporary continuation of the measurement to the GO"
    task send3 "send bill for additional readings to the GO"
  lane GO "GO"
    task ex_go "examine the bill"
    task conf "GO or MPON confirms the invoice with payment advice to the MPOO or the MSPO"
    task rej "GO or MPON rejects the invoice of the MPOO or the MSPO"
    xor gjoin "Join"
    xor gdec "Confirm or reject?"
    end e_conf "End"
    end e_rej "End"
  lane MPON "MPON"
    task ex_mp "examine the bill"

flow s -> g0
flow g0 -> send1 when=""
flow g0 -> send2 when=""
flow g0 -> send3 when=""
flow g0 -> send4 default
flow send1 -> ex_go
flow send2 -> ex_go
flow send3 -> ex_go
flow send4 -> grec
flow grec -> ex_go when=""
flow grec -> ex_mp default
flow ex_go -> gjoin
flow ex_mp -> gjoin
flow gjoin -> gdec
flow gdec -> conf when=""
flow gdec -> rej default
flow conf -> e_conf
flow rej -> e_rej
