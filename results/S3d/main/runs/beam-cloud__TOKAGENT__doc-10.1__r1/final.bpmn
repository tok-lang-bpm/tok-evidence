<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Dismissal process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send" name="Send the dismissal" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="dec" name="Oppose or confirm the dismissal of MPON?" />
    <bpmn:task id="opp" name="Oppose the dismissal of MPON" />
    <bpmn:task id="conf" name="Confirm the dismissal of MPON" />
    <bpmn:exclusiveGateway id="j" name="Join" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-dec" sourceRef="review" targetRef="dec" />
    <bpmn:sequenceFlow id="f-dec-opp" name="Opposes" sourceRef="dec" targetRef="opp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-dec-conf" name="Confirms" sourceRef="dec" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-opp-j" sourceRef="opp" targetRef="j" />
    <bpmn:sequenceFlow id="f-conf-j" sourceRef="conf" targetRef="j" />
    <bpmn:sequenceFlow id="f-j-e" sourceRef="j" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
