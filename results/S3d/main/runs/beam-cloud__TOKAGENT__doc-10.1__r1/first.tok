tok 1.0 "Dismissal process"

pool org "Organisation"
  lane mpon "MPON"
    start s "Start"
    task send "Send the dismissal"
  lane mpo "MPOO"
    task review "Review the dismissal"
    xor dec "Oppose or confirm the dismissal of MPON?"
    task opp "Oppose the dismissal of MPON"
    task conf "Confirm the dismissal of MPON"
    xor j "Join"
    end e "End"

flow s -> send
flow send -> review
flow review -> dec
flow dec -> opp "Opposes" when=""
flow dec -> conf "Confirms" when=""
flow opp -> j
flow conf -> j
flow j -> e
