<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meter operation process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meter operation process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mp_on" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_meter_operation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mp_on_perform_equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mp_on_inform_go_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mp_on_inform_go_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_registration_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_ms_po_registration_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mp_on_failure_overall_transaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_mp_on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_ms_po_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_ms_po_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_registration_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_perform_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_perform_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mp_oo" name="MPOO">
        <bpmn:flowNodeRef>mp_oo_perform_equipment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ms_po" name="MSPO" />
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="report_meter_operation" name="report meter operation" />
    <bpmn:task id="mp_on_perform_equipment" name="perform equipment acquisition and / or equipment changes" />
    <bpmn:task id="mp_on_inform_go_failure" name="inform GO about failure of entire process" />
    <bpmn:task id="mp_on_inform_go_success" name="inform GO about successful completion of entire process" />
    <bpmn:task id="examine_application" name="examine application" />
    <bpmn:task id="reject_application" name="reject application" />
    <bpmn:task id="confirm_application" name="confirm application" />
    <bpmn:task id="inform_mpoo_registration_confirmation" name="inform MPOO about registration confirmation" />
    <bpmn:task id="inform_ms_po_registration_confirmation" name="inform MSPO about registration confirmation" />
    <bpmn:task id="inform_mp_on_failure_overall_transaction" name="inform MPON about failure of overall transaction by deadline" />
    <bpmn:task id="confirm_failure_assignment" name="confirm failure of assignment to MPON" />
    <bpmn:task id="assign_mp_on" name="assign MPON" />
    <bpmn:task id="confirm_assignment" name="confirm assignment to MPON" />
    <bpmn:task id="inform_mpoo_failure_assignment" name="inform MPOO about failure of assignment of MPON" />
    <bpmn:task id="inform_mpoo_assignment" name="inform MPOO about assignment of MPON" />
    <bpmn:task id="inform_ms_po_failure_assignment" name="inform MSPO about failure of assignment of MPON" />
    <bpmn:task id="inform_ms_po_assignment" name="inform MSPO about assignment of MPON" />
    <bpmn:task id="inform_sp_assignment" name="inform SP about assignment of MPON" />
    <bpmn:exclusiveGateway id="gw_application" name="reject or confirm application?" />
    <bpmn:parallelGateway id="gw_registration" name="inform MPOO and MSPO" />
    <bpmn:parallelGateway id="gw_registration_join" name="registration confirmed" />
    <bpmn:parallelGateway id="gw_perform_split" name="MPON and MPOO perform equipment acquisition and / or equipment changes" />
    <bpmn:parallelGateway id="gw_perform_join" name="equipment performed" />
    <bpmn:exclusiveGateway id="gw_result" name="inform GO about failure or success?" />
    <bpmn:exclusiveGateway id="gw_deadline" name="MPON message present at GO by deadline?" default="f-gw_deadline-inform_mp_on_failure_overall_transaction" />
    <bpmn:endEvent id="e_rejected" name="End (rejected)" />
    <bpmn:endEvent id="e_timeout" name="End (timeout)" />
    <bpmn:endEvent id="e_failure" name="End (failure)" />
    <bpmn:endEvent id="e_success" name="End (success)" />
    <bpmn:task id="mp_oo_perform_equipment" name="perform equipment acquisition and / or equipment changes" />
    <bpmn:sequenceFlow id="f-s-report_meter_operation" sourceRef="s" targetRef="report_meter_operation" />
    <bpmn:sequenceFlow id="f-report_meter_operation-examine_application" sourceRef="report_meter_operation" targetRef="examine_application" />
    <bpmn:sequenceFlow id="f-examine_application-gw_application" sourceRef="examine_application" targetRef="gw_application" />
    <bpmn:sequenceFlow id="f-gw_application-reject_application" name="reject application" sourceRef="gw_application" targetRef="reject_application" />
    <bpmn:sequenceFlow id="f-gw_application-confirm_application" name="confirm application" sourceRef="gw_application" targetRef="confirm_application" />
    <bpmn:sequenceFlow id="f-reject_application-e_rejected" sourceRef="reject_application" targetRef="e_rejected" />
    <bpmn:sequenceFlow id="f-confirm_application-gw_registration" sourceRef="confirm_application" targetRef="gw_registration" />
    <bpmn:sequenceFlow id="f-gw_registration-inform_mpoo_registration_confirmation" sourceRef="gw_registration" targetRef="inform_mpoo_registration_confirmation" />
    <bpmn:sequenceFlow id="f-gw_registration-inform_ms_po_registration_confirmation" sourceRef="gw_registration" targetRef="inform_ms_po_registration_confirmation" />
    <bpmn:sequenceFlow id="f-inform_mpoo_registration_confirmation-gw_registration_join" sourceRef="inform_mpoo_registration_confirmation" targetRef="gw_registration_join" />
    <bpmn:sequenceFlow id="f-inform_ms_po_registration_confirmation-gw_registration_join" sourceRef="inform_ms_po_registration_confirmation" targetRef="gw_registration_join" />
    <bpmn:sequenceFlow id="f-gw_registration_join-gw_perform_split" sourceRef="gw_registration_join" targetRef="gw_perform_split" />
    <bpmn:sequenceFlow id="f-gw_perform_split-mp_on_perform_equipment" sourceRef="gw_perform_split" targetRef="mp_on_perform_equipment" />
    <bpmn:sequenceFlow id="f-gw_perform_split-mp_oo_perform_equipment" sourceRef="gw_perform_split" targetRef="mp_oo_perform_equipment" />
    <bpmn:sequenceFlow id="f-mp_on_perform_equipment-gw_perform_join" sourceRef="mp_on_perform_equipment" targetRef="gw_perform_join" />
    <bpmn:sequenceFlow id="f-mp_oo_perform_equipment-gw_perform_join" sourceRef="mp_oo_perform_equipment" targetRef="gw_perform_join" />
    <bpmn:sequenceFlow id="f-gw_perform_join-gw_deadline" sourceRef="gw_perform_join" targetRef="gw_deadline" />
    <bpmn:sequenceFlow id="f-gw_deadline-inform_mp_on_failure_overall_transaction" name="no message" sourceRef="gw_deadline" targetRef="inform_mp_on_failure_overall_transaction" />
    <bpmn:sequenceFlow id="f-gw_deadline-gw_result" name="message present" sourceRef="gw_deadline" targetRef="gw_result" />
    <bpmn:sequenceFlow id="f-gw_result-mp_on_inform_go_failure" name="failure of entire process" sourceRef="gw_result" targetRef="mp_on_inform_go_failure" />
    <bpmn:sequenceFlow id="f-gw_result-mp_on_inform_go_success" name="successful completion of entire process" sourceRef="gw_result" targetRef="mp_on_inform_go_success" />
    <bpmn:sequenceFlow id="f-mp_on_inform_go_failure-confirm_failure_assignment" sourceRef="mp_on_inform_go_failure" targetRef="confirm_failure_assignment" />
    <bpmn:sequenceFlow id="f-mp_on_inform_go_success-assign_mp_on" sourceRef="mp_on_inform_go_success" targetRef="assign_mp_on" />
    <bpmn:sequenceFlow id="f-confirm_failure_assignment-inform_mpoo_failure_assignment" sourceRef="confirm_failure_assignment" targetRef="inform_mpoo_failure_assignment" />
    <bpmn:sequenceFlow id="f-inform_mpoo_failure_assignment-inform_ms_po_failure_assignment" sourceRef="inform_mpoo_failure_assignment" targetRef="inform_ms_po_failure_assignment" />
    <bpmn:sequenceFlow id="f-inform_ms_po_failure_assignment-e_failure" sourceRef="inform_ms_po_failure_assignment" targetRef="e_failure" />
    <bpmn:sequenceFlow id="f-assign_mp_on-confirm_assignment" sourceRef="assign_mp_on" targetRef="confirm_assignment" />
    <bpmn:sequenceFlow id="f-confirm_assignment-inform_mpoo_assignment" sourceRef="confirm_assignment" targetRef="inform_mpoo_assignment" />
    <bpmn:sequenceFlow id="f-inform_mpoo_assignment-inform_ms_po_assignment" sourceRef="inform_mpoo_assignment" targetRef="inform_ms_po_assignment" />
    <bpmn:sequenceFlow id="f-inform_ms_po_assignment-inform_sp_assignment" sourceRef="inform_ms_po_assignment" targetRef="inform_sp_assignment" />
    <bpmn:sequenceFlow id="f-inform_sp_assignment-e_success" sourceRef="inform_sp_assignment" targetRef="e_success" />
    <bpmn:sequenceFlow id="f-inform_mp_on_failure_overall_transaction-e_timeout" sourceRef="inform_mp_on_failure_overall_transaction" targetRef="e_timeout" />
  </bpmn:process>
</bpmn:definitions>
