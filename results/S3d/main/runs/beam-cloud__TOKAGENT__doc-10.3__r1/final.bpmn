<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Deregistration of MPOO at GO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Deregistration of MPOO at GO" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_opt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="dereg" name="Deregisters at the GO" />
    <bpmn:task id="confirm" name="Confirms the continuation to the MPOO" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="verify" name="Verifies the deregistration" />
    <bpmn:exclusiveGateway id="g1" name="Reject or preliminarily confirm?" default="f-g1-reject" />
    <bpmn:task id="reject" name="Rejects the deregistration of the MPOO" />
    <bpmn:task id="prelim" name="Preliminarily confirms the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepares the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="g_opt" name="Oblige the MPOO to continue the operations?" default="f-g_opt-g_join" />
    <bpmn:task id="oblige" name="Obliges the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="g_join" name="Continue?" />
    <bpmn:task id="equip" name="Performs the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assigns the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="Informs the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Informs the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Informs the SP about the assignment of the GO" />
    <bpmn:sequenceFlow id="f-s-dereg" sourceRef="s" targetRef="dereg" />
    <bpmn:sequenceFlow id="f-dereg-verify" sourceRef="dereg" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-g1" sourceRef="verify" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-reject" sourceRef="g1" targetRef="reject" />
    <bpmn:sequenceFlow id="f-g1-prelim" sourceRef="g1" targetRef="prelim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reject-e" sourceRef="reject" targetRef="e" />
    <bpmn:sequenceFlow id="f-prelim-prepare" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-g_opt" sourceRef="prepare" targetRef="g_opt" />
    <bpmn:sequenceFlow id="f-g_opt-oblige" sourceRef="g_opt" targetRef="oblige">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_opt-g_join" sourceRef="g_opt" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-oblige-confirm" sourceRef="oblige" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-g_join" sourceRef="confirm" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_join-equip" sourceRef="g_join" targetRef="equip" />
    <bpmn:sequenceFlow id="f-equip-assign" sourceRef="equip" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mpoo" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f-inform_mpoo-inform_mspo" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-inform_mspo-inform_sp" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-e" sourceRef="inform_sp" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
