tok 1.0 "Deregistration of MPOO at GO"

pool org "Organisation"
  lane MPOO "MPOO"
    start s "Start"
    task dereg "Deregisters at the GO"
    task confirm "Confirms the continuation to the MPOO"
    end e "End"
  lane GO "GO"
    task verify "Verifies the deregistration"
    xor g1 "Reject or preliminarily confirm?"
    task reject "Rejects the deregistration of the MPOO"
    task prelim "Preliminarily confirms the deregistration of the MPOO"
    task prepare "Prepares the readmission of the measuring point"
    xor g_opt "Oblige the MPOO to continue the operations?"
    task oblige "Obligates the MPOO to continue the operations"
    xor g_join "Continue?"
    task equip "Performs the equipment acquisition and / or equipment changes"
    task assign "Assigns the GO as MPO"
    task inform_mpoo "Informs the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO"
    task inform_mspo "Informs the MSPO about the assignment of the GO"
    task inform_sp "Informs the SP about the assignment of the GO"

flow s -> dereg
flow dereg -> verify
flow verify -> g1
flow g1 -> reject default
flow g1 -> prelim when=""
flow reject -> e
flow prelim -> prepare
flow prepare -> g_opt
flow g_opt -> oblige when=""
flow g_opt -> g_join default
flow oblige -> confirm
flow confirm -> g_join
flow g_join -> equip
flow equip -> assign
flow assign -> inform_mpoo
flow inform_mpoo -> inform_mspo
flow inform_mspo -> inform_sp
flow inform_sp -> e
