<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fr_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dm_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_noself</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fr_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dm_mpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>t_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSP" name="MSP">
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t1" name="notify MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="g3" name="Who performs the final reading?" />
    <bpmn:task id="t_fr_mpon" name="perform the final reading" />
    <bpmn:exclusiveGateway id="g4" />
    <bpmn:exclusiveGateway id="g5" name="Who dismounts the old equipment?" />
    <bpmn:task id="t_dm_mpon" name="dismount the old equipment" />
    <bpmn:exclusiveGateway id="g6" />
    <bpmn:task id="t_mount" name="mount the new device" />
    <bpmn:task id="t_read" name="read the meter count from the installed meter" />
    <bpmn:task id="t_send" name="send the values of the final reading to the GO" />
    <bpmn:task id="t_tell" name="tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="g1" name="Self-dismounting?" />
    <bpmn:task id="t_self" name="announce self dismounting to MPON" />
    <bpmn:task id="t_noself" name="notify MPON about no self-dismounting" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="t_fr_mpoo" name="perform the final reading" />
    <bpmn:task id="t_dm_mpoo" name="dismount the old equipment" />
    <bpmn:task id="t_go" name="notify the MSP about the device changes, the master data, the meter count at dismounting, and the meter count at installation" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t_self" name="self-dismounting" sourceRef="g1" targetRef="t_self">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-t_noself" name="no self-dismounting" sourceRef="g1" targetRef="t_noself">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_self-g2" sourceRef="t_self" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t_noself-g2" sourceRef="t_noself" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-g3" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t_fr_mpon" name="MPON" sourceRef="g3" targetRef="t_fr_mpon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g3-t_fr_mpoo" name="MPOO" sourceRef="g3" targetRef="t_fr_mpoo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_fr_mpon-g4" sourceRef="t_fr_mpon" targetRef="g4" />
    <bpmn:sequenceFlow id="f-t_fr_mpoo-g4" sourceRef="t_fr_mpoo" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-g5" sourceRef="g4" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-t_dm_mpon" name="MPON" sourceRef="g5" targetRef="t_dm_mpon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g5-t_dm_mpoo" name="MPOO" sourceRef="g5" targetRef="t_dm_mpoo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_dm_mpon-g6" sourceRef="t_dm_mpon" targetRef="g6" />
    <bpmn:sequenceFlow id="f-t_dm_mpoo-g6" sourceRef="t_dm_mpoo" targetRef="g6" />
    <bpmn:sequenceFlow id="f-g6-t_mount" sourceRef="g6" targetRef="t_mount" />
    <bpmn:sequenceFlow id="f-t_mount-t_read" sourceRef="t_mount" targetRef="t_read" />
    <bpmn:sequenceFlow id="f-t_read-t_send" sourceRef="t_read" targetRef="t_send" />
    <bpmn:sequenceFlow id="f-t_send-t_tell" sourceRef="t_send" targetRef="t_tell" />
    <bpmn:sequenceFlow id="f-t_tell-t_go" sourceRef="t_tell" targetRef="t_go" />
    <bpmn:sequenceFlow id="f-t_go-e" sourceRef="t_go" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
