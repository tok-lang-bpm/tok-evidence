<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="P" name="Organisation" processRef="P-process" />
  </bpmn:collaboration>
  <bpmn:process id="P-process" name="Dismissal process" isExecutable="false">
    <bpmn:laneSet id="P-lanes">
      <bpmn:lane id="MSPN" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send" name="send dismissal" />
    <bpmn:task id="review" name="review dismissal" />
    <bpmn:exclusiveGateway id="decide" name="Reject or confirm?" />
    <bpmn:task id="reject" name="reject dismissal" />
    <bpmn:task id="confirm" name="confirm dismissal" />
    <bpmn:endEvent id="accepted" name="End" />
    <bpmn:endEvent id="rejected" name="End" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="reject" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="confirm" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-accepted" sourceRef="confirm" targetRef="accepted" />
  </bpmn:process>
</bpmn:definitions>
