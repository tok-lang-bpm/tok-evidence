tok 1.0 "Dismissal process"

pool P "Organisation"
  lane MSPN "MSPN"
    start s "Start"
    task send "send dismissal"
  lane MSPO "MSPO"
    task review "review dismissal"
    xor decide "Reject or confirm?"
    task reject "reject dismissal"
    task confirm "confirm dismissal"
    end accepted "End"
    end rejected "End"

flow s -> send
flow send -> review
flow review -> decide
flow decide -> reject "reject"
flow decide -> confirm "confirm"
flow reject -> rejected
flow confirm -> accepted
