<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="register" name="Register measurement at the GO" />
    <bpmn:task id="examine" name="Examine application of the MSPN" />
    <bpmn:exclusiveGateway id="decide" name="Application of the MSPN approved?" />
    <bpmn:task id="reject" name="Reject application of the MSPN" />
    <bpmn:task id="confirm" name="Confirm application of the MSPN" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:task id="inform-mspo" name="Inform the MSPO about the assignment of MSPN" />
    <bpmn:task id="inform-mpo" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="inform-sp" name="Inform the SP about the assignment of MSPN" />
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:endEvent id="end-rejected" name="Application rejected" />
    <bpmn:endEvent id="end-done" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-register" sourceRef="s" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-examine" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-decide" sourceRef="examine" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="No" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="Yes" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-end-rejected" sourceRef="reject" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="f-confirm-assign" sourceRef="confirm" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform-mspo" sourceRef="assign" targetRef="inform-mspo" />
    <bpmn:sequenceFlow id="f-inform-mspo-inform-mpo" sourceRef="inform-mspo" targetRef="inform-mpo" />
    <bpmn:sequenceFlow id="f-inform-mpo-inform-sp" sourceRef="inform-mpo" targetRef="inform-sp" />
    <bpmn:sequenceFlow id="f-inform-sp-end-done" sourceRef="inform-sp" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
