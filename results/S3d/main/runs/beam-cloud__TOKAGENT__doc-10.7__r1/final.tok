tok 1.0 "MSPN registration"

pool org "Organisation"
  lane mspn "MSPN"
    task register "Register measurement at the GO"
  lane go "GO"
    task examine "Examine application of the MSPN"
    xor decide "Application of the MSPN approved?"
    task reject "Reject application of the MSPN"
    task confirm "Confirm application of the MSPN"
    task assign "Assign the MSPN"
    task inform-mspo "Inform the MSPO about the assignment of MSPN"
    task inform-mpo "Inform the MPO about the assignment of the MSPN"
    task inform-sp "Inform the SP about the assignment of MSPN"
    start s "Start"
    end end-rejected "Application rejected"
    end end-done "Process completed"

flow s -> register -> examine -> decide
flow decide -> reject "No"
flow decide -> confirm "Yes"
flow reject -> end-rejected
flow confirm -> assign -> inform-mspo -> inform-mpo -> inform-sp -> end-done
