<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Organisation" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="request" name="request changes" />
    <bpmn:exclusiveGateway id="g0" name="Who causes the change?" default="f-g0-cause" />
    <bpmn:task id="cause" name="cause a change" />
    <bpmn:task id="review" name="review change request" />
    <bpmn:exclusiveGateway id="g1" name="Reject or confirm?" default="f-g1-end1" />
    <bpmn:task id="perform" name="perform the measuring point change" />
    <bpmn:exclusiveGateway id="g2" name="Implement or fail?" default="f-g2-notify" />
    <bpmn:task id="report" name="report the implementation" />
    <bpmn:task id="notify" name="notify about the failure of the changes" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:sequenceFlow id="f-start-g0" sourceRef="start" targetRef="g0" />
    <bpmn:sequenceFlow id="f-g0-request" name="requests" sourceRef="g0" targetRef="request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g0-cause" name="causes" sourceRef="g0" targetRef="cause" />
    <bpmn:sequenceFlow id="f-request-review" sourceRef="request" targetRef="review" />
    <bpmn:sequenceFlow id="f-cause-review" sourceRef="cause" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g1" sourceRef="review" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-perform" name="confirm" sourceRef="g1" targetRef="perform">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-end1" name="reject" sourceRef="g1" targetRef="end1" />
    <bpmn:sequenceFlow id="f-perform-g2" sourceRef="perform" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-report" name="implementation" sourceRef="g2" targetRef="report">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g2-notify" name="failure" sourceRef="g2" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-end1" sourceRef="report" targetRef="end1" />
    <bpmn:sequenceFlow id="f-notify-end1" sourceRef="notify" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
