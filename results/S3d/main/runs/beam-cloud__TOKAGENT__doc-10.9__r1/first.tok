tok 1.0 "Measuring point change"

pool p "Organisation"
  lane sp "SP / PU / GO"
    start start "Start"
    task request "request changes"
  lane mpo "MPO"
    task cause "cause a change"
    task review "review change request"
    xor g1 "Reject or confirm?"
    task perform "perform the measuring point change"
    xor g2 "Implement or fail?"
    task report "report the implementation"
    task notify "notify about the failure of the changes"
    end end1 "End"

flow start -> g0
flow g0 -> request "requests" when=""
flow g0 -> cause "causes" default
flow request -> review
flow cause -> review
flow review -> g1
flow g1 -> perform "confirm" when=""
flow g1 -> end1 "reject" default
flow perform -> g2
flow g2 -> report "implementation" when=""
flow g2 -> notify "failure" default
flow report -> end1
flow notify -> end1
