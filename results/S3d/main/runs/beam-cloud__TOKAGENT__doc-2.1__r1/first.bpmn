<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="TELECO" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Service degradation process" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perceive-service-degradation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-problem-parameters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-customer-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer-service" name="Customer Service">
        <bpmn:flowNodeRef>enter-problem-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare-report-sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-counter-measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-customer-significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>link-extra-problem-fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>significance-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-detailed-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-detailed-report-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-actual-service-performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-problem-resolution-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-cs-reports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork-cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-customer-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-customer-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report-sla-rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service-management" name="Service Management">
        <bpmn:flowNodeRef>investigate-analyzability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-detailed-report-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform-analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-trouble-report-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-final-status-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measures-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-actual-service-performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertake-corrective-actions-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-problem-resolution-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-problem-resolution-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-restoration-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-restoration-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-trouble-shooting-report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="resource-provisioning" name="Resource Provisioning">
        <bpmn:flowNodeRef>check-possible-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-normal-execution-notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze-problem-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-trouble-report-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>include-status-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-restoration-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track-errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertake-corrective-actions-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-trouble-shooting-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-trouble-shooting-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rp-timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rp-restoration</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust-billing</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="perceive-service-degradation" name="Perceive service degradation" />
    <bpmn:task id="send-problem-parameters" name="Send list of problem parameters" />
    <bpmn:task id="receive-customer-report" name="Receive report about service performance and problem resolution" />
    <bpmn:endEvent id="end-process" name="End" />
    <bpmn:task id="enter-problem-report" name="Enter problem report into system T" />
    <bpmn:task id="compare-report-sla" name="Compare problem report to customer SLA" />
    <bpmn:task id="determine-counter-measures" name="Determine necessary counter measures and priorities" />
    <bpmn:task id="determine-customer-significance" name="Determine customer significance" />
    <bpmn:exclusiveGateway id="premium-split" name="Customer premium?" default="f-premium-split-premium-join" />
    <bpmn:task id="link-extra-problem-fix" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="premium-join" name="Join after premium handling" />
    <bpmn:exclusiveGateway id="significance-split" name="Customer significance affects counter measures?" default="f-significance-split-create-detailed-report" />
    <bpmn:task id="create-detailed-report" name="Create detailed problem report" />
    <bpmn:task id="send-detailed-report-sm" name="Send detailed problem report to Service Management" />
    <bpmn:task id="receive-actual-service-performance" name="Receive actual service performance" />
    <bpmn:task id="receive-problem-resolution-report" name="Receive problem resolution report" />
    <bpmn:exclusiveGateway id="join-cs-reports" name="Join received reports" />
    <bpmn:parallelGateway id="fork-cs" name="Trigger concurrent activities" />
    <bpmn:task id="create-customer-report" name="Create report for customer" />
    <bpmn:task id="send-customer-report" name="Send report to customer" />
    <bpmn:task id="report-sla-rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="join-cs" name="Join completed activities" />
    <bpmn:task id="investigate-analyzability" name="Investigate whether problem analyzable at Service Management or located at Resource Provisioning" />
    <bpmn:exclusiveGateway id="analyzable-split" name="Problem analyzable by Service Management?" default="f-analyzable-split-perform-analysis" />
    <bpmn:task id="send-detailed-report-rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="perform-analysis" name="Perform analysis" />
    <bpmn:task id="create-trouble-report-sm" name="Create trouble report indicating type of problem" />
    <bpmn:task id="prepare-final-status-report" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="measures-split" name="Counter measures based on final status report?" default="f-measures-split-create-restoration-request" />
    <bpmn:task id="send-actual-service-performance" name="Send actual service performance to Customer Service" />
    <bpmn:task id="undertake-corrective-actions-sm" name="Undertake corrective actions" />
    <bpmn:task id="create-problem-resolution-report" name="Create problem resolution report" />
    <bpmn:task id="send-problem-resolution-report" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="create-restoration-request" name="Create request for automatic resource restoration" />
    <bpmn:task id="send-restoration-request" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="receive-trouble-shooting-report" name="Receive trouble-shooting report" />
    <bpmn:task id="check-possible-problems" name="Check whether there are any possible problems" default="f-check-possible-problems-analyze-problem-rp" />
    <bpmn:task id="create-normal-execution-notification" name="Create notification about normal service execution" />
    <bpmn:task id="analyze-problem-rp" name="Analyze problem" />
    <bpmn:task id="create-trouble-report-rp" name="Create trouble report" />
    <bpmn:task id="include-status-report" name="Include report in status report and send back to Service Management" />
    <bpmn:task id="receive-restoration-request" name="Receive restoration request" />
    <bpmn:boundaryEvent id="rp-timeout" name="Timeout after 2 days" attachedToRef="receive-restoration-request">
      <bpmn:timerEventDefinition id="rp-timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="track-errors" name="Track all possible errors" />
    <bpmn:task id="undertake-corrective-actions-rp" name="Undertake all necessary corrective actions" />
    <bpmn:task id="create-trouble-shooting-report" name="Create trouble-shooting report" />
    <bpmn:task id="send-trouble-shooting-report" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="end-rp-timeout" name="Terminate process">
      <bpmn:terminateEventDefinition id="end-rp-timeout-def" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end-rp-restoration" name="End" />
    <bpmn:task id="adjust-billing" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-start-perceive-service-degradation" sourceRef="start" targetRef="perceive-service-degradation" />
    <bpmn:sequenceFlow id="f-perceive-service-degradation-send-problem-parameters" sourceRef="perceive-service-degradation" targetRef="send-problem-parameters" />
    <bpmn:sequenceFlow id="f-send-problem-parameters-enter-problem-report" sourceRef="send-problem-parameters" targetRef="enter-problem-report" />
    <bpmn:sequenceFlow id="f-enter-problem-report-compare-report-sla" sourceRef="enter-problem-report" targetRef="compare-report-sla" />
    <bpmn:sequenceFlow id="f-compare-report-sla-determine-counter-measures" sourceRef="compare-report-sla" targetRef="determine-counter-measures" />
    <bpmn:sequenceFlow id="f-determine-counter-measures-determine-customer-significance" sourceRef="determine-counter-measures" targetRef="determine-customer-significance" />
    <bpmn:sequenceFlow id="f-determine-customer-significance-premium-split" sourceRef="determine-customer-significance" targetRef="premium-split" />
    <bpmn:sequenceFlow id="f-premium-split-link-extra-problem-fix" name="Premium" sourceRef="premium-split" targetRef="link-extra-problem-fix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerPremium = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-premium-split-premium-join" name="Not premium" sourceRef="premium-split" targetRef="premium-join" />
    <bpmn:sequenceFlow id="f-link-extra-problem-fix-premium-join" sourceRef="link-extra-problem-fix" targetRef="premium-join" />
    <bpmn:sequenceFlow id="f-premium-join-significance-split" sourceRef="premium-join" targetRef="significance-split" />
    <bpmn:sequenceFlow id="f-significance-split-determine-counter-measures" name="Affects counter measures" sourceRef="significance-split" targetRef="determine-counter-measures">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerSignificanceAffectsCounterMeasures = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-significance-split-create-detailed-report" name="Does not affect" sourceRef="significance-split" targetRef="create-detailed-report" />
    <bpmn:sequenceFlow id="f-create-detailed-report-send-detailed-report-sm" sourceRef="create-detailed-report" targetRef="send-detailed-report-sm" />
    <bpmn:sequenceFlow id="f-send-detailed-report-sm-investigate-analyzability" sourceRef="send-detailed-report-sm" targetRef="investigate-analyzability" />
    <bpmn:sequenceFlow id="f-investigate-analyzability-analyzable-split" sourceRef="investigate-analyzability" targetRef="analyzable-split" />
    <bpmn:sequenceFlow id="f-analyzable-split-send-detailed-report-rp" name="Not analyzable" sourceRef="analyzable-split" targetRef="send-detailed-report-rp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">serviceManagementCanAnalyze = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-analyzable-split-perform-analysis" name="Analyzable" sourceRef="analyzable-split" targetRef="perform-analysis" />
    <bpmn:sequenceFlow id="f-perform-analysis-create-trouble-report-sm" sourceRef="perform-analysis" targetRef="create-trouble-report-sm" />
    <bpmn:sequenceFlow id="f-create-trouble-report-sm-prepare-final-status-report" sourceRef="create-trouble-report-sm" targetRef="prepare-final-status-report" />
    <bpmn:sequenceFlow id="f-send-detailed-report-rp-check-possible-problems" sourceRef="send-detailed-report-rp" targetRef="check-possible-problems" />
    <bpmn:sequenceFlow id="f-check-possible-problems-create-normal-execution-notification" name="No problems" sourceRef="check-possible-problems" targetRef="create-normal-execution-notification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noPossibleProblems = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-check-possible-problems-analyze-problem-rp" name="Problem detected" sourceRef="check-possible-problems" targetRef="analyze-problem-rp" />
    <bpmn:sequenceFlow id="f-analyze-problem-rp-create-trouble-report-rp" sourceRef="analyze-problem-rp" targetRef="create-trouble-report-rp" />
    <bpmn:sequenceFlow id="f-create-trouble-report-rp-include-status-report" sourceRef="create-trouble-report-rp" targetRef="include-status-report" />
    <bpmn:sequenceFlow id="f-create-normal-execution-notification-include-status-report" sourceRef="create-normal-execution-notification" targetRef="include-status-report" />
    <bpmn:sequenceFlow id="f-include-status-report-prepare-final-status-report" sourceRef="include-status-report" targetRef="prepare-final-status-report" />
    <bpmn:sequenceFlow id="f-prepare-final-status-report-measures-split" sourceRef="prepare-final-status-report" targetRef="measures-split" />
    <bpmn:sequenceFlow id="f-measures-split-send-actual-service-performance" name="No problem detected at all" sourceRef="measures-split" targetRef="send-actual-service-performance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noProblemDetectedAtAll = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-measures-split-undertake-corrective-actions-sm" name="Minor corrective actions required" sourceRef="measures-split" targetRef="undertake-corrective-actions-sm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">minorCorrectiveActionsRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-measures-split-create-restoration-request" name="Automatic resource restoration required" sourceRef="measures-split" targetRef="create-restoration-request" />
    <bpmn:sequenceFlow id="f-undertake-corrective-actions-sm-create-problem-resolution-report" sourceRef="undertake-corrective-actions-sm" targetRef="create-problem-resolution-report" />
    <bpmn:sequenceFlow id="f-create-problem-resolution-report-send-problem-resolution-report" sourceRef="create-problem-resolution-report" targetRef="send-problem-resolution-report" />
    <bpmn:sequenceFlow id="f-create-restoration-request-send-restoration-request" sourceRef="create-restoration-request" targetRef="send-restoration-request" />
    <bpmn:sequenceFlow id="f-send-restoration-request-receive-restoration-request" sourceRef="send-restoration-request" targetRef="receive-restoration-request" />
    <bpmn:sequenceFlow id="f-rp-timeout-end-rp-timeout" sourceRef="rp-timeout" targetRef="end-rp-timeout" />
    <bpmn:sequenceFlow id="f-receive-restoration-request-track-errors" sourceRef="receive-restoration-request" targetRef="track-errors" />
    <bpmn:sequenceFlow id="f-track-errors-undertake-corrective-actions-rp" sourceRef="track-errors" targetRef="undertake-corrective-actions-rp" />
    <bpmn:sequenceFlow id="f-undertake-corrective-actions-rp-create-trouble-shooting-report" sourceRef="undertake-corrective-actions-rp" targetRef="create-trouble-shooting-report" />
    <bpmn:sequenceFlow id="f-create-trouble-shooting-report-send-trouble-shooting-report" sourceRef="create-trouble-shooting-report" targetRef="send-trouble-shooting-report" />
    <bpmn:sequenceFlow id="f-send-trouble-shooting-report-receive-trouble-shooting-report" sourceRef="send-trouble-shooting-report" targetRef="receive-trouble-shooting-report" />
    <bpmn:sequenceFlow id="f-receive-trouble-shooting-report-create-problem-resolution-report" sourceRef="receive-trouble-shooting-report" targetRef="create-problem-resolution-report" />
    <bpmn:sequenceFlow id="f-send-trouble-shooting-report-end-rp-restoration" sourceRef="send-trouble-shooting-report" targetRef="end-rp-restoration" />
    <bpmn:sequenceFlow id="f-send-actual-service-performance-receive-actual-service-performance" sourceRef="send-actual-service-performance" targetRef="receive-actual-service-performance" />
    <bpmn:sequenceFlow id="f-send-problem-resolution-report-receive-problem-resolution-report" sourceRef="send-problem-resolution-report" targetRef="receive-problem-resolution-report" />
    <bpmn:sequenceFlow id="f-receive-actual-service-performance-join-cs-reports" sourceRef="receive-actual-service-performance" targetRef="join-cs-reports" />
    <bpmn:sequenceFlow id="f-receive-problem-resolution-report-join-cs-reports" sourceRef="receive-problem-resolution-report" targetRef="join-cs-reports" />
    <bpmn:sequenceFlow id="f-join-cs-reports-fork-cs" sourceRef="join-cs-reports" targetRef="fork-cs" />
    <bpmn:sequenceFlow id="f-fork-cs-create-customer-report" sourceRef="fork-cs" targetRef="create-customer-report" />
    <bpmn:sequenceFlow id="f-fork-cs-report-sla-rebate" sourceRef="fork-cs" targetRef="report-sla-rebate" />
    <bpmn:sequenceFlow id="f-create-customer-report-send-customer-report" sourceRef="create-customer-report" targetRef="send-customer-report" />
    <bpmn:sequenceFlow id="f-send-customer-report-join-cs" sourceRef="send-customer-report" targetRef="join-cs" />
    <bpmn:sequenceFlow id="f-report-sla-rebate-adjust-billing" sourceRef="report-sla-rebate" targetRef="adjust-billing" />
    <bpmn:sequenceFlow id="f-adjust-billing-join-cs" sourceRef="adjust-billing" targetRef="join-cs" />
    <bpmn:sequenceFlow id="f-join-cs-receive-customer-report" sourceRef="join-cs" targetRef="receive-customer-report" />
    <bpmn:sequenceFlow id="f-receive-customer-report-end-process" sourceRef="receive-customer-report" targetRef="end-process" />
  </bpmn:process>
</bpmn:definitions>
