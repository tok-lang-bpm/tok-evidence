<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Power supplier switch process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Power supplier switch process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Power supplier switch process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-contract-details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-withdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer-service" name="Customer Service">
        <bpmn:flowNodeRef>receive-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct-errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-contracts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-cis-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import-meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-won</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-customer-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-grid-old</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM System">
        <bpmn:flowNodeRef>enter-crm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="Customer Information System (CIS)">
        <bpmn:flowNodeRef>check-contracts-cis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze-issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regenerate-contracts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-request-grid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid Operator">
        <bpmn:flowNodeRef>check-supplier-concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate-agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-go-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-grid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old-supplier" name="Old Supplier">
        <bpmn:flowNodeRef>create-old-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-old-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-customer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Switch-over request" />
    <bpmn:task id="transmit-data" name="Transmit customer data" />
    <bpmn:task id="check-contract-details" name="Check contract details" />
    <bpmn:task id="withdraw" name="Withdraw from switch contract" />
    <bpmn:endEvent id="end-withdraw" name="Process ends (withdrawal)" />
    <bpmn:task id="receive-data" name="Receive customer data" />
    <bpmn:task id="compare-data" name="Compare customer data with internal customer database" />
    <bpmn:task id="check-data" name="Check data for completeness and plausibility" />
    <bpmn:task id="correct-errors" name="Correct data errors based on error list" />
    <bpmn:task id="prepare-contracts" name="Prepare contract documents for power supplier switch" />
    <bpmn:task id="send-confirmation" name="Send confirmation document to customer" />
    <bpmn:task id="create-cis-contract" name="Create CIS contract" />
    <bpmn:task id="import-meter" name="Import meter data into systems" />
    <bpmn:endEvent id="end-won" name="Process of winning new customer ends" />
    <bpmn:exclusiveGateway id="gw-errors" name="Data errors found?" default="f-gw-errors-gw-exists" />
    <bpmn:exclusiveGateway id="gw-exists" name="Customer exists in database?" default="f-gw-exists-gw-customer-join" />
    <bpmn:exclusiveGateway id="gw-customer-join" name="Customer data merge" />
    <bpmn:exclusiveGateway id="gw-contract" name="Contract documents generated correctly?" default="f-gw-contract-send-confirmation" />
    <bpmn:exclusiveGateway id="gw-concurrence" name="Supplier concurrence found?" default="f-gw-concurrence-create-cis-contract" />
    <bpmn:exclusiveGateway id="gw-withdraw" name="Withdraw from switch contract?" default="f-gw-withdraw-g-final" />
    <bpmn:parallelGateway id="g-final" name="Final billing phase" />
    <bpmn:parallelGateway id="g-grid-old" name="Grid-to-old-supplier split" />
    <bpmn:task id="enter-crm" name="Enter customer data object into CRM system" />
    <bpmn:task id="create-customer" name="Create new customer object" />
    <bpmn:task id="check-contracts-cis" name="Check contract documents in CIS" />
    <bpmn:task id="analyze-issues" name="Analyze and resolve contract generation issues" />
    <bpmn:task id="regenerate-contracts" name="Regenerate contract documents" />
    <bpmn:task id="send-request-grid" name="Send switch-over request to grid operator" />
    <bpmn:task id="check-supplier-concurrence" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="transmit-response" name="Transmit response comment" />
    <bpmn:task id="inform-suppliers" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:task id="terminate-agreement" name="Carry out termination of sales agreement with old supplier" />
    <bpmn:task id="transmit-meter" name="Transmit power meter data" />
    <bpmn:task id="compute-final" name="Compute final billing based on meter data" />
    <bpmn:task id="send-go-final" name="Send final billing to old supplier" />
    <bpmn:endEvent id="end-concurrence" name="Process ends after supplier concurrence" />
    <bpmn:endEvent id="end-grid" name="Grid operator process ends" />
    <bpmn:task id="create-old-final" name="Create final billing" />
    <bpmn:task id="send-old-final" name="Send final billing to customer" />
    <bpmn:endEvent id="end-customer" name="Customer process ends" />
    <bpmn:sequenceFlow id="f-s-transmit-data" sourceRef="s" targetRef="transmit-data" />
    <bpmn:sequenceFlow id="f-transmit-data-receive-data" sourceRef="transmit-data" targetRef="receive-data" />
    <bpmn:sequenceFlow id="f-receive-data-enter-crm" sourceRef="receive-data" targetRef="enter-crm" />
    <bpmn:sequenceFlow id="f-enter-crm-compare-data" sourceRef="enter-crm" targetRef="compare-data" />
    <bpmn:sequenceFlow id="f-compare-data-check-data" sourceRef="compare-data" targetRef="check-data" />
    <bpmn:sequenceFlow id="f-check-data-gw-errors" sourceRef="check-data" targetRef="gw-errors" />
    <bpmn:sequenceFlow id="f-gw-errors-correct-errors" name="Errors found" sourceRef="gw-errors" targetRef="correct-errors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">errors = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-errors-gw-exists" name="No errors" sourceRef="gw-errors" targetRef="gw-exists" />
    <bpmn:sequenceFlow id="f-correct-errors-compare-data" sourceRef="correct-errors" targetRef="compare-data" />
    <bpmn:sequenceFlow id="f-gw-exists-gw-customer-join" name="Customer exists" sourceRef="gw-exists" targetRef="gw-customer-join" />
    <bpmn:sequenceFlow id="f-gw-exists-create-customer" name="Customer does not exist" sourceRef="gw-exists" targetRef="create-customer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerExists = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-create-customer-gw-customer-join" sourceRef="create-customer" targetRef="gw-customer-join" />
    <bpmn:sequenceFlow id="f-gw-customer-join-prepare-contracts" sourceRef="gw-customer-join" targetRef="prepare-contracts" />
    <bpmn:sequenceFlow id="f-prepare-contracts-check-contracts-cis" sourceRef="prepare-contracts" targetRef="check-contracts-cis" />
    <bpmn:sequenceFlow id="f-check-contracts-cis-gw-contract" sourceRef="check-contracts-cis" targetRef="gw-contract" />
    <bpmn:sequenceFlow id="f-gw-contract-analyze-issues" name="Documents not generated" sourceRef="gw-contract" targetRef="analyze-issues">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">generated = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-contract-send-confirmation" name="Documents generated" sourceRef="gw-contract" targetRef="send-confirmation" />
    <bpmn:sequenceFlow id="f-analyze-issues-regenerate-contracts" sourceRef="analyze-issues" targetRef="regenerate-contracts" />
    <bpmn:sequenceFlow id="f-regenerate-contracts-check-contracts-cis" sourceRef="regenerate-contracts" targetRef="check-contracts-cis" />
    <bpmn:sequenceFlow id="f-send-confirmation-send-request-grid" sourceRef="send-confirmation" targetRef="send-request-grid" />
    <bpmn:sequenceFlow id="f-send-request-grid-check-supplier-concurrence" sourceRef="send-request-grid" targetRef="check-supplier-concurrence" />
    <bpmn:sequenceFlow id="f-check-supplier-concurrence-transmit-response" sourceRef="check-supplier-concurrence" targetRef="transmit-response" />
    <bpmn:sequenceFlow id="f-transmit-response-gw-concurrence" sourceRef="transmit-response" targetRef="gw-concurrence" />
    <bpmn:sequenceFlow id="f-gw-concurrence-inform-suppliers" name="Supplier concurrence" sourceRef="gw-concurrence" targetRef="inform-suppliers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">concurrence = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-concurrence-create-cis-contract" name="No concurrence" sourceRef="gw-concurrence" targetRef="create-cis-contract" />
    <bpmn:sequenceFlow id="f-inform-suppliers-terminate-agreement" sourceRef="inform-suppliers" targetRef="terminate-agreement" />
    <bpmn:sequenceFlow id="f-terminate-agreement-end-concurrence" sourceRef="terminate-agreement" targetRef="end-concurrence" />
    <bpmn:sequenceFlow id="f-create-cis-contract-check-contract-details" sourceRef="create-cis-contract" targetRef="check-contract-details" />
    <bpmn:sequenceFlow id="f-check-contract-details-gw-withdraw" sourceRef="check-contract-details" targetRef="gw-withdraw" />
    <bpmn:sequenceFlow id="f-gw-withdraw-withdraw" name="Withdraw" sourceRef="gw-withdraw" targetRef="withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">withdraw = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-withdraw-g-final" name="Confirm or accepted after 7 days" sourceRef="gw-withdraw" targetRef="g-final" />
    <bpmn:sequenceFlow id="f-withdraw-end-withdraw" sourceRef="withdraw" targetRef="end-withdraw" />
    <bpmn:sequenceFlow id="f-g-final-transmit-meter" sourceRef="g-final" targetRef="transmit-meter" />
    <bpmn:sequenceFlow id="f-g-final-compute-final" sourceRef="g-final" targetRef="compute-final" />
    <bpmn:sequenceFlow id="f-transmit-meter-import-meter" sourceRef="transmit-meter" targetRef="import-meter" />
    <bpmn:sequenceFlow id="f-import-meter-end-won" sourceRef="import-meter" targetRef="end-won" />
    <bpmn:sequenceFlow id="f-compute-final-send-go-final" sourceRef="compute-final" targetRef="send-go-final" />
    <bpmn:sequenceFlow id="f-send-go-final-g-grid-old" sourceRef="send-go-final" targetRef="g-grid-old" />
    <bpmn:sequenceFlow id="f-g-grid-old-end-grid" sourceRef="g-grid-old" targetRef="end-grid" />
    <bpmn:sequenceFlow id="f-g-grid-old-create-old-final" sourceRef="g-grid-old" targetRef="create-old-final" />
    <bpmn:sequenceFlow id="f-create-old-final-send-old-final" sourceRef="create-old-final" targetRef="send-old-final" />
    <bpmn:sequenceFlow id="f-send-old-final-end-customer" sourceRef="send-old-final" targetRef="end-customer" />
  </bpmn:process>
</bpmn:definitions>
