<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant Possession Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Warrant_possession_request" name="Warrant possession request" />
  <bpmn:message id="Message_SCT_Warrant_Possession" name="SCT Warrant Possession" />
  <bpmn:message id="Message_Report" name="Report" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="party" name="The party" />
    <bpmn:participant id="police" name="Queensland Police" />
    <bpmn:participant id="org" name="Small Claims Registry Operations" processRef="org-process" />
    <bpmn:messageFlow id="m-party-receive-request" name="Warrant possession request" sourceRef="party" targetRef="receive-request" messageRef="Message_Warrant_possession_request" />
    <bpmn:messageFlow id="m-forward-police-police" name="SCT Warrant Possession" sourceRef="forward-police" targetRef="police" messageRef="Message_SCT_Warrant_Possession" />
    <bpmn:messageFlow id="m-police-receive-report" name="Report" sourceRef="police" targetRef="receive-report" messageRef="Message_Report" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Warrant Possession Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="csbo" name="Client Service Back Office">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-sct-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward-police</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-sct-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-sct-file-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach-sct-doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-expanded-file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="other" name="Other MC internal staff">
        <bpmn:flowNodeRef>receive-physical-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="receive-request" name="Receive warrant possession request" />
    <bpmn:task id="retrieve-sct-file" name="Retrieve the SCT file" />
    <bpmn:task id="forward-police" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store-sct-file" name="Store SCT physical file" />
    <bpmn:receiveTask id="receive-report" name="Receive report from Queensland Police" messageRef="Message_Report" />
    <bpmn:task id="retrieve-sct-file-report" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach-sct-doc" name="Attach the new SCT document" />
    <bpmn:task id="store-expanded-file" name="Store expanded SCT physical file" />
    <bpmn:task id="receive-physical-file" name="Receive physical SCT file" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-receive-request" sourceRef="s" targetRef="receive-request" />
    <bpmn:sequenceFlow id="f-receive-request-retrieve-sct-file" sourceRef="receive-request" targetRef="retrieve-sct-file" />
    <bpmn:sequenceFlow id="f-retrieve-sct-file-forward-police" sourceRef="retrieve-sct-file" targetRef="forward-police" />
    <bpmn:sequenceFlow id="f-forward-police-store-sct-file" sourceRef="forward-police" targetRef="store-sct-file" />
    <bpmn:sequenceFlow id="f-store-sct-file-receive-report" sourceRef="store-sct-file" targetRef="receive-report" />
    <bpmn:sequenceFlow id="f-receive-report-retrieve-sct-file-report" sourceRef="receive-report" targetRef="retrieve-sct-file-report" />
    <bpmn:sequenceFlow id="f-retrieve-sct-file-report-attach-sct-doc" sourceRef="retrieve-sct-file-report" targetRef="attach-sct-doc" />
    <bpmn:sequenceFlow id="f-attach-sct-doc-store-expanded-file" sourceRef="attach-sct-doc" targetRef="store-expanded-file" />
    <bpmn:sequenceFlow id="f-store-expanded-file-receive-physical-file" sourceRef="store-expanded-file" targetRef="receive-physical-file" />
    <bpmn:sequenceFlow id="f-receive-physical-file-e" sourceRef="receive-physical-file" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
