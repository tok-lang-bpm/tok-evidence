tok 1.0 "Warrant Possession Request"

pool party "The party"

pool police "Queensland Police"

pool org "Small Claims Registry Operations"
  lane csbo "Client Service Back Office"
    start s "Start"
    task receive-request "Receive warrant possession request"
    task retrieve-sct-file "Retrieve the SCT file"
    task forward-police "Forward SCT Warrant Possession to Queensland Police"
    task store-sct-file "Store SCT physical file"
    receive receive-report "Receive report from Queensland Police" message="Report"
    task retrieve-sct-file-report "Retrieve the respective SCT file"
    task attach-sct-doc "Attach the new SCT document"
    task store-expanded-file "Store expanded SCT physical file"
  lane other "Other MC internal staff"
    task receive-physical-file "Receive physical SCT file"
    end e "End"

flow s -> receive-request -> retrieve-sct-file -> forward-police -> store-sct-file -> receive-report -> retrieve-sct-file-report -> attach-sct-doc -> store-expanded-file -> receive-physical-file -> e

message party -> receive-request "Warrant possession request"
message forward-police -> police "SCT Warrant Possession"
message police -> receive-report "Report"
