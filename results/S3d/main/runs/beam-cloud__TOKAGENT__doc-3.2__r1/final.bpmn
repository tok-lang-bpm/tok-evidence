<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Court File Processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court File Processing" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="office" name="Court Office">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiate-search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-to-associate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute-lawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="check-files" name="Check files" />
    <bpmn:exclusiveGateway id="gw-missing" name="Some files missing?" default="f-gw-missing-track-files" />
    <bpmn:task id="initiate-search" name="Initiate search" />
    <bpmn:task id="track-files" name="Physically track files to intended location" />
    <bpmn:exclusiveGateway id="gw-merge" />
    <bpmn:parallelGateway id="gw-parallel" name="All files ready" />
    <bpmn:task id="hand-to-associate" name="Hand files to the Associate" />
    <bpmn:task id="distribute-lawlist" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="gw-join" />
    <bpmn:task id="conduct-hearings" name="Conduct directions hearings" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:sequenceFlow id="f-start1-check-files" sourceRef="start1" targetRef="check-files" />
    <bpmn:sequenceFlow id="f-check-files-gw-missing" sourceRef="check-files" targetRef="gw-missing" />
    <bpmn:sequenceFlow id="f-gw-missing-initiate-search" name="Yes" sourceRef="gw-missing" targetRef="initiate-search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">filesMissing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-missing-track-files" name="No" sourceRef="gw-missing" targetRef="track-files" />
    <bpmn:sequenceFlow id="f-initiate-search-gw-merge" sourceRef="initiate-search" targetRef="gw-merge" />
    <bpmn:sequenceFlow id="f-track-files-gw-merge" sourceRef="track-files" targetRef="gw-merge" />
    <bpmn:sequenceFlow id="f-gw-merge-gw-parallel" sourceRef="gw-merge" targetRef="gw-parallel" />
    <bpmn:sequenceFlow id="f-gw-parallel-hand-to-associate" sourceRef="gw-parallel" targetRef="hand-to-associate" />
    <bpmn:sequenceFlow id="f-gw-parallel-distribute-lawlist" sourceRef="gw-parallel" targetRef="distribute-lawlist" />
    <bpmn:sequenceFlow id="f-hand-to-associate-gw-join" sourceRef="hand-to-associate" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-distribute-lawlist-gw-join" sourceRef="distribute-lawlist" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-gw-join-conduct-hearings" sourceRef="gw-join" targetRef="conduct-hearings" />
    <bpmn:sequenceFlow id="f-conduct-hearings-end1" sourceRef="conduct-hearings" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
