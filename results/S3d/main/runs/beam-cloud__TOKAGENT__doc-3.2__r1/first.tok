tok 1.0 "Court File Processing"

pool court "Court" {
  lane office "Court Office" {
    start start1 "Start"
    task check-files "Check files"
    xor gw-missing "Some files missing?"
    task initiate-search "Initiate search"
    task track-files "Physically track files to intended location"
    xor gw-merge
    and gw-parallel "All files ready"
    task hand-to-associate "Hand files to the Associate"
    task distribute-lawlist "Distribute the Judge's Lawlist to the relevant people"
    and gw-join
    task conduct-hearings "Conduct directions hearings"
    end end1 "End"
  }
}

flow start1 -> check-files
flow check-files -> gw-missing
flow gw-missing -> initiate-search "Yes" when="filesMissing = true"
flow gw-missing -> track-files "No" default
flow initiate-search -> gw-merge
flow track-files -> gw-merge
flow gw-merge -> gw-parallel
flow gw-parallel -> hand-to-associate
flow gw-parallel -> distribute-lawlist
flow hand-to-associate -> gw-join
flow distribute-lawlist -> gw-join
flow gw-join -> conduct-hearings
flow conduct-hearings -> end1
