<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="claims" name="Claims officer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="claim registered" />
    <bpmn:task id="examine" name="examine claim" />
    <bpmn:task id="write" name="write settlement recommendation" />
    <bpmn:task id="check" name="check recommendation" />
    <bpmn:exclusiveGateway id="gw" name="OK?" default="f-gw-write" />
    <bpmn:endEvent id="e" name="proceed" />
    <bpmn:sequenceFlow id="f-s-examine" sourceRef="s" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-write" sourceRef="examine" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-check" sourceRef="write" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-gw" sourceRef="check" targetRef="gw" />
    <bpmn:sequenceFlow id="f-gw-e" name="OK" sourceRef="gw" targetRef="e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ok = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-write" name="Not OK" sourceRef="gw" targetRef="write" />
  </bpmn:process>
</bpmn:definitions>
