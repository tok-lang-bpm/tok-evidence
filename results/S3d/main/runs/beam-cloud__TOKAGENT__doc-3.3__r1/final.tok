tok 1.0

pool org "Organisation"
  lane claims "Claims officer"
    start s "claim registered"
    task examine "examine claim"
    task write "write settlement recommendation"
  lane senior "Senior claims officer"
    task check "check recommendation"
    xor gw "OK?"
    end e "proceed"

flow s -> examine -> write -> check -> gw
flow gw -> e "OK" when="ok = true"
flow gw -> write "Not OK" default
