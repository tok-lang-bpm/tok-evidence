<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mail registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Mail registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mail_processing_unit" name="Mail Processing Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort-unopened-mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute-mail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>open-sort-mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-mail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>quality-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile-requisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture-matter-details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post-party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>take-fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture-party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="collect-mail" name="Collect mail" />
    <bpmn:task id="sort-unopened-mail" name="Sort unopened mail into business areas" />
    <bpmn:task id="distribute-mail" name="Distribute mail" />
    <bpmn:task id="open-sort-mail" name="Open and sort mail into groups" />
    <bpmn:task id="register-mail" name="Register mail in incoming register" />
    <bpmn:task id="quality-check" name="Perform quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" default="f-compliant-capture-matter-details" />
    <bpmn:task id="compile-requisition" name="Compile list of requisition" />
    <bpmn:task id="send-back" name="Send back to party" />
    <bpmn:task id="capture-matter-details" name="Capture matter details" />
    <bpmn:task id="put-receipt" name="Put receipt and copied documents into envelope" />
    <bpmn:task id="post-party" name="Post to party" />
    <bpmn:endEvent id="end-rejected" name="End" />
    <bpmn:task id="take-fees" name="Take applicable fees" />
    <bpmn:task id="capture-party" name="Capture party details" />
    <bpmn:task id="print-file" name="Print physical court file" />
    <bpmn:parallelGateway id="split" name="Parallel activities" />
    <bpmn:parallelGateway id="join" name="Join" />
    <bpmn:endEvent id="end-ok" name="End" />
    <bpmn:sequenceFlow id="f-start-collect-mail" sourceRef="start" targetRef="collect-mail" />
    <bpmn:sequenceFlow id="f-collect-mail-sort-unopened-mail" sourceRef="collect-mail" targetRef="sort-unopened-mail" />
    <bpmn:sequenceFlow id="f-sort-unopened-mail-distribute-mail" sourceRef="sort-unopened-mail" targetRef="distribute-mail" />
    <bpmn:sequenceFlow id="f-distribute-mail-open-sort-mail" sourceRef="distribute-mail" targetRef="open-sort-mail" />
    <bpmn:sequenceFlow id="f-open-sort-mail-register-mail" sourceRef="open-sort-mail" targetRef="register-mail" />
    <bpmn:sequenceFlow id="f-register-mail-quality-check" sourceRef="register-mail" targetRef="quality-check" />
    <bpmn:sequenceFlow id="f-quality-check-compliant" sourceRef="quality-check" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-compile-requisition" name="Not compliant" sourceRef="compliant" targetRef="compile-requisition">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compliant = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-compliant-capture-matter-details" name="Compliant" sourceRef="compliant" targetRef="capture-matter-details" />
    <bpmn:sequenceFlow id="f-compile-requisition-send-back" sourceRef="compile-requisition" targetRef="send-back" />
    <bpmn:sequenceFlow id="f-send-back-end-rejected" sourceRef="send-back" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="f-capture-matter-details-take-fees" sourceRef="capture-matter-details" targetRef="take-fees" />
    <bpmn:sequenceFlow id="f-take-fees-split" sourceRef="take-fees" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-put-receipt" sourceRef="split" targetRef="put-receipt" />
    <bpmn:sequenceFlow id="f-put-receipt-post-party" sourceRef="put-receipt" targetRef="post-party" />
    <bpmn:sequenceFlow id="f-post-party-join" sourceRef="post-party" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-capture-party" sourceRef="split" targetRef="capture-party" />
    <bpmn:sequenceFlow id="f-capture-party-print-file" sourceRef="capture-party" targetRef="print-file" />
    <bpmn:sequenceFlow id="f-print-file-join" sourceRef="print-file" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-end-ok" sourceRef="join" targetRef="end-ok" />
  </bpmn:process>
</bpmn:definitions>
