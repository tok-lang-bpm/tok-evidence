<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Car accident claim" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="claims-handler" name="Claims Handler">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-police-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-in-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculate-estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-action-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-claimant</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims-manager" name="Claims Manager">
        <bpmn:flowNodeRef>negotiate-settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="search-police-report" name="Search Police Report in Police Report database" />
    <bpmn:task id="put-in-file" name="Put Police Report in file with Claim Documentation" />
    <bpmn:task id="calculate-estimate" name="Calculate initial claim estimate" />
    <bpmn:task id="create-action-plan" name="Create Action Plan based on Action Plan Checklist" />
    <bpmn:task id="inform-claimant" name="Inform claimant of outcome" />
    <bpmn:task id="negotiate-settlement" name="Negotiate settlement on claim estimate" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-search-police-report" sourceRef="s" targetRef="search-police-report" />
    <bpmn:sequenceFlow id="f-search-police-report-put-in-file" sourceRef="search-police-report" targetRef="put-in-file" />
    <bpmn:sequenceFlow id="f-put-in-file-calculate-estimate" sourceRef="put-in-file" targetRef="calculate-estimate" />
    <bpmn:sequenceFlow id="f-calculate-estimate-create-action-plan" sourceRef="calculate-estimate" targetRef="create-action-plan" />
    <bpmn:sequenceFlow id="f-create-action-plan-negotiate-settlement" sourceRef="create-action-plan" targetRef="negotiate-settlement" />
    <bpmn:sequenceFlow id="f-negotiate-settlement-inform-claimant" sourceRef="negotiate-settlement" targetRef="inform-claimant" />
    <bpmn:sequenceFlow id="f-inform-claimant-e" sourceRef="inform-claimant" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
