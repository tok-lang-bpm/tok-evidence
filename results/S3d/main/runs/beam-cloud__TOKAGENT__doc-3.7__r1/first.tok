tok 1.0 "Car accident claim"

pool organisation "Organisation" {
  lane claims-handler "Claims Handler" {
    start s "Start"
    task search-police-report "Search Police Report in Police Report database"
    task put-in-file "Put Police Report in file with Claim Documentation"
    task calculate-estimate "Calculate initial claim estimate"
    task create-action-plan "Create Action Plan based on Action Plan Checklist"
    task inform-claimant "Inform claimant of outcome"
  }
  lane claims-manager "Claims Manager" {
    task negotiate-settlement "Negotiate settlement on claim estimate"
    end e "End"
  }
}

flow s -> search-police-report
flow search-police-report -> put-in-file
flow put-in-file -> calculate-estimate
flow calculate-estimate -> create-action-plan
flow create-action-plan -> negotiate-settlement
flow negotiate-settlement -> inform-claimant
flow inform-claimant -> e
