<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car Insurer" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkdocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendletter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Claim submitted" />
    <bpmn:task id="checkdocs" name="Check documents upon completeness" />
    <bpmn:task id="register" name="Register claim" />
    <bpmn:task id="sendletter" name="Send letter to customer" />
    <bpmn:endEvent id="e" name="Complete" />
    <bpmn:task id="pick" name="Pick up claim" />
    <bpmn:task id="checkins" name="Check insurance" />
    <bpmn:task id="assess" name="Perform assessment" />
    <bpmn:exclusiveGateway id="gx" name="Assessment positive?" default="f-gx-reject" />
    <bpmn:task id="phone" name="Phone garage to authorise repairs" />
    <bpmn:task id="schedule" name="Schedule payment" />
    <bpmn:task id="reject" name="Reject claim" />
    <bpmn:exclusiveGateway id="gj" />
    <bpmn:sequenceFlow id="f-s-checkdocs" sourceRef="s" targetRef="checkdocs" />
    <bpmn:sequenceFlow id="f-checkdocs-register" sourceRef="checkdocs" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-pick" sourceRef="register" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-checkins" sourceRef="pick" targetRef="checkins" />
    <bpmn:sequenceFlow id="f-checkins-assess" sourceRef="checkins" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-gx" sourceRef="assess" targetRef="gx" />
    <bpmn:sequenceFlow id="f-gx-phone" name="Yes" sourceRef="gx" targetRef="phone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gx-reject" name="No" sourceRef="gx" targetRef="reject" />
    <bpmn:sequenceFlow id="f-gj-sendletter" sourceRef="gj" targetRef="sendletter" />
    <bpmn:sequenceFlow id="f-sendletter-e" sourceRef="sendletter" targetRef="e" />
    <bpmn:sequenceFlow id="f-phone-schedule" sourceRef="phone" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-gj" sourceRef="schedule" targetRef="gj" />
    <bpmn:sequenceFlow id="f-reject-gj" sourceRef="reject" targetRef="gj" />
  </bpmn:process>
</bpmn:definitions>
