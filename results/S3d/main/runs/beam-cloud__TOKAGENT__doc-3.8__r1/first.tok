tok 1.0

pool insurer "Car Insurer"
  lane notification "Notification department"
    start s "Claim submitted"
    task checkdocs "Check documents upon completeness"
    task register "Register claim"
    task sendletter "Send letter to customer"
    end e "Complete"
  lane handling "Handling department"
    task pick "Pick up claim"
    task checkins "Check insurance"
    task assess "Perform assessment"
    xor gx "Assessment positive?"
    task phone "Phone garage to authorise repairs"
    task schedule "Schedule payment"
    task reject "Reject claim"
    xor gj

flow s -> checkdocs
flow checkdocs -> register
flow register -> pick
flow pick -> checkins
flow checkins -> assess
flow assess -> gx
flow gx -> phone "Yes" when=""
flow gx -> reject "No" default
flow phone -> schedule
flow schedule -> gj
flow reject -> gj
flow gj -> sendletter
flow sendletter -> e