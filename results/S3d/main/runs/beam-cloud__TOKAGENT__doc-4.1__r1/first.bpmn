<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Telephone_notice" name="Telephone notice" />
  <bpmn:message id="Message_Request_medical_file" name="Request medical file" />
  <bpmn:message id="Message_Medical_file_copy" name="Medical file copy" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="family-doctor" name="Family doctor" />
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
    <bpmn:messageFlow id="m-family-doctor-notice" name="Telephone notice" sourceRef="family-doctor" targetRef="notice" messageRef="Message_Telephone_notice" />
    <bpmn:messageFlow id="m-prepare-letter-family-doctor" name="Request medical file" sourceRef="prepare-letter" targetRef="family-doctor" messageRef="Message_Request_medical_file" />
    <bpmn:messageFlow id="m-family-doctor-receive-copy" name="Medical file copy" sourceRef="family-doctor" targetRef="receive-copy" messageRef="Message_Medical_file_copy" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="secretarial" name="Secretarial office">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print-form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-in-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce-cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-new-notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass-cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mf-required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-copy-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type-out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-transcribed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-on-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing" name="Nursing officer">
        <bpmn:flowNodeRef>full-inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-in-form</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team-leader" name="Team leader">
        <bpmn:flowNodeRef>hold-meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-intakers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-mf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record-assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold-planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>formulate-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-procedure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first-intaker" name="First intaker">
        <bpmn:flowNodeRef>plan-first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copy-notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-checklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second-intaker" name="Second intaker">
        <bpmn:flowNodeRef>plan-second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-second</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Psychiatrist" />
    </bpmn:laneSet>
    <bpmn:startEvent id="notice" name="Notice by telephone">
      <bpmn:messageEventDefinition id="notice-def" messageRef="Message_Telephone_notice" />
    </bpmn:startEvent>
    <bpmn:task id="inquire" name="Inquire name and residence of patient" />
    <bpmn:task id="transfer" name="Put doctor through to nursing officer" />
    <bpmn:task id="store-form" name="Store form information in information system" />
    <bpmn:task id="print-form" name="Print form information" />
    <bpmn:task id="create-file" name="Create patient file" />
    <bpmn:task id="store-in-file" name="Store registration form and print in patient file" />
    <bpmn:task id="produce-cards" name="Produce two registration cards" />
    <bpmn:task id="add-new-notice" name="Add new patient to list of new notices" />
    <bpmn:task id="store-assignment" name="Store assignment in information system" />
    <bpmn:task id="pass-cards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="par1" name="Parallel" />
    <bpmn:exclusiveGateway id="mf-required" name="Medical file required?" default="f-mf-required-plan-second" />
    <bpmn:task id="prepare-letter" name="Prepare and send letter requesting medical file" />
    <bpmn:intermediateCatchEvent id="receive-copy" name="Receive medical file copy">
      <bpmn:messageEventDefinition id="receive-copy-def" messageRef="Message_Medical_file_copy" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inform-second" name="Inform second intaker of received medical file" />
    <bpmn:task id="add-copy-file" name="Add medical file copy to patient file" />
    <bpmn:task id="type-out" name="Type out dictaphone tapes" />
    <bpmn:task id="add-transcribed" name="Add transcribed information to patient file" />
    <bpmn:task id="put-on-list" name="Put patient on list of patients that reached status" />
    <bpmn:task id="provide-list" name="Provide team-leader with list of patients" />
    <bpmn:parallelGateway id="par2" name="Join" />
    <bpmn:task id="full-inquiry" name="Make full inquiry into mental health and social state" />
    <bpmn:task id="hand-in-form" name="Hand in registration form at secretarial office" />
    <bpmn:task id="hold-meeting" name="Hold Wednesday staff meeting" />
    <bpmn:task id="assign-intakers" name="Assign new patients to first and second intaker" />
    <bpmn:task id="determine-mf" name="Determine whether medical file is required" />
    <bpmn:task id="record-assignment" name="Record assignments on assignment list" />
    <bpmn:task id="hold-planning" name="Hold Wednesday staff meeting" />
    <bpmn:task id="formulate-plan" name="Formulate treatment plan" />
    <bpmn:endEvent id="end-procedure" name="End intake procedure" />
    <bpmn:task id="plan-first" name="Plan meeting with patient" />
    <bpmn:task id="conduct-first" name="Conduct first meeting and fill standard checklist" />
    <bpmn:task id="register-obs" name="Register additional observations in personal notebook" />
    <bpmn:task id="copy-notes" name="Put copy of notes in patient file" />
    <bpmn:task id="add-checklist" name="Add standard checklist to patient file" />
    <bpmn:task id="plan-second" name="Plan first meeting" />
    <bpmn:task id="conduct-second" name="Conduct first meeting and record observations on dictaphone" />
    <bpmn:sequenceFlow id="f-notice-inquire" sourceRef="notice" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-transfer" sourceRef="inquire" targetRef="transfer" />
    <bpmn:sequenceFlow id="f-transfer-full-inquiry" sourceRef="transfer" targetRef="full-inquiry" />
    <bpmn:sequenceFlow id="f-full-inquiry-hand-in-form" sourceRef="full-inquiry" targetRef="hand-in-form" />
    <bpmn:sequenceFlow id="f-hand-in-form-store-form" sourceRef="hand-in-form" targetRef="store-form" />
    <bpmn:sequenceFlow id="f-store-form-print-form" sourceRef="store-form" targetRef="print-form" />
    <bpmn:sequenceFlow id="f-print-form-create-file" sourceRef="print-form" targetRef="create-file" />
    <bpmn:sequenceFlow id="f-create-file-store-in-file" sourceRef="create-file" targetRef="store-in-file" />
    <bpmn:sequenceFlow id="f-store-in-file-produce-cards" sourceRef="store-in-file" targetRef="produce-cards" />
    <bpmn:sequenceFlow id="f-produce-cards-add-new-notice" sourceRef="produce-cards" targetRef="add-new-notice" />
    <bpmn:sequenceFlow id="f-add-new-notice-hold-meeting" sourceRef="add-new-notice" targetRef="hold-meeting" />
    <bpmn:sequenceFlow id="f-hold-meeting-assign-intakers" sourceRef="hold-meeting" targetRef="assign-intakers" />
    <bpmn:sequenceFlow id="f-assign-intakers-determine-mf" sourceRef="assign-intakers" targetRef="determine-mf" />
    <bpmn:sequenceFlow id="f-determine-mf-record-assignment" sourceRef="determine-mf" targetRef="record-assignment" />
    <bpmn:sequenceFlow id="f-record-assignment-store-assignment" sourceRef="record-assignment" targetRef="store-assignment" />
    <bpmn:sequenceFlow id="f-store-assignment-pass-cards" sourceRef="store-assignment" targetRef="pass-cards" />
    <bpmn:sequenceFlow id="f-pass-cards-par1" sourceRef="pass-cards" targetRef="par1" />
    <bpmn:sequenceFlow id="f-par1-plan-first" sourceRef="par1" targetRef="plan-first" />
    <bpmn:sequenceFlow id="f-par1-mf-required" sourceRef="par1" targetRef="mf-required" />
    <bpmn:sequenceFlow id="f-mf-required-prepare-letter" name="yes" sourceRef="mf-required" targetRef="prepare-letter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">medicalFileRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-mf-required-plan-second" name="no" sourceRef="mf-required" targetRef="plan-second" />
    <bpmn:sequenceFlow id="f-prepare-letter-receive-copy" sourceRef="prepare-letter" targetRef="receive-copy" />
    <bpmn:sequenceFlow id="f-receive-copy-inform-second" sourceRef="receive-copy" targetRef="inform-second" />
    <bpmn:sequenceFlow id="f-inform-second-add-copy-file" sourceRef="inform-second" targetRef="add-copy-file" />
    <bpmn:sequenceFlow id="f-add-copy-file-plan-second" sourceRef="add-copy-file" targetRef="plan-second" />
    <bpmn:sequenceFlow id="f-plan-first-conduct-first" sourceRef="plan-first" targetRef="conduct-first" />
    <bpmn:sequenceFlow id="f-conduct-first-register-obs" sourceRef="conduct-first" targetRef="register-obs" />
    <bpmn:sequenceFlow id="f-register-obs-copy-notes" sourceRef="register-obs" targetRef="copy-notes" />
    <bpmn:sequenceFlow id="f-copy-notes-add-checklist" sourceRef="copy-notes" targetRef="add-checklist" />
    <bpmn:sequenceFlow id="f-add-checklist-par2" sourceRef="add-checklist" targetRef="par2" />
    <bpmn:sequenceFlow id="f-plan-second-conduct-second" sourceRef="plan-second" targetRef="conduct-second" />
    <bpmn:sequenceFlow id="f-conduct-second-type-out" sourceRef="conduct-second" targetRef="type-out" />
    <bpmn:sequenceFlow id="f-type-out-add-transcribed" sourceRef="type-out" targetRef="add-transcribed" />
    <bpmn:sequenceFlow id="f-add-transcribed-par2" sourceRef="add-transcribed" targetRef="par2" />
    <bpmn:sequenceFlow id="f-par2-put-on-list" sourceRef="par2" targetRef="put-on-list" />
    <bpmn:sequenceFlow id="f-put-on-list-provide-list" sourceRef="put-on-list" targetRef="provide-list" />
    <bpmn:sequenceFlow id="f-provide-list-hold-planning" sourceRef="provide-list" targetRef="hold-planning" />
    <bpmn:sequenceFlow id="f-hold-planning-formulate-plan" sourceRef="hold-planning" targetRef="formulate-plan" />
    <bpmn:sequenceFlow id="f-formulate-plan-end-procedure" sourceRef="formulate-plan" targetRef="end-procedure" />
    <bpmn:textAnnotation id="n1">
      <bpmn:text>Patient files are kept at secretarial office and may not leave the building</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="n1-assoc" sourceRef="n1" targetRef="store-in-file" />
  </bpmn:process>
</bpmn:definitions>
