tok 1.0 "Vacations Request"

pool org "Organization"
  lane employee "Employee"
    start s "Vacation request submitted"
    task register "Register requirement"
    task review "Review rejection reasons"
    end e_rejected "Rejection reviewed"
  lane supervisor "Supervisor"
    task decide "Approve or reject request"
    xor g "Approved?"
  lane hr "Human Resources Representative"
    task notify "Generate notification"
    task manage "Complete management procedures"
    end e_done "Management procedures completed"

flow s -> register -> decide -> g
flow g -> review "Rejected" when="approved = false"
flow g -> notify "Approved" when="approved = true"
flow review -> e_rejected
flow notify -> manage -> e_done
