<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Vacation request submitted" />
    <bpmn:task id="register" name="Register requirement" />
    <bpmn:task id="review" name="Review rejection reasons" />
    <bpmn:endEvent id="e_rejected" name="Rejection reviewed" />
    <bpmn:task id="decide" name="Approve or reject request" />
    <bpmn:exclusiveGateway id="g" name="Approved?" />
    <bpmn:task id="notify" name="Generate notification" />
    <bpmn:task id="manage" name="Complete management procedures" />
    <bpmn:endEvent id="e_done" name="Management procedures completed" />
    <bpmn:sequenceFlow id="f-s-register" sourceRef="s" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-decide" sourceRef="register" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-g" sourceRef="decide" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-review" name="Rejected" sourceRef="g" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-notify" name="Approved" sourceRef="g" targetRef="notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-review-e_rejected" sourceRef="review" targetRef="e_rejected" />
    <bpmn:sequenceFlow id="f-notify-manage" sourceRef="notify" targetRef="manage" />
    <bpmn:sequenceFlow id="f-manage-e_done" sourceRef="manage" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>
