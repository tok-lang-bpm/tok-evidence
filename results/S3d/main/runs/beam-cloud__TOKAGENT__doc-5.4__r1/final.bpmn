<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Expense report process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense report process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Start" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="g1" name="Approve or reject?" default="f-g1-edit" />
    <bpmn:task id="check" name="Check receipts" />
    <bpmn:exclusiveGateway id="g2" name="Receipts in order?" default="f-g2-edit" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:serviceTask id="link" name="Link to payment system" />
    <bpmn:receiveTask id="wait" name="Wait for payment confirmation" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:sequenceFlow id="f-s1-purchase" sourceRef="s1" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g1" sourceRef="review" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-check" name="Approved" sourceRef="g1" targetRef="check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-edit" name="Rejected" sourceRef="g1" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-review" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f-check-g2" sourceRef="check" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-accept" name="Yes" sourceRef="g2" targetRef="accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g2-edit" name="No" sourceRef="g2" targetRef="edit" />
    <bpmn:sequenceFlow id="f-accept-link" sourceRef="accept" targetRef="link" />
    <bpmn:sequenceFlow id="f-link-wait" sourceRef="link" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-end1" sourceRef="wait" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
