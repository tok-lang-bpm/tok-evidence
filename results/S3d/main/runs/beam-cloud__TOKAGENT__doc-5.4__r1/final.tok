tok 1.0 "Expense report process"

pool org "Organisation"
  lane employee "Employee"
    start s1 "Start"
    task purchase "Purchase product or service"
    task submit "Submit expense report"
    task edit "Edit expense report"
  lane supervisor "Supervisor"
    task review "Review expense report"
    xor g1 "Approve or reject?"
  lane treasurer "Treasurer"
    task check "Check receipts"
    xor g2 "Receipts in order?"
    task accept "Accept expenses for processing"
  lane system "System"
    service link "Link to payment system"
    receive wait "Wait for payment confirmation"
    end end1 "End"

flow s1 -> purchase -> submit -> review -> g1
flow g1 -> check "Approved" when=""
flow g1 -> edit "Rejected" default
flow edit -> review
flow check -> g2
flow g2 -> accept "Yes" when=""
flow g2 -> edit "No" default
flow accept -> link -> wait -> end1
