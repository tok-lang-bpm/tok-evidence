<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order parts" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Order process" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Order parts" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Monthly">
      <bpmn:timerEventDefinition id="s1-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/2025-01-01T00:00:00Z/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="send the order" />
    <bpmn:task id="t4" name="receive the invoice" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:task id="t2" name="process the order" />
    <bpmn:task id="t3" name="send an invoice" />
    <bpmn:sequenceFlow id="f-s1-t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-e1" sourceRef="t4" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
