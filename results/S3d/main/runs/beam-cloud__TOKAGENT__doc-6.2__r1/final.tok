tok 1.0 "Order parts"

pool p "Order process"
  lane assembler "Assembler AG"
    start s1 "Monthly" timer="R/2025-01-01T00:00:00Z/P1M"
    task t1 "send the order"
    task t4 "receive the invoice"
    end e1 "End"
  lane supplier "Supplier"
    task t2 "process the order"
    task t3 "send an invoice"

flow s1 -> t1
flow t1 -> t2
flow t2 -> t3
flow t3 -> t4
flow t4 -> e1
