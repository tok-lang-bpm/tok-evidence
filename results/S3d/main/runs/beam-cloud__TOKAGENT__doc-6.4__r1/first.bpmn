<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_customer_contact" name="customer-contact" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_huge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="headdev" name="Head of development">
        <bpmn:flowNodeRef>t_head</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_end_interest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>t_pres_sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_call_sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_quot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gpj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_timer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>t_pres_tech</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t1" name="Determine contact details of potential customers" />
    <bpmn:task id="t2" name="Call customer" />
    <bpmn:task id="t3" name="Determine contact person and budget" />
    <bpmn:exclusiveGateway id="g_interest" name="Customer interested?" default="f-g_interest-g_huge" />
    <bpmn:exclusiveGateway id="g_huge" name="Budget huge?" default="f-g_huge-e_left" />
    <bpmn:task id="t_head" name="Acquire customer" />
    <bpmn:exclusiveGateway id="g_end_interest" name="Customer interested in the end?" default="f-g_end_interest-e_left" />
    <bpmn:task id="t_pres_sales" name="Give online presentation" />
    <bpmn:task id="t_call_sales" name="Call customer" />
    <bpmn:task id="t_quot" name="Create quotation" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:endEvent id="e_left" name="Left alone" />
    <bpmn:exclusiveGateway id="g_tech" name="More technical presentation?" default="f-g_tech-t_pres_sales" />
    <bpmn:exclusiveGateway id="gpj" name="Presentation done" />
    <bpmn:exclusiveGateway id="gaw" name="Customer responded" />
    <bpmn:eventBasedGateway id="g_wait" name="Wait for customer" />
    <bpmn:intermediateCatchEvent id="c_contact" name="Customer contacts">
      <bpmn:messageEventDefinition id="c_contact-def" messageRef="Message_customer_contact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_timer" name="2 weeks elapsed">
      <bpmn:timerEventDefinition id="c_timer-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_pres_tech" name="Give technical online presentation" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-g_interest" sourceRef="t3" targetRef="g_interest" />
    <bpmn:sequenceFlow id="f-g_interest-g_tech" name="yes" sourceRef="g_interest" targetRef="g_tech">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_interest-g_huge" name="no" sourceRef="g_interest" targetRef="g_huge" />
    <bpmn:sequenceFlow id="f-g_huge-t_head" name="yes" sourceRef="g_huge" targetRef="t_head">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_huge-e_left" name="no" sourceRef="g_huge" targetRef="e_left" />
    <bpmn:sequenceFlow id="f-t_head-g_end_interest" sourceRef="t_head" targetRef="g_end_interest" />
    <bpmn:sequenceFlow id="f-g_end_interest-g_tech" name="yes" sourceRef="g_end_interest" targetRef="g_tech">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_end_interest-e_left" name="no" sourceRef="g_end_interest" targetRef="e_left" />
    <bpmn:sequenceFlow id="f-g_tech-t_pres_tech" name="technical" sourceRef="g_tech" targetRef="t_pres_tech">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_tech-t_pres_sales" name="standard" sourceRef="g_tech" targetRef="t_pres_sales" />
    <bpmn:sequenceFlow id="f-t_pres_tech-gpj" sourceRef="t_pres_tech" targetRef="gpj" />
    <bpmn:sequenceFlow id="f-t_pres_sales-gpj" sourceRef="t_pres_sales" targetRef="gpj" />
    <bpmn:sequenceFlow id="f-gpj-g_wait" sourceRef="gpj" targetRef="g_wait" />
    <bpmn:sequenceFlow id="f-g_wait-c_contact" sourceRef="g_wait" targetRef="c_contact" />
    <bpmn:sequenceFlow id="f-g_wait-c_timer" sourceRef="g_wait" targetRef="c_timer" />
    <bpmn:sequenceFlow id="f-c_contact-gaw" sourceRef="c_contact" targetRef="gaw" />
    <bpmn:sequenceFlow id="f-c_timer-t_call_sales" sourceRef="c_timer" targetRef="t_call_sales" />
    <bpmn:sequenceFlow id="f-t_call_sales-gaw" sourceRef="t_call_sales" targetRef="gaw" />
    <bpmn:sequenceFlow id="f-gaw-t_quot" sourceRef="gaw" targetRef="t_quot" />
    <bpmn:sequenceFlow id="f-t_quot-e1" sourceRef="t_quot" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
