<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lead processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Organisation" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Lead processing" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="check" name="Check open leads" />
    <bpmn:task id="select" name="Select the top five ones" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call the contact person of the leads" />
    <bpmn:task id="process" name="Process the lead" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="call" name="Call each customer" />
    <bpmn:exclusiveGateway id="gw" name="Interested?" default="f-gw-next" />
    <bpmn:task id="note" name="Send a note to the Manager" />
    <bpmn:task id="next" name="Call the next customer" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-gw" sourceRef="call" targetRef="gw" />
    <bpmn:sequenceFlow id="f-gw-note" name="Yes" sourceRef="gw" targetRef="note">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-next" name="No" sourceRef="gw" targetRef="next" />
    <bpmn:sequenceFlow id="f-note-process" sourceRef="note" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-e" sourceRef="process" targetRef="e" />
    <bpmn:sequenceFlow id="f-next-call" sourceRef="next" targetRef="call" />
  </bpmn:process>
</bpmn:definitions>
