tok 1.0 "Lead processing"

pool p "Organisation"
  lane manager "Manager"
    start s "Start"
    task check "Check open leads"
    task select "Select the top five ones"
    task tell "Tell Sales Assistant to call the contact person of the leads"
    task process "Process the lead"
    end e "End"
  lane assistant "Sales Assistant"
    task call "Call each customer"
    xor gw "Interested?"
    task note "Send a note to the Manager"
    task next "Call the next customer"

flow s -> check
flow check -> select
flow select -> tell
flow tell -> call
flow call -> gw
flow gw -> note "Yes" when="interested = true"
flow gw -> next "No" default
flow note -> process
flow process -> e
flow next -> call
