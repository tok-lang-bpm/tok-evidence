tok 1.0 "Recruitment"

pool main "Organisation"
  lane h "HR"
    start s "Demand to fill post"
    task advertise "Advertise post"
    task apply "Applicants apply"
    task check "Check applications"
    task fill "Fill post"
    task conclude "Conclude contract of employment"
    end e "Post filled"

flow s -> advertise -> apply -> check -> fill -> conclude -> e
