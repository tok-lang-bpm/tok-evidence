<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Recruitment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="main" name="Organisation" processRef="main-process" />
  </bpmn:collaboration>
  <bpmn:process id="main-process" name="Recruitment" isExecutable="false">
    <bpmn:laneSet id="main-lanes">
      <bpmn:lane id="h" name="HR">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Demand to fill post" />
    <bpmn:task id="advertise" name="Advertise post" />
    <bpmn:task id="apply" name="Applicants apply" />
    <bpmn:task id="check" name="Check applications" />
    <bpmn:task id="fill" name="Fill post" />
    <bpmn:task id="conclude" name="Conclude contract of employment" />
    <bpmn:endEvent id="e" name="Post filled" />
    <bpmn:sequenceFlow id="f-s-advertise" sourceRef="s" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-apply" sourceRef="advertise" targetRef="apply" />
    <bpmn:sequenceFlow id="f-apply-check" sourceRef="apply" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-fill" sourceRef="check" targetRef="fill" />
    <bpmn:sequenceFlow id="f-fill-conclude" sourceRef="fill" targetRef="conclude" />
    <bpmn:sequenceFlow id="f-conclude-e" sourceRef="conclude" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
