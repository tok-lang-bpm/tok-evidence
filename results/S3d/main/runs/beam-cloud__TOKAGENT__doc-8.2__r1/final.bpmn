<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Job description approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job description approval" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="hr" name="HR clerk">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_confusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>consider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Vacancy reported" />
    <bpmn:task id="create" name="Create job description" />
    <bpmn:exclusiveGateway id="gw_confusion" name="Confusion in the message?" default="f-gw_confusion-submit" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:task id="submit" name="Submit job description for consideration" />
    <bpmn:task id="correct" name="Correct job description" />
    <bpmn:task id="post" name="Post job" />
    <bpmn:endEvent id="e_post" name="Job posted" />
    <bpmn:task id="consider" name="Consider job description" />
    <bpmn:exclusiveGateway id="gw_approved" name="Approved?" default="f-gw_approved-correct" />
    <bpmn:sequenceFlow id="f-s-create" sourceRef="s" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-gw_confusion" sourceRef="create" targetRef="gw_confusion" />
    <bpmn:sequenceFlow id="f-gw_confusion-ask" name="Yes" sourceRef="gw_confusion" targetRef="ask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_confusion-submit" name="No" sourceRef="gw_confusion" targetRef="submit" />
    <bpmn:sequenceFlow id="f-ask-create" sourceRef="ask" targetRef="create" />
    <bpmn:sequenceFlow id="f-submit-consider" sourceRef="submit" targetRef="consider" />
    <bpmn:sequenceFlow id="f-consider-gw_approved" sourceRef="consider" targetRef="gw_approved" />
    <bpmn:sequenceFlow id="f-gw_approved-post" name="Approved" sourceRef="gw_approved" targetRef="post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_approved-correct" name="Rejected" sourceRef="gw_approved" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-submit" sourceRef="correct" targetRef="submit" />
    <bpmn:sequenceFlow id="f-post-e_post" sourceRef="post" targetRef="e_post" />
  </bpmn:process>
</bpmn:definitions>
