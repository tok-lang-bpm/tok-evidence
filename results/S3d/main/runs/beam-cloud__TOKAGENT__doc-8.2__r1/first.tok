tok 1.0 "Job description approval"

pool org "Organisation"
  lane hr "HR Clerk"
    start s "Vacancy reported"
    task create "Create job description"
    xor gw_confusion "Confusion in the message?"
    task ask "Ask the Department again"
    task submit "Submit job description for consideration"
    task correct "Correct job description"
    task post "Post job"
    end e_post "Job posted"
  lane dept "Department"
    task consider "Consider job description"
    xor gw_approved "Approved?"

flow s -> create
flow create -> gw_confusion
flow gw_confusion -> ask "Yes"
flow gw_confusion -> submit "No" default
flow ask -> create
flow submit -> consider
flow consider -> gw_approved
flow gw_approved -> post "Approved"
flow gw_approved -> correct "Rejected" default
flow correct -> submit
flow post -> e_post
