<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Personnel recruitment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Personnel recruitment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwcorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askcorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>gwq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report vacancy to Personnel Department" />
    <bpmn:task id="review" name="Review job description" />
    <bpmn:exclusiveGateway id="gwcorr" name="Corrections needed?" default="f-gwcorr-approve" />
    <bpmn:task id="askcorr" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:endEvent id="e" name="Job description approved" />
    <bpmn:exclusiveGateway id="gwq" name="Questions about tasks and requirements?" default="f-gwq-describe" />
    <bpmn:task id="askq" name="Ask clarifying questions" />
    <bpmn:task id="describe" name="Describe job" />
    <bpmn:task id="correct" name="Correct job description" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-gwq" sourceRef="report" targetRef="gwq" />
    <bpmn:sequenceFlow id="f-gwq-askq" name="yes" sourceRef="gwq" targetRef="askq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasQuestions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gwq-describe" name="no" sourceRef="gwq" targetRef="describe" />
    <bpmn:sequenceFlow id="f-askq-clarify" sourceRef="askq" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-describe" sourceRef="clarify" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-review" sourceRef="describe" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-gwcorr" sourceRef="review" targetRef="gwcorr" />
    <bpmn:sequenceFlow id="f-gwcorr-askcorr" name="yes" sourceRef="gwcorr" targetRef="askcorr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsCorrections</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gwcorr-approve" name="no" sourceRef="gwcorr" targetRef="approve" />
    <bpmn:sequenceFlow id="f-askcorr-correct" sourceRef="askcorr" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-review" sourceRef="correct" targetRef="review" />
    <bpmn:sequenceFlow id="f-approve-e" sourceRef="approve" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
