tok 1.0 "Personnel recruitment"

pool org "Organisation"
  lane head "Head of functional department"
    start s "Personnel requirements detected"
    task report "Report vacancy to Personnel Department"
    task review "Review job description"
    xor gwcorr "Corrections needed?"
    task askcorr "Ask for corrections"
    task approve "Approve job description"
    task clarify "Provide clarifications"
    end e "Job description approved"
  lane hr "Personnel Department"
    xor gwq "Questions about tasks and requirements?"
    task askq "Ask clarifying questions"
    task describe "Describe job"
    task correct "Correct job description"

flow s -> report -> gwq
flow gwq -> askq "yes" when="hasQuestions"
flow gwq -> describe "no" default
flow askq -> clarify -> describe -> review -> gwcorr
flow gwcorr -> askcorr "yes" when="needsCorrections"
flow gwcorr -> approve "no" default
flow askcorr -> correct -> review
flow approve -> e
