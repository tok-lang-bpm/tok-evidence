<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Schedule meetings" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Schedule meetings" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>check-diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="draft" name="Draft a schedule of meetings" />
    <bpmn:task id="add" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="look" name="Look for potential conflicts" />
    <bpmn:sendTask id="send-final" name="Send final schedule of meeting dates" />
    <bpmn:task id="check" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="check-diaries" name="Check their diaries" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of any conflicts" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-draft" sourceRef="s" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-add" sourceRef="draft" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-check" sourceRef="add" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-suggest" sourceRef="check" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-look" sourceRef="recheck" targetRef="look" />
    <bpmn:sequenceFlow id="f-look-send-final" sourceRef="look" targetRef="send-final" />
    <bpmn:sequenceFlow id="f-send-final-check-diaries" sourceRef="send-final" targetRef="check-diaries" />
    <bpmn:sequenceFlow id="f-check-diaries-advise" sourceRef="check-diaries" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-e" sourceRef="advise" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
