tok 1.0 "Schedule meetings"

pool authority "Town Planning Authority" {
  lane coordination "Coordination Unit" {
    start s "Start"
    task draft "Draft a schedule of meetings"
    task add "Add draft dates to all calendars"
    task recheck "Recheck all dates"
    task look "Look for potential conflicts"
    send send-final "Send final schedule of meeting dates"
    task receive-advice "Receive advice of conflicts"
  }
  lane support "Support Officer" {
    task check "Check the dates"
    task suggest "Suggest modifications"
  }
  lane committee "Committee Members" {
    task check-diaries "Check their diaries"
    task advise "Advise the Coordination Unit of any conflicts"
    end e "End"
  }
}

flow s -> draft
flow draft -> add
flow add -> check
flow check -> suggest
flow suggest -> recheck
flow recheck -> look
flow look -> send-final
flow send-final -> check-diaries
flow check-diaries -> advise
flow advise -> receive-advice
flow receive-advice -> e
