<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize-dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-minutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise-members</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce-minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>read-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold-meeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Dates to be finalized" />
    <bpmn:task id="finalize-dates" name="Finalize meeting dates" />
    <bpmn:task id="qa-check" name="Conduct QA check on the minutes" />
    <bpmn:task id="send-minutes" name="Send minutes to all Committee Members" />
    <bpmn:parallelGateway id="g1" name="Prepare meeting" />
    <bpmn:task id="update-calendars" name="Update all group calendars" />
    <bpmn:task id="create-folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="upload-docs" name="Ensure all appropriate documents are uploaded to system" />
    <bpmn:parallelGateway id="g2" name="Preparation complete" />
    <bpmn:task id="advise-members" name="Advise Committee Members a week before meeting" />
    <bpmn:task id="produce-minutes" name="Produce minutes including Action Points" />
    <bpmn:task id="update-records" name="Update all departmental records" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="read-docs" name="Read related documents" />
    <bpmn:task id="hold-meeting" name="Hold meeting" />
    <bpmn:sequenceFlow id="f-s-finalize-dates" sourceRef="s" targetRef="finalize-dates" />
    <bpmn:sequenceFlow id="f-finalize-dates-g1" sourceRef="finalize-dates" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-update-calendars" sourceRef="g1" targetRef="update-calendars" />
    <bpmn:sequenceFlow id="f-g1-create-folders" sourceRef="g1" targetRef="create-folders" />
    <bpmn:sequenceFlow id="f-g1-upload-docs" sourceRef="g1" targetRef="upload-docs" />
    <bpmn:sequenceFlow id="f-update-calendars-g2" sourceRef="update-calendars" targetRef="g2" />
    <bpmn:sequenceFlow id="f-create-folders-g2" sourceRef="create-folders" targetRef="g2" />
    <bpmn:sequenceFlow id="f-upload-docs-g2" sourceRef="upload-docs" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-advise-members" sourceRef="g2" targetRef="advise-members" />
    <bpmn:sequenceFlow id="f-advise-members-read-docs" sourceRef="advise-members" targetRef="read-docs" />
    <bpmn:sequenceFlow id="f-read-docs-hold-meeting" sourceRef="read-docs" targetRef="hold-meeting" />
    <bpmn:sequenceFlow id="f-hold-meeting-produce-minutes" sourceRef="hold-meeting" targetRef="produce-minutes" />
    <bpmn:sequenceFlow id="f-produce-minutes-qa-check" sourceRef="produce-minutes" targetRef="qa-check" />
    <bpmn:sequenceFlow id="f-qa-check-send-minutes" sourceRef="qa-check" targetRef="send-minutes" />
    <bpmn:sequenceFlow id="f-send-minutes-update-records" sourceRef="send-minutes" targetRef="update-records" />
    <bpmn:sequenceFlow id="f-update-records-e" sourceRef="update-records" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
