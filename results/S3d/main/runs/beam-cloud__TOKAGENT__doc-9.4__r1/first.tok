tok 1.0 "Committee meeting process"

pool org "Organisation"
  lane coordination "Coordination Unit"
    start s "Dates to be finalized"
    task finalize-dates "Finalize meeting dates"
    task qa-check "Conduct QA check on the minutes"
    task send-minutes "Send minutes to all Committee Members"
  lane support "Support Officer"
    task update-calendars "Update all group calendars"
    task create-folders "Create meeting folders for each meeting"
    task upload-docs "Ensure all appropriate documents are uploaded to system"
    task advise-members "Advise Committee Members a week before meeting"
    task produce-minutes "Produce minutes including Action Points"
    task update-records "Update all departmental records"
    end e "End"
  lane committee "Committee Members"
    task read-docs "Read related documents"
    task hold-meeting "Hold meeting"
  and g1 "Prepare meeting"
  and g2 "Preparation complete"

flow s -> finalize-dates
flow finalize-dates -> g1
flow g1 -> update-calendars
flow g1 -> create-folders
flow g1 -> upload-docs
flow update-calendars -> g2
flow create-folders -> g2
flow upload-docs -> g2
flow g2 -> advise-members
flow advise-members -> read-docs
flow read-docs -> hold-meeting
flow hold-meeting -> produce-minutes
flow produce-minutes -> qa-check
flow qa-check -> send-minutes
flow send-minutes -> update-records
flow update-records -> e