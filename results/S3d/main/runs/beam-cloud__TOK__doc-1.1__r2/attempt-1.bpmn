<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customized bicycle manufacturing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customized bicycle manufacturing" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_eng</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>process_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_qty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Order received" />
    <bpmn:exclusiveGateway id="choice" name="Reject or accept?" />
    <bpmn:task id="reject" name="Reject the order" />
    <bpmn:task id="accept" name="Accept the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="inform_store" name="Inform the storehouse" />
    <bpmn:task id="inform_eng" name="Inform the engineering department" />
    <bpmn:task id="ship" name="Ship the bicycle" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:task id="process_list" name="Process the part list" />
    <bpmn:task id="check_qty" name="Check the required quantity" />
    <bpmn:exclusiveGateway id="avail" name="Part available in-house?" />
    <bpmn:task id="reserve" name="Reserve the part" />
    <bpmn:task id="backorder" name="Back-order the part" />
    <bpmn:exclusiveGateway id="more" name="More items to process?" />
    <bpmn:task id="prepare" name="Prepare everything for the assembling" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:parallelGateway id="join" />
    <bpmn:sequenceFlow id="f-received-choice" sourceRef="received" targetRef="choice" />
    <bpmn:sequenceFlow id="f-choice-reject" name="Reject" sourceRef="choice" targetRef="reject" />
    <bpmn:sequenceFlow id="f-choice-accept" name="Accept" sourceRef="choice" targetRef="accept" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-split" sourceRef="accept" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-inform_store" sourceRef="split" targetRef="inform_store" />
    <bpmn:sequenceFlow id="f-split-inform_eng" sourceRef="split" targetRef="inform_eng" />
    <bpmn:sequenceFlow id="f-inform_store-process_list" sourceRef="inform_store" targetRef="process_list" />
    <bpmn:sequenceFlow id="f-inform_eng-prepare" sourceRef="inform_eng" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-process_list-check_qty" sourceRef="process_list" targetRef="check_qty" />
    <bpmn:sequenceFlow id="f-check_qty-avail" sourceRef="check_qty" targetRef="avail" />
    <bpmn:sequenceFlow id="f-avail-reserve" name="Yes" sourceRef="avail" targetRef="reserve" />
    <bpmn:sequenceFlow id="f-avail-backorder" name="No" sourceRef="avail" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-reserve-more" sourceRef="reserve" targetRef="more" />
    <bpmn:sequenceFlow id="f-backorder-more" sourceRef="backorder" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-check_qty" name="Yes" sourceRef="more" targetRef="check_qty" />
    <bpmn:sequenceFlow id="f-more-join" name="No" sourceRef="more" targetRef="join" />
    <bpmn:sequenceFlow id="f-prepare-join" sourceRef="prepare" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-assemble" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-completed" sourceRef="ship" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
