<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Room service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="call" name="Guest calls room service" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:task id="submit" name="Submit an order ticket to the kitchen" />
    <bpmn:task id="assign" name="Assign the order to the waiter" />
    <bpmn:exclusiveGateway id="alcohol" name="Alcoholic beverage included?" default="f-alcohol-join" />
    <bpmn:task id="give" name="Give an order to the sommelier" />
    <bpmn:parallelGateway id="fork" name="Ready tasks" />
    <bpmn:parallelGateway id="join" name="All tasks complete" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:task id="prepare" name="Prepare the food" />
    <bpmn:task id="fetch" name="Fetch wine from the cellar and prepare alcoholic beverages" />
    <bpmn:task id="cart" name="Ready a cart" />
    <bpmn:task id="drinks" name="Prepare nonalcoholic drinks" />
    <bpmn:sequenceFlow id="f-call-take" sourceRef="call" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-submit" sourceRef="take" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assign" sourceRef="submit" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-fork" sourceRef="assign" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-prepare" sourceRef="fork" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-fork-alcohol" sourceRef="fork" targetRef="alcohol" />
    <bpmn:sequenceFlow id="f-fork-cart" sourceRef="fork" targetRef="cart" />
    <bpmn:sequenceFlow id="f-fork-drinks" sourceRef="fork" targetRef="drinks" />
    <bpmn:sequenceFlow id="f-alcohol-give" name="yes" sourceRef="alcohol" targetRef="give">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alcoholic = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-alcohol-join" name="no" sourceRef="alcohol" targetRef="join" />
    <bpmn:sequenceFlow id="f-give-fetch" sourceRef="give" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-join" sourceRef="fetch" targetRef="join" />
    <bpmn:sequenceFlow id="f-prepare-join" sourceRef="prepare" targetRef="join" />
    <bpmn:sequenceFlow id="f-cart-join" sourceRef="cart" targetRef="join" />
    <bpmn:sequenceFlow id="f-drinks-join" sourceRef="drinks" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-deliver" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-debit" sourceRef="deliver" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-done" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
