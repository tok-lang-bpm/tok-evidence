<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Room service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="evanstonian" name="The Evanstonian" processRef="evanstonian-process" />
  </bpmn:collaboration>
  <bpmn:process id="evanstonian-process" name="Room service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="evanstonian-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>take_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare_food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch_wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ready_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_nonalcoholic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>items_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Room service requested" />
    <bpmn:task id="take_order" name="Take down the order" />
    <bpmn:task id="submit_ticket" name="Submit an order ticket to the kitchen" />
    <bpmn:parallelGateway id="start_prep" name="Begin order preparation" />
    <bpmn:exclusiveGateway id="alcohol" name="Order includes alcoholic beverage?" default="f-alcohol-merge_assign" />
    <bpmn:task id="give_order" name="Give an order to the sommelier" />
    <bpmn:parallelGateway id="give_split" name="Begin wine preparation" />
    <bpmn:exclusiveGateway id="merge_assign" name="Assign order to waiter" />
    <bpmn:task id="assign_order" name="Assign the order to the waiter" />
    <bpmn:task id="prepare_food" name="Prepare food" />
    <bpmn:task id="fetch_wine" name="Fetch wine from the cellar and prepare alcoholic beverages" />
    <bpmn:task id="ready_cart" name="Ready a cart" />
    <bpmn:task id="prepare_nonalcoholic" name="Prepare nonalcoholic drinks" />
    <bpmn:inclusiveGateway id="items_ready" name="Food, wine and cart ready" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="billed" name="Guest's account debited" />
    <bpmn:sequenceFlow id="f-requested-take_order" sourceRef="requested" targetRef="take_order" />
    <bpmn:sequenceFlow id="f-take_order-submit_ticket" sourceRef="take_order" targetRef="submit_ticket" />
    <bpmn:sequenceFlow id="f-submit_ticket-start_prep" sourceRef="submit_ticket" targetRef="start_prep" />
    <bpmn:sequenceFlow id="f-start_prep-prepare_food" sourceRef="start_prep" targetRef="prepare_food" />
    <bpmn:sequenceFlow id="f-start_prep-alcohol" sourceRef="start_prep" targetRef="alcohol" />
    <bpmn:sequenceFlow id="f-alcohol-give_order" name="yes" sourceRef="alcohol" targetRef="give_order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alcoholic</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-alcohol-merge_assign" name="no" sourceRef="alcohol" targetRef="merge_assign" />
    <bpmn:sequenceFlow id="f-give_order-give_split" sourceRef="give_order" targetRef="give_split" />
    <bpmn:sequenceFlow id="f-give_split-merge_assign" sourceRef="give_split" targetRef="merge_assign" />
    <bpmn:sequenceFlow id="f-give_split-fetch_wine" sourceRef="give_split" targetRef="fetch_wine" />
    <bpmn:sequenceFlow id="f-merge_assign-assign_order" sourceRef="merge_assign" targetRef="assign_order" />
    <bpmn:sequenceFlow id="f-assign_order-ready_cart" sourceRef="assign_order" targetRef="ready_cart" />
    <bpmn:sequenceFlow id="f-ready_cart-prepare_nonalcoholic" sourceRef="ready_cart" targetRef="prepare_nonalcoholic" />
    <bpmn:sequenceFlow id="f-prepare_food-items_ready" sourceRef="prepare_food" targetRef="items_ready" />
    <bpmn:sequenceFlow id="f-fetch_wine-items_ready" sourceRef="fetch_wine" targetRef="items_ready" />
    <bpmn:sequenceFlow id="f-prepare_nonalcoholic-items_ready" sourceRef="prepare_nonalcoholic" targetRef="items_ready" />
    <bpmn:sequenceFlow id="f-items_ready-deliver" sourceRef="items_ready" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-debit" sourceRef="deliver" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-billed" sourceRef="debit" targetRef="billed" />
  </bpmn:process>
</bpmn:definitions>
