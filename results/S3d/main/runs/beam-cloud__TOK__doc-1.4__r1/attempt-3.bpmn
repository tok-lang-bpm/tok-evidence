<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Company going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Company going public" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Company going public" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>decision_to_go_public</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_underwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>provide_advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>facts_fair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_seal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_blue_sky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm_up_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrange_roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason_not_to_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm_commitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer_public</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_handled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="Securities and Exchange Commission">
        <bpmn:flowNodeRef>approve_registration</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decision_to_go_public" name="Decision to go public" />
    <bpmn:task id="select_underwriters" name="Select underwriters" />
    <bpmn:task id="provide_advice" name="Provide procedural and financial advice" />
    <bpmn:exclusiveGateway id="facts_fair" name="Facts presented fairly?" default="f-facts_fair-not_handled" />
    <bpmn:task id="give_seal" name="Give seal of approval" />
    <bpmn:task id="prepare_registration" name="Prepare registration statement" />
    <bpmn:parallelGateway id="split_reg" />
    <bpmn:task id="register_issue" name="Register issue with SEC" />
    <bpmn:task id="check_blue_sky" name="Check compliance with blue-sky laws" />
    <bpmn:task id="firm_up_price" name="Firm up issue price" />
    <bpmn:task id="arrange_roadshow" name="Arrange road show" />
    <bpmn:task id="receive_clearance" name="Receive clearance from SEC" />
    <bpmn:parallelGateway id="join_reg" />
    <bpmn:task id="fix_price" name="Fix issue price" />
    <bpmn:exclusiveGateway id="reason_not_to_offer" name="Any reason not to offer?" default="f-reason_not_to_offer-firm_commitment" />
    <bpmn:task id="firm_commitment" name="Enter firm commitment to buy stock" />
    <bpmn:task id="offer_public" name="Offer to public" />
    <bpmn:endEvent id="offered" name="Issue offered to public" />
    <bpmn:endEvent id="not_offered" name="Issue not offered to public" />
    <bpmn:endEvent id="not_handled" name="Issue not handled" />
    <bpmn:task id="approve_registration" name="Approve registration statement" />
    <bpmn:sequenceFlow id="f-decision_to_go_public-select_underwriters" sourceRef="decision_to_go_public" targetRef="select_underwriters" />
    <bpmn:sequenceFlow id="f-select_underwriters-provide_advice" sourceRef="select_underwriters" targetRef="provide_advice" />
    <bpmn:sequenceFlow id="f-provide_advice-facts_fair" sourceRef="provide_advice" targetRef="facts_fair" />
    <bpmn:sequenceFlow id="f-facts_fair-give_seal" name="yes" sourceRef="facts_fair" targetRef="give_seal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">factsPresentedFairly</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-facts_fair-not_handled" name="no" sourceRef="facts_fair" targetRef="not_handled" />
    <bpmn:sequenceFlow id="f-give_seal-prepare_registration" sourceRef="give_seal" targetRef="prepare_registration" />
    <bpmn:sequenceFlow id="f-prepare_registration-split_reg" sourceRef="prepare_registration" targetRef="split_reg" />
    <bpmn:sequenceFlow id="f-split_reg-register_issue" sourceRef="split_reg" targetRef="register_issue" />
    <bpmn:sequenceFlow id="f-split_reg-check_blue_sky" sourceRef="split_reg" targetRef="check_blue_sky" />
    <bpmn:sequenceFlow id="f-split_reg-firm_up_price" sourceRef="split_reg" targetRef="firm_up_price" />
    <bpmn:sequenceFlow id="f-register_issue-approve_registration" sourceRef="register_issue" targetRef="approve_registration" />
    <bpmn:sequenceFlow id="f-approve_registration-receive_clearance" sourceRef="approve_registration" targetRef="receive_clearance" />
    <bpmn:sequenceFlow id="f-receive_clearance-join_reg" sourceRef="receive_clearance" targetRef="join_reg" />
    <bpmn:sequenceFlow id="f-check_blue_sky-join_reg" sourceRef="check_blue_sky" targetRef="join_reg" />
    <bpmn:sequenceFlow id="f-firm_up_price-arrange_roadshow" sourceRef="firm_up_price" targetRef="arrange_roadshow" />
    <bpmn:sequenceFlow id="f-arrange_roadshow-join_reg" sourceRef="arrange_roadshow" targetRef="join_reg" />
    <bpmn:sequenceFlow id="f-join_reg-fix_price" sourceRef="join_reg" targetRef="fix_price" />
    <bpmn:sequenceFlow id="f-fix_price-reason_not_to_offer" sourceRef="fix_price" targetRef="reason_not_to_offer" />
    <bpmn:sequenceFlow id="f-reason_not_to_offer-firm_commitment" name="No" sourceRef="reason_not_to_offer" targetRef="firm_commitment" />
    <bpmn:sequenceFlow id="f-reason_not_to_offer-not_offered" name="Yes" sourceRef="reason_not_to_offer" targetRef="not_offered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-firm_commitment-offer_public" sourceRef="firm_commitment" targetRef="offer_public" />
    <bpmn:sequenceFlow id="f-offer_public-offered" sourceRef="offer_public" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
