<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Going public" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>facts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bluesky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firmup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveclearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cleared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixprice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notHandled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notoffered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decide" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advice" name="Provide procedural and financial advice" />
    <bpmn:exclusiveGateway id="facts" name="Facts presented fairly?" default="f-facts-init" />
    <bpmn:parallelGateway id="init" name="Prepare registration" />
    <bpmn:task id="register" name="Register issue with SEC" />
    <bpmn:task id="bluesky" name="Check blue-sky laws compliance" />
    <bpmn:parallelGateway id="regdone" name="Registration prepared" />
    <bpmn:parallelGateway id="await" name="Await approval" />
    <bpmn:task id="firmup" name="Firm up issue price" />
    <bpmn:task id="roadshow" name="Arrange road show" />
    <bpmn:task id="receiveclearance" name="Receive clearance from SEC" />
    <bpmn:parallelGateway id="cleared" name="Clearance received" />
    <bpmn:task id="fixprice" name="Fix issue price" />
    <bpmn:exclusiveGateway id="proceed" name="Any reason not to proceed?" default="f-proceed-commitment" />
    <bpmn:task id="commitment" name="Enter firm commitment to buy the stock" />
    <bpmn:task id="offer" name="Offer it to the public" />
    <bpmn:endEvent id="notHandled" name="Issue not handled" />
    <bpmn:endEvent id="notoffered" name="Issue not offered" />
    <bpmn:endEvent id="offered" name="Issue offered to the public" />
    <bpmn:task id="approve" name="Approve registration statement" />
    <bpmn:task id="clear" name="Grant clearance" />
    <bpmn:sequenceFlow id="f-decide-select" sourceRef="decide" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-advice" sourceRef="select" targetRef="advice" />
    <bpmn:sequenceFlow id="f-advice-facts" sourceRef="advice" targetRef="facts" />
    <bpmn:sequenceFlow id="f-facts-init" name="Yes" sourceRef="facts" targetRef="init" />
    <bpmn:sequenceFlow id="f-facts-notHandled" name="No" sourceRef="facts" targetRef="notHandled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">factsFair = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-init-register" sourceRef="init" targetRef="register" />
    <bpmn:sequenceFlow id="f-init-bluesky" sourceRef="init" targetRef="bluesky" />
    <bpmn:sequenceFlow id="f-register-regdone" sourceRef="register" targetRef="regdone" />
    <bpmn:sequenceFlow id="f-bluesky-regdone" sourceRef="bluesky" targetRef="regdone" />
    <bpmn:sequenceFlow id="f-regdone-await" sourceRef="regdone" targetRef="await" />
    <bpmn:sequenceFlow id="f-await-approve" sourceRef="await" targetRef="approve" />
    <bpmn:sequenceFlow id="f-await-firmup" sourceRef="await" targetRef="firmup" />
    <bpmn:sequenceFlow id="f-approve-clear" sourceRef="approve" targetRef="clear" />
    <bpmn:sequenceFlow id="f-clear-receiveclearance" sourceRef="clear" targetRef="receiveclearance" />
    <bpmn:sequenceFlow id="f-firmup-roadshow" sourceRef="firmup" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-receiveclearance-cleared" sourceRef="receiveclearance" targetRef="cleared" />
    <bpmn:sequenceFlow id="f-roadshow-cleared" sourceRef="roadshow" targetRef="cleared" />
    <bpmn:sequenceFlow id="f-cleared-fixprice" sourceRef="cleared" targetRef="fixprice" />
    <bpmn:sequenceFlow id="f-fixprice-proceed" sourceRef="fixprice" targetRef="proceed" />
    <bpmn:sequenceFlow id="f-proceed-commitment" name="Proceed" sourceRef="proceed" targetRef="commitment" />
    <bpmn:sequenceFlow id="f-proceed-notoffered" name="Reason found" sourceRef="proceed" targetRef="notoffered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-commitment-offer" sourceRef="commitment" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-offered" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
