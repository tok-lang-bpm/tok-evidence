tok 1.0 "Going public"

pool organisation "Organisation"
  lane company "Company"
    start decide "Company decides to go public"
    task select "Select the underwriters"
  lane underwriters "Underwriters"
    task advice "Provide procedural and financial advice"
    xor facts "Facts presented fairly?"
    and init "Prepare registration"
    task register "Register issue with SEC"
    task bluesky "Check blue-sky laws compliance"
    and regdone "Registration prepared"
    and await "Await approval"
    task firmup "Firm up issue price"
    task roadshow "Arrange road show"
    task receiveclearance "Receive clearance from SEC"
    and cleared "Clearance received"
    task fixprice "Fix issue price"
    xor proceed "Any reason not to proceed?"
    task commitment "Enter firm commitment to buy the stock"
    task offer "Offer it to the public"
    end notHandled "Issue not handled"
    end notoffered "Issue not offered"
    end offered "Issue offered to the public"
  lane sec "SEC"
    task approve "Approve registration statement"
    task clear "Grant clearance"

flow decide -> select -> advice
flow advice -> facts
flow facts -> init "Yes" default
flow facts -> notHandled "No" when="factsFair = false"
flow init -> register
flow init -> bluesky
flow register -> regdone
flow bluesky -> regdone
flow regdone -> await
flow await -> approve
flow await -> firmup
flow approve -> clear
flow clear -> receiveclearance
flow firmup -> roadshow
flow receiveclearance -> cleared
flow roadshow -> cleared
flow cleared -> fixprice
flow fixprice -> proceed
flow proceed -> commitment "Proceed" default
flow proceed -> notoffered "Reason found" when="reasonFound = true"
flow commitment -> offer
flow offer -> offered
