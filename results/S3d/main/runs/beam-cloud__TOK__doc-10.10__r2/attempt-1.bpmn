<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Fault handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Fault handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="faultdetector" name="Fault Detector">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>suspected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informedInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informGORes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Failure reported" />
    <bpmn:task id="report" name="Report the failure" />
    <bpmn:startEvent id="suspected" name="Suspicion of own fault" />
    <bpmn:exclusiveGateway id="source" name="Failure source?" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="decision" name="Failure confirmed?" />
    <bpmn:task id="reject" name="Reject the failure of the fault detector" />
    <bpmn:parallelGateway id="informInitial" name="Inform GO and MSP" />
    <bpmn:task id="informGO" name="Inform the GO" />
    <bpmn:task id="informMSP" name="Inform the MSP" />
    <bpmn:parallelGateway id="informedInitial" name="GO and MSP informed" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="share" name="Share the results of the repairs with the fault detector" />
    <bpmn:task id="informGORes" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="informMSPRes" name="Inform the MSP about the resolution of the interference" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:endEvent id="resolved" name="Failure resolved" />
    <bpmn:sequenceFlow id="f-reported-report" sourceRef="reported" targetRef="report" />
    <bpmn:sequenceFlow id="f-suspected-source" sourceRef="suspected" targetRef="source" />
    <bpmn:sequenceFlow id="f-report-source" sourceRef="report" targetRef="source" />
    <bpmn:sequenceFlow id="f-source-examine" sourceRef="source" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-decision" sourceRef="examine" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="Rejects" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-informInitial" name="Confirms" sourceRef="decision" targetRef="informInitial" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-informInitial-informGO" sourceRef="informInitial" targetRef="informGO" />
    <bpmn:sequenceFlow id="f-informInitial-informMSP" sourceRef="informInitial" targetRef="informMSP" />
    <bpmn:sequenceFlow id="f-informGO-informedInitial" sourceRef="informGO" targetRef="informedInitial" />
    <bpmn:sequenceFlow id="f-informMSP-informedInitial" sourceRef="informMSP" targetRef="informedInitial" />
    <bpmn:sequenceFlow id="f-informedInitial-fix" sourceRef="informedInitial" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-informGORes" sourceRef="share" targetRef="informGORes" />
    <bpmn:sequenceFlow id="f-informGORes-informMSPRes" sourceRef="informGORes" targetRef="informMSPRes" />
    <bpmn:sequenceFlow id="f-informMSPRes-resolved" sourceRef="informMSPRes" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
