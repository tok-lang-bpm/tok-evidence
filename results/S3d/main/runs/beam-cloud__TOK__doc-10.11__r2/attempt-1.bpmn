<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="GO, MSP and SP process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="GO, MSP and SP process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_measurements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_measured_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_changed_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_readings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_measurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_measured_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="request_measurements" name="Request the measurements" />
    <bpmn:task id="process_measured_values" name="Process the measured values" />
    <bpmn:task id="send_changed_values" name="Send the changed values" />
    <bpmn:task id="transmit_readings" name="Transmit the readings" />
    <bpmn:endEvent id="done" name="Readings transmitted" />
    <bpmn:task id="check_request" name="Check the received request" />
    <bpmn:exclusiveGateway id="decide" name="Deny or perform?" default="f-decide-perform_measurement" />
    <bpmn:task id="deny_request" name="Deny the request" />
    <bpmn:task id="perform_measurement" name="Perform the measurement" />
    <bpmn:task id="inform_failure" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="transmit_measured_values" name="Transmit the measured values to the GO" />
    <bpmn:endEvent id="failed" name="Request denied" />
    <bpmn:sequenceFlow id="f-start-request_measurements" sourceRef="start" targetRef="request_measurements" />
    <bpmn:sequenceFlow id="f-request_measurements-check_request" sourceRef="request_measurements" targetRef="check_request" />
    <bpmn:sequenceFlow id="f-check_request-decide" sourceRef="check_request" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-deny_request" name="deny" sourceRef="decide" targetRef="deny_request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">denied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decide-perform_measurement" name="perform" sourceRef="decide" targetRef="perform_measurement" />
    <bpmn:sequenceFlow id="f-deny_request-inform_failure" sourceRef="deny_request" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="f-inform_failure-failed" sourceRef="inform_failure" targetRef="failed" />
    <bpmn:sequenceFlow id="f-perform_measurement-transmit_measured_values" sourceRef="perform_measurement" targetRef="transmit_measured_values" />
    <bpmn:sequenceFlow id="f-transmit_measured_values-process_measured_values" sourceRef="transmit_measured_values" targetRef="process_measured_values" />
    <bpmn:sequenceFlow id="f-process_measured_values-send_changed_values" sourceRef="process_measured_values" targetRef="send_changed_values" />
    <bpmn:sequenceFlow id="f-send_changed_values-transmit_readings" sourceRef="send_changed_values" targetRef="transmit_readings" />
    <bpmn:sequenceFlow id="f-transmit_readings-done" sourceRef="transmit_readings" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
