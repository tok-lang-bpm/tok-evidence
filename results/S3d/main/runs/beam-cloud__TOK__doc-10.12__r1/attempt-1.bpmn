<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Master data change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Master data change" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>can_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="tell" name="Tell the INQ about the change of his master data" />
    <bpmn:task id="notify" name="Notify the IP of the change" />
    <bpmn:task id="check" name="Check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="can_change" name="Can be changed at desired time?" />
    <bpmn:task id="confirm" name="Confirm the changes of the INQ" />
    <bpmn:task id="reject" name="Reject the changes of the INQ" />
    <bpmn:endEvent id="done" name="Changes processed" />
    <bpmn:sequenceFlow id="f-s-tell" sourceRef="s" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-notify" sourceRef="tell" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-check" sourceRef="notify" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-can_change" sourceRef="check" targetRef="can_change" />
    <bpmn:sequenceFlow id="f-can_change-confirm" name="yes" sourceRef="can_change" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-can_change-reject" name="no" sourceRef="can_change" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
    <bpmn:sequenceFlow id="f-reject-done" sourceRef="reject" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
