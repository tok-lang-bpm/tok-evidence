<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Transaction data request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Transaction data request" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Start" />
    <bpmn:task id="transmit_request" name="Transmit the transaction data request" />
    <bpmn:task id="check_request" name="Check the request" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome of the examination?" />
    <bpmn:task id="transmit_data" name="Transmit the data" />
    <bpmn:task id="reject_request" name="Reject the request" />
    <bpmn:endEvent id="handled" name="Request handled" />
    <bpmn:sequenceFlow id="f-start_event-transmit_request" sourceRef="start_event" targetRef="transmit_request" />
    <bpmn:sequenceFlow id="f-transmit_request-check_request" sourceRef="transmit_request" targetRef="check_request" />
    <bpmn:sequenceFlow id="f-check_request-outcome" sourceRef="check_request" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-transmit_data" name="Transmission of data" sourceRef="outcome" targetRef="transmit_data" />
    <bpmn:sequenceFlow id="f-outcome-reject_request" name="Rejection" sourceRef="outcome" targetRef="reject_request" />
    <bpmn:sequenceFlow id="f-transmit_data-handled" sourceRef="transmit_data" targetRef="handled" />
    <bpmn:sequenceFlow id="f-reject_request-handled" sourceRef="reject_request" targetRef="handled" />
  </bpmn:process>
</bpmn:definitions>
