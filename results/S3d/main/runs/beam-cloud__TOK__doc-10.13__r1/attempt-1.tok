tok 1.0 "Transaction data request"

pool organisation "Organisation"
  lane inq "INQ"
    start start_event "Start"
    task transmit_request "Transmit the transaction data request"
  lane ip "IP"
    task check_request "Check the request"
    xor outcome "Outcome of the examination?"
    task transmit_data "Transmit the data"
    task reject_request "Reject the request"
    end handled "Request handled"

flow start_event -> transmit_request -> check_request -> outcome
flow outcome -> transmit_data "Transmission of data"
flow outcome -> reject_request "Rejection"
flow transmit_data -> handled
flow reject_request -> handled
