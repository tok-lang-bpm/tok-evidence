<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Transaction data request processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Transaction data request processing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome of the examination?" default="f-outcome-reject" />
    <bpmn:task id="transmit_data" name="Transmission of data" />
    <bpmn:task id="reject" name="Rejection" />
    <bpmn:exclusiveGateway id="answered" name="Answered?" />
    <bpmn:endEvent id="done" name="Question answered" />
    <bpmn:sequenceFlow id="f-start-transmit" sourceRef="start" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-check" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-outcome" sourceRef="check" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-transmit_data" name="Transmission of data" sourceRef="outcome" targetRef="transmit_data">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-outcome-reject" name="Rejection" sourceRef="outcome" targetRef="reject" />
    <bpmn:sequenceFlow id="f-transmit_data-answered" sourceRef="transmit_data" targetRef="answered" />
    <bpmn:sequenceFlow id="f-reject-answered" sourceRef="reject" targetRef="answered" />
    <bpmn:sequenceFlow id="f-answered-done" sourceRef="answered" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
