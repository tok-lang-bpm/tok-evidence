<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Billing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Billing" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_metering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equipment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>send_measurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_readings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scenario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recipient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>examine_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_mpon</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send_metering" name="Send the bill for the temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="send_equipment" name="Send the bill for the equipment acquisition to the MPON or the GO" />
    <bpmn:task id="send_measurement" name="Send the bill for the temporary continuation of the measurement to the GO" />
    <bpmn:task id="send_readings" name="Send the bill for additional readings to the GO" />
    <bpmn:task id="examine_go" name="Examine the bill" />
    <bpmn:task id="confirm_go" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject_go" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:exclusiveGateway id="scenario" name="Bill scenario?" />
    <bpmn:exclusiveGateway id="recipient" name="MPON or GO?" />
    <bpmn:exclusiveGateway id="outcome" name="Confirm or reject?" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:task id="examine_mpon" name="Examine the bill" />
    <bpmn:task id="confirm_mpon" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject_mpon" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:sequenceFlow id="f-start-scenario" sourceRef="start" targetRef="scenario" />
    <bpmn:sequenceFlow id="f-scenario-send_metering" sourceRef="scenario" targetRef="send_metering" />
    <bpmn:sequenceFlow id="f-scenario-send_measurement" sourceRef="scenario" targetRef="send_measurement" />
    <bpmn:sequenceFlow id="f-scenario-send_readings" sourceRef="scenario" targetRef="send_readings" />
    <bpmn:sequenceFlow id="f-scenario-send_equipment" sourceRef="scenario" targetRef="send_equipment" />
    <bpmn:sequenceFlow id="f-send_metering-examine_go" sourceRef="send_metering" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_measurement-examine_go" sourceRef="send_measurement" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_readings-examine_go" sourceRef="send_readings" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_equipment-recipient" sourceRef="send_equipment" targetRef="recipient" />
    <bpmn:sequenceFlow id="f-recipient-examine_mpon" sourceRef="recipient" targetRef="examine_mpon" />
    <bpmn:sequenceFlow id="f-recipient-examine_go" sourceRef="recipient" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-examine_go-outcome" sourceRef="examine_go" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-examine_mpon-outcome" sourceRef="examine_mpon" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-confirm_go" sourceRef="outcome" targetRef="confirm_go" />
    <bpmn:sequenceFlow id="f-outcome-confirm_mpon" sourceRef="outcome" targetRef="confirm_mpon" />
    <bpmn:sequenceFlow id="f-outcome-reject_go" sourceRef="outcome" targetRef="reject_go" />
    <bpmn:sequenceFlow id="f-outcome-reject_mpon" sourceRef="outcome" targetRef="reject_mpon" />
    <bpmn:sequenceFlow id="f-confirm_go-completed" sourceRef="confirm_go" targetRef="completed" />
    <bpmn:sequenceFlow id="f-confirm_mpon-completed" sourceRef="confirm_mpon" targetRef="completed" />
    <bpmn:sequenceFlow id="f-reject_go-completed" sourceRef="reject_go" targetRef="completed" />
    <bpmn:sequenceFlow id="f-reject_mpon-completed" sourceRef="reject_mpon" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
