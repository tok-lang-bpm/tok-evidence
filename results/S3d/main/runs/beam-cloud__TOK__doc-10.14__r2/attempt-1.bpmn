<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Bill handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_temp_ops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recipient</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>which</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_go_ops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_go_meas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_go_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam_go_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ms" name="MSPO">
        <bpmn:flowNodeRef>send_temp_meas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_add</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>exam_mp_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej_mp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Bill sent" />
    <bpmn:task id="send_temp_ops" name="Send the bill for the temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="send_equip" name="Send the bill for the equipment acquisition to the MPON or the GO" />
    <bpmn:exclusiveGateway id="recipient" name="MPON or GO?" />
    <bpmn:exclusiveGateway id="which" name="Which bill?" />
    <bpmn:task id="exam_go_ops" name="Examine the bill" />
    <bpmn:task id="exam_go_meas" name="Examine the bill" />
    <bpmn:task id="exam_go_read" name="Examine the bill" />
    <bpmn:task id="exam_go_equip" name="Examine the bill" />
    <bpmn:exclusiveGateway id="decide_go" name="Confirm or reject?" default="f-decide_go-reject_go" />
    <bpmn:task id="confirm_go" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject_go" name="Reject the invoice" />
    <bpmn:endEvent id="conf_go" name="Invoice confirmed" />
    <bpmn:endEvent id="rej_go" name="Invoice rejected" />
    <bpmn:task id="send_temp_meas" name="Send the bill for the temporary continuation of the measurement to the GO" />
    <bpmn:task id="send_add" name="Send the bill for additional readings to the GO" />
    <bpmn:task id="exam_mp_equip" name="Examine the bill" />
    <bpmn:exclusiveGateway id="decide_mp" name="Confirm or reject?" default="f-decide_mp-reject_mp" />
    <bpmn:task id="confirm_mp" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject_mp" name="Reject the invoice" />
    <bpmn:endEvent id="conf_mp" name="Invoice confirmed" />
    <bpmn:endEvent id="rej_mp" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f-s-which" sourceRef="s" targetRef="which" />
    <bpmn:sequenceFlow id="f-which-send_temp_ops" sourceRef="which" targetRef="send_temp_ops" />
    <bpmn:sequenceFlow id="f-which-send_temp_meas" sourceRef="which" targetRef="send_temp_meas" />
    <bpmn:sequenceFlow id="f-which-send_add" sourceRef="which" targetRef="send_add" />
    <bpmn:sequenceFlow id="f-which-send_equip" sourceRef="which" targetRef="send_equip" />
    <bpmn:sequenceFlow id="f-send_temp_ops-exam_go_ops" sourceRef="send_temp_ops" targetRef="exam_go_ops" />
    <bpmn:sequenceFlow id="f-send_temp_meas-exam_go_meas" sourceRef="send_temp_meas" targetRef="exam_go_meas" />
    <bpmn:sequenceFlow id="f-send_add-exam_go_read" sourceRef="send_add" targetRef="exam_go_read" />
    <bpmn:sequenceFlow id="f-send_equip-recipient" sourceRef="send_equip" targetRef="recipient" />
    <bpmn:sequenceFlow id="f-recipient-exam_mp_equip" name="MPON" sourceRef="recipient" targetRef="exam_mp_equip" />
    <bpmn:sequenceFlow id="f-recipient-exam_go_equip" name="GO" sourceRef="recipient" targetRef="exam_go_equip" />
    <bpmn:sequenceFlow id="f-exam_go_ops-decide_go" sourceRef="exam_go_ops" targetRef="decide_go" />
    <bpmn:sequenceFlow id="f-exam_go_meas-decide_go" sourceRef="exam_go_meas" targetRef="decide_go" />
    <bpmn:sequenceFlow id="f-exam_go_read-decide_go" sourceRef="exam_go_read" targetRef="decide_go" />
    <bpmn:sequenceFlow id="f-exam_go_equip-decide_go" sourceRef="exam_go_equip" targetRef="decide_go" />
    <bpmn:sequenceFlow id="f-exam_mp_equip-decide_mp" sourceRef="exam_mp_equip" targetRef="decide_mp" />
    <bpmn:sequenceFlow id="f-decide_go-confirm_go" name="Confirm" sourceRef="decide_go" targetRef="confirm_go" />
    <bpmn:sequenceFlow id="f-decide_go-reject_go" name="Reject" sourceRef="decide_go" targetRef="reject_go" />
    <bpmn:sequenceFlow id="f-confirm_go-conf_go" sourceRef="confirm_go" targetRef="conf_go" />
    <bpmn:sequenceFlow id="f-reject_go-rej_go" sourceRef="reject_go" targetRef="rej_go" />
    <bpmn:sequenceFlow id="f-decide_mp-confirm_mp" name="Confirm" sourceRef="decide_mp" targetRef="confirm_mp" />
    <bpmn:sequenceFlow id="f-decide_mp-reject_mp" name="Reject" sourceRef="decide_mp" targetRef="reject_mp" />
    <bpmn:sequenceFlow id="f-confirm_mp-conf_mp" sourceRef="confirm_mp" targetRef="conf_mp" />
    <bpmn:sequenceFlow id="f-reject_mp-rej_mp" sourceRef="reject_mp" targetRef="rej_mp" />
  </bpmn:process>
</bpmn:definitions>
