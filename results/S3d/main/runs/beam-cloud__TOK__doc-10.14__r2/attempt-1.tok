tok 1.0 "Bill handling"

pool org "Organisation"
  lane mpoo "MPOO"
    start s "Bill sent"
    task send_temp_ops "Send the bill for the temporary continuation of the metering point operations to the GO"
    task send_equip "Send the bill for the equipment acquisition to the MPON or the GO"
    xor recipient "MPON or GO?"
  lane go "GO"
    xor which "Which bill?"
    task exam_go_ops "Examine the bill"
    task exam_go_meas "Examine the bill"
    task exam_go_read "Examine the bill"
    task exam_go_equip "Examine the bill"
    xor decide_go "Confirm or reject?"
    task confirm_go "Confirm the invoice with payment advice"
    task reject_go "Reject the invoice"
    end conf_go "Invoice confirmed"
    end rej_go "Invoice rejected"
  lane ms "MSPO"
    task send_temp_meas "Send the bill for the temporary continuation of the measurement to the GO"
    task send_add "Send the bill for additional readings to the GO"
  lane mpon "MPON"
    task exam_mp_equip "Examine the bill"
    xor decide_mp "Confirm or reject?"
    task confirm_mp "Confirm the invoice with payment advice"
    task reject_mp "Reject the invoice"
    end conf_mp "Invoice confirmed"
    end rej_mp "Invoice rejected"

flow s -> which
flow which -> send_temp_ops
flow which -> send_temp_meas
flow which -> send_add
flow which -> send_equip

flow send_temp_ops -> exam_go_ops
flow send_temp_meas -> exam_go_meas
flow send_add -> exam_go_read
flow send_equip -> recipient
flow recipient -> exam_mp_equip "MPON"
flow recipient -> exam_go_equip "GO"

flow exam_go_ops -> decide_go
flow exam_go_meas -> decide_go
flow exam_go_read -> decide_go
flow exam_go_equip -> decide_go
flow exam_mp_equip -> decide_mp

flow decide_go -> confirm_go "Confirm"
flow decide_go -> reject_go "Reject" default
flow confirm_go -> conf_go
flow reject_go -> rej_go

flow decide_mp -> confirm_mp "Confirm"
flow decide_mp -> reject_mp "Reject" default
flow confirm_mp -> conf_mp
flow reject_mp -> rej_mp
