<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPON dismissal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPON dismissal" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpnon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send" name="Send the dismissal" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="choice" name="Oppose or confirm?" />
    <bpmn:task id="oppose" name="Oppose the dismissal of MPON" />
    <bpmn:task id="confirm" name="Confirm the dismissal of the MPON" />
    <bpmn:endEvent id="opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-start-send" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-choice" sourceRef="review" targetRef="choice" />
    <bpmn:sequenceFlow id="f-choice-oppose" name="oppose" sourceRef="choice" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-choice-confirm" name="confirm" sourceRef="choice" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-oppose-opposed" sourceRef="oppose" targetRef="opposed" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
