<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPON dismissal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPON dismissal" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Dismissal needed" />
    <bpmn:task id="send" name="Send the dismissal" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Oppose or confirm the dismissal?" />
    <bpmn:task id="oppose" name="Oppose the dismissal of MPON" />
    <bpmn:task id="confirm" name="Confirm the dismissal of MPON" />
    <bpmn:exclusiveGateway id="decided" name="Dismissal decided" />
    <bpmn:endEvent id="done" name="Dismissal process completed" />
    <bpmn:sequenceFlow id="f-needed-send" sourceRef="needed" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-oppose" name="opposes" sourceRef="decision" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="confirms" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-oppose-decided" sourceRef="oppose" targetRef="decided" />
    <bpmn:sequenceFlow id="f-confirm-decided" sourceRef="confirm" targetRef="decided" />
    <bpmn:sequenceFlow id="f-decided-done" sourceRef="decided" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
