<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Meter operation registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meter operation registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infSuccess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infMPOOreg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infMSPOreg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infMPOOfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infMPOOassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infMSPOfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infMSPOassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infSPassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO" name="MPOO" />
      <bpmn:lane id="MSPO" name="MSPO" />
      <bpmn:lane id="SP" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="rep" name="Report the meter operation" />
    <bpmn:task id="equip" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="infFail" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="infSuccess" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="exam" name="Examine the application" />
    <bpmn:exclusiveGateway id="app" name="Application confirmed?" />
    <bpmn:task id="rej" name="Reject the application" />
    <bpmn:task id="conf" name="Confirm the application" />
    <bpmn:task id="infMPOOreg" name="Inform the MPOO about the registration confirmation" />
    <bpmn:task id="infMSPOreg" name="Inform the MSPO about the registration confirmation" />
    <bpmn:exclusiveGateway id="result" name="Entire process completed?" default="f-result-infDeadline" />
    <bpmn:task id="infDeadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:task id="confFail" name="Confirm the failure of the assignment" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confAssign" name="Confirm the assignment to the MPON" />
    <bpmn:task id="infMPOOfail" name="Inform the MPOO about the failure of the assignment" />
    <bpmn:task id="infMPOOassign" name="Inform the MPOO about the assignment" />
    <bpmn:task id="infMSPOfail" name="Inform the MSPO about the failure of the assignment" />
    <bpmn:task id="infMSPOassign" name="Inform the MSPO about the assignment" />
    <bpmn:task id="infSPassign" name="Inform the SP about the assignment" />
    <bpmn:endEvent id="eRejected" name="Application rejected" />
    <bpmn:endEvent id="eFail" name="Process failed" />
    <bpmn:endEvent id="eSuccess" name="Process completed" />
    <bpmn:endEvent id="eTimeout" name="Process failed by deadline" />
    <bpmn:sequenceFlow id="f-s-rep" sourceRef="s" targetRef="rep" />
    <bpmn:sequenceFlow id="f-rep-exam" sourceRef="rep" targetRef="exam" />
    <bpmn:sequenceFlow id="f-exam-app" sourceRef="exam" targetRef="app" />
    <bpmn:sequenceFlow id="f-app-rej" name="no" sourceRef="app" targetRef="rej">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-app-conf" name="yes" sourceRef="app" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rej-eRejected" sourceRef="rej" targetRef="eRejected" />
    <bpmn:sequenceFlow id="f-conf-infMPOOreg" sourceRef="conf" targetRef="infMPOOreg" />
    <bpmn:sequenceFlow id="f-infMPOOreg-infMSPOreg" sourceRef="infMPOOreg" targetRef="infMSPOreg" />
    <bpmn:sequenceFlow id="f-infMSPOreg-equip" sourceRef="infMSPOreg" targetRef="equip" />
    <bpmn:sequenceFlow id="f-equip-result" sourceRef="equip" targetRef="result" />
    <bpmn:sequenceFlow id="f-result-infFail" name="failure" sourceRef="result" targetRef="infFail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">failed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-result-infSuccess" name="success" sourceRef="result" targetRef="infSuccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">successful</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-result-infDeadline" name="no message" sourceRef="result" targetRef="infDeadline" />
    <bpmn:sequenceFlow id="f-infFail-confFail" sourceRef="infFail" targetRef="confFail" />
    <bpmn:sequenceFlow id="f-confFail-infMPOOfail" sourceRef="confFail" targetRef="infMPOOfail" />
    <bpmn:sequenceFlow id="f-infMPOOfail-infMSPOfail" sourceRef="infMPOOfail" targetRef="infMSPOfail" />
    <bpmn:sequenceFlow id="f-infMSPOfail-eFail" sourceRef="infMSPOfail" targetRef="eFail" />
    <bpmn:sequenceFlow id="f-infSuccess-assign" sourceRef="infSuccess" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-confAssign" sourceRef="assign" targetRef="confAssign" />
    <bpmn:sequenceFlow id="f-confAssign-infMPOOassign" sourceRef="confAssign" targetRef="infMPOOassign" />
    <bpmn:sequenceFlow id="f-infMPOOassign-infMSPOassign" sourceRef="infMPOOassign" targetRef="infMSPOassign" />
    <bpmn:sequenceFlow id="f-infMSPOassign-infSPassign" sourceRef="infMSPOassign" targetRef="infSPassign" />
    <bpmn:sequenceFlow id="f-infSPassign-eSuccess" sourceRef="infSPassign" targetRef="eSuccess" />
    <bpmn:sequenceFlow id="f-infDeadline-eTimeout" sourceRef="infDeadline" targetRef="eTimeout" />
  </bpmn:process>
</bpmn:definitions>
