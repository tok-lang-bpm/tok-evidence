<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="MPON registration process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_failure" name="failure" />
  <bpmn:message id="Message_success" name="success" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPON registration process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpn" name="MPON">
        <bpmn:flowNodeRef>start_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire_equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpn_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpn_finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>application_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failure_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mp_failure_deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failure_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>change_equipment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_process" name="Start" />
    <bpmn:task id="report_meter" name="Report the meter operation" />
    <bpmn:task id="acquire_equipment" name="Perform equipment acquisition" />
    <bpmn:exclusiveGateway id="mpn_outcome" name="MPON outcome" />
    <bpmn:task id="inform_failure" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="inform_success" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:endEvent id="mpn_finished" name="MPON finished" />
    <bpmn:task id="examine_application" name="Examine the application" />
    <bpmn:exclusiveGateway id="application_decision" name="Application complete?" />
    <bpmn:task id="reject_application" name="Reject the application" />
    <bpmn:task id="confirm_application" name="Confirm the application" />
    <bpmn:task id="inform_mpoo_registration" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="inform_mspo_registration" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:inclusiveGateway id="equipment_gw" name="Equipment?" default="f-equipment_gw-change_equipment" />
    <bpmn:inclusiveGateway id="equipment_join" name="Equipment completed" />
    <bpmn:parallelGateway id="parallel_split" name="Parallel completion" />
    <bpmn:eventBasedGateway id="wait_mp" name="Wait for MPON message" />
    <bpmn:intermediateCatchEvent id="failure_message" name="Failure message">
      <bpmn:messageEventDefinition id="failure_message-def" messageRef="Message_failure" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="success_message" name="Success message">
      <bpmn:messageEventDefinition id="success_message-def" messageRef="Message_success" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="deadline_timer" name="Deadline expired">
      <bpmn:timerEventDefinition id="deadline_timer-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="confirm_failure" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="assign_mp" name="Assign the MPON" />
    <bpmn:task id="confirm_assignment" name="Confirm the assignment to the MPON" />
    <bpmn:task id="inform_mp_failure_deadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:task id="inform_mpoo_failure" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="inform_mpoo_assignment" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="inform_mspo_failure" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:task id="inform_mspo_assignment" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="inform_sp_assignment" name="Inform the SP about the assignment of the MPON" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="failure_end" name="Process failed" />
    <bpmn:endEvent id="success_end" name="Process completed" />
    <bpmn:task id="change_equipment" name="Perform equipment changes" />
    <bpmn:sequenceFlow id="f-start_process-report_meter" sourceRef="start_process" targetRef="report_meter" />
    <bpmn:sequenceFlow id="f-report_meter-examine_application" sourceRef="report_meter" targetRef="examine_application" />
    <bpmn:sequenceFlow id="f-examine_application-application_decision" sourceRef="examine_application" targetRef="application_decision" />
    <bpmn:sequenceFlow id="f-application_decision-reject_application" name="reject" sourceRef="application_decision" targetRef="reject_application" />
    <bpmn:sequenceFlow id="f-application_decision-confirm_application" name="confirm" sourceRef="application_decision" targetRef="confirm_application" />
    <bpmn:sequenceFlow id="f-reject_application-rejected" sourceRef="reject_application" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm_application-inform_mpoo_registration" sourceRef="confirm_application" targetRef="inform_mpoo_registration" />
    <bpmn:sequenceFlow id="f-inform_mpoo_registration-inform_mspo_registration" sourceRef="inform_mpoo_registration" targetRef="inform_mspo_registration" />
    <bpmn:sequenceFlow id="f-inform_mspo_registration-equipment_gw" sourceRef="inform_mspo_registration" targetRef="equipment_gw" />
    <bpmn:sequenceFlow id="f-equipment_gw-acquire_equipment" name="acquisition" sourceRef="equipment_gw" targetRef="acquire_equipment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">acquisitionRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equipment_gw-change_equipment" name="changes" sourceRef="equipment_gw" targetRef="change_equipment" />
    <bpmn:sequenceFlow id="f-acquire_equipment-equipment_join" sourceRef="acquire_equipment" targetRef="equipment_join" />
    <bpmn:sequenceFlow id="f-change_equipment-equipment_join" sourceRef="change_equipment" targetRef="equipment_join" />
    <bpmn:sequenceFlow id="f-equipment_join-parallel_split" sourceRef="equipment_join" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f-parallel_split-mpn_outcome" sourceRef="parallel_split" targetRef="mpn_outcome" />
    <bpmn:sequenceFlow id="f-parallel_split-wait_mp" sourceRef="parallel_split" targetRef="wait_mp" />
    <bpmn:sequenceFlow id="f-mpn_outcome-inform_failure" name="failure" sourceRef="mpn_outcome" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="f-mpn_outcome-inform_success" name="success" sourceRef="mpn_outcome" targetRef="inform_success" />
    <bpmn:sequenceFlow id="f-inform_failure-mpn_finished" sourceRef="inform_failure" targetRef="mpn_finished" />
    <bpmn:sequenceFlow id="f-inform_success-mpn_finished" sourceRef="inform_success" targetRef="mpn_finished" />
    <bpmn:sequenceFlow id="f-wait_mp-failure_message" sourceRef="wait_mp" targetRef="failure_message" />
    <bpmn:sequenceFlow id="f-wait_mp-success_message" sourceRef="wait_mp" targetRef="success_message" />
    <bpmn:sequenceFlow id="f-wait_mp-deadline_timer" sourceRef="wait_mp" targetRef="deadline_timer" />
    <bpmn:sequenceFlow id="f-failure_message-confirm_failure" sourceRef="failure_message" targetRef="confirm_failure" />
    <bpmn:sequenceFlow id="f-success_message-assign_mp" sourceRef="success_message" targetRef="assign_mp" />
    <bpmn:sequenceFlow id="f-assign_mp-confirm_assignment" sourceRef="assign_mp" targetRef="confirm_assignment" />
    <bpmn:sequenceFlow id="f-deadline_timer-inform_mp_failure_deadline" sourceRef="deadline_timer" targetRef="inform_mp_failure_deadline" />
    <bpmn:sequenceFlow id="f-inform_mp_failure_deadline-confirm_failure" sourceRef="inform_mp_failure_deadline" targetRef="confirm_failure" />
    <bpmn:sequenceFlow id="f-confirm_failure-inform_mpoo_failure" sourceRef="confirm_failure" targetRef="inform_mpoo_failure" />
    <bpmn:sequenceFlow id="f-inform_mpoo_failure-inform_mspo_failure" sourceRef="inform_mpoo_failure" targetRef="inform_mspo_failure" />
    <bpmn:sequenceFlow id="f-inform_mspo_failure-failure_end" sourceRef="inform_mspo_failure" targetRef="failure_end" />
    <bpmn:sequenceFlow id="f-confirm_assignment-inform_mpoo_assignment" sourceRef="confirm_assignment" targetRef="inform_mpoo_assignment" />
    <bpmn:sequenceFlow id="f-inform_mpoo_assignment-inform_mspo_assignment" sourceRef="inform_mpoo_assignment" targetRef="inform_mspo_assignment" />
    <bpmn:sequenceFlow id="f-inform_mspo_assignment-inform_sp_assignment" sourceRef="inform_mspo_assignment" targetRef="inform_sp_assignment" />
    <bpmn:sequenceFlow id="f-inform_sp_assignment-success_end" sourceRef="inform_sp_assignment" targetRef="success_end" />
  </bpmn:process>
</bpmn:definitions>
