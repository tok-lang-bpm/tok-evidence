<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="MPOO deregistration process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPOO deregistration process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_cont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>optional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_optional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="confirm_cont" name="Confirm the continuation to the MPOO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="decision" name="Deregistration rejected or preliminarily confirmed?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="end_rejected" name="Deregistration rejected" />
    <bpmn:task id="confirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="optional" name="Oblige the MPOO to continue the operations?" default="f-optional-merge_optional" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="merge_optional" name="Continuation handled" />
    <bpmn:task id="equip" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="end_completed" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-deregister" sourceRef="s" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-decision" sourceRef="verify" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="Rejected" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="Preliminarily confirmed" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-end_rejected" sourceRef="reject" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f-confirm-prepare" sourceRef="confirm" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-optional" sourceRef="prepare" targetRef="optional" />
    <bpmn:sequenceFlow id="f-optional-oblige" name="Yes" sourceRef="optional" targetRef="oblige">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">obligate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-optional-merge_optional" name="No" sourceRef="optional" targetRef="merge_optional" />
    <bpmn:sequenceFlow id="f-oblige-confirm_cont" sourceRef="oblige" targetRef="confirm_cont" />
    <bpmn:sequenceFlow id="f-confirm_cont-merge_optional" sourceRef="confirm_cont" targetRef="merge_optional" />
    <bpmn:sequenceFlow id="f-merge_optional-equip" sourceRef="merge_optional" targetRef="equip" />
    <bpmn:sequenceFlow id="f-equip-assign" sourceRef="equip" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mpoo" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f-inform_mpoo-inform_mspo" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-inform_mspo-inform_sp" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-end_completed" sourceRef="inform_sp" targetRef="end_completed" />
  </bpmn:process>
</bpmn:definitions>
