tok 1.0 "MPOO deregistration process"

pool organisation "Organisation"
  lane mpoo "MPOO"
    start s "Start"
    task deregister "Deregister at the GO"
    task confirm_cont "Confirm the continuation to the MPOO"
  lane go "GO"
    task verify "Verify the deregistration"
    xor decision "Deregistration rejected or preliminarily confirmed?"
    task reject "Reject the deregistration of the MPOO"
    end end_rejected "Deregistration rejected"
    task confirm "Preliminarily confirm the deregistration of the MPOO"
    task prepare "Prepare the readmission of the measuring point"
    xor optional "Oblige the MPOO to continue the operations?"
    task oblige "Oblige the MPOO to continue the operations"
    xor merge_optional "Continuation handled"
    task equip "Perform the equipment acquisition and / or equipment changes"
    task assign "Assign the GO as MPO"
    task inform_mpoo "Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO"
    task inform_mspo "Inform the MSPO about the assignment of the GO"
    task inform_sp "Inform the SP about the assignment of the GO"
    end end_completed "Process completed"

flow s -> deregister -> verify -> decision
flow decision -> reject "Rejected"
flow decision -> confirm "Preliminarily confirmed"
flow reject -> end_rejected
flow confirm -> prepare -> optional
flow optional -> oblige "Yes" when="obligate"
flow optional -> merge_optional "No" default
flow oblige -> confirm_cont -> merge_optional
flow merge_optional -> equip -> assign -> inform_mpoo -> inform_mspo -> inform_sp -> end_completed
