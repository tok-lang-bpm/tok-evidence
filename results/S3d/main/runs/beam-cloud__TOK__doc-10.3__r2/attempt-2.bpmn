<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="MPOO deregistration at the GO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPOO deregistration at the GO" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_cont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="confirm_cont" name="Confirm the continuation to the MPOO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="decide" name="Reject or preliminarily confirm?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:task id="confirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige_split" name="Oblige the MPOO to continue the operations?" default="f-oblige_split-oblige_join" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="oblige_join" />
    <bpmn:inclusiveGateway id="equip_split" name="Perform equipment acquisition and/or equipment changes?" default="f-equip_split-equip_join" />
    <bpmn:task id="acquire" name="Perform equipment acquisition" />
    <bpmn:task id="changes" name="Perform equipment changes" />
    <bpmn:inclusiveGateway id="equip_join" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-deregister" sourceRef="s" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-decide" sourceRef="verify" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="reject" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="preliminarily confirm" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-prepare" sourceRef="confirm" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige_split" sourceRef="prepare" targetRef="oblige_split" />
    <bpmn:sequenceFlow id="f-oblige_split-oblige" name="yes" sourceRef="oblige_split" targetRef="oblige">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">obligation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-oblige-confirm_cont" sourceRef="oblige" targetRef="confirm_cont" />
    <bpmn:sequenceFlow id="f-confirm_cont-oblige_join" sourceRef="confirm_cont" targetRef="oblige_join" />
    <bpmn:sequenceFlow id="f-oblige_split-oblige_join" name="no" sourceRef="oblige_split" targetRef="oblige_join" />
    <bpmn:sequenceFlow id="f-oblige_join-equip_split" sourceRef="oblige_join" targetRef="equip_split" />
    <bpmn:sequenceFlow id="f-equip_split-acquire" name="acquisition" sourceRef="equip_split" targetRef="acquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">acquisition = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equip_split-changes" name="changes" sourceRef="equip_split" targetRef="changes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">changes = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equip_split-equip_join" sourceRef="equip_split" targetRef="equip_join" />
    <bpmn:sequenceFlow id="f-acquire-equip_join" sourceRef="acquire" targetRef="equip_join" />
    <bpmn:sequenceFlow id="f-changes-equip_join" sourceRef="changes" targetRef="equip_join" />
    <bpmn:sequenceFlow id="f-equip_join-assign" sourceRef="equip_join" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mpoo" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f-inform_mpoo-inform_mspo" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-inform_mspo-inform_sp" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-done" sourceRef="inform_sp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
