tok 1.0 "MPOO deregistration at the GO"

pool organisation "Organisation"
  lane mpoo "MPOO"
    start s "Start"
    task deregister "Deregister at the GO"
    task confirm_cont "Confirm the continuation to the MPOO"
  lane go "GO"
    task verify "Verify the deregistration"
    xor decide "Reject or preliminarily confirm?"
    task reject "Reject the deregistration of the MPOO"
    task confirm "Preliminarily confirm the deregistration of the MPOO"
    task prepare "Prepare the readmission of the measuring point"
    xor oblige_split "Oblige the MPOO to continue the operations?"
    task oblige "Oblige the MPOO to continue the operations"
    xor oblige_join
    or equip_split "Perform equipment acquisition and/or equipment changes?"
    task acquire "Perform equipment acquisition"
    task changes "Perform equipment changes"
    or equip_join
    task assign "Assign the GO as MPO"
    task inform_mpoo "Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO"
    task inform_mspo "Inform the MSPO about the assignment of the GO"
    task inform_sp "Inform the SP about the assignment of the GO"
    end rejected "Deregistration rejected"
    end done "Process completed"

flow s -> deregister -> verify -> decide
flow decide -> reject "reject"
flow decide -> confirm "preliminarily confirm"
flow reject -> rejected
flow confirm -> prepare -> oblige_split
flow oblige_split -> oblige "yes" when="obligation = true"
flow oblige -> confirm_cont -> oblige_join
flow oblige_split -> oblige_join "no" default
flow oblige_join -> equip_split
flow equip_split -> acquire "acquisition" when="acquisition = true"
flow equip_split -> changes "changes" when="changes = true"
flow equip_split -> equip_join default
flow acquire -> equip_join
flow changes -> equip_join
flow equip_join -> assign -> inform_mpoo -> inform_mspo -> inform_sp -> done
