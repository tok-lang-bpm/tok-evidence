<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_old_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>choose_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_reading_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount_old_mpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>notify_msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Equipment change intended" />
    <bpmn:task id="notify_intent" name="Notify the MPOO about equipment change intentions" />
    <bpmn:task id="final_reading_mpon" name="Perform the final reading" />
    <bpmn:task id="dismount_old_mpon" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="joined" />
    <bpmn:task id="mount_new" name="Mount the new device" />
    <bpmn:task id="read_meter" name="Read the meter count from the installed meter" />
    <bpmn:task id="send_final" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tell_go" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="choose_self" name="Self dismounting?" />
    <bpmn:task id="announce_self" name="Announce self dismounting to the MPON" />
    <bpmn:task id="notify_no" name="Notify the MPON about no self-dismounting of the MPOO" />
    <bpmn:task id="final_reading_mpoo" name="Perform the final reading" />
    <bpmn:task id="dismount_old_mpoo" name="Dismount the old equipment" />
    <bpmn:task id="notify_msp" name="Notify the MSP about the device changes, the master data, the meter count at dismounting, and the meter count at installation" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-notify_intent" sourceRef="s" targetRef="notify_intent" />
    <bpmn:sequenceFlow id="f-notify_intent-choose_self" sourceRef="notify_intent" targetRef="choose_self" />
    <bpmn:sequenceFlow id="f-choose_self-announce_self" name="self dismounting" sourceRef="choose_self" targetRef="announce_self" />
    <bpmn:sequenceFlow id="f-choose_self-notify_no" name="no self-dismounting" sourceRef="choose_self" targetRef="notify_no" />
    <bpmn:sequenceFlow id="f-announce_self-final_reading_mpoo" sourceRef="announce_self" targetRef="final_reading_mpoo" />
    <bpmn:sequenceFlow id="f-final_reading_mpoo-dismount_old_mpoo" sourceRef="final_reading_mpoo" targetRef="dismount_old_mpoo" />
    <bpmn:sequenceFlow id="f-dismount_old_mpoo-joined" sourceRef="dismount_old_mpoo" targetRef="joined" />
    <bpmn:sequenceFlow id="f-notify_no-final_reading_mpon" sourceRef="notify_no" targetRef="final_reading_mpon" />
    <bpmn:sequenceFlow id="f-final_reading_mpon-dismount_old_mpon" sourceRef="final_reading_mpon" targetRef="dismount_old_mpon" />
    <bpmn:sequenceFlow id="f-dismount_old_mpon-joined" sourceRef="dismount_old_mpon" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-mount_new" sourceRef="joined" targetRef="mount_new" />
    <bpmn:sequenceFlow id="f-mount_new-read_meter" sourceRef="mount_new" targetRef="read_meter" />
    <bpmn:sequenceFlow id="f-read_meter-send_final" sourceRef="read_meter" targetRef="send_final" />
    <bpmn:sequenceFlow id="f-send_final-tell_go" sourceRef="send_final" targetRef="tell_go" />
    <bpmn:sequenceFlow id="f-tell_go-notify_msp" sourceRef="tell_go" targetRef="notify_msp" />
    <bpmn:sequenceFlow id="f-notify_msp-done" sourceRef="notify_msp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
