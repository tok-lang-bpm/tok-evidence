tok 1.0 "Device takeover"

pool org "Organisation"
  lane mpon "MPON"
    start s "Start"
    task req "Request a device takeover bid"
    task order "Place an order"
  lane m poo "MPOO"
    task tender "Send a tender for the equipment takeover"
    and fork
    task confirm "Confirm the order"
    task master "Send the master data"
    and join
    end e "End"

flow s -> req -> tender -> order -> fork
flow fork -> confirm -> join
flow fork -> master -> join
flow join -> e
