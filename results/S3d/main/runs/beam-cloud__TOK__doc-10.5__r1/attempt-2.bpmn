<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Device takeover" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Device takeover" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="req" name="Request a device takeover bid" />
    <bpmn:task id="order" name="Place an order" />
    <bpmn:task id="tender" name="Send a tender for the equipment takeover" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="confirm" name="Confirm the order" />
    <bpmn:task id="master" name="Send the master data" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-req" sourceRef="s" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-tender" sourceRef="req" targetRef="tender" />
    <bpmn:sequenceFlow id="f-tender-order" sourceRef="tender" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-fork" sourceRef="order" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-confirm" sourceRef="fork" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-join" sourceRef="confirm" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-master" sourceRef="fork" targetRef="master" />
    <bpmn:sequenceFlow id="f-master-join" sourceRef="master" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-e" sourceRef="join" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
