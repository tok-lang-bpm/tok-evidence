<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Device takeover process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Device takeover process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_bid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>send_tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_master_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Start" />
    <bpmn:task id="request_bid" name="Request a device takeover bid" />
    <bpmn:task id="place_order" name="Place an order" />
    <bpmn:task id="send_tender" name="Send a tender for the equipment takeover" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="confirm_order" name="Confirm the order" />
    <bpmn:task id="send_master_data" name="Send the master data" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="end_event" name="Device takeover completed" />
    <bpmn:sequenceFlow id="f-start_event-request_bid" sourceRef="start_event" targetRef="request_bid" />
    <bpmn:sequenceFlow id="f-request_bid-send_tender" sourceRef="request_bid" targetRef="send_tender" />
    <bpmn:sequenceFlow id="f-send_tender-place_order" sourceRef="send_tender" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-split" sourceRef="place_order" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-confirm_order" sourceRef="split" targetRef="confirm_order" />
    <bpmn:sequenceFlow id="f-split-send_master_data" sourceRef="split" targetRef="send_master_data" />
    <bpmn:sequenceFlow id="f-confirm_order-join" sourceRef="confirm_order" targetRef="join" />
    <bpmn:sequenceFlow id="f-send_master_data-join" sourceRef="send_master_data" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-end_event" sourceRef="join" targetRef="end_event" />
  </bpmn:process>
</bpmn:definitions>
