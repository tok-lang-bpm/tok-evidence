<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN dismissal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MSPN dismissal" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>review_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send_dismissal" name="Send a dismissal" />
    <bpmn:task id="review_dismissal" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Reject or confirm?" default="f-decision-confirm_dismissal" />
    <bpmn:task id="reject_dismissal" name="Reject the dismissal" />
    <bpmn:task id="confirm_dismissal" name="Confirm the dismissal" />
    <bpmn:endEvent id="rejected" name="Dismissal rejected" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-start-send_dismissal" sourceRef="start" targetRef="send_dismissal" />
    <bpmn:sequenceFlow id="f-send_dismissal-review_dismissal" sourceRef="send_dismissal" targetRef="review_dismissal" />
    <bpmn:sequenceFlow id="f-review_dismissal-decision" sourceRef="review_dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject_dismissal" name="Rejects" sourceRef="decision" targetRef="reject_dismissal" />
    <bpmn:sequenceFlow id="f-decision-confirm_dismissal" name="Confirms" sourceRef="decision" targetRef="confirm_dismissal" />
    <bpmn:sequenceFlow id="f-reject_dismissal-rejected" sourceRef="reject_dismissal" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm_dismissal-confirmed" sourceRef="confirm_dismissal" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
