<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Dismissal handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="MSPN" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>reviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="sendDismissal" name="Send dismissal" />
    <bpmn:task id="reviewDismissal" name="Review dismissal" />
    <bpmn:exclusiveGateway id="outcome" name="Dismissal outcome?" />
    <bpmn:task id="rejectDismissal" name="Reject dismissal" />
    <bpmn:task id="confirmDismissal" name="Confirm dismissal" />
    <bpmn:endEvent id="done" name="Dismissal handled" />
    <bpmn:sequenceFlow id="f-start-sendDismissal" sourceRef="start" targetRef="sendDismissal" />
    <bpmn:sequenceFlow id="f-sendDismissal-reviewDismissal" sourceRef="sendDismissal" targetRef="reviewDismissal" />
    <bpmn:sequenceFlow id="f-reviewDismissal-outcome" sourceRef="reviewDismissal" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-rejectDismissal" name="rejected" sourceRef="outcome" targetRef="rejectDismissal" />
    <bpmn:sequenceFlow id="f-outcome-confirmDismissal" name="confirmed" sourceRef="outcome" targetRef="confirmDismissal" />
    <bpmn:sequenceFlow id="f-rejectDismissal-done" sourceRef="rejectDismissal" targetRef="done" />
    <bpmn:sequenceFlow id="f-confirmDismissal-done" sourceRef="confirmDismissal" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
