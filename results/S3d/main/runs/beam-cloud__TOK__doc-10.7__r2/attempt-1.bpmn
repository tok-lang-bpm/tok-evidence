<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MSPN process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="register" name="Register the measurement" />
    <bpmn:task id="examine" name="Examine the application" />
    <bpmn:exclusiveGateway id="result" name="Reject or confirm?" />
    <bpmn:task id="reject" name="Reject the application" />
    <bpmn:task id="confirm" name="Confirm the application" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:task id="inform_mspos" name="Inform the MSPO about the assignment of MSPN" />
    <bpmn:task id="inform_mpo" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of MSPN" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-register" sourceRef="start" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-examine" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-result" sourceRef="examine" targetRef="result" />
    <bpmn:sequenceFlow id="f-result-reject" name="Reject" sourceRef="result" targetRef="reject" />
    <bpmn:sequenceFlow id="f-result-confirm" name="Confirm" sourceRef="result" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-assign" sourceRef="confirm" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mspos" sourceRef="assign" targetRef="inform_mspos" />
    <bpmn:sequenceFlow id="f-inform_mspos-inform_mpo" sourceRef="inform_mspos" targetRef="inform_mpo" />
    <bpmn:sequenceFlow id="f-inform_mpo-inform_sp" sourceRef="inform_mpo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-completed" sourceRef="inform_sp" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
