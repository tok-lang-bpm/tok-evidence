<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="merge">
        <bpmn:flowNodeRef>mergeSource</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Change arises" />
    <bpmn:task id="request" name="Request changes" />
    <bpmn:task id="cause" name="Cause a change" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="source" name="Change source?" />
    <bpmn:exclusiveGateway id="decision" name="Reject or confirm?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:task id="confirm" name="Confirm the request of the SP / PU / GO" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="outcome" name="Implementation or failure?" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notify" name="Notify the SP / PU / GO about the failure" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:endEvent id="reported" name="Implementation reported" />
    <bpmn:endEvent id="notified" name="Failure notified" />
    <bpmn:exclusiveGateway id="mergeSource" />
    <bpmn:sequenceFlow id="f-start-source" sourceRef="start" targetRef="source" />
    <bpmn:sequenceFlow id="f-source-request" name="SP / PU / GO request" sourceRef="source" targetRef="request" />
    <bpmn:sequenceFlow id="f-source-cause" name="MPO causes" sourceRef="source" targetRef="cause" />
    <bpmn:sequenceFlow id="f-request-mergeSource" sourceRef="request" targetRef="mergeSource" />
    <bpmn:sequenceFlow id="f-cause-mergeSource" sourceRef="cause" targetRef="mergeSource" />
    <bpmn:sequenceFlow id="f-mergeSource-review" sourceRef="mergeSource" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="Reject" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="Confirm" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-perform" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f-perform-outcome" sourceRef="perform" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-report" name="Implementation" sourceRef="outcome" targetRef="report" />
    <bpmn:sequenceFlow id="f-outcome-notify" name="Failure" sourceRef="outcome" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-reported" sourceRef="report" targetRef="reported" />
    <bpmn:sequenceFlow id="f-notify-notified" sourceRef="notify" targetRef="notified" />
  </bpmn:process>
</bpmn:definitions>
