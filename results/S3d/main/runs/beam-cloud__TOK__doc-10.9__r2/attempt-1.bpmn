<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sppugo" name="SP / PU / GO">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>initiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>init_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>init_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="request" name="Request changes" />
    <bpmn:startEvent id="initiated" name="Change initiated" />
    <bpmn:task id="cause" name="Cause a change" />
    <bpmn:exclusiveGateway id="init_split" name="Change initiated by?" />
    <bpmn:exclusiveGateway id="init_merge" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="decision" name="Reject or confirm?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:task id="confirm" name="Confirm the request" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="result" name="Report or notify?" />
    <bpmn:task id="report" name="Report the implementation" />
    <bpmn:task id="notify" name="Notify about the failure of the changes" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:endEvent id="reported" name="Implementation reported" />
    <bpmn:endEvent id="notified" name="Failure notified" />
    <bpmn:sequenceFlow id="f-initiated-init_split" sourceRef="initiated" targetRef="init_split" />
    <bpmn:sequenceFlow id="f-init_split-cause" name="MPO himself" sourceRef="init_split" targetRef="cause" />
    <bpmn:sequenceFlow id="f-init_split-request" name="SP / PU / GO" sourceRef="init_split" targetRef="request" />
    <bpmn:sequenceFlow id="f-cause-init_merge" sourceRef="cause" targetRef="init_merge" />
    <bpmn:sequenceFlow id="f-request-init_merge" sourceRef="request" targetRef="init_merge" />
    <bpmn:sequenceFlow id="f-init_merge-review" sourceRef="init_merge" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="rejects" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="confirmes" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-perform" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f-perform-result" sourceRef="perform" targetRef="result" />
    <bpmn:sequenceFlow id="f-result-report" name="reports implementation" sourceRef="result" targetRef="report" />
    <bpmn:sequenceFlow id="f-result-notify" name="notifies failure" sourceRef="result" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-reported" sourceRef="report" targetRef="reported" />
    <bpmn:sequenceFlow id="f-notify-notified" sourceRef="notify" targetRef="notified" />
  </bpmn:process>
</bpmn:definitions>
