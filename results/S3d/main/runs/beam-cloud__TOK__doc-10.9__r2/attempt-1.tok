tok 1.0 "Measuring point change"

pool org "Organisation"
  lane sppugo "SP / PU / GO"
    task request "Request changes"
  lane mpo "MPO"
    start initiated "Change initiated"
    task cause "Cause a change"
    xor init_split "Change initiated by?"
    xor init_merge
    task review "Review the change request"
    xor decision "Reject or confirm?"
    task reject "Reject the change of the measuring point"
    task confirm "Confirm the request"
    task perform "Perform the measuring point change"
    xor result "Report or notify?"
    task report "Report the implementation"
    task notify "Notify about the failure of the changes"
    end rejected "Change rejected"
    end reported "Implementation reported"
    end notified "Failure notified"

flow initiated -> init_split
flow init_split -> cause "MPO himself"
flow init_split -> request "SP / PU / GO"
flow cause -> init_merge
flow request -> init_merge
flow init_merge -> review
flow review -> decision
flow decision -> reject "rejects"
flow decision -> confirm "confirmes"
flow reject -> rejected
flow confirm -> perform
flow perform -> result
flow result -> report "reports implementation"
flow result -> notify "notifies failure"
flow report -> reported
flow notify -> notified
