<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="Service degradation handling" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>enter_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_detailed_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_actual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork_reports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_reports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="electronic" name="Electronic Service">
        <bpmn:flowNodeRef>determine_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>link_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sig_affects</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>receive_detailed_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_detailed_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_trouble_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>counter_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_actual_performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertake_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_troubleshooting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>receive_detailed_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_trouble_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_restoration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>restore_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertake_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_troubleshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_troubleshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_terminated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust_billing</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Service degraded" />
    <bpmn:task id="perceive" name="Perceive service degradation" />
    <bpmn:task id="send_params" name="Send problem parameters" />
    <bpmn:task id="receive_report" name="Receive service performance and resolution report" />
    <bpmn:endEvent id="end_customer" name="Customer process ended" />
    <bpmn:task id="enter_report" name="Enter problem report" />
    <bpmn:task id="compare_sla" name="Compare problem report to SLA" />
    <bpmn:task id="determine_measures" name="Determine counter measures" />
    <bpmn:task id="create_detailed" name="Create detailed problem report" />
    <bpmn:task id="send_detailed_sm" name="Send detailed problem report to Service Management" />
    <bpmn:task id="receive_actual" name="Receive actual service performance" />
    <bpmn:task id="receive_resolution" name="Receive problem resolution report" />
    <bpmn:parallelGateway id="fork_reports" name="Start customer reporting" />
    <bpmn:task id="create_customer_report" name="Create customer report" />
    <bpmn:task id="send_customer_report" name="Send customer report" />
    <bpmn:task id="report_rebate" name="Report SLA violation rebate" />
    <bpmn:parallelGateway id="join_reports" name="Customer reporting completed" />
    <bpmn:endEvent id="end_cs" name="Customer Service process ended" />
    <bpmn:task id="determine_significance" name="Determine customer significance" />
    <bpmn:exclusiveGateway id="premium" name="Customer premium?" default="f-premium-sig_affects" />
    <bpmn:task id="link_extra" name="Link to extra problem fix process" />
    <bpmn:endEvent id="end_extra" name="Extra problem fix process started" />
    <bpmn:exclusiveGateway id="sig_affects" name="Customer significance affects counter measures?" default="f-sig_affects-create_detailed" />
    <bpmn:task id="receive_detailed_sm" name="Receive detailed problem report" />
    <bpmn:task id="investigate" name="Investigate problem analyzability" />
    <bpmn:exclusiveGateway id="analyzable" name="Problem analyzable by Service Management?" default="f-analyzable-analyze_problem" />
    <bpmn:task id="send_detailed_rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="analyze_problem" name="Analyze problem" />
    <bpmn:task id="create_trouble_sm" name="Create trouble report" />
    <bpmn:task id="receive_status" name="Receive status report" />
    <bpmn:task id="prepare_final" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="counter_measures" name="Counter measures required?" default="f-counter_measures-create_restoration_request" />
    <bpmn:task id="send_actual_performance" name="Send actual service performance to Customer Service" />
    <bpmn:task id="undertake_minor" name="Undertake corrective actions" />
    <bpmn:task id="create_resolution" name="Create problem resolution report" />
    <bpmn:task id="send_resolution" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="create_restoration_request" name="Create request for automatic resource restoration" />
    <bpmn:task id="send_restoration_request" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="receive_troubleshooting" name="Receive trouble-shooting report" />
    <bpmn:task id="receive_detailed_rp" name="Receive detailed problem report" />
    <bpmn:task id="check_problems" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="problems" name="Possible problems detected?" default="f-problems-analyze_detected" />
    <bpmn:task id="create_normal" name="Create normal service execution notification" />
    <bpmn:task id="analyze_detected" name="Analyze detected problem" />
    <bpmn:task id="create_trouble_rp" name="Create trouble report" />
    <bpmn:task id="create_status" name="Create status report" />
    <bpmn:task id="send_status" name="Send status report to Service Management" />
    <bpmn:task id="wait_restoration" name="Receive restoration request" />
    <bpmn:boundaryEvent id="restore_timeout" name="Restoration timeout" attachedToRef="wait_restoration">
      <bpmn:timerEventDefinition id="restore_timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="track_errors" name="Track possible errors" />
    <bpmn:task id="undertake_rp" name="Undertake corrective actions" />
    <bpmn:task id="create_troubleshoot" name="Create trouble-shooting report" />
    <bpmn:task id="send_troubleshoot" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="end_rp" name="Resource Provisioning process ended" />
    <bpmn:endEvent id="end_terminated" name="Process terminated">
      <bpmn:terminateEventDefinition id="end_terminated-def" />
    </bpmn:endEvent>
    <bpmn:task id="adjust_billing" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-s0-perceive" sourceRef="s0" targetRef="perceive" />
    <bpmn:sequenceFlow id="f-perceive-send_params" sourceRef="perceive" targetRef="send_params" />
    <bpmn:sequenceFlow id="f-send_params-enter_report" sourceRef="send_params" targetRef="enter_report" />
    <bpmn:sequenceFlow id="f-enter_report-compare_sla" sourceRef="enter_report" targetRef="compare_sla" />
    <bpmn:sequenceFlow id="f-compare_sla-determine_measures" sourceRef="compare_sla" targetRef="determine_measures" />
    <bpmn:sequenceFlow id="f-determine_measures-determine_significance" sourceRef="determine_measures" targetRef="determine_significance" />
    <bpmn:sequenceFlow id="f-determine_significance-premium" sourceRef="determine_significance" targetRef="premium" />
    <bpmn:sequenceFlow id="f-premium-link_extra" name="Premium" sourceRef="premium" targetRef="link_extra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">premium</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-premium-sig_affects" name="Not premium" sourceRef="premium" targetRef="sig_affects" />
    <bpmn:sequenceFlow id="f-link_extra-end_extra" sourceRef="link_extra" targetRef="end_extra" />
    <bpmn:sequenceFlow id="f-sig_affects-determine_measures" name="Affects counter measures" sourceRef="sig_affects" targetRef="determine_measures">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">affectsCounterMeasures</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sig_affects-create_detailed" name="Does not affect" sourceRef="sig_affects" targetRef="create_detailed" />
    <bpmn:sequenceFlow id="f-create_detailed-send_detailed_sm" sourceRef="create_detailed" targetRef="send_detailed_sm" />
    <bpmn:sequenceFlow id="f-send_detailed_sm-receive_detailed_sm" sourceRef="send_detailed_sm" targetRef="receive_detailed_sm" />
    <bpmn:sequenceFlow id="f-receive_detailed_sm-investigate" sourceRef="receive_detailed_sm" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-analyzable" sourceRef="investigate" targetRef="analyzable" />
    <bpmn:sequenceFlow id="f-analyzable-send_detailed_rp" name="Not analyzable" sourceRef="analyzable" targetRef="send_detailed_rp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notAnalyzable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-analyzable-analyze_problem" name="Analyzable" sourceRef="analyzable" targetRef="analyze_problem" />
    <bpmn:sequenceFlow id="f-analyze_problem-create_trouble_sm" sourceRef="analyze_problem" targetRef="create_trouble_sm" />
    <bpmn:sequenceFlow id="f-create_trouble_sm-prepare_final" sourceRef="create_trouble_sm" targetRef="prepare_final" />
    <bpmn:sequenceFlow id="f-send_detailed_rp-receive_detailed_rp" sourceRef="send_detailed_rp" targetRef="receive_detailed_rp" />
    <bpmn:sequenceFlow id="f-receive_detailed_rp-check_problems" sourceRef="receive_detailed_rp" targetRef="check_problems" />
    <bpmn:sequenceFlow id="f-check_problems-problems" sourceRef="check_problems" targetRef="problems" />
    <bpmn:sequenceFlow id="f-problems-create_normal" name="No problems" sourceRef="problems" targetRef="create_normal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noProblems</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-problems-analyze_detected" name="Problems detected" sourceRef="problems" targetRef="analyze_detected" />
    <bpmn:sequenceFlow id="f-analyze_detected-create_trouble_rp" sourceRef="analyze_detected" targetRef="create_trouble_rp" />
    <bpmn:sequenceFlow id="f-create_trouble_rp-create_status" sourceRef="create_trouble_rp" targetRef="create_status" />
    <bpmn:sequenceFlow id="f-create_normal-create_status" sourceRef="create_normal" targetRef="create_status" />
    <bpmn:sequenceFlow id="f-create_status-send_status" sourceRef="create_status" targetRef="send_status" />
    <bpmn:sequenceFlow id="f-send_status-receive_status" sourceRef="send_status" targetRef="receive_status" />
    <bpmn:sequenceFlow id="f-receive_status-prepare_final" sourceRef="receive_status" targetRef="prepare_final" />
    <bpmn:sequenceFlow id="f-prepare_final-counter_measures" sourceRef="prepare_final" targetRef="counter_measures" />
    <bpmn:sequenceFlow id="f-counter_measures-send_actual_performance" name="No problem" sourceRef="counter_measures" targetRef="send_actual_performance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noProblem</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-counter_measures-undertake_minor" name="Minor corrective actions" sourceRef="counter_measures" targetRef="undertake_minor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">minorCorrections</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-counter_measures-create_restoration_request" name="Automatic restoration" sourceRef="counter_measures" targetRef="create_restoration_request" />
    <bpmn:sequenceFlow id="f-send_actual_performance-receive_actual" sourceRef="send_actual_performance" targetRef="receive_actual" />
    <bpmn:sequenceFlow id="f-undertake_minor-create_resolution" sourceRef="undertake_minor" targetRef="create_resolution" />
    <bpmn:sequenceFlow id="f-create_resolution-send_resolution" sourceRef="create_resolution" targetRef="send_resolution" />
    <bpmn:sequenceFlow id="f-send_resolution-receive_resolution" sourceRef="send_resolution" targetRef="receive_resolution" />
    <bpmn:sequenceFlow id="f-create_restoration_request-send_restoration_request" sourceRef="create_restoration_request" targetRef="send_restoration_request" />
    <bpmn:sequenceFlow id="f-send_restoration_request-wait_restoration" sourceRef="send_restoration_request" targetRef="wait_restoration" />
    <bpmn:sequenceFlow id="f-wait_restoration-track_errors" sourceRef="wait_restoration" targetRef="track_errors" />
    <bpmn:sequenceFlow id="f-track_errors-undertake_rp" sourceRef="track_errors" targetRef="undertake_rp" />
    <bpmn:sequenceFlow id="f-undertake_rp-create_troubleshoot" sourceRef="undertake_rp" targetRef="create_troubleshoot" />
    <bpmn:sequenceFlow id="f-create_troubleshoot-send_troubleshoot" sourceRef="create_troubleshoot" targetRef="send_troubleshoot" />
    <bpmn:sequenceFlow id="f-send_troubleshoot-receive_troubleshooting" sourceRef="send_troubleshoot" targetRef="receive_troubleshooting" />
    <bpmn:sequenceFlow id="f-receive_troubleshooting-create_resolution" sourceRef="receive_troubleshooting" targetRef="create_resolution" />
    <bpmn:sequenceFlow id="f-restore_timeout-end_terminated" sourceRef="restore_timeout" targetRef="end_terminated" />
    <bpmn:sequenceFlow id="f-receive_actual-fork_reports" sourceRef="receive_actual" targetRef="fork_reports" />
    <bpmn:sequenceFlow id="f-receive_resolution-fork_reports" sourceRef="receive_resolution" targetRef="fork_reports" />
    <bpmn:sequenceFlow id="f-fork_reports-create_customer_report" sourceRef="fork_reports" targetRef="create_customer_report" />
    <bpmn:sequenceFlow id="f-fork_reports-report_rebate" sourceRef="fork_reports" targetRef="report_rebate" />
    <bpmn:sequenceFlow id="f-create_customer_report-send_customer_report" sourceRef="create_customer_report" targetRef="send_customer_report" />
    <bpmn:sequenceFlow id="f-send_customer_report-receive_report" sourceRef="send_customer_report" targetRef="receive_report" />
    <bpmn:sequenceFlow id="f-send_customer_report-join_reports" sourceRef="send_customer_report" targetRef="join_reports" />
    <bpmn:sequenceFlow id="f-report_rebate-adjust_billing" sourceRef="report_rebate" targetRef="adjust_billing" />
    <bpmn:sequenceFlow id="f-adjust_billing-join_reports" sourceRef="adjust_billing" targetRef="join_reports" />
    <bpmn:sequenceFlow id="f-join_reports-end_cs" sourceRef="join_reports" targetRef="end_cs" />
    <bpmn:sequenceFlow id="f-receive_report-end_customer" sourceRef="receive_report" targetRef="end_customer" />
  </bpmn:process>
</bpmn:definitions>
