<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Switch-over request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Withdrawal" name="Withdrawal" />
  <bpmn:message id="Message_Confirmation" name="Confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Switch-over request" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_bill_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer_service" name="Customer Service">
        <bpmn:flowNodeRef>receive_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regenerate_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_cis_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_meter_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response_merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tail_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_new_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid_operator" name="Grid Operator">
        <bpmn:flowNodeRef>check_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_comment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>demand_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>communicate_old</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate_agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_billing_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old_supplier" name="Old Supplier">
        <bpmn:flowNodeRef>receive_meter_os</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_bill_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_bill_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_billing_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_old</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="request" name="Switch-over request" />
    <bpmn:task id="transmit_data" name="Transmit customer data" />
    <bpmn:task id="check_contract" name="Check contract details" />
    <bpmn:task id="receive_bill_customer" name="Receive final billing" />
    <bpmn:endEvent id="end_customer" name="Customer process ends" />
    <bpmn:task id="receive_data" name="Receive customer data" />
    <bpmn:task id="enter_data" name="Enter customer data object into CRM system" />
    <bpmn:task id="compare_data" name="Compare customer data with internal database" />
    <bpmn:task id="check_data" name="Check completeness and plausibility" />
    <bpmn:task id="correct_errors" name="Correct errors" />
    <bpmn:exclusiveGateway id="g_errors" name="Errors found?" default="f-g_errors-g_exists" />
    <bpmn:task id="create_customer" name="Create new customer object" />
    <bpmn:exclusiveGateway id="g_exists" name="Customer exists?" default="f-g_exists-create_customer" />
    <bpmn:task id="prepare_docs" name="Prepare contract documents" />
    <bpmn:task id="analyze_issues" name="Analyze and resolve issues" />
    <bpmn:task id="regenerate_docs" name="Regenerate contract documents" />
    <bpmn:task id="send_confirmation" name="Send confirmation document" />
    <bpmn:task id="create_cis_contract" name="Create CIS contract" />
    <bpmn:task id="receive_meter_cs" name="Receive meter data" />
    <bpmn:task id="import_meter" name="Import meter data" />
    <bpmn:eventBasedGateway id="g_response" name="Customer response?" />
    <bpmn:intermediateCatchEvent id="withdraw" name="Withdrawal received">
      <bpmn:messageEventDefinition id="withdraw-def" messageRef="Message_Withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="confirm" name="Confirmation received">
      <bpmn:messageEventDefinition id="confirm-def" messageRef="Message_Confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="7 days elapsed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_docs" name="Contract documents generated successfully?" default="f-g_docs-analyze_issues" />
    <bpmn:exclusiveGateway id="response_merged" name="Customer response merged" />
    <bpmn:parallelGateway id="tail_split" name="Start tail activities" />
    <bpmn:endEvent id="end_withdrawn" name="Contract withdrawn" />
    <bpmn:endEvent id="end_new_customer" name="New customer won" />
    <bpmn:task id="check_docs" name="Check contract documents automatically" />
    <bpmn:task id="send_request_go" name="Send switch-over request to grid operator" />
    <bpmn:task id="check_concurrence" name="Check supplier concurrence" />
    <bpmn:task id="transmit_comment" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="g_concurrence" name="Supplier concurrence?" default="f-g_concurrence-create_cis_contract" />
    <bpmn:task id="inform_suppliers" name="Inform involved suppliers" />
    <bpmn:task id="demand_resolution" name="Demand resolution of conflict" />
    <bpmn:task id="communicate_old" name="Communicate with old supplier" />
    <bpmn:task id="terminate_agreement" name="Terminate sales agreement" />
    <bpmn:task id="transmit_meter" name="Transmit power meter data" />
    <bpmn:task id="compute_billing" name="Compute final billing" />
    <bpmn:task id="send_billing_go" name="Send final billing to old supplier" />
    <bpmn:endEvent id="end_go" name="Grid operator process ends" />
    <bpmn:task id="receive_meter_os" name="Receive power meter data" />
    <bpmn:task id="create_bill_customer" name="Create final billing for customer" />
    <bpmn:task id="send_bill_customer" name="Send final billing to customer" />
    <bpmn:task id="receive_billing_go" name="Receive final billing from grid operator" />
    <bpmn:endEvent id="end_old" name="Old supplier process ends" />
    <bpmn:sequenceFlow id="f-request-transmit_data" sourceRef="request" targetRef="transmit_data" />
    <bpmn:sequenceFlow id="f-transmit_data-receive_data" sourceRef="transmit_data" targetRef="receive_data" />
    <bpmn:sequenceFlow id="f-receive_data-enter_data" sourceRef="receive_data" targetRef="enter_data" />
    <bpmn:sequenceFlow id="f-enter_data-compare_data" sourceRef="enter_data" targetRef="compare_data" />
    <bpmn:sequenceFlow id="f-compare_data-check_data" sourceRef="compare_data" targetRef="check_data" />
    <bpmn:sequenceFlow id="f-check_data-g_errors" sourceRef="check_data" targetRef="g_errors" />
    <bpmn:sequenceFlow id="f-g_errors-correct_errors" name="yes" sourceRef="g_errors" targetRef="correct_errors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">errorsFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-correct_errors-check_data" sourceRef="correct_errors" targetRef="check_data" />
    <bpmn:sequenceFlow id="f-g_errors-g_exists" name="no" sourceRef="g_errors" targetRef="g_exists" />
    <bpmn:sequenceFlow id="f-g_exists-create_customer" name="no" sourceRef="g_exists" targetRef="create_customer" />
    <bpmn:sequenceFlow id="f-create_customer-prepare_docs" sourceRef="create_customer" targetRef="prepare_docs" />
    <bpmn:sequenceFlow id="f-g_exists-prepare_docs" name="yes" sourceRef="g_exists" targetRef="prepare_docs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-prepare_docs-check_docs" sourceRef="prepare_docs" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f-check_docs-g_docs" sourceRef="check_docs" targetRef="g_docs" />
    <bpmn:sequenceFlow id="f-g_docs-send_confirmation" name="yes" sourceRef="g_docs" targetRef="send_confirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsGenerated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_docs-analyze_issues" name="no" sourceRef="g_docs" targetRef="analyze_issues" />
    <bpmn:sequenceFlow id="f-analyze_issues-regenerate_docs" sourceRef="analyze_issues" targetRef="regenerate_docs" />
    <bpmn:sequenceFlow id="f-regenerate_docs-check_docs" sourceRef="regenerate_docs" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f-send_confirmation-send_request_go" sourceRef="send_confirmation" targetRef="send_request_go" />
    <bpmn:sequenceFlow id="f-send_request_go-check_concurrence" sourceRef="send_request_go" targetRef="check_concurrence" />
    <bpmn:sequenceFlow id="f-check_concurrence-transmit_comment" sourceRef="check_concurrence" targetRef="transmit_comment" />
    <bpmn:sequenceFlow id="f-transmit_comment-g_concurrence" sourceRef="transmit_comment" targetRef="g_concurrence" />
    <bpmn:sequenceFlow id="f-g_concurrence-inform_suppliers" name="yes" sourceRef="g_concurrence" targetRef="inform_suppliers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supplierConcurrence</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-inform_suppliers-demand_resolution" sourceRef="inform_suppliers" targetRef="demand_resolution" />
    <bpmn:sequenceFlow id="f-demand_resolution-communicate_old" sourceRef="demand_resolution" targetRef="communicate_old" />
    <bpmn:sequenceFlow id="f-communicate_old-terminate_agreement" sourceRef="communicate_old" targetRef="terminate_agreement" />
    <bpmn:sequenceFlow id="f-terminate_agreement-end_go" sourceRef="terminate_agreement" targetRef="end_go" />
    <bpmn:sequenceFlow id="f-g_concurrence-create_cis_contract" name="no" sourceRef="g_concurrence" targetRef="create_cis_contract" />
    <bpmn:sequenceFlow id="f-create_cis_contract-check_contract" sourceRef="create_cis_contract" targetRef="check_contract" />
    <bpmn:sequenceFlow id="f-check_contract-g_response" sourceRef="check_contract" targetRef="g_response" />
    <bpmn:sequenceFlow id="f-g_response-withdraw" sourceRef="g_response" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-g_response-confirm" sourceRef="g_response" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-g_response-timeout" sourceRef="g_response" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-withdraw-end_withdrawn" sourceRef="withdraw" targetRef="end_withdrawn" />
    <bpmn:sequenceFlow id="f-confirm-response_merged" sourceRef="confirm" targetRef="response_merged" />
    <bpmn:sequenceFlow id="f-timeout-response_merged" sourceRef="timeout" targetRef="response_merged" />
    <bpmn:sequenceFlow id="f-response_merged-tail_split" sourceRef="response_merged" targetRef="tail_split" />
    <bpmn:sequenceFlow id="f-tail_split-transmit_meter" sourceRef="tail_split" targetRef="transmit_meter" />
    <bpmn:sequenceFlow id="f-tail_split-compute_billing" sourceRef="tail_split" targetRef="compute_billing" />
    <bpmn:sequenceFlow id="f-transmit_meter-receive_meter_cs" sourceRef="transmit_meter" targetRef="receive_meter_cs" />
    <bpmn:sequenceFlow id="f-receive_meter_cs-import_meter" sourceRef="receive_meter_cs" targetRef="import_meter" />
    <bpmn:sequenceFlow id="f-import_meter-end_new_customer" sourceRef="import_meter" targetRef="end_new_customer" />
    <bpmn:sequenceFlow id="f-transmit_meter-receive_meter_os" sourceRef="transmit_meter" targetRef="receive_meter_os" />
    <bpmn:sequenceFlow id="f-receive_meter_os-create_bill_customer" sourceRef="receive_meter_os" targetRef="create_bill_customer" />
    <bpmn:sequenceFlow id="f-create_bill_customer-send_bill_customer" sourceRef="create_bill_customer" targetRef="send_bill_customer" />
    <bpmn:sequenceFlow id="f-send_bill_customer-end_old" sourceRef="send_bill_customer" targetRef="end_old" />
    <bpmn:sequenceFlow id="f-send_bill_customer-receive_bill_customer" sourceRef="send_bill_customer" targetRef="receive_bill_customer" />
    <bpmn:sequenceFlow id="f-receive_bill_customer-end_customer" sourceRef="receive_bill_customer" targetRef="end_customer" />
    <bpmn:sequenceFlow id="f-compute_billing-send_billing_go" sourceRef="compute_billing" targetRef="send_billing_go" />
    <bpmn:sequenceFlow id="f-send_billing_go-receive_billing_go" sourceRef="send_billing_go" targetRef="receive_billing_go" />
    <bpmn:sequenceFlow id="f-receive_billing_go-end_old" sourceRef="receive_billing_go" targetRef="end_old" />
    <bpmn:sequenceFlow id="f-send_billing_go-end_go" sourceRef="send_billing_go" targetRef="end_go" />
  </bpmn:process>
</bpmn:definitions>
