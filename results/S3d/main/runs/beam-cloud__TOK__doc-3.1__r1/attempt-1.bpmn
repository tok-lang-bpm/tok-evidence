<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="operations" name="Small Claims Registry Operations" processRef="operations-process" />
  </bpmn:collaboration>
  <bpmn:process id="operations-process" name="Warrant possession request processing" isExecutable="false">
    <bpmn:laneSet id="operations-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_sct_warrant_possession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_physical_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_respective_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach_new_sct_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_expanded_physical_file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>send_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mcstaff" name="MC Internal Staff">
        <bpmn:flowNodeRef>receive_physical_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Warrant possession request needed" />
    <bpmn:task id="send_request" name="Send warrant possession request" />
    <bpmn:task id="receive_request" name="Receive warrant possession request" />
    <bpmn:task id="retrieve_sct_file" name="Retrieve SCT file" />
    <bpmn:task id="forward_sct_warrant_possession" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store_physical_file" name="Store SCT physical file" />
    <bpmn:task id="receive_report" name="Receive report" />
    <bpmn:task id="retrieve_respective_sct_file" name="Retrieve respective SCT file" />
    <bpmn:task id="attach_new_sct_document" name="Attach new SCT document" />
    <bpmn:task id="store_expanded_physical_file" name="Store expanded SCT physical file" />
    <bpmn:task id="send_report" name="Send report" />
    <bpmn:task id="receive_physical_sct_file" name="Receive physical SCT file" />
    <bpmn:endEvent id="completed" name="Physical SCT file received" />
    <bpmn:sequenceFlow id="f-needed-send_request" sourceRef="needed" targetRef="send_request" />
    <bpmn:sequenceFlow id="f-send_request-receive_request" sourceRef="send_request" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f-receive_request-retrieve_sct_file" sourceRef="receive_request" targetRef="retrieve_sct_file" />
    <bpmn:sequenceFlow id="f-retrieve_sct_file-forward_sct_warrant_possession" sourceRef="retrieve_sct_file" targetRef="forward_sct_warrant_possession" />
    <bpmn:sequenceFlow id="f-forward_sct_warrant_possession-store_physical_file" sourceRef="forward_sct_warrant_possession" targetRef="store_physical_file" />
    <bpmn:sequenceFlow id="f-store_physical_file-send_report" sourceRef="store_physical_file" targetRef="send_report" />
    <bpmn:sequenceFlow id="f-send_report-receive_report" sourceRef="send_report" targetRef="receive_report" />
    <bpmn:sequenceFlow id="f-receive_report-retrieve_respective_sct_file" sourceRef="receive_report" targetRef="retrieve_respective_sct_file" />
    <bpmn:sequenceFlow id="f-retrieve_respective_sct_file-attach_new_sct_document" sourceRef="retrieve_respective_sct_file" targetRef="attach_new_sct_document" />
    <bpmn:sequenceFlow id="f-attach_new_sct_document-store_expanded_physical_file" sourceRef="attach_new_sct_document" targetRef="store_expanded_physical_file" />
    <bpmn:sequenceFlow id="f-store_expanded_physical_file-receive_physical_sct_file" sourceRef="store_expanded_physical_file" targetRef="receive_physical_sct_file" />
    <bpmn:sequenceFlow id="f-receive_physical_sct_file-completed" sourceRef="receive_physical_sct_file" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
