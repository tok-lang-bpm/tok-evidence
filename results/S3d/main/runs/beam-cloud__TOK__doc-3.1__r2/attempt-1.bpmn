<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Small Claims Registry Operations" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Warrant possession process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="back_office" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_sct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_possession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_physical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_respective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_expanded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>send_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="other_staff" name="Other MC internal staff">
        <bpmn:flowNodeRef>receive_physical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Warrant possession requested" />
    <bpmn:task id="send_request" name="Send warrant possession request" />
    <bpmn:task id="receive_request" name="Receive the request" />
    <bpmn:task id="retrieve_sct" name="Retrieve the SCT file" />
    <bpmn:task id="forward_possession" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store_physical" name="Store SCT physical file" />
    <bpmn:task id="receive_report" name="Receive the report" />
    <bpmn:task id="retrieve_respective" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach_document" name="Attach the new SCT document" />
    <bpmn:task id="store_expanded" name="Store the expanded SCT physical file" />
    <bpmn:task id="send_report" name="Send report" />
    <bpmn:task id="receive_physical" name="Receive the physical SCT file" />
    <bpmn:endEvent id="completed" name="Physical SCT file received" />
    <bpmn:sequenceFlow id="f-requested-send_request" sourceRef="requested" targetRef="send_request" />
    <bpmn:sequenceFlow id="f-send_request-receive_request" sourceRef="send_request" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f-receive_request-retrieve_sct" sourceRef="receive_request" targetRef="retrieve_sct" />
    <bpmn:sequenceFlow id="f-retrieve_sct-forward_possession" sourceRef="retrieve_sct" targetRef="forward_possession" />
    <bpmn:sequenceFlow id="f-forward_possession-store_physical" sourceRef="forward_possession" targetRef="store_physical" />
    <bpmn:sequenceFlow id="f-store_physical-send_report" sourceRef="store_physical" targetRef="send_report" />
    <bpmn:sequenceFlow id="f-send_report-receive_report" sourceRef="send_report" targetRef="receive_report" />
    <bpmn:sequenceFlow id="f-receive_report-retrieve_respective" sourceRef="receive_report" targetRef="retrieve_respective" />
    <bpmn:sequenceFlow id="f-retrieve_respective-attach_document" sourceRef="retrieve_respective" targetRef="attach_document" />
    <bpmn:sequenceFlow id="f-attach_document-store_expanded" sourceRef="attach_document" targetRef="store_expanded" />
    <bpmn:sequenceFlow id="f-store_expanded-receive_physical" sourceRef="store_expanded" targetRef="receive_physical" />
    <bpmn:sequenceFlow id="f-receive_physical-completed" sourceRef="receive_physical" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
