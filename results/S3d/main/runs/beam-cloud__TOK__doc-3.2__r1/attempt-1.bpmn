<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court hearing preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court hearing preparation" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="staff" name="Court Staff">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Files to be checked" />
    <bpmn:task id="check" name="Check the files" />
    <bpmn:exclusiveGateway id="missing" name="Some files missing?" default="f-missing-track" />
    <bpmn:task id="search" name="Initiate a search" />
    <bpmn:task id="track" name="Physically track the files to the intended location" />
    <bpmn:exclusiveGateway id="ready" name="All files ready" />
    <bpmn:parallelGateway id="split" name="Files ready" />
    <bpmn:task id="hand" name="Hand the files to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="join" name="Ready" />
    <bpmn:task id="hearings" name="Conduct the directions hearings" />
    <bpmn:endEvent id="done" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f-morning-check" sourceRef="morning" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-split" sourceRef="ready" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-hand" sourceRef="split" targetRef="hand" />
    <bpmn:sequenceFlow id="f-split-distribute" sourceRef="split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-join" sourceRef="hand" targetRef="join" />
    <bpmn:sequenceFlow id="f-distribute-join" sourceRef="distribute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-hearings" sourceRef="join" targetRef="hearings" />
    <bpmn:sequenceFlow id="f-hearings-done" sourceRef="hearings" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
