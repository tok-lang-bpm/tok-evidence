<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Court hearing file preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court hearing file preparation" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="officer" name="Court Officer">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="associate" name="Associate">
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Each morning">
      <bpmn:timerEventDefinition id="morning-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="check" name="Check files" />
    <bpmn:exclusiveGateway id="missing" name="Files missing?" default="f-missing-track" />
    <bpmn:task id="search" name="Initiate search" />
    <bpmn:task id="track" name="Physically track files" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:parallelGateway id="split" name="All files ready?" />
    <bpmn:task id="hand" name="Hand files to Associate" />
    <bpmn:task id="distribute" name="Distribute Judge's Lawlist" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="conduct" name="Conduct directions hearings" />
    <bpmn:endEvent id="done" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f-morning-check" sourceRef="morning" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-split" sourceRef="ready" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-hand" sourceRef="split" targetRef="hand" />
    <bpmn:sequenceFlow id="f-split-distribute" sourceRef="split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-join" sourceRef="hand" targetRef="join" />
    <bpmn:sequenceFlow id="f-distribute-join" sourceRef="distribute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-conduct" sourceRef="join" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-done" sourceRef="conduct" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
