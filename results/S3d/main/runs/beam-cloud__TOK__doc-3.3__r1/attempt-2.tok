tok 1.0 "Claim handling"

pool organisation "Organisation"
  lane claimsOfficer "Claims Officer"
    start registered "Claim registered"
    task examine "Examine claim"
    task write "Write settlement recommendation"
  lane seniorClaimsOfficer "Senior Claims Officer"
    task check "Check recommendation"
    xor ok "Claim OK?"
    end handled "Claim handling proceeds"

flow registered -> examine -> write -> check -> ok
flow ok -> write "Not OK"
flow ok -> handled "OK"
