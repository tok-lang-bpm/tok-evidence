tok 1.0 "Mail processing"

pool org "Organisation"
  lane mail_processing_unit "Mail Processing Unit"
    start start "Mail processing starts"
    task collect "Collect mail"
    task distribute "Distribute mail"
  lane mail_clerk "Mail Clerk"
    task sort_unopened "Sort unopened mail"
  lane registry "Registry"
    task receive "Receive mail"
    task open "Open mail"
    task sort_groups "Sort into groups"
    task register "Register mail"
  lane assistant "Assistant Registry Manager"
    task quality_check "Perform quality check"
    xor compliant "Mail compliant?"
    task compile_requisition "Compile list of requisition"
    task send_back "Send back to party"
    task capture_matter "Capture matter details"
    task provide_matter "Provide matter details to Cashier"
    and concurrent "Perform concurrent tasks"
    task put_envelope "Put receipt and copied documents into envelope"
    task post_party "Post to party"
    and concurrent_done "Concurrent tasks completed"
    end completed "Mail processing completed"
    end returned "Mail returned to party"
  lane cashier "Cashier"
    task take_fees "Take applicable fees"
    task capture_party "Capture party details"
    task print_file "Print physical court file"

flow start -> collect -> sort_unopened -> distribute -> receive -> open -> sort_groups -> register -> quality_check -> compliant
flow compliant -> capture_matter "Yes" when="compliant"
flow compliant -> compile_requisition "No" default
flow capture_matter -> provide_matter -> take_fees -> concurrent
flow concurrent -> put_envelope
flow concurrent -> capture_party
flow put_envelope -> post_party -> concurrent_done
flow capture_party -> print_file -> concurrent_done
flow concurrent_done -> completed
flow compile_requisition -> send_back -> returned
