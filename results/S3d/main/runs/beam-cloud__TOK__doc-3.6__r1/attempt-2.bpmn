<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims Notification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Claims Notification" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="claimant" name="Claimant">
        <bpmn:flowNodeRef>return_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_forms</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="org" name="Organisation">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims_system" name="Claims Management system">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="return_forms" name="Return forms" />
    <bpmn:task id="update_forms" name="Update forms" />
    <bpmn:startEvent id="received" name="Claim received" />
    <bpmn:task id="check_insured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" />
    <bpmn:task id="inform_rejected" name="Inform claimant that claim must be rejected" />
    <bpmn:task id="evaluate_severity" name="Evaluate severity of claim" />
    <bpmn:exclusiveGateway id="severity" name="Simple or complex claim?" />
    <bpmn:task id="send_forms" name="Send relevant forms to claimant" />
    <bpmn:task id="check_forms" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="complete" name="Forms complete?" />
    <bpmn:task id="inform_update" name="Inform claimant to update forms" />
    <bpmn:endEvent id="rejected" name="Claim rejected" />
    <bpmn:task id="register" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="done" name="Claims Notification ended" />
    <bpmn:sequenceFlow id="f-received-check_insured" sourceRef="received" targetRef="check_insured" />
    <bpmn:sequenceFlow id="f-check_insured-insured" sourceRef="check_insured" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-inform_rejected" name="no" sourceRef="insured" targetRef="inform_rejected" />
    <bpmn:sequenceFlow id="f-insured-evaluate_severity" name="yes" sourceRef="insured" targetRef="evaluate_severity" />
    <bpmn:sequenceFlow id="f-inform_rejected-rejected" sourceRef="inform_rejected" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-evaluate_severity-severity" sourceRef="evaluate_severity" targetRef="severity" />
    <bpmn:sequenceFlow id="f-severity-send_forms" name="simple" sourceRef="severity" targetRef="send_forms" />
    <bpmn:sequenceFlow id="f-severity-send_forms-2" name="complex" sourceRef="severity" targetRef="send_forms" />
    <bpmn:sequenceFlow id="f-send_forms-return_forms" sourceRef="send_forms" targetRef="return_forms" />
    <bpmn:sequenceFlow id="f-return_forms-check_forms" sourceRef="return_forms" targetRef="check_forms" />
    <bpmn:sequenceFlow id="f-check_forms-complete" sourceRef="check_forms" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-register" name="yes" sourceRef="complete" targetRef="register" />
    <bpmn:sequenceFlow id="f-complete-inform_update" name="no" sourceRef="complete" targetRef="inform_update" />
    <bpmn:sequenceFlow id="f-register-done" sourceRef="register" targetRef="done" />
    <bpmn:sequenceFlow id="f-inform_update-update_forms" sourceRef="inform_update" targetRef="update_forms" />
    <bpmn:sequenceFlow id="f-update_forms-check_forms" sourceRef="update_forms" targetRef="check_forms" />
  </bpmn:process>
</bpmn:definitions>
