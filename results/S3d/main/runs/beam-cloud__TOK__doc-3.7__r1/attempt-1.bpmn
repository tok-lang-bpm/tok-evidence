<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Car accident claim process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="claimsHandler" name="Claims handler">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>searchReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putInFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claimsManager" name="Claims manager">
        <bpmn:flowNodeRef>negotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="searchReport" name="Search the Police Report related to the car accident" />
    <bpmn:task id="putInFile" name="Put the Police Report in a file together with the Claim Documentation" />
    <bpmn:task id="calculateEstimate" name="Calculate an initial claim estimate" />
    <bpmn:task id="createActionPlan" name="Create an Action Plan based on an Action Plan Checklist" />
    <bpmn:task id="negotiateSettlement" name="Try to negotiate a settlement on the claim estimate" />
    <bpmn:task id="informClaimant" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="e" name="Process ended" />
    <bpmn:sequenceFlow id="f-s-searchReport" sourceRef="s" targetRef="searchReport" />
    <bpmn:sequenceFlow id="f-searchReport-putInFile" sourceRef="searchReport" targetRef="putInFile" />
    <bpmn:sequenceFlow id="f-putInFile-calculateEstimate" sourceRef="putInFile" targetRef="calculateEstimate" />
    <bpmn:sequenceFlow id="f-calculateEstimate-createActionPlan" sourceRef="calculateEstimate" targetRef="createActionPlan" />
    <bpmn:sequenceFlow id="f-createActionPlan-negotiateSettlement" sourceRef="createActionPlan" targetRef="negotiateSettlement" />
    <bpmn:sequenceFlow id="f-negotiateSettlement-informClaimant" sourceRef="negotiateSettlement" targetRef="informClaimant" />
    <bpmn:sequenceFlow id="f-informClaimant-e" sourceRef="informClaimant" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
