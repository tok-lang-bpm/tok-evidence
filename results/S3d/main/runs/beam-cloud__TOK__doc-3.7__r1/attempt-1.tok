tok 1.0 "Car accident claim process"

pool organisation "Organisation"
  lane claimsHandler "Claims handler"
    start s "Start"
    task searchReport "Search the Police Report related to the car accident"
    task putInFile "Put the Police Report in a file together with the Claim Documentation"
    task calculateEstimate "Calculate an initial claim estimate"
    task createActionPlan "Create an Action Plan based on an Action Plan Checklist"
  lane claimsManager "Claims manager"
    task negotiateSettlement "Try to negotiate a settlement on the claim estimate"
    task informClaimant "Inform the claimant of the outcome"
    end e "Process ended"

flow s -> searchReport -> putInFile -> calculateEstimate -> createActionPlan -> negotiateSettlement -> informClaimant -> e
