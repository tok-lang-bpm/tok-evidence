<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Car accident claim handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="police_report_database" name="Police Report database">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search_police_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_in_file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims_handler" name="Claims handler">
        <bpmn:flowNodeRef>calculate_initial_claim_estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_action_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims_manager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate_settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_claimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="search_police_report" name="Search the Police Report" />
    <bpmn:task id="put_in_file" name="Put the Police Report in a file" />
    <bpmn:task id="calculate_initial_claim_estimate" name="Calculate an initial claim estimate" />
    <bpmn:task id="create_action_plan" name="Create an Action Plan" />
    <bpmn:task id="negotiate_settlement" name="Negotiate a settlement" />
    <bpmn:task id="inform_claimant" name="Inform the claimant" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-search_police_report" sourceRef="s" targetRef="search_police_report" />
    <bpmn:sequenceFlow id="f-search_police_report-put_in_file" sourceRef="search_police_report" targetRef="put_in_file" />
    <bpmn:sequenceFlow id="f-put_in_file-calculate_initial_claim_estimate" sourceRef="put_in_file" targetRef="calculate_initial_claim_estimate" />
    <bpmn:sequenceFlow id="f-calculate_initial_claim_estimate-create_action_plan" sourceRef="calculate_initial_claim_estimate" targetRef="create_action_plan" />
    <bpmn:sequenceFlow id="f-create_action_plan-negotiate_settlement" sourceRef="create_action_plan" targetRef="negotiate_settlement" />
    <bpmn:sequenceFlow id="f-negotiate_settlement-inform_claimant" sourceRef="negotiate_settlement" targetRef="inform_claimant" />
    <bpmn:sequenceFlow id="f-inform_claimant-e" sourceRef="inform_claimant" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
