tok 1.0 "Car accident claim handling"

pool organisation "Organisation"
  lane police_report_database "Police Report database"
    start s "Start"
    task search_police_report "Search the Police Report"
    task put_in_file "Put the Police Report in a file"
  lane claims_handler "Claims handler"
    task calculate_initial_claim_estimate "Calculate an initial claim estimate"
    task create_action_plan "Create an Action Plan"
  lane claims_manager "Claims manager"
    task negotiate_settlement "Negotiate a settlement"
    task inform_claimant "Inform the claimant"
    end e "End"

flow s -> search_police_report -> put_in_file -> calculate_initial_claim_estimate -> create_action_plan -> negotiate_settlement -> inform_claimant -> e
