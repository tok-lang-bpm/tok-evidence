<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling process" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>checkDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>pickUpClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessmentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessmentHandled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="submitClaim" name="Submit claim" />
    <bpmn:task id="checkDocuments" name="Check documents" />
    <bpmn:task id="registerClaim" name="Register claim" />
    <bpmn:task id="pickUpClaim" name="Pick up claim" />
    <bpmn:task id="checkInsurance" name="Check insurance" />
    <bpmn:task id="performAssessment" name="Perform assessment" />
    <bpmn:exclusiveGateway id="assessmentResult" name="Assessment positive?" />
    <bpmn:task id="phoneGarage" name="Phone garage" />
    <bpmn:task id="schedulePayment" name="Schedule payment" />
    <bpmn:task id="rejectClaim" name="Reject claim" />
    <bpmn:exclusiveGateway id="assessmentHandled" />
    <bpmn:task id="sendLetter" name="Send letter" />
    <bpmn:endEvent id="e" name="Process complete" />
    <bpmn:sequenceFlow id="f-s-submitClaim" sourceRef="s" targetRef="submitClaim" />
    <bpmn:sequenceFlow id="f-submitClaim-checkDocuments" sourceRef="submitClaim" targetRef="checkDocuments" />
    <bpmn:sequenceFlow id="f-checkDocuments-registerClaim" sourceRef="checkDocuments" targetRef="registerClaim" />
    <bpmn:sequenceFlow id="f-registerClaim-pickUpClaim" sourceRef="registerClaim" targetRef="pickUpClaim" />
    <bpmn:sequenceFlow id="f-pickUpClaim-checkInsurance" sourceRef="pickUpClaim" targetRef="checkInsurance" />
    <bpmn:sequenceFlow id="f-checkInsurance-performAssessment" sourceRef="checkInsurance" targetRef="performAssessment" />
    <bpmn:sequenceFlow id="f-performAssessment-assessmentResult" sourceRef="performAssessment" targetRef="assessmentResult" />
    <bpmn:sequenceFlow id="f-assessmentResult-phoneGarage" name="yes" sourceRef="assessmentResult" targetRef="phoneGarage" />
    <bpmn:sequenceFlow id="f-assessmentResult-rejectClaim" name="no" sourceRef="assessmentResult" targetRef="rejectClaim" />
    <bpmn:sequenceFlow id="f-phoneGarage-schedulePayment" sourceRef="phoneGarage" targetRef="schedulePayment" />
    <bpmn:sequenceFlow id="f-schedulePayment-assessmentHandled" sourceRef="schedulePayment" targetRef="assessmentHandled" />
    <bpmn:sequenceFlow id="f-rejectClaim-assessmentHandled" sourceRef="rejectClaim" targetRef="assessmentHandled" />
    <bpmn:sequenceFlow id="f-assessmentHandled-sendLetter" sourceRef="assessmentHandled" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f-sendLetter-e" sourceRef="sendLetter" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
