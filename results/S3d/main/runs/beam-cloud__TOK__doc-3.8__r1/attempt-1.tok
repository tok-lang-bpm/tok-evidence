tok 1.0 "Claim handling process"

pool insurer "Car insurer"
  lane customer "Customer"
    start s "Start"
    task submitClaim "Submit claim"
  lane notification "Notification department"
    task checkDocuments "Check documents"
    task registerClaim "Register claim"
  lane handling "Handling department"
    task pickUpClaim "Pick up claim"
    task checkInsurance "Check insurance"
    task performAssessment "Perform assessment"
    xor assessmentResult "Assessment positive?"
    task phoneGarage "Phone garage"
    task schedulePayment "Schedule payment"
    task rejectClaim "Reject claim"
    xor assessmentHandled
    task sendLetter "Send letter"
    end e "Process complete"

flow s -> submitClaim
flow submitClaim -> checkDocuments
flow checkDocuments -> registerClaim
flow registerClaim -> pickUpClaim
flow pickUpClaim -> checkInsurance
flow checkInsurance -> performAssessment
flow performAssessment -> assessmentResult
flow assessmentResult -> phoneGarage "yes"
flow assessmentResult -> rejectClaim "no"
flow phoneGarage -> schedulePayment
flow schedulePayment -> assessmentHandled
flow rejectClaim -> assessmentHandled
flow assessmentHandled -> sendLetter
flow sendLetter -> e
