<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="family" name="Family doctor">
        <bpmn:flowNodeRef>start_intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secret" name="Secretarial office">
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_through</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_assignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>medical_required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type_tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_typed_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_list_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetings_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nurse" name="Nursing officer">
        <bpmn:flowNodeRef>full_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_in_form</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team-leader">
        <bpmn:flowNodeRef>hold_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_patients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_assignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_file_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_assignment_list</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="social" name="Social-medical worker">
        <bpmn:flowNodeRef>plan_first_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill_checklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_observations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copy_notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_checklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="physician" name="Physician">
        <bpmn:flowNodeRef>plan_second_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_observations</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Psychiatrist">
        <bpmn:flowNodeRef>formulate_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_intake</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_intake" name="Intake starts" />
    <bpmn:task id="notice" name="Notice by telephone" />
    <bpmn:task id="inquire" name="Inquire name and residence" />
    <bpmn:task id="put_through" name="Put doctor through to nursing officer" />
    <bpmn:task id="store_info" name="Store information in information system" />
    <bpmn:task id="print_info" name="Print information" />
    <bpmn:exclusiveGateway id="new_patient" name="New patient?" default="f-new_patient-store_docs" />
    <bpmn:task id="create_file" name="Create patient file" />
    <bpmn:task id="store_docs" name="Store registration form and print in patient file" />
    <bpmn:task id="produce_cards" name="Produce registration cards" />
    <bpmn:task id="add_list" name="Add new patient to list of new notices" />
    <bpmn:task id="store_assignments" name="Store assignment in information system" />
    <bpmn:task id="pass_cards" name="Pass registration cards to intakers" />
    <bpmn:exclusiveGateway id="medical_required" name="Medical file required?" default="f-medical_required-plan_second_meeting" />
    <bpmn:task id="send_letter" name="Prepare and send letter to family doctor" />
    <bpmn:task id="receive_copy" name="Receive copy of medical file" />
    <bpmn:task id="inform_second" name="Inform second intaker" />
    <bpmn:task id="add_copy" name="Add copy to patient file" />
    <bpmn:task id="type_tapes" name="Type out tapes" />
    <bpmn:task id="add_typed_info" name="Add information to patient file" />
    <bpmn:task id="put_list_status" name="Put patient on list of patients reached status" />
    <bpmn:task id="provide_list" name="Provide team-leader list of patients" />
    <bpmn:parallelGateway id="meetings_done" name="Both intaker meetings completed" />
    <bpmn:task id="full_inquiry" name="Make full inquiry" />
    <bpmn:task id="record_form" name="Record information on registration form" />
    <bpmn:task id="hand_in_form" name="Hand in registration form" />
    <bpmn:task id="hold_meeting" name="Hold staff meeting" />
    <bpmn:task id="assign_patients" name="Assign new patients to members" />
    <bpmn:task id="record_assignments" name="Record assignments on assignment list" />
    <bpmn:task id="determine_file" name="Determine whether medical file is required" />
    <bpmn:task id="add_file_info" name="Add medical file requirement to assignment list" />
    <bpmn:task id="hand_assignment_list" name="Hand assignment list to secretarial office" />
    <bpmn:task id="plan_first_meeting" name="Plan meeting with patient" />
    <bpmn:task id="examine_patient" name="Examine patient using standard checklist" />
    <bpmn:task id="fill_checklist" name="Fill out standard checklist" />
    <bpmn:task id="register_observations" name="Register additional observations in notebook" />
    <bpmn:task id="copy_notes" name="Put copy of notes in patient file" />
    <bpmn:task id="add_checklist" name="Add standard checklist to patient file" />
    <bpmn:task id="plan_second_meeting" name="Plan first meeting with patient" />
    <bpmn:task id="record_observations" name="Record observations made during meetings" />
    <bpmn:task id="formulate_plan" name="Formulate treatment plan" />
    <bpmn:endEvent id="end_intake" name="Intake ends" />
    <bpmn:sequenceFlow id="f-start_intake-notice" sourceRef="start_intake" targetRef="notice" />
    <bpmn:sequenceFlow id="f-notice-inquire" sourceRef="notice" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-put_through" sourceRef="inquire" targetRef="put_through" />
    <bpmn:sequenceFlow id="f-put_through-full_inquiry" sourceRef="put_through" targetRef="full_inquiry" />
    <bpmn:sequenceFlow id="f-full_inquiry-record_form" sourceRef="full_inquiry" targetRef="record_form" />
    <bpmn:sequenceFlow id="f-record_form-hand_in_form" sourceRef="record_form" targetRef="hand_in_form" />
    <bpmn:sequenceFlow id="f-hand_in_form-store_info" sourceRef="hand_in_form" targetRef="store_info" />
    <bpmn:sequenceFlow id="f-store_info-print_info" sourceRef="store_info" targetRef="print_info" />
    <bpmn:sequenceFlow id="f-print_info-new_patient" sourceRef="print_info" targetRef="new_patient" />
    <bpmn:sequenceFlow id="f-new_patient-create_file" name="yes" sourceRef="new_patient" targetRef="create_file">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">newPatient</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-new_patient-store_docs" name="no" sourceRef="new_patient" targetRef="store_docs" />
    <bpmn:sequenceFlow id="f-create_file-store_docs" sourceRef="create_file" targetRef="store_docs" />
    <bpmn:sequenceFlow id="f-store_docs-produce_cards" sourceRef="store_docs" targetRef="produce_cards" />
    <bpmn:sequenceFlow id="f-produce_cards-add_list" sourceRef="produce_cards" targetRef="add_list" />
    <bpmn:sequenceFlow id="f-add_list-hold_meeting" sourceRef="add_list" targetRef="hold_meeting" />
    <bpmn:sequenceFlow id="f-hold_meeting-assign_patients" sourceRef="hold_meeting" targetRef="assign_patients" />
    <bpmn:sequenceFlow id="f-assign_patients-record_assignments" sourceRef="assign_patients" targetRef="record_assignments" />
    <bpmn:sequenceFlow id="f-record_assignments-determine_file" sourceRef="record_assignments" targetRef="determine_file" />
    <bpmn:sequenceFlow id="f-determine_file-add_file_info" sourceRef="determine_file" targetRef="add_file_info" />
    <bpmn:sequenceFlow id="f-add_file_info-hand_assignment_list" sourceRef="add_file_info" targetRef="hand_assignment_list" />
    <bpmn:sequenceFlow id="f-hand_assignment_list-store_assignments" sourceRef="hand_assignment_list" targetRef="store_assignments" />
    <bpmn:sequenceFlow id="f-store_assignments-pass_cards" sourceRef="store_assignments" targetRef="pass_cards" />
    <bpmn:sequenceFlow id="f-pass_cards-medical_required" sourceRef="pass_cards" targetRef="medical_required" />
    <bpmn:sequenceFlow id="f-medical_required-send_letter" name="yes" sourceRef="medical_required" targetRef="send_letter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">medicalFileRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-medical_required-plan_second_meeting" name="no" sourceRef="medical_required" targetRef="plan_second_meeting" />
    <bpmn:sequenceFlow id="f-send_letter-receive_copy" sourceRef="send_letter" targetRef="receive_copy" />
    <bpmn:sequenceFlow id="f-receive_copy-inform_second" sourceRef="receive_copy" targetRef="inform_second" />
    <bpmn:sequenceFlow id="f-inform_second-add_copy" sourceRef="inform_second" targetRef="add_copy" />
    <bpmn:sequenceFlow id="f-add_copy-plan_second_meeting" sourceRef="add_copy" targetRef="plan_second_meeting" />
    <bpmn:sequenceFlow id="f-pass_cards-plan_first_meeting" sourceRef="pass_cards" targetRef="plan_first_meeting" />
    <bpmn:sequenceFlow id="f-plan_first_meeting-examine_patient" sourceRef="plan_first_meeting" targetRef="examine_patient" />
    <bpmn:sequenceFlow id="f-examine_patient-fill_checklist" sourceRef="examine_patient" targetRef="fill_checklist" />
    <bpmn:sequenceFlow id="f-fill_checklist-register_observations" sourceRef="fill_checklist" targetRef="register_observations" />
    <bpmn:sequenceFlow id="f-register_observations-copy_notes" sourceRef="register_observations" targetRef="copy_notes" />
    <bpmn:sequenceFlow id="f-copy_notes-add_checklist" sourceRef="copy_notes" targetRef="add_checklist" />
    <bpmn:sequenceFlow id="f-add_checklist-meetings_done" sourceRef="add_checklist" targetRef="meetings_done" />
    <bpmn:sequenceFlow id="f-plan_second_meeting-record_observations" sourceRef="plan_second_meeting" targetRef="record_observations" />
    <bpmn:sequenceFlow id="f-record_observations-type_tapes" sourceRef="record_observations" targetRef="type_tapes" />
    <bpmn:sequenceFlow id="f-type_tapes-add_typed_info" sourceRef="type_tapes" targetRef="add_typed_info" />
    <bpmn:sequenceFlow id="f-add_typed_info-meetings_done" sourceRef="add_typed_info" targetRef="meetings_done" />
    <bpmn:sequenceFlow id="f-meetings_done-put_list_status" sourceRef="meetings_done" targetRef="put_list_status" />
    <bpmn:sequenceFlow id="f-put_list_status-provide_list" sourceRef="put_list_status" targetRef="provide_list" />
    <bpmn:sequenceFlow id="f-provide_list-formulate_plan" sourceRef="provide_list" targetRef="formulate_plan" />
    <bpmn:sequenceFlow id="f-formulate_plan-end_intake" sourceRef="formulate_plan" targetRef="end_intake" />
  </bpmn:process>
</bpmn:definitions>
