<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mental health intake" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Mental health intake" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="familyDoctor" name="Family doctor">
        <bpmn:flowNodeRef>telephone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendCopy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secretarial" name="Secretarial office">
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putThrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitAfterCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informIntaker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typeTapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addTapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetingsDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing" name="Nursing officer">
        <bpmn:flowNodeRef>fullInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handForm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="firstIntaker" name="First intaker">
        <bpmn:flowNodeRef>planFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerObserv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copyNotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addChecklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secondIntaker" name="Second intaker">
        <bpmn:flowNodeRef>planSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordDict</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teamLeader" name="Team-leader">
        <bpmn:flowNodeRef>staffMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetingPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>formulate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Attending psychiatrist" />
    </bpmn:laneSet>
    <bpmn:startEvent id="telephone" name="Notice by telephone" />
    <bpmn:task id="sendCopy" name="Send copy of medical file" />
    <bpmn:task id="inquire" name="Inquire name and residence" />
    <bpmn:task id="putThrough" name="Put doctor through to nursing officer" />
    <bpmn:task id="storeInfo" name="Store information in information system" />
    <bpmn:task id="printInfo" name="Print information" />
    <bpmn:exclusiveGateway id="newPatient" name="New patient?" default="f-newPatient-storeForm" />
    <bpmn:task id="createFile" name="Create patient file" />
    <bpmn:task id="storeForm" name="Store registration form and print in patient file" />
    <bpmn:task id="produceCards" name="Produce registration cards" />
    <bpmn:task id="addList" name="Add new patient to list of new notices" />
    <bpmn:task id="storeAssign" name="Store assignments in information system" />
    <bpmn:task id="passCards" name="Pass registration cards to intakers" />
    <bpmn:parallelGateway id="splitAfterCards" name="Pass registration cards" />
    <bpmn:exclusiveGateway id="required" name="Medical file required?" default="f-required-mergeRequired" />
    <bpmn:task id="sendLetter" name="Prepare and send letter requesting medical file" />
    <bpmn:task id="receiveCopy" name="Receive copy of medical file" />
    <bpmn:task id="informIntaker" name="Inform second intaker" />
    <bpmn:task id="addCopy" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="mergeRequired" name="Medical file required?" />
    <bpmn:task id="typeTapes" name="Type out tapes" />
    <bpmn:task id="addTapes" name="Add typed information to patient file" />
    <bpmn:parallelGateway id="meetingsDone" name="First and second meetings completed" />
    <bpmn:task id="putStatus" name="Put patient on list of patients that reach this status" />
    <bpmn:task id="provideList" name="Provide team-leader with list of patients" />
    <bpmn:task id="fullInquiry" name="Make full inquiry" />
    <bpmn:task id="recordForm" name="Record information on registration form" />
    <bpmn:task id="handForm" name="Hand in registration form" />
    <bpmn:task id="planFirst" name="Plan meeting with patient" />
    <bpmn:task id="examine" name="Examine patient using standard checklist" />
    <bpmn:task id="registerObserv" name="Register additional observations in personal notebook" />
    <bpmn:task id="copyNotes" name="Put copy of notes in patient file" />
    <bpmn:task id="addChecklist" name="Add standard checklist to patient file" />
    <bpmn:task id="planSecond" name="Plan first meeting" />
    <bpmn:task id="meetSecond" name="Meet with patient" />
    <bpmn:task id="recordDict" name="Record observations on dictaphone" />
    <bpmn:task id="staffMeeting" name="Hold staff meeting" />
    <bpmn:task id="assign" name="Assign patients to intakers" />
    <bpmn:task id="recordAssign" name="Record assignments on assignment list" />
    <bpmn:task id="determineFile" name="Determine whether medical file is required" />
    <bpmn:task id="meetingPlan" name="Hold staff meeting" />
    <bpmn:task id="formulate" name="Formulate treatment plan" />
    <bpmn:endEvent id="completed" name="Intake completed" />
    <bpmn:sequenceFlow id="f-telephone-inquire" sourceRef="telephone" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-putThrough" sourceRef="inquire" targetRef="putThrough" />
    <bpmn:sequenceFlow id="f-putThrough-fullInquiry" sourceRef="putThrough" targetRef="fullInquiry" />
    <bpmn:sequenceFlow id="f-fullInquiry-recordForm" sourceRef="fullInquiry" targetRef="recordForm" />
    <bpmn:sequenceFlow id="f-recordForm-handForm" sourceRef="recordForm" targetRef="handForm" />
    <bpmn:sequenceFlow id="f-handForm-storeInfo" sourceRef="handForm" targetRef="storeInfo" />
    <bpmn:sequenceFlow id="f-storeInfo-printInfo" sourceRef="storeInfo" targetRef="printInfo" />
    <bpmn:sequenceFlow id="f-printInfo-newPatient" sourceRef="printInfo" targetRef="newPatient" />
    <bpmn:sequenceFlow id="f-newPatient-createFile" name="yes" sourceRef="newPatient" targetRef="createFile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isNew</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-newPatient-storeForm" name="no" sourceRef="newPatient" targetRef="storeForm" />
    <bpmn:sequenceFlow id="f-createFile-storeForm" sourceRef="createFile" targetRef="storeForm" />
    <bpmn:sequenceFlow id="f-storeForm-produceCards" sourceRef="storeForm" targetRef="produceCards" />
    <bpmn:sequenceFlow id="f-produceCards-addList" sourceRef="produceCards" targetRef="addList" />
    <bpmn:sequenceFlow id="f-addList-staffMeeting" sourceRef="addList" targetRef="staffMeeting" />
    <bpmn:sequenceFlow id="f-staffMeeting-assign" sourceRef="staffMeeting" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-recordAssign" sourceRef="assign" targetRef="recordAssign" />
    <bpmn:sequenceFlow id="f-recordAssign-determineFile" sourceRef="recordAssign" targetRef="determineFile" />
    <bpmn:sequenceFlow id="f-determineFile-storeAssign" sourceRef="determineFile" targetRef="storeAssign" />
    <bpmn:sequenceFlow id="f-storeAssign-passCards" sourceRef="storeAssign" targetRef="passCards" />
    <bpmn:sequenceFlow id="f-passCards-splitAfterCards" sourceRef="passCards" targetRef="splitAfterCards" />
    <bpmn:sequenceFlow id="f-splitAfterCards-planFirst" sourceRef="splitAfterCards" targetRef="planFirst" />
    <bpmn:sequenceFlow id="f-splitAfterCards-required" sourceRef="splitAfterCards" targetRef="required" />
    <bpmn:sequenceFlow id="f-required-sendLetter" name="yes" sourceRef="required" targetRef="sendLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fileRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-required-mergeRequired" name="no" sourceRef="required" targetRef="mergeRequired" />
    <bpmn:sequenceFlow id="f-sendLetter-sendCopy" sourceRef="sendLetter" targetRef="sendCopy" />
    <bpmn:sequenceFlow id="f-sendCopy-receiveCopy" sourceRef="sendCopy" targetRef="receiveCopy" />
    <bpmn:sequenceFlow id="f-receiveCopy-informIntaker" sourceRef="receiveCopy" targetRef="informIntaker" />
    <bpmn:sequenceFlow id="f-informIntaker-addCopy" sourceRef="informIntaker" targetRef="addCopy" />
    <bpmn:sequenceFlow id="f-addCopy-mergeRequired" sourceRef="addCopy" targetRef="mergeRequired" />
    <bpmn:sequenceFlow id="f-mergeRequired-planSecond" sourceRef="mergeRequired" targetRef="planSecond" />
    <bpmn:sequenceFlow id="f-planFirst-examine" sourceRef="planFirst" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-registerObserv" sourceRef="examine" targetRef="registerObserv" />
    <bpmn:sequenceFlow id="f-registerObserv-copyNotes" sourceRef="registerObserv" targetRef="copyNotes" />
    <bpmn:sequenceFlow id="f-copyNotes-addChecklist" sourceRef="copyNotes" targetRef="addChecklist" />
    <bpmn:sequenceFlow id="f-planSecond-meetSecond" sourceRef="planSecond" targetRef="meetSecond" />
    <bpmn:sequenceFlow id="f-meetSecond-recordDict" sourceRef="meetSecond" targetRef="recordDict" />
    <bpmn:sequenceFlow id="f-recordDict-typeTapes" sourceRef="recordDict" targetRef="typeTapes" />
    <bpmn:sequenceFlow id="f-typeTapes-addTapes" sourceRef="typeTapes" targetRef="addTapes" />
    <bpmn:sequenceFlow id="f-addChecklist-meetingsDone" sourceRef="addChecklist" targetRef="meetingsDone" />
    <bpmn:sequenceFlow id="f-addTapes-meetingsDone" sourceRef="addTapes" targetRef="meetingsDone" />
    <bpmn:sequenceFlow id="f-meetingsDone-putStatus" sourceRef="meetingsDone" targetRef="putStatus" />
    <bpmn:sequenceFlow id="f-putStatus-provideList" sourceRef="putStatus" targetRef="provideList" />
    <bpmn:sequenceFlow id="f-provideList-meetingPlan" sourceRef="provideList" targetRef="meetingPlan" />
    <bpmn:sequenceFlow id="f-meetingPlan-formulate" sourceRef="meetingPlan" targetRef="formulate" />
    <bpmn:sequenceFlow id="f-formulate-completed" sourceRef="formulate" targetRef="completed" />
    <bpmn:textAnnotation id="psyc">
      <bpmn:text>Participates in formulating the treatment plan</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="psyc-assoc" sourceRef="psyc" targetRef="formulate" />
  </bpmn:process>
</bpmn:definitions>
