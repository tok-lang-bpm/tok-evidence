<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Loan approval process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Loan_request" name="Loan request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Loan approval" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Loan approval process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="risk" name="Risk Assessment Web Service">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="approver" name="Approver Web Service" />
    </bpmn:laneSet>
    <bpmn:startEvent id="request" name="Receive customer request">
      <bpmn:messageEventDefinition id="request-def" messageRef="Message_Loan_request" />
    </bpmn:startEvent>
    <bpmn:task id="feedback" name="Receive feedback from assessor or approver" />
    <bpmn:endEvent id="done" name="Loan approval completed" />
    <bpmn:serviceTask id="assess" name="Assess request" />
    <bpmn:exclusiveGateway id="decision" name="Risk and loan size?" default="f-decision-send" />
    <bpmn:task id="approve" name="Approve loan" />
    <bpmn:task id="deny" name="Deny loan" />
    <bpmn:serviceTask id="send" name="Send request to approver Web service" />
    <bpmn:exclusiveGateway id="merge" name="Join paths" />
    <bpmn:sequenceFlow id="f-request-assess" sourceRef="request" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-decision" sourceRef="assess" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-approve" name="Loan is small and customer is low risk" sourceRef="decision" targetRef="approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">smallLoan and lowRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-deny" name="Customer is high risk" sourceRef="decision" targetRef="deny">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">highRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-send" name="Further review or loan amount is $10,000 or more" sourceRef="decision" targetRef="send" />
    <bpmn:sequenceFlow id="f-approve-merge" sourceRef="approve" targetRef="merge" />
    <bpmn:sequenceFlow id="f-deny-merge" sourceRef="deny" targetRef="merge" />
    <bpmn:sequenceFlow id="f-send-merge" sourceRef="send" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-feedback" sourceRef="merge" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-done" sourceRef="feedback" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
