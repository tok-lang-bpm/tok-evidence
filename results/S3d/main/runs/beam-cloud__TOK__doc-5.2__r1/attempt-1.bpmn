<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>procedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Vacation request submitted" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="review" name="Review rejection reasons" />
    <bpmn:endEvent id="rejected" name="Vacation request rejected" />
    <bpmn:task id="register" name="Register requirement" />
    <bpmn:task id="notify" name="Generate notification" />
    <bpmn:task id="receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="approve" name="Vacation request approved?" default="f-approve-review" />
    <bpmn:task id="procedures" name="Complete management procedures" />
    <bpmn:endEvent id="completed" name="Vacation request completed" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-approve" sourceRef="receive" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-review" name="rejected" sourceRef="approve" targetRef="review" />
    <bpmn:sequenceFlow id="f-approve-notify" name="approved" sourceRef="approve" targetRef="notify" />
    <bpmn:sequenceFlow id="f-review-rejected" sourceRef="review" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-notify-procedures" sourceRef="notify" targetRef="procedures" />
    <bpmn:sequenceFlow id="f-procedures-completed" sourceRef="procedures" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
