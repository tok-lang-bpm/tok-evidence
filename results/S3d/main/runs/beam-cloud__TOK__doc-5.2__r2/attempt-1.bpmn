<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnapp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Vacation request needed" />
    <bpmn:task id="submit" name="Submit the vacation request" />
    <bpmn:task id="review" name="Review the rejection reasons" />
    <bpmn:endEvent id="rejected" name="Vacation request rejected" />
    <bpmn:task id="register" name="Register the requirement" />
    <bpmn:task id="receive" name="Receive the vacation request" />
    <bpmn:userTask id="approve" name="Approve or reject the request" />
    <bpmn:exclusiveGateway id="decision" name="Approved or rejected?" />
    <bpmn:task id="returnapp" name="Return the application" />
    <bpmn:task id="notify" name="Generate notification to the Human Resources Representative" />
    <bpmn:task id="manage" name="Complete the respective management procedures" />
    <bpmn:endEvent id="approved" name="Vacation request approved" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-approve" sourceRef="receive" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-decision" sourceRef="approve" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-returnapp" name="Rejected" sourceRef="decision" targetRef="returnapp" />
    <bpmn:sequenceFlow id="f-decision-notify" name="Approved" sourceRef="decision" targetRef="notify" />
    <bpmn:sequenceFlow id="f-returnapp-review" sourceRef="returnapp" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-rejected" sourceRef="review" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-notify-manage" sourceRef="notify" targetRef="manage" />
    <bpmn:sequenceFlow id="f-manage-approved" sourceRef="manage" targetRef="approved" />
  </bpmn:process>
</bpmn:definitions>
