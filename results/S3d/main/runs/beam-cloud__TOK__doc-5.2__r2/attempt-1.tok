tok 1.0 "Vacations Request"

pool organisation "Organisation"
  lane employee "Employee"
    start needed "Vacation request needed"
    task submit "Submit the vacation request"
    task review "Review the rejection reasons"
    end rejected "Vacation request rejected"
  lane supervisor "Immediate supervisor"
    task register "Register the requirement"
    task receive "Receive the vacation request"
    user approve "Approve or reject the request"
    xor decision "Approved or rejected?"
    task returnapp "Return the application"
  lane hr "Human Resources Representative"
    task notify "Generate notification to the Human Resources Representative"
    task manage "Complete the respective management procedures"
    end approved "Vacation request approved"

flow needed -> submit -> register -> receive -> approve -> decision
flow decision -> returnapp "Rejected"
flow decision -> notify "Approved"
flow returnapp -> review -> rejected
flow notify -> manage -> approved
