<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense report handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Payment_confirmation" name="Payment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense report handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment" name="Payment System">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Expense process started" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="approved" name="Expense report approved?" />
    <bpmn:task id="check" name="Check receipts" />
    <bpmn:exclusiveGateway id="receipts" name="Receipts in order?" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:task id="link" name="Link to payment system" />
    <bpmn:receiveTask id="confirm" name="Receive payment confirmation" messageRef="Message_Payment_confirmation" />
    <bpmn:endEvent id="done" name="Expense process completed" />
    <bpmn:sequenceFlow id="f-needed-purchase" sourceRef="needed" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approved" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-check" name="yes" sourceRef="approved" targetRef="check" />
    <bpmn:sequenceFlow id="f-approved-edit" name="no" sourceRef="approved" targetRef="edit" />
    <bpmn:sequenceFlow id="f-check-receipts" sourceRef="check" targetRef="receipts" />
    <bpmn:sequenceFlow id="f-receipts-accept" name="yes" sourceRef="receipts" targetRef="accept" />
    <bpmn:sequenceFlow id="f-receipts-edit" name="no" sourceRef="receipts" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-review" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f-accept-link" sourceRef="accept" targetRef="link" />
    <bpmn:sequenceFlow id="f-link-confirm" sourceRef="link" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
