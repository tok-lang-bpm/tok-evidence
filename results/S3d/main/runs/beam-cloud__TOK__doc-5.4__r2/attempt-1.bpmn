<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense Report Processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_payment_confirmed" name="payment confirmed" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Expense Report Processing" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment_system" name="Payment system">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Expense process started" />
    <bpmn:task id="purchase" name="Purchase a product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="approved" name="Expense report approved?" />
    <bpmn:task id="check" name="Check receipts" />
    <bpmn:exclusiveGateway id="receipts" name="Receipts complete and matching?" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:serviceTask id="link" name="Link to payment system" />
    <bpmn:receiveTask id="wait" name="Wait for payment confirmation" messageRef="Message_payment_confirmed" />
    <bpmn:endEvent id="ended" name="Process ended" />
    <bpmn:sequenceFlow id="f-started-purchase" sourceRef="started" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approved" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-check" name="approved" sourceRef="approved" targetRef="check" />
    <bpmn:sequenceFlow id="f-approved-edit" name="rejected" sourceRef="approved" targetRef="edit" />
    <bpmn:sequenceFlow id="f-check-receipts" sourceRef="check" targetRef="receipts" />
    <bpmn:sequenceFlow id="f-receipts-accept" name="all in order" sourceRef="receipts" targetRef="accept" />
    <bpmn:sequenceFlow id="f-receipts-edit" name="missing or mismatch" sourceRef="receipts" targetRef="edit" />
    <bpmn:sequenceFlow id="f-accept-link" sourceRef="accept" targetRef="link" />
    <bpmn:sequenceFlow id="f-link-wait" sourceRef="link" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-ended" sourceRef="wait" targetRef="ended" />
    <bpmn:sequenceFlow id="f-edit-review" sourceRef="edit" targetRef="review" />
  </bpmn:process>
</bpmn:definitions>
