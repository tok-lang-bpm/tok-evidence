tok 1.0 "Expense Report Processing"

pool organisation "Organisation"
  lane employee "Employee"
    start started "Expense process started"
    task purchase "Purchase a product or service"
    task submit "Submit expense report"
    task edit "Edit expense report"
  lane supervisor "Supervisor"
    task review "Review expense report"
    xor approved "Expense report approved?"
  lane treasurer "Treasurer"
    task check "Check receipts"
    xor receipts "Receipts complete and matching?"
    task accept "Accept expenses for processing"
  lane payment_system "Payment system"
    service link "Link to payment system"
    receive wait "Wait for payment confirmation" message="payment confirmed"
    end ended "Process ended"

flow started -> purchase -> submit -> review -> approved
flow approved -> check "approved"
flow approved -> edit "rejected"
flow check -> receipts
flow receipts -> accept "all in order"
flow receipts -> edit "missing or mismatch"
flow accept -> link -> wait -> ended
flow edit -> review
