<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice processing at ACME AG" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="ACME AG" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Invoice processing at ACME AG" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_inbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_accounting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting employee">
        <bpmn:flowNodeRef>identify_suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_instance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify_vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult_managers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>need_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inconsistencies_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_commercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file_signature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_instance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal_mail" name="Internal mail">
        <bpmn:flowNodeRef>send_first_manager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>route_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all_marked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_managers_again</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cost_manager" name="Cost center manager">
        <bpmn:flowNodeRef>review_accuracy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accuracy_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_ap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial manager">
        <bpmn:flowNodeRef>commercial_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount_over_20</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>board_check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received" />
    <bpmn:task id="receive_inbox" name="Receive invoice in central inbox" />
    <bpmn:task id="forward_accounting" name="Forward invoice to accounting after visual inspection" />
    <bpmn:task id="identify_suppliers" name="Identify charging suppliers" />
    <bpmn:task id="create_instance" name="Create new invoice instance" />
    <bpmn:task id="check_items" name="Check invoice items" />
    <bpmn:task id="note_docket" name="Note cost centers and cost center managers on docket" />
    <bpmn:task id="clarify_vendor" name="Proceed with clarification with vendor" />
    <bpmn:task id="consult_managers" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="need_consult" name="Need consult cost center managers?" default="f-need_consult-inconsistencies_resolved" />
    <bpmn:exclusiveGateway id="inconsistencies_resolved" name="All inconsistencies resolved?" default="f-inconsistencies_resolved-clarify_vendor" />
    <bpmn:task id="resolve_complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="forward_commercial" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="file_signature" name="File invoice in signature file" />
    <bpmn:task id="give_payment" name="Give payment instructions" />
    <bpmn:task id="close_instance" name="Close invoice instance" />
    <bpmn:endEvent id="completed" name="Invoice processed" />
    <bpmn:task id="send_first_manager" name="Send docket and invoice copy to first cost center manager" />
    <bpmn:task id="route_invoice" name="Pass invoice copy to next cost center manager or accounting" />
    <bpmn:exclusiveGateway id="all_marked" name="All invoice items marked AP?" default="f-all_marked-forward_commercial" />
    <bpmn:task id="send_rejected" name="Send invoice copy to accounting" />
    <bpmn:task id="send_managers_again" name="Send invoice copy to cost center managers again" />
    <bpmn:task id="review_accuracy" name="Review invoice copy for accuracy" />
    <bpmn:exclusiveGateway id="accuracy_decision" name="Everything in order?" />
    <bpmn:task id="note_ap" name="Note accurate position (AP) on docket" />
    <bpmn:task id="reject_ap" name="Reject AP and note explanation on docket" />
    <bpmn:task id="commercial_audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="complaint_decision" name="Complaint during commercial audit?" default="f-complaint_decision-issue_approval" />
    <bpmn:task id="issue_approval" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="amount_over_20" name="Bill amount exceeds EUR 20?" default="f-amount_over_20-give_payment" />
    <bpmn:task id="board_check" name="Check invoice again (4-eyes)" />
    <bpmn:sequenceFlow id="f-received-receive_inbox" sourceRef="received" targetRef="receive_inbox" />
    <bpmn:sequenceFlow id="f-receive_inbox-forward_accounting" sourceRef="receive_inbox" targetRef="forward_accounting" />
    <bpmn:sequenceFlow id="f-forward_accounting-identify_suppliers" sourceRef="forward_accounting" targetRef="identify_suppliers" />
    <bpmn:sequenceFlow id="f-identify_suppliers-create_instance" sourceRef="identify_suppliers" targetRef="create_instance" />
    <bpmn:sequenceFlow id="f-create_instance-check_items" sourceRef="create_instance" targetRef="check_items" />
    <bpmn:sequenceFlow id="f-check_items-note_docket" sourceRef="check_items" targetRef="note_docket" />
    <bpmn:sequenceFlow id="f-note_docket-send_first_manager" sourceRef="note_docket" targetRef="send_first_manager" />
    <bpmn:sequenceFlow id="f-send_first_manager-review_accuracy" sourceRef="send_first_manager" targetRef="review_accuracy" />
    <bpmn:sequenceFlow id="f-review_accuracy-accuracy_decision" sourceRef="review_accuracy" targetRef="accuracy_decision" />
    <bpmn:sequenceFlow id="f-accuracy_decision-note_ap" name="yes" sourceRef="accuracy_decision" targetRef="note_ap" />
    <bpmn:sequenceFlow id="f-accuracy_decision-reject_ap" name="no" sourceRef="accuracy_decision" targetRef="reject_ap" />
    <bpmn:sequenceFlow id="f-note_ap-route_invoice" sourceRef="note_ap" targetRef="route_invoice" />
    <bpmn:sequenceFlow id="f-route_invoice-all_marked" sourceRef="route_invoice" targetRef="all_marked" />
    <bpmn:sequenceFlow id="f-all_marked-review_accuracy" name="no" sourceRef="all_marked" targetRef="review_accuracy" />
    <bpmn:sequenceFlow id="f-all_marked-forward_commercial" name="yes" sourceRef="all_marked" targetRef="forward_commercial" />
    <bpmn:sequenceFlow id="f-reject_ap-send_rejected" sourceRef="reject_ap" targetRef="send_rejected" />
    <bpmn:sequenceFlow id="f-send_rejected-clarify_vendor" sourceRef="send_rejected" targetRef="clarify_vendor" />
    <bpmn:sequenceFlow id="f-clarify_vendor-need_consult" sourceRef="clarify_vendor" targetRef="need_consult" />
    <bpmn:sequenceFlow id="f-need_consult-consult_managers" name="yes" sourceRef="need_consult" targetRef="consult_managers" />
    <bpmn:sequenceFlow id="f-need_consult-inconsistencies_resolved" name="no" sourceRef="need_consult" targetRef="inconsistencies_resolved" />
    <bpmn:sequenceFlow id="f-consult_managers-inconsistencies_resolved" sourceRef="consult_managers" targetRef="inconsistencies_resolved" />
    <bpmn:sequenceFlow id="f-inconsistencies_resolved-send_managers_again" name="yes" sourceRef="inconsistencies_resolved" targetRef="send_managers_again" />
    <bpmn:sequenceFlow id="f-inconsistencies_resolved-clarify_vendor" name="no" sourceRef="inconsistencies_resolved" targetRef="clarify_vendor" />
    <bpmn:sequenceFlow id="f-send_managers_again-review_accuracy" sourceRef="send_managers_again" targetRef="review_accuracy" />
    <bpmn:sequenceFlow id="f-forward_commercial-commercial_audit" sourceRef="forward_commercial" targetRef="commercial_audit" />
    <bpmn:sequenceFlow id="f-commercial_audit-complaint_decision" sourceRef="commercial_audit" targetRef="complaint_decision" />
    <bpmn:sequenceFlow id="f-complaint_decision-resolve_complaint" name="yes" sourceRef="complaint_decision" targetRef="resolve_complaint" />
    <bpmn:sequenceFlow id="f-complaint_decision-issue_approval" name="no" sourceRef="complaint_decision" targetRef="issue_approval" />
    <bpmn:sequenceFlow id="f-resolve_complaint-commercial_audit" sourceRef="resolve_complaint" targetRef="commercial_audit" />
    <bpmn:sequenceFlow id="f-issue_approval-amount_over_20" sourceRef="issue_approval" targetRef="amount_over_20" />
    <bpmn:sequenceFlow id="f-amount_over_20-board_check" name="yes" sourceRef="amount_over_20" targetRef="board_check" />
    <bpmn:sequenceFlow id="f-amount_over_20-give_payment" name="no" sourceRef="amount_over_20" targetRef="give_payment" />
    <bpmn:sequenceFlow id="f-board_check-file_signature" sourceRef="board_check" targetRef="file_signature" />
    <bpmn:sequenceFlow id="f-file_signature-give_payment" sourceRef="file_signature" targetRef="give_payment" />
    <bpmn:sequenceFlow id="f-give_payment-close_instance" sourceRef="give_payment" targetRef="close_instance" />
    <bpmn:sequenceFlow id="f-close_instance-completed" sourceRef="close_instance" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
