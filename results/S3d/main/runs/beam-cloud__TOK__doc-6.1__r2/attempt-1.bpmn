<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Invoice processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice processing" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="costmanager" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_internal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>board_check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received" />
    <bpmn:task id="receive" name="Receive invoice" />
    <bpmn:task id="inspect" name="Visually inspect invoice" />
    <bpmn:task id="forward" name="Forward invoice to accounting" />
    <bpmn:task id="identify" name="Identify charging supplier" />
    <bpmn:task id="create" name="Create invoice instance" />
    <bpmn:task id="check" name="Check invoice items" />
    <bpmn:task id="note" name="Note cost center and cost center managers on docket" />
    <bpmn:task id="send_first" name="Send docket and invoice copy to first cost center manager" />
    <bpmn:task id="clarify" name="Proceed with clarification with vendor" />
    <bpmn:exclusiveGateway id="consult_gate" name="Consult cost center managers?" default="f-consult_gate-send_again" />
    <bpmn:task id="consult" name="Consult cost center managers" />
    <bpmn:task id="send_again" name="Send invoice copy to cost center managers again" />
    <bpmn:task id="forward_cm" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="resolve" name="Resolve complaint with supplier" />
    <bpmn:task id="pay" name="Give payment instructions" />
    <bpmn:task id="close" name="Close invoice instance" />
    <bpmn:endEvent id="done" name="Invoice processed" />
    <bpmn:task id="review" name="Review content for accuracy" />
    <bpmn:exclusiveGateway id="order" name="Everything in order?" default="f-order-reject" />
    <bpmn:task id="note_ap" name="Note accurate position on docket" />
    <bpmn:task id="return_internal" name="Return invoice copy to internal mail" />
    <bpmn:exclusiveGateway id="all" name="All items marked correct?" default="f-all-review" />
    <bpmn:task id="reject" name="Reject accurate position with note" />
    <bpmn:task id="audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint during audit?" default="f-complaint-approve" />
    <bpmn:task id="approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="amount" name="Bill amount exceeds EUR 20?" default="f-amount-pay" />
    <bpmn:task id="board_check" name="Check invoice" />
    <bpmn:sequenceFlow id="f-received-receive" sourceRef="received" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-identify" sourceRef="forward" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-check" sourceRef="create" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-note" sourceRef="check" targetRef="note" />
    <bpmn:sequenceFlow id="f-note-send_first" sourceRef="note" targetRef="send_first" />
    <bpmn:sequenceFlow id="f-send_first-review" sourceRef="send_first" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-order" sourceRef="review" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-note_ap" name="yes" sourceRef="order" targetRef="note_ap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accurate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-order-reject" name="no" sourceRef="order" targetRef="reject" />
    <bpmn:sequenceFlow id="f-note_ap-return_internal" sourceRef="note_ap" targetRef="return_internal" />
    <bpmn:sequenceFlow id="f-return_internal-all" sourceRef="return_internal" targetRef="all" />
    <bpmn:sequenceFlow id="f-all-forward_cm" name="yes" sourceRef="all" targetRef="forward_cm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allItemsCorrect</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-all-review" name="no" sourceRef="all" targetRef="review" />
    <bpmn:sequenceFlow id="f-reject-clarify" sourceRef="reject" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consult_gate" sourceRef="clarify" targetRef="consult_gate" />
    <bpmn:sequenceFlow id="f-consult_gate-consult" name="yes" sourceRef="consult_gate" targetRef="consult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">consultNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-consult_gate-send_again" name="no" sourceRef="consult_gate" targetRef="send_again" />
    <bpmn:sequenceFlow id="f-consult-send_again" sourceRef="consult" targetRef="send_again" />
    <bpmn:sequenceFlow id="f-send_again-review" sourceRef="send_again" targetRef="review" />
    <bpmn:sequenceFlow id="f-forward_cm-audit" sourceRef="forward_cm" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve" name="yes" sourceRef="complaint" targetRef="resolve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complaint</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-complaint-approve" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f-resolve-audit" sourceRef="resolve" targetRef="audit" />
    <bpmn:sequenceFlow id="f-approve-amount" sourceRef="approve" targetRef="amount" />
    <bpmn:sequenceFlow id="f-amount-board_check" name="yes" sourceRef="amount" targetRef="board_check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &gt; 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-amount-pay" name="no" sourceRef="amount" targetRef="pay" />
    <bpmn:sequenceFlow id="f-board_check-pay" sourceRef="board_check" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-close" sourceRef="pay" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-done" sourceRef="close" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
