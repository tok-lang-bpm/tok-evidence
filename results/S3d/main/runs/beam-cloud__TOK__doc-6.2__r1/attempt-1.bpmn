<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Procurement of product parts" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="procurement" name="Procurement process" processRef="procurement-process" />
  </bpmn:collaboration>
  <bpmn:process id="procurement-process" name="Procurement of product parts" isExecutable="false">
    <bpmn:laneSet id="procurement-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>monthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthly" name="First of each month">
      <bpmn:timerEventDefinition id="monthly-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="send_order" name="Send the order" />
    <bpmn:task id="receive_invoice" name="Receive the invoice" />
    <bpmn:endEvent id="done" name="Invoice received" />
    <bpmn:task id="process_order" name="Process the order" />
    <bpmn:task id="send_invoice" name="Send an invoice" />
    <bpmn:sequenceFlow id="f-monthly-send_order" sourceRef="monthly" targetRef="send_order" />
    <bpmn:sequenceFlow id="f-send_order-process_order" sourceRef="send_order" targetRef="process_order" />
    <bpmn:sequenceFlow id="f-process_order-send_invoice" sourceRef="process_order" targetRef="send_invoice" />
    <bpmn:sequenceFlow id="f-send_invoice-receive_invoice" sourceRef="send_invoice" targetRef="receive_invoice" />
    <bpmn:sequenceFlow id="f-receive_invoice-done" sourceRef="receive_invoice" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
