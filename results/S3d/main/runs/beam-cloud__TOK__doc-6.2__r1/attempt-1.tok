tok 1.0 "Procurement of product parts"

pool procurement "Procurement process"
  lane assembler "Assembler AG"
    start monthly "First of each month" timer=P1M
    task send_order "Send the order"
    task receive_invoice "Receive the invoice"
    end done "Invoice received"
  lane supplier "Supplier"
    task process_order "Process the order"
    task send_invoice "Send an invoice"

flow monthly -> send_order -> process_order -> send_invoice -> receive_invoice -> done
