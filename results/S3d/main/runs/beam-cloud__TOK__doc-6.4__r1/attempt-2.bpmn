<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_CustomerContact" name="CustomerContact" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="general" name="General">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know_person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave_alone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_details_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_presentation_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_contact_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="marketing" name="Marketing">
        <bpmn:flowNodeRef>marketing_part</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call Center">
        <bpmn:flowNodeRef>call_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_interest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="headdev" name="Head of Development">
        <bpmn:flowNodeRef>acquire_head</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>presentation_sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_after_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_quotation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-Sales">
        <bpmn:flowNodeRef>presentation_presales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="buy_details" name="Buy details for cold calls" />
    <bpmn:task id="know_person" name="Know somebody interested in the product" />
    <bpmn:task id="leave_alone" name="Leave customer alone" />
    <bpmn:exclusiveGateway id="gw_details" name="Determine contact details" default="f-gw_details-know_person" />
    <bpmn:exclusiveGateway id="gw_details_join" name="Contact details determined" />
    <bpmn:exclusiveGateway id="gw_interest" name="Customer generally interested?" default="f-gw_interest-gw_budget" />
    <bpmn:exclusiveGateway id="gw_budget" name="Potential project budget huge?" default="f-gw_budget-leave_alone" />
    <bpmn:exclusiveGateway id="gw_final" name="Customer interested in the end?" default="f-gw_final-leave_alone" />
    <bpmn:exclusiveGateway id="gw_presentation" name="More technical presentation?" default="f-gw_presentation-presentation_sales" />
    <bpmn:exclusiveGateway id="gw_presentation_done" name="Presentation given" />
    <bpmn:eventBasedGateway id="gw_response" name="Customer response?" />
    <bpmn:intermediateCatchEvent id="catch_contact" name="Customer contacts us">
      <bpmn:messageEventDefinition id="catch_contact-def" messageRef="Message_CustomerContact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_timeout" name="2 weeks elapsed">
      <bpmn:timerEventDefinition id="catch_timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gw_contact_join" name="Customer contacted" />
    <bpmn:endEvent id="end_done" name="End" />
    <bpmn:task id="marketing_part" name="Participate in exhibitions" />
    <bpmn:task id="call_customer" name="Start calling the customer" />
    <bpmn:task id="determine_contact" name="Determine contact person" />
    <bpmn:task id="determine_budget" name="Determine project budget" />
    <bpmn:task id="ask_interest" name="Ask customer whether generally interested" />
    <bpmn:task id="acquire_head" name="Try to acquire customer" />
    <bpmn:task id="presentation_sales" name="Give online presentation" />
    <bpmn:task id="call_after_timeout" name="Call customer" />
    <bpmn:task id="create_quotation" name="Create quotation" />
    <bpmn:task id="presentation_presales" name="Give technical online presentation" />
    <bpmn:sequenceFlow id="f-start-gw_details" sourceRef="start" targetRef="gw_details" />
    <bpmn:sequenceFlow id="f-gw_details-buy_details" name="Buy details" sourceRef="gw_details" targetRef="buy_details">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">buy</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_details-marketing_part" name="Exhibitions" sourceRef="gw_details" targetRef="marketing_part">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">exhibitions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_details-know_person" name="Know somebody" sourceRef="gw_details" targetRef="know_person" />
    <bpmn:sequenceFlow id="f-buy_details-gw_details_join" sourceRef="buy_details" targetRef="gw_details_join" />
    <bpmn:sequenceFlow id="f-marketing_part-gw_details_join" sourceRef="marketing_part" targetRef="gw_details_join" />
    <bpmn:sequenceFlow id="f-know_person-gw_details_join" sourceRef="know_person" targetRef="gw_details_join" />
    <bpmn:sequenceFlow id="f-gw_details_join-call_customer" sourceRef="gw_details_join" targetRef="call_customer" />
    <bpmn:sequenceFlow id="f-call_customer-determine_contact" sourceRef="call_customer" targetRef="determine_contact" />
    <bpmn:sequenceFlow id="f-determine_contact-determine_budget" sourceRef="determine_contact" targetRef="determine_budget" />
    <bpmn:sequenceFlow id="f-determine_budget-ask_interest" sourceRef="determine_budget" targetRef="ask_interest" />
    <bpmn:sequenceFlow id="f-ask_interest-gw_interest" sourceRef="ask_interest" targetRef="gw_interest" />
    <bpmn:sequenceFlow id="f-gw_interest-gw_presentation" name="Yes" sourceRef="gw_interest" targetRef="gw_presentation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_interest-gw_budget" name="No" sourceRef="gw_interest" targetRef="gw_budget" />
    <bpmn:sequenceFlow id="f-gw_budget-acquire_head" name="Yes" sourceRef="gw_budget" targetRef="acquire_head">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">budgetHuge</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_budget-leave_alone" name="No" sourceRef="gw_budget" targetRef="leave_alone" />
    <bpmn:sequenceFlow id="f-acquire_head-gw_final" sourceRef="acquire_head" targetRef="gw_final" />
    <bpmn:sequenceFlow id="f-gw_final-gw_presentation" name="Yes" sourceRef="gw_final" targetRef="gw_presentation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_final-leave_alone" name="No" sourceRef="gw_final" targetRef="leave_alone" />
    <bpmn:sequenceFlow id="f-leave_alone-end_done" sourceRef="leave_alone" targetRef="end_done" />
    <bpmn:sequenceFlow id="f-gw_presentation-presentation_presales" name="More technical" sourceRef="gw_presentation" targetRef="presentation_presales">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">technical</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_presentation-presentation_sales" name="Standard" sourceRef="gw_presentation" targetRef="presentation_sales" />
    <bpmn:sequenceFlow id="f-presentation_sales-gw_presentation_done" sourceRef="presentation_sales" targetRef="gw_presentation_done" />
    <bpmn:sequenceFlow id="f-presentation_presales-gw_presentation_done" sourceRef="presentation_presales" targetRef="gw_presentation_done" />
    <bpmn:sequenceFlow id="f-gw_presentation_done-gw_response" sourceRef="gw_presentation_done" targetRef="gw_response" />
    <bpmn:sequenceFlow id="f-gw_response-catch_contact" sourceRef="gw_response" targetRef="catch_contact" />
    <bpmn:sequenceFlow id="f-gw_response-catch_timeout" sourceRef="gw_response" targetRef="catch_timeout" />
    <bpmn:sequenceFlow id="f-catch_contact-gw_contact_join" sourceRef="catch_contact" targetRef="gw_contact_join" />
    <bpmn:sequenceFlow id="f-catch_timeout-call_after_timeout" sourceRef="catch_timeout" targetRef="call_after_timeout" />
    <bpmn:sequenceFlow id="f-call_after_timeout-gw_contact_join" sourceRef="call_after_timeout" targetRef="gw_contact_join" />
    <bpmn:sequenceFlow id="f-gw_contact_join-create_quotation" sourceRef="gw_contact_join" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-create_quotation-end_done" sourceRef="create_quotation" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
