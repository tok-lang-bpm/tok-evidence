tok 1.0 "Customer acquisition"

pool organisation "Organisation"
  lane marketing "Marketing"
    start start_event "Start"
    xor contact_details "How to determine contact details?"
    task buy_details "Buy details for cold calls"
    task participate "Participate in exhibitions"
    task know_person "Know an interested customer"
    xor contact_details_done "Contact details determined"
  lane call_center "Call Center"
    task call_customer "Call the customer"
    task determine_contact_person "Determine contact person"
    task determine_budget "Determine project budget"
    task ask_interest "Ask customer if interested"
    xor interested "Customer interested?"
    xor budget_huge "Potential project budget huge?"
    end left_alone "Customer left alone"
  lane development "Development"
    task acquire_customer "Acquire customer"
    xor interested_end "Customer interested in the end?"
  lane sales "Sales"
    xor presentation_type "More technical presentation?"
    task present_sales "Give online presentation"
    xor presentation_done "Presentation given"
    task wait_customer "Wait for customer to come back"
    boundary timeout "Two weeks elapsed" on=wait_customer timer=P14D
    task call_back "Call the customer"
    task create_quotation "Create quotation"
    end completed "Quotation created"
  lane pre_sales "Pre-Sales"
    task present_presales "Give online presentation"

flow start_event -> contact_details
flow contact_details -> buy_details
flow contact_details -> participate
flow contact_details -> know_person
flow buy_details -> contact_details_done
flow participate -> contact_details_done
flow know_person -> contact_details_done
flow contact_details_done -> call_customer
flow call_customer -> determine_contact_person
flow determine_contact_person -> determine_budget
flow determine_budget -> ask_interest
flow ask_interest -> interested
flow interested -> presentation_type "yes"
flow interested -> budget_huge "no"
flow budget_huge -> acquire_customer "yes"
flow budget_huge -> left_alone "no"
flow acquire_customer -> interested_end
flow interested_end -> presentation_type "yes"
flow interested_end -> left_alone "no"
flow presentation_type -> present_sales "standard"
flow presentation_type -> present_presales "technical"
flow present_sales -> presentation_done
flow present_presales -> presentation_done
flow presentation_done -> wait_customer
flow wait_customer -> create_quotation
flow timeout -> call_back
flow call_back -> create_quotation
flow create_quotation -> completed
