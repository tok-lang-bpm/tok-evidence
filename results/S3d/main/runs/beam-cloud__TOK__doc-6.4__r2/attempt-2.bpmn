<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="marketing" name="Marketing">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>participate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know_person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact_details_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="call_center" name="Call Center">
        <bpmn:flowNodeRef>call_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_contact_person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget_huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left_alone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="development" name="Development">
        <bpmn:flowNodeRef>acquire_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>presentation_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present_sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentation_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_quotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pre_sales" name="Pre-Sales">
        <bpmn:flowNodeRef>present_presales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Start" />
    <bpmn:exclusiveGateway id="contact_details" name="How to determine contact details?" />
    <bpmn:task id="buy_details" name="Buy details for cold calls" />
    <bpmn:task id="participate" name="Participate in exhibitions" />
    <bpmn:task id="know_person" name="Know an interested customer" />
    <bpmn:exclusiveGateway id="contact_details_done" name="Contact details determined" />
    <bpmn:task id="call_customer" name="Call the customer" />
    <bpmn:task id="determine_contact_person" name="Determine contact person" />
    <bpmn:task id="determine_budget" name="Determine project budget" />
    <bpmn:task id="ask_interest" name="Ask customer if interested" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="budget_huge" name="Potential project budget huge?" />
    <bpmn:endEvent id="left_alone" name="Customer left alone" />
    <bpmn:task id="acquire_customer" name="Acquire customer" />
    <bpmn:exclusiveGateway id="interested_end" name="Customer interested in the end?" />
    <bpmn:exclusiveGateway id="presentation_type" name="More technical presentation?" />
    <bpmn:task id="present_sales" name="Give online presentation" />
    <bpmn:exclusiveGateway id="presentation_done" name="Presentation given" />
    <bpmn:task id="wait_customer" name="Wait for customer to come back" />
    <bpmn:boundaryEvent id="timeout" name="Two weeks elapsed" attachedToRef="wait_customer">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="call_back" name="Call the customer" />
    <bpmn:task id="create_quotation" name="Create quotation" />
    <bpmn:endEvent id="completed" name="Quotation created" />
    <bpmn:task id="present_presales" name="Give online presentation" />
    <bpmn:sequenceFlow id="f-start_event-contact_details" sourceRef="start_event" targetRef="contact_details" />
    <bpmn:sequenceFlow id="f-contact_details-buy_details" name="buy details" sourceRef="contact_details" targetRef="buy_details" />
    <bpmn:sequenceFlow id="f-contact_details-participate" name="exhibition" sourceRef="contact_details" targetRef="participate" />
    <bpmn:sequenceFlow id="f-contact_details-know_person" name="know somebody" sourceRef="contact_details" targetRef="know_person" />
    <bpmn:sequenceFlow id="f-buy_details-contact_details_done" sourceRef="buy_details" targetRef="contact_details_done" />
    <bpmn:sequenceFlow id="f-participate-contact_details_done" sourceRef="participate" targetRef="contact_details_done" />
    <bpmn:sequenceFlow id="f-know_person-contact_details_done" sourceRef="know_person" targetRef="contact_details_done" />
    <bpmn:sequenceFlow id="f-contact_details_done-call_customer" sourceRef="contact_details_done" targetRef="call_customer" />
    <bpmn:sequenceFlow id="f-call_customer-determine_contact_person" sourceRef="call_customer" targetRef="determine_contact_person" />
    <bpmn:sequenceFlow id="f-determine_contact_person-determine_budget" sourceRef="determine_contact_person" targetRef="determine_budget" />
    <bpmn:sequenceFlow id="f-determine_budget-ask_interest" sourceRef="determine_budget" targetRef="ask_interest" />
    <bpmn:sequenceFlow id="f-ask_interest-interested" sourceRef="ask_interest" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-presentation_type" name="yes" sourceRef="interested" targetRef="presentation_type" />
    <bpmn:sequenceFlow id="f-interested-budget_huge" name="no" sourceRef="interested" targetRef="budget_huge" />
    <bpmn:sequenceFlow id="f-budget_huge-acquire_customer" name="yes" sourceRef="budget_huge" targetRef="acquire_customer" />
    <bpmn:sequenceFlow id="f-budget_huge-left_alone" name="no" sourceRef="budget_huge" targetRef="left_alone" />
    <bpmn:sequenceFlow id="f-acquire_customer-interested_end" sourceRef="acquire_customer" targetRef="interested_end" />
    <bpmn:sequenceFlow id="f-interested_end-presentation_type" name="yes" sourceRef="interested_end" targetRef="presentation_type" />
    <bpmn:sequenceFlow id="f-interested_end-left_alone" name="no" sourceRef="interested_end" targetRef="left_alone" />
    <bpmn:sequenceFlow id="f-presentation_type-present_sales" name="standard" sourceRef="presentation_type" targetRef="present_sales" />
    <bpmn:sequenceFlow id="f-presentation_type-present_presales" name="technical" sourceRef="presentation_type" targetRef="present_presales" />
    <bpmn:sequenceFlow id="f-present_sales-presentation_done" sourceRef="present_sales" targetRef="presentation_done" />
    <bpmn:sequenceFlow id="f-present_presales-presentation_done" sourceRef="present_presales" targetRef="presentation_done" />
    <bpmn:sequenceFlow id="f-presentation_done-wait_customer" sourceRef="presentation_done" targetRef="wait_customer" />
    <bpmn:sequenceFlow id="f-wait_customer-create_quotation" sourceRef="wait_customer" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-timeout-call_back" sourceRef="timeout" targetRef="call_back" />
    <bpmn:sequenceFlow id="f-call_back-create_quotation" sourceRef="call_back" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-create_quotation-completed" sourceRef="create_quotation" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
