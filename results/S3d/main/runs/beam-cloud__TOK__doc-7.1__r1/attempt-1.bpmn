<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Lead handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Lead handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendnote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callnext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="check" name="Check the open leads" />
    <bpmn:task id="select" name="Select the top five ones" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call the contact person of the leads" />
    <bpmn:task id="process" name="Process the lead" />
    <bpmn:endEvent id="done" name="Lead processed" />
    <bpmn:task id="call" name="Call each customer" />
    <bpmn:exclusiveGateway id="interested" name="Someone is interested?" default="f-interested-callnext" />
    <bpmn:task id="sendnote" name="Send a note to the Manager" />
    <bpmn:task id="callnext" name="Call the next customer" />
    <bpmn:endEvent id="finished" name="No interest" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-interested" sourceRef="call" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-sendnote" name="yes" sourceRef="interested" targetRef="sendnote" />
    <bpmn:sequenceFlow id="f-interested-callnext" name="no" sourceRef="interested" targetRef="callnext" />
    <bpmn:sequenceFlow id="f-sendnote-process" sourceRef="sendnote" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-done" sourceRef="process" targetRef="done" />
    <bpmn:sequenceFlow id="f-callnext-finished" sourceRef="callnext" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
