<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Lead follow-up" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Lead follow-up" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="check" name="Check open leads" />
    <bpmn:task id="select" name="Select top five ones" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call contact person" />
    <bpmn:task id="process" name="Process lead" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:task id="call" name="Call each customer" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" default="f-interested-next" />
    <bpmn:task id="note" name="Send note to Manager" />
    <bpmn:task id="next" name="Call next customer" />
    <bpmn:endEvent id="end2" name="End" />
    <bpmn:sequenceFlow id="f-start-check" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-interested" sourceRef="call" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-note" name="yes" sourceRef="interested" targetRef="note" />
    <bpmn:sequenceFlow id="f-interested-next" name="no" sourceRef="interested" targetRef="next" />
    <bpmn:sequenceFlow id="f-note-process" sourceRef="note" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-end1" sourceRef="process" targetRef="end1" />
    <bpmn:sequenceFlow id="f-next-end2" sourceRef="next" targetRef="end2" />
  </bpmn:process>
</bpmn:definitions>
