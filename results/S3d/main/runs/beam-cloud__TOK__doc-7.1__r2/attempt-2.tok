tok 1.0 "Lead follow-up"

pool organisation "Organisation"
  lane manager "Manager"
    start start "Start"
    task check "Check open leads"
    task select "Select top five ones"
    task tell "Tell Sales Assistant to call contact person"
    task process "Process lead"
    end end1 "End"
  lane assistant "Sales Assistant"
    task call "Call each customer"
    xor interested "Customer interested?"
    task note "Send note to Manager"
    task next "Call next customer"
    end end2 "End"

flow start -> check -> select -> tell -> call
flow interested -> note "yes" when="interested"
flow interested -> next "no" default
flow note -> process
flow process -> end1
flow next -> end2
