tok 1.0 "Vacancy handling"

pool organisation "Organisation"
  lane hr "HR clerk"
    start reported "Vacancy reported"
    task create "Create job description"
    xor confusion "Confusion in message?"
    task ask "Ask department again"
    task submit "Submit job description for consideration"
    task correct "Correct job description"
    task post "Post job"
    end posted "Job posted"
  lane department "Department"
    task consider "Consider job description"
    xor approved "Approved?"
    task reject "Reject job description and request correction"

flow reported -> create -> confusion
flow confusion -> ask "yes"
flow confusion -> submit "no"
flow ask -> create
flow submit -> consider
flow consider -> approved
flow approved -> post "yes"
flow approved -> reject "no"
flow reject -> correct
flow correct -> submit
flow post -> posted
