<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Personnel requirements and job description" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Personnel requirements and job description" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>ask_questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="detected" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report vacancy" />
    <bpmn:exclusiveGateway id="qsplit" name="Questions from HR?" default="f-qsplit-qjoin" />
    <bpmn:task id="clarify" name="Clarify tasks and requirements" />
    <bpmn:exclusiveGateway id="qjoin" name="Ready to describe" />
    <bpmn:task id="wait" name="Wait for job description" />
    <bpmn:task id="review" name="Review job description" />
    <bpmn:exclusiveGateway id="csplit" name="Corrections needed?" default="f-csplit-approve" />
    <bpmn:task id="ask" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:endEvent id="approved" name="Job description approved" />
    <bpmn:task id="ask_questions" name="Ask about tasks and requirements" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:sequenceFlow id="f-detected-report" sourceRef="detected" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-qsplit" sourceRef="report" targetRef="qsplit" />
    <bpmn:sequenceFlow id="f-qsplit-ask_questions" name="Yes" sourceRef="qsplit" targetRef="ask_questions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hrHasQuestions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-qsplit-qjoin" name="No" sourceRef="qsplit" targetRef="qjoin" />
    <bpmn:sequenceFlow id="f-ask_questions-clarify" sourceRef="ask_questions" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-qjoin" sourceRef="clarify" targetRef="qjoin" />
    <bpmn:sequenceFlow id="f-qjoin-wait" sourceRef="qjoin" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-review" sourceRef="wait" targetRef="review" />
    <bpmn:sequenceFlow id="f-describe-wait" sourceRef="describe" targetRef="wait" />
    <bpmn:sequenceFlow id="f-review-csplit" sourceRef="review" targetRef="csplit" />
    <bpmn:sequenceFlow id="f-csplit-ask" name="Yes" sourceRef="csplit" targetRef="ask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">correctionsNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-csplit-approve" name="No" sourceRef="csplit" targetRef="approve" />
    <bpmn:sequenceFlow id="f-ask-describe" sourceRef="ask" targetRef="describe" />
    <bpmn:sequenceFlow id="f-approve-approved" sourceRef="approve" targetRef="approved" />
  </bpmn:process>
</bpmn:definitions>
