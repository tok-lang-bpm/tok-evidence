<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacancy handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacancy handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askcorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertize</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="detected" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:exclusiveGateway id="questions" name="HR has questions about tasks and requirements?" />
    <bpmn:task id="clarify" name="Be available for clarifications" />
    <bpmn:task id="review" name="Get the job description for review" />
    <bpmn:exclusiveGateway id="corrections" name="Corrections needed?" />
    <bpmn:task id="askcorr" name="Ask for corrections again" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:endEvent id="approved" name="Job description approved" />
    <bpmn:task id="ask" name="Ask questions about tasks and requirements" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="advertize" name="Advertize the job description" />
    <bpmn:sequenceFlow id="f-detected-report" sourceRef="detected" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-questions" sourceRef="report" targetRef="questions" />
    <bpmn:sequenceFlow id="f-questions-describe" name="no" sourceRef="questions" targetRef="describe" />
    <bpmn:sequenceFlow id="f-questions-ask" name="yes" sourceRef="questions" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-clarify" sourceRef="ask" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-describe" sourceRef="clarify" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-review" sourceRef="describe" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corrections" sourceRef="review" targetRef="corrections" />
    <bpmn:sequenceFlow id="f-corrections-askcorr" name="yes" sourceRef="corrections" targetRef="askcorr" />
    <bpmn:sequenceFlow id="f-corrections-approve" name="no" sourceRef="corrections" targetRef="approve" />
    <bpmn:sequenceFlow id="f-askcorr-describe" sourceRef="askcorr" targetRef="describe" />
    <bpmn:sequenceFlow id="f-approve-advertize" sourceRef="approve" targetRef="advertize" />
    <bpmn:sequenceFlow id="f-advertize-approved" sourceRef="advertize" targetRef="approved" />
  </bpmn:process>
</bpmn:definitions>
