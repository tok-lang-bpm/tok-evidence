tok 1.0 "Vacancy handling"

pool org "Organisation"
  lane head "Head of functional department"
    start detected "Personnel requirements detected"
    task report "Report the vacancy to the Personnel Department"
    xor questions "HR has questions about tasks and requirements?"
    task clarify "Be available for clarifications"
    task review "Get the job description for review"
    xor corrections "Corrections needed?"
    task askcorr "Ask for corrections again"
    task approve "Approve the job description"
    end approved "Job description approved"
  lane hr "Personnel Department"
    task ask "Ask questions about tasks and requirements"
    task describe "Describe the job"
    task advertize "Advertize the job description"

flow detected -> report -> questions
flow questions -> describe "no"
flow questions -> ask "yes"
flow ask -> clarify -> describe
flow describe -> review
flow review -> corrections
flow corrections -> askcorr "yes"
flow corrections -> approve "no"
flow askcorr -> describe
flow approve -> advertize -> approved
