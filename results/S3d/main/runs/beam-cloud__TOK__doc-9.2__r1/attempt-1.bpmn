<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mortgage offer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_mortgage_offer" name="mortgage_offer" />
  <bpmn:message id="Message_decline" name="decline" />
  <bpmn:message id="Message_completed_documents" name="completed_documents" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Mortgage offer" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prereq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer" />
      <bpmn:lane id="administration" name="Administration" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:sendTask id="send_offer" name="Send Mortgage offer" messageRef="Message_mortgage_offer" />
    <bpmn:eventBasedGateway id="reply" name="Reply?" />
    <bpmn:intermediateCatchEvent id="decline" name="Decline received">
      <bpmn:messageEventDefinition id="decline-def" messageRef="Message_decline" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="docs" name="Completed offer documents received">
      <bpmn:messageEventDefinition id="docs-def" messageRef="Message_completed_documents" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="No answer after 2 weeks">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="update_case" name="Update case details" />
    <bpmn:task id="archive_work" name="Archive work" />
    <bpmn:endEvent id="cancelled" name="Case cancelled">
      <bpmn:terminateEventDefinition id="cancelled-def" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="prereq" name="All prerequisite documents provided?" default="f-prereq-request_docs" />
    <bpmn:task id="move_case" name="Move case to administration" />
    <bpmn:endEvent id="completed" name="Case completed" />
    <bpmn:task id="request_docs" name="Generate request for outstanding documents" />
    <bpmn:endEvent id="requested" name="Outstanding documents requested" />
    <bpmn:sequenceFlow id="f-start-send_offer" sourceRef="start" targetRef="send_offer" />
    <bpmn:sequenceFlow id="f-send_offer-reply" sourceRef="send_offer" targetRef="reply" />
    <bpmn:sequenceFlow id="f-reply-decline" sourceRef="reply" targetRef="decline" />
    <bpmn:sequenceFlow id="f-reply-docs" sourceRef="reply" targetRef="docs" />
    <bpmn:sequenceFlow id="f-reply-timeout" sourceRef="reply" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-decline-update_case" sourceRef="decline" targetRef="update_case" />
    <bpmn:sequenceFlow id="f-timeout-update_case" sourceRef="timeout" targetRef="update_case" />
    <bpmn:sequenceFlow id="f-update_case-archive_work" sourceRef="update_case" targetRef="archive_work" />
    <bpmn:sequenceFlow id="f-archive_work-cancelled" sourceRef="archive_work" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-docs-prereq" sourceRef="docs" targetRef="prereq" />
    <bpmn:sequenceFlow id="f-prereq-move_case" name="yes" sourceRef="prereq" targetRef="move_case" />
    <bpmn:sequenceFlow id="f-prereq-request_docs" name="no" sourceRef="prereq" targetRef="request_docs" />
    <bpmn:sequenceFlow id="f-move_case-completed" sourceRef="move_case" targetRef="completed" />
    <bpmn:sequenceFlow id="f-request_docs-requested" sourceRef="request_docs" targetRef="requested" />
  </bpmn:process>
</bpmn:definitions>
