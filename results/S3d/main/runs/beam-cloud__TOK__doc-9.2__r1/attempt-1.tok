tok 1.0 "Mortgage offer"

pool org "Organisation"
  lane csr "Customer Service Representative"
    start start "Start"
    send send_offer "Send Mortgage offer" message="mortgage_offer"
    eventgw reply "Reply?"
    catch decline "Decline received" message="decline"
    catch docs "Completed offer documents received" message="completed_documents"
    catch timeout "No answer after 2 weeks" timer=P14D
    task update_case "Update case details"
    task archive_work "Archive work"
    end cancelled "Case cancelled" terminate
    xor prereq "All prerequisite documents provided?"
    task move_case "Move case to administration"
    end completed "Case completed"
    task request_docs "Generate request for outstanding documents"
    end requested "Outstanding documents requested"

  lane customer "Customer"

  lane administration "Administration"

flow start -> send_offer -> reply
flow reply -> decline
flow reply -> docs
flow reply -> timeout
flow decline -> update_case
flow timeout -> update_case
flow update_case -> archive_work -> cancelled
flow docs -> prereq
flow prereq -> move_case "yes"
flow prereq -> request_docs "no" default
flow move_case -> completed
flow request_docs -> requested
