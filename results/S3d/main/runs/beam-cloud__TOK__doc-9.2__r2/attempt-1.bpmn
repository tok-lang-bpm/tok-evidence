<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Mortgage offer handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Mortgage offer handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prereq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_timeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="administration" name="Administration">
        <bpmn:flowNodeRef>move_admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send_offer" name="Send mortgage offer to customer" />
    <bpmn:task id="wait_reply" name="Wait for reply" />
    <bpmn:exclusiveGateway id="reply" name="Reply received?" />
    <bpmn:task id="update_decline" name="Update case details" />
    <bpmn:task id="archive_decline" name="Archive work" />
    <bpmn:endEvent id="cancel_decline" name="Case cancelled" />
    <bpmn:exclusiveGateway id="prereq" name="All prerequisite documents provided?" />
    <bpmn:task id="generate_msg" name="Generate message to customer requesting outstanding documents" />
    <bpmn:endEvent id="requested" name="Outstanding documents requested" />
    <bpmn:task id="update_timeout" name="Update case details" />
    <bpmn:task id="archive_timeout" name="Archive work" />
    <bpmn:endEvent id="cancel_timeout" name="Case cancelled" />
    <bpmn:task id="decline" name="Call or write back declining the mortgage" />
    <bpmn:task id="send_docs" name="Send back completed offer documents" />
    <bpmn:task id="attach_docs" name="Attach prerequisite documents" />
    <bpmn:task id="move_admin" name="Move case to administration for completion" />
    <bpmn:endEvent id="completed" name="Case moved to administration for completion" />
    <bpmn:sequenceFlow id="f-start-send_offer" sourceRef="start" targetRef="send_offer" />
    <bpmn:sequenceFlow id="f-send_offer-wait_reply" sourceRef="send_offer" targetRef="wait_reply" />
    <bpmn:sequenceFlow id="f-wait_reply-reply" sourceRef="wait_reply" targetRef="reply" />
    <bpmn:sequenceFlow id="f-reply-decline" name="Customer declines" sourceRef="reply" targetRef="decline" />
    <bpmn:sequenceFlow id="f-decline-update_decline" sourceRef="decline" targetRef="update_decline" />
    <bpmn:sequenceFlow id="f-update_decline-archive_decline" sourceRef="update_decline" targetRef="archive_decline" />
    <bpmn:sequenceFlow id="f-archive_decline-cancel_decline" sourceRef="archive_decline" targetRef="cancel_decline" />
    <bpmn:sequenceFlow id="f-reply-send_docs" name="Completed offer documents" sourceRef="reply" targetRef="send_docs" />
    <bpmn:sequenceFlow id="f-send_docs-attach_docs" sourceRef="send_docs" targetRef="attach_docs" />
    <bpmn:sequenceFlow id="f-attach_docs-prereq" sourceRef="attach_docs" targetRef="prereq" />
    <bpmn:sequenceFlow id="f-prereq-move_admin" name="Yes" sourceRef="prereq" targetRef="move_admin" />
    <bpmn:sequenceFlow id="f-move_admin-completed" sourceRef="move_admin" targetRef="completed" />
    <bpmn:sequenceFlow id="f-prereq-generate_msg" name="No" sourceRef="prereq" targetRef="generate_msg" />
    <bpmn:sequenceFlow id="f-generate_msg-requested" sourceRef="generate_msg" targetRef="requested" />
    <bpmn:sequenceFlow id="f-reply-update_timeout" name="No answer after 2 weeks" sourceRef="reply" targetRef="update_timeout" />
    <bpmn:sequenceFlow id="f-update_timeout-archive_timeout" sourceRef="update_timeout" targetRef="archive_timeout" />
    <bpmn:sequenceFlow id="f-archive_timeout-cancel_timeout" sourceRef="archive_timeout" targetRef="cancel_timeout" />
  </bpmn:process>
</bpmn:definitions>
