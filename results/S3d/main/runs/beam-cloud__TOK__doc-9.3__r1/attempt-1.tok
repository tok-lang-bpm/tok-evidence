tok 1.0 "Annual meeting schedule"

pool authority "Town Planning Authority"
  lane coordination "Coordination Unit"
    start annual "In November"
    task draft "Draft schedule of meetings"
    task add "Add draft dates to all calendars"
    task recheck "Recheck all dates"
    task look "Look for potential conflicts"
    task send "Send final schedule of meeting dates"
  lane support "Support Officer"
    task check "Check the dates"
    task suggest "Suggest modifications"
  lane members "Independent Committee Members"
    task diaries "Check their diaries"
    task advise "Advise of any conflicts"
    end done "Conflicts advised"

flow annual -> draft -> add -> check -> suggest -> recheck -> look -> send -> diaries -> advise -> done
