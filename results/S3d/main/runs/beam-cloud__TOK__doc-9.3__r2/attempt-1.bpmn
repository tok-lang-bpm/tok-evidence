<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meeting schedule preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Meeting schedule preparation" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>yearly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Independent Committee Members">
        <bpmn:flowNodeRef>check_diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="yearly" name="November" />
    <bpmn:task id="draft" name="Draft schedule of meetings for next calendar year" />
    <bpmn:task id="add" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates and look for potential conflicts" />
    <bpmn:task id="send" name="Send final schedule of meeting dates by email" />
    <bpmn:task id="check" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="check_diaries" name="Check their diaries" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of any conflicts" />
    <bpmn:endEvent id="done" name="Conflicts advised" />
    <bpmn:sequenceFlow id="f-yearly-draft" sourceRef="yearly" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-add" sourceRef="draft" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-check" sourceRef="add" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-suggest" sourceRef="check" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-send" sourceRef="recheck" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-check_diaries" sourceRef="send" targetRef="check_diaries" />
    <bpmn:sequenceFlow id="f-check_diaries-advise" sourceRef="check_diaries" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-done" sourceRef="advise" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
