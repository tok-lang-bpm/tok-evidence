tok 1.0 "Meeting schedule preparation"

pool authority "Town Planning Authority"
  lane coordination "Coordination Unit"
    start yearly "November"
    task draft "Draft schedule of meetings for next calendar year"
    task add "Add draft dates to all calendars"
    task recheck "Recheck all dates and look for potential conflicts"
    task send "Send final schedule of meeting dates by email"
  lane support "Support Officer"
    task check "Check the dates"
    task suggest "Suggest modifications"
  lane committee "Independent Committee Members"
    task check_diaries "Check their diaries"
    task advise "Advise the Coordination Unit of any conflicts"
    end done "Conflicts advised"

flow yearly -> draft -> add -> check -> suggest -> recheck -> send -> check_diaries -> advise -> done
