<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize_dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa_minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_minutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support_officer" name="Support Officer">
        <bpmn:flowNodeRef>update_calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ensure_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise_members</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_records</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support_office" name="Support Office">
        <bpmn:flowNodeRef>produce_minutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>read_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Start" />
    <bpmn:task id="finalize_dates" name="Finalize dates" />
    <bpmn:task id="qa_minutes" name="Conduct QA check on minutes" />
    <bpmn:task id="send_minutes" name="Send minutes to all Committee Members" />
    <bpmn:task id="update_calendars" name="Update all group calendars" />
    <bpmn:task id="create_folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="ensure_documents" name="Ensure all appropriate documents are uploaded to system" />
    <bpmn:task id="advise_members" name="Advise Committee Members to read all related documents" />
    <bpmn:task id="update_records" name="Update all departmental records" />
    <bpmn:task id="produce_minutes" name="Produce minutes including any Action Points for each Committee Member" />
    <bpmn:task id="read_documents" name="Read all related documents" />
    <bpmn:task id="hold_meeting" name="Hold meeting" />
    <bpmn:endEvent id="end_event" name="Process complete" />
    <bpmn:sequenceFlow id="f-start_event-finalize_dates" sourceRef="start_event" targetRef="finalize_dates" />
    <bpmn:sequenceFlow id="f-finalize_dates-update_calendars" sourceRef="finalize_dates" targetRef="update_calendars" />
    <bpmn:sequenceFlow id="f-update_calendars-create_folders" sourceRef="update_calendars" targetRef="create_folders" />
    <bpmn:sequenceFlow id="f-create_folders-ensure_documents" sourceRef="create_folders" targetRef="ensure_documents" />
    <bpmn:sequenceFlow id="f-ensure_documents-advise_members" sourceRef="ensure_documents" targetRef="advise_members" />
    <bpmn:sequenceFlow id="f-advise_members-read_documents" sourceRef="advise_members" targetRef="read_documents" />
    <bpmn:sequenceFlow id="f-read_documents-hold_meeting" sourceRef="read_documents" targetRef="hold_meeting" />
    <bpmn:sequenceFlow id="f-hold_meeting-produce_minutes" sourceRef="hold_meeting" targetRef="produce_minutes" />
    <bpmn:sequenceFlow id="f-produce_minutes-qa_minutes" sourceRef="produce_minutes" targetRef="qa_minutes" />
    <bpmn:sequenceFlow id="f-qa_minutes-send_minutes" sourceRef="qa_minutes" targetRef="send_minutes" />
    <bpmn:sequenceFlow id="f-send_minutes-update_records" sourceRef="send_minutes" targetRef="update_records" />
    <bpmn:sequenceFlow id="f-update_records-end_event" sourceRef="update_records" targetRef="end_event" />
  </bpmn:process>
</bpmn:definitions>
