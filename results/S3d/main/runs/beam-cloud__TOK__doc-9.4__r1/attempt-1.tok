tok 1.0 "Committee meeting process"

pool organisation "Organisation"
  lane coordination "Coordination Unit"
    start start_event "Start"
    task finalize_dates "Finalize dates"
    task qa_minutes "Conduct QA check on minutes"
    task send_minutes "Send minutes to all Committee Members"
  lane support_officer "Support Officer"
    task update_calendars "Update all group calendars"
    task create_folders "Create meeting folders for each meeting"
    task ensure_documents "Ensure all appropriate documents are uploaded to system"
    task advise_members "Advise Committee Members to read all related documents"
    task update_records "Update all departmental records"
  lane support_office "Support Office"
    task produce_minutes "Produce minutes including any Action Points for each Committee Member"
  lane committee "Committee Members"
    task read_documents "Read all related documents"
    task hold_meeting "Hold meeting"
    end end_event "Process complete"

flow start_event -> finalize_dates -> update_calendars -> create_folders -> ensure_documents -> advise_members -> read_documents -> hold_meeting -> produce_minutes -> qa_minutes -> send_minutes -> update_records -> end_event
