tok 1.0 "Committee meeting process"

pool organisation "Organisation"
  lane coordination "Coordination Unit"
    start dates_finalized "Dates finalized"
    task qa_minutes "Conduct QA check on minutes"
    task send_minutes "Send minutes to Committee Members"
  lane support_officer "Support Officer"
    task update_calendars "Update group calendars"
    task create_folders "Create meeting folders"
    task ensure_documents "Ensure appropriate documents uploaded"
    task update_records "Update departmental records"
    end completed "Departmental records updated"
  lane support_office "Support Office"
    task advise_members "Advise Committee Members to read related documents"
    task produce_minutes "Produce minutes including action points"
  lane committee "Committee Members"
    task hold_meeting "Hold meeting"

flow dates_finalized -> update_calendars -> create_folders -> ensure_documents -> advise_members -> hold_meeting -> produce_minutes -> qa_minutes -> send_minutes -> update_records -> completed
