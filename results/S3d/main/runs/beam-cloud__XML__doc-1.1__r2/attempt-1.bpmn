<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Small company" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>order-received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship-bicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>process-part-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-items</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare-assembling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble-bicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="order-received" name="Order received" />
    <bpmn:exclusiveGateway id="reject-accept" name="Reject or accept order?" />
    <bpmn:endEvent id="order-rejected" name="Order rejected" />
    <bpmn:parallelGateway id="accept-parallel" />
    <bpmn:task id="process-part-list" name="Process part list" />
    <bpmn:subProcess id="process-items" name="Check and reserve or back-order parts">
      <bpmn:standardLoopCharacteristics testBefore="false">
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">moreItems</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
      <bpmn:startEvent id="item-start" name="Part item" />
      <bpmn:task id="check-quantity" name="Check required quantity of each part" />
      <bpmn:exclusiveGateway id="available" name="Part available in-house?" />
      <bpmn:task id="reserve-part" name="Reserve part" />
      <bpmn:task id="back-order-part" name="Back-order part" />
      <bpmn:exclusiveGateway id="part-merge" />
      <bpmn:endEvent id="item-end" name="Item processed" />
      <bpmn:sequenceFlow id="i1" sourceRef="item-start" targetRef="check-quantity" />
      <bpmn:sequenceFlow id="i2" sourceRef="check-quantity" targetRef="available" />
      <bpmn:sequenceFlow id="i3" name="yes" sourceRef="available" targetRef="reserve-part">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">available</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="i4" name="no" sourceRef="available" targetRef="back-order-part">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">notAvailable</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="i5" sourceRef="reserve-part" targetRef="part-merge" />
      <bpmn:sequenceFlow id="i6" sourceRef="back-order-part" targetRef="part-merge" />
      <bpmn:sequenceFlow id="i7" sourceRef="part-merge" targetRef="item-end" />
    </bpmn:subProcess>
    <bpmn:task id="prepare-assembling" name="Prepare assembling" />
    <bpmn:parallelGateway id="ready-parallel" />
    <bpmn:task id="assemble-bicycle" name="Assemble bicycle" />
    <bpmn:task id="ship-bicycle" name="Ship bicycle to customer" />
    <bpmn:endEvent id="process-finished" name="Process finished" />

    <bpmn:sequenceFlow id="f1" sourceRef="order-received" targetRef="reject-accept" />
    <bpmn:sequenceFlow id="f-reject" name="reject" sourceRef="reject-accept" targetRef="order-rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accept" name="accept" sourceRef="reject-accept" targetRef="accept-parallel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">accepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f2" sourceRef="accept-parallel" targetRef="process-part-list" />
    <bpmn:sequenceFlow id="f3" sourceRef="accept-parallel" targetRef="prepare-assembling" />
    <bpmn:sequenceFlow id="f4" sourceRef="process-part-list" targetRef="process-items" />
    <bpmn:sequenceFlow id="f5" sourceRef="process-items" targetRef="ready-parallel" />
    <bpmn:sequenceFlow id="f6" sourceRef="prepare-assembling" targetRef="ready-parallel" />
    <bpmn:sequenceFlow id="f7" sourceRef="ready-parallel" targetRef="assemble-bicycle" />
    <bpmn:sequenceFlow id="f8" sourceRef="assemble-bicycle" targetRef="ship-bicycle" />
    <bpmn:sequenceFlow id="f9" sourceRef="ship-bicycle" targetRef="process-finished" />
  </bpmn:process>
</bpmn:definitions>
