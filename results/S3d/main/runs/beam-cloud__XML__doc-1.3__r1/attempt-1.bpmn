<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_wine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_alcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare_food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch_wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>split_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_nonalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Guest calls room service" />
    <bpmn:task id="take_order" name="Take down the order" />
    <bpmn:task id="submit_ticket" name="Submit an order ticket to the kitchen" />
    <bpmn:parallelGateway id="split_prep" />
    <bpmn:task id="prepare_food" name="Prepare the food" />
    <bpmn:exclusiveGateway id="gw_alcohol" name="Order includes alcoholic beverages?" default="f_no_alcohol" />
    <bpmn:task id="give_order" name="Give an order to the sommelier" />
    <bpmn:parallelGateway id="split_wine" />
    <bpmn:task id="fetch_wine" name="Fetch wine from the cellar and prepare alcoholic beverages" />
    <bpmn:exclusiveGateway id="merge_alcohol" />
    <bpmn:task id="assign_order" name="Assign the order to the waiter" />
    <bpmn:parallelGateway id="split_cart" />
    <bpmn:task id="ready_cart" name="Ready a cart" />
    <bpmn:task id="prepare_nonalc" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="join_cart" />
    <bpmn:inclusiveGateway id="join_ready" name="Food, wine, and cart ready?" />
    <bpmn:task id="deliver" name="Deliver to the guest room" />
    <bpmn:exclusiveGateway id="gw_bill" name="Another order to prepare or deliver?" default="f_no_wait" />
    <bpmn:task id="wait_billing" name="Wait to do the billing" />
    <bpmn:exclusiveGateway id="merge_bill" />
    <bpmn:task id="debit" name="Debit the guest account" />
    <bpmn:endEvent id="end" name="Order completed" />

    <bpmn:sequenceFlow id="f_start" sourceRef="start" targetRef="take_order" />
    <bpmn:sequenceFlow id="f1" sourceRef="take_order" targetRef="submit_ticket" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit_ticket" targetRef="split_prep" />
    <bpmn:sequenceFlow id="f3" sourceRef="split_prep" targetRef="prepare_food" />
    <bpmn:sequenceFlow id="f4" sourceRef="split_prep" targetRef="gw_alcohol" />
    <bpmn:sequenceFlow id="f_yes_alcohol" name="yes" sourceRef="gw_alcohol" targetRef="give_order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">includeAlcohol == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no_alcohol" sourceRef="gw_alcohol" targetRef="merge_alcohol" />
    <bpmn:sequenceFlow id="f5" sourceRef="give_order" targetRef="split_wine" />
    <bpmn:sequenceFlow id="f6" sourceRef="split_wine" targetRef="fetch_wine" />
    <bpmn:sequenceFlow id="f7" sourceRef="split_wine" targetRef="merge_alcohol" />
    <bpmn:sequenceFlow id="f8" sourceRef="merge_alcohol" targetRef="assign_order" />
    <bpmn:sequenceFlow id="f9" sourceRef="assign_order" targetRef="split_cart" />
    <bpmn:sequenceFlow id="f10" sourceRef="split_cart" targetRef="ready_cart" />
    <bpmn:sequenceFlow id="f11" sourceRef="split_cart" targetRef="prepare_nonalc" />
    <bpmn:sequenceFlow id="f12" sourceRef="ready_cart" targetRef="join_cart" />
    <bpmn:sequenceFlow id="f13" sourceRef="prepare_nonalc" targetRef="join_cart" />
    <bpmn:sequenceFlow id="f14" sourceRef="join_cart" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f15" sourceRef="prepare_food" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f16" sourceRef="fetch_wine" targetRef="join_ready" />
    <bpmn:sequenceFlow id="f17" sourceRef="join_ready" targetRef="deliver" />
    <bpmn:sequenceFlow id="f18" sourceRef="deliver" targetRef="gw_bill" />
    <bpmn:sequenceFlow id="f_yes_wait" name="yes" sourceRef="gw_bill" targetRef="wait_billing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">anotherOrder == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no_wait" sourceRef="gw_bill" targetRef="merge_bill" />
    <bpmn:sequenceFlow id="f19" sourceRef="wait_billing" targetRef="merge_bill" />
    <bpmn:sequenceFlow id="f20" sourceRef="merge_bill" targetRef="debit" />
    <bpmn:sequenceFlow id="f21" sourceRef="debit" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
