<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="fault-detector" name="Fault detector">
        <bpmn:flowNodeRef>report-failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-merge-trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-go-msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix-fault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share-results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-go-resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-msp-resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Failure reported or suspected" />
    <bpmn:exclusiveGateway id="gateway-source" name="Failure source?" />
    <bpmn:task id="report-failure" name="Report a failure to the MPO" />
    <bpmn:exclusiveGateway id="gateway-merge-trigger" />
    <bpmn:task id="examine-failure" name="Examine the failure" />
    <bpmn:exclusiveGateway id="gateway-decision" name="Failure confirmed?" />
    <bpmn:endEvent id="end-rejected" name="Failure rejected" />
    <bpmn:task id="inform-go-msp" name="Inform the GO and the MSP" />
    <bpmn:task id="fix-fault" name="Fix the fault at the measuring device" />
    <bpmn:task id="share-results" name="Share the results of the repairs carried out with the fault detector" />
    <bpmn:task id="inform-go-resolution" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="inform-msp-resolution" name="Inform the MSP about the resolution of the interference" />
    <bpmn:endEvent id="end-resolved" name="Interference resolved" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gateway-source" />
    <bpmn:sequenceFlow id="f2" name="Fault detector reports a failure" sourceRef="gateway-source" targetRef="report-failure" />
    <bpmn:sequenceFlow id="f3" name="MPO has a suspicion of their own fault" sourceRef="gateway-source" targetRef="gateway-merge-trigger" />
    <bpmn:sequenceFlow id="f4" sourceRef="report-failure" targetRef="gateway-merge-trigger" />
    <bpmn:sequenceFlow id="f5" sourceRef="gateway-merge-trigger" targetRef="examine-failure" />
    <bpmn:sequenceFlow id="f6" sourceRef="examine-failure" targetRef="gateway-decision" />
    <bpmn:sequenceFlow id="f7" name="MPO rejects the failure" sourceRef="gateway-decision" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="f8" name="MPO confirms the failure" sourceRef="gateway-decision" targetRef="inform-go-msp" />
    <bpmn:sequenceFlow id="f9" sourceRef="inform-go-msp" targetRef="fix-fault" />
    <bpmn:sequenceFlow id="f10" sourceRef="fix-fault" targetRef="share-results" />
    <bpmn:sequenceFlow id="f11" sourceRef="share-results" targetRef="inform-go-resolution" />
    <bpmn:sequenceFlow id="f12" sourceRef="inform-go-resolution" targetRef="inform-msp-resolution" />
    <bpmn:sequenceFlow id="f13" sourceRef="inform-msp-resolution" targetRef="end-resolved" />
  </bpmn:process>
</bpmn:definitions>
