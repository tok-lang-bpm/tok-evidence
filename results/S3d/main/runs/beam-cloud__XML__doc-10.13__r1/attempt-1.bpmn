<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="transmit-request" name="Transmit the transaction data request" />
    <bpmn:task id="check-request" name="Check the request" />
    <bpmn:exclusiveGateway id="decision" name="Outcome of examination?" />
    <bpmn:task id="transmit-data" name="Transmission of data" />
    <bpmn:task id="rejection" name="Rejection" />
    <bpmn:endEvent id="end-data" name="End" />
    <bpmn:endEvent id="end-rejection" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="transmit-request" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmit-request" targetRef="check-request" />
    <bpmn:sequenceFlow id="f3" sourceRef="check-request" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="Transmission of data" sourceRef="decision" targetRef="transmit-data" />
    <bpmn:sequenceFlow id="f5" name="Rejection" sourceRef="decision" targetRef="rejection" />
    <bpmn:sequenceFlow id="f6" sourceRef="transmit-data" targetRef="end-data" />
    <bpmn:sequenceFlow id="f7" sourceRef="rejection" targetRef="end-rejection" />
  </bpmn:process>
</bpmn:definitions>
