<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mpone" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="send" name="Send the dismissal" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Oppose or confirm?" />
    <bpmn:task id="oppose" name="Oppose the dismissal of MPON" />
    <bpmn:task id="confirm" name="Confirm the dismissal of the MPON" />
    <bpmn:endEvent id="end-opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="end-confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f2" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f3" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="oppose" sourceRef="decision" targetRef="oppose" />
    <bpmn:sequenceFlow id="f5" name="confirm" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="oppose" targetRef="end-opposed" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="end-confirmed" />
  </bpmn:process>
</bpmn:definitions>
