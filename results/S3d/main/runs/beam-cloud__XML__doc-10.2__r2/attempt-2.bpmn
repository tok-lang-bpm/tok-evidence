<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mp" name="MPON">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_report_meter_operation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_perform_equipment_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_go_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_go_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_go" name="GO">
        <bpmn:flowNodeRef>task_examine_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_application_confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_reject_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mpoo_registration_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mspo_registration_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_equipment_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_equipment_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_process_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mp_failure_deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mpoo_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mspo_failure_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_assign_mp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mpoo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_mspo_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_sp_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_timeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpoo" name="MPOO">
        <bpmn:flowNodeRef>task_perform_equipment_mpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mspo" name="MSPO" />
      <bpmn:lane id="lane_sp" name="SP" />
    </bpmn:laneSet>

    <bpmn:startEvent id="start_event" name="Start" />

    <bpmn:task id="task_report_meter_operation" name="Report the meter operation to the GO" />
    <bpmn:task id="task_examine_application" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="gateway_application_confirmed" name="Application confirmed?" />
    <bpmn:task id="task_reject_application" name="Reject the application of the MPON" />
    <bpmn:task id="task_confirm_application" name="Confirm the application of the MPON" />
    <bpmn:task id="task_inform_mpoo_registration_confirmation" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="task_inform_mspo_registration_confirmation" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="gateway_equipment_split" name="Perform equipment acquisition and changes" />
    <bpmn:task id="task_perform_equipment_mp" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="task_perform_equipment_mpoo" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:parallelGateway id="gateway_equipment_join" />
    <bpmn:exclusiveGateway id="gateway_process_outcome" name="Process outcome" default="flow_timeout" />
    <bpmn:task id="task_inform_go_failure" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="task_inform_go_success" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="task_inform_mp_failure_deadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:task id="task_confirm_failure_assignment" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="task_inform_mpoo_failure_assignment" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="task_inform_mspo_failure_assignment" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:task id="task_assign_mp" name="Assign the MPON" />
    <bpmn:task id="task_confirm_assignment" name="Confirm the assignment to the MPON" />
    <bpmn:task id="task_inform_mpoo_assignment" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="task_inform_mspo_assignment" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="task_inform_sp_assignment" name="Inform the SP about the assignment of the MPON" />

    <bpmn:endEvent id="end_rejected" name="Application rejected" />
    <bpmn:endEvent id="end_failure" name="Assignment failed" />
    <bpmn:endEvent id="end_success" name="Assignment completed" />
    <bpmn:endEvent id="end_timeout" name="No message by deadline" />

    <bpmn:sequenceFlow id="flow_start" sourceRef="start_event" targetRef="task_report_meter_operation" />
    <bpmn:sequenceFlow id="flow_report_examine" sourceRef="task_report_meter_operation" targetRef="task_examine_application" />
    <bpmn:sequenceFlow id="flow_examine_gateway" sourceRef="task_examine_application" targetRef="gateway_application_confirmed" />
    <bpmn:sequenceFlow id="flow_reject" name="reject" sourceRef="gateway_application_confirmed" targetRef="task_reject_application">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">applicationConfirmed == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reject_end" sourceRef="task_reject_application" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="flow_confirm" name="confirm" sourceRef="gateway_application_confirmed" targetRef="task_confirm_application">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">applicationConfirmed == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_confirm_inform_mpoo_reg" sourceRef="task_confirm_application" targetRef="task_inform_mpoo_registration_confirmation" />
    <bpmn:sequenceFlow id="flow_inform_mpoo_mspo_reg" sourceRef="task_inform_mpoo_registration_confirmation" targetRef="task_inform_mspo_registration_confirmation" />
    <bpmn:sequenceFlow id="flow_reg_equipment_split" sourceRef="task_inform_mspo_registration_confirmation" targetRef="gateway_equipment_split" />
    <bpmn:sequenceFlow id="flow_equipment_mp" sourceRef="gateway_equipment_split" targetRef="task_perform_equipment_mp" />
    <bpmn:sequenceFlow id="flow_equipment_mpoo" sourceRef="gateway_equipment_split" targetRef="task_perform_equipment_mpoo" />
    <bpmn:sequenceFlow id="flow_equipment_mp_join" sourceRef="task_perform_equipment_mp" targetRef="gateway_equipment_join" />
    <bpmn:sequenceFlow id="flow_equipment_mpoo_join" sourceRef="task_perform_equipment_mpoo" targetRef="gateway_equipment_join" />
    <bpmn:sequenceFlow id="flow_equipment_outcome" sourceRef="gateway_equipment_join" targetRef="gateway_process_outcome" />
    <bpmn:sequenceFlow id="flow_failure" name="failure" sourceRef="gateway_process_outcome" targetRef="task_inform_go_failure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">processResult == 'failure'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_failure_confirm" sourceRef="task_inform_go_failure" targetRef="task_confirm_failure_assignment" />
    <bpmn:sequenceFlow id="flow_failure_mpoo" sourceRef="task_confirm_failure_assignment" targetRef="task_inform_mpoo_failure_assignment" />
    <bpmn:sequenceFlow id="flow_failure_mspo" sourceRef="task_inform_mpoo_failure_assignment" targetRef="task_inform_mspo_failure_assignment" />
    <bpmn:sequenceFlow id="flow_failure_end" sourceRef="task_inform_mspo_failure_assignment" targetRef="end_failure" />
    <bpmn:sequenceFlow id="flow_success" name="success" sourceRef="gateway_process_outcome" targetRef="task_inform_go_success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">processResult == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_success_assign" sourceRef="task_inform_go_success" targetRef="task_assign_mp" />
    <bpmn:sequenceFlow id="flow_assign_confirm" sourceRef="task_assign_mp" targetRef="task_confirm_assignment" />
    <bpmn:sequenceFlow id="flow_success_mpoo" sourceRef="task_confirm_assignment" targetRef="task_inform_mpoo_assignment" />
    <bpmn:sequenceFlow id="flow_success_mspo" sourceRef="task_inform_mpoo_assignment" targetRef="task_inform_mspo_assignment" />
    <bpmn:sequenceFlow id="flow_success_sp" sourceRef="task_inform_mspo_assignment" targetRef="task_inform_sp_assignment" />
    <bpmn:sequenceFlow id="flow_success_end" sourceRef="task_inform_sp_assignment" targetRef="end_success" />
    <bpmn:sequenceFlow id="flow_timeout" name="no message by deadline" sourceRef="gateway_process_outcome" targetRef="task_inform_mp_failure_deadline" />
    <bpmn:sequenceFlow id="flow_timeout_end" sourceRef="task_inform_mp_failure_deadline" targetRef="end_timeout" />
  </bpmn:process>
</bpmn:definitions>
