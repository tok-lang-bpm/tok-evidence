<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obligation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obligationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" />

    <bpmn:task id="deregister" name="Deregisters at the GO" />
    <bpmn:task id="verify" name="Verifies the deregistration" />
    <bpmn:exclusiveGateway id="decision" name="Deregistration outcome" />
    <bpmn:task id="reject" name="Rejects the deregistration of the MPOO" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:task id="prelim" name="Preliminarily confirms the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepares the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="obligation" name="Oblige MPOO?" default="skipObligation" />
    <bpmn:task id="oblige" name="Obliges the MPOO to continue the operations" />
    <bpmn:task id="confirm" name="Confirmes the continuation to the MPOO" />
    <bpmn:exclusiveGateway id="obligationJoin" name="Obligation handled" />
    <bpmn:inclusiveGateway id="equipmentSplit" name="Equipment work" />
    <bpmn:task id="acquisition" name="Performs the equipment acquisition" />
    <bpmn:task id="changes" name="Performs the equipment changes" />
    <bpmn:inclusiveGateway id="equipmentJoin" name="Equipment work completed" />
    <bpmn:task id="assign" name="Assigns the GO as MPO" />
    <bpmn:task id="informMPOO" name="Informs the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="informMSPO" name="Informs the MSPO about the assignment of the GO" />
    <bpmn:task id="informSP" name="Informs the SP about the assignment of the GO" />
    <bpmn:endEvent id="completed" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="deregister" />
    <bpmn:sequenceFlow id="f2" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f3" sourceRef="verify" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="rejected" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="confirmed" sourceRef="decision" targetRef="prelim" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f8" name="obliges" sourceRef="obligation" targetRef="oblige" />
    <bpmn:sequenceFlow id="f9" sourceRef="oblige" targetRef="confirm" />
    <bpmn:sequenceFlow id="f10" sourceRef="confirm" targetRef="obligationJoin" />
    <bpmn:sequenceFlow id="skipObligation" sourceRef="obligation" targetRef="obligationJoin" />
    <bpmn:sequenceFlow id="f11" sourceRef="obligationJoin" targetRef="equipmentSplit" />
    <bpmn:sequenceFlow id="f12" sourceRef="equipmentSplit" targetRef="acquisition" />
    <bpmn:sequenceFlow id="f13" sourceRef="equipmentSplit" targetRef="changes" />
    <bpmn:sequenceFlow id="f14" sourceRef="acquisition" targetRef="equipmentJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="changes" targetRef="equipmentJoin" />
    <bpmn:sequenceFlow id="f16" sourceRef="equipmentJoin" targetRef="assign" />
    <bpmn:sequenceFlow id="f17" sourceRef="assign" targetRef="informMPOO" />
    <bpmn:sequenceFlow id="f18" sourceRef="informMPOO" targetRef="informMSPO" />
    <bpmn:sequenceFlow id="f19" sourceRef="informMSPO" targetRef="informSP" />
    <bpmn:sequenceFlow id="f20" sourceRef="informSP" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
