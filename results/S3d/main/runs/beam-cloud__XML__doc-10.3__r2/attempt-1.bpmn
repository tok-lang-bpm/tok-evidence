<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="mpoo-lane" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-continuation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go-lane" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verification-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preliminary-confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-readmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>optional-continuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige-continuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continuation-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Deregistration started" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="verification-result" name="Deregistration result" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="rejected-end" name="Deregistration rejected" />
    <bpmn:task id="preliminary-confirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare-readmission" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="optional-continuation" name="Oblige continuation?" default="skip-continuation" />
    <bpmn:task id="oblige-continuation" name="Oblige the MPOO to continue the operations" />
    <bpmn:task id="confirm-continuation" name="Confirm the continuation to the MPOO" />
    <bpmn:exclusiveGateway id="continuation-merge" />
    <bpmn:task id="equipment" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign-mpo" name="Assign the GO as MPO" />
    <bpmn:task id="inform-mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform-mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform-sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="completed-end" name="Assignment completed" />

    <bpmn:sequenceFlow id="f-start" sourceRef="start" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-result" sourceRef="verify" targetRef="verification-result" />
    <bpmn:sequenceFlow id="f-reject" sourceRef="verification-result" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-end" sourceRef="reject" targetRef="rejected-end" />
    <bpmn:sequenceFlow id="f-preliminary" sourceRef="verification-result" targetRef="preliminary-confirm" />
    <bpmn:sequenceFlow id="f-readmission" sourceRef="preliminary-confirm" targetRef="prepare-readmission" />
    <bpmn:sequenceFlow id="f-optional" sourceRef="prepare-readmission" targetRef="optional-continuation" />
    <bpmn:sequenceFlow id="f-oblige" name="yes" sourceRef="optional-continuation" targetRef="oblige-continuation" />
    <bpmn:sequenceFlow id="f-confirm" sourceRef="oblige-continuation" targetRef="confirm-continuation" />
    <bpmn:sequenceFlow id="f-confirm-merge" sourceRef="confirm-continuation" targetRef="continuation-merge" />
    <bpmn:sequenceFlow id="skip-continuation" sourceRef="optional-continuation" targetRef="continuation-merge" />
    <bpmn:sequenceFlow id="f-equipment" sourceRef="continuation-merge" targetRef="equipment" />
    <bpmn:sequenceFlow id="f-assign" sourceRef="equipment" targetRef="assign-mpo" />
    <bpmn:sequenceFlow id="f-inform-mpoo" sourceRef="assign-mpo" targetRef="inform-mpoo" />
    <bpmn:sequenceFlow id="f-inform-mspo" sourceRef="inform-mpoo" targetRef="inform-mspo" />
    <bpmn:sequenceFlow id="f-inform-sp" sourceRef="inform-mspo" targetRef="inform-sp" />
    <bpmn:sequenceFlow id="f-completed" sourceRef="inform-sp" targetRef="completed-end" />
  </bpmn:process>
</bpmn:definitions>
