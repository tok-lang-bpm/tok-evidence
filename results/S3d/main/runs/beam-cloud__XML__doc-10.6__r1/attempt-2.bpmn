<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send-dismissal" name="Send a dismissal" />
    <bpmn:task id="review-dismissal" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal rejected or confirmed?" default="f5" />
    <bpmn:task id="reject-dismissal" name="Reject the dismissal of the MSPN" />
    <bpmn:task id="confirm-dismissal" name="Confirm the dismissal of the MSPN" />
    <bpmn:endEvent id="end-rejected" name="Dismissal rejected" />
    <bpmn:endEvent id="end-confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send-dismissal" />
    <bpmn:sequenceFlow id="f2" sourceRef="send-dismissal" targetRef="review-dismissal" />
    <bpmn:sequenceFlow id="f3" sourceRef="review-dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="Rejects" sourceRef="decision" targetRef="reject-dismissal" />
    <bpmn:sequenceFlow id="f5" name="Confirms" sourceRef="decision" targetRef="confirm-dismissal" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject-dismissal" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm-dismissal" targetRef="end-confirmed" />
  </bpmn:process>
</bpmn:definitions>
