<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="sp-pu-go" name="SP / PU / GO">
        <bpmn:flowNodeRef>requestChanges</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>causeChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decisionSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNotified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="initiationSplit" name="Who initiates the change?" />
    <bpmn:task id="requestChanges" name="Request changes to the MPO" />
    <bpmn:task id="causeChange" name="Cause a change" />
    <bpmn:exclusiveGateway id="initiationJoin" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="decisionSplit" name="Change decision" />
    <bpmn:task id="reject" name="Reject the change of the measuring point by the SP / PU / GO" />
    <bpmn:task id="confirm" name="Confirm the request of the SP / PU / GO" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="outcomeSplit" name="Change outcome" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notify" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="endRejected" name="Change rejected" />
    <bpmn:endEvent id="endReported" name="Change reported" />
    <bpmn:endEvent id="endNotified" name="Failure notified" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="initiationSplit" />
    <bpmn:sequenceFlow id="f2" name="SP / PU / GO request changes" sourceRef="initiationSplit" targetRef="requestChanges" />
    <bpmn:sequenceFlow id="f3" name="MPO causes a change" sourceRef="initiationSplit" targetRef="causeChange" />
    <bpmn:sequenceFlow id="f4" sourceRef="requestChanges" targetRef="initiationJoin" />
    <bpmn:sequenceFlow id="f5" sourceRef="causeChange" targetRef="initiationJoin" />
    <bpmn:sequenceFlow id="f6" sourceRef="initiationJoin" targetRef="review" />
    <bpmn:sequenceFlow id="f7" sourceRef="review" targetRef="decisionSplit" />
    <bpmn:sequenceFlow id="f8" name="rejects" sourceRef="decisionSplit" targetRef="reject" />
    <bpmn:sequenceFlow id="f9" name="confirms" sourceRef="decisionSplit" targetRef="confirm" />
    <bpmn:sequenceFlow id="f10" sourceRef="reject" targetRef="endRejected" />
    <bpmn:sequenceFlow id="f11" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f12" sourceRef="perform" targetRef="outcomeSplit" />
    <bpmn:sequenceFlow id="f13" name="reports implementation" sourceRef="outcomeSplit" targetRef="report" />
    <bpmn:sequenceFlow id="f14" name="notifies failure" sourceRef="outcomeSplit" targetRef="notify" />
    <bpmn:sequenceFlow id="f15" sourceRef="report" targetRef="endReported" />
    <bpmn:sequenceFlow id="f16" sourceRef="notify" targetRef="endNotified" />
  </bpmn:process>
</bpmn:definitions>
