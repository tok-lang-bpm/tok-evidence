<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>se_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_cust_send_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ee_cust_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer_service" name="Customer Service">
        <bpmn:flowNodeRef>cs_enter_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_compare_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_determine_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_create_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_outcome_xor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_create_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_report_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ee_cs_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="electronic_service" name="Electronic Service">
        <bpmn:flowNodeRef>es_determine_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_es_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_link_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ee_es_extra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service_management" name="Service Management">
        <bpmn:flowNodeRef>sm_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sm_analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_dpro_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_sm_merge_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_prepare_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sm_paths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_actual_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_rest_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_rest_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="resource_provisioning" name="Resource Provisioning">
        <bpmn:flowNodeRef>rp_check_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rp_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_create_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_create_normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_rp_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_send_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_pg_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_wait_restoration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_rp_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_track_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_create_troubleshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_send_troubleshoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ee_rp_terminate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing_collections" name="Billing and Collections">
        <bpmn:flowNodeRef>billing_adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="se_start" name="Service degraded perceived" />
    <bpmn:task id="task_cust_send_params" name="Send problem parameter list" />
    <bpmn:endEvent id="ee_cust_end" name="Report received" />

    <bpmn:task id="cs_enter_report" name="Enter problem report into system T" />
    <bpmn:task id="cs_compare_sla" name="Compare problem report to customer SLA" />
    <bpmn:task id="cs_determine_measures" name="Determine counter measures and priorities" />
    <bpmn:task id="cs_create_detailed" name="Create detailed problem report" />
    <bpmn:task id="cs_send_detailed" name="Send detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="cs_outcome_xor" name="Outcome received" />
    <bpmn:parallelGateway id="cs_split" />
    <bpmn:task id="cs_create_report" name="Create report for customer" />
    <bpmn:task id="cs_send_report" name="Send report to customer" />
    <bpmn:parallelGateway id="cs_send_split" />
    <bpmn:task id="cs_report_billing" name="Report SLA violation rebate to Billing and Collections" />
    <bpmn:parallelGateway id="cs_join" />
    <bpmn:endEvent id="ee_cs_end" name="Customer Service process ends" />

    <bpmn:task id="es_determine_significance" name="Determine significance of customer" />
    <bpmn:exclusiveGateway id="gw_es_significance" name="Customer significance" default="f09" />
    <bpmn:task id="es_link_extra" name="Link to extra problem fix process" />
    <bpmn:endEvent id="ee_es_extra" name="Extra problem fix process linked" />

    <bpmn:task id="sm_investigate" name="Investigate problem analyzability" />
    <bpmn:exclusiveGateway id="gw_sm_analyzable" name="Problem analyzable by Service Management" default="f14" />
    <bpmn:task id="sm_send_dpro_rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="sm_analyze" name="Analyze problem" />
    <bpmn:task id="sm_create_trouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="xor_sm_merge_final" name="Merge" />
    <bpmn:task id="sm_prepare_final" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="gw_sm_paths" name="Counter measures" default="f31" />
    <bpmn:task id="sm_send_actual_perf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="sm_corrective" name="Undertake corrective actions" />
    <bpmn:task id="sm_create_resolution" name="Create problem resolution report" />
    <bpmn:task id="sm_send_resolution" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="sm_create_rest_request" name="Create request for automatic resource restoration" />
    <bpmn:task id="sm_send_rest_request" name="Send restoration request to Resource Provisioning" />

    <bpmn:task id="rp_check_problems" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="gw_rp_problems" name="Problem detected" default="f21" />
    <bpmn:task id="rp_analyze" name="Analyze problem" />
    <bpmn:task id="rp_create_trouble" name="Create trouble report" />
    <bpmn:task id="rp_create_normal" name="Create normal service execution notification" />
    <bpmn:exclusiveGateway id="xor_rp_merge" name="Merge" />
    <bpmn:task id="rp_send_status" name="Send status report to Service Management" />
    <bpmn:parallelGateway id="rp_pg_status" />
    <bpmn:receiveTask id="rp_wait_restoration" name="Wait for restoration request" />
    <bpmn:boundaryEvent id="be_rp_timer" attachedToRef="rp_wait_restoration" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="rp_track_errors" name="Track all possible errors" />
    <bpmn:task id="rp_corrective" name="Undertake all necessary corrective actions" />
    <bpmn:task id="rp_create_troubleshoot" name="Create trouble-shooting report" />
    <bpmn:task id="rp_send_troubleshoot" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="ee_rp_terminate" name="Resource Provisioning terminated">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>

    <bpmn:task id="billing_adjust" name="Adjust billing" />

    <bpmn:sequenceFlow id="f01" sourceRef="se_start" targetRef="task_cust_send_params" />
    <bpmn:sequenceFlow id="f02" sourceRef="task_cust_send_params" targetRef="cs_enter_report" />
    <bpmn:sequenceFlow id="f03" sourceRef="cs_enter_report" targetRef="cs_compare_sla" />
    <bpmn:sequenceFlow id="f04" sourceRef="cs_compare_sla" targetRef="cs_determine_measures" />
    <bpmn:sequenceFlow id="f05" sourceRef="cs_determine_measures" targetRef="es_determine_significance" />
    <bpmn:sequenceFlow id="f06" sourceRef="es_determine_significance" targetRef="gw_es_significance" />
    <bpmn:sequenceFlow id="f07" name="premium" sourceRef="gw_es_significance" targetRef="es_link_extra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">premium</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f08" name="certain significance" sourceRef="gw_es_significance" targetRef="cs_determine_measures">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">certain significance affects counter measures</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f09" name="otherwise" sourceRef="gw_es_significance" targetRef="cs_create_detailed" />
    <bpmn:sequenceFlow id="f10" sourceRef="es_link_extra" targetRef="ee_es_extra" />

    <bpmn:sequenceFlow id="f11" sourceRef="cs_create_detailed" targetRef="cs_send_detailed" />
    <bpmn:sequenceFlow id="f12" sourceRef="cs_send_detailed" targetRef="sm_investigate" />

    <bpmn:sequenceFlow id="f13" sourceRef="sm_investigate" targetRef="gw_sm_analyzable" />
    <bpmn:sequenceFlow id="f14" name="not analyzable" sourceRef="gw_sm_analyzable" targetRef="sm_send_dpro_rp" />
    <bpmn:sequenceFlow id="f15" name="analyzable" sourceRef="gw_sm_analyzable" targetRef="sm_analyze">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">analyzable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16" sourceRef="sm_analyze" targetRef="sm_create_trouble" />
    <bpmn:sequenceFlow id="f17" sourceRef="sm_create_trouble" targetRef="xor_sm_merge_final" />
    <bpmn:sequenceFlow id="f18" sourceRef="sm_send_dpro_rp" targetRef="rp_check_problems" />

    <bpmn:sequenceFlow id="f19" sourceRef="rp_check_problems" targetRef="gw_rp_problems" />
    <bpmn:sequenceFlow id="f20" name="no problems" sourceRef="gw_rp_problems" targetRef="rp_create_normal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">no problems</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f21" name="problem detected" sourceRef="gw_rp_problems" targetRef="rp_analyze" />
    <bpmn:sequenceFlow id="f22" sourceRef="rp_analyze" targetRef="rp_create_trouble" />
    <bpmn:sequenceFlow id="f23" sourceRef="rp_create_trouble" targetRef="xor_rp_merge" />
    <bpmn:sequenceFlow id="f24" sourceRef="rp_create_normal" targetRef="xor_rp_merge" />
    <bpmn:sequenceFlow id="f25" sourceRef="xor_rp_merge" targetRef="rp_send_status" />
    <bpmn:sequenceFlow id="f26" sourceRef="rp_send_status" targetRef="rp_pg_status" />
    <bpmn:sequenceFlow id="f27" sourceRef="rp_pg_status" targetRef="xor_sm_merge_final" />
    <bpmn:sequenceFlow id="f28" sourceRef="rp_pg_status" targetRef="rp_wait_restoration" />

    <bpmn:sequenceFlow id="f29" sourceRef="xor_sm_merge_final" targetRef="sm_prepare_final" />
    <bpmn:sequenceFlow id="f30" sourceRef="sm_prepare_final" targetRef="gw_sm_paths" />
    <bpmn:sequenceFlow id="f31" name="no problem" sourceRef="gw_sm_paths" targetRef="sm_send_actual_perf" />
    <bpmn:sequenceFlow id="f32" name="minor corrective actions" sourceRef="gw_sm_paths" targetRef="sm_corrective">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">minor corrective actions required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f33" name="automatic resource restoration" sourceRef="gw_sm_paths" targetRef="sm_create_rest_request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">automatic resource restoration required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="f34" sourceRef="sm_send_actual_perf" targetRef="cs_outcome_xor" />
    <bpmn:sequenceFlow id="f35" sourceRef="sm_corrective" targetRef="sm_create_resolution" />
    <bpmn:sequenceFlow id="f36" sourceRef="sm_create_resolution" targetRef="sm_send_resolution" />
    <bpmn:sequenceFlow id="f37" sourceRef="sm_send_resolution" targetRef="cs_outcome_xor" />

    <bpmn:sequenceFlow id="f38" sourceRef="sm_create_rest_request" targetRef="sm_send_rest_request" />
    <bpmn:sequenceFlow id="f39" sourceRef="sm_send_rest_request" targetRef="rp_wait_restoration" />

    <bpmn:sequenceFlow id="f40" sourceRef="rp_wait_restoration" targetRef="rp_track_errors" />
    <bpmn:sequenceFlow id="f41" sourceRef="rp_track_errors" targetRef="rp_corrective" />
    <bpmn:sequenceFlow id="f42" sourceRef="rp_corrective" targetRef="rp_create_troubleshoot" />
    <bpmn:sequenceFlow id="f43" sourceRef="rp_create_troubleshoot" targetRef="rp_send_troubleshoot" />
    <bpmn:sequenceFlow id="f44" sourceRef="rp_send_troubleshoot" targetRef="sm_create_resolution" />

    <bpmn:sequenceFlow id="f45" sourceRef="cs_outcome_xor" targetRef="cs_split" />
    <bpmn:sequenceFlow id="f46" sourceRef="cs_split" targetRef="cs_create_report" />
    <bpmn:sequenceFlow id="f47" sourceRef="cs_split" targetRef="cs_report_billing" />
    <bpmn:sequenceFlow id="f48" sourceRef="cs_create_report" targetRef="cs_send_report" />
    <bpmn:sequenceFlow id="f49" sourceRef="cs_send_report" targetRef="cs_send_split" />
    <bpmn:sequenceFlow id="f50" sourceRef="cs_send_split" targetRef="ee_cust_end" />
    <bpmn:sequenceFlow id="f51" sourceRef="cs_send_split" targetRef="cs_join" />
    <bpmn:sequenceFlow id="f52" sourceRef="cs_report_billing" targetRef="billing_adjust" />
    <bpmn:sequenceFlow id="f53" sourceRef="billing_adjust" targetRef="cs_join" />
    <bpmn:sequenceFlow id="f54" sourceRef="cs_join" targetRef="ee_cs_end" />

    <bpmn:sequenceFlow id="f55" sourceRef="be_rp_timer" targetRef="ee_rp_terminate" />
  </bpmn:process>
</bpmn:definitions>
