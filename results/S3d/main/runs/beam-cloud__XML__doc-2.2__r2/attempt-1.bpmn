<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer-lane" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveFinalBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customerEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer-service-lane" name="Customer Service">
        <bpmn:flowNodeRef>receiveData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compareData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>errorsGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>existsGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeObj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzeIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regenerateDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCisContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decisionGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawIce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmIce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timerIce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continueGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>importMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis-lane" name="CIS">
        <bpmn:flowNodeRef>cisCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cisResultGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cisRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid-operator-lane" name="Grid Operator">
        <bpmn:flowNodeRef>goCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrenceGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSuppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>demandResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>communicateOld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminateAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflictEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>computeBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBillingOld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old-supplier-lane" name="Old Supplier">
        <bpmn:flowNodeRef>createSendFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>osSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>osEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Switch-over request" />
    <bpmn:task id="transmitData" name="Transmit customer data" />
    <bpmn:task id="receiveData" name="Receive customer data" />
    <bpmn:task id="enterData" name="Enter customer data into CRM system" />
    <bpmn:task id="compareData" name="Compare customer data with internal customer database" />
    <bpmn:task id="checkComplete" name="Check completeness and plausibility" />
    <bpmn:exclusiveGateway id="errorsGw" name="Errors found?" default="f09" />
    <bpmn:task id="correctErrors" name="Correct errors based on simple error list" />
    <bpmn:exclusiveGateway id="existsGw" name="Customer exists in database?" default="f11" />
    <bpmn:task id="createCustomer" name="Create new customer object" />
    <bpmn:exclusiveGateway id="mergeObj" name="Customer object ready?" />
    <bpmn:task id="prepareDocs" name="Prepare contract documents for power supplier switch" />
    <bpmn:task id="cisCheck" name="Check contract documents in CIS" />
    <bpmn:exclusiveGateway id="cisResultGw" name="Contract documents generated successfully?" default="f19" />
    <bpmn:task id="analyzeIssues" name="Analyze and resolve issues" />
    <bpmn:task id="regenerateDocs" name="Generate contract documents again" />
    <bpmn:task id="confirmDoc" name="Send confirmation document to the customer" />
    <bpmn:task id="cisRequest" name="Send request to grid operator" />
    <bpmn:task id="goCheck" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="goResponse" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="concurrenceGw" name="Supplier concurrence?" default="f29" />
    <bpmn:task id="informSuppliers" name="Inform all involved suppliers" />
    <bpmn:task id="demandResolution" name="Demand resolution of the conflict" />
    <bpmn:task id="communicateOld" name="Communicate with the old supplier" />
    <bpmn:task id="terminateAgreement" name="Carry out termination of the sales agreement" />
    <bpmn:endEvent id="conflictEnd" name="Process ends after supplier concurrence" />
    <bpmn:task id="createCisContract" name="Create a CIS contract" />
    <bpmn:task id="checkDetails" name="Check contract details" />
    <bpmn:eventBasedGateway id="decisionGw" name="Customer decision?" />
    <bpmn:intermediateCatchEvent id="withdrawIce" name="Receive withdrawal from customer">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="confirmIce" name="Receive confirmation from customer">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timerIce" name="7 days elapsed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="continueGw" name="Contract accepted" />
    <bpmn:endEvent id="withdrawEnd" name="Switch-over withdrawn" />
    <bpmn:task id="transmitMeter" name="Transmit power meter data" />
    <bpmn:parallelGateway id="finalSplit" name="Start final billing processes" />
    <bpmn:task id="importMeter" name="Import meter data to systems" />
    <bpmn:endEvent id="csEnd" name="New customer won" />
    <bpmn:task id="computeBilling" name="Compute final billing" />
    <bpmn:task id="sendBillingOld" name="Send final billing to the old supplier" />
    <bpmn:endEvent id="goEnd" name="Grid operator process ends" />
    <bpmn:task id="createSendFinal" name="Create and send final billing to the customer" />
    <bpmn:parallelGateway id="osSplit" name="Old supplier finalization split" />
    <bpmn:endEvent id="osEnd" name="Old supplier process ends" />
    <bpmn:task id="receiveFinalBilling" name="Receive final billing from the old supplier" />
    <bpmn:endEvent id="customerEnd" name="Customer process ends" />

    <bpmn:sequenceFlow id="f01" sourceRef="start" targetRef="transmitData" />
    <bpmn:sequenceFlow id="f02" sourceRef="transmitData" targetRef="receiveData" />
    <bpmn:sequenceFlow id="f03" sourceRef="receiveData" targetRef="enterData" />
    <bpmn:sequenceFlow id="f04" sourceRef="enterData" targetRef="compareData" />
    <bpmn:sequenceFlow id="f05" sourceRef="compareData" targetRef="checkComplete" />
    <bpmn:sequenceFlow id="f06" sourceRef="checkComplete" targetRef="errorsGw" />
    <bpmn:sequenceFlow id="f07" name="yes" sourceRef="errorsGw" targetRef="correctErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">errorsFound == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f08" sourceRef="correctErrors" targetRef="existsGw" />
    <bpmn:sequenceFlow id="f09" name="no" sourceRef="errorsGw" targetRef="existsGw" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="existsGw" targetRef="createCustomer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerExists == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="existsGw" targetRef="mergeObj" />
    <bpmn:sequenceFlow id="f12" sourceRef="createCustomer" targetRef="mergeObj" />
    <bpmn:sequenceFlow id="f13" sourceRef="mergeObj" targetRef="prepareDocs" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepareDocs" targetRef="cisCheck" />
    <bpmn:sequenceFlow id="f15" sourceRef="cisCheck" targetRef="cisResultGw" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="cisResultGw" targetRef="analyzeIssues">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsGenerated == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f17" sourceRef="analyzeIssues" targetRef="regenerateDocs" />
    <bpmn:sequenceFlow id="f18" sourceRef="regenerateDocs" targetRef="cisCheck" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="cisResultGw" targetRef="confirmDoc" />
    <bpmn:sequenceFlow id="f20" sourceRef="confirmDoc" targetRef="cisRequest" />
    <bpmn:sequenceFlow id="f21" sourceRef="cisRequest" targetRef="goCheck" />
    <bpmn:sequenceFlow id="f22" sourceRef="goCheck" targetRef="goResponse" />
    <bpmn:sequenceFlow id="f23" sourceRef="goResponse" targetRef="concurrenceGw" />
    <bpmn:sequenceFlow id="f24" name="supplier concurrence" sourceRef="concurrenceGw" targetRef="informSuppliers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supplierConcurrence == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f25" sourceRef="informSuppliers" targetRef="demandResolution" />
    <bpmn:sequenceFlow id="f26" sourceRef="demandResolution" targetRef="communicateOld" />
    <bpmn:sequenceFlow id="f27" sourceRef="communicateOld" targetRef="terminateAgreement" />
    <bpmn:sequenceFlow id="f28" sourceRef="terminateAgreement" targetRef="conflictEnd" />
    <bpmn:sequenceFlow id="f29" name="no supplier concurrence" sourceRef="concurrenceGw" targetRef="createCisContract" />
    <bpmn:sequenceFlow id="f30" sourceRef="createCisContract" targetRef="checkDetails" />
    <bpmn:sequenceFlow id="f31" sourceRef="checkDetails" targetRef="decisionGw" />
    <bpmn:sequenceFlow id="f32" sourceRef="decisionGw" targetRef="withdrawIce" />
    <bpmn:sequenceFlow id="f33" sourceRef="decisionGw" targetRef="confirmIce" />
    <bpmn:sequenceFlow id="f34" sourceRef="decisionGw" targetRef="timerIce" />
    <bpmn:sequenceFlow id="f35" sourceRef="withdrawIce" targetRef="withdrawEnd" />
    <bpmn:sequenceFlow id="f36" sourceRef="confirmIce" targetRef="continueGw" />
    <bpmn:sequenceFlow id="f37" sourceRef="timerIce" targetRef="continueGw" />
    <bpmn:sequenceFlow id="f38" sourceRef="continueGw" targetRef="transmitMeter" />
    <bpmn:sequenceFlow id="f39" sourceRef="transmitMeter" targetRef="finalSplit" />
    <bpmn:sequenceFlow id="f40" sourceRef="finalSplit" targetRef="importMeter" />
    <bpmn:sequenceFlow id="f41" sourceRef="finalSplit" targetRef="computeBilling" />
    <bpmn:sequenceFlow id="f42" sourceRef="finalSplit" targetRef="createSendFinal" />
    <bpmn:sequenceFlow id="f43" sourceRef="importMeter" targetRef="csEnd" />
    <bpmn:sequenceFlow id="f44" sourceRef="computeBilling" targetRef="sendBillingOld" />
    <bpmn:sequenceFlow id="f45" sourceRef="sendBillingOld" targetRef="goEnd" />
    <bpmn:sequenceFlow id="f46" sourceRef="createSendFinal" targetRef="osSplit" />
    <bpmn:sequenceFlow id="f47" sourceRef="osSplit" targetRef="osEnd" />
    <bpmn:sequenceFlow id="f48" sourceRef="osSplit" targetRef="receiveFinalBilling" />
    <bpmn:sequenceFlow id="f49" sourceRef="receiveFinalBilling" targetRef="customerEnd" />
  </bpmn:process>
</bpmn:definitions>
