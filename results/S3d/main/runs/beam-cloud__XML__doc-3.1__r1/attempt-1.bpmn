<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg_request" name="Warrant possession request" />
  <bpmn:message id="msg_warrant" name="SCT Warrant Possession" />
  <bpmn:message id="msg_report" name="Report" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="party" name="Party" />
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
    <bpmn:participant id="police" name="Queensland Police" />
    <bpmn:messageFlow id="mf_request" sourceRef="party" targetRef="receive_request" messageRef="msg_request" />
    <bpmn:messageFlow id="mf_warrant" sourceRef="forward_warrant" targetRef="police" messageRef="msg_warrant" />
    <bpmn:messageFlow id="mf_report" sourceRef="police" targetRef="report_received" messageRef="msg_report" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="back-office-lane" name="Client Service Back Office">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_sct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_warrant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_physical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_respective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_expanded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Warrant possession request" />
    <bpmn:task id="receive_request" name="Receive the request" />
    <bpmn:task id="retrieve_sct" name="Retrieve the SCT file" />
    <bpmn:task id="forward_warrant" name="Forward the SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store_physical" name="Store the SCT physical file" />
    <bpmn:intermediateCatchEvent id="report_received" name="Report received">
      <bpmn:messageEventDefinition messageRef="msg_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="retrieve_respective" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach_document" name="Attach the new SCT document" />
    <bpmn:task id="store_expanded" name="Store the expanded SCT physical file" />
    <bpmn:endEvent id="end" name="Expanded SCT physical file stored" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive_request" targetRef="retrieve_sct" />
    <bpmn:sequenceFlow id="f3" sourceRef="retrieve_sct" targetRef="forward_warrant" />
    <bpmn:sequenceFlow id="f4" sourceRef="forward_warrant" targetRef="store_physical" />
    <bpmn:sequenceFlow id="f5" sourceRef="store_physical" targetRef="report_received" />
    <bpmn:sequenceFlow id="f6" sourceRef="report_received" targetRef="retrieve_respective" />
    <bpmn:sequenceFlow id="f7" sourceRef="retrieve_respective" targetRef="attach_document" />
    <bpmn:sequenceFlow id="f8" sourceRef="attach_document" targetRef="store_expanded" />
    <bpmn:sequenceFlow id="f9" sourceRef="store_expanded" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
