<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Small Claims Registry Operations" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="client-service-back-office" name="Client Service Back Office">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-sct-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward-warrant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-physical-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve-respective-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach-document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-expanded-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Warrant possession request sent" />
    <bpmn:task id="receive-request" name="Receive warrant possession request" />
    <bpmn:task id="retrieve-sct-file" name="Retrieve SCT file" />
    <bpmn:task id="forward-warrant" name="Forward SCT Warrant Possession" />
    <bpmn:task id="store-physical-file" name="Store SCT physical file" />
    <bpmn:task id="receive-report" name="Receive report" />
    <bpmn:task id="retrieve-respective-file" name="Retrieve respective SCT file" />
    <bpmn:task id="attach-document" name="Attach new SCT document" />
    <bpmn:task id="store-expanded-file" name="Store expanded SCT physical file" />
    <bpmn:endEvent id="end" name="Expanded SCT physical file stored" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive-request" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive-request" targetRef="retrieve-sct-file" />
    <bpmn:sequenceFlow id="f3" sourceRef="retrieve-sct-file" targetRef="forward-warrant" />
    <bpmn:sequenceFlow id="f4" sourceRef="forward-warrant" targetRef="store-physical-file" />
    <bpmn:sequenceFlow id="f5" sourceRef="store-physical-file" targetRef="receive-report" />
    <bpmn:sequenceFlow id="f6" sourceRef="receive-report" targetRef="retrieve-respective-file" />
    <bpmn:sequenceFlow id="f7" sourceRef="retrieve-respective-file" targetRef="attach-document" />
    <bpmn:sequenceFlow id="f8" sourceRef="attach-document" targetRef="store-expanded-file" />
    <bpmn:sequenceFlow id="f9" sourceRef="store-expanded-file" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
