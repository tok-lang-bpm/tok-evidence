<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="clerk" name="Clerk">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>files-missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiate-search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>files-ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="associate" name="Associate">
        <bpmn:flowNodeRef>distribute-lawlist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>conduct-hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hearings-conducted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Each morning" />

    <bpmn:task id="check-files" name="Check the files" />
    <bpmn:exclusiveGateway id="files-missing" name="Some files missing?" default="to-track" />
    <bpmn:task id="initiate-search" name="Initiate a search" />
    <bpmn:task id="track-files" name="Track the files to the intended location" />
    <bpmn:exclusiveGateway id="files-ready" name="Files ready" />
    <bpmn:parallelGateway id="ready-split" />
    <bpmn:task id="hand-files" name="Hand the files to the Associate" />
    <bpmn:task id="distribute-lawlist" name="Distribute the Judge's Lawlist" />
    <bpmn:parallelGateway id="ready-join" />
    <bpmn:task id="conduct-hearings" name="Conduct the directions hearings" />
    <bpmn:endEvent id="hearings-conducted" name="Directions hearings conducted" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check-files" />
    <bpmn:sequenceFlow id="f2" sourceRef="check-files" targetRef="files-missing" />
    <bpmn:sequenceFlow id="f-missing" name="yes" sourceRef="files-missing" targetRef="initiate-search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">filesMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="to-track" name="no" sourceRef="files-missing" targetRef="track-files" />
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="initiate-search" targetRef="files-ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track-files" targetRef="files-ready" />
    <bpmn:sequenceFlow id="f-ready" sourceRef="files-ready" targetRef="ready-split" />
    <bpmn:sequenceFlow id="f-hand" sourceRef="ready-split" targetRef="hand-files" />
    <bpmn:sequenceFlow id="f-distribute" sourceRef="ready-split" targetRef="distribute-lawlist" />
    <bpmn:sequenceFlow id="f-hand-join" sourceRef="hand-files" targetRef="ready-join" />
    <bpmn:sequenceFlow id="f-dist-join" sourceRef="distribute-lawlist" targetRef="ready-join" />
    <bpmn:sequenceFlow id="f-hearings" sourceRef="ready-join" targetRef="conduct-hearings" />
    <bpmn:sequenceFlow id="f-end" sourceRef="conduct-hearings" targetRef="hearings-conducted" />
  </bpmn:process>
</bpmn:definitions>
