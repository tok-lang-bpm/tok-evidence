<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="court-staff" name="Court staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Morning" />
    <bpmn:task id="check" name="Check the files" />
    <bpmn:exclusiveGateway id="missing" name="Some files missing?" />
    <bpmn:task id="search" name="Initiate a search" />
    <bpmn:task id="track" name="Track the files to the intended location" />
    <bpmn:exclusiveGateway id="ready" name="All files ready?" />
    <bpmn:parallelGateway id="parallel-split" />
    <bpmn:task id="hand" name="Hand the files to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist" />
    <bpmn:parallelGateway id="parallel-join" />
    <bpmn:task id="conduct" name="Conduct the directions hearings" />
    <bpmn:endEvent id="end" name="Directions hearings completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f2" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f5" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f6" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f7" sourceRef="ready" targetRef="parallel-split" />
    <bpmn:sequenceFlow id="f8" sourceRef="parallel-split" targetRef="hand" />
    <bpmn:sequenceFlow id="f9" sourceRef="parallel-split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f10" sourceRef="hand" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f11" sourceRef="distribute" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f12" sourceRef="parallel-join" targetRef="conduct" />
    <bpmn:sequenceFlow id="f13" sourceRef="conduct" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
