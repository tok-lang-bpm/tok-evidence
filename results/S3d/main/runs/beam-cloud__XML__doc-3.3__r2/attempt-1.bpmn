<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="claims-officer" name="Claims Officer">
        <bpmn:flowNodeRef>claim-registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-settlement-recommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior-claims-officer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>check-recommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommendation-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-handling-proceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim-registered" name="Claim registered" />
    <bpmn:task id="examine-claim" name="Examine claim" />
    <bpmn:task id="write-settlement-recommendation" name="Write settlement recommendation" />
    <bpmn:task id="check-recommendation" name="Check recommendation" />
    <bpmn:exclusiveGateway id="recommendation-ok" name="Recommendation OK?" />
    <bpmn:endEvent id="claim-handling-proceeds" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f1" sourceRef="claim-registered" targetRef="examine-claim" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine-claim" targetRef="write-settlement-recommendation" />
    <bpmn:sequenceFlow id="f3" sourceRef="write-settlement-recommendation" targetRef="check-recommendation" />
    <bpmn:sequenceFlow id="f4" sourceRef="check-recommendation" targetRef="recommendation-ok" />
    <bpmn:sequenceFlow id="f5" name="OK" sourceRef="recommendation-ok" targetRef="claim-handling-proceeds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">status = "OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" name="Not OK" sourceRef="recommendation-ok" targetRef="write-settlement-recommendation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">status = "Not OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
