<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation-pool" name="Organisation" processRef="claims-notification-process" />
  </bpmn:collaboration>
  <bpmn:process id="claims-notification-process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="organisation-lane" name="Organisation">
        <bpmn:flowNodeRef>claim-received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forms-returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-completeness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeness-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-ended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updated-forms-received</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim-received" name="Claim received" />
    <bpmn:task id="check-insured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="insured-decision" name="Claimant insured?" />
    <bpmn:task id="inform-rejected" name="Inform claimant that claim must be rejected" />
    <bpmn:endEvent id="claim-rejected" name="Claim rejected" />
    <bpmn:task id="evaluate-severity" name="Evaluate severity of claim" />
    <bpmn:task id="send-forms" name="Send relevant forms to claimant" />
    <bpmn:intermediateCatchEvent id="forms-returned" name="Forms returned">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="check-completeness" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="completeness-decision" name="All relevant details provided?" />
    <bpmn:task id="register-claim" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="process-ended" name="Claims Notification process ended" />
    <bpmn:task id="inform-update" name="Inform claimant to update forms" />
    <bpmn:intermediateCatchEvent id="updated-forms-received" name="Updated forms received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="claim-received" targetRef="check-insured" />
    <bpmn:sequenceFlow id="f2" sourceRef="check-insured" targetRef="insured-decision" />
    <bpmn:sequenceFlow id="f3" name="no" sourceRef="insured-decision" targetRef="inform-rejected" />
    <bpmn:sequenceFlow id="f4" sourceRef="inform-rejected" targetRef="claim-rejected" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="insured-decision" targetRef="evaluate-severity" />
    <bpmn:sequenceFlow id="f6" sourceRef="evaluate-severity" targetRef="send-forms" />
    <bpmn:sequenceFlow id="f7" sourceRef="send-forms" targetRef="forms-returned" />
    <bpmn:sequenceFlow id="f8" sourceRef="forms-returned" targetRef="check-completeness" />
    <bpmn:sequenceFlow id="f9" sourceRef="check-completeness" targetRef="completeness-decision" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="completeness-decision" targetRef="register-claim" />
    <bpmn:sequenceFlow id="f11" sourceRef="register-claim" targetRef="process-ended" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="completeness-decision" targetRef="inform-update" />
    <bpmn:sequenceFlow id="f13" sourceRef="inform-update" targetRef="updated-forms-received" />
    <bpmn:sequenceFlow id="f14" sourceRef="updated-forms-received" targetRef="check-completeness" />
  </bpmn:process>
</bpmn:definitions>
