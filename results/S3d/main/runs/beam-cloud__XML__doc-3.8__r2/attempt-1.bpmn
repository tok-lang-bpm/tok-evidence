<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="car-insurer" name="Car insurer" processRef="claim-process" />
  </bpmn:collaboration>
  <bpmn:process id="claim-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer-lane" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-claim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification-lane" name="Notification department">
        <bpmn:flowNodeRef>check-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling-lane" name="Handling department">
        <bpmn:flowNodeRef>pick-up-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform-assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessment-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone-garage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="submit-claim" name="Submit the claim" />
    <bpmn:task id="check-documents" name="Check the documents upon completeness" />
    <bpmn:task id="register-claim" name="Register the claim" />
    <bpmn:task id="pick-up-claim" name="Pick up the claim" />
    <bpmn:task id="check-insurance" name="Check the insurance" />
    <bpmn:task id="perform-assessment" name="Perform an assessment" />
    <bpmn:exclusiveGateway id="assessment-result" name="Assessment positive?" />
    <bpmn:task id="phone-garage" name="Phone a garage to authorise the repairs" />
    <bpmn:task id="schedule-payment" name="Schedule the payment" />
    <bpmn:task id="reject-claim" name="Reject the claim" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="send-letter" name="Send a letter to the customer" />
    <bpmn:endEvent id="complete" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit-claim" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit-claim" targetRef="check-documents" />
    <bpmn:sequenceFlow id="f3" sourceRef="check-documents" targetRef="register-claim" />
    <bpmn:sequenceFlow id="f4" sourceRef="register-claim" targetRef="pick-up-claim" />
    <bpmn:sequenceFlow id="f5" sourceRef="pick-up-claim" targetRef="check-insurance" />
    <bpmn:sequenceFlow id="f6" sourceRef="check-insurance" targetRef="perform-assessment" />
    <bpmn:sequenceFlow id="f7" sourceRef="perform-assessment" targetRef="assessment-result" />
    <bpmn:sequenceFlow id="f8" name="positive" sourceRef="assessment-result" targetRef="phone-garage" />
    <bpmn:sequenceFlow id="f9" sourceRef="phone-garage" targetRef="schedule-payment" />
    <bpmn:sequenceFlow id="f10" sourceRef="schedule-payment" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" name="negative" sourceRef="assessment-result" targetRef="reject-claim" />
    <bpmn:sequenceFlow id="f12" sourceRef="reject-claim" targetRef="merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="merge" targetRef="send-letter" />
    <bpmn:sequenceFlow id="f14" sourceRef="send-letter" targetRef="complete" />
  </bpmn:process>
</bpmn:definitions>
