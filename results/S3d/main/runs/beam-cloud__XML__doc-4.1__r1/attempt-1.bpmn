<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msgNotice" name="Notice by telephone" />
  <bpmn:message id="msgMedicalFile" name="Medical file copy" />

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="familyDoctor" name="Family doctor" />
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
    <bpmn:messageFlow id="noticeFlow" sourceRef="familyDoctor" targetRef="start" />
    <bpmn:messageFlow id="requestFlow" sourceRef="sendLetter" targetRef="familyDoctor" />
    <bpmn:messageFlow id="copyFlow" sourceRef="familyDoctor" targetRef="catchCopy" />
  </bpmn:collaboration>

  <bpmn:process id="institute-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneSecretarial" name="Secretarial office">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gMergeNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>listNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wed1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gMed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catchCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gMedMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitMeet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinMeet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typeTapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addTyped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wed2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneNursing" name="Nursing officer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handIn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMedical" name="Medical team">
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordAssignList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineMed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addMedReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handAssignList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>formulate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneFirst" name="First intaker">
        <bpmn:flowNodeRef>plan1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copyNotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addChecklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSecond" name="Second intaker">
        <bpmn:flowNodeRef>plan2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dictaphone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Notice received by telephone">
      <bpmn:messageEventDefinition messageRef="msgNotice" />
    </bpmn:startEvent>
    <bpmn:task id="inq" name="Inquire name and residence" />
    <bpmn:task id="put" name="Put doctor through to nursing officer" />
    <bpmn:task id="store" name="Store information in information system" />
    <bpmn:task id="print" name="Print registration form" />
    <bpmn:exclusiveGateway id="gNew" name="New patient?" default="f10" />
    <bpmn:task id="create" name="Create patient file" />
    <bpmn:task id="storeFile" name="Store registration form and print in patient file" />
    <bpmn:exclusiveGateway id="gMergeNew" />
    <bpmn:task id="cards" name="Produce registration cards" />
    <bpmn:task id="listNew" name="Add patient to list of new notices" />
    <bpmn:intermediateCatchEvent id="wed1" name="Wednesday">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="storeAssign" name="Store assignment in information system" />
    <bpmn:task id="passCards" name="Pass registration cards to first and second intaker" />
    <bpmn:exclusiveGateway id="gMed" name="Medical file required?" default="f32" />
    <bpmn:task id="sendLetter" name="Prepare and send letter to family doctor" />
    <bpmn:intermediateCatchEvent id="catchCopy" name="Medical file copy received">
      <bpmn:messageEventDefinition messageRef="msgMedicalFile" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="informSecond" name="Inform second intaker" />
    <bpmn:task id="addCopy" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="gMedMerge" />
    <bpmn:parallelGateway id="splitMeet" />
    <bpmn:parallelGateway id="joinMeet" />
    <bpmn:task id="typeTapes" name="Type out tapes" />
    <bpmn:task id="addTyped" name="Add typed information to patient file" />
    <bpmn:task id="putStatus" name="Put patient on list of patients that reach this status" />
    <bpmn:intermediateCatchEvent id="wed2" name="Wednesday">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="provideList" name="Provide team-leader with list of patients" />
    <bpmn:endEvent id="end" name="Intake procedure ended" />

    <bpmn:task id="inquiry" name="Make full inquiry" />
    <bpmn:task id="record" name="Record information on registration form" />
    <bpmn:task id="handIn" name="Hand in registration form" />

    <bpmn:task id="hold" name="Hold staff meeting" />
    <bpmn:task id="assign" name="Assign patients to intakers" />
    <bpmn:task id="recordAssignList" name="Record assignments on assignment list" />
    <bpmn:task id="determineMed" name="Determine whether medical file is required" />
    <bpmn:task id="addMedReq" name="Add medical file requirement to assignment list" />
    <bpmn:task id="handAssignList" name="Hand assignment list to secretarial office" />
    <bpmn:task id="formulate" name="Formulate treatment plan" />

    <bpmn:task id="plan1" name="Plan meeting with patient" />
    <bpmn:task id="exam" name="Examine patient using standard checklist" />
    <bpmn:task id="obs" name="Register additional observations in personal notebook" />
    <bpmn:task id="copyNotes" name="Put copy of notes in patient file" />
    <bpmn:task id="addChecklist" name="Add standard checklist to patient file" />

    <bpmn:task id="plan2" name="Plan first meeting" />
    <bpmn:task id="dictaphone" name="Record observations using dictaphone" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="inq" />
    <bpmn:sequenceFlow id="f2" sourceRef="inq" targetRef="put" />
    <bpmn:sequenceFlow id="f3" sourceRef="put" targetRef="inquiry" />
    <bpmn:sequenceFlow id="f4" sourceRef="inquiry" targetRef="record" />
    <bpmn:sequenceFlow id="f5" sourceRef="record" targetRef="handIn" />
    <bpmn:sequenceFlow id="f6" sourceRef="handIn" targetRef="store" />
    <bpmn:sequenceFlow id="f7" sourceRef="store" targetRef="print" />
    <bpmn:sequenceFlow id="f8" sourceRef="print" targetRef="gNew" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gNew" targetRef="create">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">newPatient == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gNew" targetRef="gMergeNew" />
    <bpmn:sequenceFlow id="f11" sourceRef="create" targetRef="storeFile" />
    <bpmn:sequenceFlow id="f12" sourceRef="storeFile" targetRef="gMergeNew" />
    <bpmn:sequenceFlow id="f13" sourceRef="gMergeNew" targetRef="cards" />
    <bpmn:sequenceFlow id="f14" sourceRef="cards" targetRef="listNew" />
    <bpmn:sequenceFlow id="f15" sourceRef="listNew" targetRef="wed1" />
    <bpmn:sequenceFlow id="f16" sourceRef="wed1" targetRef="hold" />
    <bpmn:sequenceFlow id="f17" sourceRef="hold" targetRef="assign" />
    <bpmn:sequenceFlow id="f18" sourceRef="assign" targetRef="recordAssignList" />
    <bpmn:sequenceFlow id="f19" sourceRef="recordAssignList" targetRef="determineMed" />
    <bpmn:sequenceFlow id="f20" sourceRef="determineMed" targetRef="addMedReq" />
    <bpmn:sequenceFlow id="f21" sourceRef="addMedReq" targetRef="handAssignList" />
    <bpmn:sequenceFlow id="f22" sourceRef="handAssignList" targetRef="storeAssign" />
    <bpmn:sequenceFlow id="f23" sourceRef="storeAssign" targetRef="passCards" />
    <bpmn:sequenceFlow id="f24" sourceRef="passCards" targetRef="splitMeet" />
    <bpmn:sequenceFlow id="f25" sourceRef="splitMeet" targetRef="plan1" />
    <bpmn:sequenceFlow id="f26" sourceRef="plan1" targetRef="exam" />
    <bpmn:sequenceFlow id="f27" sourceRef="exam" targetRef="obs" />
    <bpmn:sequenceFlow id="f28" sourceRef="obs" targetRef="copyNotes" />
    <bpmn:sequenceFlow id="f29" sourceRef="copyNotes" targetRef="addChecklist" />
    <bpmn:sequenceFlow id="f30" sourceRef="addChecklist" targetRef="joinMeet" />
    <bpmn:sequenceFlow id="f31" sourceRef="splitMeet" targetRef="gMed" />
    <bpmn:sequenceFlow id="f32" name="no" sourceRef="gMed" targetRef="gMedMerge" />
    <bpmn:sequenceFlow id="f33" name="yes" sourceRef="gMed" targetRef="sendLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">medicalFileRequired == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f34" sourceRef="sendLetter" targetRef="catchCopy" />
    <bpmn:sequenceFlow id="f35" sourceRef="catchCopy" targetRef="informSecond" />
    <bpmn:sequenceFlow id="f36" sourceRef="informSecond" targetRef="addCopy" />
    <bpmn:sequenceFlow id="f37" sourceRef="addCopy" targetRef="gMedMerge" />
    <bpmn:sequenceFlow id="f38" sourceRef="gMedMerge" targetRef="plan2" />
    <bpmn:sequenceFlow id="f39" sourceRef="plan2" targetRef="dictaphone" />
    <bpmn:sequenceFlow id="f40" sourceRef="dictaphone" targetRef="typeTapes" />
    <bpmn:sequenceFlow id="f41" sourceRef="typeTapes" targetRef="addTyped" />
    <bpmn:sequenceFlow id="f42" sourceRef="addTyped" targetRef="joinMeet" />
    <bpmn:sequenceFlow id="f43" sourceRef="joinMeet" targetRef="putStatus" />
    <bpmn:sequenceFlow id="f44" sourceRef="putStatus" targetRef="wed2" />
    <bpmn:sequenceFlow id="f45" sourceRef="wed2" targetRef="provideList" />
    <bpmn:sequenceFlow id="f46" sourceRef="provideList" targetRef="formulate" />
    <bpmn:sequenceFlow id="f47" sourceRef="formulate" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
