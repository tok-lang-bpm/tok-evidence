<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="intake-process" />
  </bpmn:collaboration>
  <bpmn:process id="intake-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-secretarial" name="Secretarial office">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copy_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_second_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type_tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_taped_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_status_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_list</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-nursing" name="Nursing officer">
        <bpmn:flowNodeRef>full_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_form</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-teamleader" name="Team leader">
        <bpmn:flowNodeRef>hold_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-first" name="First intaker">
        <bpmn:flowNodeRef>first_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_checklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-second" name="Second intaker">
        <bpmn:flowNodeRef>second_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-psychiatrist" name="Psychiatrist">
        <bpmn:flowNodeRef>formulate_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Notice by telephone" />
    <bpmn:task id="inquire" name="Inquire name and residence" />
    <bpmn:task id="transfer" name="Put doctor through to nursing officer" />
    <bpmn:task id="full_inquiry" name="Make a full inquiry into mental, health, and social state" />
    <bpmn:task id="record_form" name="Record information on registration form" />
    <bpmn:task id="hand_form" name="Hand in registration form" />
    <bpmn:task id="store_info" name="Store information in information system" />
    <bpmn:task id="print_info" name="Print information" />
    <bpmn:exclusiveGateway id="gw_new" name="New patient?" default="f11" />
    <bpmn:task id="create_file" name="Create patient file" />
    <bpmn:task id="store_docs" name="Store registration form and print in patient file" />
    <bpmn:task id="produce_cards" name="Produce registration cards" />
    <bpmn:task id="add_list" name="Add new patient to list of new notices" />
    <bpmn:task id="hold_meeting" name="Hold staff meeting" />
    <bpmn:task id="assign" name="Assign new patients to team members" />
    <bpmn:task id="determine_file" name="Determine whether medical file is required" />
    <bpmn:task id="record_assign" name="Record assignments on assignment list" />
    <bpmn:task id="store_assign" name="Store assignment in information system" />
    <bpmn:task id="pass_cards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="first_plan" name="Plan a meeting with the patient" />
    <bpmn:task id="first_examine" name="Examine patient using standard checklist" />
    <bpmn:task id="first_register" name="Register additional observations" />
    <bpmn:task id="first_copy" name="Put copy of notes in patient file" />
    <bpmn:task id="first_checklist" name="Add standard checklist to patient file" />
    <bpmn:exclusiveGateway id="gw_required" name="Medical file required?" default="f33" />
    <bpmn:task id="send_letter" name="Prepare and send letter requesting medical file" />
    <bpmn:intermediateCatchEvent id="copy_received" name="Copy of medical file received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inform_second" name="Inform second intaker" />
    <bpmn:task id="add_copy" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="gw_second_merge" />
    <bpmn:task id="second_plan" name="Plan first meeting" />
    <bpmn:task id="second_meet" name="Conduct first meeting" />
    <bpmn:task id="second_record" name="Record observations on dictaphone" />
    <bpmn:task id="type_tapes" name="Type out tapes" />
    <bpmn:task id="add_taped_info" name="Add information to patient file" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="add_status_list" name="Put patient on list of patients that reached this status" />
    <bpmn:task id="provide_list" name="Provide team leader with list of these patients" />
    <bpmn:task id="formulate_plan" name="Formulate treatment plan" />
    <bpmn:endEvent id="end" name="Intake procedure ended" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="inquire" />
    <bpmn:sequenceFlow id="f2" sourceRef="inquire" targetRef="transfer" />
    <bpmn:sequenceFlow id="f3" sourceRef="transfer" targetRef="full_inquiry" />
    <bpmn:sequenceFlow id="f4" sourceRef="full_inquiry" targetRef="record_form" />
    <bpmn:sequenceFlow id="f5" sourceRef="record_form" targetRef="hand_form" />
    <bpmn:sequenceFlow id="f6" sourceRef="hand_form" targetRef="store_info" />
    <bpmn:sequenceFlow id="f7" sourceRef="store_info" targetRef="print_info" />
    <bpmn:sequenceFlow id="f8" sourceRef="print_info" targetRef="gw_new" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gw_new" targetRef="create_file">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${newPatient}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="create_file" targetRef="store_docs" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="gw_new" targetRef="store_docs" />
    <bpmn:sequenceFlow id="f12" sourceRef="store_docs" targetRef="produce_cards" />
    <bpmn:sequenceFlow id="f13" sourceRef="produce_cards" targetRef="add_list" />
    <bpmn:sequenceFlow id="f14" sourceRef="add_list" targetRef="hold_meeting" />
    <bpmn:sequenceFlow id="f15" sourceRef="hold_meeting" targetRef="assign" />
    <bpmn:sequenceFlow id="f16" sourceRef="assign" targetRef="determine_file" />
    <bpmn:sequenceFlow id="f17" sourceRef="determine_file" targetRef="record_assign" />
    <bpmn:sequenceFlow id="f18" sourceRef="record_assign" targetRef="store_assign" />
    <bpmn:sequenceFlow id="f19" sourceRef="store_assign" targetRef="pass_cards" />
    <bpmn:sequenceFlow id="f20" sourceRef="pass_cards" targetRef="fork" />
    <bpmn:sequenceFlow id="f21" sourceRef="fork" targetRef="first_plan" />
    <bpmn:sequenceFlow id="f22" sourceRef="fork" targetRef="gw_required" />
    <bpmn:sequenceFlow id="f23" sourceRef="first_plan" targetRef="first_examine" />
    <bpmn:sequenceFlow id="f24" sourceRef="first_examine" targetRef="first_register" />
    <bpmn:sequenceFlow id="f25" sourceRef="first_register" targetRef="first_copy" />
    <bpmn:sequenceFlow id="f26" sourceRef="first_copy" targetRef="first_checklist" />
    <bpmn:sequenceFlow id="f27" sourceRef="first_checklist" targetRef="join" />
    <bpmn:sequenceFlow id="f28" name="yes" sourceRef="gw_required" targetRef="send_letter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${medicalFileRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f29" sourceRef="send_letter" targetRef="copy_received" />
    <bpmn:sequenceFlow id="f30" sourceRef="copy_received" targetRef="inform_second" />
    <bpmn:sequenceFlow id="f31" sourceRef="inform_second" targetRef="add_copy" />
    <bpmn:sequenceFlow id="f32" sourceRef="add_copy" targetRef="gw_second_merge" />
    <bpmn:sequenceFlow id="f33" name="no" sourceRef="gw_required" targetRef="gw_second_merge" />
    <bpmn:sequenceFlow id="f34" sourceRef="gw_second_merge" targetRef="second_plan" />
    <bpmn:sequenceFlow id="f35" sourceRef="second_plan" targetRef="second_meet" />
    <bpmn:sequenceFlow id="f36" sourceRef="second_meet" targetRef="second_record" />
    <bpmn:sequenceFlow id="f37" sourceRef="second_record" targetRef="type_tapes" />
    <bpmn:sequenceFlow id="f38" sourceRef="type_tapes" targetRef="add_taped_info" />
    <bpmn:sequenceFlow id="f39" sourceRef="add_taped_info" targetRef="join" />
    <bpmn:sequenceFlow id="f40" sourceRef="join" targetRef="add_status_list" />
    <bpmn:sequenceFlow id="f41" sourceRef="add_status_list" targetRef="provide_list" />
    <bpmn:sequenceFlow id="f42" sourceRef="provide_list" targetRef="formulate_plan" />
    <bpmn:sequenceFlow id="f43" sourceRef="formulate_plan" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
