<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment-confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="approval" name="Expense report approved?" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="check" name="Check receipts" />
    <bpmn:exclusiveGateway id="receipts" name="Receipts valid?" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:task id="link" name="Link to payment system" />
    <bpmn:intermediateCatchEvent id="payment-confirmed" name="Payment confirmed">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" name="Process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f2" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f3" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f4" sourceRef="review" targetRef="approval" />
    <bpmn:sequenceFlow id="f5" name="rejected" sourceRef="approval" targetRef="edit" />
    <bpmn:sequenceFlow id="f6" name="approved" sourceRef="approval" targetRef="check" />
    <bpmn:sequenceFlow id="f7" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f8" sourceRef="check" targetRef="receipts" />
    <bpmn:sequenceFlow id="f9" name="missing or mismatched" sourceRef="receipts" targetRef="edit" />
    <bpmn:sequenceFlow id="f10" name="all in order" sourceRef="receipts" targetRef="accept" />
    <bpmn:sequenceFlow id="f11" sourceRef="accept" targetRef="link" />
    <bpmn:sequenceFlow id="f12" sourceRef="link" targetRef="payment-confirmed" />
    <bpmn:sequenceFlow id="f13" sourceRef="payment-confirmed" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
