<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg_payment_confirmation" name="Payment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="employee-lane" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor-lane" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>supervisor-decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer-lane" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipt-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-back</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment-system-lane" name="Payment system">
        <bpmn:flowNodeRef>link-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="supervisor-decision" name="Expense report approved?" default="flow-rejected" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:task id="check" name="Check receipts" />
    <bpmn:exclusiveGateway id="receipt-decision" name="All receipts match?" default="flow-mismatch" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:task id="send-back" name="Send expense report back" />
    <bpmn:serviceTask id="link-payment" name="Link to payment system" />
    <bpmn:intermediateCatchEvent id="payment-confirmation" name="Payment confirmation">
      <bpmn:messageEventDefinition messageRef="msg_payment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" name="Expenses processed" />
    <bpmn:sequenceFlow id="flow-start-purchase" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="flow-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="flow-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="flow-review-decision" sourceRef="review" targetRef="supervisor-decision" />
    <bpmn:sequenceFlow id="flow-approved" name="Approved" sourceRef="supervisor-decision" targetRef="check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-rejected" name="Rejected" sourceRef="supervisor-decision" targetRef="edit" />
    <bpmn:sequenceFlow id="flow-edit-review" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="flow-check-decision" sourceRef="check" targetRef="receipt-decision" />
    <bpmn:sequenceFlow id="flow-receipts-match" name="All receipts match" sourceRef="receipt-decision" targetRef="accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">receiptsMatch</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-mismatch" name="Receipts missing or mismatch" sourceRef="receipt-decision" targetRef="send-back" />
    <bpmn:sequenceFlow id="flow-send-back-edit" sourceRef="send-back" targetRef="edit" />
    <bpmn:sequenceFlow id="flow-accept-link" sourceRef="accept" targetRef="link-payment" />
    <bpmn:sequenceFlow id="flow-link-wait" sourceRef="link-payment" targetRef="payment-confirmation" />
    <bpmn:sequenceFlow id="flow-wait-end" sourceRef="payment-confirmation" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
