<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_invoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect_visually</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_to_accounting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting">
        <bpmn:flowNodeRef>identify_suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_instance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify_vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult_managers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_copy_ccm_again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_need_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consult_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_commercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file_signature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_instance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cost_center" name="Cost Center Manager">
        <bpmn:flowNodeRef>review_accuracy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_accurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_all_ap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial Manager">
        <bpmn:flowNodeRef>commercial_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_amount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>board_check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Invoice received" />
    <bpmn:task id="receive_invoices" name="Receive invoices on paper or fax" />
    <bpmn:task id="inspect_visually" name="Perform visual inspection" />
    <bpmn:task id="forward_to_accounting" name="Forward invoices to accounting employee" />
    <bpmn:task id="identify_suppliers" name="Identify charging suppliers" />
    <bpmn:task id="create_instance" name="Create new instance" />
    <bpmn:task id="check_items" name="Check invoice items" />
    <bpmn:task id="note_docket" name="Note cost center and cost center managers on docket" />
    <bpmn:task id="review_accuracy" name="Review invoice copy for accuracy" />
    <bpmn:exclusiveGateway id="g_accurate" name="Invoice accurate?" default="f14" />
    <bpmn:task id="note_ap" name="Note accurate position on docket" />
    <bpmn:exclusiveGateway id="g_all_ap" name="All items marked AP?" default="f12" />
    <bpmn:task id="reject_ap" name="Reject AP with note and explanatory statement" />
    <bpmn:task id="clarify_vendor" name="Proceed with clarification with vendor" />
    <bpmn:exclusiveGateway id="g_need_consult" name="Consult cost center managers?" default="f19" />
    <bpmn:task id="consult_managers" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="g_consult_join" />
    <bpmn:exclusiveGateway id="g_resolved" name="All inconsistencies resolved?" default="f22" />
    <bpmn:task id="send_copy_ccm_again" name="Send copy of invoice to cost center managers again" />
    <bpmn:task id="forward_commercial" name="Forward copy of invoice to commercial manager" />
    <bpmn:task id="commercial_audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="g_complaint" name="Complaint during commercial audit?" default="f28" />
    <bpmn:task id="resolve_complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="issue_approval" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="g_amount" name="Bill amount exceeds EUR 20?" default="f33" />
    <bpmn:task id="board_check" name="Check invoice again" />
    <bpmn:task id="file_signature" name="Move copy of invoice to signature file" />
    <bpmn:task id="give_payment" name="Give payment instructions" />
    <bpmn:task id="close_instance" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="end" name="Invoice processed" />
    <bpmn:sequenceFlow id="f01" sourceRef="start" targetRef="receive_invoices" />
    <bpmn:sequenceFlow id="f02" sourceRef="receive_invoices" targetRef="inspect_visually" />
    <bpmn:sequenceFlow id="f03" sourceRef="inspect_visually" targetRef="forward_to_accounting" />
    <bpmn:sequenceFlow id="f04" sourceRef="forward_to_accounting" targetRef="identify_suppliers" />
    <bpmn:sequenceFlow id="f05" sourceRef="identify_suppliers" targetRef="create_instance" />
    <bpmn:sequenceFlow id="f06" sourceRef="create_instance" targetRef="check_items" />
    <bpmn:sequenceFlow id="f07" sourceRef="check_items" targetRef="note_docket" />
    <bpmn:sequenceFlow id="f08" sourceRef="note_docket" targetRef="review_accuracy" />
    <bpmn:sequenceFlow id="f09" sourceRef="review_accuracy" targetRef="g_accurate" />
    <bpmn:sequenceFlow id="f10" name="in order" sourceRef="g_accurate" targetRef="note_ap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">invoice accurate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="note_ap" targetRef="g_all_ap" />
    <bpmn:sequenceFlow id="f12" name="more managers" sourceRef="g_all_ap" targetRef="review_accuracy" />
    <bpmn:sequenceFlow id="f13" name="all items AP" sourceRef="g_all_ap" targetRef="forward_commercial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all items marked AP</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" name="inconsistencies" sourceRef="g_accurate" targetRef="reject_ap" />
    <bpmn:sequenceFlow id="f15" sourceRef="reject_ap" targetRef="clarify_vendor" />
    <bpmn:sequenceFlow id="f16" sourceRef="clarify_vendor" targetRef="g_need_consult" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="g_need_consult" targetRef="consult_managers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">consultation necessary</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" sourceRef="consult_managers" targetRef="g_consult_join" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="g_need_consult" targetRef="g_consult_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="g_consult_join" targetRef="g_resolved" />
    <bpmn:sequenceFlow id="f21" name="resolved" sourceRef="g_resolved" targetRef="send_copy_ccm_again">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all inconsistencies resolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f22" name="not resolved" sourceRef="g_resolved" targetRef="clarify_vendor" />
    <bpmn:sequenceFlow id="f23" sourceRef="send_copy_ccm_again" targetRef="review_accuracy" />
    <bpmn:sequenceFlow id="f24" sourceRef="forward_commercial" targetRef="commercial_audit" />
    <bpmn:sequenceFlow id="f25" sourceRef="commercial_audit" targetRef="g_complaint" />
    <bpmn:sequenceFlow id="f26" name="complaint" sourceRef="g_complaint" targetRef="resolve_complaint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complaint exists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f27" sourceRef="resolve_complaint" targetRef="commercial_audit" />
    <bpmn:sequenceFlow id="f28" name="no complaint" sourceRef="g_complaint" targetRef="issue_approval" />
    <bpmn:sequenceFlow id="f29" sourceRef="issue_approval" targetRef="g_amount" />
    <bpmn:sequenceFlow id="f30" name="exceeds EUR 20" sourceRef="g_amount" targetRef="board_check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bill amount &gt; 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f31" sourceRef="board_check" targetRef="file_signature" />
    <bpmn:sequenceFlow id="f32" sourceRef="file_signature" targetRef="give_payment" />
    <bpmn:sequenceFlow id="f33" name="not exceeds" sourceRef="g_amount" targetRef="give_payment" />
    <bpmn:sequenceFlow id="f34" sourceRef="give_payment" targetRef="close_instance" />
    <bpmn:sequenceFlow id="f35" sourceRef="close_instance" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
