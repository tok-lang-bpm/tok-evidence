<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveInbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visualInspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardAccounting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting Employee">
        <bpmn:flowNodeRef>identifySuppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createInstance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noteDocket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarifyVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consultManagers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardCommercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolveComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fileSignature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>givePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closeInstance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internalMail" name="Internal Mail">
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>routeDocket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAllAp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBackAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBackRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendAgain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="costCenterManager" name="Cost Center Manager">
        <bpmn:flowNodeRef>reviewAccuracy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAccurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noteAp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectAp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercialManager" name="Commercial Manager">
        <bpmn:flowNodeRef>commercialAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAmount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>boardCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Invoice received on paper or fax" />

    <bpmn:task id="receiveInbox" name="Receive invoice in central inbox" />
    <bpmn:task id="visualInspect" name="Visually inspect invoice" />
    <bpmn:task id="forwardAccounting" name="Forward invoice to accounting employee" />

    <bpmn:task id="identifySuppliers" name="Identify charging suppliers" />
    <bpmn:task id="createInstance" name="Create invoice instance" />
    <bpmn:task id="checkItems" name="Check invoice items" />
    <bpmn:task id="noteDocket" name="Note cost centers and cost center managers on docket" />

    <bpmn:task id="sendFirst" name="Send docket and invoice copy to first cost center manager" />

    <bpmn:task id="reviewAccuracy" name="Review invoice copy for accuracy" />
    <bpmn:exclusiveGateway id="gAccurate" name="Invoice position accurate?" default="fReject" />
    <bpmn:task id="noteAp" name="Note accurate position on docket" />
    <bpmn:task id="rejectAp" name="Reject position with note and explanation" />

    <bpmn:task id="routeDocket" name="Route invoice copy based on docket" />
    <bpmn:exclusiveGateway id="gAllAp" name="All positions accurate?" default="fMoreManagers" />
    <bpmn:task id="sendNext" name="Send invoice copy to next cost center manager" />
    <bpmn:task id="sendBackAll" name="Send invoice copy back to accounting" />
    <bpmn:task id="sendBackRejected" name="Send rejected invoice copy back to accounting" />

    <bpmn:task id="clarifyVendor" name="Proceed with clarification with vendor" />
    <bpmn:exclusiveGateway id="gResolved" name="All inconsistencies resolved?" default="fConsult" />
    <bpmn:task id="consultManagers" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:task id="sendAgain" name="Send invoice copy to cost center managers" />

    <bpmn:task id="forwardCommercial" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="commercialAudit" name="Perform commercial audit" />
    <bpmn:exclusiveGateway id="gComplaint" name="Complaint during audit?" default="fNoComplaint" />
    <bpmn:task id="resolveComplaint" name="Resolve complaint with supplier" />
    <bpmn:task id="issueApproval" name="Issue payment approval" />
    <bpmn:exclusiveGateway id="gAmount" name="Bill amount exceeds EUR 20?" default="fNoExceed" />
    <bpmn:task id="boardCheck" name="Perform four-eyes check" />

    <bpmn:task id="fileSignature" name="File invoice copy in signature file" />
    <bpmn:task id="givePayment" name="Give payment instructions" />
    <bpmn:task id="closeInstance" name="Close invoice instance" />

    <bpmn:endEvent id="end" name="Invoice handled" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receiveInbox" />
    <bpmn:sequenceFlow id="f2" sourceRef="receiveInbox" targetRef="visualInspect" />
    <bpmn:sequenceFlow id="f3" sourceRef="visualInspect" targetRef="forwardAccounting" />
    <bpmn:sequenceFlow id="f4" sourceRef="forwardAccounting" targetRef="identifySuppliers" />
    <bpmn:sequenceFlow id="f5" sourceRef="identifySuppliers" targetRef="createInstance" />
    <bpmn:sequenceFlow id="f6" sourceRef="createInstance" targetRef="checkItems" />
    <bpmn:sequenceFlow id="f7" sourceRef="checkItems" targetRef="noteDocket" />
    <bpmn:sequenceFlow id="f8" sourceRef="noteDocket" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendFirst" targetRef="reviewAccuracy" />
    <bpmn:sequenceFlow id="f10" sourceRef="reviewAccuracy" targetRef="gAccurate" />

    <bpmn:sequenceFlow id="fAccurate" name="yes" sourceRef="gAccurate" targetRef="noteAp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accurate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fReject" name="no" sourceRef="gAccurate" targetRef="rejectAp" />

    <bpmn:sequenceFlow id="f11" sourceRef="noteAp" targetRef="routeDocket" />
    <bpmn:sequenceFlow id="f12" sourceRef="routeDocket" targetRef="gAllAp" />

    <bpmn:sequenceFlow id="fAllAccurate" name="yes" sourceRef="gAllAp" targetRef="sendBackAll">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all accurate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fMoreManagers" name="no" sourceRef="gAllAp" targetRef="sendNext" />

    <bpmn:sequenceFlow id="f13" sourceRef="sendNext" targetRef="reviewAccuracy" />
    <bpmn:sequenceFlow id="f14" sourceRef="sendBackAll" targetRef="forwardCommercial" />

    <bpmn:sequenceFlow id="f15" sourceRef="rejectAp" targetRef="sendBackRejected" />
    <bpmn:sequenceFlow id="f16" sourceRef="sendBackRejected" targetRef="clarifyVendor" />
    <bpmn:sequenceFlow id="f17" sourceRef="clarifyVendor" targetRef="gResolved" />

    <bpmn:sequenceFlow id="fResolved" name="yes" sourceRef="gResolved" targetRef="sendAgain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fConsult" name="no" sourceRef="gResolved" targetRef="consultManagers" />

    <bpmn:sequenceFlow id="f18" sourceRef="consultManagers" targetRef="clarifyVendor" />
    <bpmn:sequenceFlow id="f19" sourceRef="sendAgain" targetRef="reviewAccuracy" />

    <bpmn:sequenceFlow id="f20" sourceRef="forwardCommercial" targetRef="commercialAudit" />
    <bpmn:sequenceFlow id="f21" sourceRef="commercialAudit" targetRef="gComplaint" />

    <bpmn:sequenceFlow id="fComplaint" name="yes" sourceRef="gComplaint" targetRef="resolveComplaint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complaint</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fNoComplaint" name="no" sourceRef="gComplaint" targetRef="issueApproval" />

    <bpmn:sequenceFlow id="f22" sourceRef="resolveComplaint" targetRef="commercialAudit" />
    <bpmn:sequenceFlow id="f23" sourceRef="issueApproval" targetRef="gAmount" />

    <bpmn:sequenceFlow id="fExceeds" name="yes" sourceRef="gAmount" targetRef="boardCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &gt; 20</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fNoExceed" name="no" sourceRef="gAmount" targetRef="fileSignature" />

    <bpmn:sequenceFlow id="f24" sourceRef="boardCheck" targetRef="fileSignature" />
    <bpmn:sequenceFlow id="f25" sourceRef="fileSignature" targetRef="givePayment" />
    <bpmn:sequenceFlow id="f26" sourceRef="givePayment" targetRef="closeInstance" />
    <bpmn:sequenceFlow id="f27" sourceRef="closeInstance" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
