<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="assembler-ag" name="Assembler AG" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="assembler-ag-lane" name="Assembler AG">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier-lane" name="Supplier">
        <bpmn:flowNodeRef>process-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="First of each month">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">0 0 0 1 * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="send-order" name="Send the order" />
    <bpmn:task id="process-order" name="Process the order" />
    <bpmn:task id="send-invoice" name="Send an invoice" />
    <bpmn:task id="receive-invoice" name="Receive the invoice" />
    <bpmn:endEvent id="end" name="Invoice received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send-order" />
    <bpmn:sequenceFlow id="f2" sourceRef="send-order" targetRef="process-order" />
    <bpmn:sequenceFlow id="f3" sourceRef="process-order" targetRef="send-invoice" />
    <bpmn:sequenceFlow id="f4" sourceRef="send-invoice" targetRef="receive-invoice" />
    <bpmn:sequenceFlow id="f5" sourceRef="receive-invoice" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
