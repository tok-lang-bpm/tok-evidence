<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="staff" name="Staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_methods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_methods_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_2weeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_wait_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>startCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_budget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_acquired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>presentSales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_technical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_present_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>presentPresales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="g_methods" name="How to determine contact details?" default="f_buy" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Know somebody interested in the product" />
    <bpmn:exclusiveGateway id="g_methods_merge" />
    <bpmn:task id="startCall" name="Start calling the customer" />
    <bpmn:task id="determineContact" name="Determine the contact person" />
    <bpmn:task id="determineBudget" name="Determine the budget available for the project" />
    <bpmn:task id="askInterest" name="Ask the customer whether he is generally interested" />
    <bpmn:exclusiveGateway id="g_interested" name="Customer interested?" default="f_interested_yes" />
    <bpmn:exclusiveGateway id="g_budget" name="Potential project budget huge?" default="f_budget_no" />
    <bpmn:task id="acquire" name="Try to acquire the customer" />
    <bpmn:exclusiveGateway id="g_acquired" name="Customer interested in the end?" default="f_acquired_no" />
    <bpmn:task id="leave" name="Leave the customer alone" />
    <bpmn:task id="presentSales" name="Give a detailed online presentation" />
    <bpmn:task id="presentPresales" name="Give a detailed online presentation" />
    <bpmn:exclusiveGateway id="g_technical" name="More technical presentation?" default="f_standard" />
    <bpmn:exclusiveGateway id="g_present_merge" />
    <bpmn:receiveTask id="wait" name="Wait for the customer to come back to us" />
    <bpmn:boundaryEvent id="timer_2weeks" attachedToRef="wait" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="salesCall" name="Call the customer" />
    <bpmn:exclusiveGateway id="g_wait_merge" />
    <bpmn:task id="quotation" name="Create a quotation" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f_start" sourceRef="start" targetRef="g_methods" />
    <bpmn:sequenceFlow id="f_buy" name="buy details" sourceRef="g_methods" targetRef="buy" />
    <bpmn:sequenceFlow id="f_exh" name="exhibitions" sourceRef="g_methods" targetRef="exhibit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method = 'exhibitions'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_know" name="know somebody" sourceRef="g_methods" targetRef="know">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method = 'known'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_mb" sourceRef="buy" targetRef="g_methods_merge" />
    <bpmn:sequenceFlow id="f_me" sourceRef="exhibit" targetRef="g_methods_merge" />
    <bpmn:sequenceFlow id="f_mk" sourceRef="know" targetRef="g_methods_merge" />
    <bpmn:sequenceFlow id="f_call" sourceRef="g_methods_merge" targetRef="startCall" />
    <bpmn:sequenceFlow id="f_dc" sourceRef="startCall" targetRef="determineContact" />
    <bpmn:sequenceFlow id="f_db" sourceRef="determineContact" targetRef="determineBudget" />
    <bpmn:sequenceFlow id="f_ask" sourceRef="determineBudget" targetRef="askInterest" />
    <bpmn:sequenceFlow id="f_int" sourceRef="askInterest" targetRef="g_interested" />
    <bpmn:sequenceFlow id="f_interested_yes" name="yes" sourceRef="g_interested" targetRef="g_technical" />
    <bpmn:sequenceFlow id="f_interested_no" name="no" sourceRef="g_interested" targetRef="g_budget">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_budget_yes" name="yes" sourceRef="g_budget" targetRef="acquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">budgetHuge = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_budget_no" name="no" sourceRef="g_budget" targetRef="leave" />
    <bpmn:sequenceFlow id="f_acquire" sourceRef="acquire" targetRef="g_acquired" />
    <bpmn:sequenceFlow id="f_acquired_yes" name="yes" sourceRef="g_acquired" targetRef="g_technical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">acquired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_acquired_no" name="no" sourceRef="g_acquired" targetRef="leave" />
    <bpmn:sequenceFlow id="f_tech" name="more technical" sourceRef="g_technical" targetRef="presentPresales">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">technical = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_standard" name="standard" sourceRef="g_technical" targetRef="presentSales" />
    <bpmn:sequenceFlow id="f_ps" sourceRef="presentSales" targetRef="g_present_merge" />
    <bpmn:sequenceFlow id="f_pp" sourceRef="presentPresales" targetRef="g_present_merge" />
    <bpmn:sequenceFlow id="f_wait" sourceRef="g_present_merge" targetRef="wait" />
    <bpmn:sequenceFlow id="f_wait_out" sourceRef="wait" targetRef="g_wait_merge" />
    <bpmn:sequenceFlow id="f_timer" sourceRef="timer_2weeks" targetRef="salesCall" />
    <bpmn:sequenceFlow id="f_sales" sourceRef="salesCall" targetRef="g_wait_merge" />
    <bpmn:sequenceFlow id="f_quotation" sourceRef="g_wait_merge" targetRef="quotation" />
    <bpmn:sequenceFlow id="f_end" sourceRef="quotation" targetRef="end" />
    <bpmn:sequenceFlow id="f_leave" sourceRef="leave" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
