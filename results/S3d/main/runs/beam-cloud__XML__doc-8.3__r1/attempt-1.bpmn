<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="headLane" name="Head of the functional department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitForJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctionsGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="personnelLane" name="Personnel Department">
        <bpmn:flowNodeRef>questionsGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describeJob</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="detectRequirements" name="Detect a number of personnel requirements" />
    <bpmn:task id="reportVacancy" name="Report the vacancy to the Personnel Department" />
    <bpmn:exclusiveGateway id="questionsGateway" name="Questions about tasks and requirements?" default="flowDescribeJobDirect" />
    <bpmn:task id="askQuestions" name="Ask questions about the tasks and requirements" />
    <bpmn:task id="clarifications" name="Be available for clarifications" />
    <bpmn:task id="describeJob" name="Describe the job" />
    <bpmn:task id="waitForJobDescription" name="Wait to get the job description for review" />
    <bpmn:exclusiveGateway id="correctionsGateway" name="Corrections necessary?" default="flowApprove" />
    <bpmn:task id="askCorrections" name="Ask for corrections again" />
    <bpmn:task id="approveJobDescription" name="Approve the job description" />
    <bpmn:endEvent id="end" name="Job description approved" />

    <bpmn:sequenceFlow id="flowStart" sourceRef="start" targetRef="detectRequirements" />
    <bpmn:sequenceFlow id="flowDetectReport" sourceRef="detectRequirements" targetRef="reportVacancy" />
    <bpmn:sequenceFlow id="flowReportQuestions" sourceRef="reportVacancy" targetRef="questionsGateway" />
    <bpmn:sequenceFlow id="flowQuestionsYes" name="yes" sourceRef="questionsGateway" targetRef="askQuestions" />
    <bpmn:sequenceFlow id="flowAskQuestionsClarifications" sourceRef="askQuestions" targetRef="clarifications" />
    <bpmn:sequenceFlow id="flowClarificationsDescribe" sourceRef="clarifications" targetRef="describeJob" />
    <bpmn:sequenceFlow id="flowDescribeJobDirect" name="no" sourceRef="questionsGateway" targetRef="describeJob" />
    <bpmn:sequenceFlow id="flowDescribeWait" sourceRef="describeJob" targetRef="waitForJobDescription" />
    <bpmn:sequenceFlow id="flowWaitCorrections" sourceRef="waitForJobDescription" targetRef="correctionsGateway" />
    <bpmn:sequenceFlow id="flowCorrectionsYes" name="yes" sourceRef="correctionsGateway" targetRef="askCorrections" />
    <bpmn:sequenceFlow id="flowAskCorrectionsDescribe" sourceRef="askCorrections" targetRef="describeJob" />
    <bpmn:sequenceFlow id="flowApprove" name="no" sourceRef="correctionsGateway" targetRef="approveJobDescription" />
    <bpmn:sequenceFlow id="flowApproveEnd" sourceRef="approveJobDescription" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
