<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="declinedMessage" name="Mortgage declined" />
  <bpmn:message id="completedOfferMessage" name="Completed offer documents" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="mortgage-process" />
  </bpmn:collaboration>
  <bpmn:process id="mortgage-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customerServiceRepresentative" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitForReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declineReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completedReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allPrereq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateDecline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archiveDecline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelledDecline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moveToAdministration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>movedToAdministration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestOutstanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>documentsRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archiveTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelledTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />

    <bpmn:task id="sendOffer" name="Send Mortgage offer to customer" />

    <bpmn:eventBasedGateway id="waitForReply" name="Wait for reply" />

    <bpmn:intermediateCatchEvent id="declineReceived" name="Customer declines mortgage">
      <bpmn:messageEventDefinition messageRef="declinedMessage" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="completedReceived" name="Completed offer documents received">
      <bpmn:messageEventDefinition messageRef="completedOfferMessage" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="noAnswer" name="No answer after 2 weeks">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="allPrereq" name="All prerequisite documents provided?" default="flowNo" />

    <bpmn:task id="updateDecline" name="Update case details" />
    <bpmn:task id="archiveDecline" name="Archive work" />

    <bpmn:task id="moveToAdministration" name="Move case to administration for completion" />

    <bpmn:task id="requestOutstanding" name="Generate message requesting outstanding documents" />

    <bpmn:task id="updateTimeout" name="Update case details" />
    <bpmn:task id="archiveTimeout" name="Archive work" />

    <bpmn:endEvent id="cancelledDecline" name="Case cancelled" />
    <bpmn:endEvent id="movedToAdministration" name="Case moved to administration" />
    <bpmn:endEvent id="documentsRequested" name="Outstanding documents requested" />
    <bpmn:endEvent id="cancelledTimeout" name="Case cancelled" />

    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="sendOffer" />
    <bpmn:sequenceFlow id="flow2" sourceRef="sendOffer" targetRef="waitForReply" />
    <bpmn:sequenceFlow id="flow3" sourceRef="waitForReply" targetRef="declineReceived" />
    <bpmn:sequenceFlow id="flow4" sourceRef="waitForReply" targetRef="completedReceived" />
    <bpmn:sequenceFlow id="flow5" sourceRef="waitForReply" targetRef="noAnswer" />

    <bpmn:sequenceFlow id="flow6" sourceRef="declineReceived" targetRef="updateDecline" />
    <bpmn:sequenceFlow id="flow7" sourceRef="updateDecline" targetRef="archiveDecline" />
    <bpmn:sequenceFlow id="flow8" sourceRef="archiveDecline" targetRef="cancelledDecline" />

    <bpmn:sequenceFlow id="flow9" sourceRef="completedReceived" targetRef="allPrereq" />
    <bpmn:sequenceFlow id="flowYes" name="yes" sourceRef="allPrereq" targetRef="moveToAdministration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">allPrerequisiteDocumentsProvided == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowNo" name="no" sourceRef="allPrereq" targetRef="requestOutstanding" />
    <bpmn:sequenceFlow id="flow10" sourceRef="moveToAdministration" targetRef="movedToAdministration" />
    <bpmn:sequenceFlow id="flow11" sourceRef="requestOutstanding" targetRef="documentsRequested" />

    <bpmn:sequenceFlow id="flow12" sourceRef="noAnswer" targetRef="updateTimeout" />
    <bpmn:sequenceFlow id="flow13" sourceRef="updateTimeout" targetRef="archiveTimeout" />
    <bpmn:sequenceFlow id="flow14" sourceRef="archiveTimeout" targetRef="cancelledTimeout" />
  </bpmn:process>
</bpmn:definitions>
