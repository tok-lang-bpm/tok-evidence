<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_no_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_no_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_no_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move_to_admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_requested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>decline_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-admin" name="Administration">
        <bpmn:flowNodeRef>complete_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send_offer" name="Send Mortgage offer" />
    <bpmn:eventBasedGateway id="wait_reply" name="Wait for reply" />
    <bpmn:intermediateCatchEvent id="decline_reply" name="Customer declines mortgage">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="completed_docs" name="Customer sends completed offer documents">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer_no_answer" name="No answer after 2 weeks">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="update_decline" name="Update case details" />
    <bpmn:task id="archive_decline" name="Archive the work" />
    <bpmn:task id="update_no_answer" name="Update case details" />
    <bpmn:task id="archive_no_answer" name="Archive the work" />
    <bpmn:task id="request_docs" name="Generate message requesting outstanding documents" />
    <bpmn:task id="move_to_admin" name="Move case to administration for completion" />
    <bpmn:exclusiveGateway id="all_docs" name="All prerequisite documents provided?" />
    <bpmn:task id="complete_case" name="Complete case" />
    <bpmn:endEvent id="end_cancelled" name="Cancelled" />
    <bpmn:endEvent id="end_requested" name="Outstanding documents requested" />
    <bpmn:endEvent id="end_completed" name="Completed" />

    <bpmn:sequenceFlow id="f_start" sourceRef="start" targetRef="send_offer" />
    <bpmn:sequenceFlow id="f_send" sourceRef="send_offer" targetRef="wait_reply" />
    <bpmn:sequenceFlow id="f_decline" sourceRef="wait_reply" targetRef="decline_reply" />
    <bpmn:sequenceFlow id="f_docs" sourceRef="wait_reply" targetRef="completed_docs" />
    <bpmn:sequenceFlow id="f_timer" sourceRef="wait_reply" targetRef="timer_no_answer" />
    <bpmn:sequenceFlow id="f_decline_update" sourceRef="decline_reply" targetRef="update_decline" />
    <bpmn:sequenceFlow id="f_decline_archive" sourceRef="update_decline" targetRef="archive_decline" />
    <bpmn:sequenceFlow id="f_decline_end" sourceRef="archive_decline" targetRef="end_cancelled" />
    <bpmn:sequenceFlow id="f_docs_check" sourceRef="completed_docs" targetRef="all_docs" />
    <bpmn:sequenceFlow id="f_yes" name="yes" sourceRef="all_docs" targetRef="move_to_admin" />
    <bpmn:sequenceFlow id="f_move" sourceRef="move_to_admin" targetRef="complete_case" />
    <bpmn:sequenceFlow id="f_complete" sourceRef="complete_case" targetRef="end_completed" />
    <bpmn:sequenceFlow id="f_no" name="no" sourceRef="all_docs" targetRef="request_docs" />
    <bpmn:sequenceFlow id="f_request_end" sourceRef="request_docs" targetRef="end_requested" />
    <bpmn:sequenceFlow id="f_timer_update" sourceRef="timer_no_answer" targetRef="update_no_answer" />
    <bpmn:sequenceFlow id="f_timer_archive" sourceRef="update_no_answer" targetRef="archive_no_answer" />
    <bpmn:sequenceFlow id="f_timer_end" sourceRef="archive_no_answer" targetRef="end_cancelled" />
  </bpmn:process>
</bpmn:definitions>
