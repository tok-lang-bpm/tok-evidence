<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-coord" name="Coordination Unit">
        <bpmn:flowNodeRef>start-dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-qacheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-sendminutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-support" name="Support Officer">
        <bpmn:flowNodeRef>task-updatecal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-createfolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-ensureuploads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-produceminutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-updaterecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-committee" name="Committee Members">
        <bpmn:flowNodeRef>task-holdmeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-dates" name="Dates finalized" />
    <bpmn:task id="task-updatecal" name="Update all group calendars" />
    <bpmn:task id="task-createfolders" name="Create meeting folders" />
    <bpmn:task id="task-ensureuploads" name="Ensure all appropriate documents are uploaded to system" />
    <bpmn:task id="task-advise" name="Advise Committee Members to read all related documents" />
    <bpmn:task id="task-holdmeeting" name="Hold the meeting" />
    <bpmn:task id="task-produceminutes" name="Produce minutes including Action Points" />
    <bpmn:task id="task-qacheck" name="Conduct a QA check on the minutes" />
    <bpmn:task id="task-sendminutes" name="Send minutes to all Committee Members" />
    <bpmn:task id="task-updaterecords" name="Update all departmental records" />
    <bpmn:endEvent id="end-done" name="Departmental records updated" />
    <bpmn:sequenceFlow id="f1" sourceRef="start-dates" targetRef="task-updatecal" />
    <bpmn:sequenceFlow id="f2" sourceRef="task-updatecal" targetRef="task-createfolders" />
    <bpmn:sequenceFlow id="f3" sourceRef="task-createfolders" targetRef="task-ensureuploads" />
    <bpmn:sequenceFlow id="f4" sourceRef="task-ensureuploads" targetRef="task-advise" />
    <bpmn:sequenceFlow id="f5" sourceRef="task-advise" targetRef="task-holdmeeting" />
    <bpmn:sequenceFlow id="f6" sourceRef="task-holdmeeting" targetRef="task-produceminutes" />
    <bpmn:sequenceFlow id="f7" sourceRef="task-produceminutes" targetRef="task-qacheck" />
    <bpmn:sequenceFlow id="f8" sourceRef="task-qacheck" targetRef="task-sendminutes" />
    <bpmn:sequenceFlow id="f9" sourceRef="task-sendminutes" targetRef="task-updaterecords" />
    <bpmn:sequenceFlow id="f10" sourceRef="task-updaterecords" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
