<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Going public: underwriting of an issue" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_SEC_clearance" name="SEC clearance" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ipo" name="Company going public" processRef="ipo-process" />
  </bpmn:collaboration>
  <bpmn:process id="ipo-process" name="Going public: underwriting of an issue" isExecutable="false">
    <bpmn:laneSet id="ipo-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="uw" name="Underwriters">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>road</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="review" name="Review whether the facts are presented fairly" />
    <bpmn:exclusiveGateway id="fair" name="Facts presented fairly?" default="f-fair-decline" />
    <bpmn:endEvent id="decline" name="Underwriters decline the issue" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:task id="submit" name="Submit the registration statement to the SEC" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="blue" name="Check compliance with state blue-sky laws" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="road" name="Arrange a road show for potential investors" />
    <bpmn:intermediateCatchEvent id="clear" name="SEC clearance received">
      <bpmn:messageEventDefinition id="clear-def" messageRef="Message_SEC_clearance" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="reason" name="Reason found not to offer the stock?" default="f-reason-offer" />
    <bpmn:endEvent id="no-offer" name="Offering not made" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="done" name="Stock offered to the public" />
    <bpmn:sequenceFlow id="f-s-select" sourceRef="s" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-review" sourceRef="select" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-fair" sourceRef="review" targetRef="fair" />
    <bpmn:sequenceFlow id="f-fair-prepare" name="yes" sourceRef="fair" targetRef="prepare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fair-decline" name="no" sourceRef="fair" targetRef="decline" />
    <bpmn:sequenceFlow id="f-prepare-submit" sourceRef="prepare" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-fork" sourceRef="submit" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-blue" sourceRef="fork" targetRef="blue" />
    <bpmn:sequenceFlow id="f-blue-join" sourceRef="blue" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-firm" sourceRef="fork" targetRef="firm" />
    <bpmn:sequenceFlow id="f-firm-road" sourceRef="firm" targetRef="road" />
    <bpmn:sequenceFlow id="f-road-join" sourceRef="road" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-clear" sourceRef="fork" targetRef="clear" />
    <bpmn:sequenceFlow id="f-clear-fix" sourceRef="clear" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-join" sourceRef="fix" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-commit" sourceRef="join" targetRef="commit" />
    <bpmn:sequenceFlow id="f-commit-reason" sourceRef="commit" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-no-offer" name="yes" sourceRef="reason" targetRef="no-offer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reason-offer" name="no" sourceRef="reason" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-done" sourceRef="offer" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
