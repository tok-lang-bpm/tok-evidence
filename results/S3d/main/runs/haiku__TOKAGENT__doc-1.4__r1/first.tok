tok 1.0 "Going public: underwriting of an issue"

pool ipo "Company going public"
  lane company "Company"
    start s "Company decides to go public"
    task select "Select the underwriters"
  lane uw "Underwriters"
    task review "Review whether the facts are presented fairly"
    xor fair "Facts presented fairly?"
    end decline "Underwriters decline the issue"
    task prepare "Prepare the registration statement"
    task submit "Submit the registration statement to the SEC"
    and fork
    task blue "Check compliance with state blue-sky laws"
    task firm "Firm up the issue price"
    task road "Arrange a road show for potential investors"
    catch clear "SEC clearance received" message="SEC clearance"
    task fix "Fix the issue price"
    and join
    task commit "Enter into a firm commitment to buy the stock"
    xor reason "Reason found not to offer the stock?"
    end no-offer "Offering not made"
    task offer "Offer the stock to the public"
    end done "Stock offered to the public"

flow s -> select -> review -> fair
flow fair -> prepare "yes" when=""
flow fair -> decline "no" default
flow prepare -> submit -> fork
flow fork -> blue -> join
flow fork -> firm -> road -> join
flow fork -> clear -> fix -> join
flow join -> commit -> reason
flow reason -> no-offer "yes" when="reason found"
flow reason -> offer "no" default
flow offer -> done
