<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measurement request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tr-sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-fail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Measurement needed" />
    <bpmn:task id="req" name="Request measurements" />
    <bpmn:task id="proc" name="Process measured values" />
    <bpmn:task id="chg" name="Send changed values to MSP" />
    <bpmn:task id="tr-sp" name="Transmit readings to SP" />
    <bpmn:endEvent id="e-done" name="Readings transmitted" />
    <bpmn:task id="chk" name="Check received request" />
    <bpmn:exclusiveGateway id="acc" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny request of GO" />
    <bpmn:task id="perf" name="Perform measurement" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:exclusiveGateway id="fail" name="Reading failed?" />
    <bpmn:task id="inf" name="Inform GO about failure of reading" />
    <bpmn:task id="trv" name="Transmit measured values to GO" />
    <bpmn:endEvent id="e-fail" name="Failure reported" />
    <bpmn:sequenceFlow id="f-s-req" sourceRef="s" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-chk" sourceRef="req" targetRef="chk" />
    <bpmn:sequenceFlow id="f-chk-acc" sourceRef="chk" targetRef="acc" />
    <bpmn:sequenceFlow id="f-acc-deny" name="no" sourceRef="acc" targetRef="deny" />
    <bpmn:sequenceFlow id="f-acc-perf" name="yes" sourceRef="acc" targetRef="perf" />
    <bpmn:sequenceFlow id="f-deny-merge1" sourceRef="deny" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-perf-merge1" sourceRef="perf" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-fail" sourceRef="merge1" targetRef="fail" />
    <bpmn:sequenceFlow id="f-fail-inf" name="yes" sourceRef="fail" targetRef="inf" />
    <bpmn:sequenceFlow id="f-fail-trv" name="no" sourceRef="fail" targetRef="trv" />
    <bpmn:sequenceFlow id="f-inf-e-fail" sourceRef="inf" targetRef="e-fail" />
    <bpmn:sequenceFlow id="f-trv-proc" sourceRef="trv" targetRef="proc" />
    <bpmn:sequenceFlow id="f-proc-chg" sourceRef="proc" targetRef="chg" />
    <bpmn:sequenceFlow id="f-chg-tr-sp" sourceRef="chg" targetRef="tr-sp" />
    <bpmn:sequenceFlow id="f-tr-sp-e-done" sourceRef="tr-sp" targetRef="e-done" />
  </bpmn:process>
</bpmn:definitions>
