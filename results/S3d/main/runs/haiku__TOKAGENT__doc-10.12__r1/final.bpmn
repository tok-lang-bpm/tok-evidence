<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Change of master data" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Change of master data" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>t-notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>t-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-possible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Change of master data requested" />
    <bpmn:task id="t-report" name="Report change of master data" />
    <bpmn:task id="t-notify" name="Notify IP of change" />
    <bpmn:task id="t-check" name="Check whether master data can be changed at desired time" />
    <bpmn:exclusiveGateway id="g-possible" name="Can the change be made at the desired time?" default="f-g-possible-t-reject" />
    <bpmn:task id="t-confirm" name="Confirm change of master data" />
    <bpmn:task id="t-reject" name="Reject change of master data" />
    <bpmn:endEvent id="e-confirmed" name="Change confirmed" />
    <bpmn:endEvent id="e-rejected" name="Change rejected" />
    <bpmn:sequenceFlow id="f-s-t-report" sourceRef="s" targetRef="t-report" />
    <bpmn:sequenceFlow id="f-t-report-t-notify" sourceRef="t-report" targetRef="t-notify" />
    <bpmn:sequenceFlow id="f-t-notify-t-check" sourceRef="t-notify" targetRef="t-check" />
    <bpmn:sequenceFlow id="f-t-check-g-possible" sourceRef="t-check" targetRef="g-possible" />
    <bpmn:sequenceFlow id="f-g-possible-t-confirm" name="yes" sourceRef="g-possible" targetRef="t-confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-possible-t-reject" name="no" sourceRef="g-possible" targetRef="t-reject" />
    <bpmn:sequenceFlow id="f-t-confirm-e-confirmed" sourceRef="t-confirm" targetRef="e-confirmed" />
    <bpmn:sequenceFlow id="f-t-reject-e-rejected" sourceRef="t-reject" targetRef="e-rejected" />
  </bpmn:process>
</bpmn:definitions>
