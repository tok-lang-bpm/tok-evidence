tok 1.0 "Change of master data"

pool org "Organisation"
  lane ec "EC"
    start s "Change of master data requested"
    task t-report "Report change of master data"
  lane inq "INQ"
    task t-notify "Notify IP of change"
  lane ip "IP"
    task t-check "Check whether master data can be changed at desired time"
    xor g-possible "Can the change be made at the desired time?"
    task t-confirm "Confirm change of master data"
    task t-reject "Reject change of master data"
    end e-confirmed "Change confirmed"
    end e-rejected "Change rejected"

flow s -> t-report -> t-notify -> t-check -> g-possible
flow g-possible -> t-confirm "yes" when=""
flow g-possible -> t-reject "no" default
flow t-confirm -> e-confirmed
flow t-reject -> e-rejected
