<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Transaction data request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Transaction data request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Transaction data needed" />
    <bpmn:task id="t1" name="Transmit the transaction data request" />
    <bpmn:task id="t2" name="Check the request of the INQ" />
    <bpmn:exclusiveGateway id="g1" name="Request accepted?" default="f-g1-t4" />
    <bpmn:task id="t3" name="Transmit the data" />
    <bpmn:task id="t4" name="Reject the request" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="t5" name="Answer the question of the INQ" />
    <bpmn:endEvent id="e1" name="Question answered" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t3" name="yes" sourceRef="g1" targetRef="t3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">examinationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-t4" name="no" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t3-g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t4-g2" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t5" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-e1" sourceRef="t5" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
