tok 1.0 "Transaction data request"

pool org "Organisation"
  lane inq "INQ"
    start s "Transaction data needed"
    task t1 "Transmit the transaction data request"
  lane ip "IP"
    task t2 "Check the request of the INQ"
    xor g1 "Request accepted?"
    task t3 "Transmit the data"
    task t4 "Reject the request"
    xor g2
    task t5 "Answer the question of the INQ"
    end e1 "Question answered"

flow s -> t1 -> t2 -> g1
flow g1 -> t3 "yes" when="examinationPassed = true"
flow g1 -> t4 "no" default
flow t3 -> g2
flow t4 -> g2 -> t5 -> e1
