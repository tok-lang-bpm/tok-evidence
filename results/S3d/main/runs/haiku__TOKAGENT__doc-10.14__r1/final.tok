tok 1.0 "Bill for metering services"

pool market "Metering market"
  lane mpoo "MPOO"
    start s "Bill to be sent"
    xor g1 "Which bill?"
    task t1 "Send bill for temporary continuation of metering point operations"
    task t4 "Send bill for equipment acquisition"
    task rc1 "Receive payment advice"
  lane mspo "MSPO"
    task t2 "Send bill for temporary continuation of measurement"
    task t3 "Send bill for additional readings"
    task rc2 "Receive payment advice"
  lane go "GO"
    xor j1 "Bill received"
    task e1 "Examine bill"
    xor g2 "Who examines the bill?"
    task e2 "Examine bill"
    xor j2 "Bill examined"
    xor g4 "Invoice accepted?"
    task c1 "Confirm invoice with payment advice"
    xor g6 "Invoice of MPOO or MSPO?"
    task r1 "Reject invoice"
    end endA "Payment advice sent"
    end endR "Invoice rejected"
  lane mpon "MPON"
    task e3 "Examine bill"

flow s -> g1
flow g1 -> t1 "temporary continuation of metering point operations"
flow g1 -> t2 "temporary continuation of measurement"
flow g1 -> t3 "additional readings"
flow g1 -> t4 "equipment acquisition"
flow t1 -> j1
flow t2 -> j1
flow t3 -> j1 -> e1 -> j2
flow t4 -> g2
flow g2 -> e2 "GO"
flow g2 -> e3 "MPON"
flow e2 -> j2
flow e3 -> j2 -> g4
flow g4 -> c1 "yes"
flow g4 -> r1 "no"
flow c1 -> g6
flow g6 -> rc1 "MPOO"
flow g6 -> rc2 "MSPO"
flow rc1 -> endA
flow rc2 -> endA
flow r1 -> endR
