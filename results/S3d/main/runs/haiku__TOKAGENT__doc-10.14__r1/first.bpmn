<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill for metering services" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="market" name="Metering market" processRef="market-process" />
  </bpmn:collaboration>
  <bpmn:process id="market-process" name="Bill for metering services" isExecutable="false">
    <bpmn:laneSet id="market-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rc1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rc2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Bill to be sent" />
    <bpmn:exclusiveGateway id="g1" name="Which bill?" />
    <bpmn:task id="t1" name="Send bill for temporary continuation of metering point operations" />
    <bpmn:task id="t4" name="Send bill for equipment acquisition" />
    <bpmn:task id="rc1" name="Receive payment advice" />
    <bpmn:task id="t2" name="Send bill for temporary continuation of measurement" />
    <bpmn:task id="t3" name="Send bill for additional readings" />
    <bpmn:task id="rc2" name="Receive payment advice" />
    <bpmn:exclusiveGateway id="j1" name="Bill received" />
    <bpmn:task id="e1" name="Examine bill" />
    <bpmn:exclusiveGateway id="g2" name="Who examines the bill?" />
    <bpmn:task id="e2" name="Examine bill" />
    <bpmn:exclusiveGateway id="j2" name="Bill examined" />
    <bpmn:exclusiveGateway id="g4" name="Invoice accepted?" />
    <bpmn:task id="c1" name="Confirm invoice with payment advice" />
    <bpmn:exclusiveGateway id="g6" name="Invoice of MPOO or MSPO?" />
    <bpmn:task id="r1" name="Reject invoice" />
    <bpmn:endEvent id="endA" name="Payment advice sent" />
    <bpmn:endEvent id="endR" name="Invoice rejected" />
    <bpmn:task id="e3" name="Examine bill" />
    <bpmn:sequenceFlow id="f-s-g1" sourceRef="s" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t1" name="temporary continuation of metering point operations" sourceRef="g1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-g1-t2" name="temporary continuation of measurement" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-g1-t3" name="additional readings" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-g1-t4" name="equipment acquisition" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t1-j1" sourceRef="t1" targetRef="j1" />
    <bpmn:sequenceFlow id="f-t2-j1" sourceRef="t2" targetRef="j1" />
    <bpmn:sequenceFlow id="f-t3-j1" sourceRef="t3" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-e1" sourceRef="j1" targetRef="e1" />
    <bpmn:sequenceFlow id="f-e1-j2" sourceRef="e1" targetRef="j2" />
    <bpmn:sequenceFlow id="f-t4-g2" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-e2" name="GO" sourceRef="g2" targetRef="e2" />
    <bpmn:sequenceFlow id="f-g2-e3" name="MPON" sourceRef="g2" targetRef="e3" />
    <bpmn:sequenceFlow id="f-e2-j2" sourceRef="e2" targetRef="j2" />
    <bpmn:sequenceFlow id="f-e3-j2" sourceRef="e3" targetRef="j2" />
    <bpmn:sequenceFlow id="f-j2-g4" sourceRef="j2" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-c1" name="yes" sourceRef="g4" targetRef="c1" />
    <bpmn:sequenceFlow id="f-g4-r1" name="no" sourceRef="g4" targetRef="r1" />
    <bpmn:sequenceFlow id="f-c1-g6" sourceRef="c1" targetRef="g6" />
    <bpmn:sequenceFlow id="f-g6-rc1" name="MPOO" sourceRef="g6" targetRef="rc1" />
    <bpmn:sequenceFlow id="f-g6-rc2" name="MSPO" sourceRef="g6" targetRef="rc2" />
    <bpmn:sequenceFlow id="f-rc1-endA" sourceRef="rc1" targetRef="endA" />
    <bpmn:sequenceFlow id="f-rc2-endA" sourceRef="rc2" targetRef="endA" />
    <bpmn:sequenceFlow id="f-r1-endR" sourceRef="r1" targetRef="endR" />
  </bpmn:process>
</bpmn:definitions>
