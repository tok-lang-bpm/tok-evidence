<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal of MPON" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal of MPON" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="pon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="poo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send" name="Send the dismissal to the MPOO" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="d" name="Does the MPOO oppose the dismissal?" />
    <bpmn:task id="oppose" name="Oppose the dismissal of MPON" />
    <bpmn:task id="confirm" name="Confirm the dismissal of MPON" />
    <bpmn:exclusiveGateway id="j" name="Dismissal decided" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-d" sourceRef="review" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-oppose" name="yes" sourceRef="d" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-d-confirm" name="no" sourceRef="d" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-oppose-j" sourceRef="oppose" targetRef="j" />
    <bpmn:sequenceFlow id="f-confirm-j" sourceRef="confirm" targetRef="j" />
    <bpmn:sequenceFlow id="f-j-e" sourceRef="j" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
