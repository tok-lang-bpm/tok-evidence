tok 1.0 "Dismissal of MPON"
pool org "Organisation" 
  lane pon "MPON"
    start s "Start"
    task send "Send the dismissal to the MPOO"
  lane poo "MPOO"
    task review "Review the dismissal"
    xor d "Does the MPOO oppose the dismissal?"
    task oppose "Oppose the dismissal of MPON"
    task confirm "Confirm the dismissal of MPON"
    xor j "Dismissal decided"
    end e "End"

flow s -> send -> review -> d
flow d -> oppose "yes"
flow d -> confirm "no"
flow oppose -> j
flow confirm -> j
flow j -> e
