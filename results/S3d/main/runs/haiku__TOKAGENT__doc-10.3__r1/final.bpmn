<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Deregistration of a measuring point" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="GO" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Deregistration of a measuring point" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-cont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Deregistration request" />
    <bpmn:task id="dereg" name="Deregister the measuring point" />
    <bpmn:task id="confirm-cont" name="Confirm the continuation of the operations" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="accepted" name="Is the deregistration accepted?" default="f-accepted-reject" />
    <bpmn:task id="prelim" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige-q" name="Oblige the MPOO to continue the operations?" default="f-oblige-q-merge-cont" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="merge-cont" />
    <bpmn:inclusiveGateway id="equip-split" default="f-equip-split-change" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:task id="change" name="Perform the equipment changes" />
    <bpmn:inclusiveGateway id="equip-join" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="inform-mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform-mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform-sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="done" name="Assignment of the GO completed" />
    <bpmn:sequenceFlow id="f-s-dereg" sourceRef="s" targetRef="dereg" />
    <bpmn:sequenceFlow id="f-dereg-verify" sourceRef="dereg" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-accepted" sourceRef="verify" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-prelim" name="yes" sourceRef="accepted" targetRef="prelim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-prelim-prepare" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige-q" sourceRef="prepare" targetRef="oblige-q" />
    <bpmn:sequenceFlow id="f-oblige-q-oblige" name="yes" sourceRef="oblige-q" targetRef="oblige">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">continuation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-oblige-q-merge-cont" name="no" sourceRef="oblige-q" targetRef="merge-cont" />
    <bpmn:sequenceFlow id="f-oblige-confirm-cont" sourceRef="oblige" targetRef="confirm-cont" />
    <bpmn:sequenceFlow id="f-confirm-cont-merge-cont" sourceRef="confirm-cont" targetRef="merge-cont" />
    <bpmn:sequenceFlow id="f-merge-cont-equip-split" sourceRef="merge-cont" targetRef="equip-split" />
    <bpmn:sequenceFlow id="f-equip-split-acquire" name="acquisition" sourceRef="equip-split" targetRef="acquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">acquisition = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equip-split-change" name="changes" sourceRef="equip-split" targetRef="change" />
    <bpmn:sequenceFlow id="f-acquire-equip-join" sourceRef="acquire" targetRef="equip-join" />
    <bpmn:sequenceFlow id="f-change-equip-join" sourceRef="change" targetRef="equip-join" />
    <bpmn:sequenceFlow id="f-equip-join-assign" sourceRef="equip-join" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform-mpoo" sourceRef="assign" targetRef="inform-mpoo" />
    <bpmn:sequenceFlow id="f-inform-mpoo-inform-mspo" sourceRef="inform-mpoo" targetRef="inform-mspo" />
    <bpmn:sequenceFlow id="f-inform-mspo-inform-sp" sourceRef="inform-mspo" targetRef="inform-sp" />
    <bpmn:sequenceFlow id="f-inform-sp-done" sourceRef="inform-sp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
