<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Device takeover" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Device takeover" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Device takeover" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="req" name="Request device takeover bid" />
    <bpmn:task id="order" name="Place order" />
    <bpmn:task id="tender" name="Send tender for equipment takeover" />
    <bpmn:task id="confirm" name="Confirm order" />
    <bpmn:task id="master" name="Send master data" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-req" sourceRef="s" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-tender" sourceRef="req" targetRef="tender" />
    <bpmn:sequenceFlow id="f-tender-order" sourceRef="tender" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-confirm" sourceRef="order" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-master" sourceRef="confirm" targetRef="master" />
    <bpmn:sequenceFlow id="f-master-e" sourceRef="master" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
