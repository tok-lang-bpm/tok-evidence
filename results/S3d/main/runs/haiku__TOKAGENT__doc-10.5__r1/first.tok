tok 1.0 "Device takeover"

pool p "Device takeover"
  lane mpon "MPON"
    start s "Start"
    task req "Request device takeover bid"
    task order "Place order"
  lane mpoo "MPOO"
    task tender "Send tender for equipment takeover"
    task confirm "Confirm order"
    task master "Send master data"
    end e "End"

flow s -> req -> tender -> order -> confirm -> master -> e
