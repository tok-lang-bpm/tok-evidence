<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Dismissal of the MSPN" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal of the MSPN" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Dismissal needed" />
    <bpmn:task id="send" name="Send the dismissal" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decide" name="Is the dismissal confirmed?" default="f-decide-confirm" />
    <bpmn:task id="reject" name="Reject the dismissal of the MSPN" />
    <bpmn:task id="confirm" name="Confirm the dismissal of the MSPN" />
    <bpmn:endEvent id="e-rejected" name="Dismissal rejected" />
    <bpmn:endEvent id="e-confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="rejected" sourceRef="decide" targetRef="reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decide-confirm" name="confirmed" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-e-rejected" sourceRef="reject" targetRef="e-rejected" />
    <bpmn:sequenceFlow id="f-confirm-e-confirmed" sourceRef="confirm" targetRef="e-confirmed" />
  </bpmn:process>
</bpmn:definitions>
