tok 1.0 "Dismissal of the MSPN"

pool org "Organisation"
  lane mspn "MSPN"
    start s "Dismissal needed"
    task send "Send the dismissal"
  lane mspo "MSPO"
    task review "Review the dismissal"
    xor decide "Is the dismissal confirmed?"
    task reject "Reject the dismissal of the MSPN"
    task confirm "Confirm the dismissal of the MSPN"
    end e-rejected "Dismissal rejected"
    end e-confirmed "Dismissal confirmed"

flow s -> send -> review -> decide
flow decide -> reject "rejected" when=""
flow decide -> confirm "confirmed" default
flow reject -> e-rejected
flow confirm -> e-confirmed
