<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Assignment of the MSPN measurement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Assignment of the MSPN measurement" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>asg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="reg" name="Register the measurement at the GO" />
    <bpmn:task id="exam" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="chk" name="Is the application confirmed?" default="f-chk-rej" />
    <bpmn:task id="rej" name="Reject the application of the MSPN" />
    <bpmn:endEvent id="end-rej" name="Application rejected" />
    <bpmn:task id="conf" name="Confirm the application of the MSPN" />
    <bpmn:task id="asg" name="Assign the MSPN" />
    <bpmn:task id="i1" name="Inform the MSPO about the assignment of the MSPN" />
    <bpmn:task id="i2" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="i3" name="Inform the SP about the assignment of the MSPN" />
    <bpmn:endEvent id="fin" name="Assignment completed" />
    <bpmn:sequenceFlow id="f-s-reg" sourceRef="s" targetRef="reg" />
    <bpmn:sequenceFlow id="f-reg-exam" sourceRef="reg" targetRef="exam" />
    <bpmn:sequenceFlow id="f-exam-chk" sourceRef="exam" targetRef="chk" />
    <bpmn:sequenceFlow id="f-chk-rej" name="no" sourceRef="chk" targetRef="rej" />
    <bpmn:sequenceFlow id="f-chk-conf" name="yes" sourceRef="chk" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rej-end-rej" sourceRef="rej" targetRef="end-rej" />
    <bpmn:sequenceFlow id="f-conf-asg" sourceRef="conf" targetRef="asg" />
    <bpmn:sequenceFlow id="f-asg-i1" sourceRef="asg" targetRef="i1" />
    <bpmn:sequenceFlow id="f-i1-i2" sourceRef="i1" targetRef="i2" />
    <bpmn:sequenceFlow id="f-i2-i3" sourceRef="i2" targetRef="i3" />
    <bpmn:sequenceFlow id="f-i3-fin" sourceRef="i3" targetRef="fin" />
  </bpmn:process>
</bpmn:definitions>
