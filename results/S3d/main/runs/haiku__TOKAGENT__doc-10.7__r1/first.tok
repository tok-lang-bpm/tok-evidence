tok 1.0 "Assignment of the MSPN measurement"
pool org "Organisation"
  lane mspn "MSPN"
    start s "Start"
    task reg "Register the measurement at the GO"
  lane go "GO"
    task exam "Examine the application of the MSPN"
    xor chk "Is the application confirmed?"
    task rej "Reject the application of the MSPN"
    end end-rej "Application rejected"
    task conf "Confirm the application of the MSPN"
    task asg "Assign the MSPN"
    task i1 "Inform the MSPO about the assignment of the MSPN"
    task i2 "Inform the MPO about the assignment of the MSPN"
    task i3 "Inform the SP about the assignment of the MSPN"
    end fin "Assignment completed"

flow s -> reg -> exam -> chk
flow chk -> rej "no" default
flow chk -> conf "yes" when=""
flow rej -> end-rej
flow conf -> asg -> i1 -> i2 -> i3 -> fin
