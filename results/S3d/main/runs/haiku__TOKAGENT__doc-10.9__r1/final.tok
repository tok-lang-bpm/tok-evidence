tok 1.0 "Change of measuring point"

pool org "Organisation"
  lane sp "SP / PU / GO"
    start sp-start "Change requested"
    task sp-request "Request change of measuring point"
  lane mpo "MPO"
    start mpo-start "Change caused by MPO"
    xor merge
    task review "Review change request"
    xor confirmed "Request confirmed?"
    task reject "Reject change request"
    end rejected "Change request rejected"
    task perform "Perform measuring point change"
    xor implemented "Change implemented?"
    task report "Report implementation to SP / PU / GO"
    task notify "Notify SP / PU / GO about failure of change"
    end done "Change implemented"
    end failed "Change failed"

flow sp-start -> sp-request -> merge
flow mpo-start -> merge -> review -> confirmed
flow confirmed -> perform "confirmed" when=""
flow confirmed -> reject "rejected" default
flow reject -> rejected
flow perform -> implemented
flow implemented -> report "implemented" when=""
flow implemented -> notify "failed" default
flow report -> done
flow notify -> failed
