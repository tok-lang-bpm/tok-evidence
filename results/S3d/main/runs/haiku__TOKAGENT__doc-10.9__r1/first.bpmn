<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Change of measuring point" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Change of measuring point" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>sp-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp-request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>mpo-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implemented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="sp-start" name="Change requested" />
    <bpmn:task id="sp-request" name="Request change of measuring point" />
    <bpmn:startEvent id="mpo-start" name="Change caused by MPO" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="review" name="Review change request" />
    <bpmn:exclusiveGateway id="confirmed" name="Request confirmed?" default="f-confirmed-reject" />
    <bpmn:task id="reject" name="Reject change request" />
    <bpmn:endEvent id="rejected" name="Change request rejected" />
    <bpmn:task id="perform" name="Perform measuring point change" />
    <bpmn:exclusiveGateway id="implemented" name="Change implemented?" default="f-implemented-notify" />
    <bpmn:task id="report" name="Report implementation to SP / PU / GO" />
    <bpmn:task id="notify" name="Notify SP / PU / GO about failure of change" />
    <bpmn:endEvent id="done" name="Change implemented" />
    <bpmn:endEvent id="failed" name="Change failed" />
    <bpmn:sequenceFlow id="f-sp-start-sp-request" sourceRef="sp-start" targetRef="sp-request" />
    <bpmn:sequenceFlow id="f-sp-request-merge" sourceRef="sp-request" targetRef="merge" />
    <bpmn:sequenceFlow id="f-mpo-start-merge" sourceRef="mpo-start" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-review" sourceRef="merge" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-confirmed" sourceRef="review" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-perform" name="confirmed" sourceRef="confirmed" targetRef="perform" />
    <bpmn:sequenceFlow id="f-confirmed-reject" name="rejected" sourceRef="confirmed" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-perform-implemented" sourceRef="perform" targetRef="implemented" />
    <bpmn:sequenceFlow id="f-implemented-report" name="implemented" sourceRef="implemented" targetRef="report" />
    <bpmn:sequenceFlow id="f-implemented-notify" name="failed" sourceRef="implemented" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-done" sourceRef="report" targetRef="done" />
    <bpmn:sequenceFlow id="f-notify-failed" sourceRef="notify" targetRef="failed" />
  </bpmn:process>
</bpmn:definitions>
