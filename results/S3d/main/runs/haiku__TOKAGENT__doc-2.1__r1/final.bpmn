<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation problem resolution" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Problem_parameters" name="Problem parameters" />
  <bpmn:message id="Message_Service_report" name="Service report" />
  <bpmn:signal id="Signal_Restoration_request" name="Restoration request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
    <bpmn:participant id="customer" name="Customer" processRef="customer-process" />
    <bpmn:messageFlow id="m-c-send-list-cs-start" name="Problem parameters" sourceRef="c-send-list" targetRef="cs-start" messageRef="Message_Problem_parameters" />
    <bpmn:messageFlow id="m-cs-send-report-c-recv" name="Service report" sourceRef="cs-send-report" targetRef="c-recv" messageRef="Message_Service_report" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="TELECO" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>cs-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-prem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-sig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-reprio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-after-prem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-cs-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-cs-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-send-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-cs-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="es" name="Electronic service">
        <bpmn:flowNodeRef>es-sig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>sm-investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-analysable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-send-perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-res-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-send-res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-send-restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-restore-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm-recv-tsr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>rp-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-rp-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-rp-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-send-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-tsr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp-send-tsr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bc" name="Billing and Collections">
        <bpmn:flowNodeRef>bc-adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="cs-start" name="Problem parameters received">
      <bpmn:messageEventDefinition id="cs-start-def" messageRef="Message_Problem_parameters" />
    </bpmn:startEvent>
    <bpmn:task id="cs-enter" name="Enter problem report into system T" />
    <bpmn:task id="cs-compare" name="Compare problem report with customer SLA" />
    <bpmn:task id="cs-measures" name="Determine counter measures and their priorities" />
    <bpmn:exclusiveGateway id="g-prem" name="Customer premium?" />
    <bpmn:callActivity id="cs-fix" name="Extra problem fix process" calledElement="ProblemFix" />
    <bpmn:exclusiveGateway id="g-sig" name="Significance affects counter measures?" />
    <bpmn:task id="cs-reprio" name="Re-prioritise counter measures" />
    <bpmn:exclusiveGateway id="g-after-prem" />
    <bpmn:task id="cs-detail" name="Create detailed problem report" />
    <bpmn:exclusiveGateway id="g-cs-merge" />
    <bpmn:parallelGateway id="g-cs-split" />
    <bpmn:task id="cs-report" name="Create report for customer" />
    <bpmn:task id="cs-send-report" name="Send report to customer" />
    <bpmn:task id="cs-rebate" name="Report SLA violation rebate to Billing and Collections" />
    <bpmn:parallelGateway id="g-cs-join" />
    <bpmn:endEvent id="cs-end" name="Customer Service process ends" />
    <bpmn:task id="es-sig" name="Determine significance of customer" />
    <bpmn:task id="sm-investigate" name="Investigate whether problem is analysable by Service Management" />
    <bpmn:exclusiveGateway id="g-analysable" name="Analysable by Service Management?" />
    <bpmn:task id="sm-analyse" name="Analyse the problem" />
    <bpmn:task id="sm-trouble" name="Create trouble report indicating the type of problem" />
    <bpmn:task id="sm-forward" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:exclusiveGateway id="g-final" />
    <bpmn:task id="sm-final" name="Prepare final status report" />
    <bpmn:task id="sm-determine" name="Determine counter measures from final status report" />
    <bpmn:exclusiveGateway id="g-measures" name="Which counter measures are required?" />
    <bpmn:task id="sm-send-perf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="sm-correct" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="g-res-merge" />
    <bpmn:task id="sm-resolution" name="Create problem resolution report" />
    <bpmn:task id="sm-send-res" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="sm-restore" name="Create request for automatic resource restoration" />
    <bpmn:intermediateThrowEvent id="sm-send-restore" name="Send restoration request">
      <bpmn:signalEventDefinition id="sm-send-restore-def" signalRef="Signal_Restoration_request" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="sm-restore-end" name="Restoration request sent" />
    <bpmn:task id="sm-recv-tsr" name="Receive trouble-shooting report" />
    <bpmn:task id="rp-check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="g-problem" name="Problem detected?" />
    <bpmn:task id="rp-normal" name="Create notification about normal service execution" />
    <bpmn:task id="rp-analyse" name="Analyse the problem" />
    <bpmn:task id="rp-trouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="g-rp-merge" />
    <bpmn:task id="rp-status" name="Create status report" />
    <bpmn:parallelGateway id="g-rp-split" />
    <bpmn:task id="rp-send-status" name="Send status report to Service Management" />
    <bpmn:eventBasedGateway id="rp-wait" />
    <bpmn:intermediateCatchEvent id="rp-restore" name="Restoration request received">
      <bpmn:signalEventDefinition id="rp-restore-def" signalRef="Signal_Restoration_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="rp-timeout" name="Two days after status report">
      <bpmn:timerEventDefinition id="rp-timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="rp-terminate" name="Process terminated" />
    <bpmn:task id="rp-track" name="Track all possible errors" />
    <bpmn:task id="rp-correct" name="Undertake all necessary corrective actions" />
    <bpmn:task id="rp-tsr" name="Create trouble-shooting report" />
    <bpmn:task id="rp-send-tsr" name="Send trouble-shooting report to Service Management" />
    <bpmn:task id="bc-adjust" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-cs-start-cs-enter" sourceRef="cs-start" targetRef="cs-enter" />
    <bpmn:sequenceFlow id="f-cs-enter-cs-compare" sourceRef="cs-enter" targetRef="cs-compare" />
    <bpmn:sequenceFlow id="f-cs-compare-cs-measures" sourceRef="cs-compare" targetRef="cs-measures" />
    <bpmn:sequenceFlow id="f-cs-measures-es-sig" sourceRef="cs-measures" targetRef="es-sig" />
    <bpmn:sequenceFlow id="f-es-sig-g-prem" sourceRef="es-sig" targetRef="g-prem" />
    <bpmn:sequenceFlow id="f-g-prem-cs-fix" name="yes" sourceRef="g-prem" targetRef="cs-fix" />
    <bpmn:sequenceFlow id="f-g-prem-g-sig" name="no" sourceRef="g-prem" targetRef="g-sig" />
    <bpmn:sequenceFlow id="f-cs-fix-g-after-prem" sourceRef="cs-fix" targetRef="g-after-prem" />
    <bpmn:sequenceFlow id="f-g-sig-cs-reprio" name="yes" sourceRef="g-sig" targetRef="cs-reprio" />
    <bpmn:sequenceFlow id="f-g-sig-g-after-prem" name="no" sourceRef="g-sig" targetRef="g-after-prem" />
    <bpmn:sequenceFlow id="f-cs-reprio-g-after-prem" sourceRef="cs-reprio" targetRef="g-after-prem" />
    <bpmn:sequenceFlow id="f-g-after-prem-cs-detail" sourceRef="g-after-prem" targetRef="cs-detail" />
    <bpmn:sequenceFlow id="f-cs-detail-sm-investigate" sourceRef="cs-detail" targetRef="sm-investigate" />
    <bpmn:sequenceFlow id="f-sm-investigate-g-analysable" sourceRef="sm-investigate" targetRef="g-analysable" />
    <bpmn:sequenceFlow id="f-g-analysable-sm-analyse" name="yes" sourceRef="g-analysable" targetRef="sm-analyse" />
    <bpmn:sequenceFlow id="f-sm-analyse-sm-trouble" sourceRef="sm-analyse" targetRef="sm-trouble" />
    <bpmn:sequenceFlow id="f-sm-trouble-g-final" sourceRef="sm-trouble" targetRef="g-final" />
    <bpmn:sequenceFlow id="f-g-analysable-sm-forward" name="no" sourceRef="g-analysable" targetRef="sm-forward" />
    <bpmn:sequenceFlow id="f-sm-forward-rp-check" sourceRef="sm-forward" targetRef="rp-check" />
    <bpmn:sequenceFlow id="f-rp-check-g-problem" sourceRef="rp-check" targetRef="g-problem" />
    <bpmn:sequenceFlow id="f-g-problem-rp-normal" name="no" sourceRef="g-problem" targetRef="rp-normal" />
    <bpmn:sequenceFlow id="f-g-problem-rp-analyse" name="yes" sourceRef="g-problem" targetRef="rp-analyse" />
    <bpmn:sequenceFlow id="f-rp-analyse-rp-trouble" sourceRef="rp-analyse" targetRef="rp-trouble" />
    <bpmn:sequenceFlow id="f-rp-trouble-g-rp-merge" sourceRef="rp-trouble" targetRef="g-rp-merge" />
    <bpmn:sequenceFlow id="f-rp-normal-g-rp-merge" sourceRef="rp-normal" targetRef="g-rp-merge" />
    <bpmn:sequenceFlow id="f-g-rp-merge-rp-status" sourceRef="g-rp-merge" targetRef="rp-status" />
    <bpmn:sequenceFlow id="f-rp-status-g-rp-split" sourceRef="rp-status" targetRef="g-rp-split" />
    <bpmn:sequenceFlow id="f-g-rp-split-rp-send-status" sourceRef="g-rp-split" targetRef="rp-send-status" />
    <bpmn:sequenceFlow id="f-rp-send-status-g-final" sourceRef="rp-send-status" targetRef="g-final" />
    <bpmn:sequenceFlow id="f-g-rp-split-rp-wait" sourceRef="g-rp-split" targetRef="rp-wait" />
    <bpmn:sequenceFlow id="f-rp-wait-rp-restore" sourceRef="rp-wait" targetRef="rp-restore" />
    <bpmn:sequenceFlow id="f-rp-restore-rp-track" sourceRef="rp-restore" targetRef="rp-track" />
    <bpmn:sequenceFlow id="f-rp-track-rp-correct" sourceRef="rp-track" targetRef="rp-correct" />
    <bpmn:sequenceFlow id="f-rp-correct-rp-tsr" sourceRef="rp-correct" targetRef="rp-tsr" />
    <bpmn:sequenceFlow id="f-rp-tsr-rp-send-tsr" sourceRef="rp-tsr" targetRef="rp-send-tsr" />
    <bpmn:sequenceFlow id="f-rp-send-tsr-sm-recv-tsr" sourceRef="rp-send-tsr" targetRef="sm-recv-tsr" />
    <bpmn:sequenceFlow id="f-sm-recv-tsr-g-res-merge" sourceRef="sm-recv-tsr" targetRef="g-res-merge" />
    <bpmn:sequenceFlow id="f-rp-wait-rp-timeout" sourceRef="rp-wait" targetRef="rp-timeout" />
    <bpmn:sequenceFlow id="f-rp-timeout-rp-terminate" sourceRef="rp-timeout" targetRef="rp-terminate" />
    <bpmn:sequenceFlow id="f-g-final-sm-final" sourceRef="g-final" targetRef="sm-final" />
    <bpmn:sequenceFlow id="f-sm-final-sm-determine" sourceRef="sm-final" targetRef="sm-determine" />
    <bpmn:sequenceFlow id="f-sm-determine-g-measures" sourceRef="sm-determine" targetRef="g-measures" />
    <bpmn:sequenceFlow id="f-g-measures-sm-send-perf" name="no problem detected" sourceRef="g-measures" targetRef="sm-send-perf" />
    <bpmn:sequenceFlow id="f-g-measures-sm-correct" name="minor corrective actions" sourceRef="g-measures" targetRef="sm-correct" />
    <bpmn:sequenceFlow id="f-g-measures-sm-restore" name="automatic restoration" sourceRef="g-measures" targetRef="sm-restore" />
    <bpmn:sequenceFlow id="f-sm-send-perf-g-cs-merge" sourceRef="sm-send-perf" targetRef="g-cs-merge" />
    <bpmn:sequenceFlow id="f-sm-correct-g-res-merge" sourceRef="sm-correct" targetRef="g-res-merge" />
    <bpmn:sequenceFlow id="f-g-res-merge-sm-resolution" sourceRef="g-res-merge" targetRef="sm-resolution" />
    <bpmn:sequenceFlow id="f-sm-resolution-sm-send-res" sourceRef="sm-resolution" targetRef="sm-send-res" />
    <bpmn:sequenceFlow id="f-sm-send-res-g-cs-merge" sourceRef="sm-send-res" targetRef="g-cs-merge" />
    <bpmn:sequenceFlow id="f-sm-restore-sm-send-restore" sourceRef="sm-restore" targetRef="sm-send-restore" />
    <bpmn:sequenceFlow id="f-sm-send-restore-sm-restore-end" sourceRef="sm-send-restore" targetRef="sm-restore-end" />
    <bpmn:sequenceFlow id="f-g-cs-merge-g-cs-split" sourceRef="g-cs-merge" targetRef="g-cs-split" />
    <bpmn:sequenceFlow id="f-g-cs-split-cs-report" sourceRef="g-cs-split" targetRef="cs-report" />
    <bpmn:sequenceFlow id="f-cs-report-cs-send-report" sourceRef="cs-report" targetRef="cs-send-report" />
    <bpmn:sequenceFlow id="f-cs-send-report-g-cs-join" sourceRef="cs-send-report" targetRef="g-cs-join" />
    <bpmn:sequenceFlow id="f-g-cs-split-cs-rebate" sourceRef="g-cs-split" targetRef="cs-rebate" />
    <bpmn:sequenceFlow id="f-cs-rebate-bc-adjust" sourceRef="cs-rebate" targetRef="bc-adjust" />
    <bpmn:sequenceFlow id="f-bc-adjust-g-cs-join" sourceRef="bc-adjust" targetRef="g-cs-join" />
    <bpmn:sequenceFlow id="f-g-cs-join-cs-end" sourceRef="g-cs-join" targetRef="cs-end" />
  </bpmn:process>
  <bpmn:process id="customer-process" name="Customer" isExecutable="false">
    <bpmn:laneSet id="customer-lanes">
      <bpmn:lane id="cu" name="Customer">
        <bpmn:flowNodeRef>c-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c-perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c-send-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c-recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c-start" name="Service degradation" />
    <bpmn:task id="c-perceive" name="Perceive service degradation" />
    <bpmn:task id="c-send-list" name="Send list of problem parameters" />
    <bpmn:intermediateCatchEvent id="c-recv" name="Receive service performance and problem resolution report">
      <bpmn:messageEventDefinition id="c-recv-def" messageRef="Message_Service_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c-end" name="Customer process ends" />
    <bpmn:sequenceFlow id="f-c-start-c-perceive" sourceRef="c-start" targetRef="c-perceive" />
    <bpmn:sequenceFlow id="f-c-perceive-c-send-list" sourceRef="c-perceive" targetRef="c-send-list" />
    <bpmn:sequenceFlow id="f-c-send-list-c-recv" sourceRef="c-send-list" targetRef="c-recv" />
    <bpmn:sequenceFlow id="f-c-recv-c-end" sourceRef="c-recv" targetRef="c-end" />
  </bpmn:process>
</bpmn:definitions>
