tok 1.0 "Warrant possession request"

pool party "Party"
pool police "Queensland Police"
pool mcs "MC internal staff"

pool org "Small Claims Registry Operations"
  lane bo "Client Service Back Office"
    start s "Start"
    receive rq "Receive warrant possession request" message="Warrant possession request"
    task rf "Retrieve SCT file"
    send fw "Forward SCT Warrant Possession to Queensland Police" message="SCT Warrant Possession"
    task sp "Store SCT physical file awaiting police report"
    receive rp "Receive police report" message="Police report"
    task rr "Retrieve respective SCT file"
    task at "Attach new SCT document"
    task se "Store expanded SCT physical file"
    send ho "Hand over physical SCT file to MC internal staff" message="Physical SCT file"
    end e "End"

flow s -> rq -> rf -> fw -> sp -> rp -> rr -> at -> se -> ho -> e

message party -> rq "Warrant possession request"
message fw -> police "SCT Warrant Possession"
message police -> rp "Police report"
message ho -> mcs "Physical SCT file"
