<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Warrant_possession_request" name="Warrant possession request" />
  <bpmn:message id="Message_SCT_Warrant_Possession" name="SCT Warrant Possession" />
  <bpmn:message id="Message_Police_report" name="Police report" />
  <bpmn:message id="Message_Physical_SCT_file" name="Physical SCT file" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="party" name="Party" />
    <bpmn:participant id="police" name="Queensland Police" />
    <bpmn:participant id="mcs" name="MC internal staff" />
    <bpmn:participant id="org" name="Small Claims Registry Operations" processRef="org-process" />
    <bpmn:messageFlow id="m-party-rq" name="Warrant possession request" sourceRef="party" targetRef="rq" messageRef="Message_Warrant_possession_request" />
    <bpmn:messageFlow id="m-fw-police" name="SCT Warrant Possession" sourceRef="fw" targetRef="police" messageRef="Message_SCT_Warrant_Possession" />
    <bpmn:messageFlow id="m-police-rp" name="Police report" sourceRef="police" targetRef="rp" messageRef="Message_Police_report" />
    <bpmn:messageFlow id="m-ho-mcs" name="Physical SCT file" sourceRef="ho" targetRef="mcs" messageRef="Message_Physical_SCT_file" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Warrant possession request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="bo" name="Client Service Back Office">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>at</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>se</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:receiveTask id="rq" name="Receive warrant possession request" messageRef="Message_Warrant_possession_request" />
    <bpmn:task id="rf" name="Retrieve SCT file" />
    <bpmn:sendTask id="fw" name="Forward SCT Warrant Possession to Queensland Police" messageRef="Message_SCT_Warrant_Possession" />
    <bpmn:task id="sp" name="Store SCT physical file awaiting police report" />
    <bpmn:receiveTask id="rp" name="Receive police report" messageRef="Message_Police_report" />
    <bpmn:task id="rr" name="Retrieve respective SCT file" />
    <bpmn:task id="at" name="Attach new SCT document" />
    <bpmn:task id="se" name="Store expanded SCT physical file" />
    <bpmn:sendTask id="ho" name="Hand over physical SCT file to MC internal staff" messageRef="Message_Physical_SCT_file" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-rq" sourceRef="s" targetRef="rq" />
    <bpmn:sequenceFlow id="f-rq-rf" sourceRef="rq" targetRef="rf" />
    <bpmn:sequenceFlow id="f-rf-fw" sourceRef="rf" targetRef="fw" />
    <bpmn:sequenceFlow id="f-fw-sp" sourceRef="fw" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-rp" sourceRef="sp" targetRef="rp" />
    <bpmn:sequenceFlow id="f-rp-rr" sourceRef="rp" targetRef="rr" />
    <bpmn:sequenceFlow id="f-rr-at" sourceRef="rr" targetRef="at" />
    <bpmn:sequenceFlow id="f-at-se" sourceRef="at" targetRef="se" />
    <bpmn:sequenceFlow id="f-se-ho" sourceRef="se" targetRef="ho" />
    <bpmn:sequenceFlow id="f-ho-e" sourceRef="ho" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
