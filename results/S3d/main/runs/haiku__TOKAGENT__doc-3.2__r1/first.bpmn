<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Court hearing file preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court registry" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court hearing file preparation" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="clerk" name="Registry clerk">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>files-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover-files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="judge" name="Judge">
        <bpmn:flowNodeRef>directions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-hearings</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Each morning" />
    <bpmn:task id="check-files" name="Check the files for the day's hearing" />
    <bpmn:exclusiveGateway id="missing-q" name="Are any files missing?" default="f-missing-q-track-files" />
    <bpmn:task id="search-files" name="Search for missing files" />
    <bpmn:task id="track-files" name="Track the files to the intended location" />
    <bpmn:exclusiveGateway id="files-merge" />
    <bpmn:parallelGateway id="split-ready" />
    <bpmn:task id="handover-files" name="Hand the files to the Associate" />
    <bpmn:task id="lawlist" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="join-ready" />
    <bpmn:task id="directions" name="Conduct the directions hearings" />
    <bpmn:endEvent id="end-hearings" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f-morning-check-files" sourceRef="morning" targetRef="check-files" />
    <bpmn:sequenceFlow id="f-check-files-missing-q" sourceRef="check-files" targetRef="missing-q" />
    <bpmn:sequenceFlow id="f-missing-q-search-files" name="Yes" sourceRef="missing-q" targetRef="search-files">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">missing_files = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-q-track-files" name="No" sourceRef="missing-q" targetRef="track-files" />
    <bpmn:sequenceFlow id="f-search-files-files-merge" sourceRef="search-files" targetRef="files-merge" />
    <bpmn:sequenceFlow id="f-track-files-files-merge" sourceRef="track-files" targetRef="files-merge" />
    <bpmn:sequenceFlow id="f-files-merge-split-ready" sourceRef="files-merge" targetRef="split-ready" />
    <bpmn:sequenceFlow id="f-split-ready-handover-files" sourceRef="split-ready" targetRef="handover-files" />
    <bpmn:sequenceFlow id="f-split-ready-lawlist" sourceRef="split-ready" targetRef="lawlist" />
    <bpmn:sequenceFlow id="f-handover-files-join-ready" sourceRef="handover-files" targetRef="join-ready" />
    <bpmn:sequenceFlow id="f-lawlist-join-ready" sourceRef="lawlist" targetRef="join-ready" />
    <bpmn:sequenceFlow id="f-join-ready-directions" sourceRef="join-ready" targetRef="directions" />
    <bpmn:sequenceFlow id="f-directions-end-hearings" sourceRef="directions" targetRef="end-hearings" />
  </bpmn:process>
</bpmn:definitions>
