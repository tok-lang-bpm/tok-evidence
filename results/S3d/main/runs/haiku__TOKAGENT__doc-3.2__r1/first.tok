tok 1.0 "Court hearing file preparation"

pool court "Court registry"
  lane clerk "Registry clerk"
    start morning "Each morning"
    task check-files "Check the files for the day's hearing"
    xor missing-q "Are any files missing?"
    task search-files "Search for missing files"
    task track-files "Track the files to the intended location"
    xor files-merge
    and split-ready
    task handover-files "Hand the files to the Associate"
    task lawlist "Distribute the Judge's Lawlist to the relevant people"
    and join-ready
  lane judge "Judge"
    task directions "Conduct the directions hearings"
    end end-hearings "Directions hearings conducted"

flow morning -> check-files -> missing-q
flow missing-q -> search-files "Yes" when="missing_files = true"
flow missing-q -> track-files "No" default
flow search-files -> files-merge
flow track-files -> files-merge
flow files-merge -> split-ready
flow split-ready -> handover-files
flow split-ready -> lawlist
flow handover-files -> join-ready
flow lawlist -> join-ready
flow join-ready -> directions -> end-hearings
