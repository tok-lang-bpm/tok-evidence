<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="officer" name="Claims officer">
        <bpmn:flowNodeRef>claim-registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim-registered" name="Claim registered" />
    <bpmn:task id="examine" name="Examine claim" />
    <bpmn:task id="recommend" name="Write settlement recommendation" />
    <bpmn:task id="check" name="Check settlement recommendation" />
    <bpmn:exclusiveGateway id="verdict" name="Claim OK?" default="f-verdict-proceed" />
    <bpmn:endEvent id="proceed" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-claim-registered-examine" sourceRef="claim-registered" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-recommend" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-check" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-verdict" sourceRef="check" targetRef="verdict" />
    <bpmn:sequenceFlow id="f-verdict-recommend" name="Not OK" sourceRef="verdict" targetRef="recommend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mark = "Not OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-verdict-proceed" name="OK" sourceRef="verdict" targetRef="proceed" />
  </bpmn:process>
</bpmn:definitions>
