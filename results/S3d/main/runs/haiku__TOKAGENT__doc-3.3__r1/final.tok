tok 1.0 "Claim handling"

pool org "Insurance company"
  lane officer "Claims officer"
    start claim-registered "Claim registered"
    task examine "Examine claim"
    task recommend "Write settlement recommendation"
  lane senior "Senior claims officer"
    task check "Check settlement recommendation"
    xor verdict "Claim OK?"
    end proceed "Claim handling proceeds"

flow claim-registered -> examine -> recommend -> check -> verdict
flow verdict -> recommend "Not OK" when="mark = \"Not OK\""
flow verdict -> proceed "OK" default
