<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Handling incoming court mail" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Court Registry" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Handling incoming court mail" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mailclerk" name="Mail Clerk">
        <bpmn:flowNodeRef>s-mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort-areas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort-groups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="arm" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture-party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s-mail" name="Mail from the party collected daily" />
    <bpmn:task id="collect" name="Collect mail from the party" />
    <bpmn:task id="sort-areas" name="Sort unopened mail into business areas" />
    <bpmn:task id="distribute" name="Distribute mail" />
    <bpmn:task id="receive" name="Receive mail" />
    <bpmn:task id="open" name="Open mail" />
    <bpmn:task id="sort-groups" name="Sort mail into groups for distribution" />
    <bpmn:task id="register" name="Register mail in manual incoming Mail Register" />
    <bpmn:task id="qc" name="Perform quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Is the mail compliant?" default="f-compliant-capture" />
    <bpmn:task id="compile" name="Compile list of requisition with reason for rejection" />
    <bpmn:task id="send-req" name="Send list of requisition to party" />
    <bpmn:endEvent id="e-rejected" name="Mail rejected" />
    <bpmn:task id="capture" name="Capture matter details (types of action)" />
    <bpmn:task id="envelope" name="Put receipt and copied documents into envelope" />
    <bpmn:task id="post" name="Post envelope to party" />
    <bpmn:task id="fees" name="Take applicable fees" />
    <bpmn:parallelGateway id="split-fees" />
    <bpmn:task id="capture-party" name="Capture party details" />
    <bpmn:task id="print" name="Print physical court file" />
    <bpmn:parallelGateway id="join-fees" />
    <bpmn:endEvent id="e-done" name="Mail processed" />
    <bpmn:sequenceFlow id="f-s-mail-collect" sourceRef="s-mail" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sort-areas" sourceRef="collect" targetRef="sort-areas" />
    <bpmn:sequenceFlow id="f-sort-areas-distribute" sourceRef="sort-areas" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-receive" sourceRef="distribute" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-open" sourceRef="receive" targetRef="open" />
    <bpmn:sequenceFlow id="f-open-sort-groups" sourceRef="open" targetRef="sort-groups" />
    <bpmn:sequenceFlow id="f-sort-groups-register" sourceRef="sort-groups" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-qc" sourceRef="register" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-compliant" sourceRef="qc" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-compile" name="no" sourceRef="compliant" targetRef="compile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compliant = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-compliant-capture" name="yes" sourceRef="compliant" targetRef="capture" />
    <bpmn:sequenceFlow id="f-compile-send-req" sourceRef="compile" targetRef="send-req" />
    <bpmn:sequenceFlow id="f-send-req-e-rejected" sourceRef="send-req" targetRef="e-rejected" />
    <bpmn:sequenceFlow id="f-capture-fees" sourceRef="capture" targetRef="fees" />
    <bpmn:sequenceFlow id="f-fees-split-fees" sourceRef="fees" targetRef="split-fees" />
    <bpmn:sequenceFlow id="f-split-fees-envelope" sourceRef="split-fees" targetRef="envelope" />
    <bpmn:sequenceFlow id="f-envelope-post" sourceRef="envelope" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-join-fees" sourceRef="post" targetRef="join-fees" />
    <bpmn:sequenceFlow id="f-split-fees-capture-party" sourceRef="split-fees" targetRef="capture-party" />
    <bpmn:sequenceFlow id="f-capture-party-print" sourceRef="capture-party" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-join-fees" sourceRef="print" targetRef="join-fees" />
    <bpmn:sequenceFlow id="f-join-fees-e-done" sourceRef="join-fees" targetRef="e-done" />
  </bpmn:process>
</bpmn:definitions>
