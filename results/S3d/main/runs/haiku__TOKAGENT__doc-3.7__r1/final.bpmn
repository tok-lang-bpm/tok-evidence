<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:dataStore id="db-store" name="Police Report database" />
  <bpmn:dataStore id="checklist-store" name="Action Plan Checklist" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Car accident claim" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="handler" name="Claims handler">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Claim documentation received" />
    <bpmn:task id="search" name="Search Police Report">
      <bpmn:documentation>The Police Report related to the car accident is searched; the text names no actor, so the step is placed with the claims handler, who receives the file.</bpmn:documentation>
      <bpmn:ioSpecification id="search-io">
        <bpmn:dataInput id="search-in-1" name="Police Report database" />
        <bpmn:inputSet id="search-inputs">
          <bpmn:dataInputRefs>search-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="search-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="search-dia-1">
        <bpmn:sourceRef>db</bpmn:sourceRef>
        <bpmn:targetRef>search-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="file" name="Put Police Report and Claim Documentation in file" />
    <bpmn:userTask id="estimate" name="Calculate initial claim estimate" />
    <bpmn:userTask id="plan" name="Create Action Plan">
      <bpmn:ioSpecification id="plan-io">
        <bpmn:dataInput id="plan-in-2" name="Action Plan Checklist" />
        <bpmn:inputSet id="plan-inputs">
          <bpmn:dataInputRefs>plan-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="plan-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="plan-dia-2">
        <bpmn:sourceRef>checklist</bpmn:sourceRef>
        <bpmn:targetRef>plan-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="negotiate" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="inform" name="Inform claimant of outcome" />
    <bpmn:endEvent id="e" name="Claim process ended" />
    <bpmn:sequenceFlow id="f-s-search" sourceRef="s" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-file" sourceRef="search" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-estimate" sourceRef="file" targetRef="estimate" />
    <bpmn:sequenceFlow id="f-estimate-plan" sourceRef="estimate" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-negotiate" sourceRef="plan" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-inform" sourceRef="negotiate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-e" sourceRef="inform" targetRef="e" />
    <bpmn:dataStoreReference id="db" name="Police Report database" dataStoreRef="db-store" />
    <bpmn:dataStoreReference id="checklist" name="Action Plan Checklist" dataStoreRef="checklist-store" />
  </bpmn:process>
</bpmn:definitions>
