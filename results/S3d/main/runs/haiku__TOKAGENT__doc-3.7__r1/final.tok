tok 1.0 "Car accident claim"

store db "Police Report database"
store checklist "Action Plan Checklist"

pool org "Insurance company"
  lane handler "Claims handler"
    start s "Claim documentation received"
    task search "Search Police Report" doc="The Police Report related to the car accident is searched; the text names no actor, so the step is placed with the claims handler, who receives the file."
    task file "Put Police Report and Claim Documentation in file"
    user estimate "Calculate initial claim estimate"
    user plan "Create Action Plan"
  lane manager "Claims manager"
    user negotiate "Negotiate settlement on claim estimate"
    task inform "Inform claimant of outcome"
    end e "Claim process ended"

flow s -> search -> file -> estimate -> plan -> negotiate -> inform -> e

reads search db
reads plan checklist
