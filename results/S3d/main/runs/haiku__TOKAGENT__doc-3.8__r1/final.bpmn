<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Car insurance claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car insurance claim" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>claim-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>check-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>pick-up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim-start" name="Claim submission" />
    <bpmn:task id="submit" name="Submit claim" />
    <bpmn:task id="check-docs" name="Check documents for completeness" />
    <bpmn:task id="register" name="Register claim" />
    <bpmn:task id="pick-up" name="Pick up claim" />
    <bpmn:task id="check-ins" name="Check insurance" />
    <bpmn:task id="assess" name="Perform assessment" />
    <bpmn:exclusiveGateway id="positive" name="Assessment positive?" default="f-positive-reject" />
    <bpmn:task id="phone" name="Phone garage to authorise repairs" />
    <bpmn:task id="pay" name="Schedule payment" />
    <bpmn:task id="reject" name="Reject claim" />
    <bpmn:exclusiveGateway id="merge-outcome" name="Outcome known" />
    <bpmn:task id="letter" name="Send letter to customer" />
    <bpmn:endEvent id="done" name="Process complete" />
    <bpmn:sequenceFlow id="f-claim-start-submit" sourceRef="claim-start" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check-docs" sourceRef="submit" targetRef="check-docs" />
    <bpmn:sequenceFlow id="f-check-docs-register" sourceRef="check-docs" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-pick-up" sourceRef="register" targetRef="pick-up" />
    <bpmn:sequenceFlow id="f-pick-up-check-ins" sourceRef="pick-up" targetRef="check-ins" />
    <bpmn:sequenceFlow id="f-check-ins-assess" sourceRef="check-ins" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-positive" sourceRef="assess" targetRef="positive" />
    <bpmn:sequenceFlow id="f-positive-phone" name="yes" sourceRef="positive" targetRef="phone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">positive = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-positive-reject" name="no" sourceRef="positive" targetRef="reject" />
    <bpmn:sequenceFlow id="f-phone-pay" sourceRef="phone" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-merge-outcome" sourceRef="pay" targetRef="merge-outcome" />
    <bpmn:sequenceFlow id="f-reject-merge-outcome" sourceRef="reject" targetRef="merge-outcome" />
    <bpmn:sequenceFlow id="f-merge-outcome-letter" sourceRef="merge-outcome" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-done" sourceRef="letter" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
