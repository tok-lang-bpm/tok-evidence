tok 1.0 "Car insurance claim"

pool insurer "Car insurer"
  lane customer "Customer"
    start claim-start "Claim submission"
    task submit "Submit claim"
  lane notification "Notification department"
    task check-docs "Check documents for completeness"
    task register "Register claim"
  lane handling "Handling department"
    task pick-up "Pick up claim"
    task check-ins "Check insurance"
    task assess "Perform assessment"
    xor positive "Assessment positive?"
    task phone "Phone garage to authorise repairs"
    task pay "Schedule payment"
    task reject "Reject claim"
    xor merge-outcome "Outcome known"
    task letter "Send letter to customer"
    end done "Process complete"

flow claim-start -> submit -> check-docs -> register -> pick-up -> check-ins -> assess -> positive
flow positive -> phone "yes" when="positive = true"
flow positive -> reject "no" default
flow phone -> pay -> merge-outcome
flow reject -> merge-outcome -> letter -> done
