<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Intake procedure of the mental health care institute" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Telephone_notice" name="Telephone notice" />
  <bpmn:message id="Message_Request_for_copy_of_medical_file" name="Request for copy of medical file" />
  <bpmn:message id="Message_Copy_of_medical_file" name="Copy of medical file" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="doc" name="Family doctor" />
    <bpmn:participant id="inst" name="Mental health care institute" processRef="inst-process" />
    <bpmn:messageFlow id="m-doc-s0" name="Telephone notice" sourceRef="doc" targetRef="s0" messageRef="Message_Telephone_notice" />
    <bpmn:messageFlow id="m-letter-doc" name="Request for copy of medical file" sourceRef="letter" targetRef="doc" messageRef="Message_Request_for_copy_of_medical_file" />
    <bpmn:messageFlow id="m-doc-copy-rcv" name="Copy of medical file" sourceRef="doc" targetRef="copy-rcv" messageRef="Message_Copy_of_medical_file" />
  </bpmn:collaboration>
  <bpmn:process id="inst-process" name="Intake procedure of the mental health care institute" isExecutable="false">
    <bpmn:laneSet id="inst-lanes">
      <bpmn:lane id="sec" name="Secretarial office">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-through</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new-pat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make-cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>med-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copy-rcv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store-assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass-cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type-tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-tape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-list</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nurse" name="Nursing officer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record-form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-in</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team leader">
        <bpmn:flowNodeRef>staff-meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record-assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>med-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>treatment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first" name="Social-medical worker (first intaker)">
        <bpmn:flowNodeRef>first-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first-meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first-notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first-check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second" name="Physician (second intaker)">
        <bpmn:flowNodeRef>second-plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second-meet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Telephone notice received">
      <bpmn:messageEventDefinition id="s0-def" messageRef="Message_Telephone_notice" />
    </bpmn:startEvent>
    <bpmn:task id="inquire" name="Inquire name and residence of patient" />
    <bpmn:task id="put-through" name="Put doctor through to responsible nursing officer" />
    <bpmn:task id="store-info" name="Store information of registration form in information system" />
    <bpmn:task id="print-info" name="Print information from information system" />
    <bpmn:exclusiveGateway id="new-pat" name="New patient?" default="f-new-pat-m1" />
    <bpmn:task id="create-file" name="Create patient file" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="store-file" name="Store registration form and print in patient file" />
    <bpmn:task id="make-cards" name="Produce two registration cards" />
    <bpmn:task id="add-list" name="Add new patient to list of new notices" />
    <bpmn:exclusiveGateway id="med-req" name="Medical file required?" default="f-med-req-m2" />
    <bpmn:task id="letter" name="Prepare and send letter to family doctor requesting copy of medical file" />
    <bpmn:intermediateCatchEvent id="copy-rcv" name="Copy of medical file received">
      <bpmn:messageEventDefinition id="copy-rcv-def" messageRef="Message_Copy_of_medical_file" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inform-second" name="Inform second intaker that copy is received" />
    <bpmn:task id="add-copy" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="store-assign" name="Store assignment of each patient in information system" />
    <bpmn:task id="pass-cards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="type-tapes" name="Type out dictaphone tapes" />
    <bpmn:task id="add-tape" name="Add typed information to patient file" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="list-status" name="Put patient on list of patients that reach this status" />
    <bpmn:task id="provide-list" name="Provide team leader with list of these patients" />
    <bpmn:task id="inquiry" name="Make full inquiry into mental, health and social state of patient" />
    <bpmn:task id="record-form" name="Record information on registration form" />
    <bpmn:task id="hand-in" name="Hand in registration form at secretarial office" />
    <bpmn:task id="staff-meeting" name="Hold Wednesday staff meeting of the medical team" />
    <bpmn:task id="assign" name="Assign each new patient to a first and a second intaker" />
    <bpmn:task id="record-assign" name="Record assignments on assignment list" />
    <bpmn:task id="med-check" name="Determine whether medical file is required and add it to assignment list" />
    <bpmn:task id="treatment" name="Formulate treatment plan with first and second intaker, team leader and attending psychiatrist" />
    <bpmn:task id="first-plan" name="Plan first meeting with patient as soon as possible" />
    <bpmn:task id="first-meet" name="Examine patient with standard checklist and register additional observations in personal notebook" />
    <bpmn:task id="first-notes" name="Put copy of notes in patient file" />
    <bpmn:task id="first-check" name="Add standard checklist to patient file" />
    <bpmn:task id="second-plan" name="Plan first meeting with patient after medical information has been received" />
    <bpmn:task id="second-meet" name="Hold first meeting with patient and record observations on dictaphone" />
    <bpmn:sequenceFlow id="f-s0-inquire" sourceRef="s0" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-put-through" sourceRef="inquire" targetRef="put-through" />
    <bpmn:sequenceFlow id="f-put-through-inquiry" sourceRef="put-through" targetRef="inquiry" />
    <bpmn:sequenceFlow id="f-inquiry-record-form" sourceRef="inquiry" targetRef="record-form" />
    <bpmn:sequenceFlow id="f-record-form-hand-in" sourceRef="record-form" targetRef="hand-in" />
    <bpmn:sequenceFlow id="f-hand-in-store-info" sourceRef="hand-in" targetRef="store-info" />
    <bpmn:sequenceFlow id="f-store-info-print-info" sourceRef="store-info" targetRef="print-info" />
    <bpmn:sequenceFlow id="f-print-info-new-pat" sourceRef="print-info" targetRef="new-pat" />
    <bpmn:sequenceFlow id="f-new-pat-create-file" name="yes" sourceRef="new-pat" targetRef="create-file">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">new_patient = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-new-pat-m1" name="no" sourceRef="new-pat" targetRef="m1" />
    <bpmn:sequenceFlow id="f-create-file-m1" sourceRef="create-file" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-store-file" sourceRef="m1" targetRef="store-file" />
    <bpmn:sequenceFlow id="f-store-file-make-cards" sourceRef="store-file" targetRef="make-cards" />
    <bpmn:sequenceFlow id="f-make-cards-add-list" sourceRef="make-cards" targetRef="add-list" />
    <bpmn:sequenceFlow id="f-add-list-staff-meeting" sourceRef="add-list" targetRef="staff-meeting" />
    <bpmn:sequenceFlow id="f-staff-meeting-assign" sourceRef="staff-meeting" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-record-assign" sourceRef="assign" targetRef="record-assign" />
    <bpmn:sequenceFlow id="f-record-assign-med-check" sourceRef="record-assign" targetRef="med-check" />
    <bpmn:sequenceFlow id="f-med-check-store-assign" sourceRef="med-check" targetRef="store-assign" />
    <bpmn:sequenceFlow id="f-store-assign-pass-cards" sourceRef="store-assign" targetRef="pass-cards" />
    <bpmn:sequenceFlow id="f-pass-cards-med-req" sourceRef="pass-cards" targetRef="med-req" />
    <bpmn:sequenceFlow id="f-med-req-letter" name="yes" sourceRef="med-req" targetRef="letter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">medical_file = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-med-req-m2" name="no" sourceRef="med-req" targetRef="m2" />
    <bpmn:sequenceFlow id="f-letter-copy-rcv" sourceRef="letter" targetRef="copy-rcv" />
    <bpmn:sequenceFlow id="f-copy-rcv-inform-second" sourceRef="copy-rcv" targetRef="inform-second" />
    <bpmn:sequenceFlow id="f-inform-second-add-copy" sourceRef="inform-second" targetRef="add-copy" />
    <bpmn:sequenceFlow id="f-add-copy-m2" sourceRef="add-copy" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-fork" sourceRef="m2" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-first-plan" sourceRef="fork" targetRef="first-plan" />
    <bpmn:sequenceFlow id="f-first-plan-first-meet" sourceRef="first-plan" targetRef="first-meet" />
    <bpmn:sequenceFlow id="f-first-meet-first-notes" sourceRef="first-meet" targetRef="first-notes" />
    <bpmn:sequenceFlow id="f-first-notes-first-check" sourceRef="first-notes" targetRef="first-check" />
    <bpmn:sequenceFlow id="f-first-check-join" sourceRef="first-check" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-second-plan" sourceRef="fork" targetRef="second-plan" />
    <bpmn:sequenceFlow id="f-second-plan-second-meet" sourceRef="second-plan" targetRef="second-meet" />
    <bpmn:sequenceFlow id="f-second-meet-type-tapes" sourceRef="second-meet" targetRef="type-tapes" />
    <bpmn:sequenceFlow id="f-type-tapes-add-tape" sourceRef="type-tapes" targetRef="add-tape" />
    <bpmn:sequenceFlow id="f-add-tape-join" sourceRef="add-tape" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-list-status" sourceRef="join" targetRef="list-status" />
    <bpmn:sequenceFlow id="f-list-status-provide-list" sourceRef="list-status" targetRef="provide-list" />
    <bpmn:sequenceFlow id="f-provide-list-treatment" sourceRef="provide-list" targetRef="treatment" />
    <bpmn:textAnnotation id="nt1">
      <bpmn:text>Patient files are kept at the secretarial office and may not leave the building</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="nt1-assoc" sourceRef="nt1" targetRef="store-file" />
  </bpmn:process>
</bpmn:definitions>
