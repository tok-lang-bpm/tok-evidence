<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Vacation request" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="review" name="Review rejection reasons" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:task id="register" name="Register the requirement" />
    <bpmn:task id="notify" name="Generate notification" />
    <bpmn:task id="receive" name="Receive the request" />
    <bpmn:task id="decide" name="Approve or reject the request" />
    <bpmn:exclusiveGateway id="g" name="Request approved?" />
    <bpmn:task id="ret" name="Return the application to the employee" />
    <bpmn:task id="complete" name="Complete management procedures" />
    <bpmn:endEvent id="done" name="Vacation procedures completed" />
    <bpmn:sequenceFlow id="f-s-submit" sourceRef="s" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decide" sourceRef="receive" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-g" sourceRef="decide" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-notify" name="approved" sourceRef="g" targetRef="notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-ret" name="rejected" sourceRef="g" targetRef="ret">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ret-review" sourceRef="ret" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-rejected" sourceRef="review" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-notify-complete" sourceRef="notify" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-done" sourceRef="complete" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
