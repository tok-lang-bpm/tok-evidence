tok 1.0 "Vacations Request"
pool org "Organization"
  lane employee "Employee"
    start s "Vacation request"
    task submit "Submit vacation request"
    task review "Review rejection reasons"
    end rejected "Request rejected"
  lane system "System"
    task register "Register the requirement"
    task notify "Generate notification"
  lane supervisor "Immediate supervisor"
    task receive "Receive the request"
    task decide "Approve or reject the request"
    xor g "Request approved?"
    task ret "Return the application to the employee"
  lane hr "Human Resources Representative"
    task complete "Complete management procedures"
    end done "Vacation procedures completed"

flow s -> submit -> register -> receive -> decide -> g
flow g -> notify "approved" when="approved = true"
flow g -> ret "rejected" when="approved = false"
flow ret -> review -> rejected
flow notify -> complete -> done
