<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice processing at ACME AG" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice processing at ACME AG" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="sec" name="Secretariat">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Accounting employee">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note-cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all-ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward-comm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult-cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve-complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cc" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark-ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return-mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass-next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return-acc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="comm" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amt-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>board-check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Invoice received on paper or by fax" />
    <bpmn:task id="receive" name="Receive invoice in central inbox" />
    <bpmn:task id="inspect" name="Inspect invoice visually" />
    <bpmn:task id="forward" name="Forward invoice to accounting employee" />
    <bpmn:task id="create" name="Create invoice instance in ACME Financial Accounting" />
    <bpmn:task id="identify" name="Identify charging suppliers" />
    <bpmn:task id="check-items" name="Check invoice items" />
    <bpmn:task id="note-cc" name="Note cost center and cost center managers for each position on docket" />
    <bpmn:task id="send-first" name="Send docket and invoice copy to cost center managers" />
    <bpmn:exclusiveGateway id="all-ap" name="All positions marked AP?" />
    <bpmn:task id="forward-comm" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="consult" name="Consult cost center managers needed?" />
    <bpmn:task id="consult-cc" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="merge-consult" />
    <bpmn:exclusiveGateway id="resolved" name="All inconsistencies resolved?" />
    <bpmn:task id="resolve-complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="pay" name="Give payment instructions" />
    <bpmn:task id="close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="e-end" name="Invoice processed" />
    <bpmn:task id="review" name="Review invoice copy for accuracy" />
    <bpmn:exclusiveGateway id="accurate" name="Position accurate?" />
    <bpmn:task id="mark-ap" name="Mark position AP on docket" />
    <bpmn:task id="return-mail" name="Return invoice copy to internal mail" />
    <bpmn:exclusiveGateway id="more" name="Further cost center managers on docket?" />
    <bpmn:task id="pass-next" name="Pass invoice copy to next cost center manager" />
    <bpmn:task id="reject" name="Reject position with note and explanation on docket" />
    <bpmn:task id="return-acc" name="Return invoice copy to accounting" />
    <bpmn:task id="audit" name="Perform commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint during commercial audit?" />
    <bpmn:task id="approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="amount" name="Bill amount exceeds EUR 20?" />
    <bpmn:exclusiveGateway id="amt-merge" />
    <bpmn:task id="sig" name="Return invoice copy and docket in signature file to accounting employee" />
    <bpmn:task id="board-check" name="Check invoice again (four-eyes principle)" />
    <bpmn:sequenceFlow id="f-s-receive" sourceRef="s" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-create" sourceRef="forward" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-identify" sourceRef="create" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-check-items" sourceRef="identify" targetRef="check-items" />
    <bpmn:sequenceFlow id="f-check-items-note-cc" sourceRef="check-items" targetRef="note-cc" />
    <bpmn:sequenceFlow id="f-note-cc-send-first" sourceRef="note-cc" targetRef="send-first" />
    <bpmn:sequenceFlow id="f-send-first-review" sourceRef="send-first" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accurate" sourceRef="review" targetRef="accurate" />
    <bpmn:sequenceFlow id="f-accurate-mark-ap" name="yes" sourceRef="accurate" targetRef="mark-ap" />
    <bpmn:sequenceFlow id="f-accurate-reject" name="no" sourceRef="accurate" targetRef="reject" />
    <bpmn:sequenceFlow id="f-mark-ap-return-mail" sourceRef="mark-ap" targetRef="return-mail" />
    <bpmn:sequenceFlow id="f-return-mail-more" sourceRef="return-mail" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-pass-next" name="yes" sourceRef="more" targetRef="pass-next" />
    <bpmn:sequenceFlow id="f-pass-next-review" sourceRef="pass-next" targetRef="review" />
    <bpmn:sequenceFlow id="f-more-return-acc" name="no" sourceRef="more" targetRef="return-acc" />
    <bpmn:sequenceFlow id="f-reject-return-acc" sourceRef="reject" targetRef="return-acc" />
    <bpmn:sequenceFlow id="f-return-acc-all-ap" sourceRef="return-acc" targetRef="all-ap" />
    <bpmn:sequenceFlow id="f-all-ap-forward-comm" name="yes" sourceRef="all-ap" targetRef="forward-comm" />
    <bpmn:sequenceFlow id="f-all-ap-clarify" name="no" sourceRef="all-ap" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consult" sourceRef="clarify" targetRef="consult" />
    <bpmn:sequenceFlow id="f-consult-consult-cc" name="yes" sourceRef="consult" targetRef="consult-cc" />
    <bpmn:sequenceFlow id="f-consult-merge-consult" name="no" sourceRef="consult" targetRef="merge-consult" />
    <bpmn:sequenceFlow id="f-consult-cc-merge-consult" sourceRef="consult-cc" targetRef="merge-consult" />
    <bpmn:sequenceFlow id="f-merge-consult-resolved" sourceRef="merge-consult" targetRef="resolved" />
    <bpmn:sequenceFlow id="f-resolved-clarify" name="no" sourceRef="resolved" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-resolved-send-first" name="yes" sourceRef="resolved" targetRef="send-first" />
    <bpmn:sequenceFlow id="f-forward-comm-audit" sourceRef="forward-comm" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve-complaint" name="yes" sourceRef="complaint" targetRef="resolve-complaint" />
    <bpmn:sequenceFlow id="f-resolve-complaint-audit" sourceRef="resolve-complaint" targetRef="audit" />
    <bpmn:sequenceFlow id="f-complaint-approve" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-amount" sourceRef="approve" targetRef="amount" />
    <bpmn:sequenceFlow id="f-amount-board-check" name="yes" sourceRef="amount" targetRef="board-check" />
    <bpmn:sequenceFlow id="f-amount-amt-merge" name="no" sourceRef="amount" targetRef="amt-merge" />
    <bpmn:sequenceFlow id="f-board-check-amt-merge" sourceRef="board-check" targetRef="amt-merge" />
    <bpmn:sequenceFlow id="f-amt-merge-sig" sourceRef="amt-merge" targetRef="sig" />
    <bpmn:sequenceFlow id="f-sig-pay" sourceRef="sig" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-close" sourceRef="pay" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-e-end" sourceRef="close" targetRef="e-end" />
  </bpmn:process>
</bpmn:definitions>
