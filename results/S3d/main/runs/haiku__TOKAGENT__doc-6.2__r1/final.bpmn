<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Monthly procurement order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Assembler AG" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Monthly procurement order" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="buyer" name="Assembler AG">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sup" name="Supplier">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="First of each month">
      <bpmn:timerEventDefinition id="s-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="a" name="Send order to supplier" />
    <bpmn:task id="d" name="Receive invoice" />
    <bpmn:endEvent id="e" name="Invoice received" />
    <bpmn:task id="b" name="Process order" />
    <bpmn:task id="c" name="Send invoice to Assembler AG" />
    <bpmn:sequenceFlow id="f-s-a" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="f-a-b" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="f-b-c" sourceRef="b" targetRef="c" />
    <bpmn:sequenceFlow id="f-c-d" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-e" sourceRef="d" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
