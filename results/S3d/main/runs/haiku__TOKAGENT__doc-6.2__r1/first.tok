tok 1.0 "Monthly procurement order"

pool org "Assembler AG"
  lane buyer "Assembler AG"
    start s "First of each month" timer="R/P1M"
    task a "Send order to supplier"
    task d "Receive invoice"
    end e "Invoice received"
  lane sup "Supplier"
    task b "Process order"
    task c "Send invoice to Assembler AG"

flow s -> a -> b -> c -> d -> e
