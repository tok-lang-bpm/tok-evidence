<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_contacts_us" name="Customer contacts us" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="sales" name="Sales organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-source-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="call" name="Call center staff">
        <bpmn:flowNodeRef>call-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dev" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>pres-tech</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Sales representative">
        <bpmn:flowNodeRef>g-final-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not-interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pres-sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-pres-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>came-back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer-2w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call-again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Contact details needed" />
    <bpmn:exclusiveGateway id="g-source" name="Way to get contact details?" />
    <bpmn:task id="buy-details" name="Buy details for cold calls" />
    <bpmn:task id="exhibition" name="Participate in exhibitions" />
    <bpmn:task id="referral" name="Note contact of an interested acquaintance" />
    <bpmn:exclusiveGateway id="g-source-join" />
    <bpmn:task id="call-customer" name="Call the customer" />
    <bpmn:task id="determine" name="Determine contact person and budget" />
    <bpmn:task id="ask-interest" name="Ask whether customer is generally interested" />
    <bpmn:exclusiveGateway id="g-interest" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="g-budget" name="Potential project budget huge?" />
    <bpmn:endEvent id="leave" name="Leave customer alone" />
    <bpmn:task id="acquire" name="Acquire customer personally" />
    <bpmn:task id="pres-tech" name="Give detailed online presentation (technical)" />
    <bpmn:exclusiveGateway id="g-final-join" />
    <bpmn:exclusiveGateway id="g-final" name="Customer interested in the end?" />
    <bpmn:endEvent id="not-interested" name="Customer not interested" />
    <bpmn:exclusiveGateway id="g-tech" name="Technical presentation needed?" />
    <bpmn:task id="pres-sales" name="Give detailed online presentation" />
    <bpmn:exclusiveGateway id="g-pres-join" />
    <bpmn:eventBasedGateway id="wait" name="Wait for customer to come back" />
    <bpmn:intermediateCatchEvent id="came-back" name="Customer contacts us">
      <bpmn:messageEventDefinition id="came-back-def" messageRef="Message_Customer_contacts_us" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer-2w" name="2 weeks without contact">
      <bpmn:timerEventDefinition id="timer-2w-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="call-again" name="Call the customer" />
    <bpmn:exclusiveGateway id="g-contact" />
    <bpmn:task id="quote" name="Create quotation" />
    <bpmn:endEvent id="done" name="Quotation created" />
    <bpmn:sequenceFlow id="f-s-g-source" sourceRef="s" targetRef="g-source" />
    <bpmn:sequenceFlow id="f-g-source-buy-details" name="Cold calls" sourceRef="g-source" targetRef="buy-details" />
    <bpmn:sequenceFlow id="f-g-source-exhibition" name="Exhibition" sourceRef="g-source" targetRef="exhibition" />
    <bpmn:sequenceFlow id="f-g-source-referral" name="Acquaintance" sourceRef="g-source" targetRef="referral" />
    <bpmn:sequenceFlow id="f-buy-details-g-source-join" sourceRef="buy-details" targetRef="g-source-join" />
    <bpmn:sequenceFlow id="f-exhibition-g-source-join" sourceRef="exhibition" targetRef="g-source-join" />
    <bpmn:sequenceFlow id="f-referral-g-source-join" sourceRef="referral" targetRef="g-source-join" />
    <bpmn:sequenceFlow id="f-g-source-join-call-customer" sourceRef="g-source-join" targetRef="call-customer" />
    <bpmn:sequenceFlow id="f-call-customer-determine" sourceRef="call-customer" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-ask-interest" sourceRef="determine" targetRef="ask-interest" />
    <bpmn:sequenceFlow id="f-ask-interest-g-interest" sourceRef="ask-interest" targetRef="g-interest" />
    <bpmn:sequenceFlow id="f-g-interest-g-final-join" name="Yes" sourceRef="g-interest" targetRef="g-final-join" />
    <bpmn:sequenceFlow id="f-g-interest-g-budget" name="No" sourceRef="g-interest" targetRef="g-budget" />
    <bpmn:sequenceFlow id="f-g-budget-acquire" name="Yes" sourceRef="g-budget" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-g-budget-leave" name="No" sourceRef="g-budget" targetRef="leave" />
    <bpmn:sequenceFlow id="f-acquire-g-final-join" sourceRef="acquire" targetRef="g-final-join" />
    <bpmn:sequenceFlow id="f-g-final-join-g-final" sourceRef="g-final-join" targetRef="g-final" />
    <bpmn:sequenceFlow id="f-g-final-g-tech" name="Yes" sourceRef="g-final" targetRef="g-tech" />
    <bpmn:sequenceFlow id="f-g-final-not-interested" name="No" sourceRef="g-final" targetRef="not-interested" />
    <bpmn:sequenceFlow id="f-g-tech-pres-tech" name="Yes" sourceRef="g-tech" targetRef="pres-tech" />
    <bpmn:sequenceFlow id="f-g-tech-pres-sales" name="No" sourceRef="g-tech" targetRef="pres-sales" />
    <bpmn:sequenceFlow id="f-pres-tech-g-pres-join" sourceRef="pres-tech" targetRef="g-pres-join" />
    <bpmn:sequenceFlow id="f-pres-sales-g-pres-join" sourceRef="pres-sales" targetRef="g-pres-join" />
    <bpmn:sequenceFlow id="f-g-pres-join-wait" sourceRef="g-pres-join" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-came-back" sourceRef="wait" targetRef="came-back" />
    <bpmn:sequenceFlow id="f-wait-timer-2w" sourceRef="wait" targetRef="timer-2w" />
    <bpmn:sequenceFlow id="f-came-back-g-contact" sourceRef="came-back" targetRef="g-contact" />
    <bpmn:sequenceFlow id="f-timer-2w-call-again" sourceRef="timer-2w" targetRef="call-again" />
    <bpmn:sequenceFlow id="f-call-again-g-contact" sourceRef="call-again" targetRef="g-contact" />
    <bpmn:sequenceFlow id="f-g-contact-quote" sourceRef="g-contact" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-done" sourceRef="quote" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
