tok 1.0 "Lead follow-up"

pool org "Sales organisation"
  lane manager "Manager"
    start begin "Start"
    task check-leads "Check the open leads"
    task select-top "Select the top five leads"
    task instruct "Tell the Sales Assistant to call the contact persons"
    task process-lead "Process the lead"
    end lead-done "Lead processed"
  lane assistant "Sales Assistant"
    task call-customer "Call the customer"
    xor interested "Is the customer interested?"
    task send-note "Send a note to the Manager"
    task call-next "Call the next customer"
    xor more "More customers on the list?"
    end calls-done "All customers called"

flow begin -> check-leads -> select-top -> instruct -> call-customer -> interested
flow interested -> send-note "Yes" when="interested = true"
flow interested -> call-next "No" default
flow send-note -> process-lead -> lead-done
flow call-next -> more
flow more -> call-customer "Yes" when="more = true"
flow more -> calls-done "No" default
