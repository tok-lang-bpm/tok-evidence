<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lead follow-up" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Sales organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Lead follow-up" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-leads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-top</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lead-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call-next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calls-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Start" />
    <bpmn:task id="check-leads" name="Check the open leads" />
    <bpmn:task id="select-top" name="Select the top five leads" />
    <bpmn:task id="instruct" name="Tell the Sales Assistant to call the contact persons" />
    <bpmn:task id="process-lead" name="Process the lead" />
    <bpmn:endEvent id="lead-done" name="Lead processed" />
    <bpmn:task id="call-customer" name="Call the customer" />
    <bpmn:exclusiveGateway id="interested" name="Is the customer interested?" default="f-interested-call-next" />
    <bpmn:task id="send-note" name="Send a note to the Manager" />
    <bpmn:task id="call-next" name="Call the next customer" />
    <bpmn:exclusiveGateway id="more" name="More customers on the list?" default="f-more-calls-done" />
    <bpmn:endEvent id="calls-done" name="All customers called" />
    <bpmn:sequenceFlow id="f-begin-check-leads" sourceRef="begin" targetRef="check-leads" />
    <bpmn:sequenceFlow id="f-check-leads-select-top" sourceRef="check-leads" targetRef="select-top" />
    <bpmn:sequenceFlow id="f-select-top-instruct" sourceRef="select-top" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-call-customer" sourceRef="instruct" targetRef="call-customer" />
    <bpmn:sequenceFlow id="f-call-customer-interested" sourceRef="call-customer" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-send-note" name="Yes" sourceRef="interested" targetRef="send-note">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-interested-call-next" name="No" sourceRef="interested" targetRef="call-next" />
    <bpmn:sequenceFlow id="f-send-note-process-lead" sourceRef="send-note" targetRef="process-lead" />
    <bpmn:sequenceFlow id="f-process-lead-lead-done" sourceRef="process-lead" targetRef="lead-done" />
    <bpmn:sequenceFlow id="f-call-next-more" sourceRef="call-next" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-call-customer" name="Yes" sourceRef="more" targetRef="call-customer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">more = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-calls-done" name="No" sourceRef="more" targetRef="calls-done" />
  </bpmn:process>
</bpmn:definitions>
