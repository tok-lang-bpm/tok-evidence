tok 1.0 "Job posting process"

pool org "HR organisation"
  lane hr "HR clerk"
    start vacancy "Vacancy reported" message="Vacancy reported"
    task create "Create job description"
    xor clarity "Is the information still confusing?"
    task ask "Ask the Department again"
    xor clarified
    task submit "Submit job description for consideration"
    task correct "Correct job description"
    task resubmit "Submit job description again"
    task post "Post job"
    end posted "Job posted"
  lane dept "Department"
    task consider "Consider job description"
    xor approved "Is the job description approved?"
    task reject "Reject job description and request correction"

flow vacancy -> create -> clarity
flow clarity -> ask "yes" when="confusing = true"
flow clarity -> clarified "no" default
flow ask -> clarified -> submit -> consider -> approved
flow approved -> post "yes" when="approved = true"
flow approved -> reject "no" default
flow reject -> correct -> resubmit -> consider
flow post -> posted
