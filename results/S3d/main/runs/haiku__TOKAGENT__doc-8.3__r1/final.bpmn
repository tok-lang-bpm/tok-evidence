<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Job description approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job description approval" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Personnel requirement arises" />
    <bpmn:task id="detect" name="Detect personnel requirements" />
    <bpmn:task id="report" name="Report vacancy" />
    <bpmn:task id="clarify" name="Clarify tasks and requirements" />
    <bpmn:task id="review" name="Review job description" />
    <bpmn:exclusiveGateway id="corr" name="Corrections needed?" default="f-corr-approve" />
    <bpmn:task id="request" name="Request corrections" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:exclusiveGateway id="q" name="Questions about tasks and requirements?" default="f-q-describe" />
    <bpmn:task id="describe" name="Describe job" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="revise" name="Revise job description" />
    <bpmn:task id="advertise" name="Advertise job" />
    <bpmn:endEvent id="e1" name="Job advertised" />
    <bpmn:sequenceFlow id="f-s1-detect" sourceRef="s1" targetRef="detect" />
    <bpmn:sequenceFlow id="f-detect-report" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-q" sourceRef="report" targetRef="q" />
    <bpmn:sequenceFlow id="f-q-clarify" name="yes" sourceRef="q" targetRef="clarify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-clarify-describe" sourceRef="clarify" targetRef="describe" />
    <bpmn:sequenceFlow id="f-q-describe" name="no" sourceRef="q" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-m2" sourceRef="describe" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-review" sourceRef="m2" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corr" sourceRef="review" targetRef="corr" />
    <bpmn:sequenceFlow id="f-corr-request" name="yes" sourceRef="corr" targetRef="request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-request-revise" sourceRef="request" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-m2" sourceRef="revise" targetRef="m2" />
    <bpmn:sequenceFlow id="f-corr-approve" name="no" sourceRef="corr" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-advertise" sourceRef="approve" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-e1" sourceRef="advertise" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
