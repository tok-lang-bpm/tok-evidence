tok 1.0 "Job description approval"

pool org "Organisation"
  lane head "Head of functional department"
    start s1 "Personnel requirement arises"
    task detect "Detect personnel requirements"
    task report "Report vacancy"
    task clarify "Clarify tasks and requirements"
    task review "Review job description"
    xor corr "Corrections needed?"
    task request "Request corrections"
    task approve "Approve job description"
  lane hr "Personnel Department"
    xor q "Questions about tasks and requirements?"
    task describe "Describe job"
    xor m2
    task revise "Revise job description"
    task advertise "Advertise job"
    end e1 "Job advertised"

flow s1 -> detect -> report -> q
flow q -> clarify "yes" when=""
flow clarify -> describe
flow q -> describe "no" default
flow describe -> m2 -> review -> corr
flow corr -> request "yes" when=""
flow request -> revise -> m2
flow corr -> approve "no" default
flow approve -> advertise -> e1
