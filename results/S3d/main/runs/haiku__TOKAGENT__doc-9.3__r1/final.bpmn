<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Meeting schedule" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Town Planning Authority" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meeting schedule" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check-dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Drafting of next year's schedule begins in November" />
    <bpmn:task id="draft" name="Draft schedule of meetings for next year" />
    <bpmn:task id="add-dates" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="conflicts" name="Look for potential conflicts" />
    <bpmn:task id="send" name="Send final schedule of meeting dates by email" />
    <bpmn:endEvent id="done" name="Meeting dates confirmed" />
    <bpmn:task id="check-dates" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="diaries" name="Check diaries" />
    <bpmn:exclusiveGateway id="found" name="Conflicts found?" default="f-found-done" />
    <bpmn:task id="advise" name="Advise Coordination Unit of conflicts" />
    <bpmn:endEvent id="reported" name="Conflicts reported" />
    <bpmn:sequenceFlow id="f-s-draft" sourceRef="s" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-add-dates" sourceRef="draft" targetRef="add-dates" />
    <bpmn:sequenceFlow id="f-add-dates-check-dates" sourceRef="add-dates" targetRef="check-dates" />
    <bpmn:sequenceFlow id="f-check-dates-suggest" sourceRef="check-dates" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-conflicts" sourceRef="recheck" targetRef="conflicts" />
    <bpmn:sequenceFlow id="f-conflicts-send" sourceRef="conflicts" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-diaries" sourceRef="send" targetRef="diaries" />
    <bpmn:sequenceFlow id="f-diaries-found" sourceRef="diaries" targetRef="found" />
    <bpmn:sequenceFlow id="f-found-advise" name="conflicts" sourceRef="found" targetRef="advise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-found-done" name="no conflicts" sourceRef="found" targetRef="done" />
    <bpmn:sequenceFlow id="f-advise-reported" sourceRef="advise" targetRef="reported" />
  </bpmn:process>
</bpmn:definitions>
