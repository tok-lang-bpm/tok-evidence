tok 1.0 "Meeting schedule" executable

pool org "Town Planning Authority"
  lane coord "Coordination Unit"
    start s "Drafting of next year's schedule begins in November"
    task draft "Draft schedule of meetings for next year"
    task add-dates "Add draft dates to all calendars"
    task recheck "Recheck all dates"
    task conflicts "Look for potential conflicts"
    task send "Send final schedule of meeting dates by email"
    task advise-recv "Receive advice on conflicts"
    xor conflict-check "Conflicts reported?"
    end done "Meeting dates confirmed"
  lane support "Support Officer"
    task check-dates "Check the dates"
    task suggest "Suggest modifications"
  lane committee "Committee Members"
    task diaries "Check diaries"
    xor found "Conflicts found?"
    task advise "Advise Coordination Unit of conflicts"
    end reported "Conflicts reported"

flow s -> draft -> add-dates -> check-dates -> suggest -> recheck -> conflicts -> send -> diaries -> found
flow found -> advise "conflicts" when=""
flow found -> done "no conflicts" default
flow advise -> advise-recv -> conflict-check
flow conflict-check -> reported "yes" when=""
flow conflict-check -> done "no" default
