tok 1.0 "Committee meeting support"

pool org "Committee secretariat"
  lane coord "Coordination Unit"
    start s "Meeting dates to be finalized"
    task finalize "Finalize meeting dates"
    task qa "Conduct QA check on minutes"
  lane support "Support Officer"
    task calendars "Update group calendars"
    task folders "Create meeting folders"
    task upload "Upload documents to system"
    task advise "Advise committee members to read documents"
    task minutes "Produce minutes with action points"
    task send "Send minutes to all committee members"
    task records "Update departmental records"
    end e "Departmental records updated"
  lane members "Committee Members"
    task read "Read related documents"
    task hold "Hold meeting"

flow s -> finalize -> calendars -> folders -> upload -> advise -> read -> hold -> minutes -> qa -> send -> records -> e
