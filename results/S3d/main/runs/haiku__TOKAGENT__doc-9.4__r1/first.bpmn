<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting support" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Committee secretariat" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting support" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Meeting dates to be finalized" />
    <bpmn:task id="finalize" name="Finalize meeting dates" />
    <bpmn:task id="qa" name="Conduct QA check on minutes" />
    <bpmn:task id="calendars" name="Update group calendars" />
    <bpmn:task id="folders" name="Create meeting folders" />
    <bpmn:task id="upload" name="Upload documents to system" />
    <bpmn:task id="advise" name="Advise committee members to read documents" />
    <bpmn:task id="minutes" name="Produce minutes with action points" />
    <bpmn:task id="send" name="Send minutes to all committee members" />
    <bpmn:task id="records" name="Update departmental records" />
    <bpmn:endEvent id="e" name="Departmental records updated" />
    <bpmn:task id="read" name="Read related documents" />
    <bpmn:task id="hold" name="Hold meeting" />
    <bpmn:sequenceFlow id="f-s-finalize" sourceRef="s" targetRef="finalize" />
    <bpmn:sequenceFlow id="f-finalize-calendars" sourceRef="finalize" targetRef="calendars" />
    <bpmn:sequenceFlow id="f-calendars-folders" sourceRef="calendars" targetRef="folders" />
    <bpmn:sequenceFlow id="f-folders-upload" sourceRef="folders" targetRef="upload" />
    <bpmn:sequenceFlow id="f-upload-advise" sourceRef="upload" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-read" sourceRef="advise" targetRef="read" />
    <bpmn:sequenceFlow id="f-read-hold" sourceRef="read" targetRef="hold" />
    <bpmn:sequenceFlow id="f-hold-minutes" sourceRef="hold" targetRef="minutes" />
    <bpmn:sequenceFlow id="f-minutes-qa" sourceRef="minutes" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send" sourceRef="qa" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-records" sourceRef="send" targetRef="records" />
    <bpmn:sequenceFlow id="f-records-e" sourceRef="records" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
