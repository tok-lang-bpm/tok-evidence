tok 1.0 "Expense reimbursement"

# The 7- and 30-day deadlines are attached to the supervisor approval task, the only waiting step.
pool org "Organisation"
  lane fin "Finance department"
    start s "Expense Report received"
    xor g1 "Employee has an account?"
    task acc "Create new account"
    xor g2
    task rev "Review report for automatic approval"
    xor g3 "Amount under $200?"
    task auto "Approve report automatically"
    xor g5
    task notice "Send rejection notice by email"
    task pay "Transfer reimbursement to direct deposit bank account"
    task remind "Send approval in progress email"
    task cancel "Send cancellation notice by email"
    end end-rej "Report rejected"
    end end-ok "Reimbursement paid"
    end end-remind "Employee notified: approval in progress"
    end end-cancel "Process stopped; employee must re-submit report"
  lane sup "Supervisor"
    task approve "Approve report"
    xor g6 "Report approved?"
    boundary b7 "7 days" noninterrupting on=approve timer=P7D
    boundary b30 "30 days" on=approve timer=P30D

flow s -> g1
flow g1 -> g2 "yes" when="account = true"
flow g1 -> acc "no" default
flow acc -> g2 -> rev -> g3
flow g3 -> auto "under $200" when="amount < 200"
flow g3 -> approve "$200 or more" when="amount >= 200"
flow auto -> g5
flow approve -> g6
flow g6 -> g5 "yes" when="approved = true"
flow g6 -> notice "no" default
flow notice -> end-rej
flow g5 -> pay -> end-ok
flow b7 -> remind -> end-remind
flow b30 -> cancel -> end-cancel
