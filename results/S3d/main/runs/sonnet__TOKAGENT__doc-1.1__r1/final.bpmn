<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customized bicycles" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Bicycle manufacturer" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customized bicycles" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf-st</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf-en</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store" name="Storehouse">
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="eng" name="Engineering department">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>asm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order received" />
    <bpmn:task id="review" name="Review order" />
    <bpmn:exclusiveGateway id="acc" name="Order accepted?" />
    <bpmn:task id="reject" name="Reject order" />
    <bpmn:endEvent id="e1" name="Order rejected" />
    <bpmn:task id="accept" name="Accept order" />
    <bpmn:parallelGateway id="sp" />
    <bpmn:task id="inf-st" name="Inform storehouse" />
    <bpmn:task id="inf-en" name="Inform engineering department" />
    <bpmn:task id="ship" name="Ship bicycle" />
    <bpmn:endEvent id="e2" name="Process finished" />
    <bpmn:subProcess id="parts" name="Process part list">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="ps" name="Part list item" />
      <bpmn:task id="chk" name="Check required quantity" />
      <bpmn:exclusiveGateway id="av" name="Part available in-house?" />
      <bpmn:task id="res" name="Reserve part" />
      <bpmn:task id="bo" name="Back-order part" />
      <bpmn:exclusiveGateway id="mj" />
      <bpmn:endEvent id="pe" name="Item processed" />
      <bpmn:sequenceFlow id="f-ps-chk" sourceRef="ps" targetRef="chk" />
      <bpmn:sequenceFlow id="f-chk-av" sourceRef="chk" targetRef="av" />
      <bpmn:sequenceFlow id="f-av-res" name="yes" sourceRef="av" targetRef="res" />
      <bpmn:sequenceFlow id="f-av-bo" name="no" sourceRef="av" targetRef="bo" />
      <bpmn:sequenceFlow id="f-res-mj" sourceRef="res" targetRef="mj" />
      <bpmn:sequenceFlow id="f-bo-mj" sourceRef="bo" targetRef="mj" />
      <bpmn:sequenceFlow id="f-mj-pe" sourceRef="mj" targetRef="pe" />
    </bpmn:subProcess>
    <bpmn:task id="prep" name="Prepare assembling" />
    <bpmn:parallelGateway id="jn" />
    <bpmn:task id="asm" name="Assemble bicycle" />
    <bpmn:sequenceFlow id="f-s-review" sourceRef="s" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-acc" sourceRef="review" targetRef="acc" />
    <bpmn:sequenceFlow id="f-acc-reject" name="reject" sourceRef="acc" targetRef="reject" />
    <bpmn:sequenceFlow id="f-acc-accept" name="accept" sourceRef="acc" targetRef="accept" />
    <bpmn:sequenceFlow id="f-reject-e1" sourceRef="reject" targetRef="e1" />
    <bpmn:sequenceFlow id="f-accept-sp" sourceRef="accept" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-inf-st" sourceRef="sp" targetRef="inf-st" />
    <bpmn:sequenceFlow id="f-sp-inf-en" sourceRef="sp" targetRef="inf-en" />
    <bpmn:sequenceFlow id="f-inf-st-parts" sourceRef="inf-st" targetRef="parts" />
    <bpmn:sequenceFlow id="f-inf-en-prep" sourceRef="inf-en" targetRef="prep" />
    <bpmn:sequenceFlow id="f-parts-jn" sourceRef="parts" targetRef="jn" />
    <bpmn:sequenceFlow id="f-prep-jn" sourceRef="prep" targetRef="jn" />
    <bpmn:sequenceFlow id="f-jn-asm" sourceRef="jn" targetRef="asm" />
    <bpmn:sequenceFlow id="f-asm-ship" sourceRef="asm" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-e2" sourceRef="ship" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
