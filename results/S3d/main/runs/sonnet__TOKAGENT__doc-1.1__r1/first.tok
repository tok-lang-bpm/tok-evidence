tok 1.0 "Customized bicycles"

pool company "Bicycle manufacturer"
  lane sales "Sales department"
    start s "Order received"
    task review "Review order"
    xor acc "Order accepted?"
    task reject "Reject order"
    end e1 "Order rejected"
    task accept "Accept order"
    and sp
    task inf-st "Inform storehouse"
    task inf-en "Inform engineering department"
    task ship "Ship bicycle"
    end e2 "Process finished"
  lane store "Storehouse"
    sub parts "Process part list" sequential
      start ps "Part list item"
      task chk "Check required quantity"
      xor av "Part available in-house?"
      task res "Reserve part"
      task bo "Back-order part"
      xor mj
      end pe "Item processed"
  lane eng "Engineering department"
    task prep "Prepare assembling"
    and jn
    task asm "Assemble bicycle"

  # flows inside the sub-process
flow ps -> chk -> av
flow av -> res "yes"
flow av -> bo "no"
flow res -> mj
flow bo -> mj
flow mj -> pe
flow s -> review -> acc
flow acc -> reject "reject"
flow acc -> accept "accept"
flow reject -> e1
flow accept -> sp
flow sp -> inf-st
flow sp -> inf-en
flow inf-st -> parts
flow inf-en -> prep
flow parts -> jn
flow prep -> jn
flow jn -> asm -> ship -> e2
