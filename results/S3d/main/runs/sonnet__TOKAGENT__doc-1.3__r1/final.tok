tok 1.0 "Room service"

pool hotel "The Evanstonian"
  lane mgr "Room-service manager"
    start s "Guest calls room service"
    task t1 "Take down order"
    and a1
    task t2 "Submit order ticket to kitchen"
    xor x1 "Alcoholic beverage ordered?"
    task t3 "Give order to sommelier"
    xor x2
    task t4 "Assign order to waiter"
  lane kit "Kitchen"
    task k1 "Prepare food"
  lane som "Sommelier"
    task m1 "Fetch wine from cellar"
    task m2 "Prepare alcoholic beverages"
  lane wai "Waiter"
    task w1 "Ready cart"
    task w2 "Prepare nonalcoholic drinks"
    and a2
    task w3 "Deliver order to guest's room"
    task w4 "Debit guest's account"
    end e "Order billed"

flow s -> t1 -> a1
flow a1 -> t2 -> k1 -> a2
flow a1 -> x1
flow x1 -> t3 "yes" when="alcohol = true"
flow x1 -> x2 "no" default
flow t3 -> m1 -> m2 -> x2
flow x2 -> a2
flow a1 -> t4 -> w1 -> w2 -> a2
flow a2 -> w3 -> w4 -> e
