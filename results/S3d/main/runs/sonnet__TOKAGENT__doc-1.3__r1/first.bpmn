<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room service" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="mgr" name="Room-service manager">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kit" name="Kitchen">
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="som" name="Sommelier">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wai" name="Waiter">
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Guest calls room service" />
    <bpmn:task id="t1" name="Take down order" />
    <bpmn:parallelGateway id="a1" />
    <bpmn:task id="t2" name="Submit order ticket to kitchen" />
    <bpmn:exclusiveGateway id="x1" name="Alcoholic beverage ordered?" default="f-x1-x2" />
    <bpmn:task id="t3" name="Give order to sommelier" />
    <bpmn:exclusiveGateway id="x2" />
    <bpmn:task id="t4" name="Assign order to waiter" />
    <bpmn:task id="k1" name="Prepare food" />
    <bpmn:task id="m1" name="Fetch wine from cellar" />
    <bpmn:task id="m2" name="Prepare alcoholic beverages" />
    <bpmn:task id="w1" name="Ready cart" />
    <bpmn:task id="w2" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="a2" />
    <bpmn:task id="w3" name="Deliver order to guest's room" />
    <bpmn:task id="w4" name="Debit guest's account" />
    <bpmn:endEvent id="e" name="Order billed" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-a1" sourceRef="t1" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-t2" sourceRef="a1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-k1" sourceRef="t2" targetRef="k1" />
    <bpmn:sequenceFlow id="f-k1-a2" sourceRef="k1" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a1-x1" sourceRef="a1" targetRef="x1" />
    <bpmn:sequenceFlow id="f-x1-t3" name="yes" sourceRef="x1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-x1-x2" name="no" sourceRef="x1" targetRef="x2" />
    <bpmn:sequenceFlow id="f-t3-m1" sourceRef="t3" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-m2" sourceRef="m1" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-x2" sourceRef="m2" targetRef="x2" />
    <bpmn:sequenceFlow id="f-x2-a2" sourceRef="x2" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a1-t4" sourceRef="a1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-w1" sourceRef="t4" targetRef="w1" />
    <bpmn:sequenceFlow id="f-w1-w2" sourceRef="w1" targetRef="w2" />
    <bpmn:sequenceFlow id="f-w2-a2" sourceRef="w2" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-w3" sourceRef="a2" targetRef="w3" />
    <bpmn:sequenceFlow id="f-w3-w4" sourceRef="w3" targetRef="w4" />
    <bpmn:sequenceFlow id="f-w4-e" sourceRef="w4" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
