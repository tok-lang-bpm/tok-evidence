tok 1.0 "Going public"

pool org "Organisation"
  lane company "Company"
    start s "Decision to go public made"
    task select "Select the underwriters"
  lane uw "Underwriters"
    task prep "Prepare registration statement"
    and split
    task reg "Register issue with SEC"
    task clear "Receive clearance from SEC"
    task blue "Check compliance with blue-sky laws"
    task firm "Firm up issue price"
    task road "Arrange road show"
    and join
    task fix "Fix issue price"
    xor g "Reason not to offer the stock?"
    task commit "Enter firm commitment to buy the stock"
    task offer "Offer stock to the public"
    end e1 "Issue offered"
    end e2 "Issue not offered"

flow s -> select -> prep -> split
flow split -> reg -> clear -> join
flow split -> blue -> join
flow split -> firm -> road -> join
flow join -> fix -> g
flow g -> e2 "yes"
flow g -> commit "no"
flow commit -> offer -> e1
