<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Going public" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="uw" name="Underwriters">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>road</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Decision to go public made" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="prep" name="Prepare registration statement" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="reg" name="Register issue with SEC" />
    <bpmn:task id="clear" name="Receive clearance from SEC" />
    <bpmn:task id="blue" name="Check compliance with blue-sky laws" />
    <bpmn:task id="firm" name="Firm up issue price" />
    <bpmn:task id="road" name="Arrange road show" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="fix" name="Fix issue price" />
    <bpmn:exclusiveGateway id="g" name="Reason not to offer the stock?" />
    <bpmn:task id="commit" name="Enter firm commitment to buy the stock" />
    <bpmn:task id="offer" name="Offer stock to the public" />
    <bpmn:endEvent id="e1" name="Issue offered" />
    <bpmn:endEvent id="e2" name="Issue not offered" />
    <bpmn:sequenceFlow id="f-s-select" sourceRef="s" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-prep" sourceRef="select" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-split" sourceRef="prep" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-reg" sourceRef="split" targetRef="reg" />
    <bpmn:sequenceFlow id="f-reg-clear" sourceRef="reg" targetRef="clear" />
    <bpmn:sequenceFlow id="f-clear-join" sourceRef="clear" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-blue" sourceRef="split" targetRef="blue" />
    <bpmn:sequenceFlow id="f-blue-join" sourceRef="blue" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-firm" sourceRef="split" targetRef="firm" />
    <bpmn:sequenceFlow id="f-firm-road" sourceRef="firm" targetRef="road" />
    <bpmn:sequenceFlow id="f-road-join" sourceRef="road" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-fix" sourceRef="join" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-g" sourceRef="fix" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-e2" name="yes" sourceRef="g" targetRef="e2" />
    <bpmn:sequenceFlow id="f-g-commit" name="no" sourceRef="g" targetRef="commit" />
    <bpmn:sequenceFlow id="f-commit-offer" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-e1" sourceRef="offer" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
