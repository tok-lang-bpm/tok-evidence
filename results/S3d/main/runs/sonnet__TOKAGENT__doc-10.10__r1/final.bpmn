<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Fault handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Measuring organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Fault handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="fd" name="Fault detector">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Failure detected" />
    <bpmn:task id="report" name="Report failure" />
    <bpmn:startEvent id="s2" name="Own fault suspected" />
    <bpmn:task id="suspect" name="Suspect own fault" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="examine" name="Examine failure" />
    <bpmn:exclusiveGateway id="d1" name="Failure confirmed?" default="f-d1-reject" />
    <bpmn:task id="reject" name="Reject failure" />
    <bpmn:endEvent id="e1" name="Failure rejected" />
    <bpmn:task id="confirm" name="Confirm failure" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:task id="infoa" name="Inform GO about failure" />
    <bpmn:task id="infob" name="Inform MSP about failure" />
    <bpmn:parallelGateway id="p2" />
    <bpmn:task id="fix" name="Fix fault at measuring device" />
    <bpmn:task id="share" name="Share results of repairs with fault detector" />
    <bpmn:parallelGateway id="p3" />
    <bpmn:task id="resa" name="Inform GO about resolution of interference" />
    <bpmn:task id="resb" name="Inform MSP about resolution of interference" />
    <bpmn:parallelGateway id="p4" />
    <bpmn:endEvent id="e2" name="Fault resolved" />
    <bpmn:sequenceFlow id="f-s1-report" sourceRef="s1" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-m1" sourceRef="report" targetRef="m1" />
    <bpmn:sequenceFlow id="f-s2-suspect" sourceRef="s2" targetRef="suspect" />
    <bpmn:sequenceFlow id="f-suspect-m1" sourceRef="suspect" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-examine" sourceRef="m1" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-d1" sourceRef="examine" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-reject" name="no" sourceRef="d1" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-e1" sourceRef="reject" targetRef="e1" />
    <bpmn:sequenceFlow id="f-d1-confirm" name="yes" sourceRef="d1" targetRef="confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-confirm-p1" sourceRef="confirm" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-infoa" sourceRef="p1" targetRef="infoa" />
    <bpmn:sequenceFlow id="f-infoa-p2" sourceRef="infoa" targetRef="p2" />
    <bpmn:sequenceFlow id="f-p1-infob" sourceRef="p1" targetRef="infob" />
    <bpmn:sequenceFlow id="f-infob-p2" sourceRef="infob" targetRef="p2" />
    <bpmn:sequenceFlow id="f-p2-fix" sourceRef="p2" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-p3" sourceRef="share" targetRef="p3" />
    <bpmn:sequenceFlow id="f-p3-resa" sourceRef="p3" targetRef="resa" />
    <bpmn:sequenceFlow id="f-resa-p4" sourceRef="resa" targetRef="p4" />
    <bpmn:sequenceFlow id="f-p3-resb" sourceRef="p3" targetRef="resb" />
    <bpmn:sequenceFlow id="f-resb-p4" sourceRef="resb" targetRef="p4" />
    <bpmn:sequenceFlow id="f-p4-e2" sourceRef="p4" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
