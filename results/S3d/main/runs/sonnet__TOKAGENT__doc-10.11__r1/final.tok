tok 1.0 "Measurements"

pool org "Organisation"
  lane go "GO"
    start s "Measurements needed"
    task request "Request the measurements"
    task process "Process the measured values"
    task sendchanged "Send the changed values to the MSP"
    task transmitsp "Transmit the readings to the SP"
    end e1 "Readings transmitted"
    end e2 "Request denied"
    end e3 "Failure reported"
  lane msp "MSP"
    task check "Check the received request"
    xor d1 "Request accepted?"
    task deny "Deny the request of the GO"
    task measure "Perform the measurement"
    xor d2 "Reading successful?"
    task inform "Inform the GO about the failure of the reading"
    task transmit "Transmit the measured values to the GO"

flow s -> request -> check -> d1
flow d1 -> deny "no" default
flow d1 -> measure "yes" when="accepted = true"
flow deny -> e2
flow measure -> d2
flow d2 -> inform "no" default
flow d2 -> transmit "yes" when="success = true"
flow inform -> e3
flow transmit -> process -> sendchanged -> transmitsp -> e1
