tok 1.0 "Transaction data request"

pool org "Organisation"
  lane inq "INQ"
    start s "Request needed"
    task t1 "Transmit transaction data request"
    end e1 "Data received"
    end e2 "Rejection received"
  lane ip "IP"
    task t2 "Check request"
    xor g "Request accepted?"
    task t3 "Transmit data"
    task t4 "Reject request"

flow s -> t1 -> t2 -> g
flow g -> t3 "yes" when="accepted = true"
flow g -> t4 "no" default
flow t3 -> e1
flow t4 -> e2
