<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Grid operator" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Bill handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examgo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>exammpon</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Bill received" />
    <bpmn:exclusiveGateway id="g1" name="Which bill?" />
    <bpmn:task id="examgo" name="Examine bill" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:exclusiveGateway id="g2" name="Is the invoice accepted?" />
    <bpmn:task id="confirm" name="Confirm invoice with payment advice" />
    <bpmn:task id="reject" name="Reject invoice" />
    <bpmn:endEvent id="e1" name="Invoice confirmed" />
    <bpmn:endEvent id="e2" name="Invoice rejected" />
    <bpmn:task id="exammpon" name="Examine bill" />
    <bpmn:sequenceFlow id="f-s-g1" sourceRef="s" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-examgo" name="temporary continuation or additional readings" sourceRef="g1" targetRef="examgo" />
    <bpmn:sequenceFlow id="f-g1-exammpon" name="equipment acquisition" sourceRef="g1" targetRef="exammpon" />
    <bpmn:sequenceFlow id="f-examgo-m1" sourceRef="examgo" targetRef="m1" />
    <bpmn:sequenceFlow id="f-exammpon-m1" sourceRef="exammpon" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-g2" sourceRef="m1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-confirm" name="yes" sourceRef="g2" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-g2-reject" name="no" sourceRef="g2" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-e1" sourceRef="confirm" targetRef="e1" />
    <bpmn:sequenceFlow id="f-reject-e2" sourceRef="reject" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
