tok 1.0 "Bill handling"

pool org "Grid operator"
  lane go "GO"
    start s "Bill received"
    xor g1 "Which bill?"
    task examgo "Examine bill"
    xor m1
    xor g2 "Is the invoice accepted?"
    task confirm "Confirm invoice with payment advice"
    task reject "Reject invoice"
    end e1 "Invoice confirmed"
    end e2 "Invoice rejected"
  lane mpon "MPON"
    task exammpon "Examine bill"

flow s -> g1
flow g1 -> examgo "temporary continuation or additional readings"
flow g1 -> exammpon "equipment acquisition"
flow examgo -> m1
flow exammpon -> m1
flow m1 -> g2
flow g2 -> confirm "yes"
flow g2 -> reject "no"
flow confirm -> e1
flow reject -> e2
