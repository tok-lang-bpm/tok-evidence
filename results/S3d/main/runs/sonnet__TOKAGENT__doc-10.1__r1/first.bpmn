<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Dismissal" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="send" name="Send the dismissal to the MPOO" />
    <bpmn:task id="review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="g" name="Is the dismissal confirmed?" />
    <bpmn:task id="oppose" name="Oppose the dismissal of the MPON" />
    <bpmn:task id="confirm" name="Confirm the dismissal of the MPON" />
    <bpmn:exclusiveGateway id="j" />
    <bpmn:endEvent id="e" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g" sourceRef="review" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-oppose" name="no" sourceRef="g" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-g-confirm" name="yes" sourceRef="g" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-oppose-j" sourceRef="oppose" targetRef="j" />
    <bpmn:sequenceFlow id="f-confirm-j" sourceRef="confirm" targetRef="j" />
    <bpmn:sequenceFlow id="f-j-e" sourceRef="j" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
