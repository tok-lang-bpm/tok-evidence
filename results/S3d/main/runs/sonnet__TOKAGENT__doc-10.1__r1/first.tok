tok 1.0

pool org "Dismissal"
  lane mpon "MPON"
    start s
    task send "Send the dismissal to the MPOO"
  lane mpoo "MPOO"
    task review "Review the dismissal"
    xor g "Is the dismissal confirmed?"
    task oppose "Oppose the dismissal of the MPON"
    task confirm "Confirm the dismissal of the MPON"
    xor j
    end e

flow s -> send
flow send -> review
flow review -> g
flow g -> oppose "no"
flow g -> confirm "yes"
flow oppose -> j
flow confirm -> j
flow j -> e