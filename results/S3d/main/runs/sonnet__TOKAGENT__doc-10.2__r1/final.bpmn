<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Meter operation registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Market organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meter operation registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acq1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inffail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>acq2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="acq1" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:boundaryEvent id="dl" name="Maximum time limit" attachedToRef="acq1">
      <bpmn:timerEventDefinition id="dl-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="res" name="Result of the entire process?" default="f-res-inffail" />
    <bpmn:task id="inffail" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="infok" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="exam" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="dec" name="Application confirmed?" default="f-dec-rej" />
    <bpmn:task id="rej" name="Reject the application of the MPON" />
    <bpmn:endEvent id="e1" name="Application rejected" />
    <bpmn:task id="conf" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="sp1" name="Inform" />
    <bpmn:task id="inf1" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="inf2" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="jn1" name="Informed" />
    <bpmn:parallelGateway id="sp0" name="Start equipment work" />
    <bpmn:parallelGateway id="jn0" name="Equipment work done" />
    <bpmn:task id="late" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="e2" name="Failed by deadline" />
    <bpmn:task id="cfail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:parallelGateway id="sp2" name="Inform" />
    <bpmn:task id="f1" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="f2" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:parallelGateway id="jn2" name="Informed" />
    <bpmn:endEvent id="e3" name="Assignment failed" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="cass" name="Confirm the assignment to the MPON" />
    <bpmn:parallelGateway id="sp3" name="Inform" />
    <bpmn:task id="a1" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="a2" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="a3" name="Inform the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="jn3" name="Informed" />
    <bpmn:endEvent id="e4" name="Assignment completed" />
    <bpmn:task id="acq2" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-exam" sourceRef="report" targetRef="exam" />
    <bpmn:sequenceFlow id="f-exam-dec" sourceRef="exam" targetRef="dec" />
    <bpmn:sequenceFlow id="f-dec-rej" name="no" sourceRef="dec" targetRef="rej" />
    <bpmn:sequenceFlow id="f-dec-conf" name="yes" sourceRef="dec" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rej-e1" sourceRef="rej" targetRef="e1" />
    <bpmn:sequenceFlow id="f-conf-sp1" sourceRef="conf" targetRef="sp1" />
    <bpmn:sequenceFlow id="f-sp1-inf1" sourceRef="sp1" targetRef="inf1" />
    <bpmn:sequenceFlow id="f-inf1-jn1" sourceRef="inf1" targetRef="jn1" />
    <bpmn:sequenceFlow id="f-sp1-inf2" sourceRef="sp1" targetRef="inf2" />
    <bpmn:sequenceFlow id="f-inf2-jn1" sourceRef="inf2" targetRef="jn1" />
    <bpmn:sequenceFlow id="f-jn1-sp0" sourceRef="jn1" targetRef="sp0" />
    <bpmn:sequenceFlow id="f-sp0-acq1" sourceRef="sp0" targetRef="acq1" />
    <bpmn:sequenceFlow id="f-acq1-jn0" sourceRef="acq1" targetRef="jn0" />
    <bpmn:sequenceFlow id="f-sp0-acq2" sourceRef="sp0" targetRef="acq2" />
    <bpmn:sequenceFlow id="f-acq2-jn0" sourceRef="acq2" targetRef="jn0" />
    <bpmn:sequenceFlow id="f-jn0-res" sourceRef="jn0" targetRef="res" />
    <bpmn:sequenceFlow id="f-dl-late" sourceRef="dl" targetRef="late" />
    <bpmn:sequenceFlow id="f-late-e2" sourceRef="late" targetRef="e2" />
    <bpmn:sequenceFlow id="f-res-inffail" name="failure" sourceRef="res" targetRef="inffail" />
    <bpmn:sequenceFlow id="f-res-infok" name="success" sourceRef="res" targetRef="infok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">success = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-inffail-cfail" sourceRef="inffail" targetRef="cfail" />
    <bpmn:sequenceFlow id="f-cfail-sp2" sourceRef="cfail" targetRef="sp2" />
    <bpmn:sequenceFlow id="f-sp2-f1" sourceRef="sp2" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-jn2" sourceRef="f1" targetRef="jn2" />
    <bpmn:sequenceFlow id="f-sp2-f2" sourceRef="sp2" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-jn2" sourceRef="f2" targetRef="jn2" />
    <bpmn:sequenceFlow id="f-jn2-e3" sourceRef="jn2" targetRef="e3" />
    <bpmn:sequenceFlow id="f-infok-assign" sourceRef="infok" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-cass" sourceRef="assign" targetRef="cass" />
    <bpmn:sequenceFlow id="f-cass-sp3" sourceRef="cass" targetRef="sp3" />
    <bpmn:sequenceFlow id="f-sp3-a1" sourceRef="sp3" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-jn3" sourceRef="a1" targetRef="jn3" />
    <bpmn:sequenceFlow id="f-sp3-a2" sourceRef="sp3" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-jn3" sourceRef="a2" targetRef="jn3" />
    <bpmn:sequenceFlow id="f-sp3-a3" sourceRef="sp3" targetRef="a3" />
    <bpmn:sequenceFlow id="f-a3-jn3" sourceRef="a3" targetRef="jn3" />
    <bpmn:sequenceFlow id="f-jn3-e4" sourceRef="jn3" targetRef="e4" />
  </bpmn:process>
</bpmn:definitions>
