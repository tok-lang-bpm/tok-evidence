<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="MPOO deregistration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MPOO deregistration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="dereg" name="Deregister at the GO" />
    <bpmn:task id="confirm" name="Confirm the continuation" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="d1" name="Deregistration accepted?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="e2" name="Rejected" />
    <bpmn:task id="prelim" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="d2" name="Oblige the MPOO to continue?" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="m2" name="" />
    <bpmn:inclusiveGateway id="o1" name="Which equipment work?" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:task id="change" name="Perform the equipment changes" />
    <bpmn:inclusiveGateway id="o2" name="" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="informmpoo" name="Inform the MPOO about the end and beginning of the assignment" />
    <bpmn:parallelGateway id="a1" />
    <bpmn:task id="informmspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informsp" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="a2" />
    <bpmn:endEvent id="e3" name="End" />
    <bpmn:sequenceFlow id="f-s-dereg" sourceRef="s" targetRef="dereg" />
    <bpmn:sequenceFlow id="f-dereg-verify" sourceRef="dereg" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-d1" sourceRef="verify" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-reject" name="no" sourceRef="d1" targetRef="reject" />
    <bpmn:sequenceFlow id="f-d1-prelim" name="yes" sourceRef="d1" targetRef="prelim" />
    <bpmn:sequenceFlow id="f-reject-e2" sourceRef="reject" targetRef="e2" />
    <bpmn:sequenceFlow id="f-prelim-prepare" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-d2" sourceRef="prepare" targetRef="d2" />
    <bpmn:sequenceFlow id="f-d2-oblige" name="yes" sourceRef="d2" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-d2-m2" name="no" sourceRef="d2" targetRef="m2" />
    <bpmn:sequenceFlow id="f-oblige-confirm" sourceRef="oblige" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-e1" sourceRef="confirm" targetRef="e1" />
    <bpmn:sequenceFlow id="f-o1-acquire" name="acquisition" sourceRef="o1" targetRef="acquire">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-o1-change" name="changes" sourceRef="o1" targetRef="change">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-acquire-o2" sourceRef="acquire" targetRef="o2" />
    <bpmn:sequenceFlow id="f-change-o2" sourceRef="change" targetRef="o2" />
    <bpmn:sequenceFlow id="f-o2-assign" sourceRef="o2" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-informmpoo" sourceRef="assign" targetRef="informmpoo" />
    <bpmn:sequenceFlow id="f-informmpoo-a1" sourceRef="informmpoo" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-informmspo" sourceRef="a1" targetRef="informmspo" />
    <bpmn:sequenceFlow id="f-a1-informsp" sourceRef="a1" targetRef="informsp" />
    <bpmn:sequenceFlow id="f-informmspo-a2" sourceRef="informmspo" targetRef="a2" />
    <bpmn:sequenceFlow id="f-informsp-a2" sourceRef="informsp" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-e3" sourceRef="a2" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
