tok 1.0 "Equipment change"

pool org "Metering organisation"
  lane mpon "MPON"
    start s "Equipment change intended"
    task t1 "Notify MPOO about equipment change intentions"
    xor g1 "Self dismounting by MPOO?"
    task t4 "Perform final reading"
    task t5 "Dismount old equipment"
    xor m1
    task t6 "Mount new device"
    task t7 "Read meter count from installed meter"
    task t8 "Send values of final reading to GO"
    task t9 "Tell GO about device changes, master data and meter count at installation"
  lane mpoo "MPOO"
    task t2 "Announce self dismounting to MPON"
    task t3 "Notify MPON about no self-dismounting"
    task t4b "Perform final reading"
    task t5b "Dismount old equipment"
  lane go "GO"
    task t10 "Notify MSP about device changes, master data, meter count at dismounting and meter count at installation"
    end e "MSP notified"

flow s -> t1 -> g1
flow g1 -> t2 "yes" when="selfDismounting = true"
flow g1 -> t3 "no" default
flow t2 -> t4b -> t5b -> m1
flow t3 -> t4 -> t5 -> m1
flow m1 -> t6 -> t7 -> t8 -> t9 -> t10 -> e
