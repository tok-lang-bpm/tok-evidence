<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Metering organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Equipment change intended" />
    <bpmn:task id="t1" name="Notify MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="g1" name="Self dismounting by MPOO?" default="f-g1-t3" />
    <bpmn:task id="t4" name="Perform final reading" />
    <bpmn:task id="t5" name="Dismount old equipment" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t6" name="Mount new device" />
    <bpmn:task id="t7" name="Read meter count from installed meter" />
    <bpmn:task id="t8" name="Send values of final reading to GO" />
    <bpmn:task id="t9" name="Tell GO about device changes, master data and meter count at installation" />
    <bpmn:task id="t2" name="Announce self dismounting to MPON" />
    <bpmn:task id="t3" name="Notify MPON about no self-dismounting" />
    <bpmn:task id="t4b" name="Perform final reading" />
    <bpmn:task id="t5b" name="Dismount old equipment" />
    <bpmn:task id="t10" name="Notify MSP about device changes, master data, meter count at dismounting and meter count at installation" />
    <bpmn:endEvent id="e" name="MSP notified" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t2" name="yes" sourceRef="g1" targetRef="t2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">selfDismounting = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-t3" name="no" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t2-t4b" sourceRef="t2" targetRef="t4b" />
    <bpmn:sequenceFlow id="f-t4b-t5b" sourceRef="t4b" targetRef="t5b" />
    <bpmn:sequenceFlow id="f-t5b-m1" sourceRef="t5b" targetRef="m1" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-m1" sourceRef="t5" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-t6" sourceRef="m1" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-e" sourceRef="t10" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
