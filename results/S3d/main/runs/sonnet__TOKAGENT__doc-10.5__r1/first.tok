tok 1.0 "Device takeover"

pool org "Market process"
  lane mpon "MPON"
    start s "Start"
    task t1 "Request device takeover bid"
    task t3 "Place order"
  lane mpoo "MPOO"
    task t2 "Send tender for equipment takeover"
    task t4 "Confirm order"
    task t5 "Send master data"
    end e "End"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> e
