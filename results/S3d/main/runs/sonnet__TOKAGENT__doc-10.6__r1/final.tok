tok 1.0 "Dismissal"
pool org "MSPN and MSPO"
  lane mspn "MSPN"
    start s "Start"
    task t1 "Send dismissal"
  lane mspo "MSPO"
    task t2 "Review dismissal"
    xor g "Dismissal confirmed?"
    task t3 "Reject dismissal"
    task t4 "Confirm dismissal"
    end e1 "Rejected"
    end e2 "Confirmed"
flow s -> t1 -> t2 -> g
flow g -> t3 "no" when="confirmed = false"
flow g -> t4 "yes" default
flow t3 -> e1
flow t4 -> e2
