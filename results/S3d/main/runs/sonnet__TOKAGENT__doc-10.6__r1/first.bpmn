<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Dismissal" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="MSPN and MSPO" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t1" name="Send dismissal" />
    <bpmn:task id="t2" name="Review dismissal" />
    <bpmn:exclusiveGateway id="g" name="Dismissal confirmed?" default="f-g-t4" />
    <bpmn:task id="t3" name="Reject dismissal" />
    <bpmn:task id="t4" name="Confirm dismissal" />
    <bpmn:endEvent id="e1" name="Rejected" />
    <bpmn:endEvent id="e2" name="Confirmed" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-g" sourceRef="t2" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-t3" name="no" sourceRef="g" targetRef="t3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-t4" name="yes" sourceRef="g" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t3-e1" sourceRef="t3" targetRef="e1" />
    <bpmn:sequenceFlow id="f-t4-e2" sourceRef="t4" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
