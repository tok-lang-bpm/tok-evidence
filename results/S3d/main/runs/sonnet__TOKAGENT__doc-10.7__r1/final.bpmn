<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Assignment of MSPN" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Assignment of MSPN" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="reg" name="Register the measurement at the GO" />
    <bpmn:task id="exam" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="d" name="Application confirmed?" default="f-d-rej" />
    <bpmn:task id="rej" name="Reject the application of the MSPN" />
    <bpmn:task id="conf" name="Confirm the application of the MSPN" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="i1" name="Inform the MSPO about the assignment of MSPN" />
    <bpmn:task id="i2" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="i3" name="Inform the SP about the assignment of MSPN" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="e1" name="Application rejected" />
    <bpmn:endEvent id="e2" name="MSPN assigned" />
    <bpmn:sequenceFlow id="f-s-reg" sourceRef="s" targetRef="reg" />
    <bpmn:sequenceFlow id="f-reg-exam" sourceRef="reg" targetRef="exam" />
    <bpmn:sequenceFlow id="f-exam-d" sourceRef="exam" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-rej" name="no" sourceRef="d" targetRef="rej" />
    <bpmn:sequenceFlow id="f-d-conf" name="yes" sourceRef="d" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rej-e1" sourceRef="rej" targetRef="e1" />
    <bpmn:sequenceFlow id="f-conf-assign" sourceRef="conf" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-fork" sourceRef="assign" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-i1" sourceRef="fork" targetRef="i1" />
    <bpmn:sequenceFlow id="f-i1-join" sourceRef="i1" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-i2" sourceRef="fork" targetRef="i2" />
    <bpmn:sequenceFlow id="f-i2-join" sourceRef="i2" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-i3" sourceRef="fork" targetRef="i3" />
    <bpmn:sequenceFlow id="f-i3-join" sourceRef="i3" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-e2" sourceRef="join" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
