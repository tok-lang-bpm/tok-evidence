tok 1.0 "Assignment of MSPN"

pool org "Organisation"
  lane mspn "MSPN"
    start s "Start"
    task reg "Register the measurement at the GO"
  lane go "GO"
    task exam "Examine the application of the MSPN"
    xor d "Application confirmed?"
    task rej "Reject the application of the MSPN"
    task conf "Confirm the application of the MSPN"
    task assign "Assign the MSPN"
    and fork
    task i1 "Inform the MSPO about the assignment of MSPN"
    task i2 "Inform the MPO about the assignment of the MSPN"
    task i3 "Inform the SP about the assignment of MSPN"
    and join
    end e1 "Application rejected"
    end e2 "MSPN assigned"

flow s -> reg -> exam -> d
flow d -> rej "no" default
flow d -> conf "yes" when="confirmed = true"
flow rej -> e1
flow conf -> assign -> fork
flow fork -> i1 -> join
flow fork -> i2 -> join
flow fork -> i3 -> join
flow join -> e2
