<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Market organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>succ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Change needed" />
    <bpmn:task id="req" name="Request change" />
    <bpmn:task id="rev" name="Review change request" />
    <bpmn:exclusiveGateway id="ok" name="Request confirmed?" default="f-ok-rej" />
    <bpmn:task id="rej" name="Reject change of measuring point" />
    <bpmn:task id="conf" name="Confirm request" />
    <bpmn:task id="perf" name="Perform measuring point change" />
    <bpmn:exclusiveGateway id="succ" name="Change successful?" default="f-succ-fail" />
    <bpmn:task id="rep" name="Report implementation" />
    <bpmn:task id="fail" name="Notify about failure of changes" />
    <bpmn:endEvent id="e1" name="Request rejected" />
    <bpmn:endEvent id="e2" name="Implementation reported" />
    <bpmn:endEvent id="e3" name="Failure notified" />
    <bpmn:sequenceFlow id="f-s1-req" sourceRef="s1" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-rev" sourceRef="req" targetRef="rev" />
    <bpmn:sequenceFlow id="f-rev-ok" sourceRef="rev" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-conf" name="yes" sourceRef="ok" targetRef="conf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-rej" name="no" sourceRef="ok" targetRef="rej" />
    <bpmn:sequenceFlow id="f-rej-e1" sourceRef="rej" targetRef="e1" />
    <bpmn:sequenceFlow id="f-conf-perf" sourceRef="conf" targetRef="perf" />
    <bpmn:sequenceFlow id="f-perf-succ" sourceRef="perf" targetRef="succ" />
    <bpmn:sequenceFlow id="f-succ-rep" name="yes" sourceRef="succ" targetRef="rep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">success = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-succ-fail" name="no" sourceRef="succ" targetRef="fail" />
    <bpmn:sequenceFlow id="f-rep-e2" sourceRef="rep" targetRef="e2" />
    <bpmn:sequenceFlow id="f-fail-e3" sourceRef="fail" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
