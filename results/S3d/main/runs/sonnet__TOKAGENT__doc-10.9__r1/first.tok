tok 1.0 "Measuring point change"

pool org "Market organisation"
  lane sp "SP / PU / GO"
    start s1 "Change needed"
    task req "Request change"
  lane mpo "MPO"
    task rev "Review change request"
    xor ok "Request confirmed?"
    task rej "Reject change of measuring point"
    task conf "Confirm request"
    task perf "Perform measuring point change"
    xor succ "Change successful?"
    task rep "Report implementation"
    task fail "Notify about failure of changes"
    end e1 "Request rejected"
    end e2 "Implementation reported"
    end e3 "Failure notified"

flow s1 -> req -> rev -> ok
flow ok -> conf "yes" when="confirmed = true"
flow ok -> rej "no" default
flow rej -> e1
flow conf -> perf -> succ
flow succ -> rep "yes" when="success = true"
flow succ -> fail "no" default
flow rep -> e2
flow fail -> e3
