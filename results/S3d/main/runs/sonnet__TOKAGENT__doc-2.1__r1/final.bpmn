<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="TELECO service degradation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Trouble_shooting_report" name="Trouble-shooting report" />
  <bpmn:message id="Message_Restoration_request" name="Restoration request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="TELECO service degradation" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>t_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_prem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_prem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="el" name="Electronic service">
        <bpmn:flowNodeRef>t_signif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>t_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_an</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trouble_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_stat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_path</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_res</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_prob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_an_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trouble_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_term</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bc" name="Billing and Collections">
        <bpmn:flowNodeRef>t_bill</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Service degradation perceived" />
    <bpmn:task id="t_list" name="Send list of problem parameters" />
    <bpmn:task id="t_recv" name="Receive report on service performance and problem resolution" />
    <bpmn:endEvent id="e_cust" name="Customer process ended" />
    <bpmn:task id="t_enter" name="Enter problem report into system T" />
    <bpmn:task id="t_sla" name="Compare problem report to customer SLA" />
    <bpmn:exclusiveGateway id="m_cm" />
    <bpmn:task id="t_cm" name="Determine counter measures and priorities" />
    <bpmn:exclusiveGateway id="g_prem" name="Is the customer premium?" default="f-g_prem-m_prem" />
    <bpmn:task id="t_extra" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="m_prem" />
    <bpmn:exclusiveGateway id="g_sig" name="Does customer significance affect the counter measures?" default="f-g_sig-t_detail" />
    <bpmn:task id="t_detail" name="Create detailed problem report" />
    <bpmn:task id="t_send_sm" name="Send detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="m_cs" />
    <bpmn:parallelGateway id="sp_cs" />
    <bpmn:task id="t_rep" name="Create report for customer" />
    <bpmn:task id="t_send_rep" name="Send report to customer" />
    <bpmn:parallelGateway id="sp_rep" />
    <bpmn:task id="t_rebate" name="Report SLA violation rebate to Billing and Collections" />
    <bpmn:parallelGateway id="j_cs" />
    <bpmn:endEvent id="e_cs" name="Customer Service process ended" />
    <bpmn:task id="t_signif" name="Determine significance of customer" />
    <bpmn:task id="t_inv" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="g_an" name="Is the problem analyzable by Service Management?" default="f-g_an-t_analyze" />
    <bpmn:task id="t_send_rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="t_analyze" name="Perform analysis" />
    <bpmn:task id="t_trouble_sm" name="Create trouble report" />
    <bpmn:exclusiveGateway id="m_stat" />
    <bpmn:task id="t_final" name="Prepare final status report" />
    <bpmn:task id="t_decide" name="Determine counter measures" />
    <bpmn:exclusiveGateway id="g_path" name="Which counter measures are required?" default="f-g_path-t_req" />
    <bpmn:task id="t_perf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="t_minor" name="Undertake corrective actions" />
    <bpmn:task id="t_req" name="Create request for automatic resource restoration" />
    <bpmn:task id="t_send_req" name="Send restoration request to Resource Provisioning" />
    <bpmn:intermediateCatchEvent id="c_ts" name="Trouble-shooting report received">
      <bpmn:messageEventDefinition id="c_ts-def" messageRef="Message_Trouble_shooting_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="m_res" />
    <bpmn:task id="t_resol" name="Create problem resolution report" />
    <bpmn:task id="t_send_res" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="t_check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="g_prob" name="Is a problem detected?" default="f-g_prob-t_notif" />
    <bpmn:task id="t_notif" name="Create normal execution notification" />
    <bpmn:task id="t_an_rp" name="Analyze problem" />
    <bpmn:task id="t_trouble_rp" name="Create trouble report" />
    <bpmn:exclusiveGateway id="m_rp" />
    <bpmn:task id="t_status" name="Include report in status report and send it to Service Management" />
    <bpmn:parallelGateway id="sp_rp" />
    <bpmn:eventBasedGateway id="ev_wait" />
    <bpmn:intermediateCatchEvent id="c_req" name="Restoration request received">
      <bpmn:messageEventDefinition id="c_req-def" messageRef="Message_Restoration_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_to" name="2 days passed">
      <bpmn:timerEventDefinition id="c_to-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_term" name="Resource Provisioning process terminated" />
    <bpmn:task id="t_track" name="Track errors" />
    <bpmn:task id="t_corr" name="Undertake corrective actions" />
    <bpmn:task id="t_ts" name="Create trouble-shooting report" />
    <bpmn:task id="t_send_ts" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="e_rp" name="Resource Provisioning process ended" />
    <bpmn:task id="t_bill" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-s-t_list" sourceRef="s" targetRef="t_list" />
    <bpmn:sequenceFlow id="f-t_list-t_enter" sourceRef="t_list" targetRef="t_enter" />
    <bpmn:sequenceFlow id="f-t_enter-t_sla" sourceRef="t_enter" targetRef="t_sla" />
    <bpmn:sequenceFlow id="f-t_sla-m_cm" sourceRef="t_sla" targetRef="m_cm" />
    <bpmn:sequenceFlow id="f-m_cm-t_cm" sourceRef="m_cm" targetRef="t_cm" />
    <bpmn:sequenceFlow id="f-t_cm-t_signif" sourceRef="t_cm" targetRef="t_signif" />
    <bpmn:sequenceFlow id="f-t_signif-g_prem" sourceRef="t_signif" targetRef="g_prem" />
    <bpmn:sequenceFlow id="f-g_prem-t_extra" name="yes" sourceRef="g_prem" targetRef="t_extra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">premium = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_prem-m_prem" name="no" sourceRef="g_prem" targetRef="m_prem" />
    <bpmn:sequenceFlow id="f-t_extra-m_prem" sourceRef="t_extra" targetRef="m_prem" />
    <bpmn:sequenceFlow id="f-m_prem-g_sig" sourceRef="m_prem" targetRef="g_sig" />
    <bpmn:sequenceFlow id="f-g_sig-m_cm" name="yes" sourceRef="g_sig" targetRef="m_cm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">affectsMeasures = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_sig-t_detail" name="no" sourceRef="g_sig" targetRef="t_detail" />
    <bpmn:sequenceFlow id="f-t_detail-t_send_sm" sourceRef="t_detail" targetRef="t_send_sm" />
    <bpmn:sequenceFlow id="f-t_send_sm-t_inv" sourceRef="t_send_sm" targetRef="t_inv" />
    <bpmn:sequenceFlow id="f-t_inv-g_an" sourceRef="t_inv" targetRef="g_an" />
    <bpmn:sequenceFlow id="f-g_an-t_send_rp" name="no" sourceRef="g_an" targetRef="t_send_rp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">analyzable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_an-t_analyze" name="yes" sourceRef="g_an" targetRef="t_analyze" />
    <bpmn:sequenceFlow id="f-t_analyze-t_trouble_sm" sourceRef="t_analyze" targetRef="t_trouble_sm" />
    <bpmn:sequenceFlow id="f-t_trouble_sm-m_stat" sourceRef="t_trouble_sm" targetRef="m_stat" />
    <bpmn:sequenceFlow id="f-t_send_rp-t_check" sourceRef="t_send_rp" targetRef="t_check" />
    <bpmn:sequenceFlow id="f-t_check-g_prob" sourceRef="t_check" targetRef="g_prob" />
    <bpmn:sequenceFlow id="f-g_prob-t_notif" name="no" sourceRef="g_prob" targetRef="t_notif" />
    <bpmn:sequenceFlow id="f-g_prob-t_an_rp" name="yes" sourceRef="g_prob" targetRef="t_an_rp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">problemDetected = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_an_rp-t_trouble_rp" sourceRef="t_an_rp" targetRef="t_trouble_rp" />
    <bpmn:sequenceFlow id="f-t_trouble_rp-m_rp" sourceRef="t_trouble_rp" targetRef="m_rp" />
    <bpmn:sequenceFlow id="f-t_notif-m_rp" sourceRef="t_notif" targetRef="m_rp" />
    <bpmn:sequenceFlow id="f-m_rp-t_status" sourceRef="m_rp" targetRef="t_status" />
    <bpmn:sequenceFlow id="f-t_status-sp_rp" sourceRef="t_status" targetRef="sp_rp" />
    <bpmn:sequenceFlow id="f-sp_rp-m_stat" sourceRef="sp_rp" targetRef="m_stat" />
    <bpmn:sequenceFlow id="f-sp_rp-ev_wait" sourceRef="sp_rp" targetRef="ev_wait" />
    <bpmn:sequenceFlow id="f-ev_wait-c_req" sourceRef="ev_wait" targetRef="c_req" />
    <bpmn:sequenceFlow id="f-ev_wait-c_to" sourceRef="ev_wait" targetRef="c_to" />
    <bpmn:sequenceFlow id="f-c_to-e_term" sourceRef="c_to" targetRef="e_term" />
    <bpmn:sequenceFlow id="f-c_req-t_track" sourceRef="c_req" targetRef="t_track" />
    <bpmn:sequenceFlow id="f-t_track-t_corr" sourceRef="t_track" targetRef="t_corr" />
    <bpmn:sequenceFlow id="f-t_corr-t_ts" sourceRef="t_corr" targetRef="t_ts" />
    <bpmn:sequenceFlow id="f-t_ts-t_send_ts" sourceRef="t_ts" targetRef="t_send_ts" />
    <bpmn:sequenceFlow id="f-t_send_ts-e_rp" sourceRef="t_send_ts" targetRef="e_rp" />
    <bpmn:sequenceFlow id="f-m_stat-t_final" sourceRef="m_stat" targetRef="t_final" />
    <bpmn:sequenceFlow id="f-t_final-t_decide" sourceRef="t_final" targetRef="t_decide" />
    <bpmn:sequenceFlow id="f-t_decide-g_path" sourceRef="t_decide" targetRef="g_path" />
    <bpmn:sequenceFlow id="f-g_path-t_perf" name="no problem" sourceRef="g_path" targetRef="t_perf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">path = "none"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_path-t_minor" name="minor corrective actions" sourceRef="g_path" targetRef="t_minor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">path = "minor"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_path-t_req" name="automatic restoration" sourceRef="g_path" targetRef="t_req" />
    <bpmn:sequenceFlow id="f-t_perf-m_cs" sourceRef="t_perf" targetRef="m_cs" />
    <bpmn:sequenceFlow id="f-t_minor-m_res" sourceRef="t_minor" targetRef="m_res" />
    <bpmn:sequenceFlow id="f-t_req-t_send_req" sourceRef="t_req" targetRef="t_send_req" />
    <bpmn:sequenceFlow id="f-t_send_req-c_ts" sourceRef="t_send_req" targetRef="c_ts" />
    <bpmn:sequenceFlow id="f-c_ts-m_res" sourceRef="c_ts" targetRef="m_res" />
    <bpmn:sequenceFlow id="f-m_res-t_resol" sourceRef="m_res" targetRef="t_resol" />
    <bpmn:sequenceFlow id="f-t_resol-t_send_res" sourceRef="t_resol" targetRef="t_send_res" />
    <bpmn:sequenceFlow id="f-t_send_res-m_cs" sourceRef="t_send_res" targetRef="m_cs" />
    <bpmn:sequenceFlow id="f-m_cs-sp_cs" sourceRef="m_cs" targetRef="sp_cs" />
    <bpmn:sequenceFlow id="f-sp_cs-t_rep" sourceRef="sp_cs" targetRef="t_rep" />
    <bpmn:sequenceFlow id="f-t_rep-t_send_rep" sourceRef="t_rep" targetRef="t_send_rep" />
    <bpmn:sequenceFlow id="f-t_send_rep-sp_rep" sourceRef="t_send_rep" targetRef="sp_rep" />
    <bpmn:sequenceFlow id="f-sp_cs-t_rebate" sourceRef="sp_cs" targetRef="t_rebate" />
    <bpmn:sequenceFlow id="f-t_rebate-t_bill" sourceRef="t_rebate" targetRef="t_bill" />
    <bpmn:sequenceFlow id="f-t_bill-j_cs" sourceRef="t_bill" targetRef="j_cs" />
    <bpmn:sequenceFlow id="f-sp_rep-j_cs" sourceRef="sp_rep" targetRef="j_cs" />
    <bpmn:sequenceFlow id="f-sp_rep-t_recv" sourceRef="sp_rep" targetRef="t_recv" />
    <bpmn:sequenceFlow id="f-j_cs-e_cs" sourceRef="j_cs" targetRef="e_cs" />
    <bpmn:sequenceFlow id="f-t_recv-e_cust" sourceRef="t_recv" targetRef="e_cust" />
  </bpmn:process>
</bpmn:definitions>
