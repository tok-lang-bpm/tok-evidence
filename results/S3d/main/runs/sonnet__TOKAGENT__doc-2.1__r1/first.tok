tok 1.0 "TELECO service degradation"

pool teleco "TELECO"
  lane cust "Customer"
    start s "Service degradation perceived"
    task t_list "Send list of problem parameters"
    task t_recv "Receive report on service performance and problem resolution"
    end e_cust "Customer process ended"
  lane cs "Customer Service"
    task t_enter "Enter problem report into system T"
    task t_sla "Compare problem report to customer SLA"
    xor m_cm
    task t_cm "Determine counter measures and priorities"
    xor g_prem "Is the customer premium?"
    task t_extra "Link to extra problem fix process"
    xor m_prem
    xor g_sig "Does customer significance affect the counter measures?"
    task t_detail "Create detailed problem report"
    task t_send_sm "Send detailed problem report to Service Management"
    xor m_cs
    and sp_cs
    task t_rep "Create report for customer"
    task t_send_rep "Send report to customer"
    and sp_rep
    task t_rebate "Report SLA violation rebate to Billing and Collections"
    and j_cs
    end e_cs "Customer Service process ended"
  lane el "Electronic service"
    task t_signif "Determine significance of customer"
  lane sm "Service Management"
    task t_inv "Investigate whether problem is analyzable"
    xor g_an "Is the problem analyzable by Service Management?"
    task t_send_rp "Send detailed problem report to Resource Provisioning"
    task t_analyze "Perform analysis"
    task t_trouble_sm "Create trouble report"
    xor m_stat
    task t_final "Prepare final status report"
    task t_decide "Determine counter measures"
    xor g_path "Which counter measures are required?"
    task t_perf "Send actual service performance to Customer Service"
    task t_minor "Undertake corrective actions"
    task t_req "Create request for automatic resource restoration"
    task t_send_req "Send restoration request to Resource Provisioning"
    catch c_ts "Trouble-shooting report received" message="Trouble-shooting report"
    xor m_res
    task t_resol "Create problem resolution report"
    task t_send_res "Send problem resolution report to Customer Service"
  lane rp "Resource Provisioning"
    task t_check "Check for possible problems"
    xor g_prob "Is a problem detected?"
    task t_notif "Create normal execution notification"
    task t_an_rp "Analyze problem"
    task t_trouble_rp "Create trouble report"
    xor m_rp
    task t_status "Include report in status report and send it to Service Management"
    and sp_rp
    eventgw ev_wait
    catch c_req "Restoration request received" message="Restoration request"
    catch c_to "2 days passed" timer=P2D
    end e_term "Resource Provisioning process terminated"
    task t_track "Track errors"
    task t_corr "Undertake corrective actions"
    task t_ts "Create trouble-shooting report"
    task t_send_ts "Send trouble-shooting report to Service Management"
    end e_rp "Resource Provisioning process ended"
  lane bc "Billing and Collections"
    task t_bill "Adjust billing"

flow s -> t_list -> t_enter -> t_sla -> m_cm -> t_cm -> t_signif -> g_prem
flow g_prem -> t_extra "yes" when="premium = true"
flow g_prem -> m_prem "no" default
flow t_extra -> m_prem
flow m_prem -> g_sig
flow g_sig -> m_cm "yes" when="affectsMeasures = true"
flow g_sig -> t_detail "no" default
flow t_detail -> t_send_sm -> t_inv -> g_an
flow g_an -> t_send_rp "no" when="analyzable = false"
flow g_an -> t_analyze "yes" default
flow t_analyze -> t_trouble_sm -> m_stat
flow t_send_rp -> t_check -> g_prob
flow g_prob -> t_notif "no" default
flow g_prob -> t_an_rp "yes" when="problemDetected = true"
flow t_an_rp -> t_trouble_rp -> m_rp
flow t_notif -> m_rp
flow m_rp -> t_status -> sp_rp
flow sp_rp -> m_stat
flow sp_rp -> ev_wait
flow ev_wait -> c_req
flow ev_wait -> c_to
flow c_to -> e_term
flow c_req -> t_track -> t_corr -> t_ts -> t_send_ts -> e_rp
flow m_stat -> t_final -> t_decide -> g_path
flow g_path -> t_perf "no problem" when="path = &quot;none&quot;"
flow g_path -> t_minor "minor corrective actions" when="path = &quot;minor&quot;"
flow g_path -> t_req "automatic restoration" default
flow t_perf -> m_cs
flow t_minor -> m_res
flow t_req -> t_send_req -> c_ts -> m_res
flow m_res -> t_resol -> t_send_res -> m_cs
flow m_cs -> sp_cs
flow sp_cs -> t_rep -> t_send_rep -> sp_rep
flow sp_cs -> t_rebate -> t_bill -> j_cs
flow sp_rep -> j_cs
flow sp_rep -> t_recv
flow j_cs -> e_cs
flow t_recv -> e_cust
