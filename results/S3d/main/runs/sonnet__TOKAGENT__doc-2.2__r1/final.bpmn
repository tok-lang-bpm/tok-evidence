<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Power supplier switch-over" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Contract_confirmation" name="Contract confirmation" />
  <bpmn:message id="Message_Contract_withdrawal" name="Contract withdrawal" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Power supplier switch-over" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Power supplier switch-over" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer service">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid operator">
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old" name="Old supplier">
        <bpmn:flowNodeRef>t24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t25</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Switch-over request initiated" />
    <bpmn:task id="t1" name="Transmit customer data" />
    <bpmn:task id="t17" name="Check contract details" />
    <bpmn:task id="t30" name="Receive final billing" />
    <bpmn:endEvent id="e3" name="Process ended for customer" />
    <bpmn:task id="t2" name="Receive customer data" />
    <bpmn:task id="t3" name="Enter customer data object into CRM system" />
    <bpmn:task id="t4" name="Compare customer data with customer data base" />
    <bpmn:exclusiveGateway id="g1" name="Errors found?" />
    <bpmn:task id="t5" name="Correct errors using error list" />
    <bpmn:exclusiveGateway id="g2" name="Customer exists in data base?" />
    <bpmn:task id="t6" name="Create new customer object" />
    <bpmn:exclusiveGateway id="g3" />
    <bpmn:task id="t7" name="Prepare contract documents" />
    <bpmn:task id="t10" name="Analyze and resolve issues" />
    <bpmn:task id="t11" name="Send confirmation document to customer" />
    <bpmn:task id="t15" name="Create CIS contract" />
    <bpmn:eventBasedGateway id="g6" name="Customer response?" />
    <bpmn:intermediateCatchEvent id="c1" name="Confirmation received">
      <bpmn:messageEventDefinition id="c1-def" messageRef="Message_Contract_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c2" name="Withdrawal received">
      <bpmn:messageEventDefinition id="c2-def" messageRef="Message_Contract_withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c3" name="7 days passed">
      <bpmn:timerEventDefinition id="c3-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e2" name="Process ended by withdrawal" />
    <bpmn:exclusiveGateway id="g7" />
    <bpmn:task id="t22" name="Receive meter data" />
    <bpmn:task id="t23" name="Import meter data to systems" />
    <bpmn:endEvent id="e4" name="Customer won" />
    <bpmn:task id="t8" name="Check contract documents automatically" />
    <bpmn:exclusiveGateway id="g4" name="Documents generated successfully?" />
    <bpmn:task id="t12" name="Send request to grid operator" />
    <bpmn:task id="t13" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="t14" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="g5" name="Supplier concurrence?" />
    <bpmn:task id="t16" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:endEvent id="e1" name="Switch-over stopped" />
    <bpmn:task id="t18" name="Terminate sales agreement with old supplier" />
    <bpmn:parallelGateway id="g8" />
    <bpmn:task id="t19" name="Transmit power meter data" />
    <bpmn:task id="t20" name="Compute final billing" />
    <bpmn:task id="t21" name="Send final billing to old supplier" />
    <bpmn:parallelGateway id="g9" />
    <bpmn:endEvent id="e5" name="Grid operator finished" />
    <bpmn:task id="t24" name="Create final billing" />
    <bpmn:task id="t25" name="Send final billing to customer" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-g1" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t5" name="yes" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t4" sourceRef="t5" targetRef="t4" />
    <bpmn:sequenceFlow id="f-g1-g2" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t6" name="no" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="f-g2-g3" name="yes" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-t6-g3" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t7" sourceRef="g3" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-g4" sourceRef="t8" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-t10" name="no" sourceRef="g4" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-g3" sourceRef="t10" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g4-t11" name="yes" sourceRef="g4" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-t12" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-t13" sourceRef="t12" targetRef="t13" />
    <bpmn:sequenceFlow id="f-t13-t14" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t14-g5" sourceRef="t14" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-t16" name="yes" sourceRef="g5" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t16-e1" sourceRef="t16" targetRef="e1" />
    <bpmn:sequenceFlow id="f-g5-t18" name="no" sourceRef="g5" targetRef="t18" />
    <bpmn:sequenceFlow id="f-t18-t15" sourceRef="t18" targetRef="t15" />
    <bpmn:sequenceFlow id="f-t15-t17" sourceRef="t15" targetRef="t17" />
    <bpmn:sequenceFlow id="f-t17-g6" sourceRef="t17" targetRef="g6" />
    <bpmn:sequenceFlow id="f-g6-c1" sourceRef="g6" targetRef="c1" />
    <bpmn:sequenceFlow id="f-g6-c2" sourceRef="g6" targetRef="c2" />
    <bpmn:sequenceFlow id="f-g6-c3" sourceRef="g6" targetRef="c3" />
    <bpmn:sequenceFlow id="f-c2-e2" sourceRef="c2" targetRef="e2" />
    <bpmn:sequenceFlow id="f-c1-g7" sourceRef="c1" targetRef="g7" />
    <bpmn:sequenceFlow id="f-c3-g7" sourceRef="c3" targetRef="g7" />
    <bpmn:sequenceFlow id="f-g7-g8" sourceRef="g7" targetRef="g8" />
    <bpmn:sequenceFlow id="f-g8-t19" sourceRef="g8" targetRef="t19" />
    <bpmn:sequenceFlow id="f-g8-t20" sourceRef="g8" targetRef="t20" />
    <bpmn:sequenceFlow id="f-t19-t22" sourceRef="t19" targetRef="t22" />
    <bpmn:sequenceFlow id="f-t22-t23" sourceRef="t22" targetRef="t23" />
    <bpmn:sequenceFlow id="f-t23-e4" sourceRef="t23" targetRef="e4" />
    <bpmn:sequenceFlow id="f-t20-t21" sourceRef="t20" targetRef="t21" />
    <bpmn:sequenceFlow id="f-t21-g9" sourceRef="t21" targetRef="g9" />
    <bpmn:sequenceFlow id="f-g9-e5" sourceRef="g9" targetRef="e5" />
    <bpmn:sequenceFlow id="f-g9-t24" sourceRef="g9" targetRef="t24" />
    <bpmn:sequenceFlow id="f-t24-t25" sourceRef="t24" targetRef="t25" />
    <bpmn:sequenceFlow id="f-t25-t30" sourceRef="t25" targetRef="t30" />
    <bpmn:sequenceFlow id="f-t30-e3" sourceRef="t30" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
