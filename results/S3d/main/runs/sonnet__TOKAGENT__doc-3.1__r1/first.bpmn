<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Small Claims Registry Operations" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Warrant possession request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bo" name="Client Service Back Office">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Warrant release needed" />
    <bpmn:task id="t1" name="Send warrant possession request" />
    <bpmn:task id="t2" name="Receive request" />
    <bpmn:task id="t3" name="Retrieve SCT file" />
    <bpmn:task id="t4" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="t5" name="Store SCT physical file" />
    <bpmn:task id="t7" name="Receive report" />
    <bpmn:task id="t8" name="Retrieve SCT file again" />
    <bpmn:task id="t9" name="Attach new SCT document" />
    <bpmn:task id="t10" name="Store expanded SCT physical file" />
    <bpmn:endEvent id="e" name="Physical SCT file handed over" />
    <bpmn:task id="t6" name="Send report" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-e" sourceRef="t10" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
