tok 1.0 "Warrant possession request"

pool org "Small Claims Registry Operations"
  lane party "Party"
    start s "Warrant release needed"
    task t1 "Send warrant possession request"
  lane bo "Client Service Back Office"
    task t2 "Receive request"
    task t3 "Retrieve SCT file"
    task t4 "Forward SCT Warrant Possession to Queensland Police"
    task t5 "Store SCT physical file"
    task t7 "Receive report"
    task t8 "Retrieve SCT file again"
    task t9 "Attach new SCT document"
    task t10 "Store expanded SCT physical file"
    end e "Physical SCT file handed over"
  lane police "Queensland Police"
    task t6 "Send report"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 -> t8 -> t9 -> t10 -> e
