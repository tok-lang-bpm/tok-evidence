<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court files" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court files" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="staff" name="Court staff">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Morning of hearing day" />
    <bpmn:task id="check" name="Check files" />
    <bpmn:exclusiveGateway id="miss" name="Files missing?" />
    <bpmn:task id="search" name="Initiate search" />
    <bpmn:task id="track" name="Track files to intended location" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="hand" name="Hand files to Associate" />
    <bpmn:task id="distribute" name="Distribute Judge's Lawlist to relevant people" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="conduct" name="Conduct directions hearings" />
    <bpmn:endEvent id="e" name="Hearings conducted" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-miss" sourceRef="check" targetRef="miss" />
    <bpmn:sequenceFlow id="f-miss-search" name="yes" sourceRef="miss" targetRef="search" />
    <bpmn:sequenceFlow id="f-miss-track" name="no" sourceRef="miss" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-merge" sourceRef="search" targetRef="merge" />
    <bpmn:sequenceFlow id="f-track-merge" sourceRef="track" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-fork" sourceRef="merge" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-hand" sourceRef="fork" targetRef="hand" />
    <bpmn:sequenceFlow id="f-fork-distribute" sourceRef="fork" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-join" sourceRef="hand" targetRef="join" />
    <bpmn:sequenceFlow id="f-distribute-join" sourceRef="distribute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-conduct" sourceRef="join" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-e" sourceRef="conduct" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
