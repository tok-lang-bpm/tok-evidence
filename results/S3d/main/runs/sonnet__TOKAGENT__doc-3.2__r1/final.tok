tok 1.0 "Court files"
pool court "Court"
  lane staff "Court staff"
    start s "Morning of hearing day"
    task check "Check files"
    xor miss "Files missing?"
    task search "Initiate search"
    task track "Track files to intended location"
    xor merge
    and fork
    task hand "Hand files to Associate"
    task distribute "Distribute Judge's Lawlist to relevant people"
    and join
    task conduct "Conduct directions hearings"
    end e "Hearings conducted"
flow s -> check -> miss
flow miss -> search "yes"
flow miss -> track "no"
flow search -> merge
flow track -> merge
flow merge -> fork
flow fork -> hand
flow fork -> distribute
flow hand -> join
flow distribute -> join
flow join -> conduct -> e
