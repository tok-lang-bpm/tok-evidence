tok 1.0 "Claim handling"

pool org "Insurance company"
  lane co "Claims officer"
    start s "Claim registered"
    task examine "Examine claim"
    task write "Write settlement recommendation"
  lane sco "Senior claims officer"
    task check "Check recommendation"
    xor ok "Claim OK?"
    task proceed "Proceed with claim handling"
    end e "Claim handling proceeds"

flow s -> examine -> write -> check -> ok
flow ok -> write "Not OK" when="verdict = \"Not OK\""
flow ok -> proceed "OK" default
flow proceed -> e
