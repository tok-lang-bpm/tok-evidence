<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="co" name="Claims officer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sco" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Claim registered" />
    <bpmn:task id="examine" name="Examine claim" />
    <bpmn:task id="write" name="Write settlement recommendation" />
    <bpmn:task id="check" name="Check recommendation" />
    <bpmn:exclusiveGateway id="ok" name="Claim OK?" default="f-ok-proceed" />
    <bpmn:task id="proceed" name="Proceed with claim handling" />
    <bpmn:endEvent id="e" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-s-examine" sourceRef="s" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-write" sourceRef="examine" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-check" sourceRef="write" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-write" name="Not OK" sourceRef="ok" targetRef="write">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">verdict = "Not OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-proceed" name="OK" sourceRef="ok" targetRef="proceed" />
    <bpmn:sequenceFlow id="f-proceed-e" sourceRef="proceed" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
