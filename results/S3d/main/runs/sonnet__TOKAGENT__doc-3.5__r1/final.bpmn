<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Incoming mail processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Court organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incoming mail processing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="clerk" name="Mail Clerk">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="arm" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Mail to be collected" />
    <bpmn:task id="t1" name="Collect mail" />
    <bpmn:task id="t2" name="Sort unopened mail into business areas" />
    <bpmn:task id="t3" name="Distribute mail" />
    <bpmn:task id="t4" name="Open mail" />
    <bpmn:task id="t5" name="Sort mail into groups for distribution" />
    <bpmn:task id="t6" name="Register mail in Mail Register" />
    <bpmn:task id="t7" name="Perform quality check" />
    <bpmn:exclusiveGateway id="g1" name="Is the mail compliant?" default="f-g1-t8" />
    <bpmn:task id="t8" name="Compile list of requisition" />
    <bpmn:task id="t9" name="Send list of requisition back to party" />
    <bpmn:endEvent id="e1" name="Mail rejected" />
    <bpmn:task id="t10" name="Capture matter details" />
    <bpmn:task id="t11" name="Provide matter details to Cashier" />
    <bpmn:parallelGateway id="g3" name="Split" />
    <bpmn:task id="t13" name="Put receipt and copied documents into envelope" />
    <bpmn:task id="t14" name="Post envelope to party" />
    <bpmn:parallelGateway id="g4" name="Join" />
    <bpmn:endEvent id="e2" name="Mail processed" />
    <bpmn:task id="t12" name="Take applicable fees" />
    <bpmn:task id="t15" name="Capture Party Details" />
    <bpmn:task id="t16" name="Print Physical Court File" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-g1" sourceRef="t7" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t8" name="no" sourceRef="g1" targetRef="t8" />
    <bpmn:sequenceFlow id="f-g1-t10" name="yes" sourceRef="g1" targetRef="t10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compliant = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-e1" sourceRef="t9" targetRef="e1" />
    <bpmn:sequenceFlow id="f-t10-t11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-t12" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-g3" sourceRef="t12" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t13" sourceRef="g3" targetRef="t13" />
    <bpmn:sequenceFlow id="f-g3-t15" sourceRef="g3" targetRef="t15" />
    <bpmn:sequenceFlow id="f-t13-t14" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t14-g4" sourceRef="t14" targetRef="g4" />
    <bpmn:sequenceFlow id="f-t15-t16" sourceRef="t15" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t16-g4" sourceRef="t16" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-e2" sourceRef="g4" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
