tok 1.0 "Incoming mail processing"

pool org "Court organisation"
  lane clerk "Mail Clerk"
    start s "Mail to be collected"
    task t1 "Collect mail"
    task t2 "Sort unopened mail into business areas"
    task t3 "Distribute mail"
  lane registry "Registry"
    task t4 "Open mail"
    task t5 "Sort mail into groups for distribution"
    task t6 "Register mail in Mail Register"
  lane arm "Assistant Registry Manager"
    task t7 "Perform quality check"
    xor g1 "Is the mail compliant?"
    task t8 "Compile list of requisition"
    task t9 "Send list of requisition back to party"
    end e1 "Mail rejected"
    task t10 "Capture matter details"
    task t11 "Provide matter details to Cashier"
    and g3 "Split"
    task t13 "Put receipt and copied documents into envelope"
    task t14 "Post envelope to party"
    and g4 "Join"
    end e2 "Mail processed"
  lane cashier "Cashier"
    task t12 "Take applicable fees"
    task t15 "Capture Party Details"
    task t16 "Print Physical Court File"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 -> g1
flow g1 -> t8 "no" default
flow g1 -> t10 "yes" when="compliant = true"
flow t8 -> t9 -> e1
flow t10 -> t11 -> t12 -> g3
flow g3 -> t13
flow g3 -> t15
flow t13 -> t14 -> g4
flow t15 -> t16 -> g4
flow g4 -> e2
