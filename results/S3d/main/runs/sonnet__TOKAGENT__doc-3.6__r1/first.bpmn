<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims Notification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Forms" name="Forms" />
  <bpmn:message id="Message_Updated_forms" name="Updated forms" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Insurance organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claims Notification" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="l" name="Claims handling">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ru</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Claim received" />
    <bpmn:task id="chk" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="g1" name="Claimant insured?" />
    <bpmn:task id="rej" name="Inform claimant that claim must be rejected" />
    <bpmn:endEvent id="e1" name="Claim rejected" />
    <bpmn:task id="sev" name="Evaluate severity of claim" />
    <bpmn:exclusiveGateway id="g2" name="Claim simple or complex?" />
    <bpmn:task id="fs" name="Send forms for simple claim" />
    <bpmn:task id="fc" name="Send forms for complex claim" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:receiveTask id="rf" name="Receive returned forms" messageRef="Message_Forms" />
    <bpmn:task id="cf" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="g3" name="Forms complete?" />
    <bpmn:task id="reg" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="e2" name="Claim registered" />
    <bpmn:task id="upd" name="Inform claimant to update forms" />
    <bpmn:receiveTask id="ru" name="Receive updated forms" messageRef="Message_Updated_forms" />
    <bpmn:sequenceFlow id="f-s-chk" sourceRef="s" targetRef="chk" />
    <bpmn:sequenceFlow id="f-chk-g1" sourceRef="chk" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-rej" name="no" sourceRef="g1" targetRef="rej" />
    <bpmn:sequenceFlow id="f-g1-sev" name="yes" sourceRef="g1" targetRef="sev" />
    <bpmn:sequenceFlow id="f-rej-e1" sourceRef="rej" targetRef="e1" />
    <bpmn:sequenceFlow id="f-sev-g2" sourceRef="sev" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-fs" name="simple" sourceRef="g2" targetRef="fs" />
    <bpmn:sequenceFlow id="f-g2-fc" name="complex" sourceRef="g2" targetRef="fc" />
    <bpmn:sequenceFlow id="f-fs-m1" sourceRef="fs" targetRef="m1" />
    <bpmn:sequenceFlow id="f-fc-m1" sourceRef="fc" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-rf" sourceRef="m1" targetRef="rf" />
    <bpmn:sequenceFlow id="f-rf-cf" sourceRef="rf" targetRef="cf" />
    <bpmn:sequenceFlow id="f-cf-g3" sourceRef="cf" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-reg" name="yes" sourceRef="g3" targetRef="reg" />
    <bpmn:sequenceFlow id="f-g3-upd" name="no" sourceRef="g3" targetRef="upd" />
    <bpmn:sequenceFlow id="f-reg-e2" sourceRef="reg" targetRef="e2" />
    <bpmn:sequenceFlow id="f-upd-ru" sourceRef="upd" targetRef="ru" />
    <bpmn:sequenceFlow id="f-ru-cf" sourceRef="ru" targetRef="cf" />
  </bpmn:process>
</bpmn:definitions>
