tok 1.0 "Claim handling"

pool org "Insurance company"
  lane handler "Claims handler"
    start s "Claim received"
    task t1 "Search police report in Police Report database"
    task t2 "Put police report in file with claim documentation"
    task t3 "Calculate initial claim estimate"
    task t4 "Create action plan based on checklist"
  lane manager "Claims manager"
    task t5 "Negotiate settlement on claim estimate"
    task t6 "Inform claimant of outcome"
    end e "Process ended"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> e
