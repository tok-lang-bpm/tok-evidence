<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car insurance claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Claim" name="Claim" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car insurance claim" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="notif" name="Notification department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hand" name="Handling department">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Claim submitted">
      <bpmn:messageEventDefinition id="s-def" messageRef="Message_Claim" />
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Check documents for completeness" />
    <bpmn:task id="t2" name="Register claim" />
    <bpmn:task id="t3" name="Check insurance" />
    <bpmn:task id="t4" name="Perform assessment" />
    <bpmn:exclusiveGateway id="g1" name="Assessment positive?" />
    <bpmn:task id="t5" name="Phone garage to authorise repairs" />
    <bpmn:task id="t6" name="Schedule payment" />
    <bpmn:task id="t7" name="Reject claim" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="t8" name="Send letter to customer" />
    <bpmn:endEvent id="e" name="Claim completed" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-g1" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t5" name="yes" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-g1-t7" name="no" sourceRef="g1" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-g2" sourceRef="t6" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t7-g2" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t8" sourceRef="g2" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-e" sourceRef="t8" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
