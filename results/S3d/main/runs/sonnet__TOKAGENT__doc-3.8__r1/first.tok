tok 1.0 "Car insurance claim"

pool insurer "Car insurer"
  lane notif "Notification department"
    start s "Claim submitted" message="Claim"
    task t1 "Check documents for completeness"
    task t2 "Register claim"
  lane hand "Handling department"
    task t3 "Check insurance"
    task t4 "Perform assessment"
    xor g1 "Assessment positive?"
    task t5 "Phone garage to authorise repairs"
    task t6 "Schedule payment"
    task t7 "Reject claim"
    xor g2
    task t8 "Send letter to customer"
    end e "Claim completed"

flow s -> t1 -> t2 -> t3 -> t4 -> g1
flow g1 -> t5 "yes"
flow g1 -> t7 "no"
flow t5 -> t6 -> g2
flow t7 -> g2
flow g2 -> t8 -> e
