<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Medical_file_copy" name="Medical file copy" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Mental health care institute" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sec" name="Secretarial office">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t40</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t50</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t51</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nur" name="Nursing officer">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tl" name="Team-leader">
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fi" name="First intaker">
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="si" name="Second intaker">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ps" name="Psychiatrist">
        <bpmn:flowNodeRef>t52</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Notice by telephone received" />
    <bpmn:task id="t1" name="Inquire name and residence of patient" />
    <bpmn:task id="t4" name="Hand in registration form" />
    <bpmn:task id="t5" name="Store information in information system" />
    <bpmn:task id="t6" name="Print information from information system" />
    <bpmn:exclusiveGateway id="g1" name="New patient?" />
    <bpmn:task id="t7" name="Create patient file" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t8" name="Store registration form and print in patient file" />
    <bpmn:task id="t9" name="Produce registration cards" />
    <bpmn:task id="t10" name="Add patient to list of new notices" />
    <bpmn:intermediateCatchEvent id="w" name="Wednesday staff meeting">
      <bpmn:timerEventDefinition id="w-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t20" name="Store assignment in information system" />
    <bpmn:task id="t21" name="Pass registration cards to first and second intaker" />
    <bpmn:exclusiveGateway id="g2" name="Medical file required?" />
    <bpmn:task id="t22" name="Prepare and send letter requesting medical file" />
    <bpmn:intermediateCatchEvent id="c1" name="Copy of medical file received">
      <bpmn:messageEventDefinition id="c1-def" messageRef="Message_Medical_file_copy" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t23" name="Inform second intaker" />
    <bpmn:task id="t24" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:task id="t40" name="Type out dictaphone tapes" />
    <bpmn:task id="t41" name="Add information to patient file" />
    <bpmn:parallelGateway id="p2" />
    <bpmn:task id="t50" name="Put patient on list of patients with both meetings done" />
    <bpmn:task id="t51" name="Provide team-leader with list of patients" />
    <bpmn:task id="t2" name="Make full inquiry into state of patient" />
    <bpmn:task id="t3" name="Record information on registration form" />
    <bpmn:task id="t11" name="Assign first and second intaker to new patients" />
    <bpmn:task id="t12" name="Determine whether medical file is required" />
    <bpmn:task id="t13" name="Record assignments on assignment list" />
    <bpmn:task id="t14" name="Hand assignment list to secretarial office" />
    <bpmn:task id="f1" name="Plan first meeting with patient" />
    <bpmn:task id="f2" name="Examine patient using standard checklist" />
    <bpmn:task id="f3" name="Register additional observations in notebook" />
    <bpmn:task id="f4" name="Put copy of notes in patient file" />
    <bpmn:task id="f5" name="Add checklist to patient file" />
    <bpmn:task id="s1" name="Plan first meeting with patient" />
    <bpmn:task id="s2" name="Examine patient" />
    <bpmn:task id="s3" name="Record observations with dictaphone" />
    <bpmn:task id="t52" name="Formulate treatment plan" />
    <bpmn:endEvent id="e" name="Intake procedure ended" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-g1" sourceRef="t6" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t7" name="yes" sourceRef="g1" targetRef="t7" />
    <bpmn:sequenceFlow id="f-g1-m1" name="no" sourceRef="g1" targetRef="m1" />
    <bpmn:sequenceFlow id="f-t7-m1" sourceRef="t7" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-t8" sourceRef="m1" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-w" sourceRef="t10" targetRef="w" />
    <bpmn:sequenceFlow id="f-w-t11" sourceRef="w" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-t12" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-t13" sourceRef="t12" targetRef="t13" />
    <bpmn:sequenceFlow id="f-t13-t14" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t14-t20" sourceRef="t14" targetRef="t20" />
    <bpmn:sequenceFlow id="f-t20-t21" sourceRef="t20" targetRef="t21" />
    <bpmn:sequenceFlow id="f-t21-g2" sourceRef="t21" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t22" name="yes" sourceRef="g2" targetRef="t22" />
    <bpmn:sequenceFlow id="f-g2-m2" name="no" sourceRef="g2" targetRef="m2" />
    <bpmn:sequenceFlow id="f-t22-c1" sourceRef="t22" targetRef="c1" />
    <bpmn:sequenceFlow id="f-c1-t23" sourceRef="c1" targetRef="t23" />
    <bpmn:sequenceFlow id="f-t23-t24" sourceRef="t23" targetRef="t24" />
    <bpmn:sequenceFlow id="f-t24-m2" sourceRef="t24" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-p1" sourceRef="m2" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-f1" sourceRef="p1" targetRef="f1" />
    <bpmn:sequenceFlow id="f-p1-s1" sourceRef="p1" targetRef="s1" />
    <bpmn:sequenceFlow id="f-f1-f2" sourceRef="f1" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-f3" sourceRef="f2" targetRef="f3" />
    <bpmn:sequenceFlow id="f-f3-f4" sourceRef="f3" targetRef="f4" />
    <bpmn:sequenceFlow id="f-f4-f5" sourceRef="f4" targetRef="f5" />
    <bpmn:sequenceFlow id="f-f5-p2" sourceRef="f5" targetRef="p2" />
    <bpmn:sequenceFlow id="f-s1-s2" sourceRef="s1" targetRef="s2" />
    <bpmn:sequenceFlow id="f-s2-s3" sourceRef="s2" targetRef="s3" />
    <bpmn:sequenceFlow id="f-s3-t40" sourceRef="s3" targetRef="t40" />
    <bpmn:sequenceFlow id="f-t40-t41" sourceRef="t40" targetRef="t41" />
    <bpmn:sequenceFlow id="f-t41-p2" sourceRef="t41" targetRef="p2" />
    <bpmn:sequenceFlow id="f-p2-t50" sourceRef="p2" targetRef="t50" />
    <bpmn:sequenceFlow id="f-t50-t51" sourceRef="t50" targetRef="t51" />
    <bpmn:sequenceFlow id="f-t51-t52" sourceRef="t51" targetRef="t52" />
    <bpmn:sequenceFlow id="f-t52-e" sourceRef="t52" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
