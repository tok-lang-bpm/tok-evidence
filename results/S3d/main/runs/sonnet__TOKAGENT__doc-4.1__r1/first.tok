tok 1.0 "Intake workflow"

pool org "Mental health care institute"
  lane sec "Secretarial office"
    start s "Notice by telephone received"
    task t1 "Inquire name and residence of patient"
    task t4 "Hand in registration form"
    task t5 "Store information in information system"
    task t6 "Print information from information system"
    xor g1 "New patient?"
    task t7 "Create patient file"
    xor m1
    task t8 "Store registration form and print in patient file"
    task t9 "Produce registration cards"
    task t10 "Add patient to list of new notices"
    catch w "Wednesday staff meeting" timer=P7D
    task t20 "Store assignment in information system"
    task t21 "Pass registration cards to first and second intaker"
    xor g2 "Medical file required?"
    task t22 "Prepare and send letter requesting medical file"
    catch c1 "Copy of medical file received" message="Medical file copy"
    task t23 "Inform second intaker"
    task t24 "Add copy to patient file"
    xor m2
    and p1
    task t40 "Type out dictaphone tapes"
    task t41 "Add information to patient file"
    and p2
    task t50 "Put patient on list of patients with both meetings done"
    task t51 "Provide team-leader with list of patients"
  lane nur "Nursing officer"
    task t2 "Make full inquiry into state of patient"
    task t3 "Record information on registration form"
  lane tl "Team-leader"
    task t11 "Assign first and second intaker to new patients"
    task t12 "Determine whether medical file is required"
    task t13 "Record assignments on assignment list"
    task t14 "Hand assignment list to secretarial office"
  lane fi "First intaker"
    task f1 "Plan first meeting with patient"
    task f2 "Examine patient using standard checklist"
    task f3 "Register additional observations in notebook"
    task f4 "Put copy of notes in patient file"
    task f5 "Add checklist to patient file"
  lane si "Second intaker"
    task s1 "Plan first meeting with patient"
    task s2 "Examine patient"
    task s3 "Record observations with dictaphone"
  lane ps "Psychiatrist"
    task t52 "Formulate treatment plan"
    end e "Intake procedure ended"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> g1
flow g1 -> t7 "yes"
flow g1 -> m1 "no"
flow t7 -> m1
flow m1 -> t8 -> t9 -> t10 -> w -> t11 -> t12 -> t13 -> t14 -> t20 -> t21 -> g2
flow g2 -> t22 "yes"
flow g2 -> m2 "no"
flow t22 -> c1 -> t23 -> t24 -> m2
flow m2 -> p1
flow p1 -> f1
flow p1 -> s1
flow f1 -> f2 -> f3 -> f4 -> f5 -> p2
flow s1 -> s2 -> s3 -> t40 -> t41 -> p2
flow p2 -> t50 -> t51 -> t52 -> e
