tok 1.0 "Loan approval"

pool org "Loan approval"
  lane assessor "Risk assessment Web service"
    start s "Loan request received"
    task receive-request "Receive customer request"
    task assess "Assess request"
    xor g1 "Which outcome?"
    task approve "Approve loan"
    task deny "Deny loan"
    xor m1
    task feedback "Send feedback to customer"
    end e "Customer informed"
  lane approver "Approver Web service"
    task review "Send request to approver"

flow s -> receive-request -> assess -> g1
flow g1 -> approve "small loan and low risk" when="amount < 10000 and risk = \"low\""
flow g1 -> deny "high risk" when="risk = \"high\""
flow g1 -> review "further review or amount 10000 or more" default
flow approve -> m1
flow deny -> m1
flow review -> m1
flow m1 -> feedback -> e
