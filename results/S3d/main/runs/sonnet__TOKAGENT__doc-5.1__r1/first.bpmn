<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Loan approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Loan approval" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Loan approval" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="assessor" name="Risk assessment Web service">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="approver" name="Approver Web service">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Loan request received" />
    <bpmn:task id="receive-request" name="Receive customer request" />
    <bpmn:task id="assess" name="Assess request" />
    <bpmn:exclusiveGateway id="g1" name="Which outcome?" default="f-g1-review" />
    <bpmn:task id="approve" name="Approve loan" />
    <bpmn:task id="deny" name="Deny loan" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="feedback" name="Send feedback to customer" />
    <bpmn:endEvent id="e" name="Customer informed" />
    <bpmn:task id="review" name="Send request to approver" />
    <bpmn:sequenceFlow id="f-s-receive-request" sourceRef="s" targetRef="receive-request" />
    <bpmn:sequenceFlow id="f-receive-request-assess" sourceRef="receive-request" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-g1" sourceRef="assess" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-approve" name="small loan and low risk" sourceRef="g1" targetRef="approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &lt; 10000 and risk = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-deny" name="high risk" sourceRef="g1" targetRef="deny">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">risk = "high"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-review" name="further review or amount 10000 or more" sourceRef="g1" targetRef="review" />
    <bpmn:sequenceFlow id="f-approve-m1" sourceRef="approve" targetRef="m1" />
    <bpmn:sequenceFlow id="f-deny-m1" sourceRef="deny" targetRef="m1" />
    <bpmn:sequenceFlow id="f-review-m1" sourceRef="review" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-feedback" sourceRef="m1" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-e" sourceRef="feedback" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
