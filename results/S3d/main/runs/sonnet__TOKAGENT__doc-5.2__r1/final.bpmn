<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="emp" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sup" name="Immediate supervisor">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>manage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Vacation request needed" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="review" name="Review rejection reasons" />
    <bpmn:endEvent id="e1" name="Request rejected" />
    <bpmn:task id="register" name="Receive vacation request" />
    <bpmn:task id="decide" name="Approve or reject request" />
    <bpmn:exclusiveGateway id="g" name="Request approved?" default="f-g-review" />
    <bpmn:task id="notify" name="Notify Human Resources Representative" />
    <bpmn:task id="manage" name="Complete management procedures" />
    <bpmn:endEvent id="e2" name="Vacation arranged" />
    <bpmn:sequenceFlow id="f-s-submit" sourceRef="s" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-decide" sourceRef="register" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-g" sourceRef="decide" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-notify" name="yes" sourceRef="g" targetRef="notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-review" name="no" sourceRef="g" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-e1" sourceRef="review" targetRef="e1" />
    <bpmn:sequenceFlow id="f-notify-manage" sourceRef="notify" targetRef="manage" />
    <bpmn:sequenceFlow id="f-manage-e2" sourceRef="manage" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
