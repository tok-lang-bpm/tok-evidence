tok 1.0 "Vacations Request"

pool org "Organization"
  lane emp "Employee"
    start s "Vacation request needed"
    task submit "Submit vacation request"
    task review "Review rejection reasons"
    end e1 "Request rejected"
  lane sup "Immediate supervisor"
    task register "Receive vacation request"
    task decide "Approve or reject request"
    xor g "Request approved?"
    task notify "Notify Human Resources Representative"
  lane hr "Human Resources Representative"
    task manage "Complete management procedures"
    end e2 "Vacation arranged"

flow s -> submit -> register -> decide -> g
flow g -> notify "yes" when="approved = true"
flow g -> review "no" default
flow review -> e1
flow notify -> manage -> e2
