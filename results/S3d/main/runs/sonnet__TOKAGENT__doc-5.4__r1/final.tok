tok 1.0 "Expense report"

pool org "Company"
  lane emp "Employee"
    start s "Start"
    task buy "Purchase product or service"
    task submit "Submit expense report"
    task edit "Edit expense report"
  lane sup "Supervisor"
    xor m1
    task review "Review expense report"
    xor g1 "Report approved?"
  lane tre "Treasurer"
    task check "Check receipts against items"
    xor g2 "All in order?"
    task accept "Accept expenses for processing"
  lane pay "Payment system"
    task dopay "Link to payment system"
    catch conf "Payment confirmed" message="Payment confirmation"
    end e "End"

flow s -> buy -> submit -> m1 -> review -> g1
flow g1 -> check "yes"
flow g1 -> edit "no"
flow check -> g2
flow g2 -> accept "yes"
flow g2 -> edit "no"
flow edit -> m1
flow accept -> dopay -> conf -> e
