<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense report" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Payment_confirmation" name="Payment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense report" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="emp" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sup" name="Supervisor">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tre" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pay" name="Payment system">
        <bpmn:flowNodeRef>dopay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="buy" name="Purchase product or service" />
    <bpmn:task id="submit" name="Submit expense report" />
    <bpmn:task id="edit" name="Edit expense report" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="review" name="Review expense report" />
    <bpmn:exclusiveGateway id="g1" name="Report approved?" />
    <bpmn:task id="check" name="Check receipts against items" />
    <bpmn:exclusiveGateway id="g2" name="All in order?" />
    <bpmn:task id="accept" name="Accept expenses for processing" />
    <bpmn:task id="dopay" name="Link to payment system" />
    <bpmn:intermediateCatchEvent id="conf" name="Payment confirmed">
      <bpmn:messageEventDefinition id="conf-def" messageRef="Message_Payment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-buy" sourceRef="s" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-submit" sourceRef="buy" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-m1" sourceRef="submit" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-review" sourceRef="m1" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g1" sourceRef="review" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-check" name="yes" sourceRef="g1" targetRef="check" />
    <bpmn:sequenceFlow id="f-g1-edit" name="no" sourceRef="g1" targetRef="edit" />
    <bpmn:sequenceFlow id="f-check-g2" sourceRef="check" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-accept" name="yes" sourceRef="g2" targetRef="accept" />
    <bpmn:sequenceFlow id="f-g2-edit" name="no" sourceRef="g2" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-m1" sourceRef="edit" targetRef="m1" />
    <bpmn:sequenceFlow id="f-accept-dopay" sourceRef="accept" targetRef="dopay" />
    <bpmn:sequenceFlow id="f-dopay-conf" sourceRef="dopay" targetRef="conf" />
    <bpmn:sequenceFlow id="f-conf-e" sourceRef="conf" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
