<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="ACME invoice processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="ACME invoice processing" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="sec" name="Secretariat">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Accounting employee">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ccm" name="Cost center manager">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="com" name="Commercial manager">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="brd" name="Board">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Invoice received on paper or fax" />
    <bpmn:task id="t1" name="Receive invoice in central inbox" />
    <bpmn:task id="t2" name="Inspect invoice visually" />
    <bpmn:task id="t3" name="Forward invoice to accounting employee" />
    <bpmn:task id="a1" name="Identify charging supplier" />
    <bpmn:task id="a2" name="Create invoice instance" />
    <bpmn:task id="a3" name="Check invoice items" />
    <bpmn:task id="a4" name="Note cost centers and managers on docket" />
    <bpmn:task id="a5" name="Send docket and invoice copy to first cost center manager" />
    <bpmn:task id="a6" name="Clarify inconsistencies with vendor" />
    <bpmn:task id="a7" name="Consult cost center managers" />
    <bpmn:task id="a8" name="Send invoice copy to cost center managers again" />
    <bpmn:task id="a9" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="a10" name="Resolve complaint with supplier" />
    <bpmn:task id="a11" name="File invoice copy and docket in signature file" />
    <bpmn:task id="a12" name="Give payment instructions" />
    <bpmn:task id="a13" name="Close instance" />
    <bpmn:endEvent id="e" name="Invoice processed" />
    <bpmn:exclusiveGateway id="j1" />
    <bpmn:exclusiveGateway id="j2" />
    <bpmn:exclusiveGateway id="j3" />
    <bpmn:task id="c1" name="Review invoice content for accuracy" />
    <bpmn:exclusiveGateway id="g1" name="Everything in order?" />
    <bpmn:task id="c2" name="Note AP on docket" />
    <bpmn:task id="c3" name="Reject AP with note and statement on docket" />
    <bpmn:exclusiveGateway id="g2" name="All positions marked AP?" />
    <bpmn:task id="c4" name="Send invoice copy to next cost center manager" />
    <bpmn:task id="m1" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="g3" name="Complaint?" />
    <bpmn:task id="m2" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="g4" name="Amount exceeds EUR 20?" />
    <bpmn:task id="b1" name="Check invoice again" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-a1" sourceRef="t3" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-a2" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-a3" sourceRef="a2" targetRef="a3" />
    <bpmn:sequenceFlow id="f-a3-a4" sourceRef="a3" targetRef="a4" />
    <bpmn:sequenceFlow id="f-a4-a5" sourceRef="a4" targetRef="a5" />
    <bpmn:sequenceFlow id="f-a5-j1" sourceRef="a5" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-c1" sourceRef="j1" targetRef="c1" />
    <bpmn:sequenceFlow id="f-c1-g1" sourceRef="c1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-c2" name="yes" sourceRef="g1" targetRef="c2" />
    <bpmn:sequenceFlow id="f-g1-c3" name="no" sourceRef="g1" targetRef="c3" />
    <bpmn:sequenceFlow id="f-c2-g2" sourceRef="c2" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-c4" name="no" sourceRef="g2" targetRef="c4" />
    <bpmn:sequenceFlow id="f-c4-j1" sourceRef="c4" targetRef="j1" />
    <bpmn:sequenceFlow id="f-g2-a9" name="yes" sourceRef="g2" targetRef="a9" />
    <bpmn:sequenceFlow id="f-c3-a6" sourceRef="c3" targetRef="a6" />
    <bpmn:sequenceFlow id="f-a6-a7" sourceRef="a6" targetRef="a7" />
    <bpmn:sequenceFlow id="f-a7-a8" sourceRef="a7" targetRef="a8" />
    <bpmn:sequenceFlow id="f-a8-j1" sourceRef="a8" targetRef="j1" />
    <bpmn:sequenceFlow id="f-a9-j2" sourceRef="a9" targetRef="j2" />
    <bpmn:sequenceFlow id="f-j2-m1" sourceRef="j2" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-g3" sourceRef="m1" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-a10" name="yes" sourceRef="g3" targetRef="a10" />
    <bpmn:sequenceFlow id="f-a10-j2" sourceRef="a10" targetRef="j2" />
    <bpmn:sequenceFlow id="f-g3-m2" name="no" sourceRef="g3" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-g4" sourceRef="m2" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-b1" name="yes" sourceRef="g4" targetRef="b1" />
    <bpmn:sequenceFlow id="f-g4-j3" name="no" sourceRef="g4" targetRef="j3" />
    <bpmn:sequenceFlow id="f-b1-j3" sourceRef="b1" targetRef="j3" />
    <bpmn:sequenceFlow id="f-j3-a11" sourceRef="j3" targetRef="a11" />
    <bpmn:sequenceFlow id="f-a11-a12" sourceRef="a11" targetRef="a12" />
    <bpmn:sequenceFlow id="f-a12-a13" sourceRef="a12" targetRef="a13" />
    <bpmn:sequenceFlow id="f-a13-e" sourceRef="a13" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
