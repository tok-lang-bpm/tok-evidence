tok 1.0 "Monthly order"
pool org "Order process"
  lane asm "Assembler AG"
    start s "First of month" timer=R/P1M
    task t1 "Send order"
    task t4 "Receive invoice"
    end e "Invoice received"
  lane sup "Supplier"
    task t2 "Process order"
    task t3 "Send invoice"
flow s -> t1 -> t2 -> t3 -> t4 -> e
