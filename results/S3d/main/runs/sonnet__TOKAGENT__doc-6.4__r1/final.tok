tok 1.0 "Customer acquisition"

pool org "Company"
  lane mkt "Marketing"
    start s "Start"
    xor src "Source of contact details?"
    task buy "Buy contact details"
    task exh "Participate in exhibitions"
    task know "Use personal acquaintance"
    xor srcj
  lane cc "Call center"
    task callc "Call customer"
    task det "Determine contact person and budget"
    task ask "Ask whether customer is interested"
    xor int "Customer interested?"
    xor big "Budget huge?"
    xor intj
    end e1 "Customer left alone"
  lane dev "Head of development"
    task acq "Acquire customer personally"
    xor int2 "Customer interested in the end?"
  lane sales "Sales representative"
    xor tech "Technical presentation?"
    task pres "Give online presentation"
    xor presj
    eventgw wait
    catch back "Customer contacts us" message="Customer contact"
    catch tm "No contact within 2 weeks" timer=P14D
    task rem "Call customer again"
    xor qj
    task quo "Create quotation"
    end e2 "Quotation created"
  lane pre "Pre-sales"
    task tpres "Give technical online presentation"

flow s -> src
flow src -> buy "Buy details"
flow src -> exh "Exhibition"
flow src -> know "Personal acquaintance"
flow buy -> srcj
flow exh -> srcj
flow know -> srcj -> callc -> det -> ask -> int
flow int -> intj "yes"
flow int -> big "no"
flow big -> acq "yes"
flow big -> e1 "no"
flow acq -> int2
flow int2 -> intj "yes"
flow int2 -> e1 "no"
flow intj -> tech
flow tech -> tpres "yes"
flow tech -> pres "no"
flow tpres -> presj
flow pres -> presj -> wait
flow wait -> back
flow wait -> tm
flow back -> qj
flow tm -> rem -> qj -> quo -> e2
