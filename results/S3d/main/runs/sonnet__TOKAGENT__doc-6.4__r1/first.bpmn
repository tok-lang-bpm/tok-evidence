<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_contact" name="Customer contact" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mkt" name="Marketing">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>src</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>srcj</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cc" name="Call center">
        <bpmn:flowNodeRef>callc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>det</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>big</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dev" name="Head of development">
        <bpmn:flowNodeRef>acq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>int2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pre" name="Pre-sales">
        <bpmn:flowNodeRef>tpres</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="src" name="Source of contact details?" />
    <bpmn:task id="buy" name="Buy contact details" />
    <bpmn:task id="exh" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Use personal acquaintance" />
    <bpmn:exclusiveGateway id="srcj" />
    <bpmn:task id="callc" name="Call customer" />
    <bpmn:task id="det" name="Determine contact person and budget" />
    <bpmn:task id="ask" name="Ask whether customer is interested" />
    <bpmn:exclusiveGateway id="int" name="Customer interested?" />
    <bpmn:exclusiveGateway id="big" name="Budget huge?" />
    <bpmn:exclusiveGateway id="intj" />
    <bpmn:endEvent id="e1" name="Customer left alone" />
    <bpmn:task id="acq" name="Acquire customer personally" />
    <bpmn:exclusiveGateway id="int2" name="Customer interested in the end?" />
    <bpmn:exclusiveGateway id="tech" name="Technical presentation?" />
    <bpmn:task id="pres" name="Give online presentation" />
    <bpmn:exclusiveGateway id="presj" />
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="back" name="Customer contacts us">
      <bpmn:messageEventDefinition id="back-def" messageRef="Message_Customer_contact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm" name="No contact within 2 weeks">
      <bpmn:timerEventDefinition id="tm-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="rem" name="Call customer again" />
    <bpmn:exclusiveGateway id="qj" />
    <bpmn:task id="quo" name="Create quotation" />
    <bpmn:endEvent id="e2" name="Quotation created" />
    <bpmn:task id="tpres" name="Give technical online presentation" />
    <bpmn:sequenceFlow id="f-s-src" sourceRef="s" targetRef="src" />
    <bpmn:sequenceFlow id="f-src-buy" name="Buy details" sourceRef="src" targetRef="buy" />
    <bpmn:sequenceFlow id="f-src-exh" name="Exhibition" sourceRef="src" targetRef="exh" />
    <bpmn:sequenceFlow id="f-src-know" name="Personal acquaintance" sourceRef="src" targetRef="know" />
    <bpmn:sequenceFlow id="f-buy-srcj" sourceRef="buy" targetRef="srcj" />
    <bpmn:sequenceFlow id="f-exh-srcj" sourceRef="exh" targetRef="srcj" />
    <bpmn:sequenceFlow id="f-know-srcj" sourceRef="know" targetRef="srcj" />
    <bpmn:sequenceFlow id="f-srcj-callc" sourceRef="srcj" targetRef="callc" />
    <bpmn:sequenceFlow id="f-callc-det" sourceRef="callc" targetRef="det" />
    <bpmn:sequenceFlow id="f-det-ask" sourceRef="det" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-int" sourceRef="ask" targetRef="int" />
    <bpmn:sequenceFlow id="f-int-intj" name="yes" sourceRef="int" targetRef="intj" />
    <bpmn:sequenceFlow id="f-int-big" name="no" sourceRef="int" targetRef="big" />
    <bpmn:sequenceFlow id="f-big-acq" name="yes" sourceRef="big" targetRef="acq" />
    <bpmn:sequenceFlow id="f-big-e1" name="no" sourceRef="big" targetRef="e1" />
    <bpmn:sequenceFlow id="f-acq-int2" sourceRef="acq" targetRef="int2" />
    <bpmn:sequenceFlow id="f-int2-intj" name="yes" sourceRef="int2" targetRef="intj" />
    <bpmn:sequenceFlow id="f-int2-e1" name="no" sourceRef="int2" targetRef="e1" />
    <bpmn:sequenceFlow id="f-intj-tech" sourceRef="intj" targetRef="tech" />
    <bpmn:sequenceFlow id="f-tech-tpres" name="yes" sourceRef="tech" targetRef="tpres" />
    <bpmn:sequenceFlow id="f-tech-pres" name="no" sourceRef="tech" targetRef="pres" />
    <bpmn:sequenceFlow id="f-tpres-presj" sourceRef="tpres" targetRef="presj" />
    <bpmn:sequenceFlow id="f-pres-presj" sourceRef="pres" targetRef="presj" />
    <bpmn:sequenceFlow id="f-presj-wait" sourceRef="presj" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-back" sourceRef="wait" targetRef="back" />
    <bpmn:sequenceFlow id="f-wait-tm" sourceRef="wait" targetRef="tm" />
    <bpmn:sequenceFlow id="f-back-qj" sourceRef="back" targetRef="qj" />
    <bpmn:sequenceFlow id="f-tm-rem" sourceRef="tm" targetRef="rem" />
    <bpmn:sequenceFlow id="f-rem-qj" sourceRef="rem" targetRef="qj" />
    <bpmn:sequenceFlow id="f-qj-quo" sourceRef="qj" targetRef="quo" />
    <bpmn:sequenceFlow id="f-quo-e2" sourceRef="quo" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
