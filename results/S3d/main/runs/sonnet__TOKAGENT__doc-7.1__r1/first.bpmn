<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Lead handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Sales organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Lead handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mgr" name="Manager">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="asst" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="check" name="Check open leads" />
    <bpmn:task id="select" name="Select top five leads" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call contact persons" />
    <bpmn:task id="process" name="Process lead" />
    <bpmn:endEvent id="e" name="Lead processed" />
    <bpmn:task id="call" name="Call customer" />
    <bpmn:exclusiveGateway id="g" name="Is the customer interested?" />
    <bpmn:task id="note" name="Send note to Manager" />
    <bpmn:task id="next" name="Call next customer" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-g" sourceRef="call" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-note" name="yes" sourceRef="g" targetRef="note" />
    <bpmn:sequenceFlow id="f-g-next" name="no" sourceRef="g" targetRef="next" />
    <bpmn:sequenceFlow id="f-next-g" sourceRef="next" targetRef="g" />
    <bpmn:sequenceFlow id="f-note-process" sourceRef="note" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-e" sourceRef="process" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
