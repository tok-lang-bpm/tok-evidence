tok 1.0 "Lead handling"

pool org "Sales organisation"
  lane mgr "Manager"
    start s "Start"
    task check "Check open leads"
    task select "Select top five leads"
    task tell "Tell Sales Assistant to call contact persons"
    task process "Process lead"
    end e "Lead processed"
  lane asst "Sales Assistant"
    task call "Call customer"
    xor g "Is the customer interested?"
    task note "Send note to Manager"
    task next "Call next customer"

flow s -> check -> select -> tell -> call -> g
flow g -> note "yes"
flow g -> next "no"
flow next -> g
flow note -> process -> e
