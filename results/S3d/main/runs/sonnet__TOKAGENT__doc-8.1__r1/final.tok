tok 1.0 "Filling a post"

pool org "Organisation"
  lane hr "Human resources"
    start s "Demand to fill a post received"
    task advertise "Advertise the post"
    task receive-apps "Receive applications"
    task check-apps "Check applications"
    task conclude "Conclude contract of employment"
    end e "Post filled"

flow s -> advertise -> receive-apps -> check-apps -> conclude -> e
