<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Filling a post" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Filling a post" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="hr" name="Human resources">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-apps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-apps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Demand to fill a post received" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="receive-apps" name="Receive applications" />
    <bpmn:task id="check-apps" name="Check applications" />
    <bpmn:task id="conclude" name="Conclude contract of employment" />
    <bpmn:endEvent id="e" name="Post filled" />
    <bpmn:sequenceFlow id="f-s-advertise" sourceRef="s" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-receive-apps" sourceRef="advertise" targetRef="receive-apps" />
    <bpmn:sequenceFlow id="f-receive-apps-check-apps" sourceRef="receive-apps" targetRef="check-apps" />
    <bpmn:sequenceFlow id="f-check-apps-conclude" sourceRef="check-apps" targetRef="conclude" />
    <bpmn:sequenceFlow id="f-conclude-e" sourceRef="conclude" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
