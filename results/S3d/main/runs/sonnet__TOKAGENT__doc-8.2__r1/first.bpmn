<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job vacancy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hr" name="HR" processRef="hr-process" />
  </bpmn:collaboration>
  <bpmn:process id="hr-process" name="Job vacancy" isExecutable="false">
    <bpmn:laneSet id="hr-lanes">
      <bpmn:lane id="clerk" name="HR clerk">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Vacancy reported" />
    <bpmn:task id="create" name="Create job description" />
    <bpmn:exclusiveGateway id="clear" name="Information clear?" />
    <bpmn:task id="ask" name="Ask Department again" />
    <bpmn:task id="submit" name="Submit job description for consideration" />
    <bpmn:task id="wait" name="Wait for approval" />
    <bpmn:exclusiveGateway id="appr" name="Approved?" />
    <bpmn:task id="correct" name="Correct job description" />
    <bpmn:task id="post" name="Post job" />
    <bpmn:endEvent id="e" name="Job posted" />
    <bpmn:sequenceFlow id="f-s-create" sourceRef="s" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-clear" sourceRef="create" targetRef="clear" />
    <bpmn:sequenceFlow id="f-clear-submit" name="yes" sourceRef="clear" targetRef="submit" />
    <bpmn:sequenceFlow id="f-clear-ask" name="no" sourceRef="clear" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-create" sourceRef="ask" targetRef="create" />
    <bpmn:sequenceFlow id="f-submit-wait" sourceRef="submit" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-appr" sourceRef="wait" targetRef="appr" />
    <bpmn:sequenceFlow id="f-appr-post" name="yes" sourceRef="appr" targetRef="post" />
    <bpmn:sequenceFlow id="f-appr-correct" name="no" sourceRef="appr" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-submit" sourceRef="correct" targetRef="submit" />
    <bpmn:sequenceFlow id="f-post-e" sourceRef="post" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
