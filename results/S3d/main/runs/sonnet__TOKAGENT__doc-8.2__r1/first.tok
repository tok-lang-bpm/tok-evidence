tok 1.0 "Job vacancy"

pool hr "HR"
  lane clerk "HR clerk"
    start s "Vacancy reported"
    task create "Create job description"
    xor clear "Information clear?"
    task ask "Ask Department again"
    task submit "Submit job description for consideration"
    task wait "Wait for approval"
    xor appr "Approved?"
    task correct "Correct job description"
    task post "Post job"
    end e "Job posted"

flow s -> create -> clear
flow clear -> submit "yes"
flow clear -> ask "no"
flow ask -> create
flow submit -> wait -> appr
flow appr -> post "yes"
flow appr -> correct "no"
flow correct -> submit
flow post -> e
