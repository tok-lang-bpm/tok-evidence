<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Job description" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job description" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report vacancy" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:task id="review" name="Review job description" />
    <bpmn:exclusiveGateway id="g-corr" name="Corrections needed?" default="f-g-corr-approve" />
    <bpmn:task id="ask-corr" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:endEvent id="e" name="Job description approved" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="describe" name="Describe job" />
    <bpmn:exclusiveGateway id="g-q" name="Questions about tasks and requirements?" default="f-g-q-send" />
    <bpmn:task id="ask-q" name="Ask questions" />
    <bpmn:task id="send" name="Send job description for review" />
    <bpmn:task id="revise" name="Correct job description" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-m1" sourceRef="report" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-describe" sourceRef="m1" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-g-q" sourceRef="describe" targetRef="g-q" />
    <bpmn:sequenceFlow id="f-g-q-ask-q" name="yes" sourceRef="g-q" targetRef="ask-q">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">questions = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-q-send" name="no" sourceRef="g-q" targetRef="send" />
    <bpmn:sequenceFlow id="f-ask-q-clarify" sourceRef="ask-q" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-m1" sourceRef="clarify" targetRef="m1" />
    <bpmn:sequenceFlow id="f-send-m2" sourceRef="send" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-review" sourceRef="m2" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g-corr" sourceRef="review" targetRef="g-corr" />
    <bpmn:sequenceFlow id="f-g-corr-ask-corr" name="yes" sourceRef="g-corr" targetRef="ask-corr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrections = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-corr-approve" name="no" sourceRef="g-corr" targetRef="approve" />
    <bpmn:sequenceFlow id="f-ask-corr-revise" sourceRef="ask-corr" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-m2" sourceRef="revise" targetRef="m2" />
    <bpmn:sequenceFlow id="f-approve-e" sourceRef="approve" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
