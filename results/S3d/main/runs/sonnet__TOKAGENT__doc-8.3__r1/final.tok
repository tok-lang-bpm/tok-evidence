tok 1.0 "Job description"

pool org "Organisation"
  lane head "Head of functional department"
    start s "Personnel requirements detected"
    task report "Report vacancy"
    task clarify "Provide clarifications"
    task review "Review job description"
    xor g-corr "Corrections needed?"
    task ask-corr "Ask for corrections"
    task approve "Approve job description"
    end e "Job description approved"
  lane hr "Personnel Department"
    xor m1
    task describe "Describe job"
    xor g-q "Questions about tasks and requirements?"
    task ask-q "Ask questions"
    task send "Send job description for review"
    task revise "Correct job description"
    xor m2

flow s -> report -> m1 -> describe -> g-q
flow g-q -> ask-q "yes" when="questions = true"
flow g-q -> send "no" default
flow ask-q -> clarify -> m1
flow send -> m2 -> review -> g-corr
flow g-corr -> ask-corr "yes" when="corrections = true"
flow g-corr -> approve "no" default
flow ask-corr -> revise -> m2
flow approve -> e
