tok 1.0 "Defaulting accounts"

pool org "Organisation"
  lane ops "Operations"
    start s1 "Weekday morning" timer=R/P1D
    sub p1 "Produce defaulting account report"
      start a1 "Start"
      task backup "Back up database"
      task chk "Check Account Defaulter table for new records"
      xor g1 "New records found?"
      task crm1 "Check CRM system for new returns"
      xor g2 "New returns exist?"
      task reg "Register defaulting accounts and customers"
      xor g3 "Client codes previously advised?"
      task prod "Produce table of defaulting accounts"
      task sendt "Send table to account management"
      xor m3
      xor m1
      end a2 "Report completed"
    boundary b1 noninterrupting on=p1 timer=PT6H30M
    task alert1 "Send alert to supervisor"
    end e1 "Alert sent"
    sub p2 "Reconcile defaulters"
      start c1 "Start"
      task crm2 "Check CRM system for new returns"
      xor h1 "New returns filed?"
      task rec "Reconcile with existing account defaulters table"
      xor hm
      end c2 "Done"
    boundary b2 noninterrupting on=p2 timer=PT8H
    task alert2 "Send message to supervisor"
    end e2 "Message sent"
    end e3 "Process finished"

flow a1 -> backup -> chk -> g1
flow g1 -> m1 "yes"
flow g1 -> crm1 "no"
flow crm1 -> g2
flow g2 -> reg "yes"
flow g2 -> m1 "no"
flow reg -> g3
flow g3 -> prod "no"
flow g3 -> m3 "yes"
flow prod -> sendt -> m3 -> m1 -> a2
flow c1 -> crm2 -> h1
flow h1 -> rec "yes"
flow h1 -> hm "no"
flow rec -> hm -> c2
flow s1 -> p1 -> p2 -> e3
flow b1 -> alert1 -> e1
flow b2 -> alert2 -> e2
