<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mortgage offer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Decline" name="Decline" />
  <bpmn:message id="Message_Offer_documents" name="Offer documents" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Bank" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Mortgage offer" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Mortgage offer to be sent" />
    <bpmn:task id="send" name="Send mortgage offer" />
    <bpmn:eventBasedGateway id="wait" name="Reply?" />
    <bpmn:intermediateCatchEvent id="decl" name="Customer declines mortgage">
      <bpmn:messageEventDefinition id="decl-def" messageRef="Message_Decline" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="docs" name="Customer returns offer documents">
      <bpmn:messageEventDefinition id="docs-def" messageRef="Message_Offer_documents" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="late" name="No answer after 2 weeks">
      <bpmn:timerEventDefinition id="late-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="complete" name="All prerequisite documents attached?" />
    <bpmn:task id="req" name="Generate message requesting outstanding documents" />
    <bpmn:task id="admin" name="Move case to administration" />
    <bpmn:endEvent id="done" name="Case moved to administration" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="upd" name="Update case details" />
    <bpmn:task id="arch" name="Archive work" />
    <bpmn:endEvent id="canc" name="Case cancelled" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-wait" sourceRef="send" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-decl" sourceRef="wait" targetRef="decl" />
    <bpmn:sequenceFlow id="f-wait-docs" sourceRef="wait" targetRef="docs" />
    <bpmn:sequenceFlow id="f-wait-late" sourceRef="wait" targetRef="late" />
    <bpmn:sequenceFlow id="f-decl-merge" sourceRef="decl" targetRef="merge" />
    <bpmn:sequenceFlow id="f-late-merge" sourceRef="late" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-upd" sourceRef="merge" targetRef="upd" />
    <bpmn:sequenceFlow id="f-upd-arch" sourceRef="upd" targetRef="arch" />
    <bpmn:sequenceFlow id="f-arch-canc" sourceRef="arch" targetRef="canc" />
    <bpmn:sequenceFlow id="f-docs-complete" sourceRef="docs" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-admin" name="yes" sourceRef="complete" targetRef="admin" />
    <bpmn:sequenceFlow id="f-complete-req" name="no" sourceRef="complete" targetRef="req" />
    <bpmn:sequenceFlow id="f-admin-done" sourceRef="admin" targetRef="done" />
    <bpmn:sequenceFlow id="f-req-wait" sourceRef="req" targetRef="wait" />
  </bpmn:process>
</bpmn:definitions>
