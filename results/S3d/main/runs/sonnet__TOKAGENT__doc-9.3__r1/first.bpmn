<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meeting schedule" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="tpa" name="Town Planning Authority" processRef="tpa-process" />
  </bpmn:collaboration>
  <bpmn:process id="tpa-process" name="Meeting schedule" isExecutable="false">
    <bpmn:laneSet id="tpa-lanes">
      <bpmn:lane id="cu" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="so" name="Support Officer">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cm" name="Committee Members">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="November arrives" />
    <bpmn:task id="t1" name="Draft schedule of meetings" />
    <bpmn:task id="t2" name="Add draft dates to all calendars" />
    <bpmn:task id="t4" name="Recheck all dates" />
    <bpmn:task id="t5" name="Look for potential conflicts" />
    <bpmn:task id="t6" name="Send final schedule to Committee Members by email" />
    <bpmn:task id="t8" name="Receive conflict advice" />
    <bpmn:endEvent id="e1" name="Schedule completed" />
    <bpmn:task id="t3" name="Check dates and suggest modifications" />
    <bpmn:task id="t7" name="Check diaries" />
    <bpmn:exclusiveGateway id="g" name="Any conflicts?" default="f-g-e2" />
    <bpmn:task id="t9" name="Advise Coordination Unit of conflicts" />
    <bpmn:endEvent id="e2" name="No conflicts" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-g" sourceRef="t7" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-t9" name="yes" sourceRef="g" targetRef="t9" />
    <bpmn:sequenceFlow id="f-g-e2" name="no" sourceRef="g" targetRef="e2" />
    <bpmn:sequenceFlow id="f-t9-t8" sourceRef="t9" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-e1" sourceRef="t8" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
