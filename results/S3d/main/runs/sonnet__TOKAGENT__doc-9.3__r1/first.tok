tok 1.0 "Meeting schedule"

pool tpa "Town Planning Authority"
  lane cu "Coordination Unit"
    start s "November arrives"
    task t1 "Draft schedule of meetings"
    task t2 "Add draft dates to all calendars"
    task t4 "Recheck all dates"
    task t5 "Look for potential conflicts"
    task t6 "Send final schedule to Committee Members by email"
    task t8 "Receive conflict advice"
    end e1 "Schedule completed"
  lane so "Support Officer"
    task t3 "Check dates and suggest modifications"
  lane cm "Committee Members"
    task t7 "Check diaries"
    xor g "Any conflicts?"
    task t9 "Advise Coordination Unit of conflicts"
    end e2 "No conflicts"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 -> g
flow g -> t9 "yes"
flow g -> e2 "no" default
flow t9 -> t8 -> e1
