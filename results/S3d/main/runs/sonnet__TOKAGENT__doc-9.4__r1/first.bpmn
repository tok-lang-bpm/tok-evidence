<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="officer" name="Support Officer">
        <bpmn:flowNodeRef>cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Dates finalized" />
    <bpmn:task id="qa" name="Conduct QA check on minutes" />
    <bpmn:task id="cal" name="Update group calendars" />
    <bpmn:task id="folders" name="Create meeting folders" />
    <bpmn:task id="upload" name="Upload documents to system" />
    <bpmn:task id="advise" name="Advise Committee Members to read documents" />
    <bpmn:task id="minutes" name="Produce minutes with Action Points" />
    <bpmn:task id="send" name="Send minutes to Committee Members" />
    <bpmn:task id="records" name="Update departmental records" />
    <bpmn:endEvent id="e" name="Records updated" />
    <bpmn:task id="meet" name="Hold meeting" />
    <bpmn:sequenceFlow id="f-s-cal" sourceRef="s" targetRef="cal" />
    <bpmn:sequenceFlow id="f-cal-folders" sourceRef="cal" targetRef="folders" />
    <bpmn:sequenceFlow id="f-folders-upload" sourceRef="folders" targetRef="upload" />
    <bpmn:sequenceFlow id="f-upload-advise" sourceRef="upload" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-meet" sourceRef="advise" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-minutes" sourceRef="meet" targetRef="minutes" />
    <bpmn:sequenceFlow id="f-minutes-qa" sourceRef="minutes" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send" sourceRef="qa" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-records" sourceRef="send" targetRef="records" />
    <bpmn:sequenceFlow id="f-records-e" sourceRef="records" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
