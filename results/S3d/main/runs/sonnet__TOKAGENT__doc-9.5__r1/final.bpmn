<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Expense report" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense report" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="l" name="Expense reimbursement">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e30</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Expense report received" />
    <bpmn:subProcess id="handle" name="Process expense report">
      <bpmn:startEvent id="hs" name="Start" />
      <bpmn:exclusiveGateway id="hasacc" name="Employee has an account?" />
      <bpmn:task id="mkacc" name="Create new account" />
      <bpmn:exclusiveGateway id="m1" />
      <bpmn:task id="review" name="Review expense report for automatic approval" />
      <bpmn:exclusiveGateway id="amt" name="Amount under $200?" />
      <bpmn:task id="auto" name="Approve automatically" />
      <bpmn:task id="appr" name="Approve expense report by supervisor" />
      <bpmn:exclusiveGateway id="ok" name="Approved?" />
      <bpmn:exclusiveGateway id="m2" />
      <bpmn:task id="pay" name="Reimburse to direct deposit account" />
      <bpmn:task id="rej" name="Send rejection notice by email" />
      <bpmn:endEvent id="he1" name="Reimbursed" />
      <bpmn:endEvent id="he2" name="Rejected" />
      <bpmn:sequenceFlow id="f-hs-hasacc" sourceRef="hs" targetRef="hasacc" />
      <bpmn:sequenceFlow id="f-hasacc-mkacc" name="no" sourceRef="hasacc" targetRef="mkacc" />
      <bpmn:sequenceFlow id="f-hasacc-m1" name="yes" sourceRef="hasacc" targetRef="m1" />
      <bpmn:sequenceFlow id="f-mkacc-m1" sourceRef="mkacc" targetRef="m1" />
      <bpmn:sequenceFlow id="f-m1-review" sourceRef="m1" targetRef="review" />
      <bpmn:sequenceFlow id="f-review-amt" sourceRef="review" targetRef="amt" />
      <bpmn:sequenceFlow id="f-amt-auto" name="yes" sourceRef="amt" targetRef="auto" />
      <bpmn:sequenceFlow id="f-amt-appr" name="no" sourceRef="amt" targetRef="appr" />
      <bpmn:sequenceFlow id="f-auto-m2" sourceRef="auto" targetRef="m2" />
      <bpmn:sequenceFlow id="f-appr-ok" sourceRef="appr" targetRef="ok" />
      <bpmn:sequenceFlow id="f-ok-m2" name="yes" sourceRef="ok" targetRef="m2" />
      <bpmn:sequenceFlow id="f-ok-rej" name="no" sourceRef="ok" targetRef="rej" />
      <bpmn:sequenceFlow id="f-m2-pay" sourceRef="m2" targetRef="pay" />
      <bpmn:sequenceFlow id="f-pay-he1" sourceRef="pay" targetRef="he1" />
      <bpmn:sequenceFlow id="f-rej-he2" sourceRef="rej" targetRef="he2" />
    </bpmn:subProcess>
    <bpmn:endEvent id="done" name="Request completed" />
    <bpmn:boundaryEvent id="t7" attachedToRef="handle" cancelActivity="false">
      <bpmn:timerEventDefinition id="t7-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="prog" name="Send approval in progress email" />
    <bpmn:endEvent id="e7" name="Notice sent" />
    <bpmn:boundaryEvent id="t30" attachedToRef="handle">
      <bpmn:timerEventDefinition id="t30-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="canc" name="Send cancellation notice by email" />
    <bpmn:task id="resub" name="Request re-submission of expense report" />
    <bpmn:endEvent id="e30" name="Request cancelled" />
    <bpmn:sequenceFlow id="f-s-handle" sourceRef="s" targetRef="handle" />
    <bpmn:sequenceFlow id="f-handle-done" sourceRef="handle" targetRef="done" />
    <bpmn:sequenceFlow id="f-t7-prog" sourceRef="t7" targetRef="prog" />
    <bpmn:sequenceFlow id="f-prog-e7" sourceRef="prog" targetRef="e7" />
    <bpmn:sequenceFlow id="f-t30-canc" sourceRef="t30" targetRef="canc" />
    <bpmn:sequenceFlow id="f-canc-resub" sourceRef="canc" targetRef="resub" />
    <bpmn:sequenceFlow id="f-resub-e30" sourceRef="resub" targetRef="e30" />
  </bpmn:process>
</bpmn:definitions>
