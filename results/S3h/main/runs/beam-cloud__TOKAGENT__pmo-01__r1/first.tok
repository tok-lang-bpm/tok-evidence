tok 1.0 "Sales process"
pool organisation "Organisation"
  lane sales_support "Sales staff or customer support"
    start inquiry "Customer inquires about product or service"
    task collect "Collect relevant information"
    task address "Address concerns and questions"
    xor interested "Customer interested?"
    task guide "Guide selection of product or service"
  lane sales_rep "Sales representative"
    task quote "Provide quote"
    xor approved "Quote approved?"
    task place "Place order"
  lane system "System"
    task record "Record order in system"
    task confirm "Send order confirmation"
    end success "Order placed and confirmed"
    end noSale "Process ended"
flow inquiry -> collect
flow collect -> address
flow address -> interested
flow interested -> guide "yes" when="customerInterested = true"
flow interested -> noSale "no" default
flow guide -> quote
flow quote -> approved
flow approved -> place "yes" when="quoteApproved = true"
flow approved -> noSale "no" default
flow place -> record
flow record -> confirm
flow confirm -> success