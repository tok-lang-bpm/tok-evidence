<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Hiring process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Organisation" name="Organisation" processRef="Organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="Organisation-process" name="Hiring process" isExecutable="false">
    <bpmn:laneSet id="Organisation-lanes">
      <bpmn:lane id="Department" name="Department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="HR" name="HR">
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Department identifies need for a new hire" />
    <bpmn:task id="d1" name="Identify need for new hire" />
    <bpmn:task id="j1" name="Create job description" />
    <bpmn:task id="j2" name="Post job description on job boards" />
    <bpmn:task id="r1" name="Collect resumes" />
    <bpmn:task id="r2" name="Screen resumes" />
    <bpmn:task id="p1" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="g1" name="Interview type?" />
    <bpmn:task id="i1" name="Conduct in-person interview" />
    <bpmn:task id="i2" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="g2" name="Interviews done?" />
    <bpmn:task id="choose" name="Select candidate" />
    <bpmn:task id="offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="g3" name="Salary negotiation required?" default="f-g3-g4" />
    <bpmn:task id="neg" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="g4" name="Offer accepted?" />
    <bpmn:task id="paper" name="Complete paperwork" />
    <bpmn:task id="orient" name="Complete orientation" />
    <bpmn:task id="train" name="Complete training" />
    <bpmn:endEvent id="e" name="New hire fully integrated" />
    <bpmn:sequenceFlow id="f-s-d1" sourceRef="s" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-j1" sourceRef="d1" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-j2" sourceRef="j1" targetRef="j2" />
    <bpmn:sequenceFlow id="f-j2-r1" sourceRef="j2" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-r2" sourceRef="r1" targetRef="r2" />
    <bpmn:sequenceFlow id="f-r2-p1" sourceRef="r2" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-g1" sourceRef="p1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-i1" name="in-person" sourceRef="g1" targetRef="i1" />
    <bpmn:sequenceFlow id="f-g1-i2" name="virtual" sourceRef="g1" targetRef="i2" />
    <bpmn:sequenceFlow id="f-i1-g2" sourceRef="i1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-i2-g2" sourceRef="i2" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-choose" sourceRef="g2" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-offer" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-g3" sourceRef="offer" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-neg" name="yes" sourceRef="g3" targetRef="neg" />
    <bpmn:sequenceFlow id="f-g3-g4" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f-neg-g4" sourceRef="neg" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-paper" name="accepted" sourceRef="g4" targetRef="paper" />
    <bpmn:sequenceFlow id="f-paper-orient" sourceRef="paper" targetRef="orient" />
    <bpmn:sequenceFlow id="f-orient-train" sourceRef="orient" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-e" sourceRef="train" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
