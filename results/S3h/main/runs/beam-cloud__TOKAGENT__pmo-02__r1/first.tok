tok 1.0 "Hiring process"

pool Organisation "Organisation"
  lane Department "Department"
    start s "Department identifies need for a new hire"
    task d1 "Identify need for new hire"
  lane HR "HR"
    task j1 "Create job description"
    task j2 "Post job description on job boards"
    task r1 "Collect resumes"
    task r2 "Screen resumes"
    task p1 "Conduct initial phone interviews"
    xor g1 "Interview type?"
    task i1 "Conduct in-person interview"
    task i2 "Conduct virtual interview"
    xor g2 "Interviews done?"
    task choose "Select candidate"
    task offer "Extend offer"
    xor g3 "Salary negotiation required?"
    task neg "Negotiate salary"
    xor g4 "Offer accepted?"
    task paper "Complete paperwork"
    task orient "Complete orientation"
    task train "Complete training"
    end e "New hire fully integrated"

flow s -> d1
flow d1 -> j1
flow j1 -> j2 -> r1 -> r2 -> p1 -> g1
flow g1 -> i1 "in-person"
flow g1 -> i2 "virtual"
flow i1 -> g2
flow i2 -> g2
flow g2 -> choose
flow choose -> offer -> g3
flow g3 -> neg "yes"
flow g3 -> g4 default
flow neg -> g4
flow g4 -> paper "accepted"
flow paper -> orient -> train -> e