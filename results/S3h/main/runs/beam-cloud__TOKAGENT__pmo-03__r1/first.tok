tok 1.0
pool org "Organisation"
  lane wh "Warehouse staff"
    start s "Start"
    task monitor "Monitor inventory levels"
    xor g "Stock reaches threshold?"
    task signal "Signal need to reorder"
    task receive "Receive stock"
    task inspect "Inspect stock for quality"
    task place-shelves "Place stock on shelves or in storage"
  lane sys "Inventory system"
    task update-dates "Update expected delivery dates"
    task record "Record stock in system"
    task update-levels "Update inventory levels"
    end e "End"
  lane proc "Procurement team"
    task place-order "Place order with suppliers"
pool suppliers "Suppliers"
flow s -> monitor
flow monitor -> g
flow g -> signal "Yes" when="stock at threshold = true"
flow g -> monitor "No" default
flow signal -> place-order
flow place-order -> update-dates
flow place-order -> suppliers message? no
flow update-dates -> receive
message place-order -> suppliers "Order"
message suppliers -> receive "Delivery"
flow receive -> inspect
flow inspect -> record
flow record -> place-shelves
flow place-shelves -> update-levels
flow update-levels -> e