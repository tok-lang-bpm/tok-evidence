<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>def</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="def" name="Define objectives of marketing campaign" />
    <bpmn:parallelGateway id="gw1" name="Prepare campaign" />
    <bpmn:task id="content" name="Create content" />
    <bpmn:task id="visuals" name="Design visuals" />
    <bpmn:task id="channels" name="Select channels" />
    <bpmn:parallelGateway id="gw2" name="Campaign ready" />
    <bpmn:task id="launch" name="Launch campaign" />
    <bpmn:task id="track" name="Track performance in real-time" />
    <bpmn:task id="analyze" name="Analyze performance for future optimization" />
    <bpmn:endEvent id="e1" name="Campaign period ends" />
    <bpmn:task id="collect" name="Collect leads in CRM system" />
    <bpmn:task id="followup" name="Follow up on leads" />
    <bpmn:sequenceFlow id="f-s-def" sourceRef="s" targetRef="def" />
    <bpmn:sequenceFlow id="f-def-gw1" sourceRef="def" targetRef="gw1" />
    <bpmn:sequenceFlow id="f-gw1-content" sourceRef="gw1" targetRef="content" />
    <bpmn:sequenceFlow id="f-gw1-visuals" sourceRef="gw1" targetRef="visuals" />
    <bpmn:sequenceFlow id="f-gw1-channels" sourceRef="gw1" targetRef="channels" />
    <bpmn:sequenceFlow id="f-content-gw2" sourceRef="content" targetRef="gw2" />
    <bpmn:sequenceFlow id="f-visuals-gw2" sourceRef="visuals" targetRef="gw2" />
    <bpmn:sequenceFlow id="f-channels-gw2" sourceRef="channels" targetRef="gw2" />
    <bpmn:sequenceFlow id="f-gw2-launch" sourceRef="gw2" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-track" sourceRef="launch" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-collect" sourceRef="track" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-followup" sourceRef="collect" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-analyze" sourceRef="followup" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-e1" sourceRef="analyze" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
