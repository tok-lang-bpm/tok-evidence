tok 1.0

pool org "Organisation" {
  lane marketing "Marketing team" {
    start s "Start"
    task def "Define objectives of marketing campaign"
    and gw1 "Prepare campaign"
    task content "Create content"
    task visuals "Design visuals"
    task channels "Select channels"
    and gw2 "Campaign ready"
    task launch "Launch campaign"
    task track "Track performance in real-time"
    task analyze "Analyze performance for future optimization"
    end e1 "Campaign period ends"
  }
  lane crm "CRM system" {
    task collect "Collect leads in CRM system"
  }
  lane sales "Sales team" {
    task followup "Follow up on leads"
  }
}

flow s -> def
flow def -> gw1
flow gw1 -> content
flow gw1 -> visuals
flow gw1 -> channels
flow content -> gw2
flow visuals -> gw2
flow channels -> gw2
flow gw2 -> launch
flow launch -> track
flow track -> collect
flow collect -> followup
flow followup -> analyze
flow analyze -> e1