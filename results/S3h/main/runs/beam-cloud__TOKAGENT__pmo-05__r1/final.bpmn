<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier Onboarding Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Supplier Onboarding Process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue-rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-responses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-proposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-optional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-site-visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-optional-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform-analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin-negotiations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree-terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard-supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-final-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="identify-need" name="Identify need" />
    <bpmn:task id="issue-rfp" name="Issue RFP" />
    <bpmn:task id="receive-responses" name="Receive responses" />
    <bpmn:task id="evaluate-proposals" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="g-optional" name="Conduct site visits or interviews?" default="f-g-optional-g-optional-join" />
    <bpmn:task id="conduct-site-visits" name="Conduct site visits" />
    <bpmn:task id="conduct-interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="g-optional-join" />
    <bpmn:task id="perform-analysis" name="Perform careful analysis" />
    <bpmn:task id="select-supplier" name="Select supplier" />
    <bpmn:task id="begin-negotiations" name="Begin contract negotiations" />
    <bpmn:task id="agree-terms" name="Agree on terms" />
    <bpmn:task id="sign-contract" name="Sign contract" />
    <bpmn:parallelGateway id="g-final" name="Onboard and execute" />
    <bpmn:task id="onboard-supplier" name="Onboard supplier" />
    <bpmn:task id="execute-contract" name="Execute contract" />
    <bpmn:parallelGateway id="g-final-join" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-identify-need" sourceRef="s" targetRef="identify-need" />
    <bpmn:sequenceFlow id="f-identify-need-issue-rfp" sourceRef="identify-need" targetRef="issue-rfp" />
    <bpmn:sequenceFlow id="f-issue-rfp-receive-responses" sourceRef="issue-rfp" targetRef="receive-responses" />
    <bpmn:sequenceFlow id="f-receive-responses-evaluate-proposals" sourceRef="receive-responses" targetRef="evaluate-proposals" />
    <bpmn:sequenceFlow id="f-evaluate-proposals-g-optional" sourceRef="evaluate-proposals" targetRef="g-optional" />
    <bpmn:sequenceFlow id="f-g-optional-conduct-site-visits" sourceRef="g-optional" targetRef="conduct-site-visits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-optional-conduct-interviews" sourceRef="g-optional" targetRef="conduct-interviews">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-optional-g-optional-join" sourceRef="g-optional" targetRef="g-optional-join" />
    <bpmn:sequenceFlow id="f-conduct-site-visits-g-optional-join" sourceRef="conduct-site-visits" targetRef="g-optional-join" />
    <bpmn:sequenceFlow id="f-conduct-interviews-g-optional-join" sourceRef="conduct-interviews" targetRef="g-optional-join" />
    <bpmn:sequenceFlow id="f-g-optional-join-perform-analysis" sourceRef="g-optional-join" targetRef="perform-analysis" />
    <bpmn:sequenceFlow id="f-perform-analysis-select-supplier" sourceRef="perform-analysis" targetRef="select-supplier" />
    <bpmn:sequenceFlow id="f-select-supplier-begin-negotiations" sourceRef="select-supplier" targetRef="begin-negotiations" />
    <bpmn:sequenceFlow id="f-begin-negotiations-agree-terms" sourceRef="begin-negotiations" targetRef="agree-terms" />
    <bpmn:sequenceFlow id="f-agree-terms-sign-contract" sourceRef="agree-terms" targetRef="sign-contract" />
    <bpmn:sequenceFlow id="f-sign-contract-g-final" sourceRef="sign-contract" targetRef="g-final" />
    <bpmn:sequenceFlow id="f-g-final-onboard-supplier" sourceRef="g-final" targetRef="onboard-supplier" />
    <bpmn:sequenceFlow id="f-g-final-execute-contract" sourceRef="g-final" targetRef="execute-contract" />
    <bpmn:sequenceFlow id="f-onboard-supplier-g-final-join" sourceRef="onboard-supplier" targetRef="g-final-join" />
    <bpmn:sequenceFlow id="f-execute-contract-g-final-join" sourceRef="execute-contract" targetRef="g-final-join" />
    <bpmn:sequenceFlow id="f-g-final-join-e" sourceRef="g-final-join" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
