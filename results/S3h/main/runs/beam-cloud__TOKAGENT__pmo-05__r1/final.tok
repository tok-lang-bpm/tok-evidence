tok 1.0 "Supplier Onboarding Process"

pool organisation "Organisation"
  lane procurement "Procurement Team"
    start s "Start"
    task identify-need "Identify need"
    task issue-rfp "Issue RFP"
    task receive-responses "Receive responses"
    task evaluate-proposals "Evaluate proposals"
    xor g-optional "Conduct site visits or interviews?"
    task conduct-site-visits "Conduct site visits"
    task conduct-interviews "Conduct interviews"
    xor g-optional-join
    task perform-analysis "Perform careful analysis"
    task select-supplier "Select supplier"
    task begin-negotiations "Begin contract negotiations"
    task agree-terms "Agree on terms"
    task sign-contract "Sign contract"
    and g-final "Onboard and execute"
    task onboard-supplier "Onboard supplier"
    task execute-contract "Execute contract"
    and g-final-join
    end e "End"

flow s -> identify-need -> issue-rfp -> receive-responses -> evaluate-proposals -> g-optional
flow g-optional -> conduct-site-visits when=""
flow g-optional -> conduct-interviews when=""
flow g-optional -> g-optional-join default
flow conduct-site-visits -> g-optional-join
flow conduct-interviews -> g-optional-join -> perform-analysis -> select-supplier -> begin-negotiations -> agree-terms -> sign-contract -> g-final
flow g-final -> onboard-supplier
flow g-final -> execute-contract
flow onboard-supplier -> g-final-join
flow execute-contract -> g-final-join -> e
