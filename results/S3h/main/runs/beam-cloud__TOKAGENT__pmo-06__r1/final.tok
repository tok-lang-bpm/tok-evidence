tok 1.0 "Order fulfilment process"

pool org "Organisation"
  lane customer "Customer"
    start s "Order placed"
  lane system "System"
    task gen_conf "Generate order confirmation"
    task send_conf "Send order confirmation to customer"
    task gen_label "Generate shipping label"
    task send_tracking "Send tracking information to customer"
    task monitor "Monitor shipment until delivery"
    end e "Process completed"
  lane logistics "Logistics provider"
    task deliver "Deliver order to customer"
  lane warehouse "Warehouse team"
    and split "Prepare shipment"
    task pick_pack "Pick and pack items"
    task hand_over "Hand over order to logistics provider"
    and join "Shipment ready"

flow s -> gen_conf -> send_conf -> split
flow split -> pick_pack
flow split -> gen_label
flow pick_pack -> join
flow gen_label -> join -> hand_over -> send_tracking -> monitor -> deliver -> e
