<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfilment process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order fulfilment process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>gen_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gen_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_over</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order placed" />
    <bpmn:task id="gen_conf" name="Generate order confirmation" />
    <bpmn:task id="send_conf" name="Send order confirmation to customer" />
    <bpmn:task id="gen_label" name="Generate shipping label" />
    <bpmn:task id="send_tracking" name="Send tracking information to customer" />
    <bpmn:task id="monitor" name="Monitor shipment until delivery" />
    <bpmn:endEvent id="e" name="Process completed" />
    <bpmn:parallelGateway id="split" name="Prepare shipment" />
    <bpmn:task id="pick_pack" name="Pick and pack items" />
    <bpmn:task id="hand_over" name="Hand over order to logistics provider" />
    <bpmn:parallelGateway id="join" name="Shipment ready" />
    <bpmn:task id="deliver" name="Deliver order to customer" />
    <bpmn:sequenceFlow id="f-s-gen_conf" sourceRef="s" targetRef="gen_conf" />
    <bpmn:sequenceFlow id="f-gen_conf-send_conf" sourceRef="gen_conf" targetRef="send_conf" />
    <bpmn:sequenceFlow id="f-send_conf-split" sourceRef="send_conf" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-pick_pack" sourceRef="split" targetRef="pick_pack" />
    <bpmn:sequenceFlow id="f-split-gen_label" sourceRef="split" targetRef="gen_label" />
    <bpmn:sequenceFlow id="f-pick_pack-join" sourceRef="pick_pack" targetRef="join" />
    <bpmn:sequenceFlow id="f-gen_label-join" sourceRef="gen_label" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-hand_over" sourceRef="join" targetRef="hand_over" />
    <bpmn:sequenceFlow id="f-hand_over-send_tracking" sourceRef="hand_over" targetRef="send_tracking" />
    <bpmn:sequenceFlow id="f-send_tracking-monitor" sourceRef="send_tracking" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-deliver" sourceRef="monitor" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-e" sourceRef="deliver" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
