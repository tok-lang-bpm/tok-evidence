<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Travel Booking Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Travel Booking Process" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Travel Booking Process" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="booking" name="Booking System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="travel" name="Travel Company">
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="select" name="Select preferred route, date, and time" />
    <bpmn:task id="provide" name="Provide personal information and payment details" />
    <bpmn:parallelGateway id="g1" name="Process booking" />
    <bpmn:parallelGateway id="g2" name="Processing complete" />
    <bpmn:exclusiveGateway id="g3" name="Reminders needed?" default="f-g3-g4" />
    <bpmn:task id="reminders" name="Receive reminders and instructions for check-in or boarding" />
    <bpmn:exclusiveGateway id="g4" name="Reminders merged" />
    <bpmn:task id="complete" name="Complete journey" />
    <bpmn:exclusiveGateway id="g5" name="Post-travel activities?" default="f-g5-e1" />
    <bpmn:task id="post" name="Provide post-travel feedback or services" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:task id="generate" name="Generate ticket" />
    <bpmn:task id="send" name="Send ticket via email or SMS" />
    <bpmn:task id="update" name="Update seat inventory" />
    <bpmn:sequenceFlow id="f-s-search" sourceRef="s" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-select" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-provide" sourceRef="select" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-g1" sourceRef="provide" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-generate" sourceRef="g1" targetRef="generate" />
    <bpmn:sequenceFlow id="f-g1-update" sourceRef="g1" targetRef="update" />
    <bpmn:sequenceFlow id="f-generate-send" sourceRef="generate" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-g2" sourceRef="send" targetRef="g2" />
    <bpmn:sequenceFlow id="f-update-g2" sourceRef="update" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-g3" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-reminders" sourceRef="g3" targetRef="reminders" />
    <bpmn:sequenceFlow id="f-g3-g4" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f-reminders-g4" sourceRef="reminders" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-complete" sourceRef="g4" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-g5" sourceRef="complete" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-post" sourceRef="g5" targetRef="post" />
    <bpmn:sequenceFlow id="f-g5-e1" sourceRef="g5" targetRef="e1" />
    <bpmn:sequenceFlow id="f-post-e1" sourceRef="post" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
