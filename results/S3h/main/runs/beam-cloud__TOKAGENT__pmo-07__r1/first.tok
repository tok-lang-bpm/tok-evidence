tok 1.0 "Travel Booking Process"

pool p "Travel Booking Process"
  lane customer "Customer"
    start s "Start"
    task search "Search for a flight, train, or bus ticket"
    task select "Select preferred route, date, and time"
    task provide "Provide personal information and payment details"
    and g1 "Process booking"
    and g2 "Processing complete"
    xor g3 "Reminders needed?"
    task reminders "Receive reminders and instructions for check-in or boarding"
    xor g4 "Reminders merged"
    task complete "Complete journey"
    xor g5 "Post-travel activities?"
    task post "Provide post-travel feedback or services"
    end e1 "End"
  lane booking "Booking System"
    task generate "Generate ticket"
    task send "Send ticket via email or SMS"
  lane travel "Travel Company"
    task update "Update seat inventory"

flow s -> search
flow search -> select
flow select -> provide
flow provide -> g1
flow g1 -> generate
flow g1 -> update
flow generate -> send
flow send -> g2
flow update -> g2
flow g2 -> g3
flow g3 -> reminders
flow g3 -> g4 default
flow reminders -> g4
flow g4 -> complete
flow complete -> g5
flow g5 -> post
flow g5 -> e1 default
flow post -> e1