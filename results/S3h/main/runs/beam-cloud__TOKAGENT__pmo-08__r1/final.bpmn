<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident Management Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Incident Management" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Incident Management Process" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="reporter" name="Employee / Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tracking" name="Tracking System">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Investigation Team">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>impl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Incident reported" />
    <bpmn:task id="report" name="Report incident" />
    <bpmn:task id="log" name="Log report into tracking system" />
    <bpmn:task id="assign" name="Assign report to appropriate team" />
    <bpmn:task id="close" name="Close incident report" />
    <bpmn:task id="notify" name="Notify stakeholders" />
    <bpmn:task id="gather" name="Gather necessary information" />
    <bpmn:task id="identify" name="Identify cause of incident" />
    <bpmn:task id="propose" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="impl" name="How to implement solution?" />
    <bpmn:task id="fix" name="Implement fix" />
    <bpmn:task id="training" name="Implement training" />
    <bpmn:task id="policy" name="Implement policy change" />
    <bpmn:exclusiveGateway id="implj" />
    <bpmn:task id="followup" name="Perform follow-up" />
    <bpmn:endEvent id="e" name="Incident report closed" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-log" sourceRef="report" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-gather" sourceRef="assign" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-identify" sourceRef="gather" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-propose" sourceRef="identify" targetRef="propose" />
    <bpmn:sequenceFlow id="f-propose-impl" sourceRef="propose" targetRef="impl" />
    <bpmn:sequenceFlow id="f-impl-fix" name="Fix" sourceRef="impl" targetRef="fix" />
    <bpmn:sequenceFlow id="f-impl-training" name="Training" sourceRef="impl" targetRef="training" />
    <bpmn:sequenceFlow id="f-impl-policy" name="Policy change" sourceRef="impl" targetRef="policy" />
    <bpmn:sequenceFlow id="f-fix-implj" sourceRef="fix" targetRef="implj" />
    <bpmn:sequenceFlow id="f-training-implj" sourceRef="training" targetRef="implj" />
    <bpmn:sequenceFlow id="f-policy-implj" sourceRef="policy" targetRef="implj" />
    <bpmn:sequenceFlow id="f-implj-followup" sourceRef="implj" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-close" sourceRef="followup" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-notify" sourceRef="close" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-e" sourceRef="notify" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
