tok 1.0 "Incident Management Process"

pool p "Incident Management"
  lane reporter "Employee / Customer"
    start s "Incident reported"
    task report "Report incident"
  lane tracking "Tracking System"
    task log "Log report into tracking system"
    task assign "Assign report to appropriate team"
    task close "Close incident report"
    task notify "Notify stakeholders"
  lane team "Investigation Team"
    task gather "Gather necessary information"
    task identify "Identify cause of incident"
    task propose "Propose corrective actions"
    xor impl "How to implement solution?"
    task fix "Implement fix"
    task training "Implement training"
    task policy "Implement policy change"
    xor implj
    task followup "Perform follow-up"
    end e "Incident report closed"

flow s -> report -> log -> assign -> gather -> identify -> propose -> impl
flow impl -> fix "Fix"
flow impl -> training "Training"
flow impl -> policy "Policy change"
flow fix -> implj
flow training -> implj
flow policy -> implj -> followup -> close -> notify -> e
