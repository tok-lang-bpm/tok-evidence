<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Product Development Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Product Development Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rd" name="R&amp;D team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft-concepts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build-prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test-prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine-prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="identify-idea" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft-concepts" name="Draft design concepts" />
    <bpmn:task id="select-design" name="Select a promising design" />
    <bpmn:task id="build-prototype" name="Build a prototype using available materials and resources" />
    <bpmn:task id="test-prototype" name="Test the prototype" />
    <bpmn:task id="collect-feedback" name="Collect feedback from testing" />
    <bpmn:exclusiveGateway id="g_refine" name="Refinement needed?" default="f-g_refine-g_outcome" />
    <bpmn:task id="refine-prototype" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="g_outcome" name="Approved or discarded?" default="f-g_outcome-e_discarded" />
    <bpmn:endEvent id="e_approved" name="Approved for further development" />
    <bpmn:endEvent id="e_discarded" name="Discarded" />
    <bpmn:sequenceFlow id="f-s-identify-idea" sourceRef="s" targetRef="identify-idea" />
    <bpmn:sequenceFlow id="f-identify-idea-research" sourceRef="identify-idea" targetRef="research" />
    <bpmn:sequenceFlow id="f-research-draft-concepts" sourceRef="research" targetRef="draft-concepts" />
    <bpmn:sequenceFlow id="f-draft-concepts-select-design" sourceRef="draft-concepts" targetRef="select-design" />
    <bpmn:sequenceFlow id="f-select-design-build-prototype" sourceRef="select-design" targetRef="build-prototype" />
    <bpmn:sequenceFlow id="f-build-prototype-test-prototype" sourceRef="build-prototype" targetRef="test-prototype" />
    <bpmn:sequenceFlow id="f-test-prototype-collect-feedback" sourceRef="test-prototype" targetRef="collect-feedback" />
    <bpmn:sequenceFlow id="f-collect-feedback-g_refine" sourceRef="collect-feedback" targetRef="g_refine" />
    <bpmn:sequenceFlow id="f-g_refine-refine-prototype" name="Yes" sourceRef="g_refine" targetRef="refine-prototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-refine-prototype-test-prototype" sourceRef="refine-prototype" targetRef="test-prototype" />
    <bpmn:sequenceFlow id="f-g_refine-g_outcome" name="No" sourceRef="g_refine" targetRef="g_outcome" />
    <bpmn:sequenceFlow id="f-g_outcome-e_approved" name="Approved" sourceRef="g_outcome" targetRef="e_approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_outcome-e_discarded" name="Discarded" sourceRef="g_outcome" targetRef="e_discarded" />
  </bpmn:process>
</bpmn:definitions>
