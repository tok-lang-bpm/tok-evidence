tok 1.0 "Product Development Process"

pool org "Organisation"
  lane rd "R&D team"
    start s "Start"
    task identify-idea "Identify an idea for a new product or improvement"
    task research "Conduct initial research and feasibility studies"
    task draft-concepts "Draft design concepts"
    task select-design "Select a promising design"
    task build-prototype "Build a prototype using available materials and resources"
    task test-prototype "Test the prototype"
    task collect-feedback "Collect feedback from testing"
    xor g_refine "Refinement needed?"
    task refine-prototype "Refine the prototype"
    xor g_outcome "Approved or discarded?"
    end e_approved "Approved for further development"
    end e_discarded "Discarded"

flow s -> identify-idea -> research -> draft-concepts -> select-design -> build-prototype -> test-prototype -> collect-feedback -> g_refine
flow g_refine -> refine-prototype "Yes" when=""
flow refine-prototype -> test-prototype
flow g_refine -> g_outcome "No" default
flow g_outcome -> e_approved "Approved" when=""
flow g_outcome -> e_discarded "Discarded" default
