tok 1.0 "IT solution request process"

pool organisation "Organisation"
  lane requesting "Requesting department"
    start s "Request submitted"
    task submit "Submit request for IT solution"
  lane it "IT"
    task assess "Assess request"
    xor approved "Request approved?"
    task procure "Procure necessary tools or licenses"
    task install "Install solution"
    task test "Test solution in controlled environment"
    task rollout "Roll out solution to requesting department"
    xor training "Provide training?"
    task train "Provide training"
    xor training_join "Training branch merge"
    task support "Provide IT support"
    end completed "Process completed"
    end rejected "Request rejected"

flow s -> submit
flow submit -> assess
flow assess -> approved
flow approved -> procure "Yes" when="approved"
flow approved -> rejected "No" default
flow procure -> install
flow install -> test
flow test -> rollout
flow rollout -> training
flow training -> train "Yes" when="trainingNeeded"
flow training -> training_join "No" default
flow train -> training_join
flow training_join -> support
flow support -> completed
