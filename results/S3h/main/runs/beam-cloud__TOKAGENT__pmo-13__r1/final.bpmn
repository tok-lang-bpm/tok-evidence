<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Organization" name="Organization" processRef="Organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="Organization-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="Organization-lanes">
      <bpmn:lane id="Customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Investigation" name="Investigation Team">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Finance" name="Financial Team">
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Complaint filed" />
    <bpmn:task id="feedback" name="Provide feedback" />
    <bpmn:exclusiveGateway id="fk" name="Provide feedback?" default="f-fk-e" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="log" name="Log complaint" />
    <bpmn:task id="assign" name="Assign complaint to relevant department" />
    <bpmn:task id="resolve" name="Mark complaint as resolved" />
    <bpmn:task id="review" name="Review complaint details" />
    <bpmn:task id="notify" name="Notify customer of decision" />
    <bpmn:exclusiveGateway id="g" name="Refund approved?" default="f-g-j" />
    <bpmn:exclusiveGateway id="j" name="Join" />
    <bpmn:task id="reimburse" name="Process reimbursement" />
    <bpmn:sequenceFlow id="f-s-log" sourceRef="s" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-review" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-notify" sourceRef="review" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-g" sourceRef="notify" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-reimburse" name="Yes" sourceRef="g" targetRef="reimburse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refund = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-j" name="No" sourceRef="g" targetRef="j" />
    <bpmn:sequenceFlow id="f-reimburse-j" sourceRef="reimburse" targetRef="j" />
    <bpmn:sequenceFlow id="f-j-resolve" sourceRef="j" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-fk" sourceRef="resolve" targetRef="fk" />
    <bpmn:sequenceFlow id="f-fk-feedback" name="Yes" sourceRef="fk" targetRef="feedback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">feedback = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fk-e" name="No" sourceRef="fk" targetRef="e" />
    <bpmn:sequenceFlow id="f-feedback-e" sourceRef="feedback" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
