tok 1.0 "Complaint handling"

pool Organization "Organization"
  lane Customer "Customer"
    start s "Complaint filed"
    task feedback "Provide feedback"
    xor fk "Provide feedback?"
    end e "End"
  lane CustomerService "Customer Service"
    task log "Log complaint"
    task assign "Assign complaint to relevant department"
    task resolve "Mark complaint as resolved"
  lane Investigation "Investigation Team"
    task review "Review complaint details"
    task notify "Notify customer of decision"
    xor g "Refund approved?"
    xor j "Join"
  lane Finance "Financial Team"
    task reimburse "Process reimbursement"

flow s -> log -> assign -> review -> notify -> g
flow g -> reimburse "Yes" when="refund = true"
flow g -> j "No" default
flow reimburse -> j -> resolve -> fk
flow fk -> feedback "Yes" when="feedback = true"
flow fk -> e "No" default
flow feedback -> e
