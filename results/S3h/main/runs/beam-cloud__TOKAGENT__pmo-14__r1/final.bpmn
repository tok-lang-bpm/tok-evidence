<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Budget planning" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Budget planning" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>strategic_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document_adjustment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_proc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>detailed_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>approve_adj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:task id="strategic_review" name="Review plan in strategic alignment meeting" />
    <bpmn:task id="document_adjustment" name="Document adjustment" />
    <bpmn:task id="implement" name="Begin implementing plan" />
    <bpmn:endEvent id="end_proc" name="End" />
    <bpmn:task id="draft" name="Draft plan with cost estimates and justifications" />
    <bpmn:task id="detailed_review" name="Perform detailed review" />
    <bpmn:exclusiveGateway id="g" name="Adjustments needed?" default="f-g-allocate" />
    <bpmn:task id="allocate" name="Allocate budget" />
    <bpmn:task id="distribute" name="Distribute budget" />
    <bpmn:task id="approve_adj" name="Approve adjustment" />
    <bpmn:sequenceFlow id="f-start-outline" sourceRef="start" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-strategic_review" sourceRef="draft" targetRef="strategic_review" />
    <bpmn:sequenceFlow id="f-strategic_review-detailed_review" sourceRef="strategic_review" targetRef="detailed_review" />
    <bpmn:sequenceFlow id="f-detailed_review-g" sourceRef="detailed_review" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-document_adjustment" name="Needs adjustment" sourceRef="g" targetRef="document_adjustment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adjustmentsNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-allocate" name="Approved" sourceRef="g" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-document_adjustment-approve_adj" sourceRef="document_adjustment" targetRef="approve_adj" />
    <bpmn:sequenceFlow id="f-approve_adj-strategic_review" sourceRef="approve_adj" targetRef="strategic_review" />
    <bpmn:sequenceFlow id="f-implement-end_proc" sourceRef="implement" targetRef="end_proc" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
  </bpmn:process>
</bpmn:definitions>
