tok 1.0

pool "Budget planning" {
  lane "Department" {
    start start "Start"
    task outline "Outline objectives"
    task strategic_review "Review plan in strategic alignment meeting"
    task document_adjustment "Document adjustment"
    task implement "Begin implementing plan"
    end end_proc "End"
  }
  lane "Team" {
    task draft "Draft plan with cost estimates and justifications"
  }
  lane "Finance department" {
    task detailed_review "Perform detailed review"
    task allocate "Allocate budget"
    task distribute "Distribute budget"
  }
  lane "Stakeholders" {
    task approve_adj "Approve adjustment"
  }
}

flow start -> outline
flow outline -> draft
flow draft -> strategic_review
flow strategic_review -> detailed_review
flow detailed_review -> g
xor g "Adjustments needed?"
flow g -> document_adjustment "Needs adjustment" when="adjustmentsNeeded = true"
flow g -> allocate "Approved" default
flow document_adjustment -> approve_adj
flow approve_adj -> strategic_review
flow allocate -> distribute
flow distribute -> implement
flow implement -> end_proc
