<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Compliance Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Company" name="Company" processRef="Company-process" />
  </bpmn:collaboration>
  <bpmn:process id="Company-process" name="Compliance Audit Process" isExecutable="false">
    <bpmn:laneSet id="Company-lanes">
      <bpmn:lane id="CompanyLane" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Internal" name="Internal Teams">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Compliance audit scheduled" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="g1" name="Prepare for external audit" />
    <bpmn:parallelGateway id="g2" name="Preparation complete" />
    <bpmn:exclusiveGateway id="g3" name="Gaps or issues identified?" default="f-g3-final" />
    <bpmn:task id="correct" name="Make corrections or improvements" />
    <bpmn:exclusiveGateway id="g4" name="All criteria met?" default="f-g4-e2" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="e1" name="Certification and documents issued" />
    <bpmn:endEvent id="e2" name="Process ended" />
    <bpmn:task id="prep" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="self" name="Conduct self-assessment" />
    <bpmn:task id="review" name="Review processes" />
    <bpmn:task id="identify" name="Identify gaps or issues" />
    <bpmn:task id="final" name="Conduct final audit" />
    <bpmn:task id="certify" name="Award certification" />
    <bpmn:sequenceFlow id="f-s-schedule" sourceRef="s" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-g1" sourceRef="schedule" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-prep" sourceRef="g1" targetRef="prep" />
    <bpmn:sequenceFlow id="f-g1-gather" sourceRef="g1" targetRef="gather" />
    <bpmn:sequenceFlow id="f-g1-self" sourceRef="g1" targetRef="self" />
    <bpmn:sequenceFlow id="f-prep-g2" sourceRef="prep" targetRef="g2" />
    <bpmn:sequenceFlow id="f-gather-g2" sourceRef="gather" targetRef="g2" />
    <bpmn:sequenceFlow id="f-self-g2" sourceRef="self" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-review" sourceRef="g2" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-identify" sourceRef="review" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-g3" sourceRef="identify" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-correct" name="Yes" sourceRef="g3" targetRef="correct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g3-final" name="No" sourceRef="g3" targetRef="final" />
    <bpmn:sequenceFlow id="f-correct-final" sourceRef="correct" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-g4" sourceRef="final" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-certify" name="Yes" sourceRef="g4" targetRef="certify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g4-e2" name="No" sourceRef="g4" targetRef="e2" />
    <bpmn:sequenceFlow id="f-certify-issue" sourceRef="certify" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-e1" sourceRef="issue" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
