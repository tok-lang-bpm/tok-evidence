tok 1.0 "Compliance Audit Process"

pool Company "Company"
  lane CompanyLane "Company"
    start s "Compliance audit scheduled"
    task schedule "Schedule compliance audit"
    and g1 "Prepare for external audit"
    and g2 "Preparation complete"
    xor g3 "Gaps or issues identified?"
    task correct "Make corrections or improvements"
    xor g4 "All criteria met?"
    task issue "Issue official documents"
    end e1 "Certification and documents issued"
    end e2 "Process ended"
  lane Internal "Internal Teams"
    task prep "Prepare documentation"
    task gather "Gather evidence"
    task self "Conduct self-assessment"
  lane Auditors "Auditors"
    task review "Review processes"
    task identify "Identify gaps or issues"
    task final "Conduct final audit"
    task certify "Award certification"

flow s -> schedule
flow schedule -> g1
flow g1 -> prep
flow g1 -> gather
flow g1 -> self
flow prep -> g2
flow gather -> g2
flow self -> g2
flow g2 -> review
flow review -> identify
flow identify -> g3
flow g3 -> correct "Yes" when=""
flow g3 -> final "No" default
flow correct -> final
flow final -> g4
flow g4 -> certify "Yes" when=""
flow g4 -> e2 "No" default
flow certify -> issue
flow issue -> e1
