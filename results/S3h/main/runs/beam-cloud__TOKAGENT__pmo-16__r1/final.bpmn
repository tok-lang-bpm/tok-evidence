<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Annual audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="audit-coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional-office" name="Regional office">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance-team" name="Compliance team">
        <bpmn:flowNodeRef>check-reg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central-audit-team" name="Central audit team">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-clar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-ops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>high-risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>data-analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site-gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site-visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit-director" name="Audit director">
        <bpmn:flowNodeRef>review-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve-gate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Audit process initiated" />
    <bpmn:task id="initiate" name="Initiate audit process" />
    <bpmn:task id="notify" name="Send notification to regional office" />
    <bpmn:task id="prepare" name="Prepare financial statements" />
    <bpmn:task id="gather" name="Gather necessary documents" />
    <bpmn:task id="submit" name="Submit documents to central audit team" />
    <bpmn:task id="provide" name="Provide necessary clarifications" />
    <bpmn:task id="check-reg" name="Check regulatory updates" />
    <bpmn:task id="review" name="Review submission" />
    <bpmn:task id="request-clar" name="Request clarifications" />
    <bpmn:exclusiveGateway id="disc" name="Discrepancies found?" default="f-disc-risk-split" />
    <bpmn:parallelGateway id="par-start" name="Concurrent checks start" />
    <bpmn:parallelGateway id="par-end" name="Concurrent checks end" />
    <bpmn:parallelGateway id="risk-split" name="Risk evaluation start" />
    <bpmn:task id="risk-fin" name="Evaluate financial risks" />
    <bpmn:task id="risk-ops" name="Evaluate operational risks" />
    <bpmn:task id="risk-comp" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="risk-join" name="Risk evaluation end" />
    <bpmn:exclusiveGateway id="high-risk" name="High risk identified?" default="f-high-risk-risk-merge" />
    <bpmn:task id="data-analysis" name="Perform data analysis" />
    <bpmn:task id="interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="site-gate" name="Site visit required?" default="f-site-gate-site-merge" />
    <bpmn:task id="site-visit" name="Conduct site visit" />
    <bpmn:exclusiveGateway id="site-merge" name="Site visit merge" />
    <bpmn:exclusiveGateway id="risk-merge" name="Risk branch merge" />
    <bpmn:task id="compile" name="Compile audit report" />
    <bpmn:task id="update" name="Update audit report" />
    <bpmn:task id="distribute" name="Distribute final report to executive board" />
    <bpmn:task id="archive" name="Archive audit report" />
    <bpmn:endEvent id="end" name="Audit process closed" />
    <bpmn:task id="review-report" name="Review audit report" />
    <bpmn:exclusiveGateway id="approve-gate" name="Approve report?" default="f-approve-gate-distribute" />
    <bpmn:sequenceFlow id="f-start-initiate" sourceRef="start" targetRef="initiate" />
    <bpmn:sequenceFlow id="f-initiate-notify" sourceRef="initiate" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-par-start" sourceRef="notify" targetRef="par-start" />
    <bpmn:sequenceFlow id="f-par-start-prepare" sourceRef="par-start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-par-start-check-reg" sourceRef="par-start" targetRef="check-reg" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-par-end" sourceRef="gather" targetRef="par-end" />
    <bpmn:sequenceFlow id="f-check-reg-par-end" sourceRef="check-reg" targetRef="par-end" />
    <bpmn:sequenceFlow id="f-par-end-submit" sourceRef="par-end" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-disc" sourceRef="review" targetRef="disc" />
    <bpmn:sequenceFlow id="f-disc-request-clar" name="Discrepancies found" sourceRef="disc" targetRef="request-clar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-disc-risk-split" name="No discrepancies" sourceRef="disc" targetRef="risk-split" />
    <bpmn:sequenceFlow id="f-request-clar-provide" sourceRef="request-clar" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-review" sourceRef="provide" targetRef="review" />
    <bpmn:sequenceFlow id="f-risk-split-risk-fin" sourceRef="risk-split" targetRef="risk-fin" />
    <bpmn:sequenceFlow id="f-risk-split-risk-ops" sourceRef="risk-split" targetRef="risk-ops" />
    <bpmn:sequenceFlow id="f-risk-split-risk-comp" sourceRef="risk-split" targetRef="risk-comp" />
    <bpmn:sequenceFlow id="f-risk-fin-risk-join" sourceRef="risk-fin" targetRef="risk-join" />
    <bpmn:sequenceFlow id="f-risk-ops-risk-join" sourceRef="risk-ops" targetRef="risk-join" />
    <bpmn:sequenceFlow id="f-risk-comp-risk-join" sourceRef="risk-comp" targetRef="risk-join" />
    <bpmn:sequenceFlow id="f-risk-join-high-risk" sourceRef="risk-join" targetRef="high-risk" />
    <bpmn:sequenceFlow id="f-high-risk-data-analysis" name="High risk identified" sourceRef="high-risk" targetRef="data-analysis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-high-risk-risk-merge" name="No high risk" sourceRef="high-risk" targetRef="risk-merge" />
    <bpmn:sequenceFlow id="f-data-analysis-interviews" sourceRef="data-analysis" targetRef="interviews" />
    <bpmn:sequenceFlow id="f-interviews-site-gate" sourceRef="interviews" targetRef="site-gate" />
    <bpmn:sequenceFlow id="f-site-gate-site-visit" name="Site visit required" sourceRef="site-gate" targetRef="site-visit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-site-gate-site-merge" name="No site visit" sourceRef="site-gate" targetRef="site-merge" />
    <bpmn:sequenceFlow id="f-site-visit-site-merge" sourceRef="site-visit" targetRef="site-merge" />
    <bpmn:sequenceFlow id="f-site-merge-risk-merge" sourceRef="site-merge" targetRef="risk-merge" />
    <bpmn:sequenceFlow id="f-risk-merge-compile" sourceRef="risk-merge" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compile-review-report" sourceRef="compile" targetRef="review-report" />
    <bpmn:sequenceFlow id="f-review-report-approve-gate" sourceRef="review-report" targetRef="approve-gate" />
    <bpmn:sequenceFlow id="f-approve-gate-distribute" name="Approved" sourceRef="approve-gate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-approve-gate-update" name="Revisions required" sourceRef="approve-gate" targetRef="update">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-update-review-report" sourceRef="update" targetRef="review-report" />
    <bpmn:sequenceFlow id="f-distribute-archive" sourceRef="distribute" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-end" sourceRef="archive" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
