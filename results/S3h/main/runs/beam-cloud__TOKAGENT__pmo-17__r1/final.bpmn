<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order Fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="E-commerce Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order Fulfillment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>start-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-payment-failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-payment-failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-shipping-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-return-label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-returns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory System">
        <bpmn:flowNodeRef>check-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiate-backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping Department">
        <bpmn:flowNodeRef>prepare-shipping-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package-gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package-standard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-returns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect-returns</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-order" name="Order placed" />
    <bpmn:task id="record-order" name="Record order details" />
    <bpmn:task id="process-payment" name="Process payment" />
    <bpmn:exclusiveGateway id="pay-gw" name="Payment successful?" default="f-pay-gw-check-stock" />
    <bpmn:task id="notify-payment-failed" name="Notify customer" />
    <bpmn:endEvent id="end-payment-failed" name="End" />
    <bpmn:task id="inform-delay" name="Inform customer about delay" />
    <bpmn:task id="receive-backorder" name="Receive back-order" />
    <bpmn:task id="send-shipping-confirmation" name="Send shipping confirmation" />
    <bpmn:task id="update-inventory" name="Update inventory levels" />
    <bpmn:task id="confirm-delivery" name="Confirm successful delivery" />
    <bpmn:task id="send-followup" name="Send follow-up email for feedback" />
    <bpmn:exclusiveGateway id="issues-gw" name="Customer reports issues?" default="f-issues-gw-send-return-label" />
    <bpmn:task id="send-return-label" name="Send return shipping label" />
    <bpmn:task id="process-refund" name="Process refund or replacement" />
    <bpmn:endEvent id="end-ok" name="End" />
    <bpmn:endEvent id="end-returns" name="End" />
    <bpmn:task id="check-stock" name="Check stock availability" />
    <bpmn:task id="initiate-backorder" name="Initiate back-order" />
    <bpmn:exclusiveGateway id="stock-gw" name="Items in stock?" default="f-stock-gw-stock-join" />
    <bpmn:exclusiveGateway id="stock-join" name="Items available?" />
    <bpmn:task id="prepare-shipping-docs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl-gw" name="International order?" default="f-intl-gw-prepare-customs" />
    <bpmn:task id="prepare-customs" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="intl-join" name="Customs ready?" />
    <bpmn:task id="dispatch-order" name="Dispatch order" />
    <bpmn:task id="pick-items" name="Pick items" />
    <bpmn:task id="qc-check" name="Perform quality control" />
    <bpmn:parallelGateway id="and-split" name="Packaging and shipping" />
    <bpmn:exclusiveGateway id="gift-gw" name="Gift wrapping requested?" default="f-gift-gw-package-gift" />
    <bpmn:task id="package-gift" name="Package order with gift wrap" />
    <bpmn:task id="package-standard" name="Package order" />
    <bpmn:exclusiveGateway id="gift-join" name="Packaging ready?" />
    <bpmn:parallelGateway id="and-join" name="Ready for dispatch" />
    <bpmn:task id="receive-returns" name="Receive returned items" />
    <bpmn:task id="inspect-returns" name="Inspect returned items" />
    <bpmn:sequenceFlow id="f-start-order-record-order" sourceRef="start-order" targetRef="record-order" />
    <bpmn:sequenceFlow id="f-record-order-process-payment" sourceRef="record-order" targetRef="process-payment" />
    <bpmn:sequenceFlow id="f-process-payment-pay-gw" sourceRef="process-payment" targetRef="pay-gw" />
    <bpmn:sequenceFlow id="f-pay-gw-notify-payment-failed" name="No" sourceRef="pay-gw" targetRef="notify-payment-failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-notify-payment-failed-end-payment-failed" sourceRef="notify-payment-failed" targetRef="end-payment-failed" />
    <bpmn:sequenceFlow id="f-pay-gw-check-stock" name="Yes" sourceRef="pay-gw" targetRef="check-stock" />
    <bpmn:sequenceFlow id="f-check-stock-stock-gw" sourceRef="check-stock" targetRef="stock-gw" />
    <bpmn:sequenceFlow id="f-stock-gw-stock-join" name="In stock" sourceRef="stock-gw" targetRef="stock-join" />
    <bpmn:sequenceFlow id="f-stock-gw-initiate-backorder" name="Out of stock" sourceRef="stock-gw" targetRef="initiate-backorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-initiate-backorder-inform-delay" sourceRef="initiate-backorder" targetRef="inform-delay" />
    <bpmn:sequenceFlow id="f-inform-delay-receive-backorder" sourceRef="inform-delay" targetRef="receive-backorder" />
    <bpmn:sequenceFlow id="f-receive-backorder-stock-join" sourceRef="receive-backorder" targetRef="stock-join" />
    <bpmn:sequenceFlow id="f-stock-join-pick-items" sourceRef="stock-join" targetRef="pick-items" />
    <bpmn:sequenceFlow id="f-pick-items-qc-check" sourceRef="pick-items" targetRef="qc-check" />
    <bpmn:sequenceFlow id="f-qc-check-and-split" sourceRef="qc-check" targetRef="and-split" />
    <bpmn:sequenceFlow id="f-and-split-gift-gw" sourceRef="and-split" targetRef="gift-gw" />
    <bpmn:sequenceFlow id="f-gift-gw-package-gift" name="Yes" sourceRef="gift-gw" targetRef="package-gift" />
    <bpmn:sequenceFlow id="f-gift-gw-package-standard" name="No" sourceRef="gift-gw" targetRef="package-standard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-package-gift-gift-join" sourceRef="package-gift" targetRef="gift-join" />
    <bpmn:sequenceFlow id="f-package-standard-gift-join" sourceRef="package-standard" targetRef="gift-join" />
    <bpmn:sequenceFlow id="f-gift-join-and-join" sourceRef="gift-join" targetRef="and-join" />
    <bpmn:sequenceFlow id="f-and-split-prepare-shipping-docs" sourceRef="and-split" targetRef="prepare-shipping-docs" />
    <bpmn:sequenceFlow id="f-prepare-shipping-docs-intl-gw" sourceRef="prepare-shipping-docs" targetRef="intl-gw" />
    <bpmn:sequenceFlow id="f-intl-gw-prepare-customs" name="International" sourceRef="intl-gw" targetRef="prepare-customs" />
    <bpmn:sequenceFlow id="f-intl-gw-intl-join" name="Domestic" sourceRef="intl-gw" targetRef="intl-join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-prepare-customs-intl-join" sourceRef="prepare-customs" targetRef="intl-join" />
    <bpmn:sequenceFlow id="f-intl-join-and-join" sourceRef="intl-join" targetRef="and-join" />
    <bpmn:sequenceFlow id="f-and-join-dispatch-order" sourceRef="and-join" targetRef="dispatch-order" />
    <bpmn:sequenceFlow id="f-dispatch-order-send-shipping-confirmation" sourceRef="dispatch-order" targetRef="send-shipping-confirmation" />
    <bpmn:sequenceFlow id="f-send-shipping-confirmation-update-inventory" sourceRef="send-shipping-confirmation" targetRef="update-inventory" />
    <bpmn:sequenceFlow id="f-update-inventory-confirm-delivery" sourceRef="update-inventory" targetRef="confirm-delivery" />
    <bpmn:sequenceFlow id="f-confirm-delivery-send-followup" sourceRef="confirm-delivery" targetRef="send-followup" />
    <bpmn:sequenceFlow id="f-send-followup-issues-gw" sourceRef="send-followup" targetRef="issues-gw" />
    <bpmn:sequenceFlow id="f-issues-gw-send-return-label" name="Issues" sourceRef="issues-gw" targetRef="send-return-label" />
    <bpmn:sequenceFlow id="f-issues-gw-end-ok" name="No issues" sourceRef="issues-gw" targetRef="end-ok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-send-return-label-receive-returns" sourceRef="send-return-label" targetRef="receive-returns" />
    <bpmn:sequenceFlow id="f-receive-returns-inspect-returns" sourceRef="receive-returns" targetRef="inspect-returns" />
    <bpmn:sequenceFlow id="f-inspect-returns-process-refund" sourceRef="inspect-returns" targetRef="process-refund" />
    <bpmn:sequenceFlow id="f-process-refund-end-returns" sourceRef="process-refund" targetRef="end-returns" />
  </bpmn:process>
</bpmn:definitions>
