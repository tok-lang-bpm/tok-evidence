<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="University Enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University Enrollment" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>start_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin_classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>international_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_int_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievances</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_grievance_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue_semester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_enrollment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions Office">
        <bpmn:flowNodeRef>review_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>application_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_committee" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate_application</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>process_fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="iso" name="International Student Office">
        <bpmn:flowNodeRef>visa_processing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_process" name="Start" />
    <bpmn:task id="submit_application" name="Submit application online" />
    <bpmn:task id="provide_missing" name="Provide missing items" />
    <bpmn:task id="confirm_enrollment" name="Confirm enrollment" />
    <bpmn:task id="receive_orientation" name="Receive orientation materials" />
    <bpmn:task id="obtain_id" name="Obtain student ID card" />
    <bpmn:task id="select_courses" name="Select courses" />
    <bpmn:task id="resolve_conflicts" name="Resolve schedule conflicts" />
    <bpmn:task id="begin_classes" name="Begin attending classes" />
    <bpmn:task id="add_drop" name="Add or drop courses" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:task id="submit_appeal" name="Submit appeal form" />
    <bpmn:task id="await_decision" name="Await a decision" />
    <bpmn:exclusiveGateway id="international_student" name="International student?" default="f-international_student-g_int_join" />
    <bpmn:exclusiveGateway id="g_int_join" name="International processing complete?" />
    <bpmn:exclusiveGateway id="add_drop_choice" name="Add or drop courses?" default="f-add_drop_choice-post_grades" />
    <bpmn:exclusiveGateway id="grievances" name="Grievances?" default="f-grievances-g_grievance_join" />
    <bpmn:exclusiveGateway id="g_grievance_join" name="Grievance processing complete?" />
    <bpmn:exclusiveGateway id="continue_semester" name="Continue for another semester?" default="f-continue_semester-meet_advisor" />
    <bpmn:boundaryEvent id="cancel_enrollment" attachedToRef="confirm_enrollment">
      <bpmn:timerEventDefinition id="cancel_enrollment-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="review_documents" name="Review application and supporting documents" />
    <bpmn:task id="notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="send_acceptance" name="Send acceptance letter" />
    <bpmn:task id="send_rejection" name="Send rejection letter" />
    <bpmn:task id="cancel_application" name="Cancel application" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:exclusiveGateway id="docs_complete" name="Documents complete?" default="f-docs_complete-g_parallel" />
    <bpmn:parallelGateway id="g_parallel" name="Concurrent processing" />
    <bpmn:parallelGateway id="g_join" name="Processing complete" />
    <bpmn:exclusiveGateway id="application_accepted" name="Application accepted?" default="f-application_accepted-send_rejection" />
    <bpmn:endEvent id="end_rejected" name="Rejection" />
    <bpmn:endEvent id="end_canceled" name="Application canceled" />
    <bpmn:endEvent id="end_complete" name="Process completed" />
    <bpmn:task id="evaluate_application" name="Evaluate application" />
    <bpmn:task id="process_fees" name="Process application fees or waivers" />
    <bpmn:task id="setup_accounts" name="Set up student accounts" />
    <bpmn:task id="visa_processing" name="Assist with visa processing" />
    <bpmn:task id="meet_advisor" name="Meet with academic advisor" />
    <bpmn:task id="meet_appeals" name="Meet with appeals committee" />
    <bpmn:sequenceFlow id="f-start_process-submit_application" sourceRef="start_process" targetRef="submit_application" />
    <bpmn:sequenceFlow id="f-submit_application-review_documents" sourceRef="submit_application" targetRef="review_documents" />
    <bpmn:sequenceFlow id="f-review_documents-docs_complete" sourceRef="review_documents" targetRef="docs_complete" />
    <bpmn:sequenceFlow id="f-docs_complete-notify_missing" name="Documents missing" sourceRef="docs_complete" targetRef="notify_missing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documents_missing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-notify_missing-provide_missing" sourceRef="notify_missing" targetRef="provide_missing" />
    <bpmn:sequenceFlow id="f-provide_missing-review_documents" sourceRef="provide_missing" targetRef="review_documents" />
    <bpmn:sequenceFlow id="f-docs_complete-g_parallel" name="All documents received" sourceRef="docs_complete" targetRef="g_parallel" />
    <bpmn:sequenceFlow id="f-g_parallel-evaluate_application" sourceRef="g_parallel" targetRef="evaluate_application" />
    <bpmn:sequenceFlow id="f-g_parallel-process_fees" sourceRef="g_parallel" targetRef="process_fees" />
    <bpmn:sequenceFlow id="f-evaluate_application-g_join" sourceRef="evaluate_application" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-process_fees-g_join" sourceRef="process_fees" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_join-application_accepted" sourceRef="g_join" targetRef="application_accepted" />
    <bpmn:sequenceFlow id="f-application_accepted-send_acceptance" name="Accepted" sourceRef="application_accepted" targetRef="send_acceptance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-application_accepted-send_rejection" name="Rejected" sourceRef="application_accepted" targetRef="send_rejection" />
    <bpmn:sequenceFlow id="f-send_rejection-end_rejected" sourceRef="send_rejection" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f-send_acceptance-confirm_enrollment" sourceRef="send_acceptance" targetRef="confirm_enrollment" />
    <bpmn:sequenceFlow id="f-cancel_enrollment-cancel_application" sourceRef="cancel_enrollment" targetRef="cancel_application" />
    <bpmn:sequenceFlow id="f-cancel_application-end_canceled" sourceRef="cancel_application" targetRef="end_canceled" />
    <bpmn:sequenceFlow id="f-confirm_enrollment-receive_orientation" sourceRef="confirm_enrollment" targetRef="receive_orientation" />
    <bpmn:sequenceFlow id="f-receive_orientation-setup_accounts" sourceRef="receive_orientation" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f-setup_accounts-international_student" sourceRef="setup_accounts" targetRef="international_student" />
    <bpmn:sequenceFlow id="f-international_student-visa_processing" name="International student" sourceRef="international_student" targetRef="visa_processing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-international_student-g_int_join" sourceRef="international_student" targetRef="g_int_join" />
    <bpmn:sequenceFlow id="f-visa_processing-g_int_join" sourceRef="visa_processing" targetRef="g_int_join" />
    <bpmn:sequenceFlow id="f-g_int_join-obtain_id" sourceRef="g_int_join" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-obtain_id-meet_advisor" sourceRef="obtain_id" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f-meet_advisor-select_courses" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f-select_courses-resolve_conflicts" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f-resolve_conflicts-begin_classes" sourceRef="resolve_conflicts" targetRef="begin_classes" />
    <bpmn:sequenceFlow id="f-begin_classes-add_drop_choice" sourceRef="begin_classes" targetRef="add_drop_choice" />
    <bpmn:sequenceFlow id="f-add_drop_choice-add_drop" name="Add or drop courses" sourceRef="add_drop_choice" targetRef="add_drop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">add_drop = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-add_drop_choice-post_grades" sourceRef="add_drop_choice" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-add_drop-post_grades" sourceRef="add_drop" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-post_grades-review_grades" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-review_grades-grievances" sourceRef="review_grades" targetRef="grievances" />
    <bpmn:sequenceFlow id="f-grievances-submit_appeal" name="Grievances exist" sourceRef="grievances" targetRef="submit_appeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-grievances-g_grievance_join" sourceRef="grievances" targetRef="g_grievance_join" />
    <bpmn:sequenceFlow id="f-submit_appeal-meet_appeals" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f-meet_appeals-await_decision" sourceRef="meet_appeals" targetRef="await_decision" />
    <bpmn:sequenceFlow id="f-await_decision-g_grievance_join" sourceRef="await_decision" targetRef="g_grievance_join" />
    <bpmn:sequenceFlow id="f-g_grievance_join-continue_semester" sourceRef="g_grievance_join" targetRef="continue_semester" />
    <bpmn:sequenceFlow id="f-continue_semester-end_complete" name="Graduates or withdraws" sourceRef="continue_semester" targetRef="end_complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">graduated_or_withdrew = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-continue_semester-meet_advisor" name="Another semester" sourceRef="continue_semester" targetRef="meet_advisor" />
  </bpmn:process>
</bpmn:definitions>
