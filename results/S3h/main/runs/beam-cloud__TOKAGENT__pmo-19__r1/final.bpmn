<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="online_shop" name="Online Shop" processRef="online_shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="online_shop-process" name="Online Shop" isExecutable="false">
    <bpmn:laneSet id="online_shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery_loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start order" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="split_main" name="Select and payment simultaneously" />
    <bpmn:task id="select" name="Select items to purchase" />
    <bpmn:task id="payment_method" name="Set payment method" />
    <bpmn:parallelGateway id="sel_split" name="Split selection and reward" />
    <bpmn:parallelGateway id="payment_join" name="Join payment prerequisites" />
    <bpmn:exclusiveGateway id="pay_choice" name="Payment option?" default="f-pay_choice-installment" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="pay_merge" name="Merge payment" />
    <bpmn:parallelGateway id="delivery_join" name="Join delivery prerequisites" />
    <bpmn:exclusiveGateway id="delivery_loop" name="Loop into delivery" />
    <bpmn:task id="reward" name="Choose free reward" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="return_choice" name="Return items?" default="f-return_choice-e" />
    <bpmn:task id="return_items" name="Return items for exchange" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-login" sourceRef="s" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split_main" sourceRef="login" targetRef="split_main" />
    <bpmn:sequenceFlow id="f-split_main-select" sourceRef="split_main" targetRef="select" />
    <bpmn:sequenceFlow id="f-split_main-payment_method" sourceRef="split_main" targetRef="payment_method" />
    <bpmn:sequenceFlow id="f-select-sel_split" sourceRef="select" targetRef="sel_split" />
    <bpmn:sequenceFlow id="f-sel_split-reward" sourceRef="sel_split" targetRef="reward" />
    <bpmn:sequenceFlow id="f-sel_split-payment_join" sourceRef="sel_split" targetRef="payment_join" />
    <bpmn:sequenceFlow id="f-payment_method-payment_join" sourceRef="payment_method" targetRef="payment_join" />
    <bpmn:sequenceFlow id="f-payment_join-pay_choice" sourceRef="payment_join" targetRef="pay_choice" />
    <bpmn:sequenceFlow id="f-pay_choice-pay" name="Pay" sourceRef="pay_choice" targetRef="pay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pay_choice-installment" name="Installment" sourceRef="pay_choice" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-pay_merge" sourceRef="pay" targetRef="pay_merge" />
    <bpmn:sequenceFlow id="f-installment-pay_merge" sourceRef="installment" targetRef="pay_merge" />
    <bpmn:sequenceFlow id="f-pay_merge-delivery_join" sourceRef="pay_merge" targetRef="delivery_join" />
    <bpmn:sequenceFlow id="f-reward-delivery_join" sourceRef="reward" targetRef="delivery_join" />
    <bpmn:sequenceFlow id="f-delivery_join-delivery_loop" sourceRef="delivery_join" targetRef="delivery_loop" />
    <bpmn:sequenceFlow id="f-return_items-delivery_loop" sourceRef="return_items" targetRef="delivery_loop" />
    <bpmn:sequenceFlow id="f-delivery_loop-deliver" sourceRef="delivery_loop" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-return_choice" sourceRef="deliver" targetRef="return_choice" />
    <bpmn:sequenceFlow id="f-return_choice-return_items" name="Return items for exchange" sourceRef="return_choice" targetRef="return_items">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-return_choice-e" sourceRef="return_choice" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
