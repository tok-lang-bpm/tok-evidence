tok 1.0

pool "Online Shop" {
  lane "User" {
    start s "Start order"
    task login "Log in to account"
    and split_main "Select and payment simultaneously"
    task select "Select items to purchase"
    task payment_method "Set payment method"
    and sel_split "Split selection and reward"
    task reward "Choose free reward"
    and payment_join "Join payment prerequisites"
    xor pay_choice "Payment option?"
    task pay "Pay"
    task installment "Complete installment agreement"
    xor pay_merge "Merge payment"
    and delivery_join "Join delivery prerequisites"
    xor delivery_loop "Loop into delivery"
    task deliver "Deliver items"
    xor return_choice "Return items?"
    task return_items "Return items for exchange"
    end e "End"
  }
}

flow s -> login
flow login -> split_main
flow split_main -> select
flow split_main -> payment_method
flow select -> sel_split
flow sel_split -> reward
flow sel_split -> payment_join
flow payment_method -> payment_join
flow payment_join -> pay_choice
flow pay_choice -> pay "Pay"
flow pay_choice -> installment "Installment" default
flow pay -> pay_merge
flow installment -> pay_merge
flow pay_merge -> delivery_join
flow reward -> delivery_join
flow delivery_join -> delivery_loop
flow return_items -> delivery_loop
flow delivery_loop -> deliver
flow deliver -> return_choice
flow return_choice -> return_items "Return items for exchange"
flow return_choice -> e default
