<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Shipping Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Shipping Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>start-ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify-shipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>large-amounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite-companies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-small</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-small</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-branches</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics-head" name="Logistics Department Head">
        <bpmn:flowNodeRef>take-insurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>write-label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package-goods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-ship</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-ship" name="Goods shall be shipped" />
    <bpmn:task id="clarify-shipping" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="large-amounts" name="Large amounts?" default="f-large-amounts-split-small" />
    <bpmn:task id="invite-companies" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select-company" name="Select one logistic company" />
    <bpmn:parallelGateway id="split-small" />
    <bpmn:parallelGateway id="join-small" />
    <bpmn:exclusiveGateway id="merge-branches" />
    <bpmn:task id="take-insurance" name="Take parcel insurance if necessary" />
    <bpmn:task id="write-label" name="Write package label" />
    <bpmn:task id="package-goods" name="Package goods" />
    <bpmn:task id="prepare-pickup" name="Prepare packaged goods for pickup" />
    <bpmn:endEvent id="end-ship" name="Goods ready for pickup" />
    <bpmn:sequenceFlow id="f-start-ship-clarify-shipping" sourceRef="start-ship" targetRef="clarify-shipping" />
    <bpmn:sequenceFlow id="f-clarify-shipping-large-amounts" sourceRef="clarify-shipping" targetRef="large-amounts" />
    <bpmn:sequenceFlow id="f-large-amounts-invite-companies" name="Yes" sourceRef="large-amounts" targetRef="invite-companies">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-large-amounts-split-small" name="No" sourceRef="large-amounts" targetRef="split-small" />
    <bpmn:sequenceFlow id="f-invite-companies-select-company" sourceRef="invite-companies" targetRef="select-company" />
    <bpmn:sequenceFlow id="f-select-company-merge-branches" sourceRef="select-company" targetRef="merge-branches" />
    <bpmn:sequenceFlow id="f-split-small-write-label" sourceRef="split-small" targetRef="write-label" />
    <bpmn:sequenceFlow id="f-split-small-take-insurance" sourceRef="split-small" targetRef="take-insurance" />
    <bpmn:sequenceFlow id="f-split-small-package-goods" sourceRef="split-small" targetRef="package-goods" />
    <bpmn:sequenceFlow id="f-write-label-join-small" sourceRef="write-label" targetRef="join-small" />
    <bpmn:sequenceFlow id="f-take-insurance-join-small" sourceRef="take-insurance" targetRef="join-small" />
    <bpmn:sequenceFlow id="f-package-goods-join-small" sourceRef="package-goods" targetRef="join-small" />
    <bpmn:sequenceFlow id="f-join-small-merge-branches" sourceRef="join-small" targetRef="merge-branches" />
    <bpmn:sequenceFlow id="f-merge-branches-prepare-pickup" sourceRef="merge-branches" targetRef="prepare-pickup" />
    <bpmn:sequenceFlow id="f-prepare-pickup-end-ship" sourceRef="prepare-pickup" targetRef="end-ship" />
  </bpmn:process>
</bpmn:definitions>
