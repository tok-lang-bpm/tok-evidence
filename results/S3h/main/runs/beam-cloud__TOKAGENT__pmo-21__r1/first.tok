tok 1.0 "Shipping Process"

pool org "Organisation"
  lane secretary "Secretary"
    start start-ship "Goods shall be shipped"
    task clarify-shipping "Clarify who will do the shipping"
    xor large-amounts "Large amounts?"
    task invite-companies "Invite three logistic companies to make offers"
    task select-company "Select one logistic company"
    and split-small
    and join-small
    xor merge-branches
  lane logistics-head "Logistics Department Head"
    task take-insurance "Take parcel insurance if necessary"
  lane warehouse "Warehousemen"
    task write-label "Write package label"
    task package-goods "Package goods"
    task prepare-pickup "Prepare packaged goods for pickup"
    end end-ship "Goods ready for pickup"

flow start-ship -> clarify-shipping
flow clarify-shipping -> large-amounts
flow large-amounts -> invite-companies "Yes" when=""
flow large-amounts -> split-small "No" default
flow invite-companies -> select-company
flow select-company -> merge-branches
flow split-small -> write-label
flow split-small -> take-insurance
flow split-small -> package-goods
flow write-label -> join-small
flow take-insurance -> join-small
flow package-goods -> join-small
flow join-small -> merge-branches
flow merge-branches -> prepare-pickup
flow prepare-pickup -> end-ship
