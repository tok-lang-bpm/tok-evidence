<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Restaurant service process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant service process" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>hungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick-up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enter-pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup-buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass-buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buzz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>react</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-five</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call-guest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="hungry" name="Guest is hungry" />
    <bpmn:task id="enter" name="Enter restaurant" />
    <bpmn:task id="choose" name="Choose dish from meal range" />
    <bpmn:task id="wait-turn" name="Wait until turn" />
    <bpmn:task id="place-order" name="Place order with employee" />
    <bpmn:task id="pick-up" name="Pick up meal" />
    <bpmn:task id="eat" name="Eat meal" />
    <bpmn:endEvent id="done" name="Meal eaten" />
    <bpmn:task id="enter-pos" name="Enter order into POS system" />
    <bpmn:task id="collect" name="Collect money from guest" />
    <bpmn:task id="setup-buzzer" name="Set up buzzer" />
    <bpmn:task id="pass-buzzer" name="Pass buzzer to guest" />
    <bpmn:task id="inform-chef" name="Inform chef of new meal order" />
    <bpmn:task id="buzz" name="Set off guest's buzzer" />
    <bpmn:exclusiveGateway id="join" name="Guest buzzer cycle" />
    <bpmn:exclusiveGateway id="react" name="Guest reacts to buzzer?" default="f-react-wait-five" />
    <bpmn:task id="wait-five" name="Wait 5 minutes" />
    <bpmn:task id="call-guest" name="Call guest" />
    <bpmn:task id="handover" name="Hand over meal to guest" />
    <bpmn:task id="prepare" name="Prepare meal" />
    <bpmn:task id="hatch" name="Place meal in service hatch" />
    <bpmn:task id="inform-ready" name="Inform employee meal is ready" />
    <bpmn:sequenceFlow id="f-hungry-enter" sourceRef="hungry" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-choose" sourceRef="enter" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait-turn" sourceRef="choose" targetRef="wait-turn" />
    <bpmn:sequenceFlow id="f-wait-turn-place-order" sourceRef="wait-turn" targetRef="place-order" />
    <bpmn:sequenceFlow id="f-place-order-enter-pos" sourceRef="place-order" targetRef="enter-pos" />
    <bpmn:sequenceFlow id="f-enter-pos-collect" sourceRef="enter-pos" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-setup-buzzer" sourceRef="collect" targetRef="setup-buzzer" />
    <bpmn:sequenceFlow id="f-setup-buzzer-pass-buzzer" sourceRef="setup-buzzer" targetRef="pass-buzzer" />
    <bpmn:sequenceFlow id="f-pass-buzzer-inform-chef" sourceRef="pass-buzzer" targetRef="inform-chef" />
    <bpmn:sequenceFlow id="f-inform-chef-prepare" sourceRef="inform-chef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-hatch" sourceRef="prepare" targetRef="hatch" />
    <bpmn:sequenceFlow id="f-hatch-inform-ready" sourceRef="hatch" targetRef="inform-ready" />
    <bpmn:sequenceFlow id="f-inform-ready-buzz" sourceRef="inform-ready" targetRef="buzz" />
    <bpmn:sequenceFlow id="f-buzz-join" sourceRef="buzz" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-react" sourceRef="join" targetRef="react" />
    <bpmn:sequenceFlow id="f-react-handover" name="yes" sourceRef="react" targetRef="handover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">guest_reacted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-react-wait-five" name="no" sourceRef="react" targetRef="wait-five" />
    <bpmn:sequenceFlow id="f-wait-five-call-guest" sourceRef="wait-five" targetRef="call-guest" />
    <bpmn:sequenceFlow id="f-call-guest-join" sourceRef="call-guest" targetRef="join" />
    <bpmn:sequenceFlow id="f-handover-pick-up" sourceRef="handover" targetRef="pick-up" />
    <bpmn:sequenceFlow id="f-pick-up-eat" sourceRef="pick-up" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-done" sourceRef="eat" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
