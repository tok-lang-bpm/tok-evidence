tok 1.0 "Restaurant service process"

pool restaurant "Restaurant"
  lane guest "Guest"
    start hungry "Guest is hungry"
    task enter "Enter restaurant"
    task choose "Choose dish from meal range"
    task wait-turn "Wait until turn"
    task place-order "Place order with employee"
    task pick-up "Pick up meal"
    task eat "Eat meal"
    end done "Meal eaten"
  lane employee "Employee"
    task enter-pos "Enter order into POS system"
    task collect "Collect money from guest"
    task setup-buzzer "Set up buzzer"
    task pass-buzzer "Pass buzzer to guest"
    task inform-chef "Inform chef of new meal order"
    task buzz "Set off guest's buzzer"
    xor join "Guest buzzer cycle"
    xor react "Guest reacts to buzzer?"
    task wait-five "Wait 5 minutes"
    task call-guest "Call guest"
    task handover "Hand over meal to guest"
  lane chef "Chef"
    task prepare "Prepare meal"
    task hatch "Place meal in service hatch"
    task inform-ready "Inform employee meal is ready"

flow hungry -> enter -> choose -> wait-turn -> place-order -> enter-pos -> collect -> setup-buzzer -> pass-buzzer -> inform-chef -> prepare -> hatch -> inform-ready -> buzz -> join -> react
flow react -> handover "yes" when="guest_reacted = true"
flow react -> wait-five "no" default
flow wait-five -> call-guest -> join
flow handover -> pick-up -> eat -> done
