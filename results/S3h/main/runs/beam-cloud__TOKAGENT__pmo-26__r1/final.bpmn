<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-ss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-extended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-ended</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="select" name="Let parent select" />
    <bpmn:task id="decide" name="Let parent decide about extension" />
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="fetch" name="Fetch information about potential models" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="split" name="Notify parties?" />
    <bpmn:task id="notify-ss" name="Notify Social Security" />
    <bpmn:task id="notify-company" name="Notify Company" />
    <bpmn:parallelGateway id="join" name="Notifications done" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:exclusiveGateway id="ext" name="Extend maternity leave?" default="f-ext-e-ended" />
    <bpmn:endEvent id="e-extended" name="Leave extended" />
    <bpmn:endEvent id="e-ended" name="Leave ended" />
    <bpmn:sequenceFlow id="f-s-fetch" sourceRef="s" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-collect" sourceRef="select" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-split" sourceRef="collect" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-notify-ss" sourceRef="split" targetRef="notify-ss" />
    <bpmn:sequenceFlow id="f-split-notify-company" sourceRef="split" targetRef="notify-company" />
    <bpmn:sequenceFlow id="f-notify-ss-join" sourceRef="notify-ss" targetRef="join" />
    <bpmn:sequenceFlow id="f-notify-company-join" sourceRef="notify-company" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-gather" sourceRef="join" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-decide" sourceRef="gather" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-ext" sourceRef="decide" targetRef="ext" />
    <bpmn:sequenceFlow id="f-ext-e-extended" name="Yes" sourceRef="ext" targetRef="e-extended">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">extend = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ext-e-ended" name="No" sourceRef="ext" targetRef="e-ended" />
  </bpmn:process>
</bpmn:definitions>
