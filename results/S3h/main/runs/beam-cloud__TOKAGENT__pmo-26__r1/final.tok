tok 1.0 "Becoming A Parent"

pool org "Organisation"
  lane parent "Parent"
    task select "Let parent select"
    task decide "Let parent decide about extension"
  lane hr "Human Resources"
    start s "Start"
    task fetch "Fetch information about potential models"
    task collect "Collect relevant information"
    and split "Notify parties?"
    task notify-ss "Notify Social Security"
    task notify-company "Notify Company"
    and join "Notifications done"
    task gather "Gather information from companies"
    xor ext "Extend maternity leave?"
    end e-extended "Leave extended"
    end e-ended "Leave ended"

flow s -> fetch -> select -> collect -> split
flow split -> notify-ss
flow split -> notify-company
flow notify-ss -> join
flow notify-company -> join -> gather -> decide -> ext
flow ext -> e-extended "Yes" when="extend = true"
flow ext -> e-ended "No" default
