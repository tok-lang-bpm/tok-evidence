<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Offer" name="Offer" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Internship" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="intern" name="Intern">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gdetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gdetails-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-phase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gphase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gphase-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wsi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gsu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gsu-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recrec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>send-offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wsc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:parallelGateway id="gdetails" name="Enter details" />
    <bpmn:task id="enter-topic" name="Enter topic and money wanted" />
    <bpmn:task id="enter-exp" name="Enter experience and hobbies" />
    <bpmn:parallelGateway id="gdetails-done" name="Details entered" />
    <bpmn:subProcess id="offer-phase" name="Handle offers">
      <bpmn:startEvent id="os" name="Start offer handling" />
      <bpmn:receiveTask id="ro" name="Receive offer" messageRef="Message_Offer" />
      <bpmn:exclusiveGateway id="dec" name="Accept offer?" default="f-dec-den" />
      <bpmn:task id="acc" name="Accept offer" />
      <bpmn:task id="den" name="Deny offer" />
      <bpmn:endEvent id="term" name="Offers invalidated">
        <bpmn:terminateEventDefinition id="term-def" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="f-os-ro" sourceRef="os" targetRef="ro" />
      <bpmn:sequenceFlow id="f-ro-dec" sourceRef="ro" targetRef="dec" />
      <bpmn:sequenceFlow id="f-dec-acc" name="Accept" sourceRef="dec" targetRef="acc" />
      <bpmn:sequenceFlow id="f-dec-den" name="Deny" sourceRef="dec" targetRef="den" />
      <bpmn:sequenceFlow id="f-den-ro" sourceRef="den" targetRef="ro" />
      <bpmn:sequenceFlow id="f-acc-term" sourceRef="acc" targetRef="term" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="gphase" name="Offer phase" />
    <bpmn:parallelGateway id="gphase-done" name="Offer phase done" />
    <bpmn:task id="wsi" name="Write status update about internship">
      <bpmn:standardLoopCharacteristics loopMaximum="3" />
    </bpmn:task>
    <bpmn:parallelGateway id="gsu" name="Status updates" />
    <bpmn:parallelGateway id="gsu-done" name="Status updates done" />
    <bpmn:exclusiveGateway id="recrec" name="Recommend company?" default="f-recrec-e2" />
    <bpmn:task id="recommend" name="Recommend company to friends" />
    <bpmn:task id="tweet" name="Send tweet to friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:endEvent id="e2" name="End without recommendation" />
    <bpmn:task id="send-offers" name="Send offer">
      <bpmn:standardLoopCharacteristics loopMaximum="5" />
    </bpmn:task>
    <bpmn:task id="wsc" name="Write status update about intern">
      <bpmn:standardLoopCharacteristics loopMaximum="3" />
    </bpmn:task>
    <bpmn:sequenceFlow id="f-s-gdetails" sourceRef="s" targetRef="gdetails" />
    <bpmn:sequenceFlow id="f-gdetails-enter-topic" sourceRef="gdetails" targetRef="enter-topic" />
    <bpmn:sequenceFlow id="f-gdetails-enter-exp" sourceRef="gdetails" targetRef="enter-exp" />
    <bpmn:sequenceFlow id="f-enter-topic-gdetails-done" sourceRef="enter-topic" targetRef="gdetails-done" />
    <bpmn:sequenceFlow id="f-enter-exp-gdetails-done" sourceRef="enter-exp" targetRef="gdetails-done" />
    <bpmn:sequenceFlow id="f-gdetails-done-gphase" sourceRef="gdetails-done" targetRef="gphase" />
    <bpmn:sequenceFlow id="f-gphase-offer-phase" sourceRef="gphase" targetRef="offer-phase" />
    <bpmn:sequenceFlow id="f-gphase-send-offers" sourceRef="gphase" targetRef="send-offers" />
    <bpmn:sequenceFlow id="f-offer-phase-gphase-done" sourceRef="offer-phase" targetRef="gphase-done" />
    <bpmn:sequenceFlow id="f-send-offers-gphase-done" sourceRef="send-offers" targetRef="gphase-done" />
    <bpmn:sequenceFlow id="f-gphase-done-gsu" sourceRef="gphase-done" targetRef="gsu" />
    <bpmn:sequenceFlow id="f-gsu-wsi" sourceRef="gsu" targetRef="wsi" />
    <bpmn:sequenceFlow id="f-gsu-wsc" sourceRef="gsu" targetRef="wsc" />
    <bpmn:sequenceFlow id="f-wsi-gsu-done" sourceRef="wsi" targetRef="gsu-done" />
    <bpmn:sequenceFlow id="f-wsc-gsu-done" sourceRef="wsc" targetRef="gsu-done" />
    <bpmn:sequenceFlow id="f-gsu-done-recrec" sourceRef="gsu-done" targetRef="recrec" />
    <bpmn:sequenceFlow id="f-recrec-recommend" name="Yes" sourceRef="recrec" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recrec-e2" name="No" sourceRef="recrec" targetRef="e2" />
    <bpmn:sequenceFlow id="f-recommend-tweet" sourceRef="recommend" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-e1" sourceRef="tweet" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
