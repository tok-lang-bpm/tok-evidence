<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and Live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orgAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orgBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contactRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travelDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>funds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>otherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyRwr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handleRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Representation Office">
        <bpmn:flowNodeRef>detCompetent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueVisa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auth" name="Authorities">
        <bpmn:flowNodeRef>checkGrounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessTerr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="checkReq" name="Check the requirements" />
    <bpmn:parallelGateway id="g1" name="Organize accommodation and bank account" />
    <bpmn:task id="orgAcc" name="Organize accommodation" />
    <bpmn:task id="orgBank" name="Organize bank account" />
    <bpmn:parallelGateway id="g2" name="" />
    <bpmn:task id="contactRep" name="Contact representation in advance" />
    <bpmn:parallelGateway id="g3" name="Prepare required documents" />
    <bpmn:task id="appForm" name="Complete visa application form" />
    <bpmn:task id="travelDoc" name="Prepare travel document" />
    <bpmn:task id="photo" name="Prepare passport photo" />
    <bpmn:task id="insurance" name="Obtain travel health insurance" />
    <bpmn:task id="funds" name="Prove sufficient means of subsistence" />
    <bpmn:task id="otherEvidence" name="Gather other evidence requested by authorities" />
    <bpmn:parallelGateway id="g4" name="" />
    <bpmn:task id="applyRwr" name="Apply for Rot-Weiss-Rot Card" />
    <bpmn:task id="submit" name="Submit application" />
    <bpmn:task id="await" name="Await decision" />
    <bpmn:exclusiveGateway id="g5" name="Additional documents required?" default="f-g5-await" />
    <bpmn:task id="addDocs" name="Provide additional documents" />
    <bpmn:exclusiveGateway id="g6" name="Visa approved?" default="f-g6-handleRefusal" />
    <bpmn:task id="receiveVisa" name="Receive visa" />
    <bpmn:endEvent id="e1" name="Visa issued" />
    <bpmn:task id="handleRefusal" name="Handle refusal" />
    <bpmn:endEvent id="e2" name="Visa refused" />
    <bpmn:task id="detCompetent" name="Determine competent office" />
    <bpmn:task id="requestDocs" name="Request additional documents" />
    <bpmn:task id="issueVisa" name="Issue visa" />
    <bpmn:task id="checkGrounds" name="Check absence of grounds for refusal" />
    <bpmn:task id="assessTerr" name="Assess territorial competence" />
    <bpmn:sequenceFlow id="f-s-checkReq" sourceRef="s" targetRef="checkReq" />
    <bpmn:sequenceFlow id="f-checkReq-g1" sourceRef="checkReq" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-orgAcc" sourceRef="g1" targetRef="orgAcc" />
    <bpmn:sequenceFlow id="f-g1-orgBank" sourceRef="g1" targetRef="orgBank" />
    <bpmn:sequenceFlow id="f-orgAcc-g2" sourceRef="orgAcc" targetRef="g2" />
    <bpmn:sequenceFlow id="f-orgBank-g2" sourceRef="orgBank" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-contactRep" sourceRef="g2" targetRef="contactRep" />
    <bpmn:sequenceFlow id="f-contactRep-g3" sourceRef="contactRep" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-appForm" sourceRef="g3" targetRef="appForm" />
    <bpmn:sequenceFlow id="f-g3-travelDoc" sourceRef="g3" targetRef="travelDoc" />
    <bpmn:sequenceFlow id="f-g3-photo" sourceRef="g3" targetRef="photo" />
    <bpmn:sequenceFlow id="f-g3-insurance" sourceRef="g3" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-g3-funds" sourceRef="g3" targetRef="funds" />
    <bpmn:sequenceFlow id="f-g3-otherEvidence" sourceRef="g3" targetRef="otherEvidence" />
    <bpmn:sequenceFlow id="f-appForm-g4" sourceRef="appForm" targetRef="g4" />
    <bpmn:sequenceFlow id="f-travelDoc-g4" sourceRef="travelDoc" targetRef="g4" />
    <bpmn:sequenceFlow id="f-photo-g4" sourceRef="photo" targetRef="g4" />
    <bpmn:sequenceFlow id="f-insurance-g4" sourceRef="insurance" targetRef="g4" />
    <bpmn:sequenceFlow id="f-funds-g4" sourceRef="funds" targetRef="g4" />
    <bpmn:sequenceFlow id="f-otherEvidence-g4" sourceRef="otherEvidence" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-applyRwr" sourceRef="g4" targetRef="applyRwr" />
    <bpmn:sequenceFlow id="f-applyRwr-submit" sourceRef="applyRwr" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-detCompetent" sourceRef="submit" targetRef="detCompetent" />
    <bpmn:sequenceFlow id="f-detCompetent-assessTerr" sourceRef="detCompetent" targetRef="assessTerr" />
    <bpmn:sequenceFlow id="f-assessTerr-checkGrounds" sourceRef="assessTerr" targetRef="checkGrounds" />
    <bpmn:sequenceFlow id="f-checkGrounds-g5" sourceRef="checkGrounds" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-requestDocs" name="yes" sourceRef="g5" targetRef="requestDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additional_documents_needed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-requestDocs-addDocs" sourceRef="requestDocs" targetRef="addDocs" />
    <bpmn:sequenceFlow id="f-addDocs-await" sourceRef="addDocs" targetRef="await" />
    <bpmn:sequenceFlow id="f-g5-await" name="no" sourceRef="g5" targetRef="await" />
    <bpmn:sequenceFlow id="f-await-g6" sourceRef="await" targetRef="g6" />
    <bpmn:sequenceFlow id="f-g6-issueVisa" name="yes" sourceRef="g6" targetRef="issueVisa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visa_approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g6-handleRefusal" name="no" sourceRef="g6" targetRef="handleRefusal" />
    <bpmn:sequenceFlow id="f-issueVisa-receiveVisa" sourceRef="issueVisa" targetRef="receiveVisa" />
    <bpmn:sequenceFlow id="f-receiveVisa-e1" sourceRef="receiveVisa" targetRef="e1" />
    <bpmn:sequenceFlow id="f-handleRefusal-e2" sourceRef="handleRefusal" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
