tok 1.0 "Work and Live in Austria"

pool austria "Work and Live in Austria"
  lane applicant "Applicant"
    start s "Start"
    task checkReq "Check the requirements"
    and g1 "Organize accommodation and bank account"
    task orgAcc "Organize accommodation"
    task orgBank "Organize bank account"
    and g2 ""
    task contactRep "Contact representation in advance"
    and g3 "Prepare required documents"
    task appForm "Complete visa application form"
    task travelDoc "Prepare travel document"
    task photo "Prepare passport photo"
    task insurance "Obtain travel health insurance"
    task funds "Prove sufficient means of subsistence"
    task otherEvidence "Gather other evidence requested by authorities"
    and g4 ""
    task applyRwr "Apply for Rot-Weiss-Rot Card"
    task submit "Submit application"
    task await "Await decision"
    xor g5 "Additional documents required?"
    task addDocs "Provide additional documents"
    xor g6 "Visa approved?"
    task receiveVisa "Receive visa"
    end e1 "Visa issued"
    task handleRefusal "Handle refusal"
    end e2 "Visa refused"
  lane rep "Representation Office"
    task detCompetent "Determine competent office"
    task requestDocs "Request additional documents"
    task issueVisa "Issue visa"
  lane auth "Authorities"
    task checkGrounds "Check absence of grounds for refusal"
    task assessTerr "Assess territorial competence"

flow s -> checkReq -> g1
flow g1 -> orgAcc
flow g1 -> orgBank
flow orgAcc -> g2
flow orgBank -> g2 -> contactRep -> g3
flow g3 -> appForm
flow g3 -> travelDoc
flow g3 -> photo
flow g3 -> insurance
flow g3 -> funds
flow g3 -> otherEvidence
flow appForm -> g4
flow travelDoc -> g4
flow photo -> g4
flow insurance -> g4
flow funds -> g4
flow otherEvidence -> g4 -> applyRwr -> submit -> detCompetent -> assessTerr -> checkGrounds -> g5
flow g5 -> requestDocs "yes" when="additional_documents_needed = true"
flow requestDocs -> addDocs -> await
flow g5 -> await "no" default
flow await -> g6
flow g6 -> issueVisa "yes" when="visa_approved = true"
flow g6 -> handleRefusal "no" default
flow issueVisa -> receiveVisa -> e1
flow handleRefusal -> e2
