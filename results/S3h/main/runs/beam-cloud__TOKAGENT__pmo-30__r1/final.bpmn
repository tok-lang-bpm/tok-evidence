<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="lan-party" name="LAN Party" processRef="lan-party-process" />
  </bpmn:collaboration>
  <bpmn:process id="lan-party-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="lan-party-lanes">
      <bpmn:lane id="planner" name="Planner">
        <bpmn:flowNodeRef>start-event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find-wanted-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy-lan-party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-event</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-event" name="Start" />
    <bpmn:task id="send-invitations" name="Send invitations to these 10 friends" />
    <bpmn:task id="find-wanted-games" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="split-parallel" name="Parallel split" />
    <bpmn:task id="appoint-date" name="Appoint a date when the LAN party is going to happen" />
    <bpmn:exclusiveGateway id="enough-date" name="8 or more people agree on this date?" default="f-enough-date-appoint-date" />
    <bpmn:task id="check-games" name="Find out if you have all the games your guests want to play" />
    <bpmn:exclusiveGateway id="missing-games" name="Some games are missing?" default="f-missing-games-join-parallel" />
    <bpmn:task id="download-games" name="Download them" />
    <bpmn:parallelGateway id="join-parallel" name="Parallel join" />
    <bpmn:task id="find-beer" name="Find out how much beer your friends will require" />
    <bpmn:exclusiveGateway id="enough-beer" name="Do you have enough beer?" default="f-enough-beer-buy-beer" />
    <bpmn:task id="buy-beer" name="Buy what's missing" />
    <bpmn:exclusiveGateway id="join-beer" name="Beer sufficient" />
    <bpmn:task id="enjoy-lan-party" name="Enjoy the LAN party" />
    <bpmn:endEvent id="end-event" name="End" />
    <bpmn:sequenceFlow id="f-start-event-send-invitations" sourceRef="start-event" targetRef="send-invitations" />
    <bpmn:sequenceFlow id="f-send-invitations-find-wanted-games" sourceRef="send-invitations" targetRef="find-wanted-games" />
    <bpmn:sequenceFlow id="f-find-wanted-games-split-parallel" sourceRef="find-wanted-games" targetRef="split-parallel" />
    <bpmn:sequenceFlow id="f-split-parallel-appoint-date" sourceRef="split-parallel" targetRef="appoint-date" />
    <bpmn:sequenceFlow id="f-appoint-date-enough-date" sourceRef="appoint-date" targetRef="enough-date" />
    <bpmn:sequenceFlow id="f-enough-date-join-parallel" name="Yes" sourceRef="enough-date" targetRef="join-parallel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">people &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough-date-appoint-date" name="No" sourceRef="enough-date" targetRef="appoint-date" />
    <bpmn:sequenceFlow id="f-split-parallel-check-games" sourceRef="split-parallel" targetRef="check-games" />
    <bpmn:sequenceFlow id="f-check-games-missing-games" sourceRef="check-games" targetRef="missing-games" />
    <bpmn:sequenceFlow id="f-missing-games-download-games" name="Yes" sourceRef="missing-games" targetRef="download-games">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">missing &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-games-join-parallel" name="No" sourceRef="missing-games" targetRef="join-parallel" />
    <bpmn:sequenceFlow id="f-download-games-join-parallel" sourceRef="download-games" targetRef="join-parallel" />
    <bpmn:sequenceFlow id="f-join-parallel-find-beer" sourceRef="join-parallel" targetRef="find-beer" />
    <bpmn:sequenceFlow id="f-find-beer-enough-beer" sourceRef="find-beer" targetRef="enough-beer" />
    <bpmn:sequenceFlow id="f-enough-beer-buy-beer" name="No" sourceRef="enough-beer" targetRef="buy-beer" />
    <bpmn:sequenceFlow id="f-buy-beer-join-beer" sourceRef="buy-beer" targetRef="join-beer" />
    <bpmn:sequenceFlow id="f-enough-beer-join-beer" name="Yes" sourceRef="enough-beer" targetRef="join-beer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">beer &gt;= required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-join-beer-enjoy-lan-party" sourceRef="join-beer" targetRef="enjoy-lan-party" />
    <bpmn:sequenceFlow id="f-enjoy-lan-party-end-event" sourceRef="enjoy-lan-party" targetRef="end-event" />
  </bpmn:process>
</bpmn:definitions>
