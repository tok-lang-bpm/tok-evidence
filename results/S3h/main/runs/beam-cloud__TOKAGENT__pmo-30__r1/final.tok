tok 1.0 "LAN Party"

pool lan-party "LAN Party"
  lane planner "Planner"
    start start-event "Start"
    task send-invitations "Send invitations to these 10 friends"
    task find-wanted-games "Find out which games they want to play"
    and split-parallel "Parallel split"
    task appoint-date "Appoint a date when the LAN party is going to happen"
    xor enough-date "8 or more people agree on this date?"
    task check-games "Find out if you have all the games your guests want to play"
    xor missing-games "Some games are missing?"
    task download-games "Download them"
    and join-parallel "Parallel join"
    task find-beer "Find out how much beer your friends will require"
    xor enough-beer "Do you have enough beer?"
    task buy-beer "Buy what's missing"
    xor join-beer "Beer sufficient"
    task enjoy-lan-party "Enjoy the LAN party"
    end end-event "End"

flow start-event -> send-invitations -> find-wanted-games -> split-parallel
flow split-parallel -> appoint-date -> enough-date
flow enough-date -> join-parallel "Yes" when="people >= 8"
flow enough-date -> appoint-date "No" default
flow split-parallel -> check-games -> missing-games
flow missing-games -> download-games "Yes" when="missing > 0"
flow missing-games -> join-parallel "No" default
flow download-games -> join-parallel -> find-beer -> enough-beer
flow enough-beer -> buy-beer "No" default
flow buy-beer -> join-beer
flow enough-beer -> join-beer "Yes" when="beer >= required"
flow join-beer -> enjoy-lan-party -> end-event
