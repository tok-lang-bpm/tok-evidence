<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>start_creation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_battle_net</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>battle_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_account_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click_confirmation_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>subscription_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_payment_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_method_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_credit_card_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_iban_bic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log_into_game</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_realm_race_class</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>come_up_with_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>things_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_character_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name_available_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_selfies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_another_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_creation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_creation" name="Start character creation" />
    <bpmn:parallelGateway id="split_start" name="Start two tasks" />
    <bpmn:task id="check_battle_net" name="Check whether you have a battle.net account" />
    <bpmn:exclusiveGateway id="battle_gateway" name="Do you have a battle.net account?" />
    <bpmn:task id="enter_account_info" name="Enter account information" />
    <bpmn:task id="click_confirmation_link" name="Click the link in confirmation mail" />
    <bpmn:exclusiveGateway id="account_ready" name="Account ready" />
    <bpmn:task id="check_subscription" name="Check whether you have an active WoW subscription" />
    <bpmn:exclusiveGateway id="subscription_gateway" name="Do you have an active WoW subscription?" />
    <bpmn:task id="select_payment_method" name="Select payment method" />
    <bpmn:exclusiveGateway id="payment_method_gateway" name="Which payment method?" />
    <bpmn:task id="enter_credit_card_info" name="Enter credit card information" />
    <bpmn:task id="enter_iban_bic" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="payment_ready" name="Payment entered" />
    <bpmn:exclusiveGateway id="login_ready" name="Ready to log in" />
    <bpmn:task id="log_into_game" name="Log into the game" />
    <bpmn:task id="select_realm_race_class" name="Select realm, race and class" />
    <bpmn:task id="come_up_with_names" name="Come up with good character names" />
    <bpmn:parallelGateway id="things_ready" name="Account setup and names ready" />
    <bpmn:task id="enter_character_name" name="Enter character name" />
    <bpmn:exclusiveGateway id="name_available_gateway" name="Is name available?" />
    <bpmn:task id="get_confirmation" name="Get confirmation" />
    <bpmn:task id="get_selfies" name="Get selfies of your character" />
    <bpmn:task id="get_another_message" name="Get another message" />
    <bpmn:endEvent id="end_creation" name="End" />
    <bpmn:sequenceFlow id="f-start_creation-split_start" sourceRef="start_creation" targetRef="split_start" />
    <bpmn:sequenceFlow id="f-split_start-check_battle_net" sourceRef="split_start" targetRef="check_battle_net" />
    <bpmn:sequenceFlow id="f-split_start-come_up_with_names" sourceRef="split_start" targetRef="come_up_with_names" />
    <bpmn:sequenceFlow id="f-check_battle_net-battle_gateway" sourceRef="check_battle_net" targetRef="battle_gateway" />
    <bpmn:sequenceFlow id="f-battle_gateway-enter_account_info" name="No" sourceRef="battle_gateway" targetRef="enter_account_info">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasBattleNetAccount = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enter_account_info-click_confirmation_link" sourceRef="enter_account_info" targetRef="click_confirmation_link" />
    <bpmn:sequenceFlow id="f-click_confirmation_link-account_ready" sourceRef="click_confirmation_link" targetRef="account_ready" />
    <bpmn:sequenceFlow id="f-battle_gateway-account_ready" name="Yes" sourceRef="battle_gateway" targetRef="account_ready">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasBattleNetAccount = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-account_ready-check_subscription" sourceRef="account_ready" targetRef="check_subscription" />
    <bpmn:sequenceFlow id="f-check_subscription-subscription_gateway" sourceRef="check_subscription" targetRef="subscription_gateway" />
    <bpmn:sequenceFlow id="f-subscription_gateway-select_payment_method" name="No" sourceRef="subscription_gateway" targetRef="select_payment_method">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasActiveSubscription = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-select_payment_method-payment_method_gateway" sourceRef="select_payment_method" targetRef="payment_method_gateway" />
    <bpmn:sequenceFlow id="f-payment_method_gateway-enter_credit_card_info" name="Credit card" sourceRef="payment_method_gateway" targetRef="enter_credit_card_info">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentMethod = "credit card"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-payment_method_gateway-enter_iban_bic" name="Bank account" sourceRef="payment_method_gateway" targetRef="enter_iban_bic">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentMethod = "bank account"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enter_credit_card_info-payment_ready" sourceRef="enter_credit_card_info" targetRef="payment_ready" />
    <bpmn:sequenceFlow id="f-enter_iban_bic-payment_ready" sourceRef="enter_iban_bic" targetRef="payment_ready" />
    <bpmn:sequenceFlow id="f-payment_ready-login_ready" sourceRef="payment_ready" targetRef="login_ready" />
    <bpmn:sequenceFlow id="f-subscription_gateway-login_ready" name="Yes" sourceRef="subscription_gateway" targetRef="login_ready">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasActiveSubscription = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-login_ready-log_into_game" sourceRef="login_ready" targetRef="log_into_game" />
    <bpmn:sequenceFlow id="f-log_into_game-select_realm_race_class" sourceRef="log_into_game" targetRef="select_realm_race_class" />
    <bpmn:sequenceFlow id="f-select_realm_race_class-things_ready" sourceRef="select_realm_race_class" targetRef="things_ready" />
    <bpmn:sequenceFlow id="f-come_up_with_names-things_ready" sourceRef="come_up_with_names" targetRef="things_ready" />
    <bpmn:sequenceFlow id="f-things_ready-enter_character_name" sourceRef="things_ready" targetRef="enter_character_name" />
    <bpmn:sequenceFlow id="f-enter_character_name-name_available_gateway" sourceRef="enter_character_name" targetRef="name_available_gateway" />
    <bpmn:sequenceFlow id="f-name_available_gateway-enter_character_name" name="No" sourceRef="name_available_gateway" targetRef="enter_character_name">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nameAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-name_available_gateway-get_confirmation" name="Yes" sourceRef="name_available_gateway" targetRef="get_confirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nameAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-get_confirmation-get_selfies" sourceRef="get_confirmation" targetRef="get_selfies" />
    <bpmn:sequenceFlow id="f-get_selfies-get_another_message" sourceRef="get_selfies" targetRef="get_another_message" />
    <bpmn:sequenceFlow id="f-get_another_message-end_creation" sourceRef="get_another_message" targetRef="end_creation" />
  </bpmn:process>
</bpmn:definitions>
