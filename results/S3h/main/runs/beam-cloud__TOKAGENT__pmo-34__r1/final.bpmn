<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="machine" name="Building a custom machine out of Lego bricks" processRef="machine-process" />
  </bpmn:collaboration>
  <bpmn:process id="machine-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="machine-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>develop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="develop" name="Develop basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give Lego sets to children" />
    <bpmn:exclusiveGateway id="parts" name="Parts available in container?" default="f-parts-reorder" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="build" name="Build subcomponent" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="tested" name="Subcomponent tested successfully?" default="f-tested-redesign" />
    <bpmn:task id="redesign" name="Redesign and rebuild subcomponent" />
    <bpmn:exclusiveGateway id="more" name="More subcomponents to build?" default="f-more-assemble" />
    <bpmn:task id="assemble" name="Assemble subcomponents" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:sequenceFlow id="f-s-develop" sourceRef="s" targetRef="develop" />
    <bpmn:sequenceFlow id="f-develop-order" sourceRef="develop" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-parts" sourceRef="sort" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-build" name="yes" sourceRef="parts" targetRef="build">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-parts-reorder" name="no" sourceRef="parts" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-reorder-build" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-tested" sourceRef="test" targetRef="tested" />
    <bpmn:sequenceFlow id="f-tested-more" name="yes" sourceRef="tested" targetRef="more">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-tested-redesign" name="no" sourceRef="tested" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-parts" sourceRef="redesign" targetRef="parts" />
    <bpmn:sequenceFlow id="f-more-parts" name="yes" sourceRef="more" targetRef="parts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-assemble" name="no" sourceRef="more" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-e" sourceRef="assemble" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
