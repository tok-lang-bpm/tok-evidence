tok 1.0 "Building a custom machine out of Lego bricks"

pool machine "Building a custom machine out of Lego bricks"
  lane builder "Builder"
    start s "Start"
    task develop "Develop basic design"
    task order "Order Lego brick sets"
    task give "Give Lego sets to children"
    xor parts "Parts available in container?"
    task reorder "Reorder individual parts"
    task build "Build subcomponent"
    task test "Test subcomponent"
    xor tested "Subcomponent tested successfully?"
    task redesign "Redesign and rebuild subcomponent"
    xor more "More subcomponents to build?"
    task assemble "Assemble subcomponents"
    end e "End"
  lane children "Children"
    task sort "Sort parts into containers"

flow s -> develop -> order -> give -> sort -> parts
flow parts -> build "yes" when=""
flow parts -> reorder "no" default
flow reorder -> build -> test -> tested
flow tested -> more "yes" when=""
flow tested -> redesign "no" default
flow redesign -> parts
flow more -> parts "yes" when=""
flow more -> assemble "no" default
flow assemble -> e
