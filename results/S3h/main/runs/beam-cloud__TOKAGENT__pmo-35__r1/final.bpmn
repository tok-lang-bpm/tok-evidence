<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Chainsaw organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-properties</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect-parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prod-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble-parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-prod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-first-saw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce-rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="receive-properties" name="Receive customer properties" />
    <bpmn:task id="order-parts" name="Order parts from online sources" />
    <bpmn:task id="inspect-parts" name="Inspect all parts" />
    <bpmn:parallelGateway id="prod-gw" name="Produce saw" />
    <bpmn:task id="assemble-parts" name="Assemble parts" />
    <bpmn:task id="send-updates" name="Send production updates to customer" />
    <bpmn:parallelGateway id="join-prod" name="Production complete" />
    <bpmn:task id="send-first-saw" name="Send first saw to customer" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes first saw?" default="f-likes-e" />
    <bpmn:task id="produce-rest" name="Produce rest of order" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-receive-properties" sourceRef="s" targetRef="receive-properties" />
    <bpmn:sequenceFlow id="f-receive-properties-order-parts" sourceRef="receive-properties" targetRef="order-parts" />
    <bpmn:sequenceFlow id="f-order-parts-inspect-parts" sourceRef="order-parts" targetRef="inspect-parts" />
    <bpmn:sequenceFlow id="f-inspect-parts-prod-gw" sourceRef="inspect-parts" targetRef="prod-gw" />
    <bpmn:sequenceFlow id="f-prod-gw-assemble-parts" sourceRef="prod-gw" targetRef="assemble-parts" />
    <bpmn:sequenceFlow id="f-prod-gw-send-updates" sourceRef="prod-gw" targetRef="send-updates" />
    <bpmn:sequenceFlow id="f-assemble-parts-join-prod" sourceRef="assemble-parts" targetRef="join-prod" />
    <bpmn:sequenceFlow id="f-send-updates-join-prod" sourceRef="send-updates" targetRef="join-prod" />
    <bpmn:sequenceFlow id="f-join-prod-send-first-saw" sourceRef="join-prod" targetRef="send-first-saw" />
    <bpmn:sequenceFlow id="f-send-first-saw-likes" sourceRef="send-first-saw" targetRef="likes" />
    <bpmn:sequenceFlow id="f-likes-produce-rest" name="Yes" sourceRef="likes" targetRef="produce-rest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerLikes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-likes-e" name="No" sourceRef="likes" targetRef="e" />
    <bpmn:sequenceFlow id="f-produce-rest-e" sourceRef="produce-rest" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
