tok 1.0 "Chainsaw"

pool org "Chainsaw organisation"
  lane you "You"
    start s "Start"
    task receive-properties "Receive customer properties"
    task order-parts "Order parts from online sources"
    task inspect-parts "Inspect all parts"
    and prod-gw "Produce saw"
    task assemble-parts "Assemble parts"
    task send-updates "Send production updates to customer"
    and join-prod "Production complete"
    task send-first-saw "Send first saw to customer"
    xor likes "Customer likes first saw?"
    task produce-rest "Produce rest of order"
    end e "End"

flow s -> receive-properties
flow receive-properties -> order-parts
flow order-parts -> inspect-parts
flow inspect-parts -> prod-gw
flow prod-gw -> assemble-parts
flow prod-gw -> send-updates
flow assemble-parts -> join-prod
flow send-updates -> join-prod
flow join-prod -> send-first-saw
flow send-first-saw -> likes
flow likes -> produce-rest "Yes" when="customerLikes"
flow likes -> e "No" default
flow produce-rest -> e
