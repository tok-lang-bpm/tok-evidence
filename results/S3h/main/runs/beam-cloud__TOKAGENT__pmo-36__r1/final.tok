tok 1.0 "Luxury Airplane"

pool org "Luxury Airplane Manufacturer"
  lane customer "Customer"
    user decide_specs "Decide interior specifications"
    user confirm "Confirm delivery"
    end end_event "Delivery confirmed"
  lane manufacturer "Manufacturer"
    start start_event "Start production"
    task produce_base "Produce base airplane"
    receive receive_specs "Receive specifications"
    task send_requirements "Send requirements to manufacturing teams"
    and and_split "Manufacture parts in parallel"
    and and_join "Parts received"
    receive receive_parts "Receive individual parts"
    task assemble "Assemble interior"
    task test_flight "Send plane on test flight"
    task create_protocol "Create test protocol"
    send send_protocol "Send test protocol"
    task deliver "Deliver airplane"
  lane russian "Russian team"
    task manufacture_vodka "Manufacture vodka bar"
  lane irish "Irish team"
    task manufacture_whiskey "Manufacture whiskey bar"

flow start_event -> produce_base -> decide_specs -> receive_specs -> send_requirements -> and_split
flow and_split -> manufacture_vodka
flow and_split -> manufacture_whiskey
flow manufacture_vodka -> and_join -> receive_parts -> assemble -> test_flight -> create_protocol -> send_protocol -> deliver -> confirm -> end_event
