<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Luxury Airplane Manufacturer" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>decide_specs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manufacturer" name="Manufacturer">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_specs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian" name="Russian team">
        <bpmn:flowNodeRef>manufacture_vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish" name="Irish team">
        <bpmn:flowNodeRef>manufacture_whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="decide_specs" name="Decide interior specifications" />
    <bpmn:userTask id="confirm" name="Confirm delivery" />
    <bpmn:endEvent id="end_event" name="Delivery confirmed" />
    <bpmn:startEvent id="start_event" name="Start production" />
    <bpmn:task id="produce_base" name="Produce base airplane" />
    <bpmn:receiveTask id="receive_specs" name="Receive specifications" />
    <bpmn:task id="send_requirements" name="Send requirements to manufacturing teams" />
    <bpmn:parallelGateway id="and_split" name="Manufacture parts in parallel" />
    <bpmn:parallelGateway id="and_join" name="Parts received" />
    <bpmn:receiveTask id="receive_parts" name="Receive individual parts" />
    <bpmn:task id="assemble" name="Assemble interior" />
    <bpmn:task id="test_flight" name="Send plane on test flight" />
    <bpmn:task id="create_protocol" name="Create test protocol" />
    <bpmn:sendTask id="send_protocol" name="Send test protocol" />
    <bpmn:task id="deliver" name="Deliver airplane" />
    <bpmn:task id="manufacture_vodka" name="Manufacture vodka bar" />
    <bpmn:task id="manufacture_whiskey" name="Manufacture whiskey bar" />
    <bpmn:sequenceFlow id="f-start_event-produce_base" sourceRef="start_event" targetRef="produce_base" />
    <bpmn:sequenceFlow id="f-produce_base-decide_specs" sourceRef="produce_base" targetRef="decide_specs" />
    <bpmn:sequenceFlow id="f-decide_specs-receive_specs" sourceRef="decide_specs" targetRef="receive_specs" />
    <bpmn:sequenceFlow id="f-receive_specs-send_requirements" sourceRef="receive_specs" targetRef="send_requirements" />
    <bpmn:sequenceFlow id="f-send_requirements-and_split" sourceRef="send_requirements" targetRef="and_split" />
    <bpmn:sequenceFlow id="f-and_split-manufacture_vodka" sourceRef="and_split" targetRef="manufacture_vodka" />
    <bpmn:sequenceFlow id="f-and_split-manufacture_whiskey" sourceRef="and_split" targetRef="manufacture_whiskey" />
    <bpmn:sequenceFlow id="f-manufacture_vodka-and_join" sourceRef="manufacture_vodka" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-manufacture_whiskey-and_join" sourceRef="manufacture_whiskey" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-and_join-receive_parts" sourceRef="and_join" targetRef="receive_parts" />
    <bpmn:sequenceFlow id="f-receive_parts-assemble" sourceRef="receive_parts" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-test_flight" sourceRef="assemble" targetRef="test_flight" />
    <bpmn:sequenceFlow id="f-test_flight-create_protocol" sourceRef="test_flight" targetRef="create_protocol" />
    <bpmn:sequenceFlow id="f-create_protocol-send_protocol" sourceRef="create_protocol" targetRef="send_protocol" />
    <bpmn:sequenceFlow id="f-send_protocol-deliver" sourceRef="send_protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-end_event" sourceRef="confirm" targetRef="end_event" />
  </bpmn:process>
</bpmn:definitions>
