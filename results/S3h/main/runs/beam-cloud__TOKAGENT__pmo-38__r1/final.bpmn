<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="Building a House" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createmat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendbuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Tree House Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store" name="Online Stores">
        <bpmn:flowNodeRef>processorder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="sendreq" name="Send requirements to architect" />
    <bpmn:task id="refine" name="Refine draft with additional requirements">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="createmat" name="Create list of needed materials" />
    <bpmn:task id="order" name="Order materials" />
    <bpmn:parallelGateway id="g1" />
    <bpmn:parallelGateway id="g2" />
    <bpmn:task id="sendbuild" name="Send build messages to friends" />
    <bpmn:task id="invitations" name="Send party invitations" />
    <bpmn:task id="attendee" name="Create list of attendees" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="draft" name="Send back a draft" />
    <bpmn:task id="build" name="Build house" />
    <bpmn:task id="processorder" name="Process order" />
    <bpmn:sequenceFlow id="f-s-collect" sourceRef="s" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sendreq" sourceRef="collect" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-draft" sourceRef="sendreq" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-refine" sourceRef="draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-createmat" sourceRef="refine" targetRef="createmat" />
    <bpmn:sequenceFlow id="f-createmat-order" sourceRef="createmat" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-g1" sourceRef="order" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-processorder" sourceRef="g1" targetRef="processorder" />
    <bpmn:sequenceFlow id="f-g1-sendbuild" sourceRef="g1" targetRef="sendbuild" />
    <bpmn:sequenceFlow id="f-sendbuild-build" sourceRef="sendbuild" targetRef="build" />
    <bpmn:sequenceFlow id="f-processorder-g2" sourceRef="processorder" targetRef="g2" />
    <bpmn:sequenceFlow id="f-build-g2" sourceRef="build" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-invitations" sourceRef="g2" targetRef="invitations" />
    <bpmn:sequenceFlow id="f-invitations-attendee" sourceRef="invitations" targetRef="attendee" />
    <bpmn:sequenceFlow id="f-attendee-e" sourceRef="attendee" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
