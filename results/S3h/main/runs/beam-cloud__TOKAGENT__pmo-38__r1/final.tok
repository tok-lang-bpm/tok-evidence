tok 1.0 "Building a House"

pool house "Building a House"
  lane you "You"
    start s "Start"
    task collect "Collect requirements"
    task sendreq "Send requirements to architect"
    task refine "Refine draft with additional requirements" loop
    task createmat "Create list of needed materials"
    task order "Order materials"
    and g1
    and g2
    task sendbuild "Send build messages to friends"
    task invitations "Send party invitations"
    task attendee "Create list of attendees"
    end e "End"
  lane architect "Tree House Architect"
    task draft "Send back a draft"
  lane friends "Friends"
    task build "Build house"
  lane store "Online Stores"
    task processorder "Process order"

flow s -> collect -> sendreq -> draft -> refine -> createmat -> order -> g1
flow g1 -> processorder
flow g1 -> sendbuild -> build
flow processorder -> g2
flow build -> g2 -> invitations -> attendee -> e
