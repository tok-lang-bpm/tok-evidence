<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="repair" name="DIY smartphone repair" processRef="repair-process" />
  </bpmn:collaboration>
  <bpmn:process id="repair-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="repair-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-have</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact-friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix-phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online tool">
        <bpmn:flowNodeRef>split-lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-tools</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-choices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-instructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enter-model" name="Enter model and what is broken" />
    <bpmn:task id="identify-have" name="Identify stuff already at hand" />
    <bpmn:task id="contact-friends" name="Contact friends to borrow or buy" />
    <bpmn:task id="buy-rest" name="Buy the rest" />
    <bpmn:task id="fix-phone" name="Fix the phone" />
    <bpmn:exclusiveGateway id="worked" name="Did the repair work?" default="f-worked-send-expert" />
    <bpmn:task id="send-review" name="Send review and/or video" />
    <bpmn:task id="send-expert" name="Send phone to expert" />
    <bpmn:endEvent id="end-success" name="End" />
    <bpmn:endEvent id="end-expert" name="End" />
    <bpmn:parallelGateway id="split-lists" name="Provide information" />
    <bpmn:task id="give-materials" name="Give list of materials" />
    <bpmn:task id="give-tools" name="Give list of tools" />
    <bpmn:task id="give-choices" name="Give ordering choices" />
    <bpmn:parallelGateway id="join-lists" name="Collect information" />
    <bpmn:task id="send-instructions" name="Send repair instructions" />
    <bpmn:sequenceFlow id="f-start-enter-model" sourceRef="start" targetRef="enter-model" />
    <bpmn:sequenceFlow id="f-enter-model-split-lists" sourceRef="enter-model" targetRef="split-lists" />
    <bpmn:sequenceFlow id="f-split-lists-give-materials" sourceRef="split-lists" targetRef="give-materials" />
    <bpmn:sequenceFlow id="f-split-lists-give-tools" sourceRef="split-lists" targetRef="give-tools" />
    <bpmn:sequenceFlow id="f-split-lists-give-choices" sourceRef="split-lists" targetRef="give-choices" />
    <bpmn:sequenceFlow id="f-give-materials-join-lists" sourceRef="give-materials" targetRef="join-lists" />
    <bpmn:sequenceFlow id="f-give-tools-join-lists" sourceRef="give-tools" targetRef="join-lists" />
    <bpmn:sequenceFlow id="f-give-choices-join-lists" sourceRef="give-choices" targetRef="join-lists" />
    <bpmn:sequenceFlow id="f-join-lists-identify-have" sourceRef="join-lists" targetRef="identify-have" />
    <bpmn:sequenceFlow id="f-identify-have-contact-friends" sourceRef="identify-have" targetRef="contact-friends" />
    <bpmn:sequenceFlow id="f-contact-friends-buy-rest" sourceRef="contact-friends" targetRef="buy-rest" />
    <bpmn:sequenceFlow id="f-buy-rest-send-instructions" sourceRef="buy-rest" targetRef="send-instructions" />
    <bpmn:sequenceFlow id="f-send-instructions-fix-phone" sourceRef="send-instructions" targetRef="fix-phone" />
    <bpmn:sequenceFlow id="f-fix-phone-worked" sourceRef="fix-phone" targetRef="worked" />
    <bpmn:sequenceFlow id="f-worked-send-review" name="yes" sourceRef="worked" targetRef="send-review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">worked = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-worked-send-expert" name="no" sourceRef="worked" targetRef="send-expert" />
    <bpmn:sequenceFlow id="f-send-review-end-success" sourceRef="send-review" targetRef="end-success" />
    <bpmn:sequenceFlow id="f-send-expert-end-expert" sourceRef="send-expert" targetRef="end-expert" />
  </bpmn:process>
</bpmn:definitions>
