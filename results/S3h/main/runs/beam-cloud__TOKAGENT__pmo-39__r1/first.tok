tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool repair "DIY smartphone repair"
  lane customer "Customer"
    start start "Start"
    task enter-model "Enter model and what is broken"
    task identify-have "Identify stuff already at hand"
    task contact-friends "Contact friends to borrow or buy"
    task buy-rest "Buy the rest"
    task fix-phone "Fix the phone"
    xor worked "Did the repair work?"
    task send-review "Send review and/or video"
    task send-expert "Send phone to expert"
    end end-success "End"
    end end-expert "End"
  lane tool "Online tool"
    and split-lists "Provide information"
    task give-materials "Give list of materials"
    task give-tools "Give list of tools"
    task give-choices "Give ordering choices"
    and join-lists "Collect information"
    task send-instructions "Send repair instructions"

flow start -> enter-model
flow enter-model -> split-lists
flow split-lists -> give-materials
flow split-lists -> give-tools
flow split-lists -> give-choices
flow give-materials -> join-lists
flow give-tools -> join-lists
flow give-choices -> join-lists
flow join-lists -> identify-have
flow identify-have -> contact-friends
flow contact-friends -> buy-rest
flow buy-rest -> send-instructions
flow send-instructions -> fix-phone
flow fix-phone -> worked
flow worked -> send-review "yes"
flow worked -> send-expert "no" default
flow send-review -> end-success
flow send-expert -> end-expert
