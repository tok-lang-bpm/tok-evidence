tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool p "Energy Drink Bottling Machine Inspection"
  lane l "Inspector"
    start s "Start"
    task enter-type "Enter machine type"
    task enter-serial "Enter serial number"
    task ask-questions "Ask questions"
    task input-values "Input values"
    task press-buttons "Press buttons"
    task collect-values "Collect values from machine"
    xor g "Additional questions needed?"
    task ask-additional "Ask additional questions"
    end e "End"

flow s -> enter-type -> enter-serial -> ask-questions -> input-values -> press-buttons -> collect-values -> g
flow g -> ask-additional "Yes" when=""
flow g -> e "No" default
flow ask-additional -> e
