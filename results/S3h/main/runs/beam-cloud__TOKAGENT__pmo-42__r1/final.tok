tok 1.0 "Service for Your Fridge"

pool p "Service for Your Fridge"
  lane customer "You"
    start start "Fridge produces strange noises"
    task describe "Describe the symptoms"
    task send "Send symptoms and fridge type to the central service center"
    task confirm "Confirm that the fridge is OK"
    xor rate-gw "Rate service facility?"
    task rate "Rate the service facility"
    end end "End"
  lane center "Central fridge service center"
    task select "Select a local service facility"
  lane facility "Service facility"
    task appointment "Make an appointment"
    task arrive "Arrive at a random time"
    xor parts-gw "Parts available?"
    task repair "Repair the fridge"

flow start -> describe -> send -> select -> appointment -> arrive -> parts-gw
flow parts-gw -> repair "Yes" when="partsAvailable"
flow parts-gw -> appointment "No" default
flow repair -> confirm -> rate-gw
flow rate-gw -> rate "Yes" when="wantsToRate"
flow rate-gw -> end "No" default
flow rate -> end
