<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Service for Your Fridge" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="customer" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Service facility">
        <bpmn:flowNodeRef>appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send symptoms and fridge type to the central service center" />
    <bpmn:task id="confirm" name="Confirm that the fridge is OK" />
    <bpmn:exclusiveGateway id="rate-gw" name="Rate service facility?" default="f-rate-gw-end" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:task id="appointment" name="Make an appointment" />
    <bpmn:task id="arrive" name="Arrive at a random time" />
    <bpmn:exclusiveGateway id="parts-gw" name="Parts available?" default="f-parts-gw-appointment" />
    <bpmn:task id="repair" name="Repair the fridge" />
    <bpmn:sequenceFlow id="f-start-describe" sourceRef="start" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appointment" sourceRef="select" targetRef="appointment" />
    <bpmn:sequenceFlow id="f-appointment-arrive" sourceRef="appointment" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-parts-gw" sourceRef="arrive" targetRef="parts-gw" />
    <bpmn:sequenceFlow id="f-parts-gw-repair" name="Yes" sourceRef="parts-gw" targetRef="repair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">partsAvailable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-parts-gw-appointment" name="No" sourceRef="parts-gw" targetRef="appointment" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate-gw" sourceRef="confirm" targetRef="rate-gw" />
    <bpmn:sequenceFlow id="f-rate-gw-rate" name="Yes" sourceRef="rate-gw" targetRef="rate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wantsToRate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rate-gw-end" name="No" sourceRef="rate-gw" targetRef="end" />
    <bpmn:sequenceFlow id="f-rate-end" sourceRef="rate" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
