<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Car Service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="car-service" name="Car Service" processRef="car-service-process" />
  </bpmn:collaboration>
  <bpmn:process id="car-service-process" name="Car Service" isExecutable="false">
    <bpmn:laneSet id="car-service-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>svc-needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-not-registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-fined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="owner" name="You">
        <bpmn:flowNodeRef>go-service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer-30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enter-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="svc-needed" name="Service necessary" />
    <bpmn:task id="check-reg" name="Check if your car is still registered" />
    <bpmn:exclusiveGateway id="reg-gw" name="Car still registered?" default="f-reg-gw-end-not-registered" />
    <bpmn:task id="notify" name="You are notified" />
    <bpmn:task id="fine" name="You are fined" />
    <bpmn:task id="status" name="You get status updates via email" />
    <bpmn:endEvent id="end-not-registered" name="Car not registered" />
    <bpmn:endEvent id="end-fined" name="Fined" />
    <bpmn:task id="go-service" name="Go to the service" />
    <bpmn:boundaryEvent id="timer-30" name="30 days" attachedToRef="go-service">
      <bpmn:timerEventDefinition id="timer-30-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="pay" name="Pay through the app" />
    <bpmn:endEvent id="end-paid" name="Service completed" />
    <bpmn:task id="enter-problems" name="Enter the problems of your car for reference" />
    <bpmn:task id="enter-success" name="Enter that the repair was successful and you got your Pickerl" />
    <bpmn:task id="enter-next" name="Enter the time for your next service" />
    <bpmn:sequenceFlow id="f-svc-needed-check-reg" sourceRef="svc-needed" targetRef="check-reg" />
    <bpmn:sequenceFlow id="f-check-reg-reg-gw" sourceRef="check-reg" targetRef="reg-gw" />
    <bpmn:sequenceFlow id="f-reg-gw-notify" name="yes" sourceRef="reg-gw" targetRef="notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">registered = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reg-gw-end-not-registered" sourceRef="reg-gw" targetRef="end-not-registered" />
    <bpmn:sequenceFlow id="f-notify-go-service" sourceRef="notify" targetRef="go-service" />
    <bpmn:sequenceFlow id="f-timer-30-fine" sourceRef="timer-30" targetRef="fine" />
    <bpmn:sequenceFlow id="f-go-service-enter-problems" sourceRef="go-service" targetRef="enter-problems" />
    <bpmn:sequenceFlow id="f-enter-problems-status" sourceRef="enter-problems" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-pay" sourceRef="status" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-enter-success" sourceRef="pay" targetRef="enter-success" />
    <bpmn:sequenceFlow id="f-enter-success-enter-next" sourceRef="enter-success" targetRef="enter-next" />
    <bpmn:sequenceFlow id="f-enter-next-end-paid" sourceRef="enter-next" targetRef="end-paid" />
    <bpmn:sequenceFlow id="f-fine-end-fined" sourceRef="fine" targetRef="end-fined" />
  </bpmn:process>
</bpmn:definitions>
