<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Order" name="Order" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-side-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-parallel-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-burger-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:receiveTask id="receive-order" name="Receive order" messageRef="Message_Order" />
    <bpmn:task id="ask-menu" name="Ask menu or just burger" />
    <bpmn:exclusiveGateway id="gw-menu" name="Menu or just burger?" default="f-gw-menu-gw-burger-merge" />
    <bpmn:parallelGateway id="gw-parallel" name="Parallel" />
    <bpmn:task id="prepare-drink" name="Prepare drink" />
    <bpmn:task id="ask-side" name="Ask fries or wedges" />
    <bpmn:exclusiveGateway id="gw-side" name="Fries or wedges?" default="f-gw-side-prepare-wedges" />
    <bpmn:task id="prepare-fries" name="Prepare fries" />
    <bpmn:task id="prepare-wedges" name="Prepare wedges" />
    <bpmn:exclusiveGateway id="gw-side-join" name="Join side" />
    <bpmn:parallelGateway id="gw-parallel-join" name="Join parallel" />
    <bpmn:exclusiveGateway id="gw-burger-merge" name="Merge to burger" />
    <bpmn:task id="prepare-burger" name="Prepare burger" />
    <bpmn:task id="deliver" name="Deliver order" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-receive-order" sourceRef="start" targetRef="receive-order" />
    <bpmn:sequenceFlow id="f-receive-order-ask-menu" sourceRef="receive-order" targetRef="ask-menu" />
    <bpmn:sequenceFlow id="f-ask-menu-gw-menu" sourceRef="ask-menu" targetRef="gw-menu" />
    <bpmn:sequenceFlow id="f-gw-menu-gw-parallel" name="menu" sourceRef="gw-menu" targetRef="gw-parallel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-menu-gw-burger-merge" name="just burger" sourceRef="gw-menu" targetRef="gw-burger-merge" />
    <bpmn:sequenceFlow id="f-gw-parallel-prepare-drink" sourceRef="gw-parallel" targetRef="prepare-drink" />
    <bpmn:sequenceFlow id="f-gw-parallel-ask-side" sourceRef="gw-parallel" targetRef="ask-side" />
    <bpmn:sequenceFlow id="f-prepare-drink-gw-parallel-join" sourceRef="prepare-drink" targetRef="gw-parallel-join" />
    <bpmn:sequenceFlow id="f-ask-side-gw-side" sourceRef="ask-side" targetRef="gw-side" />
    <bpmn:sequenceFlow id="f-gw-side-prepare-fries" name="fries" sourceRef="gw-side" targetRef="prepare-fries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-side-prepare-wedges" name="wedges" sourceRef="gw-side" targetRef="prepare-wedges" />
    <bpmn:sequenceFlow id="f-gw-parallel-join-gw-burger-merge" sourceRef="gw-parallel-join" targetRef="gw-burger-merge" />
    <bpmn:sequenceFlow id="f-gw-side-join-gw-parallel-join" sourceRef="gw-side-join" targetRef="gw-parallel-join" />
    <bpmn:sequenceFlow id="f-prepare-fries-gw-side-join" sourceRef="prepare-fries" targetRef="gw-side-join" />
    <bpmn:sequenceFlow id="f-prepare-wedges-gw-side-join" sourceRef="prepare-wedges" targetRef="gw-side-join" />
    <bpmn:sequenceFlow id="f-gw-burger-merge-prepare-burger" sourceRef="gw-burger-merge" targetRef="prepare-burger" />
    <bpmn:sequenceFlow id="f-prepare-burger-deliver" sourceRef="prepare-burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-end" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
