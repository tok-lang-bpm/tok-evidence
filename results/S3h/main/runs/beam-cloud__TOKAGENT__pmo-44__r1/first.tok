tok 1.0 "Robotic Burger Seller near the University of Vienna"

pool seller "Robotic Burger Seller" {
  lane robot "Robot" {
    start start "Start"
    receive receive-order "Receive order" message="Order"
    task ask-menu "Ask menu or just burger"
    xor gw-menu "Menu or just burger?"
    and gw-parallel "Parallel"
    task prepare-drink "Prepare drink"
    task ask-side "Ask fries or wedges"
    xor gw-side "Fries or wedges?"
    task prepare-fries "Prepare fries"
    task prepare-wedges "Prepare wedges"
    xor gw-side-join "Join side"
    and gw-parallel-join "Join parallel"
    xor gw-burger-merge "Merge to burger"
    task prepare-burger "Prepare burger"
    task deliver "Deliver order"
    end end "End"
  }
}

flow start -> receive-order
flow receive-order -> ask-menu
flow ask-menu -> gw-menu
flow gw-menu -> gw-parallel "menu" when=""
flow gw-menu -> gw-burger-merge "just burger" default
flow gw-parallel -> prepare-drink
flow gw-parallel -> ask-side
flow prepare-drink -> gw-parallel-join
flow ask-side -> gw-side
flow gw-side -> prepare-fries "fries" when=""
flow gw-side -> prepare-wedges "wedges" default
flow prepare-fries -> gw-side-join
flow prepare-wedges -> gw-side-join
flow gw-side-join -> gw-parallel-join
flow gw-parallel-join -> gw-burger-merge
flow gw-burger-merge -> prepare-burger
flow prepare-burger -> deliver
flow deliver -> end
