<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Sports Institute" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete-registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-no-slots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>tell-courses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="gw-slots" name="Slots free?" default="f-gw-slots-end-no-slots" />
    <bpmn:task id="select-course" name="Select a course" />
    <bpmn:task id="check-account" name="Check if you already have an account" />
    <bpmn:exclusiveGateway id="gw-account" name="Already have an account?" default="f-gw-account-check-uni" />
    <bpmn:task id="check-uni" name="Check if registered at eligible university" />
    <bpmn:exclusiveGateway id="gw-uni" name="Registered at eligible university?" default="f-gw-uni-request-activation" />
    <bpmn:task id="register-account" name="Register your account" />
    <bpmn:task id="request-activation" name="Request an activation" />
    <bpmn:task id="wait-response" name="Wait for a response" />
    <bpmn:task id="log-in" name="Log into account" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete-registration" name="Complete registration for the course" />
    <bpmn:task id="provide-payment" name="Provide payment information" />
    <bpmn:task id="receive-ticket" name="Receive course ticket" />
    <bpmn:endEvent id="end-ok" name="Course ticket received" />
    <bpmn:endEvent id="end-no-slots" name="No slots available" />
    <bpmn:task id="tell-courses" name="Tell courses and dates" />
    <bpmn:sequenceFlow id="f-s-gw-slots" sourceRef="s" targetRef="gw-slots" />
    <bpmn:sequenceFlow id="f-gw-slots-tell-courses" name="Slots free" sourceRef="gw-slots" targetRef="tell-courses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">slotsFree = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-slots-end-no-slots" name="No slots" sourceRef="gw-slots" targetRef="end-no-slots" />
    <bpmn:sequenceFlow id="f-tell-courses-select-course" sourceRef="tell-courses" targetRef="select-course" />
    <bpmn:sequenceFlow id="f-select-course-check-account" sourceRef="select-course" targetRef="check-account" />
    <bpmn:sequenceFlow id="f-check-account-gw-account" sourceRef="check-account" targetRef="gw-account" />
    <bpmn:sequenceFlow id="f-gw-account-log-in" name="Yes" sourceRef="gw-account" targetRef="log-in">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasAccount = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-account-check-uni" name="No" sourceRef="gw-account" targetRef="check-uni" />
    <bpmn:sequenceFlow id="f-check-uni-gw-uni" sourceRef="check-uni" targetRef="gw-uni" />
    <bpmn:sequenceFlow id="f-gw-uni-register-account" name="Yes" sourceRef="gw-uni" targetRef="register-account">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">eligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-uni-request-activation" name="No" sourceRef="gw-uni" targetRef="request-activation" />
    <bpmn:sequenceFlow id="f-register-account-log-in" sourceRef="register-account" targetRef="log-in" />
    <bpmn:sequenceFlow id="f-request-activation-wait-response" sourceRef="request-activation" targetRef="wait-response" />
    <bpmn:sequenceFlow id="f-wait-response-log-in" sourceRef="wait-response" targetRef="log-in" />
    <bpmn:sequenceFlow id="f-log-in-tweet" sourceRef="log-in" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-complete-registration" sourceRef="tweet" targetRef="complete-registration" />
    <bpmn:sequenceFlow id="f-complete-registration-provide-payment" sourceRef="complete-registration" targetRef="provide-payment" />
    <bpmn:sequenceFlow id="f-provide-payment-receive-ticket" sourceRef="provide-payment" targetRef="receive-ticket" />
    <bpmn:sequenceFlow id="f-receive-ticket-end-ok" sourceRef="receive-ticket" targetRef="end-ok" />
  </bpmn:process>
</bpmn:definitions>
