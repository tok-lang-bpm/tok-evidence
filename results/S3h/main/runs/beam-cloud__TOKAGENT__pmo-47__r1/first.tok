tok 1.0 "New Application for Registering for an USI course"

pool "Sports Institute"
  lane applicant "Applicant"
    start s "Start"
    xor gw-slots "Slots free?"
    task select-course "Select a course"
    task check-account "Check if you already have an account"
    xor gw-account "Already have an account?"
    task check-uni "Check if registered at eligible university"
    xor gw-uni "Registered at eligible university?"
    task register-account "Register your account"
    task request-activation "Request an activation"
    task wait-response "Wait for a response"
    task log-in "Log into account"
    task tweet "Tweet to friends"
    task complete-registration "Complete registration for the course"
    task provide-payment "Provide payment information"
    task receive-ticket "Receive course ticket"
    end end-ok "Course ticket received"
    end end-no-slots "No slots available"
  lane system "System"
    task tell-courses "Tell courses and dates"

flow s -> gw-slots
flow gw-slots -> tell-courses "Slots free" when="slotsFree = true"
flow gw-slots -> end-no-slots "No slots" default
flow tell-courses -> select-course
flow select-course -> check-account
flow check-account -> gw-account
flow gw-account -> log-in "Yes" when="hasAccount = true"
flow gw-account -> check-uni "No" default
flow check-uni -> gw-uni
flow gw-uni -> register-account "Yes" when="eligible = true"
flow gw-uni -> request-activation "No" default
flow register-account -> log-in
flow request-activation -> wait-response
flow wait-response -> log-in
flow log-in -> tweet
flow tweet -> complete-registration
flow complete-registration -> provide-payment
flow provide-payment -> receive-ticket
flow receive-ticket -> end-ok

