<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="App For Participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Participant" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="participant" name="Participant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runnight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="select" name="Select starting block" />
    <bpmn:task id="run" name="Run for 5 km and measure the time" />
    <bpmn:exclusiveGateway id="g1" name="Can do it in less than 25 minutes?" default="f-g1-train" />
    <bpmn:task id="train" name="Train and check" />
    <bpmn:task id="number" name="Get starting number" />
    <bpmn:exclusiveGateway id="g2" name="More than one hour left between starting time and end of workday?" default="f-g2-work" />
    <bpmn:task id="home" name="Go there from home" />
    <bpmn:task id="work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="j1" name=" " />
    <bpmn:parallelGateway id="split" name="Run and drink at the same time" />
    <bpmn:task id="runnight" name="Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="join" name=" " />
    <bpmn:task id="final" name="Receive final running time" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-select" sourceRef="s" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-run" sourceRef="select" targetRef="run" />
    <bpmn:sequenceFlow id="f-run-g1" sourceRef="run" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-number" name="yes" sourceRef="g1" targetRef="number">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-train" name="no" sourceRef="g1" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-run" sourceRef="train" targetRef="run" />
    <bpmn:sequenceFlow id="f-number-g2" sourceRef="number" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-home" name="yes" sourceRef="g2" targetRef="home">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">left &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g2-work" name="no" sourceRef="g2" targetRef="work" />
    <bpmn:sequenceFlow id="f-home-j1" sourceRef="home" targetRef="j1" />
    <bpmn:sequenceFlow id="f-work-j1" sourceRef="work" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-split" sourceRef="j1" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-runnight" sourceRef="split" targetRef="runnight" />
    <bpmn:sequenceFlow id="f-split-drink" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-runnight-join" sourceRef="runnight" targetRef="join" />
    <bpmn:sequenceFlow id="f-drink-join" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-final" sourceRef="join" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-e" sourceRef="final" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
