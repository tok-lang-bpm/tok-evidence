tok 1.0 "App For Participating at the Vienna Night Run"

pool p "Participant"
  lane participant "Participant"
    start s "Start"
    task select "Select starting block"
    task run "Run for 5 km and measure the time"
    xor g1 "Can do it in less than 25 minutes?"
    task train "Train and check"
    task number "Get starting number"
    xor g2 "More than one hour left between starting time and end of workday?"
    task home "Go there from home"
    task work "Leave directly from work"
    and split "Run and drink at the same time"
    task runnight "Run"
    task drink "Drink"
    and join " "
    task final "Receive final running time"
    end e "End"

flow s -> select
flow select -> run
flow run -> g1
flow g1 -> number "yes" when="time < 25"
flow g1 -> train "no" default
flow train -> run
flow number -> g2
flow g2 -> home "yes" when="left > 1"
flow g2 -> work "no" default
flow home -> split
flow work -> split
flow split -> runnight
flow split -> drink
flow runnight -> join
flow drink -> join
flow join -> final
flow final -> e