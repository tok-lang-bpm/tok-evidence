<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Central venous catheterization" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Central venous catheterization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_implements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash_hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean_puncture_area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape_puncture_zone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure_ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_gel_in_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vein_identification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_by_anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_by_doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_by_compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vein_identification_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wire_long</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wire_short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_check_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen_pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify_flow_reflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_catheter_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="prepare_implements" name="Prepare implements" />
    <bpmn:task id="wash_hands" name="Wash hands" />
    <bpmn:task id="get_sterile_clothes" name="Get in sterile clothes" />
    <bpmn:task id="clean_puncture_area" name="Clean puncture area" />
    <bpmn:task id="drape_puncture_zone" name="Drape puncture zone" />
    <bpmn:task id="configure_ultrasound" name="Configure ultrasound" />
    <bpmn:task id="put_gel_in_probe" name="Put gel in probe" />
    <bpmn:task id="cover_probe" name="Cover probe" />
    <bpmn:task id="put_sterile_gel" name="Put sterile gel" />
    <bpmn:task id="position_probe" name="Position probe" />
    <bpmn:task id="position_patient" name="Position patient" />
    <bpmn:exclusiveGateway id="vein_identification" name="How is the vein identified?" />
    <bpmn:task id="identify_by_anatomic" name="Identify vein by anatomic identification" />
    <bpmn:task id="identify_by_doppler" name="Identify vein by Doppler identification" />
    <bpmn:task id="identify_by_compression" name="Identify vein by compression identification" />
    <bpmn:exclusiveGateway id="vein_identification_join" name="Vein identified" />
    <bpmn:task id="anesthetize_patient" name="Anesthetize patient" />
    <bpmn:task id="puncture_patient" name="Puncture patient" />
    <bpmn:task id="check_blood_return" name="Check blood return" />
    <bpmn:exclusiveGateway id="blood_return" name="Is blood return correct?" default="f-blood_return-puncture_patient" />
    <bpmn:task id="drop_probe" name="Drop probe" />
    <bpmn:task id="remove_syringe" name="Remove syringe" />
    <bpmn:task id="install_guidewire" name="Install guidewire" />
    <bpmn:task id="remove_trocar" name="Remove trocar" />
    <bpmn:exclusiveGateway id="wire_check" name="How is the wire checked?" />
    <bpmn:task id="check_wire_long" name="Check wire in long axis" />
    <bpmn:task id="check_wire_short" name="Check wire in short axis" />
    <bpmn:exclusiveGateway id="wire_check_join" name="Wire checked" />
    <bpmn:task id="check_wire_position" name="Check if wire is in good position" />
    <bpmn:exclusiveGateway id="wire_position" name="Is wire in good position?" default="f-wire_position-puncture_patient" />
    <bpmn:task id="widen_pathway" name="Widen pathway" />
    <bpmn:task id="advance_catheter" name="Advance catheter" />
    <bpmn:task id="remove_guidewire" name="Remove guidewire" />
    <bpmn:task id="verify_flow_reflow" name="Verify flow and reflow" />
    <bpmn:task id="check_catheter_position" name="Check catheter position" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-prepare_implements" sourceRef="start" targetRef="prepare_implements" />
    <bpmn:sequenceFlow id="f-prepare_implements-wash_hands" sourceRef="prepare_implements" targetRef="wash_hands" />
    <bpmn:sequenceFlow id="f-wash_hands-get_sterile_clothes" sourceRef="wash_hands" targetRef="get_sterile_clothes" />
    <bpmn:sequenceFlow id="f-get_sterile_clothes-clean_puncture_area" sourceRef="get_sterile_clothes" targetRef="clean_puncture_area" />
    <bpmn:sequenceFlow id="f-clean_puncture_area-drape_puncture_zone" sourceRef="clean_puncture_area" targetRef="drape_puncture_zone" />
    <bpmn:sequenceFlow id="f-drape_puncture_zone-configure_ultrasound" sourceRef="drape_puncture_zone" targetRef="configure_ultrasound" />
    <bpmn:sequenceFlow id="f-configure_ultrasound-put_gel_in_probe" sourceRef="configure_ultrasound" targetRef="put_gel_in_probe" />
    <bpmn:sequenceFlow id="f-put_gel_in_probe-cover_probe" sourceRef="put_gel_in_probe" targetRef="cover_probe" />
    <bpmn:sequenceFlow id="f-cover_probe-put_sterile_gel" sourceRef="cover_probe" targetRef="put_sterile_gel" />
    <bpmn:sequenceFlow id="f-put_sterile_gel-position_probe" sourceRef="put_sterile_gel" targetRef="position_probe" />
    <bpmn:sequenceFlow id="f-position_probe-position_patient" sourceRef="position_probe" targetRef="position_patient" />
    <bpmn:sequenceFlow id="f-position_patient-vein_identification" sourceRef="position_patient" targetRef="vein_identification" />
    <bpmn:sequenceFlow id="f-vein_identification-identify_by_anatomic" name="Anatomic identification" sourceRef="vein_identification" targetRef="identify_by_anatomic" />
    <bpmn:sequenceFlow id="f-vein_identification-identify_by_doppler" name="Doppler identification" sourceRef="vein_identification" targetRef="identify_by_doppler" />
    <bpmn:sequenceFlow id="f-vein_identification-identify_by_compression" name="Compression identification" sourceRef="vein_identification" targetRef="identify_by_compression" />
    <bpmn:sequenceFlow id="f-identify_by_anatomic-vein_identification_join" sourceRef="identify_by_anatomic" targetRef="vein_identification_join" />
    <bpmn:sequenceFlow id="f-identify_by_doppler-vein_identification_join" sourceRef="identify_by_doppler" targetRef="vein_identification_join" />
    <bpmn:sequenceFlow id="f-identify_by_compression-vein_identification_join" sourceRef="identify_by_compression" targetRef="vein_identification_join" />
    <bpmn:sequenceFlow id="f-vein_identification_join-anesthetize_patient" sourceRef="vein_identification_join" targetRef="anesthetize_patient" />
    <bpmn:sequenceFlow id="f-anesthetize_patient-puncture_patient" sourceRef="anesthetize_patient" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f-puncture_patient-check_blood_return" sourceRef="puncture_patient" targetRef="check_blood_return" />
    <bpmn:sequenceFlow id="f-check_blood_return-blood_return" sourceRef="check_blood_return" targetRef="blood_return" />
    <bpmn:sequenceFlow id="f-blood_return-drop_probe" name="Blood return correct" sourceRef="blood_return" targetRef="drop_probe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bloodReturn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-blood_return-puncture_patient" name="Blood return not correct" sourceRef="blood_return" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f-drop_probe-remove_syringe" sourceRef="drop_probe" targetRef="remove_syringe" />
    <bpmn:sequenceFlow id="f-remove_syringe-install_guidewire" sourceRef="remove_syringe" targetRef="install_guidewire" />
    <bpmn:sequenceFlow id="f-install_guidewire-remove_trocar" sourceRef="install_guidewire" targetRef="remove_trocar" />
    <bpmn:sequenceFlow id="f-remove_trocar-wire_check" sourceRef="remove_trocar" targetRef="wire_check" />
    <bpmn:sequenceFlow id="f-wire_check-check_wire_long" name="Check of wire in long axis" sourceRef="wire_check" targetRef="check_wire_long">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wire_check-check_wire_short" name="Check of wire in short axis" sourceRef="wire_check" targetRef="check_wire_short">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-check_wire_long-wire_check_join" sourceRef="check_wire_long" targetRef="wire_check_join" />
    <bpmn:sequenceFlow id="f-check_wire_short-wire_check_join" sourceRef="check_wire_short" targetRef="wire_check_join" />
    <bpmn:sequenceFlow id="f-wire_check_join-check_wire_position" sourceRef="wire_check_join" targetRef="check_wire_position" />
    <bpmn:sequenceFlow id="f-check_wire_position-wire_position" sourceRef="check_wire_position" targetRef="wire_position" />
    <bpmn:sequenceFlow id="f-wire_position-widen_pathway" name="Wire in good position" sourceRef="wire_position" targetRef="widen_pathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wireInGoodPosition = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wire_position-puncture_patient" name="Wire not in good position" sourceRef="wire_position" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f-widen_pathway-advance_catheter" sourceRef="widen_pathway" targetRef="advance_catheter" />
    <bpmn:sequenceFlow id="f-advance_catheter-remove_guidewire" sourceRef="advance_catheter" targetRef="remove_guidewire" />
    <bpmn:sequenceFlow id="f-remove_guidewire-verify_flow_reflow" sourceRef="remove_guidewire" targetRef="verify_flow_reflow" />
    <bpmn:sequenceFlow id="f-verify_flow_reflow-check_catheter_position" sourceRef="verify_flow_reflow" targetRef="check_catheter_position" />
    <bpmn:sequenceFlow id="f-check_catheter_position-end" sourceRef="check_catheter_position" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
