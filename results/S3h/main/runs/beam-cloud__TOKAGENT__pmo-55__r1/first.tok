tok 1.0 "Central venous catheterization"
pool org "Organisation"
  lane doctor "Doctor"
    start start "Start"
    task prepare_implements "Prepare implements"
    task wash_hands "Wash hands"
    task get_sterile_clothes "Get in sterile clothes"
    task clean_puncture_area "Clean puncture area"
    task drape_puncture_zone "Drape puncture zone"
    task configure_ultrasound "Configure ultrasound"
    task put_gel_in_probe "Put gel in probe"
    task cover_probe "Cover probe"
    task put_sterile_gel "Put sterile gel"
    task position_probe "Position probe"
    task position_patient "Position patient"
    xor vein_identification "How is the vein identified?"
    task identify_by_anatomic "Identify vein by anatomic identification"
    task identify_by_doppler "Identify vein by Doppler identification"
    task identify_by_compression "Identify vein by compression identification"
    xor vein_identification_join "Vein identified"
    task anesthetize_patient "Anesthetize patient"
    task puncture_patient "Puncture patient"
    task check_blood_return "Check blood return"
    xor blood_return "Is blood return correct?"
    task drop_probe "Drop probe"
    task remove_syringe "Remove syringe"
    task install_guidewire "Install guidewire"
    task remove_trocar "Remove trocar"
    xor wire_check "How is the wire checked?"
    task check_wire_long "Check wire in long axis"
    task check_wire_short "Check wire in short axis"
    xor wire_check_join "Wire checked"
    task check_wire_position "Check if wire is in good position"
    xor wire_position "Is wire in good position?"
    task widen_pathway "Widen pathway"
    task advance_catheter "Advance catheter"
    task remove_guidewire "Remove guidewire"
    task verify_flow_reflow "Verify flow and reflow"
    task check_catheter_position "Check catheter position"
    end end "End"

flow start -> prepare_implements
flow prepare_implements -> wash_hands
flow wash_hands -> get_sterile_clothes
flow get_sterile_clothes -> clean_puncture_area
flow clean_puncture_area -> drape_puncture_zone
flow drape_puncture_zone -> configure_ultrasound
flow configure_ultrasound -> put_gel_in_probe
flow put_gel_in_probe -> cover_probe
flow cover_probe -> put_sterile_gel
flow put_sterile_gel -> position_probe
flow position_probe -> position_patient
flow position_patient -> vein_identification
flow vein_identification -> identify_by_anatomic "Anatomic identification"
flow vein_identification -> identify_by_doppler "Doppler identification"
flow vein_identification -> identify_by_compression "Compression identification"
flow identify_by_anatomic -> vein_identification_join
flow identify_by_doppler -> vein_identification_join
flow identify_by_compression -> vein_identification_join
flow vein_identification_join -> anesthetize_patient
flow anesthetize_patient -> puncture_patient
flow puncture_patient -> check_blood_return
flow check_blood_return -> blood_return
flow blood_return -> drop_probe "Blood return correct" when="bloodReturn = true"
flow blood_return -> puncture_patient "Blood return not correct" default
flow drop_probe -> remove_syringe
flow remove_syringe -> install_guidewire
flow install_guidewire -> remove_trocar
flow remove_trocar -> wire_check
flow wire_check -> check_wire_long "Check of wire in long axis" when=""
flow wire_check -> check_wire_short "Check of wire in short axis" when=""
flow check_wire_long -> wire_check_join
flow check_wire_short -> wire_check_join
flow wire_check_join -> check_wire_position
flow check_wire_position -> wire_position
flow wire_position -> widen_pathway "Wire in good position" when="wireInGoodPosition = true"
flow wire_position -> puncture_patient "Wire not in good position" default
flow widen_pathway -> advance_catheter
flow advance_catheter -> remove_guidewire
flow remove_guidewire -> verify_flow_reflow
flow verify_flow_reflow -> check_catheter_position
flow check_catheter_position -> end