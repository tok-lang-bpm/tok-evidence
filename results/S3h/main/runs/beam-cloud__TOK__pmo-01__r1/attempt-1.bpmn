<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customer inquiry to order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Customer inquiry to order" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales staff or customer support">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representative" name="Sales representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Potential customer inquires about a product or service" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="approve" name="Approve quote" />
    <bpmn:task id="place" name="Place order" />
    <bpmn:task id="receive" name="Receive order confirmation" />
    <bpmn:endEvent id="confirmed" name="Order successfully placed and confirmed" />
    <bpmn:endEvent id="declined" name="Customer not interested" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="address" name="Address concerns or questions" />
    <bpmn:task id="guide" name="Guide through selecting appropriate product or service" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:task id="record" name="Record order in system" />
    <bpmn:sequenceFlow id="f-inquiry-collect" sourceRef="inquiry" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-address" sourceRef="collect" targetRef="address" />
    <bpmn:sequenceFlow id="f-address-interested" sourceRef="address" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-guide" name="yes" sourceRef="interested" targetRef="guide" />
    <bpmn:sequenceFlow id="f-interested-declined" name="no" sourceRef="interested" targetRef="declined" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approve" sourceRef="quote" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-place" sourceRef="approve" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-record" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-receive" sourceRef="record" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-confirmed" sourceRef="receive" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
