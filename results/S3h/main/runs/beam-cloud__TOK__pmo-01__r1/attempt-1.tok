tok 1.0 "Customer inquiry to order"

pool organisation "Organisation"
  lane customer "Customer"
    start inquiry "Potential customer inquires about a product or service"
    xor interested "Customer interested?"
    task approve "Approve quote"
    task place "Place order"
    task receive "Receive order confirmation"
    end confirmed "Order successfully placed and confirmed"
    end declined "Customer not interested"
  lane sales "Sales staff or customer support"
    task collect "Collect relevant information"
    task address "Address concerns or questions"
    task guide "Guide through selecting appropriate product or service"
  lane representative "Sales representative"
    task quote "Provide a quote"
  lane system "System"
    task record "Record order in system"

flow inquiry -> collect -> address -> interested
flow interested -> guide "yes"
flow interested -> declined "no"
flow guide -> quote
flow quote -> approve
flow approve -> place
flow place -> record
flow record -> receive
flow receive -> confirmed
