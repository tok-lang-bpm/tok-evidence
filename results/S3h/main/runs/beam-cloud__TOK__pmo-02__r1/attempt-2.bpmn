<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Recruitment and onboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Recruitment and onboarding" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite_v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Need for new hire identified" />
    <bpmn:task id="create" name="Create job description" />
    <bpmn:task id="post" name="Post job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interviews" />
    <bpmn:task id="select" name="Select candidates" />
    <bpmn:exclusiveGateway id="pref" name="Interview type?" default="f-pref-invite_v" />
    <bpmn:task id="invite_in" name="Invite selected candidates for in-person interviews" />
    <bpmn:task id="invite_v" name="Invite selected candidates for virtual interviews" />
    <bpmn:exclusiveGateway id="interviewed" name="Interviews completed?" />
    <bpmn:task id="choose" name="Choose candidate" />
    <bpmn:task id="extend" name="Extend offer" />
    <bpmn:exclusiveGateway id="neg" name="Salary negotiations?" default="f-neg-neg_done" />
    <bpmn:task id="negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="neg_done" name="Salary negotiations completed?" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Conduct orientation" />
    <bpmn:task id="training" name="Complete training" />
    <bpmn:task id="integrate" name="Integrate new hire into team" />
    <bpmn:endEvent id="integrated" name="New hire integrated" />
    <bpmn:sequenceFlow id="f-needed-create" sourceRef="needed" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-post" sourceRef="create" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-select" sourceRef="phone" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-pref" sourceRef="select" targetRef="pref" />
    <bpmn:sequenceFlow id="f-pref-invite_in" name="In-person" sourceRef="pref" targetRef="invite_in">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">inPerson</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pref-invite_v" name="Virtual" sourceRef="pref" targetRef="invite_v" />
    <bpmn:sequenceFlow id="f-invite_in-interviewed" sourceRef="invite_in" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-invite_v-interviewed" sourceRef="invite_v" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-interviewed-choose" sourceRef="interviewed" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-extend" sourceRef="choose" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-neg" sourceRef="extend" targetRef="neg" />
    <bpmn:sequenceFlow id="f-neg-negotiate" name="Yes" sourceRef="neg" targetRef="negotiate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">negotiate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-neg-neg_done" name="No" sourceRef="neg" targetRef="neg_done" />
    <bpmn:sequenceFlow id="f-negotiate-neg_done" sourceRef="negotiate" targetRef="neg_done" />
    <bpmn:sequenceFlow id="f-neg_done-paperwork" sourceRef="neg_done" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-paperwork-orientation" sourceRef="paperwork" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-orientation-training" sourceRef="orientation" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-integrate" sourceRef="training" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-integrated" sourceRef="integrate" targetRef="integrated" />
  </bpmn:process>
</bpmn:definitions>
