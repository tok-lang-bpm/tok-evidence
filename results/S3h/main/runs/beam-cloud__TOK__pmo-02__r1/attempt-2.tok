tok 1.0 "Recruitment and onboarding"

pool org "Organisation"
  lane department "Department"
    start needed "Need for new hire identified"
  lane hr "HR"
    task create "Create job description"
    task post "Post job description on job boards"
    task collect "Collect resumes"
    task screen "Screen resumes"
    task phone "Conduct initial phone interviews"
    task select "Select candidates"
    xor pref "Interview type?"
    task invite_in "Invite selected candidates for in-person interviews"
    task invite_v "Invite selected candidates for virtual interviews"
    xor interviewed "Interviews completed?"
    task choose "Choose candidate"
    task extend "Extend offer"
    xor neg "Salary negotiations?"
    task negotiate "Negotiate salary"
    xor neg_done "Salary negotiations completed?"
    task paperwork "Complete paperwork"
    task orientation "Conduct orientation"
    task training "Complete training"
    task integrate "Integrate new hire into team"
    end integrated "New hire integrated"

flow needed -> create -> post -> collect -> screen -> phone -> select -> pref
flow pref -> invite_in "In-person" when="inPerson"
flow pref -> invite_v "Virtual" default
flow invite_in -> interviewed
flow invite_v -> interviewed
flow interviewed -> choose -> extend -> neg
flow neg -> negotiate "Yes" when="negotiate"
flow neg -> neg_done "No" default
flow negotiate -> neg_done
flow neg_done -> paperwork -> orientation -> training -> integrate -> integrated
