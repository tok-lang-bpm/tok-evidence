<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inventory restocking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Inventory restocking" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="warehouse" name="Warehouse or store">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeStorage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeSignal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeStorage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory system">
        <bpmn:flowNodeRef>auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateLevels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="signal" name="Signal need to reorder?" />
    <bpmn:task id="manual" name="Perform manual check" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="shelves" name="Place stock on shelves" />
    <bpmn:task id="storeStorage" name="Place stock in storage" />
    <bpmn:exclusiveGateway id="mergeSignal" />
    <bpmn:exclusiveGateway id="storage" name="Storage location?" />
    <bpmn:exclusiveGateway id="mergeStorage" />
    <bpmn:task id="order" name="Place order with suppliers" />
    <bpmn:task id="auto" name="Trigger automated alert" />
    <bpmn:task id="updateDates" name="Update system with expected delivery dates" />
    <bpmn:task id="record" name="Record stock in system" />
    <bpmn:task id="updateLevels" name="Update inventory levels" />
    <bpmn:endEvent id="e" name="Inventory levels updated" />
    <bpmn:sequenceFlow id="f-s-monitor" sourceRef="s" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-signal" sourceRef="monitor" targetRef="signal" />
    <bpmn:sequenceFlow id="f-signal-manual" name="manual check" sourceRef="signal" targetRef="manual" />
    <bpmn:sequenceFlow id="f-signal-auto" name="automated alert" sourceRef="signal" targetRef="auto" />
    <bpmn:sequenceFlow id="f-manual-mergeSignal" sourceRef="manual" targetRef="mergeSignal" />
    <bpmn:sequenceFlow id="f-auto-mergeSignal" sourceRef="auto" targetRef="mergeSignal" />
    <bpmn:sequenceFlow id="f-mergeSignal-order" sourceRef="mergeSignal" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-updateDates" sourceRef="order" targetRef="updateDates" />
    <bpmn:sequenceFlow id="f-updateDates-receive" sourceRef="updateDates" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-storage" sourceRef="record" targetRef="storage" />
    <bpmn:sequenceFlow id="f-storage-shelves" name="on shelves" sourceRef="storage" targetRef="shelves" />
    <bpmn:sequenceFlow id="f-storage-storeStorage" name="in storage" sourceRef="storage" targetRef="storeStorage" />
    <bpmn:sequenceFlow id="f-shelves-mergeStorage" sourceRef="shelves" targetRef="mergeStorage" />
    <bpmn:sequenceFlow id="f-storeStorage-mergeStorage" sourceRef="storeStorage" targetRef="mergeStorage" />
    <bpmn:sequenceFlow id="f-mergeStorage-updateLevels" sourceRef="mergeStorage" targetRef="updateLevels" />
    <bpmn:sequenceFlow id="f-updateLevels-e" sourceRef="updateLevels" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
