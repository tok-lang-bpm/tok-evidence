<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing campaign process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Marketing campaign process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>follow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Campaign needed" />
    <bpmn:task id="define" name="Define objectives" />
    <bpmn:task id="create" name="Create content" />
    <bpmn:task id="design" name="Design visuals" />
    <bpmn:task id="select" name="Select channels" />
    <bpmn:task id="launch" name="Launch campaign" />
    <bpmn:task id="track" name="Track performance" />
    <bpmn:task id="analyze" name="Analyze performance" />
    <bpmn:endEvent id="done" name="Campaign completed" />
    <bpmn:task id="collect" name="Collect leads" />
    <bpmn:task id="follow" name="Follow up" />
    <bpmn:sequenceFlow id="f-needed-define" sourceRef="needed" targetRef="define" />
    <bpmn:sequenceFlow id="f-define-create" sourceRef="define" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-design" sourceRef="create" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-select" sourceRef="design" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-launch" sourceRef="select" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-track" sourceRef="launch" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-collect" sourceRef="track" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-follow" sourceRef="collect" targetRef="follow" />
    <bpmn:sequenceFlow id="f-follow-analyze" sourceRef="follow" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-done" sourceRef="analyze" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
