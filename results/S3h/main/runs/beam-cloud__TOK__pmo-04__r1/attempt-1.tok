tok 1.0 "Marketing campaign process"

pool organisation "Organisation"
  lane marketing "Marketing team"
    start needed "Campaign needed"
    task define "Define objectives"
    task create "Create content"
    task design "Design visuals"
    task select "Select channels"
    task launch "Launch campaign"
    task track "Track performance"
    task analyze "Analyze performance"
    end done "Campaign completed"
  lane crm "CRM system"
    task collect "Collect leads"
  lane sales "Sales team"
    task follow "Follow up"

flow needed -> define -> create -> design -> select -> launch -> track -> collect -> follow -> analyze -> done
