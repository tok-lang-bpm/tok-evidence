<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier procurement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Supplier procurement" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sitevisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify need for new supplier or vendor" />
    <bpmn:task id="issue" name="Issue a request for proposals" />
    <bpmn:task id="receive" name="Receive responses from suppliers" />
    <bpmn:task id="evaluate" name="Evaluate each proposal" />
    <bpmn:exclusiveGateway id="visit" name="Conduct site visits or interviews?" default="f-visit-select" />
    <bpmn:task id="sitevisits" name="Conduct site visits or interviews" />
    <bpmn:task id="select" name="Select supplier" />
    <bpmn:task id="negotiate" name="Begin contract negotiations" />
    <bpmn:task id="agree" name="Agree on contract terms" />
    <bpmn:task id="sign" name="Sign contract" />
    <bpmn:parallelGateway id="split" name="Complete onboarding and execution" />
    <bpmn:task id="onboard" name="Onboard supplier" />
    <bpmn:task id="execute" name="Execute contract" />
    <bpmn:parallelGateway id="join" name="Onboarding and execution completed" />
    <bpmn:endEvent id="end" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f-start-identify" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-issue" sourceRef="identify" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-receive" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-visit" sourceRef="evaluate" targetRef="visit" />
    <bpmn:sequenceFlow id="f-visit-sitevisits" name="Yes" sourceRef="visit" targetRef="sitevisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">conductSiteVisits</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-visit-select" name="No" sourceRef="visit" targetRef="select" />
    <bpmn:sequenceFlow id="f-sitevisits-select" sourceRef="sitevisits" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agree" sourceRef="negotiate" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-sign" sourceRef="agree" targetRef="sign" />
    <bpmn:sequenceFlow id="f-sign-split" sourceRef="sign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-onboard" sourceRef="split" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-split-execute" sourceRef="split" targetRef="execute" />
    <bpmn:sequenceFlow id="f-onboard-join" sourceRef="onboard" targetRef="join" />
    <bpmn:sequenceFlow id="f-execute-join" sourceRef="execute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-end" sourceRef="join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
