tok 1.0 "Supplier procurement"

pool organisation "Organisation"
  lane company "Company"
    start start "Start"
    task identify "Identify need for new supplier or vendor"
  lane procurement "Procurement team"
    task issue "Issue a request for proposals"
    task receive "Receive responses from suppliers"
    task evaluate "Evaluate each proposal"
    xor visit "Conduct site visits or interviews?"
    task sitevisits "Conduct site visits or interviews"
    task select "Select supplier"
    task negotiate "Begin contract negotiations"
    task agree "Agree on contract terms"
    task sign "Sign contract"
    and split "Complete onboarding and execution"
    task onboard "Onboard supplier"
    task execute "Execute contract"
    and join "Onboarding and execution completed"
    end end "Supplier onboarded and contract executed"

flow start -> identify -> issue -> receive -> evaluate -> visit
flow visit -> sitevisits "Yes" when="conductSiteVisits"
flow visit -> select "No" default
flow sitevisits -> select
flow select -> negotiate -> agree -> sign -> split
flow split -> onboard
flow split -> execute
flow onboard -> join
flow execute -> join
flow join -> end
