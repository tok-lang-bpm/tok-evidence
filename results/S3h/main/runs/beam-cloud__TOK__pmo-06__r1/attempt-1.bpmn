<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order fulfilment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order_placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tracking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_over</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>monitor_shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order_placed" name="Order placed" />
    <bpmn:task id="place_order" name="Place order" />
    <bpmn:task id="generate_confirmation" name="Generate order confirmation" />
    <bpmn:task id="send_confirmation" name="Send order confirmation" />
    <bpmn:task id="generate_label" name="Generate shipping label" />
    <bpmn:task id="send_tracking" name="Send tracking information" />
    <bpmn:parallelGateway id="prepare" name="Prepare order" />
    <bpmn:task id="pick_items" name="Pick items" />
    <bpmn:task id="pack_items" name="Pack items" />
    <bpmn:parallelGateway id="prepared" name="Order prepared" />
    <bpmn:task id="hand_over" name="Hand over order to logistics provider" />
    <bpmn:task id="monitor_shipment" name="Monitor shipment" />
    <bpmn:task id="deliver_order" name="Deliver order" />
    <bpmn:endEvent id="order_delivered" name="Order delivered" />
    <bpmn:sequenceFlow id="f-order_placed-place_order" sourceRef="order_placed" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-generate_confirmation" sourceRef="place_order" targetRef="generate_confirmation" />
    <bpmn:sequenceFlow id="f-generate_confirmation-send_confirmation" sourceRef="generate_confirmation" targetRef="send_confirmation" />
    <bpmn:sequenceFlow id="f-send_confirmation-prepare" sourceRef="send_confirmation" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-pick_items" sourceRef="prepare" targetRef="pick_items" />
    <bpmn:sequenceFlow id="f-prepare-generate_label" sourceRef="prepare" targetRef="generate_label" />
    <bpmn:sequenceFlow id="f-pick_items-pack_items" sourceRef="pick_items" targetRef="pack_items" />
    <bpmn:sequenceFlow id="f-pack_items-prepared" sourceRef="pack_items" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-generate_label-prepared" sourceRef="generate_label" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prepared-hand_over" sourceRef="prepared" targetRef="hand_over" />
    <bpmn:sequenceFlow id="f-hand_over-send_tracking" sourceRef="hand_over" targetRef="send_tracking" />
    <bpmn:sequenceFlow id="f-send_tracking-monitor_shipment" sourceRef="send_tracking" targetRef="monitor_shipment" />
    <bpmn:sequenceFlow id="f-monitor_shipment-deliver_order" sourceRef="monitor_shipment" targetRef="deliver_order" />
    <bpmn:sequenceFlow id="f-deliver_order-order_delivered" sourceRef="deliver_order" targetRef="order_delivered" />
  </bpmn:process>
</bpmn:definitions>
