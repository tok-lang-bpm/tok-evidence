<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ticket booking process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="travel" name="Travel company" processRef="travel-process" />
  </bpmn:collaboration>
  <bpmn:process id="travel-process" name="Travel booking" isExecutable="false">
    <bpmn:laneSet id="travel-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start_booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_personal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_reminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruction_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_checkin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_boarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_travel_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>use_services</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_extended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="booking" name="Booking system">
        <bpmn:flowNodeRef>generate_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Travel company">
        <bpmn:flowNodeRef>update_inventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_booking" name="Booking started" />
    <bpmn:task id="search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="select" name="Select route, date, and time" />
    <bpmn:task id="provide_personal" name="Provide personal information" />
    <bpmn:task id="provide_payment" name="Provide payment details" />
    <bpmn:exclusiveGateway id="reminders" name="Receive reminders?" default="f-reminders-instructions" />
    <bpmn:task id="receive_reminders" name="Receive reminders" />
    <bpmn:exclusiveGateway id="instructions" name="Receive instructions?" default="f-instructions-complete_journey" />
    <bpmn:exclusiveGateway id="instruction_type" name="Check-in or boarding?" default="f-instruction_type-receive_boarding" />
    <bpmn:task id="receive_checkin" name="Receive check-in instructions" />
    <bpmn:task id="receive_boarding" name="Receive boarding instructions" />
    <bpmn:exclusiveGateway id="instructions_join" name="Instructions handled" />
    <bpmn:task id="complete_journey" name="Complete journey" />
    <bpmn:exclusiveGateway id="post_travel" name="Post-travel feedback or services?" default="f-post_travel-end_journey" />
    <bpmn:exclusiveGateway id="post_travel_type" name="Feedback or services?" default="f-post_travel_type-use_services" />
    <bpmn:task id="provide_feedback" name="Provide feedback" />
    <bpmn:task id="use_services" name="Use post-travel services" />
    <bpmn:endEvent id="end_journey" name="Journey completed" />
    <bpmn:endEvent id="end_extended" name="Post-travel completed" />
    <bpmn:task id="generate_ticket" name="Generate ticket" />
    <bpmn:exclusiveGateway id="delivery_type" name="Email or SMS?" default="f-delivery_type-send_sms" />
    <bpmn:task id="send_email" name="Send ticket by email" />
    <bpmn:task id="send_sms" name="Send ticket by SMS" />
    <bpmn:exclusiveGateway id="delivery_join" name="Ticket delivered" />
    <bpmn:parallelGateway id="ticket_split" name="Split ticket processing" />
    <bpmn:parallelGateway id="ticket_join" name="Join ticket processing" />
    <bpmn:task id="update_inventory" name="Update seat inventory" />
    <bpmn:sequenceFlow id="f-start_booking-search" sourceRef="start_booking" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-select" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-provide_personal" sourceRef="select" targetRef="provide_personal" />
    <bpmn:sequenceFlow id="f-provide_personal-provide_payment" sourceRef="provide_personal" targetRef="provide_payment" />
    <bpmn:sequenceFlow id="f-provide_payment-generate_ticket" sourceRef="provide_payment" targetRef="generate_ticket" />
    <bpmn:sequenceFlow id="f-generate_ticket-ticket_split" sourceRef="generate_ticket" targetRef="ticket_split" />
    <bpmn:sequenceFlow id="f-ticket_split-delivery_type" sourceRef="ticket_split" targetRef="delivery_type" />
    <bpmn:sequenceFlow id="f-ticket_split-update_inventory" sourceRef="ticket_split" targetRef="update_inventory" />
    <bpmn:sequenceFlow id="f-delivery_type-send_email" name="Email" sourceRef="delivery_type" targetRef="send_email" />
    <bpmn:sequenceFlow id="f-delivery_type-send_sms" name="SMS" sourceRef="delivery_type" targetRef="send_sms" />
    <bpmn:sequenceFlow id="f-send_email-delivery_join" sourceRef="send_email" targetRef="delivery_join" />
    <bpmn:sequenceFlow id="f-send_sms-delivery_join" sourceRef="send_sms" targetRef="delivery_join" />
    <bpmn:sequenceFlow id="f-delivery_join-ticket_join" sourceRef="delivery_join" targetRef="ticket_join" />
    <bpmn:sequenceFlow id="f-update_inventory-ticket_join" sourceRef="update_inventory" targetRef="ticket_join" />
    <bpmn:sequenceFlow id="f-ticket_join-reminders" sourceRef="ticket_join" targetRef="reminders" />
    <bpmn:sequenceFlow id="f-reminders-receive_reminders" name="Yes" sourceRef="reminders" targetRef="receive_reminders" />
    <bpmn:sequenceFlow id="f-reminders-instructions" name="No" sourceRef="reminders" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-receive_reminders-instructions" sourceRef="receive_reminders" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-instructions-instruction_type" name="Yes" sourceRef="instructions" targetRef="instruction_type" />
    <bpmn:sequenceFlow id="f-instructions-complete_journey" name="No" sourceRef="instructions" targetRef="complete_journey" />
    <bpmn:sequenceFlow id="f-instruction_type-receive_checkin" name="Check-in" sourceRef="instruction_type" targetRef="receive_checkin" />
    <bpmn:sequenceFlow id="f-instruction_type-receive_boarding" name="Boarding" sourceRef="instruction_type" targetRef="receive_boarding" />
    <bpmn:sequenceFlow id="f-receive_checkin-instructions_join" sourceRef="receive_checkin" targetRef="instructions_join" />
    <bpmn:sequenceFlow id="f-receive_boarding-instructions_join" sourceRef="receive_boarding" targetRef="instructions_join" />
    <bpmn:sequenceFlow id="f-instructions_join-complete_journey" sourceRef="instructions_join" targetRef="complete_journey" />
    <bpmn:sequenceFlow id="f-complete_journey-post_travel" sourceRef="complete_journey" targetRef="post_travel" />
    <bpmn:sequenceFlow id="f-post_travel-post_travel_type" name="Yes" sourceRef="post_travel" targetRef="post_travel_type" />
    <bpmn:sequenceFlow id="f-post_travel-end_journey" name="No" sourceRef="post_travel" targetRef="end_journey" />
    <bpmn:sequenceFlow id="f-post_travel_type-provide_feedback" name="Feedback" sourceRef="post_travel_type" targetRef="provide_feedback" />
    <bpmn:sequenceFlow id="f-post_travel_type-use_services" name="Services" sourceRef="post_travel_type" targetRef="use_services" />
    <bpmn:sequenceFlow id="f-provide_feedback-end_extended" sourceRef="provide_feedback" targetRef="end_extended" />
    <bpmn:sequenceFlow id="f-use_services-end_extended" sourceRef="use_services" targetRef="end_extended" />
  </bpmn:process>
</bpmn:definitions>
