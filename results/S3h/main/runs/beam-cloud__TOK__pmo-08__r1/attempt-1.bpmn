<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident management" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident management" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="reporter" name="Employee or Customer">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_incident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tracking" name="Tracking System">
        <bpmn:flowNodeRef>log_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_stakeholders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Investigation Team">
        <bpmn:flowNodeRef>gather_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose_actions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement_solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>follow_up</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Start" />
    <bpmn:task id="report_incident" name="Report the incident" />
    <bpmn:task id="log_report" name="Log the report" />
    <bpmn:task id="assign_team" name="Assign to the team" />
    <bpmn:task id="close_report" name="Close the incident report" />
    <bpmn:task id="notify_stakeholders" name="Notify stakeholders" />
    <bpmn:endEvent id="done" name="Incident report closed" />
    <bpmn:task id="gather_info" name="Gather necessary information" />
    <bpmn:task id="identify_cause" name="Identify the cause" />
    <bpmn:task id="propose_actions" name="Propose corrective actions" />
    <bpmn:task id="implement_solution" name="Implement the solution" />
    <bpmn:task id="follow_up" name="Follow up" />
    <bpmn:sequenceFlow id="f-start_event-report_incident" sourceRef="start_event" targetRef="report_incident" />
    <bpmn:sequenceFlow id="f-report_incident-log_report" sourceRef="report_incident" targetRef="log_report" />
    <bpmn:sequenceFlow id="f-log_report-assign_team" sourceRef="log_report" targetRef="assign_team" />
    <bpmn:sequenceFlow id="f-assign_team-gather_info" sourceRef="assign_team" targetRef="gather_info" />
    <bpmn:sequenceFlow id="f-gather_info-identify_cause" sourceRef="gather_info" targetRef="identify_cause" />
    <bpmn:sequenceFlow id="f-identify_cause-propose_actions" sourceRef="identify_cause" targetRef="propose_actions" />
    <bpmn:sequenceFlow id="f-propose_actions-implement_solution" sourceRef="propose_actions" targetRef="implement_solution" />
    <bpmn:sequenceFlow id="f-implement_solution-follow_up" sourceRef="implement_solution" targetRef="follow_up" />
    <bpmn:sequenceFlow id="f-follow_up-close_report" sourceRef="follow_up" targetRef="close_report" />
    <bpmn:sequenceFlow id="f-close_report-notify_stakeholders" sourceRef="close_report" targetRef="notify_stakeholders" />
    <bpmn:sequenceFlow id="f-notify_stakeholders-done" sourceRef="notify_stakeholders" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
