<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Product development" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Product development" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="rd" name="R&amp;D Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_feasibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft_concepts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build_prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refinement_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify_idea" name="Identify an idea" />
    <bpmn:task id="conduct_research" name="Conduct initial research" />
    <bpmn:task id="conduct_feasibility" name="Conduct feasibility studies" />
    <bpmn:task id="draft_concepts" name="Draft design concepts" />
    <bpmn:task id="select_design" name="Select a promising design" />
    <bpmn:task id="build_prototype" name="Build a prototype" />
    <bpmn:task id="test_prototype" name="Test the prototype" />
    <bpmn:task id="collect_feedback" name="Collect feedback" />
    <bpmn:task id="refine_prototype" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="refinement_needed" name="Refinement needed?" default="f-refinement_needed-approved" />
    <bpmn:exclusiveGateway id="approved" name="Prototype approved?" default="f-approved-discarded_end" />
    <bpmn:endEvent id="approved_end" name="Approved for further development" />
    <bpmn:endEvent id="discarded_end" name="Discarded" />
    <bpmn:sequenceFlow id="f-start-identify_idea" sourceRef="start" targetRef="identify_idea" />
    <bpmn:sequenceFlow id="f-identify_idea-conduct_research" sourceRef="identify_idea" targetRef="conduct_research" />
    <bpmn:sequenceFlow id="f-conduct_research-conduct_feasibility" sourceRef="conduct_research" targetRef="conduct_feasibility" />
    <bpmn:sequenceFlow id="f-conduct_feasibility-draft_concepts" sourceRef="conduct_feasibility" targetRef="draft_concepts" />
    <bpmn:sequenceFlow id="f-draft_concepts-select_design" sourceRef="draft_concepts" targetRef="select_design" />
    <bpmn:sequenceFlow id="f-select_design-build_prototype" sourceRef="select_design" targetRef="build_prototype" />
    <bpmn:sequenceFlow id="f-build_prototype-test_prototype" sourceRef="build_prototype" targetRef="test_prototype" />
    <bpmn:sequenceFlow id="f-test_prototype-collect_feedback" sourceRef="test_prototype" targetRef="collect_feedback" />
    <bpmn:sequenceFlow id="f-collect_feedback-refinement_needed" sourceRef="collect_feedback" targetRef="refinement_needed" />
    <bpmn:sequenceFlow id="f-refinement_needed-refine_prototype" name="yes" sourceRef="refinement_needed" targetRef="refine_prototype" />
    <bpmn:sequenceFlow id="f-refinement_needed-approved" name="no" sourceRef="refinement_needed" targetRef="approved" />
    <bpmn:sequenceFlow id="f-refine_prototype-test_prototype" sourceRef="refine_prototype" targetRef="test_prototype" />
    <bpmn:sequenceFlow id="f-approved-approved_end" name="yes" sourceRef="approved" targetRef="approved_end" />
    <bpmn:sequenceFlow id="f-approved-discarded_end" name="no" sourceRef="approved" targetRef="discarded_end" />
  </bpmn:process>
</bpmn:definitions>
