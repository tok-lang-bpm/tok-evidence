tok 1.0 "Product development"

pool organisation "Organisation"
  lane rd "R&D Team"
    start start "Start"
    task identify_idea "Identify an idea"
    task conduct_research "Conduct initial research"
    task conduct_feasibility "Conduct feasibility studies"
    task draft_concepts "Draft design concepts"
    task select_design "Select a promising design"
    task build_prototype "Build a prototype"
    task test_prototype "Test the prototype"
    task collect_feedback "Collect feedback"
    task refine_prototype "Refine the prototype"
    xor refinement_needed "Refinement needed?"
    xor approved "Prototype approved?"
    end approved_end "Approved for further development"
    end discarded_end "Discarded"

flow start -> identify_idea -> conduct_research -> conduct_feasibility -> draft_concepts -> select_design -> build_prototype -> test_prototype -> collect_feedback -> refinement_needed
flow refinement_needed -> refine_prototype "yes"
flow refinement_needed -> approved "no" default
flow refine_prototype -> test_prototype
flow approved -> approved_end "yes"
flow approved -> discarded_end "no" default
