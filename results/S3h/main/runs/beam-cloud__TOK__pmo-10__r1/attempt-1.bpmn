<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IT solution request process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="IT solution request process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="requester" name="Employee or Department">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Request submitted" />
    <bpmn:task id="submit" name="Submit request for IT solution" />
    <bpmn:task id="assess" name="Assess request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" default="f-approved-rejected" />
    <bpmn:task id="procure" name="Procure tools or licenses" />
    <bpmn:task id="install" name="Install solution" />
    <bpmn:task id="test" name="Test solution" />
    <bpmn:task id="rollout" name="Roll out solution" />
    <bpmn:exclusiveGateway id="trainDecision" name="Provide training?" default="f-trainDecision-trainingJoin" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:exclusiveGateway id="trainingJoin" />
    <bpmn:task id="support" name="Provide IT support" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assess" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-approved" sourceRef="assess" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="Approved" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approved-rejected" name="Not approved" sourceRef="approved" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-rollout" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-rollout-trainDecision" sourceRef="rollout" targetRef="trainDecision" />
    <bpmn:sequenceFlow id="f-trainDecision-train" name="Yes" sourceRef="trainDecision" targetRef="train" />
    <bpmn:sequenceFlow id="f-trainDecision-trainingJoin" name="No" sourceRef="trainDecision" targetRef="trainingJoin" />
    <bpmn:sequenceFlow id="f-train-trainingJoin" sourceRef="train" targetRef="trainingJoin" />
    <bpmn:sequenceFlow id="f-trainingJoin-support" sourceRef="trainingJoin" targetRef="support" />
    <bpmn:sequenceFlow id="f-support-completed" sourceRef="support" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
