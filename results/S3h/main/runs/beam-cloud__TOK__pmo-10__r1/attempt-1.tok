tok 1.0 "IT solution request process"

pool organisation "Organisation"
  lane requester "Employee or Department"
    start submitted "Request submitted"
    task submit "Submit request for IT solution"
  lane it "IT"
    task assess "Assess request"
    xor approved "Request approved?"
    task procure "Procure tools or licenses"
    task install "Install solution"
    task test "Test solution"
    task rollout "Roll out solution"
    xor trainDecision "Provide training?"
    task train "Provide training"
    xor trainingJoin
    task support "Provide IT support"
    end completed "Process completed"
    end rejected "Request rejected"

flow submitted -> submit -> assess -> approved
flow approved -> procure "Approved"
flow approved -> rejected "Not approved" default
flow procure -> install -> test -> rollout -> trainDecision
flow trainDecision -> train "Yes"
flow trainDecision -> trainingJoin "No" default
flow train -> trainingJoin
flow trainingJoin -> support -> completed
