<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Subscription handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Subscription handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notification_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_enhancements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_renewals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notification_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support team">
        <bpmn:flowNodeRef>process_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terms_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terms_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="signup" name="Customer signs up" />
    <bpmn:task id="enter" name="Enter personal and payment information" />
    <bpmn:exclusiveGateway id="notification_split" name="Notification type?" />
    <bpmn:task id="receive_updates" name="Receive regular updates" />
    <bpmn:task id="receive_enhancements" name="Receive product enhancements" />
    <bpmn:task id="receive_renewals" name="Receive renewal notifications" />
    <bpmn:exclusiveGateway id="notification_join" name="Notifications completed" />
    <bpmn:exclusiveGateway id="cancel_split" name="Customer decides to cancel?" />
    <bpmn:task id="submit_cancel" name="Submit cancellation request" />
    <bpmn:task id="generate" name="Generate account" />
    <bpmn:task id="access" name="Assign access" />
    <bpmn:task id="billing" name="Trigger automated billing cycles" />
    <bpmn:task id="process_cancel" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="terms_split" name="Refunds or charges?" />
    <bpmn:task id="apply_refund" name="Apply refunds" />
    <bpmn:task id="apply_charge" name="Apply charges" />
    <bpmn:exclusiveGateway id="terms_join" name="Terms applied" />
    <bpmn:parallelGateway id="close_split" name="Close subscription" />
    <bpmn:task id="deactivate" name="Deactivate subscription" />
    <bpmn:task id="settle" name="Settle final account balance" />
    <bpmn:parallelGateway id="close_join" name="Subscription closed" />
    <bpmn:endEvent id="completed" name="Subscription deactivated" />
    <bpmn:sequenceFlow id="f-signup-enter" sourceRef="signup" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-generate" sourceRef="enter" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-access" sourceRef="generate" targetRef="access" />
    <bpmn:sequenceFlow id="f-access-billing" sourceRef="access" targetRef="billing" />
    <bpmn:sequenceFlow id="f-billing-notification_split" sourceRef="billing" targetRef="notification_split" />
    <bpmn:sequenceFlow id="f-notification_split-receive_updates" sourceRef="notification_split" targetRef="receive_updates" />
    <bpmn:sequenceFlow id="f-notification_split-receive_enhancements" sourceRef="notification_split" targetRef="receive_enhancements" />
    <bpmn:sequenceFlow id="f-notification_split-receive_renewals" sourceRef="notification_split" targetRef="receive_renewals" />
    <bpmn:sequenceFlow id="f-receive_updates-notification_join" sourceRef="receive_updates" targetRef="notification_join" />
    <bpmn:sequenceFlow id="f-receive_enhancements-notification_join" sourceRef="receive_enhancements" targetRef="notification_join" />
    <bpmn:sequenceFlow id="f-receive_renewals-notification_join" sourceRef="receive_renewals" targetRef="notification_join" />
    <bpmn:sequenceFlow id="f-notification_join-cancel_split" sourceRef="notification_join" targetRef="cancel_split" />
    <bpmn:sequenceFlow id="f-cancel_split-submit_cancel" name="yes" sourceRef="cancel_split" targetRef="submit_cancel" />
    <bpmn:sequenceFlow id="f-cancel_split-notification_split" name="no" sourceRef="cancel_split" targetRef="notification_split" />
    <bpmn:sequenceFlow id="f-submit_cancel-process_cancel" sourceRef="submit_cancel" targetRef="process_cancel" />
    <bpmn:sequenceFlow id="f-process_cancel-terms_split" sourceRef="process_cancel" targetRef="terms_split" />
    <bpmn:sequenceFlow id="f-terms_split-apply_refund" name="refunds" sourceRef="terms_split" targetRef="apply_refund" />
    <bpmn:sequenceFlow id="f-terms_split-apply_charge" name="charges" sourceRef="terms_split" targetRef="apply_charge" />
    <bpmn:sequenceFlow id="f-apply_refund-terms_join" sourceRef="apply_refund" targetRef="terms_join" />
    <bpmn:sequenceFlow id="f-apply_charge-terms_join" sourceRef="apply_charge" targetRef="terms_join" />
    <bpmn:sequenceFlow id="f-terms_join-close_split" sourceRef="terms_join" targetRef="close_split" />
    <bpmn:sequenceFlow id="f-close_split-deactivate" sourceRef="close_split" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f-close_split-settle" sourceRef="close_split" targetRef="settle" />
    <bpmn:sequenceFlow id="f-deactivate-close_join" sourceRef="deactivate" targetRef="close_join" />
    <bpmn:sequenceFlow id="f-settle-close_join" sourceRef="settle" targetRef="close_join" />
    <bpmn:sequenceFlow id="f-close_join-completed" sourceRef="close_join" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
