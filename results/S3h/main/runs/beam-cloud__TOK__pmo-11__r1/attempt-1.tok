tok 1.0 "Subscription handling"

pool organisation "Organisation"
  lane customer "Customer"
    start signup "Customer signs up"
    task enter "Enter personal and payment information"
    xor notification_split "Notification type?"
    task receive_updates "Receive regular updates"
    task receive_enhancements "Receive product enhancements"
    task receive_renewals "Receive renewal notifications"
    xor notification_join "Notifications completed"
    xor cancel_split "Customer decides to cancel?"
    task submit_cancel "Submit cancellation request"
  lane system "System"
    task generate "Generate account"
    task access "Assign access"
    task billing "Trigger automated billing cycles"
  lane support "Support team"
    task process_cancel "Process cancellation request"
    xor terms_split "Refunds or charges?"
    task apply_refund "Apply refunds"
    task apply_charge "Apply charges"
    xor terms_join "Terms applied"
    and close_split "Close subscription"
    task deactivate "Deactivate subscription"
    task settle "Settle final account balance"
    and close_join "Subscription closed"
    end completed "Subscription deactivated"

flow signup -> enter -> generate -> access -> billing -> notification_split
flow notification_split -> receive_updates
flow notification_split -> receive_enhancements
flow notification_split -> receive_renewals
flow receive_updates -> notification_join
flow receive_enhancements -> notification_join
flow receive_renewals -> notification_join
flow notification_join -> cancel_split
flow cancel_split -> submit_cancel "yes"
flow cancel_split -> notification_split "no"
flow submit_cancel -> process_cancel
flow process_cancel -> terms_split
flow terms_split -> apply_refund "refunds"
flow terms_split -> apply_charge "charges"
flow apply_refund -> terms_join
flow apply_charge -> terms_join
flow terms_join -> close_split
flow close_split -> deactivate
flow close_split -> settle
flow deactivate -> close_join
flow settle -> close_join
flow close_join -> completed
