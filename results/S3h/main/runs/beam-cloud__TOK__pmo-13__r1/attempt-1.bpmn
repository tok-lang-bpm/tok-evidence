<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="department" name="Relevant department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedbackgw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="financial" name="Financial team">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Complaint needed" />
    <bpmn:task id="file" name="File complaint" />
    <bpmn:task id="receive" name="Receive refund" />
    <bpmn:task id="feedback" name="Provide feedback" />
    <bpmn:endEvent id="closed" name="Case closed" />
    <bpmn:task id="log" name="Log complaint" />
    <bpmn:task id="assign" name="Assign to relevant department" />
    <bpmn:task id="review" name="Review details" />
    <bpmn:task id="notify" name="Notify customer with decision" />
    <bpmn:exclusiveGateway id="approved" name="Refund approved?" default="f-approved-mark" />
    <bpmn:task id="mark" name="Mark complaint as resolved" />
    <bpmn:exclusiveGateway id="feedbackgw" name="Provide feedback?" default="f-feedbackgw-closed" />
    <bpmn:task id="process" name="Process reimbursement" />
    <bpmn:sequenceFlow id="f-needed-file" sourceRef="needed" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-log" sourceRef="file" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-review" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-notify" sourceRef="review" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-approved" sourceRef="notify" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-process" name="yes" sourceRef="approved" targetRef="process">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refundApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-approved-mark" name="no" sourceRef="approved" targetRef="mark" />
    <bpmn:sequenceFlow id="f-process-receive" sourceRef="process" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-mark" sourceRef="receive" targetRef="mark" />
    <bpmn:sequenceFlow id="f-mark-feedbackgw" sourceRef="mark" targetRef="feedbackgw" />
    <bpmn:sequenceFlow id="f-feedbackgw-feedback" name="yes" sourceRef="feedbackgw" targetRef="feedback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">provideFeedback</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-feedbackgw-closed" name="no" sourceRef="feedbackgw" targetRef="closed" />
    <bpmn:sequenceFlow id="f-feedback-closed" sourceRef="feedback" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
