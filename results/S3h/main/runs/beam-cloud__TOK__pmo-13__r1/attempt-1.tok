tok 1.0 "Complaint handling"

pool org "Organisation"
  lane customer "Customer"
    start needed "Complaint needed"
    task file "File complaint"
    task receive "Receive refund"
    task feedback "Provide feedback"
    end closed "Case closed"
  lane service "Customer service"
    task log "Log complaint"
    task assign "Assign to relevant department"
  lane department "Relevant department"
    task review "Review details"
    task notify "Notify customer with decision"
    xor approved "Refund approved?"
    task mark "Mark complaint as resolved"
    xor feedbackgw "Provide feedback?"
  lane financial "Financial team"
    task process "Process reimbursement"

flow needed -> file
flow file -> log
flow log -> assign
flow assign -> review
flow review -> notify
flow notify -> approved
flow approved -> process "yes" when="refundApproved"
flow approved -> mark "no" default
flow process -> receive
flow receive -> mark
flow mark -> feedbackgw
flow feedbackgw -> feedback "yes" when="provideFeedback"
flow feedbackgw -> closed "no" default
flow feedback -> closed
