<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Budget approval process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Budget approval process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="strategic" name="Strategic Alignment Meeting">
        <bpmn:flowNodeRef>reviewStrategic</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>reviewFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjustments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Budget process starts" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:task id="implement" name="Begin implementing plan" />
    <bpmn:endEvent id="finish" name="Budget distributed and plan implemented" />
    <bpmn:task id="draft" name="Draft plan" />
    <bpmn:task id="reviewStrategic" name="Review plan" />
    <bpmn:task id="reviewFinance" name="Perform detailed review" />
    <bpmn:exclusiveGateway id="adjustments" name="Adjustments needed?" default="f-adjustments-approve" />
    <bpmn:task id="allocate" name="Allocate budget" />
    <bpmn:task id="distribute" name="Distribute budget" />
    <bpmn:task id="adjust" name="Document and approve adjustment" />
    <bpmn:task id="approve" name="Approve final budget" />
    <bpmn:sequenceFlow id="f-start-outline" sourceRef="start" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-reviewStrategic" sourceRef="draft" targetRef="reviewStrategic" />
    <bpmn:sequenceFlow id="f-reviewStrategic-reviewFinance" sourceRef="reviewStrategic" targetRef="reviewFinance" />
    <bpmn:sequenceFlow id="f-reviewFinance-adjustments" sourceRef="reviewFinance" targetRef="adjustments" />
    <bpmn:sequenceFlow id="f-adjustments-adjust" name="yes" sourceRef="adjustments" targetRef="adjust">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adjustments_needed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-adjustments-approve" name="no" sourceRef="adjustments" targetRef="approve" />
    <bpmn:sequenceFlow id="f-adjust-reviewStrategic" sourceRef="adjust" targetRef="reviewStrategic" />
    <bpmn:sequenceFlow id="f-approve-allocate" sourceRef="approve" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-finish" sourceRef="implement" targetRef="finish" />
  </bpmn:process>
</bpmn:definitions>
