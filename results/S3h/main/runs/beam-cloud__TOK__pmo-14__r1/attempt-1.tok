tok 1.0 "Budget approval process"

pool organisation "Organisation"
  lane department "Department"
    start start "Budget process starts"
    task outline "Outline objectives"
    task implement "Begin implementing plan"
    end finish "Budget distributed and plan implemented"
  lane team "Team"
    task draft "Draft plan"
  lane strategic "Strategic Alignment Meeting"
    task reviewStrategic "Review plan"
  lane finance "Finance Department"
    task reviewFinance "Perform detailed review"
    xor adjustments "Adjustments needed?"
    task allocate "Allocate budget"
    task distribute "Distribute budget"
  lane stakeholders "Stakeholders"
    task adjust "Document and approve adjustment"
    task approve "Approve final budget"

flow start -> outline -> draft -> reviewStrategic -> reviewFinance -> adjustments
flow adjustments -> adjust "yes" when="adjustments_needed = true"
flow adjustments -> approve "no" default
flow adjust -> reviewStrategic
flow approve -> allocate -> distribute -> implement -> finish
