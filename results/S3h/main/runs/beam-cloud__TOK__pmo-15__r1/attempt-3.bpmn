<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undergo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notcertified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal Teams">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfassess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="required" name="Compliance audit required" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:task id="undergo" name="Undergo final audit" />
    <bpmn:endEvent id="certified" name="Certification issued" />
    <bpmn:endEvent id="notcertified" name="Certification not awarded" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="selfassess" name="Conduct self-assessment" />
    <bpmn:task id="correct" name="Make corrections and improvements" />
    <bpmn:task id="review" name="Review company's processes" />
    <bpmn:task id="identify" name="Identify gaps and issues" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" default="f-criteria-notcertified" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:sequenceFlow id="f-required-schedule" sourceRef="required" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-prepare" sourceRef="schedule" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-selfassess" sourceRef="gather" targetRef="selfassess" />
    <bpmn:sequenceFlow id="f-selfassess-review" sourceRef="selfassess" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-identify" sourceRef="review" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-correct" sourceRef="identify" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-undergo" sourceRef="correct" targetRef="undergo" />
    <bpmn:sequenceFlow id="f-undergo-criteria" sourceRef="undergo" targetRef="criteria" />
    <bpmn:sequenceFlow id="f-criteria-award" name="yes" sourceRef="criteria" targetRef="award">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all_criteria_met</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-criteria-notcertified" name="no" sourceRef="criteria" targetRef="notcertified" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-certified" sourceRef="issue" targetRef="certified" />
  </bpmn:process>
</bpmn:definitions>
