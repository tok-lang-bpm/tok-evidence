tok 1.0 "Compliance audit"

pool org "Organisation"
  lane company "Company"
    start required "Compliance audit required"
    task schedule "Schedule compliance audit"
    task undergo "Undergo final audit"
    end certified "Certification issued"
    end notcertified "Certification not awarded"
  lane internal "Internal Teams"
    task prepare "Prepare documentation"
    task gather "Gather evidence"
    task selfassess "Conduct self-assessment"
    task correct "Make corrections and improvements"
  lane auditors "Auditors"
    task review "Review company's processes"
    task identify "Identify gaps and issues"
    xor criteria "All criteria met?"
    task award "Award certification"
    task issue "Issue official documents"

flow required -> schedule -> prepare -> gather -> selfassess -> review -> identify -> correct -> undergo -> criteria
flow criteria -> award "yes" when="all_criteria_met"
flow criteria -> notcertified "no" default
flow award -> issue -> certified
