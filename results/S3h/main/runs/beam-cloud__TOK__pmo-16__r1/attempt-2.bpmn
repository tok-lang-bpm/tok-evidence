<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="audit_coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>audit_initiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par_preparation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional_office" name="Regional office">
        <bpmn:flowNodeRef>prepare_statements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_clarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance_team" name="Compliance team">
        <bpmn:flowNodeRef>check_updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central_audit_team" name="Central audit team">
        <bpmn:flowNodeRef>par_review_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_discrepancies</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit_team" name="Audit team">
        <bpmn:flowNodeRef>risk_assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_high_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_site_visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_site_visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_site_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_high_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit_director" name="Audit director">
        <bpmn:flowNodeRef>review_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_report_decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="audit_initiated" name="Audit initiated" />
    <bpmn:task id="send_notification" name="Send notification" />
    <bpmn:parallelGateway id="par_preparation" />
    <bpmn:task id="prepare_statements" name="Prepare financial statements" />
    <bpmn:task id="gather_documents" name="Gather necessary documents" />
    <bpmn:task id="submit_documents" name="Submit documents" />
    <bpmn:task id="provide_clarifications" name="Provide clarifications" />
    <bpmn:task id="check_updates" name="Check regulatory updates" />
    <bpmn:parallelGateway id="par_review_ready" />
    <bpmn:task id="review_submission" name="Review submission" />
    <bpmn:task id="request_clarifications" name="Request clarifications" />
    <bpmn:exclusiveGateway id="gw_discrepancies" name="Discrepancies found?" default="f-gw_discrepancies-risk_assessment" />
    <bpmn:adHocSubProcess id="risk_assessment" name="Risk assessment">
      <bpmn:task id="evaluate_financial" name="Evaluate financial risks" />
      <bpmn:task id="evaluate_operational" name="Evaluate operational risks" />
      <bpmn:task id="evaluate_compliance" name="Evaluate compliance risks" />
    </bpmn:adHocSubProcess>
    <bpmn:exclusiveGateway id="gw_high_risk" name="High risk identified?" default="f-gw_high_risk-gw_high_merge" />
    <bpmn:task id="analyze_data" name="Analyze data" />
    <bpmn:task id="conduct_interviews" name="Conduct interviews" />
    <bpmn:task id="conduct_site_visits" name="Conduct site visits" />
    <bpmn:exclusiveGateway id="gw_site_visit" name="Site visit needed?" default="f-gw_site_visit-gw_site_merge" />
    <bpmn:exclusiveGateway id="gw_site_merge" />
    <bpmn:exclusiveGateway id="gw_high_merge" />
    <bpmn:task id="compile_report" name="Compile audit report" />
    <bpmn:task id="update_report" name="Update audit report" />
    <bpmn:task id="resubmit_report" name="Resubmit audit report" />
    <bpmn:task id="distribute_report" name="Distribute final report" />
    <bpmn:task id="archive_report" name="Archive audit report" />
    <bpmn:endEvent id="audit_closed" name="Audit process closed" />
    <bpmn:task id="review_report" name="Review audit report" />
    <bpmn:exclusiveGateway id="gw_report_decision" name="Report approved?" default="f-gw_report_decision-update_report" />
    <bpmn:sequenceFlow id="f-audit_initiated-send_notification" sourceRef="audit_initiated" targetRef="send_notification" />
    <bpmn:sequenceFlow id="f-send_notification-par_preparation" sourceRef="send_notification" targetRef="par_preparation" />
    <bpmn:sequenceFlow id="f-par_preparation-prepare_statements" sourceRef="par_preparation" targetRef="prepare_statements" />
    <bpmn:sequenceFlow id="f-par_preparation-check_updates" sourceRef="par_preparation" targetRef="check_updates" />
    <bpmn:sequenceFlow id="f-prepare_statements-gather_documents" sourceRef="prepare_statements" targetRef="gather_documents" />
    <bpmn:sequenceFlow id="f-gather_documents-submit_documents" sourceRef="gather_documents" targetRef="submit_documents" />
    <bpmn:sequenceFlow id="f-submit_documents-par_review_ready" sourceRef="submit_documents" targetRef="par_review_ready" />
    <bpmn:sequenceFlow id="f-check_updates-par_review_ready" sourceRef="check_updates" targetRef="par_review_ready" />
    <bpmn:sequenceFlow id="f-par_review_ready-review_submission" sourceRef="par_review_ready" targetRef="review_submission" />
    <bpmn:sequenceFlow id="f-review_submission-gw_discrepancies" sourceRef="review_submission" targetRef="gw_discrepancies" />
    <bpmn:sequenceFlow id="f-gw_discrepancies-request_clarifications" name="yes" sourceRef="gw_discrepancies" targetRef="request_clarifications" />
    <bpmn:sequenceFlow id="f-request_clarifications-provide_clarifications" sourceRef="request_clarifications" targetRef="provide_clarifications" />
    <bpmn:sequenceFlow id="f-provide_clarifications-review_submission" sourceRef="provide_clarifications" targetRef="review_submission" />
    <bpmn:sequenceFlow id="f-gw_discrepancies-risk_assessment" name="no" sourceRef="gw_discrepancies" targetRef="risk_assessment" />
    <bpmn:sequenceFlow id="f-risk_assessment-gw_high_risk" sourceRef="risk_assessment" targetRef="gw_high_risk" />
    <bpmn:sequenceFlow id="f-gw_high_risk-analyze_data" name="yes" sourceRef="gw_high_risk" targetRef="analyze_data" />
    <bpmn:sequenceFlow id="f-gw_high_risk-gw_high_merge" name="no" sourceRef="gw_high_risk" targetRef="gw_high_merge" />
    <bpmn:sequenceFlow id="f-analyze_data-conduct_interviews" sourceRef="analyze_data" targetRef="conduct_interviews" />
    <bpmn:sequenceFlow id="f-conduct_interviews-gw_site_visit" sourceRef="conduct_interviews" targetRef="gw_site_visit" />
    <bpmn:sequenceFlow id="f-gw_site_visit-conduct_site_visits" name="yes" sourceRef="gw_site_visit" targetRef="conduct_site_visits" />
    <bpmn:sequenceFlow id="f-gw_site_visit-gw_site_merge" name="no" sourceRef="gw_site_visit" targetRef="gw_site_merge" />
    <bpmn:sequenceFlow id="f-conduct_site_visits-gw_site_merge" sourceRef="conduct_site_visits" targetRef="gw_site_merge" />
    <bpmn:sequenceFlow id="f-gw_site_merge-gw_high_merge" sourceRef="gw_site_merge" targetRef="gw_high_merge" />
    <bpmn:sequenceFlow id="f-gw_high_merge-compile_report" sourceRef="gw_high_merge" targetRef="compile_report" />
    <bpmn:sequenceFlow id="f-compile_report-review_report" sourceRef="compile_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-review_report-gw_report_decision" sourceRef="review_report" targetRef="gw_report_decision" />
    <bpmn:sequenceFlow id="f-gw_report_decision-distribute_report" name="approved" sourceRef="gw_report_decision" targetRef="distribute_report" />
    <bpmn:sequenceFlow id="f-distribute_report-archive_report" sourceRef="distribute_report" targetRef="archive_report" />
    <bpmn:sequenceFlow id="f-archive_report-audit_closed" sourceRef="archive_report" targetRef="audit_closed" />
    <bpmn:sequenceFlow id="f-gw_report_decision-update_report" name="revisions" sourceRef="gw_report_decision" targetRef="update_report" />
    <bpmn:sequenceFlow id="f-update_report-resubmit_report" sourceRef="update_report" targetRef="resubmit_report" />
    <bpmn:sequenceFlow id="f-resubmit_report-review_report" sourceRef="resubmit_report" targetRef="review_report" />
  </bpmn:process>
</bpmn:definitions>
