tok 1.0 "E-commerce order fulfillment"

pool ecommerce "E-commerce company"
  lane customer "Customer"
    start start_event "Start"
    task place_order "Place the order"
  lane system "System"
    task record_order "Record the order details"
    task process_payment "Process payment"
    xor payment "Payment successful?"
    task notify_customer "Notify the customer"
    end payment_failed "Payment failed"
    task inform_delay "Inform the customer about the delay"
    task send_shipping_confirmation "Send a shipping confirmation to the customer"
    task update_inventory "Update the inventory levels"
    task confirm_delivery "Confirm successful delivery"
    task send_followup "Send a follow-up email for feedback"
    xor issues "Customer reports issues?"
    task process_refund "Process a refund or replacement"
    end order_completed "Order completed"
    end return_processed "Return processed"
  lane inventory "Inventory System"
    task check_stock "Check stock availability"
    xor stock "Items in stock?"
    task initiate_backorder "Initiate a back-order"
    catch backorder_received "Back-order received" message="Back-order received"
  lane warehouse "Warehouse"
    task pick_items "Pick in-stock items from the warehouse"
    task package "Package items"
    xor gift_requested "Gift wrapping requested?"
    task gift_wrap "Gift wrap items"
    xor gift_merge "Gift wrapping complete"
    task receive_returned "Receive returned items"
  lane quality_control "Quality Control"
    task perform_qc "Perform quality control checks"
    task inspect_returned "Inspect returned items"
  lane shipping "Shipping Department"
    and and_split "Prepare order"
    task prepare_shipping_docs "Prepare shipping documents and labels"
    xor international "Order is international?"
    task prepare_customs "Prepare customs documentation"
    xor customs_merge "Customs documentation complete"
    task dispatch "Dispatch the order"
    task send_return_label "Send a return shipping label"
    and and_join "Packaging and shipping documents ready"

flow start_event -> place_order -> record_order -> process_payment -> payment
flow payment -> notify_customer "Payment failed" when="paymentSuccessful = false"
flow payment -> check_stock "Payment successful" default
flow notify_customer -> payment_failed
flow check_stock -> stock
flow stock -> initiate_backorder "Out of stock" when="itemsInStock = false"
flow stock -> pick_items "In stock" default
flow initiate_backorder -> inform_delay -> backorder_received -> pick_items
flow pick_items -> perform_qc
flow perform_qc -> and_split
flow and_split -> package
flow and_split -> prepare_shipping_docs
flow package -> gift_requested
flow gift_requested -> gift_wrap "Yes" when="giftWrappingRequested = true"
flow gift_requested -> gift_merge "No" default
flow gift_wrap -> gift_merge
flow gift_merge -> and_join
flow prepare_shipping_docs -> international
flow international -> prepare_customs "Yes" when="internationalOrder = true"
flow international -> customs_merge "No" default
flow prepare_customs -> customs_merge
flow customs_merge -> and_join
flow and_join -> dispatch
flow dispatch -> send_shipping_confirmation -> update_inventory -> confirm_delivery -> send_followup -> issues
flow issues -> send_return_label "Yes" when="customerReportsIssues = true"
flow issues -> order_completed "No" default
flow send_return_label -> receive_returned -> inspect_returned -> process_refund -> return_processed
