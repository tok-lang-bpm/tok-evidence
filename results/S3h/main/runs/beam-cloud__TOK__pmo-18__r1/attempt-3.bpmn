<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="University enrollment system" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University enrollment system" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_enr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>idcard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievances</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue_studies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions Office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrent_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelapp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>international</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="international_office" name="International Student Office">
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="advisor" name="Academic Advisor" />
      <bpmn:lane id="appeals" name="Appeals Committee" />
      <bpmn:lane id="system" name="University System">
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Application needed" />
    <bpmn:task id="submit" name="Submit application online" />
    <bpmn:task id="confirm" name="Confirm enrollment" />
    <bpmn:boundaryEvent id="cancel_enr" attachedToRef="confirm">
      <bpmn:timerEventDefinition id="cancel_enr-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="receive_orientation" name="Receive orientation materials" />
    <bpmn:task id="idcard" name="Obtain student ID card" />
    <bpmn:task id="meet_advisor" name="Meet with academic advisor" />
    <bpmn:task id="select_courses" name="Select courses" />
    <bpmn:task id="resolve_conflicts" name="Resolve schedule conflicts" />
    <bpmn:task id="attend" name="Begin attending classes" />
    <bpmn:exclusiveGateway id="add_drop_choice" name="Add or drop courses?" />
    <bpmn:task id="add_drop" name="Add or drop courses" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:exclusiveGateway id="grievances" name="Any grievances?" />
    <bpmn:task id="submit_appeal" name="Submit appeal form" />
    <bpmn:task id="meet_appeals" name="Meet with appeals committee" />
    <bpmn:task id="await_decision" name="Await appeal decision" />
    <bpmn:exclusiveGateway id="continue_studies" name="Continue, graduate, or withdraw?" />
    <bpmn:endEvent id="graduated" name="Student graduated" />
    <bpmn:endEvent id="withdrawn" name="Student withdrawn" />
    <bpmn:parallelGateway id="orient_split" />
    <bpmn:parallelGateway id="orient_join" />
    <bpmn:task id="review" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="docs" name="Documents complete?" />
    <bpmn:task id="notify" name="Notify applicant to provide missing items" />
    <bpmn:parallelGateway id="concurrent" />
    <bpmn:parallelGateway id="concurrent_done" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" />
    <bpmn:task id="send_accept" name="Send acceptance letter" />
    <bpmn:task id="send_reject" name="Send rejection letter" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:task id="cancelapp" name="Cancel application" />
    <bpmn:endEvent id="canceled" name="Application canceled" />
    <bpmn:exclusiveGateway id="international" name="International student?" />
    <bpmn:task id="evaluate" name="Evaluate application" />
    <bpmn:task id="fees" name="Process application fees or waivers" />
    <bpmn:task id="setup_accounts" name="Set up student accounts" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-docs" sourceRef="review" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-concurrent" name="yes" sourceRef="docs" targetRef="concurrent" />
    <bpmn:sequenceFlow id="f-docs-notify" name="no" sourceRef="docs" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-review" sourceRef="notify" targetRef="review" />
    <bpmn:sequenceFlow id="f-concurrent-evaluate" sourceRef="concurrent" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-concurrent-fees" sourceRef="concurrent" targetRef="fees" />
    <bpmn:sequenceFlow id="f-evaluate-concurrent_done" sourceRef="evaluate" targetRef="concurrent_done" />
    <bpmn:sequenceFlow id="f-fees-concurrent_done" sourceRef="fees" targetRef="concurrent_done" />
    <bpmn:sequenceFlow id="f-concurrent_done-accepted" sourceRef="concurrent_done" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-send_accept" name="accepted" sourceRef="accepted" targetRef="send_accept" />
    <bpmn:sequenceFlow id="f-accepted-send_reject" name="rejected" sourceRef="accepted" targetRef="send_reject" />
    <bpmn:sequenceFlow id="f-send_reject-rejected" sourceRef="send_reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-send_accept-confirm" sourceRef="send_accept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-cancel_enr-cancelapp" sourceRef="cancel_enr" targetRef="cancelapp" />
    <bpmn:sequenceFlow id="f-cancelapp-canceled" sourceRef="cancelapp" targetRef="canceled" />
    <bpmn:sequenceFlow id="f-confirm-orient_split" sourceRef="confirm" targetRef="orient_split" />
    <bpmn:sequenceFlow id="f-orient_split-receive_orientation" sourceRef="orient_split" targetRef="receive_orientation" />
    <bpmn:sequenceFlow id="f-orient_split-setup_accounts" sourceRef="orient_split" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f-receive_orientation-orient_join" sourceRef="receive_orientation" targetRef="orient_join" />
    <bpmn:sequenceFlow id="f-setup_accounts-orient_join" sourceRef="setup_accounts" targetRef="orient_join" />
    <bpmn:sequenceFlow id="f-orient_join-international" sourceRef="orient_join" targetRef="international" />
    <bpmn:sequenceFlow id="f-international-visa" name="yes" sourceRef="international" targetRef="visa" />
    <bpmn:sequenceFlow id="f-international-idcard" name="no" sourceRef="international" targetRef="idcard" />
    <bpmn:sequenceFlow id="f-visa-idcard" sourceRef="visa" targetRef="idcard" />
    <bpmn:sequenceFlow id="f-idcard-meet_advisor" sourceRef="idcard" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f-meet_advisor-select_courses" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f-select_courses-resolve_conflicts" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f-resolve_conflicts-attend" sourceRef="resolve_conflicts" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-add_drop_choice" sourceRef="attend" targetRef="add_drop_choice" />
    <bpmn:sequenceFlow id="f-add_drop_choice-add_drop" name="yes" sourceRef="add_drop_choice" targetRef="add_drop" />
    <bpmn:sequenceFlow id="f-add_drop_choice-post_grades" name="no" sourceRef="add_drop_choice" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-add_drop-post_grades" sourceRef="add_drop" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-post_grades-review_grades" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-review_grades-grievances" sourceRef="review_grades" targetRef="grievances" />
    <bpmn:sequenceFlow id="f-grievances-submit_appeal" name="yes" sourceRef="grievances" targetRef="submit_appeal" />
    <bpmn:sequenceFlow id="f-grievances-continue_studies" name="no" sourceRef="grievances" targetRef="continue_studies" />
    <bpmn:sequenceFlow id="f-submit_appeal-meet_appeals" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f-meet_appeals-await_decision" sourceRef="meet_appeals" targetRef="await_decision" />
    <bpmn:sequenceFlow id="f-await_decision-continue_studies" sourceRef="await_decision" targetRef="continue_studies" />
    <bpmn:sequenceFlow id="f-continue_studies-attend" name="continue" sourceRef="continue_studies" targetRef="attend" />
    <bpmn:sequenceFlow id="f-continue_studies-graduated" name="graduate" sourceRef="continue_studies" targetRef="graduated" />
    <bpmn:sequenceFlow id="f-continue_studies-withdrawn" name="withdraw" sourceRef="continue_studies" targetRef="withdrawn" />
  </bpmn:process>
</bpmn:definitions>
