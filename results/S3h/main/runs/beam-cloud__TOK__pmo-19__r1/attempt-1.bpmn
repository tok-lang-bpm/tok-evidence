<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Purchasing items from an online shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Online shop" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Purchasing items from an online shop" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>orderStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitPurchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readyForDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop" name="Online shop">
        <bpmn:flowNodeRef>deliverItems</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="orderStarted" name="Order started" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="splitPurchase" name="Purchase activities" />
    <bpmn:task id="selectItems" name="Select items to purchase" />
    <bpmn:task id="setPayment" name="Set payment method" />
    <bpmn:exclusiveGateway id="paymentChoice" name="Payment method" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="paymentDone" name="Payment completed" />
    <bpmn:task id="chooseReward" name="Choose free reward" />
    <bpmn:parallelGateway id="readyForDelivery" name="Ready for delivery" />
    <bpmn:exclusiveGateway id="returnDecision" name="Return items for exchange?" default="f-returnDecision-orderCompleted" />
    <bpmn:task id="returnItems" name="Return items for exchange" />
    <bpmn:endEvent id="orderCompleted" name="Order completed" />
    <bpmn:task id="deliverItems" name="Deliver items" />
    <bpmn:sequenceFlow id="f-orderStarted-login" sourceRef="orderStarted" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-splitPurchase" sourceRef="login" targetRef="splitPurchase" />
    <bpmn:sequenceFlow id="f-splitPurchase-selectItems" sourceRef="splitPurchase" targetRef="selectItems" />
    <bpmn:sequenceFlow id="f-splitPurchase-setPayment" sourceRef="splitPurchase" targetRef="setPayment" />
    <bpmn:sequenceFlow id="f-selectItems-chooseReward" sourceRef="selectItems" targetRef="chooseReward" />
    <bpmn:sequenceFlow id="f-chooseReward-readyForDelivery" sourceRef="chooseReward" targetRef="readyForDelivery" />
    <bpmn:sequenceFlow id="f-setPayment-paymentChoice" sourceRef="setPayment" targetRef="paymentChoice" />
    <bpmn:sequenceFlow id="f-paymentChoice-pay" name="Pay" sourceRef="paymentChoice" targetRef="pay" />
    <bpmn:sequenceFlow id="f-paymentChoice-installment" name="Complete installment agreement" sourceRef="paymentChoice" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-paymentDone" sourceRef="pay" targetRef="paymentDone" />
    <bpmn:sequenceFlow id="f-installment-paymentDone" sourceRef="installment" targetRef="paymentDone" />
    <bpmn:sequenceFlow id="f-paymentDone-readyForDelivery" sourceRef="paymentDone" targetRef="readyForDelivery" />
    <bpmn:sequenceFlow id="f-readyForDelivery-deliverItems" sourceRef="readyForDelivery" targetRef="deliverItems" />
    <bpmn:sequenceFlow id="f-deliverItems-returnDecision" sourceRef="deliverItems" targetRef="returnDecision" />
    <bpmn:sequenceFlow id="f-returnDecision-returnItems" name="Return items for exchange" sourceRef="returnDecision" targetRef="returnItems" />
    <bpmn:sequenceFlow id="f-returnItems-deliverItems" sourceRef="returnItems" targetRef="deliverItems" />
    <bpmn:sequenceFlow id="f-returnDecision-orderCompleted" sourceRef="returnDecision" targetRef="orderCompleted" />
  </bpmn:process>
</bpmn:definitions>
