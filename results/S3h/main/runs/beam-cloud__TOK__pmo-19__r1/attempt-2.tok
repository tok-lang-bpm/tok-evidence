tok 1.0 "Purchasing items from an online shop"

pool organisation "Online shop"
  lane user "User"
    start orderStarted "Order started"
    task login "Log in to account"
    and splitPurchase "Purchase activities"
    task selectItems "Select items to purchase"
    task setPayment "Set payment method"
    xor paymentChoice "Payment method"
    task pay "Pay"
    task installment "Complete installment agreement"
    xor paymentDone "Payment completed"
    task chooseReward "Choose free reward"
    and readyForDelivery "Ready for delivery"
    xor returnDecision "Return items for exchange?"
    task returnItems "Return items for exchange"
    end orderCompleted "Order completed"
  lane shop "Online shop"
    task deliverItems "Deliver items"

flow orderStarted -> login -> splitPurchase
flow splitPurchase -> selectItems
flow splitPurchase -> setPayment
flow selectItems -> chooseReward
flow chooseReward -> readyForDelivery
flow setPayment -> paymentChoice
flow paymentChoice -> pay "Pay"
flow paymentChoice -> installment "Complete installment agreement"
flow pay -> paymentDone
flow installment -> paymentDone
flow paymentDone -> readyForDelivery
flow readyForDelivery -> deliverItems
flow deliverItems -> returnDecision
flow returnDecision -> returnItems "Return items for exchange" when="return_for_exchange = true"
flow returnItems -> deliverItems
flow returnDecision -> orderCompleted "No return" default
