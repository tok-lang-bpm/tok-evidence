<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Shipment process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Shipment process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>goods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>startPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logisticsHead" name="Logistics department head">
        <bpmn:flowNodeRef>takeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepared</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="goods" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="large" name="Large amounts?" default="f-large-post" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one of them" />
    <bpmn:task id="post" name="Use normal post shipment" />
    <bpmn:exclusiveGateway id="method" name="Shipping method determined" />
    <bpmn:parallelGateway id="startPrep" name="Start preparation" />
    <bpmn:task id="writeLabel" name="Write package label" />
    <bpmn:exclusiveGateway id="insurance" name="Parcel insurance necessary?" default="f-insurance-ready" />
    <bpmn:parallelGateway id="ready" name="Everything ready?" />
    <bpmn:task id="takeInsurance" name="Take parcel insurance" />
    <bpmn:task id="package" name="Package goods" />
    <bpmn:task id="prepare" name="Prepare packaged goods for being picked up" />
    <bpmn:endEvent id="prepared" name="Packaged goods prepared for pickup" />
    <bpmn:sequenceFlow id="f-goods-clarify" sourceRef="goods" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-large" sourceRef="clarify" targetRef="large" />
    <bpmn:sequenceFlow id="f-large-invite" name="large amounts" sourceRef="large" targetRef="invite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">large</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-large-post" name="small amounts" sourceRef="large" targetRef="post" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-method" sourceRef="select" targetRef="method" />
    <bpmn:sequenceFlow id="f-post-method" sourceRef="post" targetRef="method" />
    <bpmn:sequenceFlow id="f-method-startPrep" sourceRef="method" targetRef="startPrep" />
    <bpmn:sequenceFlow id="f-startPrep-writeLabel" sourceRef="startPrep" targetRef="writeLabel" />
    <bpmn:sequenceFlow id="f-startPrep-insurance" sourceRef="startPrep" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-startPrep-package" sourceRef="startPrep" targetRef="package" />
    <bpmn:sequenceFlow id="f-insurance-takeInsurance" name="necessary" sourceRef="insurance" targetRef="takeInsurance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">necessary</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-insurance-ready" name="not necessary" sourceRef="insurance" targetRef="ready" />
    <bpmn:sequenceFlow id="f-takeInsurance-ready" sourceRef="takeInsurance" targetRef="ready" />
    <bpmn:sequenceFlow id="f-writeLabel-ready" sourceRef="writeLabel" targetRef="ready" />
    <bpmn:sequenceFlow id="f-package-ready" sourceRef="package" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-prepare" sourceRef="ready" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-prepared" sourceRef="prepare" targetRef="prepared" />
  </bpmn:process>
</bpmn:definitions>
