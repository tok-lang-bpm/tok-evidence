tok 1.0 "Credit scoring"

pool organisation "Organisation"
  lane clerk "Sales clerk"
    start requested "Credit scoring requested"
    task receive "Receive the credit scoring"
    end completed "Credit scoring completed"
  lane banking "Banking system"
    task send_request "Send a scoring request to the agency"
    task present_result "Present the result to the clerk"
    task display_delay "Display a message to check again later"
    task display_result "Display the scoring result at the frontend"
    and split_delay
    and join_delay
  lane agency "Agency"
    task score_level1 "Perform level 1 scoring"
    xor immediate "Immediate result?"
    task return_result "Return the result to the banking system"
    task inform_delay "Inform the banking process of the delay"
    task score_level2 "Perform level 2 scoring"
    task send_result "Send the scoring result to the banking system"

flow requested -> receive -> send_request -> score_level1 -> immediate
flow immediate -> return_result "yes" when="immediate"
flow immediate -> inform_delay "no" default
flow return_result -> present_result -> completed
flow inform_delay -> split_delay
flow split_delay -> display_delay
flow split_delay -> score_level2
flow display_delay -> join_delay
flow score_level2 -> send_result -> display_result -> join_delay
flow join_delay -> completed
