<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Restaurant service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant service" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>hungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick_up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enter_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect_money</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_off_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_over</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_five</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_guest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="hungry" name="Feeling hungry" />
    <bpmn:task id="enter" name="Enter the restaurant" />
    <bpmn:task id="choose" name="Choose a dish from the changing meal range" />
    <bpmn:task id="wait_turn" name="Wait until it is his turn" />
    <bpmn:task id="place_order" name="Place his order with the employee" />
    <bpmn:task id="pick_up" name="Pick up his meal" />
    <bpmn:task id="eat" name="Eat his meal" />
    <bpmn:endEvent id="done" name="Meal finished" />
    <bpmn:task id="enter_order" name="Enter the order into the POS system" />
    <bpmn:task id="collect_money" name="Collect the money from the guest" />
    <bpmn:task id="setup_buzzer" name="Set up a buzzer" />
    <bpmn:task id="pass_buzzer" name="Pass the buzzer to the guest" />
    <bpmn:task id="inform_chef" name="Inform the chef of the new meal order" />
    <bpmn:task id="set_off_buzzer" name="Set off the guest's buzzer" />
    <bpmn:exclusiveGateway id="reacts" name="Guest reacts to the buzzer?" default="f-reacts-wait_five" />
    <bpmn:task id="hand_over" name="Hand over the meal" />
    <bpmn:intermediateCatchEvent id="wait_five" name="5 minutes">
      <bpmn:timerEventDefinition id="wait_five-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="call_guest" name="Call for the guest" />
    <bpmn:task id="prepare" name="Prepare the meal" />
    <bpmn:task id="place_hatch" name="Place the meal in the service hatch" />
    <bpmn:task id="inform_ready" name="Inform the employee that the meal is in the service hatch" />
    <bpmn:sequenceFlow id="f-hungry-enter" sourceRef="hungry" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-choose" sourceRef="enter" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait_turn" sourceRef="choose" targetRef="wait_turn" />
    <bpmn:sequenceFlow id="f-wait_turn-place_order" sourceRef="wait_turn" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-enter_order" sourceRef="place_order" targetRef="enter_order" />
    <bpmn:sequenceFlow id="f-enter_order-collect_money" sourceRef="enter_order" targetRef="collect_money" />
    <bpmn:sequenceFlow id="f-collect_money-setup_buzzer" sourceRef="collect_money" targetRef="setup_buzzer" />
    <bpmn:sequenceFlow id="f-setup_buzzer-pass_buzzer" sourceRef="setup_buzzer" targetRef="pass_buzzer" />
    <bpmn:sequenceFlow id="f-pass_buzzer-inform_chef" sourceRef="pass_buzzer" targetRef="inform_chef" />
    <bpmn:sequenceFlow id="f-inform_chef-prepare" sourceRef="inform_chef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-place_hatch" sourceRef="prepare" targetRef="place_hatch" />
    <bpmn:sequenceFlow id="f-place_hatch-inform_ready" sourceRef="place_hatch" targetRef="inform_ready" />
    <bpmn:sequenceFlow id="f-inform_ready-set_off_buzzer" sourceRef="inform_ready" targetRef="set_off_buzzer" />
    <bpmn:sequenceFlow id="f-set_off_buzzer-reacts" sourceRef="set_off_buzzer" targetRef="reacts" />
    <bpmn:sequenceFlow id="f-reacts-hand_over" name="Reacted" sourceRef="reacts" targetRef="hand_over">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">guest_reacted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reacts-wait_five" name="No reaction" sourceRef="reacts" targetRef="wait_five" />
    <bpmn:sequenceFlow id="f-wait_five-call_guest" sourceRef="wait_five" targetRef="call_guest" />
    <bpmn:sequenceFlow id="f-call_guest-reacts" sourceRef="call_guest" targetRef="reacts" />
    <bpmn:sequenceFlow id="f-hand_over-pick_up" sourceRef="hand_over" targetRef="pick_up" />
    <bpmn:sequenceFlow id="f-pick_up-eat" sourceRef="pick_up" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-done" sourceRef="eat" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
