<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="jobmarket" name="Job market" processRef="jobmarket-process" />
  </bpmn:collaboration>
  <bpmn:process id="jobmarket-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="jobmarket-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ratecompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ratedone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>want</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateapp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateapplicant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start job search" />
    <bpmn:task id="report" name="Report job applications" />
    <bpmn:task id="negotiate" name="Negotiate job interview" />
    <bpmn:task id="enter" name="Enter probation phase" />
    <bpmn:task id="ratecompany" name="Rate company" />
    <bpmn:task id="receive" name="Receive job offers" />
    <bpmn:parallelGateway id="rates" name="Ratings" />
    <bpmn:parallelGateway id="ratedone" name="Ratings done" />
    <bpmn:exclusiveGateway id="want" name="Company wants you?" />
    <bpmn:exclusiveGateway id="permanent" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="rating" name="Rated C or less?" default="f-rating-found" />
    <bpmn:endEvent id="found" name="Job found" />
    <bpmn:task id="send" name="Send potential job offers" />
    <bpmn:task id="confirm" name="Confirm receipt of job applications" />
    <bpmn:task id="rateapp" name="Rate application" />
    <bpmn:task id="rateapplicant" name="Rate applicant" />
    <bpmn:sequenceFlow id="f-start-report" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-send" sourceRef="report" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-confirm" sourceRef="send" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rateapp" sourceRef="confirm" targetRef="rateapp" />
    <bpmn:sequenceFlow id="f-rateapp-negotiate" sourceRef="rateapp" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-want" sourceRef="negotiate" targetRef="want" />
    <bpmn:sequenceFlow id="f-want-enter" name="yes" sourceRef="want" targetRef="enter" />
    <bpmn:sequenceFlow id="f-want-report" name="no" sourceRef="want" targetRef="report" />
    <bpmn:sequenceFlow id="f-enter-rates" sourceRef="enter" targetRef="rates" />
    <bpmn:sequenceFlow id="f-rates-ratecompany" sourceRef="rates" targetRef="ratecompany" />
    <bpmn:sequenceFlow id="f-rates-rateapplicant" sourceRef="rates" targetRef="rateapplicant" />
    <bpmn:sequenceFlow id="f-ratecompany-ratedone" sourceRef="ratecompany" targetRef="ratedone" />
    <bpmn:sequenceFlow id="f-rateapplicant-ratedone" sourceRef="rateapplicant" targetRef="ratedone" />
    <bpmn:sequenceFlow id="f-ratedone-permanent" sourceRef="ratedone" targetRef="permanent" />
    <bpmn:sequenceFlow id="f-permanent-report" name="no" sourceRef="permanent" targetRef="report" />
    <bpmn:sequenceFlow id="f-permanent-rating" name="yes" sourceRef="permanent" targetRef="rating" />
    <bpmn:sequenceFlow id="f-rating-receive" name="C or less" sourceRef="rating" targetRef="receive" />
    <bpmn:sequenceFlow id="f-rating-found" name="better" sourceRef="rating" targetRef="found" />
    <bpmn:sequenceFlow id="f-receive-receive" sourceRef="receive" targetRef="receive" />
  </bpmn:process>
</bpmn:definitions>
