<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="org" name="Organisation">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_social</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notextended</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Maternity leave planning started" />
    <bpmn:task id="fetch" name="Fetch information about potential models" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="notify" name="Notify Social Security and Company in time" />
    <bpmn:task id="notify_social" name="Notify Social Security" />
    <bpmn:task id="notify_company" name="Notify Company" />
    <bpmn:parallelGateway id="notified" name="Notifications completed" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:task id="select" name="Let parent select" />
    <bpmn:task id="decide" name="Let parent decide about extension" />
    <bpmn:exclusiveGateway id="extend" name="Extend maternity leave?" default="f-extend-notextended" />
    <bpmn:endEvent id="extended" name="Maternity leave extended" />
    <bpmn:endEvent id="notextended" name="Maternity leave not extended" />
    <bpmn:sequenceFlow id="f-start-fetch" sourceRef="start" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-collect" sourceRef="select" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-notify" sourceRef="collect" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-notify_social" sourceRef="notify" targetRef="notify_social" />
    <bpmn:sequenceFlow id="f-notify-notify_company" sourceRef="notify" targetRef="notify_company" />
    <bpmn:sequenceFlow id="f-notify_social-notified" sourceRef="notify_social" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notify_company-notified" sourceRef="notify_company" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notified-gather" sourceRef="notified" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-decide" sourceRef="gather" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-extend" sourceRef="decide" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-extended" name="yes" sourceRef="extend" targetRef="extended" />
    <bpmn:sequenceFlow id="f-extend-notextended" name="no" sourceRef="extend" targetRef="notextended" />
  </bpmn:process>
</bpmn:definitions>
