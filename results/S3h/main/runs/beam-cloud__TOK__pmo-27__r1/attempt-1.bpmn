<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>discovered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_employer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_work_accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_near_miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_defect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reporter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_provider_employer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_insured</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="self_employed" name="Self-employed person">
        <bpmn:flowNodeRef>report_self</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="student" name="Student or schoolchild">
        <bpmn:flowNodeRef>report_directorate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="school" name="School, educational facility or university">
        <bpmn:flowNodeRef>report_school</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="insured" name="Insured party">
        <bpmn:flowNodeRef>report_written</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>private_fatality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_fatality_three</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ends" name="End states">
        <bpmn:flowNodeRef>near_miss_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>defect_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>student_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>school_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>private_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="discovered" name="Work accident or incident discovered" />
    <bpmn:task id="inform_employer" name="Inform the employer immediately" />
    <bpmn:task id="gather" name="Gather information about the work accident" />
    <bpmn:exclusiveGateway id="event_type" name="What is reported?" default="f-event_type-record_defect" />
    <bpmn:task id="record_work_accident" name="Record the work accident" />
    <bpmn:task id="record_near_miss" name="Record the near-miss incident" />
    <bpmn:task id="record_risk" name="Record the serious and immediate risk" />
    <bpmn:task id="record_defect" name="Record the defect in protection systems" />
    <bpmn:exclusiveGateway id="reporter" name="Who reports the accident?" default="f-reporter-report_written" />
    <bpmn:exclusiveGateway id="immediate" name="Fatal or serious injury not reported to emergency services?" default="f-immediate-merge_immediate" />
    <bpmn:task id="report_labour" name="Report the work accident to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="merge_immediate" name="Immediate report handled" />
    <bpmn:exclusiveGateway id="insured_check" name="Is the insured person killed or unable to work for three days?" default="f-insured_check-merge_insured" />
    <bpmn:task id="report_provider_employer" name="Report the work accident to the accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="merge_insured" name="Provider report handled" />
    <bpmn:task id="report_self" name="Report accidents involving employees and yourself to the accident insurance provider in good time" />
    <bpmn:task id="report_directorate" name="Report the accident to the competent directorate" />
    <bpmn:task id="report_school" name="Report every work accident to the accident insurance provider in triplicate within five days" />
    <bpmn:task id="report_written" name="Report the accident in writing immediately" />
    <bpmn:exclusiveGateway id="private_fatality" name="Is there a fatality?" default="f-private_fatality-private_end" />
    <bpmn:task id="report_fatality_three" name="Report the fatality within three days" />
    <bpmn:endEvent id="near_miss_end" name="Near-miss recorded" />
    <bpmn:endEvent id="risk_end" name="Risk recorded" />
    <bpmn:endEvent id="defect_end" name="Defect recorded" />
    <bpmn:endEvent id="work_end" name="Work accident reported" />
    <bpmn:endEvent id="self_end" name="Self-employed accident reported" />
    <bpmn:endEvent id="student_end" name="Student accident reported" />
    <bpmn:endEvent id="school_end" name="School accident reported" />
    <bpmn:endEvent id="private_end" name="Private insurance accident reported" />
    <bpmn:sequenceFlow id="f-discovered-inform_employer" sourceRef="discovered" targetRef="inform_employer" />
    <bpmn:sequenceFlow id="f-inform_employer-gather" sourceRef="inform_employer" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-event_type" sourceRef="gather" targetRef="event_type" />
    <bpmn:sequenceFlow id="f-event_type-record_work_accident" name="Work accident" sourceRef="event_type" targetRef="record_work_accident">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">is_work_accident</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-event_type-record_near_miss" name="Near-miss" sourceRef="event_type" targetRef="record_near_miss">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">is_near_miss</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-event_type-record_risk" name="Serious risk" sourceRef="event_type" targetRef="record_risk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">is_serious_risk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-event_type-record_defect" name="Defect in protection systems" sourceRef="event_type" targetRef="record_defect" />
    <bpmn:sequenceFlow id="f-record_near_miss-near_miss_end" sourceRef="record_near_miss" targetRef="near_miss_end" />
    <bpmn:sequenceFlow id="f-record_risk-risk_end" sourceRef="record_risk" targetRef="risk_end" />
    <bpmn:sequenceFlow id="f-record_defect-defect_end" sourceRef="record_defect" targetRef="defect_end" />
    <bpmn:sequenceFlow id="f-record_work_accident-reporter" sourceRef="record_work_accident" targetRef="reporter" />
    <bpmn:sequenceFlow id="f-reporter-immediate" name="Employer reports" sourceRef="reporter" targetRef="immediate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">report_by_employer</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reporter-report_self" name="Self-employed person reports" sourceRef="reporter" targetRef="report_self">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">report_by_self_employed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reporter-report_directorate" name="Student or schoolchild reports" sourceRef="reporter" targetRef="report_directorate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">report_by_student</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reporter-report_school" name="School or university reports" sourceRef="reporter" targetRef="report_school">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">report_by_school</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reporter-report_written" name="Insured party reports (private insurance)" sourceRef="reporter" targetRef="report_written" />
    <bpmn:sequenceFlow id="f-immediate-report_labour" name="Yes" sourceRef="immediate" targetRef="report_labour">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">immediate_report_required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-immediate-merge_immediate" name="No" sourceRef="immediate" targetRef="merge_immediate" />
    <bpmn:sequenceFlow id="f-report_labour-merge_immediate" sourceRef="report_labour" targetRef="merge_immediate" />
    <bpmn:sequenceFlow id="f-merge_immediate-insured_check" sourceRef="merge_immediate" targetRef="insured_check" />
    <bpmn:sequenceFlow id="f-insured_check-report_provider_employer" name="Yes" sourceRef="insured_check" targetRef="report_provider_employer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">provider_report_required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-insured_check-merge_insured" name="No" sourceRef="insured_check" targetRef="merge_insured" />
    <bpmn:sequenceFlow id="f-report_provider_employer-merge_insured" sourceRef="report_provider_employer" targetRef="merge_insured" />
    <bpmn:sequenceFlow id="f-merge_insured-work_end" sourceRef="merge_insured" targetRef="work_end" />
    <bpmn:sequenceFlow id="f-report_self-self_end" sourceRef="report_self" targetRef="self_end" />
    <bpmn:sequenceFlow id="f-report_directorate-student_end" sourceRef="report_directorate" targetRef="student_end" />
    <bpmn:sequenceFlow id="f-report_school-school_end" sourceRef="report_school" targetRef="school_end" />
    <bpmn:sequenceFlow id="f-report_written-private_fatality" sourceRef="report_written" targetRef="private_fatality" />
    <bpmn:sequenceFlow id="f-private_fatality-report_fatality_three" name="Fatality" sourceRef="private_fatality" targetRef="report_fatality_three">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_fatality</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-private_fatality-private_end" name="No fatality" sourceRef="private_fatality" targetRef="private_end" />
    <bpmn:sequenceFlow id="f-report_fatality_three-private_end" sourceRef="report_fatality_three" targetRef="private_end" />
  </bpmn:process>
</bpmn:definitions>
