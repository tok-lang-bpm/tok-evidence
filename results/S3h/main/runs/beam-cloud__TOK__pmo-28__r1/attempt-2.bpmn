<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="internship" name="Internship" processRef="internship-process" />
  </bpmn:collaboration>
  <bpmn:process id="internship-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="internship-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_experience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>write_company_updates</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="enter_topic" name="Enter topic and money" />
    <bpmn:task id="enter_experience" name="Enter experience and hobbies" />
    <bpmn:task id="receive_offer" name="Receive offer" />
    <bpmn:exclusiveGateway id="accept_offer" name="Accept offer?" default="f-accept_offer-deny" />
    <bpmn:task id="accept" name="Accept offer" />
    <bpmn:task id="deny" name="Deny offer" />
    <bpmn:task id="invalidate" name="Invalidate other offers" />
    <bpmn:parallelGateway id="update_start" name="Start status updates" />
    <bpmn:task id="write_updates" name="Write status updates">
      <bpmn:standardLoopCharacteristics loopMaximum="3" />
    </bpmn:task>
    <bpmn:parallelGateway id="update_join" name="Status updates finished" />
    <bpmn:task id="recommend" name="Recommend company to friends" />
    <bpmn:task id="tweet" name="Send tweet">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="write_company_updates" name="Write status updates">
      <bpmn:standardLoopCharacteristics loopMaximum="3" />
    </bpmn:task>
    <bpmn:sequenceFlow id="f-s-enter_topic" sourceRef="s" targetRef="enter_topic" />
    <bpmn:sequenceFlow id="f-enter_topic-enter_experience" sourceRef="enter_topic" targetRef="enter_experience" />
    <bpmn:sequenceFlow id="f-enter_experience-receive_offer" sourceRef="enter_experience" targetRef="receive_offer" />
    <bpmn:sequenceFlow id="f-receive_offer-accept_offer" sourceRef="receive_offer" targetRef="accept_offer" />
    <bpmn:sequenceFlow id="f-accept_offer-accept" name="accept" sourceRef="accept_offer" targetRef="accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accept_offer-deny" name="deny" sourceRef="accept_offer" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-receive_offer" sourceRef="deny" targetRef="receive_offer" />
    <bpmn:sequenceFlow id="f-accept-invalidate" sourceRef="accept" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f-invalidate-update_start" sourceRef="invalidate" targetRef="update_start" />
    <bpmn:sequenceFlow id="f-update_start-write_updates" sourceRef="update_start" targetRef="write_updates" />
    <bpmn:sequenceFlow id="f-update_start-write_company_updates" sourceRef="update_start" targetRef="write_company_updates" />
    <bpmn:sequenceFlow id="f-write_updates-update_join" sourceRef="write_updates" targetRef="update_join" />
    <bpmn:sequenceFlow id="f-write_company_updates-update_join" sourceRef="write_company_updates" targetRef="update_join" />
    <bpmn:sequenceFlow id="f-update_join-recommend" sourceRef="update_join" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-tweet" sourceRef="recommend" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-e" sourceRef="tweet" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
