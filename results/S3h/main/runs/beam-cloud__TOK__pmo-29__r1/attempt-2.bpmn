<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>combine_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>organize_accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate_accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open_bank_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_rwrc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>combine_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult_representations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact_representation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_travel_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present_insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prove_means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ensure_no_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gathered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>application_channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_representation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_border</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_police_extension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visa_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_schengen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_type_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_destination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_destination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equal_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_length_purpose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>territorial_ac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consular_district</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exceptional_justification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>austrian_representation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_of_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representation" name="Representation office">
        <bpmn:flowNodeRef>verify_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_competence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim_exceptional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refuse_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="border" name="Border control post">
        <bpmn:flowNodeRef>issue_border</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="State police headquarters">
        <bpmn:flowNodeRef>extend_visa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start0" name="Start process" />
    <bpmn:parallelGateway id="combine_split" name="Combine steps" />
    <bpmn:task id="organize_accommodation" name="Organize accommodation" />
    <bpmn:task id="negotiate_accommodation" name="Negotiate accommodation" />
    <bpmn:task id="open_bank_account" name="Open bank account" />
    <bpmn:task id="apply_rwrc" name="Apply for Rot-Weiss-Rot Card" />
    <bpmn:parallelGateway id="combine_join" name="Steps combined" />
    <bpmn:task id="consult_representations" name="Consult list of representation offices" />
    <bpmn:task id="contact_representation" name="Contact representation in advance" />
    <bpmn:parallelGateway id="gather" name="Gather visa requirements" />
    <bpmn:task id="complete_form" name="Complete visa application form" />
    <bpmn:task id="provide_travel_document" name="Present travel document" />
    <bpmn:task id="provide_photo" name="Provide passport photo" />
    <bpmn:task id="present_insurance" name="Present travel health insurance" />
    <bpmn:task id="prove_means" name="Prove sufficient means of subsistence" />
    <bpmn:task id="provide_evidence" name="Provide other evidence" />
    <bpmn:task id="ensure_no_refusal" name="Ensure absence of grounds for refusal" />
    <bpmn:parallelGateway id="gathered" name="Requirements gathered" />
    <bpmn:task id="submit_application" name="Submit visa application" />
    <bpmn:exclusiveGateway id="application_channel" name="Application channel?" default="f-application_channel-apply_representation" />
    <bpmn:task id="apply_representation" name="Apply at representation office" />
    <bpmn:task id="apply_border" name="Apply at border control post" />
    <bpmn:task id="apply_police_extension" name="Apply at state police headquarters" />
    <bpmn:exclusiveGateway id="visa_type" name="Visa type?" default="f-visa_type-apply_schengen" />
    <bpmn:task id="apply_schengen" name="Apply for Schengen visa" />
    <bpmn:task id="apply_type_d" name="Apply for type D visa" />
    <bpmn:exclusiveGateway id="main_destination" name="Main travel destination known?" default="f-main_destination-identify_destination" />
    <bpmn:task id="identify_destination" name="Identify main travel destination" />
    <bpmn:exclusiveGateway id="equal_time" name="Equal time in several countries?" default="f-equal_time-first_entry" />
    <bpmn:task id="decide_length_purpose" name="Decide based on length and purpose" />
    <bpmn:task id="first_entry" name="Country of first entry responsible" />
    <bpmn:exclusiveGateway id="territorial_ac" name="Territorial competence for A or C?" default="f-territorial_ac-consular_district" />
    <bpmn:task id="consular_district" name="Apply at consular district of residence" />
    <bpmn:task id="exceptional_justification" name="Provide justification for exceptional competence" />
    <bpmn:task id="austrian_representation" name="Apply at competent Austrian representation" />
    <bpmn:task id="place_of_interest" name="Prove place of residence or centre of interest" />
    <bpmn:task id="provide_additional" name="Provide additional documents" />
    <bpmn:endEvent id="issued" name="Visa issued" />
    <bpmn:endEvent id="refused" name="Application refused" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:task id="verify_documents" name="Verify documents" />
    <bpmn:task id="request_additional" name="Request additional documents" />
    <bpmn:task id="determine_competence" name="Determine territorial competence" />
    <bpmn:task id="claim_exceptional" name="Claim exceptional competence" />
    <bpmn:task id="issue_visa" name="Issue visa" />
    <bpmn:task id="refuse_visa" name="Refuse visa" />
    <bpmn:exclusiveGateway id="additional_needed" name="Additional documents requested?" default="f-additional_needed-approval_decision" />
    <bpmn:exclusiveGateway id="approval_decision" name="Application approved?" default="f-approval_decision-issue_visa" />
    <bpmn:task id="issue_border" name="Issue visa in exceptional case" />
    <bpmn:task id="extend_visa" name="Extend visa" />
    <bpmn:sequenceFlow id="f-start0-combine_split" sourceRef="start0" targetRef="combine_split" />
    <bpmn:sequenceFlow id="f-combine_split-organize_accommodation" sourceRef="combine_split" targetRef="organize_accommodation" />
    <bpmn:sequenceFlow id="f-combine_split-open_bank_account" sourceRef="combine_split" targetRef="open_bank_account" />
    <bpmn:sequenceFlow id="f-combine_split-apply_rwrc" sourceRef="combine_split" targetRef="apply_rwrc" />
    <bpmn:sequenceFlow id="f-organize_accommodation-negotiate_accommodation" sourceRef="organize_accommodation" targetRef="negotiate_accommodation" />
    <bpmn:sequenceFlow id="f-negotiate_accommodation-combine_join" sourceRef="negotiate_accommodation" targetRef="combine_join" />
    <bpmn:sequenceFlow id="f-open_bank_account-combine_join" sourceRef="open_bank_account" targetRef="combine_join" />
    <bpmn:sequenceFlow id="f-apply_rwrc-combine_join" sourceRef="apply_rwrc" targetRef="combine_join" />
    <bpmn:sequenceFlow id="f-combine_join-consult_representations" sourceRef="combine_join" targetRef="consult_representations" />
    <bpmn:sequenceFlow id="f-consult_representations-contact_representation" sourceRef="consult_representations" targetRef="contact_representation" />
    <bpmn:sequenceFlow id="f-contact_representation-gather" sourceRef="contact_representation" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-complete_form" sourceRef="gather" targetRef="complete_form" />
    <bpmn:sequenceFlow id="f-gather-provide_travel_document" sourceRef="gather" targetRef="provide_travel_document" />
    <bpmn:sequenceFlow id="f-gather-provide_photo" sourceRef="gather" targetRef="provide_photo" />
    <bpmn:sequenceFlow id="f-gather-present_insurance" sourceRef="gather" targetRef="present_insurance" />
    <bpmn:sequenceFlow id="f-gather-prove_means" sourceRef="gather" targetRef="prove_means" />
    <bpmn:sequenceFlow id="f-gather-provide_evidence" sourceRef="gather" targetRef="provide_evidence" />
    <bpmn:sequenceFlow id="f-gather-ensure_no_refusal" sourceRef="gather" targetRef="ensure_no_refusal" />
    <bpmn:sequenceFlow id="f-complete_form-gathered" sourceRef="complete_form" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-provide_travel_document-gathered" sourceRef="provide_travel_document" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-provide_photo-gathered" sourceRef="provide_photo" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-present_insurance-gathered" sourceRef="present_insurance" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-prove_means-gathered" sourceRef="prove_means" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-provide_evidence-gathered" sourceRef="provide_evidence" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-ensure_no_refusal-gathered" sourceRef="ensure_no_refusal" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-gathered-submit_application" sourceRef="gathered" targetRef="submit_application" />
    <bpmn:sequenceFlow id="f-submit_application-application_channel" sourceRef="submit_application" targetRef="application_channel" />
    <bpmn:sequenceFlow id="f-application_channel-apply_representation" name="Representation office" sourceRef="application_channel" targetRef="apply_representation" />
    <bpmn:sequenceFlow id="f-application_channel-apply_border" name="Border control post" sourceRef="application_channel" targetRef="apply_border">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">channel = "border"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-application_channel-apply_police_extension" name="State police headquarters" sourceRef="application_channel" targetRef="apply_police_extension">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">channel = "police"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-apply_border-issue_border" sourceRef="apply_border" targetRef="issue_border" />
    <bpmn:sequenceFlow id="f-issue_border-completed" sourceRef="issue_border" targetRef="completed" />
    <bpmn:sequenceFlow id="f-apply_police_extension-extend_visa" sourceRef="apply_police_extension" targetRef="extend_visa" />
    <bpmn:sequenceFlow id="f-extend_visa-completed" sourceRef="extend_visa" targetRef="completed" />
    <bpmn:sequenceFlow id="f-apply_representation-visa_type" sourceRef="apply_representation" targetRef="visa_type" />
    <bpmn:sequenceFlow id="f-visa_type-apply_schengen" name="Schengen visa" sourceRef="visa_type" targetRef="apply_schengen" />
    <bpmn:sequenceFlow id="f-visa_type-apply_type_d" name="Type D visa" sourceRef="visa_type" targetRef="apply_type_d">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visaType = "D"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-apply_schengen-main_destination" sourceRef="apply_schengen" targetRef="main_destination" />
    <bpmn:sequenceFlow id="f-apply_type_d-austrian_representation" sourceRef="apply_type_d" targetRef="austrian_representation" />
    <bpmn:sequenceFlow id="f-austrian_representation-place_of_interest" sourceRef="austrian_representation" targetRef="place_of_interest" />
    <bpmn:sequenceFlow id="f-place_of_interest-determine_competence" sourceRef="place_of_interest" targetRef="determine_competence" />
    <bpmn:sequenceFlow id="f-main_destination-identify_destination" name="Main destination known" sourceRef="main_destination" targetRef="identify_destination" />
    <bpmn:sequenceFlow id="f-main_destination-equal_time" name="No main destination" sourceRef="main_destination" targetRef="equal_time">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mainDestinationKnown = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equal_time-decide_length_purpose" name="Equal time" sourceRef="equal_time" targetRef="decide_length_purpose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">equalTime = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-equal_time-first_entry" name="Not equal time" sourceRef="equal_time" targetRef="first_entry" />
    <bpmn:sequenceFlow id="f-identify_destination-territorial_ac" sourceRef="identify_destination" targetRef="territorial_ac" />
    <bpmn:sequenceFlow id="f-decide_length_purpose-territorial_ac" sourceRef="decide_length_purpose" targetRef="territorial_ac" />
    <bpmn:sequenceFlow id="f-first_entry-territorial_ac" sourceRef="first_entry" targetRef="territorial_ac" />
    <bpmn:sequenceFlow id="f-territorial_ac-consular_district" name="Consular district" sourceRef="territorial_ac" targetRef="consular_district" />
    <bpmn:sequenceFlow id="f-territorial_ac-exceptional_justification" name="Exceptional competence" sourceRef="territorial_ac" targetRef="exceptional_justification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">exceptional = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-consular_district-determine_competence" sourceRef="consular_district" targetRef="determine_competence" />
    <bpmn:sequenceFlow id="f-exceptional_justification-claim_exceptional" sourceRef="exceptional_justification" targetRef="claim_exceptional" />
    <bpmn:sequenceFlow id="f-claim_exceptional-determine_competence" sourceRef="claim_exceptional" targetRef="determine_competence" />
    <bpmn:sequenceFlow id="f-determine_competence-verify_documents" sourceRef="determine_competence" targetRef="verify_documents" />
    <bpmn:sequenceFlow id="f-verify_documents-additional_needed" sourceRef="verify_documents" targetRef="additional_needed" />
    <bpmn:sequenceFlow id="f-additional_needed-request_additional" name="Yes" sourceRef="additional_needed" targetRef="request_additional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additionalNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-additional_needed-approval_decision" name="No" sourceRef="additional_needed" targetRef="approval_decision" />
    <bpmn:sequenceFlow id="f-request_additional-provide_additional" sourceRef="request_additional" targetRef="provide_additional" />
    <bpmn:sequenceFlow id="f-provide_additional-verify_documents" sourceRef="provide_additional" targetRef="verify_documents" />
    <bpmn:sequenceFlow id="f-approval_decision-issue_visa" name="Approved" sourceRef="approval_decision" targetRef="issue_visa" />
    <bpmn:sequenceFlow id="f-approval_decision-refuse_visa" name="Refused" sourceRef="approval_decision" targetRef="refuse_visa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-issue_visa-issued" sourceRef="issue_visa" targetRef="issued" />
    <bpmn:sequenceFlow id="f-refuse_visa-refused" sourceRef="refuse_visa" targetRef="refused" />
  </bpmn:process>
</bpmn:definitions>
