<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="planned" name="Planning needed" />
    <bpmn:task id="send" name="Send invitations" />
    <bpmn:task id="find_games" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="split" name="Split" />
    <bpmn:task id="appoint" name="Appoint a date" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree?" default="f-agree-appoint" />
    <bpmn:task id="check_games" name="Find out if you have all the games" />
    <bpmn:exclusiveGateway id="missing" name="Some games missing?" default="f-missing-join" />
    <bpmn:task id="download" name="Download them" />
    <bpmn:parallelGateway id="join" name="Join" />
    <bpmn:task id="find_beer" name="Find out how much beer your friends require" />
    <bpmn:exclusiveGateway id="enough_beer" name="Enough beer?" default="f-enough_beer-enjoy" />
    <bpmn:task id="buy" name="Buy what's missing" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="done" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f-planned-send" sourceRef="planned" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-find_games" sourceRef="send" targetRef="find_games" />
    <bpmn:sequenceFlow id="f-find_games-split" sourceRef="find_games" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-appoint" sourceRef="split" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-split-check_games" sourceRef="split" targetRef="check_games" />
    <bpmn:sequenceFlow id="f-appoint-agree" sourceRef="appoint" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-join" name="yes" sourceRef="agree" targetRef="join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreed &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-agree-appoint" name="no" sourceRef="agree" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-check_games-missing" sourceRef="check_games" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-download" name="yes" sourceRef="missing" targetRef="download">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">someMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-join" name="no" sourceRef="missing" targetRef="join" />
    <bpmn:sequenceFlow id="f-download-join" sourceRef="download" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-find_beer" sourceRef="join" targetRef="find_beer" />
    <bpmn:sequenceFlow id="f-find_beer-enough_beer" sourceRef="find_beer" targetRef="enough_beer" />
    <bpmn:sequenceFlow id="f-enough_beer-buy" name="no" sourceRef="enough_beer" targetRef="buy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notEnough</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough_beer-enjoy" name="yes" sourceRef="enough_beer" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-buy-enjoy" sourceRef="buy" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-done" sourceRef="enjoy" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
