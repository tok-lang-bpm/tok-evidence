<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:signal id="Signal_Expansion_released" name="Expansion released" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brainstorm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_bn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_bn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_bn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_character</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_initial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_selfies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="create" name="Create character" />
    <bpmn:parallelGateway id="split_initial" />
    <bpmn:task id="brainstorm" name="Come up with good character names" />
    <bpmn:task id="check_bn" name="Check whether you have a battle.net account" />
    <bpmn:exclusiveGateway id="has_bn" name="Have a battle.net account?" default="f-has_bn-merge_bn" />
    <bpmn:task id="enter_account" name="Enter the account information" />
    <bpmn:task id="click_link" name="Click the link received in the confirmation mail" />
    <bpmn:exclusiveGateway id="merge_bn" name="Battle.net account ready" />
    <bpmn:task id="check_sub" name="Check if you have an active WoW subscription" />
    <bpmn:exclusiveGateway id="has_sub" name="Have an active WoW subscription?" default="f-has_sub-merge_sub" />
    <bpmn:task id="select_payment" name="Select the payment method" />
    <bpmn:exclusiveGateway id="pay_method" name="Choose payment method?" />
    <bpmn:task id="enter_cc" name="Enter your credit card information" />
    <bpmn:task id="enter_iban" name="Enter your IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="merge_pay" name="Payment entered" />
    <bpmn:exclusiveGateway id="merge_sub" name="Subscription ready" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="select_character" name="Select realm, race and class" />
    <bpmn:parallelGateway id="join_initial" />
    <bpmn:task id="enter_name" name="Enter a character name" />
    <bpmn:exclusiveGateway id="name_available" name="Is the name still available?" default="f-name_available-split_reward" />
    <bpmn:parallelGateway id="split_reward" />
    <bpmn:task id="get_confirmation" name="Get a confirmation" />
    <bpmn:task id="get_selfies" name="Get some selfies of your character" />
    <bpmn:parallelGateway id="join_reward" />
    <bpmn:intermediateCatchEvent id="expansion" name="Expansion released">
      <bpmn:signalEventDefinition id="expansion-def" signalRef="Signal_Expansion_released" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="get_message" name="Get another message" />
    <bpmn:endEvent id="done" name="Character created" />
    <bpmn:sequenceFlow id="f-create-split_initial" sourceRef="create" targetRef="split_initial" />
    <bpmn:sequenceFlow id="f-split_initial-check_bn" sourceRef="split_initial" targetRef="check_bn" />
    <bpmn:sequenceFlow id="f-split_initial-brainstorm" sourceRef="split_initial" targetRef="brainstorm" />
    <bpmn:sequenceFlow id="f-check_bn-has_bn" sourceRef="check_bn" targetRef="has_bn" />
    <bpmn:sequenceFlow id="f-has_bn-enter_account" name="No" sourceRef="has_bn" targetRef="enter_account" />
    <bpmn:sequenceFlow id="f-has_bn-merge_bn" name="Yes" sourceRef="has_bn" targetRef="merge_bn" />
    <bpmn:sequenceFlow id="f-enter_account-click_link" sourceRef="enter_account" targetRef="click_link" />
    <bpmn:sequenceFlow id="f-click_link-merge_bn" sourceRef="click_link" targetRef="merge_bn" />
    <bpmn:sequenceFlow id="f-merge_bn-check_sub" sourceRef="merge_bn" targetRef="check_sub" />
    <bpmn:sequenceFlow id="f-check_sub-has_sub" sourceRef="check_sub" targetRef="has_sub" />
    <bpmn:sequenceFlow id="f-has_sub-select_payment" name="No" sourceRef="has_sub" targetRef="select_payment" />
    <bpmn:sequenceFlow id="f-has_sub-merge_sub" name="Yes" sourceRef="has_sub" targetRef="merge_sub" />
    <bpmn:sequenceFlow id="f-select_payment-pay_method" sourceRef="select_payment" targetRef="pay_method" />
    <bpmn:sequenceFlow id="f-pay_method-enter_cc" name="Credit card" sourceRef="pay_method" targetRef="enter_cc" />
    <bpmn:sequenceFlow id="f-pay_method-enter_iban" name="Bank account" sourceRef="pay_method" targetRef="enter_iban" />
    <bpmn:sequenceFlow id="f-enter_cc-merge_pay" sourceRef="enter_cc" targetRef="merge_pay" />
    <bpmn:sequenceFlow id="f-enter_iban-merge_pay" sourceRef="enter_iban" targetRef="merge_pay" />
    <bpmn:sequenceFlow id="f-merge_pay-merge_sub" sourceRef="merge_pay" targetRef="merge_sub" />
    <bpmn:sequenceFlow id="f-merge_sub-login" sourceRef="merge_sub" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-select_character" sourceRef="login" targetRef="select_character" />
    <bpmn:sequenceFlow id="f-select_character-join_initial" sourceRef="select_character" targetRef="join_initial" />
    <bpmn:sequenceFlow id="f-brainstorm-join_initial" sourceRef="brainstorm" targetRef="join_initial" />
    <bpmn:sequenceFlow id="f-join_initial-enter_name" sourceRef="join_initial" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-enter_name-name_available" sourceRef="enter_name" targetRef="name_available" />
    <bpmn:sequenceFlow id="f-name_available-enter_name" name="No" sourceRef="name_available" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-name_available-split_reward" name="Yes" sourceRef="name_available" targetRef="split_reward" />
    <bpmn:sequenceFlow id="f-split_reward-get_confirmation" sourceRef="split_reward" targetRef="get_confirmation" />
    <bpmn:sequenceFlow id="f-split_reward-get_selfies" sourceRef="split_reward" targetRef="get_selfies" />
    <bpmn:sequenceFlow id="f-get_confirmation-join_reward" sourceRef="get_confirmation" targetRef="join_reward" />
    <bpmn:sequenceFlow id="f-get_selfies-join_reward" sourceRef="get_selfies" targetRef="join_reward" />
    <bpmn:sequenceFlow id="f-join_reward-expansion" sourceRef="join_reward" targetRef="expansion" />
    <bpmn:sequenceFlow id="f-expansion-get_message" sourceRef="expansion" targetRef="get_message" />
    <bpmn:sequenceFlow id="f-get_message-done" sourceRef="get_message" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
