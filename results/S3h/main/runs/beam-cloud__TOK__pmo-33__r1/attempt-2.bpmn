<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Instruct an artist to create a 3D model print it on a 3D printer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Instruct an artist to create a 3D model print it on a 3D printer" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plastic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turnon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatbed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatextruder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Need custom 3D model" />
    <bpmn:task id="instruct" name="Instruct artist to create project" />
    <bpmn:task id="send" name="Send sketches" />
    <bpmn:task id="tell" name="Tell changes" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with result?" default="f-satisfied-choose" />
    <bpmn:task id="choose" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="stock" name="Color in stock?" default="f-stock-check" />
    <bpmn:task id="check" name="Check color amount left" />
    <bpmn:exclusiveGateway id="under" name="Under 100 grams?" default="f-under-plastic" />
    <bpmn:task id="putlist" name="Put color on shopping list" />
    <bpmn:task id="order" name="Order color" />
    <bpmn:exclusiveGateway id="plastic" name="Plastic available" />
    <bpmn:parallelGateway id="prep" name="Prepare printing" />
    <bpmn:task id="turnon" name="Turn printer on" />
    <bpmn:task id="heatbed" name="Heat up bed" />
    <bpmn:task id="heatextruder" name="Heat up extruder" />
    <bpmn:task id="gcode" name="Generate gcode file" />
    <bpmn:parallelGateway id="ready" name="Ready to print" />
    <bpmn:task id="print" name="Print model" />
    <bpmn:endEvent id="done" name="Model printed" />
    <bpmn:sequenceFlow id="f-s-instruct" sourceRef="s" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-send" sourceRef="instruct" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-tell" sourceRef="send" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-satisfied" sourceRef="tell" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-satisfied-tell" name="No" sourceRef="satisfied" targetRef="tell">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">satisfied = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-satisfied-choose" name="Yes" sourceRef="satisfied" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-stock" sourceRef="choose" targetRef="stock" />
    <bpmn:sequenceFlow id="f-stock-check" name="In stock" sourceRef="stock" targetRef="check" />
    <bpmn:sequenceFlow id="f-stock-order" name="Not in stock" sourceRef="stock" targetRef="order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">inStock = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-check-under" sourceRef="check" targetRef="under" />
    <bpmn:sequenceFlow id="f-under-putlist" name="Under 100 g" sourceRef="under" targetRef="putlist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amountLeft &lt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-under-plastic" name="Enough color" sourceRef="under" targetRef="plastic" />
    <bpmn:sequenceFlow id="f-putlist-plastic" sourceRef="putlist" targetRef="plastic" />
    <bpmn:sequenceFlow id="f-order-plastic" sourceRef="order" targetRef="plastic" />
    <bpmn:sequenceFlow id="f-plastic-prep" sourceRef="plastic" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-turnon" sourceRef="prep" targetRef="turnon" />
    <bpmn:sequenceFlow id="f-prep-gcode" sourceRef="prep" targetRef="gcode" />
    <bpmn:sequenceFlow id="f-turnon-heatbed" sourceRef="turnon" targetRef="heatbed" />
    <bpmn:sequenceFlow id="f-turnon-heatextruder" sourceRef="turnon" targetRef="heatextruder" />
    <bpmn:sequenceFlow id="f-heatbed-ready" sourceRef="heatbed" targetRef="ready" />
    <bpmn:sequenceFlow id="f-heatextruder-ready" sourceRef="heatextruder" targetRef="ready" />
    <bpmn:sequenceFlow id="f-gcode-ready" sourceRef="gcode" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-print" sourceRef="ready" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-done" sourceRef="print" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
