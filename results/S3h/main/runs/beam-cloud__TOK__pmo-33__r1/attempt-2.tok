tok 1.0 "Instruct an artist to create a 3D model print it on a 3D printer"

pool org "Organisation"
  lane you "You"
    start s "Need custom 3D model"
    task instruct "Instruct artist to create project"
    task send "Send sketches"
    task tell "Tell changes"
    xor satisfied "Satisfied with result?"
    task choose "Choose plastic color"
    xor stock "Color in stock?"
    task check "Check color amount left"
    xor under "Under 100 grams?"
    task putlist "Put color on shopping list"
    task order "Order color"
    xor plastic "Plastic available"
    and prep "Prepare printing"
    task turnon "Turn printer on"
    task heatbed "Heat up bed"
    task heatextruder "Heat up extruder"
    task gcode "Generate gcode file"
    and ready "Ready to print"
    task print "Print model"
    end done "Model printed"

    flow s -> instruct -> send -> tell -> satisfied
    flow satisfied -> tell "No" when="satisfied = false"
    flow satisfied -> choose "Yes" default
    flow choose -> stock
    flow stock -> check "In stock" default
    flow stock -> order "Not in stock" when="inStock = false"
    flow check -> under
    flow under -> putlist "Under 100 g" when="amountLeft < 100"
    flow under -> plastic "Enough color" default
    flow putlist -> plastic
    flow order -> plastic
    flow plastic -> prep
    flow prep -> turnon
    flow prep -> gcode
    flow turnon -> heatbed
    flow turnon -> heatextruder
    flow heatbed -> ready
    flow heatextruder -> ready
    flow gcode -> ready
    flow ready -> print -> done
