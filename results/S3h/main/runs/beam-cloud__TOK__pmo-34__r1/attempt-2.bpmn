<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>successful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="design" name="Develop basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give Lego sets to children" />
    <bpmn:task id="build" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="parts" name="No more parts in container?" default="f-parts-test" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="successful" name="Test successful?" default="f-successful-more" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="rebuild" name="Rebuild subcomponent" />
    <bpmn:exclusiveGateway id="more" name="More subcomponents?" default="f-more-assemble" />
    <bpmn:task id="assemble" name="Assemble subcomponents" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:sequenceFlow id="f-s-design" sourceRef="s" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-build" sourceRef="sort" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-parts" sourceRef="build" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-reorder" name="yes" sourceRef="parts" targetRef="reorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no_more_parts</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-parts-test" name="no" sourceRef="parts" targetRef="test" />
    <bpmn:sequenceFlow id="f-reorder-build" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f-test-successful" sourceRef="test" targetRef="successful" />
    <bpmn:sequenceFlow id="f-successful-redesign" name="no" sourceRef="successful" targetRef="redesign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not_successful</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-successful-more" name="yes" sourceRef="successful" targetRef="more" />
    <bpmn:sequenceFlow id="f-redesign-rebuild" sourceRef="redesign" targetRef="rebuild" />
    <bpmn:sequenceFlow id="f-rebuild-test" sourceRef="rebuild" targetRef="test" />
    <bpmn:sequenceFlow id="f-more-build" name="yes" sourceRef="more" targetRef="build">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">more_subcomponents</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-assemble" name="no" sourceRef="more" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-e" sourceRef="assemble" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
