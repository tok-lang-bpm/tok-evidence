tok 1.0 "Building a custom machine out of Lego bricks"

pool org "Organisation"
  lane you "You"
    start s "Start"
    task design "Develop basic design"
    task order "Order Lego brick sets"
    task give "Give Lego sets to children"
    task build "Build subcomponent"
    xor parts "No more parts in container?"
    task reorder "Reorder individual parts"
    task test "Test subcomponent"
    xor successful "Test successful?"
    task redesign "Redesign subcomponent"
    task rebuild "Rebuild subcomponent"
    xor more "More subcomponents?"
    task assemble "Assemble subcomponents"
    end e "End"
  lane children "Children"
    task sort "Sort parts into containers"

flow s -> design -> order -> give -> sort -> build
flow build -> parts
flow parts -> reorder "yes" when="no_more_parts"
flow parts -> test "no" default
flow reorder -> build
flow test -> successful
flow successful -> redesign "no" when="not_successful"
flow successful -> more "yes" default
flow redesign -> rebuild
flow rebuild -> test
flow more -> build "yes" when="more_subcomponents"
flow more -> assemble "no" default
flow assemble -> e
