tok 1.0 "Chainsaw"

pool org "Chainsaw Manufacturer"
  lane customer "Customer"
    start needed "Order received"
    task tell "Tell properties"
  lane manufacturer "Manufacturer"
    task order "Order parts" parallel
    catch parts "Parts arrived" message="parts arrived"
    task inspect "Inspect parts"
    task assemble "Assemble parts"
    task produce_first "Produce first saw"
    task send_first "Send first saw"
    xor likes "Customer likes first saw?"
    task produce_rest "Produce rest of order"
    end done "Order completed"
    end stopped "Order stopped" terminate
    eventsub updates "Send updates"
      start update_due "Update due" timer=P1D
      task send_update "Send updates"
      end update_done "Update sent"

flow needed -> tell -> order
flow order -> parts -> inspect -> assemble -> produce_first -> send_first -> likes
flow likes -> produce_rest "yes"
flow likes -> stopped "no" default
flow produce_rest -> done
