tok 1.0 "Luxury Airplane"

pool manufacturer "Manufacturer"
  lane customer "Customer"
    start start "Start"
    task decide "Decide specifications"
    task confirm "Confirm delivery"
    end confirmed "Delivery confirmed"
  lane manufacturer "Manufacturer"
    task receive "Receive specifications"
    task send "Send requirements"
    and manufacture "Manufacture parts"
    and manufactured "Parts manufactured"
    task receive_parts "Receive bits and pieces"
    task assemble "Assemble interior"
    task test_flight "Send plane on test flight"
    task protocol "Create test protocol"
    task send_protocol "Send test protocol"
    task deliver "Deliver plane"
  lane russian "Russian team"
    task vodka "Manufacture vodka bar"
  lane irish "Irish team"
    task whiskey "Manufacture whiskey bar"

flow start -> decide -> receive
flow receive -> send
flow send -> manufacture
flow manufacture -> vodka
flow manufacture -> whiskey
flow vodka -> manufactured
flow whiskey -> manufactured
flow manufactured -> receive_parts
flow receive_parts -> assemble -> test_flight -> protocol -> send_protocol -> deliver
flow deliver -> confirm -> confirmed
