<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="manufacturer" name="Manufacturer" processRef="manufacturer-process" />
  </bpmn:collaboration>
  <bpmn:process id="manufacturer-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="manufacturer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manu" name="Manufacturer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufacture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufactured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian" name="Russian team">
        <bpmn:flowNodeRef>vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish" name="Irish team">
        <bpmn:flowNodeRef>whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="decide" name="Decide specifications" />
    <bpmn:task id="confirm" name="Confirm delivery" />
    <bpmn:endEvent id="confirmed" name="Delivery confirmed" />
    <bpmn:task id="receive" name="Receive specifications" />
    <bpmn:task id="send" name="Send requirements" />
    <bpmn:parallelGateway id="manufacture" name="Manufacture parts" />
    <bpmn:parallelGateway id="manufactured" name="Parts manufactured" />
    <bpmn:task id="receive_parts" name="Receive bits and pieces" />
    <bpmn:task id="assemble" name="Assemble interior" />
    <bpmn:task id="test_flight" name="Send plane on test flight" />
    <bpmn:task id="protocol" name="Create test protocol" />
    <bpmn:task id="send_protocol" name="Send test protocol" />
    <bpmn:task id="deliver" name="Deliver plane" />
    <bpmn:task id="vodka" name="Manufacture vodka bar" />
    <bpmn:task id="whiskey" name="Manufacture whiskey bar" />
    <bpmn:sequenceFlow id="f-start-decide" sourceRef="start" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-receive" sourceRef="decide" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-send" sourceRef="receive" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-manufacture" sourceRef="send" targetRef="manufacture" />
    <bpmn:sequenceFlow id="f-manufacture-vodka" sourceRef="manufacture" targetRef="vodka" />
    <bpmn:sequenceFlow id="f-manufacture-whiskey" sourceRef="manufacture" targetRef="whiskey" />
    <bpmn:sequenceFlow id="f-vodka-manufactured" sourceRef="vodka" targetRef="manufactured" />
    <bpmn:sequenceFlow id="f-whiskey-manufactured" sourceRef="whiskey" targetRef="manufactured" />
    <bpmn:sequenceFlow id="f-manufactured-receive_parts" sourceRef="manufactured" targetRef="receive_parts" />
    <bpmn:sequenceFlow id="f-receive_parts-assemble" sourceRef="receive_parts" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-test_flight" sourceRef="assemble" targetRef="test_flight" />
    <bpmn:sequenceFlow id="f-test_flight-protocol" sourceRef="test_flight" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-protocol-send_protocol" sourceRef="protocol" targetRef="send_protocol" />
    <bpmn:sequenceFlow id="f-send_protocol-deliver" sourceRef="send_protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
