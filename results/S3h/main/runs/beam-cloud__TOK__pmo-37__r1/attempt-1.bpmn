<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Parts" name="Parts" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordermany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reordercheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderfast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkzero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Contract project started" />
    <bpmn:task id="query" name="Query all web shops" />
    <bpmn:task id="find" name="Find out how much they can deliver, at which price, and how long it will take" />
    <bpmn:task id="list" name="Create list of parts to order from each shop" />
    <bpmn:task id="cheap" name="Use cheapest parts" />
    <bpmn:exclusiveGateway id="enough" name="One shop has enough parts?" />
    <bpmn:task id="orderone" name="Order from one shop" />
    <bpmn:task id="ordermany" name="Order from several shops" />
    <bpmn:exclusiveGateway id="ordered" name="Parts ordered" />
    <bpmn:intermediateCatchEvent id="arrive" name="Parts arrive">
      <bpmn:messageEventDefinition id="arrive-def" messageRef="Message_Parts" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="build" name="Start building" />
    <bpmn:exclusiveGateway id="check5" name="Stock below 5?" default="f-check5-done" />
    <bpmn:task id="reordercheap" name="Reorder cheapest parts" />
    <bpmn:exclusiveGateway id="check3" name="Stock below 3?" />
    <bpmn:task id="reorderfast" name="Reorder fastest parts" />
    <bpmn:exclusiveGateway id="checkzero" name="Stock zero?" />
    <bpmn:task id="mail" name="Write mail to friends complaining about webshops" />
    <bpmn:endEvent id="done" name="Project completed" />
    <bpmn:endEvent id="complaint" name="Complaint sent" />
    <bpmn:sequenceFlow id="f-s-query" sourceRef="s" targetRef="query" />
    <bpmn:sequenceFlow id="f-query-find" sourceRef="query" targetRef="find" />
    <bpmn:sequenceFlow id="f-find-list" sourceRef="find" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-cheap" sourceRef="list" targetRef="cheap" />
    <bpmn:sequenceFlow id="f-cheap-enough" sourceRef="cheap" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-orderone" name="yes" sourceRef="enough" targetRef="orderone" />
    <bpmn:sequenceFlow id="f-enough-ordermany" name="no" sourceRef="enough" targetRef="ordermany" />
    <bpmn:sequenceFlow id="f-orderone-ordered" sourceRef="orderone" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-ordermany-ordered" sourceRef="ordermany" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-ordered-arrive" sourceRef="ordered" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-build" sourceRef="arrive" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-check5" sourceRef="build" targetRef="check5" />
    <bpmn:sequenceFlow id="f-check5-reordercheap" name="yes" sourceRef="check5" targetRef="reordercheap" />
    <bpmn:sequenceFlow id="f-check5-done" name="no" sourceRef="check5" targetRef="done" />
    <bpmn:sequenceFlow id="f-reordercheap-check3" sourceRef="reordercheap" targetRef="check3" />
    <bpmn:sequenceFlow id="f-check3-reorderfast" name="yes" sourceRef="check3" targetRef="reorderfast" />
    <bpmn:sequenceFlow id="f-check3-build" name="no" sourceRef="check3" targetRef="build" />
    <bpmn:sequenceFlow id="f-reorderfast-checkzero" sourceRef="reorderfast" targetRef="checkzero" />
    <bpmn:sequenceFlow id="f-checkzero-mail" name="yes" sourceRef="checkzero" targetRef="mail" />
    <bpmn:sequenceFlow id="f-checkzero-build" name="no" sourceRef="checkzero" targetRef="build" />
    <bpmn:sequenceFlow id="f-mail-complaint" sourceRef="mail" targetRef="complaint" />
  </bpmn:process>
</bpmn:definitions>
