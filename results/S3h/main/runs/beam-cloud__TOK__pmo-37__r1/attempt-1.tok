tok 1.0 "Contract"

pool org "Organisation"
  lane you "You"
    start s "Contract project started"
    task query "Query all web shops"
    task find "Find out how much they can deliver, at which price, and how long it will take"
    task list "Create list of parts to order from each shop"
    task cheap "Use cheapest parts"
    xor enough "One shop has enough parts?"
    task orderone "Order from one shop"
    task ordermany "Order from several shops"
    xor ordered "Parts ordered"
    catch arrive "Parts arrive" message="Parts"
    task build "Start building"
    xor check5 "Stock below 5?"
    task reordercheap "Reorder cheapest parts"
    xor check3 "Stock below 3?"
    task reorderfast "Reorder fastest parts"
    xor checkzero "Stock zero?"
    task mail "Write mail to friends complaining about webshops"
    end done "Project completed"
    end complaint "Complaint sent"

flow s -> query -> find -> list -> cheap -> enough
flow enough -> orderone "yes"
flow enough -> ordermany "no"
flow orderone -> ordered
flow ordermany -> ordered
flow ordered -> arrive -> build -> check5
flow check5 -> reordercheap "yes"
flow check5 -> done "no" default
flow reordercheap -> check3
flow check3 -> reorderfast "yes"
flow check3 -> build "no"
flow reorderfast -> checkzero
flow checkzero -> mail "yes"
flow checkzero -> build "no"
flow mail -> complaint
