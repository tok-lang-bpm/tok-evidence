tok 1.0 "Contract"

pool org "Organisation"
  lane you "You"
    start s "Contract project started"
    task query "Query all web shops"
    task find "Find out how much they can deliver, at which price, and how long it will take"
    task create "Create a list of parts to order from each shop"
    task cheapest "Always use the cheapest parts"
    xor enough "One shop has enough parts?"
    task orderone "Order from one shop"
    task ordermany "Order from several shops"
    xor ordered "Parts ordered"
    catch parts "Parts arrive" message="Parts"
    task build "Start building"
    xor below5 "Stock below 5?"
    task reordercheap "Reorder the cheapest parts"
    xor below3 "Stock below 3?"
    task reorderfast "Reorder the fastest parts"
    xor zero "Stock zero?"
    task mail "Write a mail to your friends complaining about the webshops"
    end done "Project completed"
    end complaint "Complaint sent"

flow s -> query -> find -> create -> cheapest -> enough
flow enough -> orderone "yes" when="enoughParts"
flow enough -> ordermany "no" default
flow orderone -> ordered
flow ordermany -> ordered
flow ordered -> parts -> build -> below5
flow below5 -> reordercheap "yes" when="stock < 5"
flow below5 -> done "no" default
flow reordercheap -> below3
flow below3 -> reorderfast "yes" when="stock < 3"
flow below3 -> build "no" default
flow reorderfast -> zero
flow zero -> mail "yes" when="stock = 0"
flow zero -> build "no" default
flow mail -> complaint
