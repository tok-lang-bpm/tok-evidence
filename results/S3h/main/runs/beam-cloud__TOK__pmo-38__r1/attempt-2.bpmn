<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="House project" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_invites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Tree house architect">
        <bpmn:flowNodeRef>send_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online stores">
        <bpmn:flowNodeRef>process_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build_house</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Start" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="send_req" name="Send requirements to architect" />
    <bpmn:task id="refine" name="Refine draft">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="create_materials" name="Create list of needed materials" />
    <bpmn:task id="order" name="Order materials" />
    <bpmn:parallelGateway id="parallel" name="Start concurrent work" />
    <bpmn:task id="send_friends" name="Send messages to friends" />
    <bpmn:parallelGateway id="join" name="Concurrent work complete" />
    <bpmn:task id="send_invites" name="Send invitations" />
    <bpmn:task id="create_attendees" name="Create list of attendees" />
    <bpmn:endEvent id="complete" name="House project complete" />
    <bpmn:task id="send_draft" name="Send draft" />
    <bpmn:task id="process_order" name="Process order" />
    <bpmn:task id="build_house" name="Build house" />
    <bpmn:sequenceFlow id="f-begin-collect" sourceRef="begin" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-send_req" sourceRef="collect" targetRef="send_req" />
    <bpmn:sequenceFlow id="f-send_req-send_draft" sourceRef="send_req" targetRef="send_draft" />
    <bpmn:sequenceFlow id="f-send_draft-refine" sourceRef="send_draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-create_materials" sourceRef="refine" targetRef="create_materials" />
    <bpmn:sequenceFlow id="f-create_materials-order" sourceRef="create_materials" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-parallel" sourceRef="order" targetRef="parallel" />
    <bpmn:sequenceFlow id="f-parallel-process_order" sourceRef="parallel" targetRef="process_order" />
    <bpmn:sequenceFlow id="f-process_order-join" sourceRef="process_order" targetRef="join" />
    <bpmn:sequenceFlow id="f-parallel-send_friends" sourceRef="parallel" targetRef="send_friends" />
    <bpmn:sequenceFlow id="f-send_friends-build_house" sourceRef="send_friends" targetRef="build_house" />
    <bpmn:sequenceFlow id="f-build_house-join" sourceRef="build_house" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-send_invites" sourceRef="join" targetRef="send_invites" />
    <bpmn:sequenceFlow id="f-send_invites-create_attendees" sourceRef="send_invites" targetRef="create_attendees" />
    <bpmn:sequenceFlow id="f-create_attendees-complete" sourceRef="create_attendees" targetRef="complete" />
  </bpmn:process>
</bpmn:definitions>
