tok 1.0 "Building a House"

pool house "House project"
  lane you "You"
    start begin "Start"
    task collect "Collect requirements"
    task send_req "Send requirements to architect"
    task refine "Refine draft" loop
    task create_materials "Create list of needed materials"
    task order "Order materials"
    and parallel "Start concurrent work"
    task send_friends "Send messages to friends"
    and join "Concurrent work complete"
    task send_invites "Send invitations"
    task create_attendees "Create list of attendees"
    end complete "House project complete"
  lane architect "Tree house architect"
    task send_draft "Send draft"
  lane stores "Online stores"
    task process_order "Process order"
  lane friends "Friends"
    task build_house "Build house"

flow begin -> collect -> send_req -> send_draft -> refine -> create_materials -> order -> parallel
flow parallel -> process_order -> join
flow parallel -> send_friends -> build_house -> join
flow join -> send_invites -> create_attendees -> complete
