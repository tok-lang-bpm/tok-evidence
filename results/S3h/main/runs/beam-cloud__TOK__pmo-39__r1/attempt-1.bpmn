<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="repair" name="DIY Repair of a Broken Smartphone Screen" processRef="repair-process" />
  </bpmn:collaboration>
  <bpmn:process id="repair-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="repair-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online Tool">
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Start repair" />
    <bpmn:task id="enter" name="Enter the model and what is broken" />
    <bpmn:parallelGateway id="split" name="Split order sources" />
    <bpmn:task id="contact" name="Contact friends" />
    <bpmn:task id="buy" name="Buy the rest" />
    <bpmn:parallelGateway id="merge" name="Merge order sources" />
    <bpmn:task id="receive" name="Receive instructions how to fix your phone" />
    <bpmn:task id="fix" name="Fix your phone" />
    <bpmn:exclusiveGateway id="worked" name="Did it work?" default="f-worked-expert" />
    <bpmn:task id="review" name="Send a review and/or video" />
    <bpmn:task id="expert" name="Send it to an expert" />
    <bpmn:endEvent id="success" name="Repair reviewed" />
    <bpmn:endEvent id="failed" name="Sent to expert" />
    <bpmn:task id="provide" name="Give the list of materials, the list of tools, and ordering choices" />
    <bpmn:sequenceFlow id="f-begin-enter" sourceRef="begin" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-provide" sourceRef="enter" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-split" sourceRef="provide" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-contact" sourceRef="split" targetRef="contact" />
    <bpmn:sequenceFlow id="f-split-buy" sourceRef="split" targetRef="buy" />
    <bpmn:sequenceFlow id="f-contact-merge" sourceRef="contact" targetRef="merge" />
    <bpmn:sequenceFlow id="f-buy-merge" sourceRef="buy" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-receive" sourceRef="merge" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-fix" sourceRef="receive" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-worked" sourceRef="fix" targetRef="worked" />
    <bpmn:sequenceFlow id="f-worked-review" name="yes" sourceRef="worked" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">worked</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-worked-expert" name="no" sourceRef="worked" targetRef="expert" />
    <bpmn:sequenceFlow id="f-review-success" sourceRef="review" targetRef="success" />
    <bpmn:sequenceFlow id="f-expert-failed" sourceRef="expert" targetRef="failed" />
  </bpmn:process>
</bpmn:definitions>
