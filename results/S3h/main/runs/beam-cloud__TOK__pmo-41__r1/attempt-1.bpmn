<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="inspection" name="Inspection" processRef="inspection-process" />
  </bpmn:collaboration>
  <bpmn:process id="inspection-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="inspection-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterSerial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inputValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pressButtons</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="application" name="Application">
        <bpmn:flowNodeRef>askQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>showValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askAdditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enterType" name="Enter type of machine" />
    <bpmn:task id="enterSerial" name="Enter serial number" />
    <bpmn:task id="inputValues" name="Input values" />
    <bpmn:task id="pressButtons" name="Press buttons" />
    <bpmn:task id="askQuestions" name="Ask questions" />
    <bpmn:task id="collectValues" name="Collect values" />
    <bpmn:task id="showValues" name="Show values" />
    <bpmn:task id="askAdditional" name="Ask additional questions" />
    <bpmn:exclusiveGateway id="additional" name="Additional questions?" default="f-additional-complete" />
    <bpmn:endEvent id="complete" name="Inspection complete" />
    <bpmn:sequenceFlow id="f-start-enterType" sourceRef="start" targetRef="enterType" />
    <bpmn:sequenceFlow id="f-enterType-enterSerial" sourceRef="enterType" targetRef="enterSerial" />
    <bpmn:sequenceFlow id="f-enterSerial-askQuestions" sourceRef="enterSerial" targetRef="askQuestions" />
    <bpmn:sequenceFlow id="f-askQuestions-inputValues" sourceRef="askQuestions" targetRef="inputValues" />
    <bpmn:sequenceFlow id="f-inputValues-pressButtons" sourceRef="inputValues" targetRef="pressButtons" />
    <bpmn:sequenceFlow id="f-pressButtons-collectValues" sourceRef="pressButtons" targetRef="collectValues" />
    <bpmn:sequenceFlow id="f-collectValues-showValues" sourceRef="collectValues" targetRef="showValues" />
    <bpmn:sequenceFlow id="f-showValues-additional" sourceRef="showValues" targetRef="additional" />
    <bpmn:sequenceFlow id="f-additional-askAdditional" name="yes" sourceRef="additional" targetRef="askAdditional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-additional-complete" name="no" sourceRef="additional" targetRef="complete" />
    <bpmn:sequenceFlow id="f-askAdditional-complete" sourceRef="askAdditional" targetRef="complete" />
  </bpmn:process>
</bpmn:definitions>
