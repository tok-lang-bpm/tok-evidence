tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool inspection "Inspection"
  lane inspector "Inspector"
    start start "Start"
    task enterType "Enter type of machine"
    task enterSerial "Enter serial number"
    task inputValues "Input values"
    task pressButtons "Press buttons"
  lane application "Application"
    task askQuestions "Ask questions"
    task collectValues "Collect values"
    task showValues "Show values"
    task askAdditional "Ask additional questions"
    xor additional "Additional questions?"
    end complete "Inspection complete"

flow start -> enterType -> enterSerial -> askQuestions -> inputValues -> pressButtons -> collectValues -> showValues -> additional
flow additional -> askAdditional "yes" when=""
flow additional -> complete "no" default
flow askAdditional -> complete
