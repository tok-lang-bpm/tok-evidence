<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="service" name="Service for Your Fridge" processRef="service-process" />
  </bpmn:collaboration>
  <bpmn:process id="service-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="service-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>noises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Local service facility">
        <bpmn:flowNodeRef>appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_repaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>can_repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noises" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe symptoms" />
    <bpmn:task id="send" name="Send symptoms and fridge type" />
    <bpmn:task id="confirm" name="Confirm fridge is OK" />
    <bpmn:task id="rate" name="Rate service facility" />
    <bpmn:endEvent id="completed" name="Service completed" />
    <bpmn:task id="select" name="Select local service facility" />
    <bpmn:task id="appointment" name="Make an appointment" />
    <bpmn:task id="arrive" name="Arrive at customer" />
    <bpmn:task id="repair" name="Repair fridge" />
    <bpmn:task id="leave" name="Leave without repairing" />
    <bpmn:endEvent id="not_repaired" name="Fridge not repaired" />
    <bpmn:exclusiveGateway id="can_repair" name="Can repair fridge?" default="f-can_repair-leave" />
    <bpmn:exclusiveGateway id="rate_service" name="Rate service facility?" default="f-rate_service-rate_merge" />
    <bpmn:exclusiveGateway id="rate_merge" />
    <bpmn:sequenceFlow id="f-noises-describe" sourceRef="noises" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appointment" sourceRef="select" targetRef="appointment" />
    <bpmn:sequenceFlow id="f-appointment-arrive" sourceRef="appointment" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-can_repair" sourceRef="arrive" targetRef="can_repair" />
    <bpmn:sequenceFlow id="f-can_repair-repair" name="yes" sourceRef="can_repair" targetRef="repair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">canRepair</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-can_repair-leave" name="no" sourceRef="can_repair" targetRef="leave" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate_service" sourceRef="confirm" targetRef="rate_service" />
    <bpmn:sequenceFlow id="f-rate_service-rate" name="yes" sourceRef="rate_service" targetRef="rate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wantToRate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rate_service-rate_merge" name="no" sourceRef="rate_service" targetRef="rate_merge" />
    <bpmn:sequenceFlow id="f-rate-rate_merge" sourceRef="rate" targetRef="rate_merge" />
    <bpmn:sequenceFlow id="f-rate_merge-completed" sourceRef="rate_merge" targetRef="completed" />
    <bpmn:sequenceFlow id="f-leave-not_repaired" sourceRef="leave" targetRef="not_repaired" />
  </bpmn:process>
</bpmn:definitions>
