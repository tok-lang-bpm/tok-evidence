tok 1.0 "Service for Your Fridge"

pool service "Service for Your Fridge"
  lane customer "Customer"
    start noises "Fridge produces strange noises"
    task describe "Describe symptoms"
    task send "Send symptoms and fridge type"
    task confirm "Confirm fridge is OK"
    task rate "Rate service facility"
    end completed "Service completed"
  lane center "Central fridge service center"
    task select "Select local service facility"
  lane facility "Local service facility"
    task appointment "Make an appointment"
    task arrive "Arrive at customer"
    task repair "Repair fridge"
    task leave "Leave without repairing"
    end not_repaired "Fridge not repaired"
    xor can_repair "Can repair fridge?"
    xor rate_service "Rate service facility?"
    xor rate_merge

flow noises -> describe -> send -> select -> appointment -> arrive -> can_repair
flow can_repair -> repair "yes" when="canRepair"
flow can_repair -> leave "no" default
flow repair -> confirm -> rate_service
flow rate_service -> rate "yes" when="wantToRate"
flow rate_service -> rate_merge "no" default
flow rate -> rate_merge
flow rate_merge -> completed
flow leave -> not_repaired
