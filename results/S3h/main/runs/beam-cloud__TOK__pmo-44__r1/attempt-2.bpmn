<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Robotic Burger Seller" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_sides</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose_side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="receive" name="Receive order" />
    <bpmn:task id="ask_menu" name="Ask whether customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="gw_menu" name="Customer wants a menu?" default="f-gw_menu-menu_merge" />
    <bpmn:parallelGateway id="menu_fork" />
    <bpmn:task id="prepare_drink" name="Prepare drink" />
    <bpmn:task id="ask_sides" name="Ask whether customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="choose_side" name="Customer wants fries or wedges?" default="f-choose_side-prepare_wedges" />
    <bpmn:task id="prepare_fries" name="Prepare fries" />
    <bpmn:task id="prepare_wedges" name="Prepare wedges" />
    <bpmn:exclusiveGateway id="side_merge" name="Side prepared" />
    <bpmn:parallelGateway id="menu_join" />
    <bpmn:exclusiveGateway id="menu_merge" name="Menu path complete?" />
    <bpmn:task id="prepare_burger" name="Prepare burger" />
    <bpmn:task id="deliver" name="Deliver order" />
    <bpmn:endEvent id="done" name="Order delivered" />
    <bpmn:sequenceFlow id="f-start-receive" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-ask_menu" sourceRef="receive" targetRef="ask_menu" />
    <bpmn:sequenceFlow id="f-ask_menu-gw_menu" sourceRef="ask_menu" targetRef="gw_menu" />
    <bpmn:sequenceFlow id="f-gw_menu-menu_fork" name="menu" sourceRef="gw_menu" targetRef="menu_fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wantsMenu</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw_menu-menu_merge" name="just burger" sourceRef="gw_menu" targetRef="menu_merge" />
    <bpmn:sequenceFlow id="f-menu_fork-prepare_drink" sourceRef="menu_fork" targetRef="prepare_drink" />
    <bpmn:sequenceFlow id="f-menu_fork-ask_sides" sourceRef="menu_fork" targetRef="ask_sides" />
    <bpmn:sequenceFlow id="f-ask_sides-choose_side" sourceRef="ask_sides" targetRef="choose_side" />
    <bpmn:sequenceFlow id="f-choose_side-prepare_fries" name="fries" sourceRef="choose_side" targetRef="prepare_fries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wantsFries</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-choose_side-prepare_wedges" name="wedges" sourceRef="choose_side" targetRef="prepare_wedges" />
    <bpmn:sequenceFlow id="f-prepare_fries-side_merge" sourceRef="prepare_fries" targetRef="side_merge" />
    <bpmn:sequenceFlow id="f-prepare_wedges-side_merge" sourceRef="prepare_wedges" targetRef="side_merge" />
    <bpmn:sequenceFlow id="f-side_merge-menu_join" sourceRef="side_merge" targetRef="menu_join" />
    <bpmn:sequenceFlow id="f-prepare_drink-menu_join" sourceRef="prepare_drink" targetRef="menu_join" />
    <bpmn:sequenceFlow id="f-menu_join-menu_merge" sourceRef="menu_join" targetRef="menu_merge" />
    <bpmn:sequenceFlow id="f-menu_merge-prepare_burger" sourceRef="menu_merge" targetRef="prepare_burger" />
    <bpmn:sequenceFlow id="f-prepare_burger-deliver" sourceRef="prepare_burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-done" sourceRef="deliver" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
