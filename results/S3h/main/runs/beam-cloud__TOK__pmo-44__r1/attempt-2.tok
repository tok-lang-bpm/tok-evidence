tok 1.0 "Robotic Burger Seller near the University of Vienna"

pool shop "Robotic Burger Seller"
  lane robot "Robot"
    start start "Start"
    task receive "Receive order"
    task ask_menu "Ask whether customer wants a menu or just the burger"
    xor gw_menu "Customer wants a menu?"
    and menu_fork
    task prepare_drink "Prepare drink"
    task ask_sides "Ask whether customer wants fries or wedges"
    xor choose_side "Customer wants fries or wedges?"
    task prepare_fries "Prepare fries"
    task prepare_wedges "Prepare wedges"
    xor side_merge "Side prepared"
    and menu_join
    xor menu_merge "Menu path complete?"
    task prepare_burger "Prepare burger"
    task deliver "Deliver order"
    end done "Order delivered"

flow start -> receive -> ask_menu -> gw_menu
flow gw_menu -> menu_fork "menu" when="wantsMenu"
flow gw_menu -> menu_merge "just burger" default
flow menu_fork -> prepare_drink
flow menu_fork -> ask_sides
flow ask_sides -> choose_side
flow choose_side -> prepare_fries "fries" when="wantsFries"
flow choose_side -> prepare_wedges "wedges" default
flow prepare_fries -> side_merge
flow prepare_wedges -> side_merge
flow side_merge -> menu_join
flow prepare_drink -> menu_join
flow menu_join -> menu_merge
flow menu_merge -> prepare_burger -> deliver -> done
