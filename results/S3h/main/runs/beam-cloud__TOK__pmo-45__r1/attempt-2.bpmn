<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online Shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all_selected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_shipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipping_equal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stop_shopping</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="eshop" name="E-Shop System">
        <bpmn:flowNodeRef>check_credentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_successful</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shopping" name="Shopping System">
        <bpmn:flowNodeRef>finish_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish_order_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>confirm_payment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="login" name="Log into E-Shop system" />
    <bpmn:task id="wait_login" name="Wait for login confirmation" />
    <bpmn:task id="select" name="Select product" />
    <bpmn:task id="add_cart" name="Add product to shopping cart" />
    <bpmn:task id="save" name="Save product" />
    <bpmn:task id="check_all" name="Check if every product was selected" />
    <bpmn:exclusiveGateway id="all_selected" name="All products selected?" default="f-all_selected-select" />
    <bpmn:task id="enter_payment" name="Enter payment data" />
    <bpmn:task id="wait_payment" name="Wait for payment confirmation" />
    <bpmn:task id="enter_shipping" name="Enter shipping address" />
    <bpmn:exclusiveGateway id="shipping_equal" name="Shipping address equals billing address?" default="f-shipping_equal-enter_billing" />
    <bpmn:task id="enter_billing" name="Enter billing address" />
    <bpmn:endEvent id="stop_shopping" name="Shopping experience stops" />
    <bpmn:task id="check_credentials" name="Check credentials" />
    <bpmn:parallelGateway id="login_and" name="Login processing" />
    <bpmn:parallelGateway id="login_join" name="Login completed" />
    <bpmn:exclusiveGateway id="login_successful" name="Login successful?" default="f-login_successful-stop_shopping" />
    <bpmn:task id="finish_order" name="Finish order" />
    <bpmn:parallelGateway id="prepare_and" name="Prepare payment and shipment" />
    <bpmn:task id="prepare_payment" name="Prepare payment" />
    <bpmn:task id="prepare_shipment" name="Prepare shipment" />
    <bpmn:parallelGateway id="payment_and" name="Payment processing" />
    <bpmn:parallelGateway id="payment_join" name="Payment completed" />
    <bpmn:parallelGateway id="final_and" name="Address and payment completed" />
    <bpmn:task id="finish_order_final" name="Finish order" />
    <bpmn:endEvent id="order_finished" name="Order finished" />
    <bpmn:task id="confirm_payment" name="Confirm payment" />
    <bpmn:sequenceFlow id="f-start-login" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-login_and" sourceRef="login" targetRef="login_and" />
    <bpmn:sequenceFlow id="f-login_and-wait_login" sourceRef="login_and" targetRef="wait_login" />
    <bpmn:sequenceFlow id="f-login_and-check_credentials" sourceRef="login_and" targetRef="check_credentials" />
    <bpmn:sequenceFlow id="f-wait_login-login_join" sourceRef="wait_login" targetRef="login_join" />
    <bpmn:sequenceFlow id="f-check_credentials-login_join" sourceRef="check_credentials" targetRef="login_join" />
    <bpmn:sequenceFlow id="f-login_join-login_successful" sourceRef="login_join" targetRef="login_successful" />
    <bpmn:sequenceFlow id="f-login_successful-select" name="Yes" sourceRef="login_successful" targetRef="select">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">login_successful</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-login_successful-stop_shopping" name="No" sourceRef="login_successful" targetRef="stop_shopping" />
    <bpmn:sequenceFlow id="f-select-add_cart" sourceRef="select" targetRef="add_cart" />
    <bpmn:sequenceFlow id="f-add_cart-save" sourceRef="add_cart" targetRef="save" />
    <bpmn:sequenceFlow id="f-save-check_all" sourceRef="save" targetRef="check_all" />
    <bpmn:sequenceFlow id="f-check_all-all_selected" sourceRef="check_all" targetRef="all_selected" />
    <bpmn:sequenceFlow id="f-all_selected-finish_order" name="Yes" sourceRef="all_selected" targetRef="finish_order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all_products_selected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-all_selected-select" name="No" sourceRef="all_selected" targetRef="select" />
    <bpmn:sequenceFlow id="f-finish_order-prepare_and" sourceRef="finish_order" targetRef="prepare_and" />
    <bpmn:sequenceFlow id="f-prepare_and-prepare_payment" sourceRef="prepare_and" targetRef="prepare_payment" />
    <bpmn:sequenceFlow id="f-prepare_and-prepare_shipment" sourceRef="prepare_and" targetRef="prepare_shipment" />
    <bpmn:sequenceFlow id="f-prepare_payment-enter_payment" sourceRef="prepare_payment" targetRef="enter_payment" />
    <bpmn:sequenceFlow id="f-prepare_shipment-enter_shipping" sourceRef="prepare_shipment" targetRef="enter_shipping" />
    <bpmn:sequenceFlow id="f-enter_payment-payment_and" sourceRef="enter_payment" targetRef="payment_and" />
    <bpmn:sequenceFlow id="f-payment_and-wait_payment" sourceRef="payment_and" targetRef="wait_payment" />
    <bpmn:sequenceFlow id="f-payment_and-confirm_payment" sourceRef="payment_and" targetRef="confirm_payment" />
    <bpmn:sequenceFlow id="f-wait_payment-payment_join" sourceRef="wait_payment" targetRef="payment_join" />
    <bpmn:sequenceFlow id="f-confirm_payment-payment_join" sourceRef="confirm_payment" targetRef="payment_join" />
    <bpmn:sequenceFlow id="f-payment_join-final_and" sourceRef="payment_join" targetRef="final_and" />
    <bpmn:sequenceFlow id="f-enter_shipping-shipping_equal" sourceRef="enter_shipping" targetRef="shipping_equal" />
    <bpmn:sequenceFlow id="f-shipping_equal-final_and" name="Yes" sourceRef="shipping_equal" targetRef="final_and">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">shipping_address_equals_billing_address</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-shipping_equal-enter_billing" name="No" sourceRef="shipping_equal" targetRef="enter_billing" />
    <bpmn:sequenceFlow id="f-enter_billing-final_and" sourceRef="enter_billing" targetRef="final_and" />
    <bpmn:sequenceFlow id="f-final_and-finish_order_final" sourceRef="final_and" targetRef="finish_order_final" />
    <bpmn:sequenceFlow id="f-finish_order_final-order_finished" sourceRef="finish_order_final" targetRef="order_finished" />
  </bpmn:process>
</bpmn:definitions>
