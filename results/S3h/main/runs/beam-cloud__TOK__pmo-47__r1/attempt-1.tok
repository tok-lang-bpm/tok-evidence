tok 1.0 "New Application for Registering for an USI course"

pool org "Organisation"
  lane applicant "Applicant"
    start want "Want to register for a USI course"
    task select_course "Select a course"
    task select_one "Select one"
    task check_account "Check if already has an account"
    task check_university "Check registered at an eligible university"
    task register_account "Register account"
    task request_activation "Request activation"
    task wait_response "Wait for response"
    task log_in "Log into account"
    task tweet "Tweet to friends"
    task complete_registration "Complete registration"
    task provide_payment "Provide payment information"
    task receive_ticket "Receive course ticket"
    xor gw_account "Already has an account?"
    xor gw_uni "Registered at an eligible university?"
    xor account_merge "Account ready"
    end done "Course registration completed"
    end no_slots "No slots available"
  lane system "System"
    task tell_courses "Tell courses and dates"
    xor slots "Slots free?"

flow want -> select_course -> slots
flow slots -> tell_courses "yes" when="slotsFree"
flow slots -> no_slots "no" default
flow tell_courses -> select_one -> check_account -> gw_account
flow gw_account -> account_merge "yes" when="hasAccount"
flow gw_account -> check_university "no" default
flow check_university -> gw_uni
flow gw_uni -> register_account "yes" when="registeredAtUniversity"
flow gw_uni -> request_activation "no" default
flow request_activation -> wait_response -> account_merge
flow register_account -> account_merge
flow account_merge -> log_in -> tweet -> complete_registration -> provide_payment -> receive_ticket -> done
