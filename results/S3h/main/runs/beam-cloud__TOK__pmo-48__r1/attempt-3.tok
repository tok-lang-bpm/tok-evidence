tok 1.0 "App For Participating at the Vienna Night Run"

pool organisation "Vienna Night Run"
  lane participant "Participant"
    start start_participation "Want to participate"
    task select_block "Select starting block"
    task run_5km "Run for 5km"
    task train "Train"
    task check "Check"
    task get_number "Get starting number"
    task from_home "Go there from home"
    task from_work "Leave directly from work"
    xor travel_merge "Travel route merged"
    and parallel_start "Run and drink"
    task run_race "Run"
    task drink "Drink"
    and parallel_end "Running and drinking done"
    task receive_time "Receive final running time"
    xor speed_check "Can do it in less than 25 minutes?"
    xor goal_check "Achieved the goal?"
    xor travel_check "More than one hour left?"
    end finish "Finished"
  lane gadget "Fitness Gadget"
    task measure_time "Measure the time"

flow start_participation -> select_block -> run_5km -> measure_time -> speed_check
flow speed_check -> get_number "yes" when="time < 25"
flow speed_check -> train "no" default
flow train -> check -> goal_check
flow goal_check -> get_number "yes" when="achieved"
flow goal_check -> train "no" default
flow get_number -> travel_check
flow travel_check -> from_home "yes" when="hoursLeft > 1"
flow travel_check -> from_work "no" default
flow from_home -> travel_merge
flow from_work -> travel_merge
flow travel_merge -> parallel_start
flow parallel_start -> run_race
flow parallel_start -> drink
flow run_race -> parallel_end
flow drink -> parallel_end
flow parallel_end -> receive_time -> finish
