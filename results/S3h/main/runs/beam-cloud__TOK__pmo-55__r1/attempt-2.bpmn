<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Ultrasound-guided venous catheter insertion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Ultrasound-guided venous catheter insertion" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gel_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pos_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pos_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>id_anat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>id_dopp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>id_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_ident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install_wire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_long</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_wire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wirepos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirepos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_wire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify_flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify_reflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="prepare" name="Prepare implements" />
    <bpmn:task id="wash" name="Wash hands" />
    <bpmn:task id="sterile_clothes" name="Get in sterile clothes" />
    <bpmn:task id="clean" name="Clean puncture area" />
    <bpmn:task id="drape" name="Drape puncture zone" />
    <bpmn:task id="config" name="Configure ultrasound" />
    <bpmn:task id="gel_probe" name="Put gel in probe" />
    <bpmn:task id="cover_probe" name="Cover probe" />
    <bpmn:task id="sterile_gel" name="Put sterile gel" />
    <bpmn:task id="pos_probe" name="Position probe" />
    <bpmn:task id="pos_patient" name="Position patient" />
    <bpmn:exclusiveGateway id="ident" name="Identification method?" default="f-ident-id_comp" />
    <bpmn:task id="id_anat" name="Identify vein by anatomic identification" />
    <bpmn:task id="id_dopp" name="Identify vein by doppler identification" />
    <bpmn:task id="id_comp" name="Identify vein by compression identification" />
    <bpmn:exclusiveGateway id="join_ident" />
    <bpmn:task id="anest" name="Anesthetize patient" />
    <bpmn:task id="puncture" name="Puncture patient" />
    <bpmn:task id="check_blood" name="Check blood return" />
    <bpmn:exclusiveGateway id="blood" name="Blood return correct?" default="f-blood-puncture" />
    <bpmn:task id="drop_probe" name="Drop probe" />
    <bpmn:task id="remove_syringe" name="Remove syringe" />
    <bpmn:task id="install_wire" name="Install guidewire" />
    <bpmn:task id="remove_trocar" name="Remove trocar" />
    <bpmn:exclusiveGateway id="wire_check" name="Wire check method?" default="f-wire_check-check_short" />
    <bpmn:task id="check_long" name="Check wire in long axis" />
    <bpmn:task id="check_short" name="Check wire in short axis" />
    <bpmn:exclusiveGateway id="join_wire" />
    <bpmn:task id="check_wirepos" name="Check wire position" />
    <bpmn:exclusiveGateway id="wirepos" name="Wire in good position?" default="f-wirepos-puncture" />
    <bpmn:task id="widen" name="Widen pathway" />
    <bpmn:task id="advance" name="Advance catheter" />
    <bpmn:task id="remove_wire" name="Remove guidewire" />
    <bpmn:task id="verify_flow" name="Verify flow" />
    <bpmn:task id="verify_reflow" name="Verify reflow" />
    <bpmn:task id="check_position" name="Check catheter position" />
    <bpmn:endEvent id="done" name="End" />
    <bpmn:sequenceFlow id="f-s-prepare" sourceRef="s" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-wash" sourceRef="prepare" targetRef="wash" />
    <bpmn:sequenceFlow id="f-wash-sterile_clothes" sourceRef="wash" targetRef="sterile_clothes" />
    <bpmn:sequenceFlow id="f-sterile_clothes-clean" sourceRef="sterile_clothes" targetRef="clean" />
    <bpmn:sequenceFlow id="f-clean-drape" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-config" sourceRef="drape" targetRef="config" />
    <bpmn:sequenceFlow id="f-config-gel_probe" sourceRef="config" targetRef="gel_probe" />
    <bpmn:sequenceFlow id="f-gel_probe-cover_probe" sourceRef="gel_probe" targetRef="cover_probe" />
    <bpmn:sequenceFlow id="f-cover_probe-sterile_gel" sourceRef="cover_probe" targetRef="sterile_gel" />
    <bpmn:sequenceFlow id="f-sterile_gel-pos_probe" sourceRef="sterile_gel" targetRef="pos_probe" />
    <bpmn:sequenceFlow id="f-pos_probe-pos_patient" sourceRef="pos_probe" targetRef="pos_patient" />
    <bpmn:sequenceFlow id="f-pos_patient-ident" sourceRef="pos_patient" targetRef="ident" />
    <bpmn:sequenceFlow id="f-ident-id_anat" name="anatomic" sourceRef="ident" targetRef="id_anat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">anatomic</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ident-id_dopp" name="doppler" sourceRef="ident" targetRef="id_dopp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">doppler</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ident-id_comp" name="compression" sourceRef="ident" targetRef="id_comp" />
    <bpmn:sequenceFlow id="f-id_anat-join_ident" sourceRef="id_anat" targetRef="join_ident" />
    <bpmn:sequenceFlow id="f-id_dopp-join_ident" sourceRef="id_dopp" targetRef="join_ident" />
    <bpmn:sequenceFlow id="f-id_comp-join_ident" sourceRef="id_comp" targetRef="join_ident" />
    <bpmn:sequenceFlow id="f-join_ident-anest" sourceRef="join_ident" targetRef="anest" />
    <bpmn:sequenceFlow id="f-anest-puncture" sourceRef="anest" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-puncture-check_blood" sourceRef="puncture" targetRef="check_blood" />
    <bpmn:sequenceFlow id="f-check_blood-blood" sourceRef="check_blood" targetRef="blood" />
    <bpmn:sequenceFlow id="f-blood-puncture" name="not correct" sourceRef="blood" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-blood-drop_probe" name="correct" sourceRef="blood" targetRef="drop_probe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bloodReturn</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-drop_probe-remove_syringe" sourceRef="drop_probe" targetRef="remove_syringe" />
    <bpmn:sequenceFlow id="f-remove_syringe-install_wire" sourceRef="remove_syringe" targetRef="install_wire" />
    <bpmn:sequenceFlow id="f-install_wire-remove_trocar" sourceRef="install_wire" targetRef="remove_trocar" />
    <bpmn:sequenceFlow id="f-remove_trocar-wire_check" sourceRef="remove_trocar" targetRef="wire_check" />
    <bpmn:sequenceFlow id="f-wire_check-check_long" name="long axis" sourceRef="wire_check" targetRef="check_long">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">longAxis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wire_check-check_short" name="short axis" sourceRef="wire_check" targetRef="check_short" />
    <bpmn:sequenceFlow id="f-check_long-join_wire" sourceRef="check_long" targetRef="join_wire" />
    <bpmn:sequenceFlow id="f-check_short-join_wire" sourceRef="check_short" targetRef="join_wire" />
    <bpmn:sequenceFlow id="f-join_wire-check_wirepos" sourceRef="join_wire" targetRef="check_wirepos" />
    <bpmn:sequenceFlow id="f-check_wirepos-wirepos" sourceRef="check_wirepos" targetRef="wirepos" />
    <bpmn:sequenceFlow id="f-wirepos-puncture" name="not in good position" sourceRef="wirepos" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-wirepos-widen" name="in good position" sourceRef="wirepos" targetRef="widen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wireGood</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-widen-advance" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f-advance-remove_wire" sourceRef="advance" targetRef="remove_wire" />
    <bpmn:sequenceFlow id="f-remove_wire-verify_flow" sourceRef="remove_wire" targetRef="verify_flow" />
    <bpmn:sequenceFlow id="f-verify_flow-verify_reflow" sourceRef="verify_flow" targetRef="verify_reflow" />
    <bpmn:sequenceFlow id="f-verify_reflow-check_position" sourceRef="verify_reflow" targetRef="check_position" />
    <bpmn:sequenceFlow id="f-check_position-done" sourceRef="check_position" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
