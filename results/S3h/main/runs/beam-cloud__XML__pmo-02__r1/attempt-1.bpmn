<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="hiring-process" />
  </bpmn:collaboration>
  <bpmn:process id="hiring-process" isExecutable="false">
    <bpmn:laneSet id="hiring-lanes">
      <bpmn:lane id="department-lane" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr-lane" name="HR">
        <bpmn:flowNodeRef>create-job-description</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post-job-description</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen-resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initial-phone-interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite-candidates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview-type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>in-person-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews-merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-candidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salary-negotiations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate-salary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiations-merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="new-hire-lane" name="New Hire">
        <bpmn:flowNodeRef>complete-paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend-orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete-training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fully-integrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need for new hire identified" />
    <bpmn:task id="identify-need" name="Identify need for new hire" />
    <bpmn:task id="create-job-description" name="Create job description" />
    <bpmn:task id="post-job-description" name="Post job description on job boards" />
    <bpmn:task id="collect-resumes" name="Collect resumes" />
    <bpmn:task id="screen-resumes" name="Screen resumes" />
    <bpmn:task id="initial-phone-interviews" name="Conduct initial phone interviews" />
    <bpmn:task id="invite-candidates" name="Invite selected candidates for interviews" />
    <bpmn:exclusiveGateway id="interview-type" name="In-person or virtual interview?" />
    <bpmn:task id="in-person-interview" name="Conduct in-person interview" />
    <bpmn:task id="virtual-interview" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="interviews-merged" />
    <bpmn:task id="choose-candidate" name="Choose candidate" />
    <bpmn:task id="extend-offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="salary-negotiations" name="Salary negotiations?" />
    <bpmn:task id="negotiate-salary" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="negotiations-merged" />
    <bpmn:exclusiveGateway id="offer-accepted" name="Offer accepted?" />
    <bpmn:parallelGateway id="onboarding-split" />
    <bpmn:task id="complete-paperwork" name="Complete paperwork" />
    <bpmn:task id="attend-orientation" name="Attend orientation" />
    <bpmn:task id="complete-training" name="Complete training" />
    <bpmn:parallelGateway id="onboarding-join" />
    <bpmn:endEvent id="fully-integrated" name="New hire fully integrated" />
    <bpmn:endEvent id="offer-declined" name="Offer declined" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify-need" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify-need" targetRef="create-job-description" />
    <bpmn:sequenceFlow id="f3" sourceRef="create-job-description" targetRef="post-job-description" />
    <bpmn:sequenceFlow id="f4" sourceRef="post-job-description" targetRef="collect-resumes" />
    <bpmn:sequenceFlow id="f5" sourceRef="collect-resumes" targetRef="screen-resumes" />
    <bpmn:sequenceFlow id="f6" sourceRef="screen-resumes" targetRef="initial-phone-interviews" />
    <bpmn:sequenceFlow id="f7" sourceRef="initial-phone-interviews" targetRef="invite-candidates" />
    <bpmn:sequenceFlow id="f8" sourceRef="invite-candidates" targetRef="interview-type" />
    <bpmn:sequenceFlow id="f9" name="In-person" sourceRef="interview-type" targetRef="in-person-interview" />
    <bpmn:sequenceFlow id="f10" name="Virtual" sourceRef="interview-type" targetRef="virtual-interview" />
    <bpmn:sequenceFlow id="f11" sourceRef="in-person-interview" targetRef="interviews-merged" />
    <bpmn:sequenceFlow id="f12" sourceRef="virtual-interview" targetRef="interviews-merged" />
    <bpmn:sequenceFlow id="f13" sourceRef="interviews-merged" targetRef="choose-candidate" />
    <bpmn:sequenceFlow id="f14" sourceRef="choose-candidate" targetRef="extend-offer" />
    <bpmn:sequenceFlow id="f15" sourceRef="extend-offer" targetRef="salary-negotiations" />
    <bpmn:sequenceFlow id="f16" name="Yes" sourceRef="salary-negotiations" targetRef="negotiate-salary" />
    <bpmn:sequenceFlow id="f17" name="No" sourceRef="salary-negotiations" targetRef="negotiations-merged" />
    <bpmn:sequenceFlow id="f18" sourceRef="negotiate-salary" targetRef="negotiations-merged" />
    <bpmn:sequenceFlow id="f19" sourceRef="negotiations-merged" targetRef="offer-accepted" />
    <bpmn:sequenceFlow id="f20" name="Yes" sourceRef="offer-accepted" targetRef="onboarding-split" />
    <bpmn:sequenceFlow id="f21" name="No" sourceRef="offer-accepted" targetRef="offer-declined" />
    <bpmn:sequenceFlow id="f22" sourceRef="onboarding-split" targetRef="complete-paperwork" />
    <bpmn:sequenceFlow id="f23" sourceRef="onboarding-split" targetRef="attend-orientation" />
    <bpmn:sequenceFlow id="f24" sourceRef="onboarding-split" targetRef="complete-training" />
    <bpmn:sequenceFlow id="f25" sourceRef="complete-paperwork" targetRef="onboarding-join" />
    <bpmn:sequenceFlow id="f26" sourceRef="attend-orientation" targetRef="onboarding-join" />
    <bpmn:sequenceFlow id="f27" sourceRef="complete-training" targetRef="onboarding-join" />
    <bpmn:sequenceFlow id="f28" sourceRef="onboarding-join" targetRef="fully-integrated" />
  </bpmn:process>
</bpmn:definitions>
