<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="warehouse" name="Warehouse Staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manual_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect_quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_shelves</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Inventory System">
        <bpmn:flowNodeRef>send_alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Inventory monitoring started" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="alert_type" name="Automated alert or manual check?" />
    <bpmn:task id="send_alert" name="Send automated alert" />
    <bpmn:task id="manual_check" name="Perform manual check" />
    <bpmn:exclusiveGateway id="alert_merge" name="Need to reorder signaled" />
    <bpmn:task id="place_order" name="Place order with suppliers" />
    <bpmn:task id="update_delivery" name="Update expected delivery dates" />
    <bpmn:task id="receive_stock" name="Receive the stock" />
    <bpmn:task id="inspect_quality" name="Inspect stock for quality" />
    <bpmn:task id="record_stock" name="Record stock in system" />
    <bpmn:task id="place_shelves" name="Place stock on shelves or in storage" />
    <bpmn:task id="update_levels" name="Update inventory levels" />
    <bpmn:endEvent id="end" name="Inventory levels updated" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="monitor" />
    <bpmn:sequenceFlow id="f2" sourceRef="monitor" targetRef="alert_type" />
    <bpmn:sequenceFlow id="f3" name="Automated alert" sourceRef="alert_type" targetRef="send_alert" />
    <bpmn:sequenceFlow id="f4" name="Manual check" sourceRef="alert_type" targetRef="manual_check" />
    <bpmn:sequenceFlow id="f5" sourceRef="send_alert" targetRef="alert_merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="manual_check" targetRef="alert_merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="alert_merge" targetRef="place_order" />
    <bpmn:sequenceFlow id="f8" sourceRef="place_order" targetRef="update_delivery" />
    <bpmn:sequenceFlow id="f9" sourceRef="update_delivery" targetRef="receive_stock" />
    <bpmn:sequenceFlow id="f10" sourceRef="receive_stock" targetRef="inspect_quality" />
    <bpmn:sequenceFlow id="f11" sourceRef="inspect_quality" targetRef="record_stock" />
    <bpmn:sequenceFlow id="f12" sourceRef="record_stock" targetRef="place_shelves" />
    <bpmn:sequenceFlow id="f13" sourceRef="place_shelves" targetRef="update_levels" />
    <bpmn:sequenceFlow id="f14" sourceRef="update_levels" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
