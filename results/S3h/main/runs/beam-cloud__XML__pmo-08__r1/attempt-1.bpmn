<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="incident-process" />
  </bpmn:collaboration>
  <bpmn:process id="incident-process" isExecutable="false">
    <bpmn:laneSet id="incident-lanes">
      <bpmn:lane id="employee-or-customer" name="Employee or Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report-incident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tracking-system" name="Tracking System">
        <bpmn:flowNodeRef>log-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-stakeholders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appropriate-team" name="Appropriate Team">
        <bpmn:flowNodeRef>gather-information</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose-actions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement-solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>follow-up</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Incident occurs" />
    <bpmn:task id="report-incident" name="Report an incident" />
    <bpmn:task id="log-report" name="Log the report" />
    <bpmn:task id="assign-team" name="Assign to appropriate team" />
    <bpmn:task id="gather-information" name="Gather necessary information" />
    <bpmn:task id="identify-cause" name="Identify cause of incident" />
    <bpmn:task id="propose-actions" name="Propose corrective actions" />
    <bpmn:task id="implement-solution" name="Implement solution" />
    <bpmn:task id="follow-up" name="Follow up" />
    <bpmn:task id="close-report" name="Close incident report" />
    <bpmn:task id="notify-stakeholders" name="Notify all stakeholders" />
    <bpmn:endEvent id="end" name="Incident report closed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report-incident" />
    <bpmn:sequenceFlow id="f2" sourceRef="report-incident" targetRef="log-report" />
    <bpmn:sequenceFlow id="f3" sourceRef="log-report" targetRef="assign-team" />
    <bpmn:sequenceFlow id="f4" sourceRef="assign-team" targetRef="gather-information" />
    <bpmn:sequenceFlow id="f5" sourceRef="gather-information" targetRef="identify-cause" />
    <bpmn:sequenceFlow id="f6" sourceRef="identify-cause" targetRef="propose-actions" />
    <bpmn:sequenceFlow id="f7" sourceRef="propose-actions" targetRef="implement-solution" />
    <bpmn:sequenceFlow id="f8" sourceRef="implement-solution" targetRef="follow-up" />
    <bpmn:sequenceFlow id="f9" sourceRef="follow-up" targetRef="close-report" />
    <bpmn:sequenceFlow id="f10" sourceRef="close-report" targetRef="notify-stakeholders" />
    <bpmn:sequenceFlow id="f11" sourceRef="notify-stakeholders" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
