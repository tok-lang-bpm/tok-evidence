<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="rd" name="R&D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refineGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discardedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify an idea" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype" />
    <bpmn:task id="test" name="Test the prototype" />
    <bpmn:task id="collect" name="Collect feedback" />
    <bpmn:exclusiveGateway id="refineGateway" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="outcomeGateway" name="Prototype approved?" />
    <bpmn:endEvent id="approvedEnd" name="Approved for further development" />
    <bpmn:endEvent id="discardedEnd" name="Discarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f3" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="draft" targetRef="select" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f6" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f7" sourceRef="test" targetRef="collect" />
    <bpmn:sequenceFlow id="f8" sourceRef="collect" targetRef="refineGateway" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="refineGateway" targetRef="refine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">refinementNeeded == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="refineGateway" targetRef="outcomeGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">refinementNeeded == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="refine" targetRef="test" />
    <bpmn:sequenceFlow id="f12" name="approved" sourceRef="outcomeGateway" targetRef="approvedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" name="discarded" sourceRef="outcomeGateway" targetRef="discardedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
