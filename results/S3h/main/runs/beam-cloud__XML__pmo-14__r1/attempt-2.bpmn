<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="budget-process" />
  </bpmn:collaboration>
  <bpmn:process id="budget-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>detailed-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjustments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve-final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>strategic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve-adjustment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Budget process started" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:task id="draft" name="Draft a plan" />
    <bpmn:task id="strategic" name="Review in strategic alignment meeting" />
    <bpmn:task id="detailed-review" name="Perform detailed review" />
    <bpmn:exclusiveGateway id="adjustments" name="Adjustments needed?" default="to-final" />
    <bpmn:task id="adjust" name="Adjust plan" />
    <bpmn:task id="document" name="Document adjustment" />
    <bpmn:task id="approve-adjustment" name="Approve adjustment" />
    <bpmn:task id="approve-final" name="Approve final budget" />
    <bpmn:task id="allocate" name="Allocate budget" />
    <bpmn:endEvent id="end" name="Budget distributed and plan implementation begins" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="outline" />
    <bpmn:sequenceFlow id="f2" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f3" sourceRef="draft" targetRef="strategic" />
    <bpmn:sequenceFlow id="f4" sourceRef="strategic" targetRef="detailed-review" />
    <bpmn:sequenceFlow id="f5" sourceRef="detailed-review" targetRef="adjustments" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="adjustments" targetRef="adjust">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">adjustmentsNeeded == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f8" sourceRef="document" targetRef="approve-adjustment" />
    <bpmn:sequenceFlow id="f9" sourceRef="approve-adjustment" targetRef="detailed-review" />
    <bpmn:sequenceFlow id="to-final" name="no" sourceRef="adjustments" targetRef="approve-final" />
    <bpmn:sequenceFlow id="f10" sourceRef="approve-final" targetRef="allocate" />
    <bpmn:sequenceFlow id="f11" sourceRef="allocate" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
