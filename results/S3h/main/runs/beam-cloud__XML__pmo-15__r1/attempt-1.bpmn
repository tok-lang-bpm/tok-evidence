<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company-pool" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="company-lane" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalaudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal-teams-lane" name="Internal Teams">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfassess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors-lane" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Compliance audit required" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="selfassess" name="Conduct self-assessment" />
    <bpmn:task id="review" name="Review processes" />
    <bpmn:task id="identify" name="Identify gaps or issues" />
    <bpmn:task id="correct" name="Make necessary corrections or improvements" />
    <bpmn:task id="finalaudit" name="Undergo final audit" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" default="flow-no" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="end-success" name="Certification awarded" />
    <bpmn:endEvent id="end-fail" name="Certification not awarded" />

    <bpmn:sequenceFlow id="flow-start-schedule" sourceRef="start" targetRef="schedule" />
    <bpmn:sequenceFlow id="flow-schedule-prepare" sourceRef="schedule" targetRef="prepare" />
    <bpmn:sequenceFlow id="flow-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="flow-gather-selfassess" sourceRef="gather" targetRef="selfassess" />
    <bpmn:sequenceFlow id="flow-selfassess-review" sourceRef="selfassess" targetRef="review" />
    <bpmn:sequenceFlow id="flow-review-identify" sourceRef="review" targetRef="identify" />
    <bpmn:sequenceFlow id="flow-identify-correct" sourceRef="identify" targetRef="correct" />
    <bpmn:sequenceFlow id="flow-correct-finalaudit" sourceRef="correct" targetRef="finalaudit" />
    <bpmn:sequenceFlow id="flow-finalaudit-criteria" sourceRef="finalaudit" targetRef="criteria" />
    <bpmn:sequenceFlow id="flow-yes" name="yes" sourceRef="criteria" targetRef="award" />
    <bpmn:sequenceFlow id="flow-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="flow-issue-end" sourceRef="issue" targetRef="end-success" />
    <bpmn:sequenceFlow id="flow-no" name="no" sourceRef="criteria" targetRef="end-fail" />
  </bpmn:process>
</bpmn:definitions>
