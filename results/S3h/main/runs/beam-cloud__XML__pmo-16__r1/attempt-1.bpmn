<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational Company" processRef="audit-process" />
  </bpmn:collaboration>
  <bpmn:process id="audit-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="audit-coordinator-lane" name="Audit Coordinator">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-notification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional-office-lane" name="Regional Office">
        <bpmn:flowNodeRef>prepare-financial-statements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather-necessary-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-clarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance-team-lane" name="Compliance Team">
        <bpmn:flowNodeRef>check-regulatory-updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central-audit-team-lane" name="Central Audit Team">
        <bpmn:flowNodeRef>review-submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-financial-risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-operational-risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-compliance-risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch-detailed-investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-site-visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute-final-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive-final-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-split-regional-compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-join-regional-compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-review-documents-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-discrepancies-found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-risk-evaluation-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-risk-evaluation-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-high-risk-identified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-site-visit-required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-site-visit-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-high-risk-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-report-review-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit-director-lane" name="Audit Director">
        <bpmn:flowNodeRef>review-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway-report-approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Annual audit initiated" />
    <bpmn:task id="send-notification" name="Send notification to regional office" />
    <bpmn:task id="prepare-financial-statements" name="Prepare financial statements" />
    <bpmn:task id="gather-necessary-documents" name="Gather necessary documents" />
    <bpmn:task id="check-regulatory-updates" name="Check for regulatory updates" />
    <bpmn:task id="submit-documents" name="Submit documents to central audit team" />
    <bpmn:task id="review-submission" name="Review submission" />
    <bpmn:task id="request-clarifications" name="Request clarifications from regional office" />
    <bpmn:task id="provide-clarifications" name="Provide necessary clarifications" />
    <bpmn:task id="evaluate-financial-risks" name="Evaluate financial risks" />
    <bpmn:task id="evaluate-operational-risks" name="Evaluate operational risks" />
    <bpmn:task id="evaluate-compliance-risks" name="Evaluate compliance risks" />
    <bpmn:task id="launch-detailed-investigation" name="Launch detailed investigation" />
    <bpmn:task id="analyze-data" name="Analyze data" />
    <bpmn:task id="conduct-interviews" name="Conduct interviews" />
    <bpmn:task id="conduct-site-visits" name="Conduct site visits" />
    <bpmn:task id="compile-audit-report" name="Compile audit report" />
    <bpmn:task id="review-audit-report" name="Review audit report" />
    <bpmn:task id="update-audit-report" name="Update audit report" />
    <bpmn:task id="distribute-final-report" name="Distribute final report to executive board" />
    <bpmn:task id="archive-final-report" name="Archive final report" />
    <bpmn:endEvent id="end" name="Audit process closed" />

    <bpmn:parallelGateway id="gateway-split-regional-compliance" />
    <bpmn:parallelGateway id="gateway-join-regional-compliance" />
    <bpmn:exclusiveGateway id="gateway-review-documents-merge" />
    <bpmn:exclusiveGateway id="gateway-discrepancies-found" default="flow-no-discrepancies" />
    <bpmn:parallelGateway id="gateway-risk-evaluation-split" />
    <bpmn:parallelGateway id="gateway-risk-evaluation-join" />
    <bpmn:exclusiveGateway id="gateway-high-risk-identified" default="flow-no-high-risk" />
    <bpmn:exclusiveGateway id="gateway-site-visit-required" default="flow-no-site-visit" />
    <bpmn:exclusiveGateway id="gateway-site-visit-merge" />
    <bpmn:exclusiveGateway id="gateway-high-risk-merge" />
    <bpmn:exclusiveGateway id="gateway-report-review-merge" />
    <bpmn:exclusiveGateway id="gateway-report-approved" default="flow-revisions-required" />

    <bpmn:sequenceFlow id="flow-start-notification" sourceRef="start" targetRef="send-notification" />
    <bpmn:sequenceFlow id="flow-notification-split" sourceRef="send-notification" targetRef="gateway-split-regional-compliance" />
    <bpmn:sequenceFlow id="flow-split-prepare" sourceRef="gateway-split-regional-compliance" targetRef="prepare-financial-statements" />
    <bpmn:sequenceFlow id="flow-split-check" sourceRef="gateway-split-regional-compliance" targetRef="check-regulatory-updates" />
    <bpmn:sequenceFlow id="flow-prepare-gather" sourceRef="prepare-financial-statements" targetRef="gather-necessary-documents" />
    <bpmn:sequenceFlow id="flow-gather-join" sourceRef="gather-necessary-documents" targetRef="gateway-join-regional-compliance" />
    <bpmn:sequenceFlow id="flow-check-join" sourceRef="check-regulatory-updates" targetRef="gateway-join-regional-compliance" />
    <bpmn:sequenceFlow id="flow-join-submit" sourceRef="gateway-join-regional-compliance" targetRef="submit-documents" />
    <bpmn:sequenceFlow id="flow-submit-review-merge" sourceRef="submit-documents" targetRef="gateway-review-documents-merge" />
    <bpmn:sequenceFlow id="flow-review-merge-review" sourceRef="gateway-review-documents-merge" targetRef="review-submission" />
    <bpmn:sequenceFlow id="flow-review-discrepancies" sourceRef="review-submission" targetRef="gateway-discrepancies-found" />
    <bpmn:sequenceFlow id="flow-request-clarifications" name="yes" sourceRef="gateway-discrepancies-found" targetRef="request-clarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">discrepanciesFound == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-request-provide" sourceRef="request-clarifications" targetRef="provide-clarifications" />
    <bpmn:sequenceFlow id="flow-provide-review-merge" sourceRef="provide-clarifications" targetRef="gateway-review-documents-merge" />
    <bpmn:sequenceFlow id="flow-no-discrepancies" name="no" sourceRef="gateway-discrepancies-found" targetRef="gateway-risk-evaluation-split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">discrepanciesFound == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-risk-split-financial" sourceRef="gateway-risk-evaluation-split" targetRef="evaluate-financial-risks" />
    <bpmn:sequenceFlow id="flow-risk-split-operational" sourceRef="gateway-risk-evaluation-split" targetRef="evaluate-operational-risks" />
    <bpmn:sequenceFlow id="flow-risk-split-compliance" sourceRef="gateway-risk-evaluation-split" targetRef="evaluate-compliance-risks" />
    <bpmn:sequenceFlow id="flow-financial-join" sourceRef="evaluate-financial-risks" targetRef="gateway-risk-evaluation-join" />
    <bpmn:sequenceFlow id="flow-operational-join" sourceRef="evaluate-operational-risks" targetRef="gateway-risk-evaluation-join" />
    <bpmn:sequenceFlow id="flow-compliance-join" sourceRef="evaluate-compliance-risks" targetRef="gateway-risk-evaluation-join" />
    <bpmn:sequenceFlow id="flow-join-high-risk" sourceRef="gateway-risk-evaluation-join" targetRef="gateway-high-risk-identified" />
    <bpmn:sequenceFlow id="flow-high-risk-investigation" name="yes" sourceRef="gateway-high-risk-identified" targetRef="launch-detailed-investigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">highRisk == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-launch-analyze" sourceRef="launch-detailed-investigation" targetRef="analyze-data" />
    <bpmn:sequenceFlow id="flow-analyze-interviews" sourceRef="analyze-data" targetRef="conduct-interviews" />
    <bpmn:sequenceFlow id="flow-interviews-site-gateway" sourceRef="conduct-interviews" targetRef="gateway-site-visit-required" />
    <bpmn:sequenceFlow id="flow-site-visit" name="yes" sourceRef="gateway-site-visit-required" targetRef="conduct-site-visits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">siteVisitRequired == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-site-visit-merge" sourceRef="conduct-site-visits" targetRef="gateway-site-visit-merge" />
    <bpmn:sequenceFlow id="flow-no-site-visit" name="no" sourceRef="gateway-site-visit-required" targetRef="gateway-site-visit-merge" />
    <bpmn:sequenceFlow id="flow-site-merge-high-merge" sourceRef="gateway-site-visit-merge" targetRef="gateway-high-risk-merge" />
    <bpmn:sequenceFlow id="flow-no-high-risk" name="no" sourceRef="gateway-high-risk-identified" targetRef="gateway-high-risk-merge" />
    <bpmn:sequenceFlow id="flow-high-merge-compile" sourceRef="gateway-high-risk-merge" targetRef="compile-audit-report" />
    <bpmn:sequenceFlow id="flow-compile-report-merge" sourceRef="compile-audit-report" targetRef="gateway-report-review-merge" />
    <bpmn:sequenceFlow id="flow-report-merge-review" sourceRef="gateway-report-review-merge" targetRef="review-audit-report" />
    <bpmn:sequenceFlow id="flow-review-approval" sourceRef="review-audit-report" targetRef="gateway-report-approved" />
    <bpmn:sequenceFlow id="flow-approved-distribute" name="approved" sourceRef="gateway-report-approved" targetRef="distribute-final-report">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-revisions-required" name="revisions required" sourceRef="gateway-report-approved" targetRef="update-audit-report" />
    <bpmn:sequenceFlow id="flow-update-report-merge" sourceRef="update-audit-report" targetRef="gateway-report-review-merge" />
    <bpmn:sequenceFlow id="flow-distribute-archive" sourceRef="distribute-final-report" targetRef="archive-final-report" />
    <bpmn:sequenceFlow id="flow-archive-end" sourceRef="archive-final-report" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
