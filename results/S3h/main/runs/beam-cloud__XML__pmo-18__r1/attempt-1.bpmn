<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="enrollment-process" />
  </bpmn:collaboration>
  <bpmn:process id="enrollment-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="student-lane" name="Student">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline_boundary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend_classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appeal_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canceled_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>graduated_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions-lane" name="Admissions Office">
        <bpmn:flowNodeRef>review_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>documents_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_eval_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_eval_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_application</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee-lane" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate_application</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance-lane" name="Finance Department">
        <bpmn:flowNodeRef>process_fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it-lane" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="iso-lane" name="International Student Office">
        <bpmn:flowNodeRef>assist_visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="university-lane" name="University">
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_event" name="Enrollment process starts" />
    <bpmn:task id="submit_application" name="Submit application online" />
    <bpmn:task id="review_application" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="documents_complete" name="Documents complete?" default="f7" />
    <bpmn:task id="notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="provide_missing" name="Provide missing items" />
    <bpmn:parallelGateway id="p_eval_split" />
    <bpmn:task id="evaluate_application" name="Evaluate application" />
    <bpmn:task id="process_fees" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="p_eval_join" />
    <bpmn:exclusiveGateway id="accepted_gw" name="Application accepted?" default="f13" />
    <bpmn:task id="send_acceptance" name="Send acceptance letter" />
    <bpmn:task id="send_rejection" name="Send rejection letter" />
    <bpmn:endEvent id="rejected_end" name="Application rejected" />
    <bpmn:task id="confirm_enrollment" name="Confirm enrollment by specified deadline">
      <bpmn:boundaryEvent id="deadline_boundary" attachedToRef="confirm_enrollment" cancelActivity="true">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
    </bpmn:task>
    <bpmn:task id="cancel_application" name="Cancel application" />
    <bpmn:endEvent id="canceled_end" name="Application canceled" />
    <bpmn:parallelGateway id="p_orient_split" />
    <bpmn:task id="receive_orientation" name="Receive orientation materials" />
    <bpmn:task id="setup_accounts" name="Set up student accounts for email, online portals, and library access" />
    <bpmn:parallelGateway id="p_orient_join" />
    <bpmn:exclusiveGateway id="international_gw" name="International student?" default="f26" />
    <bpmn:task id="assist_visa" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="international_merge" />
    <bpmn:task id="obtain_id" name="Obtain student ID card" />
    <bpmn:task id="meet_advisor" name="Meeting with an academic advisor" />
    <bpmn:task id="select_courses" name="Selecting courses" />
    <bpmn:task id="resolve_conflicts" name="Resolving schedule conflicts" />
    <bpmn:task id="attend_classes" name="Begin attending classes" />
    <bpmn:exclusiveGateway id="add_drop_gw" name="Add or drop courses?" default="f35" />
    <bpmn:task id="add_drop_courses" name="Add or drop courses" />
    <bpmn:exclusiveGateway id="add_drop_merge" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:exclusiveGateway id="grievance_gw" name="Has grievances?" default="f43" />
    <bpmn:task id="submit_appeal" name="Submit appeal form" />
    <bpmn:task id="meet_appeals" name="Meeting with the appeals committee" />
    <bpmn:task id="await_appeal" name="Awaiting a decision" />
    <bpmn:exclusiveGateway id="appeal_merge" />
    <bpmn:exclusiveGateway id="continue_gw" name="Graduate, withdraw, or continue?" default="f45" />
    <bpmn:endEvent id="graduated_end" name="Student graduated" />
    <bpmn:endEvent id="withdrawn_end" name="Student withdrew" />

    <bpmn:sequenceFlow id="f1" sourceRef="start_event" targetRef="submit_application" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit_application" targetRef="review_application" />
    <bpmn:sequenceFlow id="f3" sourceRef="review_application" targetRef="documents_complete" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="documents_complete" targetRef="notify_missing" />
    <bpmn:sequenceFlow id="f5" sourceRef="notify_missing" targetRef="provide_missing" />
    <bpmn:sequenceFlow id="f6" sourceRef="provide_missing" targetRef="review_application" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="documents_complete" targetRef="p_eval_split" />
    <bpmn:sequenceFlow id="f8" sourceRef="p_eval_split" targetRef="evaluate_application" />
    <bpmn:sequenceFlow id="f9" sourceRef="p_eval_split" targetRef="process_fees" />
    <bpmn:sequenceFlow id="f10" sourceRef="evaluate_application" targetRef="p_eval_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="process_fees" targetRef="p_eval_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="p_eval_join" targetRef="accepted_gw" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="accepted_gw" targetRef="send_acceptance" />
    <bpmn:sequenceFlow id="f14" sourceRef="send_acceptance" targetRef="confirm_enrollment" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="accepted_gw" targetRef="send_rejection" />
    <bpmn:sequenceFlow id="f16" sourceRef="send_rejection" targetRef="rejected_end" />
    <bpmn:sequenceFlow id="f_boundary" sourceRef="deadline_boundary" targetRef="cancel_application" />
    <bpmn:sequenceFlow id="f17" sourceRef="cancel_application" targetRef="canceled_end" />
    <bpmn:sequenceFlow id="f18" sourceRef="confirm_enrollment" targetRef="p_orient_split" />
    <bpmn:sequenceFlow id="f19" sourceRef="p_orient_split" targetRef="receive_orientation" />
    <bpmn:sequenceFlow id="f20" sourceRef="p_orient_split" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f21" sourceRef="receive_orientation" targetRef="p_orient_join" />
    <bpmn:sequenceFlow id="f22" sourceRef="setup_accounts" targetRef="p_orient_join" />
    <bpmn:sequenceFlow id="f23" sourceRef="p_orient_join" targetRef="international_gw" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="international_gw" targetRef="assist_visa" />
    <bpmn:sequenceFlow id="f25" sourceRef="assist_visa" targetRef="international_merge" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="international_gw" targetRef="international_merge" />
    <bpmn:sequenceFlow id="f27" sourceRef="international_merge" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f28" sourceRef="obtain_id" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f29" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f30" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f31" sourceRef="resolve_conflicts" targetRef="attend_classes" />
    <bpmn:sequenceFlow id="f32" sourceRef="attend_classes" targetRef="add_drop_gw" />
    <bpmn:sequenceFlow id="f33" name="yes" sourceRef="add_drop_gw" targetRef="add_drop_courses" />
    <bpmn:sequenceFlow id="f34" sourceRef="add_drop_courses" targetRef="add_drop_merge" />
    <bpmn:sequenceFlow id="f35" name="no" sourceRef="add_drop_gw" targetRef="add_drop_merge" />
    <bpmn:sequenceFlow id="f36" sourceRef="add_drop_merge" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f37" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f38" sourceRef="review_grades" targetRef="grievance_gw" />
    <bpmn:sequenceFlow id="f39" name="yes" sourceRef="grievance_gw" targetRef="submit_appeal" />
    <bpmn:sequenceFlow id="f40" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f41" sourceRef="meet_appeals" targetRef="await_appeal" />
    <bpmn:sequenceFlow id="f42" sourceRef="await_appeal" targetRef="appeal_merge" />
    <bpmn:sequenceFlow id="f43" name="no" sourceRef="grievance_gw" targetRef="appeal_merge" />
    <bpmn:sequenceFlow id="f44" sourceRef="appeal_merge" targetRef="continue_gw" />
    <bpmn:sequenceFlow id="f45" name="continue" sourceRef="continue_gw" targetRef="attend_classes" />
    <bpmn:sequenceFlow id="f46" name="graduate" sourceRef="continue_gw" targetRef="graduated_end" />
    <bpmn:sequenceFlow id="f47" name="withdraw" sourceRef="continue_gw" targetRef="withdrawn_end" />
  </bpmn:process>
</bpmn:definitions>
