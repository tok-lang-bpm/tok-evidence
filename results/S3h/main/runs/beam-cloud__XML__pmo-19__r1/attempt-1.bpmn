<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="purchase-process" />
  </bpmn:collaboration>
  <bpmn:process id="purchase-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="user-lane" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Purchase started" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="parallelSplit" />
    <bpmn:task id="selectItems" name="Select items to purchase" />
    <bpmn:task id="setPayment" name="Set payment method" />
    <bpmn:task id="chooseReward" name="Choose free reward" />
    <bpmn:exclusiveGateway id="paymentDecision" name="Payment option?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="paymentMerge" />
    <bpmn:parallelGateway id="parallelJoin" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="returnDecision" name="Return items for exchange?" />
    <bpmn:task id="returnItems" name="Return items for exchange" />
    <bpmn:endEvent id="end" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="f3" sourceRef="parallelSplit" targetRef="selectItems" />
    <bpmn:sequenceFlow id="f4" sourceRef="parallelSplit" targetRef="setPayment" />
    <bpmn:sequenceFlow id="f5" sourceRef="selectItems" targetRef="chooseReward" />
    <bpmn:sequenceFlow id="f6" sourceRef="chooseReward" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f7" sourceRef="setPayment" targetRef="paymentDecision" />
    <bpmn:sequenceFlow id="f8" name="pay" sourceRef="paymentDecision" targetRef="pay" />
    <bpmn:sequenceFlow id="f9" name="installment" sourceRef="paymentDecision" targetRef="installment" />
    <bpmn:sequenceFlow id="f10" sourceRef="pay" targetRef="paymentMerge" />
    <bpmn:sequenceFlow id="f11" sourceRef="installment" targetRef="paymentMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="paymentMerge" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="parallelJoin" targetRef="deliver" />
    <bpmn:sequenceFlow id="f14" sourceRef="deliver" targetRef="returnDecision" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="returnDecision" targetRef="returnItems" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="returnDecision" targetRef="end" />
    <bpmn:sequenceFlow id="f17" sourceRef="returnItems" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
