<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg_guest_appeared" name="Guest appears at the service hatch" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_restaurant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose_dish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick_up_meal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat_meal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meal_eaten</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enter_pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect_money</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_off_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appearance_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guest_appeared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_5_minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_guest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_over_meal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare_meal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_employee_meal_ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Feeling hungry" />
    <bpmn:task id="enter_restaurant" name="Enter the restaurant" />
    <bpmn:task id="choose_dish" name="Choose a dish from the changing meal range" />
    <bpmn:task id="wait_turn" name="Wait until it is his turn" />
    <bpmn:task id="place_order" name="Place the order" />
    <bpmn:task id="enter_pos" name="Enter the order into the POS system" />
    <bpmn:task id="collect_money" name="Collect the money from the guest" />
    <bpmn:task id="setup_buzzer" name="Set up a buzzer" />
    <bpmn:task id="pass_buzzer" name="Pass the buzzer to the guest" />
    <bpmn:task id="inform_chef" name="Inform the chef of the new meal order" />
    <bpmn:task id="prepare_meal" name="Prepare the meal" />
    <bpmn:task id="place_hatch" name="Place the meal in the service hatch" />
    <bpmn:task id="inform_employee_meal_ready" name="Inform the employee that the finished meal is in the service hatch" />
    <bpmn:task id="set_off_buzzer" name="Set off the guest's buzzer" />
    <bpmn:eventBasedGateway id="appearance_gateway" />
    <bpmn:intermediateCatchEvent id="guest_appeared" name="Guest appears at the service hatch">
      <bpmn:messageEventDefinition messageRef="msg_guest_appeared" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="wait_5_minutes" name="5 minutes">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="call_guest" name="Call the guest" />
    <bpmn:task id="hand_over_meal" name="Hand over the meal" />
    <bpmn:task id="pick_up_meal" name="Pick up the meal" />
    <bpmn:task id="eat_meal" name="Eat the meal" />
    <bpmn:endEvent id="meal_eaten" name="Meal eaten" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter_restaurant" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter_restaurant" targetRef="choose_dish" />
    <bpmn:sequenceFlow id="f3" sourceRef="choose_dish" targetRef="wait_turn" />
    <bpmn:sequenceFlow id="f4" sourceRef="wait_turn" targetRef="place_order" />
    <bpmn:sequenceFlow id="f5" sourceRef="place_order" targetRef="enter_pos" />
    <bpmn:sequenceFlow id="f6" sourceRef="enter_pos" targetRef="collect_money" />
    <bpmn:sequenceFlow id="f7" sourceRef="collect_money" targetRef="setup_buzzer" />
    <bpmn:sequenceFlow id="f8" sourceRef="setup_buzzer" targetRef="pass_buzzer" />
    <bpmn:sequenceFlow id="f9" sourceRef="pass_buzzer" targetRef="inform_chef" />
    <bpmn:sequenceFlow id="f10" sourceRef="inform_chef" targetRef="prepare_meal" />
    <bpmn:sequenceFlow id="f11" sourceRef="prepare_meal" targetRef="place_hatch" />
    <bpmn:sequenceFlow id="f12" sourceRef="place_hatch" targetRef="inform_employee_meal_ready" />
    <bpmn:sequenceFlow id="f13" sourceRef="inform_employee_meal_ready" targetRef="set_off_buzzer" />
    <bpmn:sequenceFlow id="f14" sourceRef="set_off_buzzer" targetRef="appearance_gateway" />
    <bpmn:sequenceFlow id="f15" sourceRef="appearance_gateway" targetRef="guest_appeared" />
    <bpmn:sequenceFlow id="f16" sourceRef="appearance_gateway" targetRef="wait_5_minutes" />
    <bpmn:sequenceFlow id="f17" sourceRef="guest_appeared" targetRef="hand_over_meal" />
    <bpmn:sequenceFlow id="f18" sourceRef="hand_over_meal" targetRef="pick_up_meal" />
    <bpmn:sequenceFlow id="f19" sourceRef="pick_up_meal" targetRef="eat_meal" />
    <bpmn:sequenceFlow id="f20" sourceRef="eat_meal" targetRef="meal_eaten" />
    <bpmn:sequenceFlow id="f21" sourceRef="wait_5_minutes" targetRef="call_guest" />
    <bpmn:sequenceFlow id="f22" sourceRef="call_guest" targetRef="appearance_gateway" />
  </bpmn:process>
</bpmn:definitions>
