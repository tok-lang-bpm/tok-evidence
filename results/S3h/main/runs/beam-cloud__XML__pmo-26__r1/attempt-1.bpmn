<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parent_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>period_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parent_decide_extension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extension_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_extended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_extended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>fetch_models</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_ss_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_company_info</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Maternity leave planning needed" />
    <bpmn:task id="fetch_models" name="Fetch information about potential models" />
    <bpmn:task id="parent_select" name="Let parent select" />
    <bpmn:task id="collect_info" name="Collect relevant information" />
    <bpmn:task id="notify_ss_company" name="Notify Social Security, Company in time" />
    <bpmn:task id="gather_company_info" name="Gather information from companies" />
    <bpmn:intermediateCatchEvent id="period_end" name="Maternity leave period ends">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="parent_decide_extension" name="Let parent decide about extension" />
    <bpmn:exclusiveGateway id="extension_decision" name="Extend maternity leave?" default="to_not_extended" />
    <bpmn:endEvent id="end_extended" name="Maternity leave extended" />
    <bpmn:endEvent id="end_not_extended" name="Maternity leave not extended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fetch_models" />
    <bpmn:sequenceFlow id="f2" sourceRef="fetch_models" targetRef="parent_select" />
    <bpmn:sequenceFlow id="f3" sourceRef="parent_select" targetRef="collect_info" />
    <bpmn:sequenceFlow id="f4" sourceRef="collect_info" targetRef="notify_ss_company" />
    <bpmn:sequenceFlow id="f5" sourceRef="notify_ss_company" targetRef="gather_company_info" />
    <bpmn:sequenceFlow id="f6" sourceRef="gather_company_info" targetRef="period_end" />
    <bpmn:sequenceFlow id="f7" sourceRef="period_end" targetRef="parent_decide_extension" />
    <bpmn:sequenceFlow id="f8" sourceRef="parent_decide_extension" targetRef="extension_decision" />
    <bpmn:sequenceFlow id="to_extended" name="yes" sourceRef="extension_decision" targetRef="end_extended">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">extension == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="to_not_extended" name="no" sourceRef="extension_decision" targetRef="end_not_extended" />
  </bpmn:process>
</bpmn:definitions>
