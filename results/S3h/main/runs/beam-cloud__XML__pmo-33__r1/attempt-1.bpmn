<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turnOn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatBed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatExtruder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generateGcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>createProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendStl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Custom 3D model needed" />
    <bpmn:task id="instruct" name="Instruct an artist to create a project" />
    <bpmn:task id="sendSketches" name="Send several sketches" />
    <bpmn:task id="createProject" name="Create a project" />
    <bpmn:task id="tellChanges" name="Tell what to change" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with result?" />
    <bpmn:task id="sendStl" name="Send the STL" />
    <bpmn:task id="chooseColor" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="inStock" name="Color at home?" />
    <bpmn:task id="checkAmount" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under100" name="Under 100 grams?" />
    <bpmn:task id="putList" name="Put it on your shopping list" />
    <bpmn:task id="orderColor" name="Order it" />
    <bpmn:exclusiveGateway id="mergeStock" />
    <bpmn:task id="turnOn" name="Turn the printer on" />
    <bpmn:parallelGateway id="heatSplit" />
    <bpmn:task id="heatBed" name="Heat up the bed" />
    <bpmn:task id="heatExtruder" name="Heat up the extruder" />
    <bpmn:task id="generateGcode" name="Generate the gcode file" />
    <bpmn:parallelGateway id="heatJoin" />
    <bpmn:task id="print" name="Print the model" />
    <bpmn:endEvent id="end" name="Model printed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="instruct" />
    <bpmn:sequenceFlow id="f2" sourceRef="instruct" targetRef="sendSketches" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendSketches" targetRef="createProject" />
    <bpmn:sequenceFlow id="f4" sourceRef="createProject" targetRef="tellChanges" />
    <bpmn:sequenceFlow id="f5" sourceRef="tellChanges" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="satisfied" targetRef="tellChanges" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="satisfied" targetRef="sendStl" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendStl" targetRef="chooseColor" />
    <bpmn:sequenceFlow id="f9" sourceRef="chooseColor" targetRef="inStock" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="inStock" targetRef="checkAmount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">color in stock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="inStock" targetRef="orderColor" default="true" />
    <bpmn:sequenceFlow id="f12" sourceRef="checkAmount" targetRef="under100" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="under100" targetRef="putList">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">amount &lt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="under100" targetRef="mergeStock" default="true" />
    <bpmn:sequenceFlow id="f15" sourceRef="putList" targetRef="mergeStock" />
    <bpmn:sequenceFlow id="f16" sourceRef="orderColor" targetRef="mergeStock" />
    <bpmn:sequenceFlow id="f17" sourceRef="mergeStock" targetRef="turnOn" />
    <bpmn:sequenceFlow id="f18" sourceRef="turnOn" targetRef="heatSplit" />
    <bpmn:sequenceFlow id="f19" sourceRef="heatSplit" targetRef="heatBed" />
    <bpmn:sequenceFlow id="f20" sourceRef="heatSplit" targetRef="heatExtruder" />
    <bpmn:sequenceFlow id="f21" sourceRef="heatSplit" targetRef="generateGcode" />
    <bpmn:sequenceFlow id="f22" sourceRef="heatBed" targetRef="heatJoin" />
    <bpmn:sequenceFlow id="f23" sourceRef="heatExtruder" targetRef="heatJoin" />
    <bpmn:sequenceFlow id="f24" sourceRef="generateGcode" targetRef="heatJoin" />
    <bpmn:sequenceFlow id="f25" sourceRef="heatJoin" targetRef="print" />
    <bpmn:sequenceFlow id="f26" sourceRef="print" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
