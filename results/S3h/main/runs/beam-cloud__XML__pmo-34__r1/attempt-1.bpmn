<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="building-process" />
  </bpmn:collaboration>
  <bpmn:process id="building-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>startEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>developBasicDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderLegoSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveLegoSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buildSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>partsGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesignSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebuildSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assembleSubcomponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sortParts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="startEvent" name="Start building" />
    <bpmn:task id="developBasicDesign" name="Develop the basic design" />
    <bpmn:task id="orderLegoSets" name="Order certain Lego brick sets" />
    <bpmn:task id="giveLegoSets" name="Give the Lego sets to children" />
    <bpmn:task id="sortParts" name="Sort the parts" />
    <bpmn:task id="buildSubcomponent" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="partsGateway" name="No more parts in container?" />
    <bpmn:task id="reorderParts" name="Reorder individual parts" />
    <bpmn:task id="testSubcomponent" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="testGateway" name="Test successful?" />
    <bpmn:task id="redesignSubcomponent" name="Redesign subcomponent" />
    <bpmn:task id="rebuildSubcomponent" name="Rebuild subcomponent" />
    <bpmn:task id="assembleSubcomponents" name="Assemble subcomponents" />
    <bpmn:endEvent id="endEvent" name="Machine built" />

    <bpmn:sequenceFlow id="f1" sourceRef="startEvent" targetRef="developBasicDesign" />
    <bpmn:sequenceFlow id="f2" sourceRef="developBasicDesign" targetRef="orderLegoSets" />
    <bpmn:sequenceFlow id="f3" sourceRef="orderLegoSets" targetRef="giveLegoSets" />
    <bpmn:sequenceFlow id="f4" sourceRef="giveLegoSets" targetRef="sortParts" />
    <bpmn:sequenceFlow id="f5" sourceRef="sortParts" targetRef="buildSubcomponent" />
    <bpmn:sequenceFlow id="f6" sourceRef="buildSubcomponent" targetRef="partsGateway" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="partsGateway" targetRef="reorderParts" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="partsGateway" targetRef="testSubcomponent" />
    <bpmn:sequenceFlow id="f9" sourceRef="reorderParts" targetRef="buildSubcomponent" />
    <bpmn:sequenceFlow id="f10" sourceRef="testSubcomponent" targetRef="testGateway" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="testGateway" targetRef="assembleSubcomponents" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="testGateway" targetRef="redesignSubcomponent" />
    <bpmn:sequenceFlow id="f13" sourceRef="redesignSubcomponent" targetRef="rebuildSubcomponent" />
    <bpmn:sequenceFlow id="f14" sourceRef="rebuildSubcomponent" targetRef="testSubcomponent" />
    <bpmn:sequenceFlow id="f15" sourceRef="assembleSubcomponents" targetRef="endEvent" />
  </bpmn:process>
</bpmn:definitions>
