<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="production" name="Production">
        <bpmn:flowNodeRef>orderSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prodSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prodJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Custom chainsaw requested" />
    <bpmn:task id="tell" name="Tell properties" />
    <bpmn:parallelGateway id="orderSplit" name="Order parts in parallel" />
    <bpmn:task id="order1" name="Order parts" />
    <bpmn:task id="order2" name="Order parts" />
    <bpmn:parallelGateway id="orderJoin" />
    <bpmn:intermediateCatchEvent id="parts" name="Parts arrived">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inspect" name="Inspect parts" />
    <bpmn:parallelGateway id="prodSplit" />
    <bpmn:task id="assemble" name="Assemble parts" />
    <bpmn:task id="produceFirst" name="Produce first saw" />
    <bpmn:task id="sendUpdates" name="Send updates to customer" />
    <bpmn:parallelGateway id="prodJoin" />
    <bpmn:task id="sendFirst" name="Send first saw" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes saw?" default="noLike" />
    <bpmn:task id="produceRest" name="Produce rest of order" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:endEvent id="stopped" name="Order not continued" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="tell" />
    <bpmn:sequenceFlow id="f2" sourceRef="tell" targetRef="orderSplit" />
    <bpmn:sequenceFlow id="f3" sourceRef="orderSplit" targetRef="order1" />
    <bpmn:sequenceFlow id="f4" sourceRef="orderSplit" targetRef="order2" />
    <bpmn:sequenceFlow id="f5" sourceRef="order1" targetRef="orderJoin" />
    <bpmn:sequenceFlow id="f6" sourceRef="order2" targetRef="orderJoin" />
    <bpmn:sequenceFlow id="f7" sourceRef="orderJoin" targetRef="parts" />
    <bpmn:sequenceFlow id="f8" sourceRef="parts" targetRef="inspect" />
    <bpmn:sequenceFlow id="f9" sourceRef="inspect" targetRef="prodSplit" />
    <bpmn:sequenceFlow id="f10" sourceRef="prodSplit" targetRef="assemble" />
    <bpmn:sequenceFlow id="f11" sourceRef="prodSplit" targetRef="sendUpdates" />
    <bpmn:sequenceFlow id="f12" sourceRef="assemble" targetRef="produceFirst" />
    <bpmn:sequenceFlow id="f13" sourceRef="produceFirst" targetRef="prodJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="sendUpdates" targetRef="prodJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="prodJoin" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f16" sourceRef="sendFirst" targetRef="likes" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="likes" targetRef="produceRest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">customerLikes == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="noLike" sourceRef="likes" targetRef="stopped" />
    <bpmn:sequenceFlow id="f18" sourceRef="produceRest" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
