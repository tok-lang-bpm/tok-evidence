<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="contract-process" />
  </bpmn:collaboration>
  <bpmn:process id="contract-process" isExecutable="false">
    <bpmn:laneSet id="contract-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-several</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-order-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-stock-5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder-cheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-stock-3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder-fastest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-stock-0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Contract project" />
    <bpmn:task id="query" name="Query web shops" />
    <bpmn:task id="amount" name="Find out how much they can deliver" />
    <bpmn:task id="price" name="Find out at which price" />
    <bpmn:task id="time" name="Find out how long it will take" />
    <bpmn:task id="list" name="Create a list of parts" />
    <bpmn:exclusiveGateway id="gw-enough" name="One shop has enough parts?" />
    <bpmn:task id="order-one" name="Order from one shop" />
    <bpmn:task id="order-several" name="Order from several shops" />
    <bpmn:exclusiveGateway id="gw-order-join" />
    <bpmn:task id="receive" name="Receive parts" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:exclusiveGateway id="gw-reorder" name="Need to reorder?" />
    <bpmn:exclusiveGateway id="gw-stock-5" name="Stock below 5?" />
    <bpmn:task id="reorder-cheapest" name="Reorder the cheapest" />
    <bpmn:exclusiveGateway id="gw-stock-3" name="Stock below 3?" />
    <bpmn:task id="reorder-fastest" name="Reorder the fastest" />
    <bpmn:exclusiveGateway id="gw-stock-0" name="Stock zero?" />
    <bpmn:task id="write-mail" name="Write a mail to your friends" />
    <bpmn:exclusiveGateway id="gw-done" />
    <bpmn:endEvent id="end" name="Contract completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="query" />
    <bpmn:sequenceFlow id="f2" sourceRef="query" targetRef="amount" />
    <bpmn:sequenceFlow id="f3" sourceRef="amount" targetRef="price" />
    <bpmn:sequenceFlow id="f4" sourceRef="price" targetRef="time" />
    <bpmn:sequenceFlow id="f5" sourceRef="time" targetRef="list" />
    <bpmn:sequenceFlow id="f6" sourceRef="list" targetRef="gw-enough" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gw-enough" targetRef="order-one">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">oneShopHasEnoughParts</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gw-enough" targetRef="order-several" default="f8" />
    <bpmn:sequenceFlow id="f9" sourceRef="order-one" targetRef="gw-order-join" />
    <bpmn:sequenceFlow id="f10" sourceRef="order-several" targetRef="gw-order-join" />
    <bpmn:sequenceFlow id="f11" sourceRef="gw-order-join" targetRef="receive" />
    <bpmn:sequenceFlow id="f12" sourceRef="receive" targetRef="build" />
    <bpmn:sequenceFlow id="f13" sourceRef="build" targetRef="gw-reorder" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gw-reorder" targetRef="gw-done" default="f14" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="gw-reorder" targetRef="gw-stock-5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">reorderNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gw-stock-5" targetRef="gw-done" default="f16" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="gw-stock-5" targetRef="reorder-cheapest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">stock &lt; 5</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" sourceRef="reorder-cheapest" targetRef="gw-stock-3" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="gw-stock-3" targetRef="gw-done" default="f19" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="gw-stock-3" targetRef="reorder-fastest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">stock &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f21" sourceRef="reorder-fastest" targetRef="gw-stock-0" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="gw-stock-0" targetRef="gw-done" default="f22" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="gw-stock-0" targetRef="write-mail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">stock == 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f24" sourceRef="write-mail" targetRef="gw-done" />
    <bpmn:sequenceFlow id="f25" sourceRef="gw-done" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
