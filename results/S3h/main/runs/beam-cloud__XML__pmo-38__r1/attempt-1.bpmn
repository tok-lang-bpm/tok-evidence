<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organisation" processRef="building-a-house-process" />
  </bpmn:collaboration>
  <bpmn:process id="building-a-house-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="you-lane" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine-draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-materials-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-messages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-attendee-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>party-planned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect-lane" name="Tree House Architect">
        <bpmn:flowNodeRef>send-draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store-lane" name="Online Store">
        <bpmn:flowNodeRef>process-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-processed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends-lane" name="Friends">
        <bpmn:flowNodeRef>build-house</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Want to build a tree house" />

    <bpmn:task id="collect-requirements" name="Collect requirements" />
    <bpmn:task id="send-requirements" name="Send requirements to architect" />
    <bpmn:task id="send-draft" name="Send draft" />
    <bpmn:task id="refine-draft" name="Refine draft with additional requirements">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="create-materials-list" name="Create list of needed materials" />
    <bpmn:task id="order-materials" name="Order materials from online stores" />

    <bpmn:parallelGateway id="parallel-split" />

    <bpmn:task id="process-order" name="Process order" />
    <bpmn:endEvent id="order-processed" name="Order processed" />

    <bpmn:task id="send-messages" name="Send messages to friends to build house" />
    <bpmn:task id="build-house" name="Build tree house" />
    <bpmn:task id="send-invitations" name="Send invitations for tree house party" />
    <bpmn:task id="create-attendee-list" name="Create list of people that attend party" />
    <bpmn:endEvent id="party-planned" name="Tree house party planned" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collect-requirements" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect-requirements" targetRef="send-requirements" />
    <bpmn:sequenceFlow id="f3" sourceRef="send-requirements" targetRef="send-draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="send-draft" targetRef="refine-draft" />
    <bpmn:sequenceFlow id="f5" sourceRef="refine-draft" targetRef="create-materials-list" />
    <bpmn:sequenceFlow id="f6" sourceRef="create-materials-list" targetRef="order-materials" />
    <bpmn:sequenceFlow id="f7" sourceRef="order-materials" targetRef="parallel-split" />
    <bpmn:sequenceFlow id="f8" sourceRef="parallel-split" targetRef="process-order" />
    <bpmn:sequenceFlow id="f9" sourceRef="process-order" targetRef="order-processed" />
    <bpmn:sequenceFlow id="f10" sourceRef="parallel-split" targetRef="send-messages" />
    <bpmn:sequenceFlow id="f11" sourceRef="send-messages" targetRef="build-house" />
    <bpmn:sequenceFlow id="f12" sourceRef="build-house" targetRef="send-invitations" />
    <bpmn:sequenceFlow id="f13" sourceRef="send-invitations" targetRef="create-attendee-list" />
    <bpmn:sequenceFlow id="f14" sourceRef="create-attendee-list" targetRef="party-planned" />
  </bpmn:process>
</bpmn:definitions>
