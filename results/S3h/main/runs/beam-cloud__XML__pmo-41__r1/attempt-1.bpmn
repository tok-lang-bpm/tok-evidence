<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="inspection-process" />
  </bpmn:collaboration>
  <bpmn:process id="inspection-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-serial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press-buttons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional-needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="machine" name="Machine">
        <bpmn:flowNodeRef>collect-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show-values</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Inspection started" />
    <bpmn:task id="enter-type" name="Enter type of machine" />
    <bpmn:task id="enter-serial" name="Enter serial number" />
    <bpmn:task id="ask-questions" name="Ask questions" />
    <bpmn:task id="input-values" name="Input values" />
    <bpmn:task id="press-buttons" name="Press buttons" />
    <bpmn:task id="collect-values" name="Collect values from machine" />
    <bpmn:task id="show-values" name="Show values" />
    <bpmn:exclusiveGateway id="additional-needed" name="Additional questions needed?" default="flow-no" />
    <bpmn:task id="ask-additional" name="Ask additional questions" />
    <bpmn:endEvent id="end" name="Inspection finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter-type" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter-type" targetRef="enter-serial" />
    <bpmn:sequenceFlow id="f3" sourceRef="enter-serial" targetRef="ask-questions" />
    <bpmn:sequenceFlow id="f4" sourceRef="ask-questions" targetRef="input-values" />
    <bpmn:sequenceFlow id="f5" sourceRef="input-values" targetRef="press-buttons" />
    <bpmn:sequenceFlow id="f6" sourceRef="press-buttons" targetRef="collect-values" />
    <bpmn:sequenceFlow id="f7" sourceRef="collect-values" targetRef="show-values" />
    <bpmn:sequenceFlow id="f8" sourceRef="show-values" targetRef="additional-needed" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="additional-needed" targetRef="ask-additional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">additionalQuestionsNeeded == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-no" name="no" sourceRef="additional-needed" targetRef="end" />
    <bpmn:sequenceFlow id="f10" sourceRef="ask-additional" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
