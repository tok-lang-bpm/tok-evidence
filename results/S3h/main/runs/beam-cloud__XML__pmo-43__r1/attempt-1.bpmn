<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="police" name="Police" processRef="car-service-process" />
  </bpmn:collaboration>
  <bpmn:process id="car-service-process" isExecutable="false">
    <bpmn:laneSet id="lane-set">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>get-status-updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-through-app</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enter-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-successful-repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-next-service</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>service-successful-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not-registered-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend-service-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-30-days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fined-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="service-successful-start" name="Service successful" />
    <bpmn:task id="check-registration" name="Check if car is still registered" />
    <bpmn:exclusiveGateway id="registered-gateway" name="Car still registered?" />
    <bpmn:task id="notify-customer" name="Notify you" />
    <bpmn:endEvent id="not-registered-end" name="Car not registered" />
    <bpmn:exclusiveGateway id="attend-service-gateway" name="Go to service?" />
    <bpmn:intermediateCatchEvent id="wait-30-days" name="After 30 days">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fine-customer" name="Fine you" />
    <bpmn:endEvent id="fined-end" name="Fined" />
    <bpmn:task id="enter-problems" name="Enter the problems of your car" />
    <bpmn:task id="get-status-updates" name="Get status updates via email" />
    <bpmn:task id="pay-through-app" name="Pay through the app" />
    <bpmn:task id="enter-successful-repair" name="Enter successful repair and Pickerl" />
    <bpmn:task id="enter-next-service" name="Enter the time for next service" />
    <bpmn:endEvent id="completed-end" name="Service completed" />
    <bpmn:sequenceFlow id="flow-start-check" sourceRef="service-successful-start" targetRef="check-registration" />
    <bpmn:sequenceFlow id="flow-check-registered" sourceRef="check-registration" targetRef="registered-gateway" />
    <bpmn:sequenceFlow id="flow-registered-yes" name="yes" sourceRef="registered-gateway" targetRef="notify-customer" />
    <bpmn:sequenceFlow id="flow-registered-no" name="no" sourceRef="registered-gateway" targetRef="not-registered-end" />
    <bpmn:sequenceFlow id="flow-notify-attend" sourceRef="notify-customer" targetRef="attend-service-gateway" />
    <bpmn:sequenceFlow id="flow-attend-yes" name="yes" sourceRef="attend-service-gateway" targetRef="enter-problems" />
    <bpmn:sequenceFlow id="flow-attend-no" name="no" sourceRef="attend-service-gateway" targetRef="wait-30-days" />
    <bpmn:sequenceFlow id="flow-wait-fine" sourceRef="wait-30-days" targetRef="fine-customer" />
    <bpmn:sequenceFlow id="flow-fine-end" sourceRef="fine-customer" targetRef="fined-end" />
    <bpmn:sequenceFlow id="flow-problems-status" sourceRef="enter-problems" targetRef="get-status-updates" />
    <bpmn:sequenceFlow id="flow-status-pay" sourceRef="get-status-updates" targetRef="pay-through-app" />
    <bpmn:sequenceFlow id="flow-pay-successful" sourceRef="pay-through-app" targetRef="enter-successful-repair" />
    <bpmn:sequenceFlow id="flow-successful-next" sourceRef="enter-successful-repair" targetRef="enter-next-service" />
    <bpmn:sequenceFlow id="flow-next-end" sourceRef="enter-next-service" targetRef="completed-end" />
  </bpmn:process>
</bpmn:definitions>
