<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Robotic Burger Seller" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wantsMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pfMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>startDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sideChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sideMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>afterMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pfBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statusUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pjBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" />
    <bpmn:task id="receive" name="Receive the order" />
    <bpmn:task id="askMenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="wantsMenu" name="Customer wants a menu?" />
    <bpmn:parallelGateway id="pfMenu" />
    <bpmn:task id="startDrink" name="Start preparing the drink" />
    <bpmn:task id="askSide" name="Ask if you want fries or wedges" />
    <bpmn:exclusiveGateway id="sideChoice" name="Fries or wedges?" />
    <bpmn:task id="prepareFries" name="Prepare the fries" />
    <bpmn:task id="prepareWedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="sideMerge" />
    <bpmn:parallelGateway id="joinMenu" />
    <bpmn:exclusiveGateway id="afterMenu" />
    <bpmn:parallelGateway id="pfBurger" />
    <bpmn:task id="prepareBurger" name="Prepare the burger" />
    <bpmn:task id="statusUpdates" name="Give enthusiastic status updates every 30 seconds" />
    <bpmn:parallelGateway id="pjBurger" />
    <bpmn:task id="deliver" name="Deliver the order via a conveyor belt" />
    <bpmn:endEvent id="end" name="Order delivered" />

    <bpmn:sequenceFlow id="fStart" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="fReceive" sourceRef="receive" targetRef="askMenu" />
    <bpmn:sequenceFlow id="fAskMenu" sourceRef="askMenu" targetRef="wantsMenu" />
    <bpmn:sequenceFlow id="fMenu" name="menu" sourceRef="wantsMenu" targetRef="pfMenu" />
    <bpmn:sequenceFlow id="fJustBurger" name="just the burger" sourceRef="wantsMenu" targetRef="afterMenu" />
    <bpmn:sequenceFlow id="fPfDrink" sourceRef="pfMenu" targetRef="startDrink" />
    <bpmn:sequenceFlow id="fPfSide" sourceRef="pfMenu" targetRef="askSide" />
    <bpmn:sequenceFlow id="fDrinkJoin" sourceRef="startDrink" targetRef="joinMenu" />
    <bpmn:sequenceFlow id="fSideChoice" sourceRef="askSide" targetRef="sideChoice" />
    <bpmn:sequenceFlow id="fFries" name="fries" sourceRef="sideChoice" targetRef="prepareFries" />
    <bpmn:sequenceFlow id="fWedges" name="wedges" sourceRef="sideChoice" targetRef="prepareWedges" />
    <bpmn:sequenceFlow id="fFriesMerge" sourceRef="prepareFries" targetRef="sideMerge" />
    <bpmn:sequenceFlow id="fWedgesMerge" sourceRef="prepareWedges" targetRef="sideMerge" />
    <bpmn:sequenceFlow id="fSideJoin" sourceRef="sideMerge" targetRef="joinMenu" />
    <bpmn:sequenceFlow id="fMenuDone" sourceRef="joinMenu" targetRef="afterMenu" />
    <bpmn:sequenceFlow id="fBurgerPf" sourceRef="afterMenu" targetRef="pfBurger" />
    <bpmn:sequenceFlow id="fBurger" sourceRef="pfBurger" targetRef="prepareBurger" />
    <bpmn:sequenceFlow id="fStatus" sourceRef="pfBurger" targetRef="statusUpdates" />
    <bpmn:sequenceFlow id="fBurgerJoin" sourceRef="prepareBurger" targetRef="pjBurger" />
    <bpmn:sequenceFlow id="fStatusJoin" sourceRef="statusUpdates" targetRef="pjBurger" />
    <bpmn:sequenceFlow id="fDeliver" sourceRef="pjBurger" targetRef="deliver" />
    <bpmn:sequenceFlow id="fEnd" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
