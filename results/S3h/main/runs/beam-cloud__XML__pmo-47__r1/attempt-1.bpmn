<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Sports institute" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_university</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>university_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log_into</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no_slots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-system" name="System">
        <bpmn:flowNodeRef>tell_courses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Want to register for a course" />
    <bpmn:task id="select_course" name="Select a course" />
    <bpmn:exclusiveGateway id="slots_free" name="Slots free?" />
    <bpmn:task id="tell_courses" name="Tell the courses and dates" />
    <bpmn:task id="select_one" name="Select one" />
    <bpmn:task id="check_account" name="Check if you already have an account" />
    <bpmn:exclusiveGateway id="account_gateway" name="Already have an account?" />
    <bpmn:task id="check_university" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="university_gateway" name="Registered at an eligible university?" />
    <bpmn:task id="register_account" name="Register your account" />
    <bpmn:task id="request_activation" name="Request an activation" />
    <bpmn:receiveTask id="wait_response" name="Wait for a response" />
    <bpmn:exclusiveGateway id="account_join" name="Account ready" />
    <bpmn:task id="log_into" name="Log into it" />
    <bpmn:parallelGateway id="parallel_split" />
    <bpmn:task id="tweet" name="Tweet to friends who might want to join you" />
    <bpmn:task id="complete_registration" name="Complete the registration for the course" />
    <bpmn:task id="provide_payment" name="Provide the payment information" />
    <bpmn:parallelGateway id="parallel_join" />
    <bpmn:task id="receive_ticket" name="Receive a course ticket" />
    <bpmn:endEvent id="end_success" name="End" />
    <bpmn:endEvent id="end_no_slots" name="No slots available" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="select_course" />
    <bpmn:sequenceFlow id="f2" sourceRef="select_course" targetRef="slots_free" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="slots_free" targetRef="tell_courses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">slotsFree</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="slots_free" targetRef="end_no_slots" default="f4" />
    <bpmn:sequenceFlow id="f5" sourceRef="tell_courses" targetRef="select_one" />
    <bpmn:sequenceFlow id="f6" sourceRef="select_one" targetRef="check_account" />
    <bpmn:sequenceFlow id="f7" sourceRef="check_account" targetRef="account_gateway" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="account_gateway" targetRef="account_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasAccount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="account_gateway" targetRef="check_university" />
    <bpmn:sequenceFlow id="f10" sourceRef="check_university" targetRef="university_gateway" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="university_gateway" targetRef="register_account">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">registeredAtEligibleUniversity</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="university_gateway" targetRef="request_activation" />
    <bpmn:sequenceFlow id="f13" sourceRef="register_account" targetRef="account_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="request_activation" targetRef="wait_response" />
    <bpmn:sequenceFlow id="f15" sourceRef="wait_response" targetRef="account_join" />
    <bpmn:sequenceFlow id="f16" sourceRef="account_join" targetRef="log_into" />
    <bpmn:sequenceFlow id="f17" sourceRef="log_into" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f18" sourceRef="parallel_split" targetRef="tweet" />
    <bpmn:sequenceFlow id="f19" sourceRef="parallel_split" targetRef="complete_registration" />
    <bpmn:sequenceFlow id="f20" sourceRef="complete_registration" targetRef="provide_payment" />
    <bpmn:sequenceFlow id="f21" sourceRef="provide_payment" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f22" sourceRef="tweet" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f23" sourceRef="parallel_join" targetRef="receive_ticket" />
    <bpmn:sequenceFlow id="f24" sourceRef="receive_ticket" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>
