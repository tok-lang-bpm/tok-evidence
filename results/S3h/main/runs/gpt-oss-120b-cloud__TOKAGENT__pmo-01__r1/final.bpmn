<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Process start" />
    <bpmn:task id="inquire" name="Potential customer inquires about a product or service" />
    <bpmn:task id="collect" name="Collect relevant information and address concerns" />
    <bpmn:exclusiveGateway id="decision" name="Is customer interested?" />
    <bpmn:task id="guide" name="Guide customer through selecting appropriate product or service" />
    <bpmn:task id="quote" name="Provide quote" />
    <bpmn:task id="approve" name="Customer approves quote" />
    <bpmn:task id="confirm" name="Send confirmation to customer" />
    <bpmn:endEvent id="end_yes" name="Process end - order placed" />
    <bpmn:endEvent id="end_no" name="Process end - not interested" />
    <bpmn:task id="record" name="Record order in system" />
    <bpmn:sequenceFlow id="f-s-inquire" sourceRef="s" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-collect" sourceRef="inquire" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-decision" sourceRef="collect" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-guide" name="yes" sourceRef="decision" targetRef="guide" />
    <bpmn:sequenceFlow id="f-decision-end_no" name="no" sourceRef="decision" targetRef="end_no" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approve" sourceRef="quote" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-record" sourceRef="approve" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-confirm" sourceRef="record" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-end_yes" sourceRef="confirm" targetRef="end_yes" />
  </bpmn:process>
</bpmn:definitions>
