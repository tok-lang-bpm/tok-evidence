tok 1.0
pool org "Organization"
  lane sales "Sales"
    start s "Process start"
    task inquire "Potential customer inquires about a product or service"
    task collect "Collect relevant information and address concerns"
    xor decision "Is customer interested?"
    task guide "Guide customer through selecting appropriate product or service"
    task quote "Provide quote"
    task approve "Customer approves quote"
    task confirm "Send confirmation to customer"
    end end_yes "Process end - order placed"
    end end_no "Process end - not interested"
  lane system "System"
    task record "Record order in system"

  flow s -> inquire
  flow inquire -> collect
  flow collect -> decision
  flow decision -> guide "yes"
  flow decision -> end_no "no"
  flow guide -> quote
  flow quote -> approve
  flow approve -> record
  flow record -> confirm
  flow confirm -> end_yes
