tok 1.0
pool org "Organization" {
  lane sales "Sales"
  lane system "System"
}
start s "Process start"
task inquire "Potential customer inquires about a product or service" lane=sales
task collect "Collect relevant information and address concerns" lane=sales
xor decision "Is customer interested?"
flow s -> inquire
flow inquire -> collect
flow collect -> decision
flow decision -> guide "yes"
flow decision -> end_no "no"
task guide "Guide customer through selecting appropriate product or service" lane=sales
task quote "Provide quote" lane=sales
task approve "Customer approves quote" lane=sales
task record "Record order in system" lane=system
task confirm "Send confirmation to customer" lane=sales
end end_yes "Process end - order placed"
end end_no "Process end - not interested"
flow guide -> quote
flow quote -> approve
flow approve -> record
flow record -> confirm
flow confirm -> end_yes