<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create-job-desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post-job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-screen-resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview-type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-candidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiation-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate-salary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="candidate" name="Candidate">
        <bpmn:flowNodeRef>accept-offer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="identify-need" name="Identify need for new hire" />
    <bpmn:task id="create-job-desc" name="Create job description" />
    <bpmn:task id="post-job" name="Post job on job boards" />
    <bpmn:task id="collect-screen-resumes" name="Collect and screen resumes" />
    <bpmn:task id="phone-interview" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="interview-type" name="Candidate prefers in‑person interview?" />
    <bpmn:task id="inperson-interview" name="Conduct in‑person interview" />
    <bpmn:task id="virtual-interview" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="interview-join" name="Join interview paths" />
    <bpmn:task id="choose-candidate" name="Choose candidate" />
    <bpmn:task id="extend-offer" name="Extend offer to candidate" />
    <bpmn:exclusiveGateway id="negotiation-decision" name="Salary negotiation needed?" default="f-negotiation-decision-accept-offer" />
    <bpmn:task id="negotiate-salary" name="Negotiate salary" />
    <bpmn:parallelGateway id="onboarding-split" name="Onboarding parallel split" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Provide orientation" />
    <bpmn:task id="training" name="Conduct training" />
    <bpmn:parallelGateway id="onboarding-join" name="Onboarding join" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:task id="accept-offer" name="Accept offer" />
    <bpmn:sequenceFlow id="f-start1-identify-need" sourceRef="start1" targetRef="identify-need" />
    <bpmn:sequenceFlow id="f-identify-need-create-job-desc" sourceRef="identify-need" targetRef="create-job-desc" />
    <bpmn:sequenceFlow id="f-create-job-desc-post-job" sourceRef="create-job-desc" targetRef="post-job" />
    <bpmn:sequenceFlow id="f-post-job-collect-screen-resumes" sourceRef="post-job" targetRef="collect-screen-resumes" />
    <bpmn:sequenceFlow id="f-collect-screen-resumes-phone-interview" sourceRef="collect-screen-resumes" targetRef="phone-interview" />
    <bpmn:sequenceFlow id="f-phone-interview-interview-type" sourceRef="phone-interview" targetRef="interview-type" />
    <bpmn:sequenceFlow id="f-interview-type-inperson-interview" sourceRef="interview-type" targetRef="inperson-interview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">preference = "inperson"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-interview-type-virtual-interview" sourceRef="interview-type" targetRef="virtual-interview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">preference = "virtual"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-inperson-interview-interview-join" sourceRef="inperson-interview" targetRef="interview-join" />
    <bpmn:sequenceFlow id="f-virtual-interview-interview-join" sourceRef="virtual-interview" targetRef="interview-join" />
    <bpmn:sequenceFlow id="f-interview-join-choose-candidate" sourceRef="interview-join" targetRef="choose-candidate" />
    <bpmn:sequenceFlow id="f-choose-candidate-extend-offer" sourceRef="choose-candidate" targetRef="extend-offer" />
    <bpmn:sequenceFlow id="f-extend-offer-negotiation-decision" sourceRef="extend-offer" targetRef="negotiation-decision" />
    <bpmn:sequenceFlow id="f-negotiation-decision-negotiate-salary" sourceRef="negotiation-decision" targetRef="negotiate-salary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">negotiationNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-negotiation-decision-accept-offer" sourceRef="negotiation-decision" targetRef="accept-offer" />
    <bpmn:sequenceFlow id="f-negotiate-salary-accept-offer" sourceRef="negotiate-salary" targetRef="accept-offer" />
    <bpmn:sequenceFlow id="f-accept-offer-onboarding-split" sourceRef="accept-offer" targetRef="onboarding-split" />
    <bpmn:sequenceFlow id="f-onboarding-split-paperwork" sourceRef="onboarding-split" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-onboarding-split-orientation" sourceRef="onboarding-split" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-onboarding-split-training" sourceRef="onboarding-split" targetRef="training" />
    <bpmn:sequenceFlow id="f-paperwork-onboarding-join" sourceRef="paperwork" targetRef="onboarding-join" />
    <bpmn:sequenceFlow id="f-orientation-onboarding-join" sourceRef="orientation" targetRef="onboarding-join" />
    <bpmn:sequenceFlow id="f-training-onboarding-join" sourceRef="training" targetRef="onboarding-join" />
    <bpmn:sequenceFlow id="f-onboarding-join-end1" sourceRef="onboarding-join" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
