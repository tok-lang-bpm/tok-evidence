tok 1.0

pool org "Organization"
  lane department "Department"
    start start1 "Start"
    task identify-need "Identify need for new hire"
  lane hr "HR"
    task create-job-desc "Create job description"
    task post-job "Post job on job boards"
    task collect-screen-resumes "Collect and screen resumes"
    task phone-interview "Conduct initial phone interviews"
    xor interview-type "Candidate prefers in‑person interview?"
    task inperson-interview "Conduct in‑person interview"
    task virtual-interview "Conduct virtual interview"
    xor interview-join "Join interview paths"
    task choose-candidate "Choose candidate"
    task extend-offer "Extend offer to candidate"
    xor negotiation-decision "Salary negotiation needed?"
    task negotiate-salary "Negotiate salary"
    and onboarding-split "Onboarding parallel split"
    task paperwork "Complete paperwork"
    task orientation "Provide orientation"
    task training "Conduct training"
    and onboarding-join "Onboarding join"
    end end1 "End"
  lane candidate "Candidate"
    task accept-offer "Accept offer"

flow start1 -> identify-need
flow identify-need -> create-job-desc
flow create-job-desc -> post-job
flow post-job -> collect-screen-resumes
flow collect-screen-resumes -> phone-interview
flow phone-interview -> interview-type
flow interview-type -> inperson-interview when="preference = \"inperson\""
flow interview-type -> virtual-interview when="preference = \"virtual\""
flow inperson-interview -> interview-join
flow virtual-interview -> interview-join
flow interview-join -> choose-candidate
flow choose-candidate -> extend-offer
flow extend-offer -> negotiation-decision
flow negotiation-decision -> negotiate-salary when="negotiationNeeded = true"
flow negotiation-decision -> accept-offer default
flow negotiate-salary -> accept-offer
flow accept-offer -> onboarding-split
flow onboarding-split -> paperwork
flow onboarding-split -> orientation
flow onboarding-split -> training
flow paperwork -> onboarding-join
flow orientation -> onboarding-join
flow training -> onboarding-join
flow onboarding-join -> end1
