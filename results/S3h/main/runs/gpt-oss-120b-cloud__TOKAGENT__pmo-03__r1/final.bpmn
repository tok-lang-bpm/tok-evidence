<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor-inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signal-reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-expected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record-system</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>receive-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect-quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-storage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="monitor-inventory" name="monitor inventory levels" />
    <bpmn:exclusiveGateway id="g_threshold" name="stock reaches threshold?" default="f-g_threshold-monitor-inventory" />
    <bpmn:task id="signal-reorder" name="signal need to reorder" />
    <bpmn:task id="update-expected" name="update inventory system with expected delivery dates" />
    <bpmn:parallelGateway id="g_split" name="Parallel activities" />
    <bpmn:task id="record-system" name="record in system" />
    <bpmn:parallelGateway id="g_join" name="Join parallel activities" />
    <bpmn:task id="update-levels" name="update inventory levels after restock" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="place-order" name="place order with suppliers" />
    <bpmn:task id="receive-stock" name="receive stock" />
    <bpmn:task id="inspect-quality" name="inspect for quality" />
    <bpmn:task id="place-storage" name="place on shelves or in storage" />
    <bpmn:sequenceFlow id="f-start-monitor-inventory" sourceRef="start" targetRef="monitor-inventory" />
    <bpmn:sequenceFlow id="f-monitor-inventory-g_threshold" sourceRef="monitor-inventory" targetRef="g_threshold" />
    <bpmn:sequenceFlow id="f-g_threshold-signal-reorder" sourceRef="g_threshold" targetRef="signal-reorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &gt;= threshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_threshold-monitor-inventory" sourceRef="g_threshold" targetRef="monitor-inventory" />
    <bpmn:sequenceFlow id="f-signal-reorder-place-order" sourceRef="signal-reorder" targetRef="place-order" />
    <bpmn:sequenceFlow id="f-place-order-update-expected" sourceRef="place-order" targetRef="update-expected" />
    <bpmn:sequenceFlow id="f-update-expected-receive-stock" sourceRef="update-expected" targetRef="receive-stock" />
    <bpmn:sequenceFlow id="f-receive-stock-g_split" sourceRef="receive-stock" targetRef="g_split" />
    <bpmn:sequenceFlow id="f-g_split-inspect-quality" sourceRef="g_split" targetRef="inspect-quality" />
    <bpmn:sequenceFlow id="f-g_split-record-system" sourceRef="g_split" targetRef="record-system" />
    <bpmn:sequenceFlow id="f-g_split-place-storage" sourceRef="g_split" targetRef="place-storage" />
    <bpmn:sequenceFlow id="f-inspect-quality-g_join" sourceRef="inspect-quality" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-record-system-g_join" sourceRef="record-system" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-place-storage-g_join" sourceRef="place-storage" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_join-update-levels" sourceRef="g_join" targetRef="update-levels" />
    <bpmn:sequenceFlow id="f-update-levels-end" sourceRef="update-levels" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
