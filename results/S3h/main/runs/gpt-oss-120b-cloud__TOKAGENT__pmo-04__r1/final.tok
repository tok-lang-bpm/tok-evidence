tok 1.0

pool company "Company" {
  lane marketing "Marketing Team" {
    task define-objectives "Define campaign objectives"
    and split-creation "Creation activities"
    task create-content "Create content"
    task design-visuals "Design visuals"
    task select-channels "Select promotion channels"
    and join-creation "Join creation"
    task launch-campaign "Launch campaign"
    task track-performance "Track campaign performance"
    task campaign-end "Campaign period ends"
    task analyze-performance "Analyze performance for future optimization"
  }
  lane crm "CRM System" {
    task collect-leads "Collect leads in CRM"
  }
  lane sales "Sales Team" {
    task follow-up "Follow up leads"
  }
}

start s "Start"
end e "End"

flow s -> define-objectives
flow define-objectives -> split-creation
flow split-creation -> create-content
flow split-creation -> design-visuals
flow split-creation -> select-channels
flow create-content -> join-creation
flow design-visuals -> join-creation
flow select-channels -> join-creation
flow join-creation -> launch-campaign
flow launch-campaign -> track-performance
flow track-performance -> collect-leads
flow collect-leads -> follow-up
flow follow-up -> campaign-end
flow campaign-end -> analyze-performance
flow analyze-performance -> e
