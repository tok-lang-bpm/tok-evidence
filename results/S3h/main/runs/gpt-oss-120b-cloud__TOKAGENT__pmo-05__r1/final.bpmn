<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier Onboarding Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Supplier Onboarding Process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv_responses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_proposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site_visit_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_site_visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin_negotiations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreement_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard_supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Suppliers">
        <bpmn:flowNodeRef>submit_proposal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Identify need for new supplier" />
    <bpmn:task id="issue_rfp" name="Issue request for proposals (RFP)" />
    <bpmn:parallelGateway id="split_gather" name="Gather proposals" />
    <bpmn:task id="recv_responses" name="Receive supplier responses" />
    <bpmn:parallelGateway id="join_gather" name="Proposals received" />
    <bpmn:task id="evaluate_proposals" name="Evaluate proposals based on criteria" />
    <bpmn:exclusiveGateway id="site_visit_decision" name="Site visits needed?" />
    <bpmn:task id="conduct_site_visits" name="Conduct site visits or interviews" />
    <bpmn:task id="select_supplier" name="Select supplier" />
    <bpmn:task id="begin_negotiations" name="Begin contract negotiations" />
    <bpmn:exclusiveGateway id="agreement_decision" name="Agreement reached?" />
    <bpmn:task id="sign_contract" name="Sign contract" />
    <bpmn:task id="onboard_supplier" name="Onboard supplier and execute contract" />
    <bpmn:endEvent id="end" name="Process ends" />
    <bpmn:task id="submit_proposal" name="Submit proposal" />
    <bpmn:sequenceFlow id="f-start-issue_rfp" sourceRef="start" targetRef="issue_rfp" />
    <bpmn:sequenceFlow id="f-issue_rfp-split_gather" sourceRef="issue_rfp" targetRef="split_gather" />
    <bpmn:sequenceFlow id="f-split_gather-recv_responses" sourceRef="split_gather" targetRef="recv_responses" />
    <bpmn:sequenceFlow id="f-split_gather-submit_proposal" sourceRef="split_gather" targetRef="submit_proposal" />
    <bpmn:sequenceFlow id="f-recv_responses-join_gather" sourceRef="recv_responses" targetRef="join_gather" />
    <bpmn:sequenceFlow id="f-submit_proposal-join_gather" sourceRef="submit_proposal" targetRef="join_gather" />
    <bpmn:sequenceFlow id="f-join_gather-evaluate_proposals" sourceRef="join_gather" targetRef="evaluate_proposals" />
    <bpmn:sequenceFlow id="f-evaluate_proposals-site_visit_decision" sourceRef="evaluate_proposals" targetRef="site_visit_decision" />
    <bpmn:sequenceFlow id="f-site_visit_decision-conduct_site_visits" sourceRef="site_visit_decision" targetRef="conduct_site_visits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-site_visit_decision-select_supplier" sourceRef="site_visit_decision" targetRef="select_supplier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-conduct_site_visits-select_supplier" sourceRef="conduct_site_visits" targetRef="select_supplier" />
    <bpmn:sequenceFlow id="f-select_supplier-begin_negotiations" sourceRef="select_supplier" targetRef="begin_negotiations" />
    <bpmn:sequenceFlow id="f-begin_negotiations-agreement_decision" sourceRef="begin_negotiations" targetRef="agreement_decision" />
    <bpmn:sequenceFlow id="f-agreement_decision-sign_contract" sourceRef="agreement_decision" targetRef="sign_contract">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-agreement_decision-begin_negotiations" sourceRef="agreement_decision" targetRef="begin_negotiations">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sign_contract-onboard_supplier" sourceRef="sign_contract" targetRef="onboard_supplier" />
    <bpmn:sequenceFlow id="f-onboard_supplier-end" sourceRef="onboard_supplier" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
