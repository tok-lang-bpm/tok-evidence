tok 1.0 "Supplier Onboarding Process"

pool company "Company"
  lane procurement "Procurement Team"
    start start "Identify need for new supplier"
    task issue_rfp "Issue request for proposals (RFP)"
    and split_gather "Gather proposals"
    task recv_responses "Receive supplier responses"
    and join_gather "Proposals received"
    task evaluate_proposals "Evaluate proposals based on criteria"
    xor site_visit_decision "Site visits needed?"
    task conduct_site_visits "Conduct site visits or interviews"
    task select_supplier "Select supplier"
    task begin_negotiations "Begin contract negotiations"
    xor agreement_decision "Agreement reached?"
    task sign_contract "Sign contract"
    task onboard_supplier "Onboard supplier and execute contract"
    end end "Process ends"
  lane supplier "Suppliers"
    task submit_proposal "Submit proposal"

  flow start -> issue_rfp
  flow issue_rfp -> split_gather
  flow split_gather -> recv_responses
  flow split_gather -> submit_proposal
  flow recv_responses -> join_gather
  flow submit_proposal -> join_gather
  flow join_gather -> evaluate_proposals
  flow evaluate_proposals -> site_visit_decision
  flow site_visit_decision -> conduct_site_visits when="true"
  flow site_visit_decision -> select_supplier when="false"
  flow conduct_site_visits -> select_supplier
  flow select_supplier -> begin_negotiations
  flow begin_negotiations -> agreement_decision
  flow agreement_decision -> sign_contract when="true"
  flow agreement_decision -> begin_negotiations when="false"
  flow sign_contract -> onboard_supplier
  flow onboard_supplier -> end
