tok 1.0 "Supplier Onboarding Process"

pool company "Company" {
  lane procurement "Procurement Team"
  lane supplier "Suppliers"

  procurement start start "Identify need for new supplier"
  procurement task issue_rfp "Issue request for proposals (RFP)"
  procurement and split_gather "Gather proposals"
  procurement task recv_responses "Receive supplier responses"
  supplier task submit_proposal "Submit proposal"
  procurement and join_gather "Proposals received"
  procurement task evaluate_proposals "Evaluate proposals based on criteria"
  procurement xor site_visit_decision "Site visits needed?"
  procurement task conduct_site_visits "Conduct site visits or interviews"
  procurement task select_supplier "Select supplier"
  procurement task begin_negotiations "Begin contract negotiations"
  procurement xor agreement_decision "Agreement reached?"
  procurement task sign_contract "Sign contract"
  procurement task onboard_supplier "Onboard supplier and execute contract"
  procurement end end "Process ends"

  flow start -> issue_rfp
  flow issue_rfp -> split_gather
  flow split_gather -> recv_responses
  flow split_gather -> submit_proposal
  flow recv_responses -> join_gather
  flow submit_proposal -> join_gather
  flow join_gather -> evaluate_proposals
  flow evaluate_proposals -> site_visit_decision
  flow site_visit_decision -> conduct_site_visits "yes"
  flow site_visit_decision -> select_supplier default
  flow conduct_site_visits -> select_supplier
  flow select_supplier -> begin_negotiations
  flow begin_negotiations -> agreement_decision
  flow agreement_decision -> sign_contract "yes"
  flow agreement_decision -> begin_negotiations default
  flow sign_contract -> onboard_supplier
  flow onboard_supplier -> end
}
