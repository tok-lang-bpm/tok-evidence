<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Company" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handle-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-feedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse Team">
        <bpmn:flowNodeRef>pick-pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics Provider">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="place-order" name="Place order" />
    <bpmn:endEvent id="end-success" name="Process ends" />
    <bpmn:task id="generate-confirmation" name="Generate and send order confirmation" />
    <bpmn:task id="send-tracking" name="Send tracking information" />
    <bpmn:task id="monitor" name="Monitor shipment" />
    <bpmn:exclusiveGateway id="delivery-decision" name="Delivery outcome?" default="f-delivery-decision-handle-feedback" />
    <bpmn:task id="handle-feedback" name="Handle customer feedback or return" />
    <bpmn:endEvent id="end-feedback" name="Process ends after handling feedback" />
    <bpmn:task id="pick-pack" name="Pick, pack items and generate shipping label" />
    <bpmn:task id="handover" name="Hand over order to logistics provider" />
    <bpmn:task id="deliver" name="Deliver shipment" />
    <bpmn:sequenceFlow id="f-start-place-order" sourceRef="start" targetRef="place-order" />
    <bpmn:sequenceFlow id="f-place-order-generate-confirmation" sourceRef="place-order" targetRef="generate-confirmation" />
    <bpmn:sequenceFlow id="f-generate-confirmation-pick-pack" sourceRef="generate-confirmation" targetRef="pick-pack" />
    <bpmn:sequenceFlow id="f-pick-pack-handover" sourceRef="pick-pack" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-deliver" sourceRef="handover" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-send-tracking" sourceRef="deliver" targetRef="send-tracking" />
    <bpmn:sequenceFlow id="f-send-tracking-monitor" sourceRef="send-tracking" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-delivery-decision" sourceRef="monitor" targetRef="delivery-decision" />
    <bpmn:sequenceFlow id="f-delivery-decision-end-success" name="delivery successful" sourceRef="delivery-decision" targetRef="end-success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-delivery-decision-handle-feedback" name="feedback/return" sourceRef="delivery-decision" targetRef="handle-feedback" />
    <bpmn:sequenceFlow id="f-handle-feedback-end-feedback" sourceRef="handle-feedback" targetRef="end-feedback" />
  </bpmn:process>
</bpmn:definitions>
