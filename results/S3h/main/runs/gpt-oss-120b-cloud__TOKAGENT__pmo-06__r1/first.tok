tok 1.0

pool org "Company" {
  lane customer "Customer"
  lane system "System"
  lane warehouse "Warehouse Team"
  lane logistics "Logistics Provider"
}

start

task place-order "Place order" lane=customer

task generate-confirmation "Generate and send order confirmation" lane=system

task pick-pack "Pick, pack items and generate shipping label" lane=warehouse

task handover "Hand over order to logistics provider" lane=warehouse

task deliver "Deliver shipment" lane=logistics

task send-tracking "Send tracking information" lane=system

task monitor "Monitor shipment" lane=system

xor delivery-decision "Delivery outcome?"

end end-success "Process ends"

task handle-feedback "Handle customer feedback or return" lane=system

end end-feedback "Process ends after handling feedback"

flow start -> place-order
flow place-order -> generate-confirmation
flow generate-confirmation -> pick-pack
flow pick-pack -> handover
flow handover -> deliver
flow deliver -> send-tracking
flow send-tracking -> monitor
flow monitor -> delivery-decision
flow delivery-decision -> end-success "delivery successful" when="true"
flow delivery-decision -> handle-feedback "feedback/return"
flow handle-feedback -> end-feedback
