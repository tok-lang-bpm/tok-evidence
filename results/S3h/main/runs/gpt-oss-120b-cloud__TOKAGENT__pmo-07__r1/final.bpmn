<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="TravelCompany" name="Travel Company" processRef="TravelCompany-process" />
  </bpmn:collaboration>
  <bpmn:process id="TravelCompany-process" name="Travel Company" isExecutable="false">
    <bpmn:laneSet id="TravelCompany-lanes">
      <bpmn:lane id="Customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete-journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BookingSystem" name="Booking System">
        <bpmn:flowNodeRef>generate-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-reminders</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="TravelCompanyDept" name="Travel Company">
        <bpmn:flowNodeRef>update-inventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="search-ticket" name="search for a ticket" />
    <bpmn:task id="select-route" name="select preferred route, date, and time" />
    <bpmn:task id="provide-info" name="provide personal information and payment details" />
    <bpmn:task id="complete-journey" name="complete journey" />
    <bpmn:exclusiveGateway id="feedback" name="collect post-travel feedback?" />
    <bpmn:task id="collect-feedback" name="collect post-travel feedback" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="generate-ticket" name="generate ticket" />
    <bpmn:exclusiveGateway id="send-method" name="send ticket via email or SMS?" />
    <bpmn:task id="send-email" name="send ticket via email" />
    <bpmn:task id="send-sms" name="send ticket via SMS" />
    <bpmn:exclusiveGateway id="send-join" name="ticket sent" />
    <bpmn:exclusiveGateway id="send-reminder" name="send reminders and instructions?" />
    <bpmn:task id="send-reminders" name="send reminders and instructions" />
    <bpmn:task id="update-inventory" name="update seat inventory" />
    <bpmn:sequenceFlow id="f-start-search-ticket" sourceRef="start" targetRef="search-ticket" />
    <bpmn:sequenceFlow id="f-search-ticket-select-route" sourceRef="search-ticket" targetRef="select-route" />
    <bpmn:sequenceFlow id="f-select-route-provide-info" sourceRef="select-route" targetRef="provide-info" />
    <bpmn:sequenceFlow id="f-provide-info-generate-ticket" sourceRef="provide-info" targetRef="generate-ticket" />
    <bpmn:sequenceFlow id="f-generate-ticket-send-method" sourceRef="generate-ticket" targetRef="send-method" />
    <bpmn:sequenceFlow id="f-send-method-send-email" name="email" sourceRef="send-method" targetRef="send-email" />
    <bpmn:sequenceFlow id="f-send-method-send-sms" name="sms" sourceRef="send-method" targetRef="send-sms" />
    <bpmn:sequenceFlow id="f-send-email-send-join" sourceRef="send-email" targetRef="send-join" />
    <bpmn:sequenceFlow id="f-send-sms-send-join" sourceRef="send-sms" targetRef="send-join" />
    <bpmn:sequenceFlow id="f-send-join-update-inventory" sourceRef="send-join" targetRef="update-inventory" />
    <bpmn:sequenceFlow id="f-update-inventory-send-reminder" sourceRef="update-inventory" targetRef="send-reminder" />
    <bpmn:sequenceFlow id="f-send-reminder-send-reminders" name="yes" sourceRef="send-reminder" targetRef="send-reminders" />
    <bpmn:sequenceFlow id="f-send-reminder-complete-journey" name="no" sourceRef="send-reminder" targetRef="complete-journey" />
    <bpmn:sequenceFlow id="f-send-reminders-complete-journey" sourceRef="send-reminders" targetRef="complete-journey" />
    <bpmn:sequenceFlow id="f-complete-journey-feedback" sourceRef="complete-journey" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-collect-feedback" name="yes" sourceRef="feedback" targetRef="collect-feedback" />
    <bpmn:sequenceFlow id="f-feedback-end" name="no" sourceRef="feedback" targetRef="end" />
    <bpmn:sequenceFlow id="f-collect-feedback-end" sourceRef="collect-feedback" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
