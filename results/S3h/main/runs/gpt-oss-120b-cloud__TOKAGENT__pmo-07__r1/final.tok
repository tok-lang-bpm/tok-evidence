tok 1.0

pool TravelCompany "Travel Company"
    lane Customer "Customer"
        start start "Start"
        task search-ticket "search for a ticket"
        task select-route "select preferred route, date, and time"
        task provide-info "provide personal information and payment details"
        task complete-journey "complete journey"
        xor feedback "collect post-travel feedback?"
        task collect-feedback "collect post-travel feedback"
        end end "End"
    lane BookingSystem "Booking System"
        task generate-ticket "generate ticket"
        xor send-method "send ticket via email or SMS?"
        task send-email "send ticket via email"
        task send-sms "send ticket via SMS"
        xor send-join "ticket sent"
        xor send-reminder "send reminders and instructions?"
        task send-reminders "send reminders and instructions"
    lane TravelCompanyDept "Travel Company"
        task update-inventory "update seat inventory"

flow start -> search-ticket
flow search-ticket -> select-route
flow select-route -> provide-info
flow provide-info -> generate-ticket
flow generate-ticket -> send-method
flow send-method -> send-email "email"
flow send-method -> send-sms "sms"
flow send-email -> send-join
flow send-sms -> send-join
flow send-join -> update-inventory
flow update-inventory -> send-reminder
flow send-reminder -> send-reminders "yes"
flow send-reminder -> complete-journey "no"
flow send-reminders -> complete-journey
flow complete-journey -> feedback
flow feedback -> collect-feedback "yes"
flow feedback -> end "no"
flow collect-feedback -> end
