tok 1.0

pool TravelCompany "Travel Company" {
    lane Customer "Customer"
    lane BookingSystem "Booking System"
    lane TravelCompanyDept "Travel Company"
}

start start "Start" lane Customer

task search-ticket "search for a ticket" lane Customer

task select-route "select preferred route, date, and time" lane Customer

task provide-info "provide personal information and payment details" lane Customer

task generate-ticket "generate ticket" lane BookingSystem

xor gateway send-method "send ticket via email or SMS"

task send-email "send ticket via email" lane BookingSystem

task send-sms "send ticket via SMS" lane BookingSystem

xor gateway send-join "ticket sent"

task update-inventory "update seat inventory" lane TravelCompanyDept

xor gateway send-reminder "send reminders and instructions?"

task send-reminders "send reminders and instructions" lane BookingSystem

xor gateway feedback "collect post-travel feedback?"

task collect-feedback "collect post-travel feedback" lane Customer

end end "End"

flow start -> search-ticket
flow search-ticket -> select-route
flow select-route -> provide-info
flow provide-info -> generate-ticket
flow generate-ticket -> send-method
flow send-method -> send-email "email"
flow send-method -> send-sms "sms"
flow send-email -> send-join
flow send-sms -> send-join
flow send-join -> update-inventory
flow update-inventory -> send-reminder
flow send-reminder -> send-reminders "yes"
flow send-reminder -> complete-journey "no"
flow send-reminders -> complete-journey
flow complete-journey -> feedback
flow feedback -> collect-feedback "yes"
flow feedback -> end "no"
flow collect-feedback -> end
