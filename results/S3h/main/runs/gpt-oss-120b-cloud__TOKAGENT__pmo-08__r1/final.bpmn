<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident Management Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident Management Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="reporter" name="Reporter">
        <bpmn:flowNodeRef>start-event</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tracking" name="Tracking System">
        <bpmn:flowNodeRef>log-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-team</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="investigation" name="Investigation Team">
        <bpmn:flowNodeRef>gather-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose-action</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="implementation" name="Implementation Team">
        <bpmn:flowNodeRef>solution-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement-fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement-training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement-policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>solution-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="followup" name="Follow-up Team">
        <bpmn:flowNodeRef>follow-up</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>close-notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-event</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-event" name="Incident reported" />
    <bpmn:task id="log-report" name="Log incident into tracking system" />
    <bpmn:task id="assign-team" name="Assign incident to appropriate team" />
    <bpmn:task id="gather-info" name="Gather necessary information" />
    <bpmn:task id="identify-cause" name="Identify cause of incident" />
    <bpmn:task id="propose-action" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="solution-gw" name="Select solution type?" />
    <bpmn:task id="implement-fix" name="Implement fix" />
    <bpmn:task id="implement-training" name="Implement training" />
    <bpmn:task id="implement-policy" name="Implement policy change" />
    <bpmn:exclusiveGateway id="solution-join" name="Merge solution branches" />
    <bpmn:task id="follow-up" name="Perform follow-up" />
    <bpmn:task id="close-notify" name="Close incident report and notify stakeholders" />
    <bpmn:endEvent id="end-event" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-event-log-report" sourceRef="start-event" targetRef="log-report" />
    <bpmn:sequenceFlow id="f-log-report-assign-team" sourceRef="log-report" targetRef="assign-team" />
    <bpmn:sequenceFlow id="f-assign-team-gather-info" sourceRef="assign-team" targetRef="gather-info" />
    <bpmn:sequenceFlow id="f-gather-info-identify-cause" sourceRef="gather-info" targetRef="identify-cause" />
    <bpmn:sequenceFlow id="f-identify-cause-propose-action" sourceRef="identify-cause" targetRef="propose-action" />
    <bpmn:sequenceFlow id="f-propose-action-solution-gw" sourceRef="propose-action" targetRef="solution-gw" />
    <bpmn:sequenceFlow id="f-solution-gw-implement-fix" name="Fix" sourceRef="solution-gw" targetRef="implement-fix" />
    <bpmn:sequenceFlow id="f-solution-gw-implement-training" name="Training" sourceRef="solution-gw" targetRef="implement-training" />
    <bpmn:sequenceFlow id="f-solution-gw-implement-policy" name="Policy change" sourceRef="solution-gw" targetRef="implement-policy" />
    <bpmn:sequenceFlow id="f-implement-fix-solution-join" sourceRef="implement-fix" targetRef="solution-join" />
    <bpmn:sequenceFlow id="f-implement-training-solution-join" sourceRef="implement-training" targetRef="solution-join" />
    <bpmn:sequenceFlow id="f-implement-policy-solution-join" sourceRef="implement-policy" targetRef="solution-join" />
    <bpmn:sequenceFlow id="f-solution-join-follow-up" sourceRef="solution-join" targetRef="follow-up" />
    <bpmn:sequenceFlow id="f-follow-up-close-notify" sourceRef="follow-up" targetRef="close-notify" />
    <bpmn:sequenceFlow id="f-close-notify-end-event" sourceRef="close-notify" targetRef="end-event" />
  </bpmn:process>
</bpmn:definitions>
