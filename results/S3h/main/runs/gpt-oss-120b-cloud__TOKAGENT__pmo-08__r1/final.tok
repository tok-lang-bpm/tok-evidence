tok 1.0 "Incident Management Process"
pool org "Organization"
  lane reporter "Reporter"
    start start-event "Incident reported"
  lane tracking "Tracking System"
    task log-report "Log incident into tracking system"
    task assign-team "Assign incident to appropriate team"
  lane investigation "Investigation Team"
    task gather-info "Gather necessary information"
    task identify-cause "Identify cause of incident"
    task propose-action "Propose corrective actions"
  lane implementation "Implementation Team"
    xor solution-gw "Select solution type?"
    task implement-fix "Implement fix"
    task implement-training "Implement training"
    task implement-policy "Implement policy change"
    xor solution-join "Merge solution branches"
  lane followup "Follow-up Team"
    task follow-up "Perform follow-up"
  lane stakeholders "Stakeholders"
    task close-notify "Close incident report and notify stakeholders"
    end end-event "Process completed"
flow start-event -> log-report
flow log-report -> assign-team
flow assign-team -> gather-info
flow gather-info -> identify-cause
flow identify-cause -> propose-action
flow propose-action -> solution-gw
flow solution-gw -> implement-fix "Fix"
flow solution-gw -> implement-training "Training"
flow solution-gw -> implement-policy "Policy change"
flow implement-fix -> solution-join
flow implement-training -> solution-join
flow implement-policy -> solution-join
flow solution-join -> follow-up
flow follow-up -> close-notify
flow close-notify -> end-event
