<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rd" name="R&amp;D Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft-design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build-prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test-prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision-refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine-prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision-approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="identify-idea" name="Identify idea for new product or improvement" />
    <bpmn:task id="conduct-research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft-design" name="Draft design concepts" />
    <bpmn:task id="build-prototype" name="Build prototype using available materials and resources" />
    <bpmn:task id="test-prototype" name="Test prototype for functionality, safety, and market potential" />
    <bpmn:task id="collect-feedback" name="Collect feedback from testing phase" />
    <bpmn:exclusiveGateway id="decision-refine" name="Is refinement needed?" />
    <bpmn:task id="refine-prototype" name="Refine prototype as needed" />
    <bpmn:exclusiveGateway id="decision-approval" name="Is prototype approved?" />
    <bpmn:endEvent id="end-approved" name="Approved for further development" />
    <bpmn:endEvent id="end-discarded" name="Discarded" />
    <bpmn:sequenceFlow id="f-start-identify-idea" sourceRef="start" targetRef="identify-idea" />
    <bpmn:sequenceFlow id="f-identify-idea-conduct-research" sourceRef="identify-idea" targetRef="conduct-research" />
    <bpmn:sequenceFlow id="f-conduct-research-draft-design" sourceRef="conduct-research" targetRef="draft-design" />
    <bpmn:sequenceFlow id="f-draft-design-build-prototype" sourceRef="draft-design" targetRef="build-prototype" />
    <bpmn:sequenceFlow id="f-build-prototype-test-prototype" sourceRef="build-prototype" targetRef="test-prototype" />
    <bpmn:sequenceFlow id="f-test-prototype-collect-feedback" sourceRef="test-prototype" targetRef="collect-feedback" />
    <bpmn:sequenceFlow id="f-collect-feedback-decision-refine" sourceRef="collect-feedback" targetRef="decision-refine" />
    <bpmn:sequenceFlow id="f-decision-refine-refine-prototype" name="yes" sourceRef="decision-refine" targetRef="refine-prototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refinement = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-refine-decision-approval" name="no" sourceRef="decision-refine" targetRef="decision-approval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refinement = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-refine-prototype-test-prototype" sourceRef="refine-prototype" targetRef="test-prototype" />
    <bpmn:sequenceFlow id="f-decision-approval-end-approved" name="approved" sourceRef="decision-approval" targetRef="end-approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-approval-end-discarded" name="discarded" sourceRef="decision-approval" targetRef="end-discarded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
