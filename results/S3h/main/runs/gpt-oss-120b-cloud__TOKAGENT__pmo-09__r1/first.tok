tok 1.0

pool org "Organisation" {
  lane rd "R&D Team" {
    start start
    task identify-idea "Identify idea for new product or improvement"
    task conduct-research "Conduct initial research and feasibility studies"
    task draft-design "Draft design concepts"
    task build-prototype "Build prototype using available materials and resources"
    task test-prototype "Test prototype for functionality, safety, and market potential"
    task collect-feedback "Collect feedback from testing phase"
    xor decision-refine "Is refinement needed?"
    task refine-prototype "Refine prototype as needed"
    xor decision-approval "Is prototype approved?"
    end end-approved "Approved for further development"
    end end-discarded "Discarded"
  }
}

flow start -> identify-idea
flow identify-idea -> conduct-research
flow conduct-research -> draft-design
flow draft-design -> build-prototype
flow build-prototype -> test-prototype
flow test-prototype -> collect-feedback
flow collect-feedback -> decision-refine
flow decision-refine -> refine-prototype "yes" when="refinement = true"
flow decision-refine -> decision-approval "no" when="refinement = false"
flow refine-prototype -> test-prototype
flow decision-approval -> end-approved "approved" when="approved = true"
flow decision-approval -> end-discarded "discarded" when="approved = false"
