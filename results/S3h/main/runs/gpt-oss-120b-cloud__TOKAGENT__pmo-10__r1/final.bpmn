<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Company" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="requester" name="Requester">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT Department">
        <bpmn:flowNodeRef>procure-tools</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install-solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test-solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout-solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="submit-request" name="Submit request" />
    <bpmn:task id="assess-request" name="Assess request" />
    <bpmn:exclusiveGateway id="g1" name="Approved?" default="f-g1-end" />
    <bpmn:task id="procure-tools" name="Procure tools or licenses" />
    <bpmn:task id="install-solution" name="Install solution" />
    <bpmn:task id="test-solution" name="Test solution" />
    <bpmn:task id="rollout-solution" name="Rollout solution" />
    <bpmn:parallelGateway id="g2" name="After rollout" />
    <bpmn:task id="provide-training" name="Provide training" />
    <bpmn:task id="provide-support" name="Provide support" />
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="f-start-submit-request" sourceRef="start" targetRef="submit-request" />
    <bpmn:sequenceFlow id="f-submit-request-assess-request" sourceRef="submit-request" targetRef="assess-request" />
    <bpmn:sequenceFlow id="f-assess-request-g1" sourceRef="assess-request" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-procure-tools" name="yes" sourceRef="g1" targetRef="procure-tools">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-end" name="no" sourceRef="g1" targetRef="end" />
    <bpmn:sequenceFlow id="f-procure-tools-install-solution" sourceRef="procure-tools" targetRef="install-solution" />
    <bpmn:sequenceFlow id="f-install-solution-test-solution" sourceRef="install-solution" targetRef="test-solution" />
    <bpmn:sequenceFlow id="f-test-solution-rollout-solution" sourceRef="test-solution" targetRef="rollout-solution" />
    <bpmn:sequenceFlow id="f-rollout-solution-g2" sourceRef="rollout-solution" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-provide-training" sourceRef="g2" targetRef="provide-training" />
    <bpmn:sequenceFlow id="f-g2-provide-support" sourceRef="g2" targetRef="provide-support" />
    <bpmn:sequenceFlow id="f-provide-training-g2" sourceRef="provide-training" targetRef="g2" />
    <bpmn:sequenceFlow id="f-provide-support-g2" sourceRef="provide-support" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-end" sourceRef="g2" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
