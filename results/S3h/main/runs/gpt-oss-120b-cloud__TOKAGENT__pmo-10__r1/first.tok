tok 1.0

pool company "Company" {
  lane requester "Requester"
  lane it "IT Department"
}

start start

task submit-request "Submit request" lane=requester

task assess-request "Assess request" lane=it

xor g1 "Approved?"

task procure-tools "Procure tools or licenses" lane=it

task install-solution "Install solution" lane=it

task test-solution "Test solution" lane=it

task rollout-solution "Rollout solution" lane=it

and g2 "After rollout"

task provide-training "Provide training" lane=it

task provide-support "Provide support" lane=it

end end

flow start -> submit-request
flow submit-request -> assess-request
flow assess-request -> g1
flow g1 -> procure-tools "yes" when="approved = true"
flow g1 -> end "no" default
flow procure-tools -> install-solution
flow install-solution -> test-solution
flow test-solution -> rollout-solution
flow rollout-solution -> g2
flow g2 -> provide-training
flow g2 -> provide-support
flow provide-training -> g2
flow provide-support -> g2
flow g2 -> end