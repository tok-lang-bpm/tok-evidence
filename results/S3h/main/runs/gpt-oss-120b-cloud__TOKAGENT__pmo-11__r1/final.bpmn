<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Subscription Service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Subscription Service" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign-up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign-access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trigger-billing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Team">
        <bpmn:flowNodeRef>process-cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terms-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply-refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply-charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund-charge-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="sign-up" name="sign up for a subscription service and enter personal and payment information" />
    <bpmn:task id="receive-updates" name="receive regular updates, product enhancements, or renewal notifications" />
    <bpmn:exclusiveGateway id="cancel-decision" name="customer decides to cancel?" default="f-cancel-decision-receive-updates" />
    <bpmn:task id="submit-cancel" name="submit cancellation request" />
    <bpmn:task id="generate-account" name="generate account" />
    <bpmn:task id="assign-access" name="assign access" />
    <bpmn:task id="trigger-billing" name="trigger automated billing cycles" />
    <bpmn:task id="process-cancel" name="process cancellation request" />
    <bpmn:exclusiveGateway id="terms-decision" name="apply refund or charge?" />
    <bpmn:task id="apply-refund" name="apply refund" />
    <bpmn:task id="apply-charge" name="apply charge" />
    <bpmn:exclusiveGateway id="refund-charge-join" name="join refunds and charges" />
    <bpmn:task id="deactivate" name="deactivate subscription and settle final account balance" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-sign-up" sourceRef="start" targetRef="sign-up" />
    <bpmn:sequenceFlow id="f-sign-up-generate-account" sourceRef="sign-up" targetRef="generate-account" />
    <bpmn:sequenceFlow id="f-generate-account-assign-access" sourceRef="generate-account" targetRef="assign-access" />
    <bpmn:sequenceFlow id="f-assign-access-trigger-billing" sourceRef="assign-access" targetRef="trigger-billing" />
    <bpmn:sequenceFlow id="f-trigger-billing-receive-updates" sourceRef="trigger-billing" targetRef="receive-updates" />
    <bpmn:sequenceFlow id="f-receive-updates-cancel-decision" sourceRef="receive-updates" targetRef="cancel-decision" />
    <bpmn:sequenceFlow id="f-cancel-decision-submit-cancel" name="yes" sourceRef="cancel-decision" targetRef="submit-cancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cancel = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-cancel-decision-receive-updates" name="no" sourceRef="cancel-decision" targetRef="receive-updates" />
    <bpmn:sequenceFlow id="f-submit-cancel-process-cancel" sourceRef="submit-cancel" targetRef="process-cancel" />
    <bpmn:sequenceFlow id="f-process-cancel-terms-decision" sourceRef="process-cancel" targetRef="terms-decision" />
    <bpmn:sequenceFlow id="f-terms-decision-apply-refund" name="refund" sourceRef="terms-decision" targetRef="apply-refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refund = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-terms-decision-apply-charge" name="charge" sourceRef="terms-decision" targetRef="apply-charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refund = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-apply-refund-refund-charge-join" sourceRef="apply-refund" targetRef="refund-charge-join" />
    <bpmn:sequenceFlow id="f-apply-charge-refund-charge-join" sourceRef="apply-charge" targetRef="refund-charge-join" />
    <bpmn:sequenceFlow id="f-refund-charge-join-deactivate" sourceRef="refund-charge-join" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f-deactivate-end" sourceRef="deactivate" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
