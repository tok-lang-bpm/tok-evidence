<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Company" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>log_and_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark_resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inv" name="Investigation Department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Financial Team">
        <bpmn:flowNodeRef>process_refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="log_and_assign" name="log complaint and assign to relevant department" />
    <bpmn:task id="mark_resolved" name="mark complaint as resolved" />
    <bpmn:task id="review" name="review complaint details" />
    <bpmn:exclusiveGateway id="decision" name="complaint valid and refund justified?" default="f-decision-notify_rejected" />
    <bpmn:task id="notify_approved" name="notify customer of approved refund" />
    <bpmn:task id="notify_rejected" name="notify customer of rejected complaint" />
    <bpmn:exclusiveGateway id="join" name="join decision" />
    <bpmn:task id="process_refund" name="process reimbursement" />
    <bpmn:startEvent id="start" name="Customer files a complaint" />
    <bpmn:task id="provide_feedback" name="provide feedback on satisfaction" />
    <bpmn:endEvent id="end" name="process end" />
    <bpmn:sequenceFlow id="f-start-log_and_assign" sourceRef="start" targetRef="log_and_assign" />
    <bpmn:sequenceFlow id="f-log_and_assign-review" sourceRef="log_and_assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-notify_approved" name="yes" sourceRef="decision" targetRef="notify_approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-notify_rejected" name="no" sourceRef="decision" targetRef="notify_rejected" />
    <bpmn:sequenceFlow id="f-notify_approved-process_refund" sourceRef="notify_approved" targetRef="process_refund" />
    <bpmn:sequenceFlow id="f-process_refund-join" sourceRef="process_refund" targetRef="join" />
    <bpmn:sequenceFlow id="f-notify_rejected-join" sourceRef="notify_rejected" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-mark_resolved" sourceRef="join" targetRef="mark_resolved" />
    <bpmn:sequenceFlow id="f-mark_resolved-provide_feedback" sourceRef="mark_resolved" targetRef="provide_feedback" />
    <bpmn:sequenceFlow id="f-provide_feedback-end" sourceRef="provide_feedback" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
