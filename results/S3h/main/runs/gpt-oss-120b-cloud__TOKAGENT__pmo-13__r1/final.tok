tok 1.0

pool org "Company"
  lane cs "Customer Service"
    task log_and_assign "log complaint and assign to relevant department"
    task mark_resolved "mark complaint as resolved"
  lane inv "Investigation Department"
    task review "review complaint details"
    xor decision "complaint valid and refund justified?"
    task notify_approved "notify customer of approved refund"
    task notify_rejected "notify customer of rejected complaint"
    xor join "join decision"
  lane fin "Financial Team"
    task process_refund "process reimbursement"
  lane cust "Customer"
    start start "Customer files a complaint"
    task provide_feedback "provide feedback on satisfaction"
    end end "process end"

flow start -> log_and_assign
flow log_and_assign -> review
flow review -> decision
flow decision -> notify_approved "yes" when="true"
flow decision -> notify_rejected "no" default
flow notify_approved -> process_refund
flow process_refund -> join
flow notify_rejected -> join
flow join -> mark_resolved
flow mark_resolved -> provide_feedback
flow provide_feedback -> end
