tok 1.0

pool org "Company"

lane cs "Customer Service"
lane inv "Investigation Department"
lane fin "Financial Team"
lane cust "Customer"

start start "Customer files a complaint"

task log_and_assign "log complaint and assign to relevant department" cs
task review "review complaint details" inv
xor decision "complaint valid and refund justified?" 

task notify_approved "notify customer of approved refund" inv
task notify_rejected "notify customer of rejected complaint" inv
task process_refund "process reimbursement" fin

xor join "join decision"

task mark_resolved "mark complaint as resolved" cs
task provide_feedback "provide feedback on satisfaction" cust

end end "process end"

flow start -> log_and_assign
flow log_and_assign -> review
flow review -> decision

flow decision -> notify_approved "yes" when="valid and refund justified"
flow decision -> notify_rejected "no" default

flow notify_approved -> process_refund
flow process_refund -> join
flow notify_rejected -> join

flow join -> mark_resolved
flow mark_resolved -> provide_feedback
flow provide_feedback -> end