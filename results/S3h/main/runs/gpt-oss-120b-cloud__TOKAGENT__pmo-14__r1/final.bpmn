<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust-plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="strategic" name="Strategic Alignment">
        <bpmn:flowNodeRef>strategic-review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance">
        <bpmn:flowNodeRef>finance-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="draft" name="Draft plan" />
    <bpmn:task id="adjust-plan" name="Adjust plan" />
    <bpmn:task id="strategic-review" name="Strategic alignment review" />
    <bpmn:task id="finance-review" name="Finance detailed review" />
    <bpmn:exclusiveGateway id="adjust" name="Adjustments needed?" default="f-adjust-allocate" />
    <bpmn:task id="allocate" name="Allocate budget" />
    <bpmn:task id="approve" name="Approve adjustments" />
    <bpmn:sequenceFlow id="f-s-outline" sourceRef="s" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-strategic-review" sourceRef="draft" targetRef="strategic-review" />
    <bpmn:sequenceFlow id="f-strategic-review-finance-review" sourceRef="strategic-review" targetRef="finance-review" />
    <bpmn:sequenceFlow id="f-finance-review-adjust" sourceRef="finance-review" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjust-adjust-plan" name="yes" sourceRef="adjust" targetRef="adjust-plan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-adjust-allocate" name="no" sourceRef="adjust" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-adjust-plan-approve" sourceRef="adjust-plan" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-finance-review" sourceRef="approve" targetRef="finance-review" />
    <bpmn:sequenceFlow id="f-allocate-e" sourceRef="allocate" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
