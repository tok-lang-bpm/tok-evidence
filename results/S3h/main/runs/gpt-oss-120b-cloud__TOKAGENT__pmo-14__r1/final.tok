tok 1.0

pool org "Organization"
  lane department "Department"
    start s "Start"
    task outline "Outline objectives"
    end e "End"
  lane team "Team"
    task draft "Draft plan"
    task adjust-plan "Adjust plan"
  lane strategic "Strategic Alignment"
    task strategic-review "Strategic alignment review"
  lane finance "Finance"
    task finance-review "Finance detailed review"
    xor adjust "Adjustments needed?"
    task allocate "Allocate budget"
  lane stakeholders "Stakeholders"
    task approve "Approve adjustments"

  flow s -> outline
  flow outline -> draft
  flow draft -> strategic-review
  flow strategic-review -> finance-review
  flow finance-review -> adjust
  flow adjust -> adjust-plan "yes" when="true"
  flow adjust -> allocate "no" default
  flow adjust-plan -> approve
  flow approve -> finance-review
  flow allocate -> e
