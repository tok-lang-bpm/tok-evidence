tok 1.0
pool org "Organization" {
  lane department "Department"
  lane team "Team"
  lane strategic "Strategic Alignment"
  lane finance "Finance"
  lane stakeholders "Stakeholders"
}

start start

task outline-objectives "Outline objectives" lane=department
task draft-plan "Draft plan" lane=team
task strategic-review "Strategic alignment review" lane=strategic
task finance-review "Finance detailed review" lane=finance

gxor dec-adjustments "Adjustments needed?"

task adjust-plan "Adjust plan" lane=team
task approve-adjustments "Approve adjustments" lane=stakeholders

task allocate-budget "Allocate budget" lane=finance

end end

flow start -> outline-objectives
flow outline-objectives -> draft-plan
flow draft-plan -> strategic-review
flow strategic-review -> finance-review
flow finance-review -> dec-adjustments
flow dec-adjustments -> adjust-plan "yes" when="true"
flow dec-adjustments -> allocate-budget "no" default
flow adjust-plan -> approve-adjustments
flow approve-adjustments -> finance-review
flow allocate-budget -> end
