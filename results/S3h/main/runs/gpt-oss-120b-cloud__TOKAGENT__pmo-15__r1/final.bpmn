<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Compliance Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance Audit Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_prep_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_prep_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make_corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_all_met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal Teams">
        <bpmn:flowNodeRef>prepare_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self_assessment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review_process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="schedule_audit" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="and_prep_start" name="Prepare for audit" />
    <bpmn:parallelGateway id="and_prep_end" name="Preparation complete" />
    <bpmn:task id="make_corrections" name="Make corrections and improvements" />
    <bpmn:task id="final_audit" name="Final audit" />
    <bpmn:exclusiveGateway id="decision_all_met" name="All criteria met?" default="f-decision_all_met-end_failure" />
    <bpmn:task id="award_cert" name="Award certification and issue documents" />
    <bpmn:endEvent id="end_success" name="Process completed with certification" />
    <bpmn:endEvent id="end_failure" name="Process ended without certification" />
    <bpmn:task id="prepare_doc" name="Prepare documentation" />
    <bpmn:task id="gather_evidence" name="Gather evidence" />
    <bpmn:task id="self_assessment" name="Conduct self-assessment" />
    <bpmn:task id="review_process" name="Auditors review processes" />
    <bpmn:sequenceFlow id="f-start-schedule_audit" sourceRef="start" targetRef="schedule_audit" />
    <bpmn:sequenceFlow id="f-schedule_audit-and_prep_start" sourceRef="schedule_audit" targetRef="and_prep_start" />
    <bpmn:sequenceFlow id="f-and_prep_start-prepare_doc" sourceRef="and_prep_start" targetRef="prepare_doc" />
    <bpmn:sequenceFlow id="f-and_prep_start-gather_evidence" sourceRef="and_prep_start" targetRef="gather_evidence" />
    <bpmn:sequenceFlow id="f-and_prep_start-self_assessment" sourceRef="and_prep_start" targetRef="self_assessment" />
    <bpmn:sequenceFlow id="f-prepare_doc-and_prep_end" sourceRef="prepare_doc" targetRef="and_prep_end" />
    <bpmn:sequenceFlow id="f-gather_evidence-and_prep_end" sourceRef="gather_evidence" targetRef="and_prep_end" />
    <bpmn:sequenceFlow id="f-self_assessment-and_prep_end" sourceRef="self_assessment" targetRef="and_prep_end" />
    <bpmn:sequenceFlow id="f-and_prep_end-review_process" sourceRef="and_prep_end" targetRef="review_process" />
    <bpmn:sequenceFlow id="f-review_process-make_corrections" sourceRef="review_process" targetRef="make_corrections" />
    <bpmn:sequenceFlow id="f-make_corrections-final_audit" sourceRef="make_corrections" targetRef="final_audit" />
    <bpmn:sequenceFlow id="f-final_audit-decision_all_met" sourceRef="final_audit" targetRef="decision_all_met" />
    <bpmn:sequenceFlow id="f-decision_all_met-award_cert" name="yes" sourceRef="decision_all_met" targetRef="award_cert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision_all_met-end_failure" name="no" sourceRef="decision_all_met" targetRef="end_failure" />
    <bpmn:sequenceFlow id="f-award_cert-end_success" sourceRef="award_cert" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>
