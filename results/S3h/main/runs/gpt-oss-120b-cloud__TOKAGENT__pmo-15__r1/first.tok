tok 1.0 "Compliance Audit Process"

pool org "Organization" {
    lane company "Company"
    lane internal "Internal Teams"
    lane auditors "Auditors"
}

# tasks
start start "Start"
task schedule_audit "Schedule compliance audit"          # company lane

task prepare_doc "Prepare documentation"               # internal lane

task gather_evidence "Gather evidence"                # internal lane

task self_assessment "Conduct self-assessment"        # internal lane

task review_process "Auditors review processes"        # auditors lane

task make_corrections "Make corrections and improvements" # company lane

task final_audit "Final audit"                         # auditors lane

task award_cert "Award certification and issue documents" # company lane

end end_success "Process completed with certification"
end end_failure "Process ended without certification"

# gateways
and and_prep_start "Prepare for audit"
and and_prep_end "Preparation complete"

xor decision_all_met "All criteria met?"

# flows
flow start -> schedule_audit
flow schedule_audit -> and_prep_start
flow and_prep_start -> prepare_doc
flow and_prep_start -> gather_evidence
flow and_prep_start -> self_assessment
flow prepare_doc -> and_prep_end
flow gather_evidence -> and_prep_end
flow self_assessment -> and_prep_end
flow and_prep_end -> review_process
flow review_process -> make_corrections
flow make_corrections -> final_audit
flow final_audit -> decision_all_met
flow decision_all_met -> award_cert "yes" when="true"
flow decision_all_met -> end_failure "no" default
flow award_cert -> end_success
