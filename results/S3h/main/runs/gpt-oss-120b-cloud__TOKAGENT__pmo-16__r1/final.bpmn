<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="audit_coordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_prep_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional_office" name="Regional Office">
        <bpmn:flowNodeRef>prepare_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_clarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance_team" name="Compliance Team">
        <bpmn:flowNodeRef>check_regulatory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central_audit_team" name="Central Audit Team">
        <bpmn:flowNodeRef>review_submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discrepancy_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval_financial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval_operational</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval_compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>highrisk_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch_investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigation_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>data_analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site_visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigation_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit_director" name="Audit Director">
        <bpmn:flowNodeRef>review_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start Audit Process" />
    <bpmn:task id="send_notification" name="Send notification to regional office" />
    <bpmn:parallelGateway id="parallel_prep" name="Prepare and Check" />
    <bpmn:parallelGateway id="parallel_prep_join" name="Prep done" />
    <bpmn:task id="prepare_docs" name="Prepare financial statements and gather documents" />
    <bpmn:task id="submit_docs" name="Submit documents to central audit team" />
    <bpmn:task id="provide_clarifications" name="Provide clarifications" />
    <bpmn:task id="check_regulatory" name="Check regulatory updates that might affect the audit" />
    <bpmn:task id="review_submission" name="Review submission" />
    <bpmn:exclusiveGateway id="discrepancy_gateway" name="Discrepancies found?" />
    <bpmn:task id="request_clarifications" name="Request clarifications from regional office" />
    <bpmn:parallelGateway id="risk_split" name="Risk assessment" />
    <bpmn:task id="eval_financial" name="Evaluate financial risks" />
    <bpmn:task id="eval_operational" name="Evaluate operational risks" />
    <bpmn:task id="eval_compliance" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="risk_join" name="Risk assessment done" />
    <bpmn:exclusiveGateway id="highrisk_gateway" name="High risk identified?" />
    <bpmn:task id="launch_investigation" name="Launch detailed investigation" />
    <bpmn:parallelGateway id="investigation_split" name="Investigation activities" />
    <bpmn:task id="data_analysis" name="Data analysis" />
    <bpmn:task id="interviews" name="Interviews" />
    <bpmn:task id="site_visits" name="Site visits" />
    <bpmn:parallelGateway id="investigation_join" name="Investigation done" />
    <bpmn:task id="compile_report" name="Compile audit report" />
    <bpmn:task id="review_report" name="Review report" />
    <bpmn:exclusiveGateway id="approval_gateway" name="Report approved?" />
    <bpmn:task id="update_report" name="Update report" />
    <bpmn:task id="distribute_archive" name="Distribute report to executive board and archive" />
    <bpmn:endEvent id="end" name="Audit process closed" />
    <bpmn:sequenceFlow id="f-start-send_notification" sourceRef="start" targetRef="send_notification" />
    <bpmn:sequenceFlow id="f-send_notification-parallel_prep" sourceRef="send_notification" targetRef="parallel_prep" />
    <bpmn:sequenceFlow id="f-parallel_prep-prepare_docs" sourceRef="parallel_prep" targetRef="prepare_docs" />
    <bpmn:sequenceFlow id="f-parallel_prep-check_regulatory" sourceRef="parallel_prep" targetRef="check_regulatory" />
    <bpmn:sequenceFlow id="f-prepare_docs-parallel_prep_join" sourceRef="prepare_docs" targetRef="parallel_prep_join" />
    <bpmn:sequenceFlow id="f-check_regulatory-parallel_prep_join" sourceRef="check_regulatory" targetRef="parallel_prep_join" />
    <bpmn:sequenceFlow id="f-parallel_prep_join-submit_docs" sourceRef="parallel_prep_join" targetRef="submit_docs" />
    <bpmn:sequenceFlow id="f-submit_docs-review_submission" sourceRef="submit_docs" targetRef="review_submission" />
    <bpmn:sequenceFlow id="f-review_submission-discrepancy_gateway" sourceRef="review_submission" targetRef="discrepancy_gateway" />
    <bpmn:sequenceFlow id="f-discrepancy_gateway-request_clarifications" name="yes" sourceRef="discrepancy_gateway" targetRef="request_clarifications" />
    <bpmn:sequenceFlow id="f-discrepancy_gateway-risk_split" name="no" sourceRef="discrepancy_gateway" targetRef="risk_split" />
    <bpmn:sequenceFlow id="f-request_clarifications-provide_clarifications" sourceRef="request_clarifications" targetRef="provide_clarifications" />
    <bpmn:sequenceFlow id="f-provide_clarifications-risk_split" sourceRef="provide_clarifications" targetRef="risk_split" />
    <bpmn:sequenceFlow id="f-risk_split-eval_financial" sourceRef="risk_split" targetRef="eval_financial" />
    <bpmn:sequenceFlow id="f-risk_split-eval_operational" sourceRef="risk_split" targetRef="eval_operational" />
    <bpmn:sequenceFlow id="f-risk_split-eval_compliance" sourceRef="risk_split" targetRef="eval_compliance" />
    <bpmn:sequenceFlow id="f-eval_financial-risk_join" sourceRef="eval_financial" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f-eval_operational-risk_join" sourceRef="eval_operational" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f-eval_compliance-risk_join" sourceRef="eval_compliance" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f-risk_join-highrisk_gateway" sourceRef="risk_join" targetRef="highrisk_gateway" />
    <bpmn:sequenceFlow id="f-highrisk_gateway-launch_investigation" name="yes" sourceRef="highrisk_gateway" targetRef="launch_investigation" />
    <bpmn:sequenceFlow id="f-highrisk_gateway-compile_report" name="no" sourceRef="highrisk_gateway" targetRef="compile_report" />
    <bpmn:sequenceFlow id="f-launch_investigation-investigation_split" sourceRef="launch_investigation" targetRef="investigation_split" />
    <bpmn:sequenceFlow id="f-investigation_split-data_analysis" sourceRef="investigation_split" targetRef="data_analysis" />
    <bpmn:sequenceFlow id="f-investigation_split-interviews" sourceRef="investigation_split" targetRef="interviews" />
    <bpmn:sequenceFlow id="f-investigation_split-site_visits" sourceRef="investigation_split" targetRef="site_visits" />
    <bpmn:sequenceFlow id="f-data_analysis-investigation_join" sourceRef="data_analysis" targetRef="investigation_join" />
    <bpmn:sequenceFlow id="f-interviews-investigation_join" sourceRef="interviews" targetRef="investigation_join" />
    <bpmn:sequenceFlow id="f-site_visits-investigation_join" sourceRef="site_visits" targetRef="investigation_join" />
    <bpmn:sequenceFlow id="f-investigation_join-compile_report" sourceRef="investigation_join" targetRef="compile_report" />
    <bpmn:sequenceFlow id="f-compile_report-review_report" sourceRef="compile_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-review_report-approval_gateway" sourceRef="review_report" targetRef="approval_gateway" />
    <bpmn:sequenceFlow id="f-approval_gateway-distribute_archive" name="yes" sourceRef="approval_gateway" targetRef="distribute_archive" />
    <bpmn:sequenceFlow id="f-approval_gateway-update_report" name="no" sourceRef="approval_gateway" targetRef="update_report" />
    <bpmn:sequenceFlow id="f-update_report-review_report" sourceRef="update_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-distribute_archive-end" sourceRef="distribute_archive" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
