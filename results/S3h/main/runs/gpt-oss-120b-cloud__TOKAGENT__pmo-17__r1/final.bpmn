<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="E-commerce Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="E-commerce Company" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>follow-up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-return-label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-returns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment" name="Payment">
        <bpmn:flowNodeRef>process-payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory">
        <bpmn:flowNodeRef>check-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-backorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick-items</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="quality" name="Quality Control">
        <bpmn:flowNodeRef>quality-check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="packaging" name="Packaging">
        <bpmn:flowNodeRef>packaging-task</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping">
        <bpmn:flowNodeRef>prepare-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="returns" name="Returns">
        <bpmn:flowNodeRef>receive-return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect-return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-replacement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order Placed" />
    <bpmn:task id="record-order" name="System records order details" />
    <bpmn:task id="notify-failure" name="Customer is notified of payment failure" />
    <bpmn:task id="send-confirm" name="System sends shipping confirmation to the customer" />
    <bpmn:task id="update-inventory" name="System updates the inventory levels" />
    <bpmn:task id="follow-up" name="Follow-up email for feedback is sent" />
    <bpmn:task id="send-return-label" name="Sending a return shipping label" />
    <bpmn:endEvent id="end-failure" name="Process ends after payment failure" />
    <bpmn:endEvent id="end-success" name="Process ends successfully" />
    <bpmn:endEvent id="end-returns" name="Returns process completed" />
    <bpmn:exclusiveGateway id="gw-payment" name="Payment successful?" />
    <bpmn:exclusiveGateway id="gw-issue" name="Customer reports any issues upon delivery?" default="f-gw-issue-end-success" />
    <bpmn:parallelGateway id="gw-parallel" name="Packaging and shipping documents in parallel" />
    <bpmn:parallelGateway id="gw-join" name="Ready for dispatch" />
    <bpmn:task id="process-payment" name="Payment processing begins" />
    <bpmn:task id="check-stock" name="Inventory system checks stock availability" />
    <bpmn:exclusiveGateway id="gw-stock" name="Items in stock?" />
    <bpmn:task id="backorder" name="Back-order is initiated and customer informed about delay" />
    <bpmn:task id="wait-backorder" name="Back-order received and items available" />
    <bpmn:task id="pick-items" name="In-stock items are picked from the warehouse" />
    <bpmn:task id="quality-check" name="Quality control checks are performed on the picked items" />
    <bpmn:task id="packaging-task" name="Packaging is done, including gift wrapping if requested" />
    <bpmn:task id="prepare-docs" name="Shipping department prepares shipping documents and labels" />
    <bpmn:exclusiveGateway id="gw-international" name="Order is international?" default="f-gw-international-gw-join" />
    <bpmn:task id="customs-docs" name="Customs documentation is prepared" />
    <bpmn:task id="dispatch" name="Order is dispatched" />
    <bpmn:task id="receive-return" name="Receiving returned items" />
    <bpmn:task id="inspect-return" name="Inspecting returned items" />
    <bpmn:exclusiveGateway id="gw-refund" name="Refund or replacement?" />
    <bpmn:task id="process-refund" name="Processing a refund" />
    <bpmn:task id="process-replacement" name="Processing a replacement" />
    <bpmn:sequenceFlow id="f-start-record-order" sourceRef="start" targetRef="record-order" />
    <bpmn:sequenceFlow id="f-record-order-process-payment" sourceRef="record-order" targetRef="process-payment" />
    <bpmn:sequenceFlow id="f-process-payment-gw-payment" sourceRef="process-payment" targetRef="gw-payment" />
    <bpmn:sequenceFlow id="f-gw-payment-notify-failure" name="no" sourceRef="gw-payment" targetRef="notify-failure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentFailed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-payment-check-stock" name="yes" sourceRef="gw-payment" targetRef="check-stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentSucceeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-notify-failure-end-failure" sourceRef="notify-failure" targetRef="end-failure" />
    <bpmn:sequenceFlow id="f-check-stock-gw-stock" sourceRef="check-stock" targetRef="gw-stock" />
    <bpmn:sequenceFlow id="f-gw-stock-backorder" name="no" sourceRef="gw-stock" targetRef="backorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outOfStock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-stock-pick-items" name="yes" sourceRef="gw-stock" targetRef="pick-items">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">inStock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-backorder-wait-backorder" sourceRef="backorder" targetRef="wait-backorder" />
    <bpmn:sequenceFlow id="f-wait-backorder-pick-items" sourceRef="wait-backorder" targetRef="pick-items" />
    <bpmn:sequenceFlow id="f-pick-items-quality-check" sourceRef="pick-items" targetRef="quality-check" />
    <bpmn:sequenceFlow id="f-quality-check-gw-parallel" sourceRef="quality-check" targetRef="gw-parallel" />
    <bpmn:sequenceFlow id="f-gw-parallel-packaging-task" sourceRef="gw-parallel" targetRef="packaging-task" />
    <bpmn:sequenceFlow id="f-gw-parallel-prepare-docs" sourceRef="gw-parallel" targetRef="prepare-docs" />
    <bpmn:sequenceFlow id="f-packaging-task-gw-join" sourceRef="packaging-task" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-prepare-docs-gw-international" sourceRef="prepare-docs" targetRef="gw-international" />
    <bpmn:sequenceFlow id="f-gw-international-customs-docs" name="yes" sourceRef="gw-international" targetRef="customs-docs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isInternational</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-international-gw-join" name="no" sourceRef="gw-international" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-customs-docs-gw-join" sourceRef="customs-docs" targetRef="gw-join" />
    <bpmn:sequenceFlow id="f-gw-join-dispatch" sourceRef="gw-join" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-send-confirm" sourceRef="dispatch" targetRef="send-confirm" />
    <bpmn:sequenceFlow id="f-send-confirm-update-inventory" sourceRef="send-confirm" targetRef="update-inventory" />
    <bpmn:sequenceFlow id="f-update-inventory-follow-up" sourceRef="update-inventory" targetRef="follow-up" />
    <bpmn:sequenceFlow id="f-follow-up-gw-issue" sourceRef="follow-up" targetRef="gw-issue" />
    <bpmn:sequenceFlow id="f-gw-issue-send-return-label" name="yes" sourceRef="gw-issue" targetRef="send-return-label">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">issueReported</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-issue-end-success" name="no" sourceRef="gw-issue" targetRef="end-success" />
    <bpmn:sequenceFlow id="f-send-return-label-receive-return" sourceRef="send-return-label" targetRef="receive-return" />
    <bpmn:sequenceFlow id="f-receive-return-inspect-return" sourceRef="receive-return" targetRef="inspect-return" />
    <bpmn:sequenceFlow id="f-inspect-return-gw-refund" sourceRef="inspect-return" targetRef="gw-refund" />
    <bpmn:sequenceFlow id="f-gw-refund-process-refund" name="refund" sourceRef="gw-refund" targetRef="process-refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refund</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw-refund-process-replacement" name="replacement" sourceRef="gw-refund" targetRef="process-replacement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">replacement</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-process-refund-end-returns" sourceRef="process-refund" targetRef="end-returns" />
    <bpmn:sequenceFlow id="f-process-replacement-end-returns" sourceRef="process-replacement" targetRef="end-returns" />
  </bpmn:process>
</bpmn:definitions>
