<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="University Enrollment Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University Enrollment Process" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_enroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend_classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_office" name="Admissions Office">
        <bpmn:flowNodeRef>review_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_committee" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate_app</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>process_fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="international_office" name="International Student Office">
        <bpmn:flowNodeRef>visa_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals_committee" name="Appeals Committee">
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="process" name="Process">
        <bpmn:flowNodeRef>missing_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_accept_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="submit_app" name="Submit application online" />
    <bpmn:task id="provide_missing" name="Provide missing documents" />
    <bpmn:task id="confirm_enroll" name="Confirm enrollment" />
    <bpmn:task id="cancel_app" name="Cancel application" />
    <bpmn:task id="orientation" name="Receive orientation materials" />
    <bpmn:task id="obtain_id" name="Obtain student ID card" />
    <bpmn:task id="select_courses" name="Select courses" />
    <bpmn:task id="resolve_conflicts" name="Resolve any schedule conflicts" />
    <bpmn:task id="attend_classes" name="Begin attending classes" />
    <bpmn:task id="add_drop_courses" name="Add or drop courses" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:task id="submit_appeal" name="Submit appeal form" />
    <bpmn:endEvent id="end_process" name="Process completed" />
    <bpmn:task id="review_app" name="Review application and supporting documents" />
    <bpmn:task id="notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="send_accept" name="Send acceptance letter" />
    <bpmn:task id="send_reject" name="Send rejection letter" />
    <bpmn:task id="evaluate_app" name="Evaluate application" />
    <bpmn:task id="process_fees" name="Process application fees or waivers" />
    <bpmn:task id="setup_accounts" name="Set up student accounts" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:task id="visa_process" name="Assist with visa processing" />
    <bpmn:task id="meet_advisor" name="Meet with academic advisor" />
    <bpmn:task id="meet_appeals" name="Meet with appeals committee" />
    <bpmn:task id="await_decision" name="Await decision" />
    <bpmn:exclusiveGateway id="missing_docs" name="Documents missing?" />
    <bpmn:parallelGateway id="parallel_process" name="Parallel processing" />
    <bpmn:parallelGateway id="join_parallel" name="Join parallel" />
    <bpmn:exclusiveGateway id="acceptance" name="Application accepted?" />
    <bpmn:exclusiveGateway id="confirm" name="Student confirms enrollment?" />
    <bpmn:parallelGateway id="post_accept_parallel" name="Post-acceptance activities" />
    <bpmn:parallelGateway id="join_post" name="Join post‑acceptance" />
    <bpmn:exclusiveGateway id="international" name="International student?" />
    <bpmn:exclusiveGateway id="add_drop" name="Add or drop courses?" />
    <bpmn:exclusiveGateway id="grievance" name="Student has grievances?" />
    <bpmn:sequenceFlow id="f-s-submit_app" sourceRef="s" targetRef="submit_app" />
    <bpmn:sequenceFlow id="f-submit_app-review_app" sourceRef="submit_app" targetRef="review_app" />
    <bpmn:sequenceFlow id="f-review_app-missing_docs" sourceRef="review_app" targetRef="missing_docs" />
    <bpmn:sequenceFlow id="f-missing_docs-notify_missing" name="yes" sourceRef="missing_docs" targetRef="notify_missing" />
    <bpmn:sequenceFlow id="f-missing_docs-evaluate_app" name="no" sourceRef="missing_docs" targetRef="evaluate_app" />
    <bpmn:sequenceFlow id="f-notify_missing-provide_missing" sourceRef="notify_missing" targetRef="provide_missing" />
    <bpmn:sequenceFlow id="f-provide_missing-review_app" sourceRef="provide_missing" targetRef="review_app" />
    <bpmn:sequenceFlow id="f-evaluate_app-parallel_process" sourceRef="evaluate_app" targetRef="parallel_process" />
    <bpmn:sequenceFlow id="f-process_fees-parallel_process" sourceRef="process_fees" targetRef="parallel_process" />
    <bpmn:sequenceFlow id="f-parallel_process-join_parallel" sourceRef="parallel_process" targetRef="join_parallel" />
    <bpmn:sequenceFlow id="f-join_parallel-acceptance" sourceRef="join_parallel" targetRef="acceptance" />
    <bpmn:sequenceFlow id="f-acceptance-send_accept" name="yes" sourceRef="acceptance" targetRef="send_accept" />
    <bpmn:sequenceFlow id="f-acceptance-send_reject" name="no" sourceRef="acceptance" targetRef="send_reject" />
    <bpmn:sequenceFlow id="f-send_accept-confirm" sourceRef="send_accept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-send_reject-end_process" sourceRef="send_reject" targetRef="end_process" />
    <bpmn:sequenceFlow id="f-confirm-confirm_enroll" name="yes" sourceRef="confirm" targetRef="confirm_enroll" />
    <bpmn:sequenceFlow id="f-confirm-cancel_app" name="no" sourceRef="confirm" targetRef="cancel_app" />
    <bpmn:sequenceFlow id="f-cancel_app-end_process" sourceRef="cancel_app" targetRef="end_process" />
    <bpmn:sequenceFlow id="f-confirm_enroll-post_accept_parallel" sourceRef="confirm_enroll" targetRef="post_accept_parallel" />
    <bpmn:sequenceFlow id="f-post_accept_parallel-orientation" sourceRef="post_accept_parallel" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-post_accept_parallel-setup_accounts" sourceRef="post_accept_parallel" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f-orientation-join_post" sourceRef="orientation" targetRef="join_post" />
    <bpmn:sequenceFlow id="f-setup_accounts-join_post" sourceRef="setup_accounts" targetRef="join_post" />
    <bpmn:sequenceFlow id="f-join_post-international" sourceRef="join_post" targetRef="international" />
    <bpmn:sequenceFlow id="f-international-visa_process" name="yes" sourceRef="international" targetRef="visa_process" />
    <bpmn:sequenceFlow id="f-international-obtain_id" name="no" sourceRef="international" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-visa_process-obtain_id" sourceRef="visa_process" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-obtain_id-meet_advisor" sourceRef="obtain_id" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f-meet_advisor-select_courses" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f-select_courses-resolve_conflicts" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f-resolve_conflicts-attend_classes" sourceRef="resolve_conflicts" targetRef="attend_classes" />
    <bpmn:sequenceFlow id="f-attend_classes-add_drop" sourceRef="attend_classes" targetRef="add_drop" />
    <bpmn:sequenceFlow id="f-add_drop-add_drop_courses" name="yes" sourceRef="add_drop" targetRef="add_drop_courses" />
    <bpmn:sequenceFlow id="f-add_drop-post_grades" name="no" sourceRef="add_drop" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-add_drop_courses-attend_classes" sourceRef="add_drop_courses" targetRef="attend_classes" />
    <bpmn:sequenceFlow id="f-post_grades-review_grades" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-review_grades-grievance" sourceRef="review_grades" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-submit_appeal" name="yes" sourceRef="grievance" targetRef="submit_appeal" />
    <bpmn:sequenceFlow id="f-grievance-end_process" name="no" sourceRef="grievance" targetRef="end_process" />
    <bpmn:sequenceFlow id="f-submit_appeal-meet_appeals" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f-meet_appeals-await_decision" sourceRef="meet_appeals" targetRef="await_decision" />
    <bpmn:sequenceFlow id="f-await_decision-add_drop" sourceRef="await_decision" targetRef="add_drop" />
  </bpmn:process>
</bpmn:definitions>
