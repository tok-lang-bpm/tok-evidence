<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organisation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:endEvent id="e" />
    <bpmn:task id="login" name="log in to account" />
    <bpmn:parallelGateway id="split_and" />
    <bpmn:task id="select_items" name="select items to purchase" />
    <bpmn:task id="set_payment" name="set payment method" />
    <bpmn:task id="reward" name="choose free reward" />
    <bpmn:exclusiveGateway id="pay_decision" name="pay or installment?" />
    <bpmn:task id="pay" name="pay" />
    <bpmn:task id="installment" name="complete installment agreement" />
    <bpmn:parallelGateway id="join_and" />
    <bpmn:task id="deliver" name="deliver items" />
    <bpmn:exclusiveGateway id="return_decision" name="return items?" />
    <bpmn:task id="return" name="return items for exchange" />
    <bpmn:sequenceFlow id="f-s-login" sourceRef="s" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split_and" sourceRef="login" targetRef="split_and" />
    <bpmn:sequenceFlow id="f-split_and-select_items" sourceRef="split_and" targetRef="select_items" />
    <bpmn:sequenceFlow id="f-split_and-set_payment" sourceRef="split_and" targetRef="set_payment" />
    <bpmn:sequenceFlow id="f-select_items-reward" sourceRef="select_items" targetRef="reward" />
    <bpmn:sequenceFlow id="f-reward-join_and" sourceRef="reward" targetRef="join_and" />
    <bpmn:sequenceFlow id="f-set_payment-pay_decision" sourceRef="set_payment" targetRef="pay_decision" />
    <bpmn:sequenceFlow id="f-pay_decision-pay" sourceRef="pay_decision" targetRef="pay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pay</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pay_decision-installment" sourceRef="pay_decision" targetRef="installment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">installment</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pay-join_and" sourceRef="pay" targetRef="join_and" />
    <bpmn:sequenceFlow id="f-installment-join_and" sourceRef="installment" targetRef="join_and" />
    <bpmn:sequenceFlow id="f-join_and-deliver" sourceRef="join_and" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-return_decision" sourceRef="deliver" targetRef="return_decision" />
    <bpmn:sequenceFlow id="f-return_decision-return" sourceRef="return_decision" targetRef="return">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-return_decision-e" sourceRef="return_decision" targetRef="e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-return-deliver" sourceRef="return" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
