tok 1.0

pool org "Organisation"
  lane user "User"
    start s
    end e
    task login "log in to account"
    and split_and
    task select_items "select items to purchase"
    task set_payment "set payment method"
    task reward "choose free reward"
    xor pay_decision "pay or installment?"
    task pay "pay"
    task installment "complete installment agreement"
    and join_and
    task deliver "deliver items"
    xor return_decision "return items?"
    task return "return items for exchange"
    flow s -> login
    flow login -> split_and
    flow split_and -> select_items
    flow split_and -> set_payment
    flow select_items -> reward
    flow reward -> join_and
    flow set_payment -> pay_decision
    flow pay_decision -> pay when="pay"
    flow pay_decision -> installment when="installment"
    flow pay -> join_and
    flow installment -> join_and
    flow join_and -> deliver
    flow deliver -> return_decision
    flow return_decision -> return when="yes"
    flow return_decision -> e when="no"
    flow return -> deliver
