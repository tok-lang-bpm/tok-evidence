<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Bank" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Clerk">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rcv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pres</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Banking System">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Agency">
        <bpmn:flowNodeRef>lvl1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lvl2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Start" />
    <bpmn:task id="rcv" name="receive credit-scoring request" />
    <bpmn:task id="pres" name="present result to clerk" />
    <bpmn:task id="send" name="send scoring request to agency" />
    <bpmn:task id="disp" name="display delay message to clerk" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:task id="lvl1" name="perform level 1 quick scoring" />
    <bpmn:exclusiveGateway id="gw1" name="Is result immediate?" />
    <bpmn:task id="ret1" name="return immediate result" />
    <bpmn:task id="inf" name="inform delay to banking process" />
    <bpmn:task id="lvl2" name="perform level 2 scoring" />
    <bpmn:task id="ret2" name="return delayed result" />
    <bpmn:sequenceFlow id="f-s1-rcv" sourceRef="s1" targetRef="rcv" />
    <bpmn:sequenceFlow id="f-rcv-send" sourceRef="rcv" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-lvl1" sourceRef="send" targetRef="lvl1" />
    <bpmn:sequenceFlow id="f-lvl1-gw1" sourceRef="lvl1" targetRef="gw1" />
    <bpmn:sequenceFlow id="f-gw1-ret1" sourceRef="gw1" targetRef="ret1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">immediate = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gw1-inf" sourceRef="gw1" targetRef="inf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">immediate = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ret1-pres" sourceRef="ret1" targetRef="pres" />
    <bpmn:sequenceFlow id="f-inf-disp" sourceRef="inf" targetRef="disp" />
    <bpmn:sequenceFlow id="f-disp-lvl2" sourceRef="disp" targetRef="lvl2" />
    <bpmn:sequenceFlow id="f-lvl2-ret2" sourceRef="lvl2" targetRef="ret2" />
    <bpmn:sequenceFlow id="f-ret2-pres" sourceRef="ret2" targetRef="pres" />
    <bpmn:sequenceFlow id="f-pres-e1" sourceRef="pres" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
