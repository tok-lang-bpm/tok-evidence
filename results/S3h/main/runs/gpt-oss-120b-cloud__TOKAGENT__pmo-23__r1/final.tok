tok 1.0

pool bank "Bank"
  lane clerk "Clerk"
    start s1 "Start"
    task rcv "receive credit-scoring request"
    task pres "present result to clerk"
  lane system "Banking System"
    task send "send scoring request to agency"
    task disp "display delay message to clerk"
    end e1 "End"
  lane agency "Agency"
    task lvl1 "perform level 1 quick scoring"
    xor gw1 "Is result immediate?"
    task ret1 "return immediate result"
    task inf "inform delay to banking process"
    task lvl2 "perform level 2 scoring"
    task ret2 "return delayed result"

flow s1 -> rcv
flow rcv -> send
flow send -> lvl1
flow lvl1 -> gw1
flow gw1 -> ret1 when="immediate = true"
flow gw1 -> inf when="immediate = false"
flow ret1 -> pres
flow inf -> disp
flow disp -> lvl2
flow lvl2 -> ret2
flow ret2 -> pres
flow pres -> e1
