<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Job Search Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job Search Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report-applications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate-interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-job-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-year</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view-reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-low-rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue-offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>rate-company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>company-rate-applicant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="report-applications" name="Report job applications" />
    <bpmn:task id="send-offers" name="Send job offers" />
    <bpmn:task id="confirm-rate" name="Confirm receipt and rate application" />
    <bpmn:exclusiveGateway id="gw-interview" name="Interview negotiated?" />
    <bpmn:task id="negotiate-interview" name="Negotiate interview" />
    <bpmn:exclusiveGateway id="gw-job-offer" name="Company offers job?" />
    <bpmn:task id="probation" name="Enter probation phase" />
    <bpmn:parallelGateway id="rating-split" name="Parallel rating" />
    <bpmn:parallelGateway id="rating-join" name="Join rating" />
    <bpmn:task id="wait-year" name="Wait 1 year" />
    <bpmn:task id="view-reviews" name="View company reviews" />
    <bpmn:exclusiveGateway id="gw-permanent" name="Job permanent?" />
    <bpmn:exclusiveGateway id="gw-low-rating" name="Rating &lt; C?" />
    <bpmn:task id="continue-offers" name="Continue receiving job offers" />
    <bpmn:endEvent id="end" />
    <bpmn:task id="rate-company" name="Rate company" />
    <bpmn:task id="company-rate-applicant" name="Company rates applicant" />
    <bpmn:sequenceFlow id="f-start-report-applications" sourceRef="start" targetRef="report-applications" />
    <bpmn:sequenceFlow id="f-report-applications-send-offers" sourceRef="report-applications" targetRef="send-offers" />
    <bpmn:sequenceFlow id="f-send-offers-confirm-rate" sourceRef="send-offers" targetRef="confirm-rate" />
    <bpmn:sequenceFlow id="f-confirm-rate-gw-interview" sourceRef="confirm-rate" targetRef="gw-interview" />
    <bpmn:sequenceFlow id="f-gw-interview-negotiate-interview" name="yes" sourceRef="gw-interview" targetRef="negotiate-interview" />
    <bpmn:sequenceFlow id="f-gw-interview-send-offers" name="no" sourceRef="gw-interview" targetRef="send-offers" />
    <bpmn:sequenceFlow id="f-negotiate-interview-gw-job-offer" sourceRef="negotiate-interview" targetRef="gw-job-offer" />
    <bpmn:sequenceFlow id="f-gw-job-offer-probation" name="yes" sourceRef="gw-job-offer" targetRef="probation" />
    <bpmn:sequenceFlow id="f-gw-job-offer-send-offers" name="no" sourceRef="gw-job-offer" targetRef="send-offers" />
    <bpmn:sequenceFlow id="f-probation-rating-split" sourceRef="probation" targetRef="rating-split" />
    <bpmn:sequenceFlow id="f-rating-split-rate-company" sourceRef="rating-split" targetRef="rate-company" />
    <bpmn:sequenceFlow id="f-rating-split-company-rate-applicant" sourceRef="rating-split" targetRef="company-rate-applicant" />
    <bpmn:sequenceFlow id="f-rate-company-rating-join" sourceRef="rate-company" targetRef="rating-join" />
    <bpmn:sequenceFlow id="f-company-rate-applicant-rating-join" sourceRef="company-rate-applicant" targetRef="rating-join" />
    <bpmn:sequenceFlow id="f-rating-join-wait-year" sourceRef="rating-join" targetRef="wait-year" />
    <bpmn:sequenceFlow id="f-wait-year-view-reviews" sourceRef="wait-year" targetRef="view-reviews" />
    <bpmn:sequenceFlow id="f-view-reviews-gw-permanent" sourceRef="view-reviews" targetRef="gw-permanent" />
    <bpmn:sequenceFlow id="f-gw-permanent-end" name="yes" sourceRef="gw-permanent" targetRef="end" />
    <bpmn:sequenceFlow id="f-gw-permanent-gw-low-rating" name="no" sourceRef="gw-permanent" targetRef="gw-low-rating" />
    <bpmn:sequenceFlow id="f-gw-low-rating-continue-offers" name="yes" sourceRef="gw-low-rating" targetRef="continue-offers" />
    <bpmn:sequenceFlow id="f-gw-low-rating-report-applications" name="no" sourceRef="gw-low-rating" targetRef="report-applications" />
    <bpmn:sequenceFlow id="f-continue-offers-send-offers" sourceRef="continue-offers" targetRef="send-offers" />
  </bpmn:process>
</bpmn:definitions>
