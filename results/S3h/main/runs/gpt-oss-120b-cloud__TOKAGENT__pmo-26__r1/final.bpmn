<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parent-select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ext-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide-extension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend-leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ss" name="Social Security">
        <bpmn:flowNodeRef>notify-ss</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="comp" name="Company">
        <bpmn:flowNodeRef>notify-company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather-info</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="fetch-info" name="Fetch information about potential models (months duration, split between parents)" />
    <bpmn:task id="parent-select" name="Parent selects model" />
    <bpmn:task id="collect-info" name="Collect relevant information" />
    <bpmn:parallelGateway id="split1" name="Notify both" />
    <bpmn:parallelGateway id="join1" name="Notifications done" />
    <bpmn:exclusiveGateway id="ext-gateway" name="Extend leave?" />
    <bpmn:task id="decide-extension" name="Parent decides about extension" />
    <bpmn:task id="extend-leave" name="Extend maternity leave" />
    <bpmn:endEvent id="end" />
    <bpmn:task id="notify-ss" name="Notify Social Security" />
    <bpmn:task id="notify-company" name="Notify Company" />
    <bpmn:task id="gather-info" name="Gather information from companies" />
    <bpmn:sequenceFlow id="f-start-fetch-info" sourceRef="start" targetRef="fetch-info" />
    <bpmn:sequenceFlow id="f-fetch-info-parent-select" sourceRef="fetch-info" targetRef="parent-select" />
    <bpmn:sequenceFlow id="f-parent-select-collect-info" sourceRef="parent-select" targetRef="collect-info" />
    <bpmn:sequenceFlow id="f-collect-info-split1" sourceRef="collect-info" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-notify-ss" name="Notify SS" sourceRef="split1" targetRef="notify-ss" />
    <bpmn:sequenceFlow id="f-split1-notify-company" name="Notify Company" sourceRef="split1" targetRef="notify-company" />
    <bpmn:sequenceFlow id="f-notify-ss-join1" sourceRef="notify-ss" targetRef="join1" />
    <bpmn:sequenceFlow id="f-notify-company-join1" sourceRef="notify-company" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-gather-info" sourceRef="join1" targetRef="gather-info" />
    <bpmn:sequenceFlow id="f-gather-info-decide-extension" sourceRef="gather-info" targetRef="decide-extension" />
    <bpmn:sequenceFlow id="f-decide-extension-ext-gateway" sourceRef="decide-extension" targetRef="ext-gateway" />
    <bpmn:sequenceFlow id="f-ext-gateway-extend-leave" name="yes" sourceRef="ext-gateway" targetRef="extend-leave" />
    <bpmn:sequenceFlow id="f-ext-gateway-end" name="no" sourceRef="ext-gateway" targetRef="end" />
    <bpmn:sequenceFlow id="f-extend-leave-end" sourceRef="extend-leave" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
