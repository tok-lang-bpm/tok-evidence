tok 1.0

pool org "Organization"
  lane parent "Parent"
    start start
    task fetch-info "Fetch information about potential models (months duration, split between parents)"
    task parent-select "Parent selects model"
    task collect-info "Collect relevant information"
    and split1 "Notify both"
    and join1 "Notifications done"
    xor ext-gateway "Extend leave?"
    task decide-extension "Parent decides about extension"
    task extend-leave "Extend maternity leave"
    end end
  lane ss "Social Security"
    task notify-ss "Notify Social Security"
  lane comp "Company"
    task notify-company "Notify Company"
    task gather-info "Gather information from companies"

flow start -> fetch-info
flow fetch-info -> parent-select
flow parent-select -> collect-info
flow collect-info -> split1
flow split1 -> notify-ss "Notify SS"
flow split1 -> notify-company "Notify Company"
flow notify-ss -> join1
flow notify-company -> join1
flow join1 -> gather-info
flow gather-info -> decide-extension
flow decide-extension -> ext-gateway
flow ext-gateway -> extend-leave "yes"
flow ext-gateway -> end "no"
flow extend-leave -> end
