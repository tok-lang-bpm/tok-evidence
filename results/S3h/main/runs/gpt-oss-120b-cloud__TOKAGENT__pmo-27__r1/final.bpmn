<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="selfEmp" name="Self-Employed">
        <bpmn:flowNodeRef>self_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>emp_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_inspector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_insurance_emp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="insurance" name="Accident Insurance Provider" />
      <bpmn:lane id="inspector" name="Labour Inspectorate" />
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>student_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="school" name="School">
        <bpmn:flowNodeRef>school_report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="inform" name="Inform employer of accident" />
    <bpmn:parallelGateway id="split" name="Parallel Split" />
    <bpmn:task id="self_report" name="Self-employed reports accident to insurance" />
    <bpmn:task id="emp_process" name="Employer processes report" />
    <bpmn:exclusiveGateway id="fatal" name="Fatality or serious injury?" />
    <bpmn:task id="report_inspector" name="Report to Labour Inspectorate" />
    <bpmn:task id="report_insurance_emp" name="Report to Accident Insurance Provider" />
    <bpmn:parallelGateway id="join" name="Parallel Join" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="student_report" name="Student reports accident to School Directorate" />
    <bpmn:task id="school_report" name="School reports accident to Accident Insurance Provider" />
    <bpmn:sequenceFlow id="f-start-inform" sourceRef="start" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-split" sourceRef="inform" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-emp_process" name="Employee" sourceRef="split" targetRef="emp_process" />
    <bpmn:sequenceFlow id="f-split-self_report" name="Self-Employed" sourceRef="split" targetRef="self_report" />
    <bpmn:sequenceFlow id="f-split-student_report" name="Student" sourceRef="split" targetRef="student_report" />
    <bpmn:sequenceFlow id="f-emp_process-fatal" sourceRef="emp_process" targetRef="fatal" />
    <bpmn:sequenceFlow id="f-fatal-report_inspector" name="Yes" sourceRef="fatal" targetRef="report_inspector">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fatal=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fatal-report_insurance_emp" name="No" sourceRef="fatal" targetRef="report_insurance_emp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fatal=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-report_inspector-report_insurance_emp" sourceRef="report_inspector" targetRef="report_insurance_emp" />
    <bpmn:sequenceFlow id="f-self_report-join" sourceRef="self_report" targetRef="join" />
    <bpmn:sequenceFlow id="f-student_report-school_report" sourceRef="student_report" targetRef="school_report" />
    <bpmn:sequenceFlow id="f-report_insurance_emp-join" sourceRef="report_insurance_emp" targetRef="join" />
    <bpmn:sequenceFlow id="f-school_report-join" sourceRef="school_report" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-end" sourceRef="join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
