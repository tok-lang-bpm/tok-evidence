tok 1.0

pool org "Organization"
  lane employee "Employee"
    start start "Start"
    task inform "Inform employer of accident"
    and split "Parallel Split"
  lane selfEmp "Self-Employed"
    task self_report "Self-employed reports accident to insurance"
  lane employer "Employer"
    task emp_process "Employer processes report"
    xor fatal "Fatality or serious injury?"
    task report_inspector "Report to Labour Inspectorate"
    task report_insurance_emp "Report to Accident Insurance Provider"
    and join "Parallel Join"
    end end "End"
  lane insurance "Accident Insurance Provider"
  lane inspector "Labour Inspectorate"
  lane student "Student"
    task student_report "Student reports accident to School Directorate"
  lane school "School"
    task school_report "School reports accident to Accident Insurance Provider"

flow start -> inform
flow inform -> split
flow split -> emp_process "Employee"
flow split -> self_report "Self-Employed"
flow split -> student_report "Student"
flow emp_process -> fatal
flow fatal -> report_inspector "Yes" when="fatal=true"
flow fatal -> report_insurance_emp "No" when="fatal=false"
flow report_inspector -> report_insurance_emp
flow self_report -> join
flow student_report -> school_report
flow report_insurance_emp -> join
flow school_report -> join
flow join -> end
