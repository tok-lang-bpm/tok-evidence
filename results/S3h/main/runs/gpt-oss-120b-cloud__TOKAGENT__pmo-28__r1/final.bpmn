<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Internship Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Internship Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="intern" name="Intern">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_topic_and_money</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_experience_and_hobbies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gate_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate_other_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intern_status_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intern_status_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intern_status_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tweet_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tweet_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>company_status_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>company_status_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>company_status_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enter_topic_and_money" name="Enter topic and money" />
    <bpmn:task id="enter_experience_and_hobbies" name="Enter experience and hobbies" />
    <bpmn:task id="receive_offer" name="Receive offer" />
    <bpmn:exclusiveGateway id="gate_decision" name="Accept offer?" />
    <bpmn:task id="accept_offer" name="Accept offer" />
    <bpmn:task id="deny_offer" name="Deny offer" />
    <bpmn:task id="invalidate_other_offers" name="Invalidate other offers" />
    <bpmn:task id="intern_status_1" name="Write intern status update 1" />
    <bpmn:task id="intern_status_2" name="Write intern status update 2" />
    <bpmn:task id="intern_status_3" name="Write intern status update 3" />
    <bpmn:parallelGateway id="tweet_split" name="Tweet split" />
    <bpmn:task id="send_tweet_1" name="Send tweet 1" />
    <bpmn:task id="send_tweet_2" name="Send tweet 2" />
    <bpmn:parallelGateway id="tweet_join" name="Tweet join" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="company_status_1" name="Write company status update 1" />
    <bpmn:task id="company_status_2" name="Write company status update 2" />
    <bpmn:task id="company_status_3" name="Write company status update 3" />
    <bpmn:sequenceFlow id="f-start-enter_topic_and_money" sourceRef="start" targetRef="enter_topic_and_money" />
    <bpmn:sequenceFlow id="f-enter_topic_and_money-enter_experience_and_hobbies" sourceRef="enter_topic_and_money" targetRef="enter_experience_and_hobbies" />
    <bpmn:sequenceFlow id="f-enter_experience_and_hobbies-receive_offer" sourceRef="enter_experience_and_hobbies" targetRef="receive_offer" />
    <bpmn:sequenceFlow id="f-receive_offer-gate_decision" sourceRef="receive_offer" targetRef="gate_decision" />
    <bpmn:sequenceFlow id="f-gate_decision-accept_offer" name="accept" sourceRef="gate_decision" targetRef="accept_offer" />
    <bpmn:sequenceFlow id="f-gate_decision-deny_offer" name="deny" sourceRef="gate_decision" targetRef="deny_offer" />
    <bpmn:sequenceFlow id="f-deny_offer-receive_offer" sourceRef="deny_offer" targetRef="receive_offer" />
    <bpmn:sequenceFlow id="f-accept_offer-invalidate_other_offers" sourceRef="accept_offer" targetRef="invalidate_other_offers" />
    <bpmn:sequenceFlow id="f-invalidate_other_offers-intern_status_1" sourceRef="invalidate_other_offers" targetRef="intern_status_1" />
    <bpmn:sequenceFlow id="f-intern_status_1-intern_status_2" sourceRef="intern_status_1" targetRef="intern_status_2" />
    <bpmn:sequenceFlow id="f-intern_status_2-intern_status_3" sourceRef="intern_status_2" targetRef="intern_status_3" />
    <bpmn:sequenceFlow id="f-intern_status_3-company_status_1" sourceRef="intern_status_3" targetRef="company_status_1" />
    <bpmn:sequenceFlow id="f-company_status_1-company_status_2" sourceRef="company_status_1" targetRef="company_status_2" />
    <bpmn:sequenceFlow id="f-company_status_2-company_status_3" sourceRef="company_status_2" targetRef="company_status_3" />
    <bpmn:sequenceFlow id="f-company_status_3-tweet_split" sourceRef="company_status_3" targetRef="tweet_split" />
    <bpmn:sequenceFlow id="f-tweet_split-send_tweet_1" sourceRef="tweet_split" targetRef="send_tweet_1" />
    <bpmn:sequenceFlow id="f-tweet_split-send_tweet_2" sourceRef="tweet_split" targetRef="send_tweet_2" />
    <bpmn:sequenceFlow id="f-send_tweet_1-tweet_join" sourceRef="send_tweet_1" targetRef="tweet_join" />
    <bpmn:sequenceFlow id="f-send_tweet_2-tweet_join" sourceRef="send_tweet_2" targetRef="tweet_join" />
    <bpmn:sequenceFlow id="f-tweet_join-end" sourceRef="tweet_join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
