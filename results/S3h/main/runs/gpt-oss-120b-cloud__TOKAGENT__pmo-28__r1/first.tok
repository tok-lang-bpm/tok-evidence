tok 1.0 "Internship Process"
    start start "Start"
    end end "End"
    pool org "Internship Process" {
        lane intern "Intern"
            task enter_topic_and_money "Enter topic and money"
            task enter_experience_and_hobbies "Enter experience and hobbies"
            task receive_offer "Receive offer"
            task accept_offer "Accept offer"
            task deny_offer "Deny offer"
            task invalidate_other_offers "Invalidate other offers"
            task intern_status_1 "Write intern status update 1"
            task intern_status_2 "Write intern status update 2"
            task intern_status_3 "Write intern status update 3"
            task send_tweet_1 "Send tweet 1"
            task send_tweet_2 "Send tweet 2"
        lane company "Company"
            task company_status_1 "Write company status update 1"
            task company_status_2 "Write company status update 2"
            task company_status_3 "Write company status update 3"
    }
    xor gate_decision "Accept offer?"
    and tweet_split "Tweet split"
    and tweet_join "Tweet join"
    flow start -> enter_topic_and_money
    flow enter_topic_and_money -> enter_experience_and_hobbies
    flow enter_experience_and_hobbies -> receive_offer
    flow receive_offer -> gate_decision
    flow gate_decision -> accept_offer "accept"
    flow gate_decision -> deny_offer "deny"
    flow deny_offer -> receive_offer
    flow accept_offer -> invalidate_other_offers
    flow invalidate_other_offers -> intern_status_1
    flow intern_status_1 -> intern_status_2
    flow intern_status_2 -> intern_status_3
    flow intern_status_3 -> company_status_1
    flow company_status_1 -> company_status_2
    flow company_status_2 -> company_status_3
    flow company_status_3 -> tweet_split
    flow tweet_split -> send_tweet_1
    flow tweet_split -> send_tweet_2
    flow send_tweet_1 -> tweet_join
    flow send_tweet_2 -> tweet_join
    flow tweet_join -> end