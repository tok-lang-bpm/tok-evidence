<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Work and Live in Austria" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aj1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>crp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representation" name="Representation Office">
        <bpmn:flowNodeRef>ra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xs1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="cr" name="Check requirements for working and living in Austria" />
    <bpmn:parallelGateway id="as1" name="Parallel split" />
    <bpmn:task id="oa" name="Organize accommodation and bank account (negotiation)" />
    <bpmn:task id="pv" name="Prepare visa application documents" />
    <bpmn:parallelGateway id="aj1" name="Parallel join" />
    <bpmn:task id="crp" name="Contact representation in advance" />
    <bpmn:task id="rc" name="Obtain Rot‑Weiss‑Rot Card" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="ra" name="Review visa application" />
    <bpmn:exclusiveGateway id="xs1" name="Visa granted?" />
    <bpmn:task id="iv" name="Issue visa" />
    <bpmn:sequenceFlow id="f-start-cr" sourceRef="start" targetRef="cr" />
    <bpmn:sequenceFlow id="f-cr-as1" sourceRef="cr" targetRef="as1" />
    <bpmn:sequenceFlow id="f-as1-oa" sourceRef="as1" targetRef="oa" />
    <bpmn:sequenceFlow id="f-as1-pv" sourceRef="as1" targetRef="pv" />
    <bpmn:sequenceFlow id="f-oa-aj1" sourceRef="oa" targetRef="aj1" />
    <bpmn:sequenceFlow id="f-pv-aj1" sourceRef="pv" targetRef="aj1" />
    <bpmn:sequenceFlow id="f-aj1-crp" sourceRef="aj1" targetRef="crp" />
    <bpmn:sequenceFlow id="f-crp-ra" sourceRef="crp" targetRef="ra" />
    <bpmn:sequenceFlow id="f-ra-xs1" sourceRef="ra" targetRef="xs1" />
    <bpmn:sequenceFlow id="f-xs1-iv" name="granted" sourceRef="xs1" targetRef="iv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">granted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xs1-end" name="denied" sourceRef="xs1" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">denied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-iv-rc" sourceRef="iv" targetRef="rc" />
    <bpmn:sequenceFlow id="f-rc-end" sourceRef="rc" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
