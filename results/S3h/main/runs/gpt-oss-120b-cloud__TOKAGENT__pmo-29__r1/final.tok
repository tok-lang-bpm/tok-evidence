tok 1.0

pool org "Work and Live in Austria"
  lane applicant "Applicant"
    start start "Start"
    task cr "Check requirements for working and living in Austria"
    and as1 "Parallel split"
    task oa "Organize accommodation and bank account (negotiation)"
    task pv "Prepare visa application documents"
    and aj1 "Parallel join"
    task crp "Contact representation in advance"
    task rc "Obtain Rot‑Weiss‑Rot Card"
    end end "End"
  lane representation "Representation Office"
    task ra "Review visa application"
    xor xs1 "Visa granted?"
    task iv "Issue visa"

flow start -> cr
flow cr -> as1
flow as1 -> oa
flow as1 -> pv
flow oa -> aj1
flow pv -> aj1
flow aj1 -> crp
flow crp -> ra
flow ra -> xs1
flow xs1 -> iv "granted" when="granted"
flow xs1 -> end "denied" when="denied"
flow iv -> rc
flow rc -> end
