<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN Party" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="organizer" name="Organizer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>date_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send_inv" name="send invitations to 10 friends" />
    <bpmn:task id="find_games" name="find out which games friends want to play" />
    <bpmn:parallelGateway id="and_split" name="Parallel split" />
    <bpmn:task id="appoint_date" name="appoint a date for LAN party" />
    <bpmn:exclusiveGateway id="date_check" name="8 or more people free?" default="f-date_check-appoint_date" />
    <bpmn:task id="check_games" name="check if you have all games guests want to play" />
    <bpmn:exclusiveGateway id="games_check" name="All games available?" default="f-games_check-and_join" />
    <bpmn:task id="download_games" name="download missing games" />
    <bpmn:parallelGateway id="and_join" name="Parallel join" />
    <bpmn:task id="find_beer" name="find out how much beer friends will require" />
    <bpmn:exclusiveGateway id="beer_check" name="Enough beer?" default="f-beer_check-enjoy" />
    <bpmn:task id="buy_beer" name="buy missing beer" />
    <bpmn:task id="enjoy" name="enjoy the LAN party" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-send_inv" sourceRef="start" targetRef="send_inv" />
    <bpmn:sequenceFlow id="f-send_inv-find_games" sourceRef="send_inv" targetRef="find_games" />
    <bpmn:sequenceFlow id="f-find_games-and_split" sourceRef="find_games" targetRef="and_split" />
    <bpmn:sequenceFlow id="f-and_split-appoint_date" name="date branch" sourceRef="and_split" targetRef="appoint_date" />
    <bpmn:sequenceFlow id="f-and_split-check_games" name="games branch" sourceRef="and_split" targetRef="check_games" />
    <bpmn:sequenceFlow id="f-appoint_date-date_check" sourceRef="appoint_date" targetRef="date_check" />
    <bpmn:sequenceFlow id="f-date_check-and_join" name="yes" sourceRef="date_check" targetRef="and_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">people &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-date_check-appoint_date" name="no" sourceRef="date_check" targetRef="appoint_date" />
    <bpmn:sequenceFlow id="f-check_games-games_check" sourceRef="check_games" targetRef="games_check" />
    <bpmn:sequenceFlow id="f-games_check-and_join" name="yes" sourceRef="games_check" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-games_check-download_games" name="no" sourceRef="games_check" targetRef="download_games">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">missingGames</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-download_games-and_join" sourceRef="download_games" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-and_join-find_beer" sourceRef="and_join" targetRef="find_beer" />
    <bpmn:sequenceFlow id="f-find_beer-beer_check" sourceRef="find_beer" targetRef="beer_check" />
    <bpmn:sequenceFlow id="f-beer_check-enjoy" name="yes" sourceRef="beer_check" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-beer_check-buy_beer" name="no" sourceRef="beer_check" targetRef="buy_beer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">beerNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-buy_beer-enjoy" sourceRef="buy_beer" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-end" sourceRef="enjoy" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
