tok 1.0 "LAN Party"

pool org "LAN Party"
  lane organizer "Organizer"
    start start "Start"
    task send_inv "send invitations to 10 friends"
    task find_games "find out which games friends want to play"
    and and_split "Parallel split"
    task appoint_date "appoint a date for LAN party"
    xor date_check "8 or more people free?"
    task check_games "check if you have all games guests want to play"
    xor games_check "All games available?"
    task download_games "download missing games"
    and and_join "Parallel join"
    task find_beer "find out how much beer friends will require"
    xor beer_check "Enough beer?"
    task buy_beer "buy missing beer"
    task enjoy "enjoy the LAN party"
    end end "End"
    flow start -> send_inv
    flow send_inv -> find_games
    flow find_games -> and_split
    flow and_split -> appoint_date "date branch"
    flow and_split -> check_games "games branch"
    flow appoint_date -> date_check
    flow date_check -> and_join "yes" when="people >= 8"
    flow date_check -> appoint_date "no" default
    flow check_games -> games_check
    flow games_check -> and_join "yes" default
    flow games_check -> download_games "no" when="missingGames"
    flow download_games -> and_join
    flow and_join -> find_beer
    flow find_beer -> beer_check
    flow beer_check -> enjoy "yes" default
    flow beer_check -> buy_beer "no" when="beerNeeded"
    flow buy_beer -> enjoy
    flow enjoy -> end
