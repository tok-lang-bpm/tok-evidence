<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard Online Character Generator" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_account_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_credit_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>think_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_have_battlenet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_have_subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_payment_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_name_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>check_battlenet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion_message</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:parallelGateway id="gw_split" name="Parallel split" />
    <bpmn:task id="enter_account_info" name="Enter account information and click confirmation link" />
    <bpmn:task id="select_payment" name="Select payment method" />
    <bpmn:task id="enter_credit_card" name="Enter credit card information" />
    <bpmn:task id="enter_bank" name="Enter IBAN and BIC numbers" />
    <bpmn:task id="login_select" name="Log into the game and select realm, race and class" />
    <bpmn:task id="think_names" name="Think of character names" />
    <bpmn:task id="enter_name" name="Enter character name and check availability" />
    <bpmn:exclusiveGateway id="g_have_battlenet" name="Have battle.net account?" default="f-g_have_battlenet-enter_account_info" />
    <bpmn:exclusiveGateway id="g_have_subscription" name="Active WoW subscription?" default="f-g_have_subscription-select_payment" />
    <bpmn:exclusiveGateway id="g_payment_method" name="Payment method?" default="f-g_payment_method-enter_bank" />
    <bpmn:exclusiveGateway id="g_name_available" name="Name available?" default="f-g_name_available-enter_name" />
    <bpmn:parallelGateway id="gw_join" name="Parallel join" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="check_battlenet" name="Check battle.net account" />
    <bpmn:task id="check_subscription" name="Check active WoW subscription" />
    <bpmn:task id="confirm_name" name="Receive confirmation and character selfies" />
    <bpmn:task id="expansion_message" name="Receive expansion release message" />
    <bpmn:sequenceFlow id="f-s-gw_split" sourceRef="s" targetRef="gw_split" />
    <bpmn:sequenceFlow id="f-gw_split-check_battlenet" sourceRef="gw_split" targetRef="check_battlenet" />
    <bpmn:sequenceFlow id="f-check_battlenet-g_have_battlenet" sourceRef="check_battlenet" targetRef="g_have_battlenet" />
    <bpmn:sequenceFlow id="f-g_have_battlenet-check_subscription" name="yes" sourceRef="g_have_battlenet" targetRef="check_subscription">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_have_battlenet-enter_account_info" name="no" sourceRef="g_have_battlenet" targetRef="enter_account_info" />
    <bpmn:sequenceFlow id="f-enter_account_info-check_subscription" sourceRef="enter_account_info" targetRef="check_subscription" />
    <bpmn:sequenceFlow id="f-check_subscription-g_have_subscription" sourceRef="check_subscription" targetRef="g_have_subscription" />
    <bpmn:sequenceFlow id="f-g_have_subscription-login_select" name="yes" sourceRef="g_have_subscription" targetRef="login_select">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_have_subscription-select_payment" name="no" sourceRef="g_have_subscription" targetRef="select_payment" />
    <bpmn:sequenceFlow id="f-select_payment-g_payment_method" sourceRef="select_payment" targetRef="g_payment_method" />
    <bpmn:sequenceFlow id="f-g_payment_method-enter_credit_card" name="credit card" sourceRef="g_payment_method" targetRef="enter_credit_card">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_payment_method-enter_bank" name="bank" sourceRef="g_payment_method" targetRef="enter_bank" />
    <bpmn:sequenceFlow id="f-enter_credit_card-login_select" sourceRef="enter_credit_card" targetRef="login_select" />
    <bpmn:sequenceFlow id="f-enter_bank-login_select" sourceRef="enter_bank" targetRef="login_select" />
    <bpmn:sequenceFlow id="f-gw_split-think_names" sourceRef="gw_split" targetRef="think_names" />
    <bpmn:sequenceFlow id="f-think_names-enter_name" sourceRef="think_names" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-enter_name-g_name_available" sourceRef="enter_name" targetRef="g_name_available" />
    <bpmn:sequenceFlow id="f-g_name_available-confirm_name" name="yes" sourceRef="g_name_available" targetRef="confirm_name">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_name_available-enter_name" name="no" sourceRef="g_name_available" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-confirm_name-expansion_message" sourceRef="confirm_name" targetRef="expansion_message" />
    <bpmn:sequenceFlow id="f-login_select-gw_join" sourceRef="login_select" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f-expansion_message-gw_join" sourceRef="expansion_message" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f-gw_join-e" sourceRef="gw_join" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
