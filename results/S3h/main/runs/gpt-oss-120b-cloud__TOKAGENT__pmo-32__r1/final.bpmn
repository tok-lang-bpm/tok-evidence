<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Farming Bot" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Farming Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Farming Bot" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwToolsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwToolsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bot" name="Bot">
        <bpmn:flowNodeRef>sf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coll10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disasterGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>milestoneGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finishF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bragGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalJoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="f1" name="Find resources to farm" />
    <bpmn:exclusiveGateway id="gwToolsSplit" name="Tools needed?" />
    <bpmn:task id="t1" name="Create required tools" />
    <bpmn:exclusiveGateway id="gwToolsMerge" />
    <bpmn:task id="n" name="Notify player" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="sf" name="Start farming" />
    <bpmn:parallelGateway id="splitParallel" name="Parallel farming activities" />
    <bpmn:task id="coll1" name="Collect resource 1" />
    <bpmn:task id="coll2" name="Collect resource 2" />
    <bpmn:task id="coll3" name="Collect resource 3" />
    <bpmn:task id="coll4" name="Collect resource 4" />
    <bpmn:task id="coll5" name="Collect resource 5" />
    <bpmn:task id="coll6" name="Collect resource 6" />
    <bpmn:task id="coll7" name="Collect resource 7" />
    <bpmn:task id="coll8" name="Collect resource 8" />
    <bpmn:task id="coll9" name="Collect resource 9" />
    <bpmn:task id="coll10" name="Collect resource 10" />
    <bpmn:task id="up" name="Update farming list" />
    <bpmn:parallelGateway id="joinParallel" />
    <bpmn:exclusiveGateway id="disasterGw" name="Disaster occurred?" />
    <bpmn:task id="hd" name="Handle disaster" />
    <bpmn:exclusiveGateway id="milestoneGw" name="Milestone reached?" />
    <bpmn:task id="finishF" name="Finish farming" />
    <bpmn:parallelGateway id="finalSplit" name="Final actions" />
    <bpmn:exclusiveGateway id="bragGw" name="Brag?" default="f-bragGw-sendGw" />
    <bpmn:exclusiveGateway id="sendGw" name="Send materials?" default="f-sendGw-finalJoin" />
    <bpmn:task id="brag" name="Brag to friends" />
    <bpmn:task id="send" name="Send materials to friends" />
    <bpmn:parallelGateway id="finalJoin" />
    <bpmn:sequenceFlow id="f-s-f1" sourceRef="s" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-gwToolsSplit" sourceRef="f1" targetRef="gwToolsSplit" />
    <bpmn:sequenceFlow id="f-gwToolsSplit-t1" name="yes" sourceRef="gwToolsSplit" targetRef="t1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsTools = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gwToolsSplit-sf" name="no" sourceRef="gwToolsSplit" targetRef="sf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsTools = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t1-gwToolsMerge" sourceRef="t1" targetRef="gwToolsMerge" />
    <bpmn:sequenceFlow id="f-gwToolsMerge-sf" sourceRef="gwToolsMerge" targetRef="sf" />
    <bpmn:sequenceFlow id="f-sf-splitParallel" sourceRef="sf" targetRef="splitParallel" />
    <bpmn:sequenceFlow id="f-splitParallel-coll1" sourceRef="splitParallel" targetRef="coll1" />
    <bpmn:sequenceFlow id="f-splitParallel-coll2" sourceRef="splitParallel" targetRef="coll2" />
    <bpmn:sequenceFlow id="f-splitParallel-coll3" sourceRef="splitParallel" targetRef="coll3" />
    <bpmn:sequenceFlow id="f-splitParallel-coll4" sourceRef="splitParallel" targetRef="coll4" />
    <bpmn:sequenceFlow id="f-splitParallel-coll5" sourceRef="splitParallel" targetRef="coll5" />
    <bpmn:sequenceFlow id="f-splitParallel-coll6" sourceRef="splitParallel" targetRef="coll6" />
    <bpmn:sequenceFlow id="f-splitParallel-coll7" sourceRef="splitParallel" targetRef="coll7" />
    <bpmn:sequenceFlow id="f-splitParallel-coll8" sourceRef="splitParallel" targetRef="coll8" />
    <bpmn:sequenceFlow id="f-splitParallel-coll9" sourceRef="splitParallel" targetRef="coll9" />
    <bpmn:sequenceFlow id="f-splitParallel-coll10" sourceRef="splitParallel" targetRef="coll10" />
    <bpmn:sequenceFlow id="f-splitParallel-up" sourceRef="splitParallel" targetRef="up" />
    <bpmn:sequenceFlow id="f-coll1-joinParallel" sourceRef="coll1" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll2-joinParallel" sourceRef="coll2" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll3-joinParallel" sourceRef="coll3" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll4-joinParallel" sourceRef="coll4" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll5-joinParallel" sourceRef="coll5" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll6-joinParallel" sourceRef="coll6" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll7-joinParallel" sourceRef="coll7" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll8-joinParallel" sourceRef="coll8" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll9-joinParallel" sourceRef="coll9" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-coll10-joinParallel" sourceRef="coll10" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-up-joinParallel" sourceRef="up" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-joinParallel-disasterGw" sourceRef="joinParallel" targetRef="disasterGw" />
    <bpmn:sequenceFlow id="f-disasterGw-hd" name="yes" sourceRef="disasterGw" targetRef="hd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">disaster = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-disasterGw-milestoneGw" name="no" sourceRef="disasterGw" targetRef="milestoneGw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">disaster = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-hd-splitParallel" sourceRef="hd" targetRef="splitParallel" />
    <bpmn:sequenceFlow id="f-milestoneGw-n" name="yes" sourceRef="milestoneGw" targetRef="n">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">milestone = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-milestoneGw-finishF" name="no" sourceRef="milestoneGw" targetRef="finishF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">milestone = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-n-joinParallel" sourceRef="n" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-finishF-finalSplit" sourceRef="finishF" targetRef="finalSplit" />
    <bpmn:sequenceFlow id="f-finalSplit-bragGw" sourceRef="finalSplit" targetRef="bragGw" />
    <bpmn:sequenceFlow id="f-bragGw-brag" name="yes" sourceRef="bragGw" targetRef="brag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">brag = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-bragGw-sendGw" sourceRef="bragGw" targetRef="sendGw" />
    <bpmn:sequenceFlow id="f-brag-sendGw" sourceRef="brag" targetRef="sendGw" />
    <bpmn:sequenceFlow id="f-sendGw-send" name="yes" sourceRef="sendGw" targetRef="send">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">send = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sendGw-finalJoin" sourceRef="sendGw" targetRef="finalJoin" />
    <bpmn:sequenceFlow id="f-finalJoin-e" sourceRef="finalJoin" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
