tok 1.0 "Farming Bot"

pool org "Farming Process"
  lane player "Player"
    start s "Start"
    task f1 "Find resources to farm"
    xor gwToolsSplit "Tools needed?"
    task t1 "Create required tools"
    xor gwToolsMerge
    task n "Notify player"
    end e "End"
  lane bot "Bot"
    task sf "Start farming"
    and splitParallel "Parallel farming activities"
    task coll1 "Collect resource 1"
    task coll2 "Collect resource 2"
    task coll3 "Collect resource 3"
    task coll4 "Collect resource 4"
    task coll5 "Collect resource 5"
    task coll6 "Collect resource 6"
    task coll7 "Collect resource 7"
    task coll8 "Collect resource 8"
    task coll9 "Collect resource 9"
    task coll10 "Collect resource 10"
    task up "Update farming list"
    and joinParallel
    xor disasterGw "Disaster occurred?"
    task hd "Handle disaster"
    xor milestoneGw "Milestone reached?"
    task finishF "Finish farming"
    and finalSplit "Final actions"
    xor bragGw "Brag?"
    xor sendGw "Send materials?"
    task brag "Brag to friends"
    task send "Send materials to friends"
    and finalJoin

flow s -> f1
flow f1 -> gwToolsSplit
flow gwToolsSplit -> t1 "yes" when="needsTools = true"
flow gwToolsSplit -> sf "no" when="needsTools = false"
flow t1 -> gwToolsMerge
flow gwToolsMerge -> sf
flow sf -> splitParallel
flow splitParallel -> coll1
flow splitParallel -> coll2
flow splitParallel -> coll3
flow splitParallel -> coll4
flow splitParallel -> coll5
flow splitParallel -> coll6
flow splitParallel -> coll7
flow splitParallel -> coll8
flow splitParallel -> coll9
flow splitParallel -> coll10
flow splitParallel -> up
flow coll1 -> joinParallel
flow coll2 -> joinParallel
flow coll3 -> joinParallel
flow coll4 -> joinParallel
flow coll5 -> joinParallel
flow coll6 -> joinParallel
flow coll7 -> joinParallel
flow coll8 -> joinParallel
flow coll9 -> joinParallel
flow coll10 -> joinParallel
flow up -> joinParallel
flow joinParallel -> disasterGw
flow disasterGw -> hd "yes" when="disaster = true"
flow disasterGw -> milestoneGw "no" when="disaster = false"
flow hd -> splitParallel
flow milestoneGw -> n "yes" when="milestone = true"
flow milestoneGw -> finishF "no" when="milestone = false"
flow n -> joinParallel
flow finishF -> finalSplit
flow finalSplit -> bragGw
flow bragGw -> brag "yes" when="brag = true"
flow bragGw -> sendGw default
flow brag -> sendGw
flow sendGw -> send "yes" when="send = true"
flow sendGw -> finalJoin default
flow finalJoin -> e
