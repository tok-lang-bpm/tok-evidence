<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct-artist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell-changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after-feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has-color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount-enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-shopping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-stl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate-gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create-project</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printer" name="Printer">
        <bpmn:flowNodeRef>turn-printer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print-model</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="instruct-artist" name="Instruct artist to create a project" />
    <bpmn:task id="send-sketches" name="Send sketches to artist" />
    <bpmn:task id="tell-changes" name="Tell artist what to change until satisfied" />
    <bpmn:parallelGateway id="after-feedback" name="After feedback" />
    <bpmn:task id="choose-color" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="has-color" name="Is color at home?" />
    <bpmn:task id="check-amount" name="Check how much color you have left" />
    <bpmn:exclusiveGateway id="amount-enough" name="Is amount &gt;= 100g?" />
    <bpmn:task id="put-shopping" name="Put color on shopping list" />
    <bpmn:task id="order-color" name="Order color" />
    <bpmn:task id="receive-stl" name="Receive STL from artist" />
    <bpmn:task id="generate-gcode" name="Generate gcode file from STL" />
    <bpmn:parallelGateway id="prepare" name="Prepare for printing" />
    <bpmn:endEvent id="e" />
    <bpmn:task id="create-project" name="Artist creates 3D model" />
    <bpmn:task id="turn-printer" name="Turn printer on and heat up bed and extruder" />
    <bpmn:task id="print-model" name="Print the model" />
    <bpmn:sequenceFlow id="f-s-instruct-artist" sourceRef="s" targetRef="instruct-artist" />
    <bpmn:sequenceFlow id="f-instruct-artist-send-sketches" sourceRef="instruct-artist" targetRef="send-sketches" />
    <bpmn:sequenceFlow id="f-send-sketches-tell-changes" sourceRef="send-sketches" targetRef="tell-changes" />
    <bpmn:sequenceFlow id="f-tell-changes-after-feedback" sourceRef="tell-changes" targetRef="after-feedback" />
    <bpmn:sequenceFlow id="f-after-feedback-choose-color" sourceRef="after-feedback" targetRef="choose-color" />
    <bpmn:sequenceFlow id="f-after-feedback-create-project" sourceRef="after-feedback" targetRef="create-project" />
    <bpmn:sequenceFlow id="f-choose-color-has-color" sourceRef="choose-color" targetRef="has-color" />
    <bpmn:sequenceFlow id="f-has-color-check-amount" sourceRef="has-color" targetRef="check-amount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-has-color-order-color" sourceRef="has-color" targetRef="order-color">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-check-amount-amount-enough" sourceRef="check-amount" targetRef="amount-enough" />
    <bpmn:sequenceFlow id="f-amount-enough-put-shopping" sourceRef="amount-enough" targetRef="put-shopping">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-amount-enough-prepare" sourceRef="amount-enough" targetRef="prepare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-put-shopping-order-color" sourceRef="put-shopping" targetRef="order-color" />
    <bpmn:sequenceFlow id="f-order-color-prepare" sourceRef="order-color" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-create-project-receive-stl" sourceRef="create-project" targetRef="receive-stl" />
    <bpmn:sequenceFlow id="f-receive-stl-generate-gcode" sourceRef="receive-stl" targetRef="generate-gcode" />
    <bpmn:sequenceFlow id="f-generate-gcode-prepare" sourceRef="generate-gcode" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-turn-printer" sourceRef="prepare" targetRef="turn-printer" />
    <bpmn:sequenceFlow id="f-prepare-generate-gcode" sourceRef="prepare" targetRef="generate-gcode" />
    <bpmn:sequenceFlow id="f-turn-printer-print-model" sourceRef="turn-printer" targetRef="print-model" />
    <bpmn:sequenceFlow id="f-print-model-e" sourceRef="print-model" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
