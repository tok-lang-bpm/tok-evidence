tok 1.0
pool org "Organization"
  lane customer "Customer"
    start s
    task instruct-artist "Instruct artist to create a project"
    task send-sketches "Send sketches to artist"
    task tell-changes "Tell artist what to change until satisfied"
    and after-feedback "After feedback"
    task choose-color "Choose plastic color"
    xor has-color "Is color at home?"
    task check-amount "Check how much color you have left"
    xor amount-enough "Is amount >= 100g?"
    task put-shopping "Put color on shopping list"
    task order-color "Order color"
    task receive-stl "Receive STL from artist"
    task generate-gcode "Generate gcode file from STL"
    and prepare "Prepare for printing"
    end e
  lane artist "Artist"
    task create-project "Artist creates 3D model"
  lane printer "Printer"
    task turn-printer "Turn printer on and heat up bed and extruder"
    task print-model "Print the model"

flow s -> instruct-artist
flow instruct-artist -> send-sketches
flow send-sketches -> tell-changes
flow tell-changes -> after-feedback
flow after-feedback -> choose-color
flow after-feedback -> create-project
flow choose-color -> has-color
flow has-color -> check-amount when="yes"
flow has-color -> order-color when="no"
flow check-amount -> amount-enough
flow amount-enough -> put-shopping when="no"
flow amount-enough -> prepare when="yes"
flow put-shopping -> order-color
flow order-color -> prepare
flow create-project -> receive-stl
flow receive-stl -> generate-gcode
flow generate-gcode -> prepare
flow prepare -> turn-printer
flow prepare -> generate-gcode
flow turn-printer -> print-model
flow print-model -> e
