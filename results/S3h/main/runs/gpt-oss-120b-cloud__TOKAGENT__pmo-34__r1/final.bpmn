<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="designer" name="Designer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>develop-design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement">
        <bpmn:flowNodeRef>order-sets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder-parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>give-sets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort-parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>parts-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build-sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test-sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="develop-design" name="Develop basic design" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="order-sets" name="Order Lego brick sets" />
    <bpmn:task id="reorder-parts" name="Reorder individual parts" />
    <bpmn:task id="give-sets" name="Give Lego sets to children" />
    <bpmn:task id="sort-parts" name="Sort parts into containers" />
    <bpmn:exclusiveGateway id="parts-check" name="Parts available?" />
    <bpmn:exclusiveGateway id="test-decision" name="Test successful?" />
    <bpmn:task id="build-sub" name="Build subcomponent using sorted parts" />
    <bpmn:task id="test-sub" name="Test subcomponent" />
    <bpmn:task id="assemble" name="Assemble subcomponents" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-develop-design" sourceRef="s" targetRef="develop-design" />
    <bpmn:sequenceFlow id="f-develop-design-order-sets" sourceRef="develop-design" targetRef="order-sets" />
    <bpmn:sequenceFlow id="f-order-sets-give-sets" sourceRef="order-sets" targetRef="give-sets" />
    <bpmn:sequenceFlow id="f-give-sets-sort-parts" sourceRef="give-sets" targetRef="sort-parts" />
    <bpmn:sequenceFlow id="f-sort-parts-parts-check" sourceRef="sort-parts" targetRef="parts-check" />
    <bpmn:sequenceFlow id="f-parts-check-build-sub" sourceRef="parts-check" targetRef="build-sub">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-parts-check-reorder-parts" sourceRef="parts-check" targetRef="reorder-parts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reorder-parts-build-sub" sourceRef="reorder-parts" targetRef="build-sub" />
    <bpmn:sequenceFlow id="f-build-sub-test-sub" sourceRef="build-sub" targetRef="test-sub" />
    <bpmn:sequenceFlow id="f-test-sub-test-decision" sourceRef="test-sub" targetRef="test-decision" />
    <bpmn:sequenceFlow id="f-test-decision-assemble" sourceRef="test-decision" targetRef="assemble">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-test-decision-redesign" sourceRef="test-decision" targetRef="redesign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-redesign-build-sub" sourceRef="redesign" targetRef="build-sub" />
    <bpmn:sequenceFlow id="f-assemble-e" sourceRef="assemble" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
