tok 1.0

pool org "Organization" {
  lane designer "Designer"
  lane procurement "Procurement"
  lane children "Children"
  lane builder "Builder"
}

start s "Start"

task develop-design "Develop basic design" lane=designer

task order-sets "Order Lego brick sets" lane=procurement

task give-sets "Give Lego sets to children" lane=children

task sort-parts "Sort parts into containers" lane=children

xor parts-check "Parts available?"

task reorder-parts "Reorder individual parts" lane=procurement

task build-sub "Build subcomponent using sorted parts" lane=builder

task test-sub "Test subcomponent" lane=builder

xor test-decision "Test successful?"

task redesign "Redesign subcomponent" lane=designer

task assemble "Assemble subcomponents" lane=builder

end e "End"

flow s -> develop-design
flow develop-design -> order-sets
flow order-sets -> give-sets
flow give-sets -> sort-parts
flow sort-parts -> parts-check
flow parts-check -> build-sub when="true"
flow parts-check -> reorder-parts when="false"
flow reorder-parts -> build-sub
flow build-sub -> test-sub
flow test-sub -> test-decision
flow test-decision -> assemble when="true"
flow test-decision -> redesign when="false"
flow redesign -> build-sub
flow assemble -> e