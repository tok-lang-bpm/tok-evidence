<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:process id="process" isExecutable="false">
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:receiveTask id="receive-order" name="Receive order properties" />
    <bpmn:parallelGateway id="g1" name="Order parts parallel" />
    <bpmn:task id="order-guide-bar" name="Order guide bar" />
    <bpmn:task id="order-chain" name="Order chain" />
    <bpmn:task id="order-motor" name="Order motor/electric" />
    <bpmn:parallelGateway id="g2" name="Parts ordered" />
    <bpmn:task id="wait-parts" name="Wait for parts arrival" />
    <bpmn:task id="inspect-parts" name="Inspect parts" />
    <bpmn:task id="assemble-parts" name="Assemble parts" />
    <bpmn:task id="send-updates" name="Send updates to customer" />
    <bpmn:sendTask id="send-first-saw" name="Send first saw to customer" />
    <bpmn:receiveTask id="receive-feedback" name="Receive customer feedback" />
    <bpmn:exclusiveGateway id="decision-like" name="Customer likes first saw?" />
    <bpmn:task id="produce-rest" name="Produce rest of order" />
    <bpmn:endEvent id="end-yes" name="End - Order completed" />
    <bpmn:endEvent id="end-no" name="End - Order cancelled" />
    <bpmn:sequenceFlow id="f-start-receive-order" sourceRef="start" targetRef="receive-order" />
    <bpmn:sequenceFlow id="f-receive-order-g1" sourceRef="receive-order" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-order-guide-bar" name="order guide bar" sourceRef="g1" targetRef="order-guide-bar" />
    <bpmn:sequenceFlow id="f-g1-order-chain" name="order chain" sourceRef="g1" targetRef="order-chain" />
    <bpmn:sequenceFlow id="f-g1-order-motor" name="order motor" sourceRef="g1" targetRef="order-motor" />
    <bpmn:sequenceFlow id="f-order-guide-bar-g2" sourceRef="order-guide-bar" targetRef="g2" />
    <bpmn:sequenceFlow id="f-order-chain-g2" sourceRef="order-chain" targetRef="g2" />
    <bpmn:sequenceFlow id="f-order-motor-g2" sourceRef="order-motor" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-wait-parts" sourceRef="g2" targetRef="wait-parts" />
    <bpmn:sequenceFlow id="f-wait-parts-inspect-parts" sourceRef="wait-parts" targetRef="inspect-parts" />
    <bpmn:sequenceFlow id="f-inspect-parts-assemble-parts" sourceRef="inspect-parts" targetRef="assemble-parts" />
    <bpmn:sequenceFlow id="f-assemble-parts-send-updates" sourceRef="assemble-parts" targetRef="send-updates" />
    <bpmn:sequenceFlow id="f-send-updates-send-first-saw" sourceRef="send-updates" targetRef="send-first-saw" />
    <bpmn:sequenceFlow id="f-send-first-saw-receive-feedback" sourceRef="send-first-saw" targetRef="receive-feedback" />
    <bpmn:sequenceFlow id="f-receive-feedback-decision-like" sourceRef="receive-feedback" targetRef="decision-like" />
    <bpmn:sequenceFlow id="f-decision-like-produce-rest" name="yes" sourceRef="decision-like" targetRef="produce-rest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">like = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-like-end-no" name="no" sourceRef="decision-like" targetRef="end-no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">like = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-produce-rest-end-yes" sourceRef="produce-rest" targetRef="end-yes" />
  </bpmn:process>
</bpmn:definitions>
