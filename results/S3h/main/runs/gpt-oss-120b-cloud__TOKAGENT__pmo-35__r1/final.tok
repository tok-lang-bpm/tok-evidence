tok 1.0

start start "Start"
receive receive-order "Receive order properties"
and g1 "Order parts parallel"
task order-guide-bar "Order guide bar"
task order-chain "Order chain"
task order-motor "Order motor/electric"
and g2 "Parts ordered"
task wait-parts "Wait for parts arrival"
task inspect-parts "Inspect parts"
task assemble-parts "Assemble parts"
task send-updates "Send updates to customer"
send send-first-saw "Send first saw to customer"
receive receive-feedback "Receive customer feedback"
xor decision-like "Customer likes first saw?"
task produce-rest "Produce rest of order"
end end-yes "End - Order completed"
end end-no "End - Order cancelled"

flow start -> receive-order
flow receive-order -> g1
flow g1 -> order-guide-bar "order guide bar"
flow g1 -> order-chain "order chain"
flow g1 -> order-motor "order motor"
flow order-guide-bar -> g2
flow order-chain -> g2
flow order-motor -> g2
flow g2 -> wait-parts
flow wait-parts -> inspect-parts
flow inspect-parts -> assemble-parts
flow assemble-parts -> send-updates
flow send-updates -> send-first-saw
flow send-first-saw -> receive-feedback
flow receive-feedback -> decision-like
flow decision-like -> produce-rest "yes" when="like = true"
flow decision-like -> end-no "no" when="like = false"
flow produce-rest -> end-yes
