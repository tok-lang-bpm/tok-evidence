<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Luxury Airplane Production" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Luxury Airplane Production" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decisionSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideSeats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideWater</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decisionJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manufacturing" name="Manufacturing">
        <bpmn:flowNodeRef>barChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufactureVodka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufactureWhiskey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufactureOther</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>barJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assembleInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliverPlane</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="testing" name="Testing">
        <bpmn:flowNodeRef>testFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createProtocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendProtocol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>customerConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:parallelGateway id="decisionSplit" name="Make decisions" />
    <bpmn:task id="decideBar" name="decide bar type" />
    <bpmn:task id="decideSeats" name="decide number of seats" />
    <bpmn:task id="decideColor" name="decide interior color" />
    <bpmn:task id="decideWater" name="decide amount of water in toilets" />
    <bpmn:parallelGateway id="decisionJoin" name="Decisions done" />
    <bpmn:exclusiveGateway id="barChoice" name="Select bar manufacturer?" default="f-barChoice-manufactureOther" />
    <bpmn:task id="manufactureVodka" name="manufacture vodka bar" />
    <bpmn:task id="manufactureWhiskey" name="manufacture whiskey bar" />
    <bpmn:task id="manufactureOther" name="manufacture other bar" />
    <bpmn:exclusiveGateway id="barJoin" name="Bar manufacturing done" />
    <bpmn:task id="receiveParts" name="receive parts" />
    <bpmn:task id="assembleInterior" name="assemble interior" />
    <bpmn:task id="deliverPlane" name="deliver plane to customer" />
    <bpmn:task id="testFlight" name="perform test flight" />
    <bpmn:task id="createProtocol" name="create test protocol" />
    <bpmn:task id="sendProtocol" name="send test protocol" />
    <bpmn:task id="customerConfirm" name="customer confirm delivery" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-decisionSplit" sourceRef="s" targetRef="decisionSplit" />
    <bpmn:sequenceFlow id="f-decisionSplit-decideBar" sourceRef="decisionSplit" targetRef="decideBar" />
    <bpmn:sequenceFlow id="f-decisionSplit-decideSeats" sourceRef="decisionSplit" targetRef="decideSeats" />
    <bpmn:sequenceFlow id="f-decisionSplit-decideColor" sourceRef="decisionSplit" targetRef="decideColor" />
    <bpmn:sequenceFlow id="f-decisionSplit-decideWater" sourceRef="decisionSplit" targetRef="decideWater" />
    <bpmn:sequenceFlow id="f-decideBar-decisionJoin" sourceRef="decideBar" targetRef="decisionJoin" />
    <bpmn:sequenceFlow id="f-decideSeats-decisionJoin" sourceRef="decideSeats" targetRef="decisionJoin" />
    <bpmn:sequenceFlow id="f-decideColor-decisionJoin" sourceRef="decideColor" targetRef="decisionJoin" />
    <bpmn:sequenceFlow id="f-decideWater-decisionJoin" sourceRef="decideWater" targetRef="decisionJoin" />
    <bpmn:sequenceFlow id="f-decisionJoin-barChoice" sourceRef="decisionJoin" targetRef="barChoice" />
    <bpmn:sequenceFlow id="f-barChoice-manufactureVodka" sourceRef="barChoice" targetRef="manufactureVodka">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bar = "vodka"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-barChoice-manufactureWhiskey" sourceRef="barChoice" targetRef="manufactureWhiskey">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bar = "whiskey"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-barChoice-manufactureOther" sourceRef="barChoice" targetRef="manufactureOther" />
    <bpmn:sequenceFlow id="f-manufactureVodka-barJoin" sourceRef="manufactureVodka" targetRef="barJoin" />
    <bpmn:sequenceFlow id="f-manufactureWhiskey-barJoin" sourceRef="manufactureWhiskey" targetRef="barJoin" />
    <bpmn:sequenceFlow id="f-manufactureOther-barJoin" sourceRef="manufactureOther" targetRef="barJoin" />
    <bpmn:sequenceFlow id="f-barJoin-receiveParts" sourceRef="barJoin" targetRef="receiveParts" />
    <bpmn:sequenceFlow id="f-receiveParts-assembleInterior" sourceRef="receiveParts" targetRef="assembleInterior" />
    <bpmn:sequenceFlow id="f-assembleInterior-testFlight" sourceRef="assembleInterior" targetRef="testFlight" />
    <bpmn:sequenceFlow id="f-testFlight-createProtocol" sourceRef="testFlight" targetRef="createProtocol" />
    <bpmn:sequenceFlow id="f-createProtocol-sendProtocol" sourceRef="createProtocol" targetRef="sendProtocol" />
    <bpmn:sequenceFlow id="f-sendProtocol-deliverPlane" sourceRef="sendProtocol" targetRef="deliverPlane" />
    <bpmn:sequenceFlow id="f-deliverPlane-customerConfirm" sourceRef="deliverPlane" targetRef="customerConfirm" />
    <bpmn:sequenceFlow id="f-customerConfirm-e" sourceRef="customerConfirm" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
