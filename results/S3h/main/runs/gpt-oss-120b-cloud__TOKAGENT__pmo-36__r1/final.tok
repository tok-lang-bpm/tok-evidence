tok 1.0
pool org "Luxury Airplane Production"
  lane sales "Sales"
    start s "Start"
    and decisionSplit "Make decisions"
    task decideBar "decide bar type"
    task decideSeats "decide number of seats"
    task decideColor "decide interior color"
    task decideWater "decide amount of water in toilets"
    and decisionJoin "Decisions done"
  lane manufacturing "Manufacturing"
    xor barChoice "Select bar manufacturer?"
    task manufactureVodka "manufacture vodka bar"
    task manufactureWhiskey "manufacture whiskey bar"
    task manufactureOther "manufacture other bar"
    xor barJoin "Bar manufacturing done"
    task receiveParts "receive parts"
    task assembleInterior "assemble interior"
    task deliverPlane "deliver plane to customer"
  lane testing "Testing"
    task testFlight "perform test flight"
    task createProtocol "create test protocol"
    task sendProtocol "send test protocol"
  lane customer "Customer"
    task customerConfirm "customer confirm delivery"
    end e "End"

flow s -> decisionSplit
flow decisionSplit -> decideBar
flow decisionSplit -> decideSeats
flow decisionSplit -> decideColor
flow decisionSplit -> decideWater
flow decideBar -> decisionJoin
flow decideSeats -> decisionJoin
flow decideColor -> decisionJoin
flow decideWater -> decisionJoin
flow decisionJoin -> barChoice
flow barChoice -> manufactureVodka when="bar = \"vodka\""
flow barChoice -> manufactureWhiskey when="bar = \"whiskey\""
flow barChoice -> manufactureOther default
flow manufactureVodka -> barJoin
flow manufactureWhiskey -> barJoin
flow manufactureOther -> barJoin
flow barJoin -> receiveParts
flow receiveParts -> assembleInterior
flow assembleInterior -> testFlight
flow testFlight -> createProtocol
flow createProtocol -> sendProtocol
flow sendProtocol -> deliverPlane
flow deliverPlane -> customerConfirm
flow customerConfirm -> e
