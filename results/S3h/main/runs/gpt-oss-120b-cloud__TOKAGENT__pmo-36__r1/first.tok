tok 1.0
pool org "Luxury Airplane Production" {
  lane sales "Sales"
  lane manufacturing "Manufacturing"
  lane testing "Testing"
  lane customer "Customer"
}

start s "Start"

and decisionSplit "Make decisions" lane=sales

task decideBar "decide bar type" lane=sales
task decideSeats "decide number of seats" lane=sales
task decideColor "decide interior color" lane=sales
task decideWater "decide amount of water in toilets" lane=sales

and decisionJoin "Decisions done" lane=sales

xor barChoice "Select bar manufacturer" lane=manufacturing

task manufactureVodka "manufacture vodka bar" lane=manufacturing
task manufactureWhiskey "manufacture whiskey bar" lane=manufacturing
task manufactureOther "manufacture other bar" lane=manufacturing

and barJoin "Bar manufacturing done" lane=manufacturing

task receiveParts "receive parts" lane=manufacturing

task assembleInterior "assemble interior" lane=manufacturing

task testFlight "perform test flight" lane=testing

task createProtocol "create test protocol" lane=testing

task sendProtocol "send test protocol" lane=testing

task deliverPlane "deliver plane to customer" lane=manufacturing

task customerConfirm "customer confirm delivery" lane=customer

end e "End"

flow s -> decisionSplit
flow decisionSplit -> decideBar
flow decisionSplit -> decideSeats
flow decisionSplit -> decideColor
flow decisionSplit -> decideWater
flow decideBar -> decisionJoin
flow decideSeats -> decisionJoin
flow decideColor -> decisionJoin
flow decideWater -> decisionJoin
flow decisionJoin -> barChoice
flow barChoice -> manufactureVodka when="bar = 'vodka'"
flow barChoice -> manufactureWhiskey when="bar = 'whiskey'"
flow barChoice -> manufactureOther default
flow manufactureVodka -> barJoin
flow manufactureWhiskey -> barJoin
flow manufactureOther -> barJoin
flow barJoin -> receiveParts
flow receiveParts -> assembleInterior
flow assembleInterior -> testFlight
flow testFlight -> createProtocol
flow createProtocol -> sendProtocol
flow sendProtocol -> deliverPlane
flow deliverPlane -> customerConfirm
flow customerConfirm -> e