<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="House Building" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ref_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_mat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ord_mat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_att</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>arch_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arch_rev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online Stores">
        <bpmn:flowNodeRef>proc_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="c_req" name="Collect requirements" />
    <bpmn:task id="s_req" name="Send requirements to architect" />
    <bpmn:task id="r_draft" name="Receive draft" />
    <bpmn:exclusiveGateway id="draft_gw" name="Is draft satisfactory?" default="f-draft_gw-create_mat" />
    <bpmn:task id="ref_draft" name="Refine draft" />
    <bpmn:task id="s_add" name="Send additional requirements" />
    <bpmn:task id="create_mat" name="Create material list" />
    <bpmn:task id="ord_mat" name="Order materials" />
    <bpmn:parallelGateway id="split_gateway" name="Parallel split" />
    <bpmn:parallelGateway id="join_gateway" name="Parallel join" />
    <bpmn:task id="send_msg" name="Send build messages to friends" />
    <bpmn:task id="send_inv" name="Send invitations for party" />
    <bpmn:task id="create_att" name="Create attendee list" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="arch_send" name="Send draft to you" />
    <bpmn:task id="arch_rev" name="Send revised draft to you" />
    <bpmn:task id="proc_order" name="Process order" />
    <bpmn:task id="build" name="Build house" />
    <bpmn:sequenceFlow id="f-start-c_req" sourceRef="start" targetRef="c_req" />
    <bpmn:sequenceFlow id="f-c_req-s_req" sourceRef="c_req" targetRef="s_req" />
    <bpmn:sequenceFlow id="f-s_req-arch_send" sourceRef="s_req" targetRef="arch_send" />
    <bpmn:sequenceFlow id="f-arch_send-r_draft" name="Draft" sourceRef="arch_send" targetRef="r_draft" />
    <bpmn:sequenceFlow id="f-r_draft-draft_gw" sourceRef="r_draft" targetRef="draft_gw" />
    <bpmn:sequenceFlow id="f-draft_gw-create_mat" sourceRef="draft_gw" targetRef="create_mat" />
    <bpmn:sequenceFlow id="f-draft_gw-ref_draft" name="Refine" sourceRef="draft_gw" targetRef="ref_draft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ref_draft-s_add" sourceRef="ref_draft" targetRef="s_add" />
    <bpmn:sequenceFlow id="f-s_add-arch_rev" sourceRef="s_add" targetRef="arch_rev" />
    <bpmn:sequenceFlow id="f-arch_rev-r_draft" name="Revised draft" sourceRef="arch_rev" targetRef="r_draft" />
    <bpmn:sequenceFlow id="f-create_mat-ord_mat" sourceRef="create_mat" targetRef="ord_mat" />
    <bpmn:sequenceFlow id="f-ord_mat-split_gateway" sourceRef="ord_mat" targetRef="split_gateway" />
    <bpmn:sequenceFlow id="f-split_gateway-proc_order" sourceRef="split_gateway" targetRef="proc_order" />
    <bpmn:sequenceFlow id="f-split_gateway-send_msg" sourceRef="split_gateway" targetRef="send_msg" />
    <bpmn:sequenceFlow id="f-send_msg-build" name="Build request" sourceRef="send_msg" targetRef="build" />
    <bpmn:sequenceFlow id="f-proc_order-join_gateway" sourceRef="proc_order" targetRef="join_gateway" />
    <bpmn:sequenceFlow id="f-build-join_gateway" sourceRef="build" targetRef="join_gateway" />
    <bpmn:sequenceFlow id="f-join_gateway-send_inv" sourceRef="join_gateway" targetRef="send_inv" />
    <bpmn:sequenceFlow id="f-send_inv-create_att" sourceRef="send_inv" targetRef="create_att" />
    <bpmn:sequenceFlow id="f-create_att-end" sourceRef="create_att" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
