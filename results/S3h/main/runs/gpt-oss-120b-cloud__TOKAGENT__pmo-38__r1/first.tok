tok 1.0 "Building a House"
    pool house "House Building" {
        lane you "You"
            start start "Start"
            task c_req "Collect requirements"
            task s_req "Send requirements to architect"
            task r_draft "Receive draft"
            xor draft_gw "Is draft satisfactory?"
            task ref_draft "Refine draft"
            task s_add "Send additional requirements"
            task create_mat "Create material list"
            task ord_mat "Order materials"
            and split_gateway "Parallel split"
            task send_msg "Send build messages to friends"
            task send_inv "Send invitations for party"
            task create_att "Create attendee list"
            end end "End"
        lane architect "Architect"
            task arch_send "Send draft to you"
            task arch_rev "Send revised draft to you"
        lane stores "Online Stores"
            task proc_order "Process order"
        lane friends "Friends"
            task build "Build house"
    }
    flow start -> c_req
    flow c_req -> s_req
    message s_req -> arch_send "Requirements"
    flow arch_send -> r_draft "Draft"
    flow r_draft -> draft_gw
    flow draft_gw -> create_mat default
    flow draft_gw -> ref_draft "Refine" when="false"
    flow ref_draft -> s_add
    message s_add -> arch_rev "Additional requirements"
    flow arch_rev -> r_draft "Revised draft"
    flow create_mat -> ord_mat
    flow ord_mat -> split_gateway
    flow split_gateway -> proc_order
    flow split_gateway -> send_msg
    message send_msg -> build "Build request"
    flow proc_order -> join_gateway
    flow build -> join_gateway
    flow join_gateway -> send_inv
    flow send_inv -> create_att
    flow create_att -> end
