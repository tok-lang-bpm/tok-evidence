<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="DIY Repair Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="DIY Repair Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinObtain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online Tool">
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friend" name="Friend">
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="expert" name="Expert">
        <bpmn:flowNodeRef>sendExpert</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="enter" name="enter model and what is broken" />
    <bpmn:exclusiveGateway id="obtain" name="obtain missing items?" default="f-obtain-purchase" />
    <bpmn:task id="purchase" name="buy missing items" />
    <bpmn:exclusiveGateway id="joinObtain" name="join obtain" />
    <bpmn:exclusiveGateway id="result" name="did it work?" default="f-result-sendExpert" />
    <bpmn:task id="sendReview" name="send review and/or video of fixing it" />
    <bpmn:endEvent id="end" />
    <bpmn:task id="provide" name="provide list of materials, tools, ordering choices" />
    <bpmn:task id="instructions" name="receive instructions how to fix phone" />
    <bpmn:task id="contact" name="contact friend to borrow or buy cheap" />
    <bpmn:task id="sendExpert" name="send phone to expert" />
    <bpmn:sequenceFlow id="f-start-enter" sourceRef="start" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-provide" sourceRef="enter" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-obtain" sourceRef="provide" targetRef="obtain" />
    <bpmn:sequenceFlow id="f-obtain-contact" name="borrow from friend" sourceRef="obtain" targetRef="contact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">friend_available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-obtain-purchase" sourceRef="obtain" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-contact-joinObtain" sourceRef="contact" targetRef="joinObtain" />
    <bpmn:sequenceFlow id="f-purchase-joinObtain" sourceRef="purchase" targetRef="joinObtain" />
    <bpmn:sequenceFlow id="f-joinObtain-instructions" sourceRef="joinObtain" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-instructions-result" sourceRef="instructions" targetRef="result" />
    <bpmn:sequenceFlow id="f-result-sendReview" name="success" sourceRef="result" targetRef="sendReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">success</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-result-sendExpert" sourceRef="result" targetRef="sendExpert" />
    <bpmn:sequenceFlow id="f-sendReview-end" sourceRef="sendReview" targetRef="end" />
    <bpmn:sequenceFlow id="f-sendExpert-end" sourceRef="sendExpert" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
