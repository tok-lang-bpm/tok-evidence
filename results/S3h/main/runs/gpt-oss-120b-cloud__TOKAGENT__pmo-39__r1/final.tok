tok 1.0

pool org "DIY Repair Process"
  lane user "User"
    start start
    task enter "enter model and what is broken"
    xor obtain "obtain missing items?"
    task purchase "buy missing items"
    xor joinObtain "join obtain"
    xor result "did it work?"
    task sendReview "send review and/or video of fixing it"
    end end
  lane tool "Online Tool"
    task provide "provide list of materials, tools, ordering choices"
    task instructions "receive instructions how to fix phone"
  lane friend "Friend"
    task contact "contact friend to borrow or buy cheap"
  lane expert "Expert"
    task sendExpert "send phone to expert"

# flows
flow start -> enter
flow enter -> provide
flow provide -> obtain
flow obtain -> contact "borrow from friend" when="friend_available"
flow obtain -> purchase default
flow contact -> joinObtain
flow purchase -> joinObtain
flow joinObtain -> instructions
flow instructions -> result
flow result -> sendReview "success" when="success"
flow result -> sendExpert default
flow sendReview -> end
flow sendExpert -> end
