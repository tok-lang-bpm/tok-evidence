tok 1.0

pool org "DIY Repair Process" {
  lane user "User"
  lane tool "Online Tool"
  lane friend "Friend"
  lane expert "Expert"
}

start start
end end

# tasks

task enter "enter model and what is broken" lane=user
task provide "provide list of materials, tools, ordering choices" lane=tool
xor obtain "obtain missing items?" lane=user
task contact "contact friend to borrow or buy cheap" lane=friend
task purchase "buy missing items" lane=user
xor joinObtain "join obtain" lane=user
task instructions "receive instructions how to fix phone" lane=tool
xor result "did it work?" lane=user
task sendReview "send review and/or video of fixing it" lane=user
task sendExpert "send phone to expert" lane=expert

# flows
flow start -> enter
flow enter -> provide
flow provide -> obtain
flow obtain -> contact "borrow from friend" when="friend_available"
flow obtain -> purchase default
flow contact -> joinObtain
flow purchase -> joinObtain
flow joinObtain -> instructions
flow instructions -> result
flow result -> sendReview "success" when="success"
flow result -> sendExpert default
flow sendReview -> end
flow sendExpert -> end
