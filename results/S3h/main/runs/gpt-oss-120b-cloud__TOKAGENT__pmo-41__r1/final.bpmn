<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Inspection Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inspection Organization" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer-questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press-buttons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needs-more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer-additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enter-info" name="Enter machine type and serial number" />
    <bpmn:parallelGateway id="split" name="Parallel activities" />
    <bpmn:task id="answer-questions" name="Answer inspection questions" />
    <bpmn:task id="press-buttons" name="Press buttons and collect values" />
    <bpmn:parallelGateway id="join" name="Join parallel activities" />
    <bpmn:exclusiveGateway id="needs-more" name="Additional questions needed?" default="f-needs-more-end" />
    <bpmn:task id="answer-additional" name="Answer additional questions" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-enter-info" sourceRef="start" targetRef="enter-info" />
    <bpmn:sequenceFlow id="f-enter-info-split" sourceRef="enter-info" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-answer-questions" sourceRef="split" targetRef="answer-questions" />
    <bpmn:sequenceFlow id="f-split-press-buttons" sourceRef="split" targetRef="press-buttons" />
    <bpmn:sequenceFlow id="f-answer-questions-join" sourceRef="answer-questions" targetRef="join" />
    <bpmn:sequenceFlow id="f-press-buttons-join" sourceRef="press-buttons" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-needs-more" sourceRef="join" targetRef="needs-more" />
    <bpmn:sequenceFlow id="f-needs-more-answer-additional" sourceRef="needs-more" targetRef="answer-additional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additional = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-needs-more-end" sourceRef="needs-more" targetRef="end" />
    <bpmn:sequenceFlow id="f-answer-additional-end" sourceRef="answer-additional" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
