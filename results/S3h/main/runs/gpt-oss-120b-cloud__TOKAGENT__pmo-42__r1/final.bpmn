<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Fridge Service Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Fridge Service Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Service Center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Service Facility">
        <bpmn:flowNodeRef>make-appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="describe" name="Describe symptoms and send to service center" />
    <bpmn:task id="confirm" name="Confirm fridge is OK" />
    <bpmn:task id="rate" name="Rate service facility" />
    <bpmn:endEvent id="e_success" />
    <bpmn:task id="select" name="Select local service facility" />
    <bpmn:task id="make-appointment" name="Make appointment" />
    <bpmn:task id="arrive" name="Arrive at random time" />
    <bpmn:exclusiveGateway id="repair-decision" name="Repair possible?" />
    <bpmn:task id="repair" name="Repair fridge" />
    <bpmn:task id="leave" name="Leave without repairing" />
    <bpmn:endEvent id="e_failure" />
    <bpmn:sequenceFlow id="f-s-describe" sourceRef="s" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-select" sourceRef="describe" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-make-appointment" sourceRef="select" targetRef="make-appointment" />
    <bpmn:sequenceFlow id="f-make-appointment-arrive" sourceRef="make-appointment" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-repair-decision" sourceRef="arrive" targetRef="repair-decision" />
    <bpmn:sequenceFlow id="f-repair-decision-repair" name="yes" sourceRef="repair-decision" targetRef="repair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-repair-decision-leave" name="no" sourceRef="repair-decision" targetRef="leave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-e_success" sourceRef="rate" targetRef="e_success" />
    <bpmn:sequenceFlow id="f-leave-e_failure" sourceRef="leave" targetRef="e_failure" />
  </bpmn:process>
</bpmn:definitions>
