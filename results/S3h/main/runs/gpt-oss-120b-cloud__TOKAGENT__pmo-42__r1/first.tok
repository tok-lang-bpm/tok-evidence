tok 1.0
pool org "Fridge Service Process" {
 lane cust "Customer" {
  start s
  task describe "Describe symptoms and send to service center"
  task confirm "Confirm fridge is OK"
  task rate "Rate service facility"
  end e_success
 }
 lane center "Service Center" {
  task select "Select local service facility"
 }
 lane facility "Service Facility" {
  task make-appointment "Make appointment"
  task arrive "Arrive at random time"
  xor repair-decision "Repair possible?"
  task repair "Repair fridge"
  task leave "Leave without repairing"
  end e_failure
 }
}
flow s -> describe
flow describe -> select
flow select -> make-appointment
flow make-appointment -> arrive
flow arrive -> repair-decision
flow repair-decision -> repair "yes" when="true"
flow repair-decision -> leave "no" when="false"
flow repair -> confirm
flow confirm -> rate
flow rate -> e_success
flow leave -> e_failure