<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Robotic Burger Seller" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Robotic Burger Seller" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give-updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>menu-decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="receive-order" name="Robot receives an order" />
    <bpmn:parallelGateway id="menu-split" name="Parallel: drink and side" />
    <bpmn:task id="prepare-drink" name="Robot prepares the drink" />
    <bpmn:task id="ask-side" name="Robot asks if you want fries or wedges" />
    <bpmn:exclusiveGateway id="side-decision" name="Fries or wedges?" />
    <bpmn:task id="prepare-fries" name="Robot prepares fries" />
    <bpmn:task id="prepare-wedges" name="Robot prepares wedges" />
    <bpmn:parallelGateway id="menu-join" name="Join drink and side" />
    <bpmn:parallelGateway id="burger-split" name="Prepare burger and give updates" />
    <bpmn:task id="prepare-burger" name="Robot prepares the burger" />
    <bpmn:task id="give-updates" name="Robot gives enthusiastic status updates" />
    <bpmn:parallelGateway id="burger-join" name="Join burger and updates" />
    <bpmn:task id="deliver" name="Order delivered via conveyor belt" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:exclusiveGateway id="menu-decision" name="Menu or just burger?" default="f-menu-decision-menu-join" />
    <bpmn:sequenceFlow id="f-start-receive-order" sourceRef="start" targetRef="receive-order" />
    <bpmn:sequenceFlow id="f-receive-order-menu-decision" sourceRef="receive-order" targetRef="menu-decision" />
    <bpmn:sequenceFlow id="f-menu-decision-menu-split" sourceRef="menu-decision" targetRef="menu-split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">menu</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-menu-decision-menu-join" sourceRef="menu-decision" targetRef="menu-join" />
    <bpmn:sequenceFlow id="f-menu-split-prepare-drink" sourceRef="menu-split" targetRef="prepare-drink" />
    <bpmn:sequenceFlow id="f-menu-split-ask-side" sourceRef="menu-split" targetRef="ask-side" />
    <bpmn:sequenceFlow id="f-ask-side-side-decision" sourceRef="ask-side" targetRef="side-decision" />
    <bpmn:sequenceFlow id="f-side-decision-prepare-fries" sourceRef="side-decision" targetRef="prepare-fries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fries</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-side-decision-prepare-wedges" sourceRef="side-decision" targetRef="prepare-wedges">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wedges</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-prepare-drink-menu-join" sourceRef="prepare-drink" targetRef="menu-join" />
    <bpmn:sequenceFlow id="f-prepare-fries-menu-join" sourceRef="prepare-fries" targetRef="menu-join" />
    <bpmn:sequenceFlow id="f-prepare-wedges-menu-join" sourceRef="prepare-wedges" targetRef="menu-join" />
    <bpmn:sequenceFlow id="f-menu-join-burger-split" sourceRef="menu-join" targetRef="burger-split" />
    <bpmn:sequenceFlow id="f-burger-split-prepare-burger" sourceRef="burger-split" targetRef="prepare-burger" />
    <bpmn:sequenceFlow id="f-burger-split-give-updates" sourceRef="burger-split" targetRef="give-updates" />
    <bpmn:sequenceFlow id="f-prepare-burger-burger-join" sourceRef="prepare-burger" targetRef="burger-join" />
    <bpmn:sequenceFlow id="f-give-updates-burger-join" sourceRef="give-updates" targetRef="burger-join" />
    <bpmn:sequenceFlow id="f-burger-join-deliver" sourceRef="burger-join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-end" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
