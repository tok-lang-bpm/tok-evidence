tok 1.0

pool org "Robotic Burger Seller"
  lane robot "Robot"
    start start "Start"
    task receive-order "Robot receives an order"
    and menu-split "Parallel: drink and side"
    task prepare-drink "Robot prepares the drink"
    task ask-side "Robot asks if you want fries or wedges"
    xor side-decision "Fries or wedges?"
    task prepare-fries "Robot prepares fries"
    task prepare-wedges "Robot prepares wedges"
    and menu-join "Join drink and side"
    and burger-split "Prepare burger and give updates"
    task prepare-burger "Robot prepares the burger"
    task give-updates "Robot gives enthusiastic status updates"
    and burger-join "Join burger and updates"
    task deliver "Order delivered via conveyor belt"
    end end "End"
  lane customer "Customer"
    xor menu-decision "Menu or just burger?"

  # Flows
  flow start -> receive-order
  flow receive-order -> menu-decision
  flow menu-decision -> menu-split when="menu"
  flow menu-decision -> menu-join default
  flow menu-split -> prepare-drink
  flow menu-split -> ask-side
  flow ask-side -> side-decision
  flow side-decision -> prepare-fries when="fries"
  flow side-decision -> prepare-wedges when="wedges"
  flow prepare-drink -> menu-join
  flow prepare-fries -> menu-join
  flow prepare-wedges -> menu-join
  flow menu-join -> burger-split
  flow burger-split -> prepare-burger
  flow burger-split -> give-updates
  flow prepare-burger -> burger-join
  flow give-updates -> burger-join
  flow burger-join -> deliver
  flow deliver -> end
