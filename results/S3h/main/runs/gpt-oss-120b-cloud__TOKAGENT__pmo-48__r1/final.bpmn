<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Vienna Night Run" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="runner" name="Runner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-start-block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-5km</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure-time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goal-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train-and-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get-start-number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go-from-home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave-from-work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travel-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-night-run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-final-time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="App" />
      <bpmn:lane id="gadget" name="Fitness Gadget" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="select-start-block" name="Select a starting block" />
    <bpmn:task id="run-5km" name="Run for 5km" />
    <bpmn:task id="measure-time" name="Measure the time" />
    <bpmn:exclusiveGateway id="goal-check" name="Is time &lt; 25 minutes?" />
    <bpmn:task id="train-and-check" name="Train and check until goal achieved" />
    <bpmn:task id="get-start-number" name="Get your starting number" />
    <bpmn:exclusiveGateway id="work-decision" name="More than one hour left between start time and end of workday?" default="f-work-decision-leave-from-work" />
    <bpmn:task id="go-from-home" name="Go there from home" />
    <bpmn:task id="leave-from-work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="travel-join" name="Travel merge" />
    <bpmn:parallelGateway id="run-split" name="Start run activities" />
    <bpmn:task id="run-night-run" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink during the run" />
    <bpmn:parallelGateway id="run-join" name="End run activities" />
    <bpmn:task id="receive-final-time" name="Receive your final running time" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-select-start-block" sourceRef="start" targetRef="select-start-block" />
    <bpmn:sequenceFlow id="f-select-start-block-run-5km" sourceRef="select-start-block" targetRef="run-5km" />
    <bpmn:sequenceFlow id="f-run-5km-measure-time" sourceRef="run-5km" targetRef="measure-time" />
    <bpmn:sequenceFlow id="f-measure-time-goal-check" sourceRef="measure-time" targetRef="goal-check" />
    <bpmn:sequenceFlow id="f-goal-check-get-start-number" name="yes" sourceRef="goal-check" targetRef="get-start-number">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &lt; PT25M</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-goal-check-train-and-check" name="no" sourceRef="goal-check" targetRef="train-and-check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &gt;= PT25M</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-train-and-check-run-5km" name="repeat" sourceRef="train-and-check" targetRef="run-5km" />
    <bpmn:sequenceFlow id="f-get-start-number-work-decision" sourceRef="get-start-number" targetRef="work-decision" />
    <bpmn:sequenceFlow id="f-work-decision-go-from-home" name="yes" sourceRef="work-decision" targetRef="go-from-home">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">remainingTime &gt; PT1H</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-work-decision-leave-from-work" name="no" sourceRef="work-decision" targetRef="leave-from-work" />
    <bpmn:sequenceFlow id="f-go-from-home-travel-join" sourceRef="go-from-home" targetRef="travel-join" />
    <bpmn:sequenceFlow id="f-leave-from-work-travel-join" sourceRef="leave-from-work" targetRef="travel-join" />
    <bpmn:sequenceFlow id="f-travel-join-run-split" sourceRef="travel-join" targetRef="run-split" />
    <bpmn:sequenceFlow id="f-run-split-run-night-run" sourceRef="run-split" targetRef="run-night-run" />
    <bpmn:sequenceFlow id="f-run-split-drink" sourceRef="run-split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-run-night-run-run-join" sourceRef="run-night-run" targetRef="run-join" />
    <bpmn:sequenceFlow id="f-drink-run-join" sourceRef="drink" targetRef="run-join" />
    <bpmn:sequenceFlow id="f-run-join-receive-final-time" sourceRef="run-join" targetRef="receive-final-time" />
    <bpmn:sequenceFlow id="f-receive-final-time-end" sourceRef="receive-final-time" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
