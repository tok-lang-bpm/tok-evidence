tok 1.0
pool org "Vienna Night Run" {
  lane runner "Runner"
  lane app "App"
  lane gadget "Fitness Gadget"
}
start
task select-start-block "Select a starting block"
task run-5km "Run for 5km"
task measure-time "Measure the time"
xor goal-check "Is time < 25 minutes?"
task train-and-check "Train and check until goal achieved"
task get-start-number "Get your starting number"
xor work-decision "More than one hour left between start time and end of workday?"
task go-from-home "Go there from home"
task leave-from-work "Leave directly from work"
and run-phase "Start run activities"
task run-night-run "Run at the Night Run"
task drink "Drink during the run"
and run-join "End run activities"
task receive-final-time "Receive your final running time"
end

flow start -> select-start-block
flow select-start-block -> run-5km
flow run-5km -> measure-time
flow measure-time -> goal-check
flow goal-check -> get-start-number "yes" when="time < PT25M"
flow goal-check -> train-and-check "no" when="time >= PT25M"
flow train-and-check -> run-5km "repeat"
flow get-start-number -> work-decision
flow work-decision -> go-from-home "yes" when="remainingTime > PT1H"
flow work-decision -> leave-from-work "no" default
flow go-from-home -> run-phase
flow leave-from-work -> run-phase
flow run-phase -> run-night-run
flow run-phase -> drink
flow run-night-run -> run-join
flow drink -> run-join
flow run-join -> receive-final-time
flow receive-final-time -> end