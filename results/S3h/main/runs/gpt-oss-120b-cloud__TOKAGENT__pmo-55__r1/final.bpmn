<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Hospital" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Hospital" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prep_impl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_wash_hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_config_ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_put_gel_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cover_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_put_sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_position_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_position_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>id_anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>id_doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>id_compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drop_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_install_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_long</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_widen_pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_advance_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_verify_flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="patient" name="Patient">
        <bpmn:flowNodeRef>t_anaesthesia_puncture</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:parallelGateway id="and1" />
    <bpmn:task id="t_prep_impl" name="implements are prepared" />
    <bpmn:task id="t_wash_hands" name="hands are washed" />
    <bpmn:task id="t_sterile_clothes" name="doctor gets in sterile clothes" />
    <bpmn:parallelGateway id="and2" />
    <bpmn:task id="t_clean" name="doctor cleans the puncture area" />
    <bpmn:task id="t_drape" name="doctor drapes the puncture zone" />
    <bpmn:task id="t_config_ultrasound" name="doctor configures the ultrasound" />
    <bpmn:task id="t_put_gel_probe" name="doctor puts gel in the probe" />
    <bpmn:task id="t_cover_probe" name="doctor covers the probe" />
    <bpmn:task id="t_put_sterile_gel" name="doctor puts the sterile gel" />
    <bpmn:parallelGateway id="and3" />
    <bpmn:task id="t_position_probe" name="doctor positions the probe" />
    <bpmn:task id="t_position_patient" name="doctor positions the patient" />
    <bpmn:parallelGateway id="and4" />
    <bpmn:exclusiveGateway id="xor1" />
    <bpmn:exclusiveGateway id="xor2" />
    <bpmn:task id="id_anatomic" name="identifies vein using an anatomic identification" />
    <bpmn:task id="id_doppler" name="identifies vein using a doppler identification" />
    <bpmn:task id="id_compression" name="identifies vein using a compression identification" />
    <bpmn:task id="t_check_blood" name="blood return is checked" />
    <bpmn:exclusiveGateway id="xor3" default="f-xor3-t_drop_probe" />
    <bpmn:task id="t_drop_probe" name="probe is dropped" />
    <bpmn:task id="t_remove_syringe" name="syringe is removed" />
    <bpmn:task id="t_install_guidewire" name="guidewire is installed" />
    <bpmn:task id="t_remove_trocar" name="trocar is removed" />
    <bpmn:exclusiveGateway id="xor5" />
    <bpmn:exclusiveGateway id="xor6" />
    <bpmn:task id="wire_long" name="wire is checked using a check of the wire in the long axis" />
    <bpmn:task id="wire_short" name="wire is checked using a check of the wire in the short axis" />
    <bpmn:exclusiveGateway id="xor7" default="f-xor7-t_widen_pathway" />
    <bpmn:task id="t_check_wire_position" name="doctor checks if the wire is in good position" />
    <bpmn:task id="t_widen_pathway" name="pathway is widen" />
    <bpmn:task id="t_advance_catheter" name="catheter is advanced" />
    <bpmn:task id="t_remove_guidewire" name="guidewire is removed" />
    <bpmn:task id="t_verify_flow" name="doctor verifies the flow and the reflow" />
    <bpmn:task id="t_check_catheter" name="catheter position is checked" />
    <bpmn:endEvent id="e" />
    <bpmn:task id="t_anaesthesia_puncture" name="patient is anesthetized and punctured" />
    <bpmn:sequenceFlow id="f-s-and1" sourceRef="s" targetRef="and1" />
    <bpmn:sequenceFlow id="f-and1-t_prep_impl" sourceRef="and1" targetRef="t_prep_impl" />
    <bpmn:sequenceFlow id="f-and1-t_wash_hands" sourceRef="and1" targetRef="t_wash_hands" />
    <bpmn:sequenceFlow id="f-and1-t_sterile_clothes" sourceRef="and1" targetRef="t_sterile_clothes" />
    <bpmn:sequenceFlow id="f-t_prep_impl-and2" sourceRef="t_prep_impl" targetRef="and2" />
    <bpmn:sequenceFlow id="f-t_wash_hands-and2" sourceRef="t_wash_hands" targetRef="and2" />
    <bpmn:sequenceFlow id="f-t_sterile_clothes-and2" sourceRef="t_sterile_clothes" targetRef="and2" />
    <bpmn:sequenceFlow id="f-and2-t_clean" sourceRef="and2" targetRef="t_clean" />
    <bpmn:sequenceFlow id="f-t_clean-t_drape" sourceRef="t_clean" targetRef="t_drape" />
    <bpmn:sequenceFlow id="f-t_drape-t_config_ultrasound" sourceRef="t_drape" targetRef="t_config_ultrasound" />
    <bpmn:sequenceFlow id="f-t_config_ultrasound-t_put_gel_probe" sourceRef="t_config_ultrasound" targetRef="t_put_gel_probe" />
    <bpmn:sequenceFlow id="f-t_put_gel_probe-t_cover_probe" sourceRef="t_put_gel_probe" targetRef="t_cover_probe" />
    <bpmn:sequenceFlow id="f-t_cover_probe-t_put_sterile_gel" sourceRef="t_cover_probe" targetRef="t_put_sterile_gel" />
    <bpmn:sequenceFlow id="f-t_put_sterile_gel-and3" sourceRef="t_put_sterile_gel" targetRef="and3" />
    <bpmn:sequenceFlow id="f-and3-t_position_probe" sourceRef="and3" targetRef="t_position_probe" />
    <bpmn:sequenceFlow id="f-and3-t_position_patient" sourceRef="and3" targetRef="t_position_patient" />
    <bpmn:sequenceFlow id="f-t_position_probe-and4" sourceRef="t_position_probe" targetRef="and4" />
    <bpmn:sequenceFlow id="f-t_position_patient-and4" sourceRef="t_position_patient" targetRef="and4" />
    <bpmn:sequenceFlow id="f-and4-xor1" sourceRef="and4" targetRef="xor1" />
    <bpmn:sequenceFlow id="f-xor1-id_anatomic" name="anatomic" sourceRef="xor1" targetRef="id_anatomic">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">anatomic</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xor1-id_doppler" name="doppler" sourceRef="xor1" targetRef="id_doppler">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">doppler</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xor1-id_compression" name="compression" sourceRef="xor1" targetRef="id_compression">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compression</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-id_anatomic-xor2" sourceRef="id_anatomic" targetRef="xor2" />
    <bpmn:sequenceFlow id="f-id_doppler-xor2" sourceRef="id_doppler" targetRef="xor2" />
    <bpmn:sequenceFlow id="f-id_compression-xor2" sourceRef="id_compression" targetRef="xor2" />
    <bpmn:sequenceFlow id="f-xor2-t_anaesthesia_puncture" sourceRef="xor2" targetRef="t_anaesthesia_puncture" />
    <bpmn:sequenceFlow id="f-t_anaesthesia_puncture-t_check_blood" sourceRef="t_anaesthesia_puncture" targetRef="t_check_blood" />
    <bpmn:sequenceFlow id="f-t_check_blood-xor3" sourceRef="t_check_blood" targetRef="xor3" />
    <bpmn:sequenceFlow id="f-xor3-t_anaesthesia_puncture" name="not correct" sourceRef="xor3" targetRef="t_anaesthesia_puncture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not_correct</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xor3-t_drop_probe" name="correct" sourceRef="xor3" targetRef="t_drop_probe" />
    <bpmn:sequenceFlow id="f-t_drop_probe-t_remove_syringe" sourceRef="t_drop_probe" targetRef="t_remove_syringe" />
    <bpmn:sequenceFlow id="f-t_remove_syringe-t_install_guidewire" sourceRef="t_remove_syringe" targetRef="t_install_guidewire" />
    <bpmn:sequenceFlow id="f-t_install_guidewire-t_remove_trocar" sourceRef="t_install_guidewire" targetRef="t_remove_trocar" />
    <bpmn:sequenceFlow id="f-t_remove_trocar-xor5" sourceRef="t_remove_trocar" targetRef="xor5" />
    <bpmn:sequenceFlow id="f-xor5-wire_long" name="long axis" sourceRef="xor5" targetRef="wire_long">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">long_axis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xor5-wire_short" name="short axis" sourceRef="xor5" targetRef="wire_short">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">short_axis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wire_long-xor6" sourceRef="wire_long" targetRef="xor6" />
    <bpmn:sequenceFlow id="f-wire_short-xor6" sourceRef="wire_short" targetRef="xor6" />
    <bpmn:sequenceFlow id="f-xor6-t_check_wire_position" sourceRef="xor6" targetRef="t_check_wire_position" />
    <bpmn:sequenceFlow id="f-t_check_wire_position-xor7" sourceRef="t_check_wire_position" targetRef="xor7" />
    <bpmn:sequenceFlow id="f-xor7-t_anaesthesia_puncture" name="not good" sourceRef="xor7" targetRef="t_anaesthesia_puncture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not_good</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xor7-t_widen_pathway" name="good" sourceRef="xor7" targetRef="t_widen_pathway" />
    <bpmn:sequenceFlow id="f-t_widen_pathway-t_advance_catheter" sourceRef="t_widen_pathway" targetRef="t_advance_catheter" />
    <bpmn:sequenceFlow id="f-t_advance_catheter-t_remove_guidewire" sourceRef="t_advance_catheter" targetRef="t_remove_guidewire" />
    <bpmn:sequenceFlow id="f-t_remove_guidewire-t_verify_flow" sourceRef="t_remove_guidewire" targetRef="t_verify_flow" />
    <bpmn:sequenceFlow id="f-t_verify_flow-t_check_catheter" sourceRef="t_verify_flow" targetRef="t_check_catheter" />
    <bpmn:sequenceFlow id="f-t_check_catheter-e" sourceRef="t_check_catheter" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
