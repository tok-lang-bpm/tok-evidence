tok 1.0

pool org "Hospital"
  lane doctor "Doctor"
    start s
    and and1
    task t_prep_impl "implements are prepared"
    task t_wash_hands "hands are washed"
    task t_sterile_clothes "doctor gets in sterile clothes"
    and and2
    task t_clean "doctor cleans the puncture area"
    task t_drape "doctor drapes the puncture zone"
    task t_config_ultrasound "doctor configures the ultrasound"
    task t_put_gel_probe "doctor puts gel in the probe"
    task t_cover_probe "doctor covers the probe"
    task t_put_sterile_gel "doctor puts the sterile gel"
    and and3
    task t_position_probe "doctor positions the probe"
    task t_position_patient "doctor positions the patient"
    and and4
    xor xor1
    xor xor2
    task id_anatomic "identifies vein using an anatomic identification"
    task id_doppler "identifies vein using a doppler identification"
    task id_compression "identifies vein using a compression identification"
    task t_check_blood "blood return is checked"
    xor xor3
    task t_drop_probe "probe is dropped"
    task t_remove_syringe "syringe is removed"
    task t_install_guidewire "guidewire is installed"
    task t_remove_trocar "trocar is removed"
    xor xor5
    xor xor6
    task wire_long "wire is checked using a check of the wire in the long axis"
    task wire_short "wire is checked using a check of the wire in the short axis"
    xor xor7
    task t_check_wire_position "doctor checks if the wire is in good position"
    task t_widen_pathway "pathway is widen"
    task t_advance_catheter "catheter is advanced"
    task t_remove_guidewire "guidewire is removed"
    task t_verify_flow "doctor verifies the flow and the reflow"
    task t_check_catheter "catheter position is checked"
    end e
  lane patient "Patient"
    task t_anaesthesia_puncture "patient is anesthetized and punctured"

flow s -> and1
flow and1 -> t_prep_impl
flow and1 -> t_wash_hands
flow and1 -> t_sterile_clothes
flow t_prep_impl -> and2
flow t_wash_hands -> and2
flow t_sterile_clothes -> and2
flow and2 -> t_clean
flow t_clean -> t_drape
flow t_drape -> t_config_ultrasound
flow t_config_ultrasound -> t_put_gel_probe
flow t_put_gel_probe -> t_cover_probe
flow t_cover_probe -> t_put_sterile_gel
flow t_put_sterile_gel -> and3
flow and3 -> t_position_probe
flow and3 -> t_position_patient
flow t_position_probe -> and4
flow t_position_patient -> and4
flow and4 -> xor1
flow xor1 -> id_anatomic "anatomic" when="anatomic"
flow xor1 -> id_doppler "doppler" when="doppler"
flow xor1 -> id_compression "compression" when="compression"
flow id_anatomic -> xor2
flow id_doppler -> xor2
flow id_compression -> xor2
flow xor2 -> t_anaesthesia_puncture
flow t_anaesthesia_puncture -> t_check_blood
flow t_check_blood -> xor3
flow xor3 -> t_anaesthesia_puncture "not correct" when="not_correct"
flow xor3 -> t_drop_probe "correct" default
flow t_drop_probe -> t_remove_syringe
flow t_remove_syringe -> t_install_guidewire
flow t_install_guidewire -> t_remove_trocar
flow t_remove_trocar -> xor5
flow xor5 -> wire_long "long axis" when="long_axis"
flow xor5 -> wire_short "short axis" when="short_axis"
flow wire_long -> xor6
flow wire_short -> xor6
flow xor6 -> t_check_wire_position
flow t_check_wire_position -> xor7
flow xor7 -> t_anaesthesia_puncture "not good" when="not_good"
flow xor7 -> t_widen_pathway "good" default
flow t_widen_pathway -> t_advance_catheter
flow t_advance_catheter -> t_remove_guidewire
flow t_remove_guidewire -> t_verify_flow
flow t_verify_flow -> t_check_catheter
flow t_check_catheter -> e
