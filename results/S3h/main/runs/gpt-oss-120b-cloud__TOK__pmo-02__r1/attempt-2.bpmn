<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Hiring Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Hiring Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create_jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect_resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen_resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite_inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite_virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>candidate_chosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salary_negotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate_salary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_chosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="identify_need" name="Identify need for new hire" />
    <bpmn:task id="create_jd" name="Create job description" />
    <bpmn:task id="post_job" name="Post job on job boards" />
    <bpmn:task id="collect_resumes" name="Collect resumes" />
    <bpmn:task id="screen_resumes" name="Screen resumes" />
    <bpmn:task id="phone_interviews" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="interview_type" name="Interview type?" />
    <bpmn:task id="invite_inperson" name="Invite candidate for in-person interview" />
    <bpmn:task id="invite_virtual" name="Invite candidate for virtual interview" />
    <bpmn:task id="conduct_interview" name="Conduct interview" />
    <bpmn:exclusiveGateway id="candidate_chosen" name="Candidate chosen?" />
    <bpmn:task id="extend_offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="salary_negotiation" name="Salary negotiation needed?" />
    <bpmn:task id="negotiate_salary" name="Negotiate salary" />
    <bpmn:task id="offer_accepted" name="Offer accepted" />
    <bpmn:parallelGateway id="onboarding_split" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Conduct orientation" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:parallelGateway id="onboarding_join" />
    <bpmn:task id="integrate" name="Integrate new hire into team" />
    <bpmn:endEvent id="not_chosen" name="Candidate not chosen" />
    <bpmn:endEvent id="end_complete" name="Hiring process completed" />
    <bpmn:sequenceFlow id="f-start-identify_need" sourceRef="start" targetRef="identify_need" />
    <bpmn:sequenceFlow id="f-identify_need-create_jd" sourceRef="identify_need" targetRef="create_jd" />
    <bpmn:sequenceFlow id="f-create_jd-post_job" sourceRef="create_jd" targetRef="post_job" />
    <bpmn:sequenceFlow id="f-post_job-collect_resumes" sourceRef="post_job" targetRef="collect_resumes" />
    <bpmn:sequenceFlow id="f-collect_resumes-screen_resumes" sourceRef="collect_resumes" targetRef="screen_resumes" />
    <bpmn:sequenceFlow id="f-screen_resumes-phone_interviews" sourceRef="screen_resumes" targetRef="phone_interviews" />
    <bpmn:sequenceFlow id="f-phone_interviews-interview_type" sourceRef="phone_interviews" targetRef="interview_type" />
    <bpmn:sequenceFlow id="f-interview_type-invite_inperson" name="in-person" sourceRef="interview_type" targetRef="invite_inperson" />
    <bpmn:sequenceFlow id="f-interview_type-invite_virtual" name="virtual" sourceRef="interview_type" targetRef="invite_virtual" />
    <bpmn:sequenceFlow id="f-invite_inperson-conduct_interview" sourceRef="invite_inperson" targetRef="conduct_interview" />
    <bpmn:sequenceFlow id="f-invite_virtual-conduct_interview" sourceRef="invite_virtual" targetRef="conduct_interview" />
    <bpmn:sequenceFlow id="f-conduct_interview-candidate_chosen" sourceRef="conduct_interview" targetRef="candidate_chosen" />
    <bpmn:sequenceFlow id="f-candidate_chosen-extend_offer" name="yes" sourceRef="candidate_chosen" targetRef="extend_offer" />
    <bpmn:sequenceFlow id="f-candidate_chosen-not_chosen" name="no" sourceRef="candidate_chosen" targetRef="not_chosen" />
    <bpmn:sequenceFlow id="f-extend_offer-salary_negotiation" sourceRef="extend_offer" targetRef="salary_negotiation" />
    <bpmn:sequenceFlow id="f-salary_negotiation-negotiate_salary" name="yes" sourceRef="salary_negotiation" targetRef="negotiate_salary" />
    <bpmn:sequenceFlow id="f-salary_negotiation-offer_accepted" name="no" sourceRef="salary_negotiation" targetRef="offer_accepted" />
    <bpmn:sequenceFlow id="f-negotiate_salary-offer_accepted" sourceRef="negotiate_salary" targetRef="offer_accepted" />
    <bpmn:sequenceFlow id="f-offer_accepted-onboarding_split" sourceRef="offer_accepted" targetRef="onboarding_split" />
    <bpmn:sequenceFlow id="f-onboarding_split-paperwork" sourceRef="onboarding_split" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-onboarding_split-orientation" sourceRef="onboarding_split" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-onboarding_split-training" sourceRef="onboarding_split" targetRef="training" />
    <bpmn:sequenceFlow id="f-paperwork-onboarding_join" sourceRef="paperwork" targetRef="onboarding_join" />
    <bpmn:sequenceFlow id="f-orientation-onboarding_join" sourceRef="orientation" targetRef="onboarding_join" />
    <bpmn:sequenceFlow id="f-training-onboarding_join" sourceRef="training" targetRef="onboarding_join" />
    <bpmn:sequenceFlow id="f-onboarding_join-integrate" sourceRef="onboarding_join" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-end_complete" sourceRef="integrate" targetRef="end_complete" />
  </bpmn:process>
</bpmn:definitions>
