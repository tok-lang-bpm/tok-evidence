<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inventory Reorder Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inventory Reorder Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start monitoring inventory" />
    <bpmn:task id="mon" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="alert" name="Alert or manual check?" />
    <bpmn:task id="auto" name="Generate automated alert" />
    <bpmn:task id="manual" name="Perform manual check" />
    <bpmn:task id="signal" name="Signal need to reorder" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="record" name="Record stock in system" />
    <bpmn:task id="store" name="Place stock on shelves or in storage" />
    <bpmn:task id="update_levels" name="Update inventory levels after restock" />
    <bpmn:endEvent id="E" name="Process completed" />
    <bpmn:task id="place" name="Place order with suppliers" />
    <bpmn:task id="update" name="Update inventory system with expected delivery dates" />
    <bpmn:sequenceFlow id="f-S-mon" sourceRef="S" targetRef="mon" />
    <bpmn:sequenceFlow id="f-mon-alert" sourceRef="mon" targetRef="alert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &gt;= threshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-alert-auto" name="automated" sourceRef="alert" targetRef="auto" />
    <bpmn:sequenceFlow id="f-alert-manual" name="manual" sourceRef="alert" targetRef="manual" />
    <bpmn:sequenceFlow id="f-auto-signal" sourceRef="auto" targetRef="signal" />
    <bpmn:sequenceFlow id="f-manual-signal" sourceRef="manual" targetRef="signal" />
    <bpmn:sequenceFlow id="f-signal-place" sourceRef="signal" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-update" sourceRef="place" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-receive" sourceRef="update" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-store" sourceRef="record" targetRef="store" />
    <bpmn:sequenceFlow id="f-store-update_levels" sourceRef="store" targetRef="update_levels" />
    <bpmn:sequenceFlow id="f-update_levels-E" sourceRef="update_levels" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
