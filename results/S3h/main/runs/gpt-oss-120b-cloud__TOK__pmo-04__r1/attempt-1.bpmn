<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing Campaign Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing Campaign Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing Team">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="CRM System">
        <bpmn:flowNodeRef>t_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Team">
        <bpmn:flowNodeRef>t_follow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Define campaign objectives" />
    <bpmn:parallelGateway id="g1" />
    <bpmn:task id="t_create" name="Create content" />
    <bpmn:task id="t_design" name="Design visuals" />
    <bpmn:task id="t_select" name="Select promotion channels" />
    <bpmn:parallelGateway id="g2" />
    <bpmn:task id="t_launch" name="Launch campaign" />
    <bpmn:task id="t_end" name="End campaign period" />
    <bpmn:task id="t_analyze" name="Analyze performance" />
    <bpmn:endEvent id="e_end" name="Process completed" />
    <bpmn:task id="t_track" name="Track performance in real-time" />
    <bpmn:task id="t_collect" name="Collect leads in CRM system" />
    <bpmn:task id="t_follow" name="Follow up leads" />
    <bpmn:sequenceFlow id="f-s1-g1" sourceRef="s1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t_create" sourceRef="g1" targetRef="t_create" />
    <bpmn:sequenceFlow id="f-g1-t_design" sourceRef="g1" targetRef="t_design" />
    <bpmn:sequenceFlow id="f-g1-t_select" sourceRef="g1" targetRef="t_select" />
    <bpmn:sequenceFlow id="f-t_create-g2" sourceRef="t_create" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t_design-g2" sourceRef="t_design" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t_select-g2" sourceRef="t_select" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t_launch" sourceRef="g2" targetRef="t_launch" />
    <bpmn:sequenceFlow id="f-t_launch-t_track" sourceRef="t_launch" targetRef="t_track" />
    <bpmn:sequenceFlow id="f-t_track-t_collect" sourceRef="t_track" targetRef="t_collect" />
    <bpmn:sequenceFlow id="f-t_collect-t_follow" sourceRef="t_collect" targetRef="t_follow" />
    <bpmn:sequenceFlow id="f-t_follow-t_end" sourceRef="t_follow" targetRef="t_end" />
    <bpmn:sequenceFlow id="f-t_end-t_analyze" sourceRef="t_end" targetRef="t_analyze" />
    <bpmn:sequenceFlow id="f-t_analyze-e_end" sourceRef="t_analyze" targetRef="e_end" />
  </bpmn:process>
</bpmn:definitions>
