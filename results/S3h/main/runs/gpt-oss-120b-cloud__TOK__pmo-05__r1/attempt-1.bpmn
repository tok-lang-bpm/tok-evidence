<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Supplier onboarding process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Supplier onboarding process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Process start" />
    <bpmn:task id="identify" name="Identify need for new supplier" />
    <bpmn:task id="issue" name="Issue request for proposals (RFP)" />
    <bpmn:task id="receive" name="Receive proposals from suppliers" />
    <bpmn:task id="evaluate" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="visits" name="Conduct site visits or interviews?" />
    <bpmn:task id="conduct" name="Conduct site visits or interviews" />
    <bpmn:task id="select" name="Select supplier" />
    <bpmn:task id="negotiate" name="Begin contract negotiations" />
    <bpmn:task id="agree" name="Agree on terms" />
    <bpmn:task id="sign" name="Sign contract" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="execute" name="Execute contract" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="e" name="Process end" />
    <bpmn:task id="onboard" name="Onboard supplier" />
    <bpmn:sequenceFlow id="f-s-identify" sourceRef="s" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-issue" sourceRef="identify" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-receive" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-visits" sourceRef="evaluate" targetRef="visits" />
    <bpmn:sequenceFlow id="f-visits-conduct" name="yes" sourceRef="visits" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-visits-select" name="no" sourceRef="visits" targetRef="select" />
    <bpmn:sequenceFlow id="f-conduct-select" sourceRef="conduct" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agree" sourceRef="negotiate" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-sign" sourceRef="agree" targetRef="sign" />
    <bpmn:sequenceFlow id="f-sign-split" sourceRef="sign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-execute" sourceRef="split" targetRef="execute" />
    <bpmn:sequenceFlow id="f-split-onboard" sourceRef="split" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-execute-join" sourceRef="execute" targetRef="join" />
    <bpmn:sequenceFlow id="f-onboard-join" sourceRef="onboard" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-e" sourceRef="join" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
