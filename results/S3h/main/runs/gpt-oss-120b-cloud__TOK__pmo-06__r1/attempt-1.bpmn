<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order fulfillment process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_feedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_shipping_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor_shipment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover_to_logistics</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics Provider">
        <bpmn:flowNodeRef>deliver_shipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>further_actions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handle_feedback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order placed" />
    <bpmn:task id="place_order" name="Place order" />
    <bpmn:endEvent id="end_success" name="Process completed" />
    <bpmn:endEvent id="end_feedback" name="Process ended with feedback handling" />
    <bpmn:task id="generate_confirmation" name="Generate order confirmation" />
    <bpmn:task id="send_confirmation" name="Send order confirmation" />
    <bpmn:task id="generate_shipping_label" name="Generate shipping label" />
    <bpmn:task id="send_tracking" name="Send tracking information to customer" />
    <bpmn:task id="monitor_shipment" name="Monitor shipment" />
    <bpmn:task id="pick_items" name="Pick items" />
    <bpmn:task id="pack_items" name="Pack items" />
    <bpmn:task id="handover_to_logistics" name="Hand over order to logistics provider" />
    <bpmn:task id="deliver_shipment" name="Deliver shipment" />
    <bpmn:exclusiveGateway id="further_actions" name="Further actions?" />
    <bpmn:task id="handle_feedback" name="Handle customer feedback or returns" />
    <bpmn:sequenceFlow id="f-start-place_order" sourceRef="start" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-generate_confirmation" sourceRef="place_order" targetRef="generate_confirmation" />
    <bpmn:sequenceFlow id="f-generate_confirmation-send_confirmation" sourceRef="generate_confirmation" targetRef="send_confirmation" />
    <bpmn:sequenceFlow id="f-send_confirmation-pick_items" sourceRef="send_confirmation" targetRef="pick_items" />
    <bpmn:sequenceFlow id="f-pick_items-pack_items" sourceRef="pick_items" targetRef="pack_items" />
    <bpmn:sequenceFlow id="f-pack_items-generate_shipping_label" sourceRef="pack_items" targetRef="generate_shipping_label" />
    <bpmn:sequenceFlow id="f-generate_shipping_label-handover_to_logistics" sourceRef="generate_shipping_label" targetRef="handover_to_logistics" />
    <bpmn:sequenceFlow id="f-handover_to_logistics-deliver_shipment" sourceRef="handover_to_logistics" targetRef="deliver_shipment" />
    <bpmn:sequenceFlow id="f-deliver_shipment-send_tracking" sourceRef="deliver_shipment" targetRef="send_tracking" />
    <bpmn:sequenceFlow id="f-send_tracking-monitor_shipment" sourceRef="send_tracking" targetRef="monitor_shipment" />
    <bpmn:sequenceFlow id="f-monitor_shipment-further_actions" sourceRef="monitor_shipment" targetRef="further_actions" />
    <bpmn:sequenceFlow id="f-further_actions-handle_feedback" sourceRef="further_actions" targetRef="handle_feedback" />
    <bpmn:sequenceFlow id="f-handle_feedback-end_feedback" sourceRef="handle_feedback" targetRef="end_feedback" />
    <bpmn:sequenceFlow id="f-further_actions-end_success" sourceRef="further_actions" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>
