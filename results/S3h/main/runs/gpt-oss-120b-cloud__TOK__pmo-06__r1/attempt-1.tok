tok 1.0 "Order fulfillment process"

pool org "Organisation"

  lane customer "Customer"
    start start "Order placed"
    task place_order "Place order"
    end end_success "Process completed"
    end end_feedback "Process ended with feedback handling"

  lane system "System"
    task generate_confirmation "Generate order confirmation"
    task send_confirmation "Send order confirmation"
    task generate_shipping_label "Generate shipping label"
    task send_tracking "Send tracking information to customer"
    task monitor_shipment "Monitor shipment"

  lane warehouse "Warehouse"
    task pick_items "Pick items"
    task pack_items "Pack items"
    task handover_to_logistics "Hand over order to logistics provider"

  lane logistics "Logistics Provider"
    task deliver_shipment "Deliver shipment"
    xor further_actions "Further actions?"
    task handle_feedback "Handle customer feedback or returns"

flow start -> place_order -> generate_confirmation -> send_confirmation -> pick_items -> pack_items -> generate_shipping_label -> handover_to_logistics -> deliver_shipment -> send_tracking -> monitor_shipment -> further_actions
flow further_actions -> handle_feedback -> end_feedback
flow further_actions -> end_success
