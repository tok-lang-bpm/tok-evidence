tok 1.0 "Travel Booking Process"

pool travel_company "Travel Company"
  lane customer "Customer"
    start S "Search for ticket"
    task T1 "Select preferred route, date and time"
    task T2 "Provide personal information and payment details"
    task T8 "Collect post-travel feedback"
    end E2 "Feedback collected"
  lane booking_system "Booking System"
    task T3 "Generate ticket"
    xor G1 "Send ticket via email or SMS"
    task T4a "Send ticket via email"
    task T4b "Send ticket via SMS"
    xor G2 "Ticket sent merge"
    task T6 "Send reminders and instructions"
    xor G3 "Send reminders?"
    xor G4 "Reminders merge"
  lane travel_company_dept "Travel Company Dept"
    task T5 "Update seat inventory"
    task T7 "Complete journey"
    end E1 "Journey completed"

flow S -> T1 -> T2 -> T3
flow T3 -> G1
flow G1 -> T4a
flow G1 -> T4b
flow T4a -> G2
flow T4b -> G2
flow G2 -> T5
flow T5 -> G3
flow G3 -> T6
flow G3 -> G4
flow T6 -> G4
flow G4 -> T7
flow T7 -> G5
xor G5 "Collect post‑travel feedback?"
flow G5 -> T8
flow G5 -> E1
flow T8 -> E2
