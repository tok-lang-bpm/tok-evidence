<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Travel Booking Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="travel_organisation" name="Travel Organisation" processRef="travel_organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="travel_organisation-process" name="Travel Booking Process" isExecutable="false">
    <bpmn:laneSet id="travel_organisation-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="booking_system" name="Booking System">
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="travel_company" name="Travel Company">
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Search for ticket" />
    <bpmn:task id="C1" name="Select preferred route, date and time" />
    <bpmn:task id="C2" name="Provide personal information and payment details" />
    <bpmn:task id="C3" name="Collect post‑travel feedback" />
    <bpmn:endEvent id="E2" name="Feedback collected" />
    <bpmn:endEvent id="E1" name="Journey completed" />
    <bpmn:task id="B1" name="Generate ticket" />
    <bpmn:exclusiveGateway id="G1" name="Send ticket via email or SMS?" />
    <bpmn:task id="B2" name="Send ticket via email" />
    <bpmn:task id="B3" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="G2" name="Ticket sent merge" />
    <bpmn:task id="B4" name="Send reminders and instructions" />
    <bpmn:exclusiveGateway id="G3" name="Send reminders?" />
    <bpmn:exclusiveGateway id="G4" name="Reminders merge" />
    <bpmn:task id="D1" name="Update seat inventory" />
    <bpmn:task id="D2" name="Complete journey" />
    <bpmn:exclusiveGateway id="G5" name="Collect post‑travel feedback?" />
    <bpmn:task id="D3" name="Collect post‑travel feedback" />
    <bpmn:sequenceFlow id="f-S-C1" sourceRef="S" targetRef="C1" />
    <bpmn:sequenceFlow id="f-C1-C2" sourceRef="C1" targetRef="C2" />
    <bpmn:sequenceFlow id="f-C2-C3" sourceRef="C2" targetRef="C3" />
    <bpmn:sequenceFlow id="f-C3-B1" sourceRef="C3" targetRef="B1" />
    <bpmn:sequenceFlow id="f-B1-G1" sourceRef="B1" targetRef="G1" />
    <bpmn:sequenceFlow id="f-G1-B2" sourceRef="G1" targetRef="B2" />
    <bpmn:sequenceFlow id="f-G1-B3" sourceRef="G1" targetRef="B3" />
    <bpmn:sequenceFlow id="f-B2-G2" sourceRef="B2" targetRef="G2" />
    <bpmn:sequenceFlow id="f-B3-G2" sourceRef="B3" targetRef="G2" />
    <bpmn:sequenceFlow id="f-G2-D1" sourceRef="G2" targetRef="D1" />
    <bpmn:sequenceFlow id="f-D1-G3" sourceRef="D1" targetRef="G3" />
    <bpmn:sequenceFlow id="f-G3-B4" sourceRef="G3" targetRef="B4" />
    <bpmn:sequenceFlow id="f-G3-G4" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="f-B4-G4" sourceRef="B4" targetRef="G4" />
    <bpmn:sequenceFlow id="f-G4-D2" sourceRef="G4" targetRef="D2" />
    <bpmn:sequenceFlow id="f-D2-G5" sourceRef="D2" targetRef="G5" />
    <bpmn:sequenceFlow id="f-G5-D3" sourceRef="G5" targetRef="D3" />
    <bpmn:sequenceFlow id="f-G5-E1" sourceRef="G5" targetRef="E1" />
    <bpmn:sequenceFlow id="f-D3-E2" sourceRef="D3" targetRef="E2" />
  </bpmn:process>
</bpmn:definitions>
