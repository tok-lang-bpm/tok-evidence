tok 1.0 "Travel Booking Process"

pool travel_organisation "Travel Organisation"
  lane customer "Customer"
    start S "Search for ticket"
    task C1 "Select preferred route, date and time"
    task C2 "Provide personal information and payment details"
  lane booking_system "Booking System"
    task B1 "Generate ticket"
    xor G1 "Send ticket via email or SMS?"
    task B2 "Send ticket via email"
    task B3 "Send ticket via SMS"
    xor G2 "Ticket sent merge"
    xor G3 "Send reminders?"
    task B4 "Send reminders and instructions"
    xor G4 "Reminders merge"
    xor G5 "Collect post‑travel feedback?"
  lane travel_company "Travel Company"
    task D1 "Update seat inventory"
    task D2 "Complete journey"
    task D3 "Collect post‑travel feedback"
    end E1 "Journey completed"
    end E2 "Feedback collected"

flow S -> C1
flow C1 -> C2
flow C2 -> B1
flow B1 -> G1
flow G1 -> B2 "email"
flow G1 -> B3 "sms"
flow B2 -> G2
flow B3 -> G2
flow G2 -> D1
flow D1 -> G3
flow G3 -> B4 "reminder"
flow G3 -> G4 "no reminder"
flow B4 -> G4
flow G4 -> D2
flow D2 -> G5
flow G5 -> D3 "feedback"
flow G5 -> E1 "no feedback"
flow D3 -> E2
