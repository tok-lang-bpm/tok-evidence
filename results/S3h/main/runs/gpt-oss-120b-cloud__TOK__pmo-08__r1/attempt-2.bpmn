<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident Management Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident Management Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="reporter" name="Reporter">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reporter_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>emp_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cust_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Incident Response Team">
        <bpmn:flowNodeRef>log_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose_actions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement_solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_and_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Process start" />
    <bpmn:exclusiveGateway id="reporter_type" name="Reporter type?" />
    <bpmn:task id="emp_report" name="Employee reports incident" />
    <bpmn:task id="cust_report" name="Customer reports incident" />
    <bpmn:task id="log_report" name="Log incident report" />
    <bpmn:task id="assign_team" name="Assign incident to team" />
    <bpmn:task id="gather_info" name="Gather necessary information" />
    <bpmn:task id="identify_cause" name="Identify cause of incident" />
    <bpmn:task id="propose_actions" name="Propose corrective actions" />
    <bpmn:task id="implement_solution" name="Implement solution" />
    <bpmn:task id="perform_followup" name="Perform follow-up" />
    <bpmn:task id="close_and_notify" name="Close incident report and notify stakeholders" />
    <bpmn:endEvent id="end1" name="Incident closed" />
    <bpmn:sequenceFlow id="f-start1-reporter_type" sourceRef="start1" targetRef="reporter_type" />
    <bpmn:sequenceFlow id="f-reporter_type-emp_report" name="employee" sourceRef="reporter_type" targetRef="emp_report" />
    <bpmn:sequenceFlow id="f-reporter_type-cust_report" name="customer" sourceRef="reporter_type" targetRef="cust_report" />
    <bpmn:sequenceFlow id="f-emp_report-log_report" sourceRef="emp_report" targetRef="log_report" />
    <bpmn:sequenceFlow id="f-cust_report-log_report" sourceRef="cust_report" targetRef="log_report" />
    <bpmn:sequenceFlow id="f-log_report-assign_team" sourceRef="log_report" targetRef="assign_team" />
    <bpmn:sequenceFlow id="f-assign_team-gather_info" sourceRef="assign_team" targetRef="gather_info" />
    <bpmn:sequenceFlow id="f-gather_info-identify_cause" sourceRef="gather_info" targetRef="identify_cause" />
    <bpmn:sequenceFlow id="f-identify_cause-propose_actions" sourceRef="identify_cause" targetRef="propose_actions" />
    <bpmn:sequenceFlow id="f-propose_actions-implement_solution" sourceRef="propose_actions" targetRef="implement_solution" />
    <bpmn:sequenceFlow id="f-implement_solution-perform_followup" sourceRef="implement_solution" targetRef="perform_followup" />
    <bpmn:sequenceFlow id="f-perform_followup-close_and_notify" sourceRef="perform_followup" targetRef="close_and_notify" />
    <bpmn:sequenceFlow id="f-close_and_notify-end1" sourceRef="close_and_notify" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
