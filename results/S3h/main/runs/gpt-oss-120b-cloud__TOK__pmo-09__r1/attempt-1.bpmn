<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Product Development Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Product Development Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="r_and_d" name="R&amp;D Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify idea for new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="design" name="Draft design concepts" />
    <bpmn:exclusiveGateway id="select" name="Promising design selected?" />
    <bpmn:task id="prototype" name="Build prototype using available materials and resources" />
    <bpmn:task id="test" name="Prototype undergoes various tests" />
    <bpmn:task id="feedback" name="Collect feedback from testing phase" />
    <bpmn:exclusiveGateway id="refine_gw" name="Is refinement needed?" />
    <bpmn:task id="refine_task" name="Refine prototype" />
    <bpmn:exclusiveGateway id="outcome_gw" name="Prototype approved for further development?" />
    <bpmn:endEvent id="approved" name="Prototype approved" />
    <bpmn:endEvent id="discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-start-identify" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-research" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f-research-design" sourceRef="research" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-select" sourceRef="design" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-prototype" name="yes" sourceRef="select" targetRef="prototype" />
    <bpmn:sequenceFlow id="f-prototype-test" sourceRef="prototype" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-feedback" sourceRef="test" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-refine_gw" sourceRef="feedback" targetRef="refine_gw" />
    <bpmn:sequenceFlow id="f-refine_gw-refine_task" name="yes" sourceRef="refine_gw" targetRef="refine_task" />
    <bpmn:sequenceFlow id="f-refine_gw-outcome_gw" name="no" sourceRef="refine_gw" targetRef="outcome_gw" />
    <bpmn:sequenceFlow id="f-refine_task-test" sourceRef="refine_task" targetRef="test" />
    <bpmn:sequenceFlow id="f-outcome_gw-approved" name="yes" sourceRef="outcome_gw" targetRef="approved" />
    <bpmn:sequenceFlow id="f-outcome_gw-discarded" name="no" sourceRef="outcome_gw" targetRef="discarded" />
  </bpmn:process>
</bpmn:definitions>
