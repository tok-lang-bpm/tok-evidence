<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IT solution request process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="IT solution request process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="requester" name="Requester">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Process start" />
    <bpmn:task id="sub" name="Submit request" />
    <bpmn:task id="assess" name="Assess request" />
    <bpmn:exclusiveGateway id="approve" name="Request approved?" />
    <bpmn:task id="procure" name="Procure tools or licenses" />
    <bpmn:task id="install" name="Install solution" />
    <bpmn:task id="test" name="Test solution" />
    <bpmn:task id="rollout" name="Roll out solution" />
    <bpmn:parallelGateway id="pg1" name="Parallel activities after rollout" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:task id="support" name="Provide support" />
    <bpmn:parallelGateway id="pg2" name="Parallel join" />
    <bpmn:endEvent id="completed" name="Process completed" />
    <bpmn:endEvent id="rejected" name="Request not approved" />
    <bpmn:sequenceFlow id="f-s-sub" sourceRef="s" targetRef="sub" />
    <bpmn:sequenceFlow id="f-sub-assess" sourceRef="sub" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-approve" sourceRef="assess" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-procure" name="yes" sourceRef="approve" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approve-rejected" name="no" sourceRef="approve" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-rollout" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-rollout-pg1" sourceRef="rollout" targetRef="pg1" />
    <bpmn:sequenceFlow id="f-pg1-train" sourceRef="pg1" targetRef="train" />
    <bpmn:sequenceFlow id="f-pg1-support" sourceRef="pg1" targetRef="support" />
    <bpmn:sequenceFlow id="f-train-pg2" sourceRef="train" targetRef="pg2" />
    <bpmn:sequenceFlow id="f-support-pg2" sourceRef="support" targetRef="pg2" />
    <bpmn:sequenceFlow id="f-pg2-completed" sourceRef="pg2" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
