tok 1.0 "IT solution request process"

pool org "Organization"
  lane requester "Requester"
    start s "Process start"
    task sub "Submit request"
  lane it "IT"
    task assess "Assess request"
    xor approve "Request approved?"
    task procure "Procure tools or licenses"
    task install "Install solution"
    task test "Test solution"
    task rollout "Roll out solution"
    and pg1 "Parallel activities after rollout"
    task train "Provide training"
    task support "Provide support"
    and pg2 "Parallel join"
    end completed "Process completed"
    end rejected "Request not approved"

flow s -> sub -> assess -> approve
flow approve -> procure "yes"
flow approve -> rejected "no"
flow procure -> install -> test -> rollout -> pg1
flow pg1 -> train
flow pg1 -> support
flow train -> pg2
flow support -> pg2
flow pg2 -> completed
