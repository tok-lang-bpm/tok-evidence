<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Subscription Service Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Subscription Service Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5u</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EU</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Team">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Customer signs up for subscription" />
    <bpmn:task id="T1" name="Enter personal and payment information" />
    <bpmn:task id="T5c" name="Submit cancellation request" />
    <bpmn:task id="T5u" name="Receive regular updates, product enhancements, or renewal notifications" />
    <bpmn:exclusiveGateway id="G1" name="Customer decides to cancel?" />
    <bpmn:endEvent id="E1" name="Subscription active" />
    <bpmn:endEvent id="EU" name="Updates delivered" />
    <bpmn:task id="T2" name="Generate account" />
    <bpmn:task id="T3" name="Assign access" />
    <bpmn:task id="T4" name="Trigger automated billing cycles" />
    <bpmn:parallelGateway id="PG1" name="Parallel split" />
    <bpmn:task id="T6" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="G2" name="Refund or charge applicable?" />
    <bpmn:task id="T7" name="Apply refund or charge" />
    <bpmn:task id="T8" name="Deactivate subscription" />
    <bpmn:task id="T9" name="Settle final account balance" />
    <bpmn:endEvent id="E2" name="Subscription cancelled" />
    <bpmn:sequenceFlow id="f-S1-T1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="f-T1-T2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="f-T2-T3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="f-T3-T4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="f-T4-PG1" sourceRef="T4" targetRef="PG1" />
    <bpmn:sequenceFlow id="f-PG1-G1" sourceRef="PG1" targetRef="G1" />
    <bpmn:sequenceFlow id="f-PG1-T5u" sourceRef="PG1" targetRef="T5u" />
    <bpmn:sequenceFlow id="f-T5u-EU" sourceRef="T5u" targetRef="EU" />
    <bpmn:sequenceFlow id="f-G1-E1" name="no" sourceRef="G1" targetRef="E1" />
    <bpmn:sequenceFlow id="f-G1-T5c" name="yes" sourceRef="G1" targetRef="T5c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cancel</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-T5c-T6" sourceRef="T5c" targetRef="T6" />
    <bpmn:sequenceFlow id="f-T6-G2" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="f-G2-T7" name="yes" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="f-G2-T8" name="no" sourceRef="G2" targetRef="T8" />
    <bpmn:sequenceFlow id="f-T7-T8" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="f-T8-T9" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="f-T9-E2" sourceRef="T9" targetRef="E2" />
  </bpmn:process>
</bpmn:definitions>
