<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Complaint handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Complaint handling process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cust_service" name="Customer Service">
        <bpmn:flowNodeRef>L</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="investigation" name="Investigation Team">
        <bpmn:flowNodeRef>R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RES</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Financial Team">
        <bpmn:flowNodeRef>P</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Customer files complaint" />
    <bpmn:task id="FB" name="Provide feedback" />
    <bpmn:endEvent id="E" name="Process completed" />
    <bpmn:task id="L" name="Log complaint and assign" />
    <bpmn:task id="R" name="Review complaint details" />
    <bpmn:exclusiveGateway id="D" name="Refund approved?" />
    <bpmn:task id="N_yes" name="Notify customer of approval" />
    <bpmn:task id="N_no" name="Notify customer of rejection" />
    <bpmn:exclusiveGateway id="M" name="Merge paths" />
    <bpmn:task id="RES" name="Mark complaint as resolved" />
    <bpmn:task id="P" name="Process reimbursement" />
    <bpmn:sequenceFlow id="f-S-L" sourceRef="S" targetRef="L" />
    <bpmn:sequenceFlow id="f-L-R" sourceRef="L" targetRef="R" />
    <bpmn:sequenceFlow id="f-R-D" sourceRef="R" targetRef="D" />
    <bpmn:sequenceFlow id="f-D-N_yes" name="yes" sourceRef="D" targetRef="N_yes" />
    <bpmn:sequenceFlow id="f-D-N_no" name="no" sourceRef="D" targetRef="N_no" />
    <bpmn:sequenceFlow id="f-N_yes-P" sourceRef="N_yes" targetRef="P" />
    <bpmn:sequenceFlow id="f-P-M" sourceRef="P" targetRef="M" />
    <bpmn:sequenceFlow id="f-N_no-M" sourceRef="N_no" targetRef="M" />
    <bpmn:sequenceFlow id="f-M-RES" sourceRef="M" targetRef="RES" />
    <bpmn:sequenceFlow id="f-RES-FB" sourceRef="RES" targetRef="FB" />
    <bpmn:sequenceFlow id="f-FB-E" sourceRef="FB" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
