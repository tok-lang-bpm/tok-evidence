<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Budget Planning Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Budget Planning Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>D</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="strategy" name="Strategy">
        <bpmn:flowNodeRef>SR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance">
        <bpmn:flowNodeRef>FR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ADJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>AA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start budgeting process" />
    <bpmn:task id="O" name="Outline objectives" />
    <bpmn:endEvent id="E" name="Budget distributed and implementation starts" />
    <bpmn:task id="D" name="Draft plan with cost estimates and justifications" />
    <bpmn:task id="SR" name="Strategic alignment meeting review" />
    <bpmn:task id="FR" name="Finance detailed review" />
    <bpmn:exclusiveGateway id="ADJ" name="Adjustments needed?" default="f-ADJ-AL" />
    <bpmn:task id="AD" name="Document adjustments" />
    <bpmn:task id="AL" name="Allocate budget to department" />
    <bpmn:task id="AA" name="Approve adjustments" />
    <bpmn:sequenceFlow id="f-S-O" sourceRef="S" targetRef="O" />
    <bpmn:sequenceFlow id="f-O-D" sourceRef="O" targetRef="D" />
    <bpmn:sequenceFlow id="f-D-SR" sourceRef="D" targetRef="SR" />
    <bpmn:sequenceFlow id="f-SR-FR" sourceRef="SR" targetRef="FR" />
    <bpmn:sequenceFlow id="f-FR-ADJ" sourceRef="FR" targetRef="ADJ" />
    <bpmn:sequenceFlow id="f-ADJ-AD" name="yes" sourceRef="ADJ" targetRef="AD" />
    <bpmn:sequenceFlow id="f-ADJ-AL" sourceRef="ADJ" targetRef="AL" />
    <bpmn:sequenceFlow id="f-AD-AA" sourceRef="AD" targetRef="AA" />
    <bpmn:sequenceFlow id="f-AA-FR" sourceRef="AA" targetRef="FR" />
    <bpmn:sequenceFlow id="f-AL-E" sourceRef="AL" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
