<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Company" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Compliance Audit Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="scheduler" name="Scheduler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal Team">
        <bpmn:flowNodeRef>prep_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditor" name="Auditor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certify_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certify_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start audit scheduling" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="prep_start" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="assess" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="prep_end" />
    <bpmn:task id="review" name="Review processes" />
    <bpmn:task id="final_audit" name="Conduct final audit" />
    <bpmn:task id="correct" name="Make corrections or improvements" />
    <bpmn:exclusiveGateway id="decision" name="All criteria met?" />
    <bpmn:parallelGateway id="certify_start" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:parallelGateway id="certify_end" />
    <bpmn:endEvent id="success" name="Process completed" />
    <bpmn:endEvent id="failure" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f-start-schedule" sourceRef="start" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-prep_start" sourceRef="schedule" targetRef="prep_start" />
    <bpmn:sequenceFlow id="f-prep_start-prepare" sourceRef="prep_start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-prep_end" sourceRef="prepare" targetRef="prep_end" />
    <bpmn:sequenceFlow id="f-prep_start-gather" sourceRef="prep_start" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-prep_end" sourceRef="gather" targetRef="prep_end" />
    <bpmn:sequenceFlow id="f-prep_start-assess" sourceRef="prep_start" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-prep_end" sourceRef="assess" targetRef="prep_end" />
    <bpmn:sequenceFlow id="f-prep_end-review" sourceRef="prep_end" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-correct" sourceRef="review" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-decision" sourceRef="correct" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-certify_start" name="yes" sourceRef="decision" targetRef="certify_start" />
    <bpmn:sequenceFlow id="f-decision-failure" name="no" sourceRef="decision" targetRef="failure" />
    <bpmn:sequenceFlow id="f-certify_start-award" sourceRef="certify_start" targetRef="award" />
    <bpmn:sequenceFlow id="f-award-certify_end" sourceRef="award" targetRef="certify_end" />
    <bpmn:sequenceFlow id="f-certify_start-issue" sourceRef="certify_start" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-certify_end" sourceRef="issue" targetRef="certify_end" />
    <bpmn:sequenceFlow id="f-certify_end-success" sourceRef="certify_end" targetRef="success" />
  </bpmn:process>
</bpmn:definitions>
