<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Company" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Compliance Audit Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="scheduler" name="Scheduler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal Team">
        <bpmn:flowNodeRef>prep_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditor" name="Auditor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start compliance audit scheduling" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="prep_split" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="assess" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="prep_join" />
    <bpmn:task id="review" name="Review company's processes" />
    <bpmn:task id="final_audit" name="Conduct final audit" />
    <bpmn:task id="correct" name="Make corrections or improvements" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" />
    <bpmn:parallelGateway id="award_split" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:parallelGateway id="award_join" />
    <bpmn:endEvent id="success" name="Process completed" />
    <bpmn:endEvent id="failure" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f-start-schedule" sourceRef="start" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-prep_split" sourceRef="schedule" targetRef="prep_split" />
    <bpmn:sequenceFlow id="f-prep_split-prepare" sourceRef="prep_split" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-prep_join" sourceRef="prepare" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-prep_split-gather" sourceRef="prep_split" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-prep_join" sourceRef="gather" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-prep_split-assess" sourceRef="prep_split" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-prep_join" sourceRef="assess" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-prep_join-review" sourceRef="prep_join" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-correct" sourceRef="review" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-final_audit" sourceRef="correct" targetRef="final_audit" />
    <bpmn:sequenceFlow id="f-final_audit-criteria" sourceRef="final_audit" targetRef="criteria" />
    <bpmn:sequenceFlow id="f-criteria-award_split" name="yes" sourceRef="criteria" targetRef="award_split" />
    <bpmn:sequenceFlow id="f-criteria-failure" name="no" sourceRef="criteria" targetRef="failure" />
    <bpmn:sequenceFlow id="f-award_split-award" sourceRef="award_split" targetRef="award" />
    <bpmn:sequenceFlow id="f-award-award_join" sourceRef="award" targetRef="award_join" />
    <bpmn:sequenceFlow id="f-award_split-issue" sourceRef="award_split" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-award_join" sourceRef="issue" targetRef="award_join" />
    <bpmn:sequenceFlow id="f-award_join-success" sourceRef="award_join" targetRef="success" />
  </bpmn:process>
</bpmn:definitions>
