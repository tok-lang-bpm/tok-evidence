tok 1.0 "Annual Audit Process" [executable]

pool company "Multinational Company"
  lane coordinator "Audit Coordinator"
    start s "Start audit process"
    task sendNotif "Send audit notification"
    and splitParallel
    and joinParallel

  lane regional "Regional Office"
    task prepareDocs "Prepare financial statements and gather documents"
    task submitDocs "Submit documents to central audit team"
    task provideClarifs "Provide clarifications"

  lane compliance "Compliance Team"
    task checkUpdates "Check regulatory updates"

  lane central "Central Audit Team"
    task reviewSub "Review submission"
    xor disc "Discrepancies found?"
    task requestClarifs "Request clarifications"

  lane audit "Audit Team"
    task conductRisk "Conduct risk assessment"
    and riskEvalSplit
    task evalFinRisk "Evaluate financial risks"
    task evalOpsRisk "Evaluate operational risks"
    task evalCompRisk "Evaluate compliance risks"
    and riskEvalJoin
    xor highRisk "High risk identified?"
    task launchInvest "Launch detailed investigation"
    and investSplit
    task dataAnalysis "Data analysis"
    task interviews "Interviews"
    task siteVisits "Site visits"
    and investJoin
    task compileReport "Compile audit report"

  lane director "Audit Director"
    task reviewReport "Review audit report"
    xor approve "Report approved?"
    task updateReport "Update audit report"

  lane final "Finalization"
    and finalDistSplit
    task distributeReport "Distribute report to executive board"
    task archiveReport "Archive report"
    and finalDistJoin
    end closed "Audit process closed"

# Sequence flows
flow s -> sendNotif
flow sendNotif -> splitParallel

flow splitParallel -> prepareDocs
flow splitParallel -> checkUpdates

flow prepareDocs -> joinParallel
flow checkUpdates -> joinParallel

flow joinParallel -> submitDocs

flow submitDocs -> reviewSub

flow reviewSub -> disc

flow disc -> requestClarifs "yes"
flow disc -> conductRisk "no"

flow requestClarifs -> provideClarifs
flow provideClarifs -> reviewSub

flow conductRisk -> riskEvalSplit

flow riskEvalSplit -> evalFinRisk
flow riskEvalSplit -> evalOpsRisk
flow riskEvalSplit -> evalCompRisk

flow evalFinRisk -> riskEvalJoin
flow evalOpsRisk -> riskEvalJoin
flow evalCompRisk -> riskEvalJoin

flow riskEvalJoin -> highRisk

flow highRisk -> launchInvest "yes"
flow highRisk -> compileReport "no"

flow launchInvest -> investSplit

flow investSplit -> dataAnalysis
flow investSplit -> interviews
flow investSplit -> siteVisits

flow dataAnalysis -> investJoin
flow interviews -> investJoin
flow siteVisits -> investJoin

flow investJoin -> compileReport

flow compileReport -> reviewReport

flow reviewReport -> approve

flow approve -> updateReport "no"
flow approve -> finalDistSplit "yes"

flow updateReport -> reviewReport

flow finalDistSplit -> distributeReport
flow finalDistSplit -> archiveReport

flow distributeReport -> finalDistJoin
flow archiveReport -> finalDistJoin

flow finalDistJoin -> closed
