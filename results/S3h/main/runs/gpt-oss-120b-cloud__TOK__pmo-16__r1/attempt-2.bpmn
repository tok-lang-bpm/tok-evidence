<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="coordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNotif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinParallel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional Office">
        <bpmn:flowNodeRef>prepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideClarifs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance Team">
        <bpmn:flowNodeRef>checkUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central Audit Team">
        <bpmn:flowNodeRef>reviewSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestClarifs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit" name="Audit Team">
        <bpmn:flowNodeRef>conductRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>riskEvalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalFinRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalOpsRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalCompRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>riskEvalJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>highRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launchInvest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>siteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compileReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit Director">
        <bpmn:flowNodeRef>reviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="final" name="Finalization">
        <bpmn:flowNodeRef>finalDistSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalDistJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start audit process" />
    <bpmn:task id="sendNotif" name="Send audit notification" />
    <bpmn:parallelGateway id="splitParallel" name="Parallel split" />
    <bpmn:parallelGateway id="joinParallel" name="Parallel join" />
    <bpmn:task id="prepareDocs" name="Prepare financial statements and gather documents" />
    <bpmn:task id="submitDocs" name="Submit documents to central audit team" />
    <bpmn:task id="provideClarifs" name="Provide clarifications" />
    <bpmn:task id="checkUpdates" name="Check regulatory updates" />
    <bpmn:task id="reviewSub" name="Review submission" />
    <bpmn:exclusiveGateway id="disc" name="Discrepancies found?" />
    <bpmn:task id="requestClarifs" name="Request clarifications" />
    <bpmn:task id="conductRisk" name="Conduct risk assessment" />
    <bpmn:parallelGateway id="riskEvalSplit" name="Risk evaluation split" />
    <bpmn:task id="evalFinRisk" name="Evaluate financial risks" />
    <bpmn:task id="evalOpsRisk" name="Evaluate operational risks" />
    <bpmn:task id="evalCompRisk" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="riskEvalJoin" name="Risk evaluation join" />
    <bpmn:exclusiveGateway id="highRisk" name="High risk identified?" />
    <bpmn:task id="launchInvest" name="Launch detailed investigation" />
    <bpmn:parallelGateway id="investSplit" name="Investigation split" />
    <bpmn:task id="dataAnalysis" name="Data analysis" />
    <bpmn:task id="interviews" name="Interviews" />
    <bpmn:task id="siteVisits" name="Site visits" />
    <bpmn:parallelGateway id="investJoin" name="Investigation join" />
    <bpmn:task id="compileReport" name="Compile audit report" />
    <bpmn:task id="reviewReport" name="Review audit report" />
    <bpmn:exclusiveGateway id="approve" name="Report approved?" />
    <bpmn:task id="updateReport" name="Update audit report" />
    <bpmn:parallelGateway id="finalDistSplit" name="Distribution split" />
    <bpmn:task id="distributeReport" name="Distribute report to executive board" />
    <bpmn:task id="archiveReport" name="Archive report" />
    <bpmn:parallelGateway id="finalDistJoin" name="Distribution join" />
    <bpmn:endEvent id="closed" name="Audit process closed" />
    <bpmn:sequenceFlow id="f-s-sendNotif" sourceRef="s" targetRef="sendNotif" />
    <bpmn:sequenceFlow id="f-sendNotif-splitParallel" sourceRef="sendNotif" targetRef="splitParallel" />
    <bpmn:sequenceFlow id="f-splitParallel-prepareDocs" sourceRef="splitParallel" targetRef="prepareDocs" />
    <bpmn:sequenceFlow id="f-splitParallel-checkUpdates" sourceRef="splitParallel" targetRef="checkUpdates" />
    <bpmn:sequenceFlow id="f-prepareDocs-joinParallel" sourceRef="prepareDocs" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-checkUpdates-joinParallel" sourceRef="checkUpdates" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f-joinParallel-submitDocs" sourceRef="joinParallel" targetRef="submitDocs" />
    <bpmn:sequenceFlow id="f-submitDocs-reviewSub" sourceRef="submitDocs" targetRef="reviewSub" />
    <bpmn:sequenceFlow id="f-reviewSub-disc" sourceRef="reviewSub" targetRef="disc" />
    <bpmn:sequenceFlow id="f-disc-requestClarifs" name="yes" sourceRef="disc" targetRef="requestClarifs" />
    <bpmn:sequenceFlow id="f-disc-conductRisk" name="no" sourceRef="disc" targetRef="conductRisk" />
    <bpmn:sequenceFlow id="f-requestClarifs-provideClarifs" sourceRef="requestClarifs" targetRef="provideClarifs" />
    <bpmn:sequenceFlow id="f-provideClarifs-reviewSub" sourceRef="provideClarifs" targetRef="reviewSub" />
    <bpmn:sequenceFlow id="f-conductRisk-riskEvalSplit" sourceRef="conductRisk" targetRef="riskEvalSplit" />
    <bpmn:sequenceFlow id="f-riskEvalSplit-evalFinRisk" sourceRef="riskEvalSplit" targetRef="evalFinRisk" />
    <bpmn:sequenceFlow id="f-riskEvalSplit-evalOpsRisk" sourceRef="riskEvalSplit" targetRef="evalOpsRisk" />
    <bpmn:sequenceFlow id="f-riskEvalSplit-evalCompRisk" sourceRef="riskEvalSplit" targetRef="evalCompRisk" />
    <bpmn:sequenceFlow id="f-evalFinRisk-riskEvalJoin" sourceRef="evalFinRisk" targetRef="riskEvalJoin" />
    <bpmn:sequenceFlow id="f-evalOpsRisk-riskEvalJoin" sourceRef="evalOpsRisk" targetRef="riskEvalJoin" />
    <bpmn:sequenceFlow id="f-evalCompRisk-riskEvalJoin" sourceRef="evalCompRisk" targetRef="riskEvalJoin" />
    <bpmn:sequenceFlow id="f-riskEvalJoin-highRisk" sourceRef="riskEvalJoin" targetRef="highRisk" />
    <bpmn:sequenceFlow id="f-highRisk-launchInvest" name="yes" sourceRef="highRisk" targetRef="launchInvest" />
    <bpmn:sequenceFlow id="f-highRisk-compileReport" name="no" sourceRef="highRisk" targetRef="compileReport" />
    <bpmn:sequenceFlow id="f-launchInvest-investSplit" sourceRef="launchInvest" targetRef="investSplit" />
    <bpmn:sequenceFlow id="f-investSplit-dataAnalysis" sourceRef="investSplit" targetRef="dataAnalysis" />
    <bpmn:sequenceFlow id="f-investSplit-interviews" sourceRef="investSplit" targetRef="interviews" />
    <bpmn:sequenceFlow id="f-investSplit-siteVisits" sourceRef="investSplit" targetRef="siteVisits" />
    <bpmn:sequenceFlow id="f-dataAnalysis-investJoin" sourceRef="dataAnalysis" targetRef="investJoin" />
    <bpmn:sequenceFlow id="f-interviews-investJoin" sourceRef="interviews" targetRef="investJoin" />
    <bpmn:sequenceFlow id="f-siteVisits-investJoin" sourceRef="siteVisits" targetRef="investJoin" />
    <bpmn:sequenceFlow id="f-investJoin-compileReport" sourceRef="investJoin" targetRef="compileReport" />
    <bpmn:sequenceFlow id="f-compileReport-reviewReport" sourceRef="compileReport" targetRef="reviewReport" />
    <bpmn:sequenceFlow id="f-reviewReport-approve" sourceRef="reviewReport" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-updateReport" name="no" sourceRef="approve" targetRef="updateReport" />
    <bpmn:sequenceFlow id="f-approve-finalDistSplit" name="yes" sourceRef="approve" targetRef="finalDistSplit" />
    <bpmn:sequenceFlow id="f-updateReport-reviewReport" sourceRef="updateReport" targetRef="reviewReport" />
    <bpmn:sequenceFlow id="f-finalDistSplit-distributeReport" sourceRef="finalDistSplit" targetRef="distributeReport" />
    <bpmn:sequenceFlow id="f-finalDistSplit-archiveReport" sourceRef="finalDistSplit" targetRef="archiveReport" />
    <bpmn:sequenceFlow id="f-distributeReport-finalDistJoin" sourceRef="distributeReport" targetRef="finalDistJoin" />
    <bpmn:sequenceFlow id="f-archiveReport-finalDistJoin" sourceRef="archiveReport" targetRef="finalDistJoin" />
    <bpmn:sequenceFlow id="f-finalDistJoin-closed" sourceRef="finalDistJoin" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
