<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order Fulfillment Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="E‑commerce Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order Fulfillment Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_returns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_payment_fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment" name="Payment System">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory System">
        <bpmn:flowNodeRef>check_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_inventory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="quality" name="Quality Control">
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="packaging" name="Packaging">
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping Department">
        <bpmn:flowNodeRef>prepare_shipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="returns" name="Returns">
        <bpmn:flowNodeRef>init_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_return_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_refund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order placed" />
    <bpmn:endEvent id="end_failed" name="Process ends (payment failure)" />
    <bpmn:endEvent id="end_completed" name="Order completed successfully" />
    <bpmn:endEvent id="end_returns" name="Returns process completed" />
    <bpmn:task id="rec" name="Record order details" />
    <bpmn:task id="send_confirmation" name="Send shipping confirmation to customer" />
    <bpmn:task id="send_feedback" name="Send follow‑up email for feedback" />
    <bpmn:parallelGateway id="split_parallel" name="Parallel split" />
    <bpmn:parallelGateway id="join_parallel" name="Parallel join" />
    <bpmn:exclusiveGateway id="issue_report" name="Customer reports issues?" />
    <bpmn:task id="notify_payment_fail" name="Notify customer of payment failure" />
    <bpmn:task id="pay" name="Begin payment processing" />
    <bpmn:exclusiveGateway id="pay_success" name="Payment successful?" />
    <bpmn:task id="check_stock" name="Check stock availability" />
    <bpmn:exclusiveGateway id="stock_ok" name="Items in stock?" />
    <bpmn:task id="backorder" name="Initiate back‑order" />
    <bpmn:task id="inform_delay" name="Inform customer of delay" />
    <bpmn:task id="wait_backorder" name="Receive back‑order and items available" />
    <bpmn:task id="update_inventory" name="Update inventory levels" />
    <bpmn:task id="pick" name="Pick items from warehouse" />
    <bpmn:task id="qc" name="Perform quality control checks" />
    <bpmn:task id="package" name="Package items (gift wrap if requested)" />
    <bpmn:task id="prepare_shipping" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs_doc" name="Prepare customs documentation" />
    <bpmn:task id="dispatch" name="Dispatch order" />
    <bpmn:task id="init_return" name="Initiate returns process" />
    <bpmn:task id="send_return_label" name="Send return shipping label" />
    <bpmn:task id="receive_return" name="Receive returned items" />
    <bpmn:task id="inspect_return" name="Inspect returned items" />
    <bpmn:task id="process_refund" name="Process refund or replacement" />
    <bpmn:sequenceFlow id="f-start-rec" sourceRef="start" targetRef="rec" />
    <bpmn:sequenceFlow id="f-rec-pay" sourceRef="rec" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-pay_success" sourceRef="pay" targetRef="pay_success" />
    <bpmn:sequenceFlow id="f-pay_success-notify_payment_fail" name="fail" sourceRef="pay_success" targetRef="notify_payment_fail" />
    <bpmn:sequenceFlow id="f-pay_success-check_stock" name="success" sourceRef="pay_success" targetRef="check_stock" />
    <bpmn:sequenceFlow id="f-notify_payment_fail-end_failed" sourceRef="notify_payment_fail" targetRef="end_failed" />
    <bpmn:sequenceFlow id="f-check_stock-stock_ok" sourceRef="check_stock" targetRef="stock_ok" />
    <bpmn:sequenceFlow id="f-stock_ok-pick" name="in stock" sourceRef="stock_ok" targetRef="pick" />
    <bpmn:sequenceFlow id="f-stock_ok-backorder" name="out of stock" sourceRef="stock_ok" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-backorder-inform_delay" sourceRef="backorder" targetRef="inform_delay" />
    <bpmn:sequenceFlow id="f-inform_delay-wait_backorder" sourceRef="inform_delay" targetRef="wait_backorder" />
    <bpmn:sequenceFlow id="f-wait_backorder-pick" sourceRef="wait_backorder" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-split_parallel" sourceRef="qc" targetRef="split_parallel" />
    <bpmn:sequenceFlow id="f-split_parallel-package" sourceRef="split_parallel" targetRef="package" />
    <bpmn:sequenceFlow id="f-split_parallel-prepare_shipping" sourceRef="split_parallel" targetRef="prepare_shipping" />
    <bpmn:sequenceFlow id="f-prepare_shipping-intl" sourceRef="prepare_shipping" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-customs_doc" name="international" sourceRef="intl" targetRef="customs_doc" />
    <bpmn:sequenceFlow id="f-intl-join_parallel" name="domestic" sourceRef="intl" targetRef="join_parallel" />
    <bpmn:sequenceFlow id="f-customs_doc-join_parallel" sourceRef="customs_doc" targetRef="join_parallel" />
    <bpmn:sequenceFlow id="f-package-join_parallel" sourceRef="package" targetRef="join_parallel" />
    <bpmn:sequenceFlow id="f-join_parallel-dispatch" sourceRef="join_parallel" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-send_confirmation" sourceRef="dispatch" targetRef="send_confirmation" />
    <bpmn:sequenceFlow id="f-send_confirmation-update_inventory" sourceRef="send_confirmation" targetRef="update_inventory" />
    <bpmn:sequenceFlow id="f-update_inventory-send_feedback" sourceRef="update_inventory" targetRef="send_feedback" />
    <bpmn:sequenceFlow id="f-send_feedback-issue_report" sourceRef="send_feedback" targetRef="issue_report" />
    <bpmn:sequenceFlow id="f-issue_report-end_completed" name="no issues" sourceRef="issue_report" targetRef="end_completed" />
    <bpmn:sequenceFlow id="f-issue_report-init_return" name="issues" sourceRef="issue_report" targetRef="init_return" />
    <bpmn:sequenceFlow id="f-init_return-send_return_label" sourceRef="init_return" targetRef="send_return_label" />
    <bpmn:sequenceFlow id="f-send_return_label-receive_return" sourceRef="send_return_label" targetRef="receive_return" />
    <bpmn:sequenceFlow id="f-receive_return-inspect_return" sourceRef="receive_return" targetRef="inspect_return" />
    <bpmn:sequenceFlow id="f-inspect_return-process_refund" sourceRef="inspect_return" targetRef="process_refund" />
    <bpmn:sequenceFlow id="f-process_refund-end_returns" sourceRef="process_refund" targetRef="end_returns" />
  </bpmn:process>
</bpmn:definitions>
