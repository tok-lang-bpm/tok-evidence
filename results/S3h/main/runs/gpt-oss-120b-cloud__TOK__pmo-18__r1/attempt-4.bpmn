<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="University enrollment process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University enrollment process" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="prospective_student" name="Prospective Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_enroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin_classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>graduate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_graduate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_withdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_office" name="Admissions Office">
        <bpmn:flowNodeRef>review_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_app</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_committee" name="Admissions Committee">
        <bpmn:flowNodeRef>eval_app</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>process_fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it_department" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="international_office" name="International Student Office">
        <bpmn:flowNodeRef>assist_visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals_committee" name="Appeals Committee">
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="process" name="Process">
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>course_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next_step</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loop_continue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start enrollment process" />
    <bpmn:task id="submit_app" name="Submit application online" />
    <bpmn:task id="provide_missing" name="Provide missing documents" />
    <bpmn:task id="confirm_enroll" name="Confirm enrollment by deadline" />
    <bpmn:task id="receive_orientation" name="Receive orientation materials" />
    <bpmn:task id="obtain_id" name="Obtain student ID card" />
    <bpmn:task id="meet_advisor" name="Meet with academic advisor" />
    <bpmn:task id="select_courses" name="Select courses" />
    <bpmn:task id="resolve_conflicts" name="Resolve any schedule conflicts" />
    <bpmn:task id="begin_classes" name="Begin attending classes" />
    <bpmn:task id="add_drop" name="Add or drop courses within the add/drop period" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:task id="submit_appeal" name="Submit appeal form" />
    <bpmn:task id="await_decision" name="Await decision on appeal" />
    <bpmn:task id="graduate" name="Graduate" />
    <bpmn:task id="withdraw" name="Withdraw" />
    <bpmn:endEvent id="end_reject" name="Application rejected" />
    <bpmn:endEvent id="end_cancel" name="Application cancelled" />
    <bpmn:endEvent id="end_graduate" name="Graduated" />
    <bpmn:endEvent id="end_withdraw" name="Withdrawn" />
    <bpmn:task id="review_app" name="Review application and supporting documents" />
    <bpmn:task id="notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="send_accept" name="Send acceptance letter" />
    <bpmn:task id="send_reject" name="Send rejection letter" />
    <bpmn:task id="cancel_app" name="Cancel application" />
    <bpmn:task id="eval_app" name="Evaluate application by admissions committee" />
    <bpmn:task id="process_fees" name="Process application fees or waivers" />
    <bpmn:task id="setup_accounts" name="Set up student accounts for email, online portals, and library access" />
    <bpmn:task id="assist_visa" name="Assist with visa processing" />
    <bpmn:task id="meet_appeals" name="Meet with appeals committee" />
    <bpmn:exclusiveGateway id="missing" name="Are all documents present?" />
    <bpmn:parallelGateway id="parallel" name="Parallel evaluation and fee processing" />
    <bpmn:parallelGateway id="join_eval" name="Join evaluation and fee processing" />
    <bpmn:exclusiveGateway id="accept" name="Is the application accepted?" />
    <bpmn:exclusiveGateway id="confirm" name="Is enrollment confirmed?" />
    <bpmn:parallelGateway id="join_post" name="Join orientation and account setup" />
    <bpmn:exclusiveGateway id="international" name="Is the student international?" />
    <bpmn:exclusiveGateway id="course_change" name="Add or drop courses?" />
    <bpmn:exclusiveGateway id="grievance" name="File an appeal?" />
    <bpmn:exclusiveGateway id="next_step" name="Next step?" />
    <bpmn:parallelGateway id="loop_continue" name="Loop back to next semester" />
    <bpmn:sequenceFlow id="f-start-submit_app" sourceRef="start" targetRef="submit_app" />
    <bpmn:sequenceFlow id="f-submit_app-review_app" sourceRef="submit_app" targetRef="review_app" />
    <bpmn:sequenceFlow id="f-review_app-missing" sourceRef="review_app" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-parallel" name="yes" sourceRef="missing" targetRef="parallel" />
    <bpmn:sequenceFlow id="f-missing-notify_missing" name="no" sourceRef="missing" targetRef="notify_missing" />
    <bpmn:sequenceFlow id="f-notify_missing-provide_missing" sourceRef="notify_missing" targetRef="provide_missing" />
    <bpmn:sequenceFlow id="f-provide_missing-review_app" sourceRef="provide_missing" targetRef="review_app" />
    <bpmn:sequenceFlow id="f-parallel-eval_app" sourceRef="parallel" targetRef="eval_app" />
    <bpmn:sequenceFlow id="f-parallel-process_fees" sourceRef="parallel" targetRef="process_fees" />
    <bpmn:sequenceFlow id="f-eval_app-join_eval" sourceRef="eval_app" targetRef="join_eval" />
    <bpmn:sequenceFlow id="f-process_fees-join_eval" sourceRef="process_fees" targetRef="join_eval" />
    <bpmn:sequenceFlow id="f-join_eval-accept" sourceRef="join_eval" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-send_accept" name="yes" sourceRef="accept" targetRef="send_accept" />
    <bpmn:sequenceFlow id="f-accept-send_reject" name="no" sourceRef="accept" targetRef="send_reject" />
    <bpmn:sequenceFlow id="f-send_reject-end_reject" sourceRef="send_reject" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-send_accept-confirm" sourceRef="send_accept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirm_enroll" name="yes" sourceRef="confirm" targetRef="confirm_enroll" />
    <bpmn:sequenceFlow id="f-confirm-cancel_app" name="no" sourceRef="confirm" targetRef="cancel_app" />
    <bpmn:sequenceFlow id="f-cancel_app-end_cancel" sourceRef="cancel_app" targetRef="end_cancel" />
    <bpmn:sequenceFlow id="f-confirm_enroll-join_post" sourceRef="confirm_enroll" targetRef="join_post" />
    <bpmn:sequenceFlow id="f-join_post-receive_orientation" sourceRef="join_post" targetRef="receive_orientation" />
    <bpmn:sequenceFlow id="f-join_post-setup_accounts" sourceRef="join_post" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f-receive_orientation-international" sourceRef="receive_orientation" targetRef="international" />
    <bpmn:sequenceFlow id="f-setup_accounts-international" sourceRef="setup_accounts" targetRef="international" />
    <bpmn:sequenceFlow id="f-international-assist_visa" name="yes" sourceRef="international" targetRef="assist_visa" />
    <bpmn:sequenceFlow id="f-international-obtain_id" name="no" sourceRef="international" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-assist_visa-obtain_id" sourceRef="assist_visa" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-obtain_id-meet_advisor" sourceRef="obtain_id" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f-meet_advisor-select_courses" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f-select_courses-resolve_conflicts" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f-resolve_conflicts-begin_classes" sourceRef="resolve_conflicts" targetRef="begin_classes" />
    <bpmn:sequenceFlow id="f-begin_classes-course_change" sourceRef="begin_classes" targetRef="course_change" />
    <bpmn:sequenceFlow id="f-course_change-add_drop" name="yes" sourceRef="course_change" targetRef="add_drop" />
    <bpmn:sequenceFlow id="f-course_change-post_grades" name="no" sourceRef="course_change" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-add_drop-post_grades" sourceRef="add_drop" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-post_grades-review_grades" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-review_grades-grievance" sourceRef="review_grades" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-submit_appeal" name="yes" sourceRef="grievance" targetRef="submit_appeal" />
    <bpmn:sequenceFlow id="f-grievance-next_step" name="no" sourceRef="grievance" targetRef="next_step" />
    <bpmn:sequenceFlow id="f-submit_appeal-meet_appeals" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f-meet_appeals-await_decision" sourceRef="meet_appeals" targetRef="await_decision" />
    <bpmn:sequenceFlow id="f-await_decision-review_grades" sourceRef="await_decision" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-next_step-loop_continue" name="continue" sourceRef="next_step" targetRef="loop_continue" />
    <bpmn:sequenceFlow id="f-next_step-graduate" name="graduate" sourceRef="next_step" targetRef="graduate" />
    <bpmn:sequenceFlow id="f-next_step-withdraw" name="withdraw" sourceRef="next_step" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-loop_continue-begin_classes" sourceRef="loop_continue" targetRef="begin_classes" />
    <bpmn:sequenceFlow id="f-graduate-end_graduate" sourceRef="graduate" targetRef="end_graduate" />
    <bpmn:sequenceFlow id="f-withdraw-end_withdraw" sourceRef="withdraw" targetRef="end_withdraw" />
  </bpmn:process>
</bpmn:definitions>
