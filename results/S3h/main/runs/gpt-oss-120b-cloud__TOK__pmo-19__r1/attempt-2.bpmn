<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="online_shop" name="Online Shop" processRef="online_shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="online_shop-process" name="Online shop purchase process" isExecutable="false">
    <bpmn:laneSet id="online_shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop" name="Shop">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start order" />
    <bpmn:task id="login" name="log in to account" />
    <bpmn:parallelGateway id="split1" name="Select and set payment" />
    <bpmn:task id="select" name="select items to purchase" />
    <bpmn:task id="set_payment" name="set payment method" />
    <bpmn:parallelGateway id="join1" name="After selection and payment method" />
    <bpmn:parallelGateway id="split2" name="Payment and reward parallel" />
    <bpmn:exclusiveGateway id="pay_dec" name="Payment decision?" />
    <bpmn:task id="pay" name="pay" />
    <bpmn:task id="installment" name="complete installment agreement" />
    <bpmn:task id="reward" name="choose reward option" />
    <bpmn:parallelGateway id="join2" name="After payment and reward" />
    <bpmn:exclusiveGateway id="return_dec" name="Return items?" />
    <bpmn:task id="return" name="return items for exchange" />
    <bpmn:endEvent id="done" name="order completed" />
    <bpmn:task id="deliver" name="deliver items" />
    <bpmn:sequenceFlow id="f-start-login" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split1" sourceRef="login" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-select" sourceRef="split1" targetRef="select" />
    <bpmn:sequenceFlow id="f-split1-set_payment" sourceRef="split1" targetRef="set_payment" />
    <bpmn:sequenceFlow id="f-select-join1" sourceRef="select" targetRef="join1" />
    <bpmn:sequenceFlow id="f-set_payment-join1" sourceRef="set_payment" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-split2" sourceRef="join1" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-pay_dec" sourceRef="split2" targetRef="pay_dec" />
    <bpmn:sequenceFlow id="f-split2-reward" sourceRef="split2" targetRef="reward" />
    <bpmn:sequenceFlow id="f-pay_dec-pay" sourceRef="pay_dec" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay_dec-installment" sourceRef="pay_dec" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-join2" sourceRef="pay" targetRef="join2" />
    <bpmn:sequenceFlow id="f-installment-join2" sourceRef="installment" targetRef="join2" />
    <bpmn:sequenceFlow id="f-reward-join2" sourceRef="reward" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-deliver" sourceRef="join2" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-return_dec" sourceRef="deliver" targetRef="return_dec" />
    <bpmn:sequenceFlow id="f-return_dec-done" sourceRef="return_dec" targetRef="done" />
    <bpmn:sequenceFlow id="f-return_dec-return" sourceRef="return_dec" targetRef="return" />
    <bpmn:sequenceFlow id="f-return-deliver" sourceRef="return" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
