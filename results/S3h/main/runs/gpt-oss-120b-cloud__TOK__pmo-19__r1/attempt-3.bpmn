<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="online_shop" name="Online Shop" processRef="online_shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="online_shop-process" name="Online shop purchase process" isExecutable="false">
    <bpmn:laneSet id="online_shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_select_set</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_select_set</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_payment_reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_payment_reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop" name="Shop">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start order" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="split_select_set" name="Select items and set payment method" />
    <bpmn:task id="select" name="Select items to purchase" />
    <bpmn:task id="set_payment" name="Set payment method" />
    <bpmn:parallelGateway id="join_select_set" name="After selection and payment method" />
    <bpmn:parallelGateway id="split_payment_reward" name="Payment and reward parallel" />
    <bpmn:exclusiveGateway id="payment_dec" name="Payment decision?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:task id="reward" name="Choose reward option" />
    <bpmn:parallelGateway id="join_payment_reward" name="After payment and reward" />
    <bpmn:exclusiveGateway id="return_dec" name="Return items?" />
    <bpmn:task id="return" name="Return items for exchange" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:sequenceFlow id="f-start-login" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split_select_set" sourceRef="login" targetRef="split_select_set" />
    <bpmn:sequenceFlow id="f-split_select_set-select" sourceRef="split_select_set" targetRef="select" />
    <bpmn:sequenceFlow id="f-split_select_set-set_payment" sourceRef="split_select_set" targetRef="set_payment" />
    <bpmn:sequenceFlow id="f-select-join_select_set" sourceRef="select" targetRef="join_select_set" />
    <bpmn:sequenceFlow id="f-set_payment-join_select_set" sourceRef="set_payment" targetRef="join_select_set" />
    <bpmn:sequenceFlow id="f-join_select_set-split_payment_reward" sourceRef="join_select_set" targetRef="split_payment_reward" />
    <bpmn:sequenceFlow id="f-split_payment_reward-payment_dec" sourceRef="split_payment_reward" targetRef="payment_dec" />
    <bpmn:sequenceFlow id="f-split_payment_reward-reward" sourceRef="split_payment_reward" targetRef="reward" />
    <bpmn:sequenceFlow id="f-payment_dec-pay" name="pay" sourceRef="payment_dec" targetRef="pay" />
    <bpmn:sequenceFlow id="f-payment_dec-installment" name="installment" sourceRef="payment_dec" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-join_payment_reward" sourceRef="pay" targetRef="join_payment_reward" />
    <bpmn:sequenceFlow id="f-installment-join_payment_reward" sourceRef="installment" targetRef="join_payment_reward" />
    <bpmn:sequenceFlow id="f-reward-join_payment_reward" sourceRef="reward" targetRef="join_payment_reward" />
    <bpmn:sequenceFlow id="f-join_payment_reward-deliver" sourceRef="join_payment_reward" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-return_dec" sourceRef="deliver" targetRef="return_dec" />
    <bpmn:sequenceFlow id="f-return_dec-completed" name="no return" sourceRef="return_dec" targetRef="completed" />
    <bpmn:sequenceFlow id="f-return_dec-return" name="return" sourceRef="return_dec" targetRef="return" />
    <bpmn:sequenceFlow id="f-return-deliver" sourceRef="return" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
