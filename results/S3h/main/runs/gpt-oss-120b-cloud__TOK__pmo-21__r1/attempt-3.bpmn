<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Shipping Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Shipping Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_small</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_small</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics_head" name="Logistics Department Head">
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start shipping process" />
    <bpmn:exclusiveGateway id="ship_decision" name="Ship goods?" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="amount_decision" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite logistic companies" />
    <bpmn:task id="select" name="Select logistic company" />
    <bpmn:parallelGateway id="split_large" name="Parallel large‑amount activities" />
    <bpmn:parallelGateway id="join_large" name="Join large‑amount activities" />
    <bpmn:parallelGateway id="split_small" name="Parallel small‑amount activities" />
    <bpmn:parallelGateway id="join_small" name="Join small‑amount activities" />
    <bpmn:task id="label" name="Write package label" />
    <bpmn:task id="prepare" name="Prepare goods for pickup" />
    <bpmn:endEvent id="done" name="Shipping completed" />
    <bpmn:endEvent id="not_shipped" name="No shipping required" />
    <bpmn:task id="insurance" name="Take parcel insurance" />
    <bpmn:task id="package" name="Package goods" />
    <bpmn:sequenceFlow id="f-start-ship_decision" sourceRef="start" targetRef="ship_decision" />
    <bpmn:sequenceFlow id="f-ship_decision-clarify" name="yes" sourceRef="ship_decision" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-ship_decision-not_shipped" name="no" sourceRef="ship_decision" targetRef="not_shipped" />
    <bpmn:sequenceFlow id="f-clarify-amount_decision" sourceRef="clarify" targetRef="amount_decision" />
    <bpmn:sequenceFlow id="f-amount_decision-invite" name="yes" sourceRef="amount_decision" targetRef="invite" />
    <bpmn:sequenceFlow id="f-amount_decision-split_small" name="no" sourceRef="amount_decision" targetRef="split_small" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-split_large" sourceRef="select" targetRef="split_large" />
    <bpmn:sequenceFlow id="f-split_large-label" sourceRef="split_large" targetRef="label" />
    <bpmn:sequenceFlow id="f-split_large-insurance" sourceRef="split_large" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-split_large-package" sourceRef="split_large" targetRef="package" />
    <bpmn:sequenceFlow id="f-label-join_large" sourceRef="label" targetRef="join_large" />
    <bpmn:sequenceFlow id="f-insurance-join_large" sourceRef="insurance" targetRef="join_large" />
    <bpmn:sequenceFlow id="f-package-join_large" sourceRef="package" targetRef="join_large" />
    <bpmn:sequenceFlow id="f-split_small-label" sourceRef="split_small" targetRef="label" />
    <bpmn:sequenceFlow id="f-split_small-package" sourceRef="split_small" targetRef="package" />
    <bpmn:sequenceFlow id="f-label-join_small" sourceRef="label" targetRef="join_small" />
    <bpmn:sequenceFlow id="f-package-join_small" sourceRef="package" targetRef="join_small" />
    <bpmn:sequenceFlow id="f-join_large-prepare" sourceRef="join_large" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-join_small-prepare" sourceRef="join_small" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-done" sourceRef="prepare" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
