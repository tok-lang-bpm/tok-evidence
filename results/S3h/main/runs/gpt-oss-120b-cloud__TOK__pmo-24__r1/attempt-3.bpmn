<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Restaurant dining process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant dining process" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gReact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Guest enters restaurant" />
    <bpmn:task id="t1" name="Choose a dish" />
    <bpmn:task id="t2" name="Wait for turn" />
    <bpmn:task id="t3" name="Place order with employee" />
    <bpmn:exclusiveGateway id="gReact" name="Guest reacts to buzzer?" />
    <bpmn:task id="t8" name="Pick up meal" />
    <bpmn:task id="t9" name="Eat meal" />
    <bpmn:endEvent id="e1" name="Dining completed" />
    <bpmn:task id="t4" name="Enter order into POS system" />
    <bpmn:task id="t5" name="Collect payment" />
    <bpmn:task id="t6" name="Set up buzzer and give to guest" />
    <bpmn:task id="t7" name="Inform chef of order" />
    <bpmn:task id="t10" name="Activate buzzer" />
    <bpmn:task id="t11" name="Call guest" />
    <bpmn:task id="t12" name="Hand over meal" />
    <bpmn:task id="t13" name="Prepare meal" />
    <bpmn:task id="t14" name="Place meal in service hatch" />
    <bpmn:task id="t15" name="Inform employee meal ready" />
    <bpmn:sequenceFlow id="f-s1-t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t13" sourceRef="t7" targetRef="t13" />
    <bpmn:sequenceFlow id="f-t13-t14" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t14-t15" sourceRef="t14" targetRef="t15" />
    <bpmn:sequenceFlow id="f-t15-t10" sourceRef="t15" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-gReact" sourceRef="t10" targetRef="gReact" />
    <bpmn:sequenceFlow id="f-gReact-t12" name="yes" sourceRef="gReact" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-t8" sourceRef="t12" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-e1" sourceRef="t9" targetRef="e1" />
    <bpmn:sequenceFlow id="f-gReact-t11" name="no" sourceRef="gReact" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-gReact" sourceRef="t11" targetRef="gReact" />
  </bpmn:process>
</bpmn:definitions>
