<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PERM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start job search" />
    <bpmn:task id="R" name="Report job applications" />
    <bpmn:task id="O" name="Send job offers" />
    <bpmn:task id="N" name="Negotiate job interview" />
    <bpmn:task id="P" name="Enter probation phase" />
    <bpmn:task id="RC" name="Rate company" />
    <bpmn:task id="RA" name="Rate applicant" />
    <bpmn:task id="VR" name="View company reviews" />
    <bpmn:endEvent id="END" name="Process ends" />
    <bpmn:task id="C" name="Confirm receipt and rate application" />
    <bpmn:exclusiveGateway id="H" name="Company wants to hire?" />
    <bpmn:parallelGateway id="G1" name="After probation start" />
    <bpmn:parallelGateway id="G2" name="After rating join" />
    <bpmn:exclusiveGateway id="PERM" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="LR" name="Low rating?" />
    <bpmn:intermediateCatchEvent id="W" name="Wait 1 year">
      <bpmn:timerEventDefinition id="W-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f-S-R" sourceRef="S" targetRef="R" />
    <bpmn:sequenceFlow id="f-R-O" sourceRef="R" targetRef="O" />
    <bpmn:sequenceFlow id="f-O-C" sourceRef="O" targetRef="C" />
    <bpmn:sequenceFlow id="f-C-N" sourceRef="C" targetRef="N" />
    <bpmn:sequenceFlow id="f-N-H" sourceRef="N" targetRef="H" />
    <bpmn:sequenceFlow id="f-H-O" sourceRef="H" targetRef="O" />
    <bpmn:sequenceFlow id="f-H-P" sourceRef="H" targetRef="P" />
    <bpmn:sequenceFlow id="f-P-G1" sourceRef="P" targetRef="G1" />
    <bpmn:sequenceFlow id="f-G1-RC" sourceRef="G1" targetRef="RC" />
    <bpmn:sequenceFlow id="f-G1-RA" sourceRef="G1" targetRef="RA" />
    <bpmn:sequenceFlow id="f-RC-G2" sourceRef="RC" targetRef="G2" />
    <bpmn:sequenceFlow id="f-RA-G2" sourceRef="RA" targetRef="G2" />
    <bpmn:sequenceFlow id="f-G2-W" sourceRef="G2" targetRef="W" />
    <bpmn:sequenceFlow id="f-W-VR" sourceRef="W" targetRef="VR" />
    <bpmn:sequenceFlow id="f-VR-PERM" sourceRef="VR" targetRef="PERM" />
    <bpmn:sequenceFlow id="f-PERM-O" sourceRef="PERM" targetRef="O" />
    <bpmn:sequenceFlow id="f-PERM-LR" sourceRef="PERM" targetRef="LR" />
    <bpmn:sequenceFlow id="f-LR-O" sourceRef="LR" targetRef="O" />
    <bpmn:sequenceFlow id="f-LR-END" sourceRef="LR" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
