<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_comp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>col</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="socialsecurity" name="Social Security" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="sel" name="Let parent select" />
    <bpmn:exclusiveGateway id="ext" name="Extension decision?" />
    <bpmn:endEvent id="e_ext" name="Leave extended" />
    <bpmn:endEvent id="e_comp" name="Leave completed" />
    <bpmn:task id="f" name="Fetch information about potential models" />
    <bpmn:task id="col" name="Collect relevant information" />
    <bpmn:task id="n" name="Notify Social Security, Company in time" />
    <bpmn:task id="g" name="Gather information from companies" />
    <bpmn:sequenceFlow id="f-s-f" sourceRef="s" targetRef="f" />
    <bpmn:sequenceFlow id="f-f-sel" sourceRef="f" targetRef="sel" />
    <bpmn:sequenceFlow id="f-sel-col" sourceRef="sel" targetRef="col" />
    <bpmn:sequenceFlow id="f-col-n" sourceRef="col" targetRef="n" />
    <bpmn:sequenceFlow id="f-n-g" sourceRef="n" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-ext" sourceRef="g" targetRef="ext" />
    <bpmn:sequenceFlow id="f-ext-e_ext" name="yes" sourceRef="ext" targetRef="e_ext" />
    <bpmn:sequenceFlow id="f-ext-e_comp" name="no" sourceRef="ext" targetRef="e_comp" />
  </bpmn:process>
</bpmn:definitions>
