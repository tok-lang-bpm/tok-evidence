tok 1.0 "Becoming A Parent"

pool organization "Organization"
  lane parent "Parent"
    start s "Start"
    task sel "Let parent select"
    xor ext "Extension decision?"
    end e_ext "Leave extended"
    end e_comp "Leave completed"
  lane hr "HR"
    task f "Fetch information about potential models"
    task col "Collect relevant information"
    task n "Notify Social Security, Company in time"
  lane company "Company"
    task g "Gather information from companies"
  lane socialsecurity "Social Security"

flow s -> f
flow f -> sel
flow sel -> col
flow col -> n
flow n -> g
flow g -> ext
flow ext -> e_ext "yes"
flow ext -> e_comp "no"
