<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="employee" name="Employee / Employer">
        <bpmn:flowNodeRef>acc_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reporter_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_emp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self_emp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fatal_serious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_inspector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>long_term</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_emp_reports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>emp_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="school" name="School / Educational Institution">
        <bpmn:flowNodeRef>report_directorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>school_report_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>school_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="private" name="Private Insured Party">
        <bpmn:flowNodeRef>report_private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>private_fatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_private_fatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>private_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="acc_start" name="Accident occurs" />
    <bpmn:task id="gather" name="Gather accident information" />
    <bpmn:exclusiveGateway id="reporter_type" name="Reporter type?" />
    <bpmn:task id="inform_emp" name="Inform employer immediately" />
    <bpmn:exclusiveGateway id="self_emp" name="Self‑employed?" />
    <bpmn:task id="report_self" name="Report to Accident Insurance Provider (self‑employed) within 5 days" />
    <bpmn:exclusiveGateway id="fatal_serious" name="Fatality or serious injury?" />
    <bpmn:task id="report_inspector" name="Report to Labour Inspectorate" />
    <bpmn:exclusiveGateway id="long_term" name="Injury &gt;3 days or death?" />
    <bpmn:task id="report_insurance" name="Report to Accident Insurance Provider within 5 days" />
    <bpmn:parallelGateway id="join_emp_reports" />
    <bpmn:endEvent id="emp_end" name="Process completed" />
    <bpmn:task id="report_directorate" name="Report to competent directorate" />
    <bpmn:task id="school_report_ins" name="School reports to Accident Insurance Provider (triplicate, within 5 days)" />
    <bpmn:endEvent id="school_end" name="Process completed" />
    <bpmn:task id="report_private" name="Report in writing to private insurer immediately" />
    <bpmn:exclusiveGateway id="private_fatal" name="Fatalities?" />
    <bpmn:task id="report_private_fatal" name="Report fatalities within 3 days" />
    <bpmn:endEvent id="private_end" name="Process completed" />
    <bpmn:sequenceFlow id="f-acc_start-gather" sourceRef="acc_start" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-reporter_type" sourceRef="gather" targetRef="reporter_type" />
    <bpmn:sequenceFlow id="f-reporter_type-inform_emp" name="Employee" sourceRef="reporter_type" targetRef="inform_emp" />
    <bpmn:sequenceFlow id="f-reporter_type-report_directorate" name="School" sourceRef="reporter_type" targetRef="report_directorate" />
    <bpmn:sequenceFlow id="f-reporter_type-report_private" name="Private" sourceRef="reporter_type" targetRef="report_private" />
    <bpmn:sequenceFlow id="f-inform_emp-self_emp" sourceRef="inform_emp" targetRef="self_emp" />
    <bpmn:sequenceFlow id="f-self_emp-report_self" name="Yes" sourceRef="self_emp" targetRef="report_self" />
    <bpmn:sequenceFlow id="f-self_emp-fatal_serious" name="No" sourceRef="self_emp" targetRef="fatal_serious" />
    <bpmn:sequenceFlow id="f-report_self-join_emp_reports" sourceRef="report_self" targetRef="join_emp_reports" />
    <bpmn:sequenceFlow id="f-fatal_serious-report_inspector" name="Yes" sourceRef="fatal_serious" targetRef="report_inspector" />
    <bpmn:sequenceFlow id="f-fatal_serious-long_term" name="No" sourceRef="fatal_serious" targetRef="long_term" />
    <bpmn:sequenceFlow id="f-report_inspector-join_emp_reports" sourceRef="report_inspector" targetRef="join_emp_reports" />
    <bpmn:sequenceFlow id="f-long_term-report_insurance" name="Yes" sourceRef="long_term" targetRef="report_insurance" />
    <bpmn:sequenceFlow id="f-long_term-join_emp_reports" name="No" sourceRef="long_term" targetRef="join_emp_reports" />
    <bpmn:sequenceFlow id="f-report_insurance-join_emp_reports" sourceRef="report_insurance" targetRef="join_emp_reports" />
    <bpmn:sequenceFlow id="f-join_emp_reports-emp_end" sourceRef="join_emp_reports" targetRef="emp_end" />
    <bpmn:sequenceFlow id="f-report_directorate-school_report_ins" sourceRef="report_directorate" targetRef="school_report_ins" />
    <bpmn:sequenceFlow id="f-school_report_ins-school_end" sourceRef="school_report_ins" targetRef="school_end" />
    <bpmn:sequenceFlow id="f-report_private-private_fatal" sourceRef="report_private" targetRef="private_fatal" />
    <bpmn:sequenceFlow id="f-private_fatal-report_private_fatal" name="Yes" sourceRef="private_fatal" targetRef="report_private_fatal" />
    <bpmn:sequenceFlow id="f-private_fatal-private_end" name="No" sourceRef="private_fatal" targetRef="private_end" />
    <bpmn:sequenceFlow id="f-report_private_fatal-private_end" sourceRef="report_private_fatal" targetRef="private_end" />
  </bpmn:process>
</bpmn:definitions>
