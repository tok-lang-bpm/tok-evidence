<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="intern" name="Intern">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweets_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweets_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>cu</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start internship" />
    <bpmn:task id="e1" name="Enter topic and desired money" />
    <bpmn:task id="e2" name="Enter experience and hobbies" />
    <bpmn:task id="recv" name="Receive offer" />
    <bpmn:exclusiveGateway id="decide" name="Offer decision?" />
    <bpmn:task id="accept" name="Accept offer" />
    <bpmn:task id="deny" name="Deny offer" />
    <bpmn:parallelGateway id="updates_split" />
    <bpmn:task id="iu" name="Write intern status update">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">intern_updates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="updates_join" />
    <bpmn:task id="rec" name="Recommend company via Twitter" />
    <bpmn:parallelGateway id="tweets_split" />
    <bpmn:task id="tweet1" name="Send tweet to friend 1" />
    <bpmn:task id="tweet2" name="Send tweet to friend 2" />
    <bpmn:task id="tweet3" name="Send tweet to friend 3" />
    <bpmn:parallelGateway id="tweets_join" />
    <bpmn:endEvent id="end" name="Internship completed" />
    <bpmn:task id="cu" name="Write company status update">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">company_updates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:sequenceFlow id="f-start-e1" sourceRef="start" targetRef="e1" />
    <bpmn:sequenceFlow id="f-e1-e2" sourceRef="e1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-e2-recv" sourceRef="e2" targetRef="recv" />
    <bpmn:sequenceFlow id="f-recv-decide" sourceRef="recv" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-accept" name="accept" sourceRef="decide" targetRef="accept" />
    <bpmn:sequenceFlow id="f-decide-deny" name="deny" sourceRef="decide" targetRef="deny" />
    <bpmn:sequenceFlow id="f-accept-updates_split" sourceRef="accept" targetRef="updates_split" />
    <bpmn:sequenceFlow id="f-deny-recv" sourceRef="deny" targetRef="recv" />
    <bpmn:sequenceFlow id="f-updates_split-iu" sourceRef="updates_split" targetRef="iu" />
    <bpmn:sequenceFlow id="f-updates_split-cu" sourceRef="updates_split" targetRef="cu" />
    <bpmn:sequenceFlow id="f-iu-updates_join" sourceRef="iu" targetRef="updates_join" />
    <bpmn:sequenceFlow id="f-cu-updates_join" sourceRef="cu" targetRef="updates_join" />
    <bpmn:sequenceFlow id="f-updates_join-rec" sourceRef="updates_join" targetRef="rec" />
    <bpmn:sequenceFlow id="f-rec-tweets_split" sourceRef="rec" targetRef="tweets_split" />
    <bpmn:sequenceFlow id="f-tweets_split-tweet1" sourceRef="tweets_split" targetRef="tweet1" />
    <bpmn:sequenceFlow id="f-tweets_split-tweet2" sourceRef="tweets_split" targetRef="tweet2" />
    <bpmn:sequenceFlow id="f-tweets_split-tweet3" sourceRef="tweets_split" targetRef="tweet3" />
    <bpmn:sequenceFlow id="f-tweet1-tweets_join" sourceRef="tweet1" targetRef="tweets_join" />
    <bpmn:sequenceFlow id="f-tweet2-tweets_join" sourceRef="tweet2" targetRef="tweets_join" />
    <bpmn:sequenceFlow id="f-tweet3-tweets_join" sourceRef="tweet3" targetRef="tweets_join" />
    <bpmn:sequenceFlow id="f-tweets_join-end" sourceRef="tweets_join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
