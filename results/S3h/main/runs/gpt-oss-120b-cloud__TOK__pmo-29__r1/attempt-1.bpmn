<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representation" name="Representation Office" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Start" />
    <bpmn:task id="t1" name="Check requirements for working and living in Austria" />
    <bpmn:parallelGateway id="g1" />
    <bpmn:task id="t2" name="Organize accommodation and bank account (negotiation)" />
    <bpmn:task id="t3" name="Prepare visa documents" />
    <bpmn:parallelGateway id="g2" />
    <bpmn:task id="t4" name="Contact representation in advance for more information" />
    <bpmn:task id="t5" name="Submit visa application" />
    <bpmn:task id="t6" name="Review visa application" />
    <bpmn:exclusiveGateway id="g3" name="Application complete?" />
    <bpmn:task id="t7" name="Provide additional documents" />
    <bpmn:task id="t8" name="Receive Rot-Weiss-Rot Card" />
    <bpmn:endEvent id="e0" name="Process finished" />
    <bpmn:sequenceFlow id="f-s0-t1" sourceRef="s0" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t2" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-g1-t3" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t2-g2" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t3-g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t4" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-g3" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t8" name="yes" sourceRef="g3" targetRef="t8" />
    <bpmn:sequenceFlow id="f-g3-t7" name="no" sourceRef="g3" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t5" sourceRef="t7" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t8-e0" sourceRef="t8" targetRef="e0" />
  </bpmn:process>
</bpmn:definitions>
