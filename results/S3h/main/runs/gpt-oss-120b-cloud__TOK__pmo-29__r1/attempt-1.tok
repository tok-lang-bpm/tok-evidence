tok 1.0 "Work and Live in Austria"

pool org "Organization"
  lane applicant "Applicant"
    start s0 "Start"
    task t1 "Check requirements for working and living in Austria"
    and g1
    task t2 "Organize accommodation and bank account (negotiation)"
    task t3 "Prepare visa documents"
    and g2
    task t4 "Contact representation in advance for more information"
    task t5 "Submit visa application"
    task t6 "Review visa application"               # representation activity shown in applicant lane for simplicity
    xor g3 "Application complete?"
    task t7 "Provide additional documents"
    task t8 "Receive Rot-Weiss-Rot Card"
    end e0 "Process finished"

  lane representation "Representation Office"
    # (no additional nodes needed; review done in t6)

flow s0 -> t1 -> g1
flow g1 -> t2
flow g1 -> t3
flow t2 -> g2
flow t3 -> g2
flow g2 -> t4 -> t5 -> t6 -> g3
flow g3 -> t8 "yes"
flow g3 -> t7 "no"
flow t7 -> t5
flow t8 -> e0
