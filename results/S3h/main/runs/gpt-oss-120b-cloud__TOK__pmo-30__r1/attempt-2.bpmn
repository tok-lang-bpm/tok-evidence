<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN Party Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="organizer" name="Organizer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>date_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer_enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start planning" />
    <bpmn:task id="send_inv" name="Send invitations to 10 friends" />
    <bpmn:task id="find_games" name="Find out which games friends want to play" />
    <bpmn:task id="appoint_date" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="agreement" name="8 or more people agree on date?" />
    <bpmn:task id="date_confirm" name="Date confirmed" />
    <bpmn:parallelGateway id="split" name="Parallel split" />
    <bpmn:task id="check_games" name="Check if you have all the games" />
    <bpmn:exclusiveGateway id="games_available" name="All required games are available?" />
    <bpmn:task id="download_games" name="Download missing games" />
    <bpmn:task id="find_beer" name="Find out how much beer friends will require" />
    <bpmn:exclusiveGateway id="beer_enough" name="Enough beer available?" />
    <bpmn:task id="buy_beer" name="Buy missing beer" />
    <bpmn:parallelGateway id="join" name="Parallel join" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="end" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f-start-send_inv" sourceRef="start" targetRef="send_inv" />
    <bpmn:sequenceFlow id="f-send_inv-find_games" sourceRef="send_inv" targetRef="find_games" />
    <bpmn:sequenceFlow id="f-find_games-appoint_date" sourceRef="find_games" targetRef="appoint_date" />
    <bpmn:sequenceFlow id="f-appoint_date-agreement" sourceRef="appoint_date" targetRef="agreement" />
    <bpmn:sequenceFlow id="f-agreement-date_confirm" name="yes" sourceRef="agreement" targetRef="date_confirm" />
    <bpmn:sequenceFlow id="f-agreement-appoint_date" name="no" sourceRef="agreement" targetRef="appoint_date" />
    <bpmn:sequenceFlow id="f-date_confirm-split" sourceRef="date_confirm" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-check_games" sourceRef="split" targetRef="check_games" />
    <bpmn:sequenceFlow id="f-split-find_beer" sourceRef="split" targetRef="find_beer" />
    <bpmn:sequenceFlow id="f-check_games-games_available" sourceRef="check_games" targetRef="games_available" />
    <bpmn:sequenceFlow id="f-games_available-join" name="yes" sourceRef="games_available" targetRef="join" />
    <bpmn:sequenceFlow id="f-games_available-download_games" name="no" sourceRef="games_available" targetRef="download_games" />
    <bpmn:sequenceFlow id="f-download_games-join" sourceRef="download_games" targetRef="join" />
    <bpmn:sequenceFlow id="f-find_beer-beer_enough" sourceRef="find_beer" targetRef="beer_enough" />
    <bpmn:sequenceFlow id="f-beer_enough-join" name="yes" sourceRef="beer_enough" targetRef="join" />
    <bpmn:sequenceFlow id="f-beer_enough-buy_beer" name="no" sourceRef="beer_enough" targetRef="buy_beer" />
    <bpmn:sequenceFlow id="f-buy_beer-join" sourceRef="buy_beer" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-enjoy" sourceRef="join" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-end" sourceRef="enjoy" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
