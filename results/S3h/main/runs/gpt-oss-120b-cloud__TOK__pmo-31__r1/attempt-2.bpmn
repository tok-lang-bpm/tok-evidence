<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizz" name="Blizzard" processRef="blizz-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizz-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizz-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_enter_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_click_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_select_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_enter_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_enter_bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_log_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_select_rc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_send_expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_have_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_have_subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_payment_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_name_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>C_check_battle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_check_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_send_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_have_account_sys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_have_subscription_sys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_payment_method_sys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_name_available_sys</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start character generation" />
    <bpmn:task id="N_names" name="Come up with good character names" />
    <bpmn:task id="A_enter_account" name="Enter account information" />
    <bpmn:task id="A_click_link" name="Click confirmation link" />
    <bpmn:task id="P_select_payment" name="Select payment method" />
    <bpmn:task id="P_enter_cc" name="Enter credit card information" />
    <bpmn:task id="P_enter_bank" name="Enter IBAN and BIC numbers" />
    <bpmn:task id="G_log_in" name="Log into the game" />
    <bpmn:task id="G_select_rc" name="Select realm, race and class" />
    <bpmn:task id="N_enter_name" name="Enter character name" />
    <bpmn:task id="S_send_expansion" name="Send expansion message" />
    <bpmn:parallelGateway id="G_parallel_split" />
    <bpmn:parallelGateway id="G_parallel_join" />
    <bpmn:exclusiveGateway id="G_have_account" name="Battle.net account?" />
    <bpmn:exclusiveGateway id="G_have_subscription" name="Active WoW subscription?" />
    <bpmn:exclusiveGateway id="G_payment_method" name="Payment method?" />
    <bpmn:exclusiveGateway id="G_name_available" name="Name available?" />
    <bpmn:endEvent id="E" name="Character creation completed" />
    <bpmn:task id="C_check_battle" name="Check battle.net account" />
    <bpmn:task id="C_check_sub" name="Check WoW subscription" />
    <bpmn:task id="C_send_confirm" name="Send confirmation and selfies" />
    <bpmn:exclusiveGateway id="G_have_account_sys" name="Battle.net account?" />
    <bpmn:exclusiveGateway id="G_have_subscription_sys" name="Active WoW subscription?" />
    <bpmn:exclusiveGateway id="G_payment_method_sys" name="Payment method?" />
    <bpmn:exclusiveGateway id="G_name_available_sys" name="Name available?" />
    <bpmn:sequenceFlow id="f-S-G_parallel_split" sourceRef="S" targetRef="G_parallel_split" />
    <bpmn:sequenceFlow id="f-G_parallel_split-C_check_battle" sourceRef="G_parallel_split" targetRef="C_check_battle" />
    <bpmn:sequenceFlow id="f-G_parallel_split-N_names" sourceRef="G_parallel_split" targetRef="N_names" />
    <bpmn:sequenceFlow id="f-C_check_battle-G_have_account" sourceRef="C_check_battle" targetRef="G_have_account" />
    <bpmn:sequenceFlow id="f-G_have_account-C_check_sub" name="yes" sourceRef="G_have_account" targetRef="C_check_sub" />
    <bpmn:sequenceFlow id="f-G_have_account-A_enter_account" name="no" sourceRef="G_have_account" targetRef="A_enter_account" />
    <bpmn:sequenceFlow id="f-A_enter_account-A_click_link" sourceRef="A_enter_account" targetRef="A_click_link" />
    <bpmn:sequenceFlow id="f-A_click_link-C_check_sub" sourceRef="A_click_link" targetRef="C_check_sub" />
    <bpmn:sequenceFlow id="f-C_check_sub-G_have_subscription" sourceRef="C_check_sub" targetRef="G_have_subscription" />
    <bpmn:sequenceFlow id="f-G_have_subscription-G_log_in" name="yes" sourceRef="G_have_subscription" targetRef="G_log_in" />
    <bpmn:sequenceFlow id="f-G_have_subscription-P_select_payment" name="no" sourceRef="G_have_subscription" targetRef="P_select_payment" />
    <bpmn:sequenceFlow id="f-P_select_payment-G_payment_method" sourceRef="P_select_payment" targetRef="G_payment_method" />
    <bpmn:sequenceFlow id="f-G_payment_method-P_enter_cc" name="credit card" sourceRef="G_payment_method" targetRef="P_enter_cc" />
    <bpmn:sequenceFlow id="f-G_payment_method-P_enter_bank" name="bank account" sourceRef="G_payment_method" targetRef="P_enter_bank" />
    <bpmn:sequenceFlow id="f-P_enter_cc-G_log_in" sourceRef="P_enter_cc" targetRef="G_log_in" />
    <bpmn:sequenceFlow id="f-P_enter_bank-G_log_in" sourceRef="P_enter_bank" targetRef="G_log_in" />
    <bpmn:sequenceFlow id="f-G_log_in-G_select_rc" sourceRef="G_log_in" targetRef="G_select_rc" />
    <bpmn:sequenceFlow id="f-G_select_rc-G_parallel_join" sourceRef="G_select_rc" targetRef="G_parallel_join" />
    <bpmn:sequenceFlow id="f-N_names-G_parallel_join" sourceRef="N_names" targetRef="G_parallel_join" />
    <bpmn:sequenceFlow id="f-G_parallel_join-N_enter_name" sourceRef="G_parallel_join" targetRef="N_enter_name" />
    <bpmn:sequenceFlow id="f-N_enter_name-G_name_available" sourceRef="N_enter_name" targetRef="G_name_available" />
    <bpmn:sequenceFlow id="f-G_name_available-N_enter_name" name="no" sourceRef="G_name_available" targetRef="N_enter_name" />
    <bpmn:sequenceFlow id="f-G_name_available-C_send_confirm" name="yes" sourceRef="G_name_available" targetRef="C_send_confirm" />
    <bpmn:sequenceFlow id="f-C_send_confirm-S_send_expansion" sourceRef="C_send_confirm" targetRef="S_send_expansion" />
    <bpmn:sequenceFlow id="f-S_send_expansion-E" sourceRef="S_send_expansion" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
