<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Farming Bot" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Farming Bot" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tool_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bot" name="Bot">
        <bpmn:flowNodeRef>g_farm_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_farm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_farm_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_disaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_bragsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_bragjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t_find" name="Find desired resources" />
    <bpmn:exclusiveGateway id="g_tool_needed" name="Tool needed?" />
    <bpmn:task id="t_create" name="Create required tool" />
    <bpmn:parallelGateway id="g_farm_split" name="Start farming" />
    <bpmn:task id="t_farm" name="Farm resources" />
    <bpmn:task id="t_notify" name="Notify milestones" />
    <bpmn:parallelGateway id="g_farm_join" name="Farming sync" />
    <bpmn:exclusiveGateway id="g_disaster" name="Natural disaster occurred?" />
    <bpmn:task id="t_handle" name="Handle disaster" />
    <bpmn:exclusiveGateway id="g_update" name="Update resource list?" />
    <bpmn:task id="t_update" name="Update list of farmed materials" />
    <bpmn:parallelGateway id="g_bragsplit" name="Post‑farming actions" />
    <bpmn:task id="t_brag" name="Brag to selected friends" />
    <bpmn:task id="t_send" name="Send materials to friends" />
    <bpmn:parallelGateway id="g_bragjoin" name="Post‑farming sync" />
    <bpmn:endEvent id="e_end" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-t_find" sourceRef="s" targetRef="t_find" />
    <bpmn:sequenceFlow id="f-t_find-g_tool_needed" sourceRef="t_find" targetRef="g_tool_needed" />
    <bpmn:sequenceFlow id="f-g_tool_needed-t_create" name="yes" sourceRef="g_tool_needed" targetRef="t_create" />
    <bpmn:sequenceFlow id="f-g_tool_needed-g_farm_split" name="no" sourceRef="g_tool_needed" targetRef="g_farm_split" />
    <bpmn:sequenceFlow id="f-t_create-g_farm_split" sourceRef="t_create" targetRef="g_farm_split" />
    <bpmn:sequenceFlow id="f-g_farm_split-t_farm" sourceRef="g_farm_split" targetRef="t_farm" />
    <bpmn:sequenceFlow id="f-g_farm_split-t_notify" sourceRef="g_farm_split" targetRef="t_notify" />
    <bpmn:sequenceFlow id="f-t_farm-g_farm_join" sourceRef="t_farm" targetRef="g_farm_join" />
    <bpmn:sequenceFlow id="f-t_notify-g_farm_join" sourceRef="t_notify" targetRef="g_farm_join" />
    <bpmn:sequenceFlow id="f-g_farm_join-g_disaster" sourceRef="g_farm_join" targetRef="g_disaster" />
    <bpmn:sequenceFlow id="f-g_disaster-t_handle" name="yes" sourceRef="g_disaster" targetRef="t_handle" />
    <bpmn:sequenceFlow id="f-g_disaster-g_update" name="no" sourceRef="g_disaster" targetRef="g_update" />
    <bpmn:sequenceFlow id="f-t_handle-g_farm_split" sourceRef="t_handle" targetRef="g_farm_split" />
    <bpmn:sequenceFlow id="f-g_update-t_update" name="yes" sourceRef="g_update" targetRef="t_update" />
    <bpmn:sequenceFlow id="f-g_update-g_bragsplit" name="no" sourceRef="g_update" targetRef="g_bragsplit" />
    <bpmn:sequenceFlow id="f-t_update-g_farm_split" sourceRef="t_update" targetRef="g_farm_split" />
    <bpmn:sequenceFlow id="f-g_bragsplit-t_brag" sourceRef="g_bragsplit" targetRef="t_brag" />
    <bpmn:sequenceFlow id="f-g_bragsplit-t_send" sourceRef="g_bragsplit" targetRef="t_send" />
    <bpmn:sequenceFlow id="f-t_brag-g_bragjoin" sourceRef="t_brag" targetRef="g_bragjoin" />
    <bpmn:sequenceFlow id="f-t_send-g_bragjoin" sourceRef="t_send" targetRef="g_bragjoin" />
    <bpmn:sequenceFlow id="f-g_bragjoin-e_end" sourceRef="g_bragjoin" targetRef="e_end" />
  </bpmn:process>
</bpmn:definitions>
