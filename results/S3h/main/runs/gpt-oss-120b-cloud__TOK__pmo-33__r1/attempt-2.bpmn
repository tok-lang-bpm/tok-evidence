<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Instruct an artist to create 3D model and print it" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Instruct an artist to create 3D model and print it" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lowAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Craving a custom 3D model" />
    <bpmn:task id="instruct" name="Instruct artist to create a project" />
    <bpmn:task id="send" name="Send sketches to artist" />
    <bpmn:task id="tell" name="Tell artist what to change until satisfied" />
    <bpmn:task id="choose" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="stockCheck" name="Is color in stock?" />
    <bpmn:task id="check" name="Check plastic color amount" />
    <bpmn:exclusiveGateway id="lowAmount" name="Is amount under 100 grams?" />
    <bpmn:task id="list" name="Put color on shopping plan" />
    <bpmn:task id="order" name="Order plastic color" />
    <bpmn:exclusiveGateway id="ready" name="Ready for printing" />
    <bpmn:parallelGateway id="splitPrep" name="Prepare for printing" />
    <bpmn:task id="turn" name="Turn printer on and heat up printer" />
    <bpmn:task id="gcode" name="Generate gcode file from STL" />
    <bpmn:parallelGateway id="joinPrep" name="Preparation done" />
    <bpmn:task id="print" name="Print model" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:task id="create" name="Artist creates project" />
    <bpmn:sequenceFlow id="f-start-instruct" sourceRef="start" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-send" sourceRef="instruct" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-create" sourceRef="send" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-tell" sourceRef="create" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-choose" sourceRef="tell" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-stockCheck" sourceRef="choose" targetRef="stockCheck" />
    <bpmn:sequenceFlow id="f-stockCheck-check" name="yes" sourceRef="stockCheck" targetRef="check" />
    <bpmn:sequenceFlow id="f-stockCheck-order" name="no" sourceRef="stockCheck" targetRef="order" />
    <bpmn:sequenceFlow id="f-check-lowAmount" sourceRef="check" targetRef="lowAmount" />
    <bpmn:sequenceFlow id="f-lowAmount-list" name="yes" sourceRef="lowAmount" targetRef="list" />
    <bpmn:sequenceFlow id="f-lowAmount-ready" name="no" sourceRef="lowAmount" targetRef="ready" />
    <bpmn:sequenceFlow id="f-list-ready" sourceRef="list" targetRef="ready" />
    <bpmn:sequenceFlow id="f-order-ready" sourceRef="order" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-splitPrep" sourceRef="ready" targetRef="splitPrep" />
    <bpmn:sequenceFlow id="f-splitPrep-turn" sourceRef="splitPrep" targetRef="turn" />
    <bpmn:sequenceFlow id="f-splitPrep-gcode" sourceRef="splitPrep" targetRef="gcode" />
    <bpmn:sequenceFlow id="f-turn-joinPrep" sourceRef="turn" targetRef="joinPrep" />
    <bpmn:sequenceFlow id="f-gcode-joinPrep" sourceRef="gcode" targetRef="joinPrep" />
    <bpmn:sequenceFlow id="f-joinPrep-print" sourceRef="joinPrep" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-end" sourceRef="print" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
