tok 1.0 "Instruct an artist to create 3D model and print it"

pool org "Organization"
  lane customer "Customer"
    start start "Craving a custom 3D model"
    task instruct "Instruct artist to create a project"
    task send "Send sketches to artist"
    task tell "Tell artist what to change until satisfied"
    task choose "Choose plastic color"
    xor stockCheck "Is color in stock?"
    task check "Check plastic color amount"
    xor lowAmount "Is amount under 100 grams?"
    task list "Put color on shopping plan"
    task order "Order plastic color"
    xor ready "Ready for printing"
    and splitPrep "Prepare for printing"
    task turn "Turn printer on and heat up printer"
    task gcode "Generate gcode file from STL"
    and joinPrep "Preparation done"
    task print "Print model"
    end end "Process completed"

  lane artist "Artist"
    task create "Artist creates project"

flow start -> instruct
flow instruct -> send
flow send -> create
flow create -> tell
flow tell -> choose
flow choose -> stockCheck
flow stockCheck -> check "yes"
flow stockCheck -> order "no"
flow check -> lowAmount
flow lowAmount -> list "yes"
flow lowAmount -> ready "no"
flow list -> ready
flow order -> ready
flow ready -> splitPrep
flow splitPrep -> turn
flow splitPrep -> gcode
flow turn -> joinPrep
flow gcode -> joinPrep
flow joinPrep -> print
flow print -> end
