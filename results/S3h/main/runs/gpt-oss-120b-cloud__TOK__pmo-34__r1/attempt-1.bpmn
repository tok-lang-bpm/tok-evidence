<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Lego Workshop" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start building custom machine" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order LEGO brick sets" />
    <bpmn:task id="give" name="Give LEGO sets to children" />
    <bpmn:task id="build_sub" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="parts_check" name="Parts available?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="test_result" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="assemble" name="Assemble subcomponent" />
    <bpmn:exclusiveGateway id="more_sub" name="More subcomponents?" />
    <bpmn:endEvent id="end_done" name="Machine completed" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:sequenceFlow id="f-start1-design" sourceRef="start1" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-build_sub" sourceRef="sort" targetRef="build_sub" />
    <bpmn:sequenceFlow id="f-build_sub-parts_check" sourceRef="build_sub" targetRef="parts_check" />
    <bpmn:sequenceFlow id="f-parts_check-reorder" name="no" sourceRef="parts_check" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-parts_check-test" name="yes" sourceRef="parts_check" targetRef="test" />
    <bpmn:sequenceFlow id="f-reorder-build_sub" sourceRef="reorder" targetRef="build_sub" />
    <bpmn:sequenceFlow id="f-test-test_result" sourceRef="test" targetRef="test_result" />
    <bpmn:sequenceFlow id="f-test_result-redesign" name="no" sourceRef="test_result" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-test_result-assemble" name="yes" sourceRef="test_result" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-redesign-build_sub" sourceRef="redesign" targetRef="build_sub" />
    <bpmn:sequenceFlow id="f-assemble-more_sub" sourceRef="assemble" targetRef="more_sub" />
    <bpmn:sequenceFlow id="f-more_sub-build_sub" name="yes" sourceRef="more_sub" targetRef="build_sub" />
    <bpmn:sequenceFlow id="f-more_sub-end_done" name="no" sourceRef="more_sub" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
