<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="production" name="Production">
        <bpmn:flowNodeRef>split_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_production</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_production</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>like</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_rest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer provides properties" />
    <bpmn:endEvent id="cancelled" name="Order cancelled" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:parallelGateway id="split_order" />
    <bpmn:task id="order1" name="Order parts from source 1" />
    <bpmn:task id="order2" name="Order parts from source 2" />
    <bpmn:parallelGateway id="join_order" />
    <bpmn:task id="inspect" name="Inspect parts" />
    <bpmn:task id="assemble" name="Assemble parts" />
    <bpmn:parallelGateway id="split_production" />
    <bpmn:task id="send_update" name="Send update to customer" />
    <bpmn:task id="produce_first" name="Produce first saw" />
    <bpmn:parallelGateway id="join_production" />
    <bpmn:task id="send_first" name="Send first saw to customer" />
    <bpmn:exclusiveGateway id="like" name="Customer likes the saw?" />
    <bpmn:task id="produce_rest" name="Produce rest of order" />
    <bpmn:sequenceFlow id="f-start-split_order" sourceRef="start" targetRef="split_order" />
    <bpmn:sequenceFlow id="f-split_order-order1" sourceRef="split_order" targetRef="order1" />
    <bpmn:sequenceFlow id="f-split_order-order2" sourceRef="split_order" targetRef="order2" />
    <bpmn:sequenceFlow id="f-order1-join_order" sourceRef="order1" targetRef="join_order" />
    <bpmn:sequenceFlow id="f-order2-join_order" sourceRef="order2" targetRef="join_order" />
    <bpmn:sequenceFlow id="f-join_order-inspect" sourceRef="join_order" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-assemble" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-split_production" sourceRef="assemble" targetRef="split_production" />
    <bpmn:sequenceFlow id="f-split_production-send_update" sourceRef="split_production" targetRef="send_update" />
    <bpmn:sequenceFlow id="f-split_production-produce_first" sourceRef="split_production" targetRef="produce_first" />
    <bpmn:sequenceFlow id="f-send_update-join_production" sourceRef="send_update" targetRef="join_production" />
    <bpmn:sequenceFlow id="f-produce_first-join_production" sourceRef="produce_first" targetRef="join_production" />
    <bpmn:sequenceFlow id="f-join_production-send_first" sourceRef="join_production" targetRef="send_first" />
    <bpmn:sequenceFlow id="f-send_first-like" sourceRef="send_first" targetRef="like" />
    <bpmn:sequenceFlow id="f-like-produce_rest" name="yes" sourceRef="like" targetRef="produce_rest" />
    <bpmn:sequenceFlow id="f-like-cancelled" name="no" sourceRef="like" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-produce_rest-completed" sourceRef="produce_rest" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
