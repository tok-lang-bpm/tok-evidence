tok 1.0 "Chainsaw"

pool org "Company"
  lane customer "Customer"
    start start "Customer provides properties"
    end cancelled "Order cancelled"
    end completed "Order completed"

  lane production "Production"
    and split_order
    task order1 "Order parts from source 1"
    task order2 "Order parts from source 2"
    and join_order
    task inspect "Inspect parts"
    task assemble "Assemble parts"
    and split_production
    task send_update "Send update to customer"
    task produce_first "Produce first saw"
    and join_production
    task send_first "Send first saw to customer"
    xor like "Customer likes the saw?"
    task produce_rest "Produce rest of order"

flow start -> split_order
flow split_order -> order1
flow split_order -> order2
flow order1 -> join_order
flow order2 -> join_order
flow join_order -> inspect
flow inspect -> assemble
flow assemble -> split_production
flow split_production -> send_update
flow split_production -> produce_first
flow send_update -> join_production
flow produce_first -> join_production
flow join_production -> send_first
flow send_first -> like
flow like -> produce_rest "yes"
flow like -> cancelled "no"
flow produce_rest -> completed
