<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Luxury Airplane Production" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="production" name="Production">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufacture_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>other_bars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interior_color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toilet_water</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufacture_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handle_no_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>decide_interior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_protocol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian" name="Russian Team">
        <bpmn:flowNodeRef>vodka_bar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish" name="Irish Team">
        <bpmn:flowNodeRef>whiskey_bar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assembly" name="Assembly" />
      <bpmn:lane id="test" name="Test">
        <bpmn:flowNodeRef>test_flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_protocol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start production" />
    <bpmn:task id="produce_base" name="Produce base airplane" />
    <bpmn:task id="send_requirements" name="Send requirements to teams" />
    <bpmn:parallelGateway id="manufacture_split" name="Manufacture parts split" />
    <bpmn:task id="other_bars" name="Manufacture other bars" />
    <bpmn:task id="seats" name="Manufacture seats" />
    <bpmn:task id="interior_color" name="Manufacture interior color" />
    <bpmn:task id="toilet_water" name="Manufacture toilet water system" />
    <bpmn:parallelGateway id="manufacture_join" name="Manufacture parts join" />
    <bpmn:task id="assemble" name="Assemble interior" />
    <bpmn:task id="deliver" name="Deliver plane to customer" />
    <bpmn:exclusiveGateway id="confirm" name="Customer confirmation?" />
    <bpmn:task id="receive_confirm" name="Receive customer confirmation" />
    <bpmn:task id="handle_no_confirm" name="Handle non‑confirmation" />
    <bpmn:endEvent id="completed" name="Delivery completed" />
    <bpmn:endEvent id="not_completed" name="Delivery not confirmed" />
    <bpmn:task id="decide_interior" name="Let customer decide interior specifications" />
    <bpmn:task id="receive_protocol" name="Receive test protocol" />
    <bpmn:task id="vodka_bar" name="Manufacture vodka bar" />
    <bpmn:task id="whiskey_bar" name="Manufacture whiskey bar" />
    <bpmn:task id="test_flight" name="Send plane for test flight" />
    <bpmn:task id="create_protocol" name="Create test protocol" />
    <bpmn:task id="send_protocol" name="Send test protocol to customer" />
    <bpmn:sequenceFlow id="f-start-produce_base" sourceRef="start" targetRef="produce_base" />
    <bpmn:sequenceFlow id="f-produce_base-decide_interior" sourceRef="produce_base" targetRef="decide_interior" />
    <bpmn:sequenceFlow id="f-decide_interior-send_requirements" sourceRef="decide_interior" targetRef="send_requirements" />
    <bpmn:sequenceFlow id="f-send_requirements-manufacture_split" sourceRef="send_requirements" targetRef="manufacture_split" />
    <bpmn:sequenceFlow id="f-manufacture_split-vodka_bar" sourceRef="manufacture_split" targetRef="vodka_bar" />
    <bpmn:sequenceFlow id="f-manufacture_split-whiskey_bar" sourceRef="manufacture_split" targetRef="whiskey_bar" />
    <bpmn:sequenceFlow id="f-manufacture_split-other_bars" sourceRef="manufacture_split" targetRef="other_bars" />
    <bpmn:sequenceFlow id="f-manufacture_split-seats" sourceRef="manufacture_split" targetRef="seats" />
    <bpmn:sequenceFlow id="f-manufacture_split-interior_color" sourceRef="manufacture_split" targetRef="interior_color" />
    <bpmn:sequenceFlow id="f-manufacture_split-toilet_water" sourceRef="manufacture_split" targetRef="toilet_water" />
    <bpmn:sequenceFlow id="f-vodka_bar-manufacture_join" sourceRef="vodka_bar" targetRef="manufacture_join" />
    <bpmn:sequenceFlow id="f-whiskey_bar-manufacture_join" sourceRef="whiskey_bar" targetRef="manufacture_join" />
    <bpmn:sequenceFlow id="f-other_bars-manufacture_join" sourceRef="other_bars" targetRef="manufacture_join" />
    <bpmn:sequenceFlow id="f-seats-manufacture_join" sourceRef="seats" targetRef="manufacture_join" />
    <bpmn:sequenceFlow id="f-interior_color-manufacture_join" sourceRef="interior_color" targetRef="manufacture_join" />
    <bpmn:sequenceFlow id="f-toilet_water-manufacture_join" sourceRef="toilet_water" targetRef="manufacture_join" />
    <bpmn:sequenceFlow id="f-manufacture_join-assemble" sourceRef="manufacture_join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-test_flight" sourceRef="assemble" targetRef="test_flight" />
    <bpmn:sequenceFlow id="f-test_flight-create_protocol" sourceRef="test_flight" targetRef="create_protocol" />
    <bpmn:sequenceFlow id="f-create_protocol-send_protocol" sourceRef="create_protocol" targetRef="send_protocol" />
    <bpmn:sequenceFlow id="f-send_protocol-deliver" sourceRef="send_protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-receive_confirm" name="yes" sourceRef="confirm" targetRef="receive_confirm" />
    <bpmn:sequenceFlow id="f-confirm-handle_no_confirm" name="no" sourceRef="confirm" targetRef="handle_no_confirm" />
    <bpmn:sequenceFlow id="f-receive_confirm-completed" sourceRef="receive_confirm" targetRef="completed" />
    <bpmn:sequenceFlow id="f-handle_no_confirm-not_completed" sourceRef="handle_no_confirm" targetRef="not_completed" />
  </bpmn:process>
</bpmn:definitions>
