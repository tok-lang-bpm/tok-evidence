tok 1.0 "Luxury Airplane"

pool org "Luxury Airplane Production"
  lane production "Production"
    start start "Start production"
    task produce_base "Produce base airplane"
    task send_requirements "Send requirements to teams"
    and manufacture_split "Manufacture parts split"
    task other_bars "Manufacture other bars"
    task seats "Manufacture seats"
    task interior_color "Manufacture interior color"
    task toilet_water "Manufacture toilet water system"
    and manufacture_join "Manufacture parts join"
    task assemble "Assemble interior"
    task deliver "Deliver plane to customer"
    xor confirm "Customer confirmation?"
    task receive_confirm "Receive customer confirmation"
    task handle_no_confirm "Handle non‑confirmation"
    end completed "Delivery completed"
    end not_completed "Delivery not confirmed"

  lane customer "Customer"
    task decide_interior "Let customer decide interior specifications"
    task receive_protocol "Receive test protocol"
    # receiving confirmation handled in production lane above

  lane russian "Russian Team"
    task vodka_bar "Manufacture vodka bar"

  lane irish "Irish Team"
    task whiskey_bar "Manufacture whiskey bar"

  lane assembly "Assembly"
    # assembly task already in production lane; kept here for clarity if needed

  lane test "Test"
    task test_flight "Send plane for test flight"
    task create_protocol "Create test protocol"
    task send_protocol "Send test protocol to customer"

flow start -> produce_base
flow produce_base -> decide_interior
flow decide_interior -> send_requirements
flow send_requirements -> manufacture_split
flow manufacture_split -> vodka_bar
flow manufacture_split -> whiskey_bar
flow manufacture_split -> other_bars
flow manufacture_split -> seats
flow manufacture_split -> interior_color
flow manufacture_split -> toilet_water
flow vodka_bar -> manufacture_join
flow whiskey_bar -> manufacture_join
flow other_bars -> manufacture_join
flow seats -> manufacture_join
flow interior_color -> manufacture_join
flow toilet_water -> manufacture_join
flow manufacture_join -> assemble
flow assemble -> test_flight
flow test_flight -> create_protocol
flow create_protocol -> send_protocol
flow send_protocol -> deliver
flow deliver -> confirm
flow confirm -> receive_confirm "yes"
flow confirm -> handle_no_confirm "no"
flow receive_confirm -> completed
flow handle_no_confirm -> not_completed
