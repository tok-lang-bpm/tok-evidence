<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="project" name="Building a House" processRef="project-process" />
  </bpmn:collaboration>
  <bpmn:process id="project-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="project-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_messages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_attendance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>receive_requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build_house</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start building a tree house" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="send_req" name="Send requirements to architect" />
    <bpmn:task id="refine" name="Refine draft with additional requirements" />
    <bpmn:task id="create_materials" name="Create list of needed materials from plan" />
    <bpmn:parallelGateway id="fork" name="Parallel order and building" />
    <bpmn:task id="order_materials" name="Order materials from online stores" />
    <bpmn:task id="send_messages" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="join" name="Parallel join" />
    <bpmn:task id="send_invitations" name="Send invitations for a tree house party" />
    <bpmn:task id="create_attendance" name="Create list of people that attend the party" />
    <bpmn:endEvent id="e" name="Process completed" />
    <bpmn:task id="receive_requirements" name="Receive requirements" />
    <bpmn:task id="send_draft" name="Send draft to you" />
    <bpmn:task id="build_house" name="Build the house" />
    <bpmn:sequenceFlow id="f-s-collect" sourceRef="s" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-send_req" sourceRef="collect" targetRef="send_req" />
    <bpmn:sequenceFlow id="f-send_req-receive_requirements" sourceRef="send_req" targetRef="receive_requirements" />
    <bpmn:sequenceFlow id="f-receive_requirements-send_draft" sourceRef="receive_requirements" targetRef="send_draft" />
    <bpmn:sequenceFlow id="f-send_draft-refine" sourceRef="send_draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-create_materials" sourceRef="refine" targetRef="create_materials" />
    <bpmn:sequenceFlow id="f-create_materials-fork" sourceRef="create_materials" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-order_materials" sourceRef="fork" targetRef="order_materials" />
    <bpmn:sequenceFlow id="f-fork-send_messages" sourceRef="fork" targetRef="send_messages" />
    <bpmn:sequenceFlow id="f-send_messages-build_house" sourceRef="send_messages" targetRef="build_house" />
    <bpmn:sequenceFlow id="f-order_materials-join" sourceRef="order_materials" targetRef="join" />
    <bpmn:sequenceFlow id="f-build_house-join" sourceRef="build_house" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-send_invitations" sourceRef="join" targetRef="send_invitations" />
    <bpmn:sequenceFlow id="f-send_invitations-create_attendance" sourceRef="send_invitations" targetRef="create_attendance" />
    <bpmn:sequenceFlow id="f-create_attendance-e" sourceRef="create_attendance" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
