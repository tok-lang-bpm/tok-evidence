<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="DIY Repair Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendexpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expert_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online Tool">
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start DIY repair" />
    <bpmn:task id="enter" name="Enter model and what is broken" />
    <bpmn:task id="identify" name="Identify available items" />
    <bpmn:parallelGateway id="and1" name="Obtain items parallel split" />
    <bpmn:task id="contact" name="Contact friends for missing items" />
    <bpmn:task id="buy" name="Buy missing items" />
    <bpmn:parallelGateway id="and2" name="Obtain items join" />
    <bpmn:task id="fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="decision" name="Was repair successful?" />
    <bpmn:task id="review" name="Send review and/or video" />
    <bpmn:task id="sendexpert" name="Send phone to expert" />
    <bpmn:endEvent id="success" name="Repair successful" />
    <bpmn:endEvent id="expert_end" name="Sent to expert" />
    <bpmn:task id="provide" name="Provide list of materials, tools, ordering choices" />
    <bpmn:task id="instructions" name="Send repair instructions" />
    <bpmn:sequenceFlow id="f-s-enter" sourceRef="s" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-provide" sourceRef="enter" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-identify" sourceRef="provide" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-and1" sourceRef="identify" targetRef="and1" />
    <bpmn:sequenceFlow id="f-and1-contact" sourceRef="and1" targetRef="contact" />
    <bpmn:sequenceFlow id="f-and1-buy" sourceRef="and1" targetRef="buy" />
    <bpmn:sequenceFlow id="f-contact-and2" sourceRef="contact" targetRef="and2" />
    <bpmn:sequenceFlow id="f-buy-and2" sourceRef="buy" targetRef="and2" />
    <bpmn:sequenceFlow id="f-and2-instructions" sourceRef="and2" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-instructions-fix" sourceRef="instructions" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-decision" sourceRef="fix" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-review" name="yes" sourceRef="decision" targetRef="review" />
    <bpmn:sequenceFlow id="f-decision-sendexpert" name="no" sourceRef="decision" targetRef="sendexpert" />
    <bpmn:sequenceFlow id="f-review-success" sourceRef="review" targetRef="success" />
    <bpmn:sequenceFlow id="f-sendexpert-expert_end" sourceRef="sendexpert" targetRef="expert_end" />
  </bpmn:process>
</bpmn:definitions>
