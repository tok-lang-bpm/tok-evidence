tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool org "DIY Repair Process"
  lane user "User"
    start s "Start DIY repair"
    task enter "Enter model and what is broken"
    task identify "Identify available items"
    and and1 "Obtain items parallel split"
    task contact "Contact friends for missing items"
    task buy "Buy missing items"
    and and2 "Obtain items join"
    task fix "Fix the phone"
    xor decision "Was repair successful?"
    task review "Send review and/or video"
    task sendexpert "Send phone to expert"
    end success "Repair successful"
    end expert_end "Sent to expert"
  lane tool "Online Tool"
    task provide "Provide list of materials, tools, ordering choices"
    task instructions "Send repair instructions"

flow s -> enter
flow enter -> provide
flow provide -> identify
flow identify -> and1
flow and1 -> contact
flow and1 -> buy
flow contact -> and2
flow buy -> and2
flow and2 -> instructions
flow instructions -> fix
flow fix -> decision
flow decision -> review "yes"
flow decision -> sendexpert "no"
flow review -> success
flow sendexpert -> expert_end
