<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_ps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_press</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_pj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="machine" name="Machine">
        <bpmn:flowNodeRef>t_collect</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start inspection" />
    <bpmn:task id="t_enter" name="Enter machine type and serial number" />
    <bpmn:task id="t_questions" name="Answer inspection questions" />
    <bpmn:parallelGateway id="split_ps" name="Parallel split" />
    <bpmn:task id="t_press" name="Press inspection buttons" />
    <bpmn:exclusiveGateway id="decision_more" name="Additional questions needed?" default="f-decision_more-e" />
    <bpmn:task id="t_additional" name="Answer additional questions" />
    <bpmn:parallelGateway id="join_pj" name="Parallel join" />
    <bpmn:endEvent id="e" name="Inspection complete" />
    <bpmn:task id="t_collect" name="Collect machine values" />
    <bpmn:sequenceFlow id="f-s-t_enter" sourceRef="s" targetRef="t_enter" />
    <bpmn:sequenceFlow id="f-t_enter-t_questions" sourceRef="t_enter" targetRef="t_questions" />
    <bpmn:sequenceFlow id="f-t_questions-split_ps" sourceRef="t_questions" targetRef="split_ps" />
    <bpmn:sequenceFlow id="f-split_ps-t_press" sourceRef="split_ps" targetRef="t_press" />
    <bpmn:sequenceFlow id="f-split_ps-t_collect" sourceRef="split_ps" targetRef="t_collect" />
    <bpmn:sequenceFlow id="f-t_press-join_pj" sourceRef="t_press" targetRef="join_pj" />
    <bpmn:sequenceFlow id="f-t_collect-join_pj" sourceRef="t_collect" targetRef="join_pj" />
    <bpmn:sequenceFlow id="f-join_pj-decision_more" sourceRef="join_pj" targetRef="decision_more" />
    <bpmn:sequenceFlow id="f-decision_more-t_additional" name="yes" sourceRef="decision_more" targetRef="t_additional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_additional-e" sourceRef="t_additional" targetRef="e" />
    <bpmn:sequenceFlow id="f-decision_more-e" name="no" sourceRef="decision_more" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
