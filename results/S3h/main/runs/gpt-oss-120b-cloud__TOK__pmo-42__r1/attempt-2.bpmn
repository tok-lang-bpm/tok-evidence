<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Fridge Service Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central Service Center">
        <bpmn:flowNodeRef>sel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Local Service Facility">
        <bpmn:flowNodeRef>appt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rep</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Fridge produces strange noises" />
    <bpmn:task id="d" name="Describe symptoms and send to central service center" />
    <bpmn:task id="conf" name="Confirm fridge OK" />
    <bpmn:task id="rat" name="Rate service facility" />
    <bpmn:endEvent id="inc" name="Service incomplete" />
    <bpmn:endEvent id="comp" name="Service completed" />
    <bpmn:task id="sel" name="Select local service facility" />
    <bpmn:task id="appt" name="Make appointment" />
    <bpmn:task id="arr" name="Arrive at random time" />
    <bpmn:exclusiveGateway id="p" name="Additional parts needed?" />
    <bpmn:task id="leave" name="Leave without repair" />
    <bpmn:task id="rep" name="Repair fridge" />
    <bpmn:sequenceFlow id="f-s-d" sourceRef="s" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-sel" sourceRef="d" targetRef="sel" />
    <bpmn:sequenceFlow id="f-sel-appt" sourceRef="sel" targetRef="appt" />
    <bpmn:sequenceFlow id="f-appt-arr" sourceRef="appt" targetRef="arr" />
    <bpmn:sequenceFlow id="f-arr-p" sourceRef="arr" targetRef="p" />
    <bpmn:sequenceFlow id="f-p-leave" name="yes" sourceRef="p" targetRef="leave" />
    <bpmn:sequenceFlow id="f-p-rep" name="no" sourceRef="p" targetRef="rep" />
    <bpmn:sequenceFlow id="f-leave-inc" sourceRef="leave" targetRef="inc" />
    <bpmn:sequenceFlow id="f-rep-conf" sourceRef="rep" targetRef="conf" />
    <bpmn:sequenceFlow id="f-conf-rat" sourceRef="conf" targetRef="rat" />
    <bpmn:sequenceFlow id="f-rat-comp" sourceRef="rat" targetRef="comp" />
  </bpmn:process>
</bpmn:definitions>
