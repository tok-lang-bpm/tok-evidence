tok 1.0 "Service for Your Fridge"

pool org "Fridge Service Organization"
  lane customer "Customer"
    start s "Fridge produces strange noises"
    task d "Describe symptoms and send to central service center"
    task conf "Confirm fridge OK"
    task rat "Rate service facility"
    end inc "Service incomplete"
    end comp "Service completed"
  lane central "Central Service Center"
    task sel "Select local service facility"
  lane facility "Local Service Facility"
    task appt "Make appointment"
    task arr "Arrive at random time"
    xor p "Additional parts needed?"
    task leave "Leave without repair"
    task rep "Repair fridge"

flow s -> d -> sel -> appt -> arr -> p
flow p -> leave "yes"
flow p -> rep "no"
flow leave -> inc
flow rep -> conf -> rat -> comp
