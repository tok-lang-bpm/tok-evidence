<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car Service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Car Service Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Car Service" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statusUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fineEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>goToFacility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payApp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enterProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repairCar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterNextService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Service completed" />
    <bpmn:task id="checkReg" name="Check car registration" />
    <bpmn:exclusiveGateway id="regCheck" name="Car registered?" />
    <bpmn:task id="notify" name="Notify customer" />
    <bpmn:exclusiveGateway id="goService" name="Customer goes to service?" />
    <bpmn:task id="fine" name="Fine customer" />
    <bpmn:task id="statusUpdate" name="Send status updates via email" />
    <bpmn:endEvent id="fineEnd" name="Process ended with fine" />
    <bpmn:task id="goToFacility" name="Go to service facility" />
    <bpmn:task id="payApp" name="Pay through app" />
    <bpmn:task id="enterProblems" name="Enter car problems" />
    <bpmn:parallelGateway id="parallelSplit" name="Parallel split" />
    <bpmn:parallelGateway id="parallelJoin" name="Parallel join" />
    <bpmn:task id="repairCar" name="Repair car" />
    <bpmn:task id="enterSuccess" name="Enter repair successful and issue Pickerl" />
    <bpmn:task id="enterNextService" name="Enter next service time" />
    <bpmn:endEvent id="end1" name="Process completed" />
    <bpmn:sequenceFlow id="f-start1-checkReg" sourceRef="start1" targetRef="checkReg" />
    <bpmn:sequenceFlow id="f-checkReg-regCheck" sourceRef="checkReg" targetRef="regCheck" />
    <bpmn:sequenceFlow id="f-regCheck-notify" name="yes" sourceRef="regCheck" targetRef="notify" />
    <bpmn:sequenceFlow id="f-regCheck-fine" name="no" sourceRef="regCheck" targetRef="fine" />
    <bpmn:sequenceFlow id="f-notify-goService" sourceRef="notify" targetRef="goService" />
    <bpmn:sequenceFlow id="f-goService-fine" name="no" sourceRef="goService" targetRef="fine" />
    <bpmn:sequenceFlow id="f-goService-goToFacility" name="yes" sourceRef="goService" targetRef="goToFacility" />
    <bpmn:sequenceFlow id="f-goToFacility-enterProblems" sourceRef="goToFacility" targetRef="enterProblems" />
    <bpmn:sequenceFlow id="f-enterProblems-parallelSplit" sourceRef="enterProblems" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="f-parallelSplit-statusUpdate" sourceRef="parallelSplit" targetRef="statusUpdate" />
    <bpmn:sequenceFlow id="f-parallelSplit-repairCar" sourceRef="parallelSplit" targetRef="repairCar" />
    <bpmn:sequenceFlow id="f-statusUpdate-parallelJoin" sourceRef="statusUpdate" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f-repairCar-parallelJoin" sourceRef="repairCar" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f-parallelJoin-enterSuccess" sourceRef="parallelJoin" targetRef="enterSuccess" />
    <bpmn:sequenceFlow id="f-enterSuccess-enterNextService" sourceRef="enterSuccess" targetRef="enterNextService" />
    <bpmn:sequenceFlow id="f-enterNextService-payApp" sourceRef="enterNextService" targetRef="payApp" />
    <bpmn:sequenceFlow id="f-payApp-end1" sourceRef="payApp" targetRef="end1" />
    <bpmn:sequenceFlow id="f-fine-fineEnd" sourceRef="fine" targetRef="fineEnd" />
  </bpmn:process>
</bpmn:definitions>
