<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Receive order" />
    <bpmn:exclusiveGateway id="dec1" name="Menu or just burger?" />
    <bpmn:parallelGateway id="split" name="Menu parallel" />
    <bpmn:task id="drink" name="Prepare the drink" />
    <bpmn:task id="ask" name="Ask fries or wedges" />
    <bpmn:exclusiveGateway id="dec2" name="Fries or wedges?" />
    <bpmn:task id="fries" name="Prepare the fries" />
    <bpmn:task id="wedges" name="Prepare the wedges" />
    <bpmn:parallelGateway id="join" name="Menu join" />
    <bpmn:task id="burger" name="Prepare the burger" />
    <bpmn:task id="deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="e" name="Order completed" />
    <bpmn:sequenceFlow id="f-s-dec1" sourceRef="s" targetRef="dec1" />
    <bpmn:sequenceFlow id="f-dec1-split" name="menu" sourceRef="dec1" targetRef="split" />
    <bpmn:sequenceFlow id="f-dec1-burger" name="just burger" sourceRef="dec1" targetRef="burger" />
    <bpmn:sequenceFlow id="f-split-drink" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-split-ask" sourceRef="split" targetRef="ask" />
    <bpmn:sequenceFlow id="f-drink-join" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f-ask-dec2" sourceRef="ask" targetRef="dec2" />
    <bpmn:sequenceFlow id="f-dec2-fries" name="fries" sourceRef="dec2" targetRef="fries" />
    <bpmn:sequenceFlow id="f-dec2-wedges" name="wedges" sourceRef="dec2" targetRef="wedges" />
    <bpmn:sequenceFlow id="f-fries-join" sourceRef="fries" targetRef="join" />
    <bpmn:sequenceFlow id="f-wedges-join" sourceRef="wedges" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-burger" sourceRef="join" targetRef="burger" />
    <bpmn:sequenceFlow id="f-burger-deliver" sourceRef="burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-e" sourceRef="deliver" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
