<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="E-Shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>login_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_product</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_to_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save_product</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_payment_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_shipping_address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_billing_address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>check_credentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all_selected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>confirm_payment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="login_start" name="Customer logs in" />
    <bpmn:task id="select_product" name="Select product" />
    <bpmn:task id="add_to_cart" name="Add product to shopping cart" />
    <bpmn:task id="save_product" name="Save product" />
    <bpmn:task id="enter_payment_data" name="Enter payment data" />
    <bpmn:task id="enter_shipping_address" name="Enter shipping address" />
    <bpmn:task id="enter_billing_address" name="Enter billing address" />
    <bpmn:endEvent id="login_failed" name="Login failed" />
    <bpmn:endEvent id="order_completed" name="Order completed" />
    <bpmn:task id="check_credentials" name="Check credentials" />
    <bpmn:exclusiveGateway id="login_success" name="Login successful?" />
    <bpmn:exclusiveGateway id="all_selected" name="All products selected?" />
    <bpmn:exclusiveGateway id="address_match" name="Shipping address equals billing address?" />
    <bpmn:task id="finish_order" name="Finish order" />
    <bpmn:parallelGateway id="split_prepare" />
    <bpmn:parallelGateway id="join_prepare" />
    <bpmn:task id="complete_order" name="Complete order" />
    <bpmn:task id="confirm_payment" name="Confirm payment" />
    <bpmn:sequenceFlow id="f-login_start-check_credentials" sourceRef="login_start" targetRef="check_credentials" />
    <bpmn:sequenceFlow id="f-check_credentials-login_success" sourceRef="check_credentials" targetRef="login_success" />
    <bpmn:sequenceFlow id="f-login_success-select_product" name="yes" sourceRef="login_success" targetRef="select_product" />
    <bpmn:sequenceFlow id="f-login_success-login_failed" name="no" sourceRef="login_success" targetRef="login_failed" />
    <bpmn:sequenceFlow id="f-select_product-add_to_cart" sourceRef="select_product" targetRef="add_to_cart" />
    <bpmn:sequenceFlow id="f-add_to_cart-save_product" sourceRef="add_to_cart" targetRef="save_product" />
    <bpmn:sequenceFlow id="f-save_product-all_selected" sourceRef="save_product" targetRef="all_selected" />
    <bpmn:sequenceFlow id="f-all_selected-select_product" name="no" sourceRef="all_selected" targetRef="select_product" />
    <bpmn:sequenceFlow id="f-all_selected-finish_order" name="yes" sourceRef="all_selected" targetRef="finish_order" />
    <bpmn:sequenceFlow id="f-finish_order-split_prepare" sourceRef="finish_order" targetRef="split_prepare" />
    <bpmn:sequenceFlow id="f-split_prepare-enter_payment_data" sourceRef="split_prepare" targetRef="enter_payment_data" />
    <bpmn:sequenceFlow id="f-split_prepare-enter_shipping_address" sourceRef="split_prepare" targetRef="enter_shipping_address" />
    <bpmn:sequenceFlow id="f-enter_payment_data-confirm_payment" sourceRef="enter_payment_data" targetRef="confirm_payment" />
    <bpmn:sequenceFlow id="f-confirm_payment-join_prepare" sourceRef="confirm_payment" targetRef="join_prepare" />
    <bpmn:sequenceFlow id="f-enter_shipping_address-address_match" sourceRef="enter_shipping_address" targetRef="address_match" />
    <bpmn:sequenceFlow id="f-address_match-join_prepare" name="yes" sourceRef="address_match" targetRef="join_prepare" />
    <bpmn:sequenceFlow id="f-address_match-enter_billing_address" name="no" sourceRef="address_match" targetRef="enter_billing_address" />
    <bpmn:sequenceFlow id="f-enter_billing_address-join_prepare" sourceRef="enter_billing_address" targetRef="join_prepare" />
    <bpmn:sequenceFlow id="f-join_prepare-complete_order" sourceRef="join_prepare" targetRef="complete_order" />
    <bpmn:sequenceFlow id="f-complete_order-order_completed" sourceRef="complete_order" targetRef="order_completed" />
  </bpmn:process>
</bpmn:definitions>
