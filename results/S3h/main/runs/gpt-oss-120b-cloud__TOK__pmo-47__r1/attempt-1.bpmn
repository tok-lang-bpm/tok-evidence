<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="sports_institute" name="Sports Institute" processRef="sports_institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="sports_institute-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="sports_institute-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose_course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet_friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_reg_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_no_slots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>provide_courses_dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_university</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>university_eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_activation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start registration" />
    <bpmn:task id="select_course" name="Select a course" />
    <bpmn:exclusiveGateway id="slots_free" name="Slots free?" />
    <bpmn:task id="choose_course" name="Choose a course" />
    <bpmn:task id="check_account" name="Check account existence" />
    <bpmn:exclusiveGateway id="account_exists" name="Account exists?" />
    <bpmn:task id="log_in" name="Log into account" />
    <bpmn:parallelGateway id="after_login" name="Parallel after login" />
    <bpmn:task id="tweet_friends" name="Tweet to friends" />
    <bpmn:task id="complete_reg_payment" name="Complete registration and provide payment information" />
    <bpmn:parallelGateway id="join_parallel" name="Join parallel tasks" />
    <bpmn:task id="receive_ticket" name="Receive course ticket" />
    <bpmn:endEvent id="e_success" name="Registration completed" />
    <bpmn:endEvent id="e_no_slots" name="No slots available" />
    <bpmn:task id="provide_courses_dates" name="System provides courses and dates" />
    <bpmn:task id="check_university" name="Check university eligibility" />
    <bpmn:exclusiveGateway id="university_eligible" name="Eligible university?" />
    <bpmn:task id="register_account" name="Register account" />
    <bpmn:task id="request_activation" name="Request activation" />
    <bpmn:task id="wait_activation" name="Wait for activation response" />
    <bpmn:sequenceFlow id="f-s-select_course" sourceRef="s" targetRef="select_course" />
    <bpmn:sequenceFlow id="f-select_course-slots_free" sourceRef="select_course" targetRef="slots_free" />
    <bpmn:sequenceFlow id="f-slots_free-provide_courses_dates" name="yes" sourceRef="slots_free" targetRef="provide_courses_dates" />
    <bpmn:sequenceFlow id="f-slots_free-e_no_slots" name="no" sourceRef="slots_free" targetRef="e_no_slots" />
    <bpmn:sequenceFlow id="f-provide_courses_dates-choose_course" sourceRef="provide_courses_dates" targetRef="choose_course" />
    <bpmn:sequenceFlow id="f-choose_course-check_account" sourceRef="choose_course" targetRef="check_account" />
    <bpmn:sequenceFlow id="f-check_account-account_exists" sourceRef="check_account" targetRef="account_exists" />
    <bpmn:sequenceFlow id="f-account_exists-log_in" name="yes" sourceRef="account_exists" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-account_exists-check_university" name="no" sourceRef="account_exists" targetRef="check_university" />
    <bpmn:sequenceFlow id="f-check_university-university_eligible" sourceRef="check_university" targetRef="university_eligible" />
    <bpmn:sequenceFlow id="f-university_eligible-register_account" name="yes" sourceRef="university_eligible" targetRef="register_account" />
    <bpmn:sequenceFlow id="f-university_eligible-request_activation" name="no" sourceRef="university_eligible" targetRef="request_activation" />
    <bpmn:sequenceFlow id="f-register_account-log_in" sourceRef="register_account" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-request_activation-wait_activation" sourceRef="request_activation" targetRef="wait_activation" />
    <bpmn:sequenceFlow id="f-wait_activation-log_in" sourceRef="wait_activation" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-log_in-after_login" sourceRef="log_in" targetRef="after_login" />
    <bpmn:sequenceFlow id="f-after_login-tweet_friends" sourceRef="after_login" targetRef="tweet_friends" />
    <bpmn:sequenceFlow id="f-after_login-complete_reg_payment" sourceRef="after_login" targetRef="complete_reg_payment" />
    <bpmn:sequenceFlow id="f-tweet_friends-join_parallel" sourceRef="tweet_friends" targetRef="join_parallel" />
    <bpmn:sequenceFlow id="f-complete_reg_payment-join_parallel" sourceRef="complete_reg_payment" targetRef="join_parallel" />
    <bpmn:sequenceFlow id="f-join_parallel-receive_ticket" sourceRef="join_parallel" targetRef="receive_ticket" />
    <bpmn:sequenceFlow id="f-receive_ticket-e_success" sourceRef="receive_ticket" targetRef="e_success" />
  </bpmn:process>
</bpmn:definitions>
