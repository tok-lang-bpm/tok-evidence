tok 1.0 "New Application for Registering for an USI course"

pool sports_institute "Sports Institute"
  lane applicant "Applicant"
    start s "Start registration"
    task select_course "Select a course"
    xor slots_free "Slots free?"
    task choose_course "Choose a course"
    task check_account "Check account existence"
    xor account_exists "Account exists?"
    task log_in "Log into account"
    and after_login "Parallel after login"
    task tweet_friends "Tweet to friends"
    task complete_reg_payment "Complete registration and provide payment information"
    and join_parallel "Join parallel tasks"
    task receive_ticket "Receive course ticket"
    end e_success "Registration completed"
    end e_no_slots "No slots available"

  lane system "System"
    task provide_courses_dates "System provides courses and dates"
    task check_university "Check university eligibility"
    xor university_eligible "Eligible university?"
    task register_account "Register account"
    task request_activation "Request activation"
    task wait_activation "Wait for activation response"

flow s -> select_course -> slots_free
flow slots_free -> provide_courses_dates "yes"
flow slots_free -> e_no_slots "no"
flow provide_courses_dates -> choose_course -> check_account
flow check_account -> account_exists
flow account_exists -> log_in "yes"
flow account_exists -> check_university "no"
flow check_university -> university_eligible
flow university_eligible -> register_account "yes"
flow university_eligible -> request_activation "no"
flow register_account -> log_in
flow request_activation -> wait_activation -> log_in
flow log_in -> after_login
flow after_login -> tweet_friends
flow after_login -> complete_reg_payment
flow tweet_friends -> join_parallel
flow complete_reg_payment -> join_parallel
flow join_parallel -> receive_ticket -> e_success
