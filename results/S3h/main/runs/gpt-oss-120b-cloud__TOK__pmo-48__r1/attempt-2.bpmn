<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="App For Participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="participant" name="Participant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>time_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travel_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go_home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start participation" />
    <bpmn:task id="select_block" name="Select starting block" />
    <bpmn:task id="run_test" name="Run 5km and measure time" />
    <bpmn:exclusiveGateway id="time_check" name="Time less than 25 minutes?" />
    <bpmn:task id="train_check" name="Train and check" />
    <bpmn:task id="get_number" name="Get starting number" />
    <bpmn:task id="determine_travel" name="Determine travel option" />
    <bpmn:exclusiveGateway id="travel_choice" name="More than one hour left?" />
    <bpmn:task id="go_home" name="Go to event from home" />
    <bpmn:task id="leave_work" name="Leave directly from work" />
    <bpmn:parallelGateway id="travel_join" name="Travel option join" />
    <bpmn:parallelGateway id="parallel_split" name="Run and drink split" />
    <bpmn:task id="run_event" name="Run at Night Run" />
    <bpmn:task id="drink" name="Drink during run" />
    <bpmn:parallelGateway id="parallel_join" name="Run and drink join" />
    <bpmn:task id="receive_time" name="Receive final running time" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-select_block" sourceRef="start" targetRef="select_block" />
    <bpmn:sequenceFlow id="f-select_block-run_test" sourceRef="select_block" targetRef="run_test" />
    <bpmn:sequenceFlow id="f-run_test-time_check" sourceRef="run_test" targetRef="time_check" />
    <bpmn:sequenceFlow id="f-time_check-get_number" name="yes" sourceRef="time_check" targetRef="get_number" />
    <bpmn:sequenceFlow id="f-time_check-train_check" name="no" sourceRef="time_check" targetRef="train_check" />
    <bpmn:sequenceFlow id="f-train_check-run_test" sourceRef="train_check" targetRef="run_test" />
    <bpmn:sequenceFlow id="f-get_number-determine_travel" sourceRef="get_number" targetRef="determine_travel" />
    <bpmn:sequenceFlow id="f-determine_travel-travel_choice" sourceRef="determine_travel" targetRef="travel_choice" />
    <bpmn:sequenceFlow id="f-travel_choice-go_home" name="yes" sourceRef="travel_choice" targetRef="go_home" />
    <bpmn:sequenceFlow id="f-travel_choice-leave_work" name="no" sourceRef="travel_choice" targetRef="leave_work" />
    <bpmn:sequenceFlow id="f-go_home-travel_join" sourceRef="go_home" targetRef="travel_join" />
    <bpmn:sequenceFlow id="f-leave_work-travel_join" sourceRef="leave_work" targetRef="travel_join" />
    <bpmn:sequenceFlow id="f-travel_join-parallel_split" sourceRef="travel_join" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f-parallel_split-run_event" sourceRef="parallel_split" targetRef="run_event" />
    <bpmn:sequenceFlow id="f-parallel_split-drink" sourceRef="parallel_split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-run_event-parallel_join" sourceRef="run_event" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-drink-parallel_join" sourceRef="drink" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-parallel_join-receive_time" sourceRef="parallel_join" targetRef="receive_time" />
    <bpmn:sequenceFlow id="f-receive_time-end" sourceRef="receive_time" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
