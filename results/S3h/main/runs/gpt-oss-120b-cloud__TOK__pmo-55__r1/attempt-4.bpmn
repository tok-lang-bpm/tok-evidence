<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Central Venous Catheter Insertion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hospital" name="Hospital" processRef="hospital-process" />
  </bpmn:collaboration>
  <bpmn:process id="hospital-process" name="Central Venous Catheter Insertion" isExecutable="false">
    <bpmn:laneSet id="hospital-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_impl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash_hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean_puncture_area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape_puncture_zone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure_ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_gel_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_vein</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anatomic_identification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doppler_identification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compression_identification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood_return_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_check_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_long_axis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_short_axis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after_wire_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire_position_good</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen_pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify_flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify_reflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_catheter_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:parallelGateway id="split_prep" />
    <bpmn:task id="prep_impl" name="Prepare implements" />
    <bpmn:task id="wash_hands" name="Wash hands" />
    <bpmn:task id="get_sterile_clothes" name="Get in sterile clothes" />
    <bpmn:parallelGateway id="join_prep" />
    <bpmn:task id="clean_puncture_area" name="Clean puncture area" />
    <bpmn:task id="drape_puncture_zone" name="Drape puncture zone" />
    <bpmn:task id="configure_ultrasound" name="Configure ultrasound" />
    <bpmn:task id="put_gel_probe" name="Put gel in probe" />
    <bpmn:task id="cover_probe" name="Cover probe" />
    <bpmn:task id="put_sterile_gel" name="Put sterile gel" />
    <bpmn:parallelGateway id="split_position" />
    <bpmn:task id="position_probe" name="Position probe" />
    <bpmn:task id="position_patient" name="Position patient" />
    <bpmn:parallelGateway id="join_position" />
    <bpmn:exclusiveGateway id="identify_vein" name="Identify vein method" />
    <bpmn:task id="anatomic_identification" name="Anatomic identification" />
    <bpmn:task id="doppler_identification" name="Doppler identification" />
    <bpmn:task id="compression_identification" name="Compression identification" />
    <bpmn:exclusiveGateway id="after_identify" name="After vein identification" />
    <bpmn:task id="anesthetize_patient" name="Anesthetize patient" />
    <bpmn:task id="puncture_patient" name="Puncture patient" />
    <bpmn:task id="check_blood_return" name="Check blood return" />
    <bpmn:exclusiveGateway id="blood_return_ok" name="Blood return correct?" />
    <bpmn:task id="drop_probe" name="Drop probe" />
    <bpmn:task id="remove_syringe" name="Remove syringe" />
    <bpmn:task id="install_guidewire" name="Install guidewire" />
    <bpmn:task id="remove_trocar" name="Remove trocar" />
    <bpmn:exclusiveGateway id="wire_check_method" name="Wire check method" />
    <bpmn:task id="check_long_axis" name="Check wire long axis" />
    <bpmn:task id="check_short_axis" name="Check wire short axis" />
    <bpmn:exclusiveGateway id="after_wire_check" name="After wire check" />
    <bpmn:exclusiveGateway id="wire_position_good" name="Wire in good position?" />
    <bpmn:task id="widen_pathway" name="Widen pathway" />
    <bpmn:task id="advance_catheter" name="Advance catheter" />
    <bpmn:task id="remove_guidewire" name="Remove guidewire" />
    <bpmn:task id="verify_flow" name="Verify flow" />
    <bpmn:task id="verify_reflow" name="Verify reflow" />
    <bpmn:task id="check_catheter_position" name="Check catheter position" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-split_prep" sourceRef="s" targetRef="split_prep" />
    <bpmn:sequenceFlow id="f-split_prep-prep_impl" sourceRef="split_prep" targetRef="prep_impl" />
    <bpmn:sequenceFlow id="f-split_prep-wash_hands" sourceRef="split_prep" targetRef="wash_hands" />
    <bpmn:sequenceFlow id="f-split_prep-get_sterile_clothes" sourceRef="split_prep" targetRef="get_sterile_clothes" />
    <bpmn:sequenceFlow id="f-prep_impl-join_prep" sourceRef="prep_impl" targetRef="join_prep" />
    <bpmn:sequenceFlow id="f-wash_hands-join_prep" sourceRef="wash_hands" targetRef="join_prep" />
    <bpmn:sequenceFlow id="f-get_sterile_clothes-join_prep" sourceRef="get_sterile_clothes" targetRef="join_prep" />
    <bpmn:sequenceFlow id="f-join_prep-clean_puncture_area" sourceRef="join_prep" targetRef="clean_puncture_area" />
    <bpmn:sequenceFlow id="f-clean_puncture_area-drape_puncture_zone" sourceRef="clean_puncture_area" targetRef="drape_puncture_zone" />
    <bpmn:sequenceFlow id="f-drape_puncture_zone-configure_ultrasound" sourceRef="drape_puncture_zone" targetRef="configure_ultrasound" />
    <bpmn:sequenceFlow id="f-configure_ultrasound-put_gel_probe" sourceRef="configure_ultrasound" targetRef="put_gel_probe" />
    <bpmn:sequenceFlow id="f-put_gel_probe-cover_probe" sourceRef="put_gel_probe" targetRef="cover_probe" />
    <bpmn:sequenceFlow id="f-cover_probe-put_sterile_gel" sourceRef="cover_probe" targetRef="put_sterile_gel" />
    <bpmn:sequenceFlow id="f-put_sterile_gel-split_position" sourceRef="put_sterile_gel" targetRef="split_position" />
    <bpmn:sequenceFlow id="f-split_position-position_probe" sourceRef="split_position" targetRef="position_probe" />
    <bpmn:sequenceFlow id="f-split_position-position_patient" sourceRef="split_position" targetRef="position_patient" />
    <bpmn:sequenceFlow id="f-position_probe-join_position" sourceRef="position_probe" targetRef="join_position" />
    <bpmn:sequenceFlow id="f-position_patient-join_position" sourceRef="position_patient" targetRef="join_position" />
    <bpmn:sequenceFlow id="f-join_position-identify_vein" sourceRef="join_position" targetRef="identify_vein" />
    <bpmn:sequenceFlow id="f-identify_vein-anatomic_identification" name="anatomic" sourceRef="identify_vein" targetRef="anatomic_identification" />
    <bpmn:sequenceFlow id="f-identify_vein-doppler_identification" name="doppler" sourceRef="identify_vein" targetRef="doppler_identification" />
    <bpmn:sequenceFlow id="f-identify_vein-compression_identification" name="compression" sourceRef="identify_vein" targetRef="compression_identification" />
    <bpmn:sequenceFlow id="f-anatomic_identification-after_identify" sourceRef="anatomic_identification" targetRef="after_identify" />
    <bpmn:sequenceFlow id="f-doppler_identification-after_identify" sourceRef="doppler_identification" targetRef="after_identify" />
    <bpmn:sequenceFlow id="f-compression_identification-after_identify" sourceRef="compression_identification" targetRef="after_identify" />
    <bpmn:sequenceFlow id="f-after_identify-anesthetize_patient" sourceRef="after_identify" targetRef="anesthetize_patient" />
    <bpmn:sequenceFlow id="f-anesthetize_patient-puncture_patient" sourceRef="anesthetize_patient" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f-puncture_patient-check_blood_return" sourceRef="puncture_patient" targetRef="check_blood_return" />
    <bpmn:sequenceFlow id="f-check_blood_return-blood_return_ok" sourceRef="check_blood_return" targetRef="blood_return_ok" />
    <bpmn:sequenceFlow id="f-blood_return_ok-drop_probe" name="correct" sourceRef="blood_return_ok" targetRef="drop_probe" />
    <bpmn:sequenceFlow id="f-blood_return_ok-puncture_patient" name="incorrect" sourceRef="blood_return_ok" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f-drop_probe-remove_syringe" sourceRef="drop_probe" targetRef="remove_syringe" />
    <bpmn:sequenceFlow id="f-remove_syringe-install_guidewire" sourceRef="remove_syringe" targetRef="install_guidewire" />
    <bpmn:sequenceFlow id="f-install_guidewire-remove_trocar" sourceRef="install_guidewire" targetRef="remove_trocar" />
    <bpmn:sequenceFlow id="f-remove_trocar-wire_check_method" sourceRef="remove_trocar" targetRef="wire_check_method" />
    <bpmn:sequenceFlow id="f-wire_check_method-check_long_axis" name="long" sourceRef="wire_check_method" targetRef="check_long_axis" />
    <bpmn:sequenceFlow id="f-wire_check_method-check_short_axis" name="short" sourceRef="wire_check_method" targetRef="check_short_axis" />
    <bpmn:sequenceFlow id="f-check_long_axis-after_wire_check" sourceRef="check_long_axis" targetRef="after_wire_check" />
    <bpmn:sequenceFlow id="f-check_short_axis-after_wire_check" sourceRef="check_short_axis" targetRef="after_wire_check" />
    <bpmn:sequenceFlow id="f-after_wire_check-wire_position_good" sourceRef="after_wire_check" targetRef="wire_position_good" />
    <bpmn:sequenceFlow id="f-wire_position_good-widen_pathway" name="good" sourceRef="wire_position_good" targetRef="widen_pathway" />
    <bpmn:sequenceFlow id="f-wire_position_good-puncture_patient" name="bad" sourceRef="wire_position_good" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f-widen_pathway-advance_catheter" sourceRef="widen_pathway" targetRef="advance_catheter" />
    <bpmn:sequenceFlow id="f-advance_catheter-remove_guidewire" sourceRef="advance_catheter" targetRef="remove_guidewire" />
    <bpmn:sequenceFlow id="f-remove_guidewire-verify_flow" sourceRef="remove_guidewire" targetRef="verify_flow" />
    <bpmn:sequenceFlow id="f-verify_flow-verify_reflow" sourceRef="verify_flow" targetRef="verify_reflow" />
    <bpmn:sequenceFlow id="f-verify_reflow-check_catheter_position" sourceRef="verify_reflow" targetRef="check_catheter_position" />
    <bpmn:sequenceFlow id="f-check_catheter_position-e" sourceRef="check_catheter_position" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
