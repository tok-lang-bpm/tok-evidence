<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="laneSet1">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNotInterested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNotApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales" name="Sales">
        <bpmn:flowNodeRef>collectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guideSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvalGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConfirmation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Customer inquiry" />
    <bpmn:task id="collectInfo" name="Collect information and address concerns" />
    <bpmn:exclusiveGateway id="interestGw" name="Customer interested?" />
    <bpmn:task id="guideSelection" name="Guide product selection" />
    <bpmn:task id="provideQuote" name="Provide quote" />
    <bpmn:exclusiveGateway id="approvalGw" name="Quote approved?" />
    <bpmn:task id="recordOrder" name="Record order in system" />
    <bpmn:task id="sendConfirmation" name="Send order confirmation" />
    <bpmn:endEvent id="end" name="Order placed and confirmed" />
    <bpmn:endEvent id="endNotInterested" name="Inquiry ended – not interested" />
    <bpmn:endEvent id="endNotApproved" name="Quote not approved" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collectInfo" />
    <bpmn:sequenceFlow id="f2" sourceRef="collectInfo" targetRef="interestGw" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="interestGw" targetRef="guideSelection" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="interestGw" targetRef="endNotInterested" />
    <bpmn:sequenceFlow id="f5" sourceRef="guideSelection" targetRef="provideQuote" />
    <bpmn:sequenceFlow id="f6" sourceRef="provideQuote" targetRef="approvalGw" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="approvalGw" targetRef="recordOrder" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="approvalGw" targetRef="endNotApproved" />
    <bpmn:sequenceFlow id="f9" sourceRef="recordOrder" targetRef="sendConfirmation" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendConfirmation" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
