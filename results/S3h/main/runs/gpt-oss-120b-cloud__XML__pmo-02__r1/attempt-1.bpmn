<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organization" processRef="hiring-process" />
  </bpmn:collaboration>

  <bpmn:process id="hiring-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="laneset1">
      <bpmn:lane id="lane_department" name="Department">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_identify_need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hr" name="HR">
        <bpmn:flowNodeRef>t_create_job_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_post_job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_collect_resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_screen_resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_phone_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_interview_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inperson_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_virtual_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_interview_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_candidate_chosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_extend_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_negotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_salary_negotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_offer_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_onboarding_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_not_selected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_onboarding" name="Onboarding Team">
        <bpmn:flowNodeRef>t_complete_paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_onboarding_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_integrate_hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_onboarding_completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="s_start" name="Need identified" />
    <bpmn:task id="t_identify_need" name="Identify need for new hire" />
    <bpmn:task id="t_create_job_desc" name="Create job description" />
    <bpmn:task id="t_post_job" name="Post job description on job boards" />
    <bpmn:task id="t_collect_resumes" name="Collect resumes" />
    <bpmn:task id="t_screen_resumes" name="Screen resumes" />
    <bpmn:task id="t_phone_interviews" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="g_interview_type" name="Interview type?" />
    <bpmn:task id="t_inperson_interview" name="Conduct in-person interview" />
    <bpmn:task id="t_virtual_interview" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="g_interview_merge" name="Merge interview paths" />
    <bpmn:exclusiveGateway id="g_candidate_chosen" name="Candidate chosen?" />
    <bpmn:task id="t_extend_offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="g_negotiation" name="Negotiation required?" />
    <bpmn:task id="t_salary_negotiation" name="Conduct salary negotiations" />
    <bpmn:task id="t_offer_accepted" name="Offer accepted" />
    <bpmn:parallelGateway id="pg_onboarding_split" name="Onboarding split" />
    <bpmn:task id="t_complete_paperwork" name="Complete paperwork" />
    <bpmn:task id="t_orientation" name="Conduct orientation" />
    <bpmn:task id="t_training" name="Provide training" />
    <bpmn:parallelGateway id="pg_onboarding_join" name="Onboarding join" />
    <bpmn:task id="t_integrate_hire" name="Integrate new hire into team" />
    <bpmn:endEvent id="e_onboarding_completed" name="Onboarding completed" />
    <bpmn:endEvent id="e_not_selected" name="Candidate not selected - process ended" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="s_start" targetRef="t_identify_need" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_identify_need" targetRef="t_create_job_desc" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_create_job_desc" targetRef="t_post_job" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_post_job" targetRef="t_collect_resumes" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_collect_resumes" targetRef="t_screen_resumes" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_screen_resumes" targetRef="t_phone_interviews" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_phone_interviews" targetRef="g_interview_type" />
    <bpmn:sequenceFlow id="f8" name="in-person" sourceRef="g_interview_type" targetRef="t_inperson_interview" />
    <bpmn:sequenceFlow id="f9" name="virtual" sourceRef="g_interview_type" targetRef="t_virtual_interview" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_inperson_interview" targetRef="g_interview_merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_virtual_interview" targetRef="g_interview_merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="g_interview_merge" targetRef="g_candidate_chosen" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="g_candidate_chosen" targetRef="t_extend_offer" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="g_candidate_chosen" targetRef="e_not_selected" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_extend_offer" targetRef="g_negotiation" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="g_negotiation" targetRef="t_salary_negotiation" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="g_negotiation" targetRef="t_offer_accepted" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_salary_negotiation" targetRef="t_offer_accepted" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_offer_accepted" targetRef="pg_onboarding_split" />
    <bpmn:sequenceFlow id="f20" sourceRef="pg_onboarding_split" targetRef="t_complete_paperwork" />
    <bpmn:sequenceFlow id="f21" sourceRef="pg_onboarding_split" targetRef="t_orientation" />
    <bpmn:sequenceFlow id="f22" sourceRef="pg_onboarding_split" targetRef="t_training" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_complete_paperwork" targetRef="pg_onboarding_join" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_orientation" targetRef="pg_onboarding_join" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_training" targetRef="pg_onboarding_join" />
    <bpmn:sequenceFlow id="f26" sourceRef="pg_onboarding_join" targetRef="t_integrate_hire" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_integrate_hire" targetRef="e_onboarding_completed" />
  </bpmn:process>
</bpmn:definitions>
