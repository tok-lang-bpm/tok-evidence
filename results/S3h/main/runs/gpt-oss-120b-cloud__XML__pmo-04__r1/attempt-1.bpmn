<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="laneMarketing" name="Marketing Team">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>defineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>designVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endProcess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSales" name="Sales Team">
        <bpmn:flowNodeRef>followUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCRM" name="CRM System">
        <bpmn:flowNodeRef>collectLeadsInCRM</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start1" name="Start Process" />
    <bpmn:task id="defineObjectives" name="Define campaign objectives" />
    <bpmn:parallelGateway id="pg1" />
    <bpmn:task id="createContent" name="Create content" />
    <bpmn:task id="designVisuals" name="Design visuals" />
    <bpmn:task id="selectChannels" name="Select promotion channels" />
    <bpmn:parallelGateway id="pg2" />
    <bpmn:task id="launchCampaign" name="Launch campaign" />
    <bpmn:parallelGateway id="pg3" />
    <bpmn:task id="trackPerformance" name="Track performance in real-time" />
    <bpmn:task id="collectLeadsInCRM" name="Collect leads in CRM system" />
    <bpmn:parallelGateway id="pg4" />
    <bpmn:task id="followUpLeads" name="Follow up leads" />
    <bpmn:task id="analyzePerformance" name="Analyze performance for future optimization" />
    <bpmn:endEvent id="endProcess" name="Process completed" />

    <bpmn:sequenceFlow id="flow1" sourceRef="start1" targetRef="defineObjectives" />
    <bpmn:sequenceFlow id="flow2" sourceRef="defineObjectives" targetRef="pg1" />
    <bpmn:sequenceFlow id="flow3" sourceRef="pg1" targetRef="createContent" />
    <bpmn:sequenceFlow id="flow4" sourceRef="pg1" targetRef="designVisuals" />
    <bpmn:sequenceFlow id="flow5" sourceRef="pg1" targetRef="selectChannels" />
    <bpmn:sequenceFlow id="flow6" sourceRef="createContent" targetRef="pg2" />
    <bpmn:sequenceFlow id="flow7" sourceRef="designVisuals" targetRef="pg2" />
    <bpmn:sequenceFlow id="flow8" sourceRef="selectChannels" targetRef="pg2" />
    <bpmn:sequenceFlow id="flow9" sourceRef="pg2" targetRef="launchCampaign" />
    <bpmn:sequenceFlow id="flow10" sourceRef="launchCampaign" targetRef="pg3" />
    <bpmn:sequenceFlow id="flow11" sourceRef="pg3" targetRef="trackPerformance" />
    <bpmn:sequenceFlow id="flow12" sourceRef="pg3" targetRef="collectLeadsInCRM" />
    <bpmn:sequenceFlow id="flow13" sourceRef="trackPerformance" targetRef="pg4" />
    <bpmn:sequenceFlow id="flow14" sourceRef="collectLeadsInCRM" targetRef="pg4" />
    <bpmn:sequenceFlow id="flow15" sourceRef="pg4" targetRef="followUpLeads" />
    <bpmn:sequenceFlow id="flow16" sourceRef="followUpLeads" targetRef="analyzePerformance" />
    <bpmn:sequenceFlow id="flow17" sourceRef="analyzePerformance" targetRef="endProcess" />
  </bpmn:process>
</bpmn:definitions>
