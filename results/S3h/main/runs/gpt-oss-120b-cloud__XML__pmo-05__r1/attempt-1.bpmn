<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="procurement-process" />
    <bpmn:participant id="supplier" name="Supplier" />
  </bpmn:collaboration>

  <bpmn:process id="procurement-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identifyNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conductSiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectAndNegotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreeTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>executeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start1" name="Identify need for new supplier" />
    <bpmn:task id="identifyNeed" name="Identify need for new supplier" />
    <bpmn:task id="issueRFP" name="Issue request for proposals (RFP)" />
    <bpmn:task id="receiveProposals" name="Receive proposals from suppliers" />
    <bpmn:task id="evaluateProposals" name="Evaluate proposals" />
    <bpmn:task id="conductSiteVisits" name="Conduct site visits or interviews with suppliers" />
    <bpmn:exclusiveGateway id="selectGateway" name="Supplier selected?" />
    <bpmn:task id="selectAndNegotiate" name="Select supplier and begin contract negotiations" />
    <bpmn:task id="agreeTerms" name="Agree on terms" />
    <bpmn:task id="signContract" name="Sign contract" />
    <bpmn:parallelGateway id="splitParallel" />
    <bpmn:task id="onboardSupplier" name="Onboard supplier" />
    <bpmn:task id="executeContract" name="Execute contract" />
    <bpmn:parallelGateway id="joinParallel" />
    <bpmn:endEvent id="end1" name="Supplier onboarded and contract executed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="identifyNeed" />
    <bpmn:sequenceFlow id="f2" sourceRef="identifyNeed" targetRef="issueRFP" />
    <bpmn:sequenceFlow id="f3" sourceRef="issueRFP" targetRef="receiveProposals" />
    <bpmn:sequenceFlow id="f4" sourceRef="receiveProposals" targetRef="evaluateProposals" />
    <bpmn:sequenceFlow id="f5" sourceRef="evaluateProposals" targetRef="conductSiteVisits" />
    <bpmn:sequenceFlow id="f6" sourceRef="conductSiteVisits" targetRef="selectGateway" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="selectGateway" targetRef="selectAndNegotiate" />
    <bpmn:sequenceFlow id="f8" sourceRef="selectAndNegotiate" targetRef="agreeTerms" />
    <bpmn:sequenceFlow id="f9" sourceRef="agreeTerms" targetRef="signContract" />
    <bpmn:sequenceFlow id="f10" sourceRef="signContract" targetRef="splitParallel" />
    <bpmn:sequenceFlow id="f11" sourceRef="splitParallel" targetRef="onboardSupplier" />
    <bpmn:sequenceFlow id="f12" sourceRef="splitParallel" targetRef="executeContract" />
    <bpmn:sequenceFlow id="f13" sourceRef="onboardSupplier" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f14" sourceRef="executeContract" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f15" sourceRef="joinParallel" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
