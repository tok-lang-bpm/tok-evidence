<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROD-PROC" />
  </bpmn:collaboration>
  <bpmn:process id="PROD-PROC" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="RND" name="R&amp;D Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refineGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvalGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discardedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify idea for new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="build" name="Build prototype using available materials and resources" />
    <bpmn:task id="test" name="Test prototype for functionality, safety, and market potential" />
    <bpmn:task id="collectFeedback" name="Collect feedback from testing phase" />
    <bpmn:exclusiveGateway id="refineGateway" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine prototype" />
    <bpmn:exclusiveGateway id="approvalGateway" name="Prototype approved?" />
    <bpmn:endEvent id="approvedEnd" name="Prototype approved for further development" />
    <bpmn:endEvent id="discardedEnd" name="Prototype discarded" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f3" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="draft" targetRef="build" />
    <bpmn:sequenceFlow id="f5" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f6" sourceRef="test" targetRef="collectFeedback" />
    <bpmn:sequenceFlow id="f7" sourceRef="collectFeedback" targetRef="refineGateway" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="refineGateway" targetRef="refine" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="refineGateway" targetRef="approvalGateway" />
    <bpmn:sequenceFlow id="f10" sourceRef="refine" targetRef="test" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="approvalGateway" targetRef="approvedEnd" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="approvalGateway" targetRef="discardedEnd" />
  </bpmn:process>
</bpmn:definitions>
