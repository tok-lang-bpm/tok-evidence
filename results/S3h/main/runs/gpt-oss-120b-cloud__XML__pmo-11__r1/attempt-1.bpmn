<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="subscription-process" />
  </bpmn:collaboration>
  <bpmn:process id="subscription-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>communications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitCancellation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSystem" name="System">
        <bpmn:flowNodeRef>generateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>triggerBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>communications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSupport" name="Support Team">
        <bpmn:flowNodeRef>processCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refundGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyCharges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivateSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Customer signs up for subscription service" />
    <bpmn:task id="signUp" name="Enter personal and payment information" />
    <bpmn:task id="generateAccount" name="Generate account" />
    <bpmn:task id="assignAccess" name="Assign access" />
    <bpmn:task id="triggerBilling" name="Trigger automated billing cycles" />
    <bpmn:task id="communications" name="Receive regular updates, product enhancements, or renewal notifications" />
    
    <bpmn:exclusiveGateway id="cancelGateway" name="Customer decides to cancel?" />
    <bpmn:task id="submitCancellation" name="Submit cancellation request" />
    <bpmn:task id="processCancellation" name="Process cancellation request" />
    
    <bpmn:exclusiveGateway id="refundGateway" name="Refund applicable?" />
    <bpmn:task id="applyRefund" name="Apply refund" />
    <bpmn:task id="applyCharges" name="Apply charges" />
    
    <bpmn:parallelGateway id="parallelSplit" name="Parallel processing" />
    <bpmn:task id="deactivateSubscription" name="Deactivate subscription" />
    <bpmn:task id="settleBalance" name="Settle final account balance" />
    <bpmn:parallelGateway id="parallelJoin" name="Parallel join" />
    
    <bpmn:endEvent id="end" name="Process completed" />
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="signUp" />
    <bpmn:sequenceFlow id="flow2" sourceRef="signUp" targetRef="generateAccount" />
    <bpmn:sequenceFlow id="flow3" sourceRef="generateAccount" targetRef="assignAccess" />
    <bpmn:sequenceFlow id="flow4" sourceRef="assignAccess" targetRef="triggerBilling" />
    <bpmn:sequenceFlow id="flow5" sourceRef="triggerBilling" targetRef="communications" />
    <bpmn:sequenceFlow id="flow6" sourceRef="communications" targetRef="cancelGateway" />
    
    <bpmn:sequenceFlow id="flow7" name="yes" sourceRef="cancelGateway" targetRef="submitCancellation" />
    <bpmn:sequenceFlow id="flow8" name="no" sourceRef="cancelGateway" targetRef="communications" />
    
    <bpmn:sequenceFlow id="flow9" sourceRef="submitCancellation" targetRef="processCancellation" />
    <bpmn:sequenceFlow id="flow10" sourceRef="processCancellation" targetRef="refundGateway" />
    
    <bpmn:sequenceFlow id="flow11" name="yes" sourceRef="refundGateway" targetRef="applyRefund" />
    <bpmn:sequenceFlow id="flow12" name="no" sourceRef="refundGateway" targetRef="applyCharges" />
    
    <bpmn:sequenceFlow id="flow13" sourceRef="applyRefund" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="flow14" sourceRef="applyCharges" targetRef="parallelSplit" />
    
    <bpmn:sequenceFlow id="flow15" sourceRef="parallelSplit" targetRef="deactivateSubscription" />
    <bpmn:sequenceFlow id="flow16" sourceRef="parallelSplit" targetRef="settleBalance" />
    
    <bpmn:sequenceFlow id="flow17" sourceRef="deactivateSubscription" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="flow18" sourceRef="settleBalance" targetRef="parallelJoin" />
    
    <bpmn:sequenceFlow id="flow19" sourceRef="parallelJoin" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
