<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="E‑Commerce Company" processRef="order-fulfillment-process"/>
  </bpmn:collaboration>
  <bpmn:process id="order-fulfillment-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>record_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_shipping_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_followup_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_return_label</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_inventory" name="Inventory System">
        <bpmn:flowNodeRef>check_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiate_backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_backorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick_items</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_quality" name="Quality Control">
        <bpmn:flowNodeRef>qc_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_packaging" name="Packaging">
        <bpmn:flowNodeRef>package_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift_wrap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_shipping" name="Shipping Department">
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_shipping_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_customs_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_returns" name="Returns">
        <bpmn:flowNodeRef>receive_returned_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect_returned_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_refund_replacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_return</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start_customer" name="Customer places order"/>
    <bpmn:task id="record_order" name="Record order details"/>
    <bpmn:task id="process_payment" name="Process payment"/>
    <bpmn:exclusiveGateway id="gateway_payment" name="Payment successful?"/>
    <bpmn:task id="notify_failure" name="Notify customer of payment failure"/>
    <bpmn:endEvent id="end_failure" name="Process ends (payment failed)"/>
    <bpmn:task id="check_stock" name="Check stock availability"/>
    <bpmn:exclusiveGateway id="gateway_stock" name="Items in stock?"/>
    <bpmn:task id="initiate_backorder" name="Initiate back-order"/>
    <bpmn:task id="inform_delay" name="Inform customer of delay"/>
    <bpmn:task id="wait_backorder" name="Receive back-order and items available"/>
    <bpmn:task id="pick_items" name="Pick items from warehouse"/>
    <bpmn:task id="qc_check" name="Quality control check"/>
    <bpmn:parallelGateway id="parallel_split"/>
    <bpmn:task id="package_items" name="Package items"/>
    <bpmn:exclusiveGateway id="gateway_gift" name="Gift wrap requested?"/>
    <bpmn:task id="gift_wrap" name="Gift wrap items"/>
    <bpmn:task id="prepare_shipping_docs" name="Prepare shipping documents and labels"/>
    <bpmn:exclusiveGateway id="gateway_international" name="International order?"/>
    <bpmn:task id="prepare_customs_docs" name="Prepare customs documentation"/>
    <bpmn:parallelGateway id="parallel_join"/>
    <bpmn:task id="dispatch_order" name="Dispatch order"/>
    <bpmn:task id="send_shipping_confirmation" name="Send shipping confirmation"/>
    <bpmn:task id="update_inventory" name="Update inventory levels"/>
    <bpmn:task id="send_followup_email" name="Send follow‑up email for feedback"/>
    <bpmn:exclusiveGateway id="gateway_issue" name="Customer reports issue?"/>
    <bpmn:task id="send_return_label" name="Send return shipping label"/>
    <bpmn:task id="receive_returned_items" name="Receive returned items"/>
    <bpmn:task id="inspect_returned_items" name="Inspect returned items"/>
    <bpmn:task id="process_refund_replacement" name="Process refund or replacement"/>
    <bpmn:endEvent id="end_success" name="Order completed successfully"/>
    <bpmn:endEvent id="end_return" name="Returns process completed"/>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow_start_record" sourceRef="start_customer" targetRef="record_order"/>
    <bpmn:sequenceFlow id="flow_record_payment" sourceRef="record_order" targetRef="process_payment"/>
    <bpmn:sequenceFlow id="flow_payment_gateway" sourceRef="process_payment" targetRef="gateway_payment"/>

    <bpmn:sequenceFlow id="flow_payment_fail" name="no" sourceRef="gateway_payment" targetRef="notify_failure"/>
    <bpmn:sequenceFlow id="flow_notify_end" sourceRef="notify_failure" targetRef="end_failure"/>

    <bpmn:sequenceFlow id="flow_payment_success" name="yes" sourceRef="gateway_payment" targetRef="check_stock"/>

    <bpmn:sequenceFlow id="flow_stock_gateway" sourceRef="check_stock" targetRef="gateway_stock"/>

    <bpmn:sequenceFlow id="flow_stock_yes" name="yes" sourceRef="gateway_stock" targetRef="pick_items"/>
    <bpmn:sequenceFlow id="flow_stock_no" name="no" sourceRef="gateway_stock" targetRef="initiate_backorder"/>

    <bpmn:sequenceFlow id="flow_backorder_inform" sourceRef="initiate_backorder" targetRef="inform_delay"/>
    <bpmn:sequenceFlow id="flow_inform_wait" sourceRef="inform_delay" targetRef="wait_backorder"/>
    <bpmn:sequenceFlow id="flow_wait_to_pick" sourceRef="wait_backorder" targetRef="pick_items"/>

    <bpmn:sequenceFlow id="flow_pick_qc" sourceRef="pick_items" targetRef="qc_check"/>
    <bpmn:sequenceFlow id="flow_qc_parallel" sourceRef="qc_check" targetRef="parallel_split"/>

    <!-- Parallel branch A: Packaging -->
    <bpmn:sequenceFlow id="flow_parallel_to_pack" sourceRef="parallel_split" targetRef="package_items"/>
    <bpmn:sequenceFlow id="flow_pack_to_gift_gateway" sourceRef="package_items" targetRef="gateway_gift"/>
    <bpmn:sequenceFlow id="flow_gift_yes" name="yes" sourceRef="gateway_gift" targetRef="gift_wrap"/>
    <bpmn:sequenceFlow id="flow_gift_no" name="no" sourceRef="gateway_gift" targetRef="prepare_shipping_docs"/>
    <bpmn:sequenceFlow id="flow_gift_to_shipping" sourceRef="gift_wrap" targetRef="prepare_shipping_docs"/>

    <!-- Parallel branch B: Shipping documents -->
    <bpmn:sequenceFlow id="flow_parallel_to_shipdocs" sourceRef="parallel_split" targetRef="prepare_shipping_docs"/>

    <bpmn:sequenceFlow id="flow_shipdocs_to_intl" sourceRef="prepare_shipping_docs" targetRef="gateway_international"/>
    <bpmn:sequenceFlow id="flow_intl_yes" name="yes" sourceRef="gateway_international" targetRef="prepare_customs_docs"/>
    <bpmn:sequenceFlow id="flow_intl_no" name="no" sourceRef="gateway_international" targetRef="parallel_join"/>
    <bpmn:sequenceFlow id="flow_customs_to_join" sourceRef="prepare_customs_docs" targetRef="parallel_join"/>

    <!-- Join of parallel branches -->
    <bpmn:sequenceFlow id="flow_join_to_dispatch" sourceRef="parallel_join" targetRef="dispatch_order"/>

    <bpmn:sequenceFlow id="flow_dispatch_confirm" sourceRef="dispatch_order" targetRef="send_shipping_confirmation"/>
    <bpmn:sequenceFlow id="flow_confirm_update" sourceRef="send_shipping_confirmation" targetRef="update_inventory"/>
    <bpmn:sequenceFlow id="flow_update_followup" sourceRef="update_inventory" targetRef="send_followup_email"/>
    <bpmn:sequenceFlow id="flow_followup_issue_gateway" sourceRef="send_followup_email" targetRef="gateway_issue"/>

    <!-- No issues path -->
    <bpmn:sequenceFlow id="flow_no_issue" name="no" sourceRef="gateway_issue" targetRef="end_success"/>

    <!-- Issue path (returns) -->
    <bpmn:sequenceFlow id="flow_yes_issue" name="yes" sourceRef="gateway_issue" targetRef="send_return_label"/>
    <bpmn:sequenceFlow id="flow_label_to_receive" sourceRef="send_return_label" targetRef="receive_returned_items"/>
    <bpmn:sequenceFlow id="flow_receive_to_inspect" sourceRef="receive_returned_items" targetRef="inspect_returned_items"/>
    <bpmn:sequenceFlow id="flow_inspect_to_process" sourceRef="inspect_returned_items" targetRef="process_refund_replacement"/>
    <bpmn:sequenceFlow id="flow_process_to_end" sourceRef="process_refund_replacement" targetRef="end_return"/>

  </bpmn:process>
</bpmn:definitions>
