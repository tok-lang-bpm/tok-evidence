<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Online Shop" processRef="purchase-process" />
  </bpmn:collaboration>
  <bpmn:process id="purchase-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="userLane" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start order" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="fork1" />
    <bpmn:task id="selectItems" name="Select items to purchase" />
    <bpmn:task id="chooseReward" name="Choose free reward" />
    <bpmn:task id="setPaymentMethod" name="Set payment method" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:exclusiveGateway id="paymentDecision" name="Payment choice" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="returnDecision" name="Return items?" />
    <bpmn:task id="return" name="Return items for exchange" />
    <bpmn:endEvent id="end" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="fork1" />
    <bpmn:sequenceFlow id="f3" sourceRef="fork1" targetRef="selectItems" />
    <bpmn:sequenceFlow id="f4" sourceRef="selectItems" targetRef="chooseReward" />
    <bpmn:sequenceFlow id="f5" sourceRef="chooseReward" targetRef="join1" />
    <bpmn:sequenceFlow id="f6" sourceRef="fork1" targetRef="setPaymentMethod" />
    <bpmn:sequenceFlow id="f7" sourceRef="setPaymentMethod" targetRef="join1" />
    <bpmn:sequenceFlow id="f8" sourceRef="join1" targetRef="paymentDecision" />
    <bpmn:sequenceFlow id="f9" name="pay" sourceRef="paymentDecision" targetRef="pay" />
    <bpmn:sequenceFlow id="f10" name="installment" sourceRef="paymentDecision" targetRef="installment" />
    <bpmn:sequenceFlow id="f11" sourceRef="pay" targetRef="deliver" />
    <bpmn:sequenceFlow id="f12" sourceRef="installment" targetRef="deliver" />
    <bpmn:sequenceFlow id="f13" sourceRef="deliver" targetRef="returnDecision" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="returnDecision" targetRef="return" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="returnDecision" targetRef="end" />
    <bpmn:sequenceFlow id="f16" sourceRef="return" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
