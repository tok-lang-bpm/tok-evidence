<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurantPool" name="Restaurant" processRef="restaurantProcess" />
  </bpmn:collaboration>
  <bpmn:process id="restaurantProcess" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneGuest" name="Guest">
        <bpmn:flowNodeRef>guestEnter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayGuestReaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickUpMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eatMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneEmployee" name="Employee">
        <bpmn:flowNodeRef>enterOrderCollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setupBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setOffBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handOverMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitTimer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneChef" name="Chef">
        <bpmn:flowNodeRef>prepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeInHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEmployeeMealReady</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="guestEnter" name="Guest enters restaurant" />
    <bpmn:task id="chooseDish" name="Choose dish" />
    <bpmn:task id="waitTurn" name="Wait for turn" />
    <bpmn:task id="placeOrder" name="Place order with employee" />
    <bpmn:task id="enterOrderCollectMoney" name="Enter order into POS and collect money" />
    <bpmn:task id="setupBuzzer" name="Set up buzzer and give to guest" />
    <bpmn:task id="informChef" name="Inform chef of new order" />
    <bpmn:task id="prepareMeal" name="Prepare meal" />
    <bpmn:task id="placeInHatch" name="Place meal in service hatch" />
    <bpmn:task id="informEmployeeMealReady" name="Inform employee meal ready" />
    <bpmn:task id="setOffBuzzer" name="Set off buzzer" />
    <bpmn:exclusiveGateway id="gatewayGuestReaction" name="Guest reacts to buzzer?" />
    <bpmn:task id="handOverMeal" name="Hand over meal to guest" />
    <bpmn:task id="pickUpMeal" name="Pick up meal" />
    <bpmn:task id="eatMeal" name="Eat meal" />
    <bpmn:endEvent id="processEnd" name="Process completed" />
    <bpmn:task id="callGuest" name="Call guest after 5 minutes" />
    <bpmn:intermediateCatchEvent id="waitTimer" name="Wait 5 minutes">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="guestEnter" targetRef="chooseDish" />
    <bpmn:sequenceFlow id="flow2" sourceRef="chooseDish" targetRef="waitTurn" />
    <bpmn:sequenceFlow id="flow3" sourceRef="waitTurn" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="flow4" sourceRef="placeOrder" targetRef="enterOrderCollectMoney" />
    <bpmn:sequenceFlow id="flow5" sourceRef="enterOrderCollectMoney" targetRef="setupBuzzer" />
    <bpmn:sequenceFlow id="flow6" sourceRef="setupBuzzer" targetRef="informChef" />
    <bpmn:sequenceFlow id="flow7" sourceRef="informChef" targetRef="prepareMeal" />
    <bpmn:sequenceFlow id="flow8" sourceRef="prepareMeal" targetRef="placeInHatch" />
    <bpmn:sequenceFlow id="flow9" sourceRef="placeInHatch" targetRef="informEmployeeMealReady" />
    <bpmn:sequenceFlow id="flow10" sourceRef="informEmployeeMealReady" targetRef="setOffBuzzer" />
    <bpmn:sequenceFlow id="flow11" sourceRef="setOffBuzzer" targetRef="gatewayGuestReaction" />
    <bpmn:sequenceFlow id="flow12_yes" name="yes" sourceRef="gatewayGuestReaction" targetRef="handOverMeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">guest reacts</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow13_no" name="no" sourceRef="gatewayGuestReaction" targetRef="callGuest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">guest does not react</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow14" sourceRef="callGuest" targetRef="waitTimer" />
    <bpmn:sequenceFlow id="flow15" sourceRef="waitTimer" targetRef="gatewayGuestReaction" />
    <bpmn:sequenceFlow id="flow16" sourceRef="handOverMeal" targetRef="pickUpMeal" />
    <bpmn:sequenceFlow id="flow17" sourceRef="pickUpMeal" targetRef="eatMeal" />
    <bpmn:sequenceFlow id="flow18" sourceRef="eatMeal" targetRef="processEnd" />
  </bpmn:process>
</bpmn:definitions>
