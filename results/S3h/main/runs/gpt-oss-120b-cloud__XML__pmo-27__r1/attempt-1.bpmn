<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="work-accident-process" />
  </bpmn:collaboration>
  <bpmn:process id="work-accident-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="LANE_EMPLOYEE" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatherInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEmployer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwWorkAccident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_EMPLOYER" name="Employer">
        <bpmn:flowNodeRef>assessSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwLabour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportLabour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwCoveredInsurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSelfEmployed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwInstitution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPrivateInsurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportInsurer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SELFEMPLOYED" name="Self‑Employed">
        <bpmn:flowNodeRef>selfReportInsurer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_STUDENT" name="Student / Schoolchild">
        <bpmn:flowNodeRef>reportDirectorate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_EDU_INSTITUTION" name="Education Institution">
        <bpmn:flowNodeRef>institutionReportInsurer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PRIVATE_INSURER" name="Private Insurer">
        <bpmn:flowNodeRef>privateReport</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Accident / Near‑accident occurs" />
    <bpmn:task id="gatherInfo" name="Gather accident information" />
    <bpmn:exclusiveGateway id="gwWorkAccident" name="Is it a work accident?" />
    <bpmn:task id="informEmployer" name="Inform employer" />
    <bpmn:task id="assessSeverity" name="Assess accident severity" />
    <bpmn:exclusiveGateway id="gwLabour" name="Fatality or serious injury?" />
    <bpmn:task id="reportLabour" name="Report to Labour Inspectorate" />
    <bpmn:parallelGateway id="gwSplit" />
    <bpmn:exclusiveGateway id="gwCoveredInsurer" name="Covered by accident insurance?" />
    <bpmn:task id="reportInsurer" name="Report to Accident Insurance Provider" />
    <bpmn:exclusiveGateway id="gwSelfEmployed" name="Is self‑employed?" />
    <bpmn:task id="selfReportInsurer" name="Self‑employed reports to Accident Insurance Provider" />
    <bpmn:exclusiveGateway id="gwStudent" name="Student / schoolchild involved?" />
    <bpmn:task id="reportDirectorate" name="Report to competent directorate" />
    <bpmn:exclusiveGateway id="gwInstitution" name="Education institution involved?" />
    <bpmn:task id="institutionReportInsurer" name="Institution reports to Accident Insurance Provider (triplicate)" />
    <bpmn:exclusiveGateway id="gwPrivateInsurer" name="Private insurance applicable?" />
    <bpmn:task id="privateReport" name="Report to private insurer" />
    <bpmn:parallelGateway id="gwJoin" />
    <bpmn:endEvent id="end" name="Process completed" />
    
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gatherInfo" />
    <bpmn:sequenceFlow id="f2" sourceRef="gatherInfo" targetRef="gwWorkAccident" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gwWorkAccident" targetRef="informEmployer" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gwWorkAccident" targetRef="informEmployer" />
    <bpmn:sequenceFlow id="f5" sourceRef="informEmployer" targetRef="assessSeverity" />
    <bpmn:sequenceFlow id="f6" sourceRef="assessSeverity" targetRef="gwLabour" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gwLabour" targetRef="reportLabour" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gwLabour" targetRef="gwSplit" />
    <bpmn:sequenceFlow id="f9" sourceRef="reportLabour" targetRef="gwSplit" />
    <bpmn:sequenceFlow id="f10" sourceRef="gwSplit" targetRef="gwCoveredInsurer" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gwCoveredInsurer" targetRef="reportInsurer" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gwCoveredInsurer" targetRef="gwSelfEmployed" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="gwSelfEmployed" targetRef="selfReportInsurer" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gwSelfEmployed" targetRef="gwStudent" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="gwStudent" targetRef="reportDirectorate" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gwStudent" targetRef="gwInstitution" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="gwInstitution" targetRef="institutionReportInsurer" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="gwInstitution" targetRef="gwPrivateInsurer" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="gwPrivateInsurer" targetRef="privateReport" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="gwPrivateInsurer" targetRef="gwJoin" />
    <bpmn:sequenceFlow id="f21" sourceRef="reportInsurer" targetRef="gwJoin" />
    <bpmn:sequenceFlow id="f22" sourceRef="selfReportInsurer" targetRef="gwJoin" />
    <bpmn:sequenceFlow id="f23" sourceRef="reportDirectorate" targetRef="gwJoin" />
    <bpmn:sequenceFlow id="f24" sourceRef="institutionReportInsurer" targetRef="gwJoin" />
    <bpmn:sequenceFlow id="f25" sourceRef="privateReport" targetRef="gwJoin" />
    <bpmn:sequenceFlow id="f26" sourceRef="gwJoin" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
