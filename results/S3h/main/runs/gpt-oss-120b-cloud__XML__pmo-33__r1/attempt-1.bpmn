<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="process1"/>
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="customerLane" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>haveColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amountEnough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addToShoppingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generateGcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artistLane" name="Artist">
        <bpmn:flowNodeRef>createModel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printerLane" name="Printer">
        <bpmn:flowNodeRef>turnOnPrinter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printModel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="start" name="Start"/>

    <!-- Customer sends sketches -->
    <bpmn:task id="sendSketches" name="Send sketches"/>

    <!-- Artist creates 3D model -->
    <bpmn:task id="createModel" name="Create 3D model"/>

    <!-- Customer checks satisfaction -->
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with model?"/>

    <!-- Choose plastic colour -->
    <bpmn:task id="chooseColor" name="Choose plastic colour"/>

    <!-- Do you have the colour at home? -->
    <bpmn:exclusiveGateway id="haveColor" name="Colour in stock?"/>

    <!-- Check remaining amount -->
    <bpmn:task id="checkAmount" name="Check colour amount"/>

    <!-- Is amount under 100g? -->
    <bpmn:exclusiveGateway id="amountEnough" name="Amount under 100g?"/>

    <!-- Add to shopping list -->
    <bpmn:task id="addToShoppingList" name="Put colour on shopping list"/>

    <!-- Order colour -->
    <bpmn:task id="orderColor" name="Order colour"/>

    <!-- Parallel split for printer preparation and gcode generation -->
    <bpmn:parallelGateway id="parallelSplit"/>

    <!-- Generate G‑code -->
    <bpmn:task id="generateGcode" name="Generate G‑code file"/>

    <!-- Turn printer on and heat up -->
    <bpmn:task id="turnOnPrinter" name="Turn printer on and heat up"/>

    <!-- Parallel join -->
    <bpmn:parallelGateway id="parallelJoin"/>

    <!-- Print the model -->
    <bpmn:task id="printModel" name="Print the model"/>

    <!-- End -->
    <bpmn:endEvent id="end" name="End"/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendSketches"/>
    <bpmn:sequenceFlow id="f2" sourceRef="sendSketches" targetRef="createModel"/>
    <bpmn:sequenceFlow id="f3" sourceRef="createModel" targetRef="satisfied"/>
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="satisfied" targetRef="chooseColor"/>
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="satisfied" targetRef="sendSketches"/>
    <bpmn:sequenceFlow id="f6" sourceRef="chooseColor" targetRef="haveColor"/>
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="haveColor" targetRef="checkAmount"/>
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="haveColor" targetRef="orderColor"/>
    <bpmn:sequenceFlow id="f9" sourceRef="checkAmount" targetRef="amountEnough"/>
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="amountEnough" targetRef="addToShoppingList"/>
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="amountEnough" targetRef="parallelSplit"/>
    <bpmn:sequenceFlow id="f12" sourceRef="addToShoppingList" targetRef="parallelSplit"/>
    <bpmn:sequenceFlow id="f13" sourceRef="orderColor" targetRef="parallelSplit"/>
    <bpmn:sequenceFlow id="f14" sourceRef="parallelSplit" targetRef="generateGcode"/>
    <bpmn:sequenceFlow id="f15" sourceRef="parallelSplit" targetRef="turnOnPrinter"/>
    <bpmn:sequenceFlow id="f16" sourceRef="generateGcode" targetRef="parallelJoin"/>
    <bpmn:sequenceFlow id="f17" sourceRef="turnOnPrinter" targetRef="parallelJoin"/>
    <bpmn:sequenceFlow id="f18" sourceRef="parallelJoin" targetRef="printModel"/>
    <bpmn:sequenceFlow id="f19" sourceRef="printModel" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
