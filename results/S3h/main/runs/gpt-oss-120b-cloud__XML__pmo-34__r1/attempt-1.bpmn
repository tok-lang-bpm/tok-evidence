<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_builder" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buildSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_children" name="Children">
        <bpmn:flowNodeRef>sortParts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="orderSets" name="Order Lego brick sets" />
    <bpmn:task id="giveSets" name="Give Lego sets to children" />
    <bpmn:task id="sortParts" name="Sort parts into containers" />
    <bpmn:task id="buildSub" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="gwParts" name="Container has parts?" />
    <bpmn:task id="reorderParts" name="Reorder individual parts" />
    <bpmn:task id="testSub" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="gwTest" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="rebuild" name="Rebuild subcomponent" />
    <bpmn:task id="assemble" name="Assemble subcomponents" />
    <bpmn:endEvent id="end" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="design" />
    <bpmn:sequenceFlow id="f2" sourceRef="design" targetRef="orderSets" />
    <bpmn:sequenceFlow id="f3" sourceRef="orderSets" targetRef="giveSets" />
    <bpmn:sequenceFlow id="f4" sourceRef="giveSets" targetRef="sortParts" />
    <bpmn:sequenceFlow id="f5" sourceRef="sortParts" targetRef="buildSub" />
    <bpmn:sequenceFlow id="f6" sourceRef="buildSub" targetRef="gwParts" />
    <bpmn:sequenceFlow id="f7_no" name="no parts" sourceRef="gwParts" targetRef="reorderParts" />
    <bpmn:sequenceFlow id="f8_yes" name="parts available" sourceRef="gwParts" targetRef="testSub" />
    <bpmn:sequenceFlow id="f9" sourceRef="reorderParts" targetRef="buildSub" />
    <bpmn:sequenceFlow id="f10" sourceRef="testSub" targetRef="gwTest" />
    <bpmn:sequenceFlow id="f11_yes" name="yes" sourceRef="gwTest" targetRef="assemble" />
    <bpmn:sequenceFlow id="f12_no" name="no" sourceRef="gwTest" targetRef="redesign" />
    <bpmn:sequenceFlow id="f13" sourceRef="redesign" targetRef="rebuild" />
    <bpmn:sequenceFlow id="f14" sourceRef="rebuild" targetRef="testSub" />
    <bpmn:sequenceFlow id="f15" sourceRef="assemble" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
