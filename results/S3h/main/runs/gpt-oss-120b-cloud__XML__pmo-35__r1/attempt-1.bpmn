<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Chainsaw Company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideSpecs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PRODUCTION" name="Production">
        <bpmn:flowNodeRef>orderSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prodSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prodJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likeGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Order request received" />
    <bpmn:task id="provideSpecs" name="Provide chainsaw specifications" />
    <bpmn:parallelGateway id="orderSplit" />
    <bpmn:task id="order1" name="Order parts from Supplier 1" />
    <bpmn:task id="order2" name="Order parts from Supplier 2" />
    <bpmn:parallelGateway id="orderJoin" />
    <bpmn:task id="inspect" name="Inspect received parts" />
    <bpmn:task id="assemble" name="Assemble parts" />
    <bpmn:parallelGateway id="prodSplit" />
    <bpmn:task id="sendUpdate" name="Send production update to customer" />
    <bpmn:task id="produceFirst" name="Produce first chainsaw" />
    <bpmn:parallelGateway id="prodJoin" />
    <bpmn:task id="sendFirst" name="Send first chainsaw to customer" />
    <bpmn:exclusiveGateway id="likeGateway" name="Customer likes first saw?" />
    <bpmn:task id="produceRest" name="Produce rest of order" />
    <bpmn:endEvent id="endSuccess" name="Order completed" />
    <bpmn:endEvent id="endReject" name="Order cancelled" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="provideSpecs" />
    <bpmn:sequenceFlow id="f2" sourceRef="provideSpecs" targetRef="orderSplit" />
    <bpmn:sequenceFlow id="f3" sourceRef="orderSplit" targetRef="order1" />
    <bpmn:sequenceFlow id="f4" sourceRef="orderSplit" targetRef="order2" />
    <bpmn:sequenceFlow id="f5" sourceRef="order1" targetRef="orderJoin" />
    <bpmn:sequenceFlow id="f6" sourceRef="order2" targetRef="orderJoin" />
    <bpmn:sequenceFlow id="f7" sourceRef="orderJoin" targetRef="inspect" />
    <bpmn:sequenceFlow id="f8" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f9" sourceRef="assemble" targetRef="prodSplit" />
    <bpmn:sequenceFlow id="f10" sourceRef="prodSplit" targetRef="sendUpdate" />
    <bpmn:sequenceFlow id="f11" sourceRef="prodSplit" targetRef="produceFirst" />
    <bpmn:sequenceFlow id="f12" sourceRef="sendUpdate" targetRef="prodJoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="produceFirst" targetRef="prodJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="prodJoin" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f15" sourceRef="sendFirst" targetRef="likeGateway" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="likeGateway" targetRef="produceRest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">liked = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="likeGateway" targetRef="endReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">liked = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" sourceRef="produceRest" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>
