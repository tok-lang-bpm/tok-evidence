<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="ownerLane" name="Owner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tCollectReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tSendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tRefine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tCreateMaterialsList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tOrderMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tMaterialsDelivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tSendMessages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tSendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tCreateAttendanceList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architectLane" name="Architect">
        <bpmn:flowNodeRef>tSendDraft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friendsLane" name="Friends">
        <bpmn:flowNodeRef>tBuildHouse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="Start" name="Start house building" />
    <bpmn:task id="tCollectReq" name="Collect requirements" />
    <bpmn:task id="tSendReq" name="Send requirements to architect" />
    <bpmn:task id="tSendDraft" name="Architect sends draft" />
    <bpmn:task id="tRefine" name="Refine draft with additional requirements" />
    <bpmn:task id="tCreateMaterialsList" name="Create list of needed materials" />
    <bpmn:task id="tOrderMaterials" name="Order materials from online stores" />
    <bpmn:parallelGateway id="G1" name="Parallel split (order processing & messaging)" />
    <bpmn:task id="tMaterialsDelivered" name="Materials are delivered" />
    <bpmn:task id="tSendMessages" name="Send messages to friends to build house" />
    <bpmn:task id="tBuildHouse" name="Friends build the house" />
    <bpmn:parallelGateway id="G2" name="Parallel join" />
    <bpmn:task id="tSendInvitations" name="Send invitations for tree house party" />
    <bpmn:task id="tCreateAttendanceList" name="Create attendance list for party" />
    <bpmn:endEvent id="End" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="tCollectReq" />
    <bpmn:sequenceFlow id="f2" sourceRef="tCollectReq" targetRef="tSendReq" />
    <bpmn:sequenceFlow id="f3" sourceRef="tSendReq" targetRef="tSendDraft" />
    <bpmn:sequenceFlow id="f4" sourceRef="tSendDraft" targetRef="tRefine" />
    <bpmn:sequenceFlow id="f5" sourceRef="tRefine" targetRef="tCreateMaterialsList" />
    <bpmn:sequenceFlow id="f6" sourceRef="tCreateMaterialsList" targetRef="tOrderMaterials" />
    <bpmn:sequenceFlow id="f7" sourceRef="tOrderMaterials" targetRef="G1" />
    <bpmn:sequenceFlow id="f8" sourceRef="G1" targetRef="tMaterialsDelivered" />
    <bpmn:sequenceFlow id="f9" sourceRef="G1" targetRef="tSendMessages" />
    <bpmn:sequenceFlow id="f10" sourceRef="tSendMessages" targetRef="tBuildHouse" />
    <bpmn:sequenceFlow id="f11" sourceRef="tMaterialsDelivered" targetRef="G2" />
    <bpmn:sequenceFlow id="f12" sourceRef="tBuildHouse" targetRef="G2" />
    <bpmn:sequenceFlow id="f13" sourceRef="G2" targetRef="tSendInvitations" />
    <bpmn:sequenceFlow id="f14" sourceRef="tSendInvitations" targetRef="tCreateAttendanceList" />
    <bpmn:sequenceFlow id="f15" sourceRef="tCreateAttendanceList" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
