<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Service Organisation" processRef="FRIDGE_SERVICE_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="FRIDGE_SERVICE_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET_1">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end_no_rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end_rating</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CENTRAL" name="Central Service Center">
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FACILITY" name="Local Service Facility">
        <bpmn:flowNodeRef>t_appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_repair_possible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_leave</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="s_start" name="Fridge produces strange noises" />
    <bpmn:task id="t_describe" name="Describe symptoms and send to central service center" />
    <bpmn:task id="t_select" name="Select local service facility" />
    <bpmn:task id="t_appointment" name="Make appointment" />
    <bpmn:task id="t_arrive" name="Technician arrives" />
    <bpmn:exclusiveGateway id="g_repair_possible" name="Repair possible?" />
    <bpmn:task id="t_repair" name="Repair fridge" />
    <bpmn:task id="t_leave" name="Leave to obtain additional parts" />
    <bpmn:task id="t_confirm" name="Confirm fridge is OK" />
    <bpmn:exclusiveGateway id="g_rate" name="Rate service?" />
    <bpmn:task id="t_rate" name="Rate service facility" />
    <bpmn:endEvent id="e_end_no_rating" name="Process completed" />
    <bpmn:endEvent id="e_end_rating" name="Process completed with rating" />

    <bpmn:sequenceFlow id="f1" sourceRef="s_start" targetRef="t_describe" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_describe" targetRef="t_select" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_select" targetRef="t_appointment" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_appointment" targetRef="t_arrive" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_arrive" targetRef="g_repair_possible" />
    <bpmn:sequenceFlow id="f6_yes" name="yes" sourceRef="g_repair_possible" targetRef="t_repair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">parts available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7_no" name="no" sourceRef="g_repair_possible" targetRef="t_leave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">parts missing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" sourceRef="t_leave" targetRef="t_arrive" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_repair" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_confirm" targetRef="g_rate" />
    <bpmn:sequenceFlow id="f11_yes" name="yes" sourceRef="g_rate" targetRef="t_rate" />
    <bpmn:sequenceFlow id="f12_no" name="no" sourceRef="g_rate" targetRef="e_end_no_rating" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_rate" targetRef="e_end_rating" />
  </bpmn:process>
</bpmn:definitions>
