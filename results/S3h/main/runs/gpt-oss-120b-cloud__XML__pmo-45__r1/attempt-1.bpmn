<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="eshop" name="E‑Shop" processRef="eshop-process" />
  </bpmn:collaboration>

  <bpmn:process id="eshop-process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addToCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saveProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayShippingSame</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterBilling</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSystem" name="E‑Shop System">
        <bpmn:flowNodeRef>checkCred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finishOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitMain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinMain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayAllSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneBank" name="Bank">
        <bpmn:flowNodeRef>bankConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="start" name="Customer logs into E‑Shop system" />
    <bpmn:task id="checkCred" name="Check credentials" />
    <bpmn:exclusiveGateway id="gatewayLogin" name="Login successful?" />
    <bpmn:endEvent id="endFail" name="Shopping experience stopped" />
    <bpmn:task id="selectProduct" name="Select product" />
    <bpmn:task id="addToCart" name="Add product to shopping cart" />
    <bpmn:task id="saveProduct" name="Save product" />
    <bpmn:task id="checkAll" name="Check if all products selected" />
    <bpmn:exclusiveGateway id="gatewayAllSelected" name="All products selected?" />
    <bpmn:task id="finishOrder" name="Finish order" />
    <bpmn:parallelGateway id="splitMain" />
    <bpmn:task id="prepareShipment" name="Prepare shipment" />
    <bpmn:task id="enterPayment" name="Enter payment data" />
    <bpmn:parallelGateway id="splitPayment" />
    <bpmn:task id="waitBank" name="Wait for bank confirmation" />
    <bpmn:task id="enterShipping" name="Enter shipping address" />
    <bpmn:exclusiveGateway id="gatewayShippingSame" name="Shipping address equals billing address?" />
    <bpmn:task id="enterBilling" name="Enter billing address" />
    <bpmn:parallelGateway id="joinAddress" />
    <bpmn:task id="bankConfirm" name="Confirm payment" />
    <bpmn:task id="paymentConfirmed" name="Payment confirmed" />
    <bpmn:parallelGateway id="joinMain" />
    <bpmn:endEvent id="endSuccess" name="Order finished" />
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="sf1" sourceRef="start" targetRef="checkCred" />
    <bpmn:sequenceFlow id="sf2" sourceRef="checkCred" targetRef="gatewayLogin" />
    <bpmn:sequenceFlow id="sf3" sourceRef="gatewayLogin" name="yes" targetRef="selectProduct" />
    <bpmn:sequenceFlow id="sf4" sourceRef="gatewayLogin" name="no" targetRef="endFail" />
    <bpmn:sequenceFlow id="sf5" sourceRef="selectProduct" targetRef="addToCart" />
    <bpmn:sequenceFlow id="sf6" sourceRef="addToCart" targetRef="saveProduct" />
    <bpmn:sequenceFlow id="sf7" sourceRef="saveProduct" targetRef="checkAll" />
    <bpmn:sequenceFlow id="sf8" sourceRef="checkAll" targetRef="gatewayAllSelected" />
    <bpmn:sequenceFlow id="sf9" sourceRef="gatewayAllSelected" name="no" targetRef="selectProduct" />
    <bpmn:sequenceFlow id="sf10" sourceRef="gatewayAllSelected" name="yes" targetRef="finishOrder" />
    <bpmn:sequenceFlow id="sf11" sourceRef="finishOrder" targetRef="splitMain" />
    <bpmn:sequenceFlow id="sf12" sourceRef="splitMain" targetRef="prepareShipment" />
    <bpmn:sequenceFlow id="sf13" sourceRef="splitMain" targetRef="enterPayment" />
    <bpmn:sequenceFlow id="sf14" sourceRef="enterPayment" targetRef="splitPayment" />
    <bpmn:sequenceFlow id="sf15" sourceRef="splitPayment" targetRef="waitBank" />
    <bpmn:sequenceFlow id="sf16" sourceRef="splitPayment" targetRef="enterShipping" />
    <bpmn:sequenceFlow id="sf17" sourceRef="enterShipping" targetRef="gatewayShippingSame" />
    <bpmn:sequenceFlow id="sf18" sourceRef="gatewayShippingSame" name="no" targetRef="enterBilling" />
    <bpmn:sequenceFlow id="sf19" sourceRef="gatewayShippingSame" name="yes" targetRef="joinAddress" />
    <bpmn:sequenceFlow id="sf20" sourceRef="enterBilling" targetRef="joinAddress" />
    <bpmn:sequenceFlow id="sf21" sourceRef="waitBank" targetRef="bankConfirm" />
    <bpmn:sequenceFlow id="sf22" sourceRef="bankConfirm" targetRef="paymentConfirmed" />
    <bpmn:sequenceFlow id="sf23" sourceRef="paymentConfirmed" targetRef="joinAddress" />
    <bpmn:sequenceFlow id="sf24" sourceRef="joinAddress" targetRef="joinMain" />
    <bpmn:sequenceFlow id="sf25" sourceRef="prepareShipment" targetRef="joinMain" />
    <bpmn:sequenceFlow id="sf26" sourceRef="joinMain" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>
