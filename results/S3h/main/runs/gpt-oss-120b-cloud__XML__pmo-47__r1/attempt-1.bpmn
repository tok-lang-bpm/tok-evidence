<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org"
                     name="Sports Institute"
                     processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="userLane" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slotsFree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accountExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>logIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeRegistrationAndPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoSlots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="systemLane" name="System">
        <bpmn:flowNodeRef>systemTellCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligibleUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitActivationResponse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Events -->
    <bpmn:startEvent id="start" name="Start registration" />
    <bpmn:endEvent id="endTicket" name="Course ticket received" />
    <bpmn:endEvent id="endNoSlots" name="No slots available" />

    <!-- Tasks -->
    <bpmn:task id="selectCourse" name="Select a course" />
    <bpmn:task id="systemTellCourses" name="System tells courses and dates" />
    <bpmn:task id="selectOne" name="Select one" />
    <bpmn:task id="checkAccount" name="Check if you already have an account" />
    <bpmn:task id="logIn" name="Log into account" />
    <bpmn:task id="checkEligibility" name="Check eligibility at university" />
    <bpmn:task id="registerAccount" name="Register your account" />
    <bpmn:task id="requestActivation" name="Request an activation" />
    <bpmn:task id="waitActivationResponse" name="Wait for activation response" />
    <bpmn:task id="tweetFriends" name="Tweet to friends" />
    <bpmn:task id="completeRegistrationAndPayment"
               name="Complete registration for the course and provide payment information" />
    <bpmn:task id="receiveTicket" name="Receive course ticket" />

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="slotsFree" name="Slots free?" />
    <bpmn:exclusiveGateway id="accountExists" name="Account exists?" />
    <bpmn:exclusiveGateway id="eligibleUniversity" name="Eligible university?" />
    <bpmn:parallelGateway id="pgSplit" />
    <bpmn:parallelGateway id="pgJoin" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectCourse" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectCourse" targetRef="slotsFree" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="slotsFree" targetRef="systemTellCourses" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="slotsFree" targetRef="endNoSlots" />
    <bpmn:sequenceFlow id="f5" sourceRef="systemTellCourses" targetRef="selectOne" />
    <bpmn:sequenceFlow id="f6" sourceRef="selectOne" targetRef="checkAccount" />
    <bpmn:sequenceFlow id="f7" sourceRef="checkAccount" targetRef="accountExists" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="accountExists" targetRef="logIn" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="accountExists" targetRef="checkEligibility" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkEligibility" targetRef="eligibleUniversity" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="eligibleUniversity" targetRef="registerAccount" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="eligibleUniversity" targetRef="requestActivation" />
    <bpmn:sequenceFlow id="f13" sourceRef="registerAccount" targetRef="logIn" />
    <bpmn:sequenceFlow id="f14" sourceRef="requestActivation" targetRef="waitActivationResponse" />
    <bpmn:sequenceFlow id="f15" sourceRef="waitActivationResponse" targetRef="logIn" />
    <bpmn:sequenceFlow id="f16" sourceRef="logIn" targetRef="pgSplit" />
    <bpmn:sequenceFlow id="f17" sourceRef="pgSplit" targetRef="tweetFriends" />
    <bpmn:sequenceFlow id="f18" sourceRef="pgSplit" targetRef="completeRegistrationAndPayment" />
    <bpmn:sequenceFlow id="f19" sourceRef="tweetFriends" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f20" sourceRef="completeRegistrationAndPayment" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f21" sourceRef="pgJoin" targetRef="receiveTicket" />
    <bpmn:sequenceFlow id="f22" sourceRef="receiveTicket" targetRef="endTicket" />
  </bpmn:process>
</bpmn:definitions>
