<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="defs" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hospital" name="Hospital" processRef="process1" />
  </bpmn:collaboration>

  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="doctorLane" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_start_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prepare_impl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_wash_hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_get_sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_start_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clean_area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drape_zone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_configure_ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_put_gel_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cover_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_put_sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_position_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_position_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_vein_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_anatomic_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_doppler_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compression_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_anesthetize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_blood_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drop_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_install_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_check_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_long</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_widen_pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_advance_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_verify_flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Events -->
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:endEvent id="end" name="End" />

    <!-- Parallel split / join for preparation -->
    <bpmn:parallelGateway id="pg_start_split" />
    <bpmn:task id="t_prepare_impl" name="Prepare implements" />
    <bpmn:task id="t_wash_hands" name="Wash hands" />
    <bpmn:task id="t_get_sterile_clothes" name="Get sterile clothes" />
    <bpmn:parallelGateway id="pg_start_join" />

    <!-- Sequential preparation steps -->
    <bpmn:task id="t_clean_area" name="Clean puncture area" />
    <bpmn:task id="t_drape_zone" name="Drape puncture zone" />
    <bpmn:task id="t_configure_ultrasound" name="Configure ultrasound" />
    <bpmn:task id="t_put_gel_probe" name="Put gel in probe" />
    <bpmn:task id="t_cover_probe" name="Cover probe" />
    <bpmn:task id="t_put_sterile_gel" name="Put sterile gel" />
    <bpmn:task id="t_position_probe" name="Position probe" />
    <bpmn:task id="t_position_patient" name="Position patient" />

    <!-- Vein identification decision -->
    <bpmn:exclusiveGateway id="gw_vein_identify" name="Vein identification method" />
    <bpmn:task id="t_anatomic_id" name="Identify vein anatomic" />
    <bpmn:task id="t_doppler_id" name="Identify vein doppler" />
    <bpmn:task id="t_compression_id" name="Identify vein compression" />

    <!-- Anesthesia & puncture -->
    <bpmn:task id="t_anesthetize" name="Anesthetize patient" />
    <bpmn:task id="t_puncture" name="Puncture" />
    <bpmn:task id="t_check_blood" name="Check blood return" />
    <bpmn:exclusiveGateway id="gw_blood_correct" name="Blood return correct?" />

    <!-- After correct blood return -->
    <bpmn:task id="t_drop_probe" name="Drop probe" />
    <bpmn:task id="t_remove_syringe" name="Remove syringe" />
    <bpmn:task id="t_install_guidewire" name="Install guidewire" />
    <bpmn:task id="t_remove_trocar" name="Remove trocar" />
    <bpmn:exclusiveGateway id="gw_wire_check_method" name="Wire check method" />
    <bpmn:task id="t_check_long" name="Check wire long axis" />
    <bpmn:task id="t_check_short" name="Check wire short axis" />
    <bpmn:exclusiveGateway id="gw_wire_position" name="Wire good position?" />

    <!-- Final steps -->
    <bpmn:task id="t_widen_pathway" name="Widen pathway" />
    <bpmn:task id="t_advance_catheter" name="Advance catheter" />
    <bpmn:task id="t_remove_guidewire" name="Remove guidewire" />
    <bpmn:task id="t_verify_flow" name="Verify flow and reflow" />
    <bpmn:task id="t_check_catheter" name="Check catheter position" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="pg_start_split" />
    <bpmn:sequenceFlow id="f2" sourceRef="pg_start_split" targetRef="t_prepare_impl" />
    <bpmn:sequenceFlow id="f3" sourceRef="pg_start_split" targetRef="t_wash_hands" />
    <bpmn:sequenceFlow id="f4" sourceRef="pg_start_split" targetRef="t_get_sterile_clothes" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_prepare_impl" targetRef="pg_start_join" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_wash_hands" targetRef="pg_start_join" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_get_sterile_clothes" targetRef="pg_start_join" />
    <bpmn:sequenceFlow id="f8" sourceRef="pg_start_join" targetRef="t_clean_area" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_clean_area" targetRef="t_drape_zone" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_drape_zone" targetRef="t_configure_ultrasound" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_configure_ultrasound" targetRef="t_put_gel_probe" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_put_gel_probe" targetRef="t_cover_probe" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_cover_probe" targetRef="t_put_sterile_gel" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_put_sterile_gel" targetRef="t_position_probe" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_position_probe" targetRef="t_position_patient" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_position_patient" targetRef="gw_vein_identify" />
    <bpmn:sequenceFlow id="f17" sourceRef="gw_vein_identify" targetRef="t_anatomic_id">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">anatomic</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" sourceRef="gw_vein_identify" targetRef="t_doppler_id">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">doppler</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f19" sourceRef="gw_vein_identify" targetRef="t_compression_id">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">compression</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f20" sourceRef="t_anatomic_id" targetRef="t_anesthetize" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_doppler_id" targetRef="t_anesthetize" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_compression_id" targetRef="t_anesthetize" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_anesthetize" targetRef="t_puncture" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_puncture" targetRef="t_check_blood" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_check_blood" targetRef="gw_blood_correct" />
    <bpmn:sequenceFlow id="f26" sourceRef="gw_blood_correct" targetRef="t_drop_probe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">correct</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f27" sourceRef="gw_blood_correct" targetRef="t_puncture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not correct</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f28" sourceRef="t_drop_probe" targetRef="t_remove_syringe" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_remove_syringe" targetRef="t_install_guidewire" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_install_guidewire" targetRef="t_remove_trocar" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_remove_trocar" targetRef="gw_wire_check_method" />
    <bpmn:sequenceFlow id="f32" sourceRef="gw_wire_check_method" targetRef="t_check_long">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">long axis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f33" sourceRef="gw_wire_check_method" targetRef="t_check_short">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">short axis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f34" sourceRef="t_check_long" targetRef="gw_wire_position" />
    <bpmn:sequenceFlow id="f35" sourceRef="t_check_short" targetRef="gw_wire_position" />
    <bpmn:sequenceFlow id="f36" sourceRef="gw_wire_position" targetRef="t_widen_pathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">good</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f37" sourceRef="gw_wire_position" targetRef="t_puncture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not good</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f38" sourceRef="t_widen_pathway" targetRef="t_advance_catheter" />
    <bpmn:sequenceFlow id="f39" sourceRef="t_advance_catheter" targetRef="t_remove_guidewire" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_remove_guidewire" targetRef="t_verify_flow" />
    <bpmn:sequenceFlow id="f41" sourceRef="t_verify_flow" targetRef="t_check_catheter" />
    <bpmn:sequenceFlow id="f42" sourceRef="t_check_catheter" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
