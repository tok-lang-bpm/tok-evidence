<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order process from inquiry to confirmation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Product_inquiry" name="Product inquiry" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order process from inquiry to confirmation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve-quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales staff or customer support">
        <bpmn:flowNodeRef>collect-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address-concerns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not-interested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Sales representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="System">
        <bpmn:flowNodeRef>record-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Customer inquires about a product or service">
      <bpmn:messageEventDefinition id="inquiry-def" messageRef="Message_Product_inquiry" />
    </bpmn:startEvent>
    <bpmn:task id="approve-quote" name="Approve quote" />
    <bpmn:exclusiveGateway id="g-approved" name="Quote approved?" default="f-g-approved-declined" />
    <bpmn:endEvent id="declined" name="Process ends: quote declined" />
    <bpmn:task id="collect-info" name="Collect relevant information" />
    <bpmn:task id="address-concerns" name="Address concerns or questions" />
    <bpmn:exclusiveGateway id="g-interest" name="Customer interested?" default="f-g-interest-not-interested" />
    <bpmn:task id="guide" name="Guide customer through selecting the appropriate product or service" />
    <bpmn:endEvent id="not-interested" name="Process ends: customer not interested" />
    <bpmn:task id="quote" name="Provide quote" />
    <bpmn:task id="place-order" name="Place order" />
    <bpmn:task id="record-order" name="Record order in system" />
    <bpmn:task id="confirm" name="Send order confirmation to customer" />
    <bpmn:endEvent id="done" name="Process ends: order placed and confirmed" />
    <bpmn:sequenceFlow id="f-inquiry-collect-info" sourceRef="inquiry" targetRef="collect-info" />
    <bpmn:sequenceFlow id="f-collect-info-address-concerns" sourceRef="collect-info" targetRef="address-concerns" />
    <bpmn:sequenceFlow id="f-address-concerns-g-interest" sourceRef="address-concerns" targetRef="g-interest" />
    <bpmn:sequenceFlow id="f-g-interest-guide" name="yes" sourceRef="g-interest" targetRef="guide">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-interest-not-interested" name="no" sourceRef="g-interest" targetRef="not-interested" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approve-quote" sourceRef="quote" targetRef="approve-quote" />
    <bpmn:sequenceFlow id="f-approve-quote-g-approved" sourceRef="approve-quote" targetRef="g-approved" />
    <bpmn:sequenceFlow id="f-g-approved-place-order" name="yes" sourceRef="g-approved" targetRef="place-order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-approved-declined" name="no" sourceRef="g-approved" targetRef="declined" />
    <bpmn:sequenceFlow id="f-place-order-record-order" sourceRef="place-order" targetRef="record-order" />
    <bpmn:sequenceFlow id="f-record-order-confirm" sourceRef="record-order" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
