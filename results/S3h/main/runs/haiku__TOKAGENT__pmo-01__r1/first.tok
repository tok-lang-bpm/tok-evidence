tok 1.0 "Order process from inquiry to confirmation"

pool org "Organisation"
  lane cust "Customer"
    start inquiry "Customer inquires about a product or service" message="Product inquiry"
    task approve-quote "Approve quote"
    xor g-approved "Quote approved?"
    end declined "Process ends: quote declined"
  lane sales "Sales staff or customer support"
    task collect-info "Collect relevant information"
    task address-concerns "Address concerns or questions"
    xor g-interest "Customer interested?"
    task guide "Guide customer through selecting the appropriate product or service"
    end not-interested "Process ends: customer not interested"
  lane rep "Sales representative"
    task quote "Provide quote"
    task place-order "Place order"
  lane sys "System"
    task record-order "Record order in system"
    task confirm "Send order confirmation to customer"
    end done "Process ends: order placed and confirmed"

flow inquiry -> collect-info -> address-concerns -> g-interest
flow g-interest -> guide "yes" when=""
flow g-interest -> not-interested "no" default
flow guide -> quote -> approve-quote -> g-approved
flow g-approved -> place-order "yes" when=""
flow g-approved -> declined "no" default
flow place-order -> record-order -> confirm -> done
