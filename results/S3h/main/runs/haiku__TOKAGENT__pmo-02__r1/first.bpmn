<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="New hire process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="New hire process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-in-person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-candidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create-jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post-jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cand" name="Candidate">
        <bpmn:flowNodeRef>choose-format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Need for new hire identified" />
    <bpmn:task id="identify-need" name="Identify need for new hire" />
    <bpmn:task id="conduct-in-person" name="Conduct in-person interview" />
    <bpmn:task id="conduct-virtual" name="Conduct virtual interview" />
    <bpmn:task id="choose-candidate" name="Choose candidate" />
    <bpmn:task id="integrate" name="Integrate new hire into team" />
    <bpmn:endEvent id="e-done" name="New hire integrated into team" />
    <bpmn:task id="create-jd" name="Create job description" />
    <bpmn:task id="post-jd" name="Post job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interview" />
    <bpmn:exclusiveGateway id="g-sel" name="Candidate selected?" />
    <bpmn:task id="reject" name="Reject candidate" />
    <bpmn:endEvent id="e-rej" name="Candidate rejected" />
    <bpmn:task id="invite" name="Invite candidate to interview" />
    <bpmn:task id="extend" name="Extend offer" />
    <bpmn:exclusiveGateway id="g-neg" name="Salary negotiation needed?" />
    <bpmn:task id="negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="m-neg" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Conduct orientation" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:task id="choose-format" name="Choose interview format" />
    <bpmn:exclusiveGateway id="g-format" name="In-person or virtual?" />
    <bpmn:exclusiveGateway id="m-format" />
    <bpmn:task id="accept" name="Accept offer" />
    <bpmn:exclusiveGateway id="g-accept" name="Offer accepted?" />
    <bpmn:endEvent id="e-declined" name="Offer declined" />
    <bpmn:sequenceFlow id="f-s1-identify-need" sourceRef="s1" targetRef="identify-need" />
    <bpmn:sequenceFlow id="f-identify-need-create-jd" sourceRef="identify-need" targetRef="create-jd" />
    <bpmn:sequenceFlow id="f-create-jd-post-jd" sourceRef="create-jd" targetRef="post-jd" />
    <bpmn:sequenceFlow id="f-post-jd-collect" sourceRef="post-jd" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-g-sel" sourceRef="phone" targetRef="g-sel" />
    <bpmn:sequenceFlow id="f-g-sel-reject" name="no" sourceRef="g-sel" targetRef="reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">selected = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-sel-invite" name="yes" sourceRef="g-sel" targetRef="invite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">selected = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reject-e-rej" sourceRef="reject" targetRef="e-rej" />
    <bpmn:sequenceFlow id="f-invite-choose-format" sourceRef="invite" targetRef="choose-format" />
    <bpmn:sequenceFlow id="f-choose-format-g-format" sourceRef="choose-format" targetRef="g-format" />
    <bpmn:sequenceFlow id="f-g-format-conduct-in-person" name="in-person" sourceRef="g-format" targetRef="conduct-in-person">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">preference = "in-person"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-format-conduct-virtual" name="virtual" sourceRef="g-format" targetRef="conduct-virtual">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">preference = "virtual"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-conduct-in-person-m-format" sourceRef="conduct-in-person" targetRef="m-format" />
    <bpmn:sequenceFlow id="f-conduct-virtual-m-format" sourceRef="conduct-virtual" targetRef="m-format" />
    <bpmn:sequenceFlow id="f-m-format-choose-candidate" sourceRef="m-format" targetRef="choose-candidate" />
    <bpmn:sequenceFlow id="f-choose-candidate-extend" sourceRef="choose-candidate" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-g-neg" sourceRef="extend" targetRef="g-neg" />
    <bpmn:sequenceFlow id="f-g-neg-negotiate" name="yes" sourceRef="g-neg" targetRef="negotiate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">salary_negotiation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-neg-m-neg" name="no" sourceRef="g-neg" targetRef="m-neg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">salary_negotiation = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-negotiate-m-neg" sourceRef="negotiate" targetRef="m-neg" />
    <bpmn:sequenceFlow id="f-m-neg-accept" sourceRef="m-neg" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-g-accept" sourceRef="accept" targetRef="g-accept" />
    <bpmn:sequenceFlow id="f-g-accept-e-declined" name="no" sourceRef="g-accept" targetRef="e-declined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">offer_accepted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-accept-paperwork" name="yes" sourceRef="g-accept" targetRef="paperwork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">offer_accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-paperwork-orientation" sourceRef="paperwork" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-orientation-training" sourceRef="orientation" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-integrate" sourceRef="training" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-e-done" sourceRef="integrate" targetRef="e-done" />
  </bpmn:process>
</bpmn:definitions>
