<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Marketing campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mkt" name="Marketing team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Campaign process starts" />
    <bpmn:task id="obj" name="Define campaign objectives" />
    <bpmn:parallelGateway id="f1" />
    <bpmn:task id="content" name="Create content" />
    <bpmn:task id="visuals" name="Design visuals" />
    <bpmn:task id="channels" name="Select promotion channels" />
    <bpmn:parallelGateway id="j1" />
    <bpmn:task id="launch" name="Launch campaign" />
    <bpmn:parallelGateway id="f2" />
    <bpmn:task id="track" name="Track campaign performance in real time" />
    <bpmn:intermediateCatchEvent id="ended" name="Campaign period ends">
      <bpmn:conditionalEventDefinition id="ended-def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">campaignPeriodEnded = true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="j2" />
    <bpmn:task id="analyse" name="Analyse performance for future optimisation" />
    <bpmn:endEvent id="e" name="Process concluded" />
    <bpmn:task id="followup" name="Follow up leads" />
    <bpmn:task id="collect" name="Collect generated leads in CRM" />
    <bpmn:sequenceFlow id="f-s-obj" sourceRef="s" targetRef="obj" />
    <bpmn:sequenceFlow id="f-obj-f1" sourceRef="obj" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-content" sourceRef="f1" targetRef="content" />
    <bpmn:sequenceFlow id="f-f1-visuals" sourceRef="f1" targetRef="visuals" />
    <bpmn:sequenceFlow id="f-f1-channels" sourceRef="f1" targetRef="channels" />
    <bpmn:sequenceFlow id="f-content-j1" sourceRef="content" targetRef="j1" />
    <bpmn:sequenceFlow id="f-visuals-j1" sourceRef="visuals" targetRef="j1" />
    <bpmn:sequenceFlow id="f-channels-j1" sourceRef="channels" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-launch" sourceRef="j1" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-f2" sourceRef="launch" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-track" sourceRef="f2" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-ended" sourceRef="track" targetRef="ended" />
    <bpmn:sequenceFlow id="f-ended-j2" sourceRef="ended" targetRef="j2" />
    <bpmn:sequenceFlow id="f-f2-collect" sourceRef="f2" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-followup" sourceRef="collect" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-j2" sourceRef="followup" targetRef="j2" />
    <bpmn:sequenceFlow id="f-j2-analyse" sourceRef="j2" targetRef="analyse" />
    <bpmn:sequenceFlow id="f-analyse-e" sourceRef="analyse" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
