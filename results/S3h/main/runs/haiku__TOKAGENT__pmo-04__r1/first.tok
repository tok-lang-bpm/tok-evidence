tok 1.0 "Marketing campaign"

pool org "Company"
  lane mkt "Marketing team"
    start s "Campaign process starts"
    task obj "Define campaign objectives"
    and f1
    task content "Create content"
    task visuals "Design visuals"
    task channels "Select promotion channels"
    and j1
    task launch "Launch campaign"
    and f2
    task track "Track campaign performance in real time"
    catch ended "Campaign period ends" condition="campaignPeriodEnded = true"
    and j2
    task analyse "Analyse performance for future optimisation"
    end e "Process concluded"
  lane sales "Sales team"
    task followup "Follow up leads"
  lane crm "CRM system"
    task collect "Collect generated leads in CRM"

flow s -> obj -> f1
flow f1 -> content
flow f1 -> visuals
flow f1 -> channels
flow content -> j1
flow visuals -> j1
flow channels -> j1
flow j1 -> launch -> f2
flow f2 -> track -> ended -> j2
flow f2 -> collect -> followup -> j2
flow j2 -> analyse -> e
