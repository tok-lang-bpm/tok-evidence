<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier selection and onboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Supplier selection and onboarding" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>responses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new supplier or vendor identified" />
    <bpmn:task id="execute" name="Execute contract" />
    <bpmn:task id="rfp" name="Issue request for proposals (RFP)" />
    <bpmn:task id="responses" name="Receive responses from various suppliers" />
    <bpmn:task id="evaluate" name="Evaluate each proposal by cost, quality and delivery time" />
    <bpmn:exclusiveGateway id="site-q" name="Site visits or interviews needed?" default="f-site-q-select" />
    <bpmn:task id="visit" name="Conduct site visits or interviews with suppliers" />
    <bpmn:task id="select" name="Select supplier" />
    <bpmn:task id="negotiate" name="Negotiate contract terms" />
    <bpmn:exclusiveGateway id="agree" name="Both parties agree on terms?" default="f-agree-negotiate" />
    <bpmn:task id="sign" name="Sign contract" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="onboard" name="Onboard supplier" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="done" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f-need-rfp" sourceRef="need" targetRef="rfp" />
    <bpmn:sequenceFlow id="f-rfp-responses" sourceRef="rfp" targetRef="responses" />
    <bpmn:sequenceFlow id="f-responses-evaluate" sourceRef="responses" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-site-q" sourceRef="evaluate" targetRef="site-q" />
    <bpmn:sequenceFlow id="f-site-q-visit" name="yes" sourceRef="site-q" targetRef="visit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">siteVisitNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-site-q-select" name="no" sourceRef="site-q" targetRef="select" />
    <bpmn:sequenceFlow id="f-visit-select" sourceRef="visit" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agree" sourceRef="negotiate" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-sign" name="yes" sourceRef="agree" targetRef="sign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">termsAgreed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-agree-negotiate" name="no" sourceRef="agree" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-sign-fork" sourceRef="sign" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-onboard" sourceRef="fork" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-fork-execute" sourceRef="fork" targetRef="execute" />
    <bpmn:sequenceFlow id="f-onboard-join" sourceRef="onboard" targetRef="join" />
    <bpmn:sequenceFlow id="f-execute-join" sourceRef="execute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-done" sourceRef="join" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
