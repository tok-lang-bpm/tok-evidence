tok 1.0 "Supplier selection and onboarding"

pool org "Company"
  lane company "Company"
    start need "Need for a new supplier or vendor identified"
    task execute "Execute contract"
  lane procurement "Procurement team"
    task rfp "Issue request for proposals (RFP)"
    task responses "Receive responses from various suppliers"
    task evaluate "Evaluate each proposal by cost, quality and delivery time"
    xor site-q "Site visits or interviews needed?"
    task visit "Conduct site visits or interviews with suppliers"
    task select "Select supplier"
    task negotiate "Negotiate contract terms"
    xor agree "Both parties agree on terms?"
    task sign "Sign contract"
    and fork
    task onboard "Onboard supplier"
    and join
    end done "Supplier onboarded and contract executed"

flow need -> rfp -> responses -> evaluate -> site-q
flow site-q -> visit "yes" when="siteVisitNeeded = true"
flow site-q -> select "no" default
flow visit -> select
flow select -> negotiate -> agree
flow agree -> sign "yes" when="termsAgreed = true"
flow agree -> negotiate "no" default
flow sign -> fork
flow fork -> onboard
flow fork -> execute
flow onboard -> join
flow execute -> join
flow join -> done
