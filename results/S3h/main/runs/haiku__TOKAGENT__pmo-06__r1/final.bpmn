<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfilment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate-label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-tracking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-over</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivery-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order-start" name="Customer places order" />
    <bpmn:task id="place-order" name="Place order" />
    <bpmn:task id="generate-confirmation" name="Generate order confirmation" />
    <bpmn:task id="send-confirmation" name="Send order confirmation to customer" />
    <bpmn:task id="generate-label" name="Generate shipping label" />
    <bpmn:task id="send-tracking" name="Send tracking information to customer" />
    <bpmn:task id="pick-items" name="Pick items" />
    <bpmn:task id="pack-items" name="Pack items" />
    <bpmn:task id="hand-over" name="Hand over order to logistics provider" />
    <bpmn:task id="monitor" name="Monitor shipment" />
    <bpmn:exclusiveGateway id="delivered" name="Shipment reached customer's address?" />
    <bpmn:endEvent id="delivery-end" name="Delivery completed" />
    <bpmn:sequenceFlow id="f-order-start-place-order" sourceRef="order-start" targetRef="place-order" />
    <bpmn:sequenceFlow id="f-place-order-generate-confirmation" sourceRef="place-order" targetRef="generate-confirmation" />
    <bpmn:sequenceFlow id="f-generate-confirmation-send-confirmation" sourceRef="generate-confirmation" targetRef="send-confirmation" />
    <bpmn:sequenceFlow id="f-send-confirmation-pick-items" sourceRef="send-confirmation" targetRef="pick-items" />
    <bpmn:sequenceFlow id="f-pick-items-pack-items" sourceRef="pick-items" targetRef="pack-items" />
    <bpmn:sequenceFlow id="f-pack-items-generate-label" sourceRef="pack-items" targetRef="generate-label" />
    <bpmn:sequenceFlow id="f-generate-label-hand-over" sourceRef="generate-label" targetRef="hand-over" />
    <bpmn:sequenceFlow id="f-hand-over-send-tracking" sourceRef="hand-over" targetRef="send-tracking" />
    <bpmn:sequenceFlow id="f-send-tracking-monitor" sourceRef="send-tracking" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-delivered" sourceRef="monitor" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-delivery-end" name="yes" sourceRef="delivered" targetRef="delivery-end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-delivered-monitor" name="no" sourceRef="delivered" targetRef="monitor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="feedback-note">
      <bpmn:text>Customer feedback or returns may trigger further actions</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="feedback-note-assoc" sourceRef="feedback-note" targetRef="delivery-end" />
  </bpmn:process>
</bpmn:definitions>
