tok 1.0 "Order fulfilment"

pool shop "Online shop"
  lane customer "Customer"
    start order-start "Customer places order"
    task place-order "Place order"
  lane system "System"
    task generate-confirmation "Generate order confirmation"
    task send-confirmation "Send order confirmation to customer"
    task generate-label "Generate shipping label"
    task send-tracking "Send tracking information to customer"
  lane warehouse "Warehouse team"
    task pick-items "Pick items"
    task pack-items "Pack items"
    task hand-over "Hand over order to logistics provider"
  lane logistics "Logistics provider"
    task monitor "Monitor shipment"
    xor delivered "Shipment reached customer's address?"
    end delivery-end "Delivery completed"

flow order-start -> place-order -> generate-confirmation -> send-confirmation -> pick-items -> pack-items -> generate-label -> hand-over -> send-tracking -> monitor -> delivered
flow delivered -> delivery-end "yes" when=""
flow delivered -> monitor "no" when=""

note feedback-note "Customer feedback or returns may trigger further actions" on=delivery-end
