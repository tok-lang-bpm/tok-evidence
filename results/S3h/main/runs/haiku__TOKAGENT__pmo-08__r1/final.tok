tok 1.0 "Incident handling"

pool org "Organisation"
  lane reporter "Employee or customer"
    start s "Incident reported"
    task report "Report incident"
  lane system "Tracking system"
    task log "Log report in tracking system"
    task assign "Assign report to appropriate team"
    and close-split "Close and notify"
    task close "Close incident report"
    task notify "Notify all stakeholders"
    and close-join "Closed and notified"
    end e "Incident closed"
  lane team "Investigation team"
    task gather "Gather necessary information"
    task identify "Identify cause of incident"
    task propose "Propose corrective actions"
    xor sol "Type of solution?"
    task fix "Implement fix"
    task train "Provide training"
    task policy "Change policy"
    xor sol-join "Solution implemented"
    task followup "Perform follow-up to ensure issue does not recur"

flow s -> report -> log -> assign -> gather -> identify -> propose -> sol
flow sol -> fix "fix" when=""
flow sol -> train "training" when=""
flow sol -> policy "policy change" when=""
flow fix -> sol-join
flow train -> sol-join
flow policy -> sol-join -> followup -> close-split
flow close-split -> close -> close-join
flow close-split -> notify -> close-join -> e
