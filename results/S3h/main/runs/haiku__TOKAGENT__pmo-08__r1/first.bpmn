<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Incident handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="reporter" name="Employee or customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Tracking system">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Investigation team">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sol-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Incident reported" />
    <bpmn:task id="report" name="Report incident" />
    <bpmn:task id="log" name="Log report in tracking system" />
    <bpmn:task id="assign" name="Assign report to appropriate team" />
    <bpmn:parallelGateway id="close-split" name="Close and notify" />
    <bpmn:task id="close" name="Close incident report" />
    <bpmn:task id="notify" name="Notify all stakeholders" />
    <bpmn:parallelGateway id="close-join" name="Closed and notified" />
    <bpmn:endEvent id="e" name="Incident closed" />
    <bpmn:task id="gather" name="Gather necessary information" />
    <bpmn:task id="identify" name="Identify cause of incident" />
    <bpmn:task id="propose" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="sol" name="Type of solution?" />
    <bpmn:task id="fix" name="Implement fix" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:task id="policy" name="Change policy" />
    <bpmn:exclusiveGateway id="sol-join" name="Solution implemented" />
    <bpmn:task id="followup" name="Perform follow-up to ensure issue does not recur" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-log" sourceRef="report" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-gather" sourceRef="assign" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-identify" sourceRef="gather" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-propose" sourceRef="identify" targetRef="propose" />
    <bpmn:sequenceFlow id="f-propose-sol" sourceRef="propose" targetRef="sol" />
    <bpmn:sequenceFlow id="f-sol-fix" name="fix" sourceRef="sol" targetRef="fix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sol-train" name="training" sourceRef="sol" targetRef="train">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sol-policy" name="policy change" sourceRef="sol" targetRef="policy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fix-sol-join" sourceRef="fix" targetRef="sol-join" />
    <bpmn:sequenceFlow id="f-train-sol-join" sourceRef="train" targetRef="sol-join" />
    <bpmn:sequenceFlow id="f-policy-sol-join" sourceRef="policy" targetRef="sol-join" />
    <bpmn:sequenceFlow id="f-sol-join-followup" sourceRef="sol-join" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-close-split" sourceRef="followup" targetRef="close-split" />
    <bpmn:sequenceFlow id="f-close-split-close" sourceRef="close-split" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-close-join" sourceRef="close" targetRef="close-join" />
    <bpmn:sequenceFlow id="f-close-split-notify" sourceRef="close-split" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-close-join" sourceRef="notify" targetRef="close-join" />
    <bpmn:sequenceFlow id="f-close-join-e" sourceRef="close-join" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
