<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="New product development" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="New product development" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rd" name="R&amp;D team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Process started" />
    <bpmn:task id="identify" name="Identify idea for new or improved product" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="select" name="Select promising design" />
    <bpmn:task id="build" name="Build prototype from available materials and resources" />
    <bpmn:task id="test" name="Test prototype for functionality, safety and market potential" />
    <bpmn:task id="feedback" name="Collect feedback from testing phase" />
    <bpmn:exclusiveGateway id="refine-q" name="Refinement needed?" default="f-refine-q-outcome-q" />
    <bpmn:task id="refine" name="Refine prototype" />
    <bpmn:exclusiveGateway id="outcome-q" name="Prototype approved or discarded?" default="f-outcome-q-discarded" />
    <bpmn:endEvent id="approved" name="Prototype approved for further development" />
    <bpmn:endEvent id="discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-s-identify" sourceRef="s" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-research" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f-research-draft" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-select" sourceRef="draft" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-build" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-feedback" sourceRef="test" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-refine-q" sourceRef="feedback" targetRef="refine-q" />
    <bpmn:sequenceFlow id="f-refine-q-refine" name="yes" sourceRef="refine-q" targetRef="refine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needs-refinement = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-refine-q-outcome-q" name="no" sourceRef="refine-q" targetRef="outcome-q" />
    <bpmn:sequenceFlow id="f-refine-test" sourceRef="refine" targetRef="test" />
    <bpmn:sequenceFlow id="f-outcome-q-approved" name="approved" sourceRef="outcome-q" targetRef="approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-outcome-q-discarded" name="discarded" sourceRef="outcome-q" targetRef="discarded" />
  </bpmn:process>
</bpmn:definitions>
