tok 1.0 "New product development"

pool org "Organisation"
  lane rd "R&D team"
    start s "Process started"
    task identify "Identify idea for new or improved product"
    task research "Conduct initial research and feasibility studies"
    task draft "Draft design concepts"
    task select "Select promising design"
    task build "Build prototype from available materials and resources"
    task test "Test prototype for functionality, safety and market potential"
    task feedback "Collect feedback from testing phase"
    xor refine-q "Refinement needed?"
    task refine "Refine prototype"
    xor outcome-q "Prototype approved or discarded?"
    end approved "Prototype approved for further development"
    end discarded "Prototype discarded"

flow s -> identify -> research -> draft -> select -> build -> test -> feedback -> refine-q
flow refine-q -> refine "yes" when="needs-refinement = true"
flow refine-q -> outcome-q "no" default
flow refine -> test
flow outcome-q -> approved "approved" when="approved = true"
flow outcome-q -> discarded "discarded" default
