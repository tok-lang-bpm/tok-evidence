<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="IT solution request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="IT solution request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="req" name="Requesting department">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j-training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Request submitted" />
    <bpmn:task id="submit" name="Submit request for IT solution" />
    <bpmn:task id="assess" name="Assess request" />
    <bpmn:exclusiveGateway id="g-approved" name="Request approved?" default="f-g-approved-e-rejected" />
    <bpmn:task id="procure" name="Procure tools or licenses" />
    <bpmn:task id="install" name="Install solution" />
    <bpmn:task id="test" name="Test solution in controlled environment" />
    <bpmn:task id="rollout" name="Roll out solution to requesting department" />
    <bpmn:exclusiveGateway id="g-training" name="Training needed?" default="f-g-training-j-training" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:exclusiveGateway id="j-training" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="e-rejected" name="Request rejected" />
    <bpmn:endEvent id="e-done" name="Request fulfilled" />
    <bpmn:sequenceFlow id="f-s1-submit" sourceRef="s1" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assess" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-g-approved" sourceRef="assess" targetRef="g-approved" />
    <bpmn:sequenceFlow id="f-g-approved-procure" name="yes" sourceRef="g-approved" targetRef="procure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-approved-e-rejected" name="no" sourceRef="g-approved" targetRef="e-rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-rollout" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-rollout-g-training" sourceRef="rollout" targetRef="g-training" />
    <bpmn:sequenceFlow id="f-g-training-training" name="yes" sourceRef="g-training" targetRef="training">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">training = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-training-j-training" name="no" sourceRef="g-training" targetRef="j-training" />
    <bpmn:sequenceFlow id="f-training-j-training" sourceRef="training" targetRef="j-training" />
    <bpmn:sequenceFlow id="f-j-training-support" sourceRef="j-training" targetRef="support" />
    <bpmn:sequenceFlow id="f-support-e-done" sourceRef="support" targetRef="e-done" />
  </bpmn:process>
</bpmn:definitions>
