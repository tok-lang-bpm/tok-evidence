tok 1.0 "IT solution request"

pool org "Organisation"
  lane req "Requesting department"
    start s1 "Request submitted"
    task submit "Submit request for IT solution"
  lane it "IT"
    task assess "Assess request"
    xor g-approved "Request approved?"
    task procure "Procure tools or licenses"
    task install "Install solution"
    task test "Test solution in controlled environment"
    task rollout "Roll out solution to requesting department"
    xor g-training "Training needed?"
    task training "Provide training"
    xor j-training
    task support "Provide IT support for troubleshooting"
    end e-rejected "Request rejected"
    end e-done "Request fulfilled"

flow s1 -> submit -> assess -> g-approved
flow g-approved -> procure "yes" when="approved = true"
flow g-approved -> e-rejected "no" default
flow procure -> install -> test -> rollout -> g-training
flow g-training -> training "yes" when="training = true"
flow g-training -> j-training "no" default
flow training -> j-training
flow j-training -> support -> e-done
