<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Subscription lifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Subscription service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Subscription lifecycle" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel-q</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="System">
        <bpmn:flowNodeRef>gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-upd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sup" name="Support team">
        <bpmn:flowNodeRef>proc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terms-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Process begins" />
    <bpmn:userTask id="sign" name="Sign up for subscription service" />
    <bpmn:userTask id="info" name="Enter personal and payment information" />
    <bpmn:userTask id="cancel-req" name="Submit cancellation request" />
    <bpmn:exclusiveGateway id="cancel-q" name="Customer cancels?" default="f-cancel-q-m-bill" />
    <bpmn:task id="gen" name="Generate account" />
    <bpmn:task id="access" name="Assign access" />
    <bpmn:task id="bill" name="Trigger automated billing cycles" />
    <bpmn:exclusiveGateway id="m-bill" />
    <bpmn:exclusiveGateway id="upd-q" name="Which update?" />
    <bpmn:task id="upd" name="Send regular update" />
    <bpmn:task id="enh" name="Send product enhancement" />
    <bpmn:task id="ren" name="Send renewal notification" />
    <bpmn:exclusiveGateway id="m-upd" />
    <bpmn:task id="proc" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="terms-q" name="Refund or charge due?" default="f-terms-q-m-terms" />
    <bpmn:task id="refund" name="Apply refund" />
    <bpmn:task id="charge" name="Apply charge" />
    <bpmn:exclusiveGateway id="m-terms" />
    <bpmn:task id="deact" name="Deactivate subscription" />
    <bpmn:task id="settle" name="Settle final account balance" />
    <bpmn:endEvent id="e" name="Subscription ended" />
    <bpmn:sequenceFlow id="f-s-sign" sourceRef="s" targetRef="sign" />
    <bpmn:sequenceFlow id="f-sign-info" sourceRef="sign" targetRef="info" />
    <bpmn:sequenceFlow id="f-info-gen" sourceRef="info" targetRef="gen" />
    <bpmn:sequenceFlow id="f-gen-access" sourceRef="gen" targetRef="access" />
    <bpmn:sequenceFlow id="f-access-bill" sourceRef="access" targetRef="bill" />
    <bpmn:sequenceFlow id="f-bill-m-bill" sourceRef="bill" targetRef="m-bill" />
    <bpmn:sequenceFlow id="f-m-bill-upd-q" sourceRef="m-bill" targetRef="upd-q" />
    <bpmn:sequenceFlow id="f-upd-q-upd" name="regular" sourceRef="upd-q" targetRef="upd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-upd-q-enh" name="enhancement" sourceRef="upd-q" targetRef="enh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-upd-q-ren" name="renewal" sourceRef="upd-q" targetRef="ren">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-upd-m-upd" sourceRef="upd" targetRef="m-upd" />
    <bpmn:sequenceFlow id="f-enh-m-upd" sourceRef="enh" targetRef="m-upd" />
    <bpmn:sequenceFlow id="f-ren-m-upd" sourceRef="ren" targetRef="m-upd" />
    <bpmn:sequenceFlow id="f-m-upd-cancel-q" sourceRef="m-upd" targetRef="cancel-q" />
    <bpmn:sequenceFlow id="f-cancel-q-cancel-req" name="yes" sourceRef="cancel-q" targetRef="cancel-req">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-cancel-q-m-bill" name="no" sourceRef="cancel-q" targetRef="m-bill" />
    <bpmn:sequenceFlow id="f-cancel-req-proc" sourceRef="cancel-req" targetRef="proc" />
    <bpmn:sequenceFlow id="f-proc-terms-q" sourceRef="proc" targetRef="terms-q" />
    <bpmn:sequenceFlow id="f-terms-q-refund" name="refund" sourceRef="terms-q" targetRef="refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-terms-q-charge" name="charge" sourceRef="terms-q" targetRef="charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-terms-q-m-terms" name="none" sourceRef="terms-q" targetRef="m-terms" />
    <bpmn:sequenceFlow id="f-refund-m-terms" sourceRef="refund" targetRef="m-terms" />
    <bpmn:sequenceFlow id="f-charge-m-terms" sourceRef="charge" targetRef="m-terms" />
    <bpmn:sequenceFlow id="f-m-terms-deact" sourceRef="m-terms" targetRef="deact" />
    <bpmn:sequenceFlow id="f-deact-settle" sourceRef="deact" targetRef="settle" />
    <bpmn:sequenceFlow id="f-settle-e" sourceRef="settle" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
