tok 1.0 "Complaint handling"

pool org "Organisation"
  lane customer "Customer"
    start s "Complaint process begins"
    task file "File complaint"
    task feedback "Provide feedback on satisfaction"
    end e "Process ends"
  lane service "Customer service"
    task log "Log complaint"
    task assign "Assign complaint to department"
    xor merge
    task resolve "Mark complaint as resolved"
  lane dept "Relevant department"
    task review "Review complaint details"
    task determine "Determine validity and refund justification"
    task notify "Notify customer of decision"
    xor refund "Refund approved?"
  lane finance "Financial team"
    task reimburse "Process reimbursement"

flow s -> file -> log -> assign -> review -> determine -> notify -> refund
flow refund -> reimburse "yes" when="refund_approved = true"
flow refund -> merge "no" default
flow reimburse -> merge -> resolve -> feedback -> e
