<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Relevant department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Financial team">
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Complaint process begins" />
    <bpmn:task id="file" name="File complaint" />
    <bpmn:task id="feedback" name="Provide feedback on satisfaction" />
    <bpmn:endEvent id="e" name="Process ends" />
    <bpmn:task id="log" name="Log complaint" />
    <bpmn:task id="assign" name="Assign complaint to department" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="resolve" name="Mark complaint as resolved" />
    <bpmn:task id="review" name="Review complaint details" />
    <bpmn:task id="determine" name="Determine validity and refund justification" />
    <bpmn:task id="notify" name="Notify customer of decision" />
    <bpmn:exclusiveGateway id="refund" name="Refund approved?" default="f-refund-merge" />
    <bpmn:task id="reimburse" name="Process refund" />
    <bpmn:sequenceFlow id="f-s-file" sourceRef="s" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-log" sourceRef="file" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-review" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-determine" sourceRef="review" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-notify" sourceRef="determine" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-refund" sourceRef="notify" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-reimburse" name="yes" sourceRef="refund" targetRef="reimburse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refund_approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-refund-merge" name="no" sourceRef="refund" targetRef="merge" />
    <bpmn:sequenceFlow id="f-reimburse-merge" sourceRef="reimburse" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-resolve" sourceRef="merge" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-feedback" sourceRef="resolve" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-e" sourceRef="feedback" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
