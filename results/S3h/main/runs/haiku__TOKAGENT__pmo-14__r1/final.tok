tok 1.0 "Budget planning"

pool org "Organisation"
  lane team "Department team"
    start s "Budget process starts"
    task outline "Outline objectives for the upcoming period"
    task draft "Draft plan with cost estimates and justifications"
    task adjust "Adjust plan based on feedback"
    task document "Document adjustment"
    task implement "Implement plan"
    end e "Process ends"
  lane align "Strategic alignment meeting"
    task review-align "Review plan for alignment with organisational goals"
  lane finance "Finance department"
    task review-fin "Review budget feasibility in detail"
    xor more "Further adjustments needed?"
    task allocate "Allocate budget to department"
    task distribute "Distribute budget"
  lane stake "Stakeholders"
    task approve-adj "Approve adjustment"
    task approve "Approve final budget"

flow s -> outline -> draft -> review-align -> review-fin -> more
flow more -> adjust "yes" when="needs_adjustment = true"
flow more -> approve "no" default
flow adjust -> document -> approve-adj -> review-fin
flow approve -> allocate -> distribute -> implement -> e
