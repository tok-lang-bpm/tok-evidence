<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Budget planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Budget planning" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="team" name="Department team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="align" name="Strategic alignment meeting">
        <bpmn:flowNodeRef>review-align</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>review-fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stake" name="Stakeholders">
        <bpmn:flowNodeRef>approve-adj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Budget process starts" />
    <bpmn:task id="outline" name="Outline objectives for the upcoming period" />
    <bpmn:task id="draft" name="Draft plan with cost estimates and justifications" />
    <bpmn:task id="adjust" name="Adjust plan based on feedback" />
    <bpmn:task id="document" name="Document adjustment" />
    <bpmn:task id="implement" name="Implement plan" />
    <bpmn:endEvent id="e" name="Process ends" />
    <bpmn:task id="review-align" name="Review plan for alignment with organisational goals" />
    <bpmn:task id="review-fin" name="Review budget feasibility in detail" />
    <bpmn:exclusiveGateway id="more" name="Further adjustments needed?" default="f-more-approve" />
    <bpmn:task id="allocate" name="Allocate budget to department" />
    <bpmn:task id="distribute" name="Distribute budget" />
    <bpmn:task id="approve-adj" name="Approve adjustment" />
    <bpmn:task id="approve" name="Approve final budget" />
    <bpmn:sequenceFlow id="f-s-outline" sourceRef="s" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-review-align" sourceRef="draft" targetRef="review-align" />
    <bpmn:sequenceFlow id="f-review-align-review-fin" sourceRef="review-align" targetRef="review-fin" />
    <bpmn:sequenceFlow id="f-review-fin-more" sourceRef="review-fin" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-adjust" name="yes" sourceRef="more" targetRef="adjust">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needs_adjustment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-approve" name="no" sourceRef="more" targetRef="approve" />
    <bpmn:sequenceFlow id="f-adjust-document" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f-document-approve-adj" sourceRef="document" targetRef="approve-adj" />
    <bpmn:sequenceFlow id="f-approve-adj-review-fin" sourceRef="approve-adj" targetRef="review-fin" />
    <bpmn:sequenceFlow id="f-approve-allocate" sourceRef="approve" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-e" sourceRef="implement" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
