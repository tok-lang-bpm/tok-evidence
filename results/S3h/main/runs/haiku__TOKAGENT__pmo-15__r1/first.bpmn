<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Compliance audit and certification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit and certification" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mgmt" name="Company management">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sched</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Internal teams">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="aud" name="External auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>crit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Audit needed" />
    <bpmn:task id="sched" name="Schedule compliance audit" />
    <bpmn:task id="docs" name="Prepare documentation" />
    <bpmn:task id="evid" name="Gather evidence" />
    <bpmn:task id="self" name="Conduct self-assessment" />
    <bpmn:task id="fix" name="Make corrections and improvements" />
    <bpmn:task id="review" name="Review company processes" />
    <bpmn:task id="ident" name="Identify gaps or issues" />
    <bpmn:exclusiveGateway id="gaps" name="Gaps or issues found?" default="f-gaps-join" />
    <bpmn:exclusiveGateway id="join" />
    <bpmn:task id="final" name="Undergo final audit" />
    <bpmn:exclusiveGateway id="crit" name="All criteria met?" default="f-crit-e-no" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="e-ok" name="Certification process concluded" />
    <bpmn:endEvent id="e-no" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f-s-sched" sourceRef="s" targetRef="sched" />
    <bpmn:sequenceFlow id="f-sched-docs" sourceRef="sched" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-evid" sourceRef="docs" targetRef="evid" />
    <bpmn:sequenceFlow id="f-evid-self" sourceRef="evid" targetRef="self" />
    <bpmn:sequenceFlow id="f-self-review" sourceRef="self" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-ident" sourceRef="review" targetRef="ident" />
    <bpmn:sequenceFlow id="f-ident-gaps" sourceRef="ident" targetRef="gaps" />
    <bpmn:sequenceFlow id="f-gaps-fix" name="yes" sourceRef="gaps" targetRef="fix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">gaps_found = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gaps-join" name="no" sourceRef="gaps" targetRef="join" />
    <bpmn:sequenceFlow id="f-fix-join" sourceRef="fix" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-final" sourceRef="join" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-crit" sourceRef="final" targetRef="crit" />
    <bpmn:sequenceFlow id="f-crit-award" name="yes" sourceRef="crit" targetRef="award">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">criteria_met = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-crit-e-no" name="no" sourceRef="crit" targetRef="e-no" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-e-ok" sourceRef="issue" targetRef="e-ok" />
  </bpmn:process>
</bpmn:definitions>
