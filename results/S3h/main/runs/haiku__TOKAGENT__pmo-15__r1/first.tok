tok 1.0 "Compliance audit and certification"

pool org "Organisation"
  lane mgmt "Company management"
    start s "Audit needed"
    task sched "Schedule compliance audit"
  lane team "Internal teams"
    task docs "Prepare documentation"
    task evid "Gather evidence"
    task self "Conduct self-assessment"
    task fix "Make corrections and improvements"
  lane aud "External auditors"
    task review "Review company processes"
    task ident "Identify gaps or issues"
    xor gaps "Gaps or issues found?"
    xor join
    task final "Undergo final audit"
    xor crit "All criteria met?"
    task award "Award certification"
    task issue "Issue official documents"
    end e-ok "Certification process concluded"
    end e-no "Certification not awarded"

flow s -> sched -> docs -> evid -> self -> review -> ident -> gaps
flow gaps -> fix "yes" when="gaps_found = true"
flow gaps -> join "no" default
flow fix -> join -> final -> crit
flow crit -> award "yes" when="criteria_met = true"
flow crit -> e-no "no" default
flow award -> issue -> e-ok
