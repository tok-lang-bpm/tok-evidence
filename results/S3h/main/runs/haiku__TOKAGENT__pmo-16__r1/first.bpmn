<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Annual audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Multinational company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Audit coordinator">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>regs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central audit team">
        <bpmn:flowNodeRef>rev-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin-risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op-risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp-risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>high</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risks-m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>director-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Audit process starts" />
    <bpmn:task id="notify" name="Send notification to regional office" />
    <bpmn:parallelGateway id="fork" name="Split" />
    <bpmn:task id="prepare" name="Prepare financial statements" />
    <bpmn:task id="gather" name="Gather necessary documents" />
    <bpmn:parallelGateway id="join" name="Join" />
    <bpmn:task id="submit" name="Submit documents to central audit team" />
    <bpmn:task id="clarify" name="Provide necessary clarifications" />
    <bpmn:task id="regs" name="Check regulatory updates" />
    <bpmn:exclusiveGateway id="rev-merge" name="Merge" />
    <bpmn:task id="review" name="Review submission" />
    <bpmn:exclusiveGateway id="disc" name="Discrepancies found?" default="f-disc-risk-fork" />
    <bpmn:task id="request" name="Request clarifications from regional office" />
    <bpmn:parallelGateway id="risk-fork" name="Split" />
    <bpmn:task id="fin-risk" name="Evaluate financial risks" />
    <bpmn:task id="op-risk" name="Evaluate operational risks" />
    <bpmn:task id="comp-risk" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="risk-join" name="Join" />
    <bpmn:exclusiveGateway id="high" name="High risk identified?" default="f-high-risks-m" />
    <bpmn:subProcess id="invest" name="Conduct detailed investigation">
      <bpmn:startEvent id="i-s" name="Investigation starts" />
      <bpmn:task id="analyse" name="Analyse data" />
      <bpmn:task id="interview" name="Conduct interviews" />
      <bpmn:exclusiveGateway id="site" name="Site visit required?" default="f-site-site-m" />
      <bpmn:task id="visit" name="Carry out site visit" />
      <bpmn:exclusiveGateway id="site-m" name="Merge" />
      <bpmn:endEvent id="i-e" name="Investigation ends" />
      <bpmn:sequenceFlow id="f-i-s-analyse" sourceRef="i-s" targetRef="analyse" />
      <bpmn:sequenceFlow id="f-analyse-interview" sourceRef="analyse" targetRef="interview" />
      <bpmn:sequenceFlow id="f-interview-site" sourceRef="interview" targetRef="site" />
      <bpmn:sequenceFlow id="f-site-visit" name="yes" sourceRef="site" targetRef="visit">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">site_visit_required = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f-site-site-m" name="no" sourceRef="site" targetRef="site-m" />
      <bpmn:sequenceFlow id="f-visit-site-m" sourceRef="visit" targetRef="site-m" />
      <bpmn:sequenceFlow id="f-site-m-i-e" sourceRef="site-m" targetRef="i-e" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="risks-m" name="Merge" />
    <bpmn:task id="compile" name="Compile audit report" />
    <bpmn:task id="distribute" name="Distribute final report to executive board" />
    <bpmn:task id="archive" name="Archive final report" />
    <bpmn:task id="revise" name="Update report with revisions" />
    <bpmn:task id="resubmit" name="Resubmit report to audit director" />
    <bpmn:endEvent id="done" name="Audit process closed" />
    <bpmn:task id="director-review" name="Review audit report" />
    <bpmn:exclusiveGateway id="approve" name="Report approved?" default="f-approve-revise" />
    <bpmn:sequenceFlow id="f-s-notify" sourceRef="s" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-fork" sourceRef="notify" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-prepare" sourceRef="fork" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-fork-regs" sourceRef="fork" targetRef="regs" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-join" sourceRef="gather" targetRef="join" />
    <bpmn:sequenceFlow id="f-regs-join" sourceRef="regs" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-submit" sourceRef="join" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-rev-merge" sourceRef="submit" targetRef="rev-merge" />
    <bpmn:sequenceFlow id="f-rev-merge-review" sourceRef="rev-merge" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-disc" sourceRef="review" targetRef="disc" />
    <bpmn:sequenceFlow id="f-disc-request" name="yes" sourceRef="disc" targetRef="request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">discrepancies_found = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-request-clarify" sourceRef="request" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-rev-merge" sourceRef="clarify" targetRef="rev-merge" />
    <bpmn:sequenceFlow id="f-disc-risk-fork" name="no" sourceRef="disc" targetRef="risk-fork" />
    <bpmn:sequenceFlow id="f-risk-fork-fin-risk" sourceRef="risk-fork" targetRef="fin-risk" />
    <bpmn:sequenceFlow id="f-risk-fork-op-risk" sourceRef="risk-fork" targetRef="op-risk" />
    <bpmn:sequenceFlow id="f-risk-fork-comp-risk" sourceRef="risk-fork" targetRef="comp-risk" />
    <bpmn:sequenceFlow id="f-fin-risk-risk-join" sourceRef="fin-risk" targetRef="risk-join" />
    <bpmn:sequenceFlow id="f-op-risk-risk-join" sourceRef="op-risk" targetRef="risk-join" />
    <bpmn:sequenceFlow id="f-comp-risk-risk-join" sourceRef="comp-risk" targetRef="risk-join" />
    <bpmn:sequenceFlow id="f-risk-join-high" sourceRef="risk-join" targetRef="high" />
    <bpmn:sequenceFlow id="f-high-invest" name="yes" sourceRef="high" targetRef="invest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">high_risk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-high-risks-m" name="no" sourceRef="high" targetRef="risks-m" />
    <bpmn:sequenceFlow id="f-invest-risks-m" sourceRef="invest" targetRef="risks-m" />
    <bpmn:sequenceFlow id="f-risks-m-compile" sourceRef="risks-m" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compile-director-review" sourceRef="compile" targetRef="director-review" />
    <bpmn:sequenceFlow id="f-director-review-approve" sourceRef="director-review" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-distribute" name="approved" sourceRef="approve" targetRef="distribute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">report_approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-approve-revise" name="revisions required" sourceRef="approve" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-resubmit" sourceRef="revise" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f-resubmit-director-review" sourceRef="resubmit" targetRef="director-review" />
    <bpmn:sequenceFlow id="f-distribute-archive" sourceRef="distribute" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-done" sourceRef="archive" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
