<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="uni" name="University" processRef="uni-process" />
  </bpmn:collaboration>
  <bpmn:process id="uni-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="uni-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel-timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain-id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-sem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin-classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-grv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-grv-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions office">
        <bpmn:flowNodeRef>review-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-onb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-onb-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-intl-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post-grades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Admissions committee">
        <bpmn:flowNodeRef>evaluate-app</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>process-fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT department">
        <bpmn:flowNodeRef>setup-accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="intl" name="International student office">
        <bpmn:flowNodeRef>assist-visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals" name="Appeals committee">
        <bpmn:flowNodeRef>meet-appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await-decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="apply" name="Start of enrollment" />
    <bpmn:task id="submit-app" name="Submit application online" />
    <bpmn:task id="provide-items" name="Provide missing items" />
    <bpmn:task id="confirm" name="Confirm enrollment by the deadline" />
    <bpmn:boundaryEvent id="cancel-timer" name="Deadline passed" attachedToRef="confirm">
      <bpmn:documentation>The deadline duration is not given in the text; P30D is a placeholder.</bpmn:documentation>
      <bpmn:timerEventDefinition id="cancel-timer-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="end-canceled" name="Application canceled" />
    <bpmn:task id="obtain-id" name="Obtain student ID card" />
    <bpmn:subProcess id="plan" name="Create study plan">
      <bpmn:startEvent id="plan-start" name="Study plan starts" />
      <bpmn:task id="meet-advisor" name="Meet with academic advisor" />
      <bpmn:task id="select-courses" name="Select courses" />
      <bpmn:task id="resolve-conflicts" name="Resolve schedule conflicts" />
      <bpmn:endEvent id="plan-end" name="Study plan done" />
      <bpmn:sequenceFlow id="f-plan-start-meet-advisor" sourceRef="plan-start" targetRef="meet-advisor" />
      <bpmn:sequenceFlow id="f-meet-advisor-select-courses" sourceRef="meet-advisor" targetRef="select-courses" />
      <bpmn:sequenceFlow id="f-select-courses-resolve-conflicts" sourceRef="select-courses" targetRef="resolve-conflicts" />
      <bpmn:sequenceFlow id="f-resolve-conflicts-plan-end" sourceRef="resolve-conflicts" targetRef="plan-end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="g-sem" />
    <bpmn:task id="begin-classes" name="Begin attending classes" />
    <bpmn:task id="add-drop" name="Add or drop courses in the add/drop period" />
    <bpmn:task id="review-grades" name="Review grades online" />
    <bpmn:exclusiveGateway id="g-grv" name="Grievance filed?" default="f-g-grv-g-grv-join" />
    <bpmn:task id="submit-appeal" name="Submit appeal form" />
    <bpmn:exclusiveGateway id="g-grv-join" />
    <bpmn:exclusiveGateway id="g-end" name="Graduates or withdraws?" default="f-g-end-g-sem" />
    <bpmn:endEvent id="end-graduated" name="Student graduates" />
    <bpmn:endEvent id="end-withdrawn" name="Student withdraws" />
    <bpmn:task id="review-docs" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="g-docs" name="All documents received?" default="f-g-docs-notify-missing" />
    <bpmn:task id="notify-missing" name="Notify applicant of missing items" />
    <bpmn:parallelGateway id="g-fork" />
    <bpmn:parallelGateway id="g-join" />
    <bpmn:exclusiveGateway id="g-accept" name="Application accepted?" default="f-g-accept-send-reject" />
    <bpmn:task id="send-accept" name="Send acceptance letter" />
    <bpmn:task id="send-reject" name="Send rejection letter" />
    <bpmn:endEvent id="end-rejected" name="Application rejected" />
    <bpmn:parallelGateway id="g-onb" />
    <bpmn:task id="send-orient" name="Send orientation materials" />
    <bpmn:parallelGateway id="g-onb-join" />
    <bpmn:exclusiveGateway id="g-intl" name="International student?" default="f-g-intl-g-intl-join" />
    <bpmn:exclusiveGateway id="g-intl-join" />
    <bpmn:task id="post-grades" name="Post grades">
      <bpmn:documentation>The text does not name the actor for posting grades; placed with the admissions office.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="evaluate-app" name="Evaluate application" />
    <bpmn:task id="process-fees" name="Process application fees or waivers" />
    <bpmn:task id="setup-accounts" name="Set up student accounts for email, online portals and library access" />
    <bpmn:task id="assist-visa" name="Assist with visa processing" />
    <bpmn:task id="meet-appeals" name="Meet with appeals committee" />
    <bpmn:task id="await-decision" name="Await decision" />
    <bpmn:sequenceFlow id="f-apply-submit-app" sourceRef="apply" targetRef="submit-app" />
    <bpmn:sequenceFlow id="f-submit-app-review-docs" sourceRef="submit-app" targetRef="review-docs" />
    <bpmn:sequenceFlow id="f-review-docs-g-docs" sourceRef="review-docs" targetRef="g-docs" />
    <bpmn:sequenceFlow id="f-g-docs-g-fork" name="Yes" sourceRef="g-docs" targetRef="g-fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allDocuments = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-docs-notify-missing" name="No" sourceRef="g-docs" targetRef="notify-missing" />
    <bpmn:sequenceFlow id="f-notify-missing-provide-items" sourceRef="notify-missing" targetRef="provide-items" />
    <bpmn:sequenceFlow id="f-provide-items-review-docs" sourceRef="provide-items" targetRef="review-docs" />
    <bpmn:sequenceFlow id="f-g-fork-evaluate-app" sourceRef="g-fork" targetRef="evaluate-app" />
    <bpmn:sequenceFlow id="f-evaluate-app-g-join" sourceRef="evaluate-app" targetRef="g-join" />
    <bpmn:sequenceFlow id="f-g-fork-process-fees" sourceRef="g-fork" targetRef="process-fees" />
    <bpmn:sequenceFlow id="f-process-fees-g-join" sourceRef="process-fees" targetRef="g-join" />
    <bpmn:sequenceFlow id="f-g-join-g-accept" sourceRef="g-join" targetRef="g-accept" />
    <bpmn:sequenceFlow id="f-g-accept-send-accept" name="Yes" sourceRef="g-accept" targetRef="send-accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-accept-send-reject" name="No" sourceRef="g-accept" targetRef="send-reject" />
    <bpmn:sequenceFlow id="f-send-reject-end-rejected" sourceRef="send-reject" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="f-send-accept-confirm" sourceRef="send-accept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-g-onb" sourceRef="confirm" targetRef="g-onb" />
    <bpmn:sequenceFlow id="f-cancel-timer-end-canceled" sourceRef="cancel-timer" targetRef="end-canceled" />
    <bpmn:sequenceFlow id="f-g-onb-send-orient" sourceRef="g-onb" targetRef="send-orient" />
    <bpmn:sequenceFlow id="f-send-orient-g-onb-join" sourceRef="send-orient" targetRef="g-onb-join" />
    <bpmn:sequenceFlow id="f-g-onb-setup-accounts" sourceRef="g-onb" targetRef="setup-accounts" />
    <bpmn:sequenceFlow id="f-setup-accounts-g-onb-join" sourceRef="setup-accounts" targetRef="g-onb-join" />
    <bpmn:sequenceFlow id="f-g-onb-join-g-intl" sourceRef="g-onb-join" targetRef="g-intl" />
    <bpmn:sequenceFlow id="f-g-intl-assist-visa" name="Yes" sourceRef="g-intl" targetRef="assist-visa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-intl-g-intl-join" name="No" sourceRef="g-intl" targetRef="g-intl-join" />
    <bpmn:sequenceFlow id="f-assist-visa-g-intl-join" sourceRef="assist-visa" targetRef="g-intl-join" />
    <bpmn:sequenceFlow id="f-g-intl-join-obtain-id" sourceRef="g-intl-join" targetRef="obtain-id" />
    <bpmn:sequenceFlow id="f-obtain-id-plan" sourceRef="obtain-id" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-g-sem" sourceRef="plan" targetRef="g-sem" />
    <bpmn:sequenceFlow id="f-g-sem-begin-classes" sourceRef="g-sem" targetRef="begin-classes" />
    <bpmn:sequenceFlow id="f-begin-classes-add-drop" sourceRef="begin-classes" targetRef="add-drop" />
    <bpmn:sequenceFlow id="f-add-drop-post-grades" sourceRef="add-drop" targetRef="post-grades" />
    <bpmn:sequenceFlow id="f-post-grades-review-grades" sourceRef="post-grades" targetRef="review-grades" />
    <bpmn:sequenceFlow id="f-review-grades-g-grv" sourceRef="review-grades" targetRef="g-grv" />
    <bpmn:sequenceFlow id="f-g-grv-submit-appeal" name="Yes" sourceRef="g-grv" targetRef="submit-appeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-submit-appeal-meet-appeals" sourceRef="submit-appeal" targetRef="meet-appeals" />
    <bpmn:sequenceFlow id="f-meet-appeals-await-decision" sourceRef="meet-appeals" targetRef="await-decision" />
    <bpmn:sequenceFlow id="f-await-decision-g-grv-join" sourceRef="await-decision" targetRef="g-grv-join" />
    <bpmn:sequenceFlow id="f-g-grv-g-grv-join" name="No" sourceRef="g-grv" targetRef="g-grv-join" />
    <bpmn:sequenceFlow id="f-g-grv-join-g-end" sourceRef="g-grv-join" targetRef="g-end" />
    <bpmn:sequenceFlow id="f-g-end-g-sem" name="Continues" sourceRef="g-end" targetRef="g-sem" />
    <bpmn:sequenceFlow id="f-g-end-end-graduated" name="Graduates" sourceRef="g-end" targetRef="end-graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">graduated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-end-end-withdrawn" name="Withdraws" sourceRef="g-end" targetRef="end-withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">withdrawn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
