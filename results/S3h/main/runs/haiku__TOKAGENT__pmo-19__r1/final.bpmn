<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Online shop purchase" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="User">
        <bpmn:flowNodeRef>order-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>set-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return-items</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop-team" name="Shop">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order-start" name="Order started" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="split-1" name="Start in parallel" />
    <bpmn:task id="select-items" name="Select items to purchase" />
    <bpmn:task id="set-payment" name="Set payment method" />
    <bpmn:task id="choose-reward" name="Choose free reward option" />
    <bpmn:exclusiveGateway id="pay-choice" name="Pay or installment agreement?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="pay-merge" name="Payment completed" />
    <bpmn:parallelGateway id="join-1" name="Join in parallel" />
    <bpmn:task id="return-items" name="Return items for exchange" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="returned" name="Items returned?" />
    <bpmn:endEvent id="order-end" name="Order completed" />
    <bpmn:sequenceFlow id="f-order-start-login" sourceRef="order-start" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split-1" sourceRef="login" targetRef="split-1" />
    <bpmn:sequenceFlow id="f-split-1-select-items" sourceRef="split-1" targetRef="select-items" />
    <bpmn:sequenceFlow id="f-select-items-choose-reward" sourceRef="select-items" targetRef="choose-reward" />
    <bpmn:sequenceFlow id="f-choose-reward-join-1" sourceRef="choose-reward" targetRef="join-1" />
    <bpmn:sequenceFlow id="f-split-1-set-payment" sourceRef="split-1" targetRef="set-payment" />
    <bpmn:sequenceFlow id="f-set-payment-pay-choice" sourceRef="set-payment" targetRef="pay-choice" />
    <bpmn:sequenceFlow id="f-pay-choice-pay" name="pay" sourceRef="pay-choice" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-choice-installment" name="installment agreement" sourceRef="pay-choice" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-pay-merge" sourceRef="pay" targetRef="pay-merge" />
    <bpmn:sequenceFlow id="f-installment-pay-merge" sourceRef="installment" targetRef="pay-merge" />
    <bpmn:sequenceFlow id="f-pay-merge-join-1" sourceRef="pay-merge" targetRef="join-1" />
    <bpmn:sequenceFlow id="f-join-1-deliver" sourceRef="join-1" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-returned" sourceRef="deliver" targetRef="returned" />
    <bpmn:sequenceFlow id="f-returned-return-items" name="yes" sourceRef="returned" targetRef="return-items" />
    <bpmn:sequenceFlow id="f-returned-order-end" name="no" sourceRef="returned" targetRef="order-end" />
    <bpmn:sequenceFlow id="f-return-items-deliver" sourceRef="return-items" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
