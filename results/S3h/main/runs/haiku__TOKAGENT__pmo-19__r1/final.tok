tok 1.0 "Online shop purchase"

pool shop "Online shop"
  lane customer "User"
    start order-start "Order started"
    task login "Log in to account"
    and split-1 "Start in parallel"
    task select-items "Select items to purchase"
    task set-payment "Set payment method"
    task choose-reward "Choose free reward option"
    xor pay-choice "Pay or installment agreement?"
    task pay "Pay"
    task installment "Complete installment agreement"
    xor pay-merge "Payment completed"
    and join-1 "Join in parallel"
    task return-items "Return items for exchange"
  lane shop-team "Shop"
    task deliver "Deliver items"
    xor returned "Items returned?"
    end order-end "Order completed"

flow order-start -> login -> split-1
flow split-1 -> select-items -> choose-reward -> join-1
flow split-1 -> set-payment -> pay-choice
flow pay-choice -> pay "pay"
flow pay-choice -> installment "installment agreement"
flow pay -> pay-merge
flow installment -> pay-merge -> join-1 -> deliver -> returned
flow returned -> return-items "yes"
flow returned -> order-end "no"
flow return-items -> deliver
