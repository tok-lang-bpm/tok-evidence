<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Shipping of goods" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Shipping of goods" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sec" name="Secretary">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no-ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Logistics department head">
        <bpmn:flowNodeRef>ins-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ins-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wh" name="Warehousemen">
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Goods to be shipped" />
    <bpmn:exclusiveGateway id="ship-q" name="Goods shall be shipped?" default="f-ship-q-no-ship" />
    <bpmn:endEvent id="no-ship" name="No shipment" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="amount-q" name="Large amounts?" default="f-amount-q-post" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one logistic company" />
    <bpmn:task id="post" name="Use normal post shipment" />
    <bpmn:exclusiveGateway id="method-join" />
    <bpmn:parallelGateway id="work-split" />
    <bpmn:task id="label" name="Write package label" />
    <bpmn:exclusiveGateway id="ins-q" name="Parcel insurance necessary?" default="f-ins-q-ins-join" />
    <bpmn:task id="insure" name="Take out parcel insurance" />
    <bpmn:exclusiveGateway id="ins-join" />
    <bpmn:task id="package" name="Package goods" />
    <bpmn:parallelGateway id="work-join" />
    <bpmn:task id="prepare" name="Prepare packaged goods for pickup by logistic company" />
    <bpmn:endEvent id="done" name="Goods ready for pickup" />
    <bpmn:sequenceFlow id="f-s0-ship-q" sourceRef="s0" targetRef="ship-q" />
    <bpmn:sequenceFlow id="f-ship-q-clarify" name="yes" sourceRef="ship-q" targetRef="clarify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ship-q-no-ship" name="no" sourceRef="ship-q" targetRef="no-ship" />
    <bpmn:sequenceFlow id="f-clarify-amount-q" sourceRef="clarify" targetRef="amount-q" />
    <bpmn:sequenceFlow id="f-amount-q-invite" name="large" sourceRef="amount-q" targetRef="invite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-amount-q-post" name="small" sourceRef="amount-q" targetRef="post" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-method-join" sourceRef="select" targetRef="method-join" />
    <bpmn:sequenceFlow id="f-post-method-join" sourceRef="post" targetRef="method-join" />
    <bpmn:sequenceFlow id="f-method-join-work-split" sourceRef="method-join" targetRef="work-split" />
    <bpmn:sequenceFlow id="f-work-split-label" sourceRef="work-split" targetRef="label" />
    <bpmn:sequenceFlow id="f-work-split-package" sourceRef="work-split" targetRef="package" />
    <bpmn:sequenceFlow id="f-label-ins-q" sourceRef="label" targetRef="ins-q" />
    <bpmn:sequenceFlow id="f-ins-q-insure" name="yes" sourceRef="ins-q" targetRef="insure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ins-q-ins-join" name="no" sourceRef="ins-q" targetRef="ins-join" />
    <bpmn:sequenceFlow id="f-insure-ins-join" sourceRef="insure" targetRef="ins-join" />
    <bpmn:sequenceFlow id="f-ins-join-work-join" sourceRef="ins-join" targetRef="work-join" />
    <bpmn:sequenceFlow id="f-package-work-join" sourceRef="package" targetRef="work-join" />
    <bpmn:sequenceFlow id="f-work-join-prepare" sourceRef="work-join" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-done" sourceRef="prepare" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
