tok 1.0 "Shipping of goods"
pool org "Organisation"
  lane sec "Secretary"
    start s0 "Goods to be shipped"
    xor ship-q "Goods shall be shipped?"
    end no-ship "No shipment"
    task clarify "Clarify who will do the shipping"
    xor amount-q "Large amounts?"
    task invite "Invite three logistic companies to make offers"
    task select "Select one logistic company"
    task post "Use normal post shipment"
    xor method-join
    and work-split
    task label "Write package label"
  lane head "Logistics department head"
    xor ins-q "Parcel insurance necessary?"
    task insure "Take out parcel insurance"
    xor ins-join
  lane wh "Warehousemen"
    task package "Package goods"
    and work-join
    task prepare "Prepare packaged goods for pickup by logistic company"
    end done "Goods ready for pickup"

flow s0 -> ship-q
flow ship-q -> clarify "yes" when=""
flow ship-q -> no-ship "no" default
flow clarify -> amount-q
flow amount-q -> invite "large" when=""
flow amount-q -> post "small" default
flow invite -> select
flow select -> method-join
flow post -> method-join
flow method-join -> work-split
flow work-split -> label
flow work-split -> package
flow label -> ins-q
flow ins-q -> insure "yes" when=""
flow ins-q -> ins-join "no" default
flow insure -> ins-join
flow ins-join -> work-join
flow package -> work-join
flow work-join -> prepare
flow prepare -> done
