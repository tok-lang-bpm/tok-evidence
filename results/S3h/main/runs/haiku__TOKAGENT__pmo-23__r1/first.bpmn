<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>s-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c-check-later</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c-view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="banking" name="Banking system">
        <bpmn:flowNodeRef>b-send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b-receive-delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b-display-delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b-receive-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b-present</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Credit agency">
        <bpmn:flowNodeRef>a-level1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a-immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a-return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a-inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a-level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a-send-result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s-request" name="Credit scoring requested" />
    <bpmn:task id="c-check-later" name="Check again later" />
    <bpmn:task id="c-view" name="View result at frontend" />
    <bpmn:endEvent id="e-done" name="Credit scoring completed" />
    <bpmn:task id="b-send" name="Send scoring request to agency" />
    <bpmn:task id="b-receive-delay" name="Receive delay information" />
    <bpmn:task id="b-display-delay" name="Display delay message to clerk" />
    <bpmn:task id="b-receive-result" name="Receive scoring result" />
    <bpmn:exclusiveGateway id="m-result" />
    <bpmn:parallelGateway id="j-result" />
    <bpmn:task id="b-present" name="Present result to clerk" />
    <bpmn:task id="a-level1" name="Perform level 1 scoring" />
    <bpmn:exclusiveGateway id="a-immediate" name="Result determined immediately?" default="f-a-immediate-a-inform" />
    <bpmn:task id="a-return" name="Return result to banking system" />
    <bpmn:task id="a-inform" name="Inform banking system of delay" />
    <bpmn:parallelGateway id="a-split" />
    <bpmn:task id="a-level2" name="Perform level 2 scoring" />
    <bpmn:task id="a-send-result" name="Send scoring result to banking system" />
    <bpmn:sequenceFlow id="f-s-request-b-send" sourceRef="s-request" targetRef="b-send" />
    <bpmn:sequenceFlow id="f-b-send-a-level1" sourceRef="b-send" targetRef="a-level1" />
    <bpmn:sequenceFlow id="f-a-level1-a-immediate" sourceRef="a-level1" targetRef="a-immediate" />
    <bpmn:sequenceFlow id="f-a-immediate-a-return" name="yes" sourceRef="a-immediate" targetRef="a-return">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-a-immediate-a-inform" name="no" sourceRef="a-immediate" targetRef="a-inform" />
    <bpmn:sequenceFlow id="f-a-return-m-result" sourceRef="a-return" targetRef="m-result" />
    <bpmn:sequenceFlow id="f-a-inform-a-split" sourceRef="a-inform" targetRef="a-split" />
    <bpmn:sequenceFlow id="f-a-split-b-receive-delay" sourceRef="a-split" targetRef="b-receive-delay" />
    <bpmn:sequenceFlow id="f-b-receive-delay-b-display-delay" sourceRef="b-receive-delay" targetRef="b-display-delay" />
    <bpmn:sequenceFlow id="f-b-display-delay-c-check-later" sourceRef="b-display-delay" targetRef="c-check-later" />
    <bpmn:sequenceFlow id="f-c-check-later-j-result" sourceRef="c-check-later" targetRef="j-result" />
    <bpmn:sequenceFlow id="f-a-split-a-level2" sourceRef="a-split" targetRef="a-level2" />
    <bpmn:sequenceFlow id="f-a-level2-a-send-result" sourceRef="a-level2" targetRef="a-send-result" />
    <bpmn:sequenceFlow id="f-a-send-result-b-receive-result" sourceRef="a-send-result" targetRef="b-receive-result" />
    <bpmn:sequenceFlow id="f-b-receive-result-j-result" sourceRef="b-receive-result" targetRef="j-result" />
    <bpmn:sequenceFlow id="f-j-result-m-result" sourceRef="j-result" targetRef="m-result" />
    <bpmn:sequenceFlow id="f-m-result-b-present" sourceRef="m-result" targetRef="b-present" />
    <bpmn:sequenceFlow id="f-b-present-c-view" sourceRef="b-present" targetRef="c-view" />
    <bpmn:sequenceFlow id="f-c-view-e-done" sourceRef="c-view" targetRef="e-done" />
  </bpmn:process>
</bpmn:definitions>
