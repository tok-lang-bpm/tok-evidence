tok 1.0 "Restaurant meal order"

pool rest "Restaurant"
  lane guest "Guest"
    start gs "Guest feels hungry"
    task g1 "Enter restaurant"
    task g2 "Choose dish from meal range"
    task g3 "Wait until it is his turn"
    task g4 "Place order with employee"
    task g5 "Find out that meal is ready"
    xor m2
    xor xg1 "Guest reacts to buzzer?"
    task g6 "Pick up meal at service hatch"
    task g7 "Eat meal"
    end ge "Meal eaten"
  lane emp "Employee"
    task e1 "Enter order into POS system"
    task e2 "Collect payment from guest"
    task e3 "Set up buzzer"
    task e4 "Hand over buzzer to guest" doc="Information given with the buzzer: 'When the buzzer rings, your dinner is ready'"
    task e5 "Inform chef of new meal order"
    task e6 "Set off guest's buzzer"
    catch t1 "Wait 5 minutes" timer=PT5M
    task e8 "Call for guest"
    task e7 "Hand over meal to guest"
  lane chef "Chef"
    task c1 "Prepare meal"
    task c2 "Place meal in service hatch"
    task c3 "Inform employee that meal is in service hatch"

flow gs -> g1 -> g2 -> g3 -> g4 -> e1 -> e2 -> e3 -> e4 -> e5 -> c1 -> c2 -> c3 -> e6 -> g5 -> m2 -> xg1
flow xg1 -> g6 "yes" when=""
flow xg1 -> t1 "no" default
flow t1 -> e8 -> m2
flow g6 -> e7 -> g7 -> ge
