<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Restaurant meal order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="rest" name="Restaurant" processRef="rest-process" />
  </bpmn:collaboration>
  <bpmn:process id="rest-process" name="Restaurant meal order" isExecutable="false">
    <bpmn:laneSet id="rest-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="emp" name="Employee">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="gs" name="Guest feels hungry" />
    <bpmn:task id="g1" name="Enter restaurant" />
    <bpmn:task id="g2" name="Choose dish from meal range" />
    <bpmn:task id="g3" name="Wait until it is his turn" />
    <bpmn:task id="g4" name="Place order with employee" />
    <bpmn:task id="g5" name="Find out that meal is ready" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:exclusiveGateway id="xg1" name="Guest reacts to buzzer?" default="f-xg1-t1" />
    <bpmn:task id="g6" name="Pick up meal at service hatch" />
    <bpmn:task id="g7" name="Eat meal" />
    <bpmn:endEvent id="ge" name="Meal eaten" />
    <bpmn:task id="e1" name="Enter order into POS system" />
    <bpmn:task id="e2" name="Collect payment from guest" />
    <bpmn:task id="e3" name="Set up buzzer" />
    <bpmn:task id="e4" name="Hand over buzzer to guest">
      <bpmn:documentation>Information given with the buzzer: 'When the buzzer rings, your dinner is ready'</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="e5" name="Inform chef of new meal order" />
    <bpmn:task id="e6" name="Set off guest's buzzer" />
    <bpmn:intermediateCatchEvent id="t1" name="Wait 5 minutes">
      <bpmn:timerEventDefinition id="t1-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="e8" name="Call for guest" />
    <bpmn:task id="e7" name="Hand over meal to guest" />
    <bpmn:task id="c1" name="Prepare meal" />
    <bpmn:task id="c2" name="Place meal in service hatch" />
    <bpmn:task id="c3" name="Inform employee that meal is in service hatch" />
    <bpmn:sequenceFlow id="f-gs-g1" sourceRef="gs" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-g2" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-g3" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-g4" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-e1" sourceRef="g4" targetRef="e1" />
    <bpmn:sequenceFlow id="f-e1-e2" sourceRef="e1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-e2-e3" sourceRef="e2" targetRef="e3" />
    <bpmn:sequenceFlow id="f-e3-e4" sourceRef="e3" targetRef="e4" />
    <bpmn:sequenceFlow id="f-e4-e5" sourceRef="e4" targetRef="e5" />
    <bpmn:sequenceFlow id="f-e5-c1" sourceRef="e5" targetRef="c1" />
    <bpmn:sequenceFlow id="f-c1-c2" sourceRef="c1" targetRef="c2" />
    <bpmn:sequenceFlow id="f-c2-c3" sourceRef="c2" targetRef="c3" />
    <bpmn:sequenceFlow id="f-c3-e6" sourceRef="c3" targetRef="e6" />
    <bpmn:sequenceFlow id="f-e6-g5" sourceRef="e6" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-m2" sourceRef="g5" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-xg1" sourceRef="m2" targetRef="xg1" />
    <bpmn:sequenceFlow id="f-xg1-g6" name="yes" sourceRef="xg1" targetRef="g6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xg1-t1" name="no" sourceRef="xg1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-e8" sourceRef="t1" targetRef="e8" />
    <bpmn:sequenceFlow id="f-e8-m2" sourceRef="e8" targetRef="m2" />
    <bpmn:sequenceFlow id="f-g6-e7" sourceRef="g6" targetRef="e7" />
    <bpmn:sequenceFlow id="f-e7-g7" sourceRef="e7" targetRef="g7" />
    <bpmn:sequenceFlow id="f-g7-ge" sourceRef="g7" targetRef="ge" />
  </bpmn:process>
</bpmn:definitions>
