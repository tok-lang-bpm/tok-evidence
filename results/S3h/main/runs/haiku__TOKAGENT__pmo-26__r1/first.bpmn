<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Becoming A Parent" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-ss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-co</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start planning leave" />
    <bpmn:task id="select" name="Select leave model" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="notify-ss" name="Notify Social Security" />
    <bpmn:task id="notify-co" name="Notify company" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="take" name="Take maternity leave" />
    <bpmn:task id="decide" name="Decide about extension" />
    <bpmn:exclusiveGateway id="extend" name="Extend leave?" default="f-extend-done" />
    <bpmn:endEvent id="done" name="Leave completed" />
    <bpmn:task id="fetch" name="Fetch information about leave models" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:sequenceFlow id="f-s-fetch" sourceRef="s" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-split1" sourceRef="select" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-collect" sourceRef="split1" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-join1" sourceRef="collect" targetRef="join1" />
    <bpmn:sequenceFlow id="f-split1-gather" sourceRef="split1" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-join1" sourceRef="gather" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-split2" sourceRef="join1" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-notify-ss" sourceRef="split2" targetRef="notify-ss" />
    <bpmn:sequenceFlow id="f-notify-ss-join2" sourceRef="notify-ss" targetRef="join2" />
    <bpmn:sequenceFlow id="f-split2-notify-co" sourceRef="split2" targetRef="notify-co" />
    <bpmn:sequenceFlow id="f-notify-co-join2" sourceRef="notify-co" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-take" sourceRef="join2" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-decide" sourceRef="take" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-extend" sourceRef="decide" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-select" name="Yes" sourceRef="extend" targetRef="select">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">extension_wanted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-extend-done" name="No" sourceRef="extend" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
