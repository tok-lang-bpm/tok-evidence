tok 1.0 "Becoming A Parent"

pool org "Becoming A Parent"
  lane parent "Parent"
    start s "Start planning leave"
    task select "Select leave model"
    and split1
    task collect "Collect relevant information"
    and join1
    and split2
    task notify-ss "Notify Social Security"
    task notify-co "Notify company"
    and join2
    task take "Take maternity leave"
    task decide "Decide about extension"
    xor extend "Extend leave?"
    end done "Leave completed"
  lane company "Company"
    task fetch "Fetch information about leave models"
    task gather "Gather information from companies"

flow s -> fetch -> select -> split1
flow split1 -> collect -> join1
flow split1 -> gather -> join1
flow join1 -> split2
flow split2 -> notify-ss -> join2
flow split2 -> notify-co -> join2
flow join2 -> take -> decide -> extend
flow extend -> select "Yes" when="extension_wanted = true"
flow extend -> done "No" default
