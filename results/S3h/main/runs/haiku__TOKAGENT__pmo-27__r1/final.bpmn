<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Report_fatality_or_serious_injury" name="Report fatality or serious injury" />
  <bpmn:message id="Message_Report_accident" name="Report accident" />
  <bpmn:message id="Message_Report_accident_in_triplicate" name="Report accident in triplicate" />
  <bpmn:message id="Message_Report_accident_in_writing" name="Report accident in writing" />
  <bpmn:message id="Message_Report_fatality" name="Report fatality" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
    <bpmn:participant id="labour" name="Labour Inspectorate" />
    <bpmn:participant id="insurer" name="Accident insurance provider" />
    <bpmn:participant id="private" name="Private insurer" />
    <bpmn:messageFlow id="m-t_li-labour" name="Report fatality or serious injury" sourceRef="t_li" targetRef="labour" messageRef="Message_Report_fatality_or_serious_injury" />
    <bpmn:messageFlow id="m-t_ins-insurer" name="Report accident" sourceRef="t_ins" targetRef="insurer" messageRef="Message_Report_accident" />
    <bpmn:messageFlow id="m-t_school-insurer" name="Report accident in triplicate" sourceRef="t_school" targetRef="insurer" messageRef="Message_Report_accident_in_triplicate" />
    <bpmn:messageFlow id="m-t_private-private" name="Report accident in writing" sourceRef="t_private" targetRef="private" messageRef="Message_Report_accident_in_writing" />
    <bpmn:messageFlow id="m-t_pf-private" name="Report fatality" sourceRef="t_pf" targetRef="private" messageRef="Message_Report_fatality" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="insured" name="Insured person">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_what</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_priv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_wa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_outside</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_norec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_norec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_li</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="school" name="School or university">
        <bpmn:flowNodeRef>g_school</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_school</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Accident or near-miss occurs" />
    <bpmn:exclusiveGateway id="g_what" name="What is to be reported?" />
    <bpmn:task id="t_inform" name="Inform employer immediately of accident or near-miss" />
    <bpmn:task id="t_risk" name="Report serious risk or defect in protection systems" />
    <bpmn:endEvent id="e_risk" name="Risk or defect reported" />
    <bpmn:exclusiveGateway id="g_priv" name="Private insurance?" default="f-g_priv-g_m4" />
    <bpmn:task id="t_private" name="Report accident in writing immediately to private insurer" />
    <bpmn:exclusiveGateway id="g_pf" name="Fatality?" default="f-g_pf-g_m4" />
    <bpmn:task id="t_pf" name="Report fatality to private insurer within three days" />
    <bpmn:exclusiveGateway id="g_m4" />
    <bpmn:task id="t_check" name="Check whether accident is a work accident" />
    <bpmn:exclusiveGateway id="g_wa" name="Work accident?" default="f-g_wa-t_outside" />
    <bpmn:task id="t_outside" name="Check whether accident counts as work accident outside professional activity" />
    <bpmn:exclusiveGateway id="g_out" name="Counts as work accident outside professional activity?" default="f-g_out-t_norec" />
    <bpmn:task id="t_record" name="Record accident information" />
    <bpmn:task id="t_norec" name="Record near-miss or non-work accident" />
    <bpmn:endEvent id="e_norec" name="Non-work accident or near-miss recorded" />
    <bpmn:parallelGateway id="g_split" />
    <bpmn:exclusiveGateway id="g_sev" name="Fatality or serious injury not reported to emergency services?" default="f-g_sev-g_m1" />
    <bpmn:task id="t_li" name="Report to Labour Inspectorate immediately" />
    <bpmn:exclusiveGateway id="g_m1" />
    <bpmn:exclusiveGateway id="g_ins" name="Killed or unable to work for three days?" default="f-g_ins-g_m2" />
    <bpmn:task id="t_ins" name="Report accident to accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="g_m2" />
    <bpmn:parallelGateway id="g_join" />
    <bpmn:endEvent id="e_done" name="Accident documented and reported" />
    <bpmn:exclusiveGateway id="g_school" name="Insured person physically injured or killed?" default="f-g_school-g_m3" />
    <bpmn:task id="t_school" name="Report accident in triplicate within five days" />
    <bpmn:exclusiveGateway id="g_m3" />
    <bpmn:sequenceFlow id="f-s1-g_what" sourceRef="s1" targetRef="g_what" />
    <bpmn:sequenceFlow id="f-g_what-t_inform" name="accident or near-miss" sourceRef="g_what" targetRef="t_inform">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_what-t_risk" name="serious risk or defect" sourceRef="g_what" targetRef="t_risk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_risk-e_risk" sourceRef="t_risk" targetRef="e_risk" />
    <bpmn:sequenceFlow id="f-t_inform-t_check" sourceRef="t_inform" targetRef="t_check" />
    <bpmn:sequenceFlow id="f-t_check-g_wa" sourceRef="t_check" targetRef="g_wa" />
    <bpmn:sequenceFlow id="f-g_wa-t_record" name="yes" sourceRef="g_wa" targetRef="t_record">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">is_work_accident</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_wa-t_outside" name="no" sourceRef="g_wa" targetRef="t_outside" />
    <bpmn:sequenceFlow id="f-t_outside-g_out" sourceRef="t_outside" targetRef="g_out" />
    <bpmn:sequenceFlow id="f-g_out-t_record" name="yes" sourceRef="g_out" targetRef="t_record">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">counts_as_work_accident_outside_work</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_out-t_norec" name="no" sourceRef="g_out" targetRef="t_norec" />
    <bpmn:sequenceFlow id="f-t_norec-e_norec" sourceRef="t_norec" targetRef="e_norec" />
    <bpmn:sequenceFlow id="f-t_record-g_split" sourceRef="t_record" targetRef="g_split" />
    <bpmn:sequenceFlow id="f-g_split-g_sev" sourceRef="g_split" targetRef="g_sev" />
    <bpmn:sequenceFlow id="f-g_split-g_ins" sourceRef="g_split" targetRef="g_ins" />
    <bpmn:sequenceFlow id="f-g_split-g_school" sourceRef="g_split" targetRef="g_school" />
    <bpmn:sequenceFlow id="f-g_split-g_priv" sourceRef="g_split" targetRef="g_priv" />
    <bpmn:sequenceFlow id="f-g_sev-t_li" name="yes" sourceRef="g_sev" targetRef="t_li">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fatal_or_serious_unreported</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_sev-g_m1" name="no" sourceRef="g_sev" targetRef="g_m1" />
    <bpmn:sequenceFlow id="f-t_li-g_m1" sourceRef="t_li" targetRef="g_m1" />
    <bpmn:sequenceFlow id="f-g_ins-t_ins" name="yes" sourceRef="g_ins" targetRef="t_ins">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">killed_or_unable_3_days</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_ins-g_m2" name="no" sourceRef="g_ins" targetRef="g_m2" />
    <bpmn:sequenceFlow id="f-t_ins-g_m2" sourceRef="t_ins" targetRef="g_m2" />
    <bpmn:sequenceFlow id="f-g_school-t_school" name="yes" sourceRef="g_school" targetRef="t_school">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">physically_injured_or_killed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_school-g_m3" name="no" sourceRef="g_school" targetRef="g_m3" />
    <bpmn:sequenceFlow id="f-t_school-g_m3" sourceRef="t_school" targetRef="g_m3" />
    <bpmn:sequenceFlow id="f-g_priv-t_private" name="yes" sourceRef="g_priv" targetRef="t_private">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">private_insurance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_priv-g_m4" name="no" sourceRef="g_priv" targetRef="g_m4" />
    <bpmn:sequenceFlow id="f-t_private-g_pf" sourceRef="t_private" targetRef="g_pf" />
    <bpmn:sequenceFlow id="f-g_pf-t_pf" name="yes" sourceRef="g_pf" targetRef="t_pf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fatality</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g_pf-g_m4" name="no" sourceRef="g_pf" targetRef="g_m4" />
    <bpmn:sequenceFlow id="f-t_pf-g_m4" sourceRef="t_pf" targetRef="g_m4" />
    <bpmn:sequenceFlow id="f-g_m1-g_join" sourceRef="g_m1" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_m2-g_join" sourceRef="g_m2" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_m3-g_join" sourceRef="g_m3" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_m4-g_join" sourceRef="g_m4" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_join-e_done" sourceRef="g_join" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>
