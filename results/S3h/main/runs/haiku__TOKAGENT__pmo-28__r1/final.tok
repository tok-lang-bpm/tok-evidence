tok 1.0 "Internship"

pool internship "Internship"
  lane student "Student"
    start start-search "Start internship search"
    task enter-topic "Enter topic and desired pay"
    task enter-exp "Enter experience and hobbies"
    catch offer-arrives "Offer arrives" message="Offer"
    xor accepted "Offer accepted?"
    task accept "Accept offer"
    task deny "Deny offer"
    and split-status "Split"
    task write-status "Write status update about internship" loop
    and join-status "Join"
    task recommend "Recommend company to friends on Twitter" parallel
    end recommended "Recommendation sent"
  lane company "Company"
    task send-offer "Send offer" loop
    task invalidate "Invalidate other offers"
    task company-status "Write status update about student" loop

flow start-search -> enter-topic -> enter-exp -> send-offer -> offer-arrives -> accepted
flow accepted -> accept "yes" when="offer_accepted = true"
flow accepted -> deny "no" default
flow deny -> offer-arrives
flow accept -> invalidate -> split-status
flow split-status -> write-status -> join-status
flow split-status -> company-status -> join-status -> recommend -> recommended
