<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Offer" name="Offer" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="internship" name="Internship" processRef="internship-process" />
  </bpmn:collaboration>
  <bpmn:process id="internship-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="internship-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>start-search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-arrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>send-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>company-status</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-search" name="Start internship search" />
    <bpmn:task id="enter-topic" name="Enter topic and desired pay" />
    <bpmn:task id="enter-exp" name="Enter experience and hobbies" />
    <bpmn:intermediateCatchEvent id="offer-arrives" name="Offer arrives">
      <bpmn:messageEventDefinition id="offer-arrives-def" messageRef="Message_Offer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="accepted" name="Offer accepted?" default="f-accepted-deny" />
    <bpmn:task id="accept" name="Accept offer" />
    <bpmn:task id="deny" name="Deny offer" />
    <bpmn:parallelGateway id="split-status" name="Split" />
    <bpmn:task id="write-status" name="Write status update about internship">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:parallelGateway id="join-status" name="Join" />
    <bpmn:task id="recommend" name="Recommend company to friends on Twitter">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="recommended" name="Recommendation sent" />
    <bpmn:task id="send-offer" name="Send offer">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="invalidate" name="Invalidate other offers" />
    <bpmn:task id="company-status" name="Write status update about student">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:sequenceFlow id="f-start-search-enter-topic" sourceRef="start-search" targetRef="enter-topic" />
    <bpmn:sequenceFlow id="f-enter-topic-enter-exp" sourceRef="enter-topic" targetRef="enter-exp" />
    <bpmn:sequenceFlow id="f-enter-exp-send-offer" sourceRef="enter-exp" targetRef="send-offer" />
    <bpmn:sequenceFlow id="f-send-offer-offer-arrives" sourceRef="send-offer" targetRef="offer-arrives" />
    <bpmn:sequenceFlow id="f-offer-arrives-accepted" sourceRef="offer-arrives" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-accept" name="yes" sourceRef="accepted" targetRef="accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">offer_accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accepted-deny" name="no" sourceRef="accepted" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-offer-arrives" sourceRef="deny" targetRef="offer-arrives" />
    <bpmn:sequenceFlow id="f-accept-invalidate" sourceRef="accept" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f-invalidate-split-status" sourceRef="invalidate" targetRef="split-status" />
    <bpmn:sequenceFlow id="f-split-status-write-status" sourceRef="split-status" targetRef="write-status" />
    <bpmn:sequenceFlow id="f-write-status-join-status" sourceRef="write-status" targetRef="join-status" />
    <bpmn:sequenceFlow id="f-split-status-company-status" sourceRef="split-status" targetRef="company-status" />
    <bpmn:sequenceFlow id="f-company-status-join-status" sourceRef="company-status" targetRef="join-status" />
    <bpmn:sequenceFlow id="f-join-status-recommend" sourceRef="join-status" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-recommended" sourceRef="recommend" targetRef="recommended" />
  </bpmn:process>
</bpmn:definitions>
