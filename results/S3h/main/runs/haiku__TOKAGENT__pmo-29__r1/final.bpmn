<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and Live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visa-type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply-d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply-schengen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visa-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take-up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>renewal-due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stay-ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Representation office (BMEIA)">
        <bpmn:flowNodeRef>review-application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refuse-visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue-visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Plan to work and live in Austria" />
    <bpmn:task id="check-requirements" name="Check requirements for working and living in Austria" />
    <bpmn:exclusiveGateway id="visa-type" name="Which visa type?" default="f-visa-type-apply-schengen" />
    <bpmn:task id="apply-d" name="Apply at the competent Austrian representation (place of residence)" />
    <bpmn:task id="apply-schengen" name="Apply at the representation of the main travel destination" />
    <bpmn:exclusiveGateway id="visa-merge" />
    <bpmn:parallelGateway id="split-prep" />
    <bpmn:task id="accommodation" name="Organise accommodation (negotiation)" />
    <bpmn:task id="bank-account" name="Organise bank account (negotiation)" />
    <bpmn:task id="prepare-docs" name="Prepare visa application documents" />
    <bpmn:parallelGateway id="join-prep" />
    <bpmn:task id="submit-application" name="Submit visa application form with documents" />
    <bpmn:task id="provide-docs" name="Provide additional documents" />
    <bpmn:task id="take-up" name="Take up work and residence in Austria" />
    <bpmn:intermediateCatchEvent id="renewal-due" name="Visa renewal due (every x months, x not stated)">
      <bpmn:timerEventDefinition id="renewal-due-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P12M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="continue" name="Continue to work and live in Austria?" default="f-continue-stay-ended" />
    <bpmn:endEvent id="stay-ended" name="Stay ended" />
    <bpmn:task id="review-application" name="Review visa application" />
    <bpmn:exclusiveGateway id="complete" name="Application complete?" default="f-complete-grounds" />
    <bpmn:task id="request-docs" name="Request additional documents" />
    <bpmn:exclusiveGateway id="grounds" name="Grounds for refusal (residence prohibition, Schengen alert)?" default="f-grounds-issue-visa" />
    <bpmn:task id="refuse-visa" name="Refuse visa" />
    <bpmn:task id="issue-visa" name="Issue visa" />
    <bpmn:endEvent id="refused" name="Visa refused" />
    <bpmn:sequenceFlow id="f-start-check-requirements" sourceRef="start" targetRef="check-requirements" />
    <bpmn:sequenceFlow id="f-check-requirements-visa-type" sourceRef="check-requirements" targetRef="visa-type" />
    <bpmn:sequenceFlow id="f-visa-type-apply-d" name="Type D (Rot-Weiss-Rot Card)" sourceRef="visa-type" targetRef="apply-d">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-visa-type-apply-schengen" name="Schengen visa" sourceRef="visa-type" targetRef="apply-schengen" />
    <bpmn:sequenceFlow id="f-apply-d-visa-merge" sourceRef="apply-d" targetRef="visa-merge" />
    <bpmn:sequenceFlow id="f-apply-schengen-visa-merge" sourceRef="apply-schengen" targetRef="visa-merge" />
    <bpmn:sequenceFlow id="f-visa-merge-split-prep" sourceRef="visa-merge" targetRef="split-prep" />
    <bpmn:sequenceFlow id="f-split-prep-accommodation" sourceRef="split-prep" targetRef="accommodation" />
    <bpmn:sequenceFlow id="f-split-prep-bank-account" sourceRef="split-prep" targetRef="bank-account" />
    <bpmn:sequenceFlow id="f-split-prep-prepare-docs" sourceRef="split-prep" targetRef="prepare-docs" />
    <bpmn:sequenceFlow id="f-accommodation-join-prep" sourceRef="accommodation" targetRef="join-prep" />
    <bpmn:sequenceFlow id="f-bank-account-join-prep" sourceRef="bank-account" targetRef="join-prep" />
    <bpmn:sequenceFlow id="f-prepare-docs-join-prep" sourceRef="prepare-docs" targetRef="join-prep" />
    <bpmn:sequenceFlow id="f-join-prep-submit-application" sourceRef="join-prep" targetRef="submit-application" />
    <bpmn:sequenceFlow id="f-submit-application-review-application" sourceRef="submit-application" targetRef="review-application" />
    <bpmn:sequenceFlow id="f-review-application-complete" sourceRef="review-application" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-request-docs" name="No" sourceRef="complete" targetRef="request-docs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-complete-grounds" name="Yes" sourceRef="complete" targetRef="grounds" />
    <bpmn:sequenceFlow id="f-request-docs-provide-docs" sourceRef="request-docs" targetRef="provide-docs" />
    <bpmn:sequenceFlow id="f-provide-docs-review-application" sourceRef="provide-docs" targetRef="review-application" />
    <bpmn:sequenceFlow id="f-grounds-refuse-visa" name="Yes" sourceRef="grounds" targetRef="refuse-visa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-grounds-issue-visa" name="No" sourceRef="grounds" targetRef="issue-visa" />
    <bpmn:sequenceFlow id="f-refuse-visa-refused" sourceRef="refuse-visa" targetRef="refused" />
    <bpmn:sequenceFlow id="f-issue-visa-take-up" sourceRef="issue-visa" targetRef="take-up" />
    <bpmn:sequenceFlow id="f-take-up-renewal-due" sourceRef="take-up" targetRef="renewal-due" />
    <bpmn:sequenceFlow id="f-renewal-due-continue" sourceRef="renewal-due" targetRef="continue" />
    <bpmn:sequenceFlow id="f-continue-check-requirements" name="Yes" sourceRef="continue" targetRef="check-requirements">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-continue-stay-ended" name="No" sourceRef="continue" targetRef="stay-ended" />
  </bpmn:process>
</bpmn:definitions>
