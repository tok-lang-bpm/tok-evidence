tok 1.0 "LAN party"

pool org "LAN party organiser"
  lane host "Organiser"
    start s "LAN party planned"
    task t1 "Send invitations to the 10 friends"
    task t2 "Find out which games the friends want to play"
    and p1
    xor m1
    task t3 "Appoint a date for the LAN party"
    xor d1 "8 or more people agree on this date?"
    task t4 "Appoint another date"
    task t5 "Check whether you have all the games the guests want to play"
    xor d2 "Are some games missing?"
    task t6 "Download the missing games"
    xor m2
    and j1
    task t7 "Find out how much beer the friends will require"
    xor d3 "Is there enough beer?"
    task t8 "Buy the missing beer"
    xor m3
    task t9 "Enjoy the LAN party"
    end e "LAN party finished"

flow s -> t1 -> t2 -> p1
flow p1 -> m1 -> t3 -> d1
flow d1 -> t4 "no"
flow t4 -> m1
flow d1 -> j1 "yes"
flow p1 -> t5 -> d2
flow d2 -> t6 "yes"
flow d2 -> m2 "no"
flow t6 -> m2 -> j1 -> t7 -> d3
flow d3 -> t8 "no"
flow d3 -> m3 "yes"
flow t8 -> m3 -> t9 -> e
