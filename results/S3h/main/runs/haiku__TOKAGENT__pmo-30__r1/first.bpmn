<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="LAN party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN party organiser" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="host" name="Organiser">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="LAN party planned" />
    <bpmn:task id="t1" name="Send invitations to the 10 friends" />
    <bpmn:task id="t2" name="Find out which games the friends want to play" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t3" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="d1" name="8 or more people agree on this date?" />
    <bpmn:task id="t4" name="Appoint another date" />
    <bpmn:task id="t5" name="Check whether you have all the games the guests want to play" />
    <bpmn:exclusiveGateway id="d2" name="Are some games missing?" />
    <bpmn:task id="t6" name="Download the missing games" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:parallelGateway id="j1" />
    <bpmn:task id="t7" name="Find out how much beer the friends will require" />
    <bpmn:exclusiveGateway id="d3" name="Is there enough beer?" />
    <bpmn:task id="t8" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="m3" />
    <bpmn:task id="t9" name="Enjoy the LAN party" />
    <bpmn:endEvent id="e" name="LAN party finished" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-p1" sourceRef="t2" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-m1" sourceRef="p1" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-t3" sourceRef="m1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-d1" sourceRef="t3" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-t4" name="no" sourceRef="d1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-m1" sourceRef="t4" targetRef="m1" />
    <bpmn:sequenceFlow id="f-d1-j1" name="yes" sourceRef="d1" targetRef="j1" />
    <bpmn:sequenceFlow id="f-p1-t5" sourceRef="p1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-d2" sourceRef="t5" targetRef="d2" />
    <bpmn:sequenceFlow id="f-d2-t6" name="yes" sourceRef="d2" targetRef="t6" />
    <bpmn:sequenceFlow id="f-d2-m2" name="no" sourceRef="d2" targetRef="m2" />
    <bpmn:sequenceFlow id="f-t6-m2" sourceRef="t6" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-j1" sourceRef="m2" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-t7" sourceRef="j1" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-d3" sourceRef="t7" targetRef="d3" />
    <bpmn:sequenceFlow id="f-d3-t8" name="no" sourceRef="d3" targetRef="t8" />
    <bpmn:sequenceFlow id="f-d3-m3" name="yes" sourceRef="d3" targetRef="m3" />
    <bpmn:sequenceFlow id="f-t8-m3" sourceRef="t8" targetRef="m3" />
    <bpmn:sequenceFlow id="f-m3-t9" sourceRef="m3" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-e" sourceRef="t9" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
