<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Expansion_released" name="Expansion released" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click-link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-realm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-name</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Blizzard system">
        <bpmn:flowNodeRef>check-bnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bnet-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bnet-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion-msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start creating a character" />
    <bpmn:parallelGateway id="fork" name="Two things at once" />
    <bpmn:task id="names" name="Come up with character names" />
    <bpmn:task id="enter-info" name="Enter account information" />
    <bpmn:task id="click-link" name="Click the link in the confirmation mail" />
    <bpmn:task id="select-pay" name="Select payment method" />
    <bpmn:exclusiveGateway id="pay-q" name="Payment method?" default="f-pay-q-enter-iban" />
    <bpmn:task id="enter-card" name="Enter credit card information" />
    <bpmn:task id="enter-iban" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="pay-join" />
    <bpmn:task id="log-in" name="Log into the game" />
    <bpmn:task id="select-realm" name="Select realm, race and class" />
    <bpmn:parallelGateway id="name-join" />
    <bpmn:task id="enter-name" name="Enter character name" />
    <bpmn:task id="check-bnet" name="Check battle.net account" />
    <bpmn:exclusiveGateway id="bnet-q" name="Battle.net account?" default="f-bnet-q-enter-info" />
    <bpmn:exclusiveGateway id="bnet-join" />
    <bpmn:task id="check-sub" name="Check active WoW subscription" />
    <bpmn:exclusiveGateway id="sub-q" name="Active WoW subscription?" default="f-sub-q-select-pay" />
    <bpmn:exclusiveGateway id="sub-join" />
    <bpmn:exclusiveGateway id="name-q" name="Name still available?" />
    <bpmn:task id="confirm" name="Send confirmation and character selfies" />
    <bpmn:intermediateCatchEvent id="expansion" name="Expansion released">
      <bpmn:messageEventDefinition id="expansion-def" messageRef="Message_Expansion_released" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="expansion-msg" name="Send expansion message" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-fork" sourceRef="s" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-names" sourceRef="fork" targetRef="names" />
    <bpmn:sequenceFlow id="f-fork-check-bnet" sourceRef="fork" targetRef="check-bnet" />
    <bpmn:sequenceFlow id="f-check-bnet-bnet-q" sourceRef="check-bnet" targetRef="bnet-q" />
    <bpmn:sequenceFlow id="f-bnet-q-enter-info" name="no" sourceRef="bnet-q" targetRef="enter-info" />
    <bpmn:sequenceFlow id="f-bnet-q-bnet-join" name="yes" sourceRef="bnet-q" targetRef="bnet-join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_bnet_account = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enter-info-click-link" sourceRef="enter-info" targetRef="click-link" />
    <bpmn:sequenceFlow id="f-click-link-bnet-join" sourceRef="click-link" targetRef="bnet-join" />
    <bpmn:sequenceFlow id="f-bnet-join-check-sub" sourceRef="bnet-join" targetRef="check-sub" />
    <bpmn:sequenceFlow id="f-check-sub-sub-q" sourceRef="check-sub" targetRef="sub-q" />
    <bpmn:sequenceFlow id="f-sub-q-select-pay" name="no" sourceRef="sub-q" targetRef="select-pay" />
    <bpmn:sequenceFlow id="f-sub-q-sub-join" name="yes" sourceRef="sub-q" targetRef="sub-join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_wow_subscription = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-select-pay-pay-q" sourceRef="select-pay" targetRef="pay-q" />
    <bpmn:sequenceFlow id="f-pay-q-enter-card" name="credit card" sourceRef="pay-q" targetRef="enter-card">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">credit_card = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pay-q-enter-iban" name="bank account" sourceRef="pay-q" targetRef="enter-iban" />
    <bpmn:sequenceFlow id="f-enter-card-pay-join" sourceRef="enter-card" targetRef="pay-join" />
    <bpmn:sequenceFlow id="f-enter-iban-pay-join" sourceRef="enter-iban" targetRef="pay-join" />
    <bpmn:sequenceFlow id="f-pay-join-sub-join" sourceRef="pay-join" targetRef="sub-join" />
    <bpmn:sequenceFlow id="f-sub-join-log-in" sourceRef="sub-join" targetRef="log-in" />
    <bpmn:sequenceFlow id="f-log-in-select-realm" sourceRef="log-in" targetRef="select-realm" />
    <bpmn:sequenceFlow id="f-select-realm-name-join" sourceRef="select-realm" targetRef="name-join" />
    <bpmn:sequenceFlow id="f-names-name-join" sourceRef="names" targetRef="name-join" />
    <bpmn:sequenceFlow id="f-name-join-enter-name" sourceRef="name-join" targetRef="enter-name" />
    <bpmn:sequenceFlow id="f-enter-name-name-q" sourceRef="enter-name" targetRef="name-q" />
    <bpmn:sequenceFlow id="f-name-q-enter-name" name="no" sourceRef="name-q" targetRef="enter-name">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">name_available = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-name-q-confirm" name="yes" sourceRef="name-q" targetRef="confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">name_available = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-confirm-expansion" sourceRef="confirm" targetRef="expansion" />
    <bpmn:sequenceFlow id="f-expansion-expansion-msg" sourceRef="expansion" targetRef="expansion-msg" />
    <bpmn:sequenceFlow id="f-expansion-msg-e" sourceRef="expansion-msg" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
