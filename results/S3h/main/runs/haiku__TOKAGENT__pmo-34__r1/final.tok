tok 1.0 "Building a custom machine out of Lego bricks"

pool org "Lego machine project"
  lane builder "Builder"
    start s "Project starts"
    task design "Develop basic design"
    task order "Order Lego brick sets"
    task hand "Give Lego sets to children"
    xor merge
    xor parts "Parts left in container?"
    task reorder "Reorder individual parts"
    task build "Build subcomponent"
    task test "Test subcomponent"
    xor tested "Test successful?"
    task redesign "Redesign subcomponent"
    task rebuild "Rebuild subcomponent"
    task assemble "Assemble subcomponent"
    xor more "All subcomponents assembled?"
    end done "Machine built"
  lane children "Group of children"
    task sort "Sort parts into containers"

flow s -> design -> order -> hand -> sort -> merge -> parts
flow parts -> build "yes" when="partsLeft = true"
flow parts -> reorder "no" default
flow reorder -> merge
flow build -> test -> tested
flow tested -> assemble "yes" when="testPassed = true"
flow tested -> redesign "no" default
flow redesign -> rebuild -> merge
flow assemble -> more
flow more -> done "yes" when="allAssembled = true"
flow more -> merge "no" default
