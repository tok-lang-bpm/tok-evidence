<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Lego machine project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Group of children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Project starts" />
    <bpmn:task id="design" name="Develop basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="hand" name="Give Lego sets to children" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:exclusiveGateway id="parts" name="Parts left in container?" default="f-parts-reorder" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="build" name="Build subcomponent" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="tested" name="Test successful?" default="f-tested-redesign" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="rebuild" name="Rebuild subcomponent" />
    <bpmn:task id="assemble" name="Assemble subcomponent" />
    <bpmn:exclusiveGateway id="more" name="All subcomponents assembled?" default="f-more-merge" />
    <bpmn:endEvent id="done" name="Machine built" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:sequenceFlow id="f-s-design" sourceRef="s" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-hand" sourceRef="order" targetRef="hand" />
    <bpmn:sequenceFlow id="f-hand-sort" sourceRef="hand" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-merge" sourceRef="sort" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-parts" sourceRef="merge" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-build" name="yes" sourceRef="parts" targetRef="build">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">partsLeft = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-parts-reorder" name="no" sourceRef="parts" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-reorder-merge" sourceRef="reorder" targetRef="merge" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-tested" sourceRef="test" targetRef="tested" />
    <bpmn:sequenceFlow id="f-tested-assemble" name="yes" sourceRef="tested" targetRef="assemble">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">testPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-tested-redesign" name="no" sourceRef="tested" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-rebuild" sourceRef="redesign" targetRef="rebuild" />
    <bpmn:sequenceFlow id="f-rebuild-merge" sourceRef="rebuild" targetRef="merge" />
    <bpmn:sequenceFlow id="f-assemble-more" sourceRef="assemble" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-done" name="yes" sourceRef="more" targetRef="done">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allAssembled = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-merge" name="no" sourceRef="more" targetRef="merge" />
  </bpmn:process>
</bpmn:definitions>
