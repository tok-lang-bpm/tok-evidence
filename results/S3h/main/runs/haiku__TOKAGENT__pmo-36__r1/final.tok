tok 1.0 "Luxury Airplane"

pool airplane "Airplane manufacturer"
  lane customer "Customer"
    start order "Customer wants a luxury airplane"
    task choose-spec "Choose interior specification"
    task confirm "Confirm delivery"
    end done "Delivery confirmed"
  lane sales "Sales"
    task receive-spec "Receive specifications"
    task send-req "Send requirements to teams"
    and fork "Split requirements"
    task deliver "Deliver plane to customer"
  lane russian "Russian team"
    task vodka "Manufacture vodka bar"
  lane irish "Irish team"
    task whiskey "Manufacture whiskey bar"
  lane other "Other teams"
    task parts "Manufacture seats, colour and toilet water"
  lane production "Production"
    and join "Join parts"
    task receive-parts "Receive individual parts"
    task assemble "Assemble interior"
  lane test "Test flight"
    task fly "Fly test flight"
    task protocol "Create test protocol"
    task send-protocol "Send test protocol to customer and sales"

flow order -> choose-spec -> receive-spec -> send-req -> fork
flow fork -> vodka -> join
flow fork -> whiskey -> join
flow fork -> parts -> join -> receive-parts -> assemble -> fly -> protocol -> send-protocol -> deliver -> confirm -> done
