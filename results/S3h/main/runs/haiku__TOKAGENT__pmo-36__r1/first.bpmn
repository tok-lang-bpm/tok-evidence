<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="airplane" name="Airplane manufacturer" processRef="airplane-process" />
  </bpmn:collaboration>
  <bpmn:process id="airplane-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="airplane-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>receive-spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian" name="Russian team">
        <bpmn:flowNodeRef>vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish" name="Irish team">
        <bpmn:flowNodeRef>whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="other" name="Other teams">
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="production" name="Production">
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="test" name="Test flight">
        <bpmn:flowNodeRef>fly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-protocol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order" name="Customer wants a luxury airplane" />
    <bpmn:task id="choose-spec" name="Choose interior specification" />
    <bpmn:task id="confirm" name="Confirm delivery" />
    <bpmn:endEvent id="done" name="Delivery confirmed" />
    <bpmn:task id="receive-spec" name="Receive specifications" />
    <bpmn:task id="send-req" name="Send requirements to teams" />
    <bpmn:parallelGateway id="fork" name="Split requirements" />
    <bpmn:task id="deliver" name="Deliver plane to customer" />
    <bpmn:task id="vodka" name="Manufacture vodka bar" />
    <bpmn:task id="whiskey" name="Manufacture whiskey bar" />
    <bpmn:task id="parts" name="Manufacture seats, colour and toilet water" />
    <bpmn:parallelGateway id="join" name="Join parts" />
    <bpmn:task id="receive-parts" name="Receive individual parts" />
    <bpmn:task id="assemble" name="Assemble interior" />
    <bpmn:task id="fly" name="Fly test flight" />
    <bpmn:task id="protocol" name="Create test protocol" />
    <bpmn:task id="send-protocol" name="Send test protocol to customer and sales" />
    <bpmn:sequenceFlow id="f-order-choose-spec" sourceRef="order" targetRef="choose-spec" />
    <bpmn:sequenceFlow id="f-choose-spec-receive-spec" sourceRef="choose-spec" targetRef="receive-spec" />
    <bpmn:sequenceFlow id="f-receive-spec-send-req" sourceRef="receive-spec" targetRef="send-req" />
    <bpmn:sequenceFlow id="f-send-req-fork" sourceRef="send-req" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-vodka" sourceRef="fork" targetRef="vodka" />
    <bpmn:sequenceFlow id="f-vodka-join" sourceRef="vodka" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-whiskey" sourceRef="fork" targetRef="whiskey" />
    <bpmn:sequenceFlow id="f-whiskey-join" sourceRef="whiskey" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-parts" sourceRef="fork" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-join" sourceRef="parts" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-receive-parts" sourceRef="join" targetRef="receive-parts" />
    <bpmn:sequenceFlow id="f-receive-parts-assemble" sourceRef="receive-parts" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-fly" sourceRef="assemble" targetRef="fly" />
    <bpmn:sequenceFlow id="f-fly-protocol" sourceRef="fly" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-protocol-send-protocol" sourceRef="protocol" targetRef="send-protocol" />
    <bpmn:sequenceFlow id="f-send-protocol-deliver" sourceRef="send-protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
