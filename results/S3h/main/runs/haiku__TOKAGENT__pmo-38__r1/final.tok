tok 1.0 "Building a House"

pool house "Building a tree house"
  lane owner "Owner"
    start s "Want a tree house"
    task collect "Collect requirements"
    task send-req "Send requirements to architect"
    task review "Review draft"
    xor accepted "Draft accepted?"
    task refine "Refine draft with additional requirements"
    task materials "Create list of needed materials from plan"
    task order "Order materials from several online stores" parallel
    and split-par "Split into parallel activities"
    task notify "Send messages to friends to build house"
    and join-par "Join"
    task invite "Send invitations to tree house party"
    task attendees "Create list of attending people"
    task snacks "Buy snacks for party"
    end e "Party prepared"
  lane architect "Architect"
    task draw "Draw up draft"
    task send-draft "Send draft back to owner"
  lane stores "Online stores"
    task process "Process order"
  lane friends "Friends"
    task build "Build the tree house"

flow s -> collect -> send-req -> draw -> send-draft -> review -> accepted
flow accepted -> materials "yes" when="approved = true"
flow accepted -> refine "no" default
flow refine -> review
flow materials -> order -> split-par
flow split-par -> process
flow split-par -> notify
flow process -> join-par
flow notify -> join-par -> build -> invite -> attendees -> snacks -> e
