<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="Building a tree house" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="owner" name="Owner">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>draw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online stores">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Want a tree house" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="send-req" name="Send requirements to architect" />
    <bpmn:task id="review" name="Review draft" />
    <bpmn:exclusiveGateway id="accepted" name="Draft accepted?" default="f-accepted-refine" />
    <bpmn:task id="refine" name="Refine draft with additional requirements" />
    <bpmn:task id="materials" name="Create list of needed materials from plan" />
    <bpmn:task id="order" name="Order materials from several online stores">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:parallelGateway id="split-par" name="Split into parallel activities" />
    <bpmn:task id="notify" name="Send messages to friends to build house" />
    <bpmn:parallelGateway id="join-par" name="Join" />
    <bpmn:task id="invite" name="Send invitations to tree house party" />
    <bpmn:task id="attendees" name="Create list of attending people" />
    <bpmn:task id="snacks" name="Buy snacks for party" />
    <bpmn:endEvent id="e" name="Party prepared" />
    <bpmn:task id="draw" name="Draw up draft" />
    <bpmn:task id="send-draft" name="Send draft back to owner" />
    <bpmn:task id="process" name="Process order" />
    <bpmn:task id="build" name="Build the tree house" />
    <bpmn:sequenceFlow id="f-s-collect" sourceRef="s" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-send-req" sourceRef="collect" targetRef="send-req" />
    <bpmn:sequenceFlow id="f-send-req-draw" sourceRef="send-req" targetRef="draw" />
    <bpmn:sequenceFlow id="f-draw-send-draft" sourceRef="draw" targetRef="send-draft" />
    <bpmn:sequenceFlow id="f-send-draft-review" sourceRef="send-draft" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accepted" sourceRef="review" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-materials" name="yes" sourceRef="accepted" targetRef="materials">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accepted-refine" name="no" sourceRef="accepted" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-review" sourceRef="refine" targetRef="review" />
    <bpmn:sequenceFlow id="f-materials-order" sourceRef="materials" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-split-par" sourceRef="order" targetRef="split-par" />
    <bpmn:sequenceFlow id="f-split-par-process" sourceRef="split-par" targetRef="process" />
    <bpmn:sequenceFlow id="f-split-par-notify" sourceRef="split-par" targetRef="notify" />
    <bpmn:sequenceFlow id="f-process-join-par" sourceRef="process" targetRef="join-par" />
    <bpmn:sequenceFlow id="f-notify-join-par" sourceRef="notify" targetRef="join-par" />
    <bpmn:sequenceFlow id="f-join-par-build" sourceRef="join-par" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-invite" sourceRef="build" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-attendees" sourceRef="invite" targetRef="attendees" />
    <bpmn:sequenceFlow id="f-attendees-snacks" sourceRef="attendees" targetRef="snacks" />
    <bpmn:sequenceFlow id="f-snacks-e" sourceRef="snacks" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
