<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="repair" name="DIY smartphone repair" processRef="repair-process" />
  </bpmn:collaboration>
  <bpmn:process id="repair-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="repair-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-damage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mark-owned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get-from-friend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix-phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Repair tool">
        <bpmn:flowNodeRef>show-lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-options</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-instructions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friend" name="Friend">
        <bpmn:flowNodeRef>friend-answer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="expert" name="Expert">
        <bpmn:flowNodeRef>repair-expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-expert</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start repair" />
    <bpmn:task id="enter-damage" name="Enter phone model and damage" />
    <bpmn:task id="mark-owned" name="Mark items you already have" />
    <bpmn:exclusiveGateway id="g-friends" name="Can friends lend or sell cheaply?" default="f-g-friends-buy-rest" />
    <bpmn:task id="ask-friends" name="Contact friends" />
    <bpmn:task id="get-from-friend" name="Borrow or buy from friend" />
    <bpmn:task id="buy-rest" name="Buy the remaining parts" />
    <bpmn:exclusiveGateway id="g-merge" name="Parts ready?" />
    <bpmn:task id="fix-phone" name="Fix the phone" />
    <bpmn:exclusiveGateway id="g-result" name="Repair worked?" default="f-g-result-send-expert" />
    <bpmn:task id="send-review" name="Send review and video of the repair" />
    <bpmn:task id="send-expert" name="Send phone to an expert" />
    <bpmn:endEvent id="e-done" name="Repair finished" />
    <bpmn:task id="show-lists" name="Show list of materials and tools" />
    <bpmn:task id="offer-options" name="Offer ordering choices for each part" />
    <bpmn:task id="send-instructions" name="Send repair instructions" />
    <bpmn:task id="friend-answer" name="Lend or sell item cheaply" />
    <bpmn:task id="repair-expert" name="Repair the phone" />
    <bpmn:endEvent id="e-expert" name="Phone repaired by expert" />
    <bpmn:sequenceFlow id="f-s-enter-damage" sourceRef="s" targetRef="enter-damage" />
    <bpmn:sequenceFlow id="f-enter-damage-show-lists" sourceRef="enter-damage" targetRef="show-lists" />
    <bpmn:sequenceFlow id="f-show-lists-offer-options" sourceRef="show-lists" targetRef="offer-options" />
    <bpmn:sequenceFlow id="f-offer-options-mark-owned" sourceRef="offer-options" targetRef="mark-owned" />
    <bpmn:sequenceFlow id="f-mark-owned-g-friends" sourceRef="mark-owned" targetRef="g-friends" />
    <bpmn:sequenceFlow id="f-g-friends-ask-friends" name="yes" sourceRef="g-friends" targetRef="ask-friends">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-friends-buy-rest" name="no" sourceRef="g-friends" targetRef="buy-rest" />
    <bpmn:sequenceFlow id="f-ask-friends-friend-answer" sourceRef="ask-friends" targetRef="friend-answer" />
    <bpmn:sequenceFlow id="f-friend-answer-get-from-friend" sourceRef="friend-answer" targetRef="get-from-friend" />
    <bpmn:sequenceFlow id="f-get-from-friend-g-merge" sourceRef="get-from-friend" targetRef="g-merge" />
    <bpmn:sequenceFlow id="f-buy-rest-g-merge" sourceRef="buy-rest" targetRef="g-merge" />
    <bpmn:sequenceFlow id="f-g-merge-send-instructions" sourceRef="g-merge" targetRef="send-instructions" />
    <bpmn:sequenceFlow id="f-send-instructions-fix-phone" sourceRef="send-instructions" targetRef="fix-phone" />
    <bpmn:sequenceFlow id="f-fix-phone-g-result" sourceRef="fix-phone" targetRef="g-result" />
    <bpmn:sequenceFlow id="f-g-result-send-review" name="yes" sourceRef="g-result" targetRef="send-review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-result-send-expert" name="no" sourceRef="g-result" targetRef="send-expert" />
    <bpmn:sequenceFlow id="f-send-review-e-done" sourceRef="send-review" targetRef="e-done" />
    <bpmn:sequenceFlow id="f-send-expert-repair-expert" sourceRef="send-expert" targetRef="repair-expert" />
    <bpmn:sequenceFlow id="f-repair-expert-e-expert" sourceRef="repair-expert" targetRef="e-expert" />
  </bpmn:process>
</bpmn:definitions>
