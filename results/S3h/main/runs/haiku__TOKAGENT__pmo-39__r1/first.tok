tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool repair "DIY smartphone repair"
  lane customer "Customer"
    start s "Start repair"
    task enter-damage "Enter phone model and damage"
    task mark-owned "Mark items you already have"
    xor g-friends "Can friends lend or sell cheaply?"
    task ask-friends "Contact friends"
    task get-from-friend "Borrow or buy from friend"
    task buy-rest "Buy the remaining parts"
    xor g-merge "Parts ready?"
    task fix-phone "Fix the phone"
    xor g-result "Repair worked?"
    task send-review "Send review and video of the repair"
    task send-expert "Send phone to an expert"
    end e-done "Repair finished"
  lane tool "Repair tool"
    task show-lists "Show list of materials and tools"
    task offer-options "Offer ordering choices for each part"
    task send-instructions "Send repair instructions"
  lane friend "Friend"
    task friend-answer "Lend or sell item cheaply"
  lane expert "Expert"
    task repair-expert "Repair the phone"
    end e-expert "Phone repaired by expert"

flow s -> enter-damage -> show-lists -> offer-options -> mark-owned -> g-friends
flow g-friends -> ask-friends "yes" when=""
flow g-friends -> buy-rest "no" default
flow ask-friends -> friend-answer -> get-from-friend -> g-merge
flow buy-rest -> g-merge
flow g-merge -> send-instructions -> fix-phone -> g-result
flow g-result -> send-review "yes" when=""
flow g-result -> send-expert "no" default
flow send-review -> e-done
flow send-expert -> repair-expert -> e-expert
