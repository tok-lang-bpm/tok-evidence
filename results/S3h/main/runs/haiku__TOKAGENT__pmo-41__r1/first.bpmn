<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="plant" name="Energy drink bottling plant" processRef="plant-process" />
  </bpmn:collaboration>
  <bpmn:process id="plant-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="plant-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Inspection application">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inspection begins" />
    <bpmn:userTask id="enter" name="Enter machine type and serial number" />
    <bpmn:userTask id="answer" name="Answer questions and input values" />
    <bpmn:userTask id="press" name="Press the measurement button" />
    <bpmn:task id="collect" name="Collect values from the machine" />
    <bpmn:task id="show" name="Show the collected values" />
    <bpmn:exclusiveGateway id="more" name="Do the results require additional questions?" default="f-more-join" />
    <bpmn:userTask id="extra" name="Answer additional questions" />
    <bpmn:exclusiveGateway id="join" name="Merge" />
    <bpmn:endEvent id="finish" name="Inspection completed" />
    <bpmn:sequenceFlow id="f-begin-enter" sourceRef="begin" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-answer" sourceRef="enter" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-press" sourceRef="answer" targetRef="press" />
    <bpmn:sequenceFlow id="f-press-collect" sourceRef="press" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-show" sourceRef="collect" targetRef="show" />
    <bpmn:sequenceFlow id="f-show-more" sourceRef="show" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-extra" name="yes" sourceRef="more" targetRef="extra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">extra_questions = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-join" name="no" sourceRef="more" targetRef="join" />
    <bpmn:sequenceFlow id="f-extra-join" sourceRef="extra" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-finish" sourceRef="join" targetRef="finish" />
  </bpmn:process>
</bpmn:definitions>
