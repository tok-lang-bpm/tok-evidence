tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool plant "Energy drink bottling plant"
  lane inspector "Inspector"
    start begin "Inspection begins"
    user enter "Enter machine type and serial number"
    user answer "Answer questions and input values"
    user press "Press the measurement button"
  lane app "Inspection application"
    task collect "Collect values from the machine"
    task show "Show the collected values"
    xor more "Do the results require additional questions?"
    user extra "Answer additional questions"
    xor join "Merge"
    end finish "Inspection completed"

flow begin -> enter -> answer -> press -> collect -> show -> more
flow more -> extra "yes" when="extra_questions = true"
flow more -> join "no" default
flow extra -> join
flow join -> finish
