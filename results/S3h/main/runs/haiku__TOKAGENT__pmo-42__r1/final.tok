tok 1.0 "Service for Your Fridge"

pool org "Service for Your Fridge"
  lane cust "Customer"
    start s "Fridge makes strange noises"
    task describe "Describe symptoms"
    task send "Send symptoms and fridge type"
    task confirm "Confirm fridge is OK again"
    xor rate-q "Rate the service facility?"
    task rate "Rate the service facility"
    xor rate-m
    end e "Service completed"
  lane center "Central fridge service center"
    task select "Select local service facility"
  lane fac "Local service facility"
    task appt "Make appointment"
    task arrive "Arrive at random time"
    xor parts "Additional parts needed?"
    task leave "Leave without repairing fridge"
    task repair "Repair fridge"

flow s -> describe -> send -> select -> appt -> arrive -> parts
flow parts -> leave "yes" when="needs_parts = true"
flow parts -> repair "no" default
flow leave -> appt
flow repair -> confirm -> rate-q
flow rate-q -> rate "yes" when="wants_rating = true"
flow rate-q -> rate-m "no" default
flow rate -> rate-m -> e
