<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Service for Your Fridge" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fac" name="Local service facility">
        <bpmn:flowNodeRef>appt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Fridge makes strange noises" />
    <bpmn:task id="describe" name="Describe symptoms" />
    <bpmn:task id="send" name="Send symptoms and fridge type" />
    <bpmn:task id="confirm" name="Confirm fridge is OK again" />
    <bpmn:exclusiveGateway id="rate-q" name="Rate the service facility?" default="f-rate-q-rate-m" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:exclusiveGateway id="rate-m" />
    <bpmn:endEvent id="e" name="Service completed" />
    <bpmn:task id="select" name="Select local service facility" />
    <bpmn:task id="appt" name="Make appointment" />
    <bpmn:task id="arrive" name="Arrive at random time" />
    <bpmn:exclusiveGateway id="parts" name="Additional parts needed?" default="f-parts-repair" />
    <bpmn:task id="leave" name="Leave without repairing fridge" />
    <bpmn:task id="repair" name="Repair fridge" />
    <bpmn:sequenceFlow id="f-s-describe" sourceRef="s" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appt" sourceRef="select" targetRef="appt" />
    <bpmn:sequenceFlow id="f-appt-arrive" sourceRef="appt" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-parts" sourceRef="arrive" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-leave" name="yes" sourceRef="parts" targetRef="leave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needs_parts = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-parts-repair" name="no" sourceRef="parts" targetRef="repair" />
    <bpmn:sequenceFlow id="f-leave-appt" sourceRef="leave" targetRef="appt" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate-q" sourceRef="confirm" targetRef="rate-q" />
    <bpmn:sequenceFlow id="f-rate-q-rate" name="yes" sourceRef="rate-q" targetRef="rate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wants_rating = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rate-q-rate-m" name="no" sourceRef="rate-q" targetRef="rate-m" />
    <bpmn:sequenceFlow id="f-rate-rate-m" sourceRef="rate" targetRef="rate-m" />
    <bpmn:sequenceFlow id="f-rate-m-e" sourceRef="rate-m" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
