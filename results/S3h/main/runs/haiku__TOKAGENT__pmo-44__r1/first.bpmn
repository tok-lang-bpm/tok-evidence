<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller near the University of Vienna" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side-q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status-timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status-update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="conveyor" name="Conveyor belt">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order received" />
    <bpmn:task id="receive-order" name="Receive order" />
    <bpmn:exclusiveGateway id="menu-q" name="Menu or just the burger?" default="f-menu-q-burger-merge" />
    <bpmn:parallelGateway id="menu-split" name="Split menu" />
    <bpmn:task id="prepare-drink" name="Prepare drink">
      <bpmn:documentation>The duration varies with the size of the drink.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ask-side" name="Ask fries or wedges" />
    <bpmn:exclusiveGateway id="side-q" name="Fries or wedges?" />
    <bpmn:task id="prepare-fries" name="Prepare fries">
      <bpmn:documentation>The duration varies with the size of the fries order.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="prepare-wedges" name="Prepare wedges">
      <bpmn:documentation>The duration varies with the size of the wedges order.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="side-merge" name="Side ready" />
    <bpmn:parallelGateway id="menu-join" name="Menu ready" />
    <bpmn:exclusiveGateway id="burger-merge" name="Burger to prepare" />
    <bpmn:task id="prepare-burger" name="Prepare burger">
      <bpmn:documentation>The duration varies with the number of ingredients.</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="status-timer" attachedToRef="prepare-burger" cancelActivity="false">
      <bpmn:timerEventDefinition id="status-timer-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="status-update" name="Give enthusiastic status update" />
    <bpmn:endEvent id="status-end" name="Status update given" />
    <bpmn:task id="deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="done" name="Order delivered" />
    <bpmn:sequenceFlow id="f-s-receive-order" sourceRef="s" targetRef="receive-order" />
    <bpmn:sequenceFlow id="f-receive-order-menu-q" sourceRef="receive-order" targetRef="menu-q" />
    <bpmn:sequenceFlow id="f-menu-q-menu-split" name="menu" sourceRef="menu-q" targetRef="menu-split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-menu-q-burger-merge" name="just the burger" sourceRef="menu-q" targetRef="burger-merge" />
    <bpmn:sequenceFlow id="f-menu-split-prepare-drink" sourceRef="menu-split" targetRef="prepare-drink" />
    <bpmn:sequenceFlow id="f-menu-split-ask-side" sourceRef="menu-split" targetRef="ask-side" />
    <bpmn:sequenceFlow id="f-ask-side-side-q" sourceRef="ask-side" targetRef="side-q" />
    <bpmn:sequenceFlow id="f-side-q-prepare-fries" name="fries" sourceRef="side-q" targetRef="prepare-fries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-side-q-prepare-wedges" name="wedges" sourceRef="side-q" targetRef="prepare-wedges">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-prepare-fries-side-merge" sourceRef="prepare-fries" targetRef="side-merge" />
    <bpmn:sequenceFlow id="f-prepare-wedges-side-merge" sourceRef="prepare-wedges" targetRef="side-merge" />
    <bpmn:sequenceFlow id="f-prepare-drink-menu-join" sourceRef="prepare-drink" targetRef="menu-join" />
    <bpmn:sequenceFlow id="f-side-merge-menu-join" sourceRef="side-merge" targetRef="menu-join" />
    <bpmn:sequenceFlow id="f-menu-join-burger-merge" sourceRef="menu-join" targetRef="burger-merge" />
    <bpmn:sequenceFlow id="f-burger-merge-prepare-burger" sourceRef="burger-merge" targetRef="prepare-burger" />
    <bpmn:sequenceFlow id="f-prepare-burger-deliver" sourceRef="prepare-burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-done" sourceRef="deliver" targetRef="done" />
    <bpmn:sequenceFlow id="f-status-timer-status-update" sourceRef="status-timer" targetRef="status-update" />
    <bpmn:sequenceFlow id="f-status-update-status-end" sourceRef="status-update" targetRef="status-end" />
  </bpmn:process>
</bpmn:definitions>
