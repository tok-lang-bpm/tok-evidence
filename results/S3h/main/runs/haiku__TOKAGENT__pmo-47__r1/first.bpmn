<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Activation_response" name="Activation response" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="inst" name="Sports institute" processRef="inst-process" />
  </bpmn:collaboration>
  <bpmn:process id="inst-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="inst-lanes">
      <bpmn:lane id="app" name="Applicant">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-course-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>activation-response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete-registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-app</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Registration system">
        <bpmn:flowNodeRef>check-slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots-free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show-courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no-slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account-ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Want to register for a course" />
    <bpmn:task id="select-course" name="Select a course" />
    <bpmn:task id="select-course-date" name="Select one of the courses and dates" />
    <bpmn:task id="request-activation" name="Request an activation" />
    <bpmn:intermediateCatchEvent id="activation-response" name="Activation response received">
      <bpmn:messageEventDefinition id="activation-response-def" messageRef="Message_Activation_response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="register-account" name="Register your account" />
    <bpmn:task id="log-in" name="Log into your account" />
    <bpmn:parallelGateway id="split-app" />
    <bpmn:task id="tweet" name="Tweet to friends who might want to join" />
    <bpmn:task id="complete-registration" name="Complete the registration for the course" />
    <bpmn:task id="provide-payment" name="Provide the payment information" />
    <bpmn:parallelGateway id="join-app" />
    <bpmn:task id="check-slots" name="Check whether slots are free" />
    <bpmn:exclusiveGateway id="slots-free" name="Are slots free?" />
    <bpmn:task id="show-courses" name="Tell the courses and dates" />
    <bpmn:endEvent id="no-slots" name="No slots free" />
    <bpmn:task id="check-account" name="Check whether you have an account" />
    <bpmn:exclusiveGateway id="has-account" name="Do you already have an account?" />
    <bpmn:task id="check-eligible" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Are you registered at an eligible university?" />
    <bpmn:exclusiveGateway id="account-ready" />
    <bpmn:task id="issue-ticket" name="Issue the course ticket" />
    <bpmn:endEvent id="done" name="Course ticket received" />
    <bpmn:sequenceFlow id="f-begin-select-course" sourceRef="begin" targetRef="select-course" />
    <bpmn:sequenceFlow id="f-select-course-check-slots" sourceRef="select-course" targetRef="check-slots" />
    <bpmn:sequenceFlow id="f-check-slots-slots-free" sourceRef="check-slots" targetRef="slots-free" />
    <bpmn:sequenceFlow id="f-slots-free-show-courses" name="yes" sourceRef="slots-free" targetRef="show-courses" />
    <bpmn:sequenceFlow id="f-slots-free-no-slots" name="no" sourceRef="slots-free" targetRef="no-slots" />
    <bpmn:sequenceFlow id="f-show-courses-select-course-date" sourceRef="show-courses" targetRef="select-course-date" />
    <bpmn:sequenceFlow id="f-select-course-date-check-account" sourceRef="select-course-date" targetRef="check-account" />
    <bpmn:sequenceFlow id="f-check-account-has-account" sourceRef="check-account" targetRef="has-account" />
    <bpmn:sequenceFlow id="f-has-account-account-ready" name="yes" sourceRef="has-account" targetRef="account-ready" />
    <bpmn:sequenceFlow id="f-has-account-check-eligible" name="no" sourceRef="has-account" targetRef="check-eligible" />
    <bpmn:sequenceFlow id="f-check-eligible-eligible" sourceRef="check-eligible" targetRef="eligible" />
    <bpmn:sequenceFlow id="f-eligible-register-account" name="yes" sourceRef="eligible" targetRef="register-account" />
    <bpmn:sequenceFlow id="f-eligible-request-activation" name="no" sourceRef="eligible" targetRef="request-activation" />
    <bpmn:sequenceFlow id="f-request-activation-activation-response" sourceRef="request-activation" targetRef="activation-response" />
    <bpmn:sequenceFlow id="f-activation-response-account-ready" sourceRef="activation-response" targetRef="account-ready" />
    <bpmn:sequenceFlow id="f-register-account-account-ready" sourceRef="register-account" targetRef="account-ready" />
    <bpmn:sequenceFlow id="f-account-ready-log-in" sourceRef="account-ready" targetRef="log-in" />
    <bpmn:sequenceFlow id="f-log-in-split-app" sourceRef="log-in" targetRef="split-app" />
    <bpmn:sequenceFlow id="f-split-app-tweet" sourceRef="split-app" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-join-app" sourceRef="tweet" targetRef="join-app" />
    <bpmn:sequenceFlow id="f-split-app-complete-registration" sourceRef="split-app" targetRef="complete-registration" />
    <bpmn:sequenceFlow id="f-complete-registration-provide-payment" sourceRef="complete-registration" targetRef="provide-payment" />
    <bpmn:sequenceFlow id="f-provide-payment-join-app" sourceRef="provide-payment" targetRef="join-app" />
    <bpmn:sequenceFlow id="f-join-app-issue-ticket" sourceRef="join-app" targetRef="issue-ticket" />
    <bpmn:sequenceFlow id="f-issue-ticket-done" sourceRef="issue-ticket" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
