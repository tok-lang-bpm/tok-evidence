tok 1.0 "Vienna Night Run app"

pool vnr "Vienna Night Run participation"
  lane runner "Participant"
    start s "Participation wanted"
    task select "Select starting block"
    task run5 "Run 5 km"
    task enter "Enter running time into app"
    xor fast "Time under 25 minutes?"
    task train "Train"
    task number "Get starting number"
    task time-left "Find out time left between start and end of workday"
    xor home "More than one hour left?"
    task from-home "Go to the Night Run from home"
    task from-work "Leave directly from work"
    xor merge1
    and split-run
    task run-night "Run the Night Run"
    task drink "Drink while running"
    and join-run
  lane gadget "Fitness gadget"
    task measure "Measure time"
  lane app "App"
    task final-time "Receive final running time"
    end e "Final running time received"

flow s -> select -> run5 -> measure -> enter -> fast
flow fast -> number "yes" when="running-minutes < 25"
flow fast -> train "no" default
flow train -> run5
flow number -> time-left -> home
flow home -> from-home "yes" when="hours-left > 1"
flow home -> from-work "no" default
flow from-home -> merge1
flow from-work -> merge1 -> split-run
flow split-run -> run-night -> join-run
flow split-run -> drink -> join-run -> final-time -> e
