<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vienna Night Run app" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="vnr" name="Vienna Night Run participation" processRef="vnr-process" />
  </bpmn:collaboration>
  <bpmn:process id="vnr-process" name="Vienna Night Run app" isExecutable="false">
    <bpmn:laneSet id="vnr-lanes">
      <bpmn:lane id="runner" name="Participant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>time-left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>from-home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>from-work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-night</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-run</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="App">
        <bpmn:flowNodeRef>final-time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Participation wanted" />
    <bpmn:task id="select" name="Select starting block" />
    <bpmn:task id="run5" name="Run 5 km" />
    <bpmn:task id="enter" name="Enter running time into app" />
    <bpmn:exclusiveGateway id="fast" name="Time under 25 minutes?" default="f-fast-train" />
    <bpmn:task id="train" name="Train" />
    <bpmn:task id="number" name="Get starting number" />
    <bpmn:task id="time-left" name="Find out time left between start and end of workday" />
    <bpmn:exclusiveGateway id="home" name="More than one hour left?" default="f-home-from-work" />
    <bpmn:task id="from-home" name="Go to the Night Run from home" />
    <bpmn:task id="from-work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:parallelGateway id="split-run" />
    <bpmn:task id="run-night" name="Run the Night Run" />
    <bpmn:task id="drink" name="Drink while running" />
    <bpmn:parallelGateway id="join-run" />
    <bpmn:task id="measure" name="Measure time" />
    <bpmn:task id="final-time" name="Receive final running time" />
    <bpmn:endEvent id="e" name="Final running time received" />
    <bpmn:sequenceFlow id="f-s-select" sourceRef="s" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-run5" sourceRef="select" targetRef="run5" />
    <bpmn:sequenceFlow id="f-run5-measure" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f-measure-enter" sourceRef="measure" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-fast" sourceRef="enter" targetRef="fast" />
    <bpmn:sequenceFlow id="f-fast-number" name="yes" sourceRef="fast" targetRef="number">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">running-minutes &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fast-train" name="no" sourceRef="fast" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-run5" sourceRef="train" targetRef="run5" />
    <bpmn:sequenceFlow id="f-number-time-left" sourceRef="number" targetRef="time-left" />
    <bpmn:sequenceFlow id="f-time-left-home" sourceRef="time-left" targetRef="home" />
    <bpmn:sequenceFlow id="f-home-from-home" name="yes" sourceRef="home" targetRef="from-home">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hours-left &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-home-from-work" name="no" sourceRef="home" targetRef="from-work" />
    <bpmn:sequenceFlow id="f-from-home-merge1" sourceRef="from-home" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-from-work-merge1" sourceRef="from-work" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-split-run" sourceRef="merge1" targetRef="split-run" />
    <bpmn:sequenceFlow id="f-split-run-run-night" sourceRef="split-run" targetRef="run-night" />
    <bpmn:sequenceFlow id="f-run-night-join-run" sourceRef="run-night" targetRef="join-run" />
    <bpmn:sequenceFlow id="f-split-run-drink" sourceRef="split-run" targetRef="drink" />
    <bpmn:sequenceFlow id="f-drink-join-run" sourceRef="drink" targetRef="join-run" />
    <bpmn:sequenceFlow id="f-join-run-final-time" sourceRef="join-run" targetRef="final-time" />
    <bpmn:sequenceFlow id="f-final-time-e" sourceRef="final-time" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
