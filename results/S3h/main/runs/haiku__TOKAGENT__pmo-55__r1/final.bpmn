<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vein puncture under ultrasound guidance" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Hospital" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vein puncture under ultrasound guidance" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-implements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash-hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get-sterile-clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean-puncture-area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape-puncture-zone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure-ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-gel-probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover-probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put-sterile-gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position-probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position-patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vein-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vein-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize-patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture-patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-blood-return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood-return-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop-probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove-syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install-guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove-trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire-check-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-wire-long</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-wire-short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire-check-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-wire-position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wire-position-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen-pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance-catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove-guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify-flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-catheter-position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="prepare-implements" name="Prepare the implements" />
    <bpmn:task id="wash-hands" name="Wash the hands" />
    <bpmn:task id="get-sterile-clothes" name="Get in sterile clothes" />
    <bpmn:task id="clean-puncture-area" name="Clean the puncture area" />
    <bpmn:task id="drape-puncture-zone" name="Drape the puncture zone" />
    <bpmn:task id="configure-ultrasound" name="Configure the ultrasound" />
    <bpmn:task id="put-gel-probe" name="Put gel in the probe" />
    <bpmn:task id="cover-probe" name="Cover the probe" />
    <bpmn:task id="put-sterile-gel" name="Put the sterile gel" />
    <bpmn:task id="position-probe" name="Position the probe" />
    <bpmn:task id="position-patient" name="Position the patient" />
    <bpmn:exclusiveGateway id="vein-split" name="Which vein identification is used?" />
    <bpmn:task id="identify-anatomic" name="Identify the vein anatomically" />
    <bpmn:task id="identify-doppler" name="Identify the vein by doppler" />
    <bpmn:task id="identify-compression" name="Identify the vein by compression" />
    <bpmn:exclusiveGateway id="vein-merge" name="Vein identified" />
    <bpmn:task id="anesthetize-patient" name="Anesthetize the patient" />
    <bpmn:task id="puncture-patient" name="Puncture the patient" />
    <bpmn:task id="check-blood-return" name="Check the blood return" />
    <bpmn:exclusiveGateway id="blood-return-gw" name="Is the blood return correct?" />
    <bpmn:task id="drop-probe" name="Drop the probe" />
    <bpmn:task id="remove-syringe" name="Remove the syringe" />
    <bpmn:task id="install-guidewire" name="Install the guidewire" />
    <bpmn:task id="remove-trocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="wire-check-split" name="Which wire check is used?" />
    <bpmn:task id="check-wire-long" name="Check the wire in the long axis" />
    <bpmn:task id="check-wire-short" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="wire-check-merge" name="Wire checked" />
    <bpmn:task id="check-wire-position" name="Check the wire position" />
    <bpmn:exclusiveGateway id="wire-position-gw" name="Is the wire in good position?" />
    <bpmn:task id="widen-pathway" name="Widen the pathway" />
    <bpmn:task id="advance-catheter" name="Advance the catheter" />
    <bpmn:task id="remove-guidewire" name="Remove the guidewire" />
    <bpmn:task id="verify-flow" name="Verify the flow and the reflow" />
    <bpmn:task id="check-catheter-position" name="Check the catheter position" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-prepare-implements" sourceRef="s" targetRef="prepare-implements" />
    <bpmn:sequenceFlow id="f-prepare-implements-wash-hands" sourceRef="prepare-implements" targetRef="wash-hands" />
    <bpmn:sequenceFlow id="f-wash-hands-get-sterile-clothes" sourceRef="wash-hands" targetRef="get-sterile-clothes" />
    <bpmn:sequenceFlow id="f-get-sterile-clothes-clean-puncture-area" sourceRef="get-sterile-clothes" targetRef="clean-puncture-area" />
    <bpmn:sequenceFlow id="f-clean-puncture-area-drape-puncture-zone" sourceRef="clean-puncture-area" targetRef="drape-puncture-zone" />
    <bpmn:sequenceFlow id="f-drape-puncture-zone-configure-ultrasound" sourceRef="drape-puncture-zone" targetRef="configure-ultrasound" />
    <bpmn:sequenceFlow id="f-configure-ultrasound-put-gel-probe" sourceRef="configure-ultrasound" targetRef="put-gel-probe" />
    <bpmn:sequenceFlow id="f-put-gel-probe-cover-probe" sourceRef="put-gel-probe" targetRef="cover-probe" />
    <bpmn:sequenceFlow id="f-cover-probe-put-sterile-gel" sourceRef="cover-probe" targetRef="put-sterile-gel" />
    <bpmn:sequenceFlow id="f-put-sterile-gel-position-probe" sourceRef="put-sterile-gel" targetRef="position-probe" />
    <bpmn:sequenceFlow id="f-position-probe-position-patient" sourceRef="position-probe" targetRef="position-patient" />
    <bpmn:sequenceFlow id="f-position-patient-vein-split" sourceRef="position-patient" targetRef="vein-split" />
    <bpmn:sequenceFlow id="f-vein-split-identify-anatomic" name="anatomic" sourceRef="vein-split" targetRef="identify-anatomic">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-vein-split-identify-doppler" name="doppler" sourceRef="vein-split" targetRef="identify-doppler">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-vein-split-identify-compression" name="compression" sourceRef="vein-split" targetRef="identify-compression">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-identify-anatomic-vein-merge" sourceRef="identify-anatomic" targetRef="vein-merge" />
    <bpmn:sequenceFlow id="f-identify-doppler-vein-merge" sourceRef="identify-doppler" targetRef="vein-merge" />
    <bpmn:sequenceFlow id="f-identify-compression-vein-merge" sourceRef="identify-compression" targetRef="vein-merge" />
    <bpmn:sequenceFlow id="f-vein-merge-anesthetize-patient" sourceRef="vein-merge" targetRef="anesthetize-patient" />
    <bpmn:sequenceFlow id="f-anesthetize-patient-puncture-patient" sourceRef="anesthetize-patient" targetRef="puncture-patient" />
    <bpmn:sequenceFlow id="f-puncture-patient-check-blood-return" sourceRef="puncture-patient" targetRef="check-blood-return" />
    <bpmn:sequenceFlow id="f-check-blood-return-blood-return-gw" sourceRef="check-blood-return" targetRef="blood-return-gw" />
    <bpmn:sequenceFlow id="f-blood-return-gw-puncture-patient" name="not correct" sourceRef="blood-return-gw" targetRef="puncture-patient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">blood_return_correct = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-blood-return-gw-drop-probe" name="correct" sourceRef="blood-return-gw" targetRef="drop-probe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">blood_return_correct = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-drop-probe-remove-syringe" sourceRef="drop-probe" targetRef="remove-syringe" />
    <bpmn:sequenceFlow id="f-remove-syringe-install-guidewire" sourceRef="remove-syringe" targetRef="install-guidewire" />
    <bpmn:sequenceFlow id="f-install-guidewire-remove-trocar" sourceRef="install-guidewire" targetRef="remove-trocar" />
    <bpmn:sequenceFlow id="f-remove-trocar-wire-check-split" sourceRef="remove-trocar" targetRef="wire-check-split" />
    <bpmn:sequenceFlow id="f-wire-check-split-check-wire-long" name="long axis" sourceRef="wire-check-split" targetRef="check-wire-long">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wire-check-split-check-wire-short" name="short axis" sourceRef="wire-check-split" targetRef="check-wire-short">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-check-wire-long-wire-check-merge" sourceRef="check-wire-long" targetRef="wire-check-merge" />
    <bpmn:sequenceFlow id="f-check-wire-short-wire-check-merge" sourceRef="check-wire-short" targetRef="wire-check-merge" />
    <bpmn:sequenceFlow id="f-wire-check-merge-check-wire-position" sourceRef="wire-check-merge" targetRef="check-wire-position" />
    <bpmn:sequenceFlow id="f-check-wire-position-wire-position-gw" sourceRef="check-wire-position" targetRef="wire-position-gw" />
    <bpmn:sequenceFlow id="f-wire-position-gw-puncture-patient" name="not in good position" sourceRef="wire-position-gw" targetRef="puncture-patient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wire_in_good_position = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wire-position-gw-widen-pathway" name="good position" sourceRef="wire-position-gw" targetRef="widen-pathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wire_in_good_position = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-widen-pathway-advance-catheter" sourceRef="widen-pathway" targetRef="advance-catheter" />
    <bpmn:sequenceFlow id="f-advance-catheter-remove-guidewire" sourceRef="advance-catheter" targetRef="remove-guidewire" />
    <bpmn:sequenceFlow id="f-remove-guidewire-verify-flow" sourceRef="remove-guidewire" targetRef="verify-flow" />
    <bpmn:sequenceFlow id="f-verify-flow-check-catheter-position" sourceRef="verify-flow" targetRef="check-catheter-position" />
    <bpmn:sequenceFlow id="f-check-catheter-position-e" sourceRef="check-catheter-position" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
