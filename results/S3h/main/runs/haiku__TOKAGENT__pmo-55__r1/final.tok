tok 1.0 "Vein puncture under ultrasound guidance"

pool org "Hospital"
  lane doctor "Doctor"
    start s "Start"
    task prepare-implements "Prepare the implements"
    task wash-hands "Wash the hands"
    task get-sterile-clothes "Get in sterile clothes"
    task clean-puncture-area "Clean the puncture area"
    task drape-puncture-zone "Drape the puncture zone"
    task configure-ultrasound "Configure the ultrasound"
    task put-gel-probe "Put gel in the probe"
    task cover-probe "Cover the probe"
    task put-sterile-gel "Put the sterile gel"
    task position-probe "Position the probe"
    task position-patient "Position the patient"
    xor vein-split "Which vein identification is used?"
    task identify-anatomic "Identify the vein anatomically"
    task identify-doppler "Identify the vein by doppler"
    task identify-compression "Identify the vein by compression"
    xor vein-merge "Vein identified"
    task anesthetize-patient "Anesthetize the patient"
    task puncture-patient "Puncture the patient"
    task check-blood-return "Check the blood return"
    xor blood-return-gw "Is the blood return correct?"
    task drop-probe "Drop the probe"
    task remove-syringe "Remove the syringe"
    task install-guidewire "Install the guidewire"
    task remove-trocar "Remove the trocar"
    xor wire-check-split "Which wire check is used?"
    task check-wire-long "Check the wire in the long axis"
    task check-wire-short "Check the wire in the short axis"
    xor wire-check-merge "Wire checked"
    task check-wire-position "Check the wire position"
    xor wire-position-gw "Is the wire in good position?"
    task widen-pathway "Widen the pathway"
    task advance-catheter "Advance the catheter"
    task remove-guidewire "Remove the guidewire"
    task verify-flow "Verify the flow and the reflow"
    task check-catheter-position "Check the catheter position"
    end e "End"

flow s -> prepare-implements -> wash-hands -> get-sterile-clothes -> clean-puncture-area -> drape-puncture-zone -> configure-ultrasound -> put-gel-probe -> cover-probe -> put-sterile-gel -> position-probe -> position-patient -> vein-split
flow vein-split -> identify-anatomic "anatomic" when=""
flow vein-split -> identify-doppler "doppler" when=""
flow vein-split -> identify-compression "compression" when=""
flow identify-anatomic -> vein-merge
flow identify-doppler -> vein-merge
flow identify-compression -> vein-merge -> anesthetize-patient -> puncture-patient -> check-blood-return -> blood-return-gw
flow blood-return-gw -> puncture-patient "not correct" when="blood_return_correct = false"
flow blood-return-gw -> drop-probe "correct" when="blood_return_correct = true"
flow drop-probe -> remove-syringe -> install-guidewire -> remove-trocar -> wire-check-split
flow wire-check-split -> check-wire-long "long axis" when=""
flow wire-check-split -> check-wire-short "short axis" when=""
flow check-wire-long -> wire-check-merge
flow check-wire-short -> wire-check-merge -> check-wire-position -> wire-position-gw
flow wire-position-gw -> puncture-patient "not in good position" when="wire_in_good_position = false"
flow wire-position-gw -> widen-pathway "good position" when="wire_in_good_position = true"
flow widen-pathway -> advance-catheter -> remove-guidewire -> verify-flow -> check-catheter-position -> e
