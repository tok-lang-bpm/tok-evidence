<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customer order process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customer order process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales staff or customer support">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waits</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Sales representative">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Customer inquires about a product or service" />
    <bpmn:task id="guided" name="Guide the customer through selecting the product or service" />
    <bpmn:task id="confirmed" name="Receive order confirmation" />
    <bpmn:task id="approves" name="Approve the quote" />
    <bpmn:endEvent id="placed" name="Order successfully placed and confirmed" />
    <bpmn:endEvent id="declined" name="Customer not interested" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="address" name="Address concerns or questions" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:task id="waits" name="Wait for customer approval" />
    <bpmn:task id="record" name="Record the order in the system" />
    <bpmn:sequenceFlow id="f-inquiry-collect" sourceRef="inquiry" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-address" sourceRef="collect" targetRef="address" />
    <bpmn:sequenceFlow id="f-address-interested" sourceRef="address" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-guided" name="yes" sourceRef="interested" targetRef="guided" />
    <bpmn:sequenceFlow id="f-interested-declined" name="no" sourceRef="interested" targetRef="declined" />
    <bpmn:sequenceFlow id="f-guided-quote" sourceRef="guided" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approves" sourceRef="quote" targetRef="approves" />
    <bpmn:sequenceFlow id="f-approves-record" sourceRef="approves" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-confirmed" sourceRef="record" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-placed" sourceRef="confirmed" targetRef="placed" />
  </bpmn:process>
</bpmn:definitions>
