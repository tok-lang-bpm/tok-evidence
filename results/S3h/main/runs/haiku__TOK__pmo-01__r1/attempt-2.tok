tok 1.0 "Customer order process"

pool company "Company"
  lane customer "Customer"
    start inquiry "Customer inquires about a product or service"
    task guided "Guide the customer through selecting the product or service"
    task confirmed "Receive order confirmation"
    task approves "Approve the quote"
    end placed "Order successfully placed and confirmed"
    end declined "Customer not interested"
  lane sales "Sales staff or customer support"
    task collect "Collect relevant information"
    task address "Address concerns or questions"
    xor interested "Customer interested?"
    task quote "Provide a quote"
  lane rep "Sales representative"
    task record "Record the order in the system"

flow inquiry -> collect -> address -> interested
flow interested -> guided "yes"
flow interested -> declined "no"
flow guided -> quote
flow quote -> approves
flow approves -> record
flow record -> confirmed
flow confirmed -> placed
