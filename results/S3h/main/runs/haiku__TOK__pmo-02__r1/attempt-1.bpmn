<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New hire process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="New hire process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate_salary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="New hire need identified" />
    <bpmn:task id="identify" name="Identify the need for a new hire" />
    <bpmn:task id="describe" name="Create the job description" />
    <bpmn:task id="post" name="Post the job description on job boards" />
    <bpmn:task id="collect" name="Collect the resumes" />
    <bpmn:task id="screen" name="Screen the resumes" />
    <bpmn:task id="phone" name="Conduct the initial phone interviews" />
    <bpmn:exclusiveGateway id="preference" name="Candidate's preference?" />
    <bpmn:task id="inperson" name="Conduct the in-person interviews" />
    <bpmn:task id="virtual" name="Conduct the virtual interviews" />
    <bpmn:exclusiveGateway id="interviewed" name="Interview done" />
    <bpmn:exclusiveGateway id="chosen" name="Candidate chosen?" />
    <bpmn:task id="offer" name="Extend the offer" />
    <bpmn:exclusiveGateway id="negotiate" name="Salary negotiation needed?" />
    <bpmn:task id="negotiate_salary" name="Negotiate the salary" />
    <bpmn:exclusiveGateway id="accepted" name="Offer accepted?" />
    <bpmn:task id="onboard" name="Begin the onboarding process" />
    <bpmn:task id="paperwork" name="Complete the paperwork" />
    <bpmn:task id="orient" name="Conduct the orientation" />
    <bpmn:task id="train" name="Conduct the training" />
    <bpmn:parallelGateway id="onboarding_done" name="Onboarding steps joined" />
    <bpmn:task id="integrate" name="Integrate the new hire into the team" />
    <bpmn:endEvent id="done" name="New hire fully integrated" />
    <bpmn:endEvent id="declined" name="Offer declined" />
    <bpmn:sequenceFlow id="f-needed-identify" sourceRef="needed" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-describe" sourceRef="identify" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-post" sourceRef="describe" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-preference" sourceRef="phone" targetRef="preference" />
    <bpmn:sequenceFlow id="f-preference-inperson" name="in person" sourceRef="preference" targetRef="inperson" />
    <bpmn:sequenceFlow id="f-preference-virtual" name="virtual" sourceRef="preference" targetRef="virtual" />
    <bpmn:sequenceFlow id="f-inperson-interviewed" sourceRef="inperson" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-virtual-interviewed" sourceRef="virtual" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-interviewed-chosen" sourceRef="interviewed" targetRef="chosen" />
    <bpmn:sequenceFlow id="f-chosen-offer" name="yes" sourceRef="chosen" targetRef="offer" />
    <bpmn:sequenceFlow id="f-chosen-declined" name="no" sourceRef="chosen" targetRef="declined" />
    <bpmn:sequenceFlow id="f-offer-negotiate" sourceRef="offer" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-negotiate_salary" name="yes" sourceRef="negotiate" targetRef="negotiate_salary" />
    <bpmn:sequenceFlow id="f-negotiate-accepted" name="no" sourceRef="negotiate" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-negotiate_salary-accepted" sourceRef="negotiate_salary" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-onboard" name="yes" sourceRef="accepted" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-accepted-declined" name="no" sourceRef="accepted" targetRef="declined" />
    <bpmn:sequenceFlow id="f-onboard-paperwork" sourceRef="onboard" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-onboard-orient" sourceRef="onboard" targetRef="orient" />
    <bpmn:sequenceFlow id="f-onboard-train" sourceRef="onboard" targetRef="train" />
    <bpmn:sequenceFlow id="f-paperwork-onboarding_done" sourceRef="paperwork" targetRef="onboarding_done" />
    <bpmn:sequenceFlow id="f-orient-onboarding_done" sourceRef="orient" targetRef="onboarding_done" />
    <bpmn:sequenceFlow id="f-train-onboarding_done" sourceRef="train" targetRef="onboarding_done" />
    <bpmn:sequenceFlow id="f-onboarding_done-integrate" sourceRef="onboarding_done" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-done" sourceRef="integrate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
