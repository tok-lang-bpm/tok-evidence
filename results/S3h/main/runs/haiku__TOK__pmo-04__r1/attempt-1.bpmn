<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Marketing campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>objectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>period</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>follow</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Campaign process started" />
    <bpmn:task id="objectives" name="Define the campaign objectives" />
    <bpmn:task id="content" name="Create the content" />
    <bpmn:task id="visuals" name="Design the visuals" />
    <bpmn:task id="channels" name="Select the promotion channels" />
    <bpmn:task id="launch" name="Launch the campaign" />
    <bpmn:parallelGateway id="fork" name="Split" />
    <bpmn:task id="track" name="Track the campaign performance in real time" />
    <bpmn:intermediateCatchEvent id="period" name="Campaign period ends">
      <bpmn:timerEventDefinition id="period-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="analyze" name="Analyze the campaign performance" />
    <bpmn:endEvent id="done" name="Campaign concluded" />
    <bpmn:task id="follow" name="Follow up on the leads" />
    <bpmn:task id="collect" name="Collect the leads in the CRM system" />
    <bpmn:parallelGateway id="join" name="Join" />
    <bpmn:sequenceFlow id="f-begin-objectives" sourceRef="begin" targetRef="objectives" />
    <bpmn:sequenceFlow id="f-objectives-content" sourceRef="objectives" targetRef="content" />
    <bpmn:sequenceFlow id="f-content-visuals" sourceRef="content" targetRef="visuals" />
    <bpmn:sequenceFlow id="f-visuals-channels" sourceRef="visuals" targetRef="channels" />
    <bpmn:sequenceFlow id="f-channels-launch" sourceRef="channels" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-fork" sourceRef="launch" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-track" sourceRef="fork" targetRef="track" />
    <bpmn:sequenceFlow id="f-fork-collect" sourceRef="fork" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-follow" sourceRef="collect" targetRef="follow" />
    <bpmn:sequenceFlow id="f-track-join" sourceRef="track" targetRef="join" />
    <bpmn:sequenceFlow id="f-follow-join" sourceRef="follow" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-period" sourceRef="join" targetRef="period" />
    <bpmn:sequenceFlow id="f-period-analyze" sourceRef="period" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-done" sourceRef="analyze" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
