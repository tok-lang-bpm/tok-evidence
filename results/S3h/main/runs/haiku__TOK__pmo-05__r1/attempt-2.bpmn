<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier selection" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Supplier selection" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="suppliers" name="Suppliers">
        <bpmn:flowNodeRef>respond</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new supplier identified" />
    <bpmn:task id="identify" name="Identify the need for a new supplier" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="onboard" name="Onboard the supplier" />
    <bpmn:task id="execute" name="Execute the contract" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:endEvent id="done" name="Supplier onboarded and contract executed" />
    <bpmn:task id="rfp" name="Issue a request for proposals" />
    <bpmn:task id="receive" name="Receive responses from suppliers" />
    <bpmn:task id="evaluate" name="Evaluate each proposal on cost, quality and delivery time" />
    <bpmn:exclusiveGateway id="offers" name="Site visits or interviews needed?" default="f-offers-checked" />
    <bpmn:task id="visit" name="Conduct site visits" />
    <bpmn:task id="interview" name="Conduct interviews with suppliers" />
    <bpmn:exclusiveGateway id="checked" />
    <bpmn:task id="select" name="Select a supplier" />
    <bpmn:task id="negotiate" name="Negotiate contract terms" />
    <bpmn:exclusiveGateway id="agreed" name="Both parties agree on the terms?" />
    <bpmn:task id="sign" name="Sign the contract" />
    <bpmn:task id="respond" name="Respond to the request for proposals" />
    <bpmn:sequenceFlow id="f-need-identify" sourceRef="need" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-rfp" sourceRef="identify" targetRef="rfp" />
    <bpmn:sequenceFlow id="f-rfp-respond" sourceRef="rfp" targetRef="respond" />
    <bpmn:sequenceFlow id="f-respond-receive" sourceRef="respond" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-offers" sourceRef="evaluate" targetRef="offers" />
    <bpmn:sequenceFlow id="f-offers-visit" name="site visit" sourceRef="offers" targetRef="visit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsVisit = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-offers-interview" name="interview" sourceRef="offers" targetRef="interview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsInterview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-offers-checked" name="none" sourceRef="offers" targetRef="checked" />
    <bpmn:sequenceFlow id="f-visit-checked" sourceRef="visit" targetRef="checked" />
    <bpmn:sequenceFlow id="f-interview-checked" sourceRef="interview" targetRef="checked" />
    <bpmn:sequenceFlow id="f-checked-select" sourceRef="checked" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agreed" sourceRef="negotiate" targetRef="agreed" />
    <bpmn:sequenceFlow id="f-agreed-sign" name="yes" sourceRef="agreed" targetRef="sign" />
    <bpmn:sequenceFlow id="f-agreed-negotiate" name="no" sourceRef="agreed" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-sign-split" sourceRef="sign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-onboard" sourceRef="split" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-onboard-joined" sourceRef="onboard" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-execute" sourceRef="split" targetRef="execute" />
    <bpmn:sequenceFlow id="f-execute-joined" sourceRef="execute" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-done" sourceRef="joined" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
