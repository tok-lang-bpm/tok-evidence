<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Order fulfilment" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generateConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:task id="place" name="Place the order via online platform or phone" />
    <bpmn:task id="receiveConfirm" name="Receive the order confirmation" />
    <bpmn:task id="receiveTracking" name="Receive the tracking information" />
    <bpmn:task id="confirmDelivery" name="Confirm delivery at the address" />
    <bpmn:endEvent id="feedback" name="Customer feedback or return initiated" />
    <bpmn:task id="generateConfirm" name="Generate the order confirmation" />
    <bpmn:task id="sendConfirm" name="Send the order confirmation to the customer" />
    <bpmn:task id="sendTracking" name="Send the tracking information to the customer" />
    <bpmn:task id="monitor" name="Monitor the shipment until delivery" />
    <bpmn:exclusiveGateway id="delivered" name="Shipment reached the customer's address?" />
    <bpmn:endEvent id="completed" name="Delivery completed" />
    <bpmn:task id="pick" name="Pick the items" />
    <bpmn:task id="pack" name="Pack the items" />
    <bpmn:task id="label" name="Generate the shipping label" />
    <bpmn:task id="handover" name="Hand over the order to the logistics provider" />
    <bpmn:task id="deliver" name="Deliver the shipment" />
    <bpmn:sequenceFlow id="f-placed-place" sourceRef="placed" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-generateConfirm" sourceRef="place" targetRef="generateConfirm" />
    <bpmn:sequenceFlow id="f-generateConfirm-sendConfirm" sourceRef="generateConfirm" targetRef="sendConfirm" />
    <bpmn:sequenceFlow id="f-sendConfirm-receiveConfirm" sourceRef="sendConfirm" targetRef="receiveConfirm" />
    <bpmn:sequenceFlow id="f-sendConfirm-pick" sourceRef="sendConfirm" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-pack" sourceRef="pick" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-label" sourceRef="pack" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-handover" sourceRef="label" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-deliver" sourceRef="handover" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-handover-sendTracking" sourceRef="handover" targetRef="sendTracking" />
    <bpmn:sequenceFlow id="f-sendTracking-receiveTracking" sourceRef="sendTracking" targetRef="receiveTracking" />
    <bpmn:sequenceFlow id="f-deliver-monitor" sourceRef="deliver" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-delivered" sourceRef="monitor" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-confirmDelivery" name="yes" sourceRef="delivered" targetRef="confirmDelivery" />
    <bpmn:sequenceFlow id="f-delivered-monitor" name="no" sourceRef="delivered" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-confirmDelivery-completed" sourceRef="confirmDelivery" targetRef="completed" />
    <bpmn:sequenceFlow id="f-confirmDelivery-feedback" sourceRef="confirmDelivery" targetRef="feedback" />
  </bpmn:process>
</bpmn:definitions>
