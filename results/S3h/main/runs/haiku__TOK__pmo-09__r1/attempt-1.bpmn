<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New product development" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="New product development" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rd" name="R&amp;D team">
        <bpmn:flowNodeRef>idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_proto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discardedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="idea" name="Idea for a new or improved product identified" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype using available materials and resources" />
    <bpmn:task id="test" name="Test the prototype for functionality, safety and market potential" />
    <bpmn:task id="collect" name="Collect feedback from the testing phase" />
    <bpmn:exclusiveGateway id="refine" name="Refinement needed?" />
    <bpmn:task id="refine_proto" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="approved" name="Prototype approved or discarded?" />
    <bpmn:endEvent id="approvedEnd" name="Prototype approved for further development" />
    <bpmn:endEvent id="discardedEnd" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-idea-research" sourceRef="idea" targetRef="research" />
    <bpmn:sequenceFlow id="f-research-draft" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-select" sourceRef="draft" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-build" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-collect" sourceRef="test" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-refine" sourceRef="collect" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-refine_proto" name="yes" sourceRef="refine" targetRef="refine_proto" />
    <bpmn:sequenceFlow id="f-refine-approved" name="no" sourceRef="refine" targetRef="approved" />
    <bpmn:sequenceFlow id="f-refine_proto-test" sourceRef="refine_proto" targetRef="test" />
    <bpmn:sequenceFlow id="f-approved-approvedEnd" name="approved" sourceRef="approved" targetRef="approvedEnd" />
    <bpmn:sequenceFlow id="f-approved-discardedEnd" name="discarded" sourceRef="approved" targetRef="discardedEnd" />
  </bpmn:process>
</bpmn:definitions>
