<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="IT solution request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="IT solution request handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="requester" name="Requesting employee or department">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_support</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_compat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Request needed" />
    <bpmn:task id="submit" name="Submit a request for an IT solution" />
    <bpmn:task id="receive" name="Receive the new solution" />
    <bpmn:exclusiveGateway id="training" name="Training needed?" default="f-training-provide_support" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:task id="receive_support" name="Use IT support for troubleshooting" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:task id="check_compat" name="Check compatibility with existing systems" />
    <bpmn:task id="evaluate" name="Evaluate cost and resource needs" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" />
    <bpmn:task id="procure" name="Procure the necessary tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in a controlled environment" />
    <bpmn:exclusiveGateway id="passed" name="Testing successful?" />
    <bpmn:task id="rollout" name="Roll out the new solution to the requesting department" />
    <bpmn:task id="provide_support" name="Provide IT support" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="finished" name="Solution in use" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assess" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-check_compat" sourceRef="assess" targetRef="check_compat" />
    <bpmn:sequenceFlow id="f-check_compat-evaluate" sourceRef="check_compat" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-approved" sourceRef="evaluate" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="yes" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approved-rejected" name="no" sourceRef="approved" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-passed" sourceRef="test" targetRef="passed" />
    <bpmn:sequenceFlow id="f-passed-rollout" name="yes" sourceRef="passed" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-passed-install" name="no" sourceRef="passed" targetRef="install" />
    <bpmn:sequenceFlow id="f-rollout-receive" sourceRef="rollout" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-training" sourceRef="receive" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-train" name="yes" sourceRef="training" targetRef="train">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trainingNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-training-provide_support" name="no" sourceRef="training" targetRef="provide_support" />
    <bpmn:sequenceFlow id="f-train-provide_support" sourceRef="train" targetRef="provide_support" />
    <bpmn:sequenceFlow id="f-provide_support-receive_support" sourceRef="provide_support" targetRef="receive_support" />
    <bpmn:sequenceFlow id="f-receive_support-finished" sourceRef="receive_support" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
