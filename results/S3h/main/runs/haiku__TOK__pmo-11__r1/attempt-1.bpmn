<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Subscription service lifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Subscription service" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Subscription service lifecycle" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>renewal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support team">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="signup" name="Customer needed" />
    <bpmn:task id="enter" name="Enter personal and payment information" />
    <bpmn:task id="receive" name="Receive updates, enhancements or renewal notifications" />
    <bpmn:exclusiveGateway id="cancelDecision" name="Customer cancels?" />
    <bpmn:task id="cancelRequest" name="Submit a cancellation request" />
    <bpmn:task id="renewal" name="Renew the subscription" />
    <bpmn:task id="generate" name="Generate the account" />
    <bpmn:task id="assign" name="Assign access" />
    <bpmn:task id="bill" name="Trigger automated billing cycles" />
    <bpmn:task id="process" name="Process the cancellation request" />
    <bpmn:task id="refund" name="Apply refunds or charges according to the terms" />
    <bpmn:task id="deactivate" name="Deactivate the subscription" />
    <bpmn:task id="settle" name="Settle the final account balance" />
    <bpmn:endEvent id="done" name="Subscription ended" />
    <bpmn:sequenceFlow id="f-signup-enter" sourceRef="signup" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-generate" sourceRef="enter" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-assign" sourceRef="generate" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-bill" sourceRef="assign" targetRef="bill" />
    <bpmn:sequenceFlow id="f-bill-receive" sourceRef="bill" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-cancelDecision" sourceRef="receive" targetRef="cancelDecision" />
    <bpmn:sequenceFlow id="f-cancelDecision-cancelRequest" name="yes" sourceRef="cancelDecision" targetRef="cancelRequest" />
    <bpmn:sequenceFlow id="f-cancelDecision-renewal" name="no" sourceRef="cancelDecision" targetRef="renewal" />
    <bpmn:sequenceFlow id="f-renewal-receive" sourceRef="renewal" targetRef="receive" />
    <bpmn:sequenceFlow id="f-cancelRequest-process" sourceRef="cancelRequest" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-refund" sourceRef="process" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-deactivate" sourceRef="refund" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f-deactivate-settle" sourceRef="deactivate" targetRef="settle" />
    <bpmn:sequenceFlow id="f-settle-done" sourceRef="settle" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
