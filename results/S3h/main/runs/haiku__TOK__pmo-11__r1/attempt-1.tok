tok 1.0 "Subscription service lifecycle"

pool company "Subscription service"
  lane customer "Customer"
    start signup "Customer needed"
    task enter "Enter personal and payment information"
    task receive "Receive updates, enhancements or renewal notifications"
    xor cancelDecision "Customer cancels?"
    task cancelRequest "Submit a cancellation request"
    task renewal "Renew the subscription"
  lane system "System"
    task generate "Generate the account"
    task assign "Assign access"
    task bill "Trigger automated billing cycles"
  lane support "Support team"
    task process "Process the cancellation request"
    task refund "Apply refunds or charges according to the terms"
    task deactivate "Deactivate the subscription"
    task settle "Settle the final account balance"
    end done "Subscription ended"

flow signup -> enter -> generate -> assign -> bill -> receive -> cancelDecision
flow cancelDecision -> cancelRequest "yes"
flow cancelDecision -> renewal "no"
flow renewal -> receive
flow cancelRequest -> process -> refund -> deactivate -> settle -> done
