<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>filed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Relevant department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Financial team">
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="filed" name="Complaint filed" />
    <bpmn:endEvent id="closed" name="Case closed" />
    <bpmn:task id="log" name="Log the complaint" />
    <bpmn:task id="assign" name="Assign the complaint to the relevant department" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="resolve" name="Mark the complaint as resolved" />
    <bpmn:task id="review" name="Review the details of the complaint" />
    <bpmn:task id="determine" name="Determine whether the complaint is valid and whether a refund is justified" />
    <bpmn:task id="notify" name="Notify the customer of the decision" />
    <bpmn:exclusiveGateway id="refund" name="Refund approved?" default="f-refund-merged" />
    <bpmn:task id="reimburse" name="Process the reimbursement" />
    <bpmn:sequenceFlow id="f-filed-log" sourceRef="filed" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-review" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-determine" sourceRef="review" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-notify" sourceRef="determine" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-refund" sourceRef="notify" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-reimburse" name="yes" sourceRef="refund" targetRef="reimburse" />
    <bpmn:sequenceFlow id="f-refund-merged" name="no" sourceRef="refund" targetRef="merged" />
    <bpmn:sequenceFlow id="f-reimburse-merged" sourceRef="reimburse" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-resolve" sourceRef="merged" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-closed" sourceRef="resolve" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
