<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual budget planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Annual budget planning" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Planning team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mgmt" name="Strategic alignment meeting">
        <bpmn:flowNodeRef>align</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Finance department">
        <bpmn:flowNodeRef>rejoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjusted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stake" name="Stakeholders">
        <bpmn:flowNodeRef>approveAdj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveFinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Planning period starts" />
    <bpmn:task id="outline" name="Outline the objectives for the upcoming period" />
    <bpmn:task id="implement" name="Implement the plan" />
    <bpmn:endEvent id="done" name="Budget distributed, implementation begun" />
    <bpmn:task id="draft" name="Draft the plan with cost estimates and budget justification" />
    <bpmn:task id="adjust" name="Adjust the plan based on review feedback" />
    <bpmn:task id="document" name="Document the adjustment" />
    <bpmn:task id="align" name="Review the plan in the strategic alignment meeting" />
    <bpmn:exclusiveGateway id="rejoin" />
    <bpmn:task id="review" name="Review the budget feasibility in detail" />
    <bpmn:exclusiveGateway id="adjusted" name="Adjustments needed?" default="f-adjusted-approveFinal" />
    <bpmn:task id="allocate" name="Allocate the budget to the department" />
    <bpmn:task id="distribute" name="Distribute the budget" />
    <bpmn:task id="approveAdj" name="Approve the adjustment" />
    <bpmn:task id="approveFinal" name="Approve the final version of the budget" />
    <bpmn:sequenceFlow id="f-begin-outline" sourceRef="begin" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-align" sourceRef="draft" targetRef="align" />
    <bpmn:sequenceFlow id="f-align-rejoin" sourceRef="align" targetRef="rejoin" />
    <bpmn:sequenceFlow id="f-rejoin-review" sourceRef="rejoin" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-adjusted" sourceRef="review" targetRef="adjusted" />
    <bpmn:sequenceFlow id="f-adjusted-adjust" name="yes" sourceRef="adjusted" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjusted-approveFinal" name="no" sourceRef="adjusted" targetRef="approveFinal" />
    <bpmn:sequenceFlow id="f-adjust-document" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f-document-approveAdj" sourceRef="document" targetRef="approveAdj" />
    <bpmn:sequenceFlow id="f-approveAdj-rejoin" sourceRef="approveAdj" targetRef="rejoin" />
    <bpmn:sequenceFlow id="f-approveFinal-allocate" sourceRef="approveFinal" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-done" sourceRef="implement" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
