tok 1.0 "Annual budget planning"

pool org "Organisation"
  lane dept "Department"
    start begin "Planning period starts"
    task outline "Outline the objectives for the upcoming period"
    task implement "Implement the plan"
    end done "Budget distributed, implementation begun"
  lane team "Planning team"
    task draft "Draft the plan with cost estimates and budget justification"
    task adjust "Adjust the plan based on review feedback"
    task document "Document the adjustment"
  lane mgmt "Strategic alignment meeting"
    task align "Review the plan in the strategic alignment meeting"
  lane fin "Finance department"
    xor rejoin
    task review "Review the budget feasibility in detail"
    xor adjusted "Adjustments needed?"
    task allocate "Allocate the budget to the department"
    task distribute "Distribute the budget"
  lane stake "Stakeholders"
    task approveAdj "Approve the adjustment"
    task approveFinal "Approve the final version of the budget"

flow begin -> outline -> draft -> align -> rejoin -> review -> adjusted
flow adjusted -> adjust "yes" when="adjustmentNeeded = true"
flow adjusted -> approveFinal "no" default
flow adjust -> document -> approveAdj -> rejoin
flow approveFinal -> allocate -> distribute -> implement -> done
