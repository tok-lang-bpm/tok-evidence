<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="management" name="Management">
        <bpmn:flowNodeRef>scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal teams">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfassess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditor" name="External auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company2" name="Company">
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalaudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concluded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notcertified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="scheduled" name="Compliance audit scheduled" />
    <bpmn:task id="schedule" name="Schedule the compliance audit" />
    <bpmn:task id="prepare" name="Prepare the documentation" />
    <bpmn:task id="gather" name="Gather the evidence" />
    <bpmn:task id="selfassess" name="Conduct the self-assessment" />
    <bpmn:task id="review" name="Review the company's processes" />
    <bpmn:exclusiveGateway id="gaps" name="Gaps or issues found?" />
    <bpmn:task id="identify" name="Identify the gaps or issues" />
    <bpmn:task id="correct" name="Make the necessary corrections or improvements" />
    <bpmn:task id="finalaudit" name="Undergo the final audit" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" />
    <bpmn:task id="certify" name="Award the certification" />
    <bpmn:task id="issue" name="Issue the official documents" />
    <bpmn:endEvent id="concluded" name="Process concluded" />
    <bpmn:endEvent id="notcertified" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f-scheduled-schedule" sourceRef="scheduled" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-prepare" sourceRef="schedule" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-selfassess" sourceRef="gather" targetRef="selfassess" />
    <bpmn:sequenceFlow id="f-selfassess-review" sourceRef="selfassess" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-gaps" sourceRef="review" targetRef="gaps" />
    <bpmn:sequenceFlow id="f-gaps-identify" name="yes" sourceRef="gaps" targetRef="identify" />
    <bpmn:sequenceFlow id="f-gaps-finalaudit" name="no" sourceRef="gaps" targetRef="finalaudit" />
    <bpmn:sequenceFlow id="f-identify-correct" sourceRef="identify" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-finalaudit" sourceRef="correct" targetRef="finalaudit" />
    <bpmn:sequenceFlow id="f-finalaudit-criteria" sourceRef="finalaudit" targetRef="criteria" />
    <bpmn:sequenceFlow id="f-criteria-certify" name="yes" sourceRef="criteria" targetRef="certify" />
    <bpmn:sequenceFlow id="f-criteria-notcertified" name="no" sourceRef="criteria" targetRef="notcertified" />
    <bpmn:sequenceFlow id="f-certify-issue" sourceRef="certify" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-concluded" sourceRef="issue" targetRef="concluded" />
  </bpmn:process>
</bpmn:definitions>
