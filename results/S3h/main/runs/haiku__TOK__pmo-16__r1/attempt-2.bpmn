<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Multinational company annual audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Multinational company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Multinational company annual audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Audit coordinator">
        <bpmn:flowNodeRef>initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkprep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinprep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>checkreg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central audit team">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finrisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oprisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comprisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>highrisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sitevisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risksaddressed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>reviewreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="initiate" name="Audit process needed" />
    <bpmn:task id="notify" name="Send notification to the regional office" />
    <bpmn:parallelGateway id="forkprep" />
    <bpmn:task id="prepare" name="Prepare financial statements" />
    <bpmn:task id="gather" name="Gather necessary documents" />
    <bpmn:parallelGateway id="joinprep" />
    <bpmn:task id="submit" name="Submit the documents to the central audit team" />
    <bpmn:task id="clarify" name="Provide the necessary clarifications" />
    <bpmn:task id="checkreg" name="Check for regulatory updates affecting the audit" />
    <bpmn:task id="review" name="Review the submission" />
    <bpmn:exclusiveGateway id="discrepancy" name="Discrepancies found?" />
    <bpmn:task id="request" name="Request clarifications from the regional office" />
    <bpmn:exclusiveGateway id="reviewed" name="All documents reviewed without issues?" />
    <bpmn:task id="assess" name="Conduct risk assessment" />
    <bpmn:parallelGateway id="assessstart" />
    <bpmn:task id="finrisk" name="Evaluate financial risks" />
    <bpmn:task id="oprisk" name="Evaluate operational risks" />
    <bpmn:task id="comprisk" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="assessend" />
    <bpmn:exclusiveGateway id="highrisk" name="High risk identified?" />
    <bpmn:task id="investigate" name="Launch detailed investigation" />
    <bpmn:task id="analyze" name="Perform data analysis" />
    <bpmn:task id="interview" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="sitevisit" name="Site visits required?" />
    <bpmn:task id="visit" name="Conduct site visits" />
    <bpmn:exclusiveGateway id="risksaddressed" name="All risks addressed?" />
    <bpmn:task id="compile" name="Compile the audit report" />
    <bpmn:task id="reviewreport" name="Review the audit report" />
    <bpmn:exclusiveGateway id="decision" name="Report approved?" />
    <bpmn:task id="revise" name="Update the report with revisions" />
    <bpmn:task id="distribute" name="Distribute the final report to the executive board" />
    <bpmn:task id="archive" name="Archive the final report" />
    <bpmn:endEvent id="closed" name="Audit process closed" />
    <bpmn:sequenceFlow id="f-initiate-notify" sourceRef="initiate" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-forkprep" sourceRef="notify" targetRef="forkprep" />
    <bpmn:sequenceFlow id="f-forkprep-prepare" sourceRef="forkprep" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-joinprep" sourceRef="gather" targetRef="joinprep" />
    <bpmn:sequenceFlow id="f-forkprep-checkreg" sourceRef="forkprep" targetRef="checkreg" />
    <bpmn:sequenceFlow id="f-checkreg-joinprep" sourceRef="checkreg" targetRef="joinprep" />
    <bpmn:sequenceFlow id="f-joinprep-submit" sourceRef="joinprep" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-discrepancy" sourceRef="review" targetRef="discrepancy" />
    <bpmn:sequenceFlow id="f-discrepancy-request" name="yes" sourceRef="discrepancy" targetRef="request" />
    <bpmn:sequenceFlow id="f-discrepancy-reviewed" name="no" sourceRef="discrepancy" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-request-clarify" sourceRef="request" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-reviewed" sourceRef="clarify" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-reviewed-assess" name="yes" sourceRef="reviewed" targetRef="assess" />
    <bpmn:sequenceFlow id="f-reviewed-review" name="no" sourceRef="reviewed" targetRef="review" />
    <bpmn:sequenceFlow id="f-assess-assessstart" sourceRef="assess" targetRef="assessstart" />
    <bpmn:sequenceFlow id="f-assessstart-finrisk" sourceRef="assessstart" targetRef="finrisk" />
    <bpmn:sequenceFlow id="f-assessstart-oprisk" sourceRef="assessstart" targetRef="oprisk" />
    <bpmn:sequenceFlow id="f-assessstart-comprisk" sourceRef="assessstart" targetRef="comprisk" />
    <bpmn:sequenceFlow id="f-finrisk-assessend" sourceRef="finrisk" targetRef="assessend" />
    <bpmn:sequenceFlow id="f-oprisk-assessend" sourceRef="oprisk" targetRef="assessend" />
    <bpmn:sequenceFlow id="f-comprisk-assessend" sourceRef="comprisk" targetRef="assessend" />
    <bpmn:sequenceFlow id="f-assessend-highrisk" sourceRef="assessend" targetRef="highrisk" />
    <bpmn:sequenceFlow id="f-highrisk-investigate" name="yes" sourceRef="highrisk" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-highrisk-risksaddressed" name="no" sourceRef="highrisk" targetRef="risksaddressed" />
    <bpmn:sequenceFlow id="f-investigate-analyze" sourceRef="investigate" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-interview" sourceRef="analyze" targetRef="interview" />
    <bpmn:sequenceFlow id="f-interview-sitevisit" sourceRef="interview" targetRef="sitevisit" />
    <bpmn:sequenceFlow id="f-sitevisit-visit" name="yes" sourceRef="sitevisit" targetRef="visit" />
    <bpmn:sequenceFlow id="f-sitevisit-risksaddressed" name="no" sourceRef="sitevisit" targetRef="risksaddressed" />
    <bpmn:sequenceFlow id="f-visit-risksaddressed" sourceRef="visit" targetRef="risksaddressed" />
    <bpmn:sequenceFlow id="f-risksaddressed-compile" name="yes" sourceRef="risksaddressed" targetRef="compile" />
    <bpmn:sequenceFlow id="f-risksaddressed-investigate" name="no" sourceRef="risksaddressed" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-compile-reviewreport" sourceRef="compile" targetRef="reviewreport" />
    <bpmn:sequenceFlow id="f-reviewreport-decision" sourceRef="reviewreport" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-distribute" name="approved" sourceRef="decision" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-decision-revise" name="revisions required" sourceRef="decision" targetRef="revise" />
    <bpmn:sequenceFlow id="f-revise-reviewreport" sourceRef="revise" targetRef="reviewreport" />
    <bpmn:sequenceFlow id="f-distribute-archive" sourceRef="distribute" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-closed" sourceRef="archive" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
