<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Delivery_confirmation" name="Delivery confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="E-commerce company" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Order system">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updinv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>receiveback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping department">
        <bpmn:flowNodeRef>readyfork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readyjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatchfork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatchjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retlabel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:intermediateCatchEvent id="delivered" name="Delivery confirmed">
      <bpmn:messageEventDefinition id="delivered-def" messageRef="Message_Delivery_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="reported" name="Issues reported?" />
    <bpmn:task id="record" name="Record the order details" />
    <bpmn:task id="pay" name="Process the payment" />
    <bpmn:exclusiveGateway id="paid" name="Payment successful?" />
    <bpmn:task id="notifyfail" name="Notify the customer about the failed payment" />
    <bpmn:endEvent id="failed" name="Process ended" />
    <bpmn:task id="stock" name="Check the stock availability" />
    <bpmn:exclusiveGateway id="instock" name="All items in stock?" />
    <bpmn:task id="backorder" name="Initiate a back-order" />
    <bpmn:task id="delay" name="Inform the customer about the delay" />
    <bpmn:exclusiveGateway id="avail" name="Items available" />
    <bpmn:task id="updinv" name="Update the inventory levels" />
    <bpmn:task id="sendconf" name="Send the shipping confirmation" />
    <bpmn:task id="followup" name="Send a follow-up email for feedback" />
    <bpmn:task id="refund" name="Process a refund or replacement" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:endEvent id="returned" name="Return processed" />
    <bpmn:task id="receiveback" name="Receive the back-order" />
    <bpmn:task id="pick" name="Pick the items from the warehouse" />
    <bpmn:task id="qc" name="Perform quality control on the picked items" />
    <bpmn:exclusiveGateway id="giftq" name="Gift wrapping requested?" />
    <bpmn:task id="gift" name="Gift wrap the order" />
    <bpmn:exclusiveGateway id="giftmerge" name="Gift wrapping done" />
    <bpmn:task id="pack" name="Package the order" />
    <bpmn:task id="receiveret" name="Receive the returned items" />
    <bpmn:task id="inspect" name="Inspect the returned items" />
    <bpmn:parallelGateway id="readyfork" />
    <bpmn:task id="docs" name="Prepare the shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs" name="Prepare the customs documentation" />
    <bpmn:exclusiveGateway id="intlmerge" name="Documentation done" />
    <bpmn:parallelGateway id="readyjoin" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:parallelGateway id="dispatchfork" />
    <bpmn:parallelGateway id="dispatchjoin" />
    <bpmn:task id="retlabel" name="Send a return shipping label" />
    <bpmn:sequenceFlow id="f-placed-place" sourceRef="placed" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-record" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-pay" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-paid" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f-paid-notifyfail" name="nie" sourceRef="paid" targetRef="notifyfail" />
    <bpmn:sequenceFlow id="f-notifyfail-failed" sourceRef="notifyfail" targetRef="failed" />
    <bpmn:sequenceFlow id="f-paid-stock" name="tak" sourceRef="paid" targetRef="stock" />
    <bpmn:sequenceFlow id="f-stock-instock" sourceRef="stock" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-avail" name="tak" sourceRef="instock" targetRef="avail" />
    <bpmn:sequenceFlow id="f-instock-backorder" name="nie" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-backorder-delay" sourceRef="backorder" targetRef="delay" />
    <bpmn:sequenceFlow id="f-delay-receiveback" sourceRef="delay" targetRef="receiveback" />
    <bpmn:sequenceFlow id="f-receiveback-avail" sourceRef="receiveback" targetRef="avail" />
    <bpmn:sequenceFlow id="f-avail-pick" sourceRef="avail" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-readyfork" sourceRef="qc" targetRef="readyfork" />
    <bpmn:sequenceFlow id="f-readyfork-giftq" sourceRef="readyfork" targetRef="giftq" />
    <bpmn:sequenceFlow id="f-giftq-gift" name="tak" sourceRef="giftq" targetRef="gift" />
    <bpmn:sequenceFlow id="f-giftq-giftmerge" name="nie" sourceRef="giftq" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f-gift-giftmerge" sourceRef="gift" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f-giftmerge-pack" sourceRef="giftmerge" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-readyjoin" sourceRef="pack" targetRef="readyjoin" />
    <bpmn:sequenceFlow id="f-readyfork-docs" sourceRef="readyfork" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-intl" sourceRef="docs" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-customs" name="tak" sourceRef="intl" targetRef="customs" />
    <bpmn:sequenceFlow id="f-intl-intlmerge" name="nie" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-customs-intlmerge" sourceRef="customs" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intlmerge-readyjoin" sourceRef="intlmerge" targetRef="readyjoin" />
    <bpmn:sequenceFlow id="f-readyjoin-dispatch" sourceRef="readyjoin" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-dispatchfork" sourceRef="dispatch" targetRef="dispatchfork" />
    <bpmn:sequenceFlow id="f-dispatchfork-sendconf" sourceRef="dispatchfork" targetRef="sendconf" />
    <bpmn:sequenceFlow id="f-sendconf-dispatchjoin" sourceRef="sendconf" targetRef="dispatchjoin" />
    <bpmn:sequenceFlow id="f-dispatchfork-updinv" sourceRef="dispatchfork" targetRef="updinv" />
    <bpmn:sequenceFlow id="f-updinv-dispatchjoin" sourceRef="updinv" targetRef="dispatchjoin" />
    <bpmn:sequenceFlow id="f-dispatchjoin-delivered" sourceRef="dispatchjoin" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-reported" sourceRef="delivered" targetRef="reported" />
    <bpmn:sequenceFlow id="f-reported-followup" name="nie" sourceRef="reported" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-done" sourceRef="followup" targetRef="done" />
    <bpmn:sequenceFlow id="f-reported-retlabel" name="tak" sourceRef="reported" targetRef="retlabel" />
    <bpmn:sequenceFlow id="f-retlabel-receiveret" sourceRef="retlabel" targetRef="receiveret" />
    <bpmn:sequenceFlow id="f-receiveret-inspect" sourceRef="receiveret" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-refund" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-returned" sourceRef="refund" targetRef="returned" />
  </bpmn:process>
</bpmn:definitions>
