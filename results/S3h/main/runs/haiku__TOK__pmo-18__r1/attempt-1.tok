tok 1.0 "University enrollment"

pool uni "University"
  lane student "Student"
    start apply "Prospective student applies"
    task submit "Submit the application online"
    task provide "Provide the missing items"
    task confirm "Confirm enrollment by the deadline"
    xor deadline "Enrollment confirmed by the deadline?"
    end endcancel "Application canceled"
    and forkB "Split"
    task receive "Receive the orientation materials"
    and joinB "Join"
    xor intl "International student?"
    xor intlmerge "Merge"
    task idcard "Obtain the student ID card"
    task planstart "Start creating the study plan"
    task select "Select courses"
    task resolve "Resolve any schedule conflicts"
    task attend "Attend classes"
    xor addq "Add or drop courses?"
    task addrop "Add or drop courses within the add/drop period"
    task reviewgrades "Review grades online"
    xor grievance "Has a grievance?"
    task appeal "Submit the appeal form"
    xor semend "Semester ends"
    xor status "Graduate, withdraw or continue?"
    task withdraw "Withdraw from the university"
    end endgrad "Student graduates"
    end endwith "Student withdraws"
  lane admissions "Admissions office"
    task review "Review the application and supporting documents"
    xor docs "All documents received?"
    task notify "Notify the applicant of missing items"
    and forkA "Split"
    and joinA "Join"
    task sendacc "Send the acceptance letter"
    task sendrej "Send the rejection letter"
    end endrej "Application rejected"
  lane committee "Admissions committee"
    task evaluate "Evaluate the application"
    xor decide "Application accepted?"
  lane finance "Finance department"
    task fees "Process the application fees or waivers"
  lane it "IT department"
    task accounts "Set up student accounts for email, online portals and library access"
  lane intl "International student office"
    task visa "Assist with visa processing"
  lane advisor "Academic advisor"
    task advisor "Meet with an academic advisor"
  lane registrar "Registrar"
    task grades "Post grades"
  lane appeals "Appeals committee"
    task meetappeal "Meet with the appeals committee"
    task await "Await the appeal decision"

flow apply -> submit -> review -> docs
flow docs -> notify "no"
flow notify -> provide
flow provide -> docs
flow docs -> forkA "yes"
flow forkA -> evaluate
flow forkA -> fees
flow evaluate -> joinA
flow fees -> joinA
flow joinA -> decide
flow decide -> sendacc "accepted"
flow decide -> sendrej "rejected"
flow sendrej -> endrej
flow sendacc -> confirm -> deadline
flow deadline -> endcancel "no"
flow deadline -> forkB "yes"
flow forkB -> receive
flow forkB -> accounts
flow receive -> joinB
flow accounts -> joinB
flow joinB -> intl
flow intl -> visa "yes"
flow intl -> intlmerge "no"
flow visa -> intlmerge
flow intlmerge -> idcard -> planstart -> advisor -> select -> resolve -> attend
flow attend -> addq
flow addq -> addrop "yes"
flow addrop -> attend
flow addq -> grades "no"
flow grades -> reviewgrades -> grievance
flow grievance -> appeal "yes"
flow appeal -> meetappeal -> await -> semend
flow grievance -> semend "no"
flow semend -> status
flow status -> endgrad "graduates"
flow status -> withdraw "withdraws"
flow withdraw -> endwith
flow status -> attend "continues"
