<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="uni" name="University" processRef="uni-process" />
  </bpmn:collaboration>
  <bpmn:process id="uni-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="uni-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endcancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>idcard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewgrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>semend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endgrad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endwith</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendrej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endrej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Admissions committee">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT department">
        <bpmn:flowNodeRef>accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="intloffice" name="International student office">
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="advisorlane" name="Academic advisor">
        <bpmn:flowNodeRef>advisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registrar" name="Registrar">
        <bpmn:flowNodeRef>grades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals" name="Appeals committee">
        <bpmn:flowNodeRef>meetappeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="apply" name="Prospective student applies" />
    <bpmn:task id="submit" name="Submit the application online" />
    <bpmn:task id="provide" name="Provide the missing items" />
    <bpmn:task id="confirm" name="Confirm enrollment by the deadline" />
    <bpmn:exclusiveGateway id="deadline" name="Enrollment confirmed by the deadline?" />
    <bpmn:endEvent id="endcancel" name="Application canceled" />
    <bpmn:parallelGateway id="forkB" name="Split" />
    <bpmn:task id="receive" name="Receive the orientation materials" />
    <bpmn:parallelGateway id="joinB" name="Join" />
    <bpmn:exclusiveGateway id="intl" name="International student?" />
    <bpmn:exclusiveGateway id="intlmerge" name="Merge" />
    <bpmn:task id="idcard" name="Obtain the student ID card" />
    <bpmn:task id="planstart" name="Start creating the study plan" />
    <bpmn:task id="select" name="Select courses" />
    <bpmn:task id="resolve" name="Resolve any schedule conflicts" />
    <bpmn:task id="attend" name="Attend classes" />
    <bpmn:exclusiveGateway id="addq" name="Add or drop courses?" />
    <bpmn:task id="addrop" name="Add or drop courses within the add/drop period" />
    <bpmn:task id="reviewgrades" name="Review grades online" />
    <bpmn:exclusiveGateway id="grievance" name="Has a grievance?" />
    <bpmn:task id="appeal" name="Submit the appeal form" />
    <bpmn:exclusiveGateway id="semend" name="Semester ends" />
    <bpmn:exclusiveGateway id="status" name="Graduate, withdraw or continue?" />
    <bpmn:task id="withdraw" name="Withdraw from the university" />
    <bpmn:endEvent id="endgrad" name="Student graduates" />
    <bpmn:endEvent id="endwith" name="Student withdraws" />
    <bpmn:task id="review" name="Review the application and supporting documents" />
    <bpmn:exclusiveGateway id="docs" name="All documents received?" />
    <bpmn:task id="notify" name="Notify the applicant of missing items" />
    <bpmn:parallelGateway id="forkA" name="Split" />
    <bpmn:parallelGateway id="joinA" name="Join" />
    <bpmn:task id="sendacc" name="Send the acceptance letter" />
    <bpmn:task id="sendrej" name="Send the rejection letter" />
    <bpmn:endEvent id="endrej" name="Application rejected" />
    <bpmn:task id="evaluate" name="Evaluate the application" />
    <bpmn:exclusiveGateway id="decide" name="Application accepted?" />
    <bpmn:task id="fees" name="Process the application fees or waivers" />
    <bpmn:task id="accounts" name="Set up student accounts for email, online portals and library access" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:task id="advisor" name="Meet with an academic advisor" />
    <bpmn:task id="grades" name="Post grades" />
    <bpmn:task id="meetappeal" name="Meet with the appeals committee" />
    <bpmn:task id="await" name="Await the appeal decision" />
    <bpmn:sequenceFlow id="f-apply-submit" sourceRef="apply" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-docs" sourceRef="review" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-notify" name="no" sourceRef="docs" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-provide" sourceRef="notify" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-docs" sourceRef="provide" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-forkA" name="yes" sourceRef="docs" targetRef="forkA" />
    <bpmn:sequenceFlow id="f-forkA-evaluate" sourceRef="forkA" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-forkA-fees" sourceRef="forkA" targetRef="fees" />
    <bpmn:sequenceFlow id="f-evaluate-joinA" sourceRef="evaluate" targetRef="joinA" />
    <bpmn:sequenceFlow id="f-fees-joinA" sourceRef="fees" targetRef="joinA" />
    <bpmn:sequenceFlow id="f-joinA-decide" sourceRef="joinA" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-sendacc" name="accepted" sourceRef="decide" targetRef="sendacc" />
    <bpmn:sequenceFlow id="f-decide-sendrej" name="rejected" sourceRef="decide" targetRef="sendrej" />
    <bpmn:sequenceFlow id="f-sendrej-endrej" sourceRef="sendrej" targetRef="endrej" />
    <bpmn:sequenceFlow id="f-sendacc-confirm" sourceRef="sendacc" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-deadline" sourceRef="confirm" targetRef="deadline" />
    <bpmn:sequenceFlow id="f-deadline-endcancel" name="no" sourceRef="deadline" targetRef="endcancel" />
    <bpmn:sequenceFlow id="f-deadline-forkB" name="yes" sourceRef="deadline" targetRef="forkB" />
    <bpmn:sequenceFlow id="f-forkB-receive" sourceRef="forkB" targetRef="receive" />
    <bpmn:sequenceFlow id="f-forkB-accounts" sourceRef="forkB" targetRef="accounts" />
    <bpmn:sequenceFlow id="f-receive-joinB" sourceRef="receive" targetRef="joinB" />
    <bpmn:sequenceFlow id="f-accounts-joinB" sourceRef="accounts" targetRef="joinB" />
    <bpmn:sequenceFlow id="f-joinB-intl" sourceRef="joinB" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-visa" name="yes" sourceRef="intl" targetRef="visa" />
    <bpmn:sequenceFlow id="f-intl-intlmerge" name="no" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-visa-intlmerge" sourceRef="visa" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intlmerge-idcard" sourceRef="intlmerge" targetRef="idcard" />
    <bpmn:sequenceFlow id="f-idcard-planstart" sourceRef="idcard" targetRef="planstart" />
    <bpmn:sequenceFlow id="f-planstart-advisor" sourceRef="planstart" targetRef="advisor" />
    <bpmn:sequenceFlow id="f-advisor-select" sourceRef="advisor" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-resolve" sourceRef="select" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-attend" sourceRef="resolve" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-addq" sourceRef="attend" targetRef="addq" />
    <bpmn:sequenceFlow id="f-addq-addrop" name="yes" sourceRef="addq" targetRef="addrop" />
    <bpmn:sequenceFlow id="f-addrop-attend" sourceRef="addrop" targetRef="attend" />
    <bpmn:sequenceFlow id="f-addq-grades" name="no" sourceRef="addq" targetRef="grades" />
    <bpmn:sequenceFlow id="f-grades-reviewgrades" sourceRef="grades" targetRef="reviewgrades" />
    <bpmn:sequenceFlow id="f-reviewgrades-grievance" sourceRef="reviewgrades" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-appeal" name="yes" sourceRef="grievance" targetRef="appeal" />
    <bpmn:sequenceFlow id="f-appeal-meetappeal" sourceRef="appeal" targetRef="meetappeal" />
    <bpmn:sequenceFlow id="f-meetappeal-await" sourceRef="meetappeal" targetRef="await" />
    <bpmn:sequenceFlow id="f-await-semend" sourceRef="await" targetRef="semend" />
    <bpmn:sequenceFlow id="f-grievance-semend" name="no" sourceRef="grievance" targetRef="semend" />
    <bpmn:sequenceFlow id="f-semend-status" sourceRef="semend" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-endgrad" name="graduates" sourceRef="status" targetRef="endgrad" />
    <bpmn:sequenceFlow id="f-status-withdraw" name="withdraws" sourceRef="status" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-withdraw-endwith" sourceRef="withdraw" targetRef="endwith" />
    <bpmn:sequenceFlow id="f-status-attend" name="continues" sourceRef="status" targetRef="attend" />
  </bpmn:process>
</bpmn:definitions>
