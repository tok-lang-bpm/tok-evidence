<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="onlineshop" name="Online shop" processRef="onlineshop-process" />
  </bpmn:collaboration>
  <bpmn:process id="onlineshop-process" name="Online shop purchase" isExecutable="false">
    <bpmn:laneSet id="onlineshop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop" name="Shop">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Order started" />
    <bpmn:task id="login" name="Log in to the account" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="select" name="Select the items to purchase" />
    <bpmn:task id="method" name="Set the payment method" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:exclusiveGateway id="payment" name="Pay or complete an installment agreement?" />
    <bpmn:task id="pay" name="Pay for the order" />
    <bpmn:task id="installment" name="Complete the installment agreement" />
    <bpmn:exclusiveGateway id="paid" />
    <bpmn:task id="reward" name="Choose a free reward option" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:exclusiveGateway id="returned" name="Items returned?" />
    <bpmn:task id="give_back" name="Return the items for exchange" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:task id="deliver" name="Deliver the items" />
    <bpmn:sequenceFlow id="f-started-login" sourceRef="started" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split1" sourceRef="login" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-select" sourceRef="split1" targetRef="select" />
    <bpmn:sequenceFlow id="f-split1-method" sourceRef="split1" targetRef="method" />
    <bpmn:sequenceFlow id="f-select-join1" sourceRef="select" targetRef="join1" />
    <bpmn:sequenceFlow id="f-method-join1" sourceRef="method" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-split2" sourceRef="join1" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-payment" sourceRef="split2" targetRef="payment" />
    <bpmn:sequenceFlow id="f-split2-reward" sourceRef="split2" targetRef="reward" />
    <bpmn:sequenceFlow id="f-payment-pay" name="Pay" sourceRef="payment" targetRef="pay" />
    <bpmn:sequenceFlow id="f-payment-installment" name="Installment" sourceRef="payment" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-paid" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f-installment-paid" sourceRef="installment" targetRef="paid" />
    <bpmn:sequenceFlow id="f-paid-join2" sourceRef="paid" targetRef="join2" />
    <bpmn:sequenceFlow id="f-reward-join2" sourceRef="reward" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-deliver" sourceRef="join2" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-returned" sourceRef="deliver" targetRef="returned" />
    <bpmn:sequenceFlow id="f-returned-give_back" name="Yes" sourceRef="returned" targetRef="give_back" />
    <bpmn:sequenceFlow id="f-returned-done" name="No" sourceRef="returned" targetRef="done" />
    <bpmn:sequenceFlow id="f-give_back-deliver" sourceRef="give_back" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
