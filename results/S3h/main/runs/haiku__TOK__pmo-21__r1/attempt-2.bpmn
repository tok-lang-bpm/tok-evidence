<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Goods shipping" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Goods shipping" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>postship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insmerged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preparepickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics department head">
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Shipping required" />
    <bpmn:parallelGateway id="split" name="Split" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="amount" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one logistic company" />
    <bpmn:task id="postship" name="Use normal post shipment" />
    <bpmn:exclusiveGateway id="merged" name="Shipping method chosen" />
    <bpmn:task id="label" name="Write package label" />
    <bpmn:exclusiveGateway id="insured" name="Parcel insurance necessary?" />
    <bpmn:exclusiveGateway id="insmerged" name="Insurance settled" />
    <bpmn:parallelGateway id="ready" name="Everything ready?" />
    <bpmn:task id="preparepickup" name="Prepare packaged goods for pickup by logistic company" />
    <bpmn:endEvent id="shipped" name="Goods shipped" />
    <bpmn:task id="insure" name="Take out parcel insurance" />
    <bpmn:task id="pack" name="Package the goods" />
    <bpmn:sequenceFlow id="f-needed-split" sourceRef="needed" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-clarify" sourceRef="split" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-amount" sourceRef="clarify" targetRef="amount" />
    <bpmn:sequenceFlow id="f-split-pack" sourceRef="split" targetRef="pack" />
    <bpmn:sequenceFlow id="f-amount-invite" name="yes" sourceRef="amount" targetRef="invite" />
    <bpmn:sequenceFlow id="f-amount-postship" name="no" sourceRef="amount" targetRef="postship" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-merged" sourceRef="select" targetRef="merged" />
    <bpmn:sequenceFlow id="f-postship-merged" sourceRef="postship" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-label" sourceRef="merged" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-insured" sourceRef="label" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-insure" name="yes" sourceRef="insured" targetRef="insure" />
    <bpmn:sequenceFlow id="f-insured-insmerged" name="no" sourceRef="insured" targetRef="insmerged" />
    <bpmn:sequenceFlow id="f-insure-insmerged" sourceRef="insure" targetRef="insmerged" />
    <bpmn:sequenceFlow id="f-insmerged-ready" sourceRef="insmerged" targetRef="ready" />
    <bpmn:sequenceFlow id="f-pack-ready" sourceRef="pack" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-preparepickup" sourceRef="ready" targetRef="preparepickup" />
    <bpmn:sequenceFlow id="f-preparepickup-shipped" sourceRef="preparepickup" targetRef="shipped" />
  </bpmn:process>
</bpmn:definitions>
