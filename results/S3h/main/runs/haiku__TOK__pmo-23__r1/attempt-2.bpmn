<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waiting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="banking" name="Banking system">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Scoring agency">
        <bpmn:flowNodeRef>level1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnquick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informdelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnlevel2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="request" name="Credit scoring requested" />
    <bpmn:task id="display" name="Display the result to the clerk" />
    <bpmn:task id="wait" name="Check again later" />
    <bpmn:endEvent id="done" name="Result seen at the frontend" />
    <bpmn:endEvent id="waiting" name="Clerk waits for the result" />
    <bpmn:task id="send" name="Send the scoring request to the agency" />
    <bpmn:exclusiveGateway id="quick" name="Result determined immediately?" />
    <bpmn:task id="notify" name="Inform the clerk about the delay" />
    <bpmn:exclusiveGateway id="merge" name="Result received" />
    <bpmn:task id="receive" name="Receive the scoring result" />
    <bpmn:task id="level1" name="Do the first quick scoring (level 1)" />
    <bpmn:task id="returnquick" name="Return the result to the banking system" />
    <bpmn:task id="informdelay" name="Inform the banking process about the delay" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="level2" name="Do the level 2 scoring" />
    <bpmn:task id="returnlevel2" name="Send the scoring result to the banking process" />
    <bpmn:sequenceFlow id="f-request-send" sourceRef="request" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-level1" sourceRef="send" targetRef="level1" />
    <bpmn:sequenceFlow id="f-level1-quick" sourceRef="level1" targetRef="quick" />
    <bpmn:sequenceFlow id="f-quick-returnquick" name="yes" sourceRef="quick" targetRef="returnquick" />
    <bpmn:sequenceFlow id="f-quick-informdelay" name="no" sourceRef="quick" targetRef="informdelay" />
    <bpmn:sequenceFlow id="f-returnquick-merge" sourceRef="returnquick" targetRef="merge" />
    <bpmn:sequenceFlow id="f-informdelay-fork" sourceRef="informdelay" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-notify" sourceRef="fork" targetRef="notify" />
    <bpmn:sequenceFlow id="f-fork-level2" sourceRef="fork" targetRef="level2" />
    <bpmn:sequenceFlow id="f-notify-wait" sourceRef="notify" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-waiting" sourceRef="wait" targetRef="waiting" />
    <bpmn:sequenceFlow id="f-level2-returnlevel2" sourceRef="level2" targetRef="returnlevel2" />
    <bpmn:sequenceFlow id="f-returnlevel2-merge" sourceRef="returnlevel2" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-receive" sourceRef="merge" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-display" sourceRef="receive" targetRef="display" />
    <bpmn:sequenceFlow id="f-display-done" sourceRef="display" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
