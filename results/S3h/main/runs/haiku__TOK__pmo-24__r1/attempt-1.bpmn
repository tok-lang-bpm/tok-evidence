<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Restaurant service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant service" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>hungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eaten</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enterpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setbuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passbuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informchef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callguest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="hungry" name="Guest feels hungry" />
    <bpmn:task id="enter" name="Enter the restaurant" />
    <bpmn:task id="choose" name="Choose a dish from the changing meal range" />
    <bpmn:task id="wait" name="Wait until it is his turn" />
    <bpmn:task id="order" name="Place the order with the employee" />
    <bpmn:task id="findout" name="Find out that the meal is ready" />
    <bpmn:task id="appear" name="Appear at the service hatch" />
    <bpmn:task id="pickup" name="Pick up the meal" />
    <bpmn:task id="eat" name="Eat the meal" />
    <bpmn:endEvent id="eaten" name="Meal eaten" />
    <bpmn:task id="enterpos" name="Enter the order into the POS system" />
    <bpmn:task id="collect" name="Collect the money from the guest" />
    <bpmn:task id="setbuzzer" name="Set up a buzzer" />
    <bpmn:task id="passbuzzer" name="Pass the buzzer to the guest with the information: when the buzzer rings, your dinner is ready" />
    <bpmn:task id="informchef" name="Inform the chef of the new meal order" />
    <bpmn:task id="setoff" name="Set off the guest's buzzer" />
    <bpmn:exclusiveGateway id="reacts" name="Guest reacts to the buzzer?" />
    <bpmn:intermediateCatchEvent id="wait5" name="Wait 5 minutes">
      <bpmn:timerEventDefinition id="wait5-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callguest" name="Call for the guest" />
    <bpmn:task id="handover" name="Hand over the meal" />
    <bpmn:task id="prepare" name="Prepare the meal" />
    <bpmn:task id="hatch" name="Place the finished meal in the service hatch" />
    <bpmn:task id="informready" name="Inform the employee that the meal is in the service hatch" />
    <bpmn:sequenceFlow id="f-hungry-enter" sourceRef="hungry" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-choose" sourceRef="enter" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait" sourceRef="choose" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-order" sourceRef="wait" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-enterpos" sourceRef="order" targetRef="enterpos" />
    <bpmn:sequenceFlow id="f-enterpos-collect" sourceRef="enterpos" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-setbuzzer" sourceRef="collect" targetRef="setbuzzer" />
    <bpmn:sequenceFlow id="f-setbuzzer-passbuzzer" sourceRef="setbuzzer" targetRef="passbuzzer" />
    <bpmn:sequenceFlow id="f-passbuzzer-informchef" sourceRef="passbuzzer" targetRef="informchef" />
    <bpmn:sequenceFlow id="f-informchef-prepare" sourceRef="informchef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-hatch" sourceRef="prepare" targetRef="hatch" />
    <bpmn:sequenceFlow id="f-hatch-informready" sourceRef="hatch" targetRef="informready" />
    <bpmn:sequenceFlow id="f-informready-setoff" sourceRef="informready" targetRef="setoff" />
    <bpmn:sequenceFlow id="f-setoff-findout" sourceRef="setoff" targetRef="findout" />
    <bpmn:sequenceFlow id="f-findout-reacts" sourceRef="findout" targetRef="reacts" />
    <bpmn:sequenceFlow id="f-reacts-appear" name="yes" sourceRef="reacts" targetRef="appear" />
    <bpmn:sequenceFlow id="f-reacts-wait5" name="no" sourceRef="reacts" targetRef="wait5" />
    <bpmn:sequenceFlow id="f-wait5-callguest" sourceRef="wait5" targetRef="callguest" />
    <bpmn:sequenceFlow id="f-callguest-reacts" sourceRef="callguest" targetRef="reacts" />
    <bpmn:sequenceFlow id="f-appear-handover" sourceRef="appear" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-pickup" sourceRef="handover" targetRef="pickup" />
    <bpmn:sequenceFlow id="f-pickup-eat" sourceRef="pickup" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-eaten" sourceRef="eat" targetRef="eaten" />
  </bpmn:process>
</bpmn:definitions>
