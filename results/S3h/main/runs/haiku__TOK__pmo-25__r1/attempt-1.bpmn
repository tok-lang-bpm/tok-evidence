<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Job platform" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="applicant" name="Job applicant">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>employ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-applicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Job platform system">
        <bpmn:flowNodeRef>send-offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-year</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show-reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue-offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-continued</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Job search started" />
    <bpmn:task id="write" name="Write job applications" />
    <bpmn:task id="report" name="Report the companies you applied to" />
    <bpmn:task id="negotiate" name="Negotiate the job interview" />
    <bpmn:task id="enter" name="Enter the probation phase" />
    <bpmn:parallelGateway id="split-rate" />
    <bpmn:task id="rate-company" name="Rate the company" />
    <bpmn:parallelGateway id="join-rate" />
    <bpmn:exclusiveGateway id="rated" name="Rated the company C or less?" />
    <bpmn:task id="confirm" name="Confirm receipt of the job application" />
    <bpmn:task id="rate-app" name="Rate the job application" />
    <bpmn:exclusiveGateway id="hire" name="Company wants to hire you?" />
    <bpmn:task id="employ" name="Offer employment" />
    <bpmn:task id="rate-applicant" name="Rate the applicant" />
    <bpmn:exclusiveGateway id="permanent" name="Job becomes permanent?" />
    <bpmn:endEvent id="ended" name="Job search ended" />
    <bpmn:task id="send-offers" name="Send new potential job offers" />
    <bpmn:intermediateCatchEvent id="wait-year" name="One year has passed">
      <bpmn:timerEventDefinition id="wait-year-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P365D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="show-reviews" name="Show the company reviews to job applicants" />
    <bpmn:parallelGateway id="reviews" />
    <bpmn:task id="continue-offers" name="Continue sending job offers without reporting" />
    <bpmn:endEvent id="end-reviews" name="Reviews shown to applicants" />
    <bpmn:endEvent id="end-continued" name="Job offers continue" />
    <bpmn:sequenceFlow id="f-started-write" sourceRef="started" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-report" sourceRef="write" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-confirm" sourceRef="report" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate-app" sourceRef="confirm" targetRef="rate-app" />
    <bpmn:sequenceFlow id="f-rate-app-send-offers" sourceRef="rate-app" targetRef="send-offers" />
    <bpmn:sequenceFlow id="f-send-offers-negotiate" sourceRef="send-offers" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-hire" sourceRef="negotiate" targetRef="hire" />
    <bpmn:sequenceFlow id="f-hire-employ" name="yes" sourceRef="hire" targetRef="employ" />
    <bpmn:sequenceFlow id="f-hire-write" name="no" sourceRef="hire" targetRef="write" />
    <bpmn:sequenceFlow id="f-employ-enter" sourceRef="employ" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-split-rate" sourceRef="enter" targetRef="split-rate" />
    <bpmn:sequenceFlow id="f-split-rate-rate-company" sourceRef="split-rate" targetRef="rate-company" />
    <bpmn:sequenceFlow id="f-split-rate-rate-applicant" sourceRef="split-rate" targetRef="rate-applicant" />
    <bpmn:sequenceFlow id="f-rate-company-join-rate" sourceRef="rate-company" targetRef="join-rate" />
    <bpmn:sequenceFlow id="f-rate-applicant-join-rate" sourceRef="rate-applicant" targetRef="join-rate" />
    <bpmn:sequenceFlow id="f-join-rate-reviews" sourceRef="join-rate" targetRef="reviews" />
    <bpmn:sequenceFlow id="f-reviews-wait-year" sourceRef="reviews" targetRef="wait-year" />
    <bpmn:sequenceFlow id="f-wait-year-show-reviews" sourceRef="wait-year" targetRef="show-reviews" />
    <bpmn:sequenceFlow id="f-show-reviews-end-reviews" sourceRef="show-reviews" targetRef="end-reviews" />
    <bpmn:sequenceFlow id="f-reviews-permanent" sourceRef="reviews" targetRef="permanent" />
    <bpmn:sequenceFlow id="f-permanent-rated" name="yes" sourceRef="permanent" targetRef="rated" />
    <bpmn:sequenceFlow id="f-permanent-report" name="no" sourceRef="permanent" targetRef="report" />
    <bpmn:sequenceFlow id="f-rated-continue-offers" name="no" sourceRef="rated" targetRef="continue-offers" />
    <bpmn:sequenceFlow id="f-rated-ended" name="yes" sourceRef="rated" targetRef="ended" />
    <bpmn:sequenceFlow id="f-continue-offers-end-continued" sourceRef="continue-offers" targetRef="end-continued" />
  </bpmn:process>
</bpmn:definitions>
