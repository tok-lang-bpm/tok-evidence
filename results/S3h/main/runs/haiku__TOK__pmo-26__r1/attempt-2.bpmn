<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Maternity leave administration" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyCo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>periodEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ss" name="Social Security">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="planning" name="Parent plans maternity leave" />
    <bpmn:task id="fetch" name="Fetch information about potential leave models" />
    <bpmn:task id="select" name="Select leave model" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="notify" />
    <bpmn:task id="notifySS" name="Notify Social Security in time" />
    <bpmn:task id="notifyCo" name="Notify the company in time" />
    <bpmn:parallelGateway id="notified" />
    <bpmn:intermediateCatchEvent id="periodEnd" name="Leave period ends">
      <bpmn:timerEventDefinition id="periodEnd-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P12M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="extend" name="Extend leave?" />
    <bpmn:task id="request" name="Request leave extension" />
    <bpmn:endEvent id="extended" name="Leave extended" />
    <bpmn:endEvent id="ended" name="Leave ends" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:sequenceFlow id="f-planning-fetch" sourceRef="planning" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-collect" sourceRef="select" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-notify" sourceRef="collect" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-notifySS" sourceRef="notify" targetRef="notifySS" />
    <bpmn:sequenceFlow id="f-notifySS-notified" sourceRef="notifySS" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notify-notifyCo" sourceRef="notify" targetRef="notifyCo" />
    <bpmn:sequenceFlow id="f-notifyCo-notified" sourceRef="notifyCo" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notified-gather" sourceRef="notified" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-periodEnd" sourceRef="gather" targetRef="periodEnd" />
    <bpmn:sequenceFlow id="f-periodEnd-extend" sourceRef="periodEnd" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-request" name="yes" sourceRef="extend" targetRef="request" />
    <bpmn:sequenceFlow id="f-extend-ended" name="no" sourceRef="extend" targetRef="ended" />
    <bpmn:sequenceFlow id="f-request-extended" sourceRef="request" targetRef="extended" />
  </bpmn:process>
</bpmn:definitions>
