<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>experience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeCompany</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Internship needed" />
    <bpmn:task id="profile" name="Enter topic of interest and desired salary" />
    <bpmn:task id="experience" name="Enter experience and hobbies" />
    <bpmn:task id="review" name="Accept or deny offers" />
    <bpmn:exclusiveGateway id="accepted" name="Offer accepted?" default="f-accepted-review" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="write" name="Write status update about the internship">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">studentUpdates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="finish" name="Finish the internship" />
    <bpmn:task id="tweet" name="Send tweet recommending the company to a friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="recommended" name="Company recommended" />
    <bpmn:task id="offer" name="Send internship offers">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:task id="invalidate" name="Invalidate all other offers" />
    <bpmn:task id="writeCompany" name="Write status update about the student">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">companyUpdates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:sequenceFlow id="f-needed-profile" sourceRef="needed" targetRef="profile" />
    <bpmn:sequenceFlow id="f-profile-experience" sourceRef="profile" targetRef="experience" />
    <bpmn:sequenceFlow id="f-experience-offer" sourceRef="experience" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-review" sourceRef="offer" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accepted" sourceRef="review" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-review" name="nie" sourceRef="accepted" targetRef="review" />
    <bpmn:sequenceFlow id="f-accepted-split" name="tak" sourceRef="accepted" targetRef="split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">offerAccepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-split-invalidate" sourceRef="split" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f-split-write" sourceRef="split" targetRef="write" />
    <bpmn:sequenceFlow id="f-split-writeCompany" sourceRef="split" targetRef="writeCompany" />
    <bpmn:sequenceFlow id="f-invalidate-joined" sourceRef="invalidate" targetRef="joined" />
    <bpmn:sequenceFlow id="f-write-joined" sourceRef="write" targetRef="joined" />
    <bpmn:sequenceFlow id="f-writeCompany-joined" sourceRef="writeCompany" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-finish" sourceRef="joined" targetRef="finish" />
    <bpmn:sequenceFlow id="f-finish-tweet" sourceRef="finish" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-recommended" sourceRef="tweet" targetRef="recommended" />
  </bpmn:process>
</bpmn:definitions>
