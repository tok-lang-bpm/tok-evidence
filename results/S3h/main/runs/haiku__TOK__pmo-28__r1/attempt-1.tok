tok 1.0 "Internship"

pool org "Organisation"
  lane student "Student"
    start needed "Internship needed"
    task profile "Enter topic of interest and desired salary"
    task experience "Enter experience and hobbies"
    task review "Accept or deny offers"
    xor accepted "Offer accepted?"
    and split
    task write "Write status update about the internship" loop while="studentUpdates < 3"
    and joined
    task finish "Finish the internship"
    task tweet "Send tweet recommending the company to a friend" parallel
    end recommended "Company recommended"
  lane company "Company"
    task offer "Send internship offers" parallel
    task invalidate "Invalidate all other offers"
    task writeCompany "Write status update about the student" loop while="companyUpdates < 3"

flow needed -> profile -> experience -> offer -> review -> accepted
flow accepted -> review "nie" default
flow accepted -> split "tak" when="offerAccepted"
flow split -> invalidate
flow split -> write
flow split -> writeCompany
flow invalidate -> joined
flow write -> joined
flow writeCompany -> joined
flow joined -> finish -> tweet -> recommended
