tok 1.0 "Work and Live in Austria"

pool austria "Work and Live in Austria"
  lane applicant "Applicant"
    start begin "Start: plan to work and live in Austria"
    task checkReq "Check the requirements for working and living in Austria"
    task prepDocs "Prepare the visa application documents"
    task getInsurance "Obtain travel health insurance (30,000 EUR, valid in Schengen area)"
    task proveFunds "Provide proof of sufficient means of subsistence"
    task getPhoto "Obtain a passport photo (35 x 45 mm)"
    task getTravelDoc "Check travel document validity and empty pages"
    task fillForm "Fill in the visa application form"
    task submitApp "Submit the visa application to the competent representation office"
    task contactRep "Contact the representation office for additional information"
    task provideExtra "Provide additional documents requested by the authority"
    task negotiateAccom "Negotiate accommodation"
    task negotiateBank "Negotiate bank account"
    task applyRWR "Apply for the Rot-Weiss-Rot Card"
    task renewVisa "Renew the visa every x months"
    end done "Working and living in Austria arranged"
    end refused "Visa application refused"

  lane authority "Representation office (BMEIA)"
    task reviewApp "Review the visa application"
    xor complete "Application complete?"
    xor decision "Visa decision"
    task issueVisa "Issue the visa"
    task requestMissing "Request missing or additional documents"
    task checkCompetence "Determine territorial competence of the representation office"
    task checkGrounds "Check for grounds of refusal (residence prohibition, Schengen alert)"

flow begin -> checkReq -> contactRep -> checkCompetence -> prepDocs
flow prepDocs -> getTravelDoc -> getPhoto -> getInsurance -> proveFunds -> fillForm -> submitApp
flow submitApp -> reviewApp -> complete
flow complete -> checkGrounds "yes" when="true"
flow complete -> requestMissing "no"
flow requestMissing -> provideExtra -> reviewApp
flow checkGrounds -> decision
flow decision -> issueVisa "granted"
flow decision -> refused "refused"
flow issueVisa -> negotiateAccom -> negotiateBank -> applyRWR -> renewVisa -> done
