<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and Live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proveFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getPhoto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getTravelDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fillForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contactRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideExtra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiateAccom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiateBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyRWR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>renewVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="authority" name="Representation office (BMEIA)">
        <bpmn:flowNodeRef>reviewApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCompetence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkGrounds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Start: plan to work and live in Austria" />
    <bpmn:task id="checkReq" name="Check the requirements for working and living in Austria" />
    <bpmn:task id="prepDocs" name="Prepare the visa application documents" />
    <bpmn:task id="getInsurance" name="Obtain travel health insurance (30,000 EUR, valid in Schengen area)" />
    <bpmn:task id="proveFunds" name="Provide proof of sufficient means of subsistence" />
    <bpmn:task id="getPhoto" name="Obtain a passport photo (35 x 45 mm)" />
    <bpmn:task id="getTravelDoc" name="Check travel document validity and empty pages" />
    <bpmn:task id="fillForm" name="Fill in the visa application form" />
    <bpmn:task id="submitApp" name="Submit the visa application to the competent representation office" />
    <bpmn:task id="contactRep" name="Contact the representation office for additional information" />
    <bpmn:task id="provideExtra" name="Provide additional documents requested by the authority" />
    <bpmn:task id="negotiateAccom" name="Negotiate accommodation" />
    <bpmn:task id="negotiateBank" name="Negotiate bank account" />
    <bpmn:task id="applyRWR" name="Apply for the Rot-Weiss-Rot Card" />
    <bpmn:task id="renewVisa" name="Renew the visa every x months" />
    <bpmn:endEvent id="done" name="Working and living in Austria arranged" />
    <bpmn:endEvent id="refused" name="Visa application refused" />
    <bpmn:task id="reviewApp" name="Review the visa application" />
    <bpmn:exclusiveGateway id="complete" name="Application complete?" default="f-complete-requestMissing" />
    <bpmn:exclusiveGateway id="decision" name="Visa decision" />
    <bpmn:task id="issueVisa" name="Issue the visa" />
    <bpmn:task id="requestMissing" name="Request missing or additional documents" />
    <bpmn:task id="checkCompetence" name="Determine territorial competence of the representation office" />
    <bpmn:task id="checkGrounds" name="Check for grounds of refusal (residence prohibition, Schengen alert)" />
    <bpmn:sequenceFlow id="f-begin-checkReq" sourceRef="begin" targetRef="checkReq" />
    <bpmn:sequenceFlow id="f-checkReq-contactRep" sourceRef="checkReq" targetRef="contactRep" />
    <bpmn:sequenceFlow id="f-contactRep-checkCompetence" sourceRef="contactRep" targetRef="checkCompetence" />
    <bpmn:sequenceFlow id="f-checkCompetence-prepDocs" sourceRef="checkCompetence" targetRef="prepDocs" />
    <bpmn:sequenceFlow id="f-prepDocs-getTravelDoc" sourceRef="prepDocs" targetRef="getTravelDoc" />
    <bpmn:sequenceFlow id="f-getTravelDoc-getPhoto" sourceRef="getTravelDoc" targetRef="getPhoto" />
    <bpmn:sequenceFlow id="f-getPhoto-getInsurance" sourceRef="getPhoto" targetRef="getInsurance" />
    <bpmn:sequenceFlow id="f-getInsurance-proveFunds" sourceRef="getInsurance" targetRef="proveFunds" />
    <bpmn:sequenceFlow id="f-proveFunds-fillForm" sourceRef="proveFunds" targetRef="fillForm" />
    <bpmn:sequenceFlow id="f-fillForm-submitApp" sourceRef="fillForm" targetRef="submitApp" />
    <bpmn:sequenceFlow id="f-submitApp-reviewApp" sourceRef="submitApp" targetRef="reviewApp" />
    <bpmn:sequenceFlow id="f-reviewApp-complete" sourceRef="reviewApp" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-checkGrounds" name="yes" sourceRef="complete" targetRef="checkGrounds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-complete-requestMissing" name="no" sourceRef="complete" targetRef="requestMissing" />
    <bpmn:sequenceFlow id="f-requestMissing-provideExtra" sourceRef="requestMissing" targetRef="provideExtra" />
    <bpmn:sequenceFlow id="f-provideExtra-reviewApp" sourceRef="provideExtra" targetRef="reviewApp" />
    <bpmn:sequenceFlow id="f-checkGrounds-decision" sourceRef="checkGrounds" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-issueVisa" name="granted" sourceRef="decision" targetRef="issueVisa" />
    <bpmn:sequenceFlow id="f-decision-refused" name="refused" sourceRef="decision" targetRef="refused" />
    <bpmn:sequenceFlow id="f-issueVisa-negotiateAccom" sourceRef="issueVisa" targetRef="negotiateAccom" />
    <bpmn:sequenceFlow id="f-negotiateAccom-negotiateBank" sourceRef="negotiateAccom" targetRef="negotiateBank" />
    <bpmn:sequenceFlow id="f-negotiateBank-applyRWR" sourceRef="negotiateBank" targetRef="applyRWR" />
    <bpmn:sequenceFlow id="f-applyRWR-renewVisa" sourceRef="applyRWR" targetRef="renewVisa" />
    <bpmn:sequenceFlow id="f-renewVisa-done" sourceRef="renewVisa" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
