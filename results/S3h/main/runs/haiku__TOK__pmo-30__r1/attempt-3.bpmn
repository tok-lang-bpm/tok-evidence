<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organiser" name="Organiser" processRef="organiser-process" />
  </bpmn:collaboration>
  <bpmn:process id="organiser-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="organiser-lanes">
      <bpmn:lane id="host" name="Host">
        <bpmn:flowNodeRef>planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dateOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findOtherDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dateSet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gamesReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beerReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="planning" name="Planning the LAN party" />
    <bpmn:task id="invite" name="Send invitations to the 10 friends" />
    <bpmn:task id="askGames" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="appointDate" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="dateOk" name="8 or more people agree on the date?" />
    <bpmn:task id="findOtherDate" name="Appoint another date" />
    <bpmn:exclusiveGateway id="dateSet" />
    <bpmn:exclusiveGateway id="games" name="Do you have all the games?" />
    <bpmn:task id="download" name="Download the missing games" />
    <bpmn:exclusiveGateway id="gamesReady" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="findBeer" name="Find out how much beer is required" />
    <bpmn:exclusiveGateway id="beer" name="Enough beer?" />
    <bpmn:task id="buyBeer" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="beerReady" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="done" name="LAN party finished" />
    <bpmn:sequenceFlow id="f-planning-invite" sourceRef="planning" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-askGames" sourceRef="invite" targetRef="askGames" />
    <bpmn:sequenceFlow id="f-askGames-fork" sourceRef="askGames" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-appointDate" sourceRef="fork" targetRef="appointDate" />
    <bpmn:sequenceFlow id="f-appointDate-dateOk" sourceRef="appointDate" targetRef="dateOk" />
    <bpmn:sequenceFlow id="f-dateOk-dateSet" name="yes" sourceRef="dateOk" targetRef="dateSet" />
    <bpmn:sequenceFlow id="f-dateOk-findOtherDate" name="no" sourceRef="dateOk" targetRef="findOtherDate" />
    <bpmn:sequenceFlow id="f-findOtherDate-dateOk" sourceRef="findOtherDate" targetRef="dateOk" />
    <bpmn:sequenceFlow id="f-dateSet-joined" sourceRef="dateSet" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-games" sourceRef="fork" targetRef="games" />
    <bpmn:sequenceFlow id="f-games-gamesReady" name="yes" sourceRef="games" targetRef="gamesReady" />
    <bpmn:sequenceFlow id="f-games-download" name="no" sourceRef="games" targetRef="download" />
    <bpmn:sequenceFlow id="f-download-gamesReady" sourceRef="download" targetRef="gamesReady" />
    <bpmn:sequenceFlow id="f-gamesReady-joined" sourceRef="gamesReady" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-findBeer" sourceRef="joined" targetRef="findBeer" />
    <bpmn:sequenceFlow id="f-findBeer-beer" sourceRef="findBeer" targetRef="beer" />
    <bpmn:sequenceFlow id="f-beer-beerReady" name="yes" sourceRef="beer" targetRef="beerReady" />
    <bpmn:sequenceFlow id="f-beer-buyBeer" name="no" sourceRef="beer" targetRef="buyBeer" />
    <bpmn:sequenceFlow id="f-buyBeer-beerReady" sourceRef="buyBeer" targetRef="beerReady" />
    <bpmn:sequenceFlow id="f-beerReady-enjoy" sourceRef="beerReady" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-done" sourceRef="enjoy" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
