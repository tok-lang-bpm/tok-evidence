<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Expansion_released" name="Expansion released" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clickLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterIban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loginGame</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectRealm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterNames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="generator" name="Character generator">
        <bpmn:flowNodeRef>checkAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accountReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>subReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nameFree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>makeSelfies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendExpansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Start creating a character" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="names" name="Come up with good character names" />
    <bpmn:task id="enterAccount" name="Enter the account information" />
    <bpmn:task id="clickLink" name="Click the link in the confirmation mail" />
    <bpmn:exclusiveGateway id="payChoice" name="Payment method?" />
    <bpmn:task id="payMethod" name="Select the payment method" />
    <bpmn:task id="enterCard" name="Enter the credit card information" />
    <bpmn:task id="enterIban" name="Enter the IBAN and BIC numbers" />
    <bpmn:parallelGateway id="joinAll" />
    <bpmn:task id="loginGame" name="Log into the game" />
    <bpmn:task id="selectRealm" name="Select realm, race and class" />
    <bpmn:task id="enterNames" name="Enter the names one by one" />
    <bpmn:parallelGateway id="fork2" />
    <bpmn:task id="checkAccount" name="Check whether you have a battle.net account" />
    <bpmn:exclusiveGateway id="hasAccount" name="Battle.net account exists?" />
    <bpmn:exclusiveGateway id="accountReady" />
    <bpmn:task id="checkSub" name="Check whether you have an active WoW subscription" />
    <bpmn:exclusiveGateway id="hasSub" name="Active WoW subscription?" />
    <bpmn:exclusiveGateway id="subReady" />
    <bpmn:task id="checkName" name="Check whether the name is still available" />
    <bpmn:exclusiveGateway id="nameFree" name="Name still available?" />
    <bpmn:task id="sendConfirm" name="Send the confirmation" />
    <bpmn:task id="makeSelfies" name="Create selfies of your character" />
    <bpmn:parallelGateway id="joinEnd" />
    <bpmn:intermediateCatchEvent id="expansion" name="Expansion released">
      <bpmn:messageEventDefinition id="expansion-def" messageRef="Message_Expansion_released" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="sendExpansion" name="Send the message about the expansion" />
    <bpmn:endEvent id="finished" name="Character created" />
    <bpmn:sequenceFlow id="f-begin-fork" sourceRef="begin" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-names" sourceRef="fork" targetRef="names" />
    <bpmn:sequenceFlow id="f-names-joinAll" sourceRef="names" targetRef="joinAll" />
    <bpmn:sequenceFlow id="f-fork-checkAccount" sourceRef="fork" targetRef="checkAccount" />
    <bpmn:sequenceFlow id="f-checkAccount-hasAccount" sourceRef="checkAccount" targetRef="hasAccount" />
    <bpmn:sequenceFlow id="f-hasAccount-accountReady" name="yes" sourceRef="hasAccount" targetRef="accountReady" />
    <bpmn:sequenceFlow id="f-hasAccount-enterAccount" name="no" sourceRef="hasAccount" targetRef="enterAccount" />
    <bpmn:sequenceFlow id="f-enterAccount-clickLink" sourceRef="enterAccount" targetRef="clickLink" />
    <bpmn:sequenceFlow id="f-clickLink-accountReady" sourceRef="clickLink" targetRef="accountReady" />
    <bpmn:sequenceFlow id="f-accountReady-checkSub" sourceRef="accountReady" targetRef="checkSub" />
    <bpmn:sequenceFlow id="f-checkSub-hasSub" sourceRef="checkSub" targetRef="hasSub" />
    <bpmn:sequenceFlow id="f-hasSub-subReady" name="yes" sourceRef="hasSub" targetRef="subReady" />
    <bpmn:sequenceFlow id="f-hasSub-payMethod" name="no" sourceRef="hasSub" targetRef="payMethod" />
    <bpmn:sequenceFlow id="f-payMethod-payChoice" sourceRef="payMethod" targetRef="payChoice" />
    <bpmn:sequenceFlow id="f-payChoice-enterCard" name="credit card" sourceRef="payChoice" targetRef="enterCard" />
    <bpmn:sequenceFlow id="f-payChoice-enterIban" name="bank account" sourceRef="payChoice" targetRef="enterIban" />
    <bpmn:sequenceFlow id="f-enterCard-subReady" sourceRef="enterCard" targetRef="subReady" />
    <bpmn:sequenceFlow id="f-enterIban-subReady" sourceRef="enterIban" targetRef="subReady" />
    <bpmn:sequenceFlow id="f-subReady-joinAll" sourceRef="subReady" targetRef="joinAll" />
    <bpmn:sequenceFlow id="f-joinAll-loginGame" sourceRef="joinAll" targetRef="loginGame" />
    <bpmn:sequenceFlow id="f-loginGame-selectRealm" sourceRef="loginGame" targetRef="selectRealm" />
    <bpmn:sequenceFlow id="f-selectRealm-enterNames" sourceRef="selectRealm" targetRef="enterNames" />
    <bpmn:sequenceFlow id="f-enterNames-checkName" sourceRef="enterNames" targetRef="checkName" />
    <bpmn:sequenceFlow id="f-checkName-nameFree" sourceRef="checkName" targetRef="nameFree" />
    <bpmn:sequenceFlow id="f-nameFree-enterNames" name="no" sourceRef="nameFree" targetRef="enterNames" />
    <bpmn:sequenceFlow id="f-nameFree-fork2" name="yes" sourceRef="nameFree" targetRef="fork2" />
    <bpmn:sequenceFlow id="f-fork2-sendConfirm" sourceRef="fork2" targetRef="sendConfirm" />
    <bpmn:sequenceFlow id="f-sendConfirm-joinEnd" sourceRef="sendConfirm" targetRef="joinEnd" />
    <bpmn:sequenceFlow id="f-fork2-makeSelfies" sourceRef="fork2" targetRef="makeSelfies" />
    <bpmn:sequenceFlow id="f-makeSelfies-joinEnd" sourceRef="makeSelfies" targetRef="joinEnd" />
    <bpmn:sequenceFlow id="f-joinEnd-expansion" sourceRef="joinEnd" targetRef="expansion" />
    <bpmn:sequenceFlow id="f-expansion-sendExpansion" sourceRef="expansion" targetRef="sendExpansion" />
    <bpmn:sequenceFlow id="f-sendExpansion-finished" sourceRef="sendExpansion" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
