tok 1.0 "Farming Bot"

pool farm "Farming Bot"
  lane player "Player"
    start needed "Bot needed"
    task find "Find out which resources you want"
    task rank "Set the urgency of each resource"
    task deps "Define the dependencies between resources"
    task update "Update the list of materials to be farmed"
    or split "Brag and/or send materials?"
    task brag "Brag to selected friends"
    task sendm "Send materials to selected friends"
    or joined
    end done "Bot used"
  lane bot "Farming bot"
    task collect "Collect all preferences"
    task start "Start farming"
    and fork
    task gather "Collect up to 10 resources in parallel" parallel
    xor dis "Natural disaster strikes?"
    task recover "Recover the bot from the disaster"
    xor merge
    task notify "Notify the player when a milestone is reached"
    and fjoin

flow needed -> find -> rank -> deps -> collect -> start -> fork
flow fork -> gather -> fjoin
flow fork -> dis
flow dis -> recover "yes"
flow dis -> merge "no" default
flow recover -> merge -> fjoin
flow fork -> notify -> fjoin
flow fork -> update -> fjoin
flow fjoin -> split
flow split -> brag "yes"
flow split -> sendm "yes"
flow brag -> joined
flow sendm -> joined
flow joined -> done
