<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Instruct an artist to create a 3D model and print it" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="maker" name="Maker" processRef="maker-process" />
  </bpmn:collaboration>
  <bpmn:process id="maker-process" name="Instruct an artist to create a 3D model and print it" isExecutable="false">
    <bpmn:laneSet id="maker-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>craving</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>projectReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkLeft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shoppingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderPlastic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>havePlastic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>startPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>genGcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readyPrint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>createProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviseProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSTL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printer" name="3D printer">
        <bpmn:flowNodeRef>turnOn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heatUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printModel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="craving" name="Custom 3D model craved" />
    <bpmn:task id="instruct" name="Instruct the artist to create a project" />
    <bpmn:task id="sendSketches" name="Send several sketches to the artist" />
    <bpmn:exclusiveGateway id="projectReady" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with the result?" />
    <bpmn:task id="tellChanges" name="Tell the artist what to change" />
    <bpmn:task id="chooseColor" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="inStock" name="Color in stock at home?" />
    <bpmn:task id="checkLeft" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under100" name="Less than 100 grams left?" />
    <bpmn:task id="shoppingList" name="Put the color on the shopping list" />
    <bpmn:task id="orderPlastic" name="Order the plastic" />
    <bpmn:exclusiveGateway id="havePlastic" />
    <bpmn:parallelGateway id="startPrep" />
    <bpmn:task id="genGcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="readyPrint" />
    <bpmn:endEvent id="done" name="Model printed" />
    <bpmn:task id="createProject" name="Create the project" />
    <bpmn:task id="reviseProject" name="Change the project" />
    <bpmn:task id="sendSTL" name="Send the STL file" />
    <bpmn:task id="turnOn" name="Turn the printer on" />
    <bpmn:task id="heatUp" name="Heat up the bed and the extruder" />
    <bpmn:task id="reportStatus" name="Send its status back to you" />
    <bpmn:task id="printModel" name="Print the model" />
    <bpmn:sequenceFlow id="f-craving-instruct" sourceRef="craving" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-sendSketches" sourceRef="instruct" targetRef="sendSketches" />
    <bpmn:sequenceFlow id="f-sendSketches-createProject" sourceRef="sendSketches" targetRef="createProject" />
    <bpmn:sequenceFlow id="f-createProject-projectReady" sourceRef="createProject" targetRef="projectReady" />
    <bpmn:sequenceFlow id="f-projectReady-satisfied" sourceRef="projectReady" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-satisfied-tellChanges" name="no" sourceRef="satisfied" targetRef="tellChanges" />
    <bpmn:sequenceFlow id="f-tellChanges-reviseProject" sourceRef="tellChanges" targetRef="reviseProject" />
    <bpmn:sequenceFlow id="f-reviseProject-projectReady" sourceRef="reviseProject" targetRef="projectReady" />
    <bpmn:sequenceFlow id="f-satisfied-sendSTL" name="yes" sourceRef="satisfied" targetRef="sendSTL" />
    <bpmn:sequenceFlow id="f-sendSTL-chooseColor" sourceRef="sendSTL" targetRef="chooseColor" />
    <bpmn:sequenceFlow id="f-chooseColor-inStock" sourceRef="chooseColor" targetRef="inStock" />
    <bpmn:sequenceFlow id="f-inStock-checkLeft" name="yes" sourceRef="inStock" targetRef="checkLeft" />
    <bpmn:sequenceFlow id="f-checkLeft-under100" sourceRef="checkLeft" targetRef="under100" />
    <bpmn:sequenceFlow id="f-inStock-orderPlastic" name="no" sourceRef="inStock" targetRef="orderPlastic" />
    <bpmn:sequenceFlow id="f-orderPlastic-havePlastic" sourceRef="orderPlastic" targetRef="havePlastic" />
    <bpmn:sequenceFlow id="f-under100-shoppingList" name="yes" sourceRef="under100" targetRef="shoppingList" />
    <bpmn:sequenceFlow id="f-shoppingList-havePlastic" sourceRef="shoppingList" targetRef="havePlastic" />
    <bpmn:sequenceFlow id="f-under100-havePlastic" name="no" sourceRef="under100" targetRef="havePlastic" />
    <bpmn:sequenceFlow id="f-havePlastic-startPrep" sourceRef="havePlastic" targetRef="startPrep" />
    <bpmn:sequenceFlow id="f-startPrep-turnOn" sourceRef="startPrep" targetRef="turnOn" />
    <bpmn:sequenceFlow id="f-turnOn-heatUp" sourceRef="turnOn" targetRef="heatUp" />
    <bpmn:sequenceFlow id="f-heatUp-reportStatus" sourceRef="heatUp" targetRef="reportStatus" />
    <bpmn:sequenceFlow id="f-reportStatus-readyPrint" sourceRef="reportStatus" targetRef="readyPrint" />
    <bpmn:sequenceFlow id="f-startPrep-genGcode" sourceRef="startPrep" targetRef="genGcode" />
    <bpmn:sequenceFlow id="f-genGcode-readyPrint" sourceRef="genGcode" targetRef="readyPrint" />
    <bpmn:sequenceFlow id="f-readyPrint-printModel" sourceRef="readyPrint" targetRef="printModel" />
    <bpmn:sequenceFlow id="f-printModel-done" sourceRef="printModel" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
