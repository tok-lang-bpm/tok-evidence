<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="maker" name="Machine builder" processRef="maker-process" />
  </bpmn:collaboration>
  <bpmn:process id="maker-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="maker-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Group of children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Machine project started" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order the Lego brick sets" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:exclusiveGateway id="stock" name="Parts left in the container?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="build" name="Build the subcomponent" />
    <bpmn:task id="verify" name="Test the subcomponent individually" />
    <bpmn:exclusiveGateway id="testok" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign the subcomponent" />
    <bpmn:task id="rebuild" name="Rebuild the subcomponent" />
    <bpmn:task id="assemble" name="Assemble the subcomponent" />
    <bpmn:exclusiveGateway id="more" name="Subcomponents remaining?" />
    <bpmn:endEvent id="done" name="Machine built" />
    <bpmn:task id="sort" name="Sort the parts into containers" />
    <bpmn:sequenceFlow id="f-begin-design" sourceRef="begin" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-sort" sourceRef="order" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-ready" sourceRef="sort" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-stock" sourceRef="ready" targetRef="stock" />
    <bpmn:sequenceFlow id="f-stock-build" name="yes" sourceRef="stock" targetRef="build" />
    <bpmn:sequenceFlow id="f-stock-reorder" name="no" sourceRef="stock" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-reorder-ready" sourceRef="reorder" targetRef="ready" />
    <bpmn:sequenceFlow id="f-build-verify" sourceRef="build" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-testok" sourceRef="verify" targetRef="testok" />
    <bpmn:sequenceFlow id="f-testok-assemble" name="yes" sourceRef="testok" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-testok-redesign" name="no" sourceRef="testok" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-rebuild" sourceRef="redesign" targetRef="rebuild" />
    <bpmn:sequenceFlow id="f-rebuild-verify" sourceRef="rebuild" targetRef="verify" />
    <bpmn:sequenceFlow id="f-assemble-more" sourceRef="assemble" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-ready" name="yes" sourceRef="more" targetRef="ready" />
    <bpmn:sequenceFlow id="f-more-done" name="no" sourceRef="more" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
