<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_parts_delivered" name="parts-delivered" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Chainsaw workshop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notcontinued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="workshop" name="Workshop">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Chainsaw order needed" />
    <bpmn:task id="specify" name="Specify the chainsaw properties" />
    <bpmn:task id="evaluate" name="Evaluate the first saw" />
    <bpmn:exclusiveGateway id="liked" name="Customer likes the first saw?" />
    <bpmn:endEvent id="notcontinued" name="Rest of order not produced" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:task id="order" name="Order the parts from various online sources" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="updates" name="Send regular production updates to the customer" />
    <bpmn:intermediateCatchEvent id="arrived" name="Parts arrived">
      <bpmn:messageEventDefinition id="arrived-def" messageRef="Message_parts_delivered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inspect" name="Inspect all parts manually" />
    <bpmn:task id="assemble" name="Assemble the parts into the first saw" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="sendfirst" name="Send the first saw to the customer" />
    <bpmn:task id="produce" name="Produce the rest of the order" />
    <bpmn:sequenceFlow id="f-needed-specify" sourceRef="needed" targetRef="specify" />
    <bpmn:sequenceFlow id="f-specify-order" sourceRef="specify" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-fork" sourceRef="order" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-updates" sourceRef="fork" targetRef="updates" />
    <bpmn:sequenceFlow id="f-updates-joined" sourceRef="updates" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-arrived" sourceRef="fork" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-arrived-inspect" sourceRef="arrived" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-assemble" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-joined" sourceRef="assemble" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-sendfirst" sourceRef="joined" targetRef="sendfirst" />
    <bpmn:sequenceFlow id="f-sendfirst-evaluate" sourceRef="sendfirst" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-liked" sourceRef="evaluate" targetRef="liked" />
    <bpmn:sequenceFlow id="f-liked-produce" name="yes" sourceRef="liked" targetRef="produce" />
    <bpmn:sequenceFlow id="f-liked-notcontinued" name="no" sourceRef="liked" targetRef="notcontinued" />
    <bpmn:sequenceFlow id="f-produce-completed" sourceRef="produce" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
