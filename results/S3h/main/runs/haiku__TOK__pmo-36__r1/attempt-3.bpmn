<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="manufacturer" name="Airplane manufacturer" processRef="manufacturer-process" />
  </bpmn:collaboration>
  <bpmn:process id="manufacturer-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="manufacturer-lanes">
      <bpmn:lane id="customer_mgmt" name="Sales">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teams" name="Manufacturing teams">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vodka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>whiskey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bar3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bar4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bar5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>water</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assembly" name="Assembly">
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testflight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_protocol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="delivery" name="Delivery">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="client" name="Customer">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Customer order received" />
    <bpmn:task id="specify" name="Record the customer specifications" />
    <bpmn:task id="send_req" name="Send the requirements to the manufacturing teams" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="vodka" name="Manufacture the vodka bar" />
    <bpmn:task id="whiskey" name="Manufacture the whiskey bar" />
    <bpmn:task id="bar3" name="Manufacture the third bar" />
    <bpmn:task id="bar4" name="Manufacture the fourth bar" />
    <bpmn:task id="bar5" name="Manufacture the fifth bar" />
    <bpmn:task id="seats" name="Manufacture the seats" />
    <bpmn:task id="color" name="Apply the color" />
    <bpmn:task id="water" name="Install the toilet water system" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="assemble" name="Assemble the interior of the plane" />
    <bpmn:task id="testflight" name="Send the plane on a test flight" />
    <bpmn:task id="protocol" name="Create the test protocol" />
    <bpmn:task id="send_protocol" name="Send the test protocol to the manufacturer and the customer" />
    <bpmn:task id="deliver" name="Deliver the plane to the customer" />
    <bpmn:task id="confirm" name="Confirm the delivery" />
    <bpmn:endEvent id="confirmed" name="Delivery confirmed" />
    <bpmn:sequenceFlow id="f-received-specify" sourceRef="received" targetRef="specify" />
    <bpmn:sequenceFlow id="f-specify-send_req" sourceRef="specify" targetRef="send_req" />
    <bpmn:sequenceFlow id="f-send_req-split" sourceRef="send_req" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-vodka" sourceRef="split" targetRef="vodka" />
    <bpmn:sequenceFlow id="f-vodka-joined" sourceRef="vodka" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-whiskey" sourceRef="split" targetRef="whiskey" />
    <bpmn:sequenceFlow id="f-whiskey-joined" sourceRef="whiskey" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-bar3" sourceRef="split" targetRef="bar3" />
    <bpmn:sequenceFlow id="f-bar3-joined" sourceRef="bar3" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-bar4" sourceRef="split" targetRef="bar4" />
    <bpmn:sequenceFlow id="f-bar4-joined" sourceRef="bar4" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-bar5" sourceRef="split" targetRef="bar5" />
    <bpmn:sequenceFlow id="f-bar5-joined" sourceRef="bar5" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-seats" sourceRef="split" targetRef="seats" />
    <bpmn:sequenceFlow id="f-seats-joined" sourceRef="seats" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-color" sourceRef="split" targetRef="color" />
    <bpmn:sequenceFlow id="f-color-joined" sourceRef="color" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-water" sourceRef="split" targetRef="water" />
    <bpmn:sequenceFlow id="f-water-joined" sourceRef="water" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-assemble" sourceRef="joined" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-testflight" sourceRef="assemble" targetRef="testflight" />
    <bpmn:sequenceFlow id="f-testflight-protocol" sourceRef="testflight" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-protocol-send_protocol" sourceRef="protocol" targetRef="send_protocol" />
    <bpmn:sequenceFlow id="f-send_protocol-deliver" sourceRef="send_protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
