tok 1.0 "Luxury Airplane"

pool manufacturer "Airplane manufacturer"
  lane customer_mgmt "Sales"
    start received "Customer order received"
    task specify "Record the customer specifications"
    task send_req "Send the requirements to the manufacturing teams"
  lane teams "Manufacturing teams"
    and split
    task vodka "Manufacture the vodka bar"
    task whiskey "Manufacture the whiskey bar"
    task bar3 "Manufacture the third bar"
    task bar4 "Manufacture the fourth bar"
    task bar5 "Manufacture the fifth bar"
    task seats "Manufacture the seats"
    task color "Apply the color"
    task water "Install the toilet water system"
    and joined
  lane assembly "Assembly"
    task assemble "Assemble the interior of the plane"
    task testflight "Send the plane on a test flight"
    task protocol "Create the test protocol"
    task send_protocol "Send the test protocol to the manufacturer and the customer"
  lane delivery "Delivery"
    task deliver "Deliver the plane to the customer"
  lane client "Customer"
    task confirm "Confirm the delivery"
    end confirmed "Delivery confirmed"

flow received -> specify -> send_req -> split
flow split -> vodka -> joined
flow split -> whiskey -> joined
flow split -> bar3 -> joined
flow split -> bar4 -> joined
flow split -> bar5 -> joined
flow split -> seats -> joined
flow split -> color -> joined
flow split -> water -> joined
flow joined -> assemble -> testflight -> protocol -> send_protocol -> deliver -> confirm -> confirmed
