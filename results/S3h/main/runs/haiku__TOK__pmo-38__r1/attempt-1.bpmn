<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="Tree house project" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="owner" name="You">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>listmat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>messages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online stores">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Tree house wanted" />
    <bpmn:task id="collect" name="Collect the requirements" />
    <bpmn:task id="sendreq" name="Send the requirements to the architect" />
    <bpmn:exclusiveGateway id="reviewed" name="Draft final?" />
    <bpmn:task id="refine" name="Refine the draft with additional requirements" />
    <bpmn:task id="listmat" name="Create the list of needed materials from the plan" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="order" name="Order the materials from several online stores">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:task id="messages" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="invite" name="Send invitations to the party" />
    <bpmn:task id="attendees" name="Create the list of attendees" />
    <bpmn:task id="snacks" name="Buy the snacks for the party" />
    <bpmn:endEvent id="done" name="Party prepared" />
    <bpmn:task id="draft" name="Create the draft" />
    <bpmn:task id="sendback" name="Send the draft back" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:task id="build" name="Build the house" />
    <bpmn:sequenceFlow id="f-needed-collect" sourceRef="needed" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sendreq" sourceRef="collect" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-draft" sourceRef="sendreq" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-sendback" sourceRef="draft" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-reviewed" sourceRef="sendback" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-reviewed-listmat" name="yes" sourceRef="reviewed" targetRef="listmat" />
    <bpmn:sequenceFlow id="f-reviewed-refine" name="no" sourceRef="reviewed" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-sendreq" sourceRef="refine" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-listmat-split" sourceRef="listmat" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-order" sourceRef="split" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-process" sourceRef="order" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-joined" sourceRef="process" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-messages" sourceRef="split" targetRef="messages" />
    <bpmn:sequenceFlow id="f-messages-joined" sourceRef="messages" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-build" sourceRef="joined" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-invite" sourceRef="build" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-attendees" sourceRef="invite" targetRef="attendees" />
    <bpmn:sequenceFlow id="f-attendees-snacks" sourceRef="attendees" targetRef="snacks" />
    <bpmn:sequenceFlow id="f-snacks-done" sourceRef="snacks" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
