tok 1.0 "Building a House"

pool house "Tree house project"
  lane owner "You"
    start needed "Tree house wanted"
    task collect "Collect the requirements"
    task sendreq "Send the requirements to the architect"
    xor reviewed "Draft final?"
    task refine "Refine the draft with additional requirements"
    task listmat "Create the list of needed materials from the plan"
    and split
    task order "Order the materials from several online stores" parallel
    task messages "Send messages to friends to build the house"
    and joined
    task invite "Send invitations to the party"
    task attendees "Create the list of attendees"
    task snacks "Buy the snacks for the party"
    end done "Party prepared"
  lane architect "Architect"
    task draft "Create the draft"
    task sendback "Send the draft back"
  lane stores "Online stores"
    task process "Process the order"
  lane friends "Friends"
    task build "Build the house"

flow needed -> collect -> sendreq -> draft -> sendback -> reviewed
flow reviewed -> listmat "yes"
flow reviewed -> refine "no"
flow refine -> sendreq
flow listmat -> split
flow split -> order -> process -> joined
flow split -> messages -> joined
flow joined -> build -> invite -> attendees -> snacks -> done
