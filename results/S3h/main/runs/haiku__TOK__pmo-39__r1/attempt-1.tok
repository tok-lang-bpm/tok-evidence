tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool org "Online repair tool"
  lane customer "Customer"
    start started "Repair started"
    task enter "Enter the phone model and the damage"
    task checkOwned "Check which materials and tools you already have"
    task contact "Contact friends about borrowing or buying items"
    xor friendOffers "Friend offers an item cheaply?"
    xor itemsReady "Items for the repair available?"
    task buyRest "Buy the remaining materials and tools"
    task fix "Repair the screen yourself"
    xor worked "Repair successful?"
    or reviewGw "Send a review and/or video?"
    task review "Send a review of the repair"
    task video "Send a video of the repair"
    or reviewJoin "Review and/or video sent"
    end done "Repair completed"
    task sendExpert "Send the phone to an expert"
  lane tool "Repair tool"
    task listMaterials "Provide the list of materials and tools"
    task orderChoices "Offer ordering choices for each part"
    task instructions "Provide instructions how to fix the phone"
  lane friend "Friend"
    task offer "Offer the item cheaply"
  lane expert "Expert"
    task expertRepair "Repair the phone"
    end expertDone "Phone repaired by expert"

flow started -> enter -> listMaterials -> orderChoices -> checkOwned -> contact -> friendOffers
flow friendOffers -> offer "tak"
flow friendOffers -> itemsReady "nie" default
flow offer -> itemsReady
flow itemsReady -> buyRest -> instructions -> fix -> worked
flow worked -> reviewGw "tak"
flow worked -> sendExpert "nie" default
flow reviewGw -> review
flow reviewGw -> video
flow review -> reviewJoin
flow video -> reviewJoin
flow reviewJoin -> done
flow sendExpert -> expertRepair -> expertDone
