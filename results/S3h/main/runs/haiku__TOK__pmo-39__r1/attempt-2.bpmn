<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Online repair tool" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkOwned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>friendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>itemsReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>video</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendExpert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Repair tool">
        <bpmn:flowNodeRef>listMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderChoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friend" name="Friend">
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="expert" name="Expert">
        <bpmn:flowNodeRef>expertRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expertDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Repair started" />
    <bpmn:task id="enter" name="Enter the phone model and the damage" />
    <bpmn:task id="checkOwned" name="Check which materials and tools you already have" />
    <bpmn:task id="contact" name="Contact friends about borrowing or buying items" />
    <bpmn:exclusiveGateway id="friendOffers" name="Friend offers an item cheaply?" default="f-friendOffers-itemsReady" />
    <bpmn:exclusiveGateway id="itemsReady" name="Items for the repair available?" />
    <bpmn:task id="buyRest" name="Buy the remaining materials and tools" />
    <bpmn:task id="fix" name="Repair the screen yourself" />
    <bpmn:exclusiveGateway id="worked" name="Repair successful?" default="f-worked-sendExpert" />
    <bpmn:inclusiveGateway id="reviewGw" name="Send a review and/or video?" default="f-reviewGw-done" />
    <bpmn:task id="review" name="Send a review of the repair" />
    <bpmn:task id="video" name="Send a video of the repair" />
    <bpmn:inclusiveGateway id="reviewJoin" name="Review and/or video sent" />
    <bpmn:endEvent id="done" name="Repair completed" />
    <bpmn:task id="sendExpert" name="Send the phone to an expert" />
    <bpmn:task id="listMaterials" name="Provide the list of materials and tools" />
    <bpmn:task id="orderChoices" name="Offer ordering choices for each part" />
    <bpmn:task id="instructions" name="Provide instructions how to fix the phone" />
    <bpmn:task id="offer" name="Offer the item cheaply" />
    <bpmn:task id="expertRepair" name="Repair the phone" />
    <bpmn:endEvent id="expertDone" name="Phone repaired by expert" />
    <bpmn:sequenceFlow id="f-started-enter" sourceRef="started" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-listMaterials" sourceRef="enter" targetRef="listMaterials" />
    <bpmn:sequenceFlow id="f-listMaterials-orderChoices" sourceRef="listMaterials" targetRef="orderChoices" />
    <bpmn:sequenceFlow id="f-orderChoices-checkOwned" sourceRef="orderChoices" targetRef="checkOwned" />
    <bpmn:sequenceFlow id="f-checkOwned-contact" sourceRef="checkOwned" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact-friendOffers" sourceRef="contact" targetRef="friendOffers" />
    <bpmn:sequenceFlow id="f-friendOffers-offer" name="tak" sourceRef="friendOffers" targetRef="offer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cheapOffer = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-friendOffers-itemsReady" name="nie" sourceRef="friendOffers" targetRef="itemsReady" />
    <bpmn:sequenceFlow id="f-offer-itemsReady" sourceRef="offer" targetRef="itemsReady" />
    <bpmn:sequenceFlow id="f-itemsReady-buyRest" sourceRef="itemsReady" targetRef="buyRest" />
    <bpmn:sequenceFlow id="f-buyRest-instructions" sourceRef="buyRest" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-instructions-fix" sourceRef="instructions" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-worked" sourceRef="fix" targetRef="worked" />
    <bpmn:sequenceFlow id="f-worked-reviewGw" name="tak" sourceRef="worked" targetRef="reviewGw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">repairWorked = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-worked-sendExpert" name="nie" sourceRef="worked" targetRef="sendExpert" />
    <bpmn:sequenceFlow id="f-reviewGw-review" name="recenzja" sourceRef="reviewGw" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sendReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reviewGw-video" name="wideo" sourceRef="reviewGw" targetRef="video">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sendVideo = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reviewGw-done" name="nic" sourceRef="reviewGw" targetRef="done" />
    <bpmn:sequenceFlow id="f-review-reviewJoin" sourceRef="review" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f-video-reviewJoin" sourceRef="video" targetRef="reviewJoin" />
    <bpmn:sequenceFlow id="f-reviewJoin-done" sourceRef="reviewJoin" targetRef="done" />
    <bpmn:sequenceFlow id="f-sendExpert-expertRepair" sourceRef="sendExpert" targetRef="expertRepair" />
    <bpmn:sequenceFlow id="f-expertRepair-expertDone" sourceRef="expertRepair" targetRef="expertDone" />
  </bpmn:process>
</bpmn:definitions>
