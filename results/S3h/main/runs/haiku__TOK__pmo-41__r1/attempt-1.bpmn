<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Inspection organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterSerial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answerQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pressButtons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Inspection application">
        <bpmn:flowNodeRef>collectValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>showValues</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inspection requested" />
    <bpmn:task id="enterType" name="Enter the type of the machine" />
    <bpmn:task id="enterSerial" name="Enter the serial number" />
    <bpmn:exclusiveGateway id="needQuestions" name="Additional questions needed?" />
    <bpmn:task id="answerQuestions" name="Input the values for the questions" />
    <bpmn:task id="pressButtons" name="Press the buttons" />
    <bpmn:task id="reviewResults" name="Review the results" />
    <bpmn:exclusiveGateway id="more" name="Depending on the results, additional questions asked?" default="f-more-done" />
    <bpmn:endEvent id="done" name="Inspection completed" />
    <bpmn:task id="collectValues" name="Collect the values from the machine" />
    <bpmn:task id="showValues" name="Show the collected values" />
    <bpmn:sequenceFlow id="f-begin-enterType" sourceRef="begin" targetRef="enterType" />
    <bpmn:sequenceFlow id="f-enterType-enterSerial" sourceRef="enterType" targetRef="enterSerial" />
    <bpmn:sequenceFlow id="f-enterSerial-needQuestions" sourceRef="enterSerial" targetRef="needQuestions" />
    <bpmn:sequenceFlow id="f-needQuestions-answerQuestions" name="yes" sourceRef="needQuestions" targetRef="answerQuestions" />
    <bpmn:sequenceFlow id="f-needQuestions-pressButtons" name="no" sourceRef="needQuestions" targetRef="pressButtons" />
    <bpmn:sequenceFlow id="f-answerQuestions-pressButtons" sourceRef="answerQuestions" targetRef="pressButtons" />
    <bpmn:sequenceFlow id="f-pressButtons-collectValues" sourceRef="pressButtons" targetRef="collectValues" />
    <bpmn:sequenceFlow id="f-collectValues-showValues" sourceRef="collectValues" targetRef="showValues" />
    <bpmn:sequenceFlow id="f-showValues-reviewResults" sourceRef="showValues" targetRef="reviewResults" />
    <bpmn:sequenceFlow id="f-reviewResults-more" sourceRef="reviewResults" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-answerQuestions" name="additional questions" sourceRef="more" targetRef="answerQuestions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-done" name="no further questions" sourceRef="more" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
