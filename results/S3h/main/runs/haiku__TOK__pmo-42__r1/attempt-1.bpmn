<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="service" name="Fridge service" processRef="service-process" />
  </bpmn:collaboration>
  <bpmn:process id="service-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="service-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>noise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Local service facility">
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noise" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send the symptoms and the fridge type to the central fridge service center" />
    <bpmn:task id="confirm" name="Confirm that the fridge is working again" />
    <bpmn:exclusiveGateway id="rateq" name="Rate the service facility?" default="f-rateq-finished" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:endEvent id="rated" name="Service rated" />
    <bpmn:endEvent id="finished" name="Service finished" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:task id="appoint" name="Make an appointment" />
    <bpmn:task id="arrive" name="Arrive at a random time" />
    <bpmn:exclusiveGateway id="parts" name="Additional parts needed?" default="f-parts-repair" />
    <bpmn:task id="leave" name="Leave without repairing the fridge" />
    <bpmn:task id="repair" name="Repair the fridge" />
    <bpmn:sequenceFlow id="f-noise-describe" sourceRef="noise" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appoint" sourceRef="select" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-arrive" sourceRef="appoint" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-parts" sourceRef="arrive" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-leave" name="yes" sourceRef="parts" targetRef="leave" />
    <bpmn:sequenceFlow id="f-leave-appoint" sourceRef="leave" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-parts-repair" name="no" sourceRef="parts" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rateq" sourceRef="confirm" targetRef="rateq" />
    <bpmn:sequenceFlow id="f-rateq-rate" name="yes" sourceRef="rateq" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rateq-finished" name="no" sourceRef="rateq" targetRef="finished" />
    <bpmn:sequenceFlow id="f-rate-rated" sourceRef="rate" targetRef="rated" />
  </bpmn:process>
</bpmn:definitions>
