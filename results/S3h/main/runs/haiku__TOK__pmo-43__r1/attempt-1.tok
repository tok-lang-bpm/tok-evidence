tok 1.0 "Car Service"

pool office "Police and car service"
  lane police "Police app"
    start serviceDone "Service completed successfully"
    service checkReg "Check whether the car is still registered"
    xor registered "Car still registered?"
    send notify "Notify the driver of the service reminder"
    task fine "Fine the driver"
    end notRegistered "Reminder not sent"
    end fined "Driver fined"
  lane driver "Car driver"
    xor goes "Go to the car service?"
    task goService "Go to the car service"
    catch wait30 "30 days pass" timer=P30D
    task pay "Pay for the repair in the app"
  lane mechanic "Mechanic at the car service"
    task enterProblems "Enter the problems of the car for reference"
    and forkRepair "Repair and status updates"
    task repair "Repair the car"
    send statusUpdates "Send status updates by email" loop
    and joinRepair "Repair done"
    task enterSuccess "Enter that the repair was successful"
    task handover "Hand over the Pickerl"
    task enterNext "Enter the time of the next service"
    end done "Service finished"

flow serviceDone -> checkReg -> registered
flow registered -> notify "yes"
flow registered -> notRegistered "no"
flow notify -> goes
flow goes -> goService "yes"
flow goes -> wait30 "no"
flow wait30 -> fine -> fined
flow goService -> enterProblems -> forkRepair
flow forkRepair -> repair -> joinRepair
flow forkRepair -> statusUpdates -> joinRepair
flow joinRepair -> pay -> enterSuccess -> handover -> enterNext -> done
