<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askmenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menuq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepdrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askside</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepfries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepwedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sidedone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burgerready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepburger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updatestatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conveyor</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ordered" name="Order placed" />
    <bpmn:endEvent id="delivered" name="Order delivered" />
    <bpmn:task id="receive" name="Receive the order" />
    <bpmn:task id="askmenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="menuq" name="Customer wants a menu?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="prepdrink" name="Prepare the drink" />
    <bpmn:task id="askside" name="Ask whether the customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="side" name="Fries or wedges?" />
    <bpmn:task id="prepfries" name="Prepare the fries" />
    <bpmn:task id="prepwedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="sidedone" name="Side prepared" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:exclusiveGateway id="burgerready" name="Burger to prepare" />
    <bpmn:task id="prepburger" name="Prepare the burger" />
    <bpmn:task id="updatestatus" name="Give enthusiastic status updates every 30 seconds" />
    <bpmn:task id="conveyor" name="Deliver the order via the conveyor belt" />
    <bpmn:sequenceFlow id="f-ordered-receive" sourceRef="ordered" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-askmenu" sourceRef="receive" targetRef="askmenu" />
    <bpmn:sequenceFlow id="f-askmenu-menuq" sourceRef="askmenu" targetRef="menuq" />
    <bpmn:sequenceFlow id="f-menuq-split" name="yes" sourceRef="menuq" targetRef="split" />
    <bpmn:sequenceFlow id="f-menuq-burgerready" name="no" sourceRef="menuq" targetRef="burgerready" />
    <bpmn:sequenceFlow id="f-split-prepdrink" sourceRef="split" targetRef="prepdrink" />
    <bpmn:sequenceFlow id="f-prepdrink-joined" sourceRef="prepdrink" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-askside" sourceRef="split" targetRef="askside" />
    <bpmn:sequenceFlow id="f-askside-side" sourceRef="askside" targetRef="side" />
    <bpmn:sequenceFlow id="f-side-prepfries" name="fries" sourceRef="side" targetRef="prepfries" />
    <bpmn:sequenceFlow id="f-side-prepwedges" name="wedges" sourceRef="side" targetRef="prepwedges" />
    <bpmn:sequenceFlow id="f-prepfries-sidedone" sourceRef="prepfries" targetRef="sidedone" />
    <bpmn:sequenceFlow id="f-prepwedges-sidedone" sourceRef="prepwedges" targetRef="sidedone" />
    <bpmn:sequenceFlow id="f-sidedone-joined" sourceRef="sidedone" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-burgerready" sourceRef="joined" targetRef="burgerready" />
    <bpmn:sequenceFlow id="f-burgerready-prepburger" sourceRef="burgerready" targetRef="prepburger" />
    <bpmn:sequenceFlow id="f-prepburger-updatestatus" sourceRef="prepburger" targetRef="updatestatus" />
    <bpmn:sequenceFlow id="f-updatestatus-conveyor" sourceRef="updatestatus" targetRef="conveyor" />
    <bpmn:sequenceFlow id="f-conveyor-delivered" sourceRef="conveyor" targetRef="delivered" />
  </bpmn:process>
</bpmn:definitions>
