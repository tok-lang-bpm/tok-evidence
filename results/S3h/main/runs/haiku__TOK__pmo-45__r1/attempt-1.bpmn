<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loginOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saveProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billDiff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeBill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="E-Shop system">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preparePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>confirmPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wants" name="Customer wants to shop" />
    <bpmn:task id="login" name="Log into the E-Shop system" />
    <bpmn:task id="waitLogin" name="Wait for the login confirmation" />
    <bpmn:exclusiveGateway id="loginOk" name="Login successful?" />
    <bpmn:task id="select" name="Select a product" />
    <bpmn:task id="addCart" name="Add the product to the shopping cart" />
    <bpmn:task id="saveProduct" name="Save the product" />
    <bpmn:task id="checkAll" name="Check whether every product was selected" />
    <bpmn:exclusiveGateway id="allSelected" name="All products selected?" />
    <bpmn:task id="enterPayment" name="Enter the payment data" />
    <bpmn:task id="waitPayment" name="Wait for the payment confirmation" />
    <bpmn:task id="enterShipping" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="billDiff" name="Billing address differs from shipping address?" />
    <bpmn:task id="enterBilling" name="Enter the billing address" />
    <bpmn:exclusiveGateway id="mergeBill" />
    <bpmn:endEvent id="stopped" name="Shopping experience stopped" />
    <bpmn:task id="check" name="Check the credentials" />
    <bpmn:task id="finish" name="Finish the order" />
    <bpmn:parallelGateway id="forkPrep" />
    <bpmn:task id="preparePayment" name="Prepare the payment" />
    <bpmn:task id="prepareShipment" name="Prepare the shipment" />
    <bpmn:parallelGateway id="joinPay" />
    <bpmn:task id="complete" name="Complete the order" />
    <bpmn:endEvent id="done" name="Order finished" />
    <bpmn:task id="confirmPayment" name="Confirm the payment" />
    <bpmn:sequenceFlow id="f-wants-login" sourceRef="wants" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-check" sourceRef="login" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-waitLogin" sourceRef="check" targetRef="waitLogin" />
    <bpmn:sequenceFlow id="f-waitLogin-loginOk" sourceRef="waitLogin" targetRef="loginOk" />
    <bpmn:sequenceFlow id="f-loginOk-select" name="yes" sourceRef="loginOk" targetRef="select" />
    <bpmn:sequenceFlow id="f-loginOk-stopped" name="no" sourceRef="loginOk" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-select-addCart" sourceRef="select" targetRef="addCart" />
    <bpmn:sequenceFlow id="f-addCart-saveProduct" sourceRef="addCart" targetRef="saveProduct" />
    <bpmn:sequenceFlow id="f-saveProduct-checkAll" sourceRef="saveProduct" targetRef="checkAll" />
    <bpmn:sequenceFlow id="f-checkAll-allSelected" sourceRef="checkAll" targetRef="allSelected" />
    <bpmn:sequenceFlow id="f-allSelected-select" name="no" sourceRef="allSelected" targetRef="select" />
    <bpmn:sequenceFlow id="f-allSelected-finish" name="yes" sourceRef="allSelected" targetRef="finish" />
    <bpmn:sequenceFlow id="f-finish-forkPrep" sourceRef="finish" targetRef="forkPrep" />
    <bpmn:sequenceFlow id="f-forkPrep-preparePayment" sourceRef="forkPrep" targetRef="preparePayment" />
    <bpmn:sequenceFlow id="f-preparePayment-enterPayment" sourceRef="preparePayment" targetRef="enterPayment" />
    <bpmn:sequenceFlow id="f-enterPayment-confirmPayment" sourceRef="enterPayment" targetRef="confirmPayment" />
    <bpmn:sequenceFlow id="f-confirmPayment-waitPayment" sourceRef="confirmPayment" targetRef="waitPayment" />
    <bpmn:sequenceFlow id="f-waitPayment-joinPay" sourceRef="waitPayment" targetRef="joinPay" />
    <bpmn:sequenceFlow id="f-forkPrep-prepareShipment" sourceRef="forkPrep" targetRef="prepareShipment" />
    <bpmn:sequenceFlow id="f-prepareShipment-enterShipping" sourceRef="prepareShipment" targetRef="enterShipping" />
    <bpmn:sequenceFlow id="f-enterShipping-billDiff" sourceRef="enterShipping" targetRef="billDiff" />
    <bpmn:sequenceFlow id="f-billDiff-enterBilling" name="yes" sourceRef="billDiff" targetRef="enterBilling" />
    <bpmn:sequenceFlow id="f-billDiff-mergeBill" name="no" sourceRef="billDiff" targetRef="mergeBill" />
    <bpmn:sequenceFlow id="f-enterBilling-mergeBill" sourceRef="enterBilling" targetRef="mergeBill" />
    <bpmn:sequenceFlow id="f-mergeBill-joinPay" sourceRef="mergeBill" targetRef="joinPay" />
    <bpmn:sequenceFlow id="f-joinPay-complete" sourceRef="joinPay" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-done" sourceRef="complete" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
