<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Sports Institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>viewcourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkaccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasaccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkuni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestactivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitresponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registeraccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinreg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noslots</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wants" name="Want to register for a course" />
    <bpmn:task id="select" name="Select a course" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" default="f-slots-noslots" />
    <bpmn:task id="viewcourses" name="View the courses and dates" />
    <bpmn:task id="pick" name="Select one course and date" />
    <bpmn:task id="checkaccount" name="Check whether you have an account" />
    <bpmn:exclusiveGateway id="hasaccount" name="Have an account?" default="f-hasaccount-checkuni" />
    <bpmn:task id="checkuni" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Registered at an eligible university?" default="f-eligible-requestactivation" />
    <bpmn:task id="requestactivation" name="Request an activation" />
    <bpmn:task id="waitresponse" name="Wait for a response" />
    <bpmn:task id="registeraccount" name="Register your account" />
    <bpmn:parallelGateway id="joinacc" />
    <bpmn:task id="login" name="Log into your account" />
    <bpmn:parallelGateway id="joinreg" />
    <bpmn:task id="tweet" name="Tweet to friends who might want to join" />
    <bpmn:task id="completereg" name="Complete the registration for the course" />
    <bpmn:task id="payment" name="Provide the payment information" />
    <bpmn:task id="receiveticket" name="Receive the course ticket" />
    <bpmn:endEvent id="done" name="Course ticket received" />
    <bpmn:endEvent id="noslots" name="No free slots" />
    <bpmn:sequenceFlow id="f-wants-select" sourceRef="wants" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-slots" sourceRef="select" targetRef="slots" />
    <bpmn:sequenceFlow id="f-slots-viewcourses" name="yes" sourceRef="slots" targetRef="viewcourses" />
    <bpmn:sequenceFlow id="f-slots-noslots" name="no" sourceRef="slots" targetRef="noslots" />
    <bpmn:sequenceFlow id="f-viewcourses-pick" sourceRef="viewcourses" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-checkaccount" sourceRef="pick" targetRef="checkaccount" />
    <bpmn:sequenceFlow id="f-checkaccount-hasaccount" sourceRef="checkaccount" targetRef="hasaccount" />
    <bpmn:sequenceFlow id="f-hasaccount-joinacc" name="yes" sourceRef="hasaccount" targetRef="joinacc" />
    <bpmn:sequenceFlow id="f-hasaccount-checkuni" name="no" sourceRef="hasaccount" targetRef="checkuni" />
    <bpmn:sequenceFlow id="f-checkuni-eligible" sourceRef="checkuni" targetRef="eligible" />
    <bpmn:sequenceFlow id="f-eligible-registeraccount" name="yes" sourceRef="eligible" targetRef="registeraccount" />
    <bpmn:sequenceFlow id="f-eligible-requestactivation" name="no" sourceRef="eligible" targetRef="requestactivation" />
    <bpmn:sequenceFlow id="f-requestactivation-waitresponse" sourceRef="requestactivation" targetRef="waitresponse" />
    <bpmn:sequenceFlow id="f-waitresponse-joinacc" sourceRef="waitresponse" targetRef="joinacc" />
    <bpmn:sequenceFlow id="f-registeraccount-joinacc" sourceRef="registeraccount" targetRef="joinacc" />
    <bpmn:sequenceFlow id="f-joinacc-login" sourceRef="joinacc" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-joinreg" sourceRef="login" targetRef="joinreg" />
    <bpmn:sequenceFlow id="f-login-tweet" sourceRef="login" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-joinreg" sourceRef="tweet" targetRef="joinreg" />
    <bpmn:sequenceFlow id="f-joinreg-completereg" sourceRef="joinreg" targetRef="completereg" />
    <bpmn:sequenceFlow id="f-completereg-payment" sourceRef="completereg" targetRef="payment" />
    <bpmn:sequenceFlow id="f-payment-receiveticket" sourceRef="payment" targetRef="receiveticket" />
    <bpmn:sequenceFlow id="f-receiveticket-done" sourceRef="receiveticket" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
