tok 1.0 "New Application for Registering for an USI course"

pool institute "Sports Institute"
  lane applicant "Applicant"
    start wants "Want to register for a course"
    task select "Select a course"
    xor slots "Slots free?"
    task viewcourses "View the courses and dates"
    task pick "Select one course and date"
    task checkaccount "Check whether you have an account"
    xor hasaccount "Have an account?"
    task checkuni "Check whether you are registered at an eligible university"
    xor eligible "Registered at an eligible university?"
    task requestactivation "Request an activation"
    task waitresponse "Wait for a response"
    task registeraccount "Register your account"
    and joinacc
    task login "Log into your account"
    and joinreg
    task tweet "Tweet to friends who might want to join"
    task completereg "Complete the registration for the course"
    task payment "Provide the payment information"
    task receiveticket "Receive the course ticket"
    end done "Course ticket received"
    end noslots "No free slots"

flow wants -> select -> slots
flow slots -> viewcourses "yes" when="slotsFree = true"
flow slots -> noslots "no" default
flow viewcourses -> pick -> checkaccount -> hasaccount
flow hasaccount -> joinacc "yes" when="hasAccount = true"
flow hasaccount -> checkuni "no" default
flow checkuni -> eligible
flow eligible -> registeraccount "yes" when="eligibleUniversity = true"
flow eligible -> requestactivation "no" default
flow requestactivation -> waitresponse -> joinacc
flow registeraccount -> joinacc
flow joinacc -> login -> joinreg
flow login -> tweet -> joinreg
flow joinreg -> completereg -> payment -> receiveticket -> done
