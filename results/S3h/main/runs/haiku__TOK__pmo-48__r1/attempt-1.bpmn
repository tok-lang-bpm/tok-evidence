<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="App for participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Vienna Night Run" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="App for participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="participant" name="Participant">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getnum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gohome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>race</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="App">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Wants to participate in the Night Run" />
    <bpmn:task id="select" name="Select a starting block" />
    <bpmn:task id="run5" name="Run 5 km" />
    <bpmn:task id="train" name="Train" />
    <bpmn:task id="getnum" name="Get the starting number" />
    <bpmn:task id="findend" name="Find out when the work day ends" />
    <bpmn:task id="calc" name="Calculate the time left between starting time and end of work day" />
    <bpmn:exclusiveGateway id="hour" name="More than one hour left?" />
    <bpmn:task id="gohome" name="Go there from home" />
    <bpmn:task id="leave" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="merge_go" name="Go from home or work" />
    <bpmn:parallelGateway id="run_split" />
    <bpmn:task id="race" name="Run the Night Run" />
    <bpmn:task id="drink" name="Drink while running" />
    <bpmn:parallelGateway id="run_join" />
    <bpmn:task id="measure" name="Measure the time" />
    <bpmn:task id="check" name="Check the running time" />
    <bpmn:exclusiveGateway id="minutes" name="Less than 25 minutes?" />
    <bpmn:task id="receive" name="Receive the final running time" />
    <bpmn:endEvent id="done" name="Final running time received" />
    <bpmn:sequenceFlow id="f-begin-select" sourceRef="begin" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-run5" sourceRef="select" targetRef="run5" />
    <bpmn:sequenceFlow id="f-run5-measure" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f-measure-check" sourceRef="measure" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-minutes" sourceRef="check" targetRef="minutes" />
    <bpmn:sequenceFlow id="f-minutes-getnum" name="yes" sourceRef="minutes" targetRef="getnum" />
    <bpmn:sequenceFlow id="f-minutes-train" name="no" sourceRef="minutes" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-run5" sourceRef="train" targetRef="run5" />
    <bpmn:sequenceFlow id="f-getnum-findend" sourceRef="getnum" targetRef="findend" />
    <bpmn:sequenceFlow id="f-findend-calc" sourceRef="findend" targetRef="calc" />
    <bpmn:sequenceFlow id="f-calc-hour" sourceRef="calc" targetRef="hour" />
    <bpmn:sequenceFlow id="f-hour-gohome" name="yes" sourceRef="hour" targetRef="gohome" />
    <bpmn:sequenceFlow id="f-hour-leave" name="no" sourceRef="hour" targetRef="leave" />
    <bpmn:sequenceFlow id="f-gohome-merge_go" sourceRef="gohome" targetRef="merge_go" />
    <bpmn:sequenceFlow id="f-leave-merge_go" sourceRef="leave" targetRef="merge_go" />
    <bpmn:sequenceFlow id="f-merge_go-run_split" sourceRef="merge_go" targetRef="run_split" />
    <bpmn:sequenceFlow id="f-run_split-race" sourceRef="run_split" targetRef="race" />
    <bpmn:sequenceFlow id="f-run_split-drink" sourceRef="run_split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-race-run_join" sourceRef="race" targetRef="run_join" />
    <bpmn:sequenceFlow id="f-drink-run_join" sourceRef="drink" targetRef="run_join" />
    <bpmn:sequenceFlow id="f-run_join-receive" sourceRef="run_join" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-done" sourceRef="receive" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
