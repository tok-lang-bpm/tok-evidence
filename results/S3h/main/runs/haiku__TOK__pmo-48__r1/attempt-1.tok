tok 1.0 "App for participating at the Vienna Night Run"

pool org "Vienna Night Run"
  lane participant "Participant"
    start begin "Wants to participate in the Night Run"
    task select "Select a starting block"
    task run5 "Run 5 km"
    task train "Train"
    task getnum "Get the starting number"
    task findend "Find out when the work day ends"
    task calc "Calculate the time left between starting time and end of work day"
    xor hour "More than one hour left?"
    task gohome "Go there from home"
    task leave "Leave directly from work"
    xor merge_go "Go from home or work"
    and run_split
    task race "Run the Night Run"
    task drink "Drink while running"
    and run_join
  lane gadget "Fitness gadget"
    task measure "Measure the time"
  lane app "App"
    task check "Check the running time"
    xor minutes "Less than 25 minutes?"
    task receive "Receive the final running time"
    end done "Final running time received"

flow begin -> select -> run5 -> measure -> check -> minutes
flow minutes -> getnum "yes"
flow minutes -> train "no"
flow train -> run5
flow getnum -> findend -> calc -> hour
flow hour -> gohome "yes"
flow hour -> leave "no"
flow gohome -> merge_go
flow leave -> merge_go
flow merge_go -> run_split
flow run_split -> race
flow run_split -> drink
flow race -> run_join
flow drink -> run_join
flow run_join -> receive -> done
