<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vein puncture and catheter placement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Hospital" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vein puncture and catheter placement" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doc" name="Doctor">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cleanArea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gelProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coverProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterileGel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>punct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkBlood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloodOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeSyringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeTrocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wireOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>longAxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shortAxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wireClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkPos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirePos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Procedure needed" />
    <bpmn:task id="prep" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="gown" name="Put on the sterile clothes" />
    <bpmn:task id="cleanArea" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="config" name="Configure the ultrasound" />
    <bpmn:task id="gelProbe" name="Put gel in the probe" />
    <bpmn:task id="coverProbe" name="Cover the probe" />
    <bpmn:task id="sterileGel" name="Put the sterile gel" />
    <bpmn:task id="posProbe" name="Position the probe" />
    <bpmn:task id="posPatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="veinOpen" name="Vein identification method?" default="f-veinOpen-compression" />
    <bpmn:task id="anatomic" name="Identify the vein anatomically" />
    <bpmn:task id="doppler" name="Identify the vein using doppler" />
    <bpmn:task id="compression" name="Identify the vein using compression" />
    <bpmn:exclusiveGateway id="veinClose" name="Vein identified" />
    <bpmn:task id="anesth" name="Anesthetize the patient" />
    <bpmn:task id="punct" name="Puncture the patient" />
    <bpmn:task id="checkBlood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="bloodOk" name="Blood return correct?" default="f-bloodOk-punct" />
    <bpmn:task id="dropProbe" name="Drop the probe" />
    <bpmn:task id="removeSyringe" name="Remove the syringe" />
    <bpmn:task id="guidewire" name="Install the guidewire" />
    <bpmn:task id="removeTrocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="wireOpen" name="Wire check method?" default="f-wireOpen-shortAxis" />
    <bpmn:task id="longAxis" name="Check the wire in the long axis" />
    <bpmn:task id="shortAxis" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="wireClose" name="Wire checked" />
    <bpmn:task id="checkPos" name="Check whether the wire is in good position" />
    <bpmn:exclusiveGateway id="wirePos" name="Wire in good position?" default="f-wirePos-punct" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="removeGW" name="Remove the guidewire" />
    <bpmn:task id="verify" name="Verify the flow and the reflow" />
    <bpmn:task id="checkCath" name="Check the catheter position" />
    <bpmn:endEvent id="finish" name="Catheter placed" />
    <bpmn:sequenceFlow id="f-begin-prep" sourceRef="begin" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-wash" sourceRef="prep" targetRef="wash" />
    <bpmn:sequenceFlow id="f-wash-gown" sourceRef="wash" targetRef="gown" />
    <bpmn:sequenceFlow id="f-gown-cleanArea" sourceRef="gown" targetRef="cleanArea" />
    <bpmn:sequenceFlow id="f-cleanArea-drape" sourceRef="cleanArea" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-config" sourceRef="drape" targetRef="config" />
    <bpmn:sequenceFlow id="f-config-gelProbe" sourceRef="config" targetRef="gelProbe" />
    <bpmn:sequenceFlow id="f-gelProbe-coverProbe" sourceRef="gelProbe" targetRef="coverProbe" />
    <bpmn:sequenceFlow id="f-coverProbe-sterileGel" sourceRef="coverProbe" targetRef="sterileGel" />
    <bpmn:sequenceFlow id="f-sterileGel-posProbe" sourceRef="sterileGel" targetRef="posProbe" />
    <bpmn:sequenceFlow id="f-posProbe-posPatient" sourceRef="posProbe" targetRef="posPatient" />
    <bpmn:sequenceFlow id="f-posPatient-veinOpen" sourceRef="posPatient" targetRef="veinOpen" />
    <bpmn:sequenceFlow id="f-veinOpen-anatomic" name="anatomic" sourceRef="veinOpen" targetRef="anatomic">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">veinMethod = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-veinOpen-doppler" name="doppler" sourceRef="veinOpen" targetRef="doppler">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">veinMethod = 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-veinOpen-compression" name="compression" sourceRef="veinOpen" targetRef="compression" />
    <bpmn:sequenceFlow id="f-anatomic-veinClose" sourceRef="anatomic" targetRef="veinClose" />
    <bpmn:sequenceFlow id="f-doppler-veinClose" sourceRef="doppler" targetRef="veinClose" />
    <bpmn:sequenceFlow id="f-compression-veinClose" sourceRef="compression" targetRef="veinClose" />
    <bpmn:sequenceFlow id="f-veinClose-anesth" sourceRef="veinClose" targetRef="anesth" />
    <bpmn:sequenceFlow id="f-anesth-punct" sourceRef="anesth" targetRef="punct" />
    <bpmn:sequenceFlow id="f-punct-checkBlood" sourceRef="punct" targetRef="checkBlood" />
    <bpmn:sequenceFlow id="f-checkBlood-bloodOk" sourceRef="checkBlood" targetRef="bloodOk" />
    <bpmn:sequenceFlow id="f-bloodOk-dropProbe" name="yes" sourceRef="bloodOk" targetRef="dropProbe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bloodReturnCorrect = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-bloodOk-punct" name="no" sourceRef="bloodOk" targetRef="punct" />
    <bpmn:sequenceFlow id="f-dropProbe-removeSyringe" sourceRef="dropProbe" targetRef="removeSyringe" />
    <bpmn:sequenceFlow id="f-removeSyringe-guidewire" sourceRef="removeSyringe" targetRef="guidewire" />
    <bpmn:sequenceFlow id="f-guidewire-removeTrocar" sourceRef="guidewire" targetRef="removeTrocar" />
    <bpmn:sequenceFlow id="f-removeTrocar-wireOpen" sourceRef="removeTrocar" targetRef="wireOpen" />
    <bpmn:sequenceFlow id="f-wireOpen-longAxis" name="long axis" sourceRef="wireOpen" targetRef="longAxis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wireAxis = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wireOpen-shortAxis" name="short axis" sourceRef="wireOpen" targetRef="shortAxis" />
    <bpmn:sequenceFlow id="f-longAxis-wireClose" sourceRef="longAxis" targetRef="wireClose" />
    <bpmn:sequenceFlow id="f-shortAxis-wireClose" sourceRef="shortAxis" targetRef="wireClose" />
    <bpmn:sequenceFlow id="f-wireClose-checkPos" sourceRef="wireClose" targetRef="checkPos" />
    <bpmn:sequenceFlow id="f-checkPos-wirePos" sourceRef="checkPos" targetRef="wirePos" />
    <bpmn:sequenceFlow id="f-wirePos-widen" name="yes" sourceRef="wirePos" targetRef="widen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wireInPosition = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-wirePos-punct" name="no" sourceRef="wirePos" targetRef="punct" />
    <bpmn:sequenceFlow id="f-widen-advance" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f-advance-removeGW" sourceRef="advance" targetRef="removeGW" />
    <bpmn:sequenceFlow id="f-removeGW-verify" sourceRef="removeGW" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-checkCath" sourceRef="verify" targetRef="checkCath" />
    <bpmn:sequenceFlow id="f-checkCath-finish" sourceRef="checkCath" targetRef="finish" />
  </bpmn:process>
</bpmn:definitions>
