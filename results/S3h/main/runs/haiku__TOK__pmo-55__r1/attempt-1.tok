tok 1.0 "Vein puncture and catheter placement"

pool org "Hospital"
  lane doc "Doctor"
    start begin "Procedure needed"
    task prep "Prepare the implements"
    task wash "Wash the hands"
    task gown "Put on the sterile clothes"
    task cleanArea "Clean the puncture area"
    task drape "Drape the puncture zone"
    task config "Configure the ultrasound"
    task gelProbe "Put gel in the probe"
    task coverProbe "Cover the probe"
    task sterileGel "Put the sterile gel"
    task posProbe "Position the probe"
    task posPatient "Position the patient"
    xor veinOpen "Vein identification method?"
    task anatomic "Identify the vein anatomically"
    task doppler "Identify the vein using doppler"
    task compression "Identify the vein using compression"
    xor veinClose "Vein identified"
    task anesth "Anesthetize the patient"
    task punct "Puncture the patient"
    task checkBlood "Check the blood return"
    xor bloodOk "Blood return correct?"
    task dropProbe "Drop the probe"
    task removeSyringe "Remove the syringe"
    task guidewire "Install the guidewire"
    task removeTrocar "Remove the trocar"
    xor wireOpen "Wire check method?"
    task longAxis "Check the wire in the long axis"
    task shortAxis "Check the wire in the short axis"
    xor wireClose "Wire checked"
    task checkPos "Check whether the wire is in good position"
    xor wirePos "Wire in good position?"
    task widen "Widen the pathway"
    task advance "Advance the catheter"
    task removeGW "Remove the guidewire"
    task verify "Verify the flow and the reflow"
    task checkCath "Check the catheter position"
    end finish "Catheter placed"

flow begin -> prep -> wash -> gown -> cleanArea -> drape -> config -> gelProbe -> coverProbe -> sterileGel -> posProbe -> posPatient -> veinOpen
flow veinOpen -> anatomic "anatomic" when="veinMethod = 1"
flow veinOpen -> doppler "doppler" when="veinMethod = 2"
flow veinOpen -> compression "compression" default
flow anatomic -> veinClose
flow doppler -> veinClose
flow compression -> veinClose
flow veinClose -> anesth -> punct -> checkBlood -> bloodOk
flow bloodOk -> dropProbe "yes" when="bloodReturnCorrect = true"
flow bloodOk -> punct "no" default
flow dropProbe -> removeSyringe -> guidewire -> removeTrocar -> wireOpen
flow wireOpen -> longAxis "long axis" when="wireAxis = 1"
flow wireOpen -> shortAxis "short axis" default
flow longAxis -> wireClose
flow shortAxis -> wireClose
flow wireClose -> checkPos -> wirePos
flow wirePos -> widen "yes" when="wireInPosition = true"
flow wirePos -> punct "no" default
flow widen -> advance -> removeGW -> verify -> checkCath -> finish
