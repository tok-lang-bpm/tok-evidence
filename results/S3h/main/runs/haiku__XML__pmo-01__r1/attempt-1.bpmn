<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve-quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmation-received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customer-ends</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales-staff" name="Sales staff or customer support">
        <bpmn:flowNodeRef>collect-information</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address-concerns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not-interested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales-representative" name="Sales representative">
        <bpmn:flowNodeRef>guide-selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-placed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Customer inquires about a product or service" />
    <bpmn:task id="collect-information" name="Collect relevant information" />
    <bpmn:task id="address-concerns" name="Address concerns or questions" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="guide-selection" name="Guide customer through selecting the appropriate product or service" />
    <bpmn:task id="provide-quote" name="Provide quote" />
    <bpmn:task id="approve-quote" name="Customer approves quote" />
    <bpmn:exclusiveGateway id="approved" name="Quote approved?" />
    <bpmn:task id="place-order" name="Place order" />
    <bpmn:task id="record-order" name="Record order in the system" />
    <bpmn:task id="send-confirmation" name="Send order confirmation to customer" />
    <bpmn:task id="confirmation-received" name="Receive order confirmation" />
    <bpmn:endEvent id="order-placed" name="Order successfully placed and confirmed" />
    <bpmn:endEvent id="not-interested" name="Customer not interested" />
    <bpmn:endEvent id="customer-ends" name="Process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="inquiry" targetRef="collect-information" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect-information" targetRef="address-concerns" />
    <bpmn:sequenceFlow id="f3" sourceRef="address-concerns" targetRef="interested" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="interested" targetRef="guide-selection" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="interested" targetRef="not-interested" />
    <bpmn:sequenceFlow id="f6" sourceRef="guide-selection" targetRef="provide-quote" />
    <bpmn:sequenceFlow id="f7" sourceRef="provide-quote" targetRef="approve-quote" />
    <bpmn:sequenceFlow id="f8" sourceRef="approve-quote" targetRef="approved" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="approved" targetRef="place-order" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="approved" targetRef="customer-ends" />
    <bpmn:sequenceFlow id="f11" sourceRef="place-order" targetRef="record-order" />
    <bpmn:sequenceFlow id="f12" sourceRef="record-order" targetRef="send-confirmation" />
    <bpmn:sequenceFlow id="f13" sourceRef="send-confirmation" targetRef="confirmation-received" />
    <bpmn:sequenceFlow id="f14" sourceRef="confirmation-received" targetRef="order-placed" />
  </bpmn:process>
</bpmn:definitions>
