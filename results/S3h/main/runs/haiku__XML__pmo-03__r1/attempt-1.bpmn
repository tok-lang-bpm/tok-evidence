<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="restock-process" />
  </bpmn:collaboration>
  <bpmn:process id="restock-process" isExecutable="false">
    <bpmn:laneSet id="restock-lanes">
      <bpmn:lane id="inventory-system" name="Inventory System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>manual-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place-order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse or Store">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Monitoring begins" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="threshold" name="Stock reached threshold?" />
    <bpmn:task id="alert" name="Send automated alert" />
    <bpmn:task id="manual-check" name="Perform manual check" />
    <bpmn:task id="place-order" name="Place order with suppliers" />
    <bpmn:task id="update-delivery" name="Update inventory system with expected delivery dates" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="record" name="Record stock in system" />
    <bpmn:task id="shelve" name="Place stock on shelves or in storage" />
    <bpmn:task id="update-levels" name="Update inventory levels" />
    <bpmn:endEvent id="end" name="Restock complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="monitor" />
    <bpmn:sequenceFlow id="f2" sourceRef="monitor" targetRef="threshold" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="threshold" targetRef="alert" />
    <bpmn:sequenceFlow id="f4" name="yes, manual" sourceRef="threshold" targetRef="manual-check" />
    <bpmn:sequenceFlow id="f5" sourceRef="alert" targetRef="place-order" />
    <bpmn:sequenceFlow id="f6" sourceRef="manual-check" targetRef="place-order" />
    <bpmn:sequenceFlow id="f7" sourceRef="place-order" targetRef="update-delivery" />
    <bpmn:sequenceFlow id="f8" sourceRef="update-delivery" targetRef="receive" />
    <bpmn:sequenceFlow id="f9" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f10" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f11" sourceRef="record" targetRef="shelve" />
    <bpmn:sequenceFlow id="f12" sourceRef="shelve" targetRef="update-levels" />
    <bpmn:sequenceFlow id="f13" sourceRef="update-levels" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
