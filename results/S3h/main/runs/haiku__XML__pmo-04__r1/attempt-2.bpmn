<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="campaign-process" />
  </bpmn:collaboration>
  <bpmn:process id="campaign-process" isExecutable="false">
    <bpmn:laneSet id="campaign-lanes">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define-objectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design-visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch-campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track-performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>campaign-ended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze-performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales teams">
        <bpmn:flowNodeRef>follow-up-leads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leads-followed-up</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect-leads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Campaign process started" />
    <bpmn:task id="define-objectives" name="Define the objectives of the marketing campaign" />
    <bpmn:parallelGateway id="split-content" name="Split content work" />
    <bpmn:task id="create-content" name="Create the content" />
    <bpmn:task id="design-visuals" name="Design the visuals" />
    <bpmn:task id="select-channels" name="Select the channels for promotion" />
    <bpmn:parallelGateway id="join-content" name="Join content work" />
    <bpmn:task id="launch-campaign" name="Launch the campaign" />
    <bpmn:task id="track-performance" name="Track the performance in real-time" />
    <bpmn:parallelGateway id="split-tracking" name="Track and collect leads" />
    <bpmn:task id="collect-leads" name="Collect the generated leads in the CRM system" />
    <bpmn:task id="follow-up-leads" name="Follow up the leads" />
    <bpmn:endEvent id="leads-followed-up" name="Leads followed up" />
    <bpmn:exclusiveGateway id="campaign-ended" name="Campaign period ended?" />
    <bpmn:task id="analyze-performance" name="Analyze the performance for future optimization" />
    <bpmn:endEvent id="end" name="Campaign process concluded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="define-objectives" />
    <bpmn:sequenceFlow id="f2" sourceRef="define-objectives" targetRef="split-content" />
    <bpmn:sequenceFlow id="f3" sourceRef="split-content" targetRef="create-content" />
    <bpmn:sequenceFlow id="f4" sourceRef="split-content" targetRef="design-visuals" />
    <bpmn:sequenceFlow id="f5" sourceRef="split-content" targetRef="select-channels" />
    <bpmn:sequenceFlow id="f6" sourceRef="create-content" targetRef="join-content" />
    <bpmn:sequenceFlow id="f7" sourceRef="design-visuals" targetRef="join-content" />
    <bpmn:sequenceFlow id="f8" sourceRef="select-channels" targetRef="join-content" />
    <bpmn:sequenceFlow id="f9" sourceRef="join-content" targetRef="launch-campaign" />
    <bpmn:sequenceFlow id="f10" sourceRef="launch-campaign" targetRef="track-performance" />
    <bpmn:sequenceFlow id="f11" sourceRef="track-performance" targetRef="split-tracking" />
    <bpmn:sequenceFlow id="f12" sourceRef="split-tracking" targetRef="collect-leads" />
    <bpmn:sequenceFlow id="f13" sourceRef="split-tracking" targetRef="campaign-ended" />
    <bpmn:sequenceFlow id="f14" sourceRef="collect-leads" targetRef="follow-up-leads" />
    <bpmn:sequenceFlow id="f15" sourceRef="follow-up-leads" targetRef="leads-followed-up" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="campaign-ended" targetRef="analyze-performance" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="campaign-ended" targetRef="track-performance" />
    <bpmn:sequenceFlow id="f18" sourceRef="analyze-performance" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
