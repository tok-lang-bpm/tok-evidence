<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="procurement-process" />
  </bpmn:collaboration>
  <bpmn:process id="procurement-process" isExecutable="false">
    <bpmn:laneSet id="procurement-lanes">
      <bpmn:lane id="procurement-team" name="Procurement team">
        <bpmn:flowNodeRef>need-identified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue-rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-responses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-proposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>need-visits-or-interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-site-visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visits-interviews-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyse-carefully</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terms-agreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signed-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard-supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute-contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-ended</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need-identified" name="Need for new supplier identified" />
    <bpmn:task id="issue-rfp" name="Issue request for proposals (RFP)" />
    <bpmn:task id="receive-responses" name="Receive responses from various suppliers" />
    <bpmn:task id="evaluate-proposals" name="Evaluate each proposal on cost, quality and delivery time" />
    <bpmn:exclusiveGateway id="need-visits-or-interviews" name="Site visits or interviews needed?" />
    <bpmn:task id="conduct-site-visits" name="Conduct site visits with suppliers" />
    <bpmn:task id="conduct-interviews" name="Conduct interviews with suppliers" />
    <bpmn:exclusiveGateway id="visits-interviews-merge" />
    <bpmn:task id="analyse-carefully" name="Analyse proposals carefully" />
    <bpmn:task id="select-supplier" name="Select a supplier" />
    <bpmn:task id="negotiate-contract" name="Begin contract negotiations" />
    <bpmn:exclusiveGateway id="terms-agreed" name="Both parties agree on terms?" />
    <bpmn:task id="sign-contract" name="Sign the contract" />
    <bpmn:parallelGateway id="signed-split" />
    <bpmn:task id="onboard-supplier" name="Onboard the supplier officially" />
    <bpmn:task id="execute-contract" name="Execute the contract" />
    <bpmn:parallelGateway id="onboarding-done" />
    <bpmn:endEvent id="process-ended" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f1" sourceRef="need-identified" targetRef="issue-rfp" />
    <bpmn:sequenceFlow id="f2" sourceRef="issue-rfp" targetRef="receive-responses" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive-responses" targetRef="evaluate-proposals" />
    <bpmn:sequenceFlow id="f4" sourceRef="evaluate-proposals" targetRef="need-visits-or-interviews" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="need-visits-or-interviews" targetRef="conduct-site-visits" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="need-visits-or-interviews" targetRef="conduct-interviews" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="need-visits-or-interviews" targetRef="visits-interviews-merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="conduct-site-visits" targetRef="visits-interviews-merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="conduct-interviews" targetRef="visits-interviews-merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="visits-interviews-merge" targetRef="analyse-carefully" />
    <bpmn:sequenceFlow id="f11" sourceRef="analyse-carefully" targetRef="select-supplier" />
    <bpmn:sequenceFlow id="f12" sourceRef="select-supplier" targetRef="negotiate-contract" />
    <bpmn:sequenceFlow id="f13" sourceRef="negotiate-contract" targetRef="terms-agreed" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="terms-agreed" targetRef="sign-contract" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="terms-agreed" targetRef="negotiate-contract" />
    <bpmn:sequenceFlow id="f16" sourceRef="sign-contract" targetRef="signed-split" />
    <bpmn:sequenceFlow id="f17" sourceRef="signed-split" targetRef="onboard-supplier" />
    <bpmn:sequenceFlow id="f18" sourceRef="signed-split" targetRef="execute-contract" />
    <bpmn:sequenceFlow id="f19" sourceRef="onboard-supplier" targetRef="onboarding-done" />
    <bpmn:sequenceFlow id="f20" sourceRef="execute-contract" targetRef="onboarding-done" />
    <bpmn:sequenceFlow id="f21" sourceRef="onboarding-done" targetRef="process-ended" />
  </bpmn:process>
</bpmn:definitions>
