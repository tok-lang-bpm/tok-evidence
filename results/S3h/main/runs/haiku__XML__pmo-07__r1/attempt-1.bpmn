<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Travel company" processRef="ticketing-process" />
  </bpmn:collaboration>
  <bpmn:process id="ticketing-process" isExecutable="false">
    <bpmn:laneSet id="ticketing-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeJourney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>postTravel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>postMerged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="booking" name="Booking system">
        <bpmn:flowNodeRef>generateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channelMerged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminderDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeReminders</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Travel company">
        <bpmn:flowNodeRef>updateInventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Customer begins booking" />
    <bpmn:task id="search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="selectRoute" name="Select the preferred route, date, and time" />
    <bpmn:task id="provideInfo" name="Provide personal information and payment details" />
    <bpmn:task id="generateTicket" name="Generate a ticket" />
    <bpmn:parallelGateway id="parallelSplit" name="Ticket sent and inventory updated" />
    <bpmn:exclusiveGateway id="channel" name="Ticket delivery channel?" />
    <bpmn:task id="sendEmail" name="Send the ticket via email" />
    <bpmn:task id="sendSms" name="Send the ticket via SMS" />
    <bpmn:exclusiveGateway id="channelMerged" />
    <bpmn:task id="updateInventory" name="Update seat inventory" />
    <bpmn:parallelGateway id="parallelJoin" name="Ticket sent and inventory updated" />
    <bpmn:exclusiveGateway id="reminderDecision" name="Reminders due?" />
    <bpmn:task id="sendReminders" name="Send reminders and instructions for check-in or boarding" />
    <bpmn:exclusiveGateway id="mergeReminders" />
    <bpmn:task id="completeJourney" name="Complete the journey" />
    <bpmn:exclusiveGateway id="postTravel" name="Post-travel feedback or services?" />
    <bpmn:task id="provideFeedback" name="Provide post-travel feedback or services" />
    <bpmn:exclusiveGateway id="postMerged" />
    <bpmn:endEvent id="endEvent" name="Process concluded" />
    <bpmn:sequenceFlow id="s1" sourceRef="started" targetRef="search" />
    <bpmn:sequenceFlow id="s2" sourceRef="search" targetRef="selectRoute" />
    <bpmn:sequenceFlow id="s3" sourceRef="selectRoute" targetRef="provideInfo" />
    <bpmn:sequenceFlow id="s4" sourceRef="provideInfo" targetRef="generateTicket" />
    <bpmn:sequenceFlow id="s5" sourceRef="generateTicket" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="s6" sourceRef="parallelSplit" targetRef="channel" />
    <bpmn:sequenceFlow id="s7" name="email" sourceRef="channel" targetRef="sendEmail" />
    <bpmn:sequenceFlow id="s8" name="SMS" sourceRef="channel" targetRef="sendSms" />
    <bpmn:sequenceFlow id="s9" sourceRef="sendEmail" targetRef="channelMerged" />
    <bpmn:sequenceFlow id="s10" sourceRef="sendSms" targetRef="channelMerged" />
    <bpmn:sequenceFlow id="s11" sourceRef="channelMerged" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="s12" sourceRef="parallelSplit" targetRef="updateInventory" />
    <bpmn:sequenceFlow id="s13" sourceRef="updateInventory" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="s14" sourceRef="parallelJoin" targetRef="reminderDecision" />
    <bpmn:sequenceFlow id="s15" name="yes" sourceRef="reminderDecision" targetRef="sendReminders" />
    <bpmn:sequenceFlow id="s16" name="no" sourceRef="reminderDecision" targetRef="mergeReminders" />
    <bpmn:sequenceFlow id="s17" sourceRef="sendReminders" targetRef="mergeReminders" />
    <bpmn:sequenceFlow id="s18" sourceRef="mergeReminders" targetRef="completeJourney" />
    <bpmn:sequenceFlow id="s19" sourceRef="completeJourney" targetRef="postTravel" />
    <bpmn:sequenceFlow id="s20" name="yes" sourceRef="postTravel" targetRef="provideFeedback" />
    <bpmn:sequenceFlow id="s21" name="no" sourceRef="postTravel" targetRef="postMerged" />
    <bpmn:sequenceFlow id="s22" sourceRef="provideFeedback" targetRef="postMerged" />
    <bpmn:sequenceFlow id="s23" sourceRef="postMerged" targetRef="endEvent" />
  </bpmn:process>
</bpmn:definitions>
