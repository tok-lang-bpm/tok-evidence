<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Subscription Service Organisation" processRef="subscription-process" />
  </bpmn:collaboration>
  <bpmn:process id="subscription-process" isExecutable="false">
    <bpmn:laneSet id="subscription-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>triggerBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitSetup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinSetup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitorSubscription</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Team">
        <bpmn:flowNodeRef>processCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refundOrCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyRefundsCharges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivateSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSubscription</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer starts sign-up" />
    <bpmn:task id="signup" name="Sign up for the subscription service and enter personal and payment information" />
    <bpmn:task id="generateAccount" name="Generate the account" />
    <bpmn:task id="assignAccess" name="Assign access" />
    <bpmn:task id="triggerBilling" name="Trigger automated billing cycles" />
    <bpmn:parallelGateway id="splitSetup" />
    <bpmn:task id="sendUpdates" name="Send regular updates, product enhancements or renewal notifications" />
    <bpmn:task id="receiveUpdates" name="Receive regular updates, product enhancements or renewal notifications" />
    <bpmn:parallelGateway id="joinSetup" />
    <bpmn:task id="monitorSubscription" name="Monitor the subscription" />
    <bpmn:exclusiveGateway id="cancelDecision" name="Customer decides to cancel?" />
    <bpmn:task id="submitCancellation" name="Submit a cancellation request" />
    <bpmn:task id="processCancellation" name="Process the cancellation request" />
    <bpmn:task id="applyTerms" name="Apply the terms" />
    <bpmn:exclusiveGateway id="refundOrCharge" name="Refund or charge due?" />
    <bpmn:task id="applyRefundsCharges" name="Apply refunds or charges" />
    <bpmn:task id="deactivateSubscription" name="Deactivate the subscription" />
    <bpmn:task id="settleBalance" name="Settle the final account balance" />
    <bpmn:endEvent id="endNoCancel" name="Subscription not cancelled" />
    <bpmn:endEvent id="endSubscription" name="Subscription concluded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="signup" />
    <bpmn:sequenceFlow id="f2" sourceRef="signup" targetRef="generateAccount" />
    <bpmn:sequenceFlow id="f3" sourceRef="generateAccount" targetRef="assignAccess" />
    <bpmn:sequenceFlow id="f4" sourceRef="assignAccess" targetRef="triggerBilling" />
    <bpmn:sequenceFlow id="f5" sourceRef="triggerBilling" targetRef="splitSetup" />
    <bpmn:sequenceFlow id="f6" sourceRef="splitSetup" targetRef="sendUpdates" />
    <bpmn:sequenceFlow id="f7" sourceRef="splitSetup" targetRef="receiveUpdates" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendUpdates" targetRef="joinSetup" />
    <bpmn:sequenceFlow id="f9" sourceRef="receiveUpdates" targetRef="joinSetup" />
    <bpmn:sequenceFlow id="f10" sourceRef="joinSetup" targetRef="monitorSubscription" />
    <bpmn:sequenceFlow id="f11" sourceRef="monitorSubscription" targetRef="cancelDecision" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="cancelDecision" targetRef="submitCancellation" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="cancelDecision" targetRef="endNoCancel" />
    <bpmn:sequenceFlow id="f14" sourceRef="submitCancellation" targetRef="processCancellation" />
    <bpmn:sequenceFlow id="f15" sourceRef="processCancellation" targetRef="applyTerms" />
    <bpmn:sequenceFlow id="f16" sourceRef="applyTerms" targetRef="refundOrCharge" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="refundOrCharge" targetRef="applyRefundsCharges" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="refundOrCharge" targetRef="deactivateSubscription" />
    <bpmn:sequenceFlow id="f19" sourceRef="applyRefundsCharges" targetRef="deactivateSubscription" />
    <bpmn:sequenceFlow id="f20" sourceRef="deactivateSubscription" targetRef="settleBalance" />
    <bpmn:sequenceFlow id="f21" sourceRef="settleBalance" targetRef="endSubscription" />
  </bpmn:process>
</bpmn:definitions>
