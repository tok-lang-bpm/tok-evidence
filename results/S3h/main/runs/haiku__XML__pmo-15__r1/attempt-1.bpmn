<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="audit-process" />
  </bpmn:collaboration>
  <bpmn:process id="audit-process" isExecutable="false">
    <bpmn:laneSet id="audit-lanes">
      <bpmn:lane id="management" name="Company management">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concluded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notCertified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal teams">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfAssess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalAudit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Compliance audit starts" />
    <bpmn:task id="schedule" name="Schedule a compliance audit" />
    <bpmn:task id="prepare" name="Prepare the documentation and gather evidence" />
    <bpmn:task id="selfAssess" name="Conduct a self-assessment" />
    <bpmn:task id="review" name="Review the company's processes" />
    <bpmn:exclusiveGateway id="gaps" name="Gaps or issues found?" />
    <bpmn:task id="corrections" name="Make the necessary corrections or improvements" />
    <bpmn:task id="finalAudit" name="Undergo the final audit" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" />
    <bpmn:task id="certified" name="Award the certification" />
    <bpmn:task id="issue" name="Issue the official documents" />
    <bpmn:endEvent id="concluded" name="Audit process concluded" />
    <bpmn:endEvent id="notCertified" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="schedule" />
    <bpmn:sequenceFlow id="f2" sourceRef="schedule" targetRef="prepare" />
    <bpmn:sequenceFlow id="f3" sourceRef="prepare" targetRef="selfAssess" />
    <bpmn:sequenceFlow id="f4" sourceRef="selfAssess" targetRef="review" />
    <bpmn:sequenceFlow id="f5" sourceRef="review" targetRef="gaps" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="gaps" targetRef="corrections" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="gaps" targetRef="finalAudit" />
    <bpmn:sequenceFlow id="f8" sourceRef="corrections" targetRef="finalAudit" />
    <bpmn:sequenceFlow id="f9" sourceRef="finalAudit" targetRef="criteria" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="criteria" targetRef="certified" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="criteria" targetRef="notCertified" />
    <bpmn:sequenceFlow id="f12" sourceRef="certified" targetRef="issue" />
    <bpmn:sequenceFlow id="f13" sourceRef="issue" targetRef="concluded" />
  </bpmn:process>
</bpmn:definitions>
