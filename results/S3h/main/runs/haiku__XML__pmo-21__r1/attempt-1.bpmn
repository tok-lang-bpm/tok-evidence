<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="shipping-process" />
  </bpmn:collaboration>
  <bpmn:process id="shipping-process" isExecutable="false">
    <bpmn:laneSet id="shipping-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarifyShipper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amountGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inviteCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normalPost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareForPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endShipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics Department Head">
        <bpmn:flowNodeRef>insuranceNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>takeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>packageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Goods ready to ship" />

    <bpmn:exclusiveGateway id="shipGoods" name="Goods shall be shipped?" />
    <bpmn:task id="clarifyShipper" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="amountGateway" name="Large amounts?" />
    <bpmn:task id="inviteCompanies" name="Invite three logistic companies to make offers" />
    <bpmn:task id="selectCompany" name="Select one of the logistic companies" />
    <bpmn:task id="normalPost" name="Use normal post shipment" />
    <bpmn:exclusiveGateway id="joinShipping" name="Shipping method determined" />

    <bpmn:parallelGateway id="splitPreparation" name="Split preparation" />
    <bpmn:task id="writeLabel" name="Write a package label" />
    <bpmn:exclusiveGateway id="insuranceNeeded" name="Parcel insurance necessary?" />
    <bpmn:task id="takeInsurance" name="Take a parcel insurance" />
    <bpmn:task id="packageGoods" name="Package the goods" />
    <bpmn:parallelGateway id="joinPreparation" name="Preparation complete" />

    <bpmn:task id="prepareForPickup" name="Prepare the packaged goods for pickup by the logistic company" />
    <bpmn:endEvent id="endNoShipping" name="No shipping required" />
    <bpmn:endEvent id="endShipped" name="Goods prepared for pickup" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="shipGoods" />
    <bpmn:sequenceFlow id="f2" name="no" sourceRef="shipGoods" targetRef="endNoShipping" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="shipGoods" targetRef="clarifyShipper" />
    <bpmn:sequenceFlow id="f4" sourceRef="clarifyShipper" targetRef="amountGateway" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="amountGateway" targetRef="inviteCompanies" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="amountGateway" targetRef="normalPost" />
    <bpmn:sequenceFlow id="f7" sourceRef="inviteCompanies" targetRef="selectCompany" />
    <bpmn:sequenceFlow id="f8" sourceRef="selectCompany" targetRef="joinShipping" />
    <bpmn:sequenceFlow id="f9" sourceRef="normalPost" targetRef="joinShipping" />
    <bpmn:sequenceFlow id="f10" sourceRef="joinShipping" targetRef="splitPreparation" />
    <bpmn:sequenceFlow id="f11" sourceRef="splitPreparation" targetRef="writeLabel" />
    <bpmn:sequenceFlow id="f12" sourceRef="splitPreparation" targetRef="packageGoods" />
    <bpmn:sequenceFlow id="f13" sourceRef="writeLabel" targetRef="insuranceNeeded" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="insuranceNeeded" targetRef="takeInsurance" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="insuranceNeeded" targetRef="joinPreparation" />
    <bpmn:sequenceFlow id="f16" sourceRef="takeInsurance" targetRef="joinPreparation" />
    <bpmn:sequenceFlow id="f17" sourceRef="packageGoods" targetRef="joinPreparation" />
    <bpmn:sequenceFlow id="f18" sourceRef="joinPreparation" targetRef="prepareForPickup" />
    <bpmn:sequenceFlow id="f19" sourceRef="prepareForPickup" targetRef="endShipped" />
  </bpmn:process>
</bpmn:definitions>
