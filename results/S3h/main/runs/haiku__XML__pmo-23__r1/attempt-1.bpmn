<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>start-credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-scoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-later</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="banking" name="Banking system">
        <bpmn:flowNodeRef>start-scoring-process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-scoring-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-delay-notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display-delay-message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-scoring-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present-result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Scoring agency">
        <bpmn:flowNodeRef>perform-level-1-scoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return-immediate-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork-delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform-level-2-scoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return-level-2-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start-credit" name="Credit scoring needed" />
    <bpmn:task id="request-scoring" name="Request credit scoring for customer" />
    <bpmn:task id="start-scoring-process" name="Start scoring process" />
    <bpmn:task id="send-scoring-request" name="Send scoring request to agency" />
    <bpmn:task id="perform-level-1-scoring" name="Perform level 1 scoring" />
    <bpmn:exclusiveGateway id="immediate-result" name="Immediate result?" />
    <bpmn:task id="return-immediate-result" name="Return result directly to banking system" />
    <bpmn:task id="inform-delay" name="Inform banking process of delay" />
    <bpmn:parallelGateway id="fork-delay" />
    <bpmn:task id="receive-delay-notice" name="Receive delay notice" />
    <bpmn:task id="display-delay-message" name="Display delay message to clerk" />
    <bpmn:task id="check-later" name="Check result again later" />
    <bpmn:task id="perform-level-2-scoring" name="Perform level 2 scoring" />
    <bpmn:task id="return-level-2-result" name="Return level 2 scoring result to banking system" />
    <bpmn:parallelGateway id="join-delay" />
    <bpmn:exclusiveGateway id="merge-result" />
    <bpmn:task id="receive-scoring-result" name="Receive scoring result" />
    <bpmn:task id="present-result" name="Present result to clerk" />
    <bpmn:task id="view-result" name="View result at frontend" />
    <bpmn:endEvent id="end-result" name="Scoring result presented" />
    <bpmn:sequenceFlow id="f1" sourceRef="start-credit" targetRef="request-scoring" />
    <bpmn:sequenceFlow id="f2" sourceRef="request-scoring" targetRef="start-scoring-process" />
    <bpmn:sequenceFlow id="f3" sourceRef="start-scoring-process" targetRef="send-scoring-request" />
    <bpmn:sequenceFlow id="f4" sourceRef="send-scoring-request" targetRef="perform-level-1-scoring" />
    <bpmn:sequenceFlow id="f5" sourceRef="perform-level-1-scoring" targetRef="immediate-result" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="immediate-result" targetRef="return-immediate-result" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="immediate-result" targetRef="inform-delay" />
    <bpmn:sequenceFlow id="f8" sourceRef="return-immediate-result" targetRef="merge-result" />
    <bpmn:sequenceFlow id="f9" sourceRef="inform-delay" targetRef="fork-delay" />
    <bpmn:sequenceFlow id="f10" sourceRef="fork-delay" targetRef="receive-delay-notice" />
    <bpmn:sequenceFlow id="f11" sourceRef="fork-delay" targetRef="perform-level-2-scoring" />
    <bpmn:sequenceFlow id="f12" sourceRef="receive-delay-notice" targetRef="display-delay-message" />
    <bpmn:sequenceFlow id="f13" sourceRef="display-delay-message" targetRef="check-later" />
    <bpmn:sequenceFlow id="f14" sourceRef="check-later" targetRef="join-delay" />
    <bpmn:sequenceFlow id="f15" sourceRef="perform-level-2-scoring" targetRef="return-level-2-result" />
    <bpmn:sequenceFlow id="f16" sourceRef="return-level-2-result" targetRef="join-delay" />
    <bpmn:sequenceFlow id="f17" sourceRef="join-delay" targetRef="merge-result" />
    <bpmn:sequenceFlow id="f18" sourceRef="merge-result" targetRef="receive-scoring-result" />
    <bpmn:sequenceFlow id="f19" sourceRef="receive-scoring-result" targetRef="present-result" />
    <bpmn:sequenceFlow id="f20" sourceRef="present-result" targetRef="view-result" />
    <bpmn:sequenceFlow id="f21" sourceRef="view-result" targetRef="end-result" />
  </bpmn:process>
</bpmn:definitions>
