<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msgBuzzerRings" name="Buzzer rings" />
  <bpmn:message id="msgMealReady" name="Meal is in the service hatch" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterRestaurant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buzzerRings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reactGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appearHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enterPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setupBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>awareReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setOffBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitFiveMin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calledGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handOver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEmployee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Guest feels hungry" />
    <bpmn:task id="enterRestaurant" name="Enter the restaurant" />
    <bpmn:task id="chooseDish" name="Choose a dish from the changing meal range" />
    <bpmn:task id="waitTurn" name="Wait until it is his turn" />
    <bpmn:task id="placeOrder" name="Place the order with the employee" />
    <bpmn:task id="enterPOS" name="Enter the order into the POS system" />
    <bpmn:task id="collectMoney" name="Collect the money from the guest" />
    <bpmn:task id="setupBuzzer" name="Set up the buzzer" />
    <bpmn:task id="passBuzzer" name="Pass the buzzer on to the guest">
      <bpmn:documentation>When the buzzer rings, your dinner is ready</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="informChef" name="Inform the chef of the new meal order" />
    <bpmn:task id="prepareMeal" name="Prepare the meal" />
    <bpmn:task id="placeHatch" name="Place the meal in the service hatch" />
    <bpmn:task id="informEmployee" name="Inform the employee that the finished meal is in the service hatch" />
    <bpmn:intermediateCatchEvent id="awareReady" name="Employee is aware that the meal is ready">
      <bpmn:messageEventDefinition id="awareReadyDef" messageRef="msgMealReady" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="setOffBuzzer" name="Set off the guest's buzzer" />
    <bpmn:intermediateCatchEvent id="buzzerRings" name="Buzzer rings">
      <bpmn:messageEventDefinition id="buzzerRingsDef" messageRef="msgBuzzerRings" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="reactGw" name="Guest reacts to the buzzer?" />
    <bpmn:task id="appearHatch" name="Appear at the service hatch" />
    <bpmn:intermediateCatchEvent id="waitFiveMin" name="Wait 5 minutes">
      <bpmn:timerEventDefinition id="waitFiveMinDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callGuest" name="Call for the guest" />
    <bpmn:exclusiveGateway id="calledGw" name="Guest appears at the service hatch?" />
    <bpmn:exclusiveGateway id="mergeGw" name="Guest at service hatch" />
    <bpmn:task id="handOver" name="Hand over the meal" />
    <bpmn:task id="pickUp" name="Pick up the meal" />
    <bpmn:task id="eat" name="Eat the meal" />
    <bpmn:endEvent id="endEat" name="Meal eaten" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enterRestaurant" />
    <bpmn:sequenceFlow id="f2" sourceRef="enterRestaurant" targetRef="chooseDish" />
    <bpmn:sequenceFlow id="f3" sourceRef="chooseDish" targetRef="waitTurn" />
    <bpmn:sequenceFlow id="f4" sourceRef="waitTurn" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="f5" sourceRef="placeOrder" targetRef="enterPOS" />
    <bpmn:sequenceFlow id="f6" sourceRef="enterPOS" targetRef="collectMoney" />
    <bpmn:sequenceFlow id="f7" sourceRef="collectMoney" targetRef="setupBuzzer" />
    <bpmn:sequenceFlow id="f8" sourceRef="setupBuzzer" targetRef="passBuzzer" />
    <bpmn:sequenceFlow id="f9" sourceRef="passBuzzer" targetRef="informChef" />
    <bpmn:sequenceFlow id="f10" sourceRef="informChef" targetRef="prepareMeal" />
    <bpmn:sequenceFlow id="f11" sourceRef="prepareMeal" targetRef="placeHatch" />
    <bpmn:sequenceFlow id="f12" sourceRef="placeHatch" targetRef="informEmployee" />
    <bpmn:sequenceFlow id="f13" sourceRef="informEmployee" targetRef="awareReady" />
    <bpmn:sequenceFlow id="f14" sourceRef="awareReady" targetRef="setOffBuzzer" />
    <bpmn:sequenceFlow id="f15" sourceRef="setOffBuzzer" targetRef="buzzerRings" />
    <bpmn:sequenceFlow id="f16" sourceRef="buzzerRings" targetRef="reactGw" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="reactGw" targetRef="appearHatch" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="reactGw" targetRef="waitFiveMin" />
    <bpmn:sequenceFlow id="f19" sourceRef="waitFiveMin" targetRef="callGuest" />
    <bpmn:sequenceFlow id="f20" sourceRef="callGuest" targetRef="calledGw" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="calledGw" targetRef="mergeGw" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="calledGw" targetRef="waitFiveMin" />
    <bpmn:sequenceFlow id="f23" sourceRef="appearHatch" targetRef="mergeGw" />
    <bpmn:sequenceFlow id="f24" sourceRef="mergeGw" targetRef="handOver" />
    <bpmn:sequenceFlow id="f25" sourceRef="handOver" targetRef="pickUp" />
    <bpmn:sequenceFlow id="f26" sourceRef="pickUp" targetRef="eat" />
    <bpmn:sequenceFlow id="f27" sourceRef="eat" targetRef="endEat" />
  </bpmn:process>
</bpmn:definitions>
