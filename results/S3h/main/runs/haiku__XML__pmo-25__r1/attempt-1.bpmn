<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Job Search" processRef="find-job-process" />
  </bpmn:collaboration>
  <bpmn:process id="find-job-process" isExecutable="false">
    <bpmn:laneSet id="find-job-lanes">
      <bpmn:lane id="applicant" name="Job applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rate_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_after</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rate_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide_hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rate_applicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide_perm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_perm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_perm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="platform" name="Job platform">
        <bpmn:flowNodeRef>t_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_year</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_show_reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_continue_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_continue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Job search started" />
    <bpmn:task id="t_write" name="Write job application" />
    <bpmn:parallelGateway id="split_app" />
    <bpmn:task id="t_confirm" name="Confirm receipt of job application" />
    <bpmn:task id="t_rate_app" name="Rate job application" />
    <bpmn:task id="t_offers" name="Send new potential job offers" />
    <bpmn:parallelGateway id="join_app" />
    <bpmn:task id="t_report" name="Report companies with job applications" />
    <bpmn:task id="t_interview" name="Negotiate job interview" />
    <bpmn:task id="t_decide_hire" name="Decide to hire applicant" />
    <bpmn:exclusiveGateway id="gw_hire" name="Company wants applicant to work for them?" />
    <bpmn:endEvent id="end_no_offer" name="Job search ended without offer" />
    <bpmn:task id="t_probation" name="Enter probation phase" />
    <bpmn:parallelGateway id="split_rate" />
    <bpmn:task id="t_rate_company" name="Rate company" />
    <bpmn:task id="t_rate_applicant" name="Rate applicant" />
    <bpmn:parallelGateway id="join_rate" />
    <bpmn:parallelGateway id="split_after" />
    <bpmn:intermediateCatchEvent id="timer_year" name="One year later">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_show_reviews" name="Show company reviews to job applicants" />
    <bpmn:endEvent id="end_reviews" name="Reviews visible to applicants" />
    <bpmn:task id="t_decide_perm" name="Decide job becomes permanent" />
    <bpmn:exclusiveGateway id="gw_perm" name="Job becomes permanent?" />
    <bpmn:endEvent id="end_not_perm" name="Job search ended without permanent job" />
    <bpmn:exclusiveGateway id="gw_rating" name="Applicant rated company C or less?" />
    <bpmn:task id="t_continue_offers" name="Continue receiving job offers without reporting" />
    <bpmn:endEvent id="end_continue" name="Job offers continue without reporting" />
    <bpmn:endEvent id="end_done" name="Job search ended" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_write" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_write" targetRef="split_app" />
    <bpmn:sequenceFlow id="f3" sourceRef="split_app" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f4" sourceRef="split_app" targetRef="t_offers" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_confirm" targetRef="t_rate_app" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_rate_app" targetRef="join_app" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_offers" targetRef="join_app" />
    <bpmn:sequenceFlow id="f8" sourceRef="join_app" targetRef="t_report" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_report" targetRef="t_interview" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_interview" targetRef="t_decide_hire" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_decide_hire" targetRef="gw_hire" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gw_hire" targetRef="end_no_offer" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="gw_hire" targetRef="t_probation" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_probation" targetRef="split_rate" />
    <bpmn:sequenceFlow id="f15" sourceRef="split_rate" targetRef="t_rate_company" />
    <bpmn:sequenceFlow id="f16" sourceRef="split_rate" targetRef="t_rate_applicant" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_rate_company" targetRef="join_rate" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_rate_applicant" targetRef="join_rate" />
    <bpmn:sequenceFlow id="f19" sourceRef="join_rate" targetRef="split_after" />
    <bpmn:sequenceFlow id="f20" sourceRef="split_after" targetRef="timer_year" />
    <bpmn:sequenceFlow id="f21" sourceRef="split_after" targetRef="t_decide_perm" />
    <bpmn:sequenceFlow id="f22" sourceRef="timer_year" targetRef="t_show_reviews" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_show_reviews" targetRef="end_reviews" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_decide_perm" targetRef="gw_perm" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="gw_perm" targetRef="end_not_perm" />
    <bpmn:sequenceFlow id="f26" name="yes" sourceRef="gw_perm" targetRef="gw_rating" />
    <bpmn:sequenceFlow id="f27" name="C or less" sourceRef="gw_rating" targetRef="t_continue_offers" />
    <bpmn:sequenceFlow id="f28" name="better than C" sourceRef="gw_rating" targetRef="end_done" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_continue_offers" targetRef="end_continue" />
  </bpmn:process>
</bpmn:definitions>
