<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="work-accident-process" />
  </bpmn:collaboration>
  <bpmn:process id="work-accident-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="work-accident-lanes">
      <bpmn:lane id="insured" name="Insured person, self-employed person or student">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_dir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_selfreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_privreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_privfatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_priv3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>T_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_norec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_fatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_emerg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_provider5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="school" name="School or university">
        <bpmn:flowNodeRef>G_school</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_school</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="provider" name="Accident insurance provider">
        <bpmn:flowNodeRef>T_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Accident, near miss, risk or defect occurs" />
    <bpmn:task id="T_inform" name="Inform the employer immediately" />
    <bpmn:task id="T_record" name="Record the accident, near miss, risk or defect" />
    <bpmn:exclusiveGateway id="G_work" name="Work accident?" />
    <bpmn:endEvent id="E_norec" name="Near miss or risk recorded" />
    <bpmn:exclusiveGateway id="G_fatal" name="Fatality or serious injury?" />
    <bpmn:exclusiveGateway id="G_emerg" name="Reported to the emergency services?" />
    <bpmn:task id="T_labour" name="Report the work accident immediately to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="J1" />
    <bpmn:exclusiveGateway id="G_days" name="Killed or unable to work for three days?" />
    <bpmn:task id="T_provider5" name="Report the work accident to the accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="J2" />
    <bpmn:exclusiveGateway id="G_school" name="School or university accident?" />
    <bpmn:task id="T_school" name="Report the work accident to the accident insurance provider within five days in triplicate" />
    <bpmn:exclusiveGateway id="J3" />
    <bpmn:exclusiveGateway id="G_student" name="Student or schoolchild?" />
    <bpmn:task id="T_dir" name="Report the accident to the competent directorate" />
    <bpmn:exclusiveGateway id="J4" />
    <bpmn:exclusiveGateway id="G_self" name="Self-employed?" />
    <bpmn:task id="T_selfreport" name="Report the accident in good time to the accident insurance provider" />
    <bpmn:exclusiveGateway id="J5" />
    <bpmn:exclusiveGateway id="G_private" name="Privately insured?" />
    <bpmn:task id="T_privreport" name="Report the accident in writing immediately to the private insurer" />
    <bpmn:exclusiveGateway id="G_privfatal" name="Fatality?" />
    <bpmn:task id="T_priv3" name="Report the fatality within three days" />
    <bpmn:exclusiveGateway id="J6" />
    <bpmn:task id="T_gather" name="Gather the accident information" />
    <bpmn:endEvent id="E_done" name="Accident information gathered" />
    <bpmn:sequenceFlow id="f1" sourceRef="S1" targetRef="T_inform" />
    <bpmn:sequenceFlow id="f2" sourceRef="T_inform" targetRef="T_record" />
    <bpmn:sequenceFlow id="f3" sourceRef="T_record" targetRef="G_work" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="G_work" targetRef="E_norec" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="G_work" targetRef="G_fatal" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="G_fatal" targetRef="G_emerg" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="G_fatal" targetRef="J1" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="G_emerg" targetRef="J1" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="G_emerg" targetRef="T_labour" />
    <bpmn:sequenceFlow id="f10" sourceRef="T_labour" targetRef="J1" />
    <bpmn:sequenceFlow id="f11" sourceRef="J1" targetRef="G_days" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="G_days" targetRef="T_provider5" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="G_days" targetRef="J2" />
    <bpmn:sequenceFlow id="f14" sourceRef="T_provider5" targetRef="J2" />
    <bpmn:sequenceFlow id="f15" sourceRef="J2" targetRef="G_school" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="G_school" targetRef="T_school" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="G_school" targetRef="J3" />
    <bpmn:sequenceFlow id="f18" sourceRef="T_school" targetRef="J3" />
    <bpmn:sequenceFlow id="f19" sourceRef="J3" targetRef="G_student" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="G_student" targetRef="T_dir" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="G_student" targetRef="J4" />
    <bpmn:sequenceFlow id="f22" sourceRef="T_dir" targetRef="J4" />
    <bpmn:sequenceFlow id="f23" sourceRef="J4" targetRef="G_self" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="G_self" targetRef="T_selfreport" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="G_self" targetRef="J5" />
    <bpmn:sequenceFlow id="f26" sourceRef="T_selfreport" targetRef="J5" />
    <bpmn:sequenceFlow id="f27" sourceRef="J5" targetRef="G_private" />
    <bpmn:sequenceFlow id="f28" name="yes" sourceRef="G_private" targetRef="T_privreport" />
    <bpmn:sequenceFlow id="f29" name="no" sourceRef="G_private" targetRef="J6" />
    <bpmn:sequenceFlow id="f30" sourceRef="T_privreport" targetRef="G_privfatal" />
    <bpmn:sequenceFlow id="f31" name="yes" sourceRef="G_privfatal" targetRef="T_priv3" />
    <bpmn:sequenceFlow id="f32" name="no" sourceRef="G_privfatal" targetRef="J6" />
    <bpmn:sequenceFlow id="f33" sourceRef="T_priv3" targetRef="J6" />
    <bpmn:sequenceFlow id="f34" sourceRef="J6" targetRef="T_gather" />
    <bpmn:sequenceFlow id="f35" sourceRef="T_gather" targetRef="E_done" />
  </bpmn:process>
</bpmn:definitions>
