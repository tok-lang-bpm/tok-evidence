<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msgProfile" name="Candidate profile" />
  <bpmn:message id="msgOffer" name="Internship offer" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Internship" processRef="internship-process" />
    <bpmn:messageFlow id="m1" name="Profile" sourceRef="enterExperience" targetRef="companyStart" />
    <bpmn:messageFlow id="m2" name="Offer" sourceRef="sendOffer" targetRef="waitOffer" />
  </bpmn:collaboration>
  <bpmn:process id="internship-process" isExecutable="false">
    <bpmn:laneSet id="internship-lanes">
      <bpmn:lane id="intern" name="Intern">
        <bpmn:flowNodeRef>startIntern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterExperience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decideOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denyOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>weekPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enoughUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>companyStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeCompanyUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>companyWeek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enoughCompany</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startIntern" name="Internship search started" />
    <bpmn:task id="enterTopic" name="Enter topic of interest and desired salary" />
    <bpmn:task id="enterExperience" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="mergeWait" />
    <bpmn:intermediateCatchEvent id="waitOffer" name="Offer arrives">
      <bpmn:messageEventDefinition messageRef="msgOffer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="reviewOffer" name="Review offer" />
    <bpmn:exclusiveGateway id="decideOffer" name="Offer accepted?" />
    <bpmn:task id="acceptOffer" name="Accept offer" />
    <bpmn:task id="denyOffer" name="Deny offer" />
    <bpmn:task id="invalidate" name="Invalidate all other offers" />
    <bpmn:parallelGateway id="splitWork" name="Internship starts" />
    <bpmn:task id="writeUpdate" name="Write status update about internship" />
    <bpmn:intermediateCatchEvent id="weekPassed" name="One week passes">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="enoughUpdates" name="At least 3 updates written?" />
    <bpmn:parallelGateway id="joinWork" name="All updates written" />
    <bpmn:intermediateCatchEvent id="finished" name="Internship finished" />
    <bpmn:task id="selectFriends" name="Select friends from list" />
    <bpmn:task id="tweet" name="Send recommendation tweet to friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="endRec" name="Company recommended" />
    <bpmn:startEvent id="companyStart" name="Candidate profile received">
      <bpmn:messageEventDefinition messageRef="msgProfile" />
    </bpmn:startEvent>
    <bpmn:task id="sendOffer" name="Send offer" />
    <bpmn:endEvent id="endOffer" name="Offer sent" />
    <bpmn:task id="writeCompanyUpdate" name="Write status update about intern" />
    <bpmn:intermediateCatchEvent id="companyWeek" name="One week passes">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="enoughCompany" name="At least 3 updates written?" />
    <bpmn:sequenceFlow id="f1" sourceRef="startIntern" targetRef="enterTopic" />
    <bpmn:sequenceFlow id="f2" sourceRef="enterTopic" targetRef="enterExperience" />
    <bpmn:sequenceFlow id="f3" sourceRef="enterExperience" targetRef="mergeWait" />
    <bpmn:sequenceFlow id="f4" sourceRef="mergeWait" targetRef="waitOffer" />
    <bpmn:sequenceFlow id="f5" sourceRef="waitOffer" targetRef="reviewOffer" />
    <bpmn:sequenceFlow id="f6" sourceRef="reviewOffer" targetRef="decideOffer" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="decideOffer" targetRef="acceptOffer" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="decideOffer" targetRef="denyOffer" />
    <bpmn:sequenceFlow id="f9" sourceRef="denyOffer" targetRef="mergeWait" />
    <bpmn:sequenceFlow id="f10" sourceRef="acceptOffer" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f11" sourceRef="invalidate" targetRef="splitWork" />
    <bpmn:sequenceFlow id="f12" sourceRef="splitWork" targetRef="writeUpdate" />
    <bpmn:sequenceFlow id="f13" sourceRef="splitWork" targetRef="writeCompanyUpdate" />
    <bpmn:sequenceFlow id="f14" sourceRef="writeUpdate" targetRef="enoughUpdates" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="enoughUpdates" targetRef="weekPassed" />
    <bpmn:sequenceFlow id="f16" sourceRef="weekPassed" targetRef="writeUpdate" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="enoughUpdates" targetRef="joinWork" />
    <bpmn:sequenceFlow id="f18" sourceRef="writeCompanyUpdate" targetRef="enoughCompany" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="enoughCompany" targetRef="companyWeek" />
    <bpmn:sequenceFlow id="f20" sourceRef="companyWeek" targetRef="writeCompanyUpdate" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="enoughCompany" targetRef="joinWork" />
    <bpmn:sequenceFlow id="f22" sourceRef="joinWork" targetRef="finished" />
    <bpmn:sequenceFlow id="f23" sourceRef="finished" targetRef="selectFriends" />
    <bpmn:sequenceFlow id="f24" sourceRef="selectFriends" targetRef="tweet" />
    <bpmn:sequenceFlow id="f25" sourceRef="tweet" targetRef="endRec" />
    <bpmn:sequenceFlow id="f26" sourceRef="companyStart" targetRef="sendOffer" />
    <bpmn:sequenceFlow id="f27" sourceRef="sendOffer" targetRef="endOffer" />
  </bpmn:process>
</bpmn:definitions>
