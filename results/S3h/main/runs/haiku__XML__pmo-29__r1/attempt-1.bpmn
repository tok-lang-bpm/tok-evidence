<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_austria" name="Work and Live in Austria" processRef="austria_process" />
  </bpmn:collaboration>
  <bpmn:process id="austria_process" isExecutable="false">
    <bpmn:laneSet id="austria_lanes">
      <bpmn:lane id="lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>start_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_prep_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_complete_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_obtain_travel_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_take_passport_photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_obtain_health_insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prove_means_of_subsistence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_prep_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_provide_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_post_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_negotiate_accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_negotiate_bank_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_post_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_renewal_period</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_stay_continues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_renew_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_stay_ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_landlord" name="Landlord">
        <bpmn:flowNodeRef>t_agree_rental_terms</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_bank" name="Bank">
        <bpmn:flowNodeRef>t_open_bank_account</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_representation" name="Austrian Representation Office (BMEIA)">
        <bpmn:flowNodeRef>gw_visa_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_determine_type_d_office</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_determine_schengen_office</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_competent_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_grounds_for_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_additional_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_request_additional_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide_visa_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_issue_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refuse_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_application_refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_needed" name="Wish to work and live in Austria" />
    <bpmn:task id="t_check_requirements" name="Check requirements for working and living in Austria" />
    <bpmn:parallelGateway id="gw_prep_split" />
    <bpmn:task id="t_complete_form" name="Complete visa application form" />
    <bpmn:task id="t_obtain_travel_document" name="Obtain travel document valid in Austria" />
    <bpmn:task id="t_take_passport_photo" name="Take passport photo" />
    <bpmn:task id="t_obtain_health_insurance" name="Obtain travel health insurance policy" />
    <bpmn:task id="t_prove_means_of_subsistence" name="Prove sufficient means of subsistence" />
    <bpmn:parallelGateway id="gw_prep_join" />
    <bpmn:task id="t_submit_application" name="Submit visa application" />
    <bpmn:exclusiveGateway id="gw_visa_type" name="Visa type?" />
    <bpmn:task id="t_determine_type_d_office" name="Determine competent Austrian representation by place of residence" />
    <bpmn:task id="t_determine_schengen_office" name="Determine competent representation by main travel destination or legal residence" />
    <bpmn:exclusiveGateway id="gw_competent_merge" />
    <bpmn:task id="t_check_grounds_for_refusal" name="Check absence of other grounds for refusal" />
    <bpmn:exclusiveGateway id="gw_additional_documents" name="Additional documents requested?" />
    <bpmn:task id="t_request_additional_documents" name="Request additional documents" />
    <bpmn:task id="t_provide_evidence" name="Provide other evidence requested by the authorities" />
    <bpmn:task id="t_decide_visa_application" name="Decide on visa application" />
    <bpmn:exclusiveGateway id="gw_decision" name="Application approved?" />
    <bpmn:task id="t_issue_visa" name="Issue visa (Rot-Weiss-Rot Card)" />
    <bpmn:task id="t_refuse_visa" name="Refuse visa application" />
    <bpmn:endEvent id="end_application_refused" name="Application refused" />
    <bpmn:parallelGateway id="gw_post_split" />
    <bpmn:task id="t_negotiate_accommodation" name="Negotiate accommodation" />
    <bpmn:task id="t_agree_rental_terms" name="Agree rental terms" />
    <bpmn:task id="t_negotiate_bank_account" name="Negotiate bank account" />
    <bpmn:task id="t_open_bank_account" name="Open bank account" />
    <bpmn:parallelGateway id="gw_post_join" />
    <bpmn:intermediateCatchEvent id="ev_renewal_period" name="Renewal period reached (every x months)" />
    <bpmn:exclusiveGateway id="gw_stay_continues" name="Stay continues?" />
    <bpmn:task id="t_renew_visa" name="Renew visa" />
    <bpmn:endEvent id="end_stay_ended" name="Stay ended" />

    <bpmn:sequenceFlow id="f01" sourceRef="start_needed" targetRef="t_check_requirements" />
    <bpmn:sequenceFlow id="f02" sourceRef="t_check_requirements" targetRef="gw_prep_split" />
    <bpmn:sequenceFlow id="f03" sourceRef="gw_prep_split" targetRef="t_complete_form" />
    <bpmn:sequenceFlow id="f04" sourceRef="gw_prep_split" targetRef="t_obtain_travel_document" />
    <bpmn:sequenceFlow id="f05" sourceRef="gw_prep_split" targetRef="t_take_passport_photo" />
    <bpmn:sequenceFlow id="f06" sourceRef="gw_prep_split" targetRef="t_obtain_health_insurance" />
    <bpmn:sequenceFlow id="f07" sourceRef="gw_prep_split" targetRef="t_prove_means_of_subsistence" />
    <bpmn:sequenceFlow id="f08" sourceRef="t_complete_form" targetRef="gw_prep_join" />
    <bpmn:sequenceFlow id="f09" sourceRef="t_obtain_travel_document" targetRef="gw_prep_join" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_take_passport_photo" targetRef="gw_prep_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_obtain_health_insurance" targetRef="gw_prep_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_prove_means_of_subsistence" targetRef="gw_prep_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_prep_join" targetRef="t_submit_application" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_submit_application" targetRef="gw_visa_type" />
    <bpmn:sequenceFlow id="f15" name="Type D" sourceRef="gw_visa_type" targetRef="t_determine_type_d_office" />
    <bpmn:sequenceFlow id="f16" name="Schengen, category A or C" sourceRef="gw_visa_type" targetRef="t_determine_schengen_office" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_determine_type_d_office" targetRef="gw_competent_merge" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_determine_schengen_office" targetRef="gw_competent_merge" />
    <bpmn:sequenceFlow id="f19" sourceRef="gw_competent_merge" targetRef="t_check_grounds_for_refusal" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_check_grounds_for_refusal" targetRef="gw_additional_documents" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="gw_additional_documents" targetRef="t_request_additional_documents" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="gw_additional_documents" targetRef="t_decide_visa_application" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_request_additional_documents" targetRef="t_provide_evidence" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_provide_evidence" targetRef="t_check_grounds_for_refusal" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_decide_visa_application" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="f26" name="yes" sourceRef="gw_decision" targetRef="t_issue_visa" />
    <bpmn:sequenceFlow id="f27" name="no" sourceRef="gw_decision" targetRef="t_refuse_visa" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_refuse_visa" targetRef="end_application_refused" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_issue_visa" targetRef="gw_post_split" />
    <bpmn:sequenceFlow id="f30" sourceRef="gw_post_split" targetRef="t_negotiate_accommodation" />
    <bpmn:sequenceFlow id="f31" sourceRef="gw_post_split" targetRef="t_negotiate_bank_account" />
    <bpmn:sequenceFlow id="f32" sourceRef="t_negotiate_accommodation" targetRef="t_agree_rental_terms" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_agree_rental_terms" targetRef="gw_post_join" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_negotiate_bank_account" targetRef="t_open_bank_account" />
    <bpmn:sequenceFlow id="f35" sourceRef="t_open_bank_account" targetRef="gw_post_join" />
    <bpmn:sequenceFlow id="f36" sourceRef="gw_post_join" targetRef="ev_renewal_period" />
    <bpmn:sequenceFlow id="f37" sourceRef="ev_renewal_period" targetRef="gw_stay_continues" />
    <bpmn:sequenceFlow id="f38" name="yes" sourceRef="gw_stay_continues" targetRef="t_renew_visa" />
    <bpmn:sequenceFlow id="f39" name="no" sourceRef="gw_stay_continues" targetRef="end_stay_ended" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_renew_visa" targetRef="t_check_requirements" />
  </bpmn:process>
</bpmn:definitions>
