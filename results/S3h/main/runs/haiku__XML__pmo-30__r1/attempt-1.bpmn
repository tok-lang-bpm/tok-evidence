<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organiser" name="LAN party organiser" processRef="lan-party-process" />
  </bpmn:collaboration>
  <bpmn:process id="lan-party-process" isExecutable="false">
    <bpmn:laneSet id="lan-party-lanes">
      <bpmn:lane id="organiser-lane" name="Organiser">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mg_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_date_again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mg_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_beer_need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mg_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="LAN party planning starts" />
    <bpmn:task id="t_invite" name="Send invitations to the 10 friends" />
    <bpmn:task id="t_games" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="pg_split" name="Split" />
    <bpmn:exclusiveGateway id="mg_date" name="Date merge" />
    <bpmn:task id="t_date" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="g_date" name="8 or more people agree on this date?" />
    <bpmn:task id="t_date_again" name="Appoint another date for the LAN party" />
    <bpmn:task id="t_check_games" name="Find out if you have all the games your guests want to play" />
    <bpmn:exclusiveGateway id="g_games" name="All games available?" />
    <bpmn:task id="t_download" name="Download the missing games" />
    <bpmn:exclusiveGateway id="mg_games" name="Games merge" />
    <bpmn:parallelGateway id="pg_join" name="Join" />
    <bpmn:task id="t_beer_need" name="Find out how much beer your friends will require" />
    <bpmn:exclusiveGateway id="g_beer" name="Enough beer?" />
    <bpmn:task id="t_buy" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="mg_beer" name="Beer merge" />
    <bpmn:task id="t_enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="end" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_invite" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_invite" targetRef="t_games" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_games" targetRef="pg_split" />
    <bpmn:sequenceFlow id="f4" sourceRef="pg_split" targetRef="mg_date" />
    <bpmn:sequenceFlow id="f5" sourceRef="pg_split" targetRef="t_check_games" />
    <bpmn:sequenceFlow id="f6" sourceRef="mg_date" targetRef="t_date" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_date" targetRef="g_date" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="g_date" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="g_date" targetRef="t_date_again" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_date_again" targetRef="mg_date" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_check_games" targetRef="g_games" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="g_games" targetRef="mg_games" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="g_games" targetRef="t_download" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_download" targetRef="mg_games" />
    <bpmn:sequenceFlow id="f15" sourceRef="mg_games" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f16" sourceRef="pg_join" targetRef="t_beer_need" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_beer_need" targetRef="g_beer" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="g_beer" targetRef="mg_beer" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="g_beer" targetRef="t_buy" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_buy" targetRef="mg_beer" />
    <bpmn:sequenceFlow id="f21" sourceRef="mg_beer" targetRef="t_enjoy" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_enjoy" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
