<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="character-process" />
  </bpmn:collaboration>
  <bpmn:process id="character-process" isExecutable="false">
    <bpmn:laneSet id="character-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enterAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clickLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAccMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_selPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPayMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwLoginMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_realm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNameMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enterName</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Blizzard system">
        <bpmn:flowNodeRef>gwAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_checkSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_checkName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ie_expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_expMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Begin character creation" />
    <bpmn:parallelGateway id="fork1" name="Start both activities" />
    <bpmn:task id="t_names" name="Come up with character names" />
    <bpmn:exclusiveGateway id="gwAcc" name="Battle.net account exists?" />
    <bpmn:task id="t_enterAcc" name="Enter the account information" />
    <bpmn:task id="t_sendMail" name="Send confirmation mail" />
    <bpmn:task id="t_clickLink" name="Click the link in the confirmation mail" />
    <bpmn:exclusiveGateway id="gwAccMerge" name="Battle.net account ready" />
    <bpmn:task id="t_checkSub" name="Check the active WoW subscription" />
    <bpmn:exclusiveGateway id="gwSub" name="Active WoW subscription?" />
    <bpmn:task id="t_selPay" name="Select the payment method" />
    <bpmn:exclusiveGateway id="gwPay" name="Payment method?" />
    <bpmn:task id="t_card" name="Enter the credit card information" />
    <bpmn:task id="t_iban" name="Enter the IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="gwPayMerge" name="Payment method entered" />
    <bpmn:exclusiveGateway id="gwLoginMerge" name="Subscription active" />
    <bpmn:task id="t_login" name="Log into the game" />
    <bpmn:task id="t_realm" name="Select realm, race and class" />
    <bpmn:parallelGateway id="join1" name="Account set up and names come up with" />
    <bpmn:exclusiveGateway id="gwNameMerge" name="Name to enter" />
    <bpmn:task id="t_enterName" name="Enter a character name" />
    <bpmn:task id="t_checkName" name="Check whether the name is still available" />
    <bpmn:exclusiveGateway id="gwName" name="Name still available?" />
    <bpmn:task id="t_confirm" name="Send confirmation and selfies of the character" />
    <bpmn:intermediateCatchEvent id="ie_expansion" name="Expansion released">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_expMsg" name="Send the expansion message" />
    <bpmn:endEvent id="end1" name="Character created" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fork1" />
    <bpmn:sequenceFlow id="f2" sourceRef="fork1" targetRef="t_names" />
    <bpmn:sequenceFlow id="f3" sourceRef="fork1" targetRef="gwAcc" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gwAcc" targetRef="gwAccMerge" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gwAcc" targetRef="t_enterAcc" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_enterAcc" targetRef="t_sendMail" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_sendMail" targetRef="t_clickLink" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_clickLink" targetRef="gwAccMerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="gwAccMerge" targetRef="t_checkSub" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_checkSub" targetRef="gwSub" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gwSub" targetRef="gwLoginMerge" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gwSub" targetRef="t_selPay" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_selPay" targetRef="gwPay" />
    <bpmn:sequenceFlow id="f14" name="credit card" sourceRef="gwPay" targetRef="t_card" />
    <bpmn:sequenceFlow id="f15" name="bank account" sourceRef="gwPay" targetRef="t_iban" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_card" targetRef="gwPayMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_iban" targetRef="gwPayMerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="gwPayMerge" targetRef="gwLoginMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="gwLoginMerge" targetRef="t_login" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_login" targetRef="t_realm" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_realm" targetRef="join1" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_names" targetRef="join1" />
    <bpmn:sequenceFlow id="f23" sourceRef="join1" targetRef="gwNameMerge" />
    <bpmn:sequenceFlow id="f24" sourceRef="gwNameMerge" targetRef="t_enterName" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_enterName" targetRef="t_checkName" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_checkName" targetRef="gwName" />
    <bpmn:sequenceFlow id="f27" name="yes" sourceRef="gwName" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f28" name="no" sourceRef="gwName" targetRef="gwNameMerge" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_confirm" targetRef="ie_expansion" />
    <bpmn:sequenceFlow id="f30" sourceRef="ie_expansion" targetRef="t_expMsg" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_expMsg" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
