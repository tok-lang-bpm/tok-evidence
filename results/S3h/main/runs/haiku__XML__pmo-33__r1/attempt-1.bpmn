<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="maker" name="Maker" processRef="maker-process" />
  </bpmn:collaboration>
  <bpmn:process id="maker-process" isExecutable="false">
    <bpmn:laneSet id="maker-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x_merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_grams</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_shopping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x_merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_printer_on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sendstl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Craving a custom 3D model" />
    <bpmn:task id="t_instruct" name="Instruct an artist to create a project" />
    <bpmn:task id="t_sketches" name="Send several sketches to the artist" />
    <bpmn:task id="t_create" name="Create the project" />
    <bpmn:exclusiveGateway id="x_merge1" />
    <bpmn:task id="t_review" name="Review the project" />
    <bpmn:exclusiveGateway id="g_satisfied" name="Satisfied with the result?" />
    <bpmn:task id="t_tell" name="Tell the artist what to change" />
    <bpmn:task id="t_change" name="Change the project" />
    <bpmn:task id="t_sendstl" name="Send the STL file to the customer" />
    <bpmn:task id="t_choose" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="g_stock" name="Color in stock?" />
    <bpmn:task id="t_check_left" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="g_grams" name="Under 100 grams?" />
    <bpmn:task id="t_shopping" name="Put the color on the shopping list" />
    <bpmn:task id="t_order" name="Order the color" />
    <bpmn:exclusiveGateway id="x_merge2" />
    <bpmn:parallelGateway id="p_split" />
    <bpmn:task id="t_printer_on" name="Turn the printer on" />
    <bpmn:task id="t_heat" name="Heat up the bed and the extruder" />
    <bpmn:task id="t_monitor" name="Monitor the printer status" />
    <bpmn:task id="t_gcode" name="Generate the gcode file for the printer from the STL" />
    <bpmn:parallelGateway id="p_join" />
    <bpmn:task id="t_print" name="Print the model" />
    <bpmn:endEvent id="end" name="Model printed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_instruct" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_instruct" targetRef="t_sketches" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_sketches" targetRef="t_create" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_create" targetRef="x_merge1" />
    <bpmn:sequenceFlow id="f5" sourceRef="x_merge1" targetRef="t_review" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_review" targetRef="g_satisfied" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="g_satisfied" targetRef="t_sendstl" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="g_satisfied" targetRef="t_tell" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_tell" targetRef="t_change" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_change" targetRef="x_merge1" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_sendstl" targetRef="t_choose" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_choose" targetRef="g_stock" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="g_stock" targetRef="t_check_left" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="g_stock" targetRef="t_order" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_check_left" targetRef="g_grams" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="g_grams" targetRef="t_shopping" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="g_grams" targetRef="x_merge2" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_shopping" targetRef="x_merge2" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_order" targetRef="x_merge2" />
    <bpmn:sequenceFlow id="f20" sourceRef="x_merge2" targetRef="p_split" />
    <bpmn:sequenceFlow id="f21" sourceRef="p_split" targetRef="t_printer_on" />
    <bpmn:sequenceFlow id="f22" sourceRef="p_split" targetRef="t_gcode" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_printer_on" targetRef="t_heat" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_heat" targetRef="t_monitor" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_monitor" targetRef="p_join" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_gcode" targetRef="p_join" />
    <bpmn:sequenceFlow id="f27" sourceRef="p_join" targetRef="t_print" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_print" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
