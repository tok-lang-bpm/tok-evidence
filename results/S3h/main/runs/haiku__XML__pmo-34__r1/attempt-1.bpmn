<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="lego-process" />
  </bpmn:collaboration>
  <bpmn:process id="lego-process" isExecutable="false">
    <bpmn:laneSet id="lego-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>container-empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Group of children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Machine project started" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give the Lego sets to the children" />
    <bpmn:task id="sort" name="Sort the parts into containers" />
    <bpmn:parallelGateway id="split" name="Split into subcomponents" />
    <bpmn:task id="build" name="Build each subcomponent using parts from containers" />
    <bpmn:exclusiveGateway id="container-empty" name="Container empty?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="test" name="Test each subcomponent individually" />
    <bpmn:exclusiveGateway id="test-ok" name="Test successful?" />
    <bpmn:parallelGateway id="assemble-join" name="All subcomponents tested" />
    <bpmn:task id="assemble" name="Assemble the subcomponents" />
    <bpmn:task id="redesign" name="Redesign and rebuild the subcomponents" />
    <bpmn:endEvent id="end" name="Machine built" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="design" />
    <bpmn:sequenceFlow id="f2" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f3" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f4" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f5" sourceRef="sort" targetRef="split" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="build" />
    <bpmn:sequenceFlow id="f7" sourceRef="build" targetRef="container-empty" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="container-empty" targetRef="reorder" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="container-empty" targetRef="test" />
    <bpmn:sequenceFlow id="f10" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f11" sourceRef="test" targetRef="test-ok" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="test-ok" targetRef="assemble-join" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="test-ok" targetRef="redesign" />
    <bpmn:sequenceFlow id="f14" sourceRef="redesign" targetRef="build" />
    <bpmn:sequenceFlow id="f15" sourceRef="assemble-join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f16" sourceRef="assemble" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
