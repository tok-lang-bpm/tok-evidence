<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="contract-process" />
  </bpmn:collaboration>
  <bpmn:process id="contract-process" isExecutable="false">
    <bpmn:laneSet id="contract-lanes">
      <bpmn:lane id="project" name="Project">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_several</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_cheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>below5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder_cheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>below3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder_fastest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>zero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_mail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Contract project starts" />
    <bpmn:task id="query" name="Query the web shops" />
    <bpmn:task id="find" name="Find out delivery quantity, price and lead time" />
    <bpmn:task id="list" name="Create a list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="enough" name="Has one shop enough parts?" />
    <bpmn:task id="order_several" name="Order parts from several shops" />
    <bpmn:task id="order_one" name="Order parts from one shop" />
    <bpmn:task id="order_cheapest" name="Order the cheapest parts" />
    <bpmn:exclusiveGateway id="arrive_gateway" name="Parts arrived?" />
    <bpmn:task id="receive" name="Receive the parts batch" />
    <bpmn:exclusiveGateway id="first_arrived" name="First parts arrived?" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:task id="stock_check" name="Check the stock of a single part" />
    <bpmn:exclusiveGateway id="below5" name="Stock below 5?" />
    <bpmn:task id="reorder_cheapest" name="Reorder the cheapest part" />
    <bpmn:exclusiveGateway id="below3" name="Stock below 3?" />
    <bpmn:task id="reorder_fastest" name="Reorder the fastest part" />
    <bpmn:exclusiveGateway id="zero" name="Stock zero?" />
    <bpmn:task id="write_mail" name="Write a mail to friends complaining about the web shops" />
    <bpmn:endEvent id="end_done" name="Building finished" />
    <bpmn:endEvent id="end_mail" name="Complaint sent" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="query" />
    <bpmn:sequenceFlow id="f2" sourceRef="query" targetRef="find" />
    <bpmn:sequenceFlow id="f3" sourceRef="find" targetRef="list" />
    <bpmn:sequenceFlow id="f4" sourceRef="list" targetRef="enough" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="enough" targetRef="order_one" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="enough" targetRef="order_several" />
    <bpmn:sequenceFlow id="f7" sourceRef="order_one" targetRef="order_cheapest" />
    <bpmn:sequenceFlow id="f8" sourceRef="order_several" targetRef="order_cheapest" />
    <bpmn:sequenceFlow id="f9" sourceRef="order_cheapest" targetRef="arrive_gateway" />
    <bpmn:sequenceFlow id="f10" sourceRef="arrive_gateway" targetRef="receive" />
    <bpmn:sequenceFlow id="f11" sourceRef="receive" targetRef="first_arrived" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="first_arrived" targetRef="build" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="first_arrived" targetRef="arrive_gateway" />
    <bpmn:sequenceFlow id="f14" sourceRef="build" targetRef="stock_check" />
    <bpmn:sequenceFlow id="f15" sourceRef="stock_check" targetRef="below5" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="below5" targetRef="reorder_cheapest" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="below5" targetRef="end_done" />
    <bpmn:sequenceFlow id="f18" sourceRef="reorder_cheapest" targetRef="below3" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="below3" targetRef="reorder_fastest" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="below3" targetRef="stock_check" />
    <bpmn:sequenceFlow id="f21" sourceRef="reorder_fastest" targetRef="zero" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="zero" targetRef="write_mail" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="zero" targetRef="stock_check" />
    <bpmn:sequenceFlow id="f24" sourceRef="write_mail" targetRef="end_mail" />
  </bpmn:process>
</bpmn:definitions>
