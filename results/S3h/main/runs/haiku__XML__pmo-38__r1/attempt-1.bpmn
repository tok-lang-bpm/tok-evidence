<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Tree House Project" processRef="tree-house-process" />
  </bpmn:collaboration>
  <bpmn:process id="tree-house-process" isExecutable="false">
    <bpmn:laneSet id="tree-house-lanes">
      <bpmn:lane id="owner" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendAddReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msgFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDraft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online stores">
        <bpmn:flowNodeRef>store1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>buildHouse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Tree house wanted" />
    <bpmn:task id="collect" name="Collect the requirements" />
    <bpmn:task id="sendReq" name="Send the requirements to the architect" />
    <bpmn:task id="draft" name="Draft the plan" />
    <bpmn:task id="sendDraft" name="Send the draft to you" />
    <bpmn:task id="review" name="Review the draft" />
    <bpmn:exclusiveGateway id="finalGw" name="Draft final?" />
    <bpmn:task id="addReq" name="Add additional requirements" />
    <bpmn:task id="sendAddReq" name="Send the additional requirements to the architect" />
    <bpmn:task id="revise" name="Revise the plan" />
    <bpmn:task id="createList" name="Create the list of needed materials from the plan" />
    <bpmn:task id="orderMat" name="Order the materials from several online stores" />
    <bpmn:parallelGateway id="forkGw" name="Split" />
    <bpmn:task id="store1" name="Process the materials order" />
    <bpmn:task id="store2" name="Process the materials order" />
    <bpmn:task id="store3" name="Process the materials order" />
    <bpmn:task id="msgFriends" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="joinGw" name="Join" />
    <bpmn:task id="buildHouse" name="Build the house" />
    <bpmn:task id="invite" name="Send invitations for the tree house party" />
    <bpmn:task id="attendees" name="Create the list of attendees" />
    <bpmn:task id="snacks" name="Buy the snacks for the party" />
    <bpmn:endEvent id="end" name="Party prepared" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="sendReq" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendReq" targetRef="draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="draft" targetRef="sendDraft" />
    <bpmn:sequenceFlow id="f5" sourceRef="sendDraft" targetRef="review" />
    <bpmn:sequenceFlow id="f6" sourceRef="review" targetRef="finalGw" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="finalGw" targetRef="createList" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="finalGw" targetRef="addReq" />
    <bpmn:sequenceFlow id="f9" sourceRef="addReq" targetRef="sendAddReq" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendAddReq" targetRef="revise" />
    <bpmn:sequenceFlow id="f11" sourceRef="revise" targetRef="sendDraft" />
    <bpmn:sequenceFlow id="f12" sourceRef="createList" targetRef="orderMat" />
    <bpmn:sequenceFlow id="f13" sourceRef="orderMat" targetRef="forkGw" />
    <bpmn:sequenceFlow id="f14" sourceRef="forkGw" targetRef="store1" />
    <bpmn:sequenceFlow id="f15" sourceRef="forkGw" targetRef="store2" />
    <bpmn:sequenceFlow id="f16" sourceRef="forkGw" targetRef="store3" />
    <bpmn:sequenceFlow id="f17" sourceRef="forkGw" targetRef="msgFriends" />
    <bpmn:sequenceFlow id="f18" sourceRef="store1" targetRef="joinGw" />
    <bpmn:sequenceFlow id="f19" sourceRef="store2" targetRef="joinGw" />
    <bpmn:sequenceFlow id="f20" sourceRef="store3" targetRef="joinGw" />
    <bpmn:sequenceFlow id="f21" sourceRef="msgFriends" targetRef="joinGw" />
    <bpmn:sequenceFlow id="f22" sourceRef="joinGw" targetRef="buildHouse" />
    <bpmn:sequenceFlow id="f23" sourceRef="buildHouse" targetRef="invite" />
    <bpmn:sequenceFlow id="f24" sourceRef="invite" targetRef="attendees" />
    <bpmn:sequenceFlow id="f25" sourceRef="attendees" targetRef="snacks" />
    <bpmn:sequenceFlow id="f26" sourceRef="snacks" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
