<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Online Repair Tool" processRef="repair-process" />
  </bpmn:collaboration>
  <bpmn:process id="repair-process" isExecutable="false">
    <bpmn:laneSet id="repair-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-damage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-owned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide-borrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact-friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>borrow-or-buy-cheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-instructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix-phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-to-expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>respond-friends</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="expert" name="Expert">
        <bpmn:flowNodeRef>repair-by-expert</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Repair needed" />
    <bpmn:task id="enter-model" name="Enter the model" />
    <bpmn:task id="enter-damage" name="Enter what is broken" />
    <bpmn:task id="review-lists" name="Review the list of materials and tools" />
    <bpmn:task id="identify-owned" name="Identify the items already owned" />
    <bpmn:exclusiveGateway id="decide-borrow" name="Borrow or buy from friends?" />
    <bpmn:task id="contact-friends" name="Contact friends" />
    <bpmn:task id="respond-friends" name="Respond with the offer to lend or sell cheaply" />
    <bpmn:task id="borrow-or-buy-cheap" name="Borrow or buy the item cheaply from friends" />
    <bpmn:task id="buy-rest" name="Buy the remaining items" />
    <bpmn:parallelGateway id="join-materials" />
    <bpmn:task id="receive-instructions" name="Receive the repair instructions" />
    <bpmn:task id="fix-phone" name="Fix the phone" />
    <bpmn:exclusiveGateway id="check-result" name="Repair successful?" />
    <bpmn:task id="send-review" name="Send a review and/or video of the repair" />
    <bpmn:task id="send-to-expert" name="Send the phone to an expert" />
    <bpmn:task id="repair-by-expert" name="Repair the phone" />
    <bpmn:endEvent id="end-success" name="Phone repaired" />
    <bpmn:endEvent id="end-expert" name="Phone repaired by expert" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter-model" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter-model" targetRef="enter-damage" />
    <bpmn:sequenceFlow id="f3" sourceRef="enter-damage" targetRef="review-lists" />
    <bpmn:sequenceFlow id="f4" sourceRef="review-lists" targetRef="identify-owned" />
    <bpmn:sequenceFlow id="f5" sourceRef="identify-owned" targetRef="decide-borrow" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="decide-borrow" targetRef="contact-friends" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="decide-borrow" targetRef="buy-rest" />
    <bpmn:sequenceFlow id="f8" sourceRef="contact-friends" targetRef="respond-friends" />
    <bpmn:sequenceFlow id="f9" sourceRef="respond-friends" targetRef="borrow-or-buy-cheap" />
    <bpmn:sequenceFlow id="f10" sourceRef="borrow-or-buy-cheap" targetRef="buy-rest" />
    <bpmn:sequenceFlow id="f11" sourceRef="buy-rest" targetRef="join-materials" />
    <bpmn:sequenceFlow id="f12" sourceRef="join-materials" targetRef="receive-instructions" />
    <bpmn:sequenceFlow id="f13" sourceRef="receive-instructions" targetRef="fix-phone" />
    <bpmn:sequenceFlow id="f14" sourceRef="fix-phone" targetRef="check-result" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="check-result" targetRef="send-review" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="check-result" targetRef="send-to-expert" />
    <bpmn:sequenceFlow id="f17" sourceRef="send-review" targetRef="end-success" />
    <bpmn:sequenceFlow id="f18" sourceRef="send-to-expert" targetRef="repair-by-expert" />
    <bpmn:sequenceFlow id="f19" sourceRef="repair-by-expert" targetRef="end-expert" />
  </bpmn:process>
</bpmn:definitions>
