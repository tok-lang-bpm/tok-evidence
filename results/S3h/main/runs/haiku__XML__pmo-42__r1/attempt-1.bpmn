<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Fridge Service Organisation" processRef="fridge-service-process" />
  </bpmn:collaboration>
  <bpmn:process id="fridge-service-process" isExecutable="false">
    <bpmn:laneSet id="fridge-service-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>symptom-occurs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe-symptoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate-facility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>service-complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service-center" name="Central Fridge Service Center">
        <bpmn:flowNodeRef>select-facility</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service-facility" name="Local Service Facility">
        <bpmn:flowNodeRef>make-appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts-needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair-fridge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repaired</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="symptom-occurs" name="Fridge produces strange noises" />
    <bpmn:task id="describe-symptoms" name="Describe the symptoms and the type of fridge" />
    <bpmn:task id="select-facility" name="Select a local service facility" />
    <bpmn:task id="make-appointment" name="Make an appointment" />
    <bpmn:task id="visit-customer" name="Arrive at a random time" />
    <bpmn:exclusiveGateway id="parts-needed" name="Additional parts needed?" />
    <bpmn:task id="order-parts" name="Leave and order the additional parts" />
    <bpmn:task id="repair-fridge" name="Repair the fridge" />
    <bpmn:exclusiveGateway id="repaired" name="Fridge repaired?" />
    <bpmn:task id="confirm-repair" name="Confirm that the fridge is OK again" />
    <bpmn:exclusiveGateway id="confirmed" name="Repair confirmed?" />
    <bpmn:task id="rate-facility" name="Rate the service facility" />
    <bpmn:endEvent id="service-complete" name="Service completed" />
    <bpmn:endEvent id="service-cancelled" name="Service not completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="symptom-occurs" targetRef="describe-symptoms" />
    <bpmn:sequenceFlow id="f2" sourceRef="describe-symptoms" targetRef="select-facility" />
    <bpmn:sequenceFlow id="f3" sourceRef="select-facility" targetRef="make-appointment" />
    <bpmn:sequenceFlow id="f4" sourceRef="make-appointment" targetRef="visit-customer" />
    <bpmn:sequenceFlow id="f5" sourceRef="visit-customer" targetRef="parts-needed" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="parts-needed" targetRef="order-parts" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="parts-needed" targetRef="repair-fridge" />
    <bpmn:sequenceFlow id="f8" sourceRef="order-parts" targetRef="make-appointment" />
    <bpmn:sequenceFlow id="f9" sourceRef="repair-fridge" targetRef="repaired" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="repaired" targetRef="confirm-repair" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="repaired" targetRef="visit-customer" />
    <bpmn:sequenceFlow id="f12" sourceRef="confirm-repair" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="confirmed" targetRef="rate-facility" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="confirmed" targetRef="repair-fridge" />
    <bpmn:sequenceFlow id="f15" sourceRef="rate-facility" targetRef="service-complete" />
    <bpmn:sequenceFlow id="f16" sourceRef="service-cancelled" targetRef="service-cancelled" />
  </bpmn:process>
</bpmn:definitions>
