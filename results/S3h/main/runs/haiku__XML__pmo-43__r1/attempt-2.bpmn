<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="police" name="Police" processRef="car-service-process" />
  </bpmn:collaboration>
  <bpmn:process id="car-service-process" isExecutable="false">
    <bpmn:laneSet id="car-service-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify-owner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-30-days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine-owner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-status-updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-not-registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-fined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-next-service-set</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="owner" name="Car Owner">
        <bpmn:flowNodeRef>service-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go-to-service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay-repair</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enter-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform-repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-next-service</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Successful service completed" />
    <bpmn:task id="check-registered" name="Check if car is still registered" />
    <bpmn:exclusiveGateway id="registered-gateway" name="Car registered?" />
    <bpmn:task id="notify-owner" name="Notify the car owner of the service" />
    <bpmn:exclusiveGateway id="service-decision" name="Go to the service?" />
    <bpmn:task id="wait-30-days" name="Wait 30 days" />
    <bpmn:task id="fine-owner" name="Fine the car owner" />
    <bpmn:task id="go-to-service" name="Go to the car service facility" />
    <bpmn:task id="enter-problems" name="Enter the problems of the car for reference" />
    <bpmn:parallelGateway id="fork-status" name="Start waiting and status updates" />
    <bpmn:task id="wait-repair" name="Wait for the repair" />
    <bpmn:task id="send-status-updates" name="Send status updates via email" />
    <bpmn:parallelGateway id="join-status" name="Repair finished" />
    <bpmn:task id="perform-repair" name="Perform the repair" />
    <bpmn:task id="enter-success" name="Enter that the repair was successful and the Pickerl was issued" />
    <bpmn:task id="pay-repair" name="Pay for the repair through the app" />
    <bpmn:task id="enter-next-service" name="Enter the time for the next service" />
    <bpmn:endEvent id="end-not-registered" name="Car not registered" />
    <bpmn:endEvent id="end-fined" name="Owner fined" />
    <bpmn:endEvent id="end-next-service-set" name="Next service scheduled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check-registered" />
    <bpmn:sequenceFlow id="f2" sourceRef="check-registered" targetRef="registered-gateway" />
    <bpmn:sequenceFlow id="f3" name="no" sourceRef="registered-gateway" targetRef="end-not-registered" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="registered-gateway" targetRef="notify-owner" />
    <bpmn:sequenceFlow id="f5" sourceRef="notify-owner" targetRef="service-decision" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="service-decision" targetRef="go-to-service" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="service-decision" targetRef="wait-30-days" />
    <bpmn:sequenceFlow id="f8" sourceRef="wait-30-days" targetRef="fine-owner" />
    <bpmn:sequenceFlow id="f9" sourceRef="fine-owner" targetRef="end-fined" />
    <bpmn:sequenceFlow id="f10" sourceRef="go-to-service" targetRef="enter-problems" />
    <bpmn:sequenceFlow id="f11" sourceRef="enter-problems" targetRef="fork-status" />
    <bpmn:sequenceFlow id="f12" sourceRef="fork-status" targetRef="wait-repair" />
    <bpmn:sequenceFlow id="f13" sourceRef="fork-status" targetRef="send-status-updates" />
    <bpmn:sequenceFlow id="f14" sourceRef="wait-repair" targetRef="join-status" />
    <bpmn:sequenceFlow id="f15" sourceRef="send-status-updates" targetRef="join-status" />
    <bpmn:sequenceFlow id="f16" sourceRef="join-status" targetRef="perform-repair" />
    <bpmn:sequenceFlow id="f17" sourceRef="perform-repair" targetRef="enter-success" />
    <bpmn:sequenceFlow id="f18" sourceRef="enter-success" targetRef="pay-repair" />
    <bpmn:sequenceFlow id="f19" sourceRef="pay-repair" targetRef="enter-next-service" />
    <bpmn:sequenceFlow id="f20" sourceRef="enter-next-service" targetRef="end-next-service-set" />
  </bpmn:process>
</bpmn:definitions>
