<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller near the University of Vienna" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>startCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSplit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askSides</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSides</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSidesMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwJoin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMerge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSplit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statusUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwJoin2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="conveyor" name="Conveyor Belt">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startCustomer" name="Order placed" />
    <bpmn:task id="receive" name="Receive the order" />
    <bpmn:task id="askMenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="gwMenu" name="Menu or just the burger?" />
    <bpmn:parallelGateway id="gwSplit1" />
    <bpmn:task id="prepDrink" name="Prepare the drink" />
    <bpmn:task id="askSides" name="Ask whether the customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="gwSides" name="Fries or wedges?" />
    <bpmn:task id="prepFries" name="Prepare the fries" />
    <bpmn:task id="prepWedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="gwSidesMerge" />
    <bpmn:parallelGateway id="gwJoin1" />
    <bpmn:exclusiveGateway id="gwMerge2" />
    <bpmn:parallelGateway id="gwSplit2" />
    <bpmn:task id="prepBurger" name="Prepare the burger" />
    <bpmn:task id="statusUpdates" name="Give enthusiastic status updates every 30 seconds" />
    <bpmn:parallelGateway id="gwJoin2" />
    <bpmn:task id="deliver" name="Deliver the order via conveyor belt" />
    <bpmn:endEvent id="endDelivered" name="Order delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="startCustomer" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="askMenu" />
    <bpmn:sequenceFlow id="f3" sourceRef="askMenu" targetRef="gwMenu" />
    <bpmn:sequenceFlow id="f4" name="menu" sourceRef="gwMenu" targetRef="gwSplit1" />
    <bpmn:sequenceFlow id="f5" name="just the burger" sourceRef="gwMenu" targetRef="gwMerge2" />
    <bpmn:sequenceFlow id="f6" sourceRef="gwSplit1" targetRef="prepDrink" />
    <bpmn:sequenceFlow id="f7" sourceRef="gwSplit1" targetRef="askSides" />
    <bpmn:sequenceFlow id="f8" sourceRef="askSides" targetRef="gwSides" />
    <bpmn:sequenceFlow id="f9" name="fries" sourceRef="gwSides" targetRef="prepFries" />
    <bpmn:sequenceFlow id="f10" name="wedges" sourceRef="gwSides" targetRef="prepWedges" />
    <bpmn:sequenceFlow id="f11" sourceRef="prepFries" targetRef="gwSidesMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="prepWedges" targetRef="gwSidesMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="gwSidesMerge" targetRef="gwJoin1" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepDrink" targetRef="gwJoin1" />
    <bpmn:sequenceFlow id="f15" sourceRef="gwJoin1" targetRef="gwMerge2" />
    <bpmn:sequenceFlow id="f16" sourceRef="gwMerge2" targetRef="gwSplit2" />
    <bpmn:sequenceFlow id="f17" sourceRef="gwSplit2" targetRef="prepBurger" />
    <bpmn:sequenceFlow id="f18" sourceRef="gwSplit2" targetRef="statusUpdates" />
    <bpmn:sequenceFlow id="f19" sourceRef="prepBurger" targetRef="gwJoin2" />
    <bpmn:sequenceFlow id="f20" sourceRef="statusUpdates" targetRef="gwJoin2" />
    <bpmn:sequenceFlow id="f21" sourceRef="gwJoin2" targetRef="deliver" />
    <bpmn:sequenceFlow id="f22" sourceRef="deliver" targetRef="endDelivered" />
  </bpmn:process>
</bpmn:definitions>
