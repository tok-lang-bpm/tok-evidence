<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online Shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-wait-login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-check-all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-enter-pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-enter-ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge-addr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="E-Shop System">
        <bpmn:flowNodeRef>t-check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-finish1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-par-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-prep-pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-prep-ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-par-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t-finish2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>t-confirm-pay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="order-start" name="Customer wants to order" />
    <bpmn:task id="t-login" name="Log in to the E-Shop system" />
    <bpmn:task id="t-check" name="Check the credentials" />
    <bpmn:task id="t-wait-login" name="Wait for login confirmation" />
    <bpmn:exclusiveGateway id="gw-login" name="Login successful?" />
    <bpmn:endEvent id="end-stop" name="Shopping experience stopped" />
    <bpmn:exclusiveGateway id="merge-select" />
    <bpmn:task id="t-select" name="Select a product" />
    <bpmn:task id="t-cart" name="Add the product to the shopping cart" />
    <bpmn:task id="t-save" name="Save the product" />
    <bpmn:task id="t-check-all" name="Check whether every product was selected" />
    <bpmn:exclusiveGateway id="gw-all" name="All products selected?" />
    <bpmn:task id="t-finish1" name="Finish the order" />
    <bpmn:parallelGateway id="gw-par-split" />
    <bpmn:task id="t-prep-pay" name="Prepare the payment" />
    <bpmn:task id="t-prep-ship" name="Prepare the shipment" />
    <bpmn:task id="t-enter-pay" name="Enter the payment data" />
    <bpmn:task id="t-confirm-pay" name="Confirm the payment" />
    <bpmn:task id="t-enter-ship" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="gw-billing" name="Shipping address equal to billing address?" />
    <bpmn:task id="t-billing" name="Enter an independent billing address" />
    <bpmn:exclusiveGateway id="merge-addr" />
    <bpmn:parallelGateway id="gw-par-join" />
    <bpmn:task id="t-finish2" name="Finish the order" />
    <bpmn:endEvent id="end-done" name="Order finished" />

    <bpmn:sequenceFlow id="f1" sourceRef="order-start" targetRef="t-login" />
    <bpmn:sequenceFlow id="f2" sourceRef="t-login" targetRef="t-check" />
    <bpmn:sequenceFlow id="f3" sourceRef="t-check" targetRef="t-wait-login" />
    <bpmn:sequenceFlow id="f4" sourceRef="t-wait-login" targetRef="gw-login" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gw-login" targetRef="end-stop" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="gw-login" targetRef="merge-select" />
    <bpmn:sequenceFlow id="f7" sourceRef="merge-select" targetRef="t-select" />
    <bpmn:sequenceFlow id="f8" sourceRef="t-select" targetRef="t-cart" />
    <bpmn:sequenceFlow id="f9" sourceRef="t-cart" targetRef="t-save" />
    <bpmn:sequenceFlow id="f10" sourceRef="t-save" targetRef="t-check-all" />
    <bpmn:sequenceFlow id="f11" sourceRef="t-check-all" targetRef="gw-all" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gw-all" targetRef="merge-select" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="gw-all" targetRef="t-finish1" />
    <bpmn:sequenceFlow id="f14" sourceRef="t-finish1" targetRef="gw-par-split" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw-par-split" targetRef="t-prep-pay" />
    <bpmn:sequenceFlow id="f16" sourceRef="gw-par-split" targetRef="t-prep-ship" />
    <bpmn:sequenceFlow id="f17" sourceRef="t-prep-pay" targetRef="t-enter-pay" />
    <bpmn:sequenceFlow id="f18" sourceRef="t-enter-pay" targetRef="t-confirm-pay" />
    <bpmn:sequenceFlow id="f19" sourceRef="t-confirm-pay" targetRef="gw-par-join" />
    <bpmn:sequenceFlow id="f20" sourceRef="t-prep-ship" targetRef="t-enter-ship" />
    <bpmn:sequenceFlow id="f21" sourceRef="t-enter-ship" targetRef="gw-billing" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="gw-billing" targetRef="merge-addr" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="gw-billing" targetRef="t-billing" />
    <bpmn:sequenceFlow id="f24" sourceRef="t-billing" targetRef="merge-addr" />
    <bpmn:sequenceFlow id="f25" sourceRef="merge-addr" targetRef="gw-par-join" />
    <bpmn:sequenceFlow id="f26" sourceRef="gw-par-join" targetRef="t-finish2" />
    <bpmn:sequenceFlow id="f27" sourceRef="t-finish2" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
