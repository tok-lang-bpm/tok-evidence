<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="activationMsg" name="Activation response" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Sports Institute" processRef="usi-registration" />
  </bpmn:collaboration>
  <bpmn:process id="usi-registration" isExecutable="false">
    <bpmn:laneSet id="usi-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accountGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkUni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uniGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestAct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTicket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Registration System">
        <bpmn:flowNodeRef>checkSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slotsGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>showCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Registration for a course needed" />
    <bpmn:task id="selectCourse" name="Select a course" />
    <bpmn:task id="checkSlots" name="Check whether slots are free" />
    <bpmn:exclusiveGateway id="slotsGw" name="Slots free?" />
    <bpmn:endEvent id="endNoSlots" name="Course not available" />
    <bpmn:task id="showCourses" name="Show the courses and dates" />
    <bpmn:task id="selectOne" name="Select one course" />
    <bpmn:exclusiveGateway id="accountGw" name="Account at the sports institute?" />
    <bpmn:task id="checkUni" name="Check whether registered at an eligible university" />
    <bpmn:exclusiveGateway id="uniGw" name="Registered at an eligible university?" />
    <bpmn:task id="registerAcct" name="Register the account" />
    <bpmn:task id="requestAct" name="Request an activation" />
    <bpmn:intermediateCatchEvent id="waitResp" name="Wait for a response">
      <bpmn:messageEventDefinition messageRef="activationMsg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="mergeAcct" name="Account available" />
    <bpmn:task id="login" name="Log into the account" />
    <bpmn:parallelGateway id="parSplit" name="Start parallel steps" />
    <bpmn:task id="tweet" name="Tweet to friends who might want to join" />
    <bpmn:task id="completeReg" name="Complete the course registration" />
    <bpmn:task id="payment" name="Provide the payment information" />
    <bpmn:parallelGateway id="parJoin" name="Join parallel steps" />
    <bpmn:task id="ticket" name="Issue the course ticket" />
    <bpmn:endEvent id="endTicket" name="Course ticket received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectCourse" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectCourse" targetRef="checkSlots" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkSlots" targetRef="slotsGw" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="slotsGw" targetRef="endNoSlots" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="slotsGw" targetRef="showCourses" />
    <bpmn:sequenceFlow id="f6" sourceRef="showCourses" targetRef="selectOne" />
    <bpmn:sequenceFlow id="f7" sourceRef="selectOne" targetRef="accountGw" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="accountGw" targetRef="mergeAcct" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="accountGw" targetRef="checkUni" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkUni" targetRef="uniGw" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="uniGw" targetRef="registerAcct" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="uniGw" targetRef="requestAct" />
    <bpmn:sequenceFlow id="f13" sourceRef="registerAcct" targetRef="mergeAcct" />
    <bpmn:sequenceFlow id="f14" sourceRef="requestAct" targetRef="waitResp" />
    <bpmn:sequenceFlow id="f15" sourceRef="waitResp" targetRef="mergeAcct" />
    <bpmn:sequenceFlow id="f16" sourceRef="mergeAcct" targetRef="login" />
    <bpmn:sequenceFlow id="f17" sourceRef="login" targetRef="parSplit" />
    <bpmn:sequenceFlow id="f18" sourceRef="parSplit" targetRef="tweet" />
    <bpmn:sequenceFlow id="f19" sourceRef="parSplit" targetRef="completeReg" />
    <bpmn:sequenceFlow id="f20" sourceRef="completeReg" targetRef="payment" />
    <bpmn:sequenceFlow id="f21" sourceRef="tweet" targetRef="parJoin" />
    <bpmn:sequenceFlow id="f22" sourceRef="payment" targetRef="parJoin" />
    <bpmn:sequenceFlow id="f23" sourceRef="parJoin" targetRef="ticket" />
    <bpmn:sequenceFlow id="f24" sourceRef="ticket" targetRef="endTicket" />
  </bpmn:process>
</bpmn:definitions>
