<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Sales staff or customer support">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Sales representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Customer inquires about product or service" />
    <bpmn:userTask id="approve" name="Approve quote" />
    <bpmn:exclusiveGateway id="g2" name="Quote approved?" />
    <bpmn:task id="place" name="Place order" />
    <bpmn:endEvent id="e1" name="Order placed and confirmed" />
    <bpmn:endEvent id="e2" name="Quote rejected" />
    <bpmn:endEvent id="e3" name="Customer not interested" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="address" name="Address concerns and questions" />
    <bpmn:exclusiveGateway id="g1" name="Customer interested?" />
    <bpmn:task id="guide" name="Guide customer through selecting product or service" />
    <bpmn:task id="quote" name="Provide quote" />
    <bpmn:task id="record" name="Record order" />
    <bpmn:task id="confirm" name="Send order confirmation" />
    <bpmn:sequenceFlow id="f-s1-collect" sourceRef="s1" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-address" sourceRef="collect" targetRef="address" />
    <bpmn:sequenceFlow id="f-address-g1" sourceRef="address" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-guide" name="yes" sourceRef="g1" targetRef="guide" />
    <bpmn:sequenceFlow id="f-g1-e3" name="no" sourceRef="g1" targetRef="e3" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approve" sourceRef="quote" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-g2" sourceRef="approve" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-place" name="yes" sourceRef="g2" targetRef="place" />
    <bpmn:sequenceFlow id="f-g2-e2" name="no" sourceRef="g2" targetRef="e2" />
    <bpmn:sequenceFlow id="f-place-record" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-confirm" sourceRef="record" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-e1" sourceRef="confirm" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
