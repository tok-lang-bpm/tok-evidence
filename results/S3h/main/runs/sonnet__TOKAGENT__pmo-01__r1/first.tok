tok 1.0 "Order handling"

pool org "Organisation"
  lane customer "Customer"
    start s1 "Customer inquires about product or service"
    user approve "Approve quote"
    xor g2 "Quote approved?"
    task place "Place order"
    end e1 "Order placed and confirmed"
    end e2 "Quote rejected"
    end e3 "Customer not interested"
  lane support "Sales staff or customer support"
    task collect "Collect relevant information"
    task address "Address concerns and questions"
    xor g1 "Customer interested?"
    task guide "Guide customer through selecting product or service"
  lane rep "Sales representative"
    task quote "Provide quote"
  lane system "System"
    task record "Record order"
    task confirm "Send order confirmation"

flow s1 -> collect -> address -> g1
flow g1 -> guide "yes"
flow g1 -> e3 "no"
flow guide -> quote -> approve -> g2
flow g2 -> place "yes"
flow g2 -> e2 "no"
flow place -> record -> confirm -> e1
