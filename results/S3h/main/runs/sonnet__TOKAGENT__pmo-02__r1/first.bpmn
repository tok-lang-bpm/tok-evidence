<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Hiring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Hiring" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nego</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Need for new hire identified" />
    <bpmn:task id="jd" name="Create job description" />
    <bpmn:task id="post" name="Post job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="pref" name="Candidate prefers in-person or virtual?" />
    <bpmn:task id="inp" name="Conduct in-person interview" />
    <bpmn:task id="virt" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="pm" />
    <bpmn:task id="choose" name="Choose candidate" />
    <bpmn:task id="offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="neg" name="Negotiation needed?" />
    <bpmn:task id="nego" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="nm" />
    <bpmn:parallelGateway id="ob" />
    <bpmn:task id="paper" name="Complete paperwork" />
    <bpmn:task id="orient" name="Conduct orientation" />
    <bpmn:task id="train" name="Conduct training" />
    <bpmn:parallelGateway id="oj" />
    <bpmn:task id="integ" name="Integrate new hire into team" />
    <bpmn:endEvent id="e" name="New hire integrated" />
    <bpmn:sequenceFlow id="f-s-jd" sourceRef="s" targetRef="jd" />
    <bpmn:sequenceFlow id="f-jd-post" sourceRef="jd" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-pref" sourceRef="phone" targetRef="pref" />
    <bpmn:sequenceFlow id="f-pref-inp" name="in-person" sourceRef="pref" targetRef="inp" />
    <bpmn:sequenceFlow id="f-pref-virt" name="virtual" sourceRef="pref" targetRef="virt" />
    <bpmn:sequenceFlow id="f-inp-pm" sourceRef="inp" targetRef="pm" />
    <bpmn:sequenceFlow id="f-virt-pm" sourceRef="virt" targetRef="pm" />
    <bpmn:sequenceFlow id="f-pm-choose" sourceRef="pm" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-offer" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-neg" sourceRef="offer" targetRef="neg" />
    <bpmn:sequenceFlow id="f-neg-nego" name="yes" sourceRef="neg" targetRef="nego" />
    <bpmn:sequenceFlow id="f-neg-nm" name="no" sourceRef="neg" targetRef="nm" />
    <bpmn:sequenceFlow id="f-nego-nm" sourceRef="nego" targetRef="nm" />
    <bpmn:sequenceFlow id="f-nm-ob" sourceRef="nm" targetRef="ob" />
    <bpmn:sequenceFlow id="f-ob-paper" sourceRef="ob" targetRef="paper" />
    <bpmn:sequenceFlow id="f-paper-oj" sourceRef="paper" targetRef="oj" />
    <bpmn:sequenceFlow id="f-ob-orient" sourceRef="ob" targetRef="orient" />
    <bpmn:sequenceFlow id="f-orient-oj" sourceRef="orient" targetRef="oj" />
    <bpmn:sequenceFlow id="f-ob-train" sourceRef="ob" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-oj" sourceRef="train" targetRef="oj" />
    <bpmn:sequenceFlow id="f-oj-integ" sourceRef="oj" targetRef="integ" />
    <bpmn:sequenceFlow id="f-integ-e" sourceRef="integ" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
