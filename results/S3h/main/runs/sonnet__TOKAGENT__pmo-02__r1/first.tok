tok 1.0 "Hiring"

pool org "Organisation"
  lane dept "Department"
    start s "Need for new hire identified"
  lane hr "HR"
    task jd "Create job description"
    task post "Post job description on job boards"
    task collect "Collect resumes"
    task screen "Screen resumes"
    task phone "Conduct initial phone interviews"
    xor pref "Candidate prefers in-person or virtual?"
    task inp "Conduct in-person interview"
    task virt "Conduct virtual interview"
    xor pm
    task choose "Choose candidate"
    task offer "Extend offer"
    xor neg "Negotiation needed?"
    task nego "Negotiate salary"
    xor nm
    and ob
    task paper "Complete paperwork"
    task orient "Conduct orientation"
    task train "Conduct training"
    and oj
    task integ "Integrate new hire into team"
    end e "New hire integrated"

flow s -> jd -> post -> collect -> screen -> phone -> pref
flow pref -> inp "in-person"
flow pref -> virt "virtual"
flow inp -> pm
flow virt -> pm
flow pm -> choose -> offer -> neg
flow neg -> nego "yes"
flow neg -> nm "no"
flow nego -> nm
flow nm -> ob
flow ob -> paper -> oj
flow ob -> orient -> oj
flow ob -> train -> oj
flow oj -> integ -> e
