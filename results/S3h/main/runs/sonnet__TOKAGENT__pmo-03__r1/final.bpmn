<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inventory restocking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Inventory organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inventory restocking" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="wh" name="Warehouse staff">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="proc" name="Procurement team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Inventory system">
        <bpmn:flowNodeRef>dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Restock process started" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="g1" name="How is the need to reorder signalled?" default="f-g1-manual" />
    <bpmn:task id="alert" name="Raise automated alert" />
    <bpmn:task id="manual" name="Perform manual check" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="record" name="Record stock in system" />
    <bpmn:task id="shelve" name="Place stock on shelves" />
    <bpmn:endEvent id="e" name="Restock completed" />
    <bpmn:task id="order" name="Place order with suppliers" />
    <bpmn:task id="dates" name="Update expected delivery dates" />
    <bpmn:task id="update" name="Update inventory levels" />
    <bpmn:sequenceFlow id="f-s-monitor" sourceRef="s" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-g1" sourceRef="monitor" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-alert" name="automated alert" sourceRef="g1" targetRef="alert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alert = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-manual" name="manual check" sourceRef="g1" targetRef="manual" />
    <bpmn:sequenceFlow id="f-alert-g2" sourceRef="alert" targetRef="g2" />
    <bpmn:sequenceFlow id="f-manual-g2" sourceRef="manual" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-order" sourceRef="g2" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-dates" sourceRef="order" targetRef="dates" />
    <bpmn:sequenceFlow id="f-dates-receive" sourceRef="dates" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-shelve" sourceRef="record" targetRef="shelve" />
    <bpmn:sequenceFlow id="f-shelve-update" sourceRef="shelve" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-e" sourceRef="update" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
