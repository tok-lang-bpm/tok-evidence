tok 1.0 "Inventory restocking"

pool org "Inventory organisation"
  lane wh "Warehouse staff"
    start s "Restock process started"
    task monitor "Monitor inventory levels"
    xor g1 "How is the need to reorder signalled?"
    task alert "Raise automated alert"
    task manual "Perform manual check"
    xor g2
    task receive "Receive stock"
    task inspect "Inspect stock for quality"
    task record "Record stock in system"
    task shelve "Place stock on shelves"
    end e "Restock completed"
  lane proc "Procurement team"
    task order "Place order with suppliers"
  lane sys "Inventory system"
    task dates "Update expected delivery dates"
    task update "Update inventory levels"

flow s -> monitor -> g1
flow g1 -> alert "automated alert" when="alert = true"
flow g1 -> manual "manual check" default
flow alert -> g2
flow manual -> g2
flow g2 -> order -> dates -> receive -> inspect -> record -> shelve -> update -> e
