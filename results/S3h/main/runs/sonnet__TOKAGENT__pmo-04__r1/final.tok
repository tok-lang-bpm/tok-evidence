tok 1.0 "Marketing campaign"

pool org "Organisation"
  lane mkt "Marketing team"
    start s "Campaign needed"
    task t1 "Define campaign objectives"
    and g1
    task t2 "Create content"
    task t3 "Design visuals"
    task t4 "Select promotion channels"
    and g2
    task t5 "Launch campaign"
    and g3
    task t6 "Track campaign performance"
    and g4
    task t7 "Analyze performance"
    end e "Campaign analyzed"
  lane crm "CRM system"
    task t8 "Collect leads"
  lane sales "Sales team"
    task t9 "Follow up leads"

flow s -> t1 -> g1
flow g1 -> t2
flow g1 -> t3
flow g1 -> t4
flow t2 -> g2
flow t3 -> g2
flow t4 -> g2
flow g2 -> t5 -> g3
flow g3 -> t6
flow g3 -> t8
flow t8 -> t9
flow t6 -> g4
flow t9 -> g4
flow g4 -> t7 -> e
