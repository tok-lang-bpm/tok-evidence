<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mkt" name="Marketing team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Campaign needed" />
    <bpmn:task id="t1" name="Define campaign objectives" />
    <bpmn:parallelGateway id="g1" />
    <bpmn:task id="t2" name="Create content" />
    <bpmn:task id="t3" name="Design visuals" />
    <bpmn:task id="t4" name="Select promotion channels" />
    <bpmn:parallelGateway id="g2" />
    <bpmn:task id="t5" name="Launch campaign" />
    <bpmn:parallelGateway id="g3" />
    <bpmn:task id="t6" name="Track campaign performance" />
    <bpmn:parallelGateway id="g4" />
    <bpmn:task id="t7" name="Analyze performance" />
    <bpmn:endEvent id="e" name="Campaign analyzed" />
    <bpmn:task id="t8" name="Collect leads" />
    <bpmn:task id="t9" name="Follow up leads" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t2" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-g1-t3" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-g1-t4" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t2-g2" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t3-g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t4-g2" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t5" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-g3" sourceRef="t5" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t6" sourceRef="g3" targetRef="t6" />
    <bpmn:sequenceFlow id="f-g3-t8" sourceRef="g3" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t6-g4" sourceRef="t6" targetRef="g4" />
    <bpmn:sequenceFlow id="f-t9-g4" sourceRef="t9" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-t7" sourceRef="g4" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-e" sourceRef="t7" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
