tok 1.0 "Supplier selection"

pool org "Organisation"
  lane company "Company"
    start s "Need for new supplier identified"
    end e "Supplier onboarded and contract executed"
  lane proc "Procurement team"
    task t1 "Issue request for proposals"
    task t2 "Receive supplier responses"
    task t3 "Evaluate proposals"
    xor g1 "Site visits or interviews needed?"
    task t4 "Conduct site visits or interviews"
    xor g2
    task t5 "Select supplier"
    task t6 "Negotiate contract"
    task t7 "Sign contract"
    task t8 "Onboard supplier"
    task t9 "Execute contract"

flow s -> t1 -> t2 -> t3 -> g1
flow g1 -> t4 "yes" when="visitNeeded = true"
flow g1 -> g2 "no" default
flow t4 -> g2
flow g2 -> t5 -> t6 -> t7 -> t8 -> t9 -> e
