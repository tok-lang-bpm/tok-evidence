<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Supplier selection" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Supplier selection" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="proc" name="Procurement team">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Need for new supplier identified" />
    <bpmn:endEvent id="e" name="Supplier onboarded and contract executed" />
    <bpmn:task id="t1" name="Issue request for proposals" />
    <bpmn:task id="t2" name="Receive supplier responses" />
    <bpmn:task id="t3" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="g1" name="Site visits or interviews needed?" default="f-g1-g2" />
    <bpmn:task id="t4" name="Conduct site visits or interviews" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="t5" name="Select supplier" />
    <bpmn:task id="t6" name="Negotiate contract" />
    <bpmn:task id="t7" name="Sign contract" />
    <bpmn:task id="t8" name="Onboard supplier" />
    <bpmn:task id="t9" name="Execute contract" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-g1" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t4" name="yes" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-g1-g2" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t4-g2" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t5" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-e" sourceRef="t9" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
