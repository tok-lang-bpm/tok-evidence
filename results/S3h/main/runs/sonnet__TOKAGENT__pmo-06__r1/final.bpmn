<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order fulfilment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order placed" />
    <bpmn:task id="place" name="Place order" />
    <bpmn:task id="confirm" name="Generate order confirmation" />
    <bpmn:task id="sendconf" name="Send order confirmation" />
    <bpmn:task id="label" name="Generate shipping label" />
    <bpmn:task id="track" name="Send tracking information" />
    <bpmn:task id="pick" name="Pick items" />
    <bpmn:task id="pack" name="Pack items" />
    <bpmn:task id="handover" name="Hand over order to logistics provider" />
    <bpmn:task id="monitor" name="Monitor shipment" />
    <bpmn:exclusiveGateway id="arrived" name="Reached customer's address?" default="f-arrived-monitor" />
    <bpmn:endEvent id="e" name="Order delivered" />
    <bpmn:sequenceFlow id="f-s-place" sourceRef="s" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-confirm" sourceRef="place" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-sendconf" sourceRef="confirm" targetRef="sendconf" />
    <bpmn:sequenceFlow id="f-sendconf-pick" sourceRef="sendconf" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-pack" sourceRef="pick" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-label" sourceRef="pack" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-handover" sourceRef="label" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-track" sourceRef="handover" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-monitor" sourceRef="track" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-arrived" sourceRef="monitor" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-arrived-e" name="yes" sourceRef="arrived" targetRef="e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">delivered = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-arrived-monitor" name="no" sourceRef="arrived" targetRef="monitor" />
  </bpmn:process>
</bpmn:definitions>
