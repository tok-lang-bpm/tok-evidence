tok 1.0 "Order fulfilment"

pool org "Organisation"
  lane customer "Customer"
    start s "Order placed"
    task place "Place order"
  lane system "System"
    task confirm "Generate order confirmation"
    task sendconf "Send order confirmation"
    task label "Generate shipping label"
    task track "Send tracking information"
  lane warehouse "Warehouse team"
    task pick "Pick items"
    task pack "Pack items"
    task handover "Hand over order to logistics provider"
  lane logistics "Logistics provider"
    task monitor "Monitor shipment"
    xor arrived "Reached customer's address?"
    end e "Order delivered"

flow s -> place -> confirm -> sendconf -> pick -> pack -> label -> handover -> track -> monitor -> arrived
flow arrived -> e "yes" when="delivered = true"
flow arrived -> monitor "no" default
