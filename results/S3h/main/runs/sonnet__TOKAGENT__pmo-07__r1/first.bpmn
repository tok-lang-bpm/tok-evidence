<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ticket booking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Travel company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Ticket booking" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Booking system">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="trav" name="Travel company">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Customer searches for ticket" />
    <bpmn:task id="t1" name="Search for ticket" />
    <bpmn:task id="t2" name="Select route, date and time" />
    <bpmn:task id="t3" name="Provide personal information" />
    <bpmn:task id="t4" name="Provide payment details" />
    <bpmn:task id="t12" name="Complete journey" />
    <bpmn:exclusiveGateway id="g4" name="Provide feedback?" />
    <bpmn:task id="t13" name="Provide feedback" />
    <bpmn:exclusiveGateway id="g5" />
    <bpmn:endEvent id="e1" name="Process completed" />
    <bpmn:task id="t5" name="Generate ticket" />
    <bpmn:exclusiveGateway id="g1" name="Delivery channel?" />
    <bpmn:task id="t6" name="Send ticket via email" />
    <bpmn:task id="t7" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:parallelGateway id="g3" />
    <bpmn:task id="t9" name="Send reminders and check-in instructions" />
    <bpmn:parallelGateway id="g3j" />
    <bpmn:task id="t8" name="Update seat inventory" />
    <bpmn:sequenceFlow id="f-s1-t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-g1" sourceRef="t5" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t6" name="email" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="f-g1-t7" name="SMS" sourceRef="g1" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t6-g2" sourceRef="t6" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t7-g2" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-g3" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t8" sourceRef="g3" targetRef="t8" />
    <bpmn:sequenceFlow id="f-g3-t9" sourceRef="g3" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t8-g3j" sourceRef="t8" targetRef="g3j" />
    <bpmn:sequenceFlow id="f-t9-g3j" sourceRef="t9" targetRef="g3j" />
    <bpmn:sequenceFlow id="f-g3j-t12" sourceRef="g3j" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-g4" sourceRef="t12" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-t13" name="yes" sourceRef="g4" targetRef="t13" />
    <bpmn:sequenceFlow id="f-g4-g5" name="no" sourceRef="g4" targetRef="g5" />
    <bpmn:sequenceFlow id="f-t13-g5" sourceRef="t13" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-e1" sourceRef="g5" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
