tok 1.0 "Ticket booking"

pool org "Travel company"
  lane cust "Customer"
    start s1 "Customer searches for ticket"
    task t1 "Search for ticket"
    task t2 "Select route, date and time"
    task t3 "Provide personal information"
    task t4 "Provide payment details"
    task t12 "Complete journey"
    xor g4 "Provide feedback?"
    task t13 "Provide feedback"
    xor g5
    end e1 "Process completed"
  lane sys "Booking system"
    task t5 "Generate ticket"
    xor g1 "Delivery channel?"
    task t6 "Send ticket via email"
    task t7 "Send ticket via SMS"
    xor g2
    and g3
    task t9 "Send reminders and check-in instructions"
    and g3j
  lane trav "Travel company"
    task t8 "Update seat inventory"

flow s1 -> t1 -> t2 -> t3 -> t4 -> t5 -> g1
flow g1 -> t6 "email"
flow g1 -> t7 "SMS"
flow t6 -> g2
flow t7 -> g2
flow g2 -> g3
flow g3 -> t8
flow g3 -> t9
flow t8 -> g3j
flow t9 -> g3j
flow g3j -> t12 -> g4
flow g4 -> t13 "yes"
flow g4 -> g5 "no"
flow t13 -> g5
flow g5 -> e1
