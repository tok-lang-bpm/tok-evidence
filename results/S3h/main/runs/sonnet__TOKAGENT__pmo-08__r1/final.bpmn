<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident management" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident management" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rep" name="Employee or customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Tracking system">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Investigation team">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Incident reported" />
    <bpmn:task id="t1" name="Report incident" />
    <bpmn:task id="t2" name="Log report" />
    <bpmn:task id="t3" name="Assign report to team" />
    <bpmn:task id="t4" name="Gather information" />
    <bpmn:task id="t5" name="Identify cause" />
    <bpmn:task id="t6" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="g1" name="Which kind of solution?" />
    <bpmn:task id="t7" name="Implement fix" />
    <bpmn:task id="t8" name="Provide training" />
    <bpmn:task id="t9" name="Change policy" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="t10" name="Follow up on resolution" />
    <bpmn:task id="t11" name="Close incident report" />
    <bpmn:task id="t12" name="Notify stakeholders" />
    <bpmn:endEvent id="e" name="Incident closed" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-g1" sourceRef="t6" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t7" name="fix" sourceRef="g1" targetRef="t7" />
    <bpmn:sequenceFlow id="f-g1-t8" name="training" sourceRef="g1" targetRef="t8" />
    <bpmn:sequenceFlow id="f-g1-t9" name="policy change" sourceRef="g1" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t7-g2" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t8-g2" sourceRef="t8" targetRef="g2" />
    <bpmn:sequenceFlow id="f-t9-g2" sourceRef="t9" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t10" sourceRef="g2" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-t11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-t12" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-e" sourceRef="t12" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
