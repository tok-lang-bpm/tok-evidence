tok 1.0 "Incident management"

pool org "Organisation"
  lane rep "Employee or customer"
    start s "Incident reported"
    task t1 "Report incident"
  lane sys "Tracking system"
    task t2 "Log report"
    task t3 "Assign report to team"
  lane team "Investigation team"
    task t4 "Gather information"
    task t5 "Identify cause"
    task t6 "Propose corrective actions"
    xor g1 "Which kind of solution?"
    task t7 "Implement fix"
    task t8 "Provide training"
    task t9 "Change policy"
    xor g2
    task t10 "Follow up on resolution"
    task t11 "Close incident report"
    task t12 "Notify stakeholders"
    end e "Incident closed"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> g1
flow g1 -> t7 "fix"
flow g1 -> t8 "training"
flow g1 -> t9 "policy change"
flow t7 -> g2
flow t8 -> g2
flow t9 -> g2
flow g2 -> t10 -> t11 -> t12 -> e
