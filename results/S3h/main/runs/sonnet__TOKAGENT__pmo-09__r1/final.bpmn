<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Product prototype development" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Product prototype development" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rd" name="R&amp;D team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Idea identified" />
    <bpmn:task id="t1" name="Identify idea for product" />
    <bpmn:task id="t2" name="Conduct initial research" />
    <bpmn:task id="t3" name="Conduct feasibility studies" />
    <bpmn:task id="t4" name="Draft design concepts" />
    <bpmn:task id="t5" name="Select promising design" />
    <bpmn:task id="t6" name="Build prototype" />
    <bpmn:task id="t7" name="Test prototype" />
    <bpmn:task id="t8" name="Collect feedback" />
    <bpmn:exclusiveGateway id="g1" name="Refinement needed?" />
    <bpmn:task id="t9" name="Refine prototype" />
    <bpmn:exclusiveGateway id="g2" name="Prototype approved?" />
    <bpmn:task id="t10" name="Approve prototype for further development" />
    <bpmn:task id="t11" name="Discard prototype" />
    <bpmn:endEvent id="e1" name="Prototype approved" />
    <bpmn:endEvent id="e2" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-g1" sourceRef="t8" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t9" name="yes" sourceRef="g1" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t7" sourceRef="t9" targetRef="t7" />
    <bpmn:sequenceFlow id="f-g1-g2" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t10" name="yes" sourceRef="g2" targetRef="t10" />
    <bpmn:sequenceFlow id="f-g2-t11" name="no" sourceRef="g2" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t10-e1" sourceRef="t10" targetRef="e1" />
    <bpmn:sequenceFlow id="f-t11-e2" sourceRef="t11" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
