tok 1.0 "Product prototype development"

pool org "Organisation"
  lane rd "R&D team"
    start s "Idea identified"
    task t1 "Identify idea for product"
    task t2 "Conduct initial research"
    task t3 "Conduct feasibility studies"
    task t4 "Draft design concepts"
    task t5 "Select promising design"
    task t6 "Build prototype"
    task t7 "Test prototype"
    task t8 "Collect feedback"
    xor g1 "Refinement needed?"
    task t9 "Refine prototype"
    xor g2 "Prototype approved?"
    task t10 "Approve prototype for further development"
    task t11 "Discard prototype"
    end e1 "Prototype approved"
    end e2 "Prototype discarded"

flow s -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 -> t8 -> g1
flow g1 -> t9 "yes"
flow t9 -> t7
flow g1 -> g2 "no"
flow g2 -> t10 "yes"
flow g2 -> t11 "no"
flow t10 -> e1
flow t11 -> e2
