tok 1.0 "IT solution request"

pool org "Organisation"
  lane req "Employee or department"
    start s "Request submitted"
    task submit "Submit request for IT solution"
    end rejected "Request rejected"
  lane it "IT"
    task check "Check compatibility with existing systems"
    task eval "Evaluate cost and resource needs"
    task procure "Procure tools or licenses"
    task install "Install solution"
    task test "Test solution in controlled environment"
    task rollout "Roll out solution to requesting department"
    task train "Provide training"
    task support "Provide IT support for troubleshooting"
    and split
    and join
    xor approved "Approved?"
    xor tested "Test successful?"
    xor training "Training needed?"
    xor merge
    end done "Process completed"

flow s -> submit -> split
flow split -> check
flow split -> eval
flow check -> join
flow eval -> join
flow join -> approved
flow approved -> procure "yes" when="approved = true"
flow approved -> rejected "no" default
flow procure -> install -> test -> tested
flow tested -> rollout "yes" when="testPassed = true"
flow tested -> install "no" default
flow rollout -> training
flow training -> train "yes" when="trainingNeeded = true"
flow training -> merge "no" default
flow train -> merge
flow merge -> support -> done
