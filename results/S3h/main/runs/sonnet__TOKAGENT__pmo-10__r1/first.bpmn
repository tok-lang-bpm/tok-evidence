<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="IT solution request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="IT solution request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="req" name="Employee or department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Request submitted" />
    <bpmn:task id="submit" name="Submit request for IT solution" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:task id="check" name="Check compatibility with existing systems" />
    <bpmn:task id="eval" name="Evaluate cost and resource needs" />
    <bpmn:task id="procure" name="Procure tools or licenses" />
    <bpmn:task id="install" name="Install solution" />
    <bpmn:task id="test" name="Test solution in controlled environment" />
    <bpmn:task id="rollout" name="Roll out solution to requesting department" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="approved" name="Approved?" default="f-approved-rejected" />
    <bpmn:exclusiveGateway id="tested" name="Test successful?" default="f-tested-install" />
    <bpmn:exclusiveGateway id="training" name="Training needed?" default="f-training-merge" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-submit" sourceRef="s" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-split" sourceRef="submit" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-check" sourceRef="split" targetRef="check" />
    <bpmn:sequenceFlow id="f-split-eval" sourceRef="split" targetRef="eval" />
    <bpmn:sequenceFlow id="f-check-join" sourceRef="check" targetRef="join" />
    <bpmn:sequenceFlow id="f-eval-join" sourceRef="eval" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-approved" sourceRef="join" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="yes" sourceRef="approved" targetRef="procure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-approved-rejected" name="no" sourceRef="approved" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-tested" sourceRef="test" targetRef="tested" />
    <bpmn:sequenceFlow id="f-tested-rollout" name="yes" sourceRef="tested" targetRef="rollout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">testPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-tested-install" name="no" sourceRef="tested" targetRef="install" />
    <bpmn:sequenceFlow id="f-rollout-training" sourceRef="rollout" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-train" name="yes" sourceRef="training" targetRef="train">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trainingNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-training-merge" name="no" sourceRef="training" targetRef="merge" />
    <bpmn:sequenceFlow id="f-train-merge" sourceRef="train" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-support" sourceRef="merge" targetRef="support" />
    <bpmn:sequenceFlow id="f-support-done" sourceRef="support" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
