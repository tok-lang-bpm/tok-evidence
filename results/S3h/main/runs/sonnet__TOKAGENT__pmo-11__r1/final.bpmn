<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Subscription lifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Subscription service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Subscription lifecycle" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="System">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sup" name="Support team">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Customer signs up" />
    <bpmn:task id="t1" name="Enter personal and payment information" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t5" name="Receive updates and notifications" />
    <bpmn:exclusiveGateway id="g1" name="Does the customer cancel?" />
    <bpmn:task id="t6" name="Submit cancellation request" />
    <bpmn:endEvent id="e" name="Subscription closed" />
    <bpmn:task id="t2" name="Generate account" />
    <bpmn:task id="t3" name="Assign access" />
    <bpmn:task id="t4" name="Trigger automated billing cycles" />
    <bpmn:task id="t11" name="Settle final account balance" />
    <bpmn:task id="t7" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="g2" name="Which terms apply?" />
    <bpmn:task id="t8" name="Apply refund" />
    <bpmn:task id="t9" name="Apply charges" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="t10" name="Deactivate subscription" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-m1" sourceRef="t4" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-t5" sourceRef="m1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-g1" sourceRef="t5" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-m1" name="no" sourceRef="g1" targetRef="m1" />
    <bpmn:sequenceFlow id="f-g1-t6" name="yes" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-g2" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t8" name="refund due" sourceRef="g2" targetRef="t8" />
    <bpmn:sequenceFlow id="f-g2-t9" name="charges due" sourceRef="g2" targetRef="t9" />
    <bpmn:sequenceFlow id="f-g2-m2" name="no adjustment" sourceRef="g2" targetRef="m2" />
    <bpmn:sequenceFlow id="f-t8-m2" sourceRef="t8" targetRef="m2" />
    <bpmn:sequenceFlow id="f-t9-m2" sourceRef="t9" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-t10" sourceRef="m2" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-t11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-e" sourceRef="t11" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
