tok 1.0 "Subscription lifecycle"

pool org "Subscription service"
  lane cust "Customer"
    start s "Customer signs up"
    task t1 "Enter personal and payment information"
    xor m1
    task t5 "Receive updates and notifications"
    xor g1 "Does the customer cancel?"
    task t6 "Submit cancellation request"
    end e "Subscription closed"
  lane sys "System"
    task t2 "Generate account"
    task t3 "Assign access"
    task t4 "Trigger automated billing cycles"
    task t11 "Settle final account balance"
  lane sup "Support team"
    task t7 "Process cancellation request"
    xor g2 "Which terms apply?"
    task t8 "Apply refund"
    task t9 "Apply charges"
    xor m2
    task t10 "Deactivate subscription"

flow s -> t1 -> t2 -> t3 -> t4 -> m1 -> t5 -> g1
flow g1 -> m1 "no"
flow g1 -> t6 "yes"
flow t6 -> t7 -> g2
flow g2 -> t8 "refund due"
flow g2 -> t9 "charges due"
flow g2 -> m2 "no adjustment"
flow t8 -> m2
flow t9 -> m2
flow m2 -> t10 -> t11 -> e
