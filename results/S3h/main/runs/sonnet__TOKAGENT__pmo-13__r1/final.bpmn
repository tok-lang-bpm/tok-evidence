<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dep" name="Relevant department">
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Financial team">
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Complaint needed" />
    <bpmn:task id="file" name="File complaint" />
    <bpmn:task id="fb" name="Provide feedback" />
    <bpmn:endEvent id="e" name="Feedback given" />
    <bpmn:task id="log" name="Log complaint" />
    <bpmn:task id="assign" name="Assign complaint to department" />
    <bpmn:task id="notify" name="Notify customer of decision" />
    <bpmn:exclusiveGateway id="g" name="Refund approved?" default="f-g-m" />
    <bpmn:exclusiveGateway id="m" />
    <bpmn:task id="resolve" name="Mark complaint as resolved" />
    <bpmn:task id="investigate" name="Investigate complaint" />
    <bpmn:task id="decide" name="Determine validity and refund" />
    <bpmn:task id="refund" name="Process reimbursement" />
    <bpmn:sequenceFlow id="f-s-file" sourceRef="s" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-log" sourceRef="file" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-investigate" sourceRef="assign" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-decide" sourceRef="investigate" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-notify" sourceRef="decide" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-g" sourceRef="notify" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-refund" name="yes" sourceRef="g" targetRef="refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refundApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g-m" name="no" sourceRef="g" targetRef="m" />
    <bpmn:sequenceFlow id="f-refund-m" sourceRef="refund" targetRef="m" />
    <bpmn:sequenceFlow id="f-m-resolve" sourceRef="m" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-fb" sourceRef="resolve" targetRef="fb" />
    <bpmn:sequenceFlow id="f-fb-e" sourceRef="fb" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
