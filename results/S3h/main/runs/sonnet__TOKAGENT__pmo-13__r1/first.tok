tok 1.0 "Complaint handling"

pool org "Organisation"
  lane cust "Customer"
    start s "Complaint needed"
    task file "File complaint"
    task fb "Provide feedback"
    end e "Feedback given"
  lane cs "Customer service"
    task log "Log complaint"
    task assign "Assign complaint to department"
    task notify "Notify customer of decision"
    xor g "Refund approved?"
    xor m
    task resolve "Mark complaint as resolved"
  lane dep "Relevant department"
    task investigate "Investigate complaint"
    task decide "Determine validity and refund"
  lane fin "Financial team"
    task refund "Process reimbursement"

flow s -> file -> log -> assign -> investigate -> decide -> notify -> g
flow g -> refund "yes" when="refundApproved = true"
flow g -> m "no" default
flow refund -> m
flow m -> resolve -> fb -> e
