<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Budget planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Budget planning" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveadj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="strat" name="Strategic Review">
        <bpmn:flowNodeRef>align</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aligned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Finance Department">
        <bpmn:flowNodeRef>finrev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feasible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Budget period begins" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:task id="draft" name="Draft plan" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="adjust" name="Adjust plan" />
    <bpmn:task id="document" name="Document adjustment" />
    <bpmn:task id="approveadj" name="Approve adjustment" />
    <bpmn:task id="allocate" name="Allocate budget" />
    <bpmn:task id="distribute" name="Distribute budget" />
    <bpmn:task id="implement" name="Begin implementing plan" />
    <bpmn:endEvent id="e" name="Plan implementation begun" />
    <bpmn:task id="align" name="Review plan in strategic alignment meeting" />
    <bpmn:exclusiveGateway id="aligned" name="Aligned with goals?" default="f-aligned-adjust" />
    <bpmn:task id="finrev" name="Perform detailed review" />
    <bpmn:exclusiveGateway id="feasible" name="Budget feasible?" default="f-feasible-adjust" />
    <bpmn:task id="approve" name="Approve final budget" />
    <bpmn:sequenceFlow id="f-s-outline" sourceRef="s" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-merge" sourceRef="draft" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-align" sourceRef="merge" targetRef="align" />
    <bpmn:sequenceFlow id="f-align-aligned" sourceRef="align" targetRef="aligned" />
    <bpmn:sequenceFlow id="f-aligned-finrev" name="yes" sourceRef="aligned" targetRef="finrev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aligned = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-aligned-adjust" name="no" sourceRef="aligned" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-finrev-feasible" sourceRef="finrev" targetRef="feasible" />
    <bpmn:sequenceFlow id="f-feasible-approve" name="yes" sourceRef="feasible" targetRef="approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">feasible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-feasible-adjust" name="no" sourceRef="feasible" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjust-document" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f-document-approveadj" sourceRef="document" targetRef="approveadj" />
    <bpmn:sequenceFlow id="f-approveadj-merge" sourceRef="approveadj" targetRef="merge" />
    <bpmn:sequenceFlow id="f-approve-allocate" sourceRef="approve" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-e" sourceRef="implement" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
