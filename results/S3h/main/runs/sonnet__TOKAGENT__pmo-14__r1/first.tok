tok 1.0 "Budget planning"

pool org "Organisation"
  lane dept "Department"
    start s "Budget period begins"
    task outline "Outline objectives"
    task draft "Draft plan"
    xor merge
    task adjust "Adjust plan"
    task document "Document adjustment"
    task approveadj "Approve adjustment"
    task allocate "Allocate budget"
    task distribute "Distribute budget"
    task implement "Begin implementing plan"
    end e "Plan implementation begun"
  lane strat "Strategic Review"
    task align "Review plan in strategic alignment meeting"
    xor aligned "Aligned with goals?"
  lane fin "Finance Department"
    task finrev "Perform detailed review"
    xor feasible "Budget feasible?"
    task approve "Approve final budget"

flow s -> outline -> draft -> merge -> align -> aligned
flow aligned -> finrev "yes" when="aligned = true"
flow aligned -> adjust "no" default
flow finrev -> feasible
flow feasible -> approve "yes" when="feasible = true"
flow feasible -> adjust "no" default
flow adjust -> document -> approveadj -> merge
flow approve -> allocate -> distribute -> implement -> e
