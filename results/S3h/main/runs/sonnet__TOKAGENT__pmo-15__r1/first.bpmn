<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="internal" name="Internal teams">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gapq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Compliance audit scheduled" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="docs" name="Prepare documentation" />
    <bpmn:task id="evidence" name="Gather evidence" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="selfa" name="Conduct self-assessment" />
    <bpmn:exclusiveGateway id="corrmerge" />
    <bpmn:task id="correct" name="Make corrections and improvements" />
    <bpmn:task id="review" name="Review company processes" />
    <bpmn:task id="gaps" name="Identify gaps and issues" />
    <bpmn:exclusiveGateway id="gapq" name="Gaps found?" />
    <bpmn:exclusiveGateway id="finalmerge" />
    <bpmn:task id="final" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="met" name="All criteria met?" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="e" name="Certification issued" />
    <bpmn:sequenceFlow id="f-s-schedule" sourceRef="s" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-split" sourceRef="schedule" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-docs" sourceRef="split" targetRef="docs" />
    <bpmn:sequenceFlow id="f-split-evidence" sourceRef="split" targetRef="evidence" />
    <bpmn:sequenceFlow id="f-docs-join" sourceRef="docs" targetRef="join" />
    <bpmn:sequenceFlow id="f-evidence-join" sourceRef="evidence" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-selfa" sourceRef="join" targetRef="selfa" />
    <bpmn:sequenceFlow id="f-selfa-review" sourceRef="selfa" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-gaps" sourceRef="review" targetRef="gaps" />
    <bpmn:sequenceFlow id="f-gaps-gapq" sourceRef="gaps" targetRef="gapq" />
    <bpmn:sequenceFlow id="f-gapq-corrmerge" name="yes" sourceRef="gapq" targetRef="corrmerge" />
    <bpmn:sequenceFlow id="f-gapq-finalmerge" name="no" sourceRef="gapq" targetRef="finalmerge" />
    <bpmn:sequenceFlow id="f-corrmerge-correct" sourceRef="corrmerge" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-finalmerge" sourceRef="correct" targetRef="finalmerge" />
    <bpmn:sequenceFlow id="f-finalmerge-final" sourceRef="finalmerge" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-met" sourceRef="final" targetRef="met" />
    <bpmn:sequenceFlow id="f-met-award" name="yes" sourceRef="met" targetRef="award" />
    <bpmn:sequenceFlow id="f-met-corrmerge" name="no" sourceRef="met" targetRef="corrmerge" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-e" sourceRef="issue" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
