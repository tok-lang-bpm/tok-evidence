tok 1.0 "Compliance audit"

pool org "Company"
  lane internal "Internal teams"
    start s "Compliance audit scheduled"
    task schedule "Schedule compliance audit"
    and split
    task docs "Prepare documentation"
    task evidence "Gather evidence"
    and join
    task selfa "Conduct self-assessment"
    xor corrmerge
    task correct "Make corrections and improvements"
  lane auditors "Auditors"
    task review "Review company processes"
    task gaps "Identify gaps and issues"
    xor gapq "Gaps found?"
    xor finalmerge
    task final "Conduct final audit"
    xor met "All criteria met?"
    task award "Award certification"
    task issue "Issue official documents"
    end e "Certification issued"

flow s -> schedule -> split
flow split -> docs
flow split -> evidence
flow docs -> join
flow evidence -> join
flow join -> selfa -> review -> gaps -> gapq
flow gapq -> corrmerge "yes"
flow gapq -> finalmerge "no"
flow corrmerge -> correct -> finalmerge -> final -> met
flow met -> award "yes"
flow met -> corrmerge "no"
flow award -> issue -> e
