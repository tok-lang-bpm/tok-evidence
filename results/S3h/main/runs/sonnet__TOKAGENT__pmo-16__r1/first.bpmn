<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Annual audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Multinational company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Annual audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Audit coordinator">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="region" name="Regional office">
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="comp" name="Compliance team">
        <bpmn:flowNodeRef>regs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit" name="Central audit team">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqclar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cmp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>da</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>svj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h1j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dir" name="Audit director">
        <bpmn:flowNodeRef>rev2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Audit started" />
    <bpmn:task id="notify" name="Send notification to regional office" />
    <bpmn:endEvent id="e" name="Audit process closed" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:task id="prep" name="Prepare financial statements" />
    <bpmn:task id="gather" name="Gather necessary documents" />
    <bpmn:parallelGateway id="p1j" />
    <bpmn:task id="submit" name="Submit documents to central audit team" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:task id="regs" name="Check regulatory updates" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="review" name="Review submission" />
    <bpmn:exclusiveGateway id="d1" name="Discrepancies found?" default="f-d1-risk" />
    <bpmn:task id="reqclar" name="Request clarifications" />
    <bpmn:task id="risk" name="Conduct risk assessment" />
    <bpmn:parallelGateway id="r1" />
    <bpmn:task id="fin" name="Evaluate financial risks" />
    <bpmn:task id="ops" name="Evaluate operational risks" />
    <bpmn:task id="cmp" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="r1j" />
    <bpmn:exclusiveGateway id="h1" name="High risk identified?" default="f-h1-h1j" />
    <bpmn:task id="inv" name="Launch detailed investigation" />
    <bpmn:parallelGateway id="i1" />
    <bpmn:task id="da" name="Perform data analysis" />
    <bpmn:task id="iv" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="sv" name="Site visit needed?" default="f-sv-svj" />
    <bpmn:task id="visit" name="Conduct site visit" />
    <bpmn:exclusiveGateway id="svj" />
    <bpmn:parallelGateway id="i1j" />
    <bpmn:exclusiveGateway id="h1j" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="compile" name="Compile audit report" />
    <bpmn:task id="revise" name="Update report" />
    <bpmn:parallelGateway id="f1" />
    <bpmn:task id="distribute" name="Distribute final report to executive board" />
    <bpmn:task id="archive" name="Archive final report" />
    <bpmn:parallelGateway id="f1j" />
    <bpmn:task id="rev2" name="Review audit report" />
    <bpmn:exclusiveGateway id="a1" name="Report approved?" default="f-a1-f1" />
    <bpmn:sequenceFlow id="f-s-notify" sourceRef="s" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-p1" sourceRef="notify" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-prep" sourceRef="p1" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-gather" sourceRef="prep" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-p1j" sourceRef="gather" targetRef="p1j" />
    <bpmn:sequenceFlow id="f-p1-regs" sourceRef="p1" targetRef="regs" />
    <bpmn:sequenceFlow id="f-regs-p1j" sourceRef="regs" targetRef="p1j" />
    <bpmn:sequenceFlow id="f-p1j-submit" sourceRef="p1j" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-m1" sourceRef="submit" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-review" sourceRef="m1" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-d1" sourceRef="review" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-reqclar" name="yes" sourceRef="d1" targetRef="reqclar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">discrepancies = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-d1-risk" name="no" sourceRef="d1" targetRef="risk" />
    <bpmn:sequenceFlow id="f-reqclar-clarify" sourceRef="reqclar" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-m1" sourceRef="clarify" targetRef="m1" />
    <bpmn:sequenceFlow id="f-risk-r1" sourceRef="risk" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-fin" sourceRef="r1" targetRef="fin" />
    <bpmn:sequenceFlow id="f-fin-r1j" sourceRef="fin" targetRef="r1j" />
    <bpmn:sequenceFlow id="f-r1-ops" sourceRef="r1" targetRef="ops" />
    <bpmn:sequenceFlow id="f-ops-r1j" sourceRef="ops" targetRef="r1j" />
    <bpmn:sequenceFlow id="f-r1-cmp" sourceRef="r1" targetRef="cmp" />
    <bpmn:sequenceFlow id="f-cmp-r1j" sourceRef="cmp" targetRef="r1j" />
    <bpmn:sequenceFlow id="f-r1j-h1" sourceRef="r1j" targetRef="h1" />
    <bpmn:sequenceFlow id="f-h1-inv" name="yes" sourceRef="h1" targetRef="inv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">highRisk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-h1-h1j" name="no" sourceRef="h1" targetRef="h1j" />
    <bpmn:sequenceFlow id="f-inv-i1" sourceRef="inv" targetRef="i1" />
    <bpmn:sequenceFlow id="f-i1-da" sourceRef="i1" targetRef="da" />
    <bpmn:sequenceFlow id="f-da-i1j" sourceRef="da" targetRef="i1j" />
    <bpmn:sequenceFlow id="f-i1-iv" sourceRef="i1" targetRef="iv" />
    <bpmn:sequenceFlow id="f-iv-i1j" sourceRef="iv" targetRef="i1j" />
    <bpmn:sequenceFlow id="f-i1-sv" sourceRef="i1" targetRef="sv" />
    <bpmn:sequenceFlow id="f-sv-visit" name="yes" sourceRef="sv" targetRef="visit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">siteVisit = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sv-svj" name="no" sourceRef="sv" targetRef="svj" />
    <bpmn:sequenceFlow id="f-visit-svj" sourceRef="visit" targetRef="svj" />
    <bpmn:sequenceFlow id="f-svj-i1j" sourceRef="svj" targetRef="i1j" />
    <bpmn:sequenceFlow id="f-i1j-h1j" sourceRef="i1j" targetRef="h1j" />
    <bpmn:sequenceFlow id="f-h1j-compile" sourceRef="h1j" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compile-m2" sourceRef="compile" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-rev2" sourceRef="m2" targetRef="rev2" />
    <bpmn:sequenceFlow id="f-rev2-a1" sourceRef="rev2" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-revise" name="no" sourceRef="a1" targetRef="revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-a1-f1" name="yes" sourceRef="a1" targetRef="f1" />
    <bpmn:sequenceFlow id="f-revise-m2" sourceRef="revise" targetRef="m2" />
    <bpmn:sequenceFlow id="f-f1-distribute" sourceRef="f1" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-f1j" sourceRef="distribute" targetRef="f1j" />
    <bpmn:sequenceFlow id="f-f1-archive" sourceRef="f1" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-f1j" sourceRef="archive" targetRef="f1j" />
    <bpmn:sequenceFlow id="f-f1j-e" sourceRef="f1j" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
