<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="E-commerce company" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="sys" name="Order system">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recvbo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stockmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updinv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retlabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recvret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wh" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftmerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ship" name="Shipping department">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Order placed" />
    <bpmn:task id="record" name="Record order details" />
    <bpmn:task id="pay" name="Process payment" />
    <bpmn:exclusiveGateway id="payok" name="Payment successful?" default="f-payok-notifyfail" />
    <bpmn:task id="notifyfail" name="Notify customer about failed payment" />
    <bpmn:endEvent id="e1" name="Order cancelled" />
    <bpmn:task id="stock" name="Check stock availability" />
    <bpmn:exclusiveGateway id="instock" name="Items in stock?" default="f-instock-backorder" />
    <bpmn:task id="backorder" name="Initiate back-order" />
    <bpmn:task id="delay" name="Inform customer about delay" />
    <bpmn:receiveTask id="recvbo" name="Receive back-order" />
    <bpmn:exclusiveGateway id="stockmerge" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="dispatch" name="Dispatch order" />
    <bpmn:task id="confirm" name="Send shipping confirmation" />
    <bpmn:task id="updinv" name="Update inventory levels" />
    <bpmn:task id="deliv" name="Confirm successful delivery" />
    <bpmn:exclusiveGateway id="issues" name="Customer reports issues?" default="f-issues-feedback" />
    <bpmn:task id="feedback" name="Send follow-up feedback email" />
    <bpmn:endEvent id="e2" name="Order completed" />
    <bpmn:task id="retlabel" name="Send return shipping label" />
    <bpmn:task id="recvret" name="Receive returned items" />
    <bpmn:task id="inspect" name="Inspect returned items" />
    <bpmn:task id="refund" name="Process refund or replacement" />
    <bpmn:endEvent id="e3" name="Return handled" />
    <bpmn:task id="pick" name="Pick items from warehouse" />
    <bpmn:task id="qc" name="Perform quality control checks" />
    <bpmn:task id="pack" name="Package order" />
    <bpmn:exclusiveGateway id="gift" name="Gift wrapping requested?" default="f-gift-giftmerge" />
    <bpmn:task id="wrap" name="Wrap gift" />
    <bpmn:exclusiveGateway id="giftmerge" />
    <bpmn:task id="docs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" default="f-intl-intlmerge" />
    <bpmn:task id="customs" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="intlmerge" />
    <bpmn:sequenceFlow id="f-s1-record" sourceRef="s1" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-pay" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-payok" sourceRef="pay" targetRef="payok" />
    <bpmn:sequenceFlow id="f-payok-notifyfail" name="no" sourceRef="payok" targetRef="notifyfail" />
    <bpmn:sequenceFlow id="f-payok-stock" name="yes" sourceRef="payok" targetRef="stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-notifyfail-e1" sourceRef="notifyfail" targetRef="e1" />
    <bpmn:sequenceFlow id="f-stock-instock" sourceRef="stock" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-backorder" name="no" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-instock-stockmerge" name="yes" sourceRef="instock" targetRef="stockmerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">inStock = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-backorder-delay" sourceRef="backorder" targetRef="delay" />
    <bpmn:sequenceFlow id="f-delay-recvbo" sourceRef="delay" targetRef="recvbo" />
    <bpmn:sequenceFlow id="f-recvbo-stockmerge" sourceRef="recvbo" targetRef="stockmerge" />
    <bpmn:sequenceFlow id="f-stockmerge-fork" sourceRef="stockmerge" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-pick" sourceRef="fork" targetRef="pick" />
    <bpmn:sequenceFlow id="f-fork-docs" sourceRef="fork" targetRef="docs" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-pack" sourceRef="qc" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-gift" sourceRef="pack" targetRef="gift" />
    <bpmn:sequenceFlow id="f-gift-wrap" name="yes" sourceRef="gift" targetRef="wrap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">giftWrap = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-gift-giftmerge" name="no" sourceRef="gift" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f-wrap-giftmerge" sourceRef="wrap" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f-giftmerge-join" sourceRef="giftmerge" targetRef="join" />
    <bpmn:sequenceFlow id="f-docs-intl" sourceRef="docs" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-customs" name="yes" sourceRef="intl" targetRef="customs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-intl-intlmerge" name="no" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-customs-intlmerge" sourceRef="customs" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intlmerge-join" sourceRef="intlmerge" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-dispatch" sourceRef="join" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-confirm" sourceRef="dispatch" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-updinv" sourceRef="confirm" targetRef="updinv" />
    <bpmn:sequenceFlow id="f-updinv-deliv" sourceRef="updinv" targetRef="deliv" />
    <bpmn:sequenceFlow id="f-deliv-issues" sourceRef="deliv" targetRef="issues" />
    <bpmn:sequenceFlow id="f-issues-retlabel" name="yes" sourceRef="issues" targetRef="retlabel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">issuesReported = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-issues-feedback" name="no" sourceRef="issues" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-e2" sourceRef="feedback" targetRef="e2" />
    <bpmn:sequenceFlow id="f-retlabel-recvret" sourceRef="retlabel" targetRef="recvret" />
    <bpmn:sequenceFlow id="f-recvret-inspect" sourceRef="recvret" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-refund" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-e3" sourceRef="refund" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
