<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Enrollment_confirmation" name="Enrollment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="uni" name="University" processRef="uni-process" />
  </bpmn:collaboration>
  <bpmn:process id="uni-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="uni-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>idcard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chgm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grvm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>semm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="adm" name="Admissions office">
        <bpmn:flowNodeRef>revapp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="com" name="Admissions committee">
        <bpmn:flowNodeRef>eval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Finance department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT department">
        <bpmn:flowNodeRef>accts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="intl" name="International student office">
        <bpmn:flowNodeRef>intq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="adv" name="Academic advisor">
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appc" name="Appeals committee">
        <bpmn:flowNodeRef>meetapp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Application needed" />
    <bpmn:task id="submit" name="Submit application online" />
    <bpmn:task id="provide" name="Provide missing items" />
    <bpmn:eventBasedGateway id="conf" name="Confirmation by deadline?" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Enrollment confirmed">
      <bpmn:messageEventDefinition id="confirmed-def" messageRef="Message_Enrollment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="deadline" name="Deadline passed">
      <bpmn:timerEventDefinition id="deadline-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="idcard" name="Obtain student ID card" />
    <bpmn:task id="attend" name="Begin attending classes" />
    <bpmn:exclusiveGateway id="chg" name="Change courses?" default="f-chg-chgm" />
    <bpmn:task id="adddrop" name="Add or drop courses" />
    <bpmn:exclusiveGateway id="chgm" />
    <bpmn:task id="review" name="Review grades online" />
    <bpmn:exclusiveGateway id="grv" name="Grievances?" default="f-grv-grvm" />
    <bpmn:task id="form" name="Submit appeal form" />
    <bpmn:task id="await" name="Await appeal decision" />
    <bpmn:exclusiveGateway id="grvm" />
    <bpmn:exclusiveGateway id="semm" />
    <bpmn:exclusiveGateway id="done" name="Graduated or withdrawn?" default="f-done-semm" />
    <bpmn:endEvent id="e3" name="Process ends" />
    <bpmn:task id="revapp" name="Review application and documents" />
    <bpmn:exclusiveGateway id="docs" name="Documents complete?" default="f-docs-split1" />
    <bpmn:task id="notify" name="Notify applicant of missing items" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:exclusiveGateway id="acc" name="Application accepted?" default="f-acc-accl" />
    <bpmn:task id="accl" name="Send acceptance letter" />
    <bpmn:task id="rejl" name="Send rejection letter" />
    <bpmn:endEvent id="e1" name="Application rejected" />
    <bpmn:task id="cancel" name="Cancel application" />
    <bpmn:endEvent id="e2" name="Application canceled" />
    <bpmn:task id="orient" name="Send orientation materials" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="post" name="Post grades" />
    <bpmn:task id="eval" name="Evaluate application" />
    <bpmn:task id="fees" name="Process application fees or waivers" />
    <bpmn:task id="accts" name="Set up student accounts" />
    <bpmn:exclusiveGateway id="intq" name="International student?" default="f-intq-intm" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="intm" />
    <bpmn:task id="meet" name="Meet with academic advisor" />
    <bpmn:task id="select" name="Select courses" />
    <bpmn:task id="resolve" name="Resolve schedule conflicts" />
    <bpmn:task id="meetapp" name="Meet with appeals committee" />
    <bpmn:sequenceFlow id="f-s-submit" sourceRef="s" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-revapp" sourceRef="submit" targetRef="revapp" />
    <bpmn:sequenceFlow id="f-revapp-docs" sourceRef="revapp" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-notify" name="no" sourceRef="docs" targetRef="notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-docs-split1" name="yes" sourceRef="docs" targetRef="split1" />
    <bpmn:sequenceFlow id="f-notify-provide" sourceRef="notify" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-revapp" sourceRef="provide" targetRef="revapp" />
    <bpmn:sequenceFlow id="f-split1-eval" sourceRef="split1" targetRef="eval" />
    <bpmn:sequenceFlow id="f-split1-fees" sourceRef="split1" targetRef="fees" />
    <bpmn:sequenceFlow id="f-eval-join1" sourceRef="eval" targetRef="join1" />
    <bpmn:sequenceFlow id="f-fees-join1" sourceRef="fees" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-acc" sourceRef="join1" targetRef="acc" />
    <bpmn:sequenceFlow id="f-acc-accl" name="yes" sourceRef="acc" targetRef="accl" />
    <bpmn:sequenceFlow id="f-acc-rejl" name="no" sourceRef="acc" targetRef="rejl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rejl-e1" sourceRef="rejl" targetRef="e1" />
    <bpmn:sequenceFlow id="f-accl-conf" sourceRef="accl" targetRef="conf" />
    <bpmn:sequenceFlow id="f-conf-confirmed" sourceRef="conf" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-conf-deadline" sourceRef="conf" targetRef="deadline" />
    <bpmn:sequenceFlow id="f-deadline-cancel" sourceRef="deadline" targetRef="cancel" />
    <bpmn:sequenceFlow id="f-cancel-e2" sourceRef="cancel" targetRef="e2" />
    <bpmn:sequenceFlow id="f-confirmed-split2" sourceRef="confirmed" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-orient" sourceRef="split2" targetRef="orient" />
    <bpmn:sequenceFlow id="f-split2-accts" sourceRef="split2" targetRef="accts" />
    <bpmn:sequenceFlow id="f-split2-intq" sourceRef="split2" targetRef="intq" />
    <bpmn:sequenceFlow id="f-intq-visa" name="yes" sourceRef="intq" targetRef="visa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-intq-intm" name="no" sourceRef="intq" targetRef="intm" />
    <bpmn:sequenceFlow id="f-visa-intm" sourceRef="visa" targetRef="intm" />
    <bpmn:sequenceFlow id="f-orient-join2" sourceRef="orient" targetRef="join2" />
    <bpmn:sequenceFlow id="f-accts-join2" sourceRef="accts" targetRef="join2" />
    <bpmn:sequenceFlow id="f-intm-join2" sourceRef="intm" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-idcard" sourceRef="join2" targetRef="idcard" />
    <bpmn:sequenceFlow id="f-idcard-meet" sourceRef="idcard" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-select" sourceRef="meet" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-resolve" sourceRef="select" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-semm" sourceRef="resolve" targetRef="semm" />
    <bpmn:sequenceFlow id="f-semm-attend" sourceRef="semm" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-chg" sourceRef="attend" targetRef="chg" />
    <bpmn:sequenceFlow id="f-chg-adddrop" name="yes" sourceRef="chg" targetRef="adddrop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">changeCourses = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-chg-chgm" name="no" sourceRef="chg" targetRef="chgm" />
    <bpmn:sequenceFlow id="f-adddrop-chgm" sourceRef="adddrop" targetRef="chgm" />
    <bpmn:sequenceFlow id="f-chgm-post" sourceRef="chgm" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-review" sourceRef="post" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-grv" sourceRef="review" targetRef="grv" />
    <bpmn:sequenceFlow id="f-grv-form" name="yes" sourceRef="grv" targetRef="form">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-grv-grvm" name="no" sourceRef="grv" targetRef="grvm" />
    <bpmn:sequenceFlow id="f-form-meetapp" sourceRef="form" targetRef="meetapp" />
    <bpmn:sequenceFlow id="f-meetapp-await" sourceRef="meetapp" targetRef="await" />
    <bpmn:sequenceFlow id="f-await-grvm" sourceRef="await" targetRef="grvm" />
    <bpmn:sequenceFlow id="f-grvm-done" sourceRef="grvm" targetRef="done" />
    <bpmn:sequenceFlow id="f-done-e3" name="yes" sourceRef="done" targetRef="e3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">graduatedOrWithdrawn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-done-semm" name="no" sourceRef="done" targetRef="semm" />
  </bpmn:process>
</bpmn:definitions>
