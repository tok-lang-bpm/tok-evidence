<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Online shop purchase" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Online shop purchase" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paynow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Shop">
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order needed" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="f1" />
    <bpmn:task id="select" name="Select items" />
    <bpmn:task id="reward" name="Choose free reward" />
    <bpmn:task id="method" name="Set payment method" />
    <bpmn:exclusiveGateway id="pay" name="Pay or installment?" default="f-pay-inst" />
    <bpmn:task id="paynow" name="Pay" />
    <bpmn:task id="inst" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="pj" />
    <bpmn:parallelGateway id="j1" />
    <bpmn:task id="ret" name="Return items for exchange" />
    <bpmn:endEvent id="e" name="Order completed" />
    <bpmn:exclusiveGateway id="m" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="again" name="Items returned?" default="f-again-e" />
    <bpmn:sequenceFlow id="f-s-login" sourceRef="s" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-f1" sourceRef="login" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-select" sourceRef="f1" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-reward" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f-reward-j1" sourceRef="reward" targetRef="j1" />
    <bpmn:sequenceFlow id="f-f1-method" sourceRef="f1" targetRef="method" />
    <bpmn:sequenceFlow id="f-method-pay" sourceRef="method" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-paynow" name="pay" sourceRef="pay" targetRef="paynow">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">payNow = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pay-inst" name="installment" sourceRef="pay" targetRef="inst" />
    <bpmn:sequenceFlow id="f-paynow-pj" sourceRef="paynow" targetRef="pj" />
    <bpmn:sequenceFlow id="f-inst-pj" sourceRef="inst" targetRef="pj" />
    <bpmn:sequenceFlow id="f-pj-j1" sourceRef="pj" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-m" sourceRef="j1" targetRef="m" />
    <bpmn:sequenceFlow id="f-m-deliver" sourceRef="m" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-again" sourceRef="deliver" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-ret" name="yes" sourceRef="again" targetRef="ret">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">returned = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-again-e" name="no" sourceRef="again" targetRef="e" />
    <bpmn:sequenceFlow id="f-ret-m" sourceRef="ret" targetRef="m" />
  </bpmn:process>
</bpmn:definitions>
