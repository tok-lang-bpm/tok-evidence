tok 1.0 "Online shop purchase"

pool shop "Online shop"
  lane user "User"
    start s "Order needed"
    task login "Log in to account"
    and f1
    task select "Select items"
    task reward "Choose free reward"
    task method "Set payment method"
    xor pay "Pay or installment?"
    task paynow "Pay"
    task inst "Complete installment agreement"
    xor pj
    and j1
    task ret "Return items for exchange"
    end e "Order completed"
  lane sys "Shop"
    xor m
    task deliver "Deliver items"
    xor again "Items returned?"

flow s -> login -> f1
flow f1 -> select -> reward -> j1
flow f1 -> method -> pay
flow pay -> paynow "pay" when="payNow = true"
flow pay -> inst "installment" default
flow paynow -> pj
flow inst -> pj
flow pj -> j1
flow j1 -> m -> deliver -> again
flow again -> ret "yes" when="returned = true"
flow again -> e "no" default
flow ret -> m
