<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Goods shipping" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Goods shipping" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sec" name="Secretary">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>big</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Logistics department head">
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wh" name="Warehousemen">
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:parallelGateway id="sp" />
    <bpmn:exclusiveGateway id="big" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one logistic company" />
    <bpmn:task id="label" name="Write package label" />
    <bpmn:exclusiveGateway id="ins" name="Parcel insurance necessary?" />
    <bpmn:exclusiveGateway id="j2" />
    <bpmn:exclusiveGateway id="j1" />
    <bpmn:parallelGateway id="jp" />
    <bpmn:task id="prepare" name="Prepare packaged goods for pick up" />
    <bpmn:endEvent id="e" name="Goods ready for pick up" />
    <bpmn:task id="insure" name="Take parcel insurance" />
    <bpmn:task id="pack" name="Package goods" />
    <bpmn:sequenceFlow id="f-s-clarify" sourceRef="s" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-sp" sourceRef="clarify" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-big" sourceRef="sp" targetRef="big" />
    <bpmn:sequenceFlow id="f-sp-pack" sourceRef="sp" targetRef="pack" />
    <bpmn:sequenceFlow id="f-big-invite" name="yes" sourceRef="big" targetRef="invite" />
    <bpmn:sequenceFlow id="f-big-label" name="no" sourceRef="big" targetRef="label" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-j1" sourceRef="select" targetRef="j1" />
    <bpmn:sequenceFlow id="f-label-ins" sourceRef="label" targetRef="ins" />
    <bpmn:sequenceFlow id="f-ins-insure" name="yes" sourceRef="ins" targetRef="insure" />
    <bpmn:sequenceFlow id="f-ins-j2" name="no" sourceRef="ins" targetRef="j2" />
    <bpmn:sequenceFlow id="f-insure-j2" sourceRef="insure" targetRef="j2" />
    <bpmn:sequenceFlow id="f-j2-j1" sourceRef="j2" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-jp" sourceRef="j1" targetRef="jp" />
    <bpmn:sequenceFlow id="f-pack-jp" sourceRef="pack" targetRef="jp" />
    <bpmn:sequenceFlow id="f-jp-prepare" sourceRef="jp" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-e" sourceRef="prepare" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
