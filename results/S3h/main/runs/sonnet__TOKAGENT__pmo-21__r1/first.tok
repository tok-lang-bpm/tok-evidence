tok 1.0 "Goods shipping"

pool org "Organisation"
  lane sec "Secretary"
    start s "Goods shall be shipped"
    task clarify "Clarify who will do the shipping"
    and sp
    xor big "Large amounts?"
    task invite "Invite three logistic companies to make offers"
    task select "Select one logistic company"
    task label "Write package label"
    xor ins "Parcel insurance necessary?"
    xor j1
    and jp
    task prepare "Prepare packaged goods for pick up"
    end e "Goods ready for pick up"
  lane head "Logistics department head"
    task insure "Take parcel insurance"
  lane wh "Warehousemen"
    task pack "Package goods"

flow s -> clarify -> sp
flow sp -> big
flow sp -> pack
flow big -> invite "yes"
flow big -> label "no"
flow invite -> select -> j1
flow label -> ins
flow ins -> insure "yes"
flow ins -> j2 "no"
flow insure -> j2
flow j2 -> j1
flow j1 -> jp
flow pack -> jp
flow jp -> prepare -> e
