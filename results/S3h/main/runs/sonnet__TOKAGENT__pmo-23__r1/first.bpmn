<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Banking system">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ag" name="Agency">
        <bpmn:flowNodeRef>q1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Scoring needed" />
    <bpmn:task id="req" name="Request credit scoring" />
    <bpmn:task id="view" name="View scoring result" />
    <bpmn:endEvent id="e" name="Result seen" />
    <bpmn:task id="send" name="Send scoring request to agency" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="show" name="Present result to clerk" />
    <bpmn:task id="msg" name="Display delay message to clerk" />
    <bpmn:parallelGateway id="j" />
    <bpmn:task id="q1" name="Do quick scoring (level 1)" />
    <bpmn:exclusiveGateway id="g" name="Result determined immediately?" />
    <bpmn:task id="ret" name="Return result to banking system" />
    <bpmn:task id="inf" name="Inform banking process of delay" />
    <bpmn:parallelGateway id="sp" />
    <bpmn:task id="q2" name="Do level 2 scoring" />
    <bpmn:task id="back" name="Send result to banking process" />
    <bpmn:sequenceFlow id="f-s-req" sourceRef="s" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-send" sourceRef="req" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-q1" sourceRef="send" targetRef="q1" />
    <bpmn:sequenceFlow id="f-q1-g" sourceRef="q1" targetRef="g" />
    <bpmn:sequenceFlow id="f-g-ret" name="yes" sourceRef="g" targetRef="ret" />
    <bpmn:sequenceFlow id="f-g-inf" name="no" sourceRef="g" targetRef="inf" />
    <bpmn:sequenceFlow id="f-ret-m1" sourceRef="ret" targetRef="m1" />
    <bpmn:sequenceFlow id="f-inf-sp" sourceRef="inf" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-msg" sourceRef="sp" targetRef="msg" />
    <bpmn:sequenceFlow id="f-sp-q2" sourceRef="sp" targetRef="q2" />
    <bpmn:sequenceFlow id="f-q2-back" sourceRef="q2" targetRef="back" />
    <bpmn:sequenceFlow id="f-msg-j" sourceRef="msg" targetRef="j" />
    <bpmn:sequenceFlow id="f-back-j" sourceRef="back" targetRef="j" />
    <bpmn:sequenceFlow id="f-j-m1" sourceRef="j" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-show" sourceRef="m1" targetRef="show" />
    <bpmn:sequenceFlow id="f-show-view" sourceRef="show" targetRef="view" />
    <bpmn:sequenceFlow id="f-view-e" sourceRef="view" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
