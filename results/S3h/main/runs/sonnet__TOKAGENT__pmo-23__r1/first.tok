tok 1.0 "Credit scoring"

pool bank "Bank"
  lane clerk "Sales clerk"
    start s "Scoring needed"
    task req "Request credit scoring"
    task view "View scoring result"
    end e "Result seen"
  lane sys "Banking system"
    task send "Send scoring request to agency"
    xor m1 
    task show "Present result to clerk"
    task msg "Display delay message to clerk"
    and j
  lane ag "Agency"
    task q1 "Do quick scoring (level 1)"
    xor g "Result determined immediately?"
    task ret "Return result to banking system"
    task inf "Inform banking process of delay"
    and sp
    task q2 "Do level 2 scoring"
    task back "Send result to banking process"

flow s -> req -> send -> q1 -> g
flow g -> ret "yes"
flow g -> inf "no"
flow ret -> m1
flow inf -> sp
flow sp -> msg
flow sp -> q2
flow q2 -> back
flow msg -> j
flow back -> j
flow j -> m1
flow m1 -> show -> view -> e
