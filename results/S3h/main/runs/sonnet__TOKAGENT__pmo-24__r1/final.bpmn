<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Restaurant" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="rest" name="Restaurant" processRef="rest-process" />
  </bpmn:collaboration>
  <bpmn:process id="rest-process" name="Restaurant" isExecutable="false">
    <bpmn:laneSet id="rest-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="emp" name="Employee">
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>money</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setbuzz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passbuzz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informchef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informemp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Guest feels hungry" />
    <bpmn:task id="choose" name="Choose dish" />
    <bpmn:task id="wait" name="Wait for turn" />
    <bpmn:task id="order" name="Place order" />
    <bpmn:task id="pickup" name="Pick up meal" />
    <bpmn:task id="eat" name="Eat meal" />
    <bpmn:endEvent id="e" name="Meal eaten" />
    <bpmn:task id="enter" name="Enter order into POS system" />
    <bpmn:task id="money" name="Collect money from guest" />
    <bpmn:task id="setbuzz" name="Set up buzzer" />
    <bpmn:task id="passbuzz" name="Pass buzzer on to guest" />
    <bpmn:task id="informchef" name="Inform chef of new meal order" />
    <bpmn:task id="ring" name="Set off guest's buzzer" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:exclusiveGateway id="g1" name="Guest at service hatch?" />
    <bpmn:intermediateCatchEvent id="t5" name="5 minutes passed">
      <bpmn:timerEventDefinition id="t5-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="call" name="Call for guest" />
    <bpmn:task id="hand" name="Hand over meal" />
    <bpmn:task id="prep" name="Prepare meal" />
    <bpmn:task id="hatch" name="Place meal in service hatch" />
    <bpmn:task id="informemp" name="Inform employee that meal is in service hatch" />
    <bpmn:sequenceFlow id="f-s-choose" sourceRef="s" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait" sourceRef="choose" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-order" sourceRef="wait" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-enter" sourceRef="order" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-money" sourceRef="enter" targetRef="money" />
    <bpmn:sequenceFlow id="f-money-setbuzz" sourceRef="money" targetRef="setbuzz" />
    <bpmn:sequenceFlow id="f-setbuzz-passbuzz" sourceRef="setbuzz" targetRef="passbuzz" />
    <bpmn:sequenceFlow id="f-passbuzz-informchef" sourceRef="passbuzz" targetRef="informchef" />
    <bpmn:sequenceFlow id="f-informchef-prep" sourceRef="informchef" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-hatch" sourceRef="prep" targetRef="hatch" />
    <bpmn:sequenceFlow id="f-hatch-informemp" sourceRef="hatch" targetRef="informemp" />
    <bpmn:sequenceFlow id="f-informemp-ring" sourceRef="informemp" targetRef="ring" />
    <bpmn:sequenceFlow id="f-ring-m1" sourceRef="ring" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-g1" sourceRef="m1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-hand" name="yes" sourceRef="g1" targetRef="hand" />
    <bpmn:sequenceFlow id="f-g1-t5" name="no" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-call" sourceRef="t5" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-m1" sourceRef="call" targetRef="m1" />
    <bpmn:sequenceFlow id="f-hand-pickup" sourceRef="hand" targetRef="pickup" />
    <bpmn:sequenceFlow id="f-pickup-eat" sourceRef="pickup" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-e" sourceRef="eat" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
