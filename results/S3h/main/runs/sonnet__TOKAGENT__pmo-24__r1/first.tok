tok 1.0 "Restaurant"

pool rest "Restaurant"
  lane guest "Guest"
    start s "Guest feels hungry"
    task choose "Choose dish"
    task wait "Wait for turn"
    task order "Place order"
    task pickup "Pick up meal"
    task eat "Eat meal"
    end e "Meal eaten"
  lane emp "Employee"
    task enter "Enter order into POS system"
    task money "Collect money from guest"
    task setbuzz "Set up buzzer"
    task passbuzz "Pass buzzer on to guest"
    task informchef "Inform chef of new meal order"
    task ring "Set off guest's buzzer"
    xor m1
    xor g1 "Guest at service hatch?"
    catch t5 "5 minutes passed" timer=PT5M
    task call "Call for guest"
    task hand "Hand over meal"
  lane chef "Chef"
    task prep "Prepare meal"
    task hatch "Place meal in service hatch"
    task informemp "Inform employee that meal is in service hatch"

flow s -> choose -> wait -> order -> enter -> money -> setbuzz -> passbuzz -> informchef -> prep -> hatch -> informemp -> ring -> m1 -> g1
flow g1 -> hand "yes"
flow g1 -> t5 "no"
flow t5 -> call -> m1
flow hand -> pickup -> eat -> e
