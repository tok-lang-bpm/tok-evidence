<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Job search" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ratec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateapp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>year</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="write" name="Write job application" />
    <bpmn:parallelGateway id="a1" />
    <bpmn:task id="report" name="Report job applications" />
    <bpmn:parallelGateway id="a2" />
    <bpmn:exclusiveGateway id="d1" name="Interview wanted?" />
    <bpmn:task id="negotiate" name="Negotiate job interview" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:exclusiveGateway id="d2" name="Company wants you?" />
    <bpmn:task id="probation" name="Enter probation phase" />
    <bpmn:parallelGateway id="a3" />
    <bpmn:task id="ratec" name="Rate company" />
    <bpmn:parallelGateway id="a4" />
    <bpmn:exclusiveGateway id="d3" name="Job permanent?" />
    <bpmn:exclusiveGateway id="d4" name="Rated company C or less?" />
    <bpmn:endEvent id="e1" name="Process ends" />
    <bpmn:endEvent id="e2" name="Application rejected" />
    <bpmn:endEvent id="e3" name="Process ends, offers continue" />
    <bpmn:endEvent id="e4" name="Not made permanent" />
    <bpmn:task id="confirm" name="Confirm receipt of job application" />
    <bpmn:task id="rate" name="Rate job application" />
    <bpmn:task id="rateapp" name="Rate applicant" />
    <bpmn:task id="offers" name="Send potential job offers" />
    <bpmn:intermediateCatchEvent id="year" name="1 year passed">
      <bpmn:timerEventDefinition id="year-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="review" name="Show company review to applicants" />
    <bpmn:task id="more" name="Send job offers" />
    <bpmn:sequenceFlow id="f-s-write" sourceRef="s" targetRef="write" />
    <bpmn:sequenceFlow id="f-write-a1" sourceRef="write" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-report" sourceRef="a1" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-offers" sourceRef="report" targetRef="offers" />
    <bpmn:sequenceFlow id="f-offers-a2" sourceRef="offers" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a1-confirm" sourceRef="a1" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-a2" sourceRef="rate" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-d1" sourceRef="a2" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-negotiate" name="yes" sourceRef="d1" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-d1-m2" name="no" sourceRef="d1" targetRef="m2" />
    <bpmn:sequenceFlow id="f-negotiate-m2" sourceRef="negotiate" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-d2" sourceRef="m2" targetRef="d2" />
    <bpmn:sequenceFlow id="f-d2-probation" name="yes" sourceRef="d2" targetRef="probation" />
    <bpmn:sequenceFlow id="f-d2-e2" name="no" sourceRef="d2" targetRef="e2" />
    <bpmn:sequenceFlow id="f-probation-a3" sourceRef="probation" targetRef="a3" />
    <bpmn:sequenceFlow id="f-a3-ratec" sourceRef="a3" targetRef="ratec" />
    <bpmn:sequenceFlow id="f-ratec-a4" sourceRef="ratec" targetRef="a4" />
    <bpmn:sequenceFlow id="f-a3-rateapp" sourceRef="a3" targetRef="rateapp" />
    <bpmn:sequenceFlow id="f-rateapp-a4" sourceRef="rateapp" targetRef="a4" />
    <bpmn:sequenceFlow id="f-a4-year" sourceRef="a4" targetRef="year" />
    <bpmn:sequenceFlow id="f-year-review" sourceRef="year" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-d3" sourceRef="review" targetRef="d3" />
    <bpmn:sequenceFlow id="f-d3-d4" name="yes" sourceRef="d3" targetRef="d4" />
    <bpmn:sequenceFlow id="f-d3-e4" name="no" sourceRef="d3" targetRef="e4" />
    <bpmn:sequenceFlow id="f-d4-more" name="yes" sourceRef="d4" targetRef="more" />
    <bpmn:sequenceFlow id="f-d4-e1" name="no" sourceRef="d4" targetRef="e1" />
    <bpmn:sequenceFlow id="f-more-e3" sourceRef="more" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
