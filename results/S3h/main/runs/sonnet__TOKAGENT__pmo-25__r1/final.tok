tok 1.0 "Find a Job"

pool org "Job search"
  lane applicant "Applicant"
    start s "Start"
    task write "Write job application"
    and a1
    task report "Report job applications"
    and a2
    xor d1 "Interview wanted?"
    task negotiate "Negotiate job interview"
    xor m2
    xor d2 "Company wants you?"
    task probation "Enter probation phase"
    and a3
    task ratec "Rate company"
    and a4
    xor d3 "Job permanent?"
    xor d4 "Rated company C or less?"
    end e1 "Process ends"
    end e2 "Application rejected"
    end e3 "Process ends, offers continue"
    end e4 "Not made permanent"
  lane company "Company"
    task confirm "Confirm receipt of job application"
    task rate "Rate job application"
    task rateapp "Rate applicant"
  lane system "System"
    task offers "Send potential job offers"
    catch year "1 year passed" timer=P1Y
    task review "Show company review to applicants"
    task more "Send job offers"

flow s -> write -> a1
flow a1 -> report -> offers -> a2
flow a1 -> confirm -> rate -> a2
flow a2 -> d1
flow d1 -> negotiate "yes"
flow d1 -> m2 "no"
flow negotiate -> m2 -> d2
flow d2 -> probation "yes"
flow d2 -> e2 "no"
flow probation -> a3
flow a3 -> ratec -> a4
flow a3 -> rateapp -> a4
flow a4 -> year -> review -> d3
flow d3 -> d4 "yes"
flow d3 -> e4 "no"
flow d4 -> more "yes"
flow d4 -> e1 "no"
flow more -> e3
