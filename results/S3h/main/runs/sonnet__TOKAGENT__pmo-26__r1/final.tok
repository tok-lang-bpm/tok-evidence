tok 1.0 "Becoming A Parent"

pool org "Maternity leave support"
  lane parent "Parent"
    start s "Leave planning requested"
    user select "Select leave model"
    user decide "Decide about extension"
    xor ext "Extend leave?"
    end e "Leave ended"
  lane sys "Leave support system"
    task fetch "Fetch information about leave models"
    xor merge
    task collect "Collect relevant information"
    and split
    task nss "Notify Social Security"
    task nco "Notify Company"
    and join
    task gather "Gather information from companies"

flow s -> fetch -> select -> merge -> collect -> split
flow split -> nss -> join
flow split -> nco -> join
flow join -> gather -> decide -> ext
flow ext -> merge "yes"
flow ext -> e "no"
