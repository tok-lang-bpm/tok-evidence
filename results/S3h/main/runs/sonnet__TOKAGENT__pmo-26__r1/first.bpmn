<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Maternity leave support" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Leave support system">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Leave planning requested" />
    <bpmn:userTask id="select" name="Select leave model" />
    <bpmn:userTask id="decide" name="Decide about extension" />
    <bpmn:exclusiveGateway id="ext" name="Extend leave?" />
    <bpmn:endEvent id="e" name="Leave ended" />
    <bpmn:task id="fetch" name="Fetch information about leave models" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="nss" name="Notify Social Security" />
    <bpmn:task id="nco" name="Notify Company" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:sequenceFlow id="f-s-fetch" sourceRef="s" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-merge" sourceRef="select" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-collect" sourceRef="merge" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-split" sourceRef="collect" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-nss" sourceRef="split" targetRef="nss" />
    <bpmn:sequenceFlow id="f-nss-join" sourceRef="nss" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-nco" sourceRef="split" targetRef="nco" />
    <bpmn:sequenceFlow id="f-nco-join" sourceRef="nco" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-gather" sourceRef="join" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-decide" sourceRef="gather" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-ext" sourceRef="decide" targetRef="ext" />
    <bpmn:sequenceFlow id="f-ext-merge" name="yes" sourceRef="ext" targetRef="merge" />
    <bpmn:sequenceFlow id="f-ext-e" name="no" sourceRef="ext" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
