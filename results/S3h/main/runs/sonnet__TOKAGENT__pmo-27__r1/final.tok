tok 1.0 "Work Accident"

pool org "Organisation"
  lane employee "Employee"
    start s1 "Work accident or near accident occurs"
    task inform "Inform employer immediately"
  lane student "Student or schoolchild"
    start s2 "Student accident occurs"
    task repdir "Report accident to competent directorate"
    end e4 "Student accident reported"
  lane employer "Employer"
    task assess "Assess incident"
    xor g1 "Work accident?"
    task record "Record near accident"
    end e1 "Near accident recorded"
    xor g2 "Fatality or serious injury?"
    xor g3 "Reported to emergency services?"
    task replab "Report accident to Labour Inspectorate"
    xor m1
    xor g4 "Person killed or unable to work for three days?"
    task repins "Report accident to accident insurance provider within five days"
    end e2 "Accident reported"
    end e3 "No further report needed"

flow s1 -> inform -> assess -> g1
flow g1 -> record "no"
flow g1 -> g2 "yes"
flow record -> e1
flow g2 -> g3 "yes"
flow g2 -> m1 "no"
flow g3 -> replab "no"
flow g3 -> m1 "yes"
flow replab -> m1
flow m1 -> g4
flow g4 -> repins "yes"
flow g4 -> e3 "no"
flow repins -> e2
flow s2 -> repdir -> e4
