<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="student" name="Student or schoolchild">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repdir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>replab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Work accident or near accident occurs" />
    <bpmn:task id="inform" name="Inform employer immediately" />
    <bpmn:startEvent id="s2" name="Student accident occurs" />
    <bpmn:task id="repdir" name="Report accident to competent directorate" />
    <bpmn:endEvent id="e4" name="Student accident reported" />
    <bpmn:task id="assess" name="Assess incident" />
    <bpmn:exclusiveGateway id="g1" name="Work accident?" />
    <bpmn:task id="record" name="Record near accident" />
    <bpmn:endEvent id="e1" name="Near accident recorded" />
    <bpmn:exclusiveGateway id="g2" name="Fatality or serious injury?" />
    <bpmn:exclusiveGateway id="g3" name="Reported to emergency services?" />
    <bpmn:task id="replab" name="Report accident to Labour Inspectorate" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:exclusiveGateway id="g4" name="Person killed or unable to work for three days?" />
    <bpmn:task id="repins" name="Report accident to accident insurance provider within five days" />
    <bpmn:endEvent id="e2" name="Accident reported" />
    <bpmn:endEvent id="e3" name="No further report needed" />
    <bpmn:sequenceFlow id="f-s1-inform" sourceRef="s1" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-assess" sourceRef="inform" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-g1" sourceRef="assess" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-record" name="no" sourceRef="g1" targetRef="record" />
    <bpmn:sequenceFlow id="f-g1-g2" name="yes" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-record-e1" sourceRef="record" targetRef="e1" />
    <bpmn:sequenceFlow id="f-g2-g3" name="yes" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g2-m1" name="no" sourceRef="g2" targetRef="m1" />
    <bpmn:sequenceFlow id="f-g3-replab" name="no" sourceRef="g3" targetRef="replab" />
    <bpmn:sequenceFlow id="f-g3-m1" name="yes" sourceRef="g3" targetRef="m1" />
    <bpmn:sequenceFlow id="f-replab-m1" sourceRef="replab" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-g4" sourceRef="m1" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-repins" name="yes" sourceRef="g4" targetRef="repins" />
    <bpmn:sequenceFlow id="f-g4-e3" name="no" sourceRef="g4" targetRef="e3" />
    <bpmn:sequenceFlow id="f-repins-e2" sourceRef="repins" targetRef="e2" />
    <bpmn:sequenceFlow id="f-s2-repdir" sourceRef="s2" targetRef="repdir" />
    <bpmn:sequenceFlow id="f-repdir-e4" sourceRef="repdir" targetRef="e4" />
  </bpmn:process>
</bpmn:definitions>
