tok 1.0 "Internship"

pool org "Internship organisation"
  lane student "Student"
    start s "Start"
    task t1 "Enter topic and desired salary"
    task t2 "Enter experience and hobbies"
    xor m1
    receive r1 "Receive offer" message="Offer"
    xor d1 "Offer accepted?"
    task t3 "Deny offer"
    task t4 "Accept offer"
    and a1
    task t5 "Write status update" loop while="updates < 3"
    and a2
    task t6 "Finish internship"
    task t7 "Write recommendation tweet" parallel
    end e "End"
  lane company "Company"
    task c1 "Invalidate other offers"
    task c2 "Write status update about student" loop while="updates < 3"

flow s -> t1 -> t2 -> m1 -> r1 -> d1
flow d1 -> t3 "no"
flow d1 -> t4 "yes"
flow t3 -> m1
flow t4 -> c1 -> a1
flow a1 -> t5 -> a2
flow a1 -> c2 -> a2 -> t6 -> t7 -> e
