<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Offer" name="Offer" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Internship organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="t1" name="Enter topic and desired salary" />
    <bpmn:task id="t2" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:receiveTask id="r1" name="Receive offer" messageRef="Message_Offer" />
    <bpmn:exclusiveGateway id="d1" name="Offer accepted?" />
    <bpmn:task id="t3" name="Deny offer" />
    <bpmn:task id="t4" name="Accept offer" />
    <bpmn:parallelGateway id="a1" />
    <bpmn:task id="t5" name="Write status update">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">updates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="a2" />
    <bpmn:task id="t6" name="Finish internship" />
    <bpmn:task id="t7" name="Write recommendation tweet">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="c1" name="Invalidate other offers" />
    <bpmn:task id="c2" name="Write status update about student">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">updates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-m1" sourceRef="t2" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-r1" sourceRef="m1" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-d1" sourceRef="r1" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-t3" name="no" sourceRef="d1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-d1-t4" name="yes" sourceRef="d1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t3-m1" sourceRef="t3" targetRef="m1" />
    <bpmn:sequenceFlow id="f-t4-c1" sourceRef="t4" targetRef="c1" />
    <bpmn:sequenceFlow id="f-c1-a1" sourceRef="c1" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-t5" sourceRef="a1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-a2" sourceRef="t5" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a1-c2" sourceRef="a1" targetRef="c2" />
    <bpmn:sequenceFlow id="f-c2-a2" sourceRef="c2" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-t6" sourceRef="a2" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-e" sourceRef="t7" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
