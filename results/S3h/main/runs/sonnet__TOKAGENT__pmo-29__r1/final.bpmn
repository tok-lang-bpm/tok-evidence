<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Work and Live in Austria" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="app" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sj1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sj2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>live</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Representation office">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refuse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Plan stay in Austria" />
    <bpmn:parallelGateway id="sp1" />
    <bpmn:task id="acc" name="Organize accommodation" />
    <bpmn:task id="bank" name="Open bank account" />
    <bpmn:parallelGateway id="sj1" />
    <bpmn:task id="req" name="Check requirements for visa" />
    <bpmn:parallelGateway id="sp2" />
    <bpmn:task id="form" name="Fill in visa application form" />
    <bpmn:task id="doc" name="Prepare travel document" />
    <bpmn:task id="photo" name="Obtain passport photo" />
    <bpmn:task id="ins" name="Arrange travel health insurance" />
    <bpmn:task id="means" name="Prove means of subsistence" />
    <bpmn:task id="evid" name="Collect other evidence" />
    <bpmn:parallelGateway id="sj2" />
    <bpmn:exclusiveGateway id="type" name="Which visa type?" />
    <bpmn:task id="repd" name="Contact competent representation of place of residence" />
    <bpmn:task id="repm" name="Contact representation of main travel destination" />
    <bpmn:exclusiveGateway id="tm" />
    <bpmn:task id="submit" name="Submit visa application" />
    <bpmn:task id="extra" name="Provide additional documents" />
    <bpmn:task id="recv" name="Receive visa" />
    <bpmn:task id="live" name="Work and live in Austria" />
    <bpmn:endEvent id="e1" name="Stay started" />
    <bpmn:endEvent id="e2" name="Application refused" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="review" name="Review visa application" />
    <bpmn:exclusiveGateway id="g1" name="Additional documents needed?" />
    <bpmn:exclusiveGateway id="g2" name="Grounds for refusal?" />
    <bpmn:task id="issue" name="Issue visa" />
    <bpmn:task id="refuse" name="Refuse visa" />
    <bpmn:sequenceFlow id="f-s-sp1" sourceRef="s" targetRef="sp1" />
    <bpmn:sequenceFlow id="f-sp1-acc" sourceRef="sp1" targetRef="acc" />
    <bpmn:sequenceFlow id="f-acc-sj1" sourceRef="acc" targetRef="sj1" />
    <bpmn:sequenceFlow id="f-sp1-bank" sourceRef="sp1" targetRef="bank" />
    <bpmn:sequenceFlow id="f-bank-sj1" sourceRef="bank" targetRef="sj1" />
    <bpmn:sequenceFlow id="f-sj1-req" sourceRef="sj1" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-sp2" sourceRef="req" targetRef="sp2" />
    <bpmn:sequenceFlow id="f-sp2-form" sourceRef="sp2" targetRef="form" />
    <bpmn:sequenceFlow id="f-form-sj2" sourceRef="form" targetRef="sj2" />
    <bpmn:sequenceFlow id="f-sp2-doc" sourceRef="sp2" targetRef="doc" />
    <bpmn:sequenceFlow id="f-doc-sj2" sourceRef="doc" targetRef="sj2" />
    <bpmn:sequenceFlow id="f-sp2-photo" sourceRef="sp2" targetRef="photo" />
    <bpmn:sequenceFlow id="f-photo-sj2" sourceRef="photo" targetRef="sj2" />
    <bpmn:sequenceFlow id="f-sp2-ins" sourceRef="sp2" targetRef="ins" />
    <bpmn:sequenceFlow id="f-ins-sj2" sourceRef="ins" targetRef="sj2" />
    <bpmn:sequenceFlow id="f-sp2-means" sourceRef="sp2" targetRef="means" />
    <bpmn:sequenceFlow id="f-means-sj2" sourceRef="means" targetRef="sj2" />
    <bpmn:sequenceFlow id="f-sp2-evid" sourceRef="sp2" targetRef="evid" />
    <bpmn:sequenceFlow id="f-evid-sj2" sourceRef="evid" targetRef="sj2" />
    <bpmn:sequenceFlow id="f-sj2-type" sourceRef="sj2" targetRef="type" />
    <bpmn:sequenceFlow id="f-type-repd" name="Type D" sourceRef="type" targetRef="repd" />
    <bpmn:sequenceFlow id="f-type-repm" name="Type A or C" sourceRef="type" targetRef="repm" />
    <bpmn:sequenceFlow id="f-repd-tm" sourceRef="repd" targetRef="tm" />
    <bpmn:sequenceFlow id="f-repm-tm" sourceRef="repm" targetRef="tm" />
    <bpmn:sequenceFlow id="f-tm-submit" sourceRef="tm" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-m1" sourceRef="submit" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-review" sourceRef="m1" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-g1" sourceRef="review" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-extra" name="yes" sourceRef="g1" targetRef="extra" />
    <bpmn:sequenceFlow id="f-extra-m1" sourceRef="extra" targetRef="m1" />
    <bpmn:sequenceFlow id="f-g1-g2" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-refuse" name="yes" sourceRef="g2" targetRef="refuse" />
    <bpmn:sequenceFlow id="f-g2-issue" name="no" sourceRef="g2" targetRef="issue" />
    <bpmn:sequenceFlow id="f-refuse-e2" sourceRef="refuse" targetRef="e2" />
    <bpmn:sequenceFlow id="f-issue-recv" sourceRef="issue" targetRef="recv" />
    <bpmn:sequenceFlow id="f-recv-live" sourceRef="recv" targetRef="live" />
    <bpmn:sequenceFlow id="f-live-e1" sourceRef="live" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
