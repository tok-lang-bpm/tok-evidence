tok 1.0 "Work and Live in Austria"

pool org "Work and Live in Austria"
  lane app "Applicant"
    start s "Plan stay in Austria"
    and sp1
    task acc "Organize accommodation"
    task bank "Open bank account"
    and sj1
    task req "Check requirements for visa"
    and sp2
    task form "Fill in visa application form"
    task doc "Prepare travel document"
    task photo "Obtain passport photo"
    task ins "Arrange travel health insurance"
    task means "Prove means of subsistence"
    task evid "Collect other evidence"
    and sj2
    xor type "Which visa type?"
    task repd "Contact competent representation of place of residence"
    task repm "Contact representation of main travel destination"
    xor tm
    task submit "Submit visa application"
    task extra "Provide additional documents"
    task recv "Receive visa"
    task live "Work and live in Austria"
    end e1 "Stay started"
    end e2 "Application refused"
  lane rep "Representation office"
    xor m1
    task review "Review visa application"
    xor g1 "Additional documents needed?"
    xor g2 "Grounds for refusal?"
    task issue "Issue visa"
    task refuse "Refuse visa"

flow s -> sp1
flow sp1 -> acc -> sj1
flow sp1 -> bank -> sj1
flow sj1 -> req -> sp2
flow sp2 -> form -> sj2
flow sp2 -> doc -> sj2
flow sp2 -> photo -> sj2
flow sp2 -> ins -> sj2
flow sp2 -> means -> sj2
flow sp2 -> evid -> sj2
flow sj2 -> type
flow type -> repd "Type D" 
flow type -> repm "Type A or C"
flow repd -> tm
flow repm -> tm
flow tm -> submit
flow submit -> m1
flow m1 -> review -> g1
flow g1 -> extra "yes"
flow extra -> m1
flow g1 -> g2 "no"
flow g2 -> refuse "yes"
flow g2 -> issue "no"
flow refuse -> e2
flow issue -> recv -> live -> e1
