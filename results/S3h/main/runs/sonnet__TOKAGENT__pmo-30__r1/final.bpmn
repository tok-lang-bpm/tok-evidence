<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN party organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="me" name="Organiser">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Planning LAN party" />
    <bpmn:task id="inv" name="Send invitations" />
    <bpmn:task id="games" name="Find out games" />
    <bpmn:parallelGateway id="sp" />
    <bpmn:exclusiveGateway id="mj" />
    <bpmn:task id="date" name="Appoint date" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree?" default="f-agree-mj" />
    <bpmn:task id="chk" name="Find out if all games are available" />
    <bpmn:exclusiveGateway id="miss" name="Games missing?" default="f-miss-m1" />
    <bpmn:task id="dl" name="Download missing games" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="beer" name="Find out how much beer is required" />
    <bpmn:exclusiveGateway id="enough" name="Enough beer?" default="f-enough-m2" />
    <bpmn:task id="buy" name="Buy missing beer" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:parallelGateway id="jn" />
    <bpmn:task id="enjoy" name="Enjoy LAN party" />
    <bpmn:endEvent id="e" name="LAN party held" />
    <bpmn:sequenceFlow id="f-s-inv" sourceRef="s" targetRef="inv" />
    <bpmn:sequenceFlow id="f-inv-games" sourceRef="inv" targetRef="games" />
    <bpmn:sequenceFlow id="f-games-sp" sourceRef="games" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-mj" sourceRef="sp" targetRef="mj" />
    <bpmn:sequenceFlow id="f-mj-date" sourceRef="mj" targetRef="date" />
    <bpmn:sequenceFlow id="f-date-agree" sourceRef="date" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-jn" name="yes" sourceRef="agree" targetRef="jn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreed &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-agree-mj" name="no" sourceRef="agree" targetRef="mj" />
    <bpmn:sequenceFlow id="f-sp-chk" sourceRef="sp" targetRef="chk" />
    <bpmn:sequenceFlow id="f-chk-miss" sourceRef="chk" targetRef="miss" />
    <bpmn:sequenceFlow id="f-miss-dl" name="yes" sourceRef="miss" targetRef="dl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">missing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-miss-m1" name="no" sourceRef="miss" targetRef="m1" />
    <bpmn:sequenceFlow id="f-dl-m1" sourceRef="dl" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-beer" sourceRef="m1" targetRef="beer" />
    <bpmn:sequenceFlow id="f-beer-enough" sourceRef="beer" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-buy" name="no" sourceRef="enough" targetRef="buy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">enough = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough-m2" name="yes" sourceRef="enough" targetRef="m2" />
    <bpmn:sequenceFlow id="f-buy-m2" sourceRef="buy" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-jn" sourceRef="m2" targetRef="jn" />
    <bpmn:sequenceFlow id="f-jn-enjoy" sourceRef="jn" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-e" sourceRef="enjoy" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
