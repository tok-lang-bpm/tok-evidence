tok 1.0 "LAN Party"

pool org "LAN party organisation"
  lane me "Organiser"
    start s "Planning LAN party"
    task inv "Send invitations"
    task games "Find out games"
    and sp
    xor mj
    task date "Appoint date"
    xor agree "8 or more people agree?"
    task chk "Find out if all games are available"
    xor miss "Games missing?"
    task dl "Download missing games"
    xor m1
    task beer "Find out how much beer is required"
    xor enough "Enough beer?"
    task buy "Buy missing beer"
    xor m2
    and jn
    task enjoy "Enjoy LAN party"
    end e "LAN party held"

flow s -> inv -> games -> sp
flow sp -> mj
flow mj -> date -> agree
flow agree -> jn "yes" when="agreed >= 8"
flow agree -> mj "no" default
flow sp -> chk -> miss
flow miss -> dl "yes" when="missing = true"
flow miss -> m1 "no" default
flow dl -> m1 -> beer -> enough
flow enough -> buy "no" when="enough = false"
flow enough -> m2 "yes" default
flow buy -> m2 -> jn
flow jn -> enjoy -> e
