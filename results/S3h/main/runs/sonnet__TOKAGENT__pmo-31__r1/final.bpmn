<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sel_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sel_char</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start creating character" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="chk_acc" name="Check battle.net account" />
    <bpmn:exclusiveGateway id="has_acc" name="Has battle.net account?" default="f-has_acc-m1" />
    <bpmn:task id="enter_acc" name="Enter account information" />
    <bpmn:task id="click_link" name="Click link in confirmation mail" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="chk_sub" name="Check WoW subscription" />
    <bpmn:exclusiveGateway id="has_sub" name="Active WoW subscription?" default="f-has_sub-m3" />
    <bpmn:task id="sel_pay" name="Select payment method" />
    <bpmn:exclusiveGateway id="pay" name="Payment method?" default="f-pay-enter_iban" />
    <bpmn:task id="enter_cc" name="Enter credit card information" />
    <bpmn:task id="enter_iban" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:exclusiveGateway id="m3" />
    <bpmn:task id="login" name="Log into game" />
    <bpmn:task id="sel_char" name="Select realm, race and class" />
    <bpmn:task id="names" name="Come up with character names" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="enter_name" name="Enter name" />
    <bpmn:exclusiveGateway id="avail" name="Name available?" default="f-avail-get_conf" />
    <bpmn:task id="get_conf" name="Receive confirmation and selfies" />
    <bpmn:receiveTask id="get_msg" name="Receive message about released expansion" />
    <bpmn:endEvent id="e" name="Character created" />
    <bpmn:sequenceFlow id="f-s-split" sourceRef="s" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-chk_acc" sourceRef="split" targetRef="chk_acc" />
    <bpmn:sequenceFlow id="f-split-names" sourceRef="split" targetRef="names" />
    <bpmn:sequenceFlow id="f-chk_acc-has_acc" sourceRef="chk_acc" targetRef="has_acc" />
    <bpmn:sequenceFlow id="f-has_acc-enter_acc" name="no" sourceRef="has_acc" targetRef="enter_acc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasAccount = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-has_acc-m1" name="yes" sourceRef="has_acc" targetRef="m1" />
    <bpmn:sequenceFlow id="f-enter_acc-click_link" sourceRef="enter_acc" targetRef="click_link" />
    <bpmn:sequenceFlow id="f-click_link-m1" sourceRef="click_link" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-chk_sub" sourceRef="m1" targetRef="chk_sub" />
    <bpmn:sequenceFlow id="f-chk_sub-has_sub" sourceRef="chk_sub" targetRef="has_sub" />
    <bpmn:sequenceFlow id="f-has_sub-sel_pay" name="no" sourceRef="has_sub" targetRef="sel_pay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">subscription = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-has_sub-m3" name="yes" sourceRef="has_sub" targetRef="m3" />
    <bpmn:sequenceFlow id="f-sel_pay-pay" sourceRef="sel_pay" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-enter_cc" name="credit card" sourceRef="pay" targetRef="enter_cc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">payment = "card"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-pay-enter_iban" name="bank account" sourceRef="pay" targetRef="enter_iban" />
    <bpmn:sequenceFlow id="f-enter_cc-m2" sourceRef="enter_cc" targetRef="m2" />
    <bpmn:sequenceFlow id="f-enter_iban-m2" sourceRef="enter_iban" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-m3" sourceRef="m2" targetRef="m3" />
    <bpmn:sequenceFlow id="f-m3-login" sourceRef="m3" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-sel_char" sourceRef="login" targetRef="sel_char" />
    <bpmn:sequenceFlow id="f-sel_char-join" sourceRef="sel_char" targetRef="join" />
    <bpmn:sequenceFlow id="f-names-join" sourceRef="names" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-enter_name" sourceRef="join" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-enter_name-avail" sourceRef="enter_name" targetRef="avail" />
    <bpmn:sequenceFlow id="f-avail-enter_name" name="no" sourceRef="avail" targetRef="enter_name">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">available = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-avail-get_conf" name="yes" sourceRef="avail" targetRef="get_conf" />
    <bpmn:sequenceFlow id="f-get_conf-get_msg" sourceRef="get_conf" targetRef="get_msg" />
    <bpmn:sequenceFlow id="f-get_msg-e" sourceRef="get_msg" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
