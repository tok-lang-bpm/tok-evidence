tok 1.0 "Farming Bot"

pool game "Farming game"
  lane player "Player"
    start s "Player wants a farming bot"
    task find "Find out wanted resources"
    task prio "Set urgency of resources"
    task deps "Define resource dependencies"
    task sel "Select friends"
    or og "Brag, send materials or both?"
    task brag "Brag to friends"
    task send "Send materials to friends"
    or oj
    end e "Friends informed"
  lane bot "Bot"
    sub farm "Farm resources"
      start fs "Farming starts"
      task gather "Gather resources"
      end fe "Farming finished"
      eventsub dis "Natural disaster"
        start ds "Disaster strikes" signal="Disaster"
        task setback "Handle setback"
        end de "Setback handled"
      eventsub mil "Milestone"
        start ms "Milestone reached" signal="Milestone"
        task notify "Notify player"
        end me "Player notified"
      eventsub upd "Update list"
        start us "List update requested" message="UpdateList"
        task upl "Update list of materials to farm"
        end ue "List updated"

flow fs -> gather -> fe
flow ds -> setback -> de
flow ms -> notify -> me
flow us -> upl -> ue
flow s -> find -> prio -> deps -> farm -> sel -> og
flow og -> brag "brag" default
flow og -> send "send" when="send = true"
flow brag -> oj
flow send -> oj -> e
