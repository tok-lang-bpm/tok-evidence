tok 1.0 "Instruct an artist to create a 3D model and print it"

pool org "Customer"
  lane me "Customer"
    start s "Need a custom 3D model"
    task t1 "Send sketches to the artist"
    task t2 "Tell the artist what to change"
    xor g1 "Satisfied with the result?"
    task t3 "Choose plastic color"
    xor g2 "Color in stock?"
    task t4 "Check how much color is left"
    xor g3 "Under 100 grams?"
    task t5 "Put color on shopping list"
    xor m1
    task t6 "Order color"
    xor m2
    and a1
    task t7 "Generate gcode from STL"
    and a2
    task t8 "Print the model"
    end e "Model printed"
  lane prn "3D printer"
    task p1 "Turn printer on"
    task p2 "Heat up bed and extruder"

flow s -> t1 -> t2 -> g1
flow g1 -> t2 "no"
flow g1 -> t3 "yes"
flow t3 -> g2
flow g2 -> t4 "yes"
flow g2 -> t6 "no"
flow t4 -> g3
flow g3 -> t5 "yes"
flow g3 -> m1 "no"
flow t5 -> m1
flow m1 -> m2
flow t6 -> m2
flow m2 -> a1
flow a1 -> p1 -> p2 -> a2
flow a1 -> t7 -> a2
flow a2 -> t8 -> e
