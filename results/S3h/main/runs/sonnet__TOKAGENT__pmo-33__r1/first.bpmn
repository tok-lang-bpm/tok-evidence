<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Instruct an artist to create a 3D model and print it" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Customer" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Instruct an artist to create a 3D model and print it" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="me" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="prn" name="3D printer">
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Need a custom 3D model" />
    <bpmn:task id="t1" name="Send sketches to the artist" />
    <bpmn:task id="t2" name="Tell the artist what to change" />
    <bpmn:exclusiveGateway id="g1" name="Satisfied with the result?" />
    <bpmn:task id="t3" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="g2" name="Color in stock?" />
    <bpmn:task id="t4" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="g3" name="Under 100 grams?" />
    <bpmn:task id="t5" name="Put color on shopping list" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t6" name="Order color" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:parallelGateway id="a1" />
    <bpmn:task id="t7" name="Generate gcode from STL" />
    <bpmn:parallelGateway id="a2" />
    <bpmn:task id="t8" name="Print the model" />
    <bpmn:endEvent id="e" name="Model printed" />
    <bpmn:task id="p1" name="Turn printer on" />
    <bpmn:task id="p2" name="Heat up bed and extruder" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t2" name="no" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-g1-t3" name="yes" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t4" name="yes" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="f-g2-t6" name="no" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t4-g3" sourceRef="t4" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t5" name="yes" sourceRef="g3" targetRef="t5" />
    <bpmn:sequenceFlow id="f-g3-m1" name="no" sourceRef="g3" targetRef="m1" />
    <bpmn:sequenceFlow id="f-t5-m1" sourceRef="t5" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-m2" sourceRef="m1" targetRef="m2" />
    <bpmn:sequenceFlow id="f-t6-m2" sourceRef="t6" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m2-a1" sourceRef="m2" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-p1" sourceRef="a1" targetRef="p1" />
    <bpmn:sequenceFlow id="f-p1-p2" sourceRef="p1" targetRef="p2" />
    <bpmn:sequenceFlow id="f-p2-a2" sourceRef="p2" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a1-t7" sourceRef="a1" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-a2" sourceRef="t7" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-t8" sourceRef="a2" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-e" sourceRef="t8" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
