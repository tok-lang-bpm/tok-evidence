<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Lego machine project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Machine required" />
    <bpmn:task id="design" name="Develop basic design" />
    <bpmn:task id="order" name="Order Lego sets" />
    <bpmn:task id="give" name="Give Lego sets to children" />
    <bpmn:task id="build" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="empty" name="Container empty?" default="f-empty-test" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="ok" name="Test successful?" default="f-ok-redesign" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="assemble" name="Assemble machine" />
    <bpmn:endEvent id="e" name="Machine built" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:sequenceFlow id="f-s-design" sourceRef="s" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-build" sourceRef="sort" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-empty" sourceRef="build" targetRef="empty" />
    <bpmn:sequenceFlow id="f-empty-reorder" name="yes" sourceRef="empty" targetRef="reorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">containerEmpty = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reorder-build" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f-empty-test" name="no" sourceRef="empty" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-ok" sourceRef="test" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-assemble" name="yes" sourceRef="ok" targetRef="assemble">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">testSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-redesign" name="no" sourceRef="ok" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-build" sourceRef="redesign" targetRef="build" />
    <bpmn:sequenceFlow id="f-assemble-e" sourceRef="assemble" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
