tok 1.0 "Building a custom machine out of Lego bricks"

pool org "Lego machine project"
  lane builder "Builder"
    start s "Machine required"
    task design "Develop basic design"
    task order "Order Lego sets"
    task give "Give Lego sets to children"
    task build "Build subcomponent"
    xor empty "Container empty?"
    task reorder "Reorder individual parts"
    task test "Test subcomponent"
    xor ok "Test successful?"
    task redesign "Redesign subcomponent"
    task assemble "Assemble machine"
    end e "Machine built"
  lane children "Children"
    task sort "Sort parts into containers"

flow s -> design -> order -> give -> sort -> build -> empty
flow empty -> reorder "yes" when="containerEmpty = true"
flow reorder -> build
flow empty -> test "no" default
flow test -> ok
flow ok -> assemble "yes" when="testSuccessful = true"
flow ok -> redesign "no" default
flow redesign -> build
flow assemble -> e
