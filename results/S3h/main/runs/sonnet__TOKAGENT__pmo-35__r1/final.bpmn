<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Chainsaw producer" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getprops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ord1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ord2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ord3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order received" />
    <bpmn:task id="getprops" name="Receive properties from customer" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="ord1" name="Order parts from online source 1" />
    <bpmn:task id="ord2" name="Order parts from online source 2" />
    <bpmn:task id="ord3" name="Order parts from online source 3" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="recv" name="Receive parts" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="inspect" name="Inspect parts manually" />
    <bpmn:task id="assemble" name="Assemble parts" />
    <bpmn:task id="update" name="Send updates to customer" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="sendfirst" name="Send first saw to customer" />
    <bpmn:exclusiveGateway id="liked" name="Does customer like it?" />
    <bpmn:task id="rest" name="Produce rest of order" />
    <bpmn:endEvent id="e1" name="Order completed" />
    <bpmn:endEvent id="e2" name="Order closed" />
    <bpmn:sequenceFlow id="f-s-getprops" sourceRef="s" targetRef="getprops" />
    <bpmn:sequenceFlow id="f-getprops-split1" sourceRef="getprops" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-ord1" sourceRef="split1" targetRef="ord1" />
    <bpmn:sequenceFlow id="f-ord1-join1" sourceRef="ord1" targetRef="join1" />
    <bpmn:sequenceFlow id="f-split1-ord2" sourceRef="split1" targetRef="ord2" />
    <bpmn:sequenceFlow id="f-ord2-join1" sourceRef="ord2" targetRef="join1" />
    <bpmn:sequenceFlow id="f-split1-ord3" sourceRef="split1" targetRef="ord3" />
    <bpmn:sequenceFlow id="f-ord3-join1" sourceRef="ord3" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-recv" sourceRef="join1" targetRef="recv" />
    <bpmn:sequenceFlow id="f-recv-split2" sourceRef="recv" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-inspect" sourceRef="split2" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-assemble" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-join2" sourceRef="assemble" targetRef="join2" />
    <bpmn:sequenceFlow id="f-split2-update" sourceRef="split2" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-join2" sourceRef="update" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-sendfirst" sourceRef="join2" targetRef="sendfirst" />
    <bpmn:sequenceFlow id="f-sendfirst-liked" sourceRef="sendfirst" targetRef="liked" />
    <bpmn:sequenceFlow id="f-liked-rest" name="yes" sourceRef="liked" targetRef="rest" />
    <bpmn:sequenceFlow id="f-liked-e2" name="no" sourceRef="liked" targetRef="e2" />
    <bpmn:sequenceFlow id="f-rest-e1" sourceRef="rest" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
