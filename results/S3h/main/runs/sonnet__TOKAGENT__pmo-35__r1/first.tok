tok 1.0 "Chainsaw"

pool shop "Chainsaw producer"
  lane producer "Producer"
    start s "Order received"
    task getprops "Receive properties from customer"
    and split1
    task ord1 "Order parts from online source 1"
    task ord2 "Order parts from online source 2"
    task ord3 "Order parts from online source 3"
    and join1
    task recv "Receive parts"
    and split2
    task inspect "Inspect parts manually"
    task assemble "Assemble parts"
    task update "Send updates to customer"
    and join2
    task sendfirst "Send first saw to customer"
    xor liked "Does customer like it?"
    task rest "Produce rest of order"
    end e1 "Order completed"
    end e2 "Order closed"

flow s -> getprops -> split1
flow split1 -> ord1 -> join1
flow split1 -> ord2 -> join1
flow split1 -> ord3 -> join1
flow join1 -> recv -> split2
flow split2 -> inspect -> assemble -> join2
flow split2 -> update -> join2
flow join2 -> sendfirst -> liked
flow liked -> rest "yes"
flow liked -> e2 "no"
flow rest -> e1
