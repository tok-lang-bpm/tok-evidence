<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Airplane Manufacturer" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teams" name="Manufacturing Teams">
        <bpmn:flowNodeRef>make-bar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make-seats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make-toilet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assembly" name="Assembly and Test">
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="choose" name="Choose interior specifications" />
    <bpmn:task id="confirm" name="Confirm delivery" />
    <bpmn:endEvent id="done" name="Airplane accepted" />
    <bpmn:startEvent id="begin" name="Order received" />
    <bpmn:task id="receive-spec" name="Receive specifications" />
    <bpmn:task id="send-req" name="Send requirements to teams" />
    <bpmn:parallelGateway id="split-man" />
    <bpmn:parallelGateway id="join-man" />
    <bpmn:task id="send-protocol" name="Send test protocol to us and customer" />
    <bpmn:task id="deliver" name="Deliver plane to customer" />
    <bpmn:task id="make-bar" name="Manufacture bars" />
    <bpmn:task id="make-seats" name="Manufacture seats" />
    <bpmn:task id="make-toilet" name="Manufacture toilet equipment" />
    <bpmn:task id="assemble" name="Assemble interior" />
    <bpmn:task id="send-flight" name="Send plane on test flight" />
    <bpmn:parallelGateway id="split-test" />
    <bpmn:parallelGateway id="join-test" />
    <bpmn:task id="fly" name="Fly test flight" />
    <bpmn:task id="protocol" name="Create test protocol" />
    <bpmn:sequenceFlow id="f-begin-choose" sourceRef="begin" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-receive-spec" sourceRef="choose" targetRef="receive-spec" />
    <bpmn:sequenceFlow id="f-receive-spec-send-req" sourceRef="receive-spec" targetRef="send-req" />
    <bpmn:sequenceFlow id="f-send-req-split-man" sourceRef="send-req" targetRef="split-man" />
    <bpmn:sequenceFlow id="f-split-man-make-bar" sourceRef="split-man" targetRef="make-bar" />
    <bpmn:sequenceFlow id="f-split-man-make-seats" sourceRef="split-man" targetRef="make-seats" />
    <bpmn:sequenceFlow id="f-split-man-make-toilet" sourceRef="split-man" targetRef="make-toilet" />
    <bpmn:sequenceFlow id="f-make-bar-join-man" sourceRef="make-bar" targetRef="join-man" />
    <bpmn:sequenceFlow id="f-make-seats-join-man" sourceRef="make-seats" targetRef="join-man" />
    <bpmn:sequenceFlow id="f-make-toilet-join-man" sourceRef="make-toilet" targetRef="join-man" />
    <bpmn:sequenceFlow id="f-join-man-assemble" sourceRef="join-man" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-send-flight" sourceRef="assemble" targetRef="send-flight" />
    <bpmn:sequenceFlow id="f-send-flight-split-test" sourceRef="send-flight" targetRef="split-test" />
    <bpmn:sequenceFlow id="f-split-test-fly" sourceRef="split-test" targetRef="fly" />
    <bpmn:sequenceFlow id="f-split-test-protocol" sourceRef="split-test" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-fly-join-test" sourceRef="fly" targetRef="join-test" />
    <bpmn:sequenceFlow id="f-protocol-join-test" sourceRef="protocol" targetRef="join-test" />
    <bpmn:sequenceFlow id="f-join-test-send-protocol" sourceRef="join-test" targetRef="send-protocol" />
    <bpmn:sequenceFlow id="f-send-protocol-deliver" sourceRef="send-protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
