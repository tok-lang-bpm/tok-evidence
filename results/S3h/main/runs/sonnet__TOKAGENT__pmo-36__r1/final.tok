tok 1.0 "Luxury Airplane"

pool org "Airplane Manufacturer"
  lane customer "Customer"
    task choose "Choose interior specifications"
    task confirm "Confirm delivery"
    end done "Airplane accepted"
  lane sales "Sales"
    start begin "Order received"
    task receive-spec "Receive specifications"
    task send-req "Send requirements to teams"
    and split-man
    and join-man
    task send-protocol "Send test protocol to us and customer"
    task deliver "Deliver plane to customer"
  lane teams "Manufacturing Teams"
    task make-bar "Manufacture bars"
    task make-seats "Manufacture seats"
    task make-toilet "Manufacture toilet equipment"
  lane assembly "Assembly and Test"
    task assemble "Assemble interior"
    task send-flight "Send plane on test flight"
    and split-test
    and join-test
    task fly "Fly test flight"
    task protocol "Create test protocol"

flow begin -> choose -> receive-spec -> send-req -> split-man
flow split-man -> make-bar
flow split-man -> make-seats
flow split-man -> make-toilet
flow make-bar -> join-man
flow make-seats -> join-man
flow make-toilet -> join-man
flow join-man -> assemble -> send-flight -> split-test
flow split-test -> fly
flow split-test -> protocol
flow fly -> join-test
flow protocol -> join-test
flow join-test -> send-protocol -> deliver -> confirm -> done
