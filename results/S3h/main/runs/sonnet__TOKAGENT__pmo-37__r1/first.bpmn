<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Contract project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="me" name="Contractor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Parts needed for contract project" />
    <bpmn:task id="q" name="Query all web shops" />
    <bpmn:parallelGateway id="f1" />
    <bpmn:task id="a1" name="Find out how much the shop can deliver" />
    <bpmn:task id="a2" name="Find out the price" />
    <bpmn:task id="a3" name="Find out the delivery time" />
    <bpmn:parallelGateway id="f2" />
    <bpmn:task id="l" name="Create list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="g1" name="One shop has enough parts?" default="f-g1-o2" />
    <bpmn:task id="o1" name="Order parts from the cheapest shop" />
    <bpmn:task id="o2" name="Order parts from several shops" />
    <bpmn:exclusiveGateway id="j1" />
    <bpmn:task id="r" name="Receive first parts" />
    <bpmn:task id="b" name="Start building" />
    <bpmn:exclusiveGateway id="g5" name="Stock below 5?" default="f-g5-e1" />
    <bpmn:task id="rc" name="Reorder cheapest parts" />
    <bpmn:exclusiveGateway id="g3" name="Stock below 3?" default="f-g3-e2" />
    <bpmn:task id="rf" name="Reorder fastest parts" />
    <bpmn:exclusiveGateway id="g0" name="Stock zero?" default="f-g0-e3" />
    <bpmn:task id="m" name="Write mail to friends complaining about web shops" />
    <bpmn:endEvent id="e1" name="Building continues" />
    <bpmn:endEvent id="e2" name="Building continues" />
    <bpmn:endEvent id="e3" name="Building continues" />
    <bpmn:endEvent id="e4" name="Complaint sent" />
    <bpmn:sequenceFlow id="f-s-q" sourceRef="s" targetRef="q" />
    <bpmn:sequenceFlow id="f-q-f1" sourceRef="q" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-a1" sourceRef="f1" targetRef="a1" />
    <bpmn:sequenceFlow id="f-f1-a2" sourceRef="f1" targetRef="a2" />
    <bpmn:sequenceFlow id="f-f1-a3" sourceRef="f1" targetRef="a3" />
    <bpmn:sequenceFlow id="f-a1-f2" sourceRef="a1" targetRef="f2" />
    <bpmn:sequenceFlow id="f-a2-f2" sourceRef="a2" targetRef="f2" />
    <bpmn:sequenceFlow id="f-a3-f2" sourceRef="a3" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-l" sourceRef="f2" targetRef="l" />
    <bpmn:sequenceFlow id="f-l-g1" sourceRef="l" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-o1" name="yes" sourceRef="g1" targetRef="o1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">enough = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-o2" name="no" sourceRef="g1" targetRef="o2" />
    <bpmn:sequenceFlow id="f-o1-j1" sourceRef="o1" targetRef="j1" />
    <bpmn:sequenceFlow id="f-o2-j1" sourceRef="o2" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-r" sourceRef="j1" targetRef="r" />
    <bpmn:sequenceFlow id="f-r-b" sourceRef="r" targetRef="b" />
    <bpmn:sequenceFlow id="f-b-g5" sourceRef="b" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-rc" name="yes" sourceRef="g5" targetRef="rc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &lt; 5</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g5-e1" name="no" sourceRef="g5" targetRef="e1" />
    <bpmn:sequenceFlow id="f-rc-g3" sourceRef="rc" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-rf" name="yes" sourceRef="g3" targetRef="rf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g3-e2" name="no" sourceRef="g3" targetRef="e2" />
    <bpmn:sequenceFlow id="f-rf-g0" sourceRef="rf" targetRef="g0" />
    <bpmn:sequenceFlow id="f-g0-m" name="yes" sourceRef="g0" targetRef="m">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g0-e3" name="no" sourceRef="g0" targetRef="e3" />
    <bpmn:sequenceFlow id="f-m-e4" sourceRef="m" targetRef="e4" />
  </bpmn:process>
</bpmn:definitions>
