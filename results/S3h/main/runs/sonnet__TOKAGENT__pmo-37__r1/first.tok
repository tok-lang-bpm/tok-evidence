tok 1.0 "Contract"

pool org "Contract project"
  lane me "Contractor"
    start s "Parts needed for contract project"
    task q "Query all web shops"
    and f1
    task a1 "Find out how much the shop can deliver"
    task a2 "Find out the price"
    task a3 "Find out the delivery time"
    and f2
    task l "Create list of parts to order from each shop"
    xor g1 "One shop has enough parts?"
    task o1 "Order parts from the cheapest shop"
    task o2 "Order parts from several shops"
    xor j1
    task r "Receive first parts"
    task b "Start building"
    xor g5 "Stock below 5?"
    task rc "Reorder cheapest parts"
    xor g3 "Stock below 3?"
    task rf "Reorder fastest parts"
    xor g0 "Stock zero?"
    task m "Write mail to friends complaining about web shops"
    end e1 "Building continues"
    end e2 "Building continues"
    end e3 "Building continues"
    end e4 "Complaint sent"

flow s -> q -> f1
flow f1 -> a1
flow f1 -> a2
flow f1 -> a3
flow a1 -> f2
flow a2 -> f2
flow a3 -> f2
flow f2 -> l -> g1
flow g1 -> o1 "yes" when="enough = true"
flow g1 -> o2 "no" default
flow o1 -> j1
flow o2 -> j1
flow j1 -> r -> b -> g5
flow g5 -> rc "yes" when="stock < 5"
flow g5 -> e1 "no" default
flow rc -> g3
flow g3 -> rf "yes" when="stock < 3"
flow g3 -> e2 "no" default
flow rf -> g0
flow g0 -> m "yes" when="stock = 0"
flow g0 -> e3 "no" default
flow m -> e4
