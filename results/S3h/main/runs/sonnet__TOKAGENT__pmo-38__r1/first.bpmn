<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Tree house project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="owner" name="Builder">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msgs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="arch" name="Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Want to build tree house" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="sendreq" name="Send requirements to architect" />
    <bpmn:task id="refine" name="Refine draft with additional requirements" />
    <bpmn:exclusiveGateway id="more" name="Refine again?" />
    <bpmn:task id="list" name="Create list of needed materials" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="order" name="Order materials from online stores" />
    <bpmn:task id="msgs" name="Send messages to friends to build house" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="invite" name="Send invitations for tree house party" />
    <bpmn:task id="attend" name="Create list of people attending party" />
    <bpmn:task id="snacks" name="Buy snacks" />
    <bpmn:endEvent id="e" name="Party prepared" />
    <bpmn:task id="draft" name="Send draft" />
    <bpmn:sequenceFlow id="f-s-collect" sourceRef="s" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sendreq" sourceRef="collect" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-draft" sourceRef="sendreq" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-refine" sourceRef="draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-more" sourceRef="refine" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-refine" name="yes" sourceRef="more" targetRef="refine" />
    <bpmn:sequenceFlow id="f-more-list" name="no" sourceRef="more" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-split" sourceRef="list" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-order" sourceRef="split" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-join" sourceRef="order" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-msgs" sourceRef="split" targetRef="msgs" />
    <bpmn:sequenceFlow id="f-msgs-join" sourceRef="msgs" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-invite" sourceRef="join" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-attend" sourceRef="invite" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-snacks" sourceRef="attend" targetRef="snacks" />
    <bpmn:sequenceFlow id="f-snacks-e" sourceRef="snacks" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
