tok 1.0 "Building a House"

pool org "Tree house project"
  lane owner "Builder"
    start s "Want to build tree house"
    task collect "Collect requirements"
    task sendreq "Send requirements to architect"
    task refine "Refine draft with additional requirements"
    xor more "Refine again?"
    task list "Create list of needed materials"
    and split
    task order "Order materials from online stores"
    task msgs "Send messages to friends to build house"
    and join
    task invite "Send invitations for tree house party"
    task attend "Create list of people attending party"
    task snacks "Buy snacks"
    end e "Party prepared"
  lane arch "Architect"
    task draft "Send draft"

flow s -> collect -> sendreq -> draft -> refine -> more
flow more -> refine "yes"
flow more -> list "no"
flow list -> split
flow split -> order -> join
flow split -> msgs -> join
flow join -> invite -> attend -> snacks -> e
