<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="DIY repair" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>own</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>borrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online tool">
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Phone screen broken" />
    <bpmn:task id="enter" name="Enter model and damage" />
    <bpmn:task id="own" name="Check owned items" />
    <bpmn:exclusiveGateway id="miss" name="Anything missing?" default="f-miss-join" />
    <bpmn:task id="friends" name="Contact friends" />
    <bpmn:task id="borrow" name="Borrow or buy from friends" />
    <bpmn:task id="buy" name="Buy the rest" />
    <bpmn:exclusiveGateway id="join" name="Join" />
    <bpmn:task id="fix" name="Fix phone" />
    <bpmn:exclusiveGateway id="ok" name="Did the repair work?" default="f-ok-expert" />
    <bpmn:task id="review" name="Send review or video" />
    <bpmn:task id="expert" name="Send phone to expert" />
    <bpmn:endEvent id="e1" name="Repaired" />
    <bpmn:endEvent id="e2" name="Handed to expert" />
    <bpmn:parallelGateway id="sp" name="Split" />
    <bpmn:task id="mat" name="Provide list of materials" />
    <bpmn:task id="tl" name="Provide list of tools" />
    <bpmn:task id="opt" name="Provide ordering choices" />
    <bpmn:parallelGateway id="jn" name="Join" />
    <bpmn:task id="instr" name="Provide repair instructions" />
    <bpmn:sequenceFlow id="f-s-enter" sourceRef="s" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-sp" sourceRef="enter" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-mat" sourceRef="sp" targetRef="mat" />
    <bpmn:sequenceFlow id="f-mat-jn" sourceRef="mat" targetRef="jn" />
    <bpmn:sequenceFlow id="f-sp-tl" sourceRef="sp" targetRef="tl" />
    <bpmn:sequenceFlow id="f-tl-jn" sourceRef="tl" targetRef="jn" />
    <bpmn:sequenceFlow id="f-sp-opt" sourceRef="sp" targetRef="opt" />
    <bpmn:sequenceFlow id="f-opt-jn" sourceRef="opt" targetRef="jn" />
    <bpmn:sequenceFlow id="f-jn-own" sourceRef="jn" targetRef="own" />
    <bpmn:sequenceFlow id="f-own-miss" sourceRef="own" targetRef="miss" />
    <bpmn:sequenceFlow id="f-miss-friends" name="yes" sourceRef="miss" targetRef="friends">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-friends-borrow" sourceRef="friends" targetRef="borrow" />
    <bpmn:sequenceFlow id="f-borrow-buy" sourceRef="borrow" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-join" sourceRef="buy" targetRef="join" />
    <bpmn:sequenceFlow id="f-miss-join" name="no" sourceRef="miss" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-instr" sourceRef="join" targetRef="instr" />
    <bpmn:sequenceFlow id="f-instr-fix" sourceRef="instr" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-ok" sourceRef="fix" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-review" name="yes" sourceRef="ok" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-ok-expert" name="no" sourceRef="ok" targetRef="expert" />
    <bpmn:sequenceFlow id="f-review-e1" sourceRef="review" targetRef="e1" />
    <bpmn:sequenceFlow id="f-expert-e2" sourceRef="expert" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
