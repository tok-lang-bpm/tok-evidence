tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool org "DIY repair"
  lane user "User"
    start s "Phone screen broken"
    task enter "Enter model and damage"
    task own "Check owned items"
    xor miss "Anything missing?"
    task friends "Contact friends"
    task borrow "Borrow or buy from friends"
    task buy "Buy the rest"
    xor join "Join"
    task fix "Fix phone"
    xor ok "Did the repair work?"
    task review "Send review or video"
    task expert "Send phone to expert"
    end e1 "Repaired"
    end e2 "Handed to expert"
  lane tool "Online tool"
    and sp "Split"
    task mat "Provide list of materials"
    task tl "Provide list of tools"
    task opt "Provide ordering choices"
    and jn "Join"
    task instr "Provide repair instructions"

flow s -> enter -> sp
flow sp -> mat -> jn
flow sp -> tl -> jn
flow sp -> opt -> jn -> own -> miss
flow miss -> friends "yes" when=""
flow friends -> borrow -> buy -> join
flow miss -> join "no" default
flow join -> instr -> fix -> ok
flow ok -> review "yes" when=""
flow ok -> expert "no" default
flow review -> e1
flow expert -> e2
