tok 1.0 "OEE"

pool org "Organisation"
  lane sys "OEE system"
    start s "Start"
    xor m
    task collect "Collect machine information"
    task calc "Calculate OEE"
    xor g1 "OEE below limit?"
    task stop "Stop machine"
    task mail "Send email to engineer"
    catch restart "Machine restarted" message="Restart"
    xor g2 "Machine disconnected?"
    end e "End"

flow s -> m -> collect -> calc -> g1
flow g1 -> stop "yes" when="oee < limit"
flow g1 -> g2 "no" default
flow stop -> mail -> restart -> m
flow g2 -> e "yes" when="disconnected = true"
flow g2 -> m "no" default
