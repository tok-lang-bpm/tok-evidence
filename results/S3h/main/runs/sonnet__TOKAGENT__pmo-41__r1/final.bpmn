<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Inspection organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-serial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press-buttons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input-additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Application">
        <bpmn:flowNodeRef>start-inspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show-values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>need-more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-additional</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Inspection requested" />
    <bpmn:task id="enter-type" name="Enter machine type" />
    <bpmn:task id="enter-serial" name="Enter serial number" />
    <bpmn:task id="input-values" name="Input values" />
    <bpmn:task id="press-buttons" name="Press buttons" />
    <bpmn:task id="input-additional" name="Input additional values" />
    <bpmn:endEvent id="e1" name="Inspection finished" />
    <bpmn:endEvent id="e2" name="Inspection finished with additional questions" />
    <bpmn:task id="start-inspection" name="Begin inspection" />
    <bpmn:task id="ask-questions" name="Ask questions" />
    <bpmn:task id="collect-values" name="Collect values from machine" />
    <bpmn:task id="show-values" name="Show values" />
    <bpmn:task id="evaluate" name="Evaluate results" />
    <bpmn:exclusiveGateway id="need-more" name="Additional questions needed?" default="f-need-more-e1" />
    <bpmn:task id="ask-additional" name="Ask additional questions" />
    <bpmn:sequenceFlow id="f-s-enter-type" sourceRef="s" targetRef="enter-type" />
    <bpmn:sequenceFlow id="f-enter-type-enter-serial" sourceRef="enter-type" targetRef="enter-serial" />
    <bpmn:sequenceFlow id="f-enter-serial-start-inspection" sourceRef="enter-serial" targetRef="start-inspection" />
    <bpmn:sequenceFlow id="f-start-inspection-ask-questions" sourceRef="start-inspection" targetRef="ask-questions" />
    <bpmn:sequenceFlow id="f-ask-questions-input-values" sourceRef="ask-questions" targetRef="input-values" />
    <bpmn:sequenceFlow id="f-input-values-press-buttons" sourceRef="input-values" targetRef="press-buttons" />
    <bpmn:sequenceFlow id="f-press-buttons-collect-values" sourceRef="press-buttons" targetRef="collect-values" />
    <bpmn:sequenceFlow id="f-collect-values-show-values" sourceRef="collect-values" targetRef="show-values" />
    <bpmn:sequenceFlow id="f-show-values-evaluate" sourceRef="show-values" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-need-more" sourceRef="evaluate" targetRef="need-more" />
    <bpmn:sequenceFlow id="f-need-more-ask-additional" name="yes" sourceRef="need-more" targetRef="ask-additional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additionalQuestions = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-need-more-e1" name="no" sourceRef="need-more" targetRef="e1" />
    <bpmn:sequenceFlow id="f-ask-additional-input-additional" sourceRef="ask-additional" targetRef="input-additional" />
    <bpmn:sequenceFlow id="f-input-additional-e2" sourceRef="input-additional" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
