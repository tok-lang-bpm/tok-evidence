tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool org "Inspection organisation"
  lane inspector "Inspector"
    start s "Inspection requested"
    task enter-type "Enter machine type"
    task enter-serial "Enter serial number"
    task input-values "Input values"
    task press-buttons "Press buttons"
    task input-additional "Input additional values"
    end e1 "Inspection finished"
    end e2 "Inspection finished with additional questions"
  lane app "Application"
    task start-inspection "Begin inspection"
    task ask-questions "Ask questions"
    task collect-values "Collect values from machine"
    task show-values "Show values"
    task evaluate "Evaluate results"
    xor need-more "Additional questions needed?"
    task ask-additional "Ask additional questions"

flow s -> enter-type -> enter-serial -> start-inspection -> ask-questions -> input-values -> press-buttons -> collect-values -> show-values -> evaluate -> need-more
flow need-more -> ask-additional "yes" when="additionalQuestions = true"
flow need-more -> e1 "no" default
flow ask-additional -> input-additional -> e2
