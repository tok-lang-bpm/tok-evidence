tok 1.0 "Service for Your Fridge"

pool org "Fridge service"
  lane cust "Customer"
    start s "Fridge produces strange noises"
    task describe "Describe symptoms"
    task send "Send symptoms and fridge type to service center"
    task confirm "Confirm fridge is OK"
    xor rate "Rate the service facility?"
    task dorate "Rate service facility"
    xor rjoin
    end e "Service finished"
  lane center "Central fridge service center"
    task select "Select local service facility"
  lane fac "Service facility"
    xor ajoin
    task appoint "Make appointment"
    task arrive "Arrive at customer"
    xor parts "Additional parts needed?"
    task leave "Leave without repairing fridge"
    task repair "Repair fridge"

flow s -> describe -> send -> select -> ajoin -> appoint -> arrive -> parts
flow parts -> leave "yes" when=""
flow parts -> repair "no" default
flow leave -> ajoin
flow repair -> confirm -> rate
flow rate -> dorate "yes" when=""
flow rate -> rjoin "no" default
flow dorate -> rjoin -> e
