<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Fridge service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fac" name="Service facility">
        <bpmn:flowNodeRef>ajoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe symptoms" />
    <bpmn:task id="send" name="Send symptoms and fridge type to service center" />
    <bpmn:task id="confirm" name="Confirm fridge is OK" />
    <bpmn:exclusiveGateway id="rate" name="Rate the service facility?" default="f-rate-rjoin" />
    <bpmn:task id="dorate" name="Rate service facility" />
    <bpmn:exclusiveGateway id="rjoin" />
    <bpmn:endEvent id="e" name="Service finished" />
    <bpmn:task id="select" name="Select local service facility" />
    <bpmn:exclusiveGateway id="ajoin" />
    <bpmn:task id="appoint" name="Make appointment" />
    <bpmn:task id="arrive" name="Arrive at customer" />
    <bpmn:exclusiveGateway id="parts" name="Additional parts needed?" default="f-parts-repair" />
    <bpmn:task id="leave" name="Leave without repairing fridge" />
    <bpmn:task id="repair" name="Repair fridge" />
    <bpmn:sequenceFlow id="f-s-describe" sourceRef="s" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-ajoin" sourceRef="select" targetRef="ajoin" />
    <bpmn:sequenceFlow id="f-ajoin-appoint" sourceRef="ajoin" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-arrive" sourceRef="appoint" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-parts" sourceRef="arrive" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-leave" name="yes" sourceRef="parts" targetRef="leave" />
    <bpmn:sequenceFlow id="f-parts-repair" name="no" sourceRef="parts" targetRef="repair" />
    <bpmn:sequenceFlow id="f-leave-ajoin" sourceRef="leave" targetRef="ajoin" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-dorate" name="yes" sourceRef="rate" targetRef="dorate" />
    <bpmn:sequenceFlow id="f-rate-rjoin" name="no" sourceRef="rate" targetRef="rjoin" />
    <bpmn:sequenceFlow id="f-dorate-rjoin" sourceRef="dorate" targetRef="rjoin" />
    <bpmn:sequenceFlow id="f-rjoin-e" sourceRef="rjoin" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
