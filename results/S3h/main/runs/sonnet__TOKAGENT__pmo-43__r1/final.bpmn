<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Car Service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Owner_arrives" name="Owner arrives" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="police" name="Police" processRef="police-process" />
  </bpmn:collaboration>
  <bpmn:process id="police-process" name="Car Service" isExecutable="false">
    <bpmn:laneSet id="police-lanes">
      <bpmn:lane id="sys" name="App system">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="owner" name="Car owner">
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mech" name="Mechanic">
        <bpmn:flowNodeRef>prob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Service successful" />
    <bpmn:task id="chk" name="Check car registration" />
    <bpmn:exclusiveGateway id="reg" name="Car still registered?" />
    <bpmn:task id="notify" name="Notify car owner" />
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="timeout" name="30 days passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fine" name="Fine car owner" />
    <bpmn:endEvent id="e1" name="Car not registered" />
    <bpmn:endEvent id="e2" name="Car owner fined" />
    <bpmn:parallelGateway id="par" />
    <bpmn:task id="status" name="Send status updates via email" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="e3" name="Service completed" />
    <bpmn:intermediateCatchEvent id="visit" name="Owner goes to service">
      <bpmn:messageEventDefinition id="visit-def" messageRef="Message_Owner_arrives" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="pay" name="Pay through app" />
    <bpmn:task id="prob" name="Enter problems of car" />
    <bpmn:task id="repair" name="Repair car" />
    <bpmn:task id="done" name="Enter successful repair and Pickerl" />
    <bpmn:task id="next" name="Enter time for next service" />
    <bpmn:sequenceFlow id="f-s-chk" sourceRef="s" targetRef="chk" />
    <bpmn:sequenceFlow id="f-chk-reg" sourceRef="chk" targetRef="reg" />
    <bpmn:sequenceFlow id="f-reg-notify" name="yes" sourceRef="reg" targetRef="notify" />
    <bpmn:sequenceFlow id="f-reg-e1" name="no" sourceRef="reg" targetRef="e1" />
    <bpmn:sequenceFlow id="f-notify-wait" sourceRef="notify" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-visit" sourceRef="wait" targetRef="visit" />
    <bpmn:sequenceFlow id="f-wait-timeout" sourceRef="wait" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-timeout-fine" sourceRef="timeout" targetRef="fine" />
    <bpmn:sequenceFlow id="f-fine-e2" sourceRef="fine" targetRef="e2" />
    <bpmn:sequenceFlow id="f-visit-prob" sourceRef="visit" targetRef="prob" />
    <bpmn:sequenceFlow id="f-prob-par" sourceRef="prob" targetRef="par" />
    <bpmn:sequenceFlow id="f-par-status" sourceRef="par" targetRef="status" />
    <bpmn:sequenceFlow id="f-par-repair" sourceRef="par" targetRef="repair" />
    <bpmn:sequenceFlow id="f-status-join" sourceRef="status" targetRef="join" />
    <bpmn:sequenceFlow id="f-repair-join" sourceRef="repair" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-pay" sourceRef="join" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-done" sourceRef="pay" targetRef="done" />
    <bpmn:sequenceFlow id="f-done-next" sourceRef="done" targetRef="next" />
    <bpmn:sequenceFlow id="f-next-e3" sourceRef="next" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
