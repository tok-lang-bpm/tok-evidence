<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Robotic Burger Seller" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Robotic Burger Seller" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Robotic Burger Seller" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep-drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep-fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep-wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m-menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep-burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Order placed" />
    <bpmn:task id="receive-order" name="Receive order" />
    <bpmn:task id="ask-menu" name="Ask whether customer wants menu or just burger" />
    <bpmn:exclusiveGateway id="g-menu" name="Menu or just burger?" />
    <bpmn:parallelGateway id="split" name="Start drink and side" />
    <bpmn:task id="prep-drink" name="Prepare drink" />
    <bpmn:task id="ask-side" name="Ask whether customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="g-side" name="Fries or wedges?" />
    <bpmn:task id="prep-fries" name="Prepare fries" />
    <bpmn:task id="prep-wedges" name="Prepare wedges" />
    <bpmn:exclusiveGateway id="m-side" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="m-menu" />
    <bpmn:task id="prep-burger" name="Prepare burger" />
    <bpmn:boundaryEvent id="tick" name="Every 30 seconds" attachedToRef="prep-burger" cancelActivity="false">
      <bpmn:timerEventDefinition id="tick-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="status" name="Give status update" />
    <bpmn:endEvent id="e-status" name="Update given" />
    <bpmn:task id="deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="e" name="Order delivered" />
    <bpmn:sequenceFlow id="f-s-receive-order" sourceRef="s" targetRef="receive-order" />
    <bpmn:sequenceFlow id="f-receive-order-ask-menu" sourceRef="receive-order" targetRef="ask-menu" />
    <bpmn:sequenceFlow id="f-ask-menu-g-menu" sourceRef="ask-menu" targetRef="g-menu" />
    <bpmn:sequenceFlow id="f-g-menu-split" name="menu" sourceRef="g-menu" targetRef="split" />
    <bpmn:sequenceFlow id="f-g-menu-m-menu" name="just burger" sourceRef="g-menu" targetRef="m-menu" />
    <bpmn:sequenceFlow id="f-split-prep-drink" sourceRef="split" targetRef="prep-drink" />
    <bpmn:sequenceFlow id="f-prep-drink-join" sourceRef="prep-drink" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-ask-side" sourceRef="split" targetRef="ask-side" />
    <bpmn:sequenceFlow id="f-ask-side-g-side" sourceRef="ask-side" targetRef="g-side" />
    <bpmn:sequenceFlow id="f-g-side-prep-fries" name="fries" sourceRef="g-side" targetRef="prep-fries" />
    <bpmn:sequenceFlow id="f-g-side-prep-wedges" name="wedges" sourceRef="g-side" targetRef="prep-wedges" />
    <bpmn:sequenceFlow id="f-prep-fries-m-side" sourceRef="prep-fries" targetRef="m-side" />
    <bpmn:sequenceFlow id="f-prep-wedges-m-side" sourceRef="prep-wedges" targetRef="m-side" />
    <bpmn:sequenceFlow id="f-m-side-join" sourceRef="m-side" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-m-menu" sourceRef="join" targetRef="m-menu" />
    <bpmn:sequenceFlow id="f-m-menu-prep-burger" sourceRef="m-menu" targetRef="prep-burger" />
    <bpmn:sequenceFlow id="f-prep-burger-deliver" sourceRef="prep-burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-e" sourceRef="deliver" targetRef="e" />
    <bpmn:sequenceFlow id="f-tick-status" sourceRef="tick" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-e-status" sourceRef="status" targetRef="e-status" />
  </bpmn:process>
</bpmn:definitions>
