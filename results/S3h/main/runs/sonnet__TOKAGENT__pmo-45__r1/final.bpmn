<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online Shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sav</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Shopping system">
        <bpmn:flowNodeRef>chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Customer wants to order" />
    <bpmn:task id="log" name="Log into E-Shop" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="sel" name="Select product" />
    <bpmn:task id="add" name="Add product to shopping cart" />
    <bpmn:task id="sav" name="Save product" />
    <bpmn:exclusiveGateway id="g2" name="Every product selected?" />
    <bpmn:parallelGateway id="sp" />
    <bpmn:task id="pay" name="Enter payment data" />
    <bpmn:task id="addr" name="Enter shipping address" />
    <bpmn:exclusiveGateway id="g3" name="Billing address differs from shipping address?" />
    <bpmn:task id="bill" name="Enter billing address" />
    <bpmn:exclusiveGateway id="m3" />
    <bpmn:parallelGateway id="jn" />
    <bpmn:endEvent id="e1" name="Order completed" />
    <bpmn:endEvent id="e2" name="Shopping stopped" />
    <bpmn:task id="chk" name="Check credentials" />
    <bpmn:exclusiveGateway id="g1" name="Login successful?" />
    <bpmn:task id="fin" name="Finish order" />
    <bpmn:task id="comp" name="Complete order" />
    <bpmn:task id="conf" name="Confirm payment" />
    <bpmn:sequenceFlow id="f-s1-log" sourceRef="s1" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-chk" sourceRef="log" targetRef="chk" />
    <bpmn:sequenceFlow id="f-chk-g1" sourceRef="chk" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-m1" name="yes" sourceRef="g1" targetRef="m1" />
    <bpmn:sequenceFlow id="f-g1-e2" name="no" sourceRef="g1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-m1-sel" sourceRef="m1" targetRef="sel" />
    <bpmn:sequenceFlow id="f-sel-add" sourceRef="sel" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-sav" sourceRef="add" targetRef="sav" />
    <bpmn:sequenceFlow id="f-sav-g2" sourceRef="sav" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-m1" name="no" sourceRef="g2" targetRef="m1" />
    <bpmn:sequenceFlow id="f-g2-fin" name="yes" sourceRef="g2" targetRef="fin" />
    <bpmn:sequenceFlow id="f-fin-sp" sourceRef="fin" targetRef="sp" />
    <bpmn:sequenceFlow id="f-sp-pay" sourceRef="sp" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-conf" sourceRef="pay" targetRef="conf" />
    <bpmn:sequenceFlow id="f-conf-jn" sourceRef="conf" targetRef="jn" />
    <bpmn:sequenceFlow id="f-sp-addr" sourceRef="sp" targetRef="addr" />
    <bpmn:sequenceFlow id="f-addr-g3" sourceRef="addr" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-bill" name="yes" sourceRef="g3" targetRef="bill" />
    <bpmn:sequenceFlow id="f-g3-m3" name="no" sourceRef="g3" targetRef="m3" />
    <bpmn:sequenceFlow id="f-bill-m3" sourceRef="bill" targetRef="m3" />
    <bpmn:sequenceFlow id="f-m3-jn" sourceRef="m3" targetRef="jn" />
    <bpmn:sequenceFlow id="f-jn-comp" sourceRef="jn" targetRef="comp" />
    <bpmn:sequenceFlow id="f-comp-e1" sourceRef="comp" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
