tok 1.0 "Ordering in an Online Shop"

pool shop "Online Shop"
  lane cust "Customer"
    start s1 "Customer wants to order"
    task log "Log into E-Shop"
    xor m1
    task sel "Select product"
    task add "Add product to shopping cart"
    task sav "Save product"
    xor g2 "Every product selected?"
    and sp
    task pay "Enter payment data"
    task addr "Enter shipping address"
    xor g3 "Billing address differs from shipping address?"
    task bill "Enter billing address"
    xor m3
    and jn
    end e1 "Order completed"
    end e2 "Shopping stopped"
  lane sys "Shopping system"
    task chk "Check credentials"
    xor g1 "Login successful?"
    task fin "Finish order"
    task comp "Complete order"
  lane bank "Bank"
    task conf "Confirm payment"

flow s1 -> log -> chk -> g1
flow g1 -> m1 "yes"
flow g1 -> e2 "no"
flow m1 -> sel -> add -> sav -> g2
flow g2 -> m1 "no"
flow g2 -> fin "yes"
flow fin -> sp
flow sp -> pay -> conf -> jn
flow sp -> addr -> g3
flow g3 -> bill "yes"
flow g3 -> m3 "no"
flow bill -> m3
flow m3 -> jn
flow jn -> comp -> e1
