tok 1.0 "USI course registration"

pool usi "Sports institute"
  lane applicant "Applicant"
    start s "Want to register for a course"
    task select-course "Select a course"
    xor slots "Slots free?"
    task select-one "Select one course and date"
    task check-account "Check if you have an account"
    xor has-account "Account exists?"
    task check-univ "Check whether you are registered at an eligible university"
    xor eligible "Eligible university?"
    task register-account "Register your account"
    task request-activation "Request an activation"
    task wait-response "Wait for a response"
    xor merge "Account available"
    task login "Log into the account"
    and split "Start"
    task tweet "Tweet to friends"
    task complete-reg "Complete the registration for the course"
    task payment "Provide the payment information"
    and join "Done"
    task receive-ticket "Receive the course ticket"
    end e-ok "Ticket received"
    end e-none "No slots available"
  lane system "System"
    task show-courses "Tell the courses and dates"

flow s -> select-course -> show-courses -> slots
flow slots -> select-one "yes"
flow slots -> e-none "no"
flow select-one -> check-account -> has-account
flow has-account -> merge "yes"
flow has-account -> check-univ "no"
flow check-univ -> eligible
flow eligible -> register-account "yes"
flow eligible -> request-activation "no"
flow register-account -> merge
flow request-activation -> wait-response -> merge -> login -> split
flow split -> tweet
flow split -> complete-reg -> payment
flow tweet -> join
flow payment -> join -> receive-ticket -> e-ok
