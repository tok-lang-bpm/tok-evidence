<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="USI course registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="usi" name="Sports institute" processRef="usi-process" />
  </bpmn:collaboration>
  <bpmn:process id="usi-process" name="USI course registration" isExecutable="false">
    <bpmn:laneSet id="usi-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-univ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait-response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete-reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e-none</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>show-courses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Want to register for a course" />
    <bpmn:task id="select-course" name="Select a course" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" />
    <bpmn:task id="select-one" name="Select one course and date" />
    <bpmn:task id="check-account" name="Check if you have an account" />
    <bpmn:exclusiveGateway id="has-account" name="Account exists?" />
    <bpmn:task id="check-univ" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Eligible university?" />
    <bpmn:task id="register-account" name="Register your account" />
    <bpmn:task id="request-activation" name="Request an activation" />
    <bpmn:task id="wait-response" name="Wait for a response" />
    <bpmn:exclusiveGateway id="merge" name="Account available" />
    <bpmn:task id="login" name="Log into the account" />
    <bpmn:parallelGateway id="split" name="Start" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete-reg" name="Complete the registration for the course" />
    <bpmn:task id="payment" name="Provide the payment information" />
    <bpmn:parallelGateway id="join" name="Done" />
    <bpmn:task id="receive-ticket" name="Receive the course ticket" />
    <bpmn:endEvent id="e-ok" name="Ticket received" />
    <bpmn:endEvent id="e-none" name="No slots available" />
    <bpmn:task id="show-courses" name="Tell the courses and dates" />
    <bpmn:sequenceFlow id="f-s-select-course" sourceRef="s" targetRef="select-course" />
    <bpmn:sequenceFlow id="f-select-course-show-courses" sourceRef="select-course" targetRef="show-courses" />
    <bpmn:sequenceFlow id="f-show-courses-slots" sourceRef="show-courses" targetRef="slots" />
    <bpmn:sequenceFlow id="f-slots-select-one" name="yes" sourceRef="slots" targetRef="select-one" />
    <bpmn:sequenceFlow id="f-slots-e-none" name="no" sourceRef="slots" targetRef="e-none" />
    <bpmn:sequenceFlow id="f-select-one-check-account" sourceRef="select-one" targetRef="check-account" />
    <bpmn:sequenceFlow id="f-check-account-has-account" sourceRef="check-account" targetRef="has-account" />
    <bpmn:sequenceFlow id="f-has-account-merge" name="yes" sourceRef="has-account" targetRef="merge" />
    <bpmn:sequenceFlow id="f-has-account-check-univ" name="no" sourceRef="has-account" targetRef="check-univ" />
    <bpmn:sequenceFlow id="f-check-univ-eligible" sourceRef="check-univ" targetRef="eligible" />
    <bpmn:sequenceFlow id="f-eligible-register-account" name="yes" sourceRef="eligible" targetRef="register-account" />
    <bpmn:sequenceFlow id="f-eligible-request-activation" name="no" sourceRef="eligible" targetRef="request-activation" />
    <bpmn:sequenceFlow id="f-register-account-merge" sourceRef="register-account" targetRef="merge" />
    <bpmn:sequenceFlow id="f-request-activation-wait-response" sourceRef="request-activation" targetRef="wait-response" />
    <bpmn:sequenceFlow id="f-wait-response-merge" sourceRef="wait-response" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-login" sourceRef="merge" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-tweet" sourceRef="split" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-split-complete-reg" sourceRef="split" targetRef="complete-reg" />
    <bpmn:sequenceFlow id="f-complete-reg-payment" sourceRef="complete-reg" targetRef="payment" />
    <bpmn:sequenceFlow id="f-tweet-join" sourceRef="tweet" targetRef="join" />
    <bpmn:sequenceFlow id="f-payment-join" sourceRef="payment" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-receive-ticket" sourceRef="join" targetRef="receive-ticket" />
    <bpmn:sequenceFlow id="f-receive-ticket-e-ok" sourceRef="receive-ticket" targetRef="e-ok" />
  </bpmn:process>
</bpmn:definitions>
