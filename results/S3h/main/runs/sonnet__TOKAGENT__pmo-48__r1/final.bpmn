<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Vienna Night Run App" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="runner" name="Runner">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selblock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getnum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromhome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runnr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Wants to participate" />
    <bpmn:task id="selblock" name="Select starting block" />
    <bpmn:task id="run5" name="Run 5km" />
    <bpmn:exclusiveGateway id="g1" name="Time under 25 minutes?" default="f-g1-train" />
    <bpmn:task id="train" name="Train" />
    <bpmn:task id="getnum" name="Get starting number" />
    <bpmn:task id="findout" name="Find out whether to go from home or from work" />
    <bpmn:exclusiveGateway id="g2" name="More than one hour between starting time and end of workday?" default="f-g2-fromwork" />
    <bpmn:task id="fromhome" name="Go to the Night Run from home" />
    <bpmn:task id="fromwork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="g3" name="" />
    <bpmn:parallelGateway id="g4" name="" />
    <bpmn:task id="runnr" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="g5" name="" />
    <bpmn:task id="receive" name="Receive final running time" />
    <bpmn:endEvent id="e" name="Participated" />
    <bpmn:task id="measure" name="Measure time" />
    <bpmn:sequenceFlow id="f-s-selblock" sourceRef="s" targetRef="selblock" />
    <bpmn:sequenceFlow id="f-selblock-run5" sourceRef="selblock" targetRef="run5" />
    <bpmn:sequenceFlow id="f-run5-measure" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f-measure-g1" sourceRef="measure" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-getnum" name="yes" sourceRef="g1" targetRef="getnum">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-train" name="no" sourceRef="g1" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-run5" sourceRef="train" targetRef="run5" />
    <bpmn:sequenceFlow id="f-getnum-findout" sourceRef="getnum" targetRef="findout" />
    <bpmn:sequenceFlow id="f-findout-g2" sourceRef="findout" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-fromhome" name="yes" sourceRef="g2" targetRef="fromhome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">remaining &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g2-fromwork" name="no" sourceRef="g2" targetRef="fromwork" />
    <bpmn:sequenceFlow id="f-fromhome-g3" sourceRef="fromhome" targetRef="g3" />
    <bpmn:sequenceFlow id="f-fromwork-g3" sourceRef="fromwork" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-g4" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-runnr" sourceRef="g4" targetRef="runnr" />
    <bpmn:sequenceFlow id="f-g4-drink" sourceRef="g4" targetRef="drink" />
    <bpmn:sequenceFlow id="f-runnr-g5" sourceRef="runnr" targetRef="g5" />
    <bpmn:sequenceFlow id="f-drink-g5" sourceRef="drink" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-receive" sourceRef="g5" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-e" sourceRef="receive" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
