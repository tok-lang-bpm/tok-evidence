tok 1.0 "Vienna Night Run"

pool org "Vienna Night Run App"
  lane runner "Runner"
    start s "Wants to participate"
    task selblock "Select starting block"
    task run5 "Run 5km"
    xor g1 "Time under 25 minutes?"
    task train "Train"
    task getnum "Get starting number"
    task findout "Find out whether to go from home or from work"
    xor g2 "More than one hour between starting time and end of workday?"
    task fromhome "Go to the Night Run from home"
    task fromwork "Leave directly from work"
    xor g3 ""
    and g4 ""
    task runnr "Run at the Night Run"
    task drink "Drink"
    and g5 ""
    task receive "Receive final running time"
    end e "Participated"
  lane gadget "Fitness gadget"
    task measure "Measure time"

flow s -> selblock -> run5 -> measure -> g1
flow g1 -> getnum "yes" when="time < 25"
flow g1 -> train "no" default
flow train -> run5
flow getnum -> findout -> g2
flow g2 -> fromhome "yes" when="remaining > 1"
flow g2 -> fromwork "no" default
flow fromhome -> g3
flow fromwork -> g3
flow g3 -> g4
flow g4 -> runnr
flow g4 -> drink
flow runnr -> g5
flow drink -> g5
flow g5 -> receive -> e
