<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Central venous catheter insertion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Hospital" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Central venous catheter insertion" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doc" name="Doctor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>us</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sgel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>punct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>syr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>troc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:parallelGateway id="f1" />
    <bpmn:task id="t1" name="Prepare implements" />
    <bpmn:task id="t2" name="Wash hands" />
    <bpmn:task id="t3" name="Get in sterile clothes" />
    <bpmn:parallelGateway id="j1" />
    <bpmn:task id="clean" name="Clean puncture area" />
    <bpmn:task id="drape" name="Drape puncture zone" />
    <bpmn:parallelGateway id="f2" />
    <bpmn:task id="us" name="Configure ultrasound" />
    <bpmn:task id="gel" name="Put gel in probe" />
    <bpmn:parallelGateway id="j2" />
    <bpmn:task id="cover" name="Cover probe" />
    <bpmn:task id="sgel" name="Put sterile gel" />
    <bpmn:parallelGateway id="f3" />
    <bpmn:task id="pp" name="Position probe" />
    <bpmn:task id="pt" name="Position patient" />
    <bpmn:parallelGateway id="j3" />
    <bpmn:exclusiveGateway id="f4" name="Which identification?" default="f-f4-v3" />
    <bpmn:task id="v1" name="Do anatomic identification" />
    <bpmn:task id="v2" name="Do doppler identification" />
    <bpmn:task id="v3" name="Do compression identification" />
    <bpmn:exclusiveGateway id="j4" />
    <bpmn:task id="anes" name="Anesthetize patient" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="punct" name="Puncture patient" />
    <bpmn:task id="blood" name="Check blood return" />
    <bpmn:exclusiveGateway id="g1" name="Is blood return correct?" default="f-g1-drop" />
    <bpmn:task id="drop" name="Drop probe" />
    <bpmn:task id="syr" name="Remove syringe" />
    <bpmn:task id="gw" name="Install guidewire" />
    <bpmn:task id="troc" name="Remove trocar" />
    <bpmn:exclusiveGateway id="f5" name="Which wire check?" default="f-f5-w2" />
    <bpmn:task id="w1" name="Check wire in long axis" />
    <bpmn:task id="w2" name="Check wire in short axis" />
    <bpmn:exclusiveGateway id="j5" />
    <bpmn:task id="wpos" name="Check wire position" />
    <bpmn:exclusiveGateway id="g2" name="Is wire in good position?" default="f-g2-widen" />
    <bpmn:task id="widen" name="Widen pathway" />
    <bpmn:task id="adv" name="Advance catheter" />
    <bpmn:task id="rgw" name="Remove guidewire" />
    <bpmn:task id="flow" name="Verify flow" />
    <bpmn:task id="reflow" name="Verify reflow" />
    <bpmn:task id="cpos" name="Check catheter position" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-f1" sourceRef="s" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-t1" sourceRef="f1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-f1-t2" sourceRef="f1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-f1-t3" sourceRef="f1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t1-j1" sourceRef="t1" targetRef="j1" />
    <bpmn:sequenceFlow id="f-t2-j1" sourceRef="t2" targetRef="j1" />
    <bpmn:sequenceFlow id="f-t3-j1" sourceRef="t3" targetRef="j1" />
    <bpmn:sequenceFlow id="f-j1-clean" sourceRef="j1" targetRef="clean" />
    <bpmn:sequenceFlow id="f-clean-drape" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-f2" sourceRef="drape" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-us" sourceRef="f2" targetRef="us" />
    <bpmn:sequenceFlow id="f-f2-gel" sourceRef="f2" targetRef="gel" />
    <bpmn:sequenceFlow id="f-us-j2" sourceRef="us" targetRef="j2" />
    <bpmn:sequenceFlow id="f-gel-j2" sourceRef="gel" targetRef="j2" />
    <bpmn:sequenceFlow id="f-j2-cover" sourceRef="j2" targetRef="cover" />
    <bpmn:sequenceFlow id="f-cover-sgel" sourceRef="cover" targetRef="sgel" />
    <bpmn:sequenceFlow id="f-sgel-f3" sourceRef="sgel" targetRef="f3" />
    <bpmn:sequenceFlow id="f-f3-pp" sourceRef="f3" targetRef="pp" />
    <bpmn:sequenceFlow id="f-f3-pt" sourceRef="f3" targetRef="pt" />
    <bpmn:sequenceFlow id="f-pp-j3" sourceRef="pp" targetRef="j3" />
    <bpmn:sequenceFlow id="f-pt-j3" sourceRef="pt" targetRef="j3" />
    <bpmn:sequenceFlow id="f-j3-f4" sourceRef="j3" targetRef="f4" />
    <bpmn:sequenceFlow id="f-f4-v1" name="anatomic" sourceRef="f4" targetRef="v1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-f4-v2" name="doppler" sourceRef="f4" targetRef="v2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">method = 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-f4-v3" name="compression" sourceRef="f4" targetRef="v3" />
    <bpmn:sequenceFlow id="f-v1-j4" sourceRef="v1" targetRef="j4" />
    <bpmn:sequenceFlow id="f-v2-j4" sourceRef="v2" targetRef="j4" />
    <bpmn:sequenceFlow id="f-v3-j4" sourceRef="v3" targetRef="j4" />
    <bpmn:sequenceFlow id="f-j4-anes" sourceRef="j4" targetRef="anes" />
    <bpmn:sequenceFlow id="f-anes-m1" sourceRef="anes" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-punct" sourceRef="m1" targetRef="punct" />
    <bpmn:sequenceFlow id="f-punct-blood" sourceRef="punct" targetRef="blood" />
    <bpmn:sequenceFlow id="f-blood-g1" sourceRef="blood" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-m1" name="no" sourceRef="g1" targetRef="m1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bloodOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g1-drop" name="yes" sourceRef="g1" targetRef="drop" />
    <bpmn:sequenceFlow id="f-drop-syr" sourceRef="drop" targetRef="syr" />
    <bpmn:sequenceFlow id="f-syr-gw" sourceRef="syr" targetRef="gw" />
    <bpmn:sequenceFlow id="f-gw-troc" sourceRef="gw" targetRef="troc" />
    <bpmn:sequenceFlow id="f-troc-f5" sourceRef="troc" targetRef="f5" />
    <bpmn:sequenceFlow id="f-f5-w1" name="long axis" sourceRef="f5" targetRef="w1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">axis = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-f5-w2" name="short axis" sourceRef="f5" targetRef="w2" />
    <bpmn:sequenceFlow id="f-w1-j5" sourceRef="w1" targetRef="j5" />
    <bpmn:sequenceFlow id="f-w2-j5" sourceRef="w2" targetRef="j5" />
    <bpmn:sequenceFlow id="f-j5-wpos" sourceRef="j5" targetRef="wpos" />
    <bpmn:sequenceFlow id="f-wpos-g2" sourceRef="wpos" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-m1" name="no" sourceRef="g2" targetRef="m1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wireOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-g2-widen" name="yes" sourceRef="g2" targetRef="widen" />
    <bpmn:sequenceFlow id="f-widen-adv" sourceRef="widen" targetRef="adv" />
    <bpmn:sequenceFlow id="f-adv-rgw" sourceRef="adv" targetRef="rgw" />
    <bpmn:sequenceFlow id="f-rgw-flow" sourceRef="rgw" targetRef="flow" />
    <bpmn:sequenceFlow id="f-flow-reflow" sourceRef="flow" targetRef="reflow" />
    <bpmn:sequenceFlow id="f-reflow-cpos" sourceRef="reflow" targetRef="cpos" />
    <bpmn:sequenceFlow id="f-cpos-e" sourceRef="cpos" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
