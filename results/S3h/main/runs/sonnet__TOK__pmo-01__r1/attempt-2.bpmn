<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sales" name="Sales staff or customer support">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notInterested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Sales representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Customer inquires about a product or service" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="address" name="Address concerns and questions" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" default="f-interested-notInterested" />
    <bpmn:task id="guide" name="Guide the customer through selecting the product or service" />
    <bpmn:endEvent id="notInterested" name="Customer not interested" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:exclusiveGateway id="approved" name="Customer approves the quote?" default="f-approved-declined" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:endEvent id="declined" name="Quote declined" />
    <bpmn:task id="record" name="Record the order in the system" />
    <bpmn:task id="confirm" name="Send order confirmation to the customer" />
    <bpmn:endEvent id="done" name="Order placed and confirmed" />
    <bpmn:sequenceFlow id="f-inquiry-collect" sourceRef="inquiry" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-address" sourceRef="collect" targetRef="address" />
    <bpmn:sequenceFlow id="f-address-interested" sourceRef="address" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-guide" name="yes" sourceRef="interested" targetRef="guide">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerInterested = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-interested-notInterested" name="no" sourceRef="interested" targetRef="notInterested" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approved" sourceRef="quote" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-place" name="yes" sourceRef="approved" targetRef="place">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">quoteApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-approved-declined" name="no" sourceRef="approved" targetRef="declined" />
    <bpmn:sequenceFlow id="f-place-record" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-confirm" sourceRef="record" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
