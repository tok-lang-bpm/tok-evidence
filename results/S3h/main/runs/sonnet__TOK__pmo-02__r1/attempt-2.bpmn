<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Hiring process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Hiring process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new hire identified" />
    <bpmn:task id="identify" name="Identify the need for a new hire" />
    <bpmn:task id="create" name="Create a job description" />
    <bpmn:task id="post" name="Post the job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interviews" />
    <bpmn:task id="invite" name="Invite selected candidates for interviews" />
    <bpmn:exclusiveGateway id="preference" name="Candidate's preference?" default="f-preference-virtual" />
    <bpmn:task id="inperson" name="Conduct in-person interview" />
    <bpmn:task id="virtual" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="interviewed" />
    <bpmn:task id="choose" name="Choose a candidate" />
    <bpmn:task id="offer" name="Extend an offer" />
    <bpmn:exclusiveGateway id="negotiate" name="Salary negotiation needed?" default="f-negotiate-agreed" />
    <bpmn:task id="negotiation" name="Negotiate the salary" />
    <bpmn:exclusiveGateway id="agreed" />
    <bpmn:task id="paperwork" name="Complete the paperwork" />
    <bpmn:task id="orientation" name="Conduct the orientation" />
    <bpmn:task id="training" name="Conduct the training" />
    <bpmn:task id="integrate" name="Integrate the new hire into the team" />
    <bpmn:endEvent id="done" name="New hire fully integrated" />
    <bpmn:sequenceFlow id="f-need-identify" sourceRef="need" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-post" sourceRef="create" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-invite" sourceRef="phone" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-preference" sourceRef="invite" targetRef="preference" />
    <bpmn:sequenceFlow id="f-preference-inperson" name="in-person" sourceRef="preference" targetRef="inperson">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">preference = "in-person"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-preference-virtual" name="virtual" sourceRef="preference" targetRef="virtual" />
    <bpmn:sequenceFlow id="f-inperson-interviewed" sourceRef="inperson" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-virtual-interviewed" sourceRef="virtual" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-interviewed-choose" sourceRef="interviewed" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-offer" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-negotiate" sourceRef="offer" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-negotiation" name="yes" sourceRef="negotiate" targetRef="negotiation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">negotiationNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-negotiate-agreed" name="no" sourceRef="negotiate" targetRef="agreed" />
    <bpmn:sequenceFlow id="f-negotiation-agreed" sourceRef="negotiation" targetRef="agreed" />
    <bpmn:sequenceFlow id="f-agreed-paperwork" sourceRef="agreed" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-paperwork-orientation" sourceRef="paperwork" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-orientation-training" sourceRef="orientation" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-integrate" sourceRef="training" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-done" sourceRef="integrate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
