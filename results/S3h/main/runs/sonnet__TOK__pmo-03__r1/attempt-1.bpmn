<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inventory restocking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inventory restocking" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Inventory system">
        <bpmn:flowNodeRef>expected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inventory monitoring started" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:task id="signal" name="Signal the need to reorder" />
    <bpmn:task id="inspect" name="Inspect the stock for quality" />
    <bpmn:task id="record" name="Record the stock in the system" />
    <bpmn:task id="shelve" name="Place the stock on shelves or in storage" />
    <bpmn:endEvent id="done" name="Restock completed" />
    <bpmn:task id="order" name="Place an order with suppliers" />
    <bpmn:task id="expected" name="Update the inventory with expected delivery dates" />
    <bpmn:task id="update" name="Update the inventory levels" />
    <bpmn:sequenceFlow id="f-begin-monitor" sourceRef="begin" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-signal" sourceRef="monitor" targetRef="signal" />
    <bpmn:sequenceFlow id="f-signal-order" sourceRef="signal" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-expected" sourceRef="order" targetRef="expected" />
    <bpmn:sequenceFlow id="f-expected-inspect" sourceRef="expected" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-shelve" sourceRef="record" targetRef="shelve" />
    <bpmn:sequenceFlow id="f-shelve-update" sourceRef="shelve" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-done" sourceRef="update" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
