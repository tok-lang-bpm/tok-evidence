tok 1.0 "Inventory restocking"

pool org "Organisation"
  lane warehouse "Warehouse"
    start begin "Inventory monitoring started"
    task monitor "Monitor inventory levels"
    task signal "Signal the need to reorder"
    task inspect "Inspect the stock for quality"
    task record "Record the stock in the system"
    task shelve "Place the stock on shelves or in storage"
    end done "Restock completed"
  lane procurement "Procurement team"
    task order "Place an order with suppliers"
  lane system "Inventory system"
    task expected "Update the inventory with expected delivery dates"
    task update "Update the inventory levels"

flow begin -> monitor -> signal -> order -> expected -> inspect -> record -> shelve -> update -> done
