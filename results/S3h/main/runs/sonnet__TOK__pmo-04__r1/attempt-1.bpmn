<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Campaign needed" />
    <bpmn:task id="define" name="Define the campaign objectives" />
    <bpmn:parallelGateway id="prep" />
    <bpmn:task id="content" name="Create the content" />
    <bpmn:task id="visuals" name="Design the visuals" />
    <bpmn:task id="channels" name="Select the promotion channels" />
    <bpmn:parallelGateway id="prepared" />
    <bpmn:task id="launch" name="Launch the campaign" />
    <bpmn:parallelGateway id="run" />
    <bpmn:task id="track" name="Track the campaign performance" />
    <bpmn:parallelGateway id="ran" />
    <bpmn:task id="analyze" name="Analyze the campaign performance" />
    <bpmn:endEvent id="done" name="Campaign concluded" />
    <bpmn:task id="collect" name="Collect the generated leads" />
    <bpmn:task id="followup" name="Follow up on the leads" />
    <bpmn:sequenceFlow id="f-begin-define" sourceRef="begin" targetRef="define" />
    <bpmn:sequenceFlow id="f-define-prep" sourceRef="define" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-content" sourceRef="prep" targetRef="content" />
    <bpmn:sequenceFlow id="f-prep-visuals" sourceRef="prep" targetRef="visuals" />
    <bpmn:sequenceFlow id="f-prep-channels" sourceRef="prep" targetRef="channels" />
    <bpmn:sequenceFlow id="f-content-prepared" sourceRef="content" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-visuals-prepared" sourceRef="visuals" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-channels-prepared" sourceRef="channels" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prepared-launch" sourceRef="prepared" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-run" sourceRef="launch" targetRef="run" />
    <bpmn:sequenceFlow id="f-run-track" sourceRef="run" targetRef="track" />
    <bpmn:sequenceFlow id="f-run-collect" sourceRef="run" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-followup" sourceRef="collect" targetRef="followup" />
    <bpmn:sequenceFlow id="f-track-ran" sourceRef="track" targetRef="ran" />
    <bpmn:sequenceFlow id="f-followup-ran" sourceRef="followup" targetRef="ran" />
    <bpmn:sequenceFlow id="f-ran-analyze" sourceRef="ran" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-done" sourceRef="analyze" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
