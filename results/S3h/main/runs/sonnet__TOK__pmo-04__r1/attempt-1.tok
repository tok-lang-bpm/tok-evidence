tok 1.0 "Marketing campaign"

pool org "Organisation"
  lane marketing "Marketing team"
    start begin "Campaign needed"
    task define "Define the campaign objectives"
    and prep
    task content "Create the content"
    task visuals "Design the visuals"
    task channels "Select the promotion channels"
    and prepared
    task launch "Launch the campaign"
    and run
    task track "Track the campaign performance"
    and ran
    task analyze "Analyze the campaign performance"
    end done "Campaign concluded"
  lane crm "CRM system"
    task collect "Collect the generated leads"
  lane sales "Sales team"
    task followup "Follow up on the leads"

flow begin -> define -> prep
flow prep -> content
flow prep -> visuals
flow prep -> channels
flow content -> prepared
flow visuals -> prepared
flow channels -> prepared
flow prepared -> launch -> run
flow run -> track
flow run -> collect
flow collect -> followup
flow track -> ran
flow followup -> ran
flow ran -> analyze -> done
