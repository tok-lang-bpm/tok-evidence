<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Order fulfilment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepared</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:serviceTask id="confirm" name="Generate the order confirmation" />
    <bpmn:sendTask id="sendconf" name="Send the order confirmation to the customer" />
    <bpmn:task id="label" name="Generate the shipping label" />
    <bpmn:sendTask id="track" name="Send the tracking information to the customer" />
    <bpmn:parallelGateway id="prep" />
    <bpmn:task id="pick" name="Pick the items" />
    <bpmn:task id="pack" name="Pack the items" />
    <bpmn:parallelGateway id="prepared" />
    <bpmn:task id="handover" name="Hand over the order to the logistics provider" />
    <bpmn:task id="monitor" name="Monitor the shipment" />
    <bpmn:task id="deliver" name="Deliver the shipment to the customer's address" />
    <bpmn:endEvent id="delivered" name="Order delivered" />
    <bpmn:sequenceFlow id="f-placed-confirm" sourceRef="placed" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-sendconf" sourceRef="confirm" targetRef="sendconf" />
    <bpmn:sequenceFlow id="f-sendconf-prep" sourceRef="sendconf" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-pick" sourceRef="prep" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-pack" sourceRef="pick" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-prepared" sourceRef="pack" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prep-label" sourceRef="prep" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-prepared" sourceRef="label" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prepared-handover" sourceRef="prepared" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-track" sourceRef="handover" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-monitor" sourceRef="track" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-deliver" sourceRef="monitor" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-delivered" sourceRef="deliver" targetRef="delivered" />
  </bpmn:process>
</bpmn:definitions>
