<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ticket booking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="booking" name="Ticket booking" processRef="booking-process" />
  </bpmn:collaboration>
  <bpmn:process id="booking-process" name="Ticket booking" isExecutable="false">
    <bpmn:laneSet id="booking-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>searching</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>providepay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedbackq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedbackm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Booking system">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channelm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Travel company">
        <bpmn:flowNodeRef>inventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="searching" name="Customer searches for a ticket" />
    <bpmn:task id="select" name="Select the route, date and time" />
    <bpmn:task id="provideinfo" name="Provide personal information" />
    <bpmn:task id="providepay" name="Provide payment details" />
    <bpmn:task id="travel" name="Complete the journey" />
    <bpmn:exclusiveGateway id="feedbackq" name="Feedback or services wanted?" />
    <bpmn:task id="feedback" name="Provide post-travel feedback" />
    <bpmn:exclusiveGateway id="feedbackm" />
    <bpmn:endEvent id="done" name="Process concluded" />
    <bpmn:task id="generate" name="Generate the ticket" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="channel" name="Email or SMS?" />
    <bpmn:task id="email" name="Send the ticket by email" />
    <bpmn:task id="sms" name="Send the ticket by SMS" />
    <bpmn:exclusiveGateway id="channelm" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="remind" name="Send reminders and check-in or boarding instructions" />
    <bpmn:task id="inventory" name="Update the seat inventory" />
    <bpmn:sequenceFlow id="f-searching-select" sourceRef="searching" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-provideinfo" sourceRef="select" targetRef="provideinfo" />
    <bpmn:sequenceFlow id="f-provideinfo-providepay" sourceRef="provideinfo" targetRef="providepay" />
    <bpmn:sequenceFlow id="f-providepay-generate" sourceRef="providepay" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-split" sourceRef="generate" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-channel" sourceRef="split" targetRef="channel" />
    <bpmn:sequenceFlow id="f-split-inventory" sourceRef="split" targetRef="inventory" />
    <bpmn:sequenceFlow id="f-channel-email" name="email" sourceRef="channel" targetRef="email" />
    <bpmn:sequenceFlow id="f-channel-sms" name="SMS" sourceRef="channel" targetRef="sms" />
    <bpmn:sequenceFlow id="f-email-channelm" sourceRef="email" targetRef="channelm" />
    <bpmn:sequenceFlow id="f-sms-channelm" sourceRef="sms" targetRef="channelm" />
    <bpmn:sequenceFlow id="f-channelm-joined" sourceRef="channelm" targetRef="joined" />
    <bpmn:sequenceFlow id="f-inventory-joined" sourceRef="inventory" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-remind" sourceRef="joined" targetRef="remind" />
    <bpmn:sequenceFlow id="f-remind-travel" sourceRef="remind" targetRef="travel" />
    <bpmn:sequenceFlow id="f-travel-feedbackq" sourceRef="travel" targetRef="feedbackq" />
    <bpmn:sequenceFlow id="f-feedbackq-feedback" name="yes" sourceRef="feedbackq" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedbackq-feedbackm" name="no" sourceRef="feedbackq" targetRef="feedbackm" />
    <bpmn:sequenceFlow id="f-feedback-feedbackm" sourceRef="feedback" targetRef="feedbackm" />
    <bpmn:sequenceFlow id="f-feedbackm-done" sourceRef="feedbackm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
