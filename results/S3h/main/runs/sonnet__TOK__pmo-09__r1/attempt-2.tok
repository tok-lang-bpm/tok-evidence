tok 1.0 "Product prototype development"

pool org "Organisation"
  lane rd "R&D team"
    start begin "Idea needed"
    task identify "Identify an idea for a new product or improvement"
    task research "Conduct initial research and feasibility studies"
    task draft "Draft design concepts"
    task select "Select a promising design"
    task build "Build a prototype"
    xor testin
    task test "Test the prototype"
    task collect "Collect feedback from the testing phase"
    xor refine "Refinement needed?"
    task refineproto "Refine the prototype"
    xor outcome "Prototype approved?"
    end approved "Prototype approved for further development"
    end discarded "Prototype discarded"

flow begin -> identify -> research -> draft -> select -> build -> testin -> test -> collect -> refine
flow refine -> refineproto "yes" when="refinement = true"
flow refineproto -> testin
flow refine -> outcome "no" default
flow outcome -> approved "yes" when="approved = true"
flow outcome -> discarded "no" default
