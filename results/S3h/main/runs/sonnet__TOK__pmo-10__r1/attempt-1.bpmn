<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IT solution request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="IT solution request handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="requester" name="Employee or department">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkcompat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="IT solution needed" />
    <bpmn:task id="submit" name="Submit the request for an IT solution" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:task id="checkcompat" name="Check compatibility with existing systems" />
    <bpmn:task id="evaluate" name="Evaluate cost and resource needs" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" default="f-approved-rejected" />
    <bpmn:task id="procure" name="Procure the necessary tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in a controlled environment" />
    <bpmn:exclusiveGateway id="passed" name="Test successful?" default="f-passed-install" />
    <bpmn:task id="rollout" name="Roll out the solution to the requesting department" />
    <bpmn:exclusiveGateway id="training" name="Training needed?" default="f-training-trainjoin" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:exclusiveGateway id="trainjoin" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="done" name="Solution in use" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f-begin-submit" sourceRef="begin" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assess" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-checkcompat" sourceRef="assess" targetRef="checkcompat" />
    <bpmn:sequenceFlow id="f-checkcompat-evaluate" sourceRef="checkcompat" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-approved" sourceRef="evaluate" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="yes" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approved-rejected" name="no" sourceRef="approved" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-passed" sourceRef="test" targetRef="passed" />
    <bpmn:sequenceFlow id="f-passed-rollout" name="yes" sourceRef="passed" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-passed-install" name="no" sourceRef="passed" targetRef="install" />
    <bpmn:sequenceFlow id="f-rollout-training" sourceRef="rollout" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-train" name="yes" sourceRef="training" targetRef="train" />
    <bpmn:sequenceFlow id="f-training-trainjoin" name="no" sourceRef="training" targetRef="trainjoin" />
    <bpmn:sequenceFlow id="f-train-trainjoin" sourceRef="train" targetRef="trainjoin" />
    <bpmn:sequenceFlow id="f-trainjoin-support" sourceRef="trainjoin" targetRef="support" />
    <bpmn:sequenceFlow id="f-support-done" sourceRef="support" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
