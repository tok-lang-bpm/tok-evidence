tok 1.0 "IT solution request handling"

pool org "Organisation"
  lane requester "Employee or department"
    start begin "IT solution needed"
    task submit "Submit the request for an IT solution"
  lane it "IT"
    task assess "Assess the request"
    task checkcompat "Check compatibility with existing systems"
    task evaluate "Evaluate cost and resource needs"
    xor approved "Request approved?"
    task procure "Procure the necessary tools or licenses"
    task install "Install the solution"
    task test "Test the solution in a controlled environment"
    xor passed "Test successful?"
    task rollout "Roll out the solution to the requesting department"
    xor training "Training needed?"
    task train "Provide training"
    xor trainjoin
    task support "Provide IT support for troubleshooting"
    end done "Solution in use"
    end rejected "Request rejected"

flow begin -> submit -> assess -> checkcompat -> evaluate -> approved
flow approved -> procure "yes" when="approved = true"
flow approved -> rejected "no" default
flow procure -> install -> test -> passed
flow passed -> rollout "yes" when="testSuccessful = true"
flow passed -> install "no" default
flow rollout -> training
flow training -> train "yes" when="trainingNeeded = true"
flow training -> trainjoin "no" default
flow train -> trainjoin
flow trainjoin -> support -> done
