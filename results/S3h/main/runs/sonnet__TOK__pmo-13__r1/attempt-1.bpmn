<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>filed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Relevant department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Financial team">
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="filed" name="Complaint filed" />
    <bpmn:task id="file" name="File the complaint" />
    <bpmn:task id="feedback" name="Provide feedback on satisfaction" />
    <bpmn:endEvent id="done" name="Case closed" />
    <bpmn:task id="log" name="Log the complaint" />
    <bpmn:task id="assign" name="Assign the complaint to the relevant department" />
    <bpmn:task id="notify" name="Notify the customer with the decision" />
    <bpmn:exclusiveGateway id="approved" name="Refund approved?" default="f-approved-joined" />
    <bpmn:exclusiveGateway id="joined" />
    <bpmn:task id="resolve" name="Mark the complaint as resolved" />
    <bpmn:task id="review" name="Review the details" />
    <bpmn:task id="decide" name="Determine whether the complaint is valid and a refund is justified" />
    <bpmn:task id="reimburse" name="Process the reimbursement" />
    <bpmn:sequenceFlow id="f-filed-file" sourceRef="filed" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-log" sourceRef="file" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-review" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-notify" sourceRef="decide" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-approved" sourceRef="notify" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-reimburse" name="yes" sourceRef="approved" targetRef="reimburse" />
    <bpmn:sequenceFlow id="f-approved-joined" name="no" sourceRef="approved" targetRef="joined" />
    <bpmn:sequenceFlow id="f-reimburse-joined" sourceRef="reimburse" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-resolve" sourceRef="joined" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-feedback" sourceRef="resolve" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-done" sourceRef="feedback" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
