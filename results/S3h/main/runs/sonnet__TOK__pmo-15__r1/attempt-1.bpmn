<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfassess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalaudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="scheduled" name="Compliance audit scheduled" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="selfassess" name="Conduct self-assessment" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="correct" name="Make corrections and improvements" />
    <bpmn:endEvent id="finished" name="Process concluded" />
    <bpmn:task id="review" name="Review the company's processes" />
    <bpmn:task id="identify" name="Identify gaps and issues" />
    <bpmn:task id="finalaudit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="met" name="All criteria met?" default="f-met-merge" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:sequenceFlow id="f-scheduled-prepare" sourceRef="scheduled" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-selfassess" sourceRef="gather" targetRef="selfassess" />
    <bpmn:sequenceFlow id="f-selfassess-review" sourceRef="selfassess" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-identify" sourceRef="review" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-merge" sourceRef="identify" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-correct" sourceRef="merge" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-finalaudit" sourceRef="correct" targetRef="finalaudit" />
    <bpmn:sequenceFlow id="f-finalaudit-met" sourceRef="finalaudit" targetRef="met" />
    <bpmn:sequenceFlow id="f-met-award" name="yes" sourceRef="met" targetRef="award">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">criteriaMet = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-met-merge" name="no" sourceRef="met" targetRef="merge" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-finished" sourceRef="issue" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
