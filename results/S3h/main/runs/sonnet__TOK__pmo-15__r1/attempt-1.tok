tok 1.0 "Compliance audit"

pool org "Organisation"
  lane company "Company"
    start scheduled "Compliance audit scheduled"
    task prepare "Prepare documentation"
    task gather "Gather evidence"
    task selfassess "Conduct self-assessment"
    xor merge
    task correct "Make corrections and improvements"
    end finished "Process concluded"
  lane auditors "Auditors"
    task review "Review the company's processes"
    task identify "Identify gaps and issues"
    task finalaudit "Conduct final audit"
    xor met "All criteria met?"
    task award "Award certification"
    task issue "Issue official documents"

flow scheduled -> prepare -> gather -> selfassess -> review -> identify -> merge -> correct -> finalaudit -> met
flow met -> award "yes" when="criteriaMet = true"
flow met -> merge "no" default
flow award -> issue -> finished
