<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="audit" name="Annual audit" processRef="audit-process" />
  </bpmn:collaboration>
  <bpmn:process id="audit-process" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="audit-lanes">
      <bpmn:lane id="coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>checkreg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Central audit team">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>high</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sitegw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sitemerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>reviewrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Audit needed" />
    <bpmn:task id="notify" name="Send a notification to the regional office" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="prepare" name="Prepare financial statements" />
    <bpmn:task id="gather" name="Gather necessary documents" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="submit" name="Submit the documents to the central audit team" />
    <bpmn:task id="clarify" name="Provide the necessary clarifications" />
    <bpmn:task id="checkreg" name="Check regulatory updates" />
    <bpmn:task id="review" name="Review the submission" />
    <bpmn:exclusiveGateway id="disc" name="Discrepancies found?" />
    <bpmn:task id="request" name="Request clarifications from the regional office" />
    <bpmn:adHocSubProcess id="risk" name="Conduct a risk assessment">
      <bpmn:task id="finrisk" name="Evaluate financial risks" />
      <bpmn:task id="oprisk" name="Evaluate operational risks" />
      <bpmn:task id="comprisk" name="Evaluate compliance risks" />
    </bpmn:adHocSubProcess>
    <bpmn:exclusiveGateway id="high" name="High risk identified?" />
    <bpmn:task id="investigate" name="Launch a detailed investigation" />
    <bpmn:parallelGateway id="invsplit" />
    <bpmn:task id="analyze" name="Perform data analysis" />
    <bpmn:task id="interview" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="sitegw" name="Site visit needed?" />
    <bpmn:task id="visit" name="Conduct site visits" />
    <bpmn:exclusiveGateway id="sitemerge" />
    <bpmn:parallelGateway id="invjoin" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="compile" name="Compile the audit report" />
    <bpmn:task id="update" name="Update the report" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="distribute" name="Distribute the final report to the executive board" />
    <bpmn:task id="archive" name="Archive the final report" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="close" name="Close the audit process" />
    <bpmn:endEvent id="done" name="Audit process closed" />
    <bpmn:task id="reviewrep" name="Review the report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:sequenceFlow id="f-begin-notify" sourceRef="begin" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-split1" sourceRef="notify" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-prepare" sourceRef="split1" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-join1" sourceRef="gather" targetRef="join1" />
    <bpmn:sequenceFlow id="f-split1-checkreg" sourceRef="split1" targetRef="checkreg" />
    <bpmn:sequenceFlow id="f-checkreg-join1" sourceRef="checkreg" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-submit" sourceRef="join1" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-disc" sourceRef="review" targetRef="disc" />
    <bpmn:sequenceFlow id="f-disc-request" name="yes" sourceRef="disc" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-clarify" sourceRef="request" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-review" sourceRef="clarify" targetRef="review" />
    <bpmn:sequenceFlow id="f-disc-risk" name="no" sourceRef="disc" targetRef="risk" />
    <bpmn:sequenceFlow id="f-risk-high" sourceRef="risk" targetRef="high" />
    <bpmn:sequenceFlow id="f-high-investigate" name="yes" sourceRef="high" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-invsplit" sourceRef="investigate" targetRef="invsplit" />
    <bpmn:sequenceFlow id="f-invsplit-analyze" sourceRef="invsplit" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-invjoin" sourceRef="analyze" targetRef="invjoin" />
    <bpmn:sequenceFlow id="f-invsplit-interview" sourceRef="invsplit" targetRef="interview" />
    <bpmn:sequenceFlow id="f-interview-invjoin" sourceRef="interview" targetRef="invjoin" />
    <bpmn:sequenceFlow id="f-invsplit-sitegw" sourceRef="invsplit" targetRef="sitegw" />
    <bpmn:sequenceFlow id="f-sitegw-visit" name="yes" sourceRef="sitegw" targetRef="visit" />
    <bpmn:sequenceFlow id="f-visit-sitemerge" sourceRef="visit" targetRef="sitemerge" />
    <bpmn:sequenceFlow id="f-sitegw-sitemerge" name="no" sourceRef="sitegw" targetRef="sitemerge" />
    <bpmn:sequenceFlow id="f-sitemerge-invjoin" sourceRef="sitemerge" targetRef="invjoin" />
    <bpmn:sequenceFlow id="f-invjoin-merge" sourceRef="invjoin" targetRef="merge" />
    <bpmn:sequenceFlow id="f-high-merge" name="no" sourceRef="high" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-compile" sourceRef="merge" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compile-reviewrep" sourceRef="compile" targetRef="reviewrep" />
    <bpmn:sequenceFlow id="f-reviewrep-approved" sourceRef="reviewrep" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-split2" name="yes" sourceRef="approved" targetRef="split2" />
    <bpmn:sequenceFlow id="f-approved-update" name="no" sourceRef="approved" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-reviewrep" sourceRef="update" targetRef="reviewrep" />
    <bpmn:sequenceFlow id="f-split2-distribute" sourceRef="split2" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-join2" sourceRef="distribute" targetRef="join2" />
    <bpmn:sequenceFlow id="f-split2-archive" sourceRef="split2" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-join2" sourceRef="archive" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-close" sourceRef="join2" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-done" sourceRef="close" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
