<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="E-commerce company" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivebo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stockok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping department">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:task id="record" name="Record the order details" />
    <bpmn:task id="pay" name="Process the payment" />
    <bpmn:exclusiveGateway id="paid" name="Payment successful?" />
    <bpmn:task id="notifyfail" name="Notify the customer about the failed payment" />
    <bpmn:endEvent id="failed" name="Order cancelled" />
    <bpmn:task id="check" name="Check stock availability" />
    <bpmn:exclusiveGateway id="instock" name="Items in stock?" />
    <bpmn:task id="backorder" name="Initiate a back-order" />
    <bpmn:task id="delay" name="Inform the customer about the delay" />
    <bpmn:task id="receivebo" name="Receive the back-order" />
    <bpmn:exclusiveGateway id="stockok" />
    <bpmn:task id="confirm" name="Send the shipping confirmation" />
    <bpmn:task id="update" name="Update the inventory levels" />
    <bpmn:task id="delivered" name="Confirm the successful delivery" />
    <bpmn:task id="followup" name="Send the follow-up feedback email" />
    <bpmn:exclusiveGateway id="issues" name="Customer reported issues?" />
    <bpmn:task id="label" name="Send the return shipping label" />
    <bpmn:task id="refund" name="Process the refund or replacement" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:endEvent id="returned" name="Return processed" />
    <bpmn:task id="pick" name="Pick the in-stock items" />
    <bpmn:task id="qc" name="Perform the quality control checks" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="package" name="Package the order" />
    <bpmn:exclusiveGateway id="giftq" name="Gift wrapping requested?" />
    <bpmn:task id="wrap" name="Wrap the gift" />
    <bpmn:exclusiveGateway id="giftm" />
    <bpmn:task id="receiveret" name="Receive the returned items" />
    <bpmn:task id="inspect" name="Inspect the returned items" />
    <bpmn:task id="docs" name="Prepare the shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs" name="Prepare the customs documentation" />
    <bpmn:exclusiveGateway id="intlm" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:sequenceFlow id="f-placed-record" sourceRef="placed" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-pay" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-paid" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f-paid-notifyfail" name="no" sourceRef="paid" targetRef="notifyfail" />
    <bpmn:sequenceFlow id="f-notifyfail-failed" sourceRef="notifyfail" targetRef="failed" />
    <bpmn:sequenceFlow id="f-paid-check" name="yes" sourceRef="paid" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-instock" sourceRef="check" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-backorder" name="no" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-backorder-delay" sourceRef="backorder" targetRef="delay" />
    <bpmn:sequenceFlow id="f-delay-receivebo" sourceRef="delay" targetRef="receivebo" />
    <bpmn:sequenceFlow id="f-receivebo-stockok" sourceRef="receivebo" targetRef="stockok" />
    <bpmn:sequenceFlow id="f-instock-stockok" name="yes" sourceRef="instock" targetRef="stockok" />
    <bpmn:sequenceFlow id="f-stockok-pick" sourceRef="stockok" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-fork" sourceRef="qc" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-package" sourceRef="fork" targetRef="package" />
    <bpmn:sequenceFlow id="f-package-giftq" sourceRef="package" targetRef="giftq" />
    <bpmn:sequenceFlow id="f-giftq-wrap" name="yes" sourceRef="giftq" targetRef="wrap" />
    <bpmn:sequenceFlow id="f-wrap-giftm" sourceRef="wrap" targetRef="giftm" />
    <bpmn:sequenceFlow id="f-giftq-giftm" name="no" sourceRef="giftq" targetRef="giftm" />
    <bpmn:sequenceFlow id="f-giftm-join" sourceRef="giftm" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-docs" sourceRef="fork" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-intl" sourceRef="docs" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-customs" name="yes" sourceRef="intl" targetRef="customs" />
    <bpmn:sequenceFlow id="f-customs-intlm" sourceRef="customs" targetRef="intlm" />
    <bpmn:sequenceFlow id="f-intl-intlm" name="no" sourceRef="intl" targetRef="intlm" />
    <bpmn:sequenceFlow id="f-intlm-join" sourceRef="intlm" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-dispatch" sourceRef="join" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-confirm" sourceRef="dispatch" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-update" sourceRef="confirm" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-delivered" sourceRef="update" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-followup" sourceRef="delivered" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-issues" sourceRef="followup" targetRef="issues" />
    <bpmn:sequenceFlow id="f-issues-completed" name="no" sourceRef="issues" targetRef="completed" />
    <bpmn:sequenceFlow id="f-issues-label" name="yes" sourceRef="issues" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-receiveret" sourceRef="label" targetRef="receiveret" />
    <bpmn:sequenceFlow id="f-receiveret-inspect" sourceRef="receiveret" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-refund" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-returned" sourceRef="refund" targetRef="returned" />
  </bpmn:process>
</bpmn:definitions>
