<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Enrollment_confirmation" name="Enrollment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>applying</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>idcard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changesmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appealform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appealmeet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievancemerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions office">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Admissions committee">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT department">
        <bpmn:flowNodeRef>accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="intloffice" name="International student office">
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="applying" name="Application needed" />
    <bpmn:task id="submit" name="Submit the application online" />
    <bpmn:task id="provide" name="Provide the missing items" />
    <bpmn:eventBasedGateway id="await" name="Confirmation by the deadline?" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Enrollment confirmed">
      <bpmn:messageEventDefinition id="confirmed-def" messageRef="Message_Enrollment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="deadline" name="Deadline passed">
      <bpmn:timerEventDefinition id="deadline-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="idcard" name="Obtain the student ID card" />
    <bpmn:task id="meet" name="Meet with the academic advisor" />
    <bpmn:task id="select" name="Select courses" />
    <bpmn:task id="resolve" name="Resolve schedule conflicts" />
    <bpmn:task id="attend" name="Attend classes" />
    <bpmn:exclusiveGateway id="changes" name="Add or drop courses?" />
    <bpmn:task id="adddrop" name="Add or drop courses" />
    <bpmn:exclusiveGateway id="changesmerge" />
    <bpmn:task id="review" name="Review the grades online" />
    <bpmn:exclusiveGateway id="grievance" name="Any grievances?" />
    <bpmn:task id="appealform" name="Submit an appeal form" />
    <bpmn:task id="appealmeet" name="Meet with the appeals committee" />
    <bpmn:task id="decision" name="Await the appeal decision" />
    <bpmn:exclusiveGateway id="grievancemerge" />
    <bpmn:exclusiveGateway id="finished" name="Graduated or withdrawn?" />
    <bpmn:endEvent id="left" name="Student graduated or withdrew" />
    <bpmn:endEvent id="cancelled" name="Application canceled" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:task id="check" name="Review the application and supporting documents" />
    <bpmn:exclusiveGateway id="complete" name="Documents complete?" />
    <bpmn:task id="notify" name="Notify the applicant about the missing documents" />
    <bpmn:parallelGateway id="split" name="Evaluate and process fees" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" />
    <bpmn:task id="accept" name="Send the acceptance letter" />
    <bpmn:task id="reject" name="Send the rejection letter" />
    <bpmn:task id="cancel" name="Cancel the application" />
    <bpmn:parallelGateway id="onboard" />
    <bpmn:task id="orientation" name="Send the orientation materials" />
    <bpmn:exclusiveGateway id="intl" name="International student?" />
    <bpmn:exclusiveGateway id="intlmerge" />
    <bpmn:parallelGateway id="onboarded" />
    <bpmn:task id="grades" name="Post the grades" />
    <bpmn:task id="evaluate" name="Evaluate the application" />
    <bpmn:task id="fees" name="Process the application fees or waivers" />
    <bpmn:task id="accounts" name="Set up student accounts for email, online portals and library access" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:sequenceFlow id="f-applying-submit" sourceRef="applying" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check" sourceRef="submit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-complete" sourceRef="check" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-notify" name="no" sourceRef="complete" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-provide" sourceRef="notify" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-check" sourceRef="provide" targetRef="check" />
    <bpmn:sequenceFlow id="f-complete-split" name="yes" sourceRef="complete" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-evaluate" sourceRef="split" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-joined" sourceRef="evaluate" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-fees" sourceRef="split" targetRef="fees" />
    <bpmn:sequenceFlow id="f-fees-joined" sourceRef="fees" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-accepted" sourceRef="joined" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-accept" name="yes" sourceRef="accepted" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-await" sourceRef="accept" targetRef="await" />
    <bpmn:sequenceFlow id="f-await-confirmed" sourceRef="await" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-await-deadline" sourceRef="await" targetRef="deadline" />
    <bpmn:sequenceFlow id="f-deadline-cancel" sourceRef="deadline" targetRef="cancel" />
    <bpmn:sequenceFlow id="f-cancel-cancelled" sourceRef="cancel" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-confirmed-onboard" sourceRef="confirmed" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-onboard-orientation" sourceRef="onboard" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-orientation-onboarded" sourceRef="orientation" targetRef="onboarded" />
    <bpmn:sequenceFlow id="f-onboard-accounts" sourceRef="onboard" targetRef="accounts" />
    <bpmn:sequenceFlow id="f-accounts-onboarded" sourceRef="accounts" targetRef="onboarded" />
    <bpmn:sequenceFlow id="f-onboard-intl" sourceRef="onboard" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-visa" name="yes" sourceRef="intl" targetRef="visa" />
    <bpmn:sequenceFlow id="f-intl-intlmerge" name="no" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-visa-intlmerge" sourceRef="visa" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intlmerge-onboarded" sourceRef="intlmerge" targetRef="onboarded" />
    <bpmn:sequenceFlow id="f-onboarded-idcard" sourceRef="onboarded" targetRef="idcard" />
    <bpmn:sequenceFlow id="f-idcard-meet" sourceRef="idcard" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-select" sourceRef="meet" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-resolve" sourceRef="select" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-attend" sourceRef="resolve" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-changes" sourceRef="attend" targetRef="changes" />
    <bpmn:sequenceFlow id="f-changes-adddrop" name="yes" sourceRef="changes" targetRef="adddrop" />
    <bpmn:sequenceFlow id="f-changes-changesmerge" name="no" sourceRef="changes" targetRef="changesmerge" />
    <bpmn:sequenceFlow id="f-adddrop-changesmerge" sourceRef="adddrop" targetRef="changesmerge" />
    <bpmn:sequenceFlow id="f-changesmerge-grades" sourceRef="changesmerge" targetRef="grades" />
    <bpmn:sequenceFlow id="f-grades-review" sourceRef="grades" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-grievance" sourceRef="review" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-appealform" name="yes" sourceRef="grievance" targetRef="appealform" />
    <bpmn:sequenceFlow id="f-appealform-appealmeet" sourceRef="appealform" targetRef="appealmeet" />
    <bpmn:sequenceFlow id="f-appealmeet-decision" sourceRef="appealmeet" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-grievancemerge" sourceRef="decision" targetRef="grievancemerge" />
    <bpmn:sequenceFlow id="f-grievance-grievancemerge" name="no" sourceRef="grievance" targetRef="grievancemerge" />
    <bpmn:sequenceFlow id="f-grievancemerge-finished" sourceRef="grievancemerge" targetRef="finished" />
    <bpmn:sequenceFlow id="f-finished-left" name="yes" sourceRef="finished" targetRef="left" />
    <bpmn:sequenceFlow id="f-finished-attend" name="no" sourceRef="finished" targetRef="attend" />
  </bpmn:process>
</bpmn:definitions>
