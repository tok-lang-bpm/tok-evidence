<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop purchase" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Online shop purchase" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>how</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="seller" name="Online shop">
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Order started" />
    <bpmn:task id="login" name="Log in to the account" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="select" name="Select the items to purchase" />
    <bpmn:task id="reward" name="Choose a free reward" />
    <bpmn:task id="payment" name="Set a payment method" />
    <bpmn:exclusiveGateway id="how" name="Pay or installment?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete an installment agreement" />
    <bpmn:exclusiveGateway id="paid" />
    <bpmn:parallelGateway id="ready" />
    <bpmn:task id="return" name="Return the items for exchange" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="deliver" name="Deliver the items" />
    <bpmn:exclusiveGateway id="returned" name="Items returned?" default="f-returned-done" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:sequenceFlow id="f-begin-login" sourceRef="begin" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-select" sourceRef="split" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-reward" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f-reward-ready" sourceRef="reward" targetRef="ready" />
    <bpmn:sequenceFlow id="f-split-payment" sourceRef="split" targetRef="payment" />
    <bpmn:sequenceFlow id="f-payment-how" sourceRef="payment" targetRef="how" />
    <bpmn:sequenceFlow id="f-how-pay" name="pay" sourceRef="how" targetRef="pay" />
    <bpmn:sequenceFlow id="f-how-installment" name="installment" sourceRef="how" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-paid" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f-installment-paid" sourceRef="installment" targetRef="paid" />
    <bpmn:sequenceFlow id="f-paid-ready" sourceRef="paid" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-again" sourceRef="ready" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-deliver" sourceRef="again" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-returned" sourceRef="deliver" targetRef="returned" />
    <bpmn:sequenceFlow id="f-returned-return" name="yes" sourceRef="returned" targetRef="return" />
    <bpmn:sequenceFlow id="f-returned-done" name="no" sourceRef="returned" targetRef="done" />
    <bpmn:sequenceFlow id="f-return-again" sourceRef="return" targetRef="again" />
  </bpmn:process>
</bpmn:definitions>
