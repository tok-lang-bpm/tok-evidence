<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Shipping of goods" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Shipping of goods" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Logistics department head">
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="large" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one logistic company" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="label" name="Write package label" />
    <bpmn:parallelGateway id="ready" />
    <bpmn:exclusiveGateway id="shipped" />
    <bpmn:exclusiveGateway id="insurance" name="Insurance necessary?" />
    <bpmn:task id="insure" name="Take parcel insurance" />
    <bpmn:exclusiveGateway id="insured" />
    <bpmn:task id="package" name="Package the goods" />
    <bpmn:task id="prepare" name="Prepare the packaged goods for pick-up" />
    <bpmn:endEvent id="done" name="Goods ready for pick-up" />
    <bpmn:sequenceFlow id="f-needed-clarify" sourceRef="needed" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-large" sourceRef="clarify" targetRef="large" />
    <bpmn:sequenceFlow id="f-large-invite" name="yes" sourceRef="large" targetRef="invite" />
    <bpmn:sequenceFlow id="f-large-split" name="no" sourceRef="large" targetRef="split" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-shipped" sourceRef="select" targetRef="shipped" />
    <bpmn:sequenceFlow id="f-split-label" sourceRef="split" targetRef="label" />
    <bpmn:sequenceFlow id="f-split-insurance" sourceRef="split" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-split-package" sourceRef="split" targetRef="package" />
    <bpmn:sequenceFlow id="f-insurance-insure" name="yes" sourceRef="insurance" targetRef="insure" />
    <bpmn:sequenceFlow id="f-insurance-insured" name="no" sourceRef="insurance" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insure-insured" sourceRef="insure" targetRef="insured" />
    <bpmn:sequenceFlow id="f-label-ready" sourceRef="label" targetRef="ready" />
    <bpmn:sequenceFlow id="f-insured-ready" sourceRef="insured" targetRef="ready" />
    <bpmn:sequenceFlow id="f-package-ready" sourceRef="package" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-shipped" sourceRef="ready" targetRef="shipped" />
    <bpmn:sequenceFlow id="f-shipped-prepare" sourceRef="shipped" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-done" sourceRef="prepare" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
