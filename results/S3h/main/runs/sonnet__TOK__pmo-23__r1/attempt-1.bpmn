<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>see</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Banking system">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delay_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Agency">
        <bpmn:flowNodeRef>level1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Credit-scoring needed" />
    <bpmn:task id="request" name="Request the credit-scoring" />
    <bpmn:task id="check" name="Check again later" />
    <bpmn:task id="see" name="See the result at the frontend" />
    <bpmn:endEvent id="done" name="Scoring result seen" />
    <bpmn:task id="send" name="Send the scoring request to the agency" />
    <bpmn:task id="delay_msg" name="Display a delay message to the clerk" />
    <bpmn:task id="present" name="Present the result to the clerk" />
    <bpmn:task id="level1" name="Do the first quick scoring (level 1)" />
    <bpmn:exclusiveGateway id="immediate" name="Result determined immediately?" />
    <bpmn:task id="return" name="Return the result to the banking system" />
    <bpmn:task id="inform" name="Inform the banking process of the delay" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="level2" name="Do the level 2 scoring" />
    <bpmn:task id="sendback" name="Send the scoring result to the banking process" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:sequenceFlow id="f-needed-request" sourceRef="needed" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-send" sourceRef="request" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-level1" sourceRef="send" targetRef="level1" />
    <bpmn:sequenceFlow id="f-level1-immediate" sourceRef="level1" targetRef="immediate" />
    <bpmn:sequenceFlow id="f-immediate-return" name="yes" sourceRef="immediate" targetRef="return" />
    <bpmn:sequenceFlow id="f-immediate-inform" name="no" sourceRef="immediate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-split" sourceRef="inform" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-delay_msg" sourceRef="split" targetRef="delay_msg" />
    <bpmn:sequenceFlow id="f-split-level2" sourceRef="split" targetRef="level2" />
    <bpmn:sequenceFlow id="f-delay_msg-check" sourceRef="delay_msg" targetRef="check" />
    <bpmn:sequenceFlow id="f-level2-sendback" sourceRef="level2" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-check-join" sourceRef="check" targetRef="join" />
    <bpmn:sequenceFlow id="f-sendback-join" sourceRef="sendback" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-merge" sourceRef="join" targetRef="merge" />
    <bpmn:sequenceFlow id="f-return-merge" sourceRef="return" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-present" sourceRef="merge" targetRef="present" />
    <bpmn:sequenceFlow id="f-present-see" sourceRef="present" targetRef="see" />
    <bpmn:sequenceFlow id="f-see-done" sourceRef="see" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
