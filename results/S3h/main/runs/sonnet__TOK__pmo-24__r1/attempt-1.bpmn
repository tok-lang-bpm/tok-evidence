<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Restaurant meal ordering" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Guest_appears" name="Guest appears" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant meal ordering" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>hungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enterorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passbuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informchef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appears</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callguest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informemp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="hungry" name="Guest feels hungry" />
    <bpmn:task id="enter" name="Enter the restaurant" />
    <bpmn:task id="choose" name="Choose a dish" />
    <bpmn:task id="wait" name="Wait for his turn" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="pickup" name="Pick up the meal" />
    <bpmn:task id="eat" name="Eat the meal" />
    <bpmn:endEvent id="done" name="Meal eaten" />
    <bpmn:task id="enterorder" name="Enter the order into the POS system" />
    <bpmn:task id="collect" name="Collect the money" />
    <bpmn:task id="setup" name="Set up the buzzer" />
    <bpmn:task id="passbuzzer" name="Pass the buzzer on to the guest" />
    <bpmn:task id="informchef" name="Inform the chef of the new order" />
    <bpmn:task id="setoff" name="Set off the buzzer" />
    <bpmn:eventBasedGateway id="reaction" />
    <bpmn:intermediateCatchEvent id="appears" name="Guest appears at the service hatch">
      <bpmn:messageEventDefinition id="appears-def" messageRef="Message_Guest_appears" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="5 minutes passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callguest" name="Call the guest" />
    <bpmn:task id="handover" name="Hand over the meal" />
    <bpmn:task id="prepare" name="Prepare the meal" />
    <bpmn:task id="hatch" name="Place the meal in the service hatch" />
    <bpmn:task id="informemp" name="Inform the employee that the meal is ready" />
    <bpmn:sequenceFlow id="f-hungry-enter" sourceRef="hungry" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-choose" sourceRef="enter" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait" sourceRef="choose" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-place" sourceRef="wait" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-enterorder" sourceRef="place" targetRef="enterorder" />
    <bpmn:sequenceFlow id="f-enterorder-collect" sourceRef="enterorder" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-setup" sourceRef="collect" targetRef="setup" />
    <bpmn:sequenceFlow id="f-setup-passbuzzer" sourceRef="setup" targetRef="passbuzzer" />
    <bpmn:sequenceFlow id="f-passbuzzer-informchef" sourceRef="passbuzzer" targetRef="informchef" />
    <bpmn:sequenceFlow id="f-informchef-prepare" sourceRef="informchef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-hatch" sourceRef="prepare" targetRef="hatch" />
    <bpmn:sequenceFlow id="f-hatch-informemp" sourceRef="hatch" targetRef="informemp" />
    <bpmn:sequenceFlow id="f-informemp-setoff" sourceRef="informemp" targetRef="setoff" />
    <bpmn:sequenceFlow id="f-setoff-reaction" sourceRef="setoff" targetRef="reaction" />
    <bpmn:sequenceFlow id="f-reaction-appears" sourceRef="reaction" targetRef="appears" />
    <bpmn:sequenceFlow id="f-reaction-timeout" sourceRef="reaction" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-timeout-callguest" sourceRef="timeout" targetRef="callguest" />
    <bpmn:sequenceFlow id="f-callguest-reaction" sourceRef="callguest" targetRef="reaction" />
    <bpmn:sequenceFlow id="f-appears-handover" sourceRef="appears" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-pickup" sourceRef="handover" targetRef="pickup" />
    <bpmn:sequenceFlow id="f-pickup-eat" sourceRef="pickup" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-done" sourceRef="eat" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
