tok 1.0 "Restaurant meal ordering"

pool restaurant "Restaurant"
  lane guest "Guest"
    start hungry "Guest feels hungry"
    task enter "Enter the restaurant"
    task choose "Choose a dish"
    task wait "Wait for his turn"
    task place "Place the order"
    task pickup "Pick up the meal"
    task eat "Eat the meal"
    end done "Meal eaten"
  lane employee "Employee"
    task enterorder "Enter the order into the POS system"
    task collect "Collect the money"
    task setup "Set up the buzzer"
    task passbuzzer "Pass the buzzer on to the guest"
    task informchef "Inform the chef of the new order"
    task setoff "Set off the buzzer"
    eventgw reaction
    catch appears "Guest appears at the service hatch" message="Guest appears"
    catch timeout "5 minutes passed" timer=PT5M
    task callguest "Call the guest"
    task handover "Hand over the meal"
  lane chef "Chef"
    task prepare "Prepare the meal"
    task hatch "Place the meal in the service hatch"
    task informemp "Inform the employee that the meal is ready"

flow hungry -> enter -> choose -> wait -> place
flow place -> enterorder -> collect -> setup -> passbuzzer -> informchef
flow informchef -> prepare -> hatch -> informemp -> setoff -> reaction
flow reaction -> appears
flow reaction -> timeout
flow timeout -> callguest -> reaction
flow appears -> handover -> pickup -> eat -> done
