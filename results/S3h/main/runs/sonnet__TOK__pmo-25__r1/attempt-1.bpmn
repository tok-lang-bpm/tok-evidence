<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="search" name="Job search" processRef="search-process" />
  </bpmn:collaboration>
  <bpmn:process id="search-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="search-lanes">
      <bpmn:lane id="applicant" name="Job applicant">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApplicant</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Job search started" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="report" name="Report job applications" />
    <bpmn:exclusiveGateway id="interview" name="Job interview negotiated?" />
    <bpmn:task id="negotiate" name="Negotiate the job interview" />
    <bpmn:exclusiveGateway id="interviewed" />
    <bpmn:exclusiveGateway id="wants" name="Company wants you to work for them?" />
    <bpmn:task id="probation" name="Enter the probation phase" />
    <bpmn:parallelGateway id="review" />
    <bpmn:task id="rateCompany" name="Rate the company" />
    <bpmn:parallelGateway id="reviewed" />
    <bpmn:exclusiveGateway id="permanent" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="low" name="Company rated C or less?" />
    <bpmn:endEvent id="noJob" name="Process ended without a job" />
    <bpmn:endEvent id="done" name="Process ended" />
    <bpmn:endEvent id="continued" name="Job offers continue without reporting" />
    <bpmn:task id="confirm" name="Confirm receipt of the job application" />
    <bpmn:task id="rateApp" name="Rate the application" />
    <bpmn:task id="rateApplicant" name="Rate the applicant" />
    <bpmn:task id="offers" name="Send new potential job offers" />
    <bpmn:task id="publish" name="Show company reviews to applicants after 1 year" />
    <bpmn:task id="receive" name="Continue to send job offers" />
    <bpmn:sequenceFlow id="f-begin-again" sourceRef="begin" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-report" sourceRef="again" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-offers" sourceRef="report" targetRef="offers" />
    <bpmn:sequenceFlow id="f-offers-confirm" sourceRef="offers" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rateApp" sourceRef="confirm" targetRef="rateApp" />
    <bpmn:sequenceFlow id="f-rateApp-interview" sourceRef="rateApp" targetRef="interview" />
    <bpmn:sequenceFlow id="f-interview-negotiate" name="yes" sourceRef="interview" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-interview-interviewed" name="no" sourceRef="interview" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-negotiate-interviewed" sourceRef="negotiate" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f-interviewed-wants" sourceRef="interviewed" targetRef="wants" />
    <bpmn:sequenceFlow id="f-wants-probation" name="yes" sourceRef="wants" targetRef="probation" />
    <bpmn:sequenceFlow id="f-wants-again" name="no" sourceRef="wants" targetRef="again" />
    <bpmn:sequenceFlow id="f-probation-review" sourceRef="probation" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-rateCompany" sourceRef="review" targetRef="rateCompany" />
    <bpmn:sequenceFlow id="f-review-rateApplicant" sourceRef="review" targetRef="rateApplicant" />
    <bpmn:sequenceFlow id="f-rateCompany-reviewed" sourceRef="rateCompany" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-rateApplicant-reviewed" sourceRef="rateApplicant" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-reviewed-publish" sourceRef="reviewed" targetRef="publish" />
    <bpmn:sequenceFlow id="f-publish-permanent" sourceRef="publish" targetRef="permanent" />
    <bpmn:sequenceFlow id="f-permanent-low" name="yes" sourceRef="permanent" targetRef="low" />
    <bpmn:sequenceFlow id="f-permanent-noJob" name="no" sourceRef="permanent" targetRef="noJob" />
    <bpmn:sequenceFlow id="f-low-receive" name="yes" sourceRef="low" targetRef="receive" />
    <bpmn:sequenceFlow id="f-low-done" name="no" sourceRef="low" targetRef="done" />
    <bpmn:sequenceFlow id="f-receive-continued" sourceRef="receive" targetRef="continued" />
  </bpmn:process>
</bpmn:definitions>
