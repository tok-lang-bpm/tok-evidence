tok 1.0 "Find a Job"

pool search "Job search"
  lane applicant "Job applicant"
    start begin "Job search started"
    xor again
    task report "Report job applications"
    xor interview "Job interview negotiated?"
    task negotiate "Negotiate the job interview"
    xor interviewed
    xor wants "Company wants you to work for them?"
    task probation "Enter the probation phase"
    and review
    task rateCompany "Rate the company"
    and reviewed
    xor permanent "Job becomes permanent?"
    xor low "Company rated C or less?"
    end noJob "Process ended without a job"
    end done "Process ended"
    end continued "Job offers continue without reporting"
  lane company "Company"
    task confirm "Confirm receipt of the job application"
    task rateApp "Rate the application"
    task rateApplicant "Rate the applicant"
  lane system "System"
    task offers "Send new potential job offers"
    task publish "Show company reviews to applicants after 1 year"
    task receive "Continue to send job offers"

flow begin -> again -> report -> offers -> confirm -> rateApp -> interview
flow interview -> negotiate "yes"
flow interview -> interviewed "no"
flow negotiate -> interviewed
flow interviewed -> wants
flow wants -> probation "yes"
flow wants -> again "no"
flow probation -> review
flow review -> rateCompany
flow review -> rateApplicant
flow rateCompany -> reviewed
flow rateApplicant -> reviewed
flow reviewed -> publish -> permanent
flow permanent -> low "yes"
flow permanent -> noJob "no"
flow low -> receive "yes"
flow low -> done "no"
flow receive -> continued
