<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming a parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Maternity leave organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Becoming a parent" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Leave support system">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Maternity leave needed" />
    <bpmn:task id="select" name="Select the leave model" />
    <bpmn:task id="collect" name="Collect the relevant information" />
    <bpmn:task id="take" name="Take the maternity leave" />
    <bpmn:task id="decide" name="Decide about the extension" />
    <bpmn:exclusiveGateway id="extend" name="Extend the leave?" default="f-extend-finished" />
    <bpmn:endEvent id="finished" name="Leave finished" />
    <bpmn:task id="fetch" name="Fetch information about the potential models" />
    <bpmn:exclusiveGateway id="entry" />
    <bpmn:parallelGateway id="notify" />
    <bpmn:task id="notifyss" name="Notify Social Security" />
    <bpmn:task id="notifyco" name="Notify the company" />
    <bpmn:parallelGateway id="notified" />
    <bpmn:task id="gather" name="Gather information from the companies" />
    <bpmn:sequenceFlow id="f-needed-fetch" sourceRef="needed" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-entry" sourceRef="select" targetRef="entry" />
    <bpmn:sequenceFlow id="f-entry-collect" sourceRef="entry" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-notify" sourceRef="collect" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-notifyss" sourceRef="notify" targetRef="notifyss" />
    <bpmn:sequenceFlow id="f-notify-notifyco" sourceRef="notify" targetRef="notifyco" />
    <bpmn:sequenceFlow id="f-notifyss-notified" sourceRef="notifyss" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notifyco-notified" sourceRef="notifyco" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notified-gather" sourceRef="notified" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-take" sourceRef="gather" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-decide" sourceRef="take" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-extend" sourceRef="decide" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-entry" name="yes" sourceRef="extend" targetRef="entry" />
    <bpmn:sequenceFlow id="f-extend-finished" name="no" sourceRef="extend" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
