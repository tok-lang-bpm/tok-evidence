tok 1.0 "Becoming a parent"

pool org "Maternity leave organisation"
  lane parent "Parent"
    start needed "Maternity leave needed"
    task select "Select the leave model"
    task collect "Collect the relevant information"
    task take "Take the maternity leave"
    task decide "Decide about the extension"
    xor extend "Extend the leave?"
    end finished "Leave finished"
  lane system "Leave support system"
    task fetch "Fetch information about the potential models"
    xor entry
    and notify
    task notifyss "Notify Social Security"
    task notifyco "Notify the company"
    and notified
    task gather "Gather information from the companies"

flow needed -> fetch -> select -> entry
flow entry -> collect -> notify
flow notify -> notifyss
flow notify -> notifyco
flow notifyss -> notified
flow notifyco -> notified
flow notified -> gather -> take -> decide -> extend
flow extend -> entry "yes"
flow extend -> finished "no" default
