<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>noticed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noticed" name="Accident or near accident noticed" />
    <bpmn:task id="inform" name="Inform the employer immediately" />
    <bpmn:task id="record" name="Record the accident" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="serious" name="Fatality or serious injury?" default="f-serious-m1" />
    <bpmn:exclusiveGateway id="emergency" name="Reported to the emergency services?" default="f-emergency-labour" />
    <bpmn:task id="labour" name="Report the accident to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:exclusiveGateway id="insured" name="Person killed or unable to work for three days?" default="f-insured-m2" />
    <bpmn:task id="insurer" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:endEvent id="done" name="Accident reported" />
    <bpmn:sequenceFlow id="f-noticed-inform" sourceRef="noticed" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-record" sourceRef="inform" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-split" sourceRef="record" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-serious" sourceRef="split" targetRef="serious" />
    <bpmn:sequenceFlow id="f-split-insured" sourceRef="split" targetRef="insured" />
    <bpmn:sequenceFlow id="f-serious-emergency" name="yes" sourceRef="serious" targetRef="emergency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">serious = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-serious-m1" name="no" sourceRef="serious" targetRef="m1" />
    <bpmn:sequenceFlow id="f-emergency-labour" name="no" sourceRef="emergency" targetRef="labour" />
    <bpmn:sequenceFlow id="f-emergency-m1" name="yes" sourceRef="emergency" targetRef="m1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reportedToEmergencyServices = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-labour-m1" sourceRef="labour" targetRef="m1" />
    <bpmn:sequenceFlow id="f-insured-insurer" name="yes" sourceRef="insured" targetRef="insurer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">killedOrUnableToWork = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-insured-m2" name="no" sourceRef="insured" targetRef="m2" />
    <bpmn:sequenceFlow id="f-insurer-m2" sourceRef="insurer" targetRef="m2" />
    <bpmn:sequenceFlow id="f-m1-joined" sourceRef="m1" targetRef="joined" />
    <bpmn:sequenceFlow id="f-m2-joined" sourceRef="m2" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-done" sourceRef="joined" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
