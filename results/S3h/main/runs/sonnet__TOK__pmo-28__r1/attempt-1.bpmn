<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Internship" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>experience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>write_company</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Internship search started" />
    <bpmn:task id="topic" name="Enter topic and desired salary" />
    <bpmn:task id="experience" name="Enter experience and hobbies" />
    <bpmn:receiveTask id="offer" name="Receive offer" />
    <bpmn:exclusiveGateway id="decision" name="Offer accepted?" />
    <bpmn:task id="deny" name="Deny offer" />
    <bpmn:task id="invalidate" name="Invalidate all other offers" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="write_student" name="Write status update about the internship">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">studentUpdates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="recommend" name="Recommend the company to a list of friends" />
    <bpmn:task id="tweet" name="Send tweet">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="done" name="Internship completed" />
    <bpmn:task id="write_company" name="Write status update about the student">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">companyUpdates &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:sequenceFlow id="f-begin-topic" sourceRef="begin" targetRef="topic" />
    <bpmn:sequenceFlow id="f-topic-experience" sourceRef="topic" targetRef="experience" />
    <bpmn:sequenceFlow id="f-experience-offer" sourceRef="experience" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-decision" sourceRef="offer" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-invalidate" name="yes" sourceRef="decision" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f-decision-deny" name="no" sourceRef="decision" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-offer" sourceRef="deny" targetRef="offer" />
    <bpmn:sequenceFlow id="f-invalidate-split" sourceRef="invalidate" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-write_student" sourceRef="split" targetRef="write_student" />
    <bpmn:sequenceFlow id="f-split-write_company" sourceRef="split" targetRef="write_company" />
    <bpmn:sequenceFlow id="f-write_student-joined" sourceRef="write_student" targetRef="joined" />
    <bpmn:sequenceFlow id="f-write_company-joined" sourceRef="write_company" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-recommend" sourceRef="joined" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-tweet" sourceRef="recommend" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-done" sourceRef="tweet" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
