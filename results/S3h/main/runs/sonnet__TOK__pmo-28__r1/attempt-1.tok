tok 1.0 "Internship"

pool org "Internship"
  lane student "Student"
    start begin "Internship search started"
    task topic "Enter topic and desired salary"
    task experience "Enter experience and hobbies"
    receive offer "Receive offer"
    xor decision "Offer accepted?"
    task deny "Deny offer"
    task invalidate "Invalidate all other offers"
    and split
    task write_student "Write status update about the internship" loop while="studentUpdates < 3"
    and joined
    task recommend "Recommend the company to a list of friends"
    task tweet "Send tweet" parallel
    end done "Internship completed"
  lane company "Company"
    task write_company "Write status update about the student" loop while="companyUpdates < 3"

flow begin -> topic -> experience -> offer -> decision
flow decision -> invalidate "yes"
flow decision -> deny "no"
flow deny -> offer
flow invalidate -> split
flow split -> write_student
flow split -> write_company
flow write_student -> joined
flow write_company -> joined
flow joined -> recommend -> tweet -> done
