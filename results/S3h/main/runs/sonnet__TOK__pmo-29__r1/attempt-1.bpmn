<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>byresidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bydestination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>traveldoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="office" name="Representation office">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Visa needed" />
    <bpmn:task id="checkreq" name="Check the requirements for working and living in Austria" />
    <bpmn:exclusiveGateway id="typed" name="Type D visa?" />
    <bpmn:task id="byresidence" name="Determine the representation by place of residence" />
    <bpmn:task id="bydestination" name="Determine the representation by main travel destination" />
    <bpmn:exclusiveGateway id="found" />
    <bpmn:parallelGateway id="prep" />
    <bpmn:task id="form" name="Fill in the visa application form" />
    <bpmn:task id="traveldoc" name="Check the travel document" />
    <bpmn:task id="photo" name="Get a passport photo" />
    <bpmn:task id="insurance" name="Get the travel health insurance" />
    <bpmn:task id="means" name="Prove sufficient means of subsistence" />
    <bpmn:task id="evidence" name="Collect other evidence" />
    <bpmn:parallelGateway id="prepared" />
    <bpmn:task id="submit" name="Submit the visa application" />
    <bpmn:task id="provide" name="Provide the additional documents" />
    <bpmn:task id="receive" name="Receive the visa" />
    <bpmn:parallelGateway id="settle" />
    <bpmn:task id="accommodation" name="Organize the accommodation" />
    <bpmn:task id="bank" name="Open a bank account" />
    <bpmn:parallelGateway id="settled" />
    <bpmn:endEvent id="done" name="Ready to work and live in Austria" />
    <bpmn:endEvent id="refused" name="Visa refused" />
    <bpmn:task id="check" name="Check the visa application" />
    <bpmn:exclusiveGateway id="complete" name="Application complete?" />
    <bpmn:task id="request" name="Request the additional documents" />
    <bpmn:exclusiveGateway id="grounds" name="Grounds for refusal?" />
    <bpmn:task id="issue" name="Issue the visa" />
    <bpmn:task id="reject" name="Reject the application" />
    <bpmn:sequenceFlow id="f-needed-checkreq" sourceRef="needed" targetRef="checkreq" />
    <bpmn:sequenceFlow id="f-checkreq-typed" sourceRef="checkreq" targetRef="typed" />
    <bpmn:sequenceFlow id="f-typed-byresidence" name="yes" sourceRef="typed" targetRef="byresidence" />
    <bpmn:sequenceFlow id="f-typed-bydestination" name="no" sourceRef="typed" targetRef="bydestination" />
    <bpmn:sequenceFlow id="f-byresidence-found" sourceRef="byresidence" targetRef="found" />
    <bpmn:sequenceFlow id="f-bydestination-found" sourceRef="bydestination" targetRef="found" />
    <bpmn:sequenceFlow id="f-found-prep" sourceRef="found" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-form" sourceRef="prep" targetRef="form" />
    <bpmn:sequenceFlow id="f-form-prepared" sourceRef="form" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prep-traveldoc" sourceRef="prep" targetRef="traveldoc" />
    <bpmn:sequenceFlow id="f-traveldoc-prepared" sourceRef="traveldoc" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prep-photo" sourceRef="prep" targetRef="photo" />
    <bpmn:sequenceFlow id="f-photo-prepared" sourceRef="photo" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prep-insurance" sourceRef="prep" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-insurance-prepared" sourceRef="insurance" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prep-means" sourceRef="prep" targetRef="means" />
    <bpmn:sequenceFlow id="f-means-prepared" sourceRef="means" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prep-evidence" sourceRef="prep" targetRef="evidence" />
    <bpmn:sequenceFlow id="f-evidence-prepared" sourceRef="evidence" targetRef="prepared" />
    <bpmn:sequenceFlow id="f-prepared-submit" sourceRef="prepared" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check" sourceRef="submit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-complete" sourceRef="check" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-request" name="no" sourceRef="complete" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-provide" sourceRef="request" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-check" sourceRef="provide" targetRef="check" />
    <bpmn:sequenceFlow id="f-complete-grounds" name="yes" sourceRef="complete" targetRef="grounds" />
    <bpmn:sequenceFlow id="f-grounds-reject" name="yes" sourceRef="grounds" targetRef="reject" />
    <bpmn:sequenceFlow id="f-grounds-issue" name="no" sourceRef="grounds" targetRef="issue" />
    <bpmn:sequenceFlow id="f-reject-refused" sourceRef="reject" targetRef="refused" />
    <bpmn:sequenceFlow id="f-issue-receive" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-settle" sourceRef="receive" targetRef="settle" />
    <bpmn:sequenceFlow id="f-settle-accommodation" sourceRef="settle" targetRef="accommodation" />
    <bpmn:sequenceFlow id="f-accommodation-settled" sourceRef="accommodation" targetRef="settled" />
    <bpmn:sequenceFlow id="f-settle-bank" sourceRef="settle" targetRef="bank" />
    <bpmn:sequenceFlow id="f-bank-settled" sourceRef="bank" targetRef="settled" />
    <bpmn:sequenceFlow id="f-settled-done" sourceRef="settled" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
