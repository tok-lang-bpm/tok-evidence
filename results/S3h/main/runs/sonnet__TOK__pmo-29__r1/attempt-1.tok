tok 1.0 "Work and Live in Austria"

pool austria "Work and live in Austria"
  lane applicant "Applicant"
    start needed "Visa needed"
    task checkreq "Check the requirements for working and living in Austria"
    xor typed "Type D visa?"
    task byresidence "Determine the representation by place of residence"
    task bydestination "Determine the representation by main travel destination"
    xor found
    and prep
    task form "Fill in the visa application form"
    task traveldoc "Check the travel document"
    task photo "Get a passport photo"
    task insurance "Get the travel health insurance"
    task means "Prove sufficient means of subsistence"
    task evidence "Collect other evidence"
    and prepared
    task submit "Submit the visa application"
    task provide "Provide the additional documents"
    task receive "Receive the visa"
    and settle
    task accommodation "Organize the accommodation"
    task bank "Open a bank account"
    and settled
    end done "Ready to work and live in Austria"
    end refused "Visa refused"
  lane office "Representation office"
    task check "Check the visa application"
    xor complete "Application complete?"
    task request "Request the additional documents"
    xor grounds "Grounds for refusal?"
    task issue "Issue the visa"
    task reject "Reject the application"

flow needed -> checkreq -> typed
flow typed -> byresidence "yes"
flow typed -> bydestination "no"
flow byresidence -> found
flow bydestination -> found
flow found -> prep
flow prep -> form -> prepared
flow prep -> traveldoc -> prepared
flow prep -> photo -> prepared
flow prep -> insurance -> prepared
flow prep -> means -> prepared
flow prep -> evidence -> prepared
flow prepared -> submit -> check -> complete
flow complete -> request "no"
flow request -> provide -> check
flow complete -> grounds "yes"
flow grounds -> reject "yes"
flow grounds -> issue "no"
flow reject -> refused
flow issue -> receive -> settle
flow settle -> accommodation -> settled
flow settle -> bank -> settled
flow settled -> done
