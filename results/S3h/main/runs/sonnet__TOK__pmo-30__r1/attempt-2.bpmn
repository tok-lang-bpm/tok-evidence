<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN party organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="host" name="Host">
        <bpmn:flowNodeRef>planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findgames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dateMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkgames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gamesMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findbeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beerEnough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buybeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="planned" name="LAN party planned" />
    <bpmn:task id="invite" name="Send invitations to the 10 friends" />
    <bpmn:task id="findgames" name="Find out which games the friends want to play" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="dateMerge" />
    <bpmn:task id="appoint" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="enough" name="8 or more people agree on the date?" default="f-enough-dateMerge" />
    <bpmn:task id="checkgames" name="Find out if you have all the games the guests want to play" />
    <bpmn:exclusiveGateway id="missing" name="Some games missing?" default="f-missing-gamesMerge" />
    <bpmn:task id="download" name="Download the missing games" />
    <bpmn:exclusiveGateway id="gamesMerge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="findbeer" name="Find out how much beer the friends will require" />
    <bpmn:exclusiveGateway id="beerEnough" name="Enough beer?" default="f-beerEnough-beerMerge" />
    <bpmn:task id="buybeer" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="beerMerge" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="done" name="LAN party held" />
    <bpmn:sequenceFlow id="f-planned-invite" sourceRef="planned" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-findgames" sourceRef="invite" targetRef="findgames" />
    <bpmn:sequenceFlow id="f-findgames-split" sourceRef="findgames" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-dateMerge" sourceRef="split" targetRef="dateMerge" />
    <bpmn:sequenceFlow id="f-split-checkgames" sourceRef="split" targetRef="checkgames" />
    <bpmn:sequenceFlow id="f-dateMerge-appoint" sourceRef="dateMerge" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-enough" sourceRef="appoint" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-join" name="yes" sourceRef="enough" targetRef="join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreed &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough-dateMerge" name="no" sourceRef="enough" targetRef="dateMerge" />
    <bpmn:sequenceFlow id="f-checkgames-missing" sourceRef="checkgames" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-download" name="yes" sourceRef="missing" targetRef="download">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">gamesMissing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-gamesMerge" name="no" sourceRef="missing" targetRef="gamesMerge" />
    <bpmn:sequenceFlow id="f-download-gamesMerge" sourceRef="download" targetRef="gamesMerge" />
    <bpmn:sequenceFlow id="f-gamesMerge-join" sourceRef="gamesMerge" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-findbeer" sourceRef="join" targetRef="findbeer" />
    <bpmn:sequenceFlow id="f-findbeer-beerEnough" sourceRef="findbeer" targetRef="beerEnough" />
    <bpmn:sequenceFlow id="f-beerEnough-buybeer" name="no" sourceRef="beerEnough" targetRef="buybeer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">beerMissing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-beerEnough-beerMerge" name="yes" sourceRef="beerEnough" targetRef="beerMerge" />
    <bpmn:sequenceFlow id="f-buybeer-beerMerge" sourceRef="buybeer" targetRef="beerMerge" />
    <bpmn:sequenceFlow id="f-beerMerge-enjoy" sourceRef="beerMerge" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-done" sourceRef="enjoy" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
