<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clicklink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checksub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hassub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectpay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entercard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enteriban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectchar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>namemerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entername</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Character creation started" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="checkacc" name="Check battle.net account" />
    <bpmn:exclusiveGateway id="hasacc" name="Battle.net account?" />
    <bpmn:task id="enterinfo" name="Enter account information" />
    <bpmn:task id="clicklink" name="Click link in confirmation mail" />
    <bpmn:exclusiveGateway id="accmerge" />
    <bpmn:task id="checksub" name="Check active WoW subscription" />
    <bpmn:exclusiveGateway id="hassub" name="Active subscription?" />
    <bpmn:task id="selectpay" name="Select payment method" />
    <bpmn:exclusiveGateway id="method" name="Payment method?" />
    <bpmn:task id="entercard" name="Enter credit card information" />
    <bpmn:task id="enteriban" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="paymerge" />
    <bpmn:exclusiveGateway id="submerge" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="selectchar" name="Select realm, race and class" />
    <bpmn:task id="names" name="Come up with good character names" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="namemerge" />
    <bpmn:task id="entername" name="Enter character name" />
    <bpmn:exclusiveGateway id="available" name="Name still available?" />
    <bpmn:task id="confirm" name="Get confirmation and selfies of the character" />
    <bpmn:task id="release" name="Get message that the expansion is released" />
    <bpmn:endEvent id="done" name="Character created" />
    <bpmn:sequenceFlow id="f-begin-split" sourceRef="begin" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-checkacc" sourceRef="split" targetRef="checkacc" />
    <bpmn:sequenceFlow id="f-split-names" sourceRef="split" targetRef="names" />
    <bpmn:sequenceFlow id="f-checkacc-hasacc" sourceRef="checkacc" targetRef="hasacc" />
    <bpmn:sequenceFlow id="f-hasacc-enterinfo" name="no" sourceRef="hasacc" targetRef="enterinfo" />
    <bpmn:sequenceFlow id="f-hasacc-accmerge" name="yes" sourceRef="hasacc" targetRef="accmerge" />
    <bpmn:sequenceFlow id="f-enterinfo-clicklink" sourceRef="enterinfo" targetRef="clicklink" />
    <bpmn:sequenceFlow id="f-clicklink-accmerge" sourceRef="clicklink" targetRef="accmerge" />
    <bpmn:sequenceFlow id="f-accmerge-checksub" sourceRef="accmerge" targetRef="checksub" />
    <bpmn:sequenceFlow id="f-checksub-hassub" sourceRef="checksub" targetRef="hassub" />
    <bpmn:sequenceFlow id="f-hassub-selectpay" name="no" sourceRef="hassub" targetRef="selectpay" />
    <bpmn:sequenceFlow id="f-hassub-submerge" name="yes" sourceRef="hassub" targetRef="submerge" />
    <bpmn:sequenceFlow id="f-selectpay-method" sourceRef="selectpay" targetRef="method" />
    <bpmn:sequenceFlow id="f-method-entercard" name="credit card" sourceRef="method" targetRef="entercard" />
    <bpmn:sequenceFlow id="f-method-enteriban" name="bank account" sourceRef="method" targetRef="enteriban" />
    <bpmn:sequenceFlow id="f-entercard-paymerge" sourceRef="entercard" targetRef="paymerge" />
    <bpmn:sequenceFlow id="f-enteriban-paymerge" sourceRef="enteriban" targetRef="paymerge" />
    <bpmn:sequenceFlow id="f-paymerge-submerge" sourceRef="paymerge" targetRef="submerge" />
    <bpmn:sequenceFlow id="f-submerge-login" sourceRef="submerge" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-selectchar" sourceRef="login" targetRef="selectchar" />
    <bpmn:sequenceFlow id="f-selectchar-join" sourceRef="selectchar" targetRef="join" />
    <bpmn:sequenceFlow id="f-names-join" sourceRef="names" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-namemerge" sourceRef="join" targetRef="namemerge" />
    <bpmn:sequenceFlow id="f-namemerge-entername" sourceRef="namemerge" targetRef="entername" />
    <bpmn:sequenceFlow id="f-entername-available" sourceRef="entername" targetRef="available" />
    <bpmn:sequenceFlow id="f-available-confirm" name="yes" sourceRef="available" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-available-namemerge" name="no" sourceRef="available" targetRef="namemerge" />
    <bpmn:sequenceFlow id="f-confirm-release" sourceRef="confirm" targetRef="release" />
    <bpmn:sequenceFlow id="f-release-done" sourceRef="release" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
