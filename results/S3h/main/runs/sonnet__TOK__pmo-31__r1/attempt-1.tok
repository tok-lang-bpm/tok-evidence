tok 1.0 "Blizzard Online Character Generator"

pool blizzard "Blizzard"
  lane player "Player"
    start begin "Character creation started"
    and split
    task checkacc "Check battle.net account"
    xor hasacc "Battle.net account?"
    task enterinfo "Enter account information"
    task clicklink "Click link in confirmation mail"
    xor accmerge
    task checksub "Check active WoW subscription"
    xor hassub "Active subscription?"
    task selectpay "Select payment method"
    xor method "Payment method?"
    task entercard "Enter credit card information"
    task enteriban "Enter IBAN and BIC numbers"
    xor paymerge
    xor submerge
    task login "Log into the game"
    task selectchar "Select realm, race and class"
    task names "Come up with good character names"
    and join
    xor namemerge
    task entername "Enter character name"
    xor available "Name still available?"
    task confirm "Get confirmation and selfies of the character"
    task release "Get message that the expansion is released"
    end done "Character created"

flow begin -> split
flow split -> checkacc
flow split -> names
flow checkacc -> hasacc
flow hasacc -> enterinfo "no"
flow hasacc -> accmerge "yes"
flow enterinfo -> clicklink -> accmerge
flow accmerge -> checksub -> hassub
flow hassub -> selectpay "no"
flow hassub -> submerge "yes"
flow selectpay -> method
flow method -> entercard "credit card"
flow method -> enteriban "bank account"
flow entercard -> paymerge
flow enteriban -> paymerge
flow paymerge -> submerge
flow submerge -> login -> selectchar -> join
flow names -> join
flow join -> namemerge -> entername -> available
flow available -> confirm "yes"
flow available -> namemerge "no"
flow confirm -> release -> done
