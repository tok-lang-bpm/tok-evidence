<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Instruct an artist to create a 3D model and print it on a 3D printer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="owner" name="Customer" processRef="owner-process" />
  </bpmn:collaboration>
  <bpmn:process id="owner-process" name="Instruct an artist to create a 3D model and print it on a 3D printer" isExecutable="false">
    <bpmn:laneSet id="owner-lanes">
      <bpmn:lane id="you" name="Customer">
        <bpmn:flowNodeRef>craving</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shopping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plastic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="craving" name="Custom 3D model wanted" />
    <bpmn:task id="instruct" name="Instruct the artist" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="sketches" name="Send the sketches to the artist" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with the result?" />
    <bpmn:task id="change" name="Tell the artist what to change" />
    <bpmn:task id="color" name="Choose the plastic color" />
    <bpmn:exclusiveGateway id="instock" name="Color in stock?" />
    <bpmn:task id="left" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under" name="Under 100 grams?" />
    <bpmn:task id="shopping" name="Put the color on the shopping list" />
    <bpmn:task id="order" name="Order the color" />
    <bpmn:exclusiveGateway id="plastic" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="on" name="Turn the printer on" />
    <bpmn:task id="heat" name="Heat up the bed and the extruder" />
    <bpmn:task id="gcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="print" name="Print the model" />
    <bpmn:endEvent id="printed" name="Model printed" />
    <bpmn:sequenceFlow id="f-craving-instruct" sourceRef="craving" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-again" sourceRef="instruct" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-sketches" sourceRef="again" targetRef="sketches" />
    <bpmn:sequenceFlow id="f-sketches-satisfied" sourceRef="sketches" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-satisfied-change" name="no" sourceRef="satisfied" targetRef="change" />
    <bpmn:sequenceFlow id="f-change-again" sourceRef="change" targetRef="again" />
    <bpmn:sequenceFlow id="f-satisfied-color" name="yes" sourceRef="satisfied" targetRef="color" />
    <bpmn:sequenceFlow id="f-color-instock" sourceRef="color" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-left" name="yes" sourceRef="instock" targetRef="left" />
    <bpmn:sequenceFlow id="f-instock-order" name="no" sourceRef="instock" targetRef="order" />
    <bpmn:sequenceFlow id="f-left-under" sourceRef="left" targetRef="under" />
    <bpmn:sequenceFlow id="f-under-shopping" name="yes" sourceRef="under" targetRef="shopping" />
    <bpmn:sequenceFlow id="f-under-plastic" name="no" sourceRef="under" targetRef="plastic" />
    <bpmn:sequenceFlow id="f-shopping-plastic" sourceRef="shopping" targetRef="plastic" />
    <bpmn:sequenceFlow id="f-order-plastic" sourceRef="order" targetRef="plastic" />
    <bpmn:sequenceFlow id="f-plastic-split" sourceRef="plastic" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-on" sourceRef="split" targetRef="on" />
    <bpmn:sequenceFlow id="f-on-heat" sourceRef="on" targetRef="heat" />
    <bpmn:sequenceFlow id="f-heat-joined" sourceRef="heat" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-gcode" sourceRef="split" targetRef="gcode" />
    <bpmn:sequenceFlow id="f-gcode-joined" sourceRef="gcode" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-print" sourceRef="joined" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-printed" sourceRef="print" targetRef="printed" />
  </bpmn:process>
</bpmn:definitions>
