tok 1.0 "Instruct an artist to create a 3D model and print it on a 3D printer"

pool owner "Customer"
  lane you "Customer"
    start craving "Custom 3D model wanted"
    task instruct "Instruct the artist"
    xor again
    task sketches "Send the sketches to the artist"
    xor satisfied "Satisfied with the result?"
    task change "Tell the artist what to change"
    task color "Choose the plastic color"
    xor instock "Color in stock?"
    task left "Check how much color is left"
    xor under "Under 100 grams?"
    task shopping "Put the color on the shopping list"
    task order "Order the color"
    xor plastic
    and split
    task on "Turn the printer on"
    task heat "Heat up the bed and the extruder"
    task gcode "Generate the gcode file from the STL"
    and joined
    task print "Print the model"
    end printed "Model printed"

flow craving -> instruct -> again -> sketches -> satisfied
flow satisfied -> change "no"
flow change -> again
flow satisfied -> color "yes"
flow color -> instock
flow instock -> left "yes"
flow instock -> order "no"
flow left -> under
flow under -> shopping "yes"
flow under -> plastic "no"
flow shopping -> plastic
flow order -> plastic
flow plastic -> split
flow split -> on -> heat -> joined
flow split -> gcode -> joined
flow joined -> print -> printed
