<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="project" name="Lego machine project" processRef="project-process" />
  </bpmn:collaboration>
  <bpmn:process id="project-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="project-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Custom machine needed" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give the Lego sets to the children" />
    <bpmn:task id="build" name="Build the subcomponents" />
    <bpmn:exclusiveGateway id="missing" name="Parts missing in a container?" default="f-missing-test" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="test" name="Test the subcomponents" />
    <bpmn:exclusiveGateway id="passed" name="All tests successful?" default="f-passed-redesign" />
    <bpmn:task id="assemble" name="Assemble the machine" />
    <bpmn:task id="redesign" name="Redesign the subcomponents" />
    <bpmn:endEvent id="done" name="Machine built" />
    <bpmn:task id="sort" name="Sort the parts into containers" />
    <bpmn:sequenceFlow id="f-needed-design" sourceRef="needed" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-build" sourceRef="sort" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-missing" sourceRef="build" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-reorder" name="yes" sourceRef="missing" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-reorder-build" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f-missing-test" name="no" sourceRef="missing" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-passed" sourceRef="test" targetRef="passed" />
    <bpmn:sequenceFlow id="f-passed-assemble" name="yes" sourceRef="passed" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-passed-redesign" name="no" sourceRef="passed" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-build" sourceRef="redesign" targetRef="build" />
    <bpmn:sequenceFlow id="f-assemble-done" sourceRef="assemble" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
