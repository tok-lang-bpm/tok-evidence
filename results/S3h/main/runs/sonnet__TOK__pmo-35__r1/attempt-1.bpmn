<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="maker" name="Chainsaw manufacturer" processRef="maker-process" />
  </bpmn:collaboration>
  <bpmn:process id="maker-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="maker-lanes">
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_props</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prod_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prod_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_saw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ordered" name="Custom chainsaw ordered" />
    <bpmn:task id="receive_props" name="Receive the chainsaw properties from the customer" />
    <bpmn:parallelGateway id="order_split" />
    <bpmn:task id="order_a" name="Order parts from online source 1" />
    <bpmn:task id="order_b" name="Order parts from online source 2" />
    <bpmn:task id="order_c" name="Order parts from online source 3" />
    <bpmn:parallelGateway id="order_join" />
    <bpmn:task id="receive_parts" name="Receive the parts" />
    <bpmn:parallelGateway id="prod_split" />
    <bpmn:task id="inspect" name="Inspect all parts manually" />
    <bpmn:task id="assemble" name="Assemble the parts" />
    <bpmn:task id="updates" name="Send updates to the customer" />
    <bpmn:parallelGateway id="prod_join" />
    <bpmn:task id="send_saw" name="Send the first saw to the customer" />
    <bpmn:exclusiveGateway id="liked" name="Does the customer like the saw?" />
    <bpmn:task id="produce_rest" name="Produce the rest of the order" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:endEvent id="cancelled" name="Order ended" />
    <bpmn:sequenceFlow id="f-ordered-receive_props" sourceRef="ordered" targetRef="receive_props" />
    <bpmn:sequenceFlow id="f-receive_props-order_split" sourceRef="receive_props" targetRef="order_split" />
    <bpmn:sequenceFlow id="f-order_split-order_a" sourceRef="order_split" targetRef="order_a" />
    <bpmn:sequenceFlow id="f-order_a-order_join" sourceRef="order_a" targetRef="order_join" />
    <bpmn:sequenceFlow id="f-order_split-order_b" sourceRef="order_split" targetRef="order_b" />
    <bpmn:sequenceFlow id="f-order_b-order_join" sourceRef="order_b" targetRef="order_join" />
    <bpmn:sequenceFlow id="f-order_split-order_c" sourceRef="order_split" targetRef="order_c" />
    <bpmn:sequenceFlow id="f-order_c-order_join" sourceRef="order_c" targetRef="order_join" />
    <bpmn:sequenceFlow id="f-order_join-receive_parts" sourceRef="order_join" targetRef="receive_parts" />
    <bpmn:sequenceFlow id="f-receive_parts-prod_split" sourceRef="receive_parts" targetRef="prod_split" />
    <bpmn:sequenceFlow id="f-prod_split-inspect" sourceRef="prod_split" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-assemble" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-prod_join" sourceRef="assemble" targetRef="prod_join" />
    <bpmn:sequenceFlow id="f-prod_split-updates" sourceRef="prod_split" targetRef="updates" />
    <bpmn:sequenceFlow id="f-updates-prod_join" sourceRef="updates" targetRef="prod_join" />
    <bpmn:sequenceFlow id="f-prod_join-send_saw" sourceRef="prod_join" targetRef="send_saw" />
    <bpmn:sequenceFlow id="f-send_saw-liked" sourceRef="send_saw" targetRef="liked" />
    <bpmn:sequenceFlow id="f-liked-produce_rest" name="yes" sourceRef="liked" targetRef="produce_rest" />
    <bpmn:sequenceFlow id="f-liked-cancelled" name="no" sourceRef="liked" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-produce_rest-done" sourceRef="produce_rest" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
