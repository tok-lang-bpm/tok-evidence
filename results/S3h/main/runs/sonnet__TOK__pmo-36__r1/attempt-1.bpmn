<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Airplane producer" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teams" name="Manufacturing teams">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vodka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>whiskey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toilets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wish" name="Customer wants a luxury airplane" />
    <bpmn:task id="specify" name="Specify the interior" />
    <bpmn:task id="confirm" name="Confirm the delivery" />
    <bpmn:endEvent id="done" name="Airplane delivered" />
    <bpmn:task id="receive" name="Receive the specifications" />
    <bpmn:task id="send_req" name="Send the requirements to the teams" />
    <bpmn:task id="assemble" name="Assemble the interior" />
    <bpmn:task id="test_flight" name="Send the plane on a test flight" />
    <bpmn:task id="protocol" name="Create the test protocol" />
    <bpmn:task id="send_protocol" name="Send the test protocol to the customer" />
    <bpmn:task id="deliver" name="Deliver the plane to the customer" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="vodka" name="Manufacture the vodka bar" />
    <bpmn:task id="whiskey" name="Manufacture the whiskey bar" />
    <bpmn:task id="seats" name="Manufacture the seats" />
    <bpmn:task id="toilets" name="Manufacture the toilets" />
    <bpmn:parallelGateway id="join" />
    <bpmn:sequenceFlow id="f-wish-specify" sourceRef="wish" targetRef="specify" />
    <bpmn:sequenceFlow id="f-specify-receive" sourceRef="specify" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-send_req" sourceRef="receive" targetRef="send_req" />
    <bpmn:sequenceFlow id="f-send_req-split" sourceRef="send_req" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-vodka" sourceRef="split" targetRef="vodka" />
    <bpmn:sequenceFlow id="f-split-whiskey" sourceRef="split" targetRef="whiskey" />
    <bpmn:sequenceFlow id="f-split-seats" sourceRef="split" targetRef="seats" />
    <bpmn:sequenceFlow id="f-split-toilets" sourceRef="split" targetRef="toilets" />
    <bpmn:sequenceFlow id="f-vodka-join" sourceRef="vodka" targetRef="join" />
    <bpmn:sequenceFlow id="f-whiskey-join" sourceRef="whiskey" targetRef="join" />
    <bpmn:sequenceFlow id="f-seats-join" sourceRef="seats" targetRef="join" />
    <bpmn:sequenceFlow id="f-toilets-join" sourceRef="toilets" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-assemble" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-test_flight" sourceRef="assemble" targetRef="test_flight" />
    <bpmn:sequenceFlow id="f-test_flight-protocol" sourceRef="test_flight" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-protocol-send_protocol" sourceRef="protocol" targetRef="send_protocol" />
    <bpmn:sequenceFlow id="f-send_protocol-deliver" sourceRef="send_protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
