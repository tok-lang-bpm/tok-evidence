<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Parts_batch" name="Parts batch" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="contract" name="Contract project" processRef="contract-process" />
  </bpmn:collaboration>
  <bpmn:process id="contract-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="contract-lanes">
      <bpmn:lane id="builder" name="Contractor">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enoughStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderCheapA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderedA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderCheapB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderFast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderedB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complained</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Parts needed for the contract project" />
    <bpmn:task id="query" name="Query all web shops for quantity, price and delivery time" />
    <bpmn:task id="list" name="Create the list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="enough" name="One shop has enough parts?" />
    <bpmn:task id="orderOne" name="Order the parts from one shop" />
    <bpmn:task id="orderMany" name="Order the parts from several shops" />
    <bpmn:exclusiveGateway id="ordered" />
    <bpmn:receiveTask id="first" name="Receive the first parts" messageRef="Message_Parts_batch" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:task id="check" name="Check the stock of a part" />
    <bpmn:exclusiveGateway id="level" name="Stock level?" />
    <bpmn:endEvent id="enoughStock" name="Stock sufficient" />
    <bpmn:task id="reorderCheapA" name="Reorder the cheapest parts" />
    <bpmn:endEvent id="reorderedA" name="Parts reordered" />
    <bpmn:task id="reorderCheapB" name="Reorder the cheapest parts" />
    <bpmn:task id="reorderFast" name="Reorder the fastest parts" />
    <bpmn:endEvent id="reorderedB" name="Parts reordered twice" />
    <bpmn:task id="mail" name="Write a mail to friends complaining about the web shops" />
    <bpmn:endEvent id="complained" name="Complaint sent" />
    <bpmn:sequenceFlow id="f-needed-query" sourceRef="needed" targetRef="query" />
    <bpmn:sequenceFlow id="f-query-list" sourceRef="query" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-enough" sourceRef="list" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-orderOne" name="yes" sourceRef="enough" targetRef="orderOne" />
    <bpmn:sequenceFlow id="f-enough-orderMany" name="no" sourceRef="enough" targetRef="orderMany" />
    <bpmn:sequenceFlow id="f-orderOne-ordered" sourceRef="orderOne" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-orderMany-ordered" sourceRef="orderMany" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-ordered-first" sourceRef="ordered" targetRef="first" />
    <bpmn:sequenceFlow id="f-first-build" sourceRef="first" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-check" sourceRef="build" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-level" sourceRef="check" targetRef="level" />
    <bpmn:sequenceFlow id="f-level-enoughStock" name="5 or more" sourceRef="level" targetRef="enoughStock" />
    <bpmn:sequenceFlow id="f-level-reorderCheapA" name="3 or 4" sourceRef="level" targetRef="reorderCheapA" />
    <bpmn:sequenceFlow id="f-level-reorderCheapB" name="1 or 2" sourceRef="level" targetRef="reorderCheapB" />
    <bpmn:sequenceFlow id="f-level-mail" name="0" sourceRef="level" targetRef="mail" />
    <bpmn:sequenceFlow id="f-reorderCheapA-reorderedA" sourceRef="reorderCheapA" targetRef="reorderedA" />
    <bpmn:sequenceFlow id="f-reorderCheapB-reorderFast" sourceRef="reorderCheapB" targetRef="reorderFast" />
    <bpmn:sequenceFlow id="f-reorderFast-reorderedB" sourceRef="reorderFast" targetRef="reorderedB" />
    <bpmn:sequenceFlow id="f-mail-complained" sourceRef="mail" targetRef="complained" />
  </bpmn:process>
</bpmn:definitions>
