<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="Building a House" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Tree house architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Tree house wanted" />
    <bpmn:task id="collect" name="Collect the requirements" />
    <bpmn:task id="sendreq" name="Send the requirements to the architect" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="refine" name="Refine the draft with additional requirements" />
    <bpmn:exclusiveGateway id="more" name="Refine again?" default="f-more-list" />
    <bpmn:task id="list" name="Create the list of needed materials" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="order" name="Order the materials from online stores">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:task id="message" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="build" name="Build the tree house" />
    <bpmn:task id="invite" name="Send invitations for the tree house party" />
    <bpmn:task id="attendees" name="Create the list of attending people" />
    <bpmn:task id="snacks" name="Buy the snacks" />
    <bpmn:endEvent id="done" name="Party prepared" />
    <bpmn:task id="draft" name="Send the draft" />
    <bpmn:sequenceFlow id="f-needed-collect" sourceRef="needed" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sendreq" sourceRef="collect" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-draft" sourceRef="sendreq" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-again" sourceRef="draft" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-refine" sourceRef="again" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-more" sourceRef="refine" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-again" name="yes" sourceRef="more" targetRef="again" />
    <bpmn:sequenceFlow id="f-more-list" name="no" sourceRef="more" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-split" sourceRef="list" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-order" sourceRef="split" targetRef="order" />
    <bpmn:sequenceFlow id="f-split-message" sourceRef="split" targetRef="message" />
    <bpmn:sequenceFlow id="f-order-joined" sourceRef="order" targetRef="joined" />
    <bpmn:sequenceFlow id="f-message-joined" sourceRef="message" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-build" sourceRef="joined" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-invite" sourceRef="build" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-attendees" sourceRef="invite" targetRef="attendees" />
    <bpmn:sequenceFlow id="f-attendees-snacks" sourceRef="attendees" targetRef="snacks" />
    <bpmn:sequenceFlow id="f-snacks-done" sourceRef="snacks" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
