tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool diy "DIY smartphone repair"
  lane person "You"
    start broken "Smartphone screen broken"
    task enter "Enter the model and what is broken"
    task check "Check what you already have"
    task contact "Contact friends to borrow or buy cheaply"
    task buy "Buy the rest"
    task fix "Fix the phone"
    xor worked "Did the repair work?"
    or share "Share the result"
    task review "Send a review"
    task video "Send a video of the fix"
    or shared
    task expert "Send the phone to an expert"
    end repaired "Phone repaired"
    end handed "Phone sent to expert"
  lane tool "Online tool"
    task materials "Provide the list of materials"
    task tools "Provide the list of tools"
    task ordering "Provide the ordering choices for each part"
    task instructions "Provide repair instructions"

flow broken -> enter -> materials -> tools -> ordering -> check -> contact -> buy -> instructions -> fix -> worked
flow worked -> share "yes"
flow worked -> expert "no" default
flow share -> review
flow share -> video
flow review -> shared
flow video -> shared
flow shared -> repaired
flow expert -> handed
