<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="diy" name="DIY smartphone repair" processRef="diy-process" />
  </bpmn:collaboration>
  <bpmn:process id="diy-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="diy-lanes">
      <bpmn:lane id="person" name="You">
        <bpmn:flowNodeRef>broken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>video</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online tool">
        <bpmn:flowNodeRef>materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tools</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="broken" name="Smartphone screen broken" />
    <bpmn:task id="enter" name="Enter the model and what is broken" />
    <bpmn:task id="check" name="Check what you already have" />
    <bpmn:task id="contact" name="Contact friends to borrow or buy cheaply" />
    <bpmn:task id="buy" name="Buy the rest" />
    <bpmn:task id="fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="worked" name="Did the repair work?" default="f-worked-expert" />
    <bpmn:inclusiveGateway id="share" name="What do you send?" default="f-share-shared" />
    <bpmn:task id="review" name="Send a review" />
    <bpmn:task id="video" name="Send a video of the fix" />
    <bpmn:inclusiveGateway id="shared" />
    <bpmn:task id="expert" name="Send the phone to an expert" />
    <bpmn:endEvent id="repaired" name="Phone repaired" />
    <bpmn:endEvent id="handed" name="Phone sent to expert" />
    <bpmn:task id="materials" name="Provide the list of materials" />
    <bpmn:task id="tools" name="Provide the list of tools" />
    <bpmn:task id="ordering" name="Provide the ordering choices for each part" />
    <bpmn:task id="instructions" name="Provide repair instructions" />
    <bpmn:sequenceFlow id="f-broken-enter" sourceRef="broken" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-materials" sourceRef="enter" targetRef="materials" />
    <bpmn:sequenceFlow id="f-materials-tools" sourceRef="materials" targetRef="tools" />
    <bpmn:sequenceFlow id="f-tools-ordering" sourceRef="tools" targetRef="ordering" />
    <bpmn:sequenceFlow id="f-ordering-check" sourceRef="ordering" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-contact" sourceRef="check" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact-buy" sourceRef="contact" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-instructions" sourceRef="buy" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-instructions-fix" sourceRef="instructions" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-worked" sourceRef="fix" targetRef="worked" />
    <bpmn:sequenceFlow id="f-worked-share" name="yes" sourceRef="worked" targetRef="share">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">repairWorked = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-worked-expert" name="no" sourceRef="worked" targetRef="expert" />
    <bpmn:sequenceFlow id="f-share-review" name="review" sourceRef="share" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sendReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-share-video" name="video" sourceRef="share" targetRef="video">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sendVideo = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-share-shared" name="nothing" sourceRef="share" targetRef="shared" />
    <bpmn:sequenceFlow id="f-review-shared" sourceRef="review" targetRef="shared" />
    <bpmn:sequenceFlow id="f-video-shared" sourceRef="video" targetRef="shared" />
    <bpmn:sequenceFlow id="f-shared-repaired" sourceRef="shared" targetRef="repaired" />
    <bpmn:sequenceFlow id="f-expert-handed" sourceRef="expert" targetRef="handed" />
  </bpmn:process>
</bpmn:definitions>
