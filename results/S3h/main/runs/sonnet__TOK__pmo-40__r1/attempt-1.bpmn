<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="OEE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="OEE" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system" name="Monitoring system">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>connected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineer" name="Engineer">
        <bpmn:flowNodeRef>restart</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Measurement started" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="collect" name="Collect information from the machine" />
    <bpmn:task id="calculate" name="Calculate the OEE" />
    <bpmn:exclusiveGateway id="low" name="OEE below the value?" />
    <bpmn:task id="stop" name="Stop the machine" />
    <bpmn:task id="email" name="Send an email to the engineer" />
    <bpmn:exclusiveGateway id="connected" name="Machine disconnected?" />
    <bpmn:endEvent id="finished" name="Process stopped" />
    <bpmn:task id="restart" name="Restart the machine" />
    <bpmn:sequenceFlow id="f-begin-merge" sourceRef="begin" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-collect" sourceRef="merge" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-calculate" sourceRef="collect" targetRef="calculate" />
    <bpmn:sequenceFlow id="f-calculate-low" sourceRef="calculate" targetRef="low" />
    <bpmn:sequenceFlow id="f-low-stop" name="yes" sourceRef="low" targetRef="stop" />
    <bpmn:sequenceFlow id="f-low-connected" name="no" sourceRef="low" targetRef="connected" />
    <bpmn:sequenceFlow id="f-stop-email" sourceRef="stop" targetRef="email" />
    <bpmn:sequenceFlow id="f-email-restart" sourceRef="email" targetRef="restart" />
    <bpmn:sequenceFlow id="f-restart-merge" sourceRef="restart" targetRef="merge" />
    <bpmn:sequenceFlow id="f-connected-finished" name="yes" sourceRef="connected" targetRef="finished" />
    <bpmn:sequenceFlow id="f-connected-merge" name="no" sourceRef="connected" targetRef="merge" />
  </bpmn:process>
</bpmn:definitions>
