tok 1.0 "OEE"

pool org "Organisation"
  lane system "Monitoring system"
    start begin "Measurement started"
    xor merge
    task collect "Collect information from the machine"
    task calculate "Calculate the OEE"
    xor low "OEE below the value?"
    task stop "Stop the machine"
    task email "Send an email to the engineer"
    xor connected "Machine disconnected?"
    end finished "Process stopped"
  lane engineer "Engineer"
    task restart "Restart the machine"

flow begin -> merge -> collect -> calculate -> low
flow low -> stop "yes"
flow low -> connected "no"
flow stop -> email -> restart -> merge
flow connected -> finished "yes"
flow connected -> merge "no"
