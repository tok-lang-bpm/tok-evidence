<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="inspection" name="Machine inspection" processRef="inspection-process" />
  </bpmn:collaboration>
  <bpmn:process id="inspection-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="inspection-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inputmore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Application">
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askmore</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inspection needed" />
    <bpmn:task id="enter" name="Enter the type and serial number of the machine" />
    <bpmn:task id="input" name="Input values" />
    <bpmn:task id="press" name="Press buttons" />
    <bpmn:task id="inputmore" name="Input values for additional questions" />
    <bpmn:endEvent id="done" name="Inspection completed" />
    <bpmn:task id="ask" name="Ask questions" />
    <bpmn:task id="collect" name="Collect values from the machine" />
    <bpmn:task id="show" name="Show values" />
    <bpmn:exclusiveGateway id="more" name="Additional questions needed?" default="f-more-done" />
    <bpmn:task id="askmore" name="Ask additional questions" />
    <bpmn:sequenceFlow id="f-begin-enter" sourceRef="begin" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-ask" sourceRef="enter" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-input" sourceRef="ask" targetRef="input" />
    <bpmn:sequenceFlow id="f-input-press" sourceRef="input" targetRef="press" />
    <bpmn:sequenceFlow id="f-press-collect" sourceRef="press" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-show" sourceRef="collect" targetRef="show" />
    <bpmn:sequenceFlow id="f-show-more" sourceRef="show" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-askmore" name="yes" sourceRef="more" targetRef="askmore">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additionalQuestionsNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-more-done" name="no" sourceRef="more" targetRef="done" />
    <bpmn:sequenceFlow id="f-askmore-inputmore" sourceRef="askmore" targetRef="inputmore" />
    <bpmn:sequenceFlow id="f-inputmore-done" sourceRef="inputmore" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
