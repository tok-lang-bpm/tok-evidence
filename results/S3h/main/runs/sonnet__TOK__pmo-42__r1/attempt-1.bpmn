<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="fridgeservice" name="Fridge service" processRef="fridgeservice-process" />
  </bpmn:collaboration>
  <bpmn:process id="fridgeservice-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="fridgeservice-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>noises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Local service facility">
        <bpmn:flowNodeRef>appointmentjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noises" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send the symptoms and the type of fridge to the service center" />
    <bpmn:task id="confirm" name="Confirm that the fridge is OK" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:endEvent id="done" name="Fridge service completed" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:exclusiveGateway id="appointmentjoin" />
    <bpmn:task id="appoint" name="Make an appointment" />
    <bpmn:task id="repair" name="Repair the fridge" />
    <bpmn:exclusiveGateway id="repaired" name="Fridge repaired?" />
    <bpmn:task id="leave" name="Leave without repairing the fridge" />
    <bpmn:sequenceFlow id="f-noises-describe" sourceRef="noises" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appointmentjoin" sourceRef="select" targetRef="appointmentjoin" />
    <bpmn:sequenceFlow id="f-appointmentjoin-appoint" sourceRef="appointmentjoin" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-repair" sourceRef="appoint" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-repaired" sourceRef="repair" targetRef="repaired" />
    <bpmn:sequenceFlow id="f-repaired-confirm" name="yes" sourceRef="repaired" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-repaired-leave" name="no, additional parts needed" sourceRef="repaired" targetRef="leave" />
    <bpmn:sequenceFlow id="f-leave-appointmentjoin" sourceRef="leave" targetRef="appointmentjoin" />
    <bpmn:sequenceFlow id="f-confirm-rate" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-done" sourceRef="rate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
