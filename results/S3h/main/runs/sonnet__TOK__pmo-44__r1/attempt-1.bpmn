<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askmenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ismenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askside</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sidedone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tomake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Order wanted" />
    <bpmn:task id="receive" name="Receive an order" />
    <bpmn:task id="askmenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="ismenu" name="Menu or just the burger?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="drink" name="Prepare the drink" />
    <bpmn:task id="askside" name="Ask whether the customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="side" name="Fries or wedges?" />
    <bpmn:task id="fries" name="Prepare the fries" />
    <bpmn:task id="wedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="sidedone" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:exclusiveGateway id="tomake" />
    <bpmn:task id="burger" name="Prepare the burger" />
    <bpmn:boundaryEvent id="status" attachedToRef="burger" cancelActivity="false">
      <bpmn:timerEventDefinition id="status-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="update" name="Give an enthusiastic status update" />
    <bpmn:endEvent id="updated" name="Status update given" />
    <bpmn:task id="deliver" name="Deliver the order via the conveyor belt" />
    <bpmn:endEvent id="done" name="Order delivered" />
    <bpmn:sequenceFlow id="f-begin-receive" sourceRef="begin" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-askmenu" sourceRef="receive" targetRef="askmenu" />
    <bpmn:sequenceFlow id="f-askmenu-ismenu" sourceRef="askmenu" targetRef="ismenu" />
    <bpmn:sequenceFlow id="f-ismenu-split" name="menu" sourceRef="ismenu" targetRef="split" />
    <bpmn:sequenceFlow id="f-ismenu-tomake" name="just the burger" sourceRef="ismenu" targetRef="tomake" />
    <bpmn:sequenceFlow id="f-split-drink" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-split-askside" sourceRef="split" targetRef="askside" />
    <bpmn:sequenceFlow id="f-askside-side" sourceRef="askside" targetRef="side" />
    <bpmn:sequenceFlow id="f-side-fries" name="fries" sourceRef="side" targetRef="fries" />
    <bpmn:sequenceFlow id="f-side-wedges" name="wedges" sourceRef="side" targetRef="wedges" />
    <bpmn:sequenceFlow id="f-fries-sidedone" sourceRef="fries" targetRef="sidedone" />
    <bpmn:sequenceFlow id="f-wedges-sidedone" sourceRef="wedges" targetRef="sidedone" />
    <bpmn:sequenceFlow id="f-drink-joined" sourceRef="drink" targetRef="joined" />
    <bpmn:sequenceFlow id="f-sidedone-joined" sourceRef="sidedone" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-tomake" sourceRef="joined" targetRef="tomake" />
    <bpmn:sequenceFlow id="f-tomake-burger" sourceRef="tomake" targetRef="burger" />
    <bpmn:sequenceFlow id="f-burger-deliver" sourceRef="burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-done" sourceRef="deliver" targetRef="done" />
    <bpmn:sequenceFlow id="f-status-update" sourceRef="status" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-updated" sourceRef="update" targetRef="updated" />
  </bpmn:process>
</bpmn:definitions>
