tok 1.0 "Robotic Burger Seller near the University of Vienna"

pool seller "Robotic Burger Seller"
  lane robot "Robot"
    start begin "Order wanted"
    task receive "Receive an order"
    task askmenu "Ask whether the customer wants a menu or just the burger"
    xor ismenu "Menu or just the burger?"
    and split
    task drink "Prepare the drink"
    task askside "Ask whether the customer wants fries or wedges"
    xor side "Fries or wedges?"
    task fries "Prepare the fries"
    task wedges "Prepare the wedges"
    xor sidedone
    and joined
    xor tomake
    task burger "Prepare the burger"
    boundary status on=burger timer=PT30S noninterrupting
    task update "Give an enthusiastic status update"
    end updated "Status update given"
    task deliver "Deliver the order via the conveyor belt"
    end done "Order delivered"

flow begin -> receive -> askmenu -> ismenu
flow ismenu -> split "menu"
flow ismenu -> tomake "just the burger"
flow split -> drink
flow split -> askside
flow askside -> side
flow side -> fries "fries"
flow side -> wedges "wedges"
flow fries -> sidedone
flow wedges -> sidedone
flow drink -> joined
flow sidedone -> joined
flow joined -> tomake
flow tomake -> burger -> deliver -> done
flow status -> update -> updated
