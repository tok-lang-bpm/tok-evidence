<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online Shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all_selected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship_addr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing_diff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill_addr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="E-Shop system">
        <bpmn:flowNodeRef>check_cred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish_shop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Customer wants to order" />
    <bpmn:task id="login" name="Log into the E-Shop system" />
    <bpmn:receiveTask id="wait_login" name="Wait for the login confirmation" />
    <bpmn:exclusiveGateway id="select_merge" />
    <bpmn:task id="select" name="Select a product" />
    <bpmn:task id="add" name="Add the product to the shopping cart" />
    <bpmn:task id="save" name="Save the product" />
    <bpmn:task id="check_all" name="Check if every product was already selected" />
    <bpmn:exclusiveGateway id="all_selected" name="Every product selected?" default="f-all_selected-select_merge" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="pay_data" name="Enter the payment data" />
    <bpmn:receiveTask id="wait_pay" name="Wait for the payment confirmation" />
    <bpmn:task id="ship_addr" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="billing_diff" name="Billing address different from shipping address?" default="f-billing_diff-billing_merge" />
    <bpmn:task id="bill_addr" name="Enter the billing address" />
    <bpmn:exclusiveGateway id="billing_merge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="stopped" name="Shopping stopped" />
    <bpmn:task id="check_cred" name="Check the credentials" />
    <bpmn:exclusiveGateway id="login_ok" name="Login successful?" default="f-login_ok-stopped" />
    <bpmn:task id="finish_shop" name="Finish the order" />
    <bpmn:task id="prep_pay" name="Prepare the payment" />
    <bpmn:task id="prep_ship" name="Prepare the shipment" />
    <bpmn:task id="complete" name="Finish the order" />
    <bpmn:endEvent id="done" name="Order finished" />
    <bpmn:sequenceFlow id="f-begin-login" sourceRef="begin" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-check_cred" sourceRef="login" targetRef="check_cred" />
    <bpmn:sequenceFlow id="f-check_cred-wait_login" sourceRef="check_cred" targetRef="wait_login" />
    <bpmn:sequenceFlow id="f-wait_login-login_ok" sourceRef="wait_login" targetRef="login_ok" />
    <bpmn:sequenceFlow id="f-login_ok-select_merge" name="yes" sourceRef="login_ok" targetRef="select_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">loginSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-login_ok-stopped" name="no" sourceRef="login_ok" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-select_merge-select" sourceRef="select_merge" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-add" sourceRef="select" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-save" sourceRef="add" targetRef="save" />
    <bpmn:sequenceFlow id="f-save-check_all" sourceRef="save" targetRef="check_all" />
    <bpmn:sequenceFlow id="f-check_all-all_selected" sourceRef="check_all" targetRef="all_selected" />
    <bpmn:sequenceFlow id="f-all_selected-select_merge" name="no" sourceRef="all_selected" targetRef="select_merge" />
    <bpmn:sequenceFlow id="f-all_selected-finish_shop" name="yes" sourceRef="all_selected" targetRef="finish_shop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allProductsSelected = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-finish_shop-split" sourceRef="finish_shop" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-prep_pay" sourceRef="split" targetRef="prep_pay" />
    <bpmn:sequenceFlow id="f-prep_pay-pay_data" sourceRef="prep_pay" targetRef="pay_data" />
    <bpmn:sequenceFlow id="f-pay_data-wait_pay" sourceRef="pay_data" targetRef="wait_pay" />
    <bpmn:sequenceFlow id="f-wait_pay-join" sourceRef="wait_pay" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-prep_ship" sourceRef="split" targetRef="prep_ship" />
    <bpmn:sequenceFlow id="f-prep_ship-ship_addr" sourceRef="prep_ship" targetRef="ship_addr" />
    <bpmn:sequenceFlow id="f-ship_addr-billing_diff" sourceRef="ship_addr" targetRef="billing_diff" />
    <bpmn:sequenceFlow id="f-billing_diff-bill_addr" name="yes" sourceRef="billing_diff" targetRef="bill_addr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">billingAddressDiffers = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-billing_diff-billing_merge" name="no" sourceRef="billing_diff" targetRef="billing_merge" />
    <bpmn:sequenceFlow id="f-bill_addr-billing_merge" sourceRef="bill_addr" targetRef="billing_merge" />
    <bpmn:sequenceFlow id="f-billing_merge-join" sourceRef="billing_merge" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-complete" sourceRef="join" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-done" sourceRef="complete" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
