<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Sports institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkaccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasaccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkuni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accountmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noslots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wish" name="Wish to register for a course" />
    <bpmn:task id="select" name="Select a course" />
    <bpmn:task id="checkaccount" name="Check if you already have an account" />
    <bpmn:exclusiveGateway id="hasaccount" name="Account at the sports institute?" />
    <bpmn:task id="checkuni" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Registered at an eligible university?" />
    <bpmn:task id="register" name="Register your account" />
    <bpmn:task id="request" name="Request an activation" />
    <bpmn:task id="wait" name="Wait for a response" />
    <bpmn:exclusiveGateway id="accountmerge" />
    <bpmn:task id="login" name="Log into the account" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete" name="Complete the registration for the course" />
    <bpmn:task id="pay" name="Provide the payment information" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="receive" name="Receive the course ticket" />
    <bpmn:endEvent id="registered" name="Registered for the course" />
    <bpmn:endEvent id="noslots" name="No slots free" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" />
    <bpmn:task id="tell" name="Tell the courses and dates" />
    <bpmn:sequenceFlow id="f-wish-slots" sourceRef="wish" targetRef="slots" />
    <bpmn:sequenceFlow id="f-slots-tell" name="yes" sourceRef="slots" targetRef="tell" />
    <bpmn:sequenceFlow id="f-slots-noslots" name="no" sourceRef="slots" targetRef="noslots" />
    <bpmn:sequenceFlow id="f-tell-select" sourceRef="tell" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-checkaccount" sourceRef="select" targetRef="checkaccount" />
    <bpmn:sequenceFlow id="f-checkaccount-hasaccount" sourceRef="checkaccount" targetRef="hasaccount" />
    <bpmn:sequenceFlow id="f-hasaccount-accountmerge" name="yes" sourceRef="hasaccount" targetRef="accountmerge" />
    <bpmn:sequenceFlow id="f-hasaccount-checkuni" name="no" sourceRef="hasaccount" targetRef="checkuni" />
    <bpmn:sequenceFlow id="f-checkuni-eligible" sourceRef="checkuni" targetRef="eligible" />
    <bpmn:sequenceFlow id="f-eligible-register" name="yes" sourceRef="eligible" targetRef="register" />
    <bpmn:sequenceFlow id="f-eligible-request" name="no" sourceRef="eligible" targetRef="request" />
    <bpmn:sequenceFlow id="f-register-accountmerge" sourceRef="register" targetRef="accountmerge" />
    <bpmn:sequenceFlow id="f-request-wait" sourceRef="request" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-accountmerge" sourceRef="wait" targetRef="accountmerge" />
    <bpmn:sequenceFlow id="f-accountmerge-login" sourceRef="accountmerge" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-tweet" sourceRef="split" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-split-complete" sourceRef="split" targetRef="complete" />
    <bpmn:sequenceFlow id="f-split-pay" sourceRef="split" targetRef="pay" />
    <bpmn:sequenceFlow id="f-tweet-join" sourceRef="tweet" targetRef="join" />
    <bpmn:sequenceFlow id="f-complete-join" sourceRef="complete" targetRef="join" />
    <bpmn:sequenceFlow id="f-pay-join" sourceRef="pay" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-receive" sourceRef="join" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-registered" sourceRef="receive" targetRef="registered" />
  </bpmn:process>
</bpmn:definitions>
