tok 1.0 "New Application for Registering for an USI course"

pool institute "Sports institute"
  lane applicant "Applicant"
    start wish "Wish to register for a course"
    task select "Select a course"
    task checkaccount "Check if you already have an account"
    xor hasaccount "Account at the sports institute?"
    task checkuni "Check whether you are registered at an eligible university"
    xor eligible "Registered at an eligible university?"
    task register "Register your account"
    task request "Request an activation"
    task wait "Wait for a response"
    xor accountmerge
    task login "Log into the account"
    and split
    task tweet "Tweet to friends"
    task complete "Complete the registration for the course"
    task pay "Provide the payment information"
    and join
    task receive "Receive the course ticket"
    end registered "Registered for the course"
    end noslots "No slots free"
  lane system "System"
    xor slots "Slots free?"
    task tell "Tell the courses and dates"

flow wish -> slots
flow slots -> tell "yes"
flow slots -> noslots "no"
flow tell -> select -> checkaccount -> hasaccount
flow hasaccount -> accountmerge "yes"
flow hasaccount -> checkuni "no"
flow checkuni -> eligible
flow eligible -> register "yes"
flow eligible -> request "no"
flow register -> accountmerge
flow request -> wait
flow wait -> accountmerge
flow accountmerge -> login -> split
flow split -> tweet
flow split -> complete
flow split -> pay
flow tweet -> join
flow complete -> join
flow pay -> join
flow join -> receive -> registered
