<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="App For Participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Vienna Night Run" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="runner" name="Runner">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getnumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>early</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromhome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>race</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runnight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>raceend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Wish to participate" />
    <bpmn:task id="select" name="Select a starting block" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="run5" name="Run 5km" />
    <bpmn:exclusiveGateway id="fast" name="Time under 25 minutes?" default="f-fast-train" />
    <bpmn:task id="train" name="Train and check" />
    <bpmn:task id="getnumber" name="Get the starting number" />
    <bpmn:exclusiveGateway id="early" name="More than one hour left between starting time and end of workday?" default="f-early-fromwork" />
    <bpmn:task id="fromhome" name="Go there from home" />
    <bpmn:task id="fromwork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="arrived" />
    <bpmn:parallelGateway id="race" />
    <bpmn:task id="runnight" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="raceend" />
    <bpmn:task id="receive" name="Receive the final running time" />
    <bpmn:endEvent id="finished" name="Night Run completed" />
    <bpmn:task id="measure" name="Measure the time" />
    <bpmn:sequenceFlow id="f-begin-select" sourceRef="begin" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-again" sourceRef="select" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-run5" sourceRef="again" targetRef="run5" />
    <bpmn:sequenceFlow id="f-run5-measure" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f-measure-fast" sourceRef="measure" targetRef="fast" />
    <bpmn:sequenceFlow id="f-fast-getnumber" name="yes" sourceRef="fast" targetRef="getnumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fast-train" name="no" sourceRef="fast" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-again" sourceRef="train" targetRef="again" />
    <bpmn:sequenceFlow id="f-getnumber-early" sourceRef="getnumber" targetRef="early" />
    <bpmn:sequenceFlow id="f-early-fromhome" name="yes" sourceRef="early" targetRef="fromhome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">timeLeft &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-early-fromwork" name="no" sourceRef="early" targetRef="fromwork" />
    <bpmn:sequenceFlow id="f-fromhome-arrived" sourceRef="fromhome" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-fromwork-arrived" sourceRef="fromwork" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-arrived-race" sourceRef="arrived" targetRef="race" />
    <bpmn:sequenceFlow id="f-race-runnight" sourceRef="race" targetRef="runnight" />
    <bpmn:sequenceFlow id="f-race-drink" sourceRef="race" targetRef="drink" />
    <bpmn:sequenceFlow id="f-runnight-raceend" sourceRef="runnight" targetRef="raceend" />
    <bpmn:sequenceFlow id="f-drink-raceend" sourceRef="drink" targetRef="raceend" />
    <bpmn:sequenceFlow id="f-raceend-receive" sourceRef="raceend" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-finished" sourceRef="receive" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
