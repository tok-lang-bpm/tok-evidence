<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ultrasound-guided catheter placement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hospital" name="Hospital" processRef="hospital-process" />
  </bpmn:collaboration>
  <bpmn:process id="hospital-process" name="Ultrasound-guided catheter placement" isExecutable="false">
    <bpmn:laneSet id="hospital-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gelprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterilegel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pospatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkblood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloodok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wiresplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>longaxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shortaxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirejoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catheterpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Procedure needed" />
    <bpmn:task id="implements" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="clothes" name="Get in sterile clothes" />
    <bpmn:task id="clean" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="configure" name="Configure the ultrasound" />
    <bpmn:task id="gelprobe" name="Put gel in the probe" />
    <bpmn:task id="cover" name="Cover the probe" />
    <bpmn:task id="sterilegel" name="Put the sterile gel" />
    <bpmn:task id="posprobe" name="Position the probe" />
    <bpmn:task id="pospatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="veinsplit" name="How is the vein identified?" />
    <bpmn:task id="anatomic" name="Identify the vein using an anatomic identification" />
    <bpmn:task id="doppler" name="Identify the vein using a doppler identification" />
    <bpmn:task id="compression" name="Identify the vein using a compression identification" />
    <bpmn:exclusiveGateway id="veinjoin" />
    <bpmn:exclusiveGateway id="retry" />
    <bpmn:task id="anesthetize" name="Anesthetize the patient" />
    <bpmn:task id="puncture" name="Puncture the patient" />
    <bpmn:task id="checkblood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="bloodok" name="Blood return correct?" />
    <bpmn:task id="dropprobe" name="Drop the probe" />
    <bpmn:task id="syringe" name="Remove the syringe" />
    <bpmn:task id="guidewire" name="Install the guidewire" />
    <bpmn:task id="trocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="wiresplit" name="How is the wire checked?" />
    <bpmn:task id="longaxis" name="Check the wire in the long axis" />
    <bpmn:task id="shortaxis" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="wirejoin" />
    <bpmn:task id="checkpos" name="Check if the wire is in good position" />
    <bpmn:exclusiveGateway id="posok" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="removewire" name="Remove the guidewire" />
    <bpmn:task id="flow" name="Verify the flow and the reflow" />
    <bpmn:task id="catheterpos" name="Check the catheter position" />
    <bpmn:endEvent id="done" name="Catheter placed" />
    <bpmn:sequenceFlow id="f-begin-implements" sourceRef="begin" targetRef="implements" />
    <bpmn:sequenceFlow id="f-implements-wash" sourceRef="implements" targetRef="wash" />
    <bpmn:sequenceFlow id="f-wash-clothes" sourceRef="wash" targetRef="clothes" />
    <bpmn:sequenceFlow id="f-clothes-clean" sourceRef="clothes" targetRef="clean" />
    <bpmn:sequenceFlow id="f-clean-drape" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-configure" sourceRef="drape" targetRef="configure" />
    <bpmn:sequenceFlow id="f-configure-gelprobe" sourceRef="configure" targetRef="gelprobe" />
    <bpmn:sequenceFlow id="f-gelprobe-cover" sourceRef="gelprobe" targetRef="cover" />
    <bpmn:sequenceFlow id="f-cover-sterilegel" sourceRef="cover" targetRef="sterilegel" />
    <bpmn:sequenceFlow id="f-sterilegel-posprobe" sourceRef="sterilegel" targetRef="posprobe" />
    <bpmn:sequenceFlow id="f-posprobe-pospatient" sourceRef="posprobe" targetRef="pospatient" />
    <bpmn:sequenceFlow id="f-pospatient-veinsplit" sourceRef="pospatient" targetRef="veinsplit" />
    <bpmn:sequenceFlow id="f-veinsplit-anatomic" name="anatomic" sourceRef="veinsplit" targetRef="anatomic" />
    <bpmn:sequenceFlow id="f-veinsplit-doppler" name="doppler" sourceRef="veinsplit" targetRef="doppler" />
    <bpmn:sequenceFlow id="f-veinsplit-compression" name="compression" sourceRef="veinsplit" targetRef="compression" />
    <bpmn:sequenceFlow id="f-anatomic-veinjoin" sourceRef="anatomic" targetRef="veinjoin" />
    <bpmn:sequenceFlow id="f-doppler-veinjoin" sourceRef="doppler" targetRef="veinjoin" />
    <bpmn:sequenceFlow id="f-compression-veinjoin" sourceRef="compression" targetRef="veinjoin" />
    <bpmn:sequenceFlow id="f-veinjoin-retry" sourceRef="veinjoin" targetRef="retry" />
    <bpmn:sequenceFlow id="f-retry-anesthetize" sourceRef="retry" targetRef="anesthetize" />
    <bpmn:sequenceFlow id="f-anesthetize-puncture" sourceRef="anesthetize" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-puncture-checkblood" sourceRef="puncture" targetRef="checkblood" />
    <bpmn:sequenceFlow id="f-checkblood-bloodok" sourceRef="checkblood" targetRef="bloodok" />
    <bpmn:sequenceFlow id="f-bloodok-retry" name="no" sourceRef="bloodok" targetRef="retry" />
    <bpmn:sequenceFlow id="f-bloodok-dropprobe" name="yes" sourceRef="bloodok" targetRef="dropprobe" />
    <bpmn:sequenceFlow id="f-dropprobe-syringe" sourceRef="dropprobe" targetRef="syringe" />
    <bpmn:sequenceFlow id="f-syringe-guidewire" sourceRef="syringe" targetRef="guidewire" />
    <bpmn:sequenceFlow id="f-guidewire-trocar" sourceRef="guidewire" targetRef="trocar" />
    <bpmn:sequenceFlow id="f-trocar-wiresplit" sourceRef="trocar" targetRef="wiresplit" />
    <bpmn:sequenceFlow id="f-wiresplit-longaxis" name="long axis" sourceRef="wiresplit" targetRef="longaxis" />
    <bpmn:sequenceFlow id="f-wiresplit-shortaxis" name="short axis" sourceRef="wiresplit" targetRef="shortaxis" />
    <bpmn:sequenceFlow id="f-longaxis-wirejoin" sourceRef="longaxis" targetRef="wirejoin" />
    <bpmn:sequenceFlow id="f-shortaxis-wirejoin" sourceRef="shortaxis" targetRef="wirejoin" />
    <bpmn:sequenceFlow id="f-wirejoin-checkpos" sourceRef="wirejoin" targetRef="checkpos" />
    <bpmn:sequenceFlow id="f-checkpos-posok" sourceRef="checkpos" targetRef="posok" />
    <bpmn:sequenceFlow id="f-posok-retry" name="no" sourceRef="posok" targetRef="retry" />
    <bpmn:sequenceFlow id="f-posok-widen" name="yes" sourceRef="posok" targetRef="widen" />
    <bpmn:sequenceFlow id="f-widen-advance" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f-advance-removewire" sourceRef="advance" targetRef="removewire" />
    <bpmn:sequenceFlow id="f-removewire-flow" sourceRef="removewire" targetRef="flow" />
    <bpmn:sequenceFlow id="f-flow-catheterpos" sourceRef="flow" targetRef="catheterpos" />
    <bpmn:sequenceFlow id="f-catheterpos-done" sourceRef="catheterpos" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
