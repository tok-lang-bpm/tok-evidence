<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Sales Organisation" processRef="sales-process" />
  </bpmn:collaboration>
  <bpmn:process id="sales-process" isExecutable="false">
    <bpmn:laneSet id="sales-lanes">
      <bpmn:lane id="staff" name="Sales Staff or Customer Support">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notinterested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rep" name="Sales Representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Potential customer inquires about a product or service" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="address" name="Address concerns and questions" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="guide" name="Guide the customer through selecting the product or service" />
    <bpmn:endEvent id="notinterested" name="Customer not interested" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:exclusiveGateway id="approved" name="Customer approves the quote?" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="record" name="Record the order in the system" />
    <bpmn:task id="confirm" name="Send order confirmation to the customer" />
    <bpmn:endEvent id="placed" name="Order placed and confirmed" />
    <bpmn:endEvent id="declined" name="Quote not approved" />
    <bpmn:sequenceFlow id="f1" sourceRef="inquiry" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="address" />
    <bpmn:sequenceFlow id="f3" sourceRef="address" targetRef="interested" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="interested" targetRef="guide" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="interested" targetRef="notinterested" />
    <bpmn:sequenceFlow id="f6" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f7" sourceRef="quote" targetRef="approved" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="approved" targetRef="place" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="approved" targetRef="declined" />
    <bpmn:sequenceFlow id="f10" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f11" sourceRef="record" targetRef="confirm" />
    <bpmn:sequenceFlow id="f12" sourceRef="confirm" targetRef="placed" />
  </bpmn:process>
</bpmn:definitions>
