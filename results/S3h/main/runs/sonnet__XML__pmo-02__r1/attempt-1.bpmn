<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="hiring-process" />
  </bpmn:collaboration>
  <bpmn:process id="hiring-process" isExecutable="false">
    <bpmn:laneSet id="hiring-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need for new hire identified" />
    <bpmn:task id="create" name="Create the job description" />
    <bpmn:task id="post" name="Post the job description on job boards" />
    <bpmn:task id="collect" name="Collect the resumes" />
    <bpmn:task id="screen" name="Screen the resumes" />
    <bpmn:task id="phone" name="Conduct the initial phone interviews" />
    <bpmn:task id="invite" name="Invite the selected candidates" />
    <bpmn:exclusiveGateway id="preference" name="Candidate's preferred interview type?" />
    <bpmn:task id="inperson" name="Conduct the in-person interview" />
    <bpmn:task id="virtual" name="Conduct the virtual interview" />
    <bpmn:exclusiveGateway id="interviewed" />
    <bpmn:task id="choose" name="Choose the candidate" />
    <bpmn:task id="offer" name="Extend the offer" />
    <bpmn:exclusiveGateway id="negotiation" name="Salary negotiation needed?" />
    <bpmn:task id="negotiate" name="Negotiate the salary" />
    <bpmn:exclusiveGateway id="negotiated" />
    <bpmn:task id="paperwork" name="Complete the paperwork" />
    <bpmn:task id="orientation" name="Conduct the orientation" />
    <bpmn:task id="training" name="Provide the training" />
    <bpmn:endEvent id="end" name="New hire integrated into the team" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="create" />
    <bpmn:sequenceFlow id="f2" sourceRef="create" targetRef="post" />
    <bpmn:sequenceFlow id="f3" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f4" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f5" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f6" sourceRef="phone" targetRef="invite" />
    <bpmn:sequenceFlow id="f7" sourceRef="invite" targetRef="preference" />
    <bpmn:sequenceFlow id="f8" name="in-person" sourceRef="preference" targetRef="inperson" />
    <bpmn:sequenceFlow id="f9" name="virtual" sourceRef="preference" targetRef="virtual" />
    <bpmn:sequenceFlow id="f10" sourceRef="inperson" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f11" sourceRef="virtual" targetRef="interviewed" />
    <bpmn:sequenceFlow id="f12" sourceRef="interviewed" targetRef="choose" />
    <bpmn:sequenceFlow id="f13" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f14" sourceRef="offer" targetRef="negotiation" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="negotiation" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="negotiation" targetRef="negotiated" />
    <bpmn:sequenceFlow id="f17" sourceRef="negotiate" targetRef="negotiated" />
    <bpmn:sequenceFlow id="f18" sourceRef="negotiated" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f19" sourceRef="paperwork" targetRef="orientation" />
    <bpmn:sequenceFlow id="f20" sourceRef="orientation" targetRef="training" />
    <bpmn:sequenceFlow id="f21" sourceRef="training" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
