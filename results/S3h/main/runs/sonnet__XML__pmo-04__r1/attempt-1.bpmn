<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Marketing Organisation" processRef="campaign-process" />
  </bpmn:collaboration>
  <bpmn:process id="campaign-process" isExecutable="false">
    <bpmn:laneSet id="campaign-lanes">
      <bpmn:lane id="marketing" name="Marketing Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>period-ends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM System">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Team">
        <bpmn:flowNodeRef>follow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Campaign needed" />
    <bpmn:task id="define" name="Define the campaign objectives" />
    <bpmn:parallelGateway id="prepare-split" />
    <bpmn:task id="create" name="Create the content" />
    <bpmn:task id="design" name="Design the visuals" />
    <bpmn:task id="select" name="Select the channels" />
    <bpmn:parallelGateway id="prepare-join" />
    <bpmn:task id="launch" name="Launch the campaign" />
    <bpmn:parallelGateway id="run-split" />
    <bpmn:task id="track" name="Track the campaign performance" />
    <bpmn:intermediateCatchEvent id="period-ends" name="Campaign period ends">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="collect" name="Collect the leads in the CRM system" />
    <bpmn:task id="follow" name="Follow up on the leads" />
    <bpmn:parallelGateway id="run-join" />
    <bpmn:task id="analyze" name="Analyze the campaign performance" />
    <bpmn:endEvent id="end" name="Campaign concluded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="define" />
    <bpmn:sequenceFlow id="f2" sourceRef="define" targetRef="prepare-split" />
    <bpmn:sequenceFlow id="f3" sourceRef="prepare-split" targetRef="create" />
    <bpmn:sequenceFlow id="f4" sourceRef="prepare-split" targetRef="design" />
    <bpmn:sequenceFlow id="f5" sourceRef="prepare-split" targetRef="select" />
    <bpmn:sequenceFlow id="f6" sourceRef="create" targetRef="prepare-join" />
    <bpmn:sequenceFlow id="f7" sourceRef="design" targetRef="prepare-join" />
    <bpmn:sequenceFlow id="f8" sourceRef="select" targetRef="prepare-join" />
    <bpmn:sequenceFlow id="f9" sourceRef="prepare-join" targetRef="launch" />
    <bpmn:sequenceFlow id="f10" sourceRef="launch" targetRef="run-split" />
    <bpmn:sequenceFlow id="f11" sourceRef="run-split" targetRef="track" />
    <bpmn:sequenceFlow id="f12" sourceRef="run-split" targetRef="collect" />
    <bpmn:sequenceFlow id="f13" sourceRef="track" targetRef="period-ends" />
    <bpmn:sequenceFlow id="f14" sourceRef="collect" targetRef="follow" />
    <bpmn:sequenceFlow id="f15" sourceRef="period-ends" targetRef="run-join" />
    <bpmn:sequenceFlow id="f16" sourceRef="follow" targetRef="run-join" />
    <bpmn:sequenceFlow id="f17" sourceRef="run-join" targetRef="analyze" />
    <bpmn:sequenceFlow id="f18" sourceRef="analyze" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
