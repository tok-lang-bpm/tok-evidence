<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="supplier-process" />
  </bpmn:collaboration>
  <bpmn:process id="supplier-process" isExecutable="false">
    <bpmn:laneSet id="supplier-lanes">
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visitq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visitm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new supplier identified" />
    <bpmn:task id="issue" name="Issue a request for proposals" />
    <bpmn:task id="receive" name="Receive responses from suppliers" />
    <bpmn:task id="evaluate" name="Evaluate each proposal" />
    <bpmn:exclusiveGateway id="visitq" name="Site visits or interviews needed?" default="f6" />
    <bpmn:task id="visit" name="Conduct site visits or interviews with suppliers" />
    <bpmn:exclusiveGateway id="visitm" />
    <bpmn:task id="select" name="Select a supplier" />
    <bpmn:task id="negotiate" name="Negotiate the contract" />
    <bpmn:task id="sign" name="Sign the contract" />
    <bpmn:task id="onboard" name="Onboard the supplier" />
    <bpmn:task id="execute" name="Execute the contract" />
    <bpmn:endEvent id="done" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f1" sourceRef="need" targetRef="issue" />
    <bpmn:sequenceFlow id="f2" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f4" sourceRef="evaluate" targetRef="visitq" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="visitq" targetRef="visit" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="visitq" targetRef="visitm" />
    <bpmn:sequenceFlow id="f7" sourceRef="visit" targetRef="visitm" />
    <bpmn:sequenceFlow id="f8" sourceRef="visitm" targetRef="select" />
    <bpmn:sequenceFlow id="f9" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f10" sourceRef="negotiate" targetRef="sign" />
    <bpmn:sequenceFlow id="f11" sourceRef="sign" targetRef="onboard" />
    <bpmn:sequenceFlow id="f12" sourceRef="onboard" targetRef="execute" />
    <bpmn:sequenceFlow id="f13" sourceRef="execute" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
