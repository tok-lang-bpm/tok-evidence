<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Order fulfilment" processRef="order-process" />
  </bpmn:collaboration>
  <bpmn:process id="order-process" isExecutable="false">
    <bpmn:laneSet id="order-lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-system" name="System">
        <bpmn:flowNodeRef>generate-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate-label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick-pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand-over</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-logistics" name="Logistics provider">
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order needed" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="generate-confirmation" name="Generate the order confirmation" />
    <bpmn:task id="send-confirmation" name="Send the order confirmation to the customer" />
    <bpmn:task id="pick-pack" name="Pick and pack the items" />
    <bpmn:task id="generate-label" name="Generate the shipping label" />
    <bpmn:task id="hand-over" name="Hand over the order to the logistics provider" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="send-tracking" name="Send the tracking information to the customer" />
    <bpmn:task id="monitor" name="Monitor the shipment until it reaches the customer's address" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="end" name="Order delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="place" />
    <bpmn:sequenceFlow id="f2" sourceRef="place" targetRef="generate-confirmation" />
    <bpmn:sequenceFlow id="f3" sourceRef="generate-confirmation" targetRef="send-confirmation" />
    <bpmn:sequenceFlow id="f4" sourceRef="send-confirmation" targetRef="pick-pack" />
    <bpmn:sequenceFlow id="f5" sourceRef="pick-pack" targetRef="generate-label" />
    <bpmn:sequenceFlow id="f6" sourceRef="generate-label" targetRef="hand-over" />
    <bpmn:sequenceFlow id="f7" sourceRef="hand-over" targetRef="split" />
    <bpmn:sequenceFlow id="f8" sourceRef="split" targetRef="send-tracking" />
    <bpmn:sequenceFlow id="f9" sourceRef="split" targetRef="monitor" />
    <bpmn:sequenceFlow id="f10" sourceRef="send-tracking" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="monitor" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
