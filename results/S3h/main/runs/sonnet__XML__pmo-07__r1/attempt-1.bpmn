<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Travel company" processRef="booking-process" />
  </bpmn:collaboration>
  <bpmn:process id="booking-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fbq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endfb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endnofb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-system" name="Booking system">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-company" name="Travel company">
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendrem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remmerge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer needs a ticket" />
    <bpmn:task id="search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="select" name="Select the preferred route, date, and time" />
    <bpmn:task id="provide" name="Provide personal information and payment details" />
    <bpmn:task id="generate" name="Generate the ticket" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="channel" name="Delivery channel?" />
    <bpmn:task id="email" name="Send the ticket via email" />
    <bpmn:task id="sms" name="Send the ticket via SMS" />
    <bpmn:exclusiveGateway id="chmerge" />
    <bpmn:task id="update" name="Update the seat inventory" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="remind" name="Reminders needed?" />
    <bpmn:task id="sendrem" name="Send reminders and check-in or boarding instructions" />
    <bpmn:exclusiveGateway id="remmerge" />
    <bpmn:task id="journey" name="Complete the journey" />
    <bpmn:exclusiveGateway id="fbq" name="Feedback given?" />
    <bpmn:task id="feedback" name="Provide post-travel feedback" />
    <bpmn:endEvent id="endfb" name="Journey completed with feedback" />
    <bpmn:endEvent id="endnofb" name="Journey completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="search" />
    <bpmn:sequenceFlow id="f2" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f3" sourceRef="select" targetRef="provide" />
    <bpmn:sequenceFlow id="f4" sourceRef="provide" targetRef="generate" />
    <bpmn:sequenceFlow id="f5" sourceRef="generate" targetRef="split" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="channel" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="update" />
    <bpmn:sequenceFlow id="f8" name="email" sourceRef="channel" targetRef="email" />
    <bpmn:sequenceFlow id="f9" name="SMS" sourceRef="channel" targetRef="sms" />
    <bpmn:sequenceFlow id="f10" sourceRef="email" targetRef="chmerge" />
    <bpmn:sequenceFlow id="f11" sourceRef="sms" targetRef="chmerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="chmerge" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="update" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="join" targetRef="remind" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="remind" targetRef="sendrem" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="remind" targetRef="remmerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="sendrem" targetRef="remmerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="remmerge" targetRef="journey" />
    <bpmn:sequenceFlow id="f19" sourceRef="journey" targetRef="fbq" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="fbq" targetRef="feedback" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="fbq" targetRef="endnofb" />
    <bpmn:sequenceFlow id="f22" sourceRef="feedback" targetRef="endfb" />
  </bpmn:process>
</bpmn:definitions>
