<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="requester" name="Employee or Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFailed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="IT solution needed" />
    <bpmn:task id="submit" name="Submit the request for an IT solution" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" default="f5" />
    <bpmn:task id="procure" name="Procure the tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in a controlled environment" />
    <bpmn:exclusiveGateway id="passed" name="Test successful?" default="f10" />
    <bpmn:task id="rollout" name="Roll out the solution to the requesting department" />
    <bpmn:exclusiveGateway id="trainq" name="Training needed?" default="f13" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:exclusiveGateway id="trainmerge" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="endDone" name="Solution in use" />
    <bpmn:endEvent id="endRejected" name="Request rejected" />
    <bpmn:endEvent id="endFailed" name="Solution not accepted" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f3" sourceRef="assess" targetRef="approved" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="approved" targetRef="procure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="approved" targetRef="endRejected" />
    <bpmn:sequenceFlow id="f6" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f7" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f8" sourceRef="test" targetRef="passed" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="passed" targetRef="rollout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">testSuccessful == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="passed" targetRef="endFailed" />
    <bpmn:sequenceFlow id="f11" sourceRef="rollout" targetRef="trainq" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="trainq" targetRef="training">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trainingNeeded == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="trainq" targetRef="trainmerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="training" targetRef="trainmerge" />
    <bpmn:sequenceFlow id="f15" sourceRef="trainmerge" targetRef="support" />
    <bpmn:sequenceFlow id="f16" sourceRef="support" targetRef="endDone" />
  </bpmn:process>
</bpmn:definitions>
