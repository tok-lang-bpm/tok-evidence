<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Subscription Service" processRef="subscription-process" />
  </bpmn:collaboration>
  <bpmn:process id="subscription-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Team">
        <bpmn:flowNodeRef>process_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_charges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer wants a subscription" />
    <bpmn:task id="signup" name="Enter personal and payment information" />
    <bpmn:task id="generate" name="Generate the account" />
    <bpmn:task id="assign" name="Assign access" />
    <bpmn:task id="billing" name="Trigger automated billing cycles" />
    <bpmn:task id="updates" name="Send updates, product enhancements or renewal notifications" />
    <bpmn:task id="receive" name="Receive updates, product enhancements or renewal notifications" />
    <bpmn:exclusiveGateway id="cancel_gw" name="Does the customer cancel?" />
    <bpmn:task id="submit_cancel" name="Submit the cancellation request" />
    <bpmn:endEvent id="continue_end" name="Subscription continues" />
    <bpmn:task id="process_cancel" name="Process the cancellation request" />
    <bpmn:exclusiveGateway id="refund_gw" name="Which terms apply?" />
    <bpmn:task id="apply_refund" name="Apply the refund" />
    <bpmn:task id="apply_charges" name="Apply the charges" />
    <bpmn:exclusiveGateway id="refund_merge" />
    <bpmn:task id="deactivate" name="Deactivate the subscription" />
    <bpmn:task id="settle" name="Settle the final account balance" />
    <bpmn:endEvent id="end" name="Subscription closed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="signup" />
    <bpmn:sequenceFlow id="f2" sourceRef="signup" targetRef="generate" />
    <bpmn:sequenceFlow id="f3" sourceRef="generate" targetRef="assign" />
    <bpmn:sequenceFlow id="f4" sourceRef="assign" targetRef="billing" />
    <bpmn:sequenceFlow id="f5" sourceRef="billing" targetRef="updates" />
    <bpmn:sequenceFlow id="f6" sourceRef="updates" targetRef="receive" />
    <bpmn:sequenceFlow id="f7" sourceRef="receive" targetRef="cancel_gw" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="cancel_gw" targetRef="submit_cancel" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="cancel_gw" targetRef="continue_end" />
    <bpmn:sequenceFlow id="f10" sourceRef="submit_cancel" targetRef="process_cancel" />
    <bpmn:sequenceFlow id="f11" sourceRef="process_cancel" targetRef="refund_gw" />
    <bpmn:sequenceFlow id="f12" name="refund due" sourceRef="refund_gw" targetRef="apply_refund" />
    <bpmn:sequenceFlow id="f13" name="charges due" sourceRef="refund_gw" targetRef="apply_charges" />
    <bpmn:sequenceFlow id="f14" sourceRef="apply_refund" targetRef="refund_merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="apply_charges" targetRef="refund_merge" />
    <bpmn:sequenceFlow id="f16" sourceRef="refund_merge" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f17" sourceRef="deactivate" targetRef="settle" />
    <bpmn:sequenceFlow id="f18" sourceRef="settle" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
