<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="E-commerce company" processRef="fulfillment" />
  </bpmn:collaboration>
  <bpmn:process id="fulfillment" isExecutable="false">
    <bpmn:laneSet id="fulfillment-lanes">
      <bpmn:lane id="lane-system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informdelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivebo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateinv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endret</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-shipping" name="Shipping department">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order placed" />
    <bpmn:task id="record" name="Record the order details" />
    <bpmn:task id="pay" name="Process the payment" />
    <bpmn:exclusiveGateway id="payok" name="Payment successful?" />
    <bpmn:task id="notifyfail" name="Notify the customer about the failed payment" />
    <bpmn:endEvent id="endfail" name="Order cancelled" />
    <bpmn:task id="stock" name="Check the stock availability" />
    <bpmn:exclusiveGateway id="instock" name="Items in stock?" />
    <bpmn:task id="backorder" name="Initiate a back-order" />
    <bpmn:task id="informdelay" name="Inform the customer about the delay" />
    <bpmn:task id="receivebo" name="Receive the back-order" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:task id="pick" name="Pick the items from the warehouse" />
    <bpmn:task id="qc" name="Perform quality control checks on the picked items" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="package" name="Package the items" />
    <bpmn:exclusiveGateway id="giftq" name="Gift wrapping requested?" />
    <bpmn:task id="wrap" name="Wrap the gift" />
    <bpmn:exclusiveGateway id="giftmerge" />
    <bpmn:task id="docs" name="Prepare the shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs" name="Prepare the customs documentation" />
    <bpmn:exclusiveGateway id="intlmerge" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="confirmship" name="Send the shipping confirmation to the customer" />
    <bpmn:task id="updateinv" name="Update the inventory levels" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="delivered" name="Confirm the successful delivery" />
    <bpmn:exclusiveGateway id="issues" name="Customer reports issues?" />
    <bpmn:task id="feedback" name="Send a follow-up email for feedback" />
    <bpmn:endEvent id="endok" name="Order completed" />
    <bpmn:task id="label" name="Send a return shipping label" />
    <bpmn:task id="receiveret" name="Receive the returned items" />
    <bpmn:task id="inspect" name="Inspect the returned items" />
    <bpmn:task id="refund" name="Process a refund or replacement" />
    <bpmn:endEvent id="endret" name="Return handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="record" />
    <bpmn:sequenceFlow id="f2" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f3" sourceRef="pay" targetRef="payok" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="payok" targetRef="notifyfail" />
    <bpmn:sequenceFlow id="f5" sourceRef="notifyfail" targetRef="endfail" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="payok" targetRef="stock" />
    <bpmn:sequenceFlow id="f7" sourceRef="stock" targetRef="instock" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f9" sourceRef="backorder" targetRef="informdelay" />
    <bpmn:sequenceFlow id="f10" sourceRef="informdelay" targetRef="receivebo" />
    <bpmn:sequenceFlow id="f11" sourceRef="receivebo" targetRef="merge1" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="instock" targetRef="merge1" />
    <bpmn:sequenceFlow id="f13" sourceRef="merge1" targetRef="pick" />
    <bpmn:sequenceFlow id="f14" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f15" sourceRef="qc" targetRef="split1" />
    <bpmn:sequenceFlow id="f16" sourceRef="split1" targetRef="package" />
    <bpmn:sequenceFlow id="f17" sourceRef="split1" targetRef="docs" />
    <bpmn:sequenceFlow id="f18" sourceRef="package" targetRef="giftq" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="giftq" targetRef="wrap" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="giftq" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f21" sourceRef="wrap" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="giftmerge" targetRef="join1" />
    <bpmn:sequenceFlow id="f23" sourceRef="docs" targetRef="intl" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="intl" targetRef="customs" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f26" sourceRef="customs" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f27" sourceRef="intlmerge" targetRef="join1" />
    <bpmn:sequenceFlow id="f28" sourceRef="join1" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f29" sourceRef="dispatch" targetRef="split2" />
    <bpmn:sequenceFlow id="f30" sourceRef="split2" targetRef="confirmship" />
    <bpmn:sequenceFlow id="f31" sourceRef="split2" targetRef="updateinv" />
    <bpmn:sequenceFlow id="f32" sourceRef="confirmship" targetRef="join2" />
    <bpmn:sequenceFlow id="f33" sourceRef="updateinv" targetRef="join2" />
    <bpmn:sequenceFlow id="f34" sourceRef="join2" targetRef="delivered" />
    <bpmn:sequenceFlow id="f35" sourceRef="delivered" targetRef="issues" />
    <bpmn:sequenceFlow id="f36" name="no" sourceRef="issues" targetRef="feedback" />
    <bpmn:sequenceFlow id="f37" sourceRef="feedback" targetRef="endok" />
    <bpmn:sequenceFlow id="f38" name="yes" sourceRef="issues" targetRef="label" />
    <bpmn:sequenceFlow id="f39" sourceRef="label" targetRef="receiveret" />
    <bpmn:sequenceFlow id="f40" sourceRef="receiveret" targetRef="inspect" />
    <bpmn:sequenceFlow id="f41" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f42" sourceRef="refund" targetRef="endret" />
  </bpmn:process>
</bpmn:definitions>
