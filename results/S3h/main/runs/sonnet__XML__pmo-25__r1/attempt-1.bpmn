<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Job search" processRef="job-process" />
  </bpmn:collaboration>
  <bpmn:process id="job-process" isExecutable="false">
    <bpmn:laneSet id="job-lanes">
      <bpmn:lane id="lane-applicant" name="Job applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lowRated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endPermanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNotPermanent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviewQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApplicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-platform" name="Job platform">
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continueOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endContinue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Job search started" />
    <bpmn:task id="write" name="Write the job application" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="report" name="Report the job application" />
    <bpmn:task id="offers" name="Send new potential job offers" />
    <bpmn:endEvent id="endReported" name="Job offers sent" />
    <bpmn:task id="confirm" name="Confirm the receipt of the job application" />
    <bpmn:task id="rate" name="Rate the job application" />
    <bpmn:exclusiveGateway id="interviewQ" name="Job interview wanted?" />
    <bpmn:task id="negotiate" name="Negotiate the job interview" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:exclusiveGateway id="wants" name="Company wants you to work for them?" />
    <bpmn:endEvent id="endRejected" name="Application rejected" />
    <bpmn:task id="probation" name="Enter the probation phase" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="rateCompany" name="Rate the company" />
    <bpmn:task id="rateApplicant" name="Rate the job applicant" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:parallelGateway id="split3" />
    <bpmn:intermediateCatchEvent id="wait" name="1 year passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="publish" name="Show the company review to job applicants" />
    <bpmn:endEvent id="endPublished" name="Review visible" />
    <bpmn:exclusiveGateway id="permanent" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="lowRated" name="Company rated C or less?" />
    <bpmn:task id="continueOffers" name="Continue to send job offers" />
    <bpmn:endEvent id="endContinue" name="Job offers continue" />
    <bpmn:endEvent id="endPermanent" name="Process ended" />
    <bpmn:endEvent id="endNotPermanent" name="Job not made permanent" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="write" />
    <bpmn:sequenceFlow id="f2" sourceRef="write" targetRef="split1" />
    <bpmn:sequenceFlow id="f3" sourceRef="split1" targetRef="report" />
    <bpmn:sequenceFlow id="f4" sourceRef="split1" targetRef="confirm" />
    <bpmn:sequenceFlow id="f5" sourceRef="report" targetRef="offers" />
    <bpmn:sequenceFlow id="f6" sourceRef="offers" targetRef="endReported" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f8" sourceRef="rate" targetRef="interviewQ" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="interviewQ" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="interviewQ" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="negotiate" targetRef="merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="merge" targetRef="wants" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="wants" targetRef="probation" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="wants" targetRef="endRejected" />
    <bpmn:sequenceFlow id="f15" sourceRef="probation" targetRef="split2" />
    <bpmn:sequenceFlow id="f16" sourceRef="split2" targetRef="rateCompany" />
    <bpmn:sequenceFlow id="f17" sourceRef="split2" targetRef="rateApplicant" />
    <bpmn:sequenceFlow id="f18" sourceRef="rateCompany" targetRef="join2" />
    <bpmn:sequenceFlow id="f19" sourceRef="rateApplicant" targetRef="join2" />
    <bpmn:sequenceFlow id="f20" sourceRef="join2" targetRef="split3" />
    <bpmn:sequenceFlow id="f21" sourceRef="split3" targetRef="wait" />
    <bpmn:sequenceFlow id="f22" sourceRef="split3" targetRef="permanent" />
    <bpmn:sequenceFlow id="f23" sourceRef="wait" targetRef="publish" />
    <bpmn:sequenceFlow id="f24" sourceRef="publish" targetRef="endPublished" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="permanent" targetRef="lowRated" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="permanent" targetRef="endNotPermanent" />
    <bpmn:sequenceFlow id="f27" name="yes" sourceRef="lowRated" targetRef="continueOffers" />
    <bpmn:sequenceFlow id="f28" name="no" sourceRef="lowRated" targetRef="endPermanent" />
    <bpmn:sequenceFlow id="f29" sourceRef="continueOffers" targetRef="endContinue" />
  </bpmn:process>
</bpmn:definitions>
