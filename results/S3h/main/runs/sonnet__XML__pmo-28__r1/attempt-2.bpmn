<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg-offer" name="Offer" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Internship" processRef="internship-process" />
  </bpmn:collaboration>
  <bpmn:process id="internship-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-student" name="Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-experience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-arrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny-offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-student-update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-company" name="Company">
        <bpmn:flowNodeRef>invalidate-offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-company-update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Internship wanted" />
    <bpmn:task id="enter-topic" name="Enter topic and desired money" />
    <bpmn:task id="enter-experience" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="offer-merge" />
    <bpmn:intermediateCatchEvent id="offer-arrives" name="Offer arrives">
      <bpmn:messageEventDefinition messageRef="msg-offer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="offer-decision" name="Offer accepted?" default="f-no" />
    <bpmn:task id="accept-offer" name="Accept offer" />
    <bpmn:task id="deny-offer" name="Deny offer" />
    <bpmn:task id="invalidate-offers" name="Invalidate all other offers" />
    <bpmn:parallelGateway id="updates-split" />
    <bpmn:task id="write-student-update" name="Write status update about internship">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>3</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:task id="write-company-update" name="Write status update about student">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>3</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="updates-join" />
    <bpmn:task id="recommend" name="Recommend company via twitter">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="end" name="Internship finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter-topic" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter-topic" targetRef="enter-experience" />
    <bpmn:sequenceFlow id="f3" sourceRef="enter-experience" targetRef="offer-merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="offer-merge" targetRef="offer-arrives" />
    <bpmn:sequenceFlow id="f5" sourceRef="offer-arrives" targetRef="offer-decision" />
    <bpmn:sequenceFlow id="f-yes" name="yes" sourceRef="offer-decision" targetRef="accept-offer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">offerAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-no" name="no" sourceRef="offer-decision" targetRef="deny-offer" />
    <bpmn:sequenceFlow id="f6" sourceRef="deny-offer" targetRef="offer-merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="accept-offer" targetRef="invalidate-offers" />
    <bpmn:sequenceFlow id="f8" sourceRef="invalidate-offers" targetRef="updates-split" />
    <bpmn:sequenceFlow id="f9" sourceRef="updates-split" targetRef="write-student-update" />
    <bpmn:sequenceFlow id="f10" sourceRef="updates-split" targetRef="write-company-update" />
    <bpmn:sequenceFlow id="f11" sourceRef="write-student-update" targetRef="updates-join" />
    <bpmn:sequenceFlow id="f12" sourceRef="write-company-update" targetRef="updates-join" />
    <bpmn:sequenceFlow id="f13" sourceRef="updates-join" targetRef="recommend" />
    <bpmn:sequenceFlow id="f14" sourceRef="recommend" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
