<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Blizzard Online Character Generator" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="playerLane" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clickLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>subGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterCC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterIBAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>subMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectChar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nameGw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="blizzardLane" name="Blizzard">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>released</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Character wanted" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="checkAcc" name="Check whether you have a battle.net account" />
    <bpmn:exclusiveGateway id="accGw" name="Battle.net account exists?" />
    <bpmn:task id="enterAcc" name="Enter the account information" />
    <bpmn:task id="clickLink" name="Click the link in the confirmation mail" />
    <bpmn:exclusiveGateway id="accMerge" />
    <bpmn:task id="checkSub" name="Check if you have an active WoW subscription" />
    <bpmn:exclusiveGateway id="subGw" name="Active subscription?" />
    <bpmn:task id="selectPay" name="Select the payment method" />
    <bpmn:exclusiveGateway id="payGw" name="Payment method?" />
    <bpmn:task id="enterCC" name="Enter the credit card information" />
    <bpmn:task id="enterIBAN" name="Enter the IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="payMerge" />
    <bpmn:exclusiveGateway id="subMerge" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="selectChar" name="Select realm, race and class of the character" />
    <bpmn:task id="names" name="Come up with good character names" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="enterName" name="Enter a character name" />
    <bpmn:exclusiveGateway id="nameGw" name="Name still available?" />
    <bpmn:task id="confirm" name="Send the confirmation and selfies of the character" />
    <bpmn:intermediateCatchEvent id="released" name="Expansion released">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="sendMsg" name="Send the expansion release message" />
    <bpmn:endEvent id="end" name="Character created" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="split" />
    <bpmn:sequenceFlow id="f2" sourceRef="split" targetRef="checkAcc" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="names" />
    <bpmn:sequenceFlow id="f4" sourceRef="checkAcc" targetRef="accGw" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="accGw" targetRef="enterAcc" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="accGw" targetRef="accMerge" />
    <bpmn:sequenceFlow id="f7" sourceRef="enterAcc" targetRef="clickLink" />
    <bpmn:sequenceFlow id="f8" sourceRef="clickLink" targetRef="accMerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="accMerge" targetRef="checkSub" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkSub" targetRef="subGw" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="subGw" targetRef="subMerge" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="subGw" targetRef="selectPay" />
    <bpmn:sequenceFlow id="f13" sourceRef="selectPay" targetRef="payGw" />
    <bpmn:sequenceFlow id="f14" name="credit card" sourceRef="payGw" targetRef="enterCC" />
    <bpmn:sequenceFlow id="f15" name="bank account" sourceRef="payGw" targetRef="enterIBAN" />
    <bpmn:sequenceFlow id="f16" sourceRef="enterCC" targetRef="payMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="enterIBAN" targetRef="payMerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="payMerge" targetRef="subMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="subMerge" targetRef="login" />
    <bpmn:sequenceFlow id="f20" sourceRef="login" targetRef="selectChar" />
    <bpmn:sequenceFlow id="f21" sourceRef="selectChar" targetRef="join" />
    <bpmn:sequenceFlow id="f22" sourceRef="names" targetRef="join" />
    <bpmn:sequenceFlow id="f23" sourceRef="join" targetRef="enterName" />
    <bpmn:sequenceFlow id="f24" sourceRef="enterName" targetRef="nameGw" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="nameGw" targetRef="enterName" />
    <bpmn:sequenceFlow id="f26" name="yes" sourceRef="nameGw" targetRef="confirm" />
    <bpmn:sequenceFlow id="f27" sourceRef="confirm" targetRef="released" />
    <bpmn:sequenceFlow id="f28" sourceRef="released" targetRef="sendMsg" />
    <bpmn:sequenceFlow id="f29" sourceRef="sendMsg" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
