<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="3D model printing" processRef="print-process" />
  </bpmn:collaboration>
  <bpmn:process id="print-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkleft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shopping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeleft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergecolor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>poweron</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printer" name="3D printer">
        <bpmn:flowNodeRef>heat</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Custom 3D model wanted" />
    <bpmn:task id="sketches" name="Send sketches to the artist" />
    <bpmn:task id="changes" name="Tell the artist what to change" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with the result?" default="f-sat-no" />
    <bpmn:task id="color" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="instock" name="Color in stock?" default="f-stock-no" />
    <bpmn:task id="checkleft" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under" name="Under 100 grams?" default="f-under-no" />
    <bpmn:task id="shopping" name="Put the color on the shopping list" />
    <bpmn:exclusiveGateway id="mergeleft" />
    <bpmn:task id="order" name="Order the color" />
    <bpmn:exclusiveGateway id="mergecolor" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="poweron" name="Turn the printer on" />
    <bpmn:task id="heat" name="Heat up the bed and the extruder" />
    <bpmn:task id="gcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="print" name="Print the model" />
    <bpmn:endEvent id="end" name="Model printed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sketches" />
    <bpmn:sequenceFlow id="f2" sourceRef="sketches" targetRef="changes" />
    <bpmn:sequenceFlow id="f3" sourceRef="changes" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-sat-no" name="no" sourceRef="satisfied" targetRef="changes" />
    <bpmn:sequenceFlow id="f-sat-yes" name="yes" sourceRef="satisfied" targetRef="color">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">satisfied == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="color" targetRef="instock" />
    <bpmn:sequenceFlow id="f-stock-yes" name="yes" sourceRef="instock" targetRef="checkleft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">inStock == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-stock-no" name="no" sourceRef="instock" targetRef="order" />
    <bpmn:sequenceFlow id="f5" sourceRef="checkleft" targetRef="under" />
    <bpmn:sequenceFlow id="f-under-yes" name="yes" sourceRef="under" targetRef="shopping">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">gramsLeft &lt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-under-no" name="no" sourceRef="under" targetRef="mergeleft" />
    <bpmn:sequenceFlow id="f6" sourceRef="shopping" targetRef="mergeleft" />
    <bpmn:sequenceFlow id="f7" sourceRef="mergeleft" targetRef="mergecolor" />
    <bpmn:sequenceFlow id="f8" sourceRef="order" targetRef="mergecolor" />
    <bpmn:sequenceFlow id="f9" sourceRef="mergecolor" targetRef="split" />
    <bpmn:sequenceFlow id="f10" sourceRef="split" targetRef="poweron" />
    <bpmn:sequenceFlow id="f11" sourceRef="split" targetRef="gcode" />
    <bpmn:sequenceFlow id="f12" sourceRef="poweron" targetRef="heat" />
    <bpmn:sequenceFlow id="f13" sourceRef="heat" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="gcode" targetRef="join" />
    <bpmn:sequenceFlow id="f15" sourceRef="join" targetRef="print" />
    <bpmn:sequenceFlow id="f16" sourceRef="print" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
