<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="DIY smartphone screen repair" processRef="repair-process" />
  </bpmn:collaboration>
  <bpmn:process id="repair-process" isExecutable="false">
    <bpmn:laneSet id="repair-lanes">
      <bpmn:lane id="lane-user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>borrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stillmissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-tool" name="Online tool">
        <bpmn:flowNodeRef>lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Phone screen broken" />
    <bpmn:task id="enter" name="Enter the model and what is broken" />
    <bpmn:task id="lists" name="Give the list of materials, the list of tools and the ordering choices" />
    <bpmn:task id="check" name="Check what you already have" />
    <bpmn:exclusiveGateway id="missing" name="Is something missing?" default="f6" />
    <bpmn:task id="contact" name="Contact friends" />
    <bpmn:task id="borrow" name="Borrow or buy stuff from friends" />
    <bpmn:exclusiveGateway id="stillmissing" name="Is something still missing?" default="f10" />
    <bpmn:task id="buy" name="Buy the rest" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="instructions" name="Give the repair instructions" />
    <bpmn:task id="fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="worked" name="Did the repair work?" default="f16" />
    <bpmn:task id="review" name="Send a review and/or video" />
    <bpmn:task id="expert" name="Send the phone to an expert" />
    <bpmn:endEvent id="end-ok" name="Phone repaired" />
    <bpmn:endEvent id="end-expert" name="Phone sent to expert" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter" targetRef="lists" />
    <bpmn:sequenceFlow id="f3" sourceRef="lists" targetRef="check" />
    <bpmn:sequenceFlow id="f4" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="missing" targetRef="contact" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="missing" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="contact" targetRef="borrow" />
    <bpmn:sequenceFlow id="f8" sourceRef="borrow" targetRef="stillmissing" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="stillmissing" targetRef="buy" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="stillmissing" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="buy" targetRef="merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="merge" targetRef="instructions" />
    <bpmn:sequenceFlow id="f13" sourceRef="instructions" targetRef="fix" />
    <bpmn:sequenceFlow id="f14" sourceRef="fix" targetRef="worked" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="worked" targetRef="review" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="worked" targetRef="expert" />
    <bpmn:sequenceFlow id="f17" sourceRef="review" targetRef="end-ok" />
    <bpmn:sequenceFlow id="f18" sourceRef="expert" targetRef="end-expert" />
  </bpmn:process>
</bpmn:definitions>
