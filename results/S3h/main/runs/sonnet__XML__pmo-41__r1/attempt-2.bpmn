<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Machine inspection" processRef="inspection-process" />
  </bpmn:collaboration>
  <bpmn:process id="inspection-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="application" name="Inspection application">
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askmore</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Inspection needed" />
    <bpmn:task id="enter" name="Enter the machine type and serial number" />
    <bpmn:task id="ask" name="Ask questions" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="input" name="Input values" />
    <bpmn:task id="press" name="Press buttons" />
    <bpmn:task id="collect" name="Collect values from the machine" />
    <bpmn:task id="show" name="Show values" />
    <bpmn:exclusiveGateway id="more" name="Additional questions needed?" default="f11" />
    <bpmn:task id="askmore" name="Ask additional questions" />
    <bpmn:endEvent id="end" name="Inspection completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter" targetRef="ask" />
    <bpmn:sequenceFlow id="f3" sourceRef="ask" targetRef="merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="merge" targetRef="input" />
    <bpmn:sequenceFlow id="f5" sourceRef="input" targetRef="press" />
    <bpmn:sequenceFlow id="f6" sourceRef="press" targetRef="collect" />
    <bpmn:sequenceFlow id="f7" sourceRef="collect" targetRef="show" />
    <bpmn:sequenceFlow id="f8" sourceRef="show" targetRef="more" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="more" targetRef="askmore">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additionalQuestionsNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="askmore" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="more" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
