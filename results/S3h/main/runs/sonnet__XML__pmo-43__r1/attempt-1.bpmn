<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="police" name="Police" processRef="car-service-process" />
  </bpmn:collaboration>
  <bpmn:process id="car-service-process" isExecutable="false">
    <bpmn:laneSet id="car-service-lanes">
      <bpmn:lane id="lane-system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>necessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-unregistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-fined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-owner" name="Car owner">
        <bpmn:flowNodeRef>wait-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>days30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enter-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Car service successful" />
    <bpmn:intermediateCatchEvent id="necessary" name="Service necessary">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="check" name="Check if the car is still registered" />
    <bpmn:exclusiveGateway id="registered" name="Car still registered?" />
    <bpmn:task id="notify" name="Notify the car owner" />
    <bpmn:eventBasedGateway id="wait-gw" />
    <bpmn:intermediateCatchEvent id="arrive" name="Owner arrives at service facility">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="days30" name="30 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fine" name="Fine the car owner" />
    <bpmn:task id="enter-problems" name="Enter the problems of the car" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="repair" name="Repair the car" />
    <bpmn:task id="status" name="Send status updates via email" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="pay" name="Pay through the app" />
    <bpmn:task id="enter-success" name="Enter that the repair was successful and the Pickerl was issued" />
    <bpmn:task id="enter-next" name="Enter the time for the next service" />
    <bpmn:endEvent id="end-unregistered" name="Car not registered" />
    <bpmn:endEvent id="end-fined" name="Owner fined" />
    <bpmn:endEvent id="end-done" name="Car service completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="necessary" />
    <bpmn:sequenceFlow id="f2" sourceRef="necessary" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="registered" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="registered" targetRef="notify" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="registered" targetRef="end-unregistered" />
    <bpmn:sequenceFlow id="f6" sourceRef="notify" targetRef="wait-gw" />
    <bpmn:sequenceFlow id="f7" sourceRef="wait-gw" targetRef="arrive" />
    <bpmn:sequenceFlow id="f8" sourceRef="wait-gw" targetRef="days30" />
    <bpmn:sequenceFlow id="f9" sourceRef="days30" targetRef="fine" />
    <bpmn:sequenceFlow id="f10" sourceRef="fine" targetRef="end-fined" />
    <bpmn:sequenceFlow id="f11" sourceRef="arrive" targetRef="enter-problems" />
    <bpmn:sequenceFlow id="f12" sourceRef="enter-problems" targetRef="split" />
    <bpmn:sequenceFlow id="f13" sourceRef="split" targetRef="repair" />
    <bpmn:sequenceFlow id="f14" sourceRef="split" targetRef="status" />
    <bpmn:sequenceFlow id="f15" sourceRef="repair" targetRef="join" />
    <bpmn:sequenceFlow id="f16" sourceRef="status" targetRef="join" />
    <bpmn:sequenceFlow id="f17" sourceRef="join" targetRef="pay" />
    <bpmn:sequenceFlow id="f18" sourceRef="pay" targetRef="enter-success" />
    <bpmn:sequenceFlow id="f19" sourceRef="enter-success" targetRef="enter-next" />
    <bpmn:sequenceFlow id="f20" sourceRef="enter-next" targetRef="end-done" />
  </bpmn:process>
</bpmn:definitions>
