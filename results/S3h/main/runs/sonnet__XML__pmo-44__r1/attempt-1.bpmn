<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Robotic Burger Seller" processRef="burger-process" />
  </bpmn:collaboration>
  <bpmn:process id="burger-process" isExecutable="false">
    <bpmn:laneSet id="burger-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side-gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order arrives" />
    <bpmn:task id="receive" name="Receive an order" />
    <bpmn:task id="ask-menu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="menu-gw" name="Menu or just the burger?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="drink" name="Prepare the drink" />
    <bpmn:task id="ask-side" name="Ask whether the customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="side-gw" name="Fries or wedges?" />
    <bpmn:task id="fries" name="Prepare the fries" />
    <bpmn:task id="wedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="side-merge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="menu-merge" />
    <bpmn:task id="burger" name="Prepare the burger" />
    <bpmn:boundaryEvent id="timer30" name="Every 30 seconds" attachedToRef="burger" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="update" name="Give an enthusiastic status update" />
    <bpmn:endEvent id="update-end" name="Status update given" />
    <bpmn:task id="deliver" name="Deliver the order via the conveyor belt" />
    <bpmn:endEvent id="end" name="Order delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="ask-menu" />
    <bpmn:sequenceFlow id="f3" sourceRef="ask-menu" targetRef="menu-gw" />
    <bpmn:sequenceFlow id="f4" name="menu" sourceRef="menu-gw" targetRef="split" />
    <bpmn:sequenceFlow id="f5" name="just the burger" sourceRef="menu-gw" targetRef="menu-merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="ask-side" />
    <bpmn:sequenceFlow id="f8" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="ask-side" targetRef="side-gw" />
    <bpmn:sequenceFlow id="f10" name="fries" sourceRef="side-gw" targetRef="fries" />
    <bpmn:sequenceFlow id="f11" name="wedges" sourceRef="side-gw" targetRef="wedges" />
    <bpmn:sequenceFlow id="f12" sourceRef="fries" targetRef="side-merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="wedges" targetRef="side-merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="side-merge" targetRef="join" />
    <bpmn:sequenceFlow id="f15" sourceRef="join" targetRef="menu-merge" />
    <bpmn:sequenceFlow id="f16" sourceRef="menu-merge" targetRef="burger" />
    <bpmn:sequenceFlow id="f17" sourceRef="burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f18" sourceRef="deliver" targetRef="end" />
    <bpmn:sequenceFlow id="f19" sourceRef="timer30" targetRef="update" />
    <bpmn:sequenceFlow id="f20" sourceRef="update" targetRef="update-end" />
  </bpmn:process>
</bpmn:definitions>
