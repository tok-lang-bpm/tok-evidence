<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Online Shop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loopMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allSel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sameAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addrMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="E-Shop System">
        <bpmn:flowNodeRef>checkCred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loginOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>bankConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer wants to order" />
    <bpmn:task id="login" name="Log into the E-Shop system" />
    <bpmn:task id="checkCred" name="Check the credentials" />
    <bpmn:exclusiveGateway id="loginOk" name="Login successful?" />
    <bpmn:endEvent id="endStop" name="Shopping stopped" />
    <bpmn:exclusiveGateway id="loopMerge" />
    <bpmn:task id="select" name="Select a product" />
    <bpmn:task id="add" name="Add the product to the shopping cart" />
    <bpmn:task id="save" name="Save the product" />
    <bpmn:task id="checkAll" name="Check if every product was selected" />
    <bpmn:exclusiveGateway id="allSel" name="Every product selected?" />
    <bpmn:task id="finish" name="Finish the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="payData" name="Enter the payment data" />
    <bpmn:task id="bankConfirm" name="Confirm the payment" />
    <bpmn:task id="shipAddr" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="sameAddr" name="Billing address equal to shipping address?" />
    <bpmn:task id="billAddr" name="Enter the billing address" />
    <bpmn:exclusiveGateway id="addrMerge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="finalize" name="Finalise the order" />
    <bpmn:endEvent id="endDone" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="checkCred" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkCred" targetRef="loginOk" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="loginOk" targetRef="endStop" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="loginOk" targetRef="loopMerge" />
    <bpmn:sequenceFlow id="f6" sourceRef="loopMerge" targetRef="select" />
    <bpmn:sequenceFlow id="f7" sourceRef="select" targetRef="add" />
    <bpmn:sequenceFlow id="f8" sourceRef="add" targetRef="save" />
    <bpmn:sequenceFlow id="f9" sourceRef="save" targetRef="checkAll" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkAll" targetRef="allSel" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="allSel" targetRef="loopMerge" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="allSel" targetRef="finish" />
    <bpmn:sequenceFlow id="f13" sourceRef="finish" targetRef="split" />
    <bpmn:sequenceFlow id="f14" sourceRef="split" targetRef="payData" />
    <bpmn:sequenceFlow id="f15" sourceRef="split" targetRef="shipAddr" />
    <bpmn:sequenceFlow id="f16" sourceRef="payData" targetRef="bankConfirm" />
    <bpmn:sequenceFlow id="f17" sourceRef="bankConfirm" targetRef="join" />
    <bpmn:sequenceFlow id="f18" sourceRef="shipAddr" targetRef="sameAddr" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="sameAddr" targetRef="billAddr" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="sameAddr" targetRef="addrMerge" />
    <bpmn:sequenceFlow id="f21" sourceRef="billAddr" targetRef="addrMerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="addrMerge" targetRef="join" />
    <bpmn:sequenceFlow id="f23" sourceRef="join" targetRef="finalize" />
    <bpmn:sequenceFlow id="f24" sourceRef="finalize" targetRef="endDone" />
  </bpmn:process>
</bpmn:definitions>
