<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Sports Institute" processRef="usi-process" />
  </bpmn:collaboration>
  <bpmn:process id="usi-process" isExecutable="false">
    <bpmn:laneSet id="usi-lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkUni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestAct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-system" name="System">
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Course registration wanted" />
    <bpmn:task id="selectCourse" name="Select a course" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" />
    <bpmn:task id="tell" name="Tell the courses and dates" />
    <bpmn:task id="selectOne" name="Select one course" />
    <bpmn:task id="checkAcc" name="Check if you already have an account" />
    <bpmn:exclusiveGateway id="hasAcc" name="Account at the sports institute?" />
    <bpmn:task id="checkUni" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Registered at an eligible university?" />
    <bpmn:task id="register" name="Register your account" />
    <bpmn:task id="requestAct" name="Request an activation" />
    <bpmn:task id="waitResp" name="Wait for a response" />
    <bpmn:exclusiveGateway id="accMerge" />
    <bpmn:task id="login" name="Log into your account" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete" name="Complete the registration for the course" />
    <bpmn:task id="pay" name="Provide the payment information" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="ticket" name="Receive the course ticket" />
    <bpmn:endEvent id="endOk" name="Registration completed" />
    <bpmn:endEvent id="endNo" name="No registration possible" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectCourse" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectCourse" targetRef="slots" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="slots" targetRef="tell" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="slots" targetRef="endNo" />
    <bpmn:sequenceFlow id="f5" sourceRef="tell" targetRef="selectOne" />
    <bpmn:sequenceFlow id="f6" sourceRef="selectOne" targetRef="checkAcc" />
    <bpmn:sequenceFlow id="f7" sourceRef="checkAcc" targetRef="hasAcc" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="hasAcc" targetRef="accMerge" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="hasAcc" targetRef="checkUni" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkUni" targetRef="eligible" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="eligible" targetRef="register" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="eligible" targetRef="requestAct" />
    <bpmn:sequenceFlow id="f13" sourceRef="requestAct" targetRef="waitResp" />
    <bpmn:sequenceFlow id="f14" sourceRef="register" targetRef="accMerge" />
    <bpmn:sequenceFlow id="f15" sourceRef="waitResp" targetRef="accMerge" />
    <bpmn:sequenceFlow id="f16" sourceRef="accMerge" targetRef="login" />
    <bpmn:sequenceFlow id="f17" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f18" sourceRef="split" targetRef="tweet" />
    <bpmn:sequenceFlow id="f19" sourceRef="split" targetRef="complete" />
    <bpmn:sequenceFlow id="f20" sourceRef="complete" targetRef="pay" />
    <bpmn:sequenceFlow id="f21" sourceRef="tweet" targetRef="join" />
    <bpmn:sequenceFlow id="f22" sourceRef="pay" targetRef="join" />
    <bpmn:sequenceFlow id="f23" sourceRef="join" targetRef="ticket" />
    <bpmn:sequenceFlow id="f24" sourceRef="ticket" targetRef="endOk" />
  </bpmn:process>
</bpmn:definitions>
