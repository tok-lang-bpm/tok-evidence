<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Vienna Night Run participation" processRef="nightrun-process" />
  </bpmn:collaboration>
  <bpmn:process id="nightrun-process" isExecutable="false">
    <bpmn:laneSet id="nightrun-lanes">
      <bpmn:lane id="runner" name="Runner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getnum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromhome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runnight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Wish to participate at the Night Run" />
    <bpmn:task id="select" name="Select a starting block" />
    <bpmn:task id="run5" name="Run 5km" />
    <bpmn:task id="measure" name="Measure the time" />
    <bpmn:exclusiveGateway id="fast" name="Time less than 25 minutes?" default="f6" />
    <bpmn:task id="train" name="Train and check" />
    <bpmn:task id="getnum" name="Get the starting number" />
    <bpmn:task id="findout" name="Find out when the work day ends" />
    <bpmn:exclusiveGateway id="hour" name="More than one hour left between work day end and starting time?" default="f11" />
    <bpmn:task id="fromhome" name="Go to the Night Run from home" />
    <bpmn:task id="fromwork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="arrived" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="runnight" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="receive" name="Receive the final running time" />
    <bpmn:endEvent id="end" name="Night Run completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="select" />
    <bpmn:sequenceFlow id="f2" sourceRef="select" targetRef="run5" />
    <bpmn:sequenceFlow id="f3" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f4" sourceRef="measure" targetRef="fast" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="fast" targetRef="getnum">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">time &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="fast" targetRef="train" />
    <bpmn:sequenceFlow id="f7" sourceRef="train" targetRef="run5" />
    <bpmn:sequenceFlow id="f8" sourceRef="getnum" targetRef="findout" />
    <bpmn:sequenceFlow id="f9" sourceRef="findout" targetRef="hour" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="hour" targetRef="fromhome">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">hoursLeft &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="hour" targetRef="fromwork" />
    <bpmn:sequenceFlow id="f12" sourceRef="fromhome" targetRef="arrived" />
    <bpmn:sequenceFlow id="f13" sourceRef="fromwork" targetRef="arrived" />
    <bpmn:sequenceFlow id="f14" sourceRef="arrived" targetRef="split" />
    <bpmn:sequenceFlow id="f15" sourceRef="split" targetRef="runnight" />
    <bpmn:sequenceFlow id="f16" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f17" sourceRef="runnight" targetRef="join" />
    <bpmn:sequenceFlow id="f18" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f19" sourceRef="join" targetRef="receive" />
    <bpmn:sequenceFlow id="f20" sourceRef="receive" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
