<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Central venous catheterization" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="DOCTOR" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gelprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterilegel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pospatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncturemerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkblood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloodok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removesyringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installwire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removetrocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wiresplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>longaxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shortaxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirejoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkposition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positionok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifyflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkcatheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Catheterization needed" />
    <bpmn:task id="prepare" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="dress" name="Get in sterile clothes" />
    <bpmn:task id="clean" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="configure" name="Configure the ultrasound" />
    <bpmn:task id="gelprobe" name="Put gel in the probe" />
    <bpmn:task id="cover" name="Cover the probe" />
    <bpmn:task id="sterilegel" name="Put the sterile gel" />
    <bpmn:task id="posprobe" name="Position the probe" />
    <bpmn:task id="pospatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="veinsplit" name="Which identification?" />
    <bpmn:task id="anatomic" name="Identify the vein using an anatomic identification" />
    <bpmn:task id="doppler" name="Identify the vein using a doppler identification" />
    <bpmn:task id="compression" name="Identify the vein using a compression identification" />
    <bpmn:exclusiveGateway id="veinjoin" />
    <bpmn:exclusiveGateway id="puncturemerge" />
    <bpmn:task id="anesthetize" name="Anesthetize the patient" />
    <bpmn:task id="puncture" name="Puncture the patient" />
    <bpmn:task id="checkblood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="bloodok" name="Blood return correct?" />
    <bpmn:task id="dropprobe" name="Drop the probe" />
    <bpmn:task id="removesyringe" name="Remove the syringe" />
    <bpmn:task id="installwire" name="Install the guidewire" />
    <bpmn:task id="removetrocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="wiresplit" name="Which wire check?" />
    <bpmn:task id="longaxis" name="Check the wire in the long axis" />
    <bpmn:task id="shortaxis" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="wirejoin" />
    <bpmn:task id="checkposition" name="Check if the wire is in good position" />
    <bpmn:exclusiveGateway id="positionok" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="removewire" name="Remove the guidewire" />
    <bpmn:task id="verifyflow" name="Verify the flow and the reflow" />
    <bpmn:task id="checkcatheter" name="Check the catheter position" />
    <bpmn:endEvent id="end" name="Catheter placed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f2" sourceRef="prepare" targetRef="wash" />
    <bpmn:sequenceFlow id="f3" sourceRef="wash" targetRef="dress" />
    <bpmn:sequenceFlow id="f4" sourceRef="dress" targetRef="clean" />
    <bpmn:sequenceFlow id="f5" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f6" sourceRef="drape" targetRef="configure" />
    <bpmn:sequenceFlow id="f7" sourceRef="configure" targetRef="gelprobe" />
    <bpmn:sequenceFlow id="f8" sourceRef="gelprobe" targetRef="cover" />
    <bpmn:sequenceFlow id="f9" sourceRef="cover" targetRef="sterilegel" />
    <bpmn:sequenceFlow id="f10" sourceRef="sterilegel" targetRef="posprobe" />
    <bpmn:sequenceFlow id="f11" sourceRef="posprobe" targetRef="pospatient" />
    <bpmn:sequenceFlow id="f12" sourceRef="pospatient" targetRef="veinsplit" />
    <bpmn:sequenceFlow id="f13" name="anatomic" sourceRef="veinsplit" targetRef="anatomic" />
    <bpmn:sequenceFlow id="f14" name="doppler" sourceRef="veinsplit" targetRef="doppler" />
    <bpmn:sequenceFlow id="f15" name="compression" sourceRef="veinsplit" targetRef="compression" />
    <bpmn:sequenceFlow id="f16" sourceRef="anatomic" targetRef="veinjoin" />
    <bpmn:sequenceFlow id="f17" sourceRef="doppler" targetRef="veinjoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="compression" targetRef="veinjoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="veinjoin" targetRef="puncturemerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="puncturemerge" targetRef="anesthetize" />
    <bpmn:sequenceFlow id="f21" sourceRef="anesthetize" targetRef="puncture" />
    <bpmn:sequenceFlow id="f22" sourceRef="puncture" targetRef="checkblood" />
    <bpmn:sequenceFlow id="f23" sourceRef="checkblood" targetRef="bloodok" />
    <bpmn:sequenceFlow id="f24" name="no" sourceRef="bloodok" targetRef="puncturemerge" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="bloodok" targetRef="dropprobe" />
    <bpmn:sequenceFlow id="f26" sourceRef="dropprobe" targetRef="removesyringe" />
    <bpmn:sequenceFlow id="f27" sourceRef="removesyringe" targetRef="installwire" />
    <bpmn:sequenceFlow id="f28" sourceRef="installwire" targetRef="removetrocar" />
    <bpmn:sequenceFlow id="f29" sourceRef="removetrocar" targetRef="wiresplit" />
    <bpmn:sequenceFlow id="f30" name="long axis" sourceRef="wiresplit" targetRef="longaxis" />
    <bpmn:sequenceFlow id="f31" name="short axis" sourceRef="wiresplit" targetRef="shortaxis" />
    <bpmn:sequenceFlow id="f32" sourceRef="longaxis" targetRef="wirejoin" />
    <bpmn:sequenceFlow id="f33" sourceRef="shortaxis" targetRef="wirejoin" />
    <bpmn:sequenceFlow id="f34" sourceRef="wirejoin" targetRef="checkposition" />
    <bpmn:sequenceFlow id="f35" sourceRef="checkposition" targetRef="positionok" />
    <bpmn:sequenceFlow id="f36" name="no" sourceRef="positionok" targetRef="puncturemerge" />
    <bpmn:sequenceFlow id="f37" name="yes" sourceRef="positionok" targetRef="widen" />
    <bpmn:sequenceFlow id="f38" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f39" sourceRef="advance" targetRef="removewire" />
    <bpmn:sequenceFlow id="f40" sourceRef="removewire" targetRef="verifyflow" />
    <bpmn:sequenceFlow id="f41" sourceRef="verifyflow" targetRef="checkcatheter" />
    <bpmn:sequenceFlow id="f42" sourceRef="checkcatheter" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
