<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Supplier selection and onboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Supplier selection and onboarding" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visitq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visitm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Need for a new supplier identified" />
    <bpmn:task id="identify" name="Identify the need for a new supplier" />
    <bpmn:task id="issue" name="Issue the request for proposals" />
    <bpmn:task id="receive" name="Receive responses from suppliers" />
    <bpmn:task id="evaluate" name="Evaluate the proposals" />
    <bpmn:exclusiveGateway id="visitq" name="Site visits or interviews needed?" />
    <bpmn:task id="visit" name="Conduct site visits or interviews with suppliers" />
    <bpmn:exclusiveGateway id="visitm" />
    <bpmn:task id="select" name="Select the supplier" />
    <bpmn:task id="negotiate" name="Negotiate the contract" />
    <bpmn:exclusiveGateway id="agreed" name="Terms agreed?" />
    <bpmn:task id="sign" name="Sign the contract" />
    <bpmn:task id="onboard" name="Onboard the supplier" />
    <bpmn:task id="execute" name="Execute the contract" />
    <bpmn:endEvent id="done" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f-needed-identify" sourceRef="needed" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-issue" sourceRef="identify" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-receive" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-visitq" sourceRef="evaluate" targetRef="visitq" />
    <bpmn:sequenceFlow id="f-visitq-visit" name="yes" sourceRef="visitq" targetRef="visit" />
    <bpmn:sequenceFlow id="f-visitq-visitm" name="no" sourceRef="visitq" targetRef="visitm" />
    <bpmn:sequenceFlow id="f-visit-visitm" sourceRef="visit" targetRef="visitm" />
    <bpmn:sequenceFlow id="f-visitm-select" sourceRef="visitm" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agreed" sourceRef="negotiate" targetRef="agreed" />
    <bpmn:sequenceFlow id="f-agreed-sign" name="yes" sourceRef="agreed" targetRef="sign" />
    <bpmn:sequenceFlow id="f-agreed-negotiate" name="no" sourceRef="agreed" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-sign-onboard" sourceRef="sign" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-onboard-execute" sourceRef="onboard" targetRef="execute" />
    <bpmn:sequenceFlow id="f-execute-done" sourceRef="execute" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
