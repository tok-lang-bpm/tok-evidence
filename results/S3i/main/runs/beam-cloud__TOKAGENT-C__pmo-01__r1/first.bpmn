<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Sales process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Sales process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="customer" name="Potential Customer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Staff or Customer Support">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="salesrep" name="Sales Representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inquiry" name="Customer inquiry" />
    <bpmn:task id="inquire" name="Inquire about a product or service" />
    <bpmn:task id="approve" name="Approve the quote" />
    <bpmn:task id="receive" name="Receive confirmation of the order" />
    <bpmn:endEvent id="placed" name="Order placed and confirmed" />
    <bpmn:endEvent id="closed" name="Inquiry closed" />
    <bpmn:task id="collect" name="Collect relevant information and address concerns or questions" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="guide" name="Guide the customer through selecting the appropriate product or service" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="record" name="Record the order in the system" />
    <bpmn:sequenceFlow id="f-inquiry-inquire" sourceRef="inquiry" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-collect" sourceRef="inquire" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-interested" sourceRef="collect" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-guide" name="yes" sourceRef="interested" targetRef="guide" />
    <bpmn:sequenceFlow id="f-interested-closed" name="no" sourceRef="interested" targetRef="closed" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approve" sourceRef="quote" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-place" sourceRef="approve" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-record" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-receive" sourceRef="record" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-placed" sourceRef="receive" targetRef="placed" />
  </bpmn:process>
</bpmn:definitions>
