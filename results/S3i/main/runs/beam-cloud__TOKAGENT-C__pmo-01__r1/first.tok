tok 1.0 "Sales process"

pool organisation "Organisation"
  lane customer "Potential Customer"
    start inquiry "Customer inquiry"
    task inquire "Inquire about a product or service"
    task approve "Approve the quote"
    task receive "Receive confirmation of the order"
    end placed "Order placed and confirmed"
    end closed "Inquiry closed"
  lane sales "Sales Staff or Customer Support"
    task collect "Collect relevant information and address concerns or questions"
    xor interested "Customer interested?"
    task guide "Guide the customer through selecting the appropriate product or service"
  lane salesrep "Sales Representative"
    task quote "Provide a quote"
    task place "Place the order"
  lane system "System"
    task record "Record the order in the system"

flow inquiry -> inquire -> collect -> interested
flow interested -> guide "yes"
flow interested -> closed "no"
flow guide -> quote
flow quote -> approve
flow approve -> place
flow place -> record
flow record -> receive
flow receive -> placed
