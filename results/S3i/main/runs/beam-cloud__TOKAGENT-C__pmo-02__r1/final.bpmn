<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Hiring process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Organisation" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Hiring process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nego</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for new hire identified" />
    <bpmn:task id="identify" name="Identify the need for a new hire" />
    <bpmn:task id="create" name="Create a job description" />
    <bpmn:task id="post" name="Post the job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interviews" />
    <bpmn:task id="invite" name="Invite selected candidates for interviews" />
    <bpmn:exclusiveGateway id="mode" name="Interview mode?" />
    <bpmn:task id="inperson" name="Conduct in-person interview" />
    <bpmn:task id="virtual" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="merged" name="Proceed to offer" />
    <bpmn:task id="offer" name="Extend an offer" />
    <bpmn:exclusiveGateway id="nego" name="Salary negotiations?" />
    <bpmn:task id="negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="ready" name="Proceed to onboarding" />
    <bpmn:parallelGateway id="onboard" name="Onboarding" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Conduct orientation" />
    <bpmn:task id="training" name="Conduct training" />
    <bpmn:parallelGateway id="onboarded" name="Onboarding completed" />
    <bpmn:endEvent id="done" name="New hire fully integrated" />
    <bpmn:sequenceFlow id="f-need-identify" sourceRef="need" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-post" sourceRef="create" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-invite" sourceRef="phone" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-mode" sourceRef="invite" targetRef="mode" />
    <bpmn:sequenceFlow id="f-mode-inperson" name="in-person" sourceRef="mode" targetRef="inperson" />
    <bpmn:sequenceFlow id="f-mode-virtual" name="virtual" sourceRef="mode" targetRef="virtual" />
    <bpmn:sequenceFlow id="f-inperson-merged" sourceRef="inperson" targetRef="merged" />
    <bpmn:sequenceFlow id="f-virtual-merged" sourceRef="virtual" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-offer" sourceRef="merged" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-nego" sourceRef="offer" targetRef="nego" />
    <bpmn:sequenceFlow id="f-nego-negotiate" name="yes" sourceRef="nego" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-nego-ready" name="no" sourceRef="nego" targetRef="ready" />
    <bpmn:sequenceFlow id="f-negotiate-ready" sourceRef="negotiate" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-onboard" sourceRef="ready" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-onboard-paperwork" sourceRef="onboard" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-onboard-orientation" sourceRef="onboard" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-onboard-training" sourceRef="onboard" targetRef="training" />
    <bpmn:sequenceFlow id="f-paperwork-onboarded" sourceRef="paperwork" targetRef="onboarded" />
    <bpmn:sequenceFlow id="f-orientation-onboarded" sourceRef="orientation" targetRef="onboarded" />
    <bpmn:sequenceFlow id="f-training-onboarded" sourceRef="training" targetRef="onboarded" />
    <bpmn:sequenceFlow id="f-onboarded-done" sourceRef="onboarded" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
