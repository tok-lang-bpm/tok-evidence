tok 1.0 "Hiring process"

pool company "Organisation"
  lane department "Department"
    start need "Need for new hire identified"
    task identify "Identify the need for a new hire"
  lane hr "HR"
    task create "Create a job description"
    task post "Post the job description on job boards"
    task collect "Collect resumes"
    task screen "Screen resumes"
    task phone "Conduct initial phone interviews"
    task invite "Invite selected candidates for interviews"
    xor mode "Interview mode?"
    task inperson "Conduct in-person interview"
    task virtual "Conduct virtual interview"
    task offer "Extend an offer"
    xor nego "Salary negotiations?"
    task negotiate "Negotiate salary"
    and onboard "Onboarding"
    task paperwork "Complete paperwork"
    task orientation "Conduct orientation"
    task training "Conduct training"
    and onboarded "Onboarding completed"
    end done "New hire fully integrated"

flow need -> identify -> create -> post -> collect -> screen -> phone -> invite -> mode
flow mode -> inperson "in-person"
flow mode -> virtual "virtual" default
flow inperson -> offer
flow virtual -> offer
flow offer -> nego
flow nego -> negotiate "yes"
flow nego -> onboard default "no"
flow negotiate -> onboard
flow onboard -> paperwork
flow onboard -> orientation
flow onboard -> training
flow paperwork -> onboarded
flow orientation -> onboarded
flow training -> onboarded
flow onboarded -> done
