tok 1.0 "Inventory restocking"

pool organisation "Organisation"
  lane warehouse "Warehouse or store"
    start begin "Inventory monitoring begins"
    task monitor "Monitor inventory levels"
    task manual "Perform manual check"
    task receive "Receive stock"
    task inspect "Inspect stock for quality"
    task place "Place on shelves or in storage"
  lane procurement "Procurement team"
    task order "Place order with suppliers"
  lane inventory "Inventory system"
    task alert "Send automated alert"
    xor signaled
    task update_expected "Update with expected delivery dates"
    task record "Record in system"
    task update_levels "Update inventory levels"
    end done "Restock complete"
    xor detection "Automated alert or manual check?"

flow begin -> monitor -> detection
flow detection -> alert "automated alert"
flow detection -> manual "manual check"
flow alert -> signaled
flow manual -> signaled
flow signaled -> order -> update_expected -> receive -> inspect -> record -> place -> update_levels -> done
