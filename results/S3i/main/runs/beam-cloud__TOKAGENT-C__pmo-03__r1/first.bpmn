<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inventory restocking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Inventory restocking" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory system">
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_expected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inventory monitoring begins" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="place" name="Place on shelves or in storage" />
    <bpmn:task id="order" name="Place order with suppliers" />
    <bpmn:task id="signal" name="Signal need to reorder" />
    <bpmn:task id="update_expected" name="Update with expected delivery dates" />
    <bpmn:task id="record" name="Record in system" />
    <bpmn:task id="update_levels" name="Update inventory levels" />
    <bpmn:endEvent id="done" name="Restock complete" />
    <bpmn:sequenceFlow id="f-begin-monitor" sourceRef="begin" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-signal" sourceRef="monitor" targetRef="signal" />
    <bpmn:sequenceFlow id="f-signal-order" sourceRef="signal" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-update_expected" sourceRef="order" targetRef="update_expected" />
    <bpmn:sequenceFlow id="f-update_expected-receive" sourceRef="update_expected" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-place" sourceRef="record" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-update_levels" sourceRef="place" targetRef="update_levels" />
    <bpmn:sequenceFlow id="f-update_levels-done" sourceRef="update_levels" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
