tok 1.0 "Marketing campaign"

pool organisation "Organisation"
  lane marketing "Marketing team"
    start start "Campaign planning started"
    task define "Define objectives"
    task create "Create the content"
    task design "Design the visuals"
    task select "Select channels for promotion"
    task launch "Launch the campaign"
    task track "Track performance"
    task analyze "Analyze performance"
    end done "Process concluded"
  lane crm "CRM system"
    task collect "Collect leads in the CRM system"
  lane sales "Sales teams"
    task followup "Follow up leads"

flow start -> define -> create -> design -> select -> launch -> track -> collect -> followup -> analyze -> done
