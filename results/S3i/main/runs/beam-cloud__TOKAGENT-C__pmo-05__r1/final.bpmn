<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier procurement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Organisation" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Supplier procurement" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conducted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Need for new supplier identified" />
    <bpmn:task id="identify" name="Identify the need for a new supplier or vendor" />
    <bpmn:task id="issue" name="Issue a request for proposals (RFP)" />
    <bpmn:task id="receive" name="Receive responses from various suppliers" />
    <bpmn:task id="evaluate" name="Evaluate each proposal" />
    <bpmn:exclusiveGateway id="conduct" name="Conduct site visits or interviews?" default="f-conduct-conducted" />
    <bpmn:task id="visits" name="Conduct site visits or interviews with suppliers" />
    <bpmn:exclusiveGateway id="conducted" />
    <bpmn:task id="select" name="Select a supplier" />
    <bpmn:task id="negotiate" name="Begin contract negotiations" />
    <bpmn:task id="agree" name="Agree on the terms" />
    <bpmn:task id="sign" name="Sign the contract" />
    <bpmn:endEvent id="done" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f-needed-identify" sourceRef="needed" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-issue" sourceRef="identify" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-receive" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-conduct" sourceRef="evaluate" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-visits" name="yes" sourceRef="conduct" targetRef="visits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-conduct-conducted" name="no" sourceRef="conduct" targetRef="conducted" />
    <bpmn:sequenceFlow id="f-visits-conducted" sourceRef="visits" targetRef="conducted" />
    <bpmn:sequenceFlow id="f-conducted-select" sourceRef="conducted" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agree" sourceRef="negotiate" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-sign" sourceRef="agree" targetRef="sign" />
    <bpmn:sequenceFlow id="f-sign-done" sourceRef="sign" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
