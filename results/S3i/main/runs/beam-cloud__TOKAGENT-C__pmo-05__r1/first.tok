tok 1.0 "Supplier procurement"

pool office "Organisation"
  lane procurement "Procurement team"
    start needed "Need for new supplier identified"
    task identify "Identify the need for a new supplier or vendor"
    task issue "Issue a request for proposals (RFP)"
    task receive "Receive responses from various suppliers"
    task evaluate "Evaluate each proposal"
    xor conduct "Conduct site visits or interviews?"
    task visits "Conduct site visits or interviews with suppliers"
    xor conducted
    task select "Select a supplier"
    task negotiate "Begin contract negotiations"
    task agree "Agree on the terms"
    task sign "Sign the contract"
    end done "Supplier onboarded and contract executed"

flow needed -> identify -> issue -> receive -> evaluate -> conduct
flow conduct -> visits "yes"
flow conduct -> conducted "no" default
flow visits -> conducted
flow conducted -> select
flow select -> negotiate -> agree -> sign -> done
