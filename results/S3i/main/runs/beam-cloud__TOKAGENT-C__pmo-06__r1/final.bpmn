<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tracking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="generate_confirmation" name="Generate order confirmation" />
    <bpmn:task id="send_confirmation" name="Send order confirmation to the customer" />
    <bpmn:task id="send_tracking" name="Send tracking information" />
    <bpmn:task id="pick" name="Pick the items" />
    <bpmn:task id="pack" name="Pack the items" />
    <bpmn:task id="label" name="Generate shipping label" />
    <bpmn:task id="handover" name="Hand over the order to the logistics provider" />
    <bpmn:task id="monitor" name="Monitor the shipment" />
    <bpmn:endEvent id="delivered" name="Successful delivery" />
    <bpmn:sequenceFlow id="f-placed-place" sourceRef="placed" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-generate_confirmation" sourceRef="place" targetRef="generate_confirmation" />
    <bpmn:sequenceFlow id="f-generate_confirmation-send_confirmation" sourceRef="generate_confirmation" targetRef="send_confirmation" />
    <bpmn:sequenceFlow id="f-send_confirmation-pick" sourceRef="send_confirmation" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-pack" sourceRef="pick" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-label" sourceRef="pack" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-handover" sourceRef="label" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-send_tracking" sourceRef="handover" targetRef="send_tracking" />
    <bpmn:sequenceFlow id="f-send_tracking-monitor" sourceRef="send_tracking" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-delivered" sourceRef="monitor" targetRef="delivered" />
  </bpmn:process>
</bpmn:definitions>
