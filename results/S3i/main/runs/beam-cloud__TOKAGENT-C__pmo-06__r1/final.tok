tok 1.0 "Order fulfillment"

pool company "Company"
  lane customer "Customer"
    start placed "Order placed"
    task place "Place the order"
  lane system "System"
    task generate_confirmation "Generate order confirmation"
    task send_confirmation "Send order confirmation to the customer"
    task send_tracking "Send tracking information"
  lane warehouse "Warehouse team"
    task pick "Pick the items"
    task pack "Pack the items"
    task label "Generate shipping label"
    task handover "Hand over the order to the logistics provider"
  lane logistics "Logistics provider"
    task monitor "Monitor the shipment"
    end delivered "Successful delivery"

flow placed -> place -> generate_confirmation -> send_confirmation -> pick -> pack -> label -> handover -> send_tracking -> monitor -> delivered
