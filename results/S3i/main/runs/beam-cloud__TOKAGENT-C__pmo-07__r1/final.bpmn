<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Travel ticket booking and journey" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Travel organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Travel ticket booking and journey" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fbjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="booking" name="Booking system">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chanjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>andsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>andjoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Travel company">
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="select" name="Select preferred route, date, and time" />
    <bpmn:task id="provide" name="Provide personal information and payment details" />
    <bpmn:task id="remind" name="Receive reminders and instructions" />
    <bpmn:task id="complete" name="Complete the journey" />
    <bpmn:task id="feedback" name="Provide post-travel feedback" />
    <bpmn:exclusiveGateway id="rem" name="Receive reminders?" default="f-rem-remjoin" />
    <bpmn:exclusiveGateway id="remjoin" name="Reminders done?" />
    <bpmn:exclusiveGateway id="fb" name="Post-travel feedback or services?" default="f-fb-fbjoin" />
    <bpmn:exclusiveGateway id="fbjoin" name="Feedback done?" />
    <bpmn:endEvent id="e" name="Journey completed" />
    <bpmn:task id="generate" name="Generate ticket" />
    <bpmn:task id="email" name="Send ticket via email" />
    <bpmn:task id="sms" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="chan" name="Send via email or SMS?" default="f-chan-sms" />
    <bpmn:exclusiveGateway id="chanjoin" name="Ticket sent?" />
    <bpmn:parallelGateway id="andsplit" name="Send and update" />
    <bpmn:parallelGateway id="andjoin" name="Sent and updated" />
    <bpmn:task id="update" name="Update seat inventory" />
    <bpmn:sequenceFlow id="f-s-search" sourceRef="s" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-select" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-provide" sourceRef="select" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-generate" sourceRef="provide" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-andsplit" sourceRef="generate" targetRef="andsplit" />
    <bpmn:sequenceFlow id="f-andsplit-chan" sourceRef="andsplit" targetRef="chan" />
    <bpmn:sequenceFlow id="f-andsplit-update" sourceRef="andsplit" targetRef="update" />
    <bpmn:sequenceFlow id="f-chan-email" name="via email" sourceRef="chan" targetRef="email">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-chan-sms" name="via SMS" sourceRef="chan" targetRef="sms" />
    <bpmn:sequenceFlow id="f-email-chanjoin" sourceRef="email" targetRef="chanjoin" />
    <bpmn:sequenceFlow id="f-sms-chanjoin" sourceRef="sms" targetRef="chanjoin" />
    <bpmn:sequenceFlow id="f-update-andjoin" sourceRef="update" targetRef="andjoin" />
    <bpmn:sequenceFlow id="f-chanjoin-andjoin" sourceRef="chanjoin" targetRef="andjoin" />
    <bpmn:sequenceFlow id="f-andjoin-rem" sourceRef="andjoin" targetRef="rem" />
    <bpmn:sequenceFlow id="f-rem-remind" name="yes" sourceRef="rem" targetRef="remind">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rem-remjoin" name="no" sourceRef="rem" targetRef="remjoin" />
    <bpmn:sequenceFlow id="f-remind-remjoin" sourceRef="remind" targetRef="remjoin" />
    <bpmn:sequenceFlow id="f-remjoin-complete" sourceRef="remjoin" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-fb" sourceRef="complete" targetRef="fb" />
    <bpmn:sequenceFlow id="f-fb-feedback" name="yes" sourceRef="fb" targetRef="feedback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fb-fbjoin" name="no" sourceRef="fb" targetRef="fbjoin" />
    <bpmn:sequenceFlow id="f-feedback-fbjoin" sourceRef="feedback" targetRef="fbjoin" />
    <bpmn:sequenceFlow id="f-fbjoin-e" sourceRef="fbjoin" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
