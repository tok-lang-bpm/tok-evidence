<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident management" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident management" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="reporter" name="Employee or Customer">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Investigation Team">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Tracking System">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Incident reported" />
    <bpmn:task id="report" name="Report the incident" />
    <bpmn:task id="gather" name="Gather necessary information" />
    <bpmn:task id="identify" name="Identify cause of incident" />
    <bpmn:task id="propose" name="Propose corrective actions" />
    <bpmn:task id="implement" name="Implement solution" />
    <bpmn:task id="followup" name="Follow up after resolution" />
    <bpmn:task id="log" name="Log report into tracking system" />
    <bpmn:task id="assign" name="Assign to appropriate team" />
    <bpmn:task id="close" name="Close incident report" />
    <bpmn:task id="notify" name="Notify all stakeholders" />
    <bpmn:endEvent id="closed" name="Incident report closed" />
    <bpmn:sequenceFlow id="f-reported-report" sourceRef="reported" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-log" sourceRef="report" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-gather" sourceRef="assign" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-identify" sourceRef="gather" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-propose" sourceRef="identify" targetRef="propose" />
    <bpmn:sequenceFlow id="f-propose-implement" sourceRef="propose" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-followup" sourceRef="implement" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-close" sourceRef="followup" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-notify" sourceRef="close" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-closed" sourceRef="notify" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
