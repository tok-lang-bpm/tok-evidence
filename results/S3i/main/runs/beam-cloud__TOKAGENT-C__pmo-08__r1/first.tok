tok 1.0 "Incident management"

pool org "Organisation"
  lane reporter "Employee or Customer"
    start reported "Incident reported"
    task report "Report the incident"
  lane team "Investigation Team"
    task gather "Gather necessary information"
    task identify "Identify cause of incident"
    task propose "Propose corrective actions"
    task implement "Implement solution"
    task followup "Follow up after resolution"
  lane system "Tracking System"
    task log "Log report into tracking system"
    task assign "Assign to appropriate team"
    task close "Close incident report"
    task notify "Notify all stakeholders"
    end closed "Incident report closed"

flow reported -> report -> log -> assign -> gather -> identify -> propose -> implement -> followup -> close -> notify -> closed
