<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Product development" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Product development" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rnd" name="R&amp;D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify an idea" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype" />
    <bpmn:task id="test" name="Test the prototype" />
    <bpmn:task id="collect" name="Collect feedback" />
    <bpmn:exclusiveGateway id="refine" name="Refinement needed?" />
    <bpmn:task id="refine_task" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="outcome" name="Prototype approved or discarded?" />
    <bpmn:endEvent id="approved" name="Prototype approved for further development" />
    <bpmn:endEvent id="discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-start-identify" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-research" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f-research-draft" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-select" sourceRef="draft" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-build" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-collect" sourceRef="test" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-refine" sourceRef="collect" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-refine_task" name="yes" sourceRef="refine" targetRef="refine_task" />
    <bpmn:sequenceFlow id="f-refine-outcome" name="no" sourceRef="refine" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-refine_task-test" sourceRef="refine_task" targetRef="test" />
    <bpmn:sequenceFlow id="f-outcome-approved" name="approved for further development" sourceRef="outcome" targetRef="approved" />
    <bpmn:sequenceFlow id="f-outcome-discarded" name="discarded" sourceRef="outcome" targetRef="discarded" />
  </bpmn:process>
</bpmn:definitions>
