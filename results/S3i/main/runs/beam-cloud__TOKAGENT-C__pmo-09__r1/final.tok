tok 1.0 "Product development"

pool org "Organisation"
  lane rnd "R&D team"
    start start "Start"
    task identify "Identify an idea"
    task research "Conduct initial research and feasibility studies"
    task draft "Draft design concepts"
    task select "Select a promising design"
    task build "Build a prototype"
    task test "Test the prototype"
    task collect "Collect feedback"
    xor refine "Refinement needed?"
    task refine_task "Refine the prototype"
    xor outcome "Prototype approved or discarded?"
    end approved "Prototype approved for further development"
    end discarded "Prototype discarded"

flow start -> identify -> research -> draft -> select -> build -> test -> collect -> refine
flow refine -> refine_task "yes"
flow refine -> outcome "no"
flow refine_task -> test
flow outcome -> approved "approved for further development"
flow outcome -> discarded "discarded"
