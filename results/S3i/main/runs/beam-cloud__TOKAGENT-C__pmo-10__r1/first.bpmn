<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IT solution request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="IT solution request" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="requester" name="Employee or department">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trained</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Request for IT solution needed" />
    <bpmn:task id="submit" name="Submit request for IT solution" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:task id="assess" name="Assess request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" default="f-approved-rejected" />
    <bpmn:task id="procure" name="Procure necessary tools or licenses" />
    <bpmn:task id="install" name="Install solution" />
    <bpmn:task id="test" name="Test solution in controlled environment" />
    <bpmn:task id="rollout" name="Roll out new solution to requesting department" />
    <bpmn:exclusiveGateway id="training" name="Provide training?" default="f-training-trained" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:exclusiveGateway id="trained" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="completed" name="IT solution implemented" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assess" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-approved" sourceRef="assess" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="Yes" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approved-rejected" name="No" sourceRef="approved" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-rollout" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-rollout-training" sourceRef="rollout" targetRef="training" />
    <bpmn:sequenceFlow id="f-training-train" name="Yes" sourceRef="training" targetRef="train" />
    <bpmn:sequenceFlow id="f-training-trained" name="No" sourceRef="training" targetRef="trained" />
    <bpmn:sequenceFlow id="f-train-trained" sourceRef="train" targetRef="trained" />
    <bpmn:sequenceFlow id="f-trained-support" sourceRef="trained" targetRef="support" />
    <bpmn:sequenceFlow id="f-support-completed" sourceRef="support" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
