tok 1.0 "IT solution request"

pool organisation "Organisation"
  lane requester "Employee or department"
    start needed "Request for IT solution needed"
    task submit "Submit request for IT solution"
    end rejected "Request rejected"
  lane it "IT"
    task assess "Assess request"
    xor approved "Request approved?"
    task procure "Procure necessary tools or licenses"
    task install "Install solution"
    task test "Test solution in controlled environment"
    task rollout "Roll out new solution to requesting department"
    xor training "Provide training?"
    task train "Provide training"
    xor trained
    task support "Provide IT support for troubleshooting"
    end completed "IT solution implemented"

flow needed -> submit -> assess -> approved
flow approved -> procure "Yes"
flow approved -> rejected "No" default
flow procure -> install -> test -> rollout -> training
flow training -> train "Yes"
flow training -> trained "No" default
flow train -> trained
flow trained -> support -> completed
