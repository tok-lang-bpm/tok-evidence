<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Subscription service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Subscription service" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>begins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decides</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitcancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support team">
        <bpmn:flowNodeRef>processcancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>termsdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begins" name="Subscription sign-up begins" />
    <bpmn:task id="signup" name="Sign up for the subscription service" />
    <bpmn:task id="receive" name="Receive regular updates, product enhancements, or renewal notifications" />
    <bpmn:exclusiveGateway id="decides" name="Decides to cancel?" default="f-decides-receive" />
    <bpmn:task id="submitcancel" name="Submit a cancellation request" />
    <bpmn:task id="generate" name="Generate an account" />
    <bpmn:task id="assign" name="Assign access" />
    <bpmn:task id="bill" name="Trigger automated billing cycles" />
    <bpmn:task id="processcancel" name="Process the cancellation request" />
    <bpmn:exclusiveGateway id="terms" name="Refunds or charges?" default="f-terms-charge" />
    <bpmn:task id="refund" name="Apply refunds" />
    <bpmn:task id="charge" name="Apply charges" />
    <bpmn:exclusiveGateway id="termsdone" name="Terms applied?" />
    <bpmn:parallelGateway id="finalize" />
    <bpmn:task id="deactivate" name="Deactivate the subscription" />
    <bpmn:task id="settle" name="Settle the final account balance" />
    <bpmn:parallelGateway id="finalized" />
    <bpmn:endEvent id="done" name="Subscription deactivated and balance settled" />
    <bpmn:sequenceFlow id="f-begins-signup" sourceRef="begins" targetRef="signup" />
    <bpmn:sequenceFlow id="f-signup-generate" sourceRef="signup" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-assign" sourceRef="generate" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-bill" sourceRef="assign" targetRef="bill" />
    <bpmn:sequenceFlow id="f-bill-receive" sourceRef="bill" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decides" sourceRef="receive" targetRef="decides" />
    <bpmn:sequenceFlow id="f-decides-submitcancel" name="yes" sourceRef="decides" targetRef="submitcancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decides-receive" name="no" sourceRef="decides" targetRef="receive" />
    <bpmn:sequenceFlow id="f-submitcancel-processcancel" sourceRef="submitcancel" targetRef="processcancel" />
    <bpmn:sequenceFlow id="f-processcancel-terms" sourceRef="processcancel" targetRef="terms" />
    <bpmn:sequenceFlow id="f-terms-refund" name="refunds" sourceRef="terms" targetRef="refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-terms-charge" name="charges" sourceRef="terms" targetRef="charge" />
    <bpmn:sequenceFlow id="f-refund-termsdone" sourceRef="refund" targetRef="termsdone" />
    <bpmn:sequenceFlow id="f-charge-termsdone" sourceRef="charge" targetRef="termsdone" />
    <bpmn:sequenceFlow id="f-termsdone-finalize" sourceRef="termsdone" targetRef="finalize" />
    <bpmn:sequenceFlow id="f-finalize-deactivate" sourceRef="finalize" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f-finalize-settle" sourceRef="finalize" targetRef="settle" />
    <bpmn:sequenceFlow id="f-deactivate-finalized" sourceRef="deactivate" targetRef="finalized" />
    <bpmn:sequenceFlow id="f-settle-finalized" sourceRef="settle" targetRef="finalized" />
    <bpmn:sequenceFlow id="f-finalized-done" sourceRef="finalized" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
