tok 1.0 "Subscription service"

pool organisation "Organisation"
  lane customer "Customer"
    start begins "Subscription sign-up begins"
    task signup "Sign up for the subscription service"
    task receive "Receive regular updates, product enhancements, or renewal notifications"
    xor decides "Decides to cancel?"
    task submitcancel "Submit a cancellation request"
  lane system "System"
    task generate "Generate an account"
    task assign "Assign access"
    task bill "Trigger automated billing cycles"
  lane support "Support team"
    task processcancel "Process the cancellation request"
    xor terms "Refunds or charges?"
    task refund "Apply refunds"
    task charge "Apply charges"
    xor termsdone "Terms applied?"
    and finalize
    task deactivate "Deactivate the subscription"
    task settle "Settle the final account balance"
    and finalized
    end done "Subscription deactivated and balance settled"

flow begins -> signup -> generate -> assign -> bill -> receive
flow receive -> decides
flow decides -> submitcancel "yes" when=""
flow decides -> receive "no" default
flow submitcancel -> processcancel
flow processcancel -> terms
flow terms -> refund "refunds" when=""
flow terms -> charge "charges" default
flow refund -> termsdone
flow charge -> termsdone
flow termsdone -> finalize
flow finalize -> deactivate
flow finalize -> settle
flow deactivate -> finalized
flow settle -> finalized
flow finalized -> done
