tok 1.0 "Complaint handling"

pool office "Organisation"
  lane customer "Customer"
    start needed "Complaint needed"
    task file "File a complaint"
    task feedback "Provide feedback on satisfaction"
    xor feedback_xor "Provide feedback?"
    end ended "Process ended"
  lane service "Customer service"
    task log "Log the complaint"
    task assign "Assign the complaint to the relevant department"
    task mark "Mark the complaint as resolved"
  lane team "Investigation team"
    task review "Review the details"
    task determine "Determine whether the complaint is valid and a refund is justified"
    task notify "Notify the customer with the decision"
    xor refund "Refund approved?"
  lane finance "Financial team"
    task reimburse "Process the reimbursement"

flow needed -> file -> log -> assign -> review -> determine -> notify -> refund
flow refund -> reimburse "yes" when="refundApproved"
flow refund -> mark "no" default
flow reimburse -> mark
flow mark -> feedback_xor
flow feedback_xor -> feedback "yes" when="provideFeedback"
flow feedback_xor -> ended "no" default
flow feedback -> ended
