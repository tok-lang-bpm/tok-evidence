<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Budget planning process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Budget planning process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>finance_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>strategic_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve_adjustment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Budget process starts" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:task id="implement" name="Begin implementing the plan" />
    <bpmn:endEvent id="done" name="Plan implemented" />
    <bpmn:task id="draft" name="Draft the plan" />
    <bpmn:task id="adjust" name="Adjust the plan" />
    <bpmn:task id="document" name="Document the adjustment" />
    <bpmn:task id="finance_review" name="Perform detailed review" />
    <bpmn:task id="allocate" name="Allocate the budget" />
    <bpmn:task id="distribute" name="Distribute the budget" />
    <bpmn:exclusiveGateway id="approved" name="Adjustments needed?" />
    <bpmn:task id="strategic_review" name="Review plan in strategic alignment meeting" />
    <bpmn:task id="approve_adjustment" name="Approve adjustment" />
    <bpmn:sequenceFlow id="f-needed-outline" sourceRef="needed" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-strategic_review" sourceRef="draft" targetRef="strategic_review" />
    <bpmn:sequenceFlow id="f-strategic_review-finance_review" sourceRef="strategic_review" targetRef="finance_review" />
    <bpmn:sequenceFlow id="f-finance_review-approved" sourceRef="finance_review" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-adjust" name="yes" sourceRef="approved" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-approved-allocate" name="no" sourceRef="approved" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-adjust-document" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f-document-approve_adjustment" sourceRef="document" targetRef="approve_adjustment" />
    <bpmn:sequenceFlow id="f-approve_adjustment-strategic_review" sourceRef="approve_adjustment" targetRef="strategic_review" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-done" sourceRef="implement" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
