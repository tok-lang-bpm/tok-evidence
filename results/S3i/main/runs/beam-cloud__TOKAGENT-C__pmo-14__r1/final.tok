tok 1.0 "Budget planning process"

pool organisation "Organisation"
  lane department "Department"
    start needed "Budget process starts"
    task outline "Outline objectives"
    task implement "Begin implementing the plan"
    end done "Plan implemented"
  lane team "Team"
    task draft "Draft the plan"
    task adjust "Adjust the plan"
    task document "Document the adjustment"
  lane finance "Finance Department"
    task finance_review "Perform detailed review"
    task allocate "Allocate the budget"
    task distribute "Distribute the budget"
    xor approved "Adjustments needed?"
  lane stakeholders "Stakeholders"
    task strategic_review "Review plan in strategic alignment meeting"
    task approve_adjustment "Approve adjustment"
flow needed -> outline -> draft -> strategic_review -> finance_review -> approved
flow approved -> adjust "yes"
flow approved -> allocate "no"
flow adjust -> document -> approve_adjustment -> strategic_review
flow allocate -> distribute -> implement -> done
