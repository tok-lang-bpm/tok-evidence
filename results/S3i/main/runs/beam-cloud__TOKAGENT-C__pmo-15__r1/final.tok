tok 1.0 "Compliance audit"

pool company "Company"
  lane company_lane "Company"
    start start "Start"
    task schedule "Schedule a compliance audit"
    task correct "Make the necessary corrections or improvements"
    task final "Undergo a final audit"
    xor criteria "All criteria met?"
    task award "Award certification"
    task issue "Issue official documents"
    end issued "Official documents issued"
    end denied "Certification not granted"
  lane internal "Internal teams"
    task prepare "Prepare documentation"
    task gather "Gather evidence"
    task selfassess "Conduct a self-assessment"
  lane auditors "Auditors"
    task review "Review the company's processes"
    task identify "Identify any gaps or issues"

flow start -> schedule -> prepare -> gather -> selfassess -> review -> identify -> correct -> final -> criteria
flow criteria -> award "Yes" when="true"
flow criteria -> denied "No" default
flow award -> issue -> issued
