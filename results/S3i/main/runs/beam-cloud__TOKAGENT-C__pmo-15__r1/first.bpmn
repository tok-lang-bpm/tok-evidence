<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="company_lane" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal teams">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfassess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="schedule" name="Schedule a compliance audit" />
    <bpmn:task id="correct" name="Make the necessary corrections or improvements" />
    <bpmn:task id="final" name="Undergo a final audit" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" default="f-criteria-denied" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="issued" name="Official documents issued" />
    <bpmn:endEvent id="denied" name="Certification not granted" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="selfassess" name="Conduct a self-assessment" />
    <bpmn:task id="review" name="Review the company's processes" />
    <bpmn:task id="identify" name="Identify any gaps or issues" />
    <bpmn:sequenceFlow id="f-start-schedule" sourceRef="start" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-prepare" sourceRef="schedule" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-selfassess" sourceRef="gather" targetRef="selfassess" />
    <bpmn:sequenceFlow id="f-selfassess-review" sourceRef="selfassess" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-identify" sourceRef="review" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-correct" sourceRef="identify" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-final" sourceRef="correct" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-criteria" sourceRef="final" targetRef="criteria" />
    <bpmn:sequenceFlow id="f-criteria-award" name="Yes" sourceRef="criteria" targetRef="award" />
    <bpmn:sequenceFlow id="f-criteria-denied" name="No" sourceRef="criteria" targetRef="denied" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-issued" sourceRef="issue" targetRef="issued" />
  </bpmn:process>
</bpmn:definitions>
