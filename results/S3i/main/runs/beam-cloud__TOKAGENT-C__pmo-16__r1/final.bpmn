<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>process_started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_parallel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>prepare_financial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>check_updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central audit team">
        <bpmn:flowNodeRef>review_submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discrepancies</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit" name="Audit team">
        <bpmn:flowNodeRef>evaluate_financial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_operational</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>high_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_site_visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>review_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="process_started" name="Audit process initiated" />
    <bpmn:task id="send_notification" name="Send notification to regional office" />
    <bpmn:parallelGateway id="start_parallel" />
    <bpmn:task id="prepare_financial" name="Prepare financial statements" />
    <bpmn:task id="gather_documents" name="Gather necessary documents" />
    <bpmn:task id="submit_documents" name="Submit documents to central audit team" />
    <bpmn:task id="provide_clarifications" name="Provide necessary clarifications" />
    <bpmn:parallelGateway id="prep_join" />
    <bpmn:task id="check_updates" name="Check for regulatory updates" />
    <bpmn:task id="review_submission" name="Review submission" />
    <bpmn:task id="request_clarifications" name="Request clarifications" />
    <bpmn:exclusiveGateway id="discrepancies" name="Discrepancies found?" />
    <bpmn:task id="evaluate_financial" name="Evaluate financial risks" />
    <bpmn:task id="evaluate_operational" name="Evaluate operational risks" />
    <bpmn:task id="evaluate_compliance" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="risk_split" />
    <bpmn:parallelGateway id="risk_join" />
    <bpmn:exclusiveGateway id="high_risk" name="High risk identified?" />
    <bpmn:task id="analyze_data" name="Perform data analysis" />
    <bpmn:task id="conduct_interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="site_needed" name="Site visit required?" />
    <bpmn:task id="perform_site_visit" name="Perform site visit" />
    <bpmn:exclusiveGateway id="risk_merge" />
    <bpmn:exclusiveGateway id="risk_done" />
    <bpmn:task id="compile_report" name="Compile audit report" />
    <bpmn:task id="update_report" name="Update report" />
    <bpmn:task id="resubmit_report" name="Resubmit report" />
    <bpmn:task id="distribute_report" name="Distribute final report to executive board" />
    <bpmn:task id="archive_report" name="Archive final report" />
    <bpmn:endEvent id="process_closed" name="Audit process closed" />
    <bpmn:task id="review_report" name="Review audit report" />
    <bpmn:exclusiveGateway id="approval" name="Report approved?" />
    <bpmn:sequenceFlow id="f-process_started-send_notification" sourceRef="process_started" targetRef="send_notification" />
    <bpmn:sequenceFlow id="f-send_notification-start_parallel" sourceRef="send_notification" targetRef="start_parallel" />
    <bpmn:sequenceFlow id="f-start_parallel-prepare_financial" sourceRef="start_parallel" targetRef="prepare_financial" />
    <bpmn:sequenceFlow id="f-start_parallel-check_updates" sourceRef="start_parallel" targetRef="check_updates" />
    <bpmn:sequenceFlow id="f-prepare_financial-gather_documents" sourceRef="prepare_financial" targetRef="gather_documents" />
    <bpmn:sequenceFlow id="f-gather_documents-prep_join" sourceRef="gather_documents" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-check_updates-prep_join" sourceRef="check_updates" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-prep_join-submit_documents" sourceRef="prep_join" targetRef="submit_documents" />
    <bpmn:sequenceFlow id="f-submit_documents-review_submission" sourceRef="submit_documents" targetRef="review_submission" />
    <bpmn:sequenceFlow id="f-review_submission-discrepancies" sourceRef="review_submission" targetRef="discrepancies" />
    <bpmn:sequenceFlow id="f-discrepancies-request_clarifications" name="yes" sourceRef="discrepancies" targetRef="request_clarifications" />
    <bpmn:sequenceFlow id="f-request_clarifications-provide_clarifications" sourceRef="request_clarifications" targetRef="provide_clarifications" />
    <bpmn:sequenceFlow id="f-provide_clarifications-review_submission" sourceRef="provide_clarifications" targetRef="review_submission" />
    <bpmn:sequenceFlow id="f-discrepancies-risk_split" name="no" sourceRef="discrepancies" targetRef="risk_split" />
    <bpmn:sequenceFlow id="f-risk_split-evaluate_financial" sourceRef="risk_split" targetRef="evaluate_financial" />
    <bpmn:sequenceFlow id="f-risk_split-evaluate_operational" sourceRef="risk_split" targetRef="evaluate_operational" />
    <bpmn:sequenceFlow id="f-risk_split-evaluate_compliance" sourceRef="risk_split" targetRef="evaluate_compliance" />
    <bpmn:sequenceFlow id="f-evaluate_financial-risk_join" sourceRef="evaluate_financial" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f-evaluate_operational-risk_join" sourceRef="evaluate_operational" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f-evaluate_compliance-risk_join" sourceRef="evaluate_compliance" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f-risk_join-high_risk" sourceRef="risk_join" targetRef="high_risk" />
    <bpmn:sequenceFlow id="f-high_risk-analyze_data" name="yes" sourceRef="high_risk" targetRef="analyze_data" />
    <bpmn:sequenceFlow id="f-analyze_data-conduct_interviews" sourceRef="analyze_data" targetRef="conduct_interviews" />
    <bpmn:sequenceFlow id="f-conduct_interviews-site_needed" sourceRef="conduct_interviews" targetRef="site_needed" />
    <bpmn:sequenceFlow id="f-site_needed-perform_site_visit" name="yes" sourceRef="site_needed" targetRef="perform_site_visit" />
    <bpmn:sequenceFlow id="f-site_needed-risk_merge" name="no" sourceRef="site_needed" targetRef="risk_merge" />
    <bpmn:sequenceFlow id="f-perform_site_visit-risk_merge" sourceRef="perform_site_visit" targetRef="risk_merge" />
    <bpmn:sequenceFlow id="f-risk_merge-risk_done" sourceRef="risk_merge" targetRef="risk_done" />
    <bpmn:sequenceFlow id="f-high_risk-risk_done" name="no" sourceRef="high_risk" targetRef="risk_done" />
    <bpmn:sequenceFlow id="f-risk_done-compile_report" sourceRef="risk_done" targetRef="compile_report" />
    <bpmn:sequenceFlow id="f-compile_report-review_report" sourceRef="compile_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-review_report-approval" sourceRef="review_report" targetRef="approval" />
    <bpmn:sequenceFlow id="f-approval-distribute_report" name="yes" sourceRef="approval" targetRef="distribute_report" />
    <bpmn:sequenceFlow id="f-approval-update_report" name="no" sourceRef="approval" targetRef="update_report" />
    <bpmn:sequenceFlow id="f-update_report-resubmit_report" sourceRef="update_report" targetRef="resubmit_report" />
    <bpmn:sequenceFlow id="f-resubmit_report-review_report" sourceRef="resubmit_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-distribute_report-archive_report" sourceRef="distribute_report" targetRef="archive_report" />
    <bpmn:sequenceFlow id="f-archive_report-process_closed" sourceRef="archive_report" targetRef="process_closed" />
  </bpmn:process>
</bpmn:definitions>
