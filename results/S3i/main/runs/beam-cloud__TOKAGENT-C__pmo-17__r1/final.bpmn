<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="E-commerce company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>recordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendShippingConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFollowup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReturnLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory System">
        <bpmn:flowNodeRef>checkStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiateBackorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveBackorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stockJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>workSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveReturns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspectReturns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping Department">
        <bpmn:flowNodeRef>prepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareCustoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>workJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Order needed" />
    <bpmn:task id="placeOrder" name="Place an order" />
    <bpmn:task id="recordOrder" name="Record the order details" />
    <bpmn:task id="processPayment" name="Process payment" />
    <bpmn:exclusiveGateway id="payment" name="Payment successful?" />
    <bpmn:task id="notifyFailure" name="Notify the customer" />
    <bpmn:endEvent id="paymentFailed" name="Payment failed" />
    <bpmn:task id="sendShippingConfirmation" name="Send a shipping confirmation" />
    <bpmn:task id="updateInventory" name="Update the inventory levels" />
    <bpmn:exclusiveGateway id="issues" name="Issues reported?" />
    <bpmn:task id="sendFollowup" name="Send a follow-up email for feedback" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:task id="sendReturnLabel" name="Send a return shipping label" />
    <bpmn:task id="processRefund" name="Process a refund or replacement" />
    <bpmn:endEvent id="returned" name="Return completed" />
    <bpmn:task id="checkStock" name="Check stock availability" />
    <bpmn:exclusiveGateway id="stock" name="Items in stock?" />
    <bpmn:task id="initiateBackorder" name="Initiate a back-order" />
    <bpmn:task id="informDelay" name="Inform the customer about the delay" />
    <bpmn:task id="receiveBackorder" name="Receive the back-order" />
    <bpmn:exclusiveGateway id="stockJoin" name="All required items available?" />
    <bpmn:task id="pick" name="Pick in-stock items" />
    <bpmn:task id="qc" name="Perform quality control checks" />
    <bpmn:parallelGateway id="workSplit" name="Start packaging and shipping preparation" />
    <bpmn:task id="package" name="Package items including gift wrapping if requested" />
    <bpmn:task id="receiveReturns" name="Receive returned items" />
    <bpmn:task id="inspectReturns" name="Inspect returned items" />
    <bpmn:task id="prepareDocs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="international" name="Order is international?" />
    <bpmn:task id="prepareCustoms" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="customsJoin" name="Customs documentation ready?" />
    <bpmn:parallelGateway id="workJoin" name="Packaging and shipping documents ready?" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:sequenceFlow id="f-needed-placeOrder" sourceRef="needed" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="f-placeOrder-recordOrder" sourceRef="placeOrder" targetRef="recordOrder" />
    <bpmn:sequenceFlow id="f-recordOrder-processPayment" sourceRef="recordOrder" targetRef="processPayment" />
    <bpmn:sequenceFlow id="f-processPayment-payment" sourceRef="processPayment" targetRef="payment" />
    <bpmn:sequenceFlow id="f-payment-checkStock" name="yes" sourceRef="payment" targetRef="checkStock" />
    <bpmn:sequenceFlow id="f-payment-notifyFailure" name="no" sourceRef="payment" targetRef="notifyFailure" />
    <bpmn:sequenceFlow id="f-notifyFailure-paymentFailed" sourceRef="notifyFailure" targetRef="paymentFailed" />
    <bpmn:sequenceFlow id="f-checkStock-stock" sourceRef="checkStock" targetRef="stock" />
    <bpmn:sequenceFlow id="f-stock-stockJoin" name="yes" sourceRef="stock" targetRef="stockJoin" />
    <bpmn:sequenceFlow id="f-stock-initiateBackorder" name="no" sourceRef="stock" targetRef="initiateBackorder" />
    <bpmn:sequenceFlow id="f-initiateBackorder-informDelay" sourceRef="initiateBackorder" targetRef="informDelay" />
    <bpmn:sequenceFlow id="f-informDelay-receiveBackorder" sourceRef="informDelay" targetRef="receiveBackorder" />
    <bpmn:sequenceFlow id="f-receiveBackorder-stockJoin" sourceRef="receiveBackorder" targetRef="stockJoin" />
    <bpmn:sequenceFlow id="f-stockJoin-pick" sourceRef="stockJoin" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-workSplit" sourceRef="qc" targetRef="workSplit" />
    <bpmn:sequenceFlow id="f-workSplit-package" sourceRef="workSplit" targetRef="package" />
    <bpmn:sequenceFlow id="f-workSplit-prepareDocs" sourceRef="workSplit" targetRef="prepareDocs" />
    <bpmn:sequenceFlow id="f-package-workJoin" sourceRef="package" targetRef="workJoin" />
    <bpmn:sequenceFlow id="f-prepareDocs-international" sourceRef="prepareDocs" targetRef="international" />
    <bpmn:sequenceFlow id="f-international-prepareCustoms" name="yes" sourceRef="international" targetRef="prepareCustoms" />
    <bpmn:sequenceFlow id="f-international-customsJoin" name="no" sourceRef="international" targetRef="customsJoin" />
    <bpmn:sequenceFlow id="f-prepareCustoms-customsJoin" sourceRef="prepareCustoms" targetRef="customsJoin" />
    <bpmn:sequenceFlow id="f-customsJoin-workJoin" sourceRef="customsJoin" targetRef="workJoin" />
    <bpmn:sequenceFlow id="f-workJoin-dispatch" sourceRef="workJoin" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-sendShippingConfirmation" sourceRef="dispatch" targetRef="sendShippingConfirmation" />
    <bpmn:sequenceFlow id="f-sendShippingConfirmation-updateInventory" sourceRef="sendShippingConfirmation" targetRef="updateInventory" />
    <bpmn:sequenceFlow id="f-updateInventory-issues" sourceRef="updateInventory" targetRef="issues" />
    <bpmn:sequenceFlow id="f-issues-sendReturnLabel" name="yes" sourceRef="issues" targetRef="sendReturnLabel" />
    <bpmn:sequenceFlow id="f-issues-sendFollowup" name="no" sourceRef="issues" targetRef="sendFollowup" />
    <bpmn:sequenceFlow id="f-sendFollowup-completed" sourceRef="sendFollowup" targetRef="completed" />
    <bpmn:sequenceFlow id="f-sendReturnLabel-receiveReturns" sourceRef="sendReturnLabel" targetRef="receiveReturns" />
    <bpmn:sequenceFlow id="f-receiveReturns-inspectReturns" sourceRef="receiveReturns" targetRef="inspectReturns" />
    <bpmn:sequenceFlow id="f-inspectReturns-processRefund" sourceRef="inspectReturns" targetRef="processRefund" />
    <bpmn:sequenceFlow id="f-processRefund-returned" sourceRef="processRefund" targetRef="returned" />
  </bpmn:process>
</bpmn:definitions>
