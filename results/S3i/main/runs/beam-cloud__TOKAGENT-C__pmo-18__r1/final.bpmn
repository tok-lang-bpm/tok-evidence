<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>may_ad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievances</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions Office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>process_fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="international" name="International Student Office">
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registrar" name="Registrar">
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="submit" name="Submit an application online" />
    <bpmn:task id="provide" name="Provide the missing items" />
    <bpmn:task id="confirm" name="Confirm enrollment" />
    <bpmn:task id="receive_orientation" name="Receive orientation materials" />
    <bpmn:task id="obtain_id" name="Obtain a student ID card" />
    <bpmn:task id="select_courses" name="Select courses" />
    <bpmn:task id="resolve_conflicts" name="Resolve schedule conflicts" />
    <bpmn:task id="attend" name="Begin attending classes" />
    <bpmn:task id="adddrop" name="Add or drop courses" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:task id="submit_appeal" name="Submit an appeal form" />
    <bpmn:task id="await_decision" name="Await a decision" />
    <bpmn:parallelGateway id="orient" />
    <bpmn:parallelGateway id="orient_done" />
    <bpmn:exclusiveGateway id="confirmed" name="Confirmed by deadline?" default="f-confirmed-canceled" />
    <bpmn:exclusiveGateway id="intl" name="International student?" default="f-intl-obtain_id" />
    <bpmn:exclusiveGateway id="may_ad" name="Add or drop courses?" default="f-may_ad-post_grades" />
    <bpmn:exclusiveGateway id="grievances" name="Any grievances?" default="f-grievances-outcome_join" />
    <bpmn:exclusiveGateway id="outcome_join" />
    <bpmn:exclusiveGateway id="outcome" name="Graduate or withdraw?" default="f-outcome-attend" />
    <bpmn:endEvent id="canceled" name="Application canceled" />
    <bpmn:endEvent id="graduated" name="Student graduated" />
    <bpmn:endEvent id="withdrawn" name="Student withdrew" />
    <bpmn:task id="review" name="Review the application and supporting documents" />
    <bpmn:task id="notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="send_accept" name="Send an acceptance letter" />
    <bpmn:task id="send_reject" name="Send a rejection letter" />
    <bpmn:exclusiveGateway id="docs" name="Documents complete?" default="f-docs-docs_join" />
    <bpmn:exclusiveGateway id="docs_join" name="Documents received?" />
    <bpmn:parallelGateway id="par1" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" default="f-accepted-send_reject" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:task id="evaluate" name="Evaluate the application" />
    <bpmn:task id="process_fees" name="Process application fees or waivers" />
    <bpmn:task id="setup_accounts" name="Set up student accounts for email, online portals, and library access" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:task id="meet_advisor" name="Meet with an academic advisor" />
    <bpmn:task id="meet_appeals" name="Meet with the appeals committee" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:sequenceFlow id="f-s-submit" sourceRef="s" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-docs" sourceRef="review" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-notify_missing" name="Documents missing" sourceRef="docs" targetRef="notify_missing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-notify_missing-provide" sourceRef="notify_missing" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-docs_join" sourceRef="provide" targetRef="docs_join" />
    <bpmn:sequenceFlow id="f-docs-docs_join" name="Documents complete" sourceRef="docs" targetRef="docs_join" />
    <bpmn:sequenceFlow id="f-docs_join-par1" sourceRef="docs_join" targetRef="par1" />
    <bpmn:sequenceFlow id="f-par1-evaluate" sourceRef="par1" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-par1-process_fees" sourceRef="par1" targetRef="process_fees" />
    <bpmn:sequenceFlow id="f-evaluate-join1" sourceRef="evaluate" targetRef="join1" />
    <bpmn:sequenceFlow id="f-process_fees-join1" sourceRef="process_fees" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-accepted" sourceRef="join1" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-send_accept" name="Accepted" sourceRef="accepted" targetRef="send_accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-accepted-send_reject" name="Rejected" sourceRef="accepted" targetRef="send_reject" />
    <bpmn:sequenceFlow id="f-send_reject-rejected" sourceRef="send_reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-send_accept-confirm" sourceRef="send_accept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-orient" name="Confirmed" sourceRef="confirmed" targetRef="orient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-confirmed-canceled" sourceRef="confirmed" targetRef="canceled" />
    <bpmn:sequenceFlow id="f-orient-receive_orientation" sourceRef="orient" targetRef="receive_orientation" />
    <bpmn:sequenceFlow id="f-orient-setup_accounts" sourceRef="orient" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f-receive_orientation-orient_done" sourceRef="receive_orientation" targetRef="orient_done" />
    <bpmn:sequenceFlow id="f-setup_accounts-orient_done" sourceRef="setup_accounts" targetRef="orient_done" />
    <bpmn:sequenceFlow id="f-orient_done-intl" sourceRef="orient_done" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-visa" name="International" sourceRef="intl" targetRef="visa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">international</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-intl-obtain_id" name="Not international" sourceRef="intl" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-visa-obtain_id" sourceRef="visa" targetRef="obtain_id" />
    <bpmn:sequenceFlow id="f-obtain_id-meet_advisor" sourceRef="obtain_id" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f-meet_advisor-select_courses" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f-select_courses-resolve_conflicts" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f-resolve_conflicts-attend" sourceRef="resolve_conflicts" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-may_ad" sourceRef="attend" targetRef="may_ad" />
    <bpmn:sequenceFlow id="f-may_ad-adddrop" name="Add or drop" sourceRef="may_ad" targetRef="adddrop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">changes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-may_ad-post_grades" name="No changes" sourceRef="may_ad" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-adddrop-post_grades" sourceRef="adddrop" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-post_grades-review_grades" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-review_grades-grievances" sourceRef="review_grades" targetRef="grievances" />
    <bpmn:sequenceFlow id="f-grievances-submit_appeal" name="Grievances" sourceRef="grievances" targetRef="submit_appeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasGrievances</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-grievances-outcome_join" name="No grievances" sourceRef="grievances" targetRef="outcome_join" />
    <bpmn:sequenceFlow id="f-submit_appeal-meet_appeals" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f-meet_appeals-await_decision" sourceRef="meet_appeals" targetRef="await_decision" />
    <bpmn:sequenceFlow id="f-await_decision-outcome_join" sourceRef="await_decision" targetRef="outcome_join" />
    <bpmn:sequenceFlow id="f-outcome_join-outcome" sourceRef="outcome_join" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-graduated" name="Graduate" sourceRef="outcome" targetRef="graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">graduate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-outcome-withdrawn" name="Withdraw" sourceRef="outcome" targetRef="withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">withdraw</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-outcome-attend" name="Continue" sourceRef="outcome" targetRef="attend" />
  </bpmn:process>
</bpmn:definitions>
