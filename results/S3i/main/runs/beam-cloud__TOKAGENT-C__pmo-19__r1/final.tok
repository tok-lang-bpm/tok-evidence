tok 1.0 "Purchasing items from an online shop"

pool shop "Online shop"
  lane user "User"
    start start_order "Order started"
    task login "Log in to their account"
    and fork "Perform in parallel"
    task select "Select items to purchase"
    task setpay "Set payment method"
    task reward "Choose free reward"
    xor paychoice "Pay or installment?"
    task pay "Pay"
    task installment "Complete installment agreement"
    and join "All purchase activities completed"
    task deliver "Deliver items"
    xor returnchoice "Return items?"
    task return_exchange "Return items for exchange"
    end completed "Order completed"

flow start_order -> login -> fork
flow fork -> select
flow fork -> setpay
flow select -> reward
flow reward -> join
flow setpay -> paychoice
flow paychoice -> pay "pay"
flow paychoice -> installment "installment"
flow pay -> join
flow installment -> join
flow join -> deliver
flow deliver -> returnchoice
flow returnchoice -> return_exchange "yes"
flow returnchoice -> completed "no"
flow return_exchange -> deliver
