<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Purchasing items from an online shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Purchasing items from an online shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setpay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paychoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnchoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_exchange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_order" name="Order started" />
    <bpmn:task id="login" name="Log in to their account" />
    <bpmn:parallelGateway id="fork" name="Perform in parallel" />
    <bpmn:task id="select" name="Select items to purchase" />
    <bpmn:task id="setpay" name="Set payment method" />
    <bpmn:task id="reward" name="Choose free reward" />
    <bpmn:exclusiveGateway id="paychoice" name="Pay or installment?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:parallelGateway id="join" name="All purchase activities completed" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="returnchoice" name="Return items?" default="f-returnchoice-completed" />
    <bpmn:task id="return_exchange" name="Return items for exchange" />
    <bpmn:endEvent id="completed" name="Order completed" />
    <bpmn:sequenceFlow id="f-start_order-login" sourceRef="start_order" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-fork" sourceRef="login" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-select" sourceRef="fork" targetRef="select" />
    <bpmn:sequenceFlow id="f-fork-setpay" sourceRef="fork" targetRef="setpay" />
    <bpmn:sequenceFlow id="f-select-reward" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f-reward-join" sourceRef="reward" targetRef="join" />
    <bpmn:sequenceFlow id="f-setpay-paychoice" sourceRef="setpay" targetRef="paychoice" />
    <bpmn:sequenceFlow id="f-paychoice-pay" name="pay" sourceRef="paychoice" targetRef="pay" />
    <bpmn:sequenceFlow id="f-paychoice-installment" name="installment" sourceRef="paychoice" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-join" sourceRef="pay" targetRef="join" />
    <bpmn:sequenceFlow id="f-installment-join" sourceRef="installment" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-deliver" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-returnchoice" sourceRef="deliver" targetRef="returnchoice" />
    <bpmn:sequenceFlow id="f-returnchoice-return_exchange" name="yes" sourceRef="returnchoice" targetRef="return_exchange" />
    <bpmn:sequenceFlow id="f-returnchoice-completed" name="no" sourceRef="returnchoice" targetRef="completed" />
    <bpmn:sequenceFlow id="f-return_exchange-deliver" sourceRef="return_exchange" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
