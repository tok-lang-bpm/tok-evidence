<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Shipping of goods" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Shipping of goods" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insuremerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Logistics department head">
        <bpmn:flowNodeRef>insuretask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="shipped" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:parallelGateway id="fork" name="Shipping and packaging" />
    <bpmn:exclusiveGateway id="large" name="Large amounts?" default="f-large-label" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one of them" />
    <bpmn:task id="label" name="Write a package label" />
    <bpmn:exclusiveGateway id="insure" name="Parcel insurance necessary?" default="f-insure-insuremerge" />
    <bpmn:exclusiveGateway id="insuremerge" name="Insured" />
    <bpmn:exclusiveGateway id="shipmerge" name="Shipping arranged" />
    <bpmn:parallelGateway id="ready" name="Everything ready?" />
    <bpmn:task id="insuretask" name="Take parcel insurance" />
    <bpmn:task id="pack" name="Package the goods" />
    <bpmn:task id="prepare" name="Prepare packaged goods for pickup" />
    <bpmn:endEvent id="done" name="Goods prepared for pickup" />
    <bpmn:sequenceFlow id="f-shipped-clarify" sourceRef="shipped" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-fork" sourceRef="clarify" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-large" sourceRef="fork" targetRef="large" />
    <bpmn:sequenceFlow id="f-fork-pack" sourceRef="fork" targetRef="pack" />
    <bpmn:sequenceFlow id="f-large-invite" name="yes, large amounts" sourceRef="large" targetRef="invite" />
    <bpmn:sequenceFlow id="f-large-label" sourceRef="large" targetRef="label" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-shipmerge" sourceRef="select" targetRef="shipmerge" />
    <bpmn:sequenceFlow id="f-label-insure" sourceRef="label" targetRef="insure" />
    <bpmn:sequenceFlow id="f-insure-insuretask" name="yes" sourceRef="insure" targetRef="insuretask" />
    <bpmn:sequenceFlow id="f-insure-insuremerge" sourceRef="insure" targetRef="insuremerge" />
    <bpmn:sequenceFlow id="f-insuretask-insuremerge" sourceRef="insuretask" targetRef="insuremerge" />
    <bpmn:sequenceFlow id="f-insuremerge-shipmerge" sourceRef="insuremerge" targetRef="shipmerge" />
    <bpmn:sequenceFlow id="f-shipmerge-ready" sourceRef="shipmerge" targetRef="ready" />
    <bpmn:sequenceFlow id="f-pack-ready" sourceRef="pack" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-prepare" sourceRef="ready" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-done" sourceRef="prepare" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
