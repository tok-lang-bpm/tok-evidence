tok 1.0 "Shipping of goods"

pool company "Company"
  lane secretary "Secretary"
    start shipped "Goods shall be shipped"
    task clarify "Clarify who will do the shipping"
    and fork "Shipping and packaging"
    xor large "Large amounts?"
    task invite "Invite three logistic companies to make offers"
    task select "Select one of them"
    task label "Write a package label"
    xor insure "Parcel insurance necessary?"
    xor insuremerge "Insured"
    xor shipmerge "Shipping arranged"
    and ready "Everything ready?"
  lane head "Logistics department head"
    task insuretask "Take parcel insurance"
  lane warehouse "Warehousemen"
    task pack "Package the goods"
    task prepare "Prepare packaged goods for pickup"
    end done "Goods prepared for pickup"

flow shipped -> clarify -> fork
flow fork -> large
flow fork -> pack
flow large -> invite "yes, large amounts"
flow large -> label default
flow invite -> select
flow select -> shipmerge
flow label -> insure
flow insure -> insuretask "yes"
flow insure -> insuremerge default
flow insuretask -> insuremerge
flow insuremerge -> shipmerge
flow shipmerge -> ready
flow pack -> ready
flow ready -> prepare
flow prepare -> done
