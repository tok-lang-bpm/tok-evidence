<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Banking system">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Agency">
        <bpmn:flowNodeRef>first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnimm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Scoring requested" />
    <bpmn:task id="receive" name="Receive credit-scoring" />
    <bpmn:task id="send" name="Send a scoring request" />
    <bpmn:exclusiveGateway id="immediate" name="Immediate result?" default="f-immediate-inform" />
    <bpmn:task id="present" name="Present the result" />
    <bpmn:task id="display" name="Display a message" />
    <bpmn:exclusiveGateway id="merged" name="Result path?" />
    <bpmn:endEvent id="done" name="Scoring completed" />
    <bpmn:task id="first" name="Do first quick scoring (level 1)" />
    <bpmn:task id="returnimm" name="Return result directly" />
    <bpmn:task id="inform" name="Inform the delay" />
    <bpmn:task id="level2" name="Start level 2 scoring" />
    <bpmn:task id="sendback" name="Send result back" />
    <bpmn:sequenceFlow id="f-requested-receive" sourceRef="requested" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-send" sourceRef="receive" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-first" sourceRef="send" targetRef="first" />
    <bpmn:sequenceFlow id="f-first-immediate" sourceRef="first" targetRef="immediate" />
    <bpmn:sequenceFlow id="f-immediate-returnimm" name="yes" sourceRef="immediate" targetRef="returnimm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">immediate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-immediate-inform" name="no" sourceRef="immediate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-returnimm-merged" sourceRef="returnimm" targetRef="merged" />
    <bpmn:sequenceFlow id="f-inform-display" sourceRef="inform" targetRef="display" />
    <bpmn:sequenceFlow id="f-display-level2" sourceRef="display" targetRef="level2" />
    <bpmn:sequenceFlow id="f-level2-sendback" sourceRef="level2" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-merged" sourceRef="sendback" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-present" sourceRef="merged" targetRef="present" />
    <bpmn:sequenceFlow id="f-present-done" sourceRef="present" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
