tok 1.0 "Credit scoring"

pool bank "Bank"
  lane clerk "Sales clerk"
    start requested "Scoring requested"
    task receive "Receive credit-scoring"
  lane system "Banking system"
    task send "Send a scoring request"
    xor immediate "Immediate result?"
    task present "Present the result"
    task display "Display a message"
    xor merged "Result path?"
    end done "Scoring completed"
  lane agency "Agency"
    task first "Do first quick scoring (level 1)"
    task returnimm "Return result directly"
    task inform "Inform the delay"
    task level2 "Start level 2 scoring"
    task sendback "Send result back"

flow requested -> receive -> send -> first -> immediate
flow immediate -> returnimm "yes" when="immediate"
flow immediate -> inform "no" default
flow returnimm -> merged
flow inform -> display
flow display -> level2
flow level2 -> sendback
flow sendback -> merged
flow merged -> present
flow present -> done
