<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Restaurant service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant service" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>hungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enter_pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>react</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_emp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>served</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="hungry" name="Feeling hungry" />
    <bpmn:task id="enter" name="Enter the restaurant" />
    <bpmn:task id="choose" name="Choose a dish" />
    <bpmn:task id="wait_turn" name="Wait until turn" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="pickup" name="Pick up the meal" />
    <bpmn:task id="eat" name="Eat the meal" />
    <bpmn:task id="enter_pos" name="Enter the order into the POS system" />
    <bpmn:task id="collect" name="Collect the money" />
    <bpmn:task id="setup" name="Set up the buzzer" />
    <bpmn:task id="pass" name="Pass on the buzzer" />
    <bpmn:task id="inform_chef" name="Inform the chef" />
    <bpmn:task id="trigger" name="Set off the buzzer" />
    <bpmn:task id="wait5" name="Wait 5 minutes" />
    <bpmn:task id="call" name="Call the guest" />
    <bpmn:task id="handover" name="Hand over the meal" />
    <bpmn:exclusiveGateway id="react" name="Guest reacts to the buzzer?" />
    <bpmn:task id="prepare" name="Prepare the meal" />
    <bpmn:task id="place_hatch" name="Place meal in service hatch" />
    <bpmn:task id="inform_emp" name="Inform the employee" />
    <bpmn:endEvent id="served" name="Meal eaten" />
    <bpmn:sequenceFlow id="f-hungry-enter" sourceRef="hungry" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-choose" sourceRef="enter" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait_turn" sourceRef="choose" targetRef="wait_turn" />
    <bpmn:sequenceFlow id="f-wait_turn-place" sourceRef="wait_turn" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-enter_pos" sourceRef="place" targetRef="enter_pos" />
    <bpmn:sequenceFlow id="f-enter_pos-collect" sourceRef="enter_pos" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-setup" sourceRef="collect" targetRef="setup" />
    <bpmn:sequenceFlow id="f-setup-pass" sourceRef="setup" targetRef="pass" />
    <bpmn:sequenceFlow id="f-pass-inform_chef" sourceRef="pass" targetRef="inform_chef" />
    <bpmn:sequenceFlow id="f-inform_chef-prepare" sourceRef="inform_chef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-place_hatch" sourceRef="prepare" targetRef="place_hatch" />
    <bpmn:sequenceFlow id="f-place_hatch-inform_emp" sourceRef="place_hatch" targetRef="inform_emp" />
    <bpmn:sequenceFlow id="f-inform_emp-trigger" sourceRef="inform_emp" targetRef="trigger" />
    <bpmn:sequenceFlow id="f-trigger-react" sourceRef="trigger" targetRef="react" />
    <bpmn:sequenceFlow id="f-react-handover" name="yes" sourceRef="react" targetRef="handover" />
    <bpmn:sequenceFlow id="f-react-wait5" name="no" sourceRef="react" targetRef="wait5" />
    <bpmn:sequenceFlow id="f-handover-pickup" sourceRef="handover" targetRef="pickup" />
    <bpmn:sequenceFlow id="f-pickup-eat" sourceRef="pickup" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-served" sourceRef="eat" targetRef="served" />
    <bpmn:sequenceFlow id="f-wait5-call" sourceRef="wait5" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-react" sourceRef="call" targetRef="react" />
  </bpmn:process>
</bpmn:definitions>
