<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="jobsearch" name="Find a Job" processRef="jobsearch-process" />
  </bpmn:collaboration>
  <bpmn:process id="jobsearch-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="jobsearch-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gWanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterProbation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gRate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApplicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gRated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gPermanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gRating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continueOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endPermanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endContinue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="companies" name="Companies">
        <bpmn:flowNodeRef>sendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApplication</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Start" />
    <bpmn:task id="report" name="Report job applications" />
    <bpmn:exclusiveGateway id="gInterview" name="Negotiate job interview?" default="f-gInterview-gWanted" />
    <bpmn:task id="negotiate" name="Negotiate job interview" />
    <bpmn:exclusiveGateway id="gWanted" name="Company wants you to work for them?" default="f-gWanted-report" />
    <bpmn:task id="enterProbation" name="Enter probation phase" />
    <bpmn:parallelGateway id="gRate" />
    <bpmn:task id="rateCompany" name="Rate company" />
    <bpmn:task id="rateApplicant" name="Rate applicant" />
    <bpmn:parallelGateway id="gRated" />
    <bpmn:exclusiveGateway id="gPermanent" name="Job becomes permanent?" default="f-gPermanent-report" />
    <bpmn:exclusiveGateway id="gRating" name="Rated company C or less?" default="f-gRating-endPermanent" />
    <bpmn:task id="continueOffers" name="Continue to receive job offers" />
    <bpmn:endEvent id="endPermanent" name="Job becomes permanent" />
    <bpmn:endEvent id="endContinue" name="Continue receiving job offers" />
    <bpmn:task id="sendOffers" name="Send new potential job offers" />
    <bpmn:task id="confirm" name="Confirm received job applications" />
    <bpmn:task id="rateApplication" name="Rate application" />
    <bpmn:sequenceFlow id="f-start_event-report" sourceRef="start_event" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-sendOffers" sourceRef="report" targetRef="sendOffers" />
    <bpmn:sequenceFlow id="f-sendOffers-confirm" sourceRef="sendOffers" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rateApplication" sourceRef="confirm" targetRef="rateApplication" />
    <bpmn:sequenceFlow id="f-rateApplication-gInterview" sourceRef="rateApplication" targetRef="gInterview" />
    <bpmn:sequenceFlow id="f-gInterview-negotiate" name="yes" sourceRef="gInterview" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-gInterview-gWanted" name="no" sourceRef="gInterview" targetRef="gWanted" />
    <bpmn:sequenceFlow id="f-negotiate-gWanted" sourceRef="negotiate" targetRef="gWanted" />
    <bpmn:sequenceFlow id="f-gWanted-enterProbation" name="yes" sourceRef="gWanted" targetRef="enterProbation" />
    <bpmn:sequenceFlow id="f-gWanted-report" name="no" sourceRef="gWanted" targetRef="report" />
    <bpmn:sequenceFlow id="f-enterProbation-gRate" sourceRef="enterProbation" targetRef="gRate" />
    <bpmn:sequenceFlow id="f-gRate-rateCompany" sourceRef="gRate" targetRef="rateCompany" />
    <bpmn:sequenceFlow id="f-gRate-rateApplicant" sourceRef="gRate" targetRef="rateApplicant" />
    <bpmn:sequenceFlow id="f-rateCompany-gRated" sourceRef="rateCompany" targetRef="gRated" />
    <bpmn:sequenceFlow id="f-rateApplicant-gRated" sourceRef="rateApplicant" targetRef="gRated" />
    <bpmn:sequenceFlow id="f-gRated-gPermanent" sourceRef="gRated" targetRef="gPermanent" />
    <bpmn:sequenceFlow id="f-gPermanent-gRating" name="yes" sourceRef="gPermanent" targetRef="gRating" />
    <bpmn:sequenceFlow id="f-gPermanent-report" name="no" sourceRef="gPermanent" targetRef="report" />
    <bpmn:sequenceFlow id="f-gRating-continueOffers" name="yes" sourceRef="gRating" targetRef="continueOffers" />
    <bpmn:sequenceFlow id="f-gRating-endPermanent" name="no" sourceRef="gRating" targetRef="endPermanent" />
    <bpmn:sequenceFlow id="f-continueOffers-endContinue" sourceRef="continueOffers" targetRef="endContinue" />
  </bpmn:process>
</bpmn:definitions>
