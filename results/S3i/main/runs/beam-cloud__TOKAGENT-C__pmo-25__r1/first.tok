tok 1.0 "Find a Job"

pool jobsearch "Find a Job"
  lane applicant "Applicant"
    start start_event "Start"
    task report "Report job applications"
    xor gInterview "Negotiate job interview?"
    task negotiate "Negotiate job interview"
    xor gWanted "Company wants you to work for them?"
    task enterProbation "Enter probation phase"
    and gRate
    task rateCompany "Rate company"
    task rateApplicant "Rate applicant"
    and gRated
    xor gPermanent "Job becomes permanent?"
    xor gRating "Rated company C or less?"
    task continueOffers "Continue to receive job offers"
    end endPermanent "Job becomes permanent"
    end endContinue "Continue receiving job offers"
  lane companies "Companies"
    task sendOffers "Send new potential job offers"
    task confirm "Confirm received job applications"
    task rateApplication "Rate application"

flow start_event -> report
flow report -> sendOffers
flow sendOffers -> confirm
flow confirm -> rateApplication
flow rateApplication -> gInterview
flow gInterview -> negotiate "yes"
flow gInterview -> gWanted "no" default
flow negotiate -> gWanted
flow gWanted -> enterProbation "yes"
flow gWanted -> report "no" default
flow enterProbation -> gRate
flow gRate -> rateCompany
flow gRate -> rateApplicant
flow rateCompany -> gRated
flow rateApplicant -> gRated
flow gRated -> gPermanent
flow gPermanent -> gRating "yes"
flow gPermanent -> report "no" default
flow gRating -> continueOffers "yes"
flow gRating -> endPermanent "no" default
flow continueOffers -> endContinue