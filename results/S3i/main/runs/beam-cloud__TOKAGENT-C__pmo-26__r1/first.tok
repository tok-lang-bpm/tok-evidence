tok 1.0 "Becoming A Parent"

pool org "Organisation"
  lane parent "Parent"
    start started "Maternity leave needed"
    task select "Let parent select"
    task decide "Let parent decide about extension"
    end completed "Maternity leave completed"
    end extended "Maternity leave extended"
  lane organisation "Organisation"
    task fetch "Fetch information about potential models"
    task collect "Collect relevant information"
    and notify
    task notify_ss "Notify Social Security"
    task notify_company "Notify Company"
    and notified
    task gather "Gather information from companies"
    xor extend "Extend maternity leave?"

flow started -> fetch -> select -> collect -> notify
flow notify -> notify_ss
flow notify -> notify_company
flow notify_ss -> notified
flow notify_company -> notified
flow notified -> gather -> decide -> extend
flow extend -> completed "No"
flow extend -> extended "Yes"
