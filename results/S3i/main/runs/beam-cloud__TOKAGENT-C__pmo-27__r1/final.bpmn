<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="employees" name="Employees">
        <bpmn:flowNodeRef>accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported_by</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>employee_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_near_miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_defect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informed_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>employer_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_provider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>employer_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="self_employed" name="Self-employed person">
        <bpmn:flowNodeRef>self_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_employees_accidents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_own_accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="student" name="Student or schoolchild">
        <bpmn:flowNodeRef>report_directorate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="school" name="School, educational facility or university">
        <bpmn:flowNodeRef>report_school</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="insured" name="Insured party (private insurance)">
        <bpmn:flowNodeRef>report_private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fatality_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_fatality</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="accident" name="Work accident occurs" />
    <bpmn:exclusiveGateway id="reported_by" name="Reported by?" />
    <bpmn:exclusiveGateway id="employee_report" name="What is reported?" />
    <bpmn:task id="inform_accident" name="Inform the employer of any work accident" />
    <bpmn:task id="inform_near_miss" name="Inform the employer of an incident that would almost have led to an accident" />
    <bpmn:task id="inform_risk" name="Inform the employer of a serious and immediate risk to safety and health" />
    <bpmn:task id="inform_defect" name="Inform the employer of a defect discovered in protection systems" />
    <bpmn:exclusiveGateway id="informed_join" name="Informed employer?" />
    <bpmn:inclusiveGateway id="employer_split" name="Employer reporting obligations?" default="f-employer_split-employer_join" />
    <bpmn:task id="report_labour" name="Report any work accident that leads to a fatality or serious injury to the Labour Inspectorate if it has not been reported to the emergency services" />
    <bpmn:task id="report_provider" name="Report the work accident to the responsible accident insurance provider within five days" />
    <bpmn:inclusiveGateway id="employer_join" name="Reported to provider or inspectorate?" />
    <bpmn:endEvent id="reported" name="Accident reported" />
    <bpmn:parallelGateway id="self_split" name="Self-employed reporting obligations?" />
    <bpmn:task id="report_employees_accidents" name="Report accidents involving people you employ to the accident insurance provider" />
    <bpmn:task id="report_own_accident" name="Report accidents involving you to the accident insurance provider" />
    <bpmn:parallelGateway id="self_join" name="Reported?" />
    <bpmn:task id="report_directorate" name="Report accidents to the competent directorate" />
    <bpmn:task id="report_school" name="Report every work accident to the responsible accident insurance provider within five days in triplicate" />
    <bpmn:task id="report_private" name="Report an accident in writing immediately to the private insurance provider" />
    <bpmn:exclusiveGateway id="fatality_check" name="Fatalities?" default="f-fatality_check-reported" />
    <bpmn:task id="report_fatality" name="Report fatalities to the private insurance provider within three days" />
    <bpmn:sequenceFlow id="f-accident-reported_by" sourceRef="accident" targetRef="reported_by" />
    <bpmn:sequenceFlow id="f-reported_by-employee_report" name="Employee" sourceRef="reported_by" targetRef="employee_report" />
    <bpmn:sequenceFlow id="f-reported_by-self_split" name="Self-employed person" sourceRef="reported_by" targetRef="self_split" />
    <bpmn:sequenceFlow id="f-reported_by-report_directorate" name="Student or schoolchild" sourceRef="reported_by" targetRef="report_directorate" />
    <bpmn:sequenceFlow id="f-reported_by-report_school" name="School, educational facility or university" sourceRef="reported_by" targetRef="report_school" />
    <bpmn:sequenceFlow id="f-reported_by-report_private" name="Insured party (private insurance)" sourceRef="reported_by" targetRef="report_private" />
    <bpmn:sequenceFlow id="f-employee_report-inform_accident" name="Work accident" sourceRef="employee_report" targetRef="inform_accident" />
    <bpmn:sequenceFlow id="f-employee_report-inform_near_miss" name="Near miss" sourceRef="employee_report" targetRef="inform_near_miss" />
    <bpmn:sequenceFlow id="f-employee_report-inform_risk" name="Serious risk" sourceRef="employee_report" targetRef="inform_risk" />
    <bpmn:sequenceFlow id="f-employee_report-inform_defect" name="Defect in protection systems" sourceRef="employee_report" targetRef="inform_defect" />
    <bpmn:sequenceFlow id="f-inform_accident-informed_join" sourceRef="inform_accident" targetRef="informed_join" />
    <bpmn:sequenceFlow id="f-inform_near_miss-informed_join" sourceRef="inform_near_miss" targetRef="informed_join" />
    <bpmn:sequenceFlow id="f-inform_risk-informed_join" sourceRef="inform_risk" targetRef="informed_join" />
    <bpmn:sequenceFlow id="f-inform_defect-informed_join" sourceRef="inform_defect" targetRef="informed_join" />
    <bpmn:sequenceFlow id="f-informed_join-employer_split" sourceRef="informed_join" targetRef="employer_split" />
    <bpmn:sequenceFlow id="f-employer_split-report_labour" name="Fatality or serious injury not reported to emergency services" sourceRef="employer_split" targetRef="report_labour">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fatalAndNotEmergency</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-employer_split-report_provider" name="Insured person killed or unable to work for three days" sourceRef="employer_split" targetRef="report_provider">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">unable3Days</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-employer_split-employer_join" name="Neither" sourceRef="employer_split" targetRef="employer_join" />
    <bpmn:sequenceFlow id="f-report_labour-employer_join" sourceRef="report_labour" targetRef="employer_join" />
    <bpmn:sequenceFlow id="f-report_provider-employer_join" sourceRef="report_provider" targetRef="employer_join" />
    <bpmn:sequenceFlow id="f-employer_join-reported" sourceRef="employer_join" targetRef="reported" />
    <bpmn:sequenceFlow id="f-self_split-report_employees_accidents" sourceRef="self_split" targetRef="report_employees_accidents" />
    <bpmn:sequenceFlow id="f-self_split-report_own_accident" sourceRef="self_split" targetRef="report_own_accident" />
    <bpmn:sequenceFlow id="f-report_employees_accidents-self_join" sourceRef="report_employees_accidents" targetRef="self_join" />
    <bpmn:sequenceFlow id="f-report_own_accident-self_join" sourceRef="report_own_accident" targetRef="self_join" />
    <bpmn:sequenceFlow id="f-self_join-reported" sourceRef="self_join" targetRef="reported" />
    <bpmn:sequenceFlow id="f-report_directorate-reported" sourceRef="report_directorate" targetRef="reported" />
    <bpmn:sequenceFlow id="f-report_school-reported" sourceRef="report_school" targetRef="reported" />
    <bpmn:sequenceFlow id="f-report_private-fatality_check" sourceRef="report_private" targetRef="fatality_check" />
    <bpmn:sequenceFlow id="f-fatality_check-report_fatality" name="Fatalities" sourceRef="fatality_check" targetRef="report_fatality">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fatalities</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fatality_check-reported" name="No fatalities" sourceRef="fatality_check" targetRef="reported" />
    <bpmn:sequenceFlow id="f-report_fatality-reported" sourceRef="report_fatality" targetRef="reported" />
  </bpmn:process>
</bpmn:definitions>
