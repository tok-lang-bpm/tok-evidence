<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="internship" name="Internship" processRef="internship-process" />
  </bpmn:collaboration>
  <bpmn:process id="internship-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="internship-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start_internship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_experience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_status_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_status_you</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_status_you2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_status_you3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_status_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no_rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>send_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_status_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_status_company2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_status_company3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_internship" name="Internship started" />
    <bpmn:parallelGateway id="and_begin" />
    <bpmn:task id="enter_topic" name="Enter a topic and money" />
    <bpmn:task id="enter_experience" name="Enter experience and hobbies" />
    <bpmn:parallelGateway id="and_offers" />
    <bpmn:task id="receive_offers" name="Receive offers" />
    <bpmn:exclusiveGateway id="accept" name="Accept offer?" />
    <bpmn:task id="invalidate" name="Invalidate other offers" />
    <bpmn:parallelGateway id="and_status_start" />
    <bpmn:task id="write_status_you" name="Write a status update" />
    <bpmn:task id="write_status_you2" name="Write a status update" />
    <bpmn:task id="write_status_you3" name="Write a status update" />
    <bpmn:parallelGateway id="and_status_end" />
    <bpmn:exclusiveGateway id="recommend" name="Recommend the company?" />
    <bpmn:task id="send_tweet" name="Send a tweet">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="done" name="Internship completed" />
    <bpmn:endEvent id="no_rec" name="Recommendation declined" />
    <bpmn:task id="send_offers" name="Send offers" />
    <bpmn:task id="write_status_company" name="Write a status update about the intern" />
    <bpmn:task id="write_status_company2" name="Write a status update about the intern" />
    <bpmn:task id="write_status_company3" name="Write a status update about the intern" />
    <bpmn:sequenceFlow id="f-start_internship-and_begin" sourceRef="start_internship" targetRef="and_begin" />
    <bpmn:sequenceFlow id="f-and_begin-enter_topic" sourceRef="and_begin" targetRef="enter_topic" />
    <bpmn:sequenceFlow id="f-and_begin-send_offers" sourceRef="and_begin" targetRef="send_offers" />
    <bpmn:sequenceFlow id="f-enter_topic-enter_experience" sourceRef="enter_topic" targetRef="enter_experience" />
    <bpmn:sequenceFlow id="f-enter_experience-and_offers" sourceRef="enter_experience" targetRef="and_offers" />
    <bpmn:sequenceFlow id="f-send_offers-and_offers" sourceRef="send_offers" targetRef="and_offers" />
    <bpmn:sequenceFlow id="f-and_offers-receive_offers" sourceRef="and_offers" targetRef="receive_offers" />
    <bpmn:sequenceFlow id="f-receive_offers-accept" sourceRef="receive_offers" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-invalidate" name="yes" sourceRef="accept" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f-accept-receive_offers" name="no" sourceRef="accept" targetRef="receive_offers" />
    <bpmn:sequenceFlow id="f-invalidate-and_status_start" sourceRef="invalidate" targetRef="and_status_start" />
    <bpmn:sequenceFlow id="f-and_status_start-write_status_you" sourceRef="and_status_start" targetRef="write_status_you" />
    <bpmn:sequenceFlow id="f-and_status_start-write_status_company" sourceRef="and_status_start" targetRef="write_status_company" />
    <bpmn:sequenceFlow id="f-write_status_you-write_status_you2" sourceRef="write_status_you" targetRef="write_status_you2" />
    <bpmn:sequenceFlow id="f-write_status_you2-write_status_you3" sourceRef="write_status_you2" targetRef="write_status_you3" />
    <bpmn:sequenceFlow id="f-write_status_you3-and_status_end" sourceRef="write_status_you3" targetRef="and_status_end" />
    <bpmn:sequenceFlow id="f-write_status_company-write_status_company2" sourceRef="write_status_company" targetRef="write_status_company2" />
    <bpmn:sequenceFlow id="f-write_status_company2-write_status_company3" sourceRef="write_status_company2" targetRef="write_status_company3" />
    <bpmn:sequenceFlow id="f-write_status_company3-and_status_end" sourceRef="write_status_company3" targetRef="and_status_end" />
    <bpmn:sequenceFlow id="f-and_status_end-recommend" sourceRef="and_status_end" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-send_tweet" name="yes" sourceRef="recommend" targetRef="send_tweet" />
    <bpmn:sequenceFlow id="f-recommend-no_rec" name="no" sourceRef="recommend" targetRef="no_rec" />
    <bpmn:sequenceFlow id="f-send_tweet-done" sourceRef="send_tweet" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
