tok 1.0 "Internship"

pool internship "Internship"
  lane you "You"
    start start_internship "Internship started"
    and and_begin
    task enter_topic "Enter a topic and money"
    task enter_experience "Enter experience and hobbies"
    and and_offers
    task receive_offers "Receive offers"
    xor accept "Accept offer?"
    task invalidate "Invalidate other offers"
    and and_status_start
    task write_status_you "Write a status update"
    task write_status_you2 "Write a status update"
    task write_status_you3 "Write a status update"
    and and_status_end
    xor recommend "Recommend the company?"
    task send_tweet "Send a tweet" parallel
    end done "Internship completed"
    end no_rec "Recommendation declined"
  lane company "Company"
    task send_offers "Send offers"
    task write_status_company "Write a status update about the intern"
    task write_status_company2 "Write a status update about the intern"
    task write_status_company3 "Write a status update about the intern"

flow start_internship -> and_begin
flow and_begin -> enter_topic
flow and_begin -> send_offers
flow enter_topic -> enter_experience
flow enter_experience -> and_offers
flow send_offers -> and_offers
flow and_offers -> receive_offers
flow receive_offers -> accept
flow accept -> invalidate "yes"
flow accept -> receive_offers "no"
flow invalidate -> and_status_start
flow and_status_start -> write_status_you
flow and_status_start -> write_status_company
flow write_status_you -> write_status_you2 -> write_status_you3 -> and_status_end
flow write_status_company -> write_status_company2 -> write_status_company3 -> and_status_end
flow and_status_end -> recommend
flow recommend -> send_tweet "yes"
flow recommend -> no_rec "no"
flow send_tweet -> done