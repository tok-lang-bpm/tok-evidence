tok 1.0 "Work and Live in Austria"

pool austria "Work and Live in Austria"
  lane applicant "Applicant"
    start s "Start process"
    task check "Check requirements"
    and par
    task acc "Organize accommodation"
    task bank "Open bank account"
    and gathered
    task negotiate "Negotiate accommodation and bank account"
  lane representation "Representation office"
    task visaType "Determine visa type"
    xor type "Visa type?"
    task schengen "Apply for Schengen visa"
    task typeD "Apply for Type D visa"
    task typeAC "Apply for category A or C visa"
    xor docs
    task form "Submit visa application form"
    task passport "Provide travel document"
    task photo "Provide passport photo"
    task insurance "Present travel health insurance"
    task means "Prove sufficient means of subsistence"
    task evidence "Provide other evidence"
    task grounds "Check absence of grounds for refusal"
    xor safe "Absence of grounds for refusal?"
    xor additional "Additional documents requested?"
    task extra "Provide additional documents"
    task competence "Determine territorial competence"
    task contact "Contact representation in advance"
    task rwr "Apply for Rot-Weiss-Rot Card"
    task issue "Issue visa"
    end done "Visa issued"
    end refused "Application refused"

flow s -> check -> par
flow par -> acc
flow par -> bank
flow acc -> gathered
flow bank -> gathered
flow gathered -> negotiate -> visaType -> type
flow type -> schengen "Schengen visa"
flow type -> typeD "Type D visa"
flow type -> typeAC "Category A or C visa"
flow schengen -> docs
flow typeD -> docs
flow typeAC -> docs
flow docs -> form -> passport -> photo -> insurance -> means -> evidence -> grounds -> safe
flow safe -> additional "Yes"
flow safe -> refused "No"
flow additional -> extra "Yes"
flow additional -> competence "No"
flow extra -> competence
flow competence -> contact -> rwr -> issue -> done
