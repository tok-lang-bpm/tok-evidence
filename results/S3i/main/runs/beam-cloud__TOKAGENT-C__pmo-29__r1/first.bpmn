<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and Live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gathered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representation" name="Representation office">
        <bpmn:flowNodeRef>visaType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schengen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typeD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typeAC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>safe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>competence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rwr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start process" />
    <bpmn:task id="check" name="Check requirements" />
    <bpmn:parallelGateway id="par" />
    <bpmn:task id="acc" name="Organize accommodation" />
    <bpmn:task id="bank" name="Open bank account" />
    <bpmn:parallelGateway id="gathered" />
    <bpmn:task id="negotiate" name="Negotiate accommodation and bank account" />
    <bpmn:task id="visaType" name="Determine visa type" />
    <bpmn:exclusiveGateway id="type" name="Visa type?" />
    <bpmn:task id="schengen" name="Apply for Schengen visa" />
    <bpmn:task id="typeD" name="Apply for Type D visa" />
    <bpmn:task id="typeAC" name="Apply for category A or C visa" />
    <bpmn:parallelGateway id="docs" />
    <bpmn:task id="form" name="Submit visa application form" />
    <bpmn:task id="passport" name="Provide travel document" />
    <bpmn:task id="photo" name="Provide passport photo" />
    <bpmn:task id="insurance" name="Present travel health insurance" />
    <bpmn:task id="means" name="Prove sufficient means of subsistence" />
    <bpmn:task id="evidence" name="Provide other evidence" />
    <bpmn:task id="grounds" name="Check absence of grounds for refusal" />
    <bpmn:exclusiveGateway id="safe" name="Absence of grounds for refusal?" />
    <bpmn:parallelGateway id="docsdone" />
    <bpmn:exclusiveGateway id="additional" name="Additional documents requested?" default="f-additional-competence" />
    <bpmn:task id="extra" name="Provide additional documents" />
    <bpmn:task id="competence" name="Determine territorial competence" />
    <bpmn:task id="contact" name="Contact representation in advance" />
    <bpmn:task id="rwr" name="Apply for Rot-Weiss-Rot Card" />
    <bpmn:task id="issue" name="Issue visa" />
    <bpmn:endEvent id="done" name="Visa issued" />
    <bpmn:endEvent id="refused" name="Application refused" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-par" sourceRef="check" targetRef="par" />
    <bpmn:sequenceFlow id="f-par-acc" sourceRef="par" targetRef="acc" />
    <bpmn:sequenceFlow id="f-par-bank" sourceRef="par" targetRef="bank" />
    <bpmn:sequenceFlow id="f-acc-gathered" sourceRef="acc" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-bank-gathered" sourceRef="bank" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-gathered-negotiate" sourceRef="gathered" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-visaType" sourceRef="negotiate" targetRef="visaType" />
    <bpmn:sequenceFlow id="f-visaType-type" sourceRef="visaType" targetRef="type" />
    <bpmn:sequenceFlow id="f-type-schengen" name="Schengen visa" sourceRef="type" targetRef="schengen" />
    <bpmn:sequenceFlow id="f-type-typeD" name="Type D visa" sourceRef="type" targetRef="typeD" />
    <bpmn:sequenceFlow id="f-type-typeAC" name="Category A or C visa" sourceRef="type" targetRef="typeAC" />
    <bpmn:sequenceFlow id="f-schengen-docs" sourceRef="schengen" targetRef="docs" />
    <bpmn:sequenceFlow id="f-typeD-docs" sourceRef="typeD" targetRef="docs" />
    <bpmn:sequenceFlow id="f-typeAC-docs" sourceRef="typeAC" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-form" sourceRef="docs" targetRef="form" />
    <bpmn:sequenceFlow id="f-form-passport" sourceRef="form" targetRef="passport" />
    <bpmn:sequenceFlow id="f-passport-photo" sourceRef="passport" targetRef="photo" />
    <bpmn:sequenceFlow id="f-photo-insurance" sourceRef="photo" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-insurance-means" sourceRef="insurance" targetRef="means" />
    <bpmn:sequenceFlow id="f-means-evidence" sourceRef="means" targetRef="evidence" />
    <bpmn:sequenceFlow id="f-evidence-grounds" sourceRef="evidence" targetRef="grounds" />
    <bpmn:sequenceFlow id="f-grounds-safe" sourceRef="grounds" targetRef="safe" />
    <bpmn:sequenceFlow id="f-safe-docsdone" name="Yes" sourceRef="safe" targetRef="docsdone" />
    <bpmn:sequenceFlow id="f-safe-refused" name="No" sourceRef="safe" targetRef="refused" />
    <bpmn:sequenceFlow id="f-docsdone-additional" sourceRef="docsdone" targetRef="additional" />
    <bpmn:sequenceFlow id="f-additional-extra" name="Yes" sourceRef="additional" targetRef="extra" />
    <bpmn:sequenceFlow id="f-additional-competence" name="No" sourceRef="additional" targetRef="competence" />
    <bpmn:sequenceFlow id="f-extra-competence" sourceRef="extra" targetRef="competence" />
    <bpmn:sequenceFlow id="f-competence-contact" sourceRef="competence" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact-rwr" sourceRef="contact" targetRef="rwr" />
    <bpmn:sequenceFlow id="f-rwr-issue" sourceRef="rwr" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-done" sourceRef="issue" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
