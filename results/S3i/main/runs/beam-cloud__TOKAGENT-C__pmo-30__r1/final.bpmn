<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkgames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Plan LAN party" />
    <bpmn:task id="invite" name="Send invitations" />
    <bpmn:task id="games" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="parallel" />
    <bpmn:task id="appoint" name="Appoint a date" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree?" />
    <bpmn:task id="checkgames" name="Find out if you have all the games" />
    <bpmn:exclusiveGateway id="missing" name="Some games missing?" />
    <bpmn:task id="download" name="Download them" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="beer" name="Find out how much beer your friends will require" />
    <bpmn:exclusiveGateway id="enough" name="Do you have enough beer?" />
    <bpmn:task id="buy" name="Buy what's missing" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="e" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f-s-invite" sourceRef="s" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-games" sourceRef="invite" targetRef="games" />
    <bpmn:sequenceFlow id="f-games-parallel" sourceRef="games" targetRef="parallel" />
    <bpmn:sequenceFlow id="f-parallel-appoint" sourceRef="parallel" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-parallel-checkgames" sourceRef="parallel" targetRef="checkgames" />
    <bpmn:sequenceFlow id="f-appoint-agree" sourceRef="appoint" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-appoint" name="No" sourceRef="agree" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-agree-joined" name="Yes" sourceRef="agree" targetRef="joined" />
    <bpmn:sequenceFlow id="f-checkgames-missing" sourceRef="checkgames" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-download" name="Yes" sourceRef="missing" targetRef="download" />
    <bpmn:sequenceFlow id="f-missing-joined" name="No" sourceRef="missing" targetRef="joined" />
    <bpmn:sequenceFlow id="f-download-joined" sourceRef="download" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-beer" sourceRef="joined" targetRef="beer" />
    <bpmn:sequenceFlow id="f-beer-enough" sourceRef="beer" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-enjoy" name="Yes" sourceRef="enough" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enough-buy" name="No" sourceRef="enough" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-enjoy" sourceRef="buy" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-e" sourceRef="enjoy" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
