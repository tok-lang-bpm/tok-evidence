tok 1.0 "LAN Party"

pool org "Organisation"
  lane you "You"
    start s "Plan LAN party"
    task invite "Send invitations"
    task games "Find out which games they want to play"
    and parallel
    task appoint "Appoint a date"
    xor agree "8 or more people agree?"
    task checkgames "Find out if you have all the games"
    xor missing "Some games missing?"
    task download "Download them"
    and joined
    task beer "Find out how much beer your friends will require"
    xor enough "Do you have enough beer?"
    task buy "Buy what's missing"
    task enjoy "Enjoy the LAN party"
    end e "LAN party enjoyed"

flow s -> invite -> games -> parallel
flow parallel -> appoint
flow parallel -> checkgames
flow appoint -> agree
flow agree -> appoint "No"
flow agree -> joined "Yes"
flow checkgames -> missing
flow missing -> download "Yes"
flow missing -> joined "No"
flow download -> joined
flow joined -> beer
flow beer -> enough
flow enough -> enjoy "Yes"
flow enough -> buy "No"
flow buy -> enjoy
flow enjoy -> e
