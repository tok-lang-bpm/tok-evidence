<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comeUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkBnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasBnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clickLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterNames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="comeUp" name="Come up with good character names" />
    <bpmn:task id="checkBnet" name="Check whether you have a battle.net account" />
    <bpmn:exclusiveGateway id="hasBnet" name="Have a battle.net account?" />
    <bpmn:task id="enterInfo" name="Enter the account information" />
    <bpmn:task id="clickLink" name="Click the link you receive in the confirmation mail" />
    <bpmn:task id="checkSub" name="Check if you have an active WoW subscription" />
    <bpmn:exclusiveGateway id="hasSub" name="Have an active WoW subscription?" />
    <bpmn:task id="payMethod" name="Select the payment method" />
    <bpmn:exclusiveGateway id="payType" name="Payment method?" />
    <bpmn:task id="cc" name="Enter your credit card information" />
    <bpmn:task id="iban" name="Enter your IBAN and BIC numbers" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="select" name="Select realm, race and class" />
    <bpmn:parallelGateway id="merge" />
    <bpmn:task id="enterNames" name="Enter names one by one until a name is still available" />
    <bpmn:task id="confirm" name="Get a confirmation and some selfies" />
    <bpmn:task id="message" name="Get another message" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f-start-split" sourceRef="start" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-comeUp" sourceRef="split" targetRef="comeUp" />
    <bpmn:sequenceFlow id="f-split-checkBnet" sourceRef="split" targetRef="checkBnet" />
    <bpmn:sequenceFlow id="f-checkBnet-hasBnet" sourceRef="checkBnet" targetRef="hasBnet" />
    <bpmn:sequenceFlow id="f-hasBnet-checkSub" name="yes" sourceRef="hasBnet" targetRef="checkSub" />
    <bpmn:sequenceFlow id="f-hasBnet-enterInfo" name="no" sourceRef="hasBnet" targetRef="enterInfo" />
    <bpmn:sequenceFlow id="f-enterInfo-clickLink" sourceRef="enterInfo" targetRef="clickLink" />
    <bpmn:sequenceFlow id="f-clickLink-checkSub" sourceRef="clickLink" targetRef="checkSub" />
    <bpmn:sequenceFlow id="f-checkSub-hasSub" sourceRef="checkSub" targetRef="hasSub" />
    <bpmn:sequenceFlow id="f-hasSub-login" name="yes" sourceRef="hasSub" targetRef="login" />
    <bpmn:sequenceFlow id="f-hasSub-payMethod" name="no" sourceRef="hasSub" targetRef="payMethod" />
    <bpmn:sequenceFlow id="f-payMethod-payType" sourceRef="payMethod" targetRef="payType" />
    <bpmn:sequenceFlow id="f-payType-cc" name="Credit card" sourceRef="payType" targetRef="cc" />
    <bpmn:sequenceFlow id="f-payType-iban" name="Bank account" sourceRef="payType" targetRef="iban" />
    <bpmn:sequenceFlow id="f-cc-login" sourceRef="cc" targetRef="login" />
    <bpmn:sequenceFlow id="f-iban-login" sourceRef="iban" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-select" sourceRef="login" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-merge" sourceRef="select" targetRef="merge" />
    <bpmn:sequenceFlow id="f-comeUp-merge" sourceRef="comeUp" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-enterNames" sourceRef="merge" targetRef="enterNames" />
    <bpmn:sequenceFlow id="f-enterNames-confirm" sourceRef="enterNames" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-message" sourceRef="confirm" targetRef="message" />
    <bpmn:sequenceFlow id="f-message-end" sourceRef="message" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
