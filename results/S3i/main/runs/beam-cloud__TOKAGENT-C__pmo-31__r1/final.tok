tok 1.0 "Blizzard Online Character Generator"

pool blizzard "Blizzard"
  lane player "Player"
    start start "Start"
    and split
    task comeUp "Come up with good character names"
    task checkBnet "Check whether you have a battle.net account"
    xor hasBnet "Have a battle.net account?"
    task enterInfo "Enter the account information"
    task clickLink "Click the link you receive in the confirmation mail"
    task checkSub "Check if you have an active WoW subscription"
    xor hasSub "Have an active WoW subscription?"
    task payMethod "Select the payment method"
    xor payType "Payment method?"
    task cc "Enter your credit card information"
    task iban "Enter your IBAN and BIC numbers"
    task login "Log into the game"
    task select "Select realm, race and class"
    and merge
    task enterNames "Enter names one by one until a name is still available"
    task confirm "Get a confirmation and some selfies"
    task message "Get another message"
    end end "End"

flow start -> split
flow split -> comeUp
flow split -> checkBnet
flow checkBnet -> hasBnet
flow hasBnet -> checkSub "yes"
flow hasBnet -> enterInfo "no"
flow enterInfo -> clickLink
flow clickLink -> checkSub
flow checkSub -> hasSub
flow hasSub -> login "yes"
flow hasSub -> payMethod "no"
flow payMethod -> payType
flow payType -> cc "Credit card"
flow payType -> iban "Bank account"
flow cc -> login
flow iban -> login
flow login -> select
flow select -> merge
flow comeUp -> merge
flow merge -> enterNames
flow enterNames -> confirm
flow confirm -> message
flow message -> end
