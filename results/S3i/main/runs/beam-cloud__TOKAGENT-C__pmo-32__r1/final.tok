tok 1.0 "Farming Bot"

pool farm "Farming Bot"
  lane player "Player"
    start start "Player wants to create a custom farming bot"
    task find "Find out which resources you want"
    task update "Update the list of to be farmed materials"
    task brag "Brag to selected friends"
    task send "Send them materials"
    or choice "Brag and/or send materials?"
    or joined "Bragging and sending done"
    end done "Finished"
    end listed "List updated"
    end notified "Milestone notified"
  lane bot "Bot"
    task startfarming "Start farming"
    task recover "Recover from natural disaster"
    task notify "Notify that a milestone is reached"
    sub farming "Farm resources"
      start fs "Farming started"
      task gather "Gather resources" parallel
      end fe "Farming finished"
      flow fs -> gather -> fe
    boundary disaster on=farming signal="natural disaster"
    boundary milestone on=farming signal="milestone reached" noninterrupting
    boundary updateevent on=farming signal="update list requested" noninterrupting

flow start -> find -> startfarming -> farming
flow farming -> choice
flow choice -> brag "Brag" when="brag"
flow choice -> send "Send materials" when="send"
flow choice -> joined default
flow brag -> joined
flow send -> joined
flow joined -> done
flow disaster -> recover
flow recover -> farming
flow milestone -> notify -> notified
flow updateevent -> update -> listed
