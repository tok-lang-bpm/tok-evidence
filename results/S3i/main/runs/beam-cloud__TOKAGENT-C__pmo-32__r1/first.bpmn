<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Farming Bot" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="farm" name="Farming Bot" processRef="farm-process" />
  </bpmn:collaboration>
  <bpmn:process id="farm-process" name="Farming Bot" isExecutable="false">
    <bpmn:laneSet id="farm-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bot" name="Bot">
        <bpmn:flowNodeRef>startfarming</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="find" name="Find out which resources you want" />
    <bpmn:task id="brag" name="Brag to selected friends" />
    <bpmn:task id="send" name="Send them materials" />
    <bpmn:endEvent id="done" name="Finished" />
    <bpmn:task id="startfarming" name="Start farming" />
    <bpmn:task id="collect" name="Collect resources" />
    <bpmn:task id="finish" name="Finish farming" />
    <bpmn:sequenceFlow id="f-start-find" sourceRef="start" targetRef="find" />
    <bpmn:sequenceFlow id="f-find-startfarming" sourceRef="find" targetRef="startfarming" />
    <bpmn:sequenceFlow id="f-startfarming-collect" sourceRef="startfarming" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-finish" sourceRef="collect" targetRef="finish" />
    <bpmn:sequenceFlow id="f-finish-brag" sourceRef="finish" targetRef="brag" />
    <bpmn:sequenceFlow id="f-brag-send" sourceRef="brag" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-done" sourceRef="send" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
