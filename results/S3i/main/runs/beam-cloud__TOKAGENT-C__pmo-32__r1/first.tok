tok 1.0 "Farming Bot"

pool farm "Farming Bot"
  lane player "Player"
    start start "Start"
    task find "Find out which resources you want"
    task brag "Brag to selected friends"
    task send "Send them materials"
    end done "Finished"
  lane bot "Bot"
    task startfarming "Start farming"
    task collect "Collect resources"
    task finish "Finish farming"

flow start -> find -> startfarming -> collect -> finish
flow finish -> brag
flow brag -> send
flow send -> done
