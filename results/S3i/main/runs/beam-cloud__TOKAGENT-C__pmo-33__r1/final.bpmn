<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Instruct an artist to create a 3D model print it on a 3D printer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Instruct an artist to create a 3D model print it on a 3D printer" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>craving</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sat_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sat_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose_color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>in_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under_100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plastic_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turn_on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heat_bed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heat_extruder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>listed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create_project</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_project</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_stl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printer" name="3D Printer">
        <bpmn:flowNodeRef>print_model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="craving" name="Craving a custom 3D model" />
    <bpmn:task id="instruct" name="Instruct an artist to create a project" />
    <bpmn:task id="send_sketches" name="Send sketches" />
    <bpmn:task id="tell_change" name="Tell what to change" />
    <bpmn:exclusiveGateway id="sat_merge" name="Merge satisfied check" />
    <bpmn:exclusiveGateway id="sat_split" name="Satisfied with result?" />
    <bpmn:task id="choose_color" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="in_stock" name="Color in stock?" />
    <bpmn:task id="check_amount" name="Check how much color left" />
    <bpmn:exclusiveGateway id="under_100" name="Under 100 grams?" />
    <bpmn:task id="add_list" name="Put on shopping list" />
    <bpmn:task id="order_color" name="Order the color" />
    <bpmn:exclusiveGateway id="plastic_ready" name="Plastic available?" />
    <bpmn:parallelGateway id="prep" name="Prepare printing" />
    <bpmn:task id="turn_on" name="Turn the printer on" />
    <bpmn:task id="heat_bed" name="Heat up the bed" />
    <bpmn:task id="heat_extruder" name="Heat up the extruder" />
    <bpmn:parallelGateway id="prep_join" name="Preparation complete" />
    <bpmn:task id="generate_gcode" name="Generate gcode file" />
    <bpmn:endEvent id="listed" name="Shopping list updated" />
    <bpmn:task id="create_project" name="Create project" />
    <bpmn:task id="update_project" name="Update project" />
    <bpmn:task id="send_stl" name="Send STL file" />
    <bpmn:task id="print_model" name="Print the model" />
    <bpmn:endEvent id="printed" name="Model printed" />
    <bpmn:sequenceFlow id="f-craving-instruct" sourceRef="craving" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-send_sketches" sourceRef="instruct" targetRef="send_sketches" />
    <bpmn:sequenceFlow id="f-send_sketches-create_project" sourceRef="send_sketches" targetRef="create_project" />
    <bpmn:sequenceFlow id="f-create_project-sat_merge" sourceRef="create_project" targetRef="sat_merge" />
    <bpmn:sequenceFlow id="f-sat_merge-sat_split" sourceRef="sat_merge" targetRef="sat_split" />
    <bpmn:sequenceFlow id="f-sat_split-send_stl" name="yes" sourceRef="sat_split" targetRef="send_stl" />
    <bpmn:sequenceFlow id="f-sat_split-tell_change" name="no" sourceRef="sat_split" targetRef="tell_change" />
    <bpmn:sequenceFlow id="f-send_stl-choose_color" sourceRef="send_stl" targetRef="choose_color" />
    <bpmn:sequenceFlow id="f-tell_change-update_project" sourceRef="tell_change" targetRef="update_project" />
    <bpmn:sequenceFlow id="f-update_project-sat_merge" sourceRef="update_project" targetRef="sat_merge" />
    <bpmn:sequenceFlow id="f-choose_color-in_stock" sourceRef="choose_color" targetRef="in_stock" />
    <bpmn:sequenceFlow id="f-in_stock-check_amount" name="yes" sourceRef="in_stock" targetRef="check_amount" />
    <bpmn:sequenceFlow id="f-in_stock-order_color" name="no" sourceRef="in_stock" targetRef="order_color" />
    <bpmn:sequenceFlow id="f-check_amount-under_100" sourceRef="check_amount" targetRef="under_100" />
    <bpmn:sequenceFlow id="f-under_100-add_list" name="yes" sourceRef="under_100" targetRef="add_list" />
    <bpmn:sequenceFlow id="f-under_100-plastic_ready" name="no" sourceRef="under_100" targetRef="plastic_ready" />
    <bpmn:sequenceFlow id="f-add_list-listed" sourceRef="add_list" targetRef="listed" />
    <bpmn:sequenceFlow id="f-order_color-plastic_ready" sourceRef="order_color" targetRef="plastic_ready" />
    <bpmn:sequenceFlow id="f-plastic_ready-prep" sourceRef="plastic_ready" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-turn_on" sourceRef="prep" targetRef="turn_on" />
    <bpmn:sequenceFlow id="f-prep-generate_gcode" sourceRef="prep" targetRef="generate_gcode" />
    <bpmn:sequenceFlow id="f-turn_on-heat_bed" sourceRef="turn_on" targetRef="heat_bed" />
    <bpmn:sequenceFlow id="f-heat_bed-heat_extruder" sourceRef="heat_bed" targetRef="heat_extruder" />
    <bpmn:sequenceFlow id="f-heat_extruder-prep_join" sourceRef="heat_extruder" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-generate_gcode-prep_join" sourceRef="generate_gcode" targetRef="prep_join" />
    <bpmn:sequenceFlow id="f-prep_join-print_model" sourceRef="prep_join" targetRef="print_model" />
    <bpmn:sequenceFlow id="f-print_model-printed" sourceRef="print_model" targetRef="printed" />
  </bpmn:process>
</bpmn:definitions>
