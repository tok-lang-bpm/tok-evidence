tok 1.0 "Instruct an artist to create a 3D model print it on a 3D printer"

pool org "Organisation"
  lane you "You"
    start craving "Craving a custom 3D model"
    task instruct "Instruct an artist to create a project"
    task send_sketches "Send sketches"
    task tell_change "Tell what to change"
    xor satisfied "Satisfied with result?"
    task choose_color "Choose plastic color"
    xor in_stock "Color in stock?"
    task check_amount "Check how much color left"
    xor under_100 "Under 100 grams?"
    task add_list "Put on shopping list"
    task order_color "Order the color"
    xor plastic_ready "Plastic available?"
    and prep "Prepare printing"
    task turn_on "Turn the printer on"
    task heat_bed "Heat up the bed"
    task heat_extruder "Heat up the extruder"
    and prep_join "Preparation complete"
    task generate_gcode "Generate gcode file"
    and work_join "Work complete"
    task plant_placeholder "Placeholder"
    end listed "Shopping list updated"
  lane artist "Artist"
    task create_project "Create project"
    task update_project "Update project"
    task send_stl "Send STL file"
  lane printer "3D Printer"
    task print_model "Print the model"
    end printed "Model printed"

flow craving -> instruct -> send_sketches -> create_project -> satisfied
flow satisfied -> send_stl "yes"
flow satisfied -> tell_change "no"
flow send_stl -> choose_color
flow tell_change -> update_project
flow update_project -> satisfied

flow choose_color -> in_stock
flow in_stock -> check_amount "yes"
flow in_stock -> order_color "no"
flow check_amount -> under_100
flow under_100 -> add_list "yes"
flow under_100 -> plastic_ready "no"
flow add_list -> listed
flow order_color -> plastic_ready

flow plastic_ready -> prep
flow prep -> turn_on
flow prep -> generate_gcode
flow turn_on -> heat_bed
flow heat_bed -> heat_extruder
flow heat_extruder -> prep_join
flow generate_gcode -> prep_join? 
flow prep_join -> work_join
flow work_join -> print_model
flow print_model -> printed
```