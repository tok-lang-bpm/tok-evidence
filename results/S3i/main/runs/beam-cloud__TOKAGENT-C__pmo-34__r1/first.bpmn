<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order certain Lego brick sets" />
    <bpmn:task id="give" name="Give the Lego brick sets to the children" />
    <bpmn:exclusiveGateway id="parts" name="Parts available in the container?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="build" name="Build a subcomponent" />
    <bpmn:task id="test" name="Test the subcomponent" />
    <bpmn:exclusiveGateway id="tested" name="Subcomponent tested successfully?" />
    <bpmn:task id="redesign" name="Redesign and rebuild the subcomponent" />
    <bpmn:exclusiveGateway id="more" name="More subcomponents to build?" />
    <bpmn:task id="assemble" name="Assemble the subcomponents" />
    <bpmn:endEvent id="success" name="Machine built" />
    <bpmn:task id="sort" name="Sort the parts into containers" />
    <bpmn:sequenceFlow id="f-start-design" sourceRef="start" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-parts" sourceRef="sort" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-build" name="yes" sourceRef="parts" targetRef="build" />
    <bpmn:sequenceFlow id="f-parts-reorder" name="no" sourceRef="parts" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-reorder-build" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-tested" sourceRef="test" targetRef="tested" />
    <bpmn:sequenceFlow id="f-tested-more" name="yes" sourceRef="tested" targetRef="more" />
    <bpmn:sequenceFlow id="f-tested-redesign" name="no" sourceRef="tested" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-build" sourceRef="redesign" targetRef="build" />
    <bpmn:sequenceFlow id="f-more-build" name="yes" sourceRef="more" targetRef="build" />
    <bpmn:sequenceFlow id="f-more-assemble" name="no" sourceRef="more" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-success" sourceRef="assemble" targetRef="success" />
  </bpmn:process>
</bpmn:definitions>
