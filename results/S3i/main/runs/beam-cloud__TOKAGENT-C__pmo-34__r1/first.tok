tok 1.0 "Building a custom machine out of Lego bricks"

pool organisation "Organisation"
  lane you "You"
    start start "Start"
    task design "Develop the basic design"
    task order "Order certain Lego brick sets"
    task give "Give the Lego brick sets to the children"
    xor parts "Parts available in the container?"
    task reorder "Reorder individual parts"
    task build "Build a subcomponent"
    task test "Test the subcomponent"
    xor tested "Subcomponent tested successfully?"
    task redesign "Redesign and rebuild the subcomponent"
    xor more "More subcomponents to build?"
    task assemble "Assemble the subcomponents"
    end success "Machine built"
  lane children "Children"
    task sort "Sort the parts into containers"

flow start -> design -> order -> give -> sort
flow sort -> parts
flow parts -> build "yes"
flow parts -> reorder "no"
flow reorder -> build
flow build -> test
flow test -> tested
flow tested -> more "yes"
flow tested -> redesign "no"
flow redesign -> build
flow more -> build "yes"
flow more -> assemble "no"
flow assemble -> success
