tok 1.0 "Chainsaw"

pool org "Organisation"
  lane customer "Customer"
    start needed "Order needed"
    task tell "Tell the properties"
    end done "Order fulfilled"
    end stopped "Order stopped"
  lane producer "Producer"
    and po
    task order1 "Order parts"
    task order2 "Order parts"
    and pi
    task receive "Receive parts"
    task inspect "Inspect all parts"
    and prod
    task assemble "Assemble parts"
    task update "Send updates to customer"
    and prodjoin
    task sendfirst "Send first saw to customer"
    xor likes "Customer likes it?"
    task rest "Produce rest of order"

flow needed -> tell -> po
flow po -> order1
flow po -> order2
flow order1 -> pi
flow order2 -> pi
flow pi -> receive -> inspect -> prod
flow prod -> assemble
flow prod -> update
flow assemble -> prodjoin
flow update -> prodjoin
flow prodjoin -> sendfirst -> likes
flow likes -> rest "yes" when="likes"
flow likes -> stopped "no" default
flow rest -> done
