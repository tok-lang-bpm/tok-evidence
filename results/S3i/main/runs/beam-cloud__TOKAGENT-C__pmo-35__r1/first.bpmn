<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prodjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Order needed" />
    <bpmn:task id="tell" name="Tell the properties" />
    <bpmn:task id="evaluate" name="Evaluate first saw" />
    <bpmn:endEvent id="done" name="Order fulfilled" />
    <bpmn:endEvent id="stopped" name="Order stopped" />
    <bpmn:parallelGateway id="po" />
    <bpmn:task id="order1" name="Order parts" />
    <bpmn:task id="order2" name="Order parts" />
    <bpmn:parallelGateway id="pi" />
    <bpmn:task id="receive" name="Receive parts" />
    <bpmn:task id="inspect" name="Inspect all parts" />
    <bpmn:parallelGateway id="prod" />
    <bpmn:task id="assemble" name="Assemble parts" />
    <bpmn:task id="update" name="Send updates to customer" />
    <bpmn:parallelGateway id="prodjoin" />
    <bpmn:task id="sendfirst" name="Send first saw to customer" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes it?" default="f-likes-stopped" />
    <bpmn:task id="rest" name="Produce rest of order" />
    <bpmn:sequenceFlow id="f-needed-tell" sourceRef="needed" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-po" sourceRef="tell" targetRef="po" />
    <bpmn:sequenceFlow id="f-po-order1" sourceRef="po" targetRef="order1" />
    <bpmn:sequenceFlow id="f-po-order2" sourceRef="po" targetRef="order2" />
    <bpmn:sequenceFlow id="f-order1-pi" sourceRef="order1" targetRef="pi" />
    <bpmn:sequenceFlow id="f-order2-pi" sourceRef="order2" targetRef="pi" />
    <bpmn:sequenceFlow id="f-pi-receive" sourceRef="pi" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-prod" sourceRef="inspect" targetRef="prod" />
    <bpmn:sequenceFlow id="f-prod-assemble" sourceRef="prod" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-prod-update" sourceRef="prod" targetRef="update" />
    <bpmn:sequenceFlow id="f-assemble-prodjoin" sourceRef="assemble" targetRef="prodjoin" />
    <bpmn:sequenceFlow id="f-update-prodjoin" sourceRef="update" targetRef="prodjoin" />
    <bpmn:sequenceFlow id="f-prodjoin-sendfirst" sourceRef="prodjoin" targetRef="sendfirst" />
    <bpmn:sequenceFlow id="f-sendfirst-evaluate" sourceRef="sendfirst" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-likes" sourceRef="evaluate" targetRef="likes" />
    <bpmn:sequenceFlow id="f-likes-rest" name="yes" sourceRef="likes" targetRef="rest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">likes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-likes-stopped" name="no" sourceRef="likes" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-rest-done" sourceRef="rest" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
