<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Luxury Airplane Manufacturer" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendprotocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian" name="Russian team">
        <bpmn:flowNodeRef>vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish" name="Irish team">
        <bpmn:flowNodeRef>whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Specifications needed" />
    <bpmn:task id="select" name="Select interior specifications" />
    <bpmn:task id="confirm" name="Confirm delivery" />
    <bpmn:endEvent id="confirmed" name="Delivery confirmed" />
    <bpmn:task id="receive" name="Receive the specifications" />
    <bpmn:task id="send" name="Send requirements to manufacturing teams" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="assemble" name="Assemble the interior" />
    <bpmn:task id="flight" name="Send the plane on a test flight" />
    <bpmn:task id="protocol" name="Create a test protocol" />
    <bpmn:task id="sendprotocol" name="Send the test protocol" />
    <bpmn:task id="deliver" name="Deliver the plane to the customer" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="vodka" name="Manufacture the vodka bar" />
    <bpmn:task id="whiskey" name="Manufacture the whiskey bar" />
    <bpmn:sequenceFlow id="f-needed-select" sourceRef="needed" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-receive" sourceRef="select" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-send" sourceRef="receive" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-fork" sourceRef="send" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-vodka" sourceRef="fork" targetRef="vodka" />
    <bpmn:sequenceFlow id="f-fork-whiskey" sourceRef="fork" targetRef="whiskey" />
    <bpmn:sequenceFlow id="f-vodka-join" sourceRef="vodka" targetRef="join" />
    <bpmn:sequenceFlow id="f-whiskey-join" sourceRef="whiskey" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-assemble" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-flight" sourceRef="assemble" targetRef="flight" />
    <bpmn:sequenceFlow id="f-flight-protocol" sourceRef="flight" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-protocol-sendprotocol" sourceRef="protocol" targetRef="sendprotocol" />
    <bpmn:sequenceFlow id="f-sendprotocol-deliver" sourceRef="sendprotocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
