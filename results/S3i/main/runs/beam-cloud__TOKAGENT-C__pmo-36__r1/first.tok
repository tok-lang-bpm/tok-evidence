tok 1.0 "Luxury Airplane"

pool company "Luxury Airplane Manufacturer"
  lane customer "Customer"
    start needed "Specifications needed"
    task select "Select interior specifications"
    task confirm "Confirm delivery"
    end confirmed "Delivery confirmed"
  lane producer "Producer"
    task receive "Receive the specifications"
    task send "Send requirements to manufacturing teams"
    and fork
    task assemble "Assemble the interior"
    task flight "Send the plane on a test flight"
    task protocol "Create a test protocol"
    task sendprotocol "Send the test protocol"
    task deliver "Deliver the plane to the customer"
    and join
  lane russian "Russian team"
    task vodka "Manufacture the vodka bar"
  lane irish "Irish team"
    task whiskey "Manufacture the whiskey bar"

flow needed -> select -> receive -> send -> fork
flow fork -> vodka
flow fork -> whiskey
flow vodka -> join
flow whiskey -> join
flow join -> assemble -> flight -> protocol -> sendprotocol -> deliver -> confirm -> confirmed
