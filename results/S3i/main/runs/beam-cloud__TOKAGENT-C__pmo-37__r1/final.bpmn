<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderseveral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enoughjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivejoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reordercheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderfast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Need parts" />
    <bpmn:task id="query" name="Query web shops" />
    <bpmn:task id="find" name="Find out how much they can deliver, at which price, and how long it will take" />
    <bpmn:task id="create" name="Create a list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="enough" name="One shop has not enough parts?" default="f-enough-enoughjoin" />
    <bpmn:task id="orderseveral" name="Order from several shops" />
    <bpmn:exclusiveGateway id="enoughjoin" />
    <bpmn:task id="cheapest" name="Always use the cheapest parts" />
    <bpmn:exclusiveGateway id="receivejoin" />
    <bpmn:task id="receive" name="The parts arrive in batches" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:exclusiveGateway id="stock" name="Stock below threshold?" default="f-stock-complete" />
    <bpmn:task id="reordercheap" name="Reorder the cheapest" />
    <bpmn:task id="reorderfast" name="Reorder the fastest" />
    <bpmn:task id="mail" name="Write a mail to your friends, complaining about the webshops" />
    <bpmn:endEvent id="complete" name="Contract completed" />
    <bpmn:endEvent id="complaint" name="Mail sent" />
    <bpmn:sequenceFlow id="f-needed-query" sourceRef="needed" targetRef="query" />
    <bpmn:sequenceFlow id="f-query-find" sourceRef="query" targetRef="find" />
    <bpmn:sequenceFlow id="f-find-create" sourceRef="find" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-enough" sourceRef="create" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-orderseveral" name="not enough" sourceRef="enough" targetRef="orderseveral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notEnough</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough-enoughjoin" name="enough" sourceRef="enough" targetRef="enoughjoin" />
    <bpmn:sequenceFlow id="f-orderseveral-enoughjoin" sourceRef="orderseveral" targetRef="enoughjoin" />
    <bpmn:sequenceFlow id="f-enoughjoin-cheapest" sourceRef="enoughjoin" targetRef="cheapest" />
    <bpmn:sequenceFlow id="f-cheapest-receivejoin" sourceRef="cheapest" targetRef="receivejoin" />
    <bpmn:sequenceFlow id="f-reordercheap-receivejoin" sourceRef="reordercheap" targetRef="receivejoin" />
    <bpmn:sequenceFlow id="f-reorderfast-receivejoin" sourceRef="reorderfast" targetRef="receivejoin" />
    <bpmn:sequenceFlow id="f-receivejoin-receive" sourceRef="receivejoin" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-build" sourceRef="receive" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-stock" sourceRef="build" targetRef="stock" />
    <bpmn:sequenceFlow id="f-stock-reordercheap" name="below 5" sourceRef="stock" targetRef="reordercheap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &lt; 5 and stock &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-stock-reorderfast" name="below 3" sourceRef="stock" targetRef="reorderfast">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &lt; 3 and stock &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-stock-mail" name="zero" sourceRef="stock" targetRef="mail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-stock-complete" name="enough stock" sourceRef="stock" targetRef="complete" />
    <bpmn:sequenceFlow id="f-mail-complaint" sourceRef="mail" targetRef="complaint" />
  </bpmn:process>
</bpmn:definitions>
