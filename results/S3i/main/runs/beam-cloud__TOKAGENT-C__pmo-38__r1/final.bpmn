<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Building a House" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_msgs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_invites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendee_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Tree house architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online stores">
        <bpmn:flowNodeRef>process_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="collect" name="Collect your requirements" />
    <bpmn:task id="send_req" name="Send them to a tree house architect" />
    <bpmn:task id="refine" name="Refine with additional requirements" />
    <bpmn:exclusiveGateway id="more" name="More refinement needed?" />
    <bpmn:task id="create_list" name="Create the list of needed materials from the plan" />
    <bpmn:task id="order" name="Order them from several online stores" />
    <bpmn:parallelGateway id="split" name="Send messages while order is processed" />
    <bpmn:task id="send_msgs" name="Send messages to several of your friends to build the house" />
    <bpmn:task id="send_invites" name="Send invitations for a tree house party" />
    <bpmn:task id="attendee_list" name="Create the list of people that attend the party" />
    <bpmn:endEvent id="done" name="House built" />
    <bpmn:task id="draft" name="Send you back a draft" />
    <bpmn:task id="process_order" name="Process the order" />
    <bpmn:task id="build" name="Build the house" />
    <bpmn:parallelGateway id="join" name="Work finished" />
    <bpmn:sequenceFlow id="f-start-collect" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-send_req" sourceRef="collect" targetRef="send_req" />
    <bpmn:sequenceFlow id="f-send_req-draft" sourceRef="send_req" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-refine" sourceRef="draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-more" sourceRef="refine" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-refine" name="yes" sourceRef="more" targetRef="refine" />
    <bpmn:sequenceFlow id="f-more-create_list" name="no" sourceRef="more" targetRef="create_list" />
    <bpmn:sequenceFlow id="f-create_list-order" sourceRef="create_list" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-split" sourceRef="order" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-process_order" sourceRef="split" targetRef="process_order" />
    <bpmn:sequenceFlow id="f-split-send_msgs" sourceRef="split" targetRef="send_msgs" />
    <bpmn:sequenceFlow id="f-send_msgs-build" sourceRef="send_msgs" targetRef="build" />
    <bpmn:sequenceFlow id="f-process_order-join" sourceRef="process_order" targetRef="join" />
    <bpmn:sequenceFlow id="f-build-join" sourceRef="build" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-send_invites" sourceRef="join" targetRef="send_invites" />
    <bpmn:sequenceFlow id="f-send_invites-attendee_list" sourceRef="send_invites" targetRef="attendee_list" />
    <bpmn:sequenceFlow id="f-attendee_list-done" sourceRef="attendee_list" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
