tok 1.0 "Building a House"

pool org "Building a House"
  lane you "You"
    start start "Start"
    task collect "Collect your requirements"
    task send_req "Send them to a tree house architect"
    task refine "Refine with additional requirements"
    xor more "More refinement needed?"
    task create_list "Create the list of needed materials from the plan"
    task order "Order them from several online stores"
    and split "Send messages while order is processed"
    task send_msgs "Send messages to several of your friends to build the house"
    task send_invites "Send invitations for a tree house party"
    task attendee_list "Create the list of people that attend the party"
    end done "House built"
  lane architect "Tree house architect"
    task draft "Send you back a draft"
  lane stores "Online stores"
    task process_order "Process the order"
  lane friends "Friends"
    task build "Build the house"
    and join "Work finished"

flow start -> collect -> send_req -> draft -> refine -> more
flow more -> refine "yes"
flow more -> create_list "no"
flow create_list -> order -> split
flow split -> process_order
flow split -> send_msgs
flow send_msgs -> build
flow process_order -> join
flow build -> join
flow join -> send_invites -> attendee_list -> done
