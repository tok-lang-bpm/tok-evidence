tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool inspection "Inspection"
  lane inspector "Inspector"
    start begin "Inspection needed"
    task enter_type "Enter type of machine"
    task enter_serial "Enter serial number"
    task input_values "Input values"
    task press_buttons "Press buttons"
    task answer_additional "Answer additional questions"
    xor additional "Additional questions needed?"
    end done "Inspection done"
    end skipped "Inspection done without additional questions"
  lane machine "Machine"
    task collect_values "Collect values from machine"
    task show_values "Show values"

flow begin -> enter_type -> enter_serial -> input_values -> press_buttons
flow press_buttons -> collect_values -> show_values -> additional
flow additional -> answer_additional "yes"
flow additional -> skipped "no"
flow answer_additional -> done
