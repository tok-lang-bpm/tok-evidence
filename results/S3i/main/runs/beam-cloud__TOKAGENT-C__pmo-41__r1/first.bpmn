<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="inspection" name="Inspection" processRef="inspection-process" />
  </bpmn:collaboration>
  <bpmn:process id="inspection-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="inspection-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_serial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press_buttons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer_additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>skipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="machine" name="Machine">
        <bpmn:flowNodeRef>collect_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show_values</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inspection needed" />
    <bpmn:task id="enter_type" name="Enter type of machine" />
    <bpmn:task id="enter_serial" name="Enter serial number" />
    <bpmn:task id="input_values" name="Input values" />
    <bpmn:task id="press_buttons" name="Press buttons" />
    <bpmn:task id="answer_additional" name="Answer additional questions" />
    <bpmn:exclusiveGateway id="additional" name="Additional questions needed?" default="f-additional-skipped" />
    <bpmn:endEvent id="done" name="Inspection done" />
    <bpmn:endEvent id="skipped" name="Inspection done without additional questions" />
    <bpmn:task id="collect_values" name="Collect values from machine" />
    <bpmn:task id="show_values" name="Show values" />
    <bpmn:sequenceFlow id="f-begin-enter_type" sourceRef="begin" targetRef="enter_type" />
    <bpmn:sequenceFlow id="f-enter_type-enter_serial" sourceRef="enter_type" targetRef="enter_serial" />
    <bpmn:sequenceFlow id="f-enter_serial-input_values" sourceRef="enter_serial" targetRef="input_values" />
    <bpmn:sequenceFlow id="f-input_values-press_buttons" sourceRef="input_values" targetRef="press_buttons" />
    <bpmn:sequenceFlow id="f-press_buttons-collect_values" sourceRef="press_buttons" targetRef="collect_values" />
    <bpmn:sequenceFlow id="f-collect_values-show_values" sourceRef="collect_values" targetRef="show_values" />
    <bpmn:sequenceFlow id="f-show_values-additional" sourceRef="show_values" targetRef="additional" />
    <bpmn:sequenceFlow id="f-additional-answer_additional" name="yes" sourceRef="additional" targetRef="answer_additional" />
    <bpmn:sequenceFlow id="f-additional-skipped" name="no" sourceRef="additional" targetRef="skipped" />
    <bpmn:sequenceFlow id="f-answer_additional-done" sourceRef="answer_additional" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
