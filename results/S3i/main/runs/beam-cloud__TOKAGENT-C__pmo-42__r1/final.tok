tok 1.0 "Service for Your Fridge"

pool service "Service for Your Fridge"
  lane customer "Customer"
    start noises "Fridge produces strange noises"
    task describe "Describe the symptoms"
    task send "Send symptoms and fridge type"
    task confirm "Confirm fridge is OK"
    xor rate "Rate the service facility?"
    task rating "Rate the service facility"
    end completed "Service completed"
  lane central "Central fridge service center"
    task select "Select a local service facility"
  lane facility "Service facility"
    task appointment "Make an appointment"
    task arrive "Arrive at a random time"
    xor parts "Additional parts needed?"
    task leave "Leave without repairing the fridge"
    task repair "Repair the fridge"
    end not_repaired "Fridge not repaired"

flow noises -> describe -> send -> select -> appointment -> arrive -> parts
flow parts -> leave "yes"
flow parts -> repair "no"
flow leave -> not_repaired
flow repair -> confirm
flow confirm -> rate
flow rate -> rating "yes"
flow rate -> completed "no"
flow rating -> completed
