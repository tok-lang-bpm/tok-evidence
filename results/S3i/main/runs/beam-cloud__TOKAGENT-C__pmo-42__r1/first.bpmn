<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="service" name="Service for Your Fridge" processRef="service-process" />
  </bpmn:collaboration>
  <bpmn:process id="service-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="service-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>noises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Service facility">
        <bpmn:flowNodeRef>appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_repaired</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noises" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send symptoms and fridge type" />
    <bpmn:task id="confirm" name="Confirm fridge is OK" />
    <bpmn:exclusiveGateway id="rate" name="Rate the service facility?" default="f-rate-completed" />
    <bpmn:task id="rating" name="Rate the service facility" />
    <bpmn:endEvent id="completed" name="Service completed" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:task id="appointment" name="Make an appointment" />
    <bpmn:task id="arrive" name="Arrive at a random time" />
    <bpmn:exclusiveGateway id="parts" name="Additional parts needed?" />
    <bpmn:task id="leave" name="Leave without repairing the fridge" />
    <bpmn:task id="repair" name="Repair the fridge" />
    <bpmn:endEvent id="not_repaired" name="Fridge not repaired" />
    <bpmn:sequenceFlow id="f-noises-describe" sourceRef="noises" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appointment" sourceRef="select" targetRef="appointment" />
    <bpmn:sequenceFlow id="f-appointment-arrive" sourceRef="appointment" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-parts" sourceRef="arrive" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-leave" name="yes" sourceRef="parts" targetRef="leave" />
    <bpmn:sequenceFlow id="f-parts-repair" name="no" sourceRef="parts" targetRef="repair" />
    <bpmn:sequenceFlow id="f-leave-not_repaired" sourceRef="leave" targetRef="not_repaired" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-rating" name="yes" sourceRef="rate" targetRef="rating" />
    <bpmn:sequenceFlow id="f-rate-completed" name="no" sourceRef="rate" targetRef="completed" />
    <bpmn:sequenceFlow id="f-rating-completed" sourceRef="rating" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
