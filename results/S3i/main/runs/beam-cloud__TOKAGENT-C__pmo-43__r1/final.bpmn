<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car Service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Car service" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Car Service" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>necessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notregistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>attended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="necessary" name="Service is necessary" />
    <bpmn:task id="check" name="Check if your car is still registered" />
    <bpmn:exclusiveGateway id="registered" name="Car still registered?" />
    <bpmn:task id="notify" name="Notify you" />
    <bpmn:task id="fine" name="Fine you after 30 days" />
    <bpmn:endEvent id="notregistered" name="Car not registered" />
    <bpmn:endEvent id="fined" name="You are fined" />
    <bpmn:exclusiveGateway id="attended" name="Go to the service?" />
    <bpmn:task id="updates" name="Get status updates via email" />
    <bpmn:task id="pay" name="Pay through the app" />
    <bpmn:task id="problems" name="Enter the problems of your car for reference" />
    <bpmn:task id="repair" name="Enter that the repair was successful and you got your Pickerl" />
    <bpmn:task id="next" name="Enter the time for your next service" />
    <bpmn:endEvent id="done" name="Service completed" />
    <bpmn:sequenceFlow id="f-necessary-check" sourceRef="necessary" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-registered" sourceRef="check" targetRef="registered" />
    <bpmn:sequenceFlow id="f-registered-notify" name="yes" sourceRef="registered" targetRef="notify" />
    <bpmn:sequenceFlow id="f-registered-notregistered" name="no" sourceRef="registered" targetRef="notregistered" />
    <bpmn:sequenceFlow id="f-notify-attended" sourceRef="notify" targetRef="attended" />
    <bpmn:sequenceFlow id="f-attended-problems" name="yes" sourceRef="attended" targetRef="problems" />
    <bpmn:sequenceFlow id="f-attended-fine" name="no" sourceRef="attended" targetRef="fine" />
    <bpmn:sequenceFlow id="f-fine-fined" sourceRef="fine" targetRef="fined" />
    <bpmn:sequenceFlow id="f-problems-updates" sourceRef="problems" targetRef="updates" />
    <bpmn:sequenceFlow id="f-updates-pay" sourceRef="updates" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-repair" sourceRef="pay" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-next" sourceRef="repair" targetRef="next" />
    <bpmn:sequenceFlow id="f-next-done" sourceRef="next" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
