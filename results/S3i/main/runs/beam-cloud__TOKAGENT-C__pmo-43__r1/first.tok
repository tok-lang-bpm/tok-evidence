tok 1.0 "Car Service"

pool organisation "Car service"
  lane system "System"
    start necessary "Service is necessary"
    task check "Check if your car is still registered"
    xor registered "Car still registered?"
    task notify "Notify you"
    task fine "Fine you after 30 days"
    end notregistered "Car not registered"
    end fined "You are fined"
  lane customer "Customer"
    xor attended "Go to the service?"
    task updates "Get status updates via email"
    task pay "Pay through the app"
  lane mechanic "Mechanic"
    task problems "Enter the problems of your car for reference"
    task repair "Enter that the repair was successful and you got your Pickerl"
    task next "Enter the time for your next service"
    end done "Service completed"

flow necessary -> check -> registered
flow registered -> notify "yes"
flow registered -> notregistered "no"
flow notify -> attended
flow attended -> problems "yes"
flow attended -> fine "no"
flow fine -> fined
flow problems -> updates -> pay -> repair -> next -> done