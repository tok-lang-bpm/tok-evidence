<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seller" name="Robotic Burger Seller" processRef="seller-process" />
  </bpmn:collaboration>
  <bpmn:process id="seller-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="seller-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>order_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order_needed" name="Order needed" />
    <bpmn:task id="receive_order" name="Receive the order" />
    <bpmn:task id="ask_menu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="menu_choice" name="Menu or just the burger?" default="f-menu_choice-prepare_burger" />
    <bpmn:parallelGateway id="fork" name="Prepare drink and ask for a side order" />
    <bpmn:task id="prepare_drink" name="Prepare the drink" />
    <bpmn:task id="ask_side" name="Ask if you want fries or wedges" />
    <bpmn:exclusiveGateway id="side_choice" name="Fries or wedges?" default="f-side_choice-prepare_wedges" />
    <bpmn:task id="prepare_fries" name="Prepare the fries" />
    <bpmn:task id="prepare_wedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="side_join" name="Side order complete" />
    <bpmn:parallelGateway id="ready" name="Drink and side order ready" />
    <bpmn:task id="prepare_burger" name="Prepare the burger" />
    <bpmn:task id="deliver" name="Deliver the order via a conveyor belt" />
    <bpmn:endEvent id="order_delivered" name="Order delivered" />
    <bpmn:sequenceFlow id="f-order_needed-receive_order" sourceRef="order_needed" targetRef="receive_order" />
    <bpmn:sequenceFlow id="f-receive_order-ask_menu" sourceRef="receive_order" targetRef="ask_menu" />
    <bpmn:sequenceFlow id="f-ask_menu-menu_choice" sourceRef="ask_menu" targetRef="menu_choice" />
    <bpmn:sequenceFlow id="f-menu_choice-fork" name="menu" sourceRef="menu_choice" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-prepare_drink" sourceRef="fork" targetRef="prepare_drink" />
    <bpmn:sequenceFlow id="f-fork-ask_side" sourceRef="fork" targetRef="ask_side" />
    <bpmn:sequenceFlow id="f-ask_side-side_choice" sourceRef="ask_side" targetRef="side_choice" />
    <bpmn:sequenceFlow id="f-side_choice-prepare_fries" name="fries" sourceRef="side_choice" targetRef="prepare_fries" />
    <bpmn:sequenceFlow id="f-side_choice-prepare_wedges" name="wedges" sourceRef="side_choice" targetRef="prepare_wedges" />
    <bpmn:sequenceFlow id="f-prepare_fries-side_join" sourceRef="prepare_fries" targetRef="side_join" />
    <bpmn:sequenceFlow id="f-prepare_wedges-side_join" sourceRef="prepare_wedges" targetRef="side_join" />
    <bpmn:sequenceFlow id="f-side_join-ready" sourceRef="side_join" targetRef="ready" />
    <bpmn:sequenceFlow id="f-prepare_drink-ready" sourceRef="prepare_drink" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-prepare_burger" sourceRef="ready" targetRef="prepare_burger" />
    <bpmn:sequenceFlow id="f-menu_choice-prepare_burger" name="just the burger" sourceRef="menu_choice" targetRef="prepare_burger" />
    <bpmn:sequenceFlow id="f-prepare_burger-deliver" sourceRef="prepare_burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-order_delivered" sourceRef="deliver" targetRef="order_delivered" />
  </bpmn:process>
</bpmn:definitions>
