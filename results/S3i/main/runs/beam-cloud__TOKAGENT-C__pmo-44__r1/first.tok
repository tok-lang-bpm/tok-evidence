tok 1.0 "Robotic Burger Seller near the University of Vienna"

pool seller "Robotic Burger Seller"
  lane robot "Robot"
    start order_needed "Order needed"
    task receive_order "Receive the order"
    task ask_menu "Ask whether the customer wants a menu or just the burger"
    xor menu_choice "Menu or just the burger?"
    and fork "Prepare drink and ask for a side order"
    task prepare_drink "Prepare the drink"
    task ask_side "Ask if you want fries or wedges"
    xor side_choice "Fries or wedges?"
    task prepare_fries "Prepare the fries"
    task prepare_wedges "Prepare the wedges"
    xor side_join "Side order complete"
    and ready "Drink and side order ready"
    task prepare_burger "Prepare the burger"
    task deliver "Deliver the order via a conveyor belt"
    end order_delivered "Order delivered"

flow order_needed -> receive_order -> ask_menu -> menu_choice
flow menu_choice -> fork "menu"
flow fork -> prepare_drink
flow fork -> ask_side
flow ask_side -> side_choice
flow side_choice -> prepare_fries "fries"
flow side_choice -> prepare_wedges "wedges" default
flow prepare_fries -> side_join
flow prepare_wedges -> side_join
flow side_join -> ready
flow prepare_drink -> ready
flow ready -> prepare_burger
flow menu_choice -> prepare_burger "just the burger" default
flow prepare_burger -> deliver -> order_delivered
