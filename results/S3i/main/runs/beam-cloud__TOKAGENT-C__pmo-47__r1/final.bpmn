<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="sports" name="Sports Institute" processRef="sports-process" />
  </bpmn:collaboration>
  <bpmn:process id="sports-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="sports-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_univ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no_slots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>tell_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start registration" />
    <bpmn:task id="select_one" name="Select one" />
    <bpmn:task id="check_account" name="Check if already have an account" />
    <bpmn:task id="check_univ" name="Check whether registered at an eligible university" />
    <bpmn:task id="register_account" name="Register your account" />
    <bpmn:task id="request_activation" name="Request an activation" />
    <bpmn:task id="wait_response" name="Wait for a response" />
    <bpmn:task id="login" name="Log into it" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete" name="Complete the registration for the course" />
    <bpmn:task id="provide_payment" name="Provide the payment information" />
    <bpmn:task id="receive_ticket" name="Receive a course ticket" />
    <bpmn:exclusiveGateway id="has_account" name="Already have an account?" />
    <bpmn:exclusiveGateway id="eligible" name="Registered at an eligible university?" />
    <bpmn:exclusiveGateway id="account_ready" name="Account ready?" />
    <bpmn:endEvent id="done" name="Registration complete" />
    <bpmn:endEvent id="no_slots" name="No slots available" />
    <bpmn:task id="tell_courses" name="Tell the courses and dates" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" />
    <bpmn:sequenceFlow id="f-start-slots" sourceRef="start" targetRef="slots" />
    <bpmn:sequenceFlow id="f-slots-tell_courses" name="yes" sourceRef="slots" targetRef="tell_courses" />
    <bpmn:sequenceFlow id="f-slots-no_slots" name="no" sourceRef="slots" targetRef="no_slots" />
    <bpmn:sequenceFlow id="f-tell_courses-select_one" sourceRef="tell_courses" targetRef="select_one" />
    <bpmn:sequenceFlow id="f-select_one-check_account" sourceRef="select_one" targetRef="check_account" />
    <bpmn:sequenceFlow id="f-check_account-has_account" sourceRef="check_account" targetRef="has_account" />
    <bpmn:sequenceFlow id="f-has_account-account_ready" name="yes" sourceRef="has_account" targetRef="account_ready" />
    <bpmn:sequenceFlow id="f-has_account-check_univ" name="no" sourceRef="has_account" targetRef="check_univ" />
    <bpmn:sequenceFlow id="f-check_univ-eligible" sourceRef="check_univ" targetRef="eligible" />
    <bpmn:sequenceFlow id="f-eligible-register_account" name="yes" sourceRef="eligible" targetRef="register_account" />
    <bpmn:sequenceFlow id="f-eligible-request_activation" name="no" sourceRef="eligible" targetRef="request_activation" />
    <bpmn:sequenceFlow id="f-register_account-account_ready" sourceRef="register_account" targetRef="account_ready" />
    <bpmn:sequenceFlow id="f-request_activation-wait_response" sourceRef="request_activation" targetRef="wait_response" />
    <bpmn:sequenceFlow id="f-wait_response-account_ready" sourceRef="wait_response" targetRef="account_ready" />
    <bpmn:sequenceFlow id="f-account_ready-login" sourceRef="account_ready" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-tweet" sourceRef="login" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-complete" sourceRef="tweet" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-provide_payment" sourceRef="complete" targetRef="provide_payment" />
    <bpmn:sequenceFlow id="f-provide_payment-receive_ticket" sourceRef="provide_payment" targetRef="receive_ticket" />
    <bpmn:sequenceFlow id="f-receive_ticket-done" sourceRef="receive_ticket" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
