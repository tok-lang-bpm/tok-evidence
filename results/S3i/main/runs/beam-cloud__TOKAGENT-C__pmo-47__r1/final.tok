tok 1.0 "New Application for Registering for an USI course"

pool sports "Sports Institute"
  lane applicant "Applicant"
    start start "Start registration"
    task select_one "Select one"
    task check_account "Check if already have an account"
    task check_univ "Check whether registered at an eligible university"
    task register_account "Register your account"
    task request_activation "Request an activation"
    task wait_response "Wait for a response"
    task login "Log into it"
    task tweet "Tweet to friends"
    task complete "Complete the registration for the course"
    task provide_payment "Provide the payment information"
    task receive_ticket "Receive a course ticket"
    xor has_account "Already have an account?"
    xor eligible "Registered at an eligible university?"
    xor account_ready "Account ready?"
    end done "Registration complete"
    end no_slots "No slots available"
  lane system "System"
    task tell_courses "Tell the courses and dates"
    xor slots "Slots free?"
flow start -> slots
flow slots -> tell_courses "yes"
flow slots -> no_slots "no"
flow tell_courses -> select_one
flow select_one -> check_account
flow check_account -> has_account
flow has_account -> account_ready "yes"
flow has_account -> check_univ "no"
flow check_univ -> eligible
flow eligible -> register_account "yes"
flow eligible -> request_activation "no"
flow register_account -> account_ready
flow request_activation -> wait_response
flow wait_response -> account_ready
flow account_ready -> login
flow login -> tweet
flow tweet -> complete
flow complete -> provide_payment
flow provide_payment -> receive_ticket
flow receive_ticket -> done
