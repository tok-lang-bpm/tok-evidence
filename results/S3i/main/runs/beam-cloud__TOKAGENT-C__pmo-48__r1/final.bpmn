<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="App For Participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="participant" name="Participant">
        <bpmn:flowNodeRef>wanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getnumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromhome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fromwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rundrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runnight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rundone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivetime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wanted" name="Want to participate" />
    <bpmn:task id="select" name="Select a starting block" />
    <bpmn:task id="run5" name="Run for 5km" />
    <bpmn:task id="measure" name="Measure the time" />
    <bpmn:exclusiveGateway id="enough" name="Less than 25 minutes?" default="f-enough-train" />
    <bpmn:task id="train" name="Train" />
    <bpmn:task id="getnumber" name="Get starting number" />
    <bpmn:exclusiveGateway id="route" name="More than one hour left?" default="f-route-fromwork" />
    <bpmn:task id="fromhome" name="Go there from home" />
    <bpmn:task id="fromwork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="arrived" />
    <bpmn:parallelGateway id="rundrink" />
    <bpmn:task id="runnight" name="Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="rundone" />
    <bpmn:task id="receivetime" name="Receive final running time" />
    <bpmn:endEvent id="done" name="Final running time received" />
    <bpmn:sequenceFlow id="f-wanted-select" sourceRef="wanted" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-run5" sourceRef="select" targetRef="run5" />
    <bpmn:sequenceFlow id="f-run5-measure" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f-measure-enough" sourceRef="measure" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-getnumber" name="yes" sourceRef="enough" targetRef="getnumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">minutes &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough-train" name="no" sourceRef="enough" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-run5" sourceRef="train" targetRef="run5" />
    <bpmn:sequenceFlow id="f-getnumber-route" sourceRef="getnumber" targetRef="route" />
    <bpmn:sequenceFlow id="f-route-fromhome" name="yes" sourceRef="route" targetRef="fromhome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hours &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-route-fromwork" name="no" sourceRef="route" targetRef="fromwork" />
    <bpmn:sequenceFlow id="f-fromhome-arrived" sourceRef="fromhome" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-fromwork-arrived" sourceRef="fromwork" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-arrived-rundrink" sourceRef="arrived" targetRef="rundrink" />
    <bpmn:sequenceFlow id="f-rundrink-runnight" sourceRef="rundrink" targetRef="runnight" />
    <bpmn:sequenceFlow id="f-rundrink-drink" sourceRef="rundrink" targetRef="drink" />
    <bpmn:sequenceFlow id="f-runnight-rundone" sourceRef="runnight" targetRef="rundone" />
    <bpmn:sequenceFlow id="f-drink-rundone" sourceRef="drink" targetRef="rundone" />
    <bpmn:sequenceFlow id="f-rundone-receivetime" sourceRef="rundone" targetRef="receivetime" />
    <bpmn:sequenceFlow id="f-receivetime-done" sourceRef="receivetime" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
