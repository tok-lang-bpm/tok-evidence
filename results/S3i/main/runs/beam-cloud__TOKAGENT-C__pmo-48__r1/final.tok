tok 1.0 "App For Participating at the Vienna Night Run"

pool organisation "Organisation"
  lane participant "Participant"
    start wanted "Want to participate"
    task select "Select a starting block"
    task run5 "Run for 5km"
    task measure "Measure the time"
    xor enough "Less than 25 minutes?"
    task train "Train"
    task getnumber "Get starting number"
    xor route "More than one hour left?"
    task fromhome "Go there from home"
    task fromwork "Leave directly from work"
    xor arrived
    and rundrink
    task runnight "Run"
    task drink "Drink"
    and rundone
    task receivetime "Receive final running time"
    end done "Final running time received"

flow wanted -> select -> run5 -> measure -> enough
flow enough -> getnumber "yes" when="minutes < 25"
flow enough -> train "no" default
flow train -> run5
flow getnumber -> route
flow route -> fromhome "yes" when="hours > 1"
flow route -> fromwork "no" default
flow fromhome -> arrived
flow fromwork -> arrived
flow arrived -> rundrink
flow rundrink -> runnight
flow rundrink -> drink
flow runnight -> rundone
flow drink -> rundone
flow rundone -> receivetime -> done
