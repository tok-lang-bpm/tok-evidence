<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Catheter insertion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Catheter insertion" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterilegel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positionprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positionpatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkblood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removesyringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>longaxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shortaxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirechecked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wiregood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removegw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkcath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="prepare" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="sterile" name="Get in sterile clothes" />
    <bpmn:task id="clean" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="configure" name="Configure the ultrasound" />
    <bpmn:task id="gel" name="Put gel in the probe" />
    <bpmn:task id="cover" name="Cover the probe" />
    <bpmn:task id="sterilegel" name="Put the sterile gel" />
    <bpmn:task id="positionprobe" name="Position the probe" />
    <bpmn:task id="positionpatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="identify" name="Identify vein?" />
    <bpmn:task id="anatomic" name="Anatomic identification" />
    <bpmn:task id="doppler" name="Doppler identification" />
    <bpmn:task id="compression" name="Compression identification" />
    <bpmn:exclusiveGateway id="identified" name="Vein identified" />
    <bpmn:task id="anesthetize" name="Anesthetize the patient" />
    <bpmn:task id="puncture" name="Puncture the patient" />
    <bpmn:task id="checkblood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="blood" name="Blood return correct?" />
    <bpmn:task id="drop" name="Drop the probe" />
    <bpmn:task id="removesyringe" name="Remove the syringe" />
    <bpmn:task id="guidewire" name="Install the guidewire" />
    <bpmn:task id="trocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="wirecheck" name="Check wire axis?" />
    <bpmn:task id="longaxis" name="Check the wire in the long axis" />
    <bpmn:task id="shortaxis" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="wirechecked" name="Wire checked" />
    <bpmn:task id="checkpos" name="Check if the wire is in good position" />
    <bpmn:exclusiveGateway id="wiregood" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="removegw" name="Remove the guidewire" />
    <bpmn:task id="verify" name="Verify the flow and the reflow" />
    <bpmn:task id="checkcath" name="Check the catheter position" />
    <bpmn:endEvent id="done" name="End" />
    <bpmn:sequenceFlow id="f-start-prepare" sourceRef="start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-wash" sourceRef="prepare" targetRef="wash" />
    <bpmn:sequenceFlow id="f-wash-sterile" sourceRef="wash" targetRef="sterile" />
    <bpmn:sequenceFlow id="f-sterile-clean" sourceRef="sterile" targetRef="clean" />
    <bpmn:sequenceFlow id="f-clean-drape" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-configure" sourceRef="drape" targetRef="configure" />
    <bpmn:sequenceFlow id="f-configure-gel" sourceRef="configure" targetRef="gel" />
    <bpmn:sequenceFlow id="f-gel-cover" sourceRef="gel" targetRef="cover" />
    <bpmn:sequenceFlow id="f-cover-sterilegel" sourceRef="cover" targetRef="sterilegel" />
    <bpmn:sequenceFlow id="f-sterilegel-positionprobe" sourceRef="sterilegel" targetRef="positionprobe" />
    <bpmn:sequenceFlow id="f-positionprobe-positionpatient" sourceRef="positionprobe" targetRef="positionpatient" />
    <bpmn:sequenceFlow id="f-positionpatient-identify" sourceRef="positionpatient" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-anatomic" name="anatomic" sourceRef="identify" targetRef="anatomic" />
    <bpmn:sequenceFlow id="f-anatomic-identified" sourceRef="anatomic" targetRef="identified" />
    <bpmn:sequenceFlow id="f-identify-doppler" name="doppler" sourceRef="identify" targetRef="doppler" />
    <bpmn:sequenceFlow id="f-doppler-identified" sourceRef="doppler" targetRef="identified" />
    <bpmn:sequenceFlow id="f-identify-compression" name="compression" sourceRef="identify" targetRef="compression" />
    <bpmn:sequenceFlow id="f-compression-identified" sourceRef="compression" targetRef="identified" />
    <bpmn:sequenceFlow id="f-identified-anesthetize" sourceRef="identified" targetRef="anesthetize" />
    <bpmn:sequenceFlow id="f-anesthetize-puncture" sourceRef="anesthetize" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-puncture-checkblood" sourceRef="puncture" targetRef="checkblood" />
    <bpmn:sequenceFlow id="f-checkblood-blood" sourceRef="checkblood" targetRef="blood" />
    <bpmn:sequenceFlow id="f-blood-puncture" name="not correct" sourceRef="blood" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-blood-drop" name="correct" sourceRef="blood" targetRef="drop" />
    <bpmn:sequenceFlow id="f-drop-removesyringe" sourceRef="drop" targetRef="removesyringe" />
    <bpmn:sequenceFlow id="f-removesyringe-guidewire" sourceRef="removesyringe" targetRef="guidewire" />
    <bpmn:sequenceFlow id="f-guidewire-trocar" sourceRef="guidewire" targetRef="trocar" />
    <bpmn:sequenceFlow id="f-trocar-wirecheck" sourceRef="trocar" targetRef="wirecheck" />
    <bpmn:sequenceFlow id="f-wirecheck-longaxis" name="long axis" sourceRef="wirecheck" targetRef="longaxis" />
    <bpmn:sequenceFlow id="f-longaxis-wirechecked" sourceRef="longaxis" targetRef="wirechecked" />
    <bpmn:sequenceFlow id="f-wirecheck-shortaxis" name="short axis" sourceRef="wirecheck" targetRef="shortaxis" />
    <bpmn:sequenceFlow id="f-shortaxis-wirechecked" sourceRef="shortaxis" targetRef="wirechecked" />
    <bpmn:sequenceFlow id="f-wirechecked-checkpos" sourceRef="wirechecked" targetRef="checkpos" />
    <bpmn:sequenceFlow id="f-checkpos-wiregood" sourceRef="checkpos" targetRef="wiregood" />
    <bpmn:sequenceFlow id="f-wiregood-puncture" name="not in good position" sourceRef="wiregood" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-wiregood-widen" name="in good position" sourceRef="wiregood" targetRef="widen" />
    <bpmn:sequenceFlow id="f-widen-advance" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f-advance-removegw" sourceRef="advance" targetRef="removegw" />
    <bpmn:sequenceFlow id="f-removegw-verify" sourceRef="removegw" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-checkcath" sourceRef="verify" targetRef="checkcath" />
    <bpmn:sequenceFlow id="f-checkcath-done" sourceRef="checkcath" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
