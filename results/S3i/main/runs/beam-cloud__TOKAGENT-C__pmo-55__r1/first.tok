tok 1.0 "Catheter insertion"

pool org "Organisation"
  lane doctor "Doctor"
    start start "Start"
    task prepare "Prepare the implements"
    task wash "Wash the hands"
    task sterile "Get in sterile clothes"
    task clean "Clean the puncture area"
    task drape "Drape the puncture zone"
    task configure "Configure the ultrasound"
    task gel "Put gel in the probe"
    task cover "Cover the probe"
    task sterilegel "Put the sterile gel"
    task positionprobe "Position the probe"
    task positionpatient "Position the patient"
    xor identify "Identify vein?"
    task anatomic "Anatomic identification"
    task doppler "Doppler identification"
    task compression "Compression identification"
    xor identified "Vein identified"
    task anesthetize "Anesthetize the patient"
    task puncture "Puncture the patient"
    task checkblood "Check the blood return"
    xor blood "Blood return correct?"
    task drop "Drop the probe"
    task removesyringe "Remove the syringe"
    task guidewire "Install the guidewire"
    task trocar "Remove the trocar"
    xor wirecheck "Check wire axis?"
    task longaxis "Check the wire in the long axis"
    task shortaxis "Check the wire in the short axis"
    xor wirechecked "Wire checked"
    task checkpos "Check if the wire is in good position"
    xor wiregood "Wire in good position?"
    task widen "Widen the pathway"
    task advance "Advance the catheter"
    task removegw "Remove the guidewire"
    task verify "Verify the flow and the reflow"
    task checkcath "Check the catheter position"
    end done "End"

flow start -> prepare -> wash -> sterile -> clean -> drape -> configure -> gel -> cover -> sterilegel -> positionprobe -> positionpatient -> identify
flow identify -> anatomic -> identified
flow identify -> doppler -> identified
flow identify -> compression -> identified
flow identified -> anesthetize -> puncture -> checkblood -> blood
flow blood -> puncture "not correct"
flow blood -> drop "correct"
flow drop -> removesyringe -> guidewire -> trocar -> wirecheck
flow wirecheck -> longaxis -> wirechecked
flow wirecheck -> shortaxis -> wirechecked
flow wirechecked -> checkpos -> wiregood
flow wiregood -> puncture "not in good position"
flow wiregood -> widen "in good position"
flow widen -> advance -> removegw -> verify -> checkcath -> done
