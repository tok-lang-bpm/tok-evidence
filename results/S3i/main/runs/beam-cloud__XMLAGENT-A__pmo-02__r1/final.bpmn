<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create_jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_fmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify need for new hire" />
    <bpmn:task id="create_jd" name="Create job description" />
    <bpmn:task id="post" name="Post job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interviews" />
    <bpmn:task id="select" name="Select candidates" />
    <bpmn:task id="invite" name="Invite selected candidates for interviews" />
    <bpmn:exclusiveGateway id="gw_fmt" name="In-person or virtual?" default="f_inperson" />
    <bpmn:task id="inperson" name="Conduct in-person interviews" />
    <bpmn:task id="virtual" name="Conduct virtual interviews" />
    <bpmn:exclusiveGateway id="join_fmt" />
    <bpmn:task id="choose" name="Choose candidate" />
    <bpmn:task id="extend" name="Extend offer" />
    <bpmn:exclusiveGateway id="gw_neg" name="Salary negotiations necessary?" default="f_noneg" />
    <bpmn:task id="negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="join_neg" />
    <bpmn:task id="accept" name="Accept offer" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Conduct orientation" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:endEvent id="end" name="New hire fully integrated" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="create_jd" />
    <bpmn:sequenceFlow id="f3" sourceRef="create_jd" targetRef="post" />
    <bpmn:sequenceFlow id="f4" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f5" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f6" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f7" sourceRef="phone" targetRef="select" />
    <bpmn:sequenceFlow id="f8" sourceRef="select" targetRef="invite" />
    <bpmn:sequenceFlow id="f9" sourceRef="invite" targetRef="gw_fmt" />
    <bpmn:sequenceFlow id="f_inperson" name="In-person" sourceRef="gw_fmt" targetRef="inperson" />
    <bpmn:sequenceFlow id="f_virtual" name="Virtual" sourceRef="gw_fmt" targetRef="virtual">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">preference = "virtual"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="inperson" targetRef="join_fmt" />
    <bpmn:sequenceFlow id="f11" sourceRef="virtual" targetRef="join_fmt" />
    <bpmn:sequenceFlow id="f12" sourceRef="join_fmt" targetRef="choose" />
    <bpmn:sequenceFlow id="f13" sourceRef="choose" targetRef="extend" />
    <bpmn:sequenceFlow id="f14" sourceRef="extend" targetRef="gw_neg" />
    <bpmn:sequenceFlow id="f_neg" name="Yes" sourceRef="gw_neg" targetRef="negotiate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsNegotiation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_noneg" name="No" sourceRef="gw_neg" targetRef="join_neg" />
    <bpmn:sequenceFlow id="f15" sourceRef="negotiate" targetRef="join_neg" />
    <bpmn:sequenceFlow id="f16" sourceRef="join_neg" targetRef="accept" />
    <bpmn:sequenceFlow id="f17" sourceRef="accept" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f18" sourceRef="paperwork" targetRef="orientation" />
    <bpmn:sequenceFlow id="f19" sourceRef="orientation" targetRef="training" />
    <bpmn:sequenceFlow id="f20" sourceRef="training" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
