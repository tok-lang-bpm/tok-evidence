<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org-pool" name="Organisation" processRef="org-process" />
    <bpmn:participant id="supplier-pool" name="Suppliers" />
    <bpmn:messageFlow id="mf-rfp" sourceRef="Task_IssueRFP" targetRef="supplier-pool" />
    <bpmn:messageFlow id="mf-responses" sourceRef="supplier-pool" targetRef="Task_ReceiveResponses" />
    <bpmn:messageFlow id="mf-contract" sourceRef="Task_Sign" targetRef="supplier-pool" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="lane-company" name="Company">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveResponses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Need for new supplier identified" />
    <bpmn:task id="Task_Identify" name="Identify need for new supplier" />
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)" />
    <bpmn:task id="Task_ReceiveResponses" name="Receive responses from suppliers" />
    <bpmn:task id="Task_Evaluate" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="Gw_SiteVisits" name="Conduct site visits or interviews?" default="Flow_NoVisits" />
    <bpmn:task id="Task_SiteVisits" name="Conduct site visits or interviews" />
    <bpmn:exclusiveGateway id="Gw_MergeVisits" name="Visits completed" />
    <bpmn:task id="Task_SelectSupplier" name="Select supplier" />
    <bpmn:task id="Task_Negotiate" name="Negotiate contract terms" />
    <bpmn:task id="Task_Sign" name="Sign contract" />
    <bpmn:task id="Task_Onboard" name="Onboard supplier" />
    <bpmn:endEvent id="EndEvent_1" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Identify" targetRef="Task_IssueRFP" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveResponses" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReceiveResponses" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Evaluate" targetRef="Gw_SiteVisits" />
    <bpmn:sequenceFlow id="Flow_YesVisits" name="yes" sourceRef="Gw_SiteVisits" targetRef="Task_SiteVisits" />
    <bpmn:sequenceFlow id="Flow_NoVisits" name="no" sourceRef="Gw_SiteVisits" targetRef="Gw_MergeVisits" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SiteVisits" targetRef="Gw_MergeVisits" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_MergeVisits" targetRef="Task_SelectSupplier" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SelectSupplier" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Negotiate" targetRef="Task_Sign" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Sign" targetRef="Task_Onboard" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Onboard" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
