<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Travel organisation" processRef="travel-process" />
  </bpmn:collaboration>
  <bpmn:process id="travel-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>searchTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideInfoPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwReminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveReminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwRemindersMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeJourney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwFeedbackMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endJourney</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bookingSystem" name="Booking System">
        <bpmn:flowNodeRef>generateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSendMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSendMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="travelCompany" name="Travel Company">
        <bpmn:flowNodeRef>updateInventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="searchTicket" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="selectRoute" name="Select preferred route, date, and time" />
    <bpmn:task id="provideInfoPayment" name="Provide personal information and payment details" />
    <bpmn:task id="generateTicket" name="Generate ticket" />
    <bpmn:exclusiveGateway id="gwSendMethod" name="Send ticket via email or SMS?" />
    <bpmn:task id="sendEmail" name="Send ticket via email" />
    <bpmn:task id="sendSms" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="gwSendMerge" name="Ticket sent" />
    <bpmn:task id="updateInventory" name="Update seat inventory" />
    <bpmn:exclusiveGateway id="gwReminders" name="Receive reminders and instructions?" />
    <bpmn:task id="receiveReminders" name="Receive reminders and instructions for check-in or boarding" />
    <bpmn:exclusiveGateway id="gwRemindersMerge" name="Reminders handled" />
    <bpmn:task id="completeJourney" name="Complete journey" />
    <bpmn:exclusiveGateway id="gwFeedback" name="Provide post-travel feedback or services?" />
    <bpmn:task id="provideFeedback" name="Provide post-travel feedback or services" />
    <bpmn:exclusiveGateway id="gwFeedbackMerge" name="Post-travel handling completed" />
    <bpmn:endEvent id="endJourney" name="Journey completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="searchTicket" />
    <bpmn:sequenceFlow id="f2" sourceRef="searchTicket" targetRef="selectRoute" />
    <bpmn:sequenceFlow id="f3" sourceRef="selectRoute" targetRef="provideInfoPayment" />
    <bpmn:sequenceFlow id="f4" sourceRef="provideInfoPayment" targetRef="generateTicket" />
    <bpmn:sequenceFlow id="f5" sourceRef="generateTicket" targetRef="gwSendMethod" />
    <bpmn:sequenceFlow id="f6" name="email" sourceRef="gwSendMethod" targetRef="sendEmail" />
    <bpmn:sequenceFlow id="f7" name="SMS" sourceRef="gwSendMethod" targetRef="sendSms" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendEmail" targetRef="gwSendMerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendSms" targetRef="gwSendMerge" />
    <bpmn:sequenceFlow id="f10" sourceRef="gwSendMerge" targetRef="updateInventory" />
    <bpmn:sequenceFlow id="f11" sourceRef="updateInventory" targetRef="gwReminders" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="gwReminders" targetRef="receiveReminders" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="gwReminders" targetRef="gwRemindersMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="receiveReminders" targetRef="gwRemindersMerge" />
    <bpmn:sequenceFlow id="f15" sourceRef="gwRemindersMerge" targetRef="completeJourney" />
    <bpmn:sequenceFlow id="f16" sourceRef="completeJourney" targetRef="gwFeedback" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="gwFeedback" targetRef="provideFeedback" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="gwFeedback" targetRef="gwFeedbackMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="provideFeedback" targetRef="gwFeedbackMerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="gwFeedbackMerge" targetRef="endJourney" />
  </bpmn:process>
</bpmn:definitions>
