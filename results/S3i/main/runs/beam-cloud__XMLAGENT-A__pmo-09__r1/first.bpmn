<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="rd" name="R&D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refineDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discardedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identify" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="design" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype" />
    <bpmn:task id="test" name="Test the prototype for functionality, safety, and market potential" />
    <bpmn:task id="feedback" name="Collect feedback from the testing phase" />
    <bpmn:exclusiveGateway id="refineDecision" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="outcomeDecision" name="Prototype approved for further development?" />
    <bpmn:endEvent id="approvedEnd" name="Prototype approved for further development" />
    <bpmn:endEvent id="discardedEnd" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f3" sourceRef="research" targetRef="design" />
    <bpmn:sequenceFlow id="f4" sourceRef="design" targetRef="select" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f6" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f7" sourceRef="test" targetRef="feedback" />
    <bpmn:sequenceFlow id="f8" sourceRef="feedback" targetRef="refineDecision" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="refineDecision" targetRef="refine" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="refineDecision" targetRef="outcomeDecision" default="f10" />
    <bpmn:sequenceFlow id="f11" sourceRef="refine" targetRef="test" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="outcomeDecision" targetRef="approvedEnd" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="outcomeDecision" targetRef="discardedEnd" default="f13" />
  </bpmn:process>
</bpmn:definitions>