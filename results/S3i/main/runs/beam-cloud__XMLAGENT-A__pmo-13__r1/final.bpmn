<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CS" name="Customer service">
        <bpmn:flowNodeRef>Task_LogAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkResolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TEAM" name="Investigation team">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ResolveJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FIN" name="Financial team">
        <bpmn:flowNodeRef>Task_ProcessReimb</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Complaint filed" />
    <bpmn:task id="Task_File" name="File a complaint" />
    <bpmn:task id="Task_LogAssign" name="Log the complaint and assign it to the relevant department" />
    <bpmn:task id="Task_Review" name="Review the details" />
    <bpmn:task id="Task_Notify" name="Notify customer with the decision" />
    <bpmn:exclusiveGateway id="Gw_Refund" name="Refund approved?" default="Flow_Rejected" />
    <bpmn:task id="Task_ProcessReimb" name="Process the reimbursement" />
    <bpmn:task id="Task_ReceiveRefund" name="Receive the refund" />
    <bpmn:exclusiveGateway id="Gw_ResolveJoin" name="Resolved" />
    <bpmn:task id="Task_MarkResolved" name="Mark complaint as resolved" />
    <bpmn:exclusiveGateway id="Gw_Feedback" name="Provide feedback?" default="Flow_NoFeedback" />
    <bpmn:task id="Task_Feedback" name="Provide feedback on satisfaction" />
    <bpmn:endEvent id="End_1" name="Case resolved" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_File" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_File" targetRef="Task_LogAssign" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_LogAssign" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Review" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Notify" targetRef="Gw_Refund" />
    <bpmn:sequenceFlow id="Flow_Approved" name="yes" sourceRef="Gw_Refund" targetRef="Task_ProcessReimb" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="no" sourceRef="Gw_Refund" targetRef="Gw_ResolveJoin" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProcessReimb" targetRef="Task_ReceiveRefund" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ReceiveRefund" targetRef="Gw_ResolveJoin" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_ResolveJoin" targetRef="Task_MarkResolved" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_MarkResolved" targetRef="Gw_Feedback" />
    <bpmn:sequenceFlow id="Flow_Feedback" name="yes" sourceRef="Gw_Feedback" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="Flow_NoFeedback" name="no" sourceRef="Gw_Feedback" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Feedback" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
