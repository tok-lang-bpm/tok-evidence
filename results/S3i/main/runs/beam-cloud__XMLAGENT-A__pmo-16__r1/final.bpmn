<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational Company" processRef="audit-process" />
  </bpmn:collaboration>
  <bpmn:process id="audit-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-audit-coordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-concurrent-prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-regional-office" name="Regional Office">
        <bpmn:flowNodeRef>prepare-statements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-docs-ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-clarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-compliance-team" name="Compliance Team">
        <bpmn:flowNodeRef>check-regulatory-updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-central-audit-team" name="Central Audit Team">
        <bpmn:flowNodeRef>review-submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval-financial-risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval-operational-risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eval-compliance-risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-risk-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-risk-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-high-risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze-data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-site-visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-site-visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-investigation-complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-all-risks-addressed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute-final-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive-final-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-audit-director" name="Audit Director">
        <bpmn:flowNodeRef>review-audit-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-report-approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start annual audit" />
    <bpmn:task id="send-notification" name="Send notification to regional office" />
    <bpmn:parallelGateway id="gw-concurrent-prep" />
    <bpmn:task id="prepare-statements" name="Prepare financial statements" />
    <bpmn:task id="gather-documents" name="Gather necessary documents" />
    <bpmn:task id="check-regulatory-updates" name="Check regulatory updates" />
    <bpmn:parallelGateway id="gw-docs-ready" />
    <bpmn:task id="submit-documents" name="Submit documents to central audit team" />
    <bpmn:task id="review-submission" name="Review submission" />
    <bpmn:exclusiveGateway id="gw-discrepancies" name="Discrepancies found?" />
    <bpmn:task id="request-clarifications" name="Request clarifications" />
    <bpmn:task id="provide-clarifications" name="Provide necessary clarifications" />
    <bpmn:parallelGateway id="gw-risk-split" />
    <bpmn:task id="eval-financial-risks" name="Evaluate financial risks" />
    <bpmn:task id="eval-operational-risks" name="Evaluate operational risks" />
    <bpmn:task id="eval-compliance-risks" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="gw-risk-join" />
    <bpmn:exclusiveGateway id="gw-high-risk" name="High risk identified?" />
    <bpmn:task id="analyze-data" name="Analyze data" />
    <bpmn:task id="conduct-interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="gw-site-visit" name="Site visit required?" />
    <bpmn:task id="conduct-site-visit" name="Conduct site visit" />
    <bpmn:exclusiveGateway id="gw-investigation-complete" />
    <bpmn:exclusiveGateway id="gw-all-risks-addressed" />
    <bpmn:task id="compile-audit-report" name="Compile audit report" />
    <bpmn:task id="review-audit-report" name="Review audit report" />
    <bpmn:exclusiveGateway id="gw-report-approved" name="Report approved?" />
    <bpmn:task id="update-audit-report" name="Update audit report" />
    <bpmn:task id="resubmit-audit-report" name="Resubmit audit report" />
    <bpmn:task id="distribute-final-report" name="Distribute final report to executive board" />
    <bpmn:task id="archive-final-report" name="Archive final report" />
    <bpmn:endEvent id="end" name="Audit process closed" />

    <bpmn:sequenceFlow id="f-start" sourceRef="start" targetRef="send-notification" />
    <bpmn:sequenceFlow id="f-after-send" sourceRef="send-notification" targetRef="gw-concurrent-prep" />
    <bpmn:sequenceFlow id="f-regional-branch" sourceRef="gw-concurrent-prep" targetRef="prepare-statements" />
    <bpmn:sequenceFlow id="f-compliance-branch" sourceRef="gw-concurrent-prep" targetRef="check-regulatory-updates" />
    <bpmn:sequenceFlow id="f-prepare-to-gather" sourceRef="prepare-statements" targetRef="gather-documents" />
    <bpmn:sequenceFlow id="f-gather-to-join" sourceRef="gather-documents" targetRef="gw-docs-ready" />
    <bpmn:sequenceFlow id="f-compliance-to-join" sourceRef="check-regulatory-updates" targetRef="gw-docs-ready" />
    <bpmn:sequenceFlow id="f-submit" sourceRef="gw-docs-ready" targetRef="submit-documents" />
    <bpmn:sequenceFlow id="f-review-submission" sourceRef="submit-documents" targetRef="review-submission" />
    <bpmn:sequenceFlow id="f-to-discrepancies" sourceRef="review-submission" targetRef="gw-discrepancies" />
    <bpmn:sequenceFlow id="f-discrepancies-yes" name="yes" sourceRef="gw-discrepancies" targetRef="request-clarifications" />
    <bpmn:sequenceFlow id="f-request-to-provide" sourceRef="request-clarifications" targetRef="provide-clarifications" />
    <bpmn:sequenceFlow id="f-provide-to-review" sourceRef="provide-clarifications" targetRef="review-submission" />
    <bpmn:sequenceFlow id="f-discrepancies-no" name="no" sourceRef="gw-discrepancies" targetRef="gw-risk-split" />
    <bpmn:sequenceFlow id="f-risk-financial" sourceRef="gw-risk-split" targetRef="eval-financial-risks" />
    <bpmn:sequenceFlow id="f-risk-operational" sourceRef="gw-risk-split" targetRef="eval-operational-risks" />
    <bpmn:sequenceFlow id="f-risk-compliance" sourceRef="gw-risk-split" targetRef="eval-compliance-risks" />
    <bpmn:sequenceFlow id="f-financial-to-join" sourceRef="eval-financial-risks" targetRef="gw-risk-join" />
    <bpmn:sequenceFlow id="f-operational-to-join" sourceRef="eval-operational-risks" targetRef="gw-risk-join" />
    <bpmn:sequenceFlow id="f-compliance-to-join-risk" sourceRef="eval-compliance-risks" targetRef="gw-risk-join" />
    <bpmn:sequenceFlow id="f-risk-joined-to-high-risk" sourceRef="gw-risk-join" targetRef="gw-high-risk" />
    <bpmn:sequenceFlow id="f-high-risk-yes" name="yes" sourceRef="gw-high-risk" targetRef="analyze-data" />
    <bpmn:sequenceFlow id="f-analyze-to-interviews" sourceRef="analyze-data" targetRef="conduct-interviews" />
    <bpmn:sequenceFlow id="f-interviews-to-site-gateway" sourceRef="conduct-interviews" targetRef="gw-site-visit" />
    <bpmn:sequenceFlow id="f-site-visit-yes" name="yes" sourceRef="gw-site-visit" targetRef="conduct-site-visit" />
    <bpmn:sequenceFlow id="f-site-visit-to-merge" sourceRef="conduct-site-visit" targetRef="gw-investigation-complete" />
    <bpmn:sequenceFlow id="f-site-visit-no" name="no" sourceRef="gw-site-visit" targetRef="gw-investigation-complete" />
    <bpmn:sequenceFlow id="f-investigation-to-all-risks" sourceRef="gw-investigation-complete" targetRef="gw-all-risks-addressed" />
    <bpmn:sequenceFlow id="f-high-risk-no" name="no" sourceRef="gw-high-risk" targetRef="gw-all-risks-addressed" />
    <bpmn:sequenceFlow id="f-compile-report" sourceRef="gw-all-risks-addressed" targetRef="compile-audit-report" />
    <bpmn:sequenceFlow id="f-report-to-director" sourceRef="compile-audit-report" targetRef="review-audit-report" />
    <bpmn:sequenceFlow id="f-to-approval" sourceRef="review-audit-report" targetRef="gw-report-approved" />
    <bpmn:sequenceFlow id="f-approved" name="approved" sourceRef="gw-report-approved" targetRef="distribute-final-report" />
    <bpmn:sequenceFlow id="f-distribute-to-archive" sourceRef="distribute-final-report" targetRef="archive-final-report" />
    <bpmn:sequenceFlow id="f-archive-to-end" sourceRef="archive-final-report" targetRef="end" />
    <bpmn:sequenceFlow id="f-revisions" name="revisions required" sourceRef="gw-report-approved" targetRef="update-audit-report" />
    <bpmn:sequenceFlow id="f-update-to-resubmit" sourceRef="update-audit-report" targetRef="resubmit-audit-report" />
    <bpmn:sequenceFlow id="f-resubmit-to-review" sourceRef="resubmit-audit-report" targetRef="review-audit-report" />
  </bpmn:process>
</bpmn:definitions>
