<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="process" />
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-student" name="Student">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_par2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_par2j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_adddrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reviewgrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_griev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_appealform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_grad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_graduated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-admissions" name="Admissions Office">
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_par1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_par1j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-committee" name="Admissions Committee">
        <bpmn:flowNodeRef>T_evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-finance" name="Finance Department">
        <bpmn:flowNodeRef>T_finance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-it" name="IT Department">
        <bpmn:flowNodeRef>T_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-international" name="International Student Office">
        <bpmn:flowNodeRef>T_visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>T_meet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>T_meetappeal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start" />

    <bpmn:task id="T_submit" name="Submit application online" />
    <bpmn:task id="T_review" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="G_docs" name="Documents complete?" default="F_docs_no" />
    <bpmn:task id="T_notify" name="Notify applicant to provide missing items" />
    <bpmn:parallelGateway id="G_par1" />
    <bpmn:task id="T_evaluate" name="Evaluate application" />
    <bpmn:task id="T_finance" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="G_par1j" />
    <bpmn:exclusiveGateway id="G_accepted" name="Application accepted?" default="F_accepted_no" />
    <bpmn:task id="T_accept" name="Send acceptance letter" />
    <bpmn:task id="T_reject" name="Send rejection letter" />
    <bpmn:endEvent id="E_rejected" name="Application rejected" />
    <bpmn:task id="T_confirm" name="Confirm enrollment" />
    <bpmn:exclusiveGateway id="G_confirm" name="Enrollment confirmed by deadline?" default="F_confirm_no" />
    <bpmn:endEvent id="E_canceled" name="Application canceled" />
    <bpmn:parallelGateway id="G_par2" />
    <bpmn:task id="T_orientation" name="Receive orientation materials" />
    <bpmn:task id="T_accounts" name="Set up student accounts" />
    <bpmn:parallelGateway id="G_par2j" />
    <bpmn:exclusiveGateway id="G_intl" name="International student?" default="F_intl_no" />
    <bpmn:task id="T_visa" name="Assist with visa processing" />
    <bpmn:task id="T_id" name="Obtain student ID card" />
    <bpmn:task id="T_meet" name="Meet with academic advisor" />
    <bpmn:task id="T_select" name="Select courses" />
    <bpmn:task id="T_resolve" name="Resolve schedule conflicts" />
    <bpmn:task id="T_attend" name="Begin attending classes" />
    <bpmn:task id="T_adddrop" name="Add or drop courses" />
    <bpmn:task id="T_post" name="Post grades" />
    <bpmn:task id="T_reviewgrades" name="Review grades online" />
    <bpmn:exclusiveGateway id="G_griev" name="Has grievances?" default="F_griev_no" />
    <bpmn:task id="T_appealform" name="Submit appeal form" />
    <bpmn:task id="T_meetappeal" name="Meet with appeals committee" />
    <bpmn:task id="T_await" name="Await decision" />
    <bpmn:exclusiveGateway id="G_grad" name="Graduate or withdraw?" default="F_grad_no" />
    <bpmn:endEvent id="E_graduated" name="Graduated or withdrawn" />

    <bpmn:sequenceFlow id="F_start" sourceRef="Start_1" targetRef="T_submit" />
    <bpmn:sequenceFlow id="F_submit" sourceRef="T_submit" targetRef="T_review" />
    <bpmn:sequenceFlow id="F_review" sourceRef="T_review" targetRef="G_docs" />
    <bpmn:sequenceFlow id="F_docs_yes" name="yes" sourceRef="G_docs" targetRef="G_par1" />
    <bpmn:sequenceFlow id="F_docs_no" name="no" sourceRef="G_docs" targetRef="T_notify" />
    <bpmn:sequenceFlow id="F_notify" sourceRef="T_notify" targetRef="T_review" />
    <bpmn:sequenceFlow id="F_par1_a" sourceRef="G_par1" targetRef="T_evaluate" />
    <bpmn:sequenceFlow id="F_par1_b" sourceRef="G_par1" targetRef="T_finance" />
    <bpmn:sequenceFlow id="F_eval" sourceRef="T_evaluate" targetRef="G_par1j" />
    <bpmn:sequenceFlow id="F_fin" sourceRef="T_finance" targetRef="G_par1j" />
    <bpmn:sequenceFlow id="F_join1" sourceRef="G_par1j" targetRef="G_accepted" />
    <bpmn:sequenceFlow id="F_accepted_yes" name="yes" sourceRef="G_accepted" targetRef="T_accept" />
    <bpmn:sequenceFlow id="F_accepted_no" name="no" sourceRef="G_accepted" targetRef="T_reject" />
    <bpmn:sequenceFlow id="F_reject" sourceRef="T_reject" targetRef="E_rejected" />
    <bpmn:sequenceFlow id="F_accept" sourceRef="T_accept" targetRef="T_confirm" />
    <bpmn:sequenceFlow id="F_confirm" sourceRef="T_confirm" targetRef="G_confirm" />
    <bpmn:sequenceFlow id="F_confirm_yes" name="yes" sourceRef="G_confirm" targetRef="G_par2" />
    <bpmn:sequenceFlow id="F_confirm_no" name="no" sourceRef="G_confirm" targetRef="E_canceled" />
    <bpmn:sequenceFlow id="F_par2_a" sourceRef="G_par2" targetRef="T_orientation" />
    <bpmn:sequenceFlow id="F_par2_b" sourceRef="G_par2" targetRef="T_accounts" />
    <bpmn:sequenceFlow id="F_orient" sourceRef="T_orientation" targetRef="G_par2j" />
    <bpmn:sequenceFlow id="F_accounts" sourceRef="T_accounts" targetRef="G_par2j" />
    <bpmn:sequenceFlow id="F_join2" sourceRef="G_par2j" targetRef="G_intl" />
    <bpmn:sequenceFlow id="F_intl_yes" name="yes" sourceRef="G_intl" targetRef="T_visa" />
    <bpmn:sequenceFlow id="F_intl_no" name="no" sourceRef="G_intl" targetRef="T_id" />
    <bpmn:sequenceFlow id="F_visa" sourceRef="T_visa" targetRef="T_id" />
    <bpmn:sequenceFlow id="F_id" sourceRef="T_id" targetRef="T_meet" />
    <bpmn:sequenceFlow id="F_meet" sourceRef="T_meet" targetRef="T_select" />
    <bpmn:sequenceFlow id="F_select" sourceRef="T_select" targetRef="T_resolve" />
    <bpmn:sequenceFlow id="F_resolve" sourceRef="T_resolve" targetRef="T_attend" />
    <bpmn:sequenceFlow id="F_attend" sourceRef="T_attend" targetRef="T_adddrop" />
    <bpmn:sequenceFlow id="F_adddrop" sourceRef="T_adddrop" targetRef="T_post" />
    <bpmn:sequenceFlow id="F_post" sourceRef="T_post" targetRef="T_reviewgrades" />
    <bpmn:sequenceFlow id="F_reviewgrades" sourceRef="T_reviewgrades" targetRef="G_griev" />
    <bpmn:sequenceFlow id="F_griev_yes" name="yes" sourceRef="G_griev" targetRef="T_appealform" />
    <bpmn:sequenceFlow id="F_griev_no" name="no" sourceRef="G_griev" targetRef="G_grad" />
    <bpmn:sequenceFlow id="F_appealform" sourceRef="T_appealform" targetRef="T_meetappeal" />
    <bpmn:sequenceFlow id="F_meetappeal" sourceRef="T_meetappeal" targetRef="T_await" />
    <bpmn:sequenceFlow id="F_await" sourceRef="T_await" targetRef="G_grad" />
    <bpmn:sequenceFlow id="F_grad_yes" name="yes" sourceRef="G_grad" targetRef="E_graduated" />
    <bpmn:sequenceFlow id="F_grad_no" name="no" sourceRef="G_grad" targetRef="T_attend" />
  </bpmn:process>
</bpmn:definitions>
