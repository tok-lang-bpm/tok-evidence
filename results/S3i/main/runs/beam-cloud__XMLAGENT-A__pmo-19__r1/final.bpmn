<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setpay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xg_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xg_paymerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xg_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start order" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="pg_split" />
    <bpmn:task id="select" name="Select items to purchase" />
    <bpmn:task id="setpay" name="Set payment method" />
    <bpmn:task id="reward" name="Choose free reward" />
    <bpmn:parallelGateway id="pg_join" />
    <bpmn:exclusiveGateway id="xg_pay" default="f_install" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="install" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="xg_paymerge" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="xg_return" default="f_end" />
    <bpmn:task id="return_items" name="Return items for exchange" />
    <bpmn:task id="new_delivery" name="Make new delivery" />
    <bpmn:endEvent id="end" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="pg_split" />
    <bpmn:sequenceFlow id="f3" sourceRef="pg_split" targetRef="select" />
    <bpmn:sequenceFlow id="f4" sourceRef="pg_split" targetRef="setpay" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f6" sourceRef="reward" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f_pay" name="pay" sourceRef="xg_pay" targetRef="pay" />
    <bpmn:sequenceFlow id="f_install" name="installment" sourceRef="xg_pay" targetRef="install" />
    <bpmn:sequenceFlow id="f7" sourceRef="setpay" targetRef="xg_pay" />
    <bpmn:sequenceFlow id="f8" sourceRef="pay" targetRef="xg_paymerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="install" targetRef="xg_paymerge" />
    <bpmn:sequenceFlow id="f10" sourceRef="xg_paymerge" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="pg_join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f_yes" name="yes" sourceRef="xg_return" targetRef="return_items" />
    <bpmn:sequenceFlow id="f_end" name="no" sourceRef="xg_return" targetRef="end" />
    <bpmn:sequenceFlow id="f12" sourceRef="deliver" targetRef="xg_return" />
    <bpmn:sequenceFlow id="f13" sourceRef="return_items" targetRef="new_delivery" />
    <bpmn:sequenceFlow id="f14" sourceRef="new_delivery" targetRef="xg_return" />
  </bpmn:process>
</bpmn:definitions>
