<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneEmployee" name="Employee">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_reportType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_emp_workaccident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_emp_near</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_emp_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_emp_defect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="laneEmployer" name="Employer">
        <bpmn:flowNodeRef>Gw_group</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ag_split_gain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_fatalSerious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_incapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_provider5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ag_join_gain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ag_split_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_fatalSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_emergencySelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_labourSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ag_join_self</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="laneSelfEmployed" name="Self-employed Person">
        <bpmn:flowNodeRef>T_selfreport</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="laneStudent" name="Student, Schoolchild or Kindergarten Child">
        <bpmn:flowNodeRef>And_split_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>And_join_student</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="laneSchool" name="School, Educational Facility or University">
        <bpmn:flowNodeRef>T_school</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lanePrivate" name="Insured Party (Private Insurance)">
        <bpmn:flowNodeRef>T_privateImmediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_privateFatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_privateFatal3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Accident or near-accident occurs" />

    <bpmn:exclusiveGateway id="Gw_reportType" name="What is reported?" />
    <bpmn:task id="T_emp_workaccident" name="Inform employer immediately of work accident" />
    <bpmn:task id="T_emp_near" name="Inform employer immediately of incident that would almost have led to an accident" />
    <bpmn:task id="T_emp_risk" name="Inform employer immediately of serious and immediate risk to safety and health" />
    <bpmn:task id="T_emp_defect" name="Inform employer immediately of defect discovered in protection systems" />

    <bpmn:exclusiveGateway id="Gw_group" name="Which protected group?" default="F_group_other" />
    <bpmn:parallelGateway id="Ag_split_gain" />
    <bpmn:exclusiveGateway id="Gw_fatalSerious" name="Leads to fatality or serious injury?" default="F_fatal_no" />
    <bpmn:exclusiveGateway id="Gw_emergency" name="Reported to emergency services?" default="F_emergency_skip" />
    <bpmn:task id="T_labour" name="Report work accident leading to fatality or serious injury to Labour Inspectorate immediately" />
    <bpmn:exclusiveGateway id="Gw_incapacity" name="Person killed or unable to work at least three days?" default="F_incap_no" />
    <bpmn:task id="T_provider5" name="Report work accident with death or 3-day inability to work to responsible accident insurance provider within five days" />
    <bpmn:parallelGateway id="Ag_join_gain" />

    <bpmn:parallelGateway id="Ag_split_self" />
    <bpmn:task id="T_selfreport" name="Report accidents involving employees and self to accident insurance provider in good time" />
    <bpmn:exclusiveGateway id="Gw_fatalSelf" name="Leads to fatality or serious injury?" default="F_self_fatal_no" />
    <bpmn:exclusiveGateway id="Gw_emergencySelf" name="Reported to emergency services?" default="F_self_emergency_skip" />
    <bpmn:task id="T_labourSelf" name="Report work accident leading to fatality or serious injury to Labour Inspectorate immediately" />
    <bpmn:parallelGateway id="Ag_join_self" />

    <bpmn:parallelGateway id="And_split_student" />
    <bpmn:task id="T_student" name="Report accident to competent directorate" />
    <bpmn:task id="T_school" name="Report work accident with physical injury or death to responsible accident insurance provider within five days in triplicate" />
    <bpmn:parallelGateway id="And_join_student" />

    <bpmn:task id="T_privateImmediate" name="Report accident in writing immediately to private insurance provider" />
    <bpmn:exclusiveGateway id="Gw_privateFatal" name="Fatality?" default="F_priv_fatal_no" />
    <bpmn:task id="T_privateFatal3" name="Report fatality within three days to private insurance provider even if already reported" />

    <bpmn:endEvent id="End_done" name="Reporting completed" />

    <bpmn:sequenceFlow id="F_start_type" sourceRef="Start_1" targetRef="Gw_reportType" />

    <bpmn:sequenceFlow id="F_type_work" name="work accident" sourceRef="Gw_reportType" targetRef="T_emp_workaccident" />
    <bpmn:sequenceFlow id="F_type_near" name="almost an accident" sourceRef="Gw_reportType" targetRef="T_emp_near" />
    <bpmn:sequenceFlow id="F_type_risk" name="serious and immediate risk" sourceRef="Gw_reportType" targetRef="T_emp_risk" />
    <bpmn:sequenceFlow id="F_type_defect" name="defect in protection systems" sourceRef="Gw_reportType" targetRef="T_emp_defect" />

    <bpmn:sequenceFlow id="F_near_end" sourceRef="T_emp_near" targetRef="End_done" />
    <bpmn:sequenceFlow id="F_risk_end" sourceRef="T_emp_risk" targetRef="End_done" />
    <bpmn:sequenceFlow id="F_defect_end" sourceRef="T_emp_defect" targetRef="End_done" />

    <bpmn:sequenceFlow id="F_work_group" sourceRef="T_emp_workaccident" targetRef="Gw_group" />

    <bpmn:sequenceFlow id="F_group_gain" name="Gainfully employed person" sourceRef="Gw_group" targetRef="Ag_split_gain" />
    <bpmn:sequenceFlow id="F_group_self" name="Self-employed person" sourceRef="Gw_group" targetRef="Ag_split_self" />
    <bpmn:sequenceFlow id="F_group_student" name="Student, schoolchild or kindergarten child" sourceRef="Gw_group" targetRef="And_split_student" />
    <bpmn:sequenceFlow id="F_group_private" name="Private insurance" sourceRef="Gw_group" targetRef="T_privateImmediate" />
    <bpmn:sequenceFlow id="F_group_other" name="Other protected person" sourceRef="Gw_group" targetRef="End_done" />

    <bpmn:sequenceFlow id="F_gain_split_fatal" sourceRef="Ag_split_gain" targetRef="Gw_fatalSerious" />
    <bpmn:sequenceFlow id="F_gain_split_incap" sourceRef="Ag_split_gain" targetRef="Gw_incapacity" />
    <bpmn:sequenceFlow id="F_fatal_yes" name="yes" sourceRef="Gw_fatalSerious" targetRef="Gw_emergency" />
    <bpmn:sequenceFlow id="F_fatal_no" name="no" sourceRef="Gw_fatalSerious" targetRef="Ag_join_gain" />
    <bpmn:sequenceFlow id="F_emergency_report" name="not reported to emergency services" sourceRef="Gw_emergency" targetRef="T_labour" />
    <bpmn:sequenceFlow id="F_emergency_skip" name="already reported to emergency services" sourceRef="Gw_emergency" targetRef="Ag_join_gain" />
    <bpmn:sequenceFlow id="F_labour_join" sourceRef="T_labour" targetRef="Ag_join_gain" />
    <bpmn:sequenceFlow id="F_incap_yes" name="yes" sourceRef="Gw_incapacity" targetRef="T_provider5" />
    <bpmn:sequenceFlow id="F_incap_no" name="no" sourceRef="Gw_incapacity" targetRef="Ag_join_gain" />
    <bpmn:sequenceFlow id="F_provider_join" sourceRef="T_provider5" targetRef="Ag_join_gain" />
    <bpmn:sequenceFlow id="F_gain_end" sourceRef="Ag_join_gain" targetRef="End_done" />

    <bpmn:sequenceFlow id="F_self_split_report" sourceRef="Ag_split_self" targetRef="T_selfreport" />
    <bpmn:sequenceFlow id="F_self_split_fatal" sourceRef="Ag_split_self" targetRef="Gw_fatalSelf" />
    <bpmn:sequenceFlow id="F_self_report_join" sourceRef="T_selfreport" targetRef="Ag_join_self" />
    <bpmn:sequenceFlow id="F_self_fatal_yes" name="yes" sourceRef="Gw_fatalSelf" targetRef="Gw_emergencySelf" />
    <bpmn:sequenceFlow id="F_self_fatal_no" name="no" sourceRef="Gw_fatalSelf" targetRef="Ag_join_self" />
    <bpmn:sequenceFlow id="F_self_emergency_report" name="not reported to emergency services" sourceRef="Gw_emergencySelf" targetRef="T_labourSelf" />
    <bpmn:sequenceFlow id="F_self_emergency_skip" name="already reported to emergency services" sourceRef="Gw_emergencySelf" targetRef="Ag_join_self" />
    <bpmn:sequenceFlow id="F_self_labour_join" sourceRef="T_labourSelf" targetRef="Ag_join_self" />
    <bpmn:sequenceFlow id="F_self_end" sourceRef="Ag_join_self" targetRef="End_done" />

    <bpmn:sequenceFlow id="F_student_report" sourceRef="And_split_student" targetRef="T_student" />
    <bpmn:sequenceFlow id="F_school_report" sourceRef="And_split_student" targetRef="T_school" />
    <bpmn:sequenceFlow id="F_student_join" sourceRef="T_student" targetRef="And_join_student" />
    <bpmn:sequenceFlow id="F_school_join" sourceRef="T_school" targetRef="And_join_student" />
    <bpmn:sequenceFlow id="F_student_end" sourceRef="And_join_student" targetRef="End_done" />

    <bpmn:sequenceFlow id="F_priv_immediate_join" sourceRef="T_privateImmediate" targetRef="Gw_privateFatal" />
    <bpmn:sequenceFlow id="F_priv_fatal_yes" name="yes" sourceRef="Gw_privateFatal" targetRef="T_privateFatal3" />
    <bpmn:sequenceFlow id="F_priv_fatal_no" name="no" sourceRef="Gw_privateFatal" targetRef="End_done" />
    <bpmn:sequenceFlow id="F_priv_fatal3_end" sourceRef="T_privateFatal3" targetRef="End_done" />
  </bpmn:process>
</bpmn:definitions>
