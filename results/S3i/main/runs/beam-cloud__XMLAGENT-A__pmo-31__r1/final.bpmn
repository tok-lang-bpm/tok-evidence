<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool" name="Blizzard Online Character Generator" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Player" name="Player">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check_bnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_bnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_enter_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_click_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_bnet_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_select_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_payment_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_sub_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_select_realm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_come_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_name_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_selfies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_recv_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Start character creation" />
    <bpmn:parallelGateway id="PG1" />
    <bpmn:task id="T_check_bnet" name="Check battle.net account" />
    <bpmn:exclusiveGateway id="G_bnet" name="Battle.net account?" />
    <bpmn:task id="T_enter_account" name="Enter account information" />
    <bpmn:task id="T_click_link" name="Click confirmation link" />
    <bpmn:exclusiveGateway id="G_bnet_merge" />
    <bpmn:task id="T_check_sub" name="Check active WoW subscription" />
    <bpmn:exclusiveGateway id="G_sub" name="Active WoW subscription?" />
    <bpmn:task id="T_select_payment" name="Select payment method" />
    <bpmn:exclusiveGateway id="G_payment" name="Payment method?" />
    <bpmn:task id="T_credit" name="Enter credit card information" />
    <bpmn:task id="T_iban" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="G_payment_merge" />
    <bpmn:exclusiveGateway id="G_sub_merge" />
    <bpmn:task id="T_login" name="Log into the game" />
    <bpmn:task id="T_select_realm" name="Select realm, race and class" />
    <bpmn:task id="T_come_names" name="Come up with character names" />
    <bpmn:parallelGateway id="PG_join" />
    <bpmn:task id="T_enter_name" name="Enter character name" />
    <bpmn:exclusiveGateway id="G_name_avail" name="Character name available?" />
    <bpmn:parallelGateway id="PG_recv" />
    <bpmn:task id="T_confirm" name="Receive confirmation" />
    <bpmn:task id="T_selfies" name="Receive character selfies" />
    <bpmn:parallelGateway id="PG_recv_join" />
    <bpmn:task id="T_expansion" name="Receive expansion release message" />
    <bpmn:endEvent id="End" name="Character created" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="PG1" />
    <bpmn:sequenceFlow id="F2" sourceRef="PG1" targetRef="T_check_bnet" />
    <bpmn:sequenceFlow id="F3" sourceRef="PG1" targetRef="T_come_names" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_check_bnet" targetRef="G_bnet" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="G_bnet" targetRef="G_bnet_merge" default="true" />
    <bpmn:sequenceFlow id="F6" name="no" sourceRef="G_bnet" targetRef="T_enter_account" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_enter_account" targetRef="T_click_link" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_click_link" targetRef="G_bnet_merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="G_bnet_merge" targetRef="T_check_sub" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_check_sub" targetRef="G_sub" />
    <bpmn:sequenceFlow id="F11" name="yes" sourceRef="G_sub" targetRef="G_sub_merge" default="true" />
    <bpmn:sequenceFlow id="F12" name="no" sourceRef="G_sub" targetRef="T_select_payment" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_select_payment" targetRef="G_payment" />
    <bpmn:sequenceFlow id="F14" name="Credit card" sourceRef="G_payment" targetRef="T_credit" />
    <bpmn:sequenceFlow id="F15" name="Bank account" sourceRef="G_payment" targetRef="T_iban" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_credit" targetRef="G_payment_merge" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_iban" targetRef="G_payment_merge" />
    <bpmn:sequenceFlow id="F18" sourceRef="G_payment_merge" targetRef="G_sub_merge" />
    <bpmn:sequenceFlow id="F19" sourceRef="G_sub_merge" targetRef="T_login" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_login" targetRef="T_select_realm" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_select_realm" targetRef="PG_join" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_come_names" targetRef="PG_join" />
    <bpmn:sequenceFlow id="F23" sourceRef="PG_join" targetRef="T_enter_name" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_enter_name" targetRef="G_name_avail" />
    <bpmn:sequenceFlow id="F25" name="no" sourceRef="G_name_avail" targetRef="T_enter_name" />
    <bpmn:sequenceFlow id="F26" name="yes" sourceRef="G_name_avail" targetRef="PG_recv" default="true" />
    <bpmn:sequenceFlow id="F27" sourceRef="PG_recv" targetRef="T_confirm" />
    <bpmn:sequenceFlow id="F28" sourceRef="PG_recv" targetRef="T_selfies" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_confirm" targetRef="PG_recv_join" />
    <bpmn:sequenceFlow id="F30" sourceRef="T_selfies" targetRef="PG_recv_join" />
    <bpmn:sequenceFlow id="F31" sourceRef="PG_recv_join" targetRef="T_expansion" />
    <bpmn:sequenceFlow id="F32" sourceRef="T_expansion" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
