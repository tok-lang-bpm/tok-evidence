<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell-changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-colour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>colour-in-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under-100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shopping-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order-colour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plastic-available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turn-on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate-gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create-project</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise-project</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-stl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printer" name="3D Printer">
        <bpmn:flowNodeRef>heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print-model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Craving custom 3D model" />
    <bpmn:task id="instruct" name="Instruct artist to create project" />
    <bpmn:task id="create-project" name="Create project" />
    <bpmn:task id="send-sketches" name="Send several sketches to artist" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with result?" />
    <bpmn:task id="tell-changes" name="Tell artist what to change" />
    <bpmn:task id="revise-project" name="Revise project" />
    <bpmn:task id="send-stl" name="Send STL file" />
    <bpmn:task id="choose-colour" name="Choose plastic colour" />
    <bpmn:exclusiveGateway id="colour-in-stock" name="Colour in stock?" />
    <bpmn:task id="check-amount" name="Check how much colour is left" />
    <bpmn:exclusiveGateway id="under-100" name="Under 100 grams?" />
    <bpmn:task id="shopping-list" name="Put colour on shopping list" />
    <bpmn:task id="order-colour" name="Order colour" />
    <bpmn:exclusiveGateway id="plastic-available" name="Plastic available" />
    <bpmn:parallelGateway id="parallel-split" />
    <bpmn:task id="turn-on" name="Turn printer on" />
    <bpmn:task id="heat" name="Heat up bed and extruder" />
    <bpmn:task id="generate-gcode" name="Generate gcode file from STL" />
    <bpmn:parallelGateway id="parallel-join" />
    <bpmn:task id="print-model" name="Print model" />
    <bpmn:endEvent id="end" name="Model printed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="instruct" />
    <bpmn:sequenceFlow id="f2" sourceRef="instruct" targetRef="create-project" />
    <bpmn:sequenceFlow id="f3" sourceRef="create-project" targetRef="send-sketches" />
    <bpmn:sequenceFlow id="f4" sourceRef="send-sketches" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="satisfied" targetRef="send-stl" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="satisfied" targetRef="tell-changes" />
    <bpmn:sequenceFlow id="f7" sourceRef="tell-changes" targetRef="revise-project" />
    <bpmn:sequenceFlow id="f8" sourceRef="revise-project" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f9" sourceRef="send-stl" targetRef="choose-colour" />
    <bpmn:sequenceFlow id="f10" sourceRef="choose-colour" targetRef="colour-in-stock" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="colour-in-stock" targetRef="check-amount" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="colour-in-stock" targetRef="order-colour" />
    <bpmn:sequenceFlow id="f13" sourceRef="check-amount" targetRef="under-100" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="under-100" targetRef="shopping-list" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="under-100" targetRef="plastic-available" />
    <bpmn:sequenceFlow id="f16" sourceRef="shopping-list" targetRef="plastic-available" />
    <bpmn:sequenceFlow id="f17" sourceRef="order-colour" targetRef="plastic-available" />
    <bpmn:sequenceFlow id="f18" sourceRef="plastic-available" targetRef="parallel-split" />
    <bpmn:sequenceFlow id="f19" sourceRef="parallel-split" targetRef="turn-on" />
    <bpmn:sequenceFlow id="f20" sourceRef="parallel-split" targetRef="generate-gcode" />
    <bpmn:sequenceFlow id="f21" sourceRef="turn-on" targetRef="heat" />
    <bpmn:sequenceFlow id="f22" sourceRef="heat" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f23" sourceRef="generate-gcode" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f24" sourceRef="parallel-join" targetRef="print-model" />
    <bpmn:sequenceFlow id="f25" sourceRef="print-model" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
