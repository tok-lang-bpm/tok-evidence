<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Building a custom machine out of Lego bricks" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>develop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="develop" name="Develop basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give Lego sets to children" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:exclusiveGateway id="parts_gw" name="Parts available in container?" default="flow_parts_yes" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="build" name="Build subcomponent" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="test_gw" name="Test successful?" default="flow_test_fail" />
    <bpmn:exclusiveGateway id="more_gw" name="More subcomponents?" default="flow_more_no" />
    <bpmn:task id="assemble" name="Assemble subcomponents" />
    <bpmn:task id="redesign" name="Redesign and rebuild subcomponent" />
    <bpmn:endEvent id="end" name="Machine built" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="develop" />
    <bpmn:sequenceFlow id="f2" sourceRef="develop" targetRef="order" />
    <bpmn:sequenceFlow id="f3" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f4" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f5" sourceRef="sort" targetRef="parts_gw" />
    <bpmn:sequenceFlow id="flow_parts_yes" name="yes" sourceRef="parts_gw" targetRef="build" />
    <bpmn:sequenceFlow id="flow_parts_no" name="no" sourceRef="parts_gw" targetRef="reorder" />
    <bpmn:sequenceFlow id="f6" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f7" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f8" sourceRef="test" targetRef="test_gw" />
    <bpmn:sequenceFlow id="flow_test_ok" name="yes" sourceRef="test_gw" targetRef="more_gw" />
    <bpmn:sequenceFlow id="flow_test_fail" name="no" sourceRef="test_gw" targetRef="redesign" />
    <bpmn:sequenceFlow id="f9" sourceRef="redesign" targetRef="parts_gw" />
    <bpmn:sequenceFlow id="flow_more_yes" name="yes" sourceRef="more_gw" targetRef="build" />
    <bpmn:sequenceFlow id="flow_more_no" name="no" sourceRef="more_gw" targetRef="assemble" />
    <bpmn:sequenceFlow id="f10" sourceRef="assemble" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
