<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Contract project" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gstock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderfast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reordercheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endproj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Parts needed" />
    <bpmn:task id="q" name="Query web shops" />
    <bpmn:task id="lst" name="Create list of parts to order from each shop" />
    <bpmn:task id="cheap" name="Select cheapest parts" />
    <bpmn:task id="order" name="Order parts" />
    <bpmn:task id="recv" name="Receive parts in batches" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:exclusiveGateway id="gstock" name="Stock level?" />
    <bpmn:task id="mail" name="Write mail to friends complaining about webshops" />
    <bpmn:task id="reorderfast" name="Reorder parts (fastest)" />
    <bpmn:task id="reordercheap" name="Reorder parts (cheapest)" />
    <bpmn:task id="cont" name="Continue building" />
    <bpmn:endEvent id="endmail" name="Complaint sent" />
    <bpmn:endEvent id="endproj" name="Project completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="q" />
    <bpmn:sequenceFlow id="f2" sourceRef="q" targetRef="lst" />
    <bpmn:sequenceFlow id="f3" sourceRef="lst" targetRef="cheap" />
    <bpmn:sequenceFlow id="f4" sourceRef="cheap" targetRef="order" />
    <bpmn:sequenceFlow id="f5" sourceRef="order" targetRef="recv" />
    <bpmn:sequenceFlow id="f6" sourceRef="recv" targetRef="build" />
    <bpmn:sequenceFlow id="f7" sourceRef="build" targetRef="gstock" />
    <bpmn:sequenceFlow id="f8" name="zero" sourceRef="gstock" targetRef="mail" />
    <bpmn:sequenceFlow id="f9" name="below 3" sourceRef="gstock" targetRef="reorderfast" />
    <bpmn:sequenceFlow id="f10" name="below 5" sourceRef="gstock" targetRef="reordercheap" />
    <bpmn:sequenceFlow id="f11" sourceRef="gstock" targetRef="cont" />
    <bpmn:sequenceFlow id="f12" sourceRef="mail" targetRef="endmail" />
    <bpmn:sequenceFlow id="f13" sourceRef="reorderfast" targetRef="build" />
    <bpmn:sequenceFlow id="f14" sourceRef="reordercheap" targetRef="build" />
    <bpmn:sequenceFlow id="f15" sourceRef="cont" targetRef="endproj" />
  </bpmn:process>
</bpmn:definitions>
