<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="owner-pool" name="Smartphone Owner" processRef="owner-process" />
    <bpmn:participant id="expert-pool" name="Expert Repair Service" />
    <bpmn:messageFlow id="mf_send_to_expert" sourceRef="Task_expert" targetRef="expert-pool" />
  </bpmn:collaboration>
  <bpmn:process id="owner-process" isExecutable="false">
    <bpmn:laneSet id="owner-lanes">
      <bpmn:lane id="lane_user" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_tool" name="Online Tool">
        <bpmn:flowNodeRef>Task_lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_instr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Broken smartphone screen" />
    <bpmn:task id="Task_enter" name="Enter model and what is broken" />
    <bpmn:task id="Task_lists" name="Provide list of materials, tools, and ordering choices" />
    <bpmn:task id="Task_check" name="Check what is already available" />
    <bpmn:exclusiveGateway id="Gw_friends" name="Borrow or buy cheap from friends?" default="f_buy_direct" />
    <bpmn:task id="Task_contact" name="Contact friends to borrow or buy cheap" />
    <bpmn:task id="Task_buy" name="Buy remaining materials and tools" />
    <bpmn:task id="Task_instr" name="Provide repair instructions" />
    <bpmn:task id="Task_fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="Gw_success" name="Repair successful?" default="f_send_expert" />
    <bpmn:task id="Task_review" name="Send review and/or video" />
    <bpmn:task id="Task_expert" name="Send phone to expert" />
    <bpmn:endEvent id="End_review" name="Repair shared" />
    <bpmn:endEvent id="End_expert" name="Sent to expert" />
    <bpmn:sequenceFlow id="f_enter" sourceRef="start" targetRef="Task_enter" />
    <bpmn:sequenceFlow id="f_lists" sourceRef="Task_enter" targetRef="Task_lists" />
    <bpmn:sequenceFlow id="f_check" sourceRef="Task_lists" targetRef="Task_check" />
    <bpmn:sequenceFlow id="f_friends" sourceRef="Task_check" targetRef="Gw_friends" />
    <bpmn:sequenceFlow id="f_contact_yes" name="yes" sourceRef="Gw_friends" targetRef="Task_contact" />
    <bpmn:sequenceFlow id="f_buy_direct" name="no" sourceRef="Gw_friends" targetRef="Task_buy" />
    <bpmn:sequenceFlow id="f_buy_after_contact" sourceRef="Task_contact" targetRef="Task_buy" />
    <bpmn:sequenceFlow id="f_instr" sourceRef="Task_buy" targetRef="Task_instr" />
    <bpmn:sequenceFlow id="f_fix" sourceRef="Task_instr" targetRef="Task_fix" />
    <bpmn:sequenceFlow id="f_success" sourceRef="Task_fix" targetRef="Gw_success" />
    <bpmn:sequenceFlow id="f_review" name="yes" sourceRef="Gw_success" targetRef="Task_review" />
    <bpmn:sequenceFlow id="f_send_expert" name="no" sourceRef="Gw_success" targetRef="Task_expert" />
    <bpmn:sequenceFlow id="f_end_review" sourceRef="Task_review" targetRef="End_review" />
    <bpmn:sequenceFlow id="f_end_expert" sourceRef="Task_expert" targetRef="End_expert" />
  </bpmn:process>
</bpmn:definitions>
