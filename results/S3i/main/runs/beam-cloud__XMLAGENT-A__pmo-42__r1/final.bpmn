<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool" name="Service for Your Fridge" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Customer" name="You">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RateChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoRate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Center" name="Central Fridge Service Center">
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Facility" name="Local Service Facility">
        <bpmn:flowNodeRef>Appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Repaired</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Fridge produces strange noises" />
    <bpmn:task id="Describe" name="Describe symptoms and send to service center" />
    <bpmn:task id="Select" name="Select local service facility" />
    <bpmn:task id="Appointment" name="Make appointment" />
    <bpmn:task id="Arrive" name="Arrive at your home" />
    <bpmn:exclusiveGateway id="Repaired" name="Fridge repaired?" default="BackToAppointment" />
    <bpmn:task id="Confirm" name="Confirm fridge is OK" />
    <bpmn:exclusiveGateway id="RateChoice" name="Rate service?" default="SkipRate" />
    <bpmn:task id="Rate" name="Rate service facility" />
    <bpmn:endEvent id="EndNoRate" name="Service completed" />
    <bpmn:endEvent id="EndRated" name="Service completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Describe" />
    <bpmn:sequenceFlow id="F2" sourceRef="Describe" targetRef="Select" />
    <bpmn:sequenceFlow id="F3" sourceRef="Select" targetRef="Appointment" />
    <bpmn:sequenceFlow id="F4" sourceRef="Appointment" targetRef="Arrive" />
    <bpmn:sequenceFlow id="F5" sourceRef="Arrive" targetRef="Repaired" />
    <bpmn:sequenceFlow id="Fix" name="yes" sourceRef="Repaired" targetRef="Confirm" />
    <bpmn:sequenceFlow id="BackToAppointment" name="no, needs parts" sourceRef="Repaired" targetRef="Appointment" />
    <bpmn:sequenceFlow id="F8" sourceRef="Confirm" targetRef="RateChoice" />
    <bpmn:sequenceFlow id="DoRate" name="yes" sourceRef="RateChoice" targetRef="Rate" />
    <bpmn:sequenceFlow id="SkipRate" name="no" sourceRef="RateChoice" targetRef="EndNoRate" />
    <bpmn:sequenceFlow id="F11" sourceRef="Rate" targetRef="EndRated" />
  </bpmn:process>
</bpmn:definitions>
