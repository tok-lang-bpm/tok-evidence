<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Robotic Burger Seller near the University of Vienna" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parMenuSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwFriesJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parMenuJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwBurgerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parStatusSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statusUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parStatusJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="receiveOrder" name="Receive the order" />
    <bpmn:task id="askMenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="gwMenu" name="Wants a menu?" />
    <bpmn:parallelGateway id="parMenuSplit" />
    <bpmn:task id="prepareDrink" name="Start preparing the drink" />
    <bpmn:task id="askFries" name="Ask if you want fries or wedges" />
    <bpmn:exclusiveGateway id="gwFries" name="Wants fries?" />
    <bpmn:task id="prepareFries" name="Prepare the fries" />
    <bpmn:task id="prepareWedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="gwFriesJoin" />
    <bpmn:parallelGateway id="parMenuJoin" />
    <bpmn:exclusiveGateway id="gwBurgerMerge" />
    <bpmn:task id="prepareBurger" name="Prepare the burger" />
    <bpmn:parallelGateway id="parStatusSplit" />
    <bpmn:task id="statusUpdates" name="Give enthusiastic status updates every 30 seconds" />
    <bpmn:parallelGateway id="parStatusJoin" />
    <bpmn:task id="deliver" name="Deliver the order via conveyor belt" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receiveOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="receiveOrder" targetRef="askMenu" />
    <bpmn:sequenceFlow id="f3" sourceRef="askMenu" targetRef="gwMenu" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gwMenu" targetRef="parMenuSplit" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gwMenu" targetRef="gwBurgerMerge" />
    <bpmn:sequenceFlow id="f6" sourceRef="parMenuSplit" targetRef="prepareDrink" />
    <bpmn:sequenceFlow id="f7" sourceRef="parMenuSplit" targetRef="askFries" />
    <bpmn:sequenceFlow id="f8" sourceRef="askFries" targetRef="gwFries" />
    <bpmn:sequenceFlow id="f9" name="fries" sourceRef="gwFries" targetRef="prepareFries" />
    <bpmn:sequenceFlow id="f10" name="wedges" sourceRef="gwFries" targetRef="prepareWedges" />
    <bpmn:sequenceFlow id="f11" sourceRef="prepareFries" targetRef="gwFriesJoin" />
    <bpmn:sequenceFlow id="f12" sourceRef="prepareWedges" targetRef="gwFriesJoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="gwFriesJoin" targetRef="parMenuJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepareDrink" targetRef="parMenuJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="parMenuJoin" targetRef="gwBurgerMerge" />
    <bpmn:sequenceFlow id="f16" sourceRef="gwBurgerMerge" targetRef="parStatusSplit" />
    <bpmn:sequenceFlow id="f17" sourceRef="parStatusSplit" targetRef="prepareBurger" />
    <bpmn:sequenceFlow id="f18" sourceRef="parStatusSplit" targetRef="statusUpdates" />
    <bpmn:sequenceFlow id="f19" sourceRef="prepareBurger" targetRef="parStatusJoin" />
    <bpmn:sequenceFlow id="f20" sourceRef="statusUpdates" targetRef="parStatusJoin" />
    <bpmn:sequenceFlow id="f21" sourceRef="parStatusJoin" targetRef="deliver" />
    <bpmn:sequenceFlow id="f22" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions> Patrik