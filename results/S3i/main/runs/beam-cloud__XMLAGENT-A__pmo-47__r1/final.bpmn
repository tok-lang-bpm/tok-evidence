<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="sports-institute" name="Sports Institute" processRef="registration-process" />
  </bpmn:collaboration>
  <bpmn:process id="registration-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select-one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-university</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>university-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request-activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet-friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete-registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive-ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-no-slots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>slots-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell-courses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="New application" />

    <bpmn:task id="select-course" name="Select a course" />
    <bpmn:exclusiveGateway id="slots-gateway" name="Slots free?" default="flow-no-slots" />
    <bpmn:task id="tell-courses" name="Tell courses and dates" />
    <bpmn:task id="select-one" name="Select one" />

    <bpmn:task id="check-account" name="Check if already have an account" />
    <bpmn:exclusiveGateway id="account-gateway" name="Already have account?" />

    <bpmn:task id="check-university" name="Check registered at eligible university" />
    <bpmn:exclusiveGateway id="university-gateway" name="Registered at eligible university?" />
    <bpmn:task id="register-account" name="Register your account" />
    <bpmn:task id="request-activation" name="Request activation" />
    <bpmn:receiveTask id="receive-activation" name="Receive activation response" />
    <bpmn:exclusiveGateway id="account-merge" name="Account available" />
    <bpmn:task id="log-in" name="Log into it" />

    <bpmn:parallelGateway id="parallel-split" />
    <bpmn:task id="tweet-friends" name="Tweet to friends" />
    <bpmn:task id="complete-registration" name="Complete registration for the course" />
    <bpmn:task id="provide-payment" name="Provide payment information" />
    <bpmn:parallelGateway id="parallel-join" />

    <bpmn:receiveTask id="receive-ticket" name="Receive a course ticket" />
    <bpmn:endEvent id="end-success" name="Registration complete" />
    <bpmn:endEvent id="end-no-slots" name="No slots available" />

    <bpmn:sequenceFlow id="flow-start-select" sourceRef="start" targetRef="select-course" />
    <bpmn:sequenceFlow id="flow-select-slots" sourceRef="select-course" targetRef="slots-gateway" />
    <bpmn:sequenceFlow id="flow-slots-yes" name="yes" sourceRef="slots-gateway" targetRef="tell-courses" />
    <bpmn:sequenceFlow id="flow-slots-no" name="no" sourceRef="slots-gateway" targetRef="end-no-slots" />
    <bpmn:sequenceFlow id="flow-tell-selectone" sourceRef="tell-courses" targetRef="select-one" />
    <bpmn:sequenceFlow id="flow-selectone-check" sourceRef="select-one" targetRef="check-account" />
    <bpmn:sequenceFlow id="flow-check-account-gw" sourceRef="check-account" targetRef="account-gateway" />
    <bpmn:sequenceFlow id="flow-account-yes" name="yes" sourceRef="account-gateway" targetRef="log-in" />
    <bpmn:sequenceFlow id="flow-account-no" name="no" sourceRef="account-gateway" targetRef="check-university" />
    <bpmn:sequenceFlow id="flow-checkuni-gw" sourceRef="check-university" targetRef="university-gateway" />
    <bpmn:sequenceFlow id="flow-uni-yes" name="yes" sourceRef="university-gateway" targetRef="register-account" />
    <bpmn:sequenceFlow id="flow-uni-no" name="no" sourceRef="university-gateway" targetRef="request-activation" />
    <bpmn:sequenceFlow id="flow-request-receive" sourceRef="request-activation" targetRef="receive-activation" />
    <bpmn:sequenceFlow id="flow-receive-merge" sourceRef="receive-activation" targetRef="account-merge" />
    <bpmn:sequenceFlow id="flow-register-merge" sourceRef="register-account" targetRef="account-merge" />
    <bpmn:sequenceFlow id="flow-merge-login" sourceRef="account-merge" targetRef="log-in" />
    <bpmn:sequenceFlow id="flow-login-split" sourceRef="log-in" targetRef="parallel-split" />
    <bpmn:sequenceFlow id="flow-split-tweet" sourceRef="parallel-split" targetRef="tweet-friends" />
    <bpmn:sequenceFlow id="flow-split-complete" sourceRef="parallel-split" targetRef="complete-registration" />
    <bpmn:sequenceFlow id="flow-complete-payment" sourceRef="complete-registration" targetRef="provide-payment" />
    <bpmn:sequenceFlow id="flow-tweet-join" sourceRef="tweet-friends" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="flow-payment-join" sourceRef="provide-payment" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="flow-join-ticket" sourceRef="parallel-join" targetRef="receive-ticket" />
    <bpmn:sequenceFlow id="flow-ticket-end" sourceRef="receive-ticket" targetRef="end-success" />
  </bpmn:process>
</bpmn:definitions>
