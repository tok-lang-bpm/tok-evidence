<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="participantLane" name="Participant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leaveWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeTravel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitRunDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runNight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinRunDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appLane" name="App">
        <bpmn:flowNodeRef>selectBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hourGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTime</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fitnessLane" name="Fitness gadgets">
        <bpmn:flowNodeRef>measureTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeGateway</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Want to participate" />
    <bpmn:task id="selectBlock" name="Select a starting block" />
    <bpmn:task id="run5" name="Run for 5km" />
    <bpmn:task id="measureTime" name="Measure the time" />
    <bpmn:exclusiveGateway id="timeGateway" name="Can do it in less than 25 minutes?" default="flowToTrain" />
    <bpmn:task id="trainCheck" name="Train and check" />
    <bpmn:task id="getNumber" name="Get your starting number" />
    <bpmn:task id="findOut" name="Find out whether go there from home or leave directly from work" />
    <bpmn:exclusiveGateway id="hourGateway" name="More than one hour left?" default="flowToLeave" />
    <bpmn:task id="goHome" name="Go there from home" />
    <bpmn:task id="leaveWork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="mergeTravel" name="Travel route merged" />
    <bpmn:parallelGateway id="splitRunDrink" />
    <bpmn:task id="runNight" name="Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="joinRunDrink" />
    <bpmn:task id="receiveTime" name="Receive your final running time" />
    <bpmn:endEvent id="end" name="Process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectBlock" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectBlock" targetRef="run5" />
    <bpmn:sequenceFlow id="f3" sourceRef="run5" targetRef="measureTime" />
    <bpmn:sequenceFlow id="f4" sourceRef="measureTime" targetRef="timeGateway" />
    <bpmn:sequenceFlow id="flowToGet" name="yes" sourceRef="timeGateway" targetRef="getNumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">time &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowToTrain" name="no" sourceRef="timeGateway" targetRef="trainCheck" />
    <bpmn:sequenceFlow id="flowTrainLoop" sourceRef="trainCheck" targetRef="run5" />
    <bpmn:sequenceFlow id="f5" sourceRef="getNumber" targetRef="findOut" />
    <bpmn:sequenceFlow id="f6" sourceRef="findOut" targetRef="hourGateway" />
    <bpmn:sequenceFlow id="flowToHome" name="yes" sourceRef="hourGateway" targetRef="goHome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">hoursLeft &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowToLeave" name="no" sourceRef="hourGateway" targetRef="leaveWork" />
    <bpmn:sequenceFlow id="f7" sourceRef="goHome" targetRef="mergeTravel" />
    <bpmn:sequenceFlow id="f8" sourceRef="leaveWork" targetRef="mergeTravel" />
    <bpmn:sequenceFlow id="f9" sourceRef="mergeTravel" targetRef="splitRunDrink" />
    <bpmn:sequenceFlow id="f10" sourceRef="splitRunDrink" targetRef="runNight" />
    <bpmn:sequenceFlow id="f11" sourceRef="splitRunDrink" targetRef="drink" />
    <bpmn:sequenceFlow id="f12" sourceRef="runNight" targetRef="joinRunDrink" />
    <bpmn:sequenceFlow id="f13" sourceRef="drink" targetRef="joinRunDrink" />
    <bpmn:sequenceFlow id="f14" sourceRef="joinRunDrink" targetRef="receiveTime" />
    <bpmn:sequenceFlow id="f15" sourceRef="receiveTime" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
