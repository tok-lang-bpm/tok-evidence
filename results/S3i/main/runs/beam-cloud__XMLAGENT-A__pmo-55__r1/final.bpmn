<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gelProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coverProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterileGel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwIdent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identAnat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identDopp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identComp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwIdentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>punct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkBR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwBR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeSyr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeTrocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwWire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkLong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkShort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwWireJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkWirePos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwWirePos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />

    <bpmn:task id="prepare" name="Prepare implements" />
    <bpmn:task id="wash" name="Wash hands" />
    <bpmn:task id="sterile" name="Get in sterile clothes" />
    <bpmn:task id="clean" name="Clean puncture area" />
    <bpmn:task id="drape" name="Drape puncture zone" />
    <bpmn:task id="config" name="Configure ultrasound" />
    <bpmn:task id="gelProbe" name="Put gel in probe" />
    <bpmn:task id="coverProbe" name="Cover probe" />
    <bpmn:task id="sterileGel" name="Put sterile gel" />
    <bpmn:task id="posProbe" name="Position probe" />
    <bpmn:task id="posPatient" name="Position patient" />

    <bpmn:exclusiveGateway id="gwIdent" name="Identification method?" />
    <bpmn:task id="identAnat" name="Identify vein using anatomic identification" />
    <bpmn:task id="identDopp" name="Identify vein using doppler identification" />
    <bpmn:task id="identComp" name="Identify vein using compression identification" />
    <bpmn:exclusiveGateway id="gwIdentJoin" />

    <bpmn:task id="anesth" name="Anesthetize patient" />
    <bpmn:task id="punct" name="Puncture patient" />
    <bpmn:task id="checkBR" name="Check blood return" />
    <bpmn:exclusiveGateway id="gwBR" name="Blood return correct?" />
    <bpmn:task id="dropProbe" name="Drop probe" />
    <bpmn:task id="removeSyr" name="Remove syringe" />
    <bpmn:task id="installGW" name="Install guidewire" />
    <bpmn:task id="removeTrocar" name="Remove trocar" />

    <bpmn:exclusiveGateway id="gwWire" name="Wire check method?" />
    <bpmn:task id="checkLong" name="Check wire in long axis" />
    <bpmn:task id="checkShort" name="Check wire in short axis" />
    <bpmn:exclusiveGateway id="gwWireJoin" />
    <bpmn:task id="checkWirePos" name="Check wire position" />
    <bpmn:exclusiveGateway id="gwWirePos" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen pathway" />
    <bpmn:task id="advance" name="Advance catheter" />
    <bpmn:task id="removeGW" name="Remove guidewire" />
    <bpmn:task id="verify" name="Verify flow and reflow" />
    <bpmn:task id="checkCath" name="Check catheter position" />

    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f2" sourceRef="prepare" targetRef="wash" />
    <bpmn:sequenceFlow id="f3" sourceRef="wash" targetRef="sterile" />
    <bpmn:sequenceFlow id="f4" sourceRef="sterile" targetRef="clean" />
    <bpmn:sequenceFlow id="f5" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f6" sourceRef="drape" targetRef="config" />
    <bpmn:sequenceFlow id="f7" sourceRef="config" targetRef="gelProbe" />
    <bpmn:sequenceFlow id="f8" sourceRef="gelProbe" targetRef="coverProbe" />
    <bpmn:sequenceFlow id="f9" sourceRef="coverProbe" targetRef="sterileGel" />
    <bpmn:sequenceFlow id="f10" sourceRef="sterileGel" targetRef="posProbe" />
    <bpmn:sequenceFlow id="f11" sourceRef="posProbe" targetRef="posPatient" />
    <bpmn:sequenceFlow id="f12" sourceRef="posPatient" targetRef="gwIdent" />

    <bpmn:sequenceFlow id="f13" name="anatomic" sourceRef="gwIdent" targetRef="identAnat" />
    <bpmn:sequenceFlow id="f14" name="doppler" sourceRef="gwIdent" targetRef="identDopp" />
    <bpmn:sequenceFlow id="f15" name="compression" sourceRef="gwIdent" targetRef="identComp" />
    <bpmn:sequenceFlow id="f16" sourceRef="identAnat" targetRef="gwIdentJoin" />
    <bpmn:sequenceFlow id="f17" sourceRef="identDopp" targetRef="gwIdentJoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="identComp" targetRef="gwIdentJoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="gwIdentJoin" targetRef="anesth" />

    <bpmn:sequenceFlow id="f20" sourceRef="anesth" targetRef="punct" />
    <bpmn:sequenceFlow id="f21" sourceRef="punct" targetRef="checkBR" />
    <bpmn:sequenceFlow id="f22" sourceRef="checkBR" targetRef="gwBR" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="gwBR" targetRef="punct" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="gwBR" targetRef="dropProbe" />
    <bpmn:sequenceFlow id="f25" sourceRef="dropProbe" targetRef="removeSyr" />
    <bpmn:sequenceFlow id="f26" sourceRef="removeSyr" targetRef="installGW" />
    <bpmn:sequenceFlow id="f27" sourceRef="installGW" targetRef="removeTrocar" />
    <bpmn:sequenceFlow id="f28" sourceRef="removeTrocar" targetRef="gwWire" />

    <bpmn:sequenceFlow id="f29" name="long axis" sourceRef="gwWire" targetRef="checkLong" />
    <bpmn:sequenceFlow id="f30" name="short axis" sourceRef="gwWire" targetRef="checkShort" />
    <bpmn:sequenceFlow id="f31" sourceRef="checkLong" targetRef="gwWireJoin" />
    <bpmn:sequenceFlow id="f32" sourceRef="checkShort" targetRef="gwWireJoin" />
    <bpmn:sequenceFlow id="f33" sourceRef="gwWireJoin" targetRef="checkWirePos" />
    <bpmn:sequenceFlow id="f34" sourceRef="checkWirePos" targetRef="gwWirePos" />
    <bpmn:sequenceFlow id="f35" name="no" sourceRef="gwWirePos" targetRef="punct" />
    <bpmn:sequenceFlow id="f36" name="yes" sourceRef="gwWirePos" targetRef="widen" />
    <bpmn:sequenceFlow id="f37" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f38" sourceRef="advance" targetRef="removeGW" />
    <bpmn:sequenceFlow id="f39" sourceRef="removeGW" targetRef="verify" />
    <bpmn:sequenceFlow id="f40" sourceRef="verify" targetRef="checkCath" />
    <bpmn:sequenceFlow id="f41" sourceRef="checkCath" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
