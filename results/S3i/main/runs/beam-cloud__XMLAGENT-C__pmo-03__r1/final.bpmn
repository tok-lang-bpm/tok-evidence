<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="warehouse" name="Warehouse Staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement Team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Inventory System">
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_expected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_levels</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:task id="signal" name="Signal need to reorder" />
    <bpmn:task id="order" name="Place order with suppliers" />
    <bpmn:task id="update_expected" name="Update inventory system with expected delivery dates" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="inspect" name="Inspect for quality" />
    <bpmn:task id="record" name="Record in system" />
    <bpmn:task id="place" name="Place on shelves or in storage" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="update_levels" name="Update inventory levels after restock" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="monitor" />
    <bpmn:sequenceFlow id="f2" sourceRef="monitor" targetRef="signal" />
    <bpmn:sequenceFlow id="f3" sourceRef="signal" targetRef="order" />
    <bpmn:sequenceFlow id="f4" sourceRef="order" targetRef="update_expected" />
    <bpmn:sequenceFlow id="f5" sourceRef="update_expected" targetRef="receive" />
    <bpmn:sequenceFlow id="f6" sourceRef="receive" targetRef="split" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="inspect" />
    <bpmn:sequenceFlow id="f8" sourceRef="split" targetRef="record" />
    <bpmn:sequenceFlow id="f9" sourceRef="split" targetRef="place" />
    <bpmn:sequenceFlow id="f10" sourceRef="inspect" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="record" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="place" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="join" targetRef="update_levels" />
    <bpmn:sequenceFlow id="f14" sourceRef="update_levels" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
