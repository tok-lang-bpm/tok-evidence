<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identifyNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueRfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveResponses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>siteVisitsDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conductSiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>siteVisitsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beginNegotiations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboardingSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>executeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboardingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need identified" />
    <bpmn:task id="identifyNeed" name="Identify need for new supplier" />
    <bpmn:task id="issueRfp" name="Issue request for proposals" />
    <bpmn:task id="receiveResponses" name="Receive responses from suppliers" />
    <bpmn:task id="evaluateProposals" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="siteVisitsDecision" name="Conduct site visits or interviews?" />
    <bpmn:task id="conductSiteVisits" name="Conduct site visits or interviews" />
    <bpmn:exclusiveGateway id="siteVisitsJoin" />
    <bpmn:task id="selectSupplier" name="Select supplier" />
    <bpmn:task id="beginNegotiations" name="Begin contract negotiations" />
    <bpmn:task id="signContract" name="Sign contract" />
    <bpmn:parallelGateway id="onboardingSplit" />
    <bpmn:task id="onboardSupplier" name="Onboard supplier" />
    <bpmn:task id="executeContract" name="Execute contract" />
    <bpmn:parallelGateway id="onboardingJoin" />
    <bpmn:endEvent id="end" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identifyNeed" />
    <bpmn:sequenceFlow id="f2" sourceRef="identifyNeed" targetRef="issueRfp" />
    <bpmn:sequenceFlow id="f3" sourceRef="issueRfp" targetRef="receiveResponses" />
    <bpmn:sequenceFlow id="f4" sourceRef="receiveResponses" targetRef="evaluateProposals" />
    <bpmn:sequenceFlow id="f5" sourceRef="evaluateProposals" targetRef="siteVisitsDecision" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="siteVisitsDecision" targetRef="conductSiteVisits" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="siteVisitsDecision" targetRef="siteVisitsJoin" />
    <bpmn:sequenceFlow id="f8" sourceRef="conductSiteVisits" targetRef="siteVisitsJoin" />
    <bpmn:sequenceFlow id="f9" sourceRef="siteVisitsJoin" targetRef="selectSupplier" />
    <bpmn:sequenceFlow id="f10" sourceRef="selectSupplier" targetRef="beginNegotiations" />
    <bpmn:sequenceFlow id="f11" sourceRef="beginNegotiations" targetRef="signContract" />
    <bpmn:sequenceFlow id="f12" sourceRef="signContract" targetRef="onboardingSplit" />
    <bpmn:sequenceFlow id="f13" sourceRef="onboardingSplit" targetRef="onboardSupplier" />
    <bpmn:sequenceFlow id="f14" sourceRef="onboardingSplit" targetRef="executeContract" />
    <bpmn:sequenceFlow id="f15" sourceRef="onboardSupplier" targetRef="onboardingJoin" />
    <bpmn:sequenceFlow id="f16" sourceRef="executeContract" targetRef="onboardingJoin" />
    <bpmn:sequenceFlow id="f17" sourceRef="onboardingJoin" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
