<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="rd" name="R&D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="New product idea" />
    <bpmn:task id="identify" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype" />
    <bpmn:task id="test" name="Test the prototype" />
    <bpmn:task id="feedback" name="Collect feedback from testing" />
    <bpmn:exclusiveGateway id="refine_needed" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="outcome" name="Prototype approved or discarded?" />
    <bpmn:endEvent id="approved_end" name="Approved for further development" />
    <bpmn:endEvent id="discarded_end" name="Discarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f3" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="draft" targetRef="select" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f6" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f7" sourceRef="test" targetRef="feedback" />
    <bpmn:sequenceFlow id="f8" sourceRef="feedback" targetRef="refine_needed" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="refine_needed" targetRef="refine" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="refine_needed" targetRef="outcome" />
    <bpmn:sequenceFlow id="f11" sourceRef="refine" targetRef="test" />
    <bpmn:sequenceFlow id="f12" name="approved" sourceRef="outcome" targetRef="approved_end" />
    <bpmn:sequenceFlow id="f13" name="discarded" sourceRef="outcome" targetRef="discarded_end" />
  </bpmn:process>
</bpmn:definitions>