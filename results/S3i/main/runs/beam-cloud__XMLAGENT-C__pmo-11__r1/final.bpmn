assistant to=check_bpmnanalysis xml">
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="CUST" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SYS" name="System">
        <bpmn:flowNodeRef>genAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>triggerBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>termsDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>termsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SUP" name="Support team">
        <bpmn:flowNodeRef>processCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Subscription requested" />
    <bpmn:task id="signup" name="Sign up for the subscription service" />
    <bpmn:task id="genAccount" name="Generate an account" />
    <bpmn:task id="assignAccess" name="Assign access" />
    <bpmn:task id="triggerBilling" name="Trigger automated billing cycles" />
    <bpmn:task id="updates" name="Receive regular updates, product enhancements, or renewal notifications" />
    <bpmn:exclusiveGateway id="cancelDecision" name="Cancel subscription?" />
    <bpmn:task id="submitCancel" name="Submit a cancellation request" />
    <bpmn:task id="processCancel" name="Process the cancellation request" />
    <bpmn:exclusiveGateway id="termsDecision" name="Refunds or charges?" />
    <bpmn:task id="applyRefund" name="Apply a refund" />
    <bpmn:task id="applyCharge" name="Apply charges" />
    <bpmn:exclusiveGateway id="termsMerge" />
    <bpmn:parallelGateway id="finalSplit" />
    <bpmn:task id="deactivate" name="Deactivate the subscription" />
    <bpmn:task id="settleBalance" name="Settle the final account balance" />
    <bpmn:parallelGateway id="finalJoin" />
    <bpmn:endEvent id="end" name="Subscription handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="signup" />
    <bpmn:sequenceFlow id="f2" sourceRef="signup" targetRef="genAccount" />
    <bpmn:sequenceFlow id="f3" sourceRef="genAccount" targetRef="assignAccess" />
    <bpmn:sequenceFlow id="f4" sourceRef="assignAccess" targetRef="triggerBilling" />
    <bpmn:sequenceFlow id="f5" sourceRef="triggerBilling" targetRef="updates" />
    <bpmn:sequenceFlow id="f6" sourceRef="updates" targetRef="cancelDecision" />
    <bpmn:sequenceFlow id="f7" name="cancel" sourceRef="cancelDecision" targetRef="submitCancel" />
    <bpmn:sequenceFlow id="f8" name="continue" sourceRef="cancelDecision" targetRef="updates" />
    <bpmn:sequenceFlow id="f9" sourceRef="submitCancel" targetRef="processCancel" />
    <bpmn:sequenceFlow id="f10" sourceRef="processCancel" targetRef="termsDecision" />
    <bpmn:sequenceFlow id="f11" name="refund" sourceRef="termsDecision" targetRef="applyRefund" />
    <bpmn:sequenceFlow id="f12" name="charge" sourceRef="termsDecision" targetRef="applyCharge" />
    <bpmn:sequenceFlow id="f13" sourceRef="applyRefund" targetRef="termsMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="applyCharge" targetRef="termsMerge" />
    <bpmn:sequenceFlow id="f15" sourceRef="termsMerge" targetRef="finalSplit" />
    <bpmn:sequenceFlow id="f16" sourceRef="finalSplit" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f17" sourceRef="finalSplit" targetRef="settleBalance" />
    <bpmn:sequenceFlow id="f18" sourceRef="deactivate" targetRef="finalJoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="settleBalance" targetRef="finalJoin" />
    <bpmn:sequenceFlow id="f20" sourceRef="finalJoin" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
</rfl:parameter>
