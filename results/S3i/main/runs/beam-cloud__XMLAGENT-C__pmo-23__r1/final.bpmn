<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="banking" name="Banking system">
        <bpmn:flowNodeRef>sendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>displayMsg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Agency">
        <bpmn:flowNodeRef>level1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwImmediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendResultBack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Credit scoring needed" />
    <bpmn:task id="sendReq" name="Send scoring request to agency" />
    <bpmn:task id="level1" name="Do level 1 scoring" />
    <bpmn:exclusiveGateway id="gwImmediate" name="Immediate result?" />
    <bpmn:task id="returnResult" name="Return result to banking system" />
    <bpmn:task id="informDelay" name="Inform banking process of delay" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="displayMsg" name="Display message to check again later" />
    <bpmn:task id="level2" name="Do level 2 scoring" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="sendResultBack" name="Send scoring result to banking process" />
    <bpmn:task id="presentResult" name="Present result to clerk" />
    <bpmn:endEvent id="end" name="Credit scoring complete" />
    <bpmn:sequenceFlow id="f_start_send" sourceRef="start" targetRef="sendReq" />
    <bpmn:sequenceFlow id="f_send_level1" sourceRef="sendReq" targetRef="level1" />
    <bpmn:sequenceFlow id="f_level1_gw" sourceRef="level1" targetRef="gwImmediate" />
    <bpmn:sequenceFlow id="f_yes" name="yes" sourceRef="gwImmediate" targetRef="returnResult" />
    <bpmn:sequenceFlow id="f_no" name="no" sourceRef="gwImmediate" targetRef="informDelay" />
    <bpmn:sequenceFlow id="f_ret_pres" sourceRef="returnResult" targetRef="presentResult" />
    <bpmn:sequenceFlow id="f_inform_split" sourceRef="informDelay" targetRef="split" />
    <bpmn:sequenceFlow id="f_split_display" sourceRef="split" targetRef="displayMsg" />
    <bpmn:sequenceFlow id="f_split_level2" sourceRef="split" targetRef="level2" />
    <bpmn:sequenceFlow id="f_display_join" sourceRef="displayMsg" targetRef="join" />
    <bpmn:sequenceFlow id="f_level2_join" sourceRef="level2" targetRef="join" />
    <bpmn:sequenceFlow id="f_join_send" sourceRef="join" targetRef="sendResultBack" />
    <bpmn:sequenceFlow id="f_send_pres" sourceRef="sendResultBack" targetRef="presentResult" />
    <bpmn:sequenceFlow id="f_pres_end" sourceRef="presentResult" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
