<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORGANISATION" name="Organisation" processRef="FIND_JOB_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="FIND_JOB_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="YOU" name="You">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REPORT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RECEIVE_OFFERS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INTERVIEW_GATEWAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NEGOTIATE_INTERVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INTERVIEW_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ENTER_PROBATION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RATING_SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RATE_COMPANY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RATING_JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PERMANENT_GATEWAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LOW_RATING_GATEWAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONTINUE_OFFERS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_FOUND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_CONTINUE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="COMPANIES" name="Companies">
        <bpmn:flowNodeRef>CONFIRM_RECEIPT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RATE_APPLICATION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WANTS_GATEWAY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RATE_YOU</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="START" name="Find a job" />

    <bpmn:task id="REPORT" name="Report to which companies you wrote job applications" />
    <bpmn:task id="RECEIVE_OFFERS" name="Receive new potential job offers" />
    <bpmn:task id="CONFIRM_RECEIPT" name="Confirm receipt of job application" />
    <bpmn:task id="RATE_APPLICATION" name="Rate the application" />
    <bpmn:exclusiveGateway id="INTERVIEW_GATEWAY" name="Negotiate job interview?" default="F7" />
    <bpmn:task id="NEGOTIATE_INTERVIEW" name="Negotiate a job interview" />
    <bpmn:exclusiveGateway id="INTERVIEW_MERGE" />
    <bpmn:exclusiveGateway id="WANTS_GATEWAY" name="Company wants you to work for them?" default="F11" />
    <bpmn:task id="ENTER_PROBATION" name="Enter the probation phase" />
    <bpmn:parallelGateway id="RATING_SPLIT" />
    <bpmn:task id="RATE_COMPANY" name="Rate the company" />
    <bpmn:task id="RATE_YOU" name="Rate you" />
    <bpmn:parallelGateway id="RATING_JOIN" />
    <bpmn:exclusiveGateway id="PERMANENT_GATEWAY" name="Job becomes permanent?" default="F19" />
    <bpmn:exclusiveGateway id="LOW_RATING_GATEWAY" name="Rated company C or less?" default="F21" />
    <bpmn:task id="CONTINUE_OFFERS" name="Continue to receive job offers" />
    <bpmn:endEvent id="END_FOUND" name="Job becomes permanent" />
    <bpmn:endEvent id="END_CONTINUE" name="Continue receiving job offers" />

    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="REPORT" />
    <bpmn:sequenceFlow id="F2" sourceRef="REPORT" targetRef="RECEIVE_OFFERS" />
    <bpmn:sequenceFlow id="F3" sourceRef="RECEIVE_OFFERS" targetRef="CONFIRM_RECEIPT" />
    <bpmn:sequenceFlow id="F4" sourceRef="CONFIRM_RECEIPT" targetRef="RATE_APPLICATION" />
    <bpmn:sequenceFlow id="F5" sourceRef="RATE_APPLICATION" targetRef="INTERVIEW_GATEWAY" />
    <bpmn:sequenceFlow id="F6" name="yes" sourceRef="INTERVIEW_GATEWAY" targetRef="NEGOTIATE_INTERVIEW" />
    <bpmn:sequenceFlow id="F7" name="no" sourceRef="INTERVIEW_GATEWAY" targetRef="INTERVIEW_MERGE" />
    <bpmn:sequenceFlow id="F8" sourceRef="NEGOTIATE_INTERVIEW" targetRef="INTERVIEW_MERGE" />
    <bpmn:sequenceFlow id="F9" sourceRef="INTERVIEW_MERGE" targetRef="WANTS_GATEWAY" />
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="WANTS_GATEWAY" targetRef="ENTER_PROBATION" />
    <bpmn:sequenceFlow id="F11" name="no" sourceRef="WANTS_GATEWAY" targetRef="REPORT" />
    <bpmn:sequenceFlow id="F12" sourceRef="ENTER_PROBATION" targetRef="RATING_SPLIT" />
    <bpmn:sequenceFlow id="F13" sourceRef="RATING_SPLIT" targetRef="RATE_COMPANY" />
    <bpmn:sequenceFlow id="F14" sourceRef="RATING_SPLIT" targetRef="RATE_YOU" />
    <bpmn:sequenceFlow id="F15" sourceRef="RATE_COMPANY" targetRef="RATING_JOIN" />
    <bpmn:sequenceFlow id="F16" sourceRef="RATE_YOU" targetRef="RATING_JOIN" />
    <bpmn:sequenceFlow id="F17" sourceRef="RATING_JOIN" targetRef="PERMANENT_GATEWAY" />
    <bpmn:sequenceFlow id="F18" name="yes" sourceRef="PERMANENT_GATEWAY" targetRef="LOW_RATING_GATEWAY" />
    <bpmn:sequenceFlow id="F19" name="no" sourceRef="PERMANENT_GATEWAY" targetRef="REPORT" />
    <bpmn:sequenceFlow id="F20" name="yes" sourceRef="LOW_RATING_GATEWAY" targetRef="CONTINUE_OFFERS" />
    <bpmn:sequenceFlow id="F21" name="no" sourceRef="LOW_RATING_GATEWAY" targetRef="END_FOUND" />
    <bpmn:sequenceFlow id="F22" sourceRef="CONTINUE_OFFERS" targetRef="END_CONTINUE" />
  </bpmn:process>
</bpmn:definitions>
