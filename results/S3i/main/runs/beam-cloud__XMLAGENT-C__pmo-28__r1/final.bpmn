<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="intern" name="Intern">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterTopicMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterExpHobbies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denyOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidateOther</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgWorkSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updI1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updI2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updI3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgWorkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwRecommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgTweetSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgTweetJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>updC1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updC3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enterTopicMoney" name="Enter topic and money" />
    <bpmn:task id="enterExpHobbies" name="Enter experience and hobbies" />
    <bpmn:task id="receiveOffers" name="Receive offers" />
    <bpmn:exclusiveGateway id="gwAccept" name="Accept offer?" />
    <bpmn:task id="denyOffer" name="Deny offer" />
    <bpmn:task id="acceptOffer" name="Accept offer" />
    <bpmn:task id="invalidateOther" name="Invalidate other offers" />
    <bpmn:parallelGateway id="pgWorkSplit" />
    <bpmn:task id="updI1" name="Write status update" />
    <bpmn:task id="updI2" name="Write status update" />
    <bpmn:task id="updI3" name="Write status update" />
    <bpmn:task id="updC1" name="Write status update about you" />
    <bpmn:task id="updC2" name="Write status update about you" />
    <bpmn:task id="updC3" name="Write status update about you" />
    <bpmn:parallelGateway id="pgWorkJoin" />
    <bpmn:exclusiveGateway id="gwRecommend" name="Recommend company?" />
    <bpmn:parallelGateway id="pgTweetSplit" />
    <bpmn:task id="tweet1" name="Send tweet" />
    <bpmn:task id="tweet2" name="Send tweet" />
    <bpmn:task id="tweet3" name="Send tweet" />
    <bpmn:parallelGateway id="pgTweetJoin" />
    <bpmn:endEvent id="endNoRec" name="End" />
    <bpmn:endEvent id="endRec" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enterTopicMoney" />
    <bpmn:sequenceFlow id="f2" sourceRef="enterTopicMoney" targetRef="enterExpHobbies" />
    <bpmn:sequenceFlow id="f3" sourceRef="enterExpHobbies" targetRef="receiveOffers" />
    <bpmn:sequenceFlow id="f4" sourceRef="receiveOffers" targetRef="gwAccept" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gwAccept" targetRef="denyOffer" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="gwAccept" targetRef="acceptOffer" />
    <bpmn:sequenceFlow id="f7" sourceRef="denyOffer" targetRef="receiveOffers" />
    <bpmn:sequenceFlow id="f8" sourceRef="acceptOffer" targetRef="invalidateOther" />
    <bpmn:sequenceFlow id="f9" sourceRef="invalidateOther" targetRef="pgWorkSplit" />
    <bpmn:sequenceFlow id="f10" sourceRef="pgWorkSplit" targetRef="updI1" />
    <bpmn:sequenceFlow id="f11" sourceRef="pgWorkSplit" targetRef="updC1" />
    <bpmn:sequenceFlow id="f12" sourceRef="updI1" targetRef="updI2" />
    <bpmn:sequenceFlow id="f13" sourceRef="updI2" targetRef="updI3" />
    <bpmn:sequenceFlow id="f14" sourceRef="updI3" targetRef="pgWorkJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="updC1" targetRef="updC2" />
    <bpmn:sequenceFlow id="f16" sourceRef="updC2" targetRef="updC3" />
    <bpmn:sequenceFlow id="f17" sourceRef="updC3" targetRef="pgWorkJoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="pgWorkJoin" targetRef="gwRecommend" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="gwRecommend" targetRef="endNoRec" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="gwRecommend" targetRef="pgTweetSplit" />
    <bpmn:sequenceFlow id="f21" sourceRef="pgTweetSplit" targetRef="tweet1" />
    <bpmn:sequenceFlow id="f22" sourceRef="pgTweetSplit" targetRef="tweet2" />
    <bpmn:sequenceFlow id="f23" sourceRef="pgTweetSplit" targetRef="tweet3" />
    <bpmn:sequenceFlow id="f24" sourceRef="tweet1" targetRef="pgTweetJoin" />
    <bpmn:sequenceFlow id="f25" sourceRef="tweet2" targetRef="pgTweetJoin" />
    <bpmn:sequenceFlow id="f26" sourceRef="tweet3" targetRef="pgTweetJoin" />
    <bpmn:sequenceFlow id="f27" sourceRef="pgTweetJoin" targetRef="endRec" />
  </bpmn:process>
</bpmn:definitions>
