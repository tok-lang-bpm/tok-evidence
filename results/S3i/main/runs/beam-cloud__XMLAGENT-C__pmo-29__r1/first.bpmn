<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>organize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visaForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travelDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>otherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noGrounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additionalDocsGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestAdditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additionalDocsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contactRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findOffices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representation" name="Representation Office">
        <bpmn:flowNodeRef>destinationGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>destinationMain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>destinationEqual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>destinationFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>destinationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>categoryGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consularDistrict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exceptionalGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claimExceptional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyConsular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exceptionalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyAustrian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>centreInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>categoryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issuingGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueRepresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issuingMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="border" name="Border Control Post">
        <bpmn:flowNodeRef>issueBorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="State Police Headquarters">
        <bpmn:flowNodeRef>extendVisa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need to work and live in Austria" />
    <bpmn:task id="checkReq" name="Check requirements for working and living in Austria" />
    <bpmn:parallelGateway id="parallelSplit" />
    <bpmn:task id="organize" name="Organize accommodation and bank account" />
    <bpmn:task id="visaForm" name="Complete visa application form" />
    <bpmn:task id="travelDoc" name="Verify travel document validity" />
    <bpmn:task id="photo" name="Provide passport photo" />
    <bpmn:task id="insurance" name="Present travel health insurance" />
    <bpmn:task id="means" name="Prove sufficient means of subsistence" />
    <bpmn:task id="otherEvidence" name="Collect other evidence requested by authorities" />
    <bpmn:task id="noGrounds" name="Confirm absence of other grounds for refusal" />
    <bpmn:exclusiveGateway id="additionalDocsGate" name="Additional documents requested?" />
    <bpmn:task id="requestAdditional" name="Request additional documents" />
    <bpmn:exclusiveGateway id="additionalDocsMerge" />
    <bpmn:task id="contactRep" name="Contact representation in advance" />
    <bpmn:exclusiveGateway id="destinationGate" name="Main travel destination?" />
    <bpmn:task id="destinationMain" name="Determine representation office by main travel destination" />
    <bpmn:task id="destinationEqual" name="Determine competent office by length and purpose of stay" />
    <bpmn:task id="destinationFirst" name="Determine member country of first entry" />
    <bpmn:exclusiveGateway id="destinationMerge" />
    <bpmn:exclusiveGateway id="categoryGate" name="Visa category?" />
    <bpmn:task id="consularDistrict" name="Determine consular district of legal residence" />
    <bpmn:exclusiveGateway id="exceptionalGate" name="Exceptional competence justified?" />
    <bpmn:task id="claimExceptional" name="Claim exceptional competence" />
    <bpmn:task id="applyConsular" name="Apply in consular district" />
    <bpmn:exclusiveGateway id="exceptionalMerge" />
    <bpmn:task id="applyAustrian" name="Apply at competent Austrian representation" />
    <bpmn:task id="centreInterest" name="Determine place of residence i.e. centre of interest" />
    <bpmn:exclusiveGateway id="categoryMerge" />
    <bpmn:task id="findOffices" name="Find representation offices on BMEIA website" />
    <bpmn:exclusiveGateway id="issuingGate" name="Issuing authority?" />
    <bpmn:task id="issueRepresentation" name="Issue visa by representation office" />
    <bpmn:task id="issueBorder" name="Issue visa by border control post" />
    <bpmn:task id="extendVisa" name="Extend visa by state police headquarters" />
    <bpmn:exclusiveGateway id="issuingMerge" />
    <bpmn:parallelGateway id="parallelJoin" />
    <bpmn:endEvent id="end" name="Ready to work and live in Austria" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkReq" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkReq" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="f3" sourceRef="parallelSplit" targetRef="organize" />
    <bpmn:sequenceFlow id="f4" sourceRef="organize" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f5" sourceRef="parallelSplit" targetRef="visaForm" />
    <bpmn:sequenceFlow id="f6" sourceRef="visaForm" targetRef="travelDoc" />
    <bpmn:sequenceFlow id="f7" sourceRef="travelDoc" targetRef="photo" />
    <bpmn:sequenceFlow id="f8" sourceRef="photo" targetRef="insurance" />
    <bpmn:sequenceFlow id="f9" sourceRef="insurance" targetRef="means" />
    <bpmn:sequenceFlow id="f10" sourceRef="means" targetRef="otherEvidence" />
    <bpmn:sequenceFlow id="f11" sourceRef="otherEvidence" targetRef="noGrounds" />
    <bpmn:sequenceFlow id="f12" sourceRef="noGrounds" targetRef="additionalDocsGate" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="additionalDocsGate" targetRef="requestAdditional" />
    <bpmn:sequenceFlow id="f14" sourceRef="requestAdditional" targetRef="additionalDocsMerge" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="additionalDocsGate" targetRef="additionalDocsMerge" />
    <bpmn:sequenceFlow id="f16" sourceRef="additionalDocsMerge" targetRef="contactRep" />
    <bpmn:sequenceFlow id="f17" sourceRef="contactRep" targetRef="destinationGate" />
    <bpmn:sequenceFlow id="f18" name="main destination determinable" sourceRef="destinationGate" targetRef="destinationMain" />
    <bpmn:sequenceFlow id="f19" name="equal time in several countries" sourceRef="destinationGate" targetRef="destinationEqual" />
    <bpmn:sequenceFlow id="f20" name="main destination not determinable" sourceRef="destinationGate" targetRef="destinationFirst" />
    <bpmn:sequenceFlow id="f21" sourceRef="destinationMain" targetRef="destinationMerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="destinationEqual" targetRef="destinationMerge" />
    <bpmn:sequenceFlow id="f23" sourceRef="destinationFirst" targetRef="destinationMerge" />
    <bpmn:sequenceFlow id="f24" sourceRef="destinationMerge" targetRef="categoryGate" />
    <bpmn:sequenceFlow id="f25" name="category A or C" sourceRef="categoryGate" targetRef="consularDistrict" />
    <bpmn:sequenceFlow id="f26" sourceRef="consularDistrict" targetRef="exceptionalGate" />
    <bpmn:sequenceFlow id="f27" name="justified" sourceRef="exceptionalGate" targetRef="claimExceptional" />
    <bpmn:sequenceFlow id="f28" name="not justified" sourceRef="exceptionalGate" targetRef="applyConsular" />
    <bpmn:sequenceFlow id="f29" sourceRef="claimExceptional" targetRef="exceptionalMerge" />
    <bpmn:sequenceFlow id="f30" sourceRef="applyConsular" targetRef="exceptionalMerge" />
    <bpmn:sequenceFlow id="f31" sourceRef="exceptionalMerge" targetRef="categoryMerge" />
    <bpmn:sequenceFlow id="f32" name="type D" sourceRef="categoryGate" targetRef="applyAustrian" />
    <bpmn:sequenceFlow id="f33" sourceRef="applyAustrian" targetRef="centreInterest" />
    <bpmn:sequenceFlow id="f34" sourceRef="centreInterest" targetRef="categoryMerge" />
    <bpmn:sequenceFlow id="f35" sourceRef="categoryMerge" targetRef="findOffices" />
    <bpmn:sequenceFlow id="f36" sourceRef="findOffices" targetRef="issuingGate" />
    <bpmn:sequenceFlow id="f37" name="representation office" sourceRef="issuingGate" targetRef="issueRepresentation" />
    <bpmn:sequenceFlow id="f38" name="border control post" sourceRef="issuingGate" targetRef="issueBorder" />
    <bpmn:sequenceFlow id="f39" name="extension permitted" sourceRef="issuingGate" targetRef="extendVisa" />
    <bpmn:sequenceFlow id="f40" sourceRef="issueRepresentation" targetRef="issuingMerge" />
    <bpmn:sequenceFlow id="f41" sourceRef="issueBorder" targetRef="issuingMerge" />
    <bpmn:sequenceFlow id="f42" sourceRef="extendVisa" targetRef="issuingMerge" />
    <bpmn:sequenceFlow id="f43" sourceRef="issuingMerge" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f44" sourceRef="parallelJoin" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
