<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-date-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint-another-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree-another</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games-missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games-merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer-merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="LAN party planned" />
    <bpmn:task id="send-invitations" name="Send invitations to these 10 friends" />
    <bpmn:task id="find-games" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="parallel-date-games" />
    <bpmn:task id="appoint-date" name="Appoint a date when the LAN party is going to happen" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree on this date?" />
    <bpmn:task id="appoint-another-date" name="Appoint another date" />
    <bpmn:exclusiveGateway id="agree-another" name="8 or more people agree on this date?" />
    <bpmn:task id="check-games" name="Find out if you have all the games your guests want to play" />
    <bpmn:exclusiveGateway id="games-missing" name="Some games missing?" />
    <bpmn:task id="download-games" name="Download them" />
    <bpmn:exclusiveGateway id="games-merged" />
    <bpmn:parallelGateway id="parallel-join" />
    <bpmn:task id="find-beer" name="Find out how much beer your friends will require" />
    <bpmn:exclusiveGateway id="enough-beer" name="Enough beer?" />
    <bpmn:task id="buy-beer" name="Buy what's missing" />
    <bpmn:exclusiveGateway id="beer-merged" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="end" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send-invitations" />
    <bpmn:sequenceFlow id="f2" sourceRef="send-invitations" targetRef="find-games" />
    <bpmn:sequenceFlow id="f3" sourceRef="find-games" targetRef="parallel-date-games" />
    <bpmn:sequenceFlow id="f4" sourceRef="parallel-date-games" targetRef="appoint-date" />
    <bpmn:sequenceFlow id="f5" sourceRef="parallel-date-games" targetRef="check-games" />
    <bpmn:sequenceFlow id="f6" sourceRef="appoint-date" targetRef="agree" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="agree" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="agree" targetRef="appoint-another-date" />
    <bpmn:sequenceFlow id="f9" sourceRef="appoint-another-date" targetRef="agree-another" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="agree-another" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="agree-another" targetRef="appoint-another-date" />
    <bpmn:sequenceFlow id="f12" sourceRef="check-games" targetRef="games-missing" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="games-missing" targetRef="download-games" />
    <bpmn:sequenceFlow id="f14" sourceRef="download-games" targetRef="games-merged" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="games-missing" targetRef="games-merged" />
    <bpmn:sequenceFlow id="f16" sourceRef="games-merged" targetRef="parallel-join" />
    <bpmn:sequenceFlow id="f17" sourceRef="parallel-join" targetRef="find-beer" />
    <bpmn:sequenceFlow id="f18" sourceRef="find-beer" targetRef="enough-beer" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="enough-beer" targetRef="beer-merged" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="enough-beer" targetRef="buy-beer" />
    <bpmn:sequenceFlow id="f21" sourceRef="buy-beer" targetRef="beer-merged" />
    <bpmn:sequenceFlow id="f22" sourceRef="beer-merged" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f23" sourceRef="enjoy" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
