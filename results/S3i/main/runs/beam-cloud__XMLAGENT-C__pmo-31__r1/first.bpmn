<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Blizzard" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkBN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasBN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clickLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bnMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterCC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterIBAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>subMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectRRC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>thinkNames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nameAvail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getSelfies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Create a WoW character" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="checkBN" name="Check for a battle.net account" />
    <bpmn:exclusiveGateway id="hasBN" name="Has a battle.net account?" />
    <bpmn:task id="enterAcct" name="Enter account information" />
    <bpmn:task id="clickLink" name="Click the confirmation link" />
    <bpmn:exclusiveGateway id="bnMerge" />
    <bpmn:task id="checkSub" name="Check for an active WoW subscription" />
    <bpmn:exclusiveGateway id="hasSub" name="Has an active WoW subscription?" />
    <bpmn:exclusiveGateway id="payMethod" name="Select a payment method" />
    <bpmn:task id="enterCC" name="Enter credit card information" />
    <bpmn:task id="enterIBAN" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="payMerge" />
    <bpmn:exclusiveGateway id="subMerge" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="selectRRC" name="Select realm, race and class" />
    <bpmn:task id="thinkNames" name="Come up with good character names" />
    <bpmn:parallelGateway id="joinParallel" />
    <bpmn:task id="enterName" name="Enter a character name" />
    <bpmn:exclusiveGateway id="nameAvail" name="Is the name available?" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="getConfirm" name="Receive a confirmation" />
    <bpmn:task id="getSelfies" name="Receive selfies of your character" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="getMessage" name="Receive another message when the expansion is released" />
    <bpmn:endEvent id="done" name="Character created" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="split1" />
    <bpmn:sequenceFlow id="f2" sourceRef="split1" targetRef="checkBN" />
    <bpmn:sequenceFlow id="f3" sourceRef="split1" targetRef="thinkNames" />
    <bpmn:sequenceFlow id="f4" sourceRef="checkBN" targetRef="hasBN" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="hasBN" targetRef="bnMerge" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="hasBN" targetRef="enterAcct" />
    <bpmn:sequenceFlow id="f7" sourceRef="enterAcct" targetRef="clickLink" />
    <bpmn:sequenceFlow id="f8" sourceRef="clickLink" targetRef="bnMerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="bnMerge" targetRef="checkSub" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkSub" targetRef="hasSub" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="hasSub" targetRef="subMerge" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="hasSub" targetRef="payMethod" />
    <bpmn:sequenceFlow id="f13" name="Credit card" sourceRef="payMethod" targetRef="enterCC" />
    <bpmn:sequenceFlow id="f14" name="Bank account" sourceRef="payMethod" targetRef="enterIBAN" />
    <bpmn:sequenceFlow id="f15" sourceRef="enterCC" targetRef="payMerge" />
    <bpmn:sequenceFlow id="f16" sourceRef="enterIBAN" targetRef="payMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="payMerge" targetRef="subMerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="subMerge" targetRef="login" />
    <bpmn:sequenceFlow id="f19" sourceRef="login" targetRef="selectRRC" />
    <bpmn:sequenceFlow id="f20" sourceRef="selectRRC" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f21" sourceRef="thinkNames" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f22" sourceRef="joinParallel" targetRef="enterName" />
    <bpmn:sequenceFlow id="f23" sourceRef="enterName" targetRef="nameAvail" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="nameAvail" targetRef="split2" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="nameAvail" targetRef="enterName" />
    <bpmn:sequenceFlow id="f26" sourceRef="split2" targetRef="getConfirm" />
    <bpmn:sequenceFlow id="f27" sourceRef="split2" targetRef="getSelfies" />
    <bpmn:sequenceFlow id="f28" sourceRef="getConfirm" targetRef="join2" />
    <bpmn:sequenceFlow id="f29" sourceRef="getSelfies" targetRef="join2" />
    <bpmn:sequenceFlow id="f30" sourceRef="join2" targetRef="getMessage" />
    <bpmn:sequenceFlow id="f31" sourceRef="getMessage" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>