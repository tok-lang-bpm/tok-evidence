<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="luxury-airplane" name="Luxury Airplane Organisation" processRef="luxury-airplane-process" />
  </bpmn:collaboration>
  <bpmn:process id="luxury-airplane-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide-specifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>receive-specifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-manufacturing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join-manufacturing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble-interior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-test-flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-test-protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver-plane</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian-team" name="Russian team">
        <bpmn:flowNodeRef>manufacture-vodka-bar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish-team" name="Irish team">
        <bpmn:flowNodeRef>manufacture-whiskey-bar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Airplane requested" />

    <bpmn:task id="decide-specifications" name="Decide interior specifications" />
    <bpmn:task id="receive-specifications" name="Receive specifications" />
    <bpmn:task id="send-requirements" name="Send requirements to teams" />
    <bpmn:parallelGateway id="split-manufacturing" />
    <bpmn:task id="manufacture-vodka-bar" name="Manufacture vodka bar" />
    <bpmn:task id="manufacture-whiskey-bar" name="Manufacture whiskey bar" />
    <bpmn:parallelGateway id="join-manufacturing" />
    <bpmn:task id="assemble-interior" name="Assemble interior" />
    <bpmn:task id="send-test-flight" name="Send plane on test flight" />
    <bpmn:task id="create-test-protocol" name="Create test protocol" />
    <bpmn:task id="deliver-plane" name="Deliver plane to customer" />
    <bpmn:task id="confirm-delivery" name="Confirm delivery" />
    <bpmn:endEvent id="end" name="Airplane delivered" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="decide-specifications" />
    <bpmn:sequenceFlow id="f2" sourceRef="decide-specifications" targetRef="receive-specifications" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive-specifications" targetRef="send-requirements" />
    <bpmn:sequenceFlow id="f4" sourceRef="send-requirements" targetRef="split-manufacturing" />
    <bpmn:sequenceFlow id="f5" sourceRef="split-manufacturing" targetRef="manufacture-vodka-bar" />
    <bpmn:sequenceFlow id="f6" sourceRef="split-manufacturing" targetRef="manufacture-whiskey-bar" />
    <bpmn:sequenceFlow id="f7" sourceRef="manufacture-vodka-bar" targetRef="join-manufacturing" />
    <bpmn:sequenceFlow id="f8" sourceRef="manufacture-whiskey-bar" targetRef="join-manufacturing" />
    <bpmn:sequenceFlow id="f9" sourceRef="join-manufacturing" targetRef="assemble-interior" />
    <bpmn:sequenceFlow id="f10" sourceRef="assemble-interior" targetRef="send-test-flight" />
    <bpmn:sequenceFlow id="f11" sourceRef="send-test-flight" targetRef="create-test-protocol" />
    <bpmn:sequenceFlow id="f12" sourceRef="create-test-protocol" targetRef="deliver-plane" />
    <bpmn:sequenceFlow id="f13" sourceRef="deliver-plane" targetRef="confirm-delivery" />
    <bpmn:sequenceFlow id="f14" sourceRef="confirm-delivery" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
