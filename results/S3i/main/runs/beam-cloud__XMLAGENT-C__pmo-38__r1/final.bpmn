<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="YOU" name="You">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refineDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moreRefinement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createMaterialsList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMessages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createAttendeeList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ARCHITECT" name="Tree house architect">
        <bpmn:flowNodeRef>sendDraft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FRIENDS" name="Friends">
        <bpmn:flowNodeRef>buildHouse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="STORES" name="Online stores">
        <bpmn:flowNodeRef>processOrder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Want to build a tree house" />
    <bpmn:task id="collectRequirements" name="Collect your requirements" />
    <bpmn:task id="sendRequirements" name="Send requirements to architect" />
    <bpmn:task id="sendDraft" name="Send back a draft" />
    <bpmn:task id="refineDraft" name="Refine draft with additional requirements" />
    <bpmn:exclusiveGateway id="moreRefinement" name="More refinement needed?" />
    <bpmn:task id="createMaterialsList" name="Create list of needed materials from plan" />
    <bpmn:task id="orderMaterials" name="Order materials from online stores" />
    <bpmn:parallelGateway id="orderFork" />
    <bpmn:task id="processOrder" name="Process the order" />
    <bpmn:task id="sendMessages" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="orderJoin" />
    <bpmn:task id="buildHouse" name="Build the house" />
    <bpmn:task id="sendInvitations" name="Send invitations for tree house party" />
    <bpmn:task id="createAttendeeList" name="Create list of people attending" />
    <bpmn:endEvent id="end" name="House built and party planned" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collectRequirements" />
    <bpmn:sequenceFlow id="f2" sourceRef="collectRequirements" targetRef="sendRequirements" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendRequirements" targetRef="sendDraft" />
    <bpmn:sequenceFlow id="f4" sourceRef="sendDraft" targetRef="refineDraft" />
    <bpmn:sequenceFlow id="f5" sourceRef="refineDraft" targetRef="moreRefinement" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="moreRefinement" targetRef="refineDraft" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="moreRefinement" targetRef="createMaterialsList" />
    <bpmn:sequenceFlow id="f8" sourceRef="createMaterialsList" targetRef="orderMaterials" />
    <bpmn:sequenceFlow id="f9" sourceRef="orderMaterials" targetRef="orderFork" />
    <bpmn:sequenceFlow id="f10" sourceRef="orderFork" targetRef="processOrder" />
    <bpmn:sequenceFlow id="f11" sourceRef="orderFork" targetRef="sendMessages" />
    <bpmn:sequenceFlow id="f12" sourceRef="processOrder" targetRef="orderJoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="sendMessages" targetRef="orderJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="orderJoin" targetRef="buildHouse" />
    <bpmn:sequenceFlow id="f15" sourceRef="buildHouse" targetRef="sendInvitations" />
    <bpmn:sequenceFlow id="f16" sourceRef="sendInvitations" targetRef="createAttendeeList" />
    <bpmn:sequenceFlow id="f17" sourceRef="createAttendeeList" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
