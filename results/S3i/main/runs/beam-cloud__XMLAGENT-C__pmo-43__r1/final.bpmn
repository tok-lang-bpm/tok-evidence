assistant to=check_bpmnanalysis xml">
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Car Service" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not-registered-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fined-end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>go-to-service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status-updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enter-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter-next-service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>service-complete-end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Service necessary" />
    <bpmn:task id="check" name="Check if your car is still registered" />
    <bpmn:exclusiveGateway id="registered" name="Car still registered?" />
    <bpmn:task id="notify" name="Notify you" />
    <bpmn:exclusiveGateway id="go-to-service" name="Do you go to the service?" />
    <bpmn:task id="fine" name="Fine you after 30 days" />
    <bpmn:task id="enter-problems" name="Enter the problems of your car for reference" />
    <bpmn:task id="status-updates" name="Get status updates via email" />
    <bpmn:task id="pay" name="Pay through the app" />
    <bpmn:task id="enter-repair" name="Enter that the repair was successful and you got your Pickerl" />
    <bpmn:task id="enter-next-service" name="Enter the time for your next service" />
    <bpmn:endEvent id="not-registered-end" name="Car not registered" />
    <bpmn:endEvent id="fined-end" name="You are fined" />
    <bpmn:endEvent id="service-complete-end" name="Service complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f2" sourceRef="check" targetRef="registered" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="registered" targetRef="notify" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="registered" targetRef="not-registered-end" />
    <bpmn:sequenceFlow id="f5" sourceRef="notify" targetRef="go-to-service" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="go-to-service" targetRef="enter-problems" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="go-to-service" targetRef="fine" />
    <bpmn:sequenceFlow id="f8" sourceRef="fine" targetRef="fined-end" />
    <bpmn:sequenceFlow id="f9" sourceRef="enter-problems" targetRef="status-updates" />
    <bpmn:sequenceFlow id="f10" sourceRef="status-updates" targetRef="pay" />
    <bpmn:sequenceFlow id="f11" sourceRef="pay" targetRef="enter-repair" />
    <bpmn:sequenceFlow id="f12" sourceRef="enter-repair" targetRef="enter-next-service" />
    <bpmn:sequenceFlow id="f13" sourceRef="enter-next-service" targetRef="service-complete-end" />
  </bpmn:process>
</bpmn:definitions>
