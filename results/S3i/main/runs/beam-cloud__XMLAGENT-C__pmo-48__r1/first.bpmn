<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="participant" name="Participant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectStartingBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5km</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measureTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under25Minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trainAndCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getStartingNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findTravelOption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travelChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goFromHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leaveFromWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travelChoiceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runAndDrinkSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runAtNightRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinkAtNightRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runAndDrinkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveFinalTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Want to participate" />
    <bpmn:task id="selectStartingBlock" name="Select starting block" />
    <bpmn:task id="run5km" name="Run for 5km" />
    <bpmn:task id="measureTime" name="Measure the time" />
    <bpmn:exclusiveGateway id="under25Minutes" name="Under 25 minutes?" />
    <bpmn:task id="trainAndCheck" name="Train and check" />
    <bpmn:task id="getStartingNumber" name="Get starting number" />
    <bpmn:task id="findTravelOption" name="Find out travel option" />
    <bpmn:exclusiveGateway id="travelChoice" name="More than one hour left?" />
    <bpmn:task id="goFromHome" name="Go there from home" />
    <bpmn:task id="leaveFromWork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="travelChoiceMerge" name="Travel option chosen" />
    <bpmn:parallelGateway id="runAndDrinkSplit" name="Run and drink" />
    <bpmn:task id="runAtNightRun" name="Run" />
    <bpmn:task id="drinkAtNightRun" name="Drink" />
    <bpmn:parallelGateway id="runAndDrinkJoin" />
    <bpmn:task id="receiveFinalTime" name="Receive final running time" />
    <bpmn:endEvent id="end" name="Final running time received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectStartingBlock" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectStartingBlock" targetRef="run5km" />
    <bpmn:sequenceFlow id="f3" sourceRef="run5km" targetRef="measureTime" />
    <bpmn:sequenceFlow id="f4" sourceRef="measureTime" targetRef="under25Minutes" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="under25Minutes" targetRef="getStartingNumber" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="under25Minutes" targetRef="trainAndCheck" />
    <bpmn:sequenceFlow id="f7" sourceRef="trainAndCheck" targetRef="under25Minutes" />
    <bpmn:sequenceFlow id="f8" sourceRef="getStartingNumber" targetRef="findTravelOption" />
    <bpmn:sequenceFlow id="f9" sourceRef="findTravelOption" targetRef="travelChoice" />
    <bpmn:sequenceFlow id="f10" name="more than one hour" sourceRef="travelChoice" targetRef="goFromHome" />
    <bpmn:sequenceFlow id="f11" name="one hour or less" sourceRef="travelChoice" targetRef="leaveFromWork" />
    <bpmn:sequenceFlow id="f12" sourceRef="goFromHome" targetRef="travelChoiceMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="leaveFromWork" targetRef="travelChoiceMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="travelChoiceMerge" targetRef="runAndDrinkSplit" />
    <bpmn:sequenceFlow id="f15" sourceRef="runAndDrinkSplit" targetRef="runAtNightRun" />
    <bpmn:sequenceFlow id="f16" sourceRef="runAndDrinkSplit" targetRef="drinkAtNightRun" />
    <bpmn:sequenceFlow id="f17" sourceRef="runAtNightRun" targetRef="runAndDrinkJoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="drinkAtNightRun" targetRef="runAndDrinkJoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="runAndDrinkJoin" targetRef="receiveFinalTime" />
    <bpmn:sequenceFlow id="f20" sourceRef="receiveFinalTime" targetRef="end" />
  </bpmn:process>
</bpmn:definitions></tool_call>