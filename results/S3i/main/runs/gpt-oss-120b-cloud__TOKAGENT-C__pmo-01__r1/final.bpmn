<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Product inquiry and order process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Product inquiry and order process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="customer" name="Potential Customer">
        <bpmn:flowNodeRef>start_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Staff">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_inquiry" name="Process start" />
    <bpmn:task id="inquire" name="Inquire about product or service" />
    <bpmn:task id="collect" name="Collect information and address concerns" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="guide" name="Guide through selecting appropriate product or service" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:exclusiveGateway id="approved" name="Quote approved by customer?" />
    <bpmn:task id="place_order" name="Place order" />
    <bpmn:parallelGateway id="record_confirm" name="Record order and send confirmation" />
    <bpmn:task id="record" name="Record order in system" />
    <bpmn:task id="confirm" name="Send confirmation to customer" />
    <bpmn:parallelGateway id="recorded" name="Joining parallel" />
    <bpmn:endEvent id="placed" name="Order placed and confirmed" />
    <bpmn:endEvent id="not_interested" name="Process ended - not interested" />
    <bpmn:endEvent id="not_approved" name="Process ended - quote not approved" />
    <bpmn:sequenceFlow id="f-start_inquiry-inquire" sourceRef="start_inquiry" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-collect" sourceRef="inquire" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-interested" sourceRef="collect" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-guide" name="yes" sourceRef="interested" targetRef="guide" />
    <bpmn:sequenceFlow id="f-interested-not_interested" name="no" sourceRef="interested" targetRef="not_interested" />
    <bpmn:sequenceFlow id="f-guide-quote" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-approved" sourceRef="quote" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-place_order" name="yes" sourceRef="approved" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-approved-not_approved" name="no" sourceRef="approved" targetRef="not_approved" />
    <bpmn:sequenceFlow id="f-place_order-record_confirm" sourceRef="place_order" targetRef="record_confirm" />
    <bpmn:sequenceFlow id="f-record_confirm-record" sourceRef="record_confirm" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-recorded" sourceRef="record" targetRef="recorded" />
    <bpmn:sequenceFlow id="f-record_confirm-confirm" sourceRef="record_confirm" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-recorded" sourceRef="confirm" targetRef="recorded" />
    <bpmn:sequenceFlow id="f-recorded-placed" sourceRef="recorded" targetRef="placed" />
  </bpmn:process>
</bpmn:definitions>
