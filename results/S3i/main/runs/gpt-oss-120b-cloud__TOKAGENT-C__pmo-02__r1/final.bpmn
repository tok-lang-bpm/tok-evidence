<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Hiring Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Hiring Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect_resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen_resumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate_salary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboarding_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need identified" />
    <bpmn:task id="create_desc" name="Create job description" />
    <bpmn:task id="post_desc" name="Post job description on job boards" />
    <bpmn:task id="collect_resumes" name="Collect resumes" />
    <bpmn:task id="screen_resumes" name="Screen resumes" />
    <bpmn:task id="phone_interviews" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="interview_type" name="Interview type?" />
    <bpmn:task id="inperson" name="Conduct in-person interview" />
    <bpmn:task id="virtual" name="Conduct virtual interview" />
    <bpmn:task id="extend_offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="negotiate" name="Salary negotiation needed?" />
    <bpmn:task id="negotiate_salary" name="Negotiate salary" />
    <bpmn:task id="accept_offer" name="Accept offer" />
    <bpmn:parallelGateway id="onboarding_start" name="Onboarding parallel start" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Conduct orientation" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:parallelGateway id="onboarding_end" name="Onboarding parallel end" />
    <bpmn:endEvent id="completed" name="Onboarding completed" />
    <bpmn:sequenceFlow id="f-need-create_desc" sourceRef="need" targetRef="create_desc" />
    <bpmn:sequenceFlow id="f-create_desc-post_desc" sourceRef="create_desc" targetRef="post_desc" />
    <bpmn:sequenceFlow id="f-post_desc-collect_resumes" sourceRef="post_desc" targetRef="collect_resumes" />
    <bpmn:sequenceFlow id="f-collect_resumes-screen_resumes" sourceRef="collect_resumes" targetRef="screen_resumes" />
    <bpmn:sequenceFlow id="f-screen_resumes-phone_interviews" sourceRef="screen_resumes" targetRef="phone_interviews" />
    <bpmn:sequenceFlow id="f-phone_interviews-interview_type" sourceRef="phone_interviews" targetRef="interview_type" />
    <bpmn:sequenceFlow id="f-interview_type-inperson" name="In-person" sourceRef="interview_type" targetRef="inperson" />
    <bpmn:sequenceFlow id="f-interview_type-virtual" name="Virtual" sourceRef="interview_type" targetRef="virtual" />
    <bpmn:sequenceFlow id="f-inperson-extend_offer" sourceRef="inperson" targetRef="extend_offer" />
    <bpmn:sequenceFlow id="f-virtual-extend_offer" sourceRef="virtual" targetRef="extend_offer" />
    <bpmn:sequenceFlow id="f-extend_offer-negotiate" sourceRef="extend_offer" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-negotiate_salary" name="Yes" sourceRef="negotiate" targetRef="negotiate_salary" />
    <bpmn:sequenceFlow id="f-negotiate-accept_offer" name="No" sourceRef="negotiate" targetRef="accept_offer" />
    <bpmn:sequenceFlow id="f-negotiate_salary-accept_offer" sourceRef="negotiate_salary" targetRef="accept_offer" />
    <bpmn:sequenceFlow id="f-accept_offer-onboarding_start" sourceRef="accept_offer" targetRef="onboarding_start" />
    <bpmn:sequenceFlow id="f-onboarding_start-paperwork" sourceRef="onboarding_start" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f-onboarding_start-orientation" sourceRef="onboarding_start" targetRef="orientation" />
    <bpmn:sequenceFlow id="f-onboarding_start-training" sourceRef="onboarding_start" targetRef="training" />
    <bpmn:sequenceFlow id="f-paperwork-onboarding_end" sourceRef="paperwork" targetRef="onboarding_end" />
    <bpmn:sequenceFlow id="f-orientation-onboarding_end" sourceRef="orientation" targetRef="onboarding_end" />
    <bpmn:sequenceFlow id="f-training-onboarding_end" sourceRef="training" targetRef="onboarding_end" />
    <bpmn:sequenceFlow id="f-onboarding_end-completed" sourceRef="onboarding_end" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
