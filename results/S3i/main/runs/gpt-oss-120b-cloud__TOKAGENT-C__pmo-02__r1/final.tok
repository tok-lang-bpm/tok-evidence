tok 1.0 "Hiring Process"

pool organization "Organization"
  lane department "Department"
    start need "Need identified"
  lane hr "HR"
    task create_desc "Create job description"
    task post_desc "Post job description on job boards"
    task collect_resumes "Collect resumes"
    task screen_resumes "Screen resumes"
    task phone_interviews "Conduct initial phone interviews"
    xor interview_type "Interview type?"
    task inperson "Conduct in-person interview"
    task virtual "Conduct virtual interview"
    task extend_offer "Extend offer"
    xor negotiate "Salary negotiation needed?"
    task negotiate_salary "Negotiate salary"
    task accept_offer "Accept offer"
    and onboarding_start "Onboarding parallel start"
    task paperwork "Complete paperwork"
    task orientation "Conduct orientation"
    task training "Provide training"
    and onboarding_end "Onboarding parallel end"
    end completed "Onboarding completed"

flow need -> create_desc
flow create_desc -> post_desc
flow post_desc -> collect_resumes
flow collect_resumes -> screen_resumes
flow screen_resumes -> phone_interviews
flow phone_interviews -> interview_type
flow interview_type -> inperson "In-person"
flow interview_type -> virtual "Virtual"
flow inperson -> extend_offer
flow virtual -> extend_offer
flow extend_offer -> negotiate
flow negotiate -> negotiate_salary "Yes"
flow negotiate -> accept_offer "No"
flow negotiate_salary -> accept_offer
flow accept_offer -> onboarding_start
flow onboarding_start -> paperwork
flow onboarding_start -> orientation
flow onboarding_start -> training
flow paperwork -> onboarding_end
flow orientation -> onboarding_end
flow training -> onboarding_end
flow onboarding_end -> completed
