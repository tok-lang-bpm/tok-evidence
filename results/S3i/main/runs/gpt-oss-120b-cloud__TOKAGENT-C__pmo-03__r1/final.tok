tok 1.0 "Inventory Reorder Process"

pool organization "Organization"
  lane warehouse "Warehouse"
    start s1 "Start"
    task monitor "Monitor inventory levels"
    task signal "Signal need to reorder"
    task receive "Receive stock"
    task inspect "Inspect stock for quality"
    task record "Record stock in system"
    task place "Place stock on shelves"
    task update_levels "Update inventory levels after restock"
    end e1 "Process completed"

  lane procurement "Procurement"
    task place_order "Place order with suppliers"
    task update_expected "Update inventory system with expected delivery dates"

flow s1 -> monitor -> signal -> place_order -> update_expected -> receive -> inspect -> record -> place -> update_levels -> e1
