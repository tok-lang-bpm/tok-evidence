<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inventory Reorder Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Inventory Reorder Process" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement">
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_expected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Start" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:task id="signal" name="Signal need to reorder" />
    <bpmn:task id="receive" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="record" name="Record stock in system" />
    <bpmn:task id="place" name="Place stock on shelves" />
    <bpmn:task id="update_levels" name="Update inventory levels after restock" />
    <bpmn:endEvent id="e1" name="Process completed" />
    <bpmn:task id="place_order" name="Place order with suppliers" />
    <bpmn:task id="update_expected" name="Update inventory system with expected delivery dates" />
    <bpmn:sequenceFlow id="f-s1-monitor" sourceRef="s1" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-signal" sourceRef="monitor" targetRef="signal" />
    <bpmn:sequenceFlow id="f-signal-place_order" sourceRef="signal" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-update_expected" sourceRef="place_order" targetRef="update_expected" />
    <bpmn:sequenceFlow id="f-update_expected-receive" sourceRef="update_expected" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-place" sourceRef="record" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-update_levels" sourceRef="place" targetRef="update_levels" />
    <bpmn:sequenceFlow id="f-update_levels-e1" sourceRef="update_levels" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
