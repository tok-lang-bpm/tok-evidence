<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing Campaign Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing Campaign Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing Team">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design_visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_period</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM System">
        <bpmn:flowNodeRef>collect_leads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales Team">
        <bpmn:flowNodeRef>follow_up</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="define" name="Define campaign objectives" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="create_content" name="Create content" />
    <bpmn:task id="design_visuals" name="Design visuals" />
    <bpmn:task id="select_channels" name="Select promotion channels" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="launch" name="Launch campaign" />
    <bpmn:task id="track" name="Track performance in real-time" />
    <bpmn:task id="end_period" name="End campaign period" />
    <bpmn:task id="analyze" name="Analyze performance for future optimization" />
    <bpmn:endEvent id="end1" name="Process completed" />
    <bpmn:task id="collect_leads" name="Collect leads in CRM system" />
    <bpmn:task id="follow_up" name="Follow up leads" />
    <bpmn:sequenceFlow id="f-start1-define" sourceRef="start1" targetRef="define" />
    <bpmn:sequenceFlow id="f-define-split1" sourceRef="define" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-create_content" sourceRef="split1" targetRef="create_content" />
    <bpmn:sequenceFlow id="f-split1-design_visuals" sourceRef="split1" targetRef="design_visuals" />
    <bpmn:sequenceFlow id="f-split1-select_channels" sourceRef="split1" targetRef="select_channels" />
    <bpmn:sequenceFlow id="f-create_content-join1" sourceRef="create_content" targetRef="join1" />
    <bpmn:sequenceFlow id="f-design_visuals-join1" sourceRef="design_visuals" targetRef="join1" />
    <bpmn:sequenceFlow id="f-select_channels-join1" sourceRef="select_channels" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-launch" sourceRef="join1" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-track" sourceRef="launch" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-collect_leads" sourceRef="track" targetRef="collect_leads" />
    <bpmn:sequenceFlow id="f-collect_leads-follow_up" sourceRef="collect_leads" targetRef="follow_up" />
    <bpmn:sequenceFlow id="f-follow_up-end_period" sourceRef="follow_up" targetRef="end_period" />
    <bpmn:sequenceFlow id="f-end_period-analyze" sourceRef="end_period" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-end1" sourceRef="analyze" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
