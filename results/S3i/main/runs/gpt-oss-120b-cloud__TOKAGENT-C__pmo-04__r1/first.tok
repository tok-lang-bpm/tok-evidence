tok 1.0 "Marketing Campaign Process"

pool org "Organization"
  lane marketing "Marketing Team"
    start start1 "Start"
    task define "Define campaign objectives"
    and split1
    task create_content "Create content"
    task design_visuals "Design visuals"
    task select_channels "Select promotion channels"
    and join1
    task launch "Launch campaign"
    task track "Track performance in real-time"
    task end_period "End campaign period"
    task analyze "Analyze performance for future optimization"
    end end1 "Process completed"
  lane crm "CRM System"
    task collect_leads "Collect leads in CRM system"
  lane sales "Sales Team"
    task follow_up "Follow up leads"

flow start1 -> define -> split1
flow split1 -> create_content
flow split1 -> design_visuals
flow split1 -> select_channels
flow create_content -> join1
flow design_visuals -> join1
flow select_channels -> join1
flow join1 -> launch -> track -> collect_leads -> follow_up -> end_period -> analyze -> end1