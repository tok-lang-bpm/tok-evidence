<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Supplier onboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Supplier onboarding" isExecutable="true">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement">
        <bpmn:flowNodeRef>rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site_visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Process start" />
    <bpmn:task id="need" name="Identify need for new supplier" />
    <bpmn:task id="rfp" name="Issue request for proposals (RFP)" />
    <bpmn:task id="receive" name="Receive supplier responses" />
    <bpmn:task id="evaluate" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="site_dec" name="Conduct site visits or interviews?" default="f-site_dec-select" />
    <bpmn:task id="site_visit" name="Conduct site visits or interviews" />
    <bpmn:task id="select" name="Select supplier" />
    <bpmn:task id="negotiate" name="Negotiate contract" />
    <bpmn:exclusiveGateway id="agree" name="Both parties agree on terms?" default="f-agree-negotiate" />
    <bpmn:task id="sign" name="Sign contract" />
    <bpmn:task id="onboard" name="Onboard supplier" />
    <bpmn:endEvent id="end1" name="Process end" />
    <bpmn:sequenceFlow id="f-start1-need" sourceRef="start1" targetRef="need" />
    <bpmn:sequenceFlow id="f-need-rfp" sourceRef="need" targetRef="rfp" />
    <bpmn:sequenceFlow id="f-rfp-receive" sourceRef="rfp" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-site_dec" sourceRef="evaluate" targetRef="site_dec" />
    <bpmn:sequenceFlow id="f-site_dec-site_visit" name="yes" sourceRef="site_dec" targetRef="site_visit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-site_dec-select" name="no" sourceRef="site_dec" targetRef="select" />
    <bpmn:sequenceFlow id="f-site_visit-select" sourceRef="site_visit" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-agree" sourceRef="negotiate" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-sign" name="yes" sourceRef="agree" targetRef="sign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-agree-negotiate" name="no" sourceRef="agree" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-sign-onboard" sourceRef="sign" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-onboard-end1" sourceRef="onboard" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
