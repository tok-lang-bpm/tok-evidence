tok 1.0 "Supplier onboarding" executable

pool org "Organization"
  lane company "Company"
    start start1 "Process start"
    task id_need "Identify need for new supplier"
  lane procurement "Procurement"
    task rfp "Issue request for proposals (RFP)"
    task receive "Receive supplier responses"
    task evaluate "Evaluate proposals"
    xor site_dec "Conduct site visits or interviews?"
    task site_visit "Conduct site visits or interviews"
    task select "Select supplier"
    task negotiate "Negotiate contract"
    xor agree "Both parties agree on terms?"
    task sign "Sign contract"
    task onboard "Onboard supplier"
    end end1 "Process end"
  lane supplier "Supplier"
    # optional tasks could be added but omitted for simplicity

flow start1 -> id_need -> rfp -> receive -> evaluate -> site_dec
flow site_dec -> site_visit "yes"
flow site_dec -> select "no"
flow site_visit -> select
flow select -> negotiate -> agree
flow agree -> sign "yes"
flow agree -> negotiate "no"   # loop not modeled, just continue
flow sign -> onboard -> end1
