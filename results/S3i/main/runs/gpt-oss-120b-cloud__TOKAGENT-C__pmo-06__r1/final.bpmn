<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Order process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_online</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_feedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>gen_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gen_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Order placed" />
    <bpmn:exclusiveGateway id="X1" name="Order channel?" />
    <bpmn:task id="o_online" name="Place order online" />
    <bpmn:task id="o_phone" name="Place order by phone" />
    <bpmn:exclusiveGateway id="X2" name="Order placed" />
    <bpmn:task id="receive_tracking" name="Receive tracking information" />
    <bpmn:task id="receive_delivery" name="Receive delivery" />
    <bpmn:exclusiveGateway id="G1" name="Feedback or return?" />
    <bpmn:task id="provide_feedback" name="Provide feedback or return" />
    <bpmn:endEvent id="end_success" name="Process completed" />
    <bpmn:endEvent id="end_feedback" name="Feedback handled" />
    <bpmn:task id="gen_conf" name="Generate and send order confirmation" />
    <bpmn:task id="gen_label" name="Generate shipping label" />
    <bpmn:task id="send_tracking" name="Send tracking information to customer" />
    <bpmn:task id="monitor" name="Monitor shipment" />
    <bpmn:task id="pick" name="Pick items" />
    <bpmn:task id="pack" name="Pack items" />
    <bpmn:task id="handover" name="Hand over order to logistics provider" />
    <bpmn:task id="deliver" name="Deliver shipment" />
    <bpmn:sequenceFlow id="f-s1-X1" sourceRef="s1" targetRef="X1" />
    <bpmn:sequenceFlow id="f-X1-o_online" name="online" sourceRef="X1" targetRef="o_online" />
    <bpmn:sequenceFlow id="f-X1-o_phone" name="phone" sourceRef="X1" targetRef="o_phone" />
    <bpmn:sequenceFlow id="f-o_online-X2" sourceRef="o_online" targetRef="X2" />
    <bpmn:sequenceFlow id="f-o_phone-X2" sourceRef="o_phone" targetRef="X2" />
    <bpmn:sequenceFlow id="f-X2-gen_conf" sourceRef="X2" targetRef="gen_conf" />
    <bpmn:sequenceFlow id="f-gen_conf-pick" sourceRef="gen_conf" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-pack" sourceRef="pick" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-gen_label" sourceRef="pack" targetRef="gen_label" />
    <bpmn:sequenceFlow id="f-gen_label-handover" sourceRef="gen_label" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-deliver" sourceRef="handover" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-send_tracking" sourceRef="deliver" targetRef="send_tracking" />
    <bpmn:sequenceFlow id="f-send_tracking-receive_tracking" sourceRef="send_tracking" targetRef="receive_tracking" />
    <bpmn:sequenceFlow id="f-receive_tracking-monitor" sourceRef="receive_tracking" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-receive_delivery" sourceRef="monitor" targetRef="receive_delivery" />
    <bpmn:sequenceFlow id="f-receive_delivery-G1" sourceRef="receive_delivery" targetRef="G1" />
    <bpmn:sequenceFlow id="f-G1-end_success" name="no feedback" sourceRef="G1" targetRef="end_success" />
    <bpmn:sequenceFlow id="f-G1-provide_feedback" name="feedback" sourceRef="G1" targetRef="provide_feedback" />
    <bpmn:sequenceFlow id="f-provide_feedback-end_feedback" sourceRef="provide_feedback" targetRef="end_feedback" />
  </bpmn:process>
</bpmn:definitions>
