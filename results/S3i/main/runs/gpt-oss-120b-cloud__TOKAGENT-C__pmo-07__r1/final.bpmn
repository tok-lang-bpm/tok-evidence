<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ticket Booking Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="travel" name="Travel Company" processRef="travel-process" />
  </bpmn:collaboration>
  <bpmn:process id="travel-process" name="Ticket Booking Process" isExecutable="false">
    <bpmn:laneSet id="travel-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="booking" name="Booking System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMethodMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Travel Company">
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminderDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminderMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedbackDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start booking" />
    <bpmn:task id="search" name="Search for flight, train, or bus ticket" />
    <bpmn:task id="select" name="Select route, date, time and provide personal information and payment details" />
    <bpmn:task id="complete" name="Complete journey" />
    <bpmn:task id="feedback" name="Provide post-travel feedback" />
    <bpmn:endEvent id="E" name="Process completed" />
    <bpmn:task id="generate" name="Generate ticket" />
    <bpmn:exclusiveGateway id="sendMethod" name="Send ticket via email or SMS?" />
    <bpmn:task id="email" name="Send ticket via email" />
    <bpmn:task id="sms" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="sendMethodMerge" />
    <bpmn:task id="update" name="Update seat inventory" />
    <bpmn:exclusiveGateway id="reminderDecision" name="Send reminder and instructions?" />
    <bpmn:task id="reminder" name="Send reminders and instructions" />
    <bpmn:exclusiveGateway id="reminderMerge" />
    <bpmn:exclusiveGateway id="feedbackDecision" name="Provide post-travel feedback?" />
    <bpmn:sequenceFlow id="f-S-search" sourceRef="S" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-select" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-generate" sourceRef="select" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-sendMethod" sourceRef="generate" targetRef="sendMethod" />
    <bpmn:sequenceFlow id="f-sendMethod-email" name="email" sourceRef="sendMethod" targetRef="email" />
    <bpmn:sequenceFlow id="f-sendMethod-sms" name="SMS" sourceRef="sendMethod" targetRef="sms" />
    <bpmn:sequenceFlow id="f-email-sendMethodMerge" sourceRef="email" targetRef="sendMethodMerge" />
    <bpmn:sequenceFlow id="f-sms-sendMethodMerge" sourceRef="sms" targetRef="sendMethodMerge" />
    <bpmn:sequenceFlow id="f-sendMethodMerge-update" sourceRef="sendMethodMerge" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-reminderDecision" sourceRef="update" targetRef="reminderDecision" />
    <bpmn:sequenceFlow id="f-reminderDecision-reminder" name="yes" sourceRef="reminderDecision" targetRef="reminder" />
    <bpmn:sequenceFlow id="f-reminderDecision-reminderMerge" name="no" sourceRef="reminderDecision" targetRef="reminderMerge" />
    <bpmn:sequenceFlow id="f-reminder-reminderMerge" sourceRef="reminder" targetRef="reminderMerge" />
    <bpmn:sequenceFlow id="f-reminderMerge-complete" sourceRef="reminderMerge" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-feedbackDecision" sourceRef="complete" targetRef="feedbackDecision" />
    <bpmn:sequenceFlow id="f-feedbackDecision-feedback" name="yes" sourceRef="feedbackDecision" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedbackDecision-E" name="no" sourceRef="feedbackDecision" targetRef="E" />
    <bpmn:sequenceFlow id="f-feedback-E" sourceRef="feedback" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
