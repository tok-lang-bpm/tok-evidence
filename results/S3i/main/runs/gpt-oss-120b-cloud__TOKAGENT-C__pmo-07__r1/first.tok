tok 1.0 "Ticket Booking Process"

pool travel "Travel Company"
  lane customer "Customer"
    start S "Start booking"
    task search "Search for flight, train, or bus ticket"
    task select "Select route, date, time and provide personal information and payment details"
    task complete "Complete journey"
    task feedback "Provide post-travel feedback"
    end E "Process completed"
  lane booking "Booking System"
    task generate "Generate ticket"
    xor sendMethod "Send ticket via email or SMS?"
    task email "Send ticket via email"
    task sms "Send ticket via SMS"
    xor sendMethodMerge
  lane company "Travel Company"
    task update "Update seat inventory"
    xor reminderDecision "Send reminder and instructions?"
    task reminder "Send reminders and instructions"
    xor reminderMerge
    xor feedbackDecision "Provide post-travel feedback?"

flow S -> search -> select -> generate -> sendMethod
flow sendMethod -> email "email"
flow sendMethod -> sms "SMS"
flow email -> sendMethodMerge
flow sms -> sendMethodMerge
flow sendMethodMerge -> update -> reminderDecision
flow reminderDecision -> reminder "yes"
flow reminderDecision -> reminderMerge "no"
flow reminder -> reminderMerge
flow reminderMerge -> complete -> feedbackDecision
flow feedbackDecision -> feedback "yes"
flow feedbackDecision -> E "no"
flow feedback -> E