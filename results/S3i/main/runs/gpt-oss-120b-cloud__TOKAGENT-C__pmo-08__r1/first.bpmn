<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Incident Management" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Incident Management" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="reporter" name="Reporter">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholder" name="Stakeholder">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Incident reported" />
    <bpmn:task id="report" name="Report incident" />
    <bpmn:task id="log" name="Log incident into tracking system" />
    <bpmn:task id="assign" name="Assign incident to appropriate team" />
    <bpmn:task id="gather" name="Gather information" />
    <bpmn:task id="identify" name="Identify cause of incident" />
    <bpmn:task id="propose" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="solution" name="Solution type?" />
    <bpmn:task id="fix" name="Implement fix" />
    <bpmn:task id="training" name="Implement training" />
    <bpmn:task id="policy" name="Implement policy change" />
    <bpmn:exclusiveGateway id="done" name="Solution implemented" />
    <bpmn:task id="followup" name="Follow-up to ensure issue won't recur" />
    <bpmn:task id="notify" name="Notify stakeholders" />
    <bpmn:endEvent id="end" name="Incident closed" />
    <bpmn:sequenceFlow id="f-start-report" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-log" sourceRef="report" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-gather" sourceRef="assign" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-identify" sourceRef="gather" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-propose" sourceRef="identify" targetRef="propose" />
    <bpmn:sequenceFlow id="f-propose-solution" sourceRef="propose" targetRef="solution" />
    <bpmn:sequenceFlow id="f-solution-fix" name="Fix" sourceRef="solution" targetRef="fix" />
    <bpmn:sequenceFlow id="f-solution-training" name="Training" sourceRef="solution" targetRef="training" />
    <bpmn:sequenceFlow id="f-solution-policy" name="Policy change" sourceRef="solution" targetRef="policy" />
    <bpmn:sequenceFlow id="f-fix-done" sourceRef="fix" targetRef="done" />
    <bpmn:sequenceFlow id="f-training-done" sourceRef="training" targetRef="done" />
    <bpmn:sequenceFlow id="f-policy-done" sourceRef="policy" targetRef="done" />
    <bpmn:sequenceFlow id="f-done-followup" sourceRef="done" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-notify" sourceRef="followup" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-end" sourceRef="notify" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
