tok 1.0 "Incident Management"

pool org "Organization"
  lane reporter "Reporter"
    start start "Incident reported"
    task report "Report incident"
    task log "Log incident into tracking system"
    task assign "Assign incident to appropriate team"
  lane team "Team"
    task gather "Gather information"
    task identify "Identify cause of incident"
    task propose "Propose corrective actions"
    xor solution "Solution type?"
    task fix "Implement fix"
    task training "Implement training"
    task policy "Implement policy change"
    xor done "Solution implemented"
    task followup "Follow-up to ensure issue won't recur"
  lane stakeholder "Stakeholder"
    task notify "Notify stakeholders"
    end end "Incident closed"
    
flow start -> report -> log -> assign -> gather -> identify -> propose -> solution
flow solution -> fix "Fix"
flow solution -> training "Training"
flow solution -> policy "Policy change"
flow fix -> done
flow training -> done
flow policy -> done
flow done -> followup -> notify -> end