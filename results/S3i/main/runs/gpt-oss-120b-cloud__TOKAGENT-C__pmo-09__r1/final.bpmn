<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Product Development Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Product Development Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="rnd" name="R&amp;D team">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft_design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build_prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refinement_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_prototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="identify_idea" name="Identify idea for new product or improvement" />
    <bpmn:task id="conduct_research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft_design" name="Draft design concepts" />
    <bpmn:task id="select_design" name="Select promising design" />
    <bpmn:task id="build_prototype" name="Build prototype using available materials and resources" />
    <bpmn:task id="test_prototype" name="Test prototype for functionality, safety, and market potential" />
    <bpmn:exclusiveGateway id="refinement_needed" name="Refinement needed?" />
    <bpmn:task id="refine_prototype" name="Refine prototype" />
    <bpmn:exclusiveGateway id="outcome" name="Prototype outcome?" />
    <bpmn:endEvent id="approved" name="Prototype approved for further development" />
    <bpmn:endEvent id="discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-s-identify_idea" sourceRef="s" targetRef="identify_idea" />
    <bpmn:sequenceFlow id="f-identify_idea-conduct_research" sourceRef="identify_idea" targetRef="conduct_research" />
    <bpmn:sequenceFlow id="f-conduct_research-draft_design" sourceRef="conduct_research" targetRef="draft_design" />
    <bpmn:sequenceFlow id="f-draft_design-select_design" sourceRef="draft_design" targetRef="select_design" />
    <bpmn:sequenceFlow id="f-select_design-build_prototype" sourceRef="select_design" targetRef="build_prototype" />
    <bpmn:sequenceFlow id="f-build_prototype-test_prototype" sourceRef="build_prototype" targetRef="test_prototype" />
    <bpmn:sequenceFlow id="f-test_prototype-refinement_needed" sourceRef="test_prototype" targetRef="refinement_needed" />
    <bpmn:sequenceFlow id="f-refinement_needed-refine_prototype" name="yes" sourceRef="refinement_needed" targetRef="refine_prototype" />
    <bpmn:sequenceFlow id="f-refinement_needed-outcome" name="no" sourceRef="refinement_needed" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-refine_prototype-test_prototype" sourceRef="refine_prototype" targetRef="test_prototype" />
    <bpmn:sequenceFlow id="f-outcome-approved" name="approve" sourceRef="outcome" targetRef="approved" />
    <bpmn:sequenceFlow id="f-outcome-discarded" name="discard" sourceRef="outcome" targetRef="discarded" />
  </bpmn:process>
</bpmn:definitions>
