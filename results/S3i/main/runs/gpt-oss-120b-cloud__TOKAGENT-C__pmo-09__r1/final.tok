tok 1.0 "Product Development Process"

pool org "Organization"
  lane rnd "R&D team"
    start s "Start"
    task identify_idea "Identify idea for new product or improvement"
    task conduct_research "Conduct initial research and feasibility studies"
    task draft_design "Draft design concepts"
    task select_design "Select promising design"
    task build_prototype "Build prototype using available materials and resources"
    task test_prototype "Test prototype for functionality, safety, and market potential"
    xor refinement_needed "Refinement needed?"
    task refine_prototype "Refine prototype"
    xor outcome "Prototype outcome?"
    end approved "Prototype approved for further development"
    end discarded "Prototype discarded"

    flow s -> identify_idea -> conduct_research -> draft_design -> select_design -> build_prototype -> test_prototype -> refinement_needed
    flow refinement_needed -> refine_prototype "yes"
    flow refinement_needed -> outcome "no"
    flow refine_prototype -> test_prototype
    flow outcome -> approved "approve"
    flow outcome -> discarded "discard"
