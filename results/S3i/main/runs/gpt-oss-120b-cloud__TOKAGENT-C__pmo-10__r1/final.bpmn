<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IT solution request process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="IT solution request process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="requester" name="Requester">
        <bpmn:flowNodeRef>start_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_req" name="Process start" />
    <bpmn:task id="submit_req" name="Submit request for IT solution" />
    <bpmn:endEvent id="end_reject" name="Request rejected" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" />
    <bpmn:task id="procure" name="Procure tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in controlled environment" />
    <bpmn:task id="rollout" name="Roll out the solution to requesting department" />
    <bpmn:exclusiveGateway id="training_needed" name="Training needed?" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:task id="support" name="Provide IT support" />
    <bpmn:endEvent id="end_complete" name="Process complete" />
    <bpmn:sequenceFlow id="f-start_req-submit_req" sourceRef="start_req" targetRef="submit_req" />
    <bpmn:sequenceFlow id="f-submit_req-assess" sourceRef="submit_req" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-approved" sourceRef="assess" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="yes" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approved-end_reject" name="no" sourceRef="approved" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-rollout" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-rollout-training_needed" sourceRef="rollout" targetRef="training_needed" />
    <bpmn:sequenceFlow id="f-training_needed-train" name="yes" sourceRef="training_needed" targetRef="train" />
    <bpmn:sequenceFlow id="f-training_needed-support" name="no" sourceRef="training_needed" targetRef="support" />
    <bpmn:sequenceFlow id="f-train-support" sourceRef="train" targetRef="support" />
    <bpmn:sequenceFlow id="f-support-end_complete" sourceRef="support" targetRef="end_complete" />
  </bpmn:process>
</bpmn:definitions>
