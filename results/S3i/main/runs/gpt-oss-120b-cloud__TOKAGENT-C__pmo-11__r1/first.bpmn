<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Subscription process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Subscription process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>su</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_continue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support team">
        <bpmn:flowNodeRef>pc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>de</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Subscription sign‑up" />
    <bpmn:task id="su" name="Sign up for subscription service" />
    <bpmn:exclusiveGateway id="cd" name="Cancel subscription?" />
    <bpmn:task id="ru" name="Receive subscription communications" />
    <bpmn:task id="sc" name="Submit cancellation request" />
    <bpmn:endEvent id="e_continue" name="Subscription continues" />
    <bpmn:task id="ga" name="Generate account" />
    <bpmn:task id="aa" name="Assign access" />
    <bpmn:task id="tb" name="Trigger automated billing cycles" />
    <bpmn:task id="pc" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="rd" name="Refund applicable?" />
    <bpmn:task id="ar" name="Apply refund" />
    <bpmn:task id="ac" name="Apply charge" />
    <bpmn:task id="de" name="Deactivate subscription" />
    <bpmn:task id="sb" name="Settle final account balance" />
    <bpmn:endEvent id="e_cancel" name="Subscription cancelled" />
    <bpmn:sequenceFlow id="f-s-su" sourceRef="s" targetRef="su" />
    <bpmn:sequenceFlow id="f-su-ga" sourceRef="su" targetRef="ga" />
    <bpmn:sequenceFlow id="f-ga-aa" sourceRef="ga" targetRef="aa" />
    <bpmn:sequenceFlow id="f-aa-tb" sourceRef="aa" targetRef="tb" />
    <bpmn:sequenceFlow id="f-tb-ru" sourceRef="tb" targetRef="ru" />
    <bpmn:sequenceFlow id="f-ru-cd" sourceRef="ru" targetRef="cd" />
    <bpmn:sequenceFlow id="f-cd-sc" name="yes" sourceRef="cd" targetRef="sc" />
    <bpmn:sequenceFlow id="f-cd-e_continue" name="no" sourceRef="cd" targetRef="e_continue" />
    <bpmn:sequenceFlow id="f-sc-pc" sourceRef="sc" targetRef="pc" />
    <bpmn:sequenceFlow id="f-pc-rd" sourceRef="pc" targetRef="rd" />
    <bpmn:sequenceFlow id="f-rd-ar" name="yes" sourceRef="rd" targetRef="ar" />
    <bpmn:sequenceFlow id="f-rd-ac" name="no" sourceRef="rd" targetRef="ac" />
    <bpmn:sequenceFlow id="f-ar-de" sourceRef="ar" targetRef="de" />
    <bpmn:sequenceFlow id="f-ac-de" sourceRef="ac" targetRef="de" />
    <bpmn:sequenceFlow id="f-de-sb" sourceRef="de" targetRef="sb" />
    <bpmn:sequenceFlow id="f-sb-e_cancel" sourceRef="sb" targetRef="e_cancel" />
  </bpmn:process>
</bpmn:definitions>
