tok 1.0 "Subscription process"

pool org "Organization"
  lane customer "Customer"
    start s "Subscription sign‑up"
    task su "Sign up for subscription service"
    xor cd "Cancel subscription?"
    task ru "Receive subscription communications"
    task sc "Submit cancellation request"
    end e_continue "Subscription continues"
  lane system "System"
    task ga "Generate account"
    task aa "Assign access"
    task tb "Trigger automated billing cycles"
  lane support "Support team"
    task pc "Process cancellation request"
    xor rd "Refund applicable?"
    task ar "Apply refund"
    task ac "Apply charge"
    task de "Deactivate subscription"
    task sb "Settle final account balance"
    end e_cancel "Subscription cancelled"

flow s -> su -> ga -> aa -> tb -> ru -> cd
flow cd -> sc "yes"
flow cd -> e_continue "no"
flow sc -> pc -> rd
flow rd -> ar "yes"
flow rd -> ac "no"
flow ar -> de
flow ac -> de
flow de -> sb -> e_cancel