<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Complaint handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Complaint handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>after</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Financial Team">
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer2" name="Customer">
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Complaint received" />
    <bpmn:task id="file" name="file complaint" />
    <bpmn:task id="log" name="log complaint" />
    <bpmn:task id="assign" name="assign complaint" />
    <bpmn:task id="review" name="review complaint" />
    <bpmn:exclusiveGateway id="decide" name="Refund approved?" />
    <bpmn:task id="notify" name="notify customer" />
    <bpmn:exclusiveGateway id="after" name="Refund approved?" />
    <bpmn:task id="reimburse" name="process reimbursement" />
    <bpmn:task id="feedback" name="provide feedback" />
    <bpmn:endEvent id="end1" name="Process completed" />
    <bpmn:sequenceFlow id="f-start1-file" sourceRef="start1" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-log" sourceRef="file" targetRef="log" />
    <bpmn:sequenceFlow id="f-log-assign" sourceRef="log" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-review" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decide" sourceRef="review" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-notify" name="yes" sourceRef="decide" targetRef="notify" />
    <bpmn:sequenceFlow id="f-decide-notify-2" name="no" sourceRef="decide" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-after" sourceRef="notify" targetRef="after" />
    <bpmn:sequenceFlow id="f-after-reimburse" name="yes" sourceRef="after" targetRef="reimburse" />
    <bpmn:sequenceFlow id="f-after-feedback" name="no" sourceRef="after" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-reimburse-feedback" sourceRef="reimburse" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-end1" sourceRef="feedback" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
