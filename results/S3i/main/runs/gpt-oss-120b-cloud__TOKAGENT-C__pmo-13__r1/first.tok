tok 1.0 "Complaint handling"

pool org "Organization"
  lane customer "Customer"
    start start1 "Complaint received"
    task file "file complaint"
  lane cs "Customer Service"
    task log "log complaint"
    task assign "assign complaint"
  lane dept "Department"
    task review "review complaint"
    xor decide "Refund approved?"
    task notify "notify customer"
    xor after "Refund approved?"
  lane fin "Financial Team"
    task reimburse "process reimbursement"
  lane customer2 "Customer"
    task feedback "provide feedback"
    end end1 "Process completed"

flow start1 -> file -> log -> assign -> review -> decide
flow decide -> notify "yes"
flow decide -> notify "no"
flow notify -> after
flow after -> reimburse "yes"
flow after -> feedback "no"
flow reimburse -> feedback
flow feedback -> end1
