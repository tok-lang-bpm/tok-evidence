<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Budget Planning Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Budget Planning Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="department" name="Department">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document_adjustment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>strategic_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>finance_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate_budget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>approve_adjustment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Process start" />
    <bpmn:task id="outline" name="Outline objectives" />
    <bpmn:task id="document_adjustment" name="Document adjustment" />
    <bpmn:task id="implement_plan" name="Implement plan" />
    <bpmn:endEvent id="end1" name="Process end" />
    <bpmn:task id="draft" name="Draft plan" />
    <bpmn:task id="strategic_review" name="Review plan in strategic alignment meeting" />
    <bpmn:task id="finance_review" name="Finance detailed review" />
    <bpmn:exclusiveGateway id="adjust_needed" name="Adjustment needed?" />
    <bpmn:task id="allocate_budget" name="Allocate budget" />
    <bpmn:task id="approve_adjustment" name="Approve adjustment" />
    <bpmn:sequenceFlow id="f-start1-outline" sourceRef="start1" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-strategic_review" sourceRef="draft" targetRef="strategic_review" />
    <bpmn:sequenceFlow id="f-strategic_review-finance_review" sourceRef="strategic_review" targetRef="finance_review" />
    <bpmn:sequenceFlow id="f-finance_review-adjust_needed" sourceRef="finance_review" targetRef="adjust_needed" />
    <bpmn:sequenceFlow id="f-adjust_needed-document_adjustment" name="yes" sourceRef="adjust_needed" targetRef="document_adjustment" />
    <bpmn:sequenceFlow id="f-adjust_needed-allocate_budget" name="no" sourceRef="adjust_needed" targetRef="allocate_budget" />
    <bpmn:sequenceFlow id="f-document_adjustment-approve_adjustment" sourceRef="document_adjustment" targetRef="approve_adjustment" />
    <bpmn:sequenceFlow id="f-approve_adjustment-finance_review" sourceRef="approve_adjustment" targetRef="finance_review" />
    <bpmn:sequenceFlow id="f-allocate_budget-implement_plan" sourceRef="allocate_budget" targetRef="implement_plan" />
    <bpmn:sequenceFlow id="f-implement_plan-end1" sourceRef="implement_plan" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
