tok 1.0 "Budget Planning Process"

pool org "Organization"
  lane department "Department"
    start start1 "Process start"
    task outline "Outline objectives"
    task document_adjustment "Document adjustment"
    task implement_plan "Implement plan"
    end end1 "Process end"
  lane team "Team"
    task draft "Draft plan"
    task strategic_review "Review plan in strategic alignment meeting"
  lane finance "Finance Department"
    task finance_review "Finance detailed review"
    xor adjust_needed "Adjustment needed?"
    task allocate_budget "Allocate budget"
  lane stakeholders "Stakeholders"
    task approve_adjustment "Approve adjustment"

flow start1 -> outline
flow outline -> draft
flow draft -> strategic_review
flow strategic_review -> finance_review
flow finance_review -> adjust_needed
flow adjust_needed -> document_adjustment "yes"
flow adjust_needed -> allocate_budget "no"
flow document_adjustment -> approve_adjustment
flow approve_adjustment -> finance_review
flow allocate_budget -> implement_plan
flow implement_plan -> end1
