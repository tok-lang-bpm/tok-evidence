<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="internal" name="Internal Team">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selfassess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditor" name="Auditor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>certified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_certified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="schedule" name="Schedule compliance audit" />
    <bpmn:task id="prepare" name="Prepare documentation" />
    <bpmn:task id="gather" name="Gather evidence" />
    <bpmn:task id="selfassess" name="Conduct self-assessment" />
    <bpmn:task id="review" name="Review processes and identify gaps" />
    <bpmn:task id="final_audit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="criteria" name="All criteria met?" />
    <bpmn:task id="award" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="certified" name="Certification issued" />
    <bpmn:endEvent id="not_certified" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f-start-schedule" sourceRef="start" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-prepare" sourceRef="schedule" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-selfassess" sourceRef="gather" targetRef="selfassess" />
    <bpmn:sequenceFlow id="f-selfassess-review" sourceRef="selfassess" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-final_audit" sourceRef="review" targetRef="final_audit" />
    <bpmn:sequenceFlow id="f-final_audit-criteria" sourceRef="final_audit" targetRef="criteria" />
    <bpmn:sequenceFlow id="f-criteria-award" name="yes" sourceRef="criteria" targetRef="award" />
    <bpmn:sequenceFlow id="f-criteria-not_certified" name="no" sourceRef="criteria" targetRef="not_certified" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-certified" sourceRef="issue" targetRef="certified" />
  </bpmn:process>
</bpmn:definitions>
