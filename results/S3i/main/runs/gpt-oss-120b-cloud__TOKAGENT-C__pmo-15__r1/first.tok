tok 1.0 "Compliance audit process"

pool org "Organization"
  lane company "Company"
    start start "Process start"
    task schedule "Schedule compliance audit"
  lane internal "Internal Team"
    task prepare "Prepare documentation"
    task gather "Gather evidence"
    task selfassess "Conduct self-assessment"
  lane auditor "Auditor"
    task review "Review processes and identify gaps"
    task final_audit "Conduct final audit"
    xor criteria "All criteria met?"
    task award "Award certification"
    task issue "Issue official documents"
    end certified "Certification issued"
    end not_certified "Certification not awarded"

flow start -> schedule -> prepare -> gather -> selfassess -> review -> final_audit -> criteria
flow criteria -> award "yes"
flow criteria -> not_certified "no"
flow award -> issue -> certified
