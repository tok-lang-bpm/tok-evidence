<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual Audit Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="coordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional Office">
        <bpmn:flowNodeRef>t_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_provideClar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance Team">
        <bpmn:flowNodeRef>t_checkReg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central Audit Team">
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_discrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_requestClar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_siteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_prep_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_risk_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_highRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_invest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_invest_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_final_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_finRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_operRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit Director">
        <bpmn:flowNodeRef>t_directorReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_archive</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Audit process start" />
    <bpmn:task id="t_notify" name="send notification to regional office" />
    <bpmn:task id="t_prepare" name="prepare financial statements and gather documents" />
    <bpmn:task id="t_submit" name="submit documents to central audit team" />
    <bpmn:task id="t_provideClar" name="provide clarifications" />
    <bpmn:task id="t_checkReg" name="check regulatory updates" />
    <bpmn:task id="t_review" name="review submission" />
    <bpmn:exclusiveGateway id="xor_discrep" name="discrepancies found?" />
    <bpmn:task id="t_requestClar" name="request clarifications from regional office" />
    <bpmn:task id="t_investigate" name="launch detailed investigation" />
    <bpmn:task id="t_dataAnalysis" name="perform data analysis" />
    <bpmn:task id="t_interviews" name="conduct interviews" />
    <bpmn:task id="t_siteVisits" name="perform site visits" />
    <bpmn:task id="t_compile" name="compile audit report" />
    <bpmn:task id="t_update" name="update audit report" />
    <bpmn:parallelGateway id="and_prep" />
    <bpmn:parallelGateway id="and_prep_join" />
    <bpmn:parallelGateway id="and_risk" />
    <bpmn:parallelGateway id="and_risk_join" />
    <bpmn:exclusiveGateway id="xor_highRisk" name="high risk identified?" />
    <bpmn:parallelGateway id="and_invest" />
    <bpmn:parallelGateway id="and_invest_join" />
    <bpmn:parallelGateway id="and_final" />
    <bpmn:parallelGateway id="and_final_join" />
    <bpmn:task id="t_finRisk" name="evaluate financial risks" />
    <bpmn:task id="t_operRisk" name="evaluate operational risks" />
    <bpmn:task id="t_compRisk" name="evaluate compliance risks" />
    <bpmn:endEvent id="endClosed" name="audit process closed" />
    <bpmn:task id="t_directorReview" name="review audit report" />
    <bpmn:exclusiveGateway id="xor_approval" name="approve report?" />
    <bpmn:task id="t_distribute" name="distribute report to executive board" />
    <bpmn:task id="t_archive" name="archive report" />
    <bpmn:sequenceFlow id="f-s0-t_notify" sourceRef="s0" targetRef="t_notify" />
    <bpmn:sequenceFlow id="f-t_notify-and_prep" sourceRef="t_notify" targetRef="and_prep" />
    <bpmn:sequenceFlow id="f-and_prep-t_prepare" sourceRef="and_prep" targetRef="t_prepare" />
    <bpmn:sequenceFlow id="f-and_prep-t_checkReg" sourceRef="and_prep" targetRef="t_checkReg" />
    <bpmn:sequenceFlow id="f-t_prepare-and_prep_join" sourceRef="t_prepare" targetRef="and_prep_join" />
    <bpmn:sequenceFlow id="f-t_checkReg-and_prep_join" sourceRef="t_checkReg" targetRef="and_prep_join" />
    <bpmn:sequenceFlow id="f-and_prep_join-t_submit" sourceRef="and_prep_join" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f-t_submit-t_review" sourceRef="t_submit" targetRef="t_review" />
    <bpmn:sequenceFlow id="f-t_review-xor_discrep" sourceRef="t_review" targetRef="xor_discrep" />
    <bpmn:sequenceFlow id="f-xor_discrep-t_requestClar" name="yes" sourceRef="xor_discrep" targetRef="t_requestClar" />
    <bpmn:sequenceFlow id="f-xor_discrep-and_risk" name="no" sourceRef="xor_discrep" targetRef="and_risk" />
    <bpmn:sequenceFlow id="f-t_requestClar-t_provideClar" sourceRef="t_requestClar" targetRef="t_provideClar" />
    <bpmn:sequenceFlow id="f-t_provideClar-t_review" sourceRef="t_provideClar" targetRef="t_review" />
    <bpmn:sequenceFlow id="f-and_risk-t_finRisk" sourceRef="and_risk" targetRef="t_finRisk" />
    <bpmn:sequenceFlow id="f-and_risk-t_operRisk" sourceRef="and_risk" targetRef="t_operRisk" />
    <bpmn:sequenceFlow id="f-and_risk-t_compRisk" sourceRef="and_risk" targetRef="t_compRisk" />
    <bpmn:sequenceFlow id="f-t_finRisk-and_risk_join" sourceRef="t_finRisk" targetRef="and_risk_join" />
    <bpmn:sequenceFlow id="f-t_operRisk-and_risk_join" sourceRef="t_operRisk" targetRef="and_risk_join" />
    <bpmn:sequenceFlow id="f-t_compRisk-and_risk_join" sourceRef="t_compRisk" targetRef="and_risk_join" />
    <bpmn:sequenceFlow id="f-and_risk_join-xor_highRisk" sourceRef="and_risk_join" targetRef="xor_highRisk" />
    <bpmn:sequenceFlow id="f-xor_highRisk-t_investigate" name="yes" sourceRef="xor_highRisk" targetRef="t_investigate" />
    <bpmn:sequenceFlow id="f-xor_highRisk-t_compile" name="no" sourceRef="xor_highRisk" targetRef="t_compile" />
    <bpmn:sequenceFlow id="f-t_investigate-and_invest" sourceRef="t_investigate" targetRef="and_invest" />
    <bpmn:sequenceFlow id="f-and_invest-t_dataAnalysis" sourceRef="and_invest" targetRef="t_dataAnalysis" />
    <bpmn:sequenceFlow id="f-and_invest-t_interviews" sourceRef="and_invest" targetRef="t_interviews" />
    <bpmn:sequenceFlow id="f-and_invest-t_siteVisits" sourceRef="and_invest" targetRef="t_siteVisits" />
    <bpmn:sequenceFlow id="f-t_dataAnalysis-and_invest_join" sourceRef="t_dataAnalysis" targetRef="and_invest_join" />
    <bpmn:sequenceFlow id="f-t_interviews-and_invest_join" sourceRef="t_interviews" targetRef="and_invest_join" />
    <bpmn:sequenceFlow id="f-t_siteVisits-and_invest_join" sourceRef="t_siteVisits" targetRef="and_invest_join" />
    <bpmn:sequenceFlow id="f-and_invest_join-t_compile" sourceRef="and_invest_join" targetRef="t_compile" />
    <bpmn:sequenceFlow id="f-t_compile-t_directorReview" sourceRef="t_compile" targetRef="t_directorReview" />
    <bpmn:sequenceFlow id="f-t_directorReview-xor_approval" sourceRef="t_directorReview" targetRef="xor_approval" />
    <bpmn:sequenceFlow id="f-xor_approval-and_final" name="yes" sourceRef="xor_approval" targetRef="and_final" />
    <bpmn:sequenceFlow id="f-xor_approval-t_update" name="no" sourceRef="xor_approval" targetRef="t_update" />
    <bpmn:sequenceFlow id="f-t_update-t_directorReview" sourceRef="t_update" targetRef="t_directorReview" />
    <bpmn:sequenceFlow id="f-and_final-t_distribute" sourceRef="and_final" targetRef="t_distribute" />
    <bpmn:sequenceFlow id="f-and_final-t_archive" sourceRef="and_final" targetRef="t_archive" />
    <bpmn:sequenceFlow id="f-t_distribute-and_final_join" sourceRef="t_distribute" targetRef="and_final_join" />
    <bpmn:sequenceFlow id="f-t_archive-and_final_join" sourceRef="t_archive" targetRef="and_final_join" />
    <bpmn:sequenceFlow id="f-and_final_join-endClosed" sourceRef="and_final_join" targetRef="endClosed" />
  </bpmn:process>
</bpmn:definitions>
