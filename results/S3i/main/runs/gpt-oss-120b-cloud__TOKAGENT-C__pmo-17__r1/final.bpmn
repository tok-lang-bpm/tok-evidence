<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order Fulfillment Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ecommerce" name="E-commerce Company" processRef="ecommerce-process" />
  </bpmn:collaboration>
  <bpmn:process id="ecommerce-process" name="Order Fulfillment Process" isExecutable="false">
    <bpmn:laneSet id="ecommerce-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inventory" name="Inventory">
        <bpmn:flowNodeRef>check_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_backorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quality_control</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>package_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift_wrap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping">
        <bpmn:flowNodeRef>prepare_shipping_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="returns" name="Returns">
        <bpmn:flowNodeRef>send_return_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_returned_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect_returned_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_refund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order_start" name="Order placed" />
    <bpmn:task id="place_order" name="Place order" />
    <bpmn:exclusiveGateway id="issue_decision" name="Customer reports any issues upon delivery?" />
    <bpmn:endEvent id="order_end" name="Order fulfilled" />
    <bpmn:endEvent id="return_end" name="Return process completed" />
    <bpmn:task id="record_order" name="Record order details" />
    <bpmn:task id="process_payment" name="Process payment" />
    <bpmn:exclusiveGateway id="pay_success" name="Payment successful?" />
    <bpmn:task id="notify_fail" name="Notify payment failure" />
    <bpmn:endEvent id="payment_failed" name="Process ends due to payment failure" />
    <bpmn:task id="send_confirm" name="Send shipping confirmation" />
    <bpmn:task id="upd_inv" name="Update inventory levels" />
    <bpmn:task id="feedback" name="Send follow-up email for feedback" />
    <bpmn:task id="check_stock" name="Check stock availability" />
    <bpmn:exclusiveGateway id="stock_ok" name="Stock available?" />
    <bpmn:task id="backorder" name="Initiate back-order" />
    <bpmn:task id="inform_delay" name="Inform customer about delay" />
    <bpmn:task id="receive_backorder" name="Receive back-order" />
    <bpmn:task id="pick_items" name="Pick items from warehouse" />
    <bpmn:task id="quality_control" name="Perform quality control checks" />
    <bpmn:task id="package_items" name="Package items" />
    <bpmn:exclusiveGateway id="gift_needed" name="Gift wrap requested?" />
    <bpmn:task id="gift_wrap" name="Gift wrap items" />
    <bpmn:task id="prepare_shipping_docs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl_order" name="International order?" />
    <bpmn:task id="prepare_customs" name="Prepare customs documentation" />
    <bpmn:parallelGateway id="and_split" name="Parallel split" />
    <bpmn:parallelGateway id="and_join" name="Parallel join" />
    <bpmn:task id="dispatch_order" name="Dispatch order" />
    <bpmn:task id="send_return_label" name="Send return shipping label" />
    <bpmn:task id="receive_returned_items" name="Receive returned items" />
    <bpmn:task id="inspect_returned_items" name="Inspect returned items" />
    <bpmn:task id="process_refund" name="Process refund or replacement" />
    <bpmn:sequenceFlow id="f-order_start-place_order" sourceRef="order_start" targetRef="place_order" />
    <bpmn:sequenceFlow id="f-place_order-record_order" sourceRef="place_order" targetRef="record_order" />
    <bpmn:sequenceFlow id="f-record_order-process_payment" sourceRef="record_order" targetRef="process_payment" />
    <bpmn:sequenceFlow id="f-process_payment-pay_success" sourceRef="process_payment" targetRef="pay_success" />
    <bpmn:sequenceFlow id="f-pay_success-check_stock" name="yes" sourceRef="pay_success" targetRef="check_stock" />
    <bpmn:sequenceFlow id="f-pay_success-notify_fail" name="no" sourceRef="pay_success" targetRef="notify_fail" />
    <bpmn:sequenceFlow id="f-notify_fail-payment_failed" sourceRef="notify_fail" targetRef="payment_failed" />
    <bpmn:sequenceFlow id="f-check_stock-stock_ok" sourceRef="check_stock" targetRef="stock_ok" />
    <bpmn:sequenceFlow id="f-stock_ok-pick_items" name="yes" sourceRef="stock_ok" targetRef="pick_items" />
    <bpmn:sequenceFlow id="f-stock_ok-backorder" name="no" sourceRef="stock_ok" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-backorder-inform_delay" sourceRef="backorder" targetRef="inform_delay" />
    <bpmn:sequenceFlow id="f-inform_delay-receive_backorder" sourceRef="inform_delay" targetRef="receive_backorder" />
    <bpmn:sequenceFlow id="f-receive_backorder-pick_items" sourceRef="receive_backorder" targetRef="pick_items" />
    <bpmn:sequenceFlow id="f-pick_items-quality_control" sourceRef="pick_items" targetRef="quality_control" />
    <bpmn:sequenceFlow id="f-quality_control-and_split" sourceRef="quality_control" targetRef="and_split" />
    <bpmn:sequenceFlow id="f-and_split-package_items" sourceRef="and_split" targetRef="package_items" />
    <bpmn:sequenceFlow id="f-and_split-prepare_shipping_docs" sourceRef="and_split" targetRef="prepare_shipping_docs" />
    <bpmn:sequenceFlow id="f-package_items-gift_needed" sourceRef="package_items" targetRef="gift_needed" />
    <bpmn:sequenceFlow id="f-gift_needed-gift_wrap" name="yes" sourceRef="gift_needed" targetRef="gift_wrap" />
    <bpmn:sequenceFlow id="f-gift_needed-and_join" name="no" sourceRef="gift_needed" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-gift_wrap-and_join" sourceRef="gift_wrap" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-prepare_shipping_docs-intl_order" sourceRef="prepare_shipping_docs" targetRef="intl_order" />
    <bpmn:sequenceFlow id="f-intl_order-prepare_customs" name="yes" sourceRef="intl_order" targetRef="prepare_customs" />
    <bpmn:sequenceFlow id="f-intl_order-and_join" name="no" sourceRef="intl_order" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-prepare_customs-and_join" sourceRef="prepare_customs" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-and_join-dispatch_order" sourceRef="and_join" targetRef="dispatch_order" />
    <bpmn:sequenceFlow id="f-dispatch_order-send_confirm" sourceRef="dispatch_order" targetRef="send_confirm" />
    <bpmn:sequenceFlow id="f-send_confirm-upd_inv" sourceRef="send_confirm" targetRef="upd_inv" />
    <bpmn:sequenceFlow id="f-upd_inv-feedback" sourceRef="upd_inv" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-issue_decision" sourceRef="feedback" targetRef="issue_decision" />
    <bpmn:sequenceFlow id="f-issue_decision-send_return_label" name="yes" sourceRef="issue_decision" targetRef="send_return_label" />
    <bpmn:sequenceFlow id="f-issue_decision-order_end" name="no" sourceRef="issue_decision" targetRef="order_end" />
    <bpmn:sequenceFlow id="f-send_return_label-receive_returned_items" sourceRef="send_return_label" targetRef="receive_returned_items" />
    <bpmn:sequenceFlow id="f-receive_returned_items-inspect_returned_items" sourceRef="receive_returned_items" targetRef="inspect_returned_items" />
    <bpmn:sequenceFlow id="f-inspect_returned_items-process_refund" sourceRef="inspect_returned_items" targetRef="process_refund" />
    <bpmn:sequenceFlow id="f-process_refund-return_end" sourceRef="process_refund" targetRef="return_end" />
  </bpmn:process>
</bpmn:definitions>
