<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="University enrollment process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="university" name="University" processRef="university-process" />
  </bpmn:collaboration>
  <bpmn:process id="university-process" name="University enrollment process" isExecutable="false">
    <bpmn:laneSet id="university-lanes">
      <bpmn:lane id="prospective_student" name="Prospective Student">
        <bpmn:flowNodeRef>start_enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_application</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_office" name="Admissions Office">
        <bpmn:flowNodeRef>review_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_missing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions_committee" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate_application</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance Department">
        <bpmn:flowNodeRef>process_fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>eval_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_id_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_study_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>international_student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assist_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_confirm_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet_appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>another_semester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT Department">
        <bpmn:flowNodeRef>setup_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="academic_advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>meet_advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin_classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_drop_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_grades</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_enrollment" name="Start enrollment" />
    <bpmn:task id="submit_application" name="Submit application online" />
    <bpmn:task id="review_application" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="missing_documents" name="Documents missing?" />
    <bpmn:task id="notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="evaluate_application" name="Evaluate application" />
    <bpmn:task id="process_fees" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="eval_join" />
    <bpmn:exclusiveGateway id="acceptance" name="Application accepted?" />
    <bpmn:task id="send_acceptance" name="Send acceptance letter" />
    <bpmn:task id="send_rejection" name="Send rejection letter" />
    <bpmn:exclusiveGateway id="confirm_enrollment" name="Student confirms enrollment?" />
    <bpmn:task id="cancel_application" name="Cancel application" />
    <bpmn:task id="receive_orientation" name="Receive orientation materials" />
    <bpmn:task id="obtain_id_card" name="Obtain student ID card" />
    <bpmn:task id="create_study_plan" name="Create study plan" />
    <bpmn:exclusiveGateway id="international_student" name="Is student international?" />
    <bpmn:task id="assist_visa" name="Assist with visa processing" />
    <bpmn:parallelGateway id="intl_join" />
    <bpmn:parallelGateway id="post_confirm_join" />
    <bpmn:exclusiveGateway id="grievance" name="Student has grievance?" />
    <bpmn:task id="submit_appeal" name="Submit appeal form" />
    <bpmn:task id="meet_appeals" name="Meet with appeals committee" />
    <bpmn:task id="await_decision" name="Await decision" />
    <bpmn:exclusiveGateway id="another_semester" name="Another semester?" />
    <bpmn:endEvent id="end_process" name="Process ends" />
    <bpmn:task id="setup_accounts" name="Set up student accounts for email, online portals, and library access" />
    <bpmn:task id="meet_advisor" name="Meet with academic advisor" />
    <bpmn:task id="select_courses" name="Select courses" />
    <bpmn:task id="resolve_conflicts" name="Resolve schedule conflicts" />
    <bpmn:task id="begin_classes" name="Begin attending classes" />
    <bpmn:task id="add_drop_courses" name="Add or drop courses" />
    <bpmn:task id="post_grades" name="Post grades" />
    <bpmn:task id="review_grades" name="Review grades online" />
    <bpmn:sequenceFlow id="f-start_enrollment-submit_application" sourceRef="start_enrollment" targetRef="submit_application" />
    <bpmn:sequenceFlow id="f-submit_application-review_application" sourceRef="submit_application" targetRef="review_application" />
    <bpmn:sequenceFlow id="f-review_application-missing_documents" sourceRef="review_application" targetRef="missing_documents" />
    <bpmn:sequenceFlow id="f-missing_documents-notify_missing" name="yes" sourceRef="missing_documents" targetRef="notify_missing" />
    <bpmn:sequenceFlow id="f-notify_missing-review_application" sourceRef="notify_missing" targetRef="review_application" />
    <bpmn:sequenceFlow id="f-missing_documents-evaluate_application" name="no" sourceRef="missing_documents" targetRef="evaluate_application" />
    <bpmn:sequenceFlow id="f-missing_documents-process_fees" name="no" sourceRef="missing_documents" targetRef="process_fees" />
    <bpmn:sequenceFlow id="f-evaluate_application-eval_join" sourceRef="evaluate_application" targetRef="eval_join" />
    <bpmn:sequenceFlow id="f-process_fees-eval_join" sourceRef="process_fees" targetRef="eval_join" />
    <bpmn:sequenceFlow id="f-eval_join-acceptance" sourceRef="eval_join" targetRef="acceptance" />
    <bpmn:sequenceFlow id="f-acceptance-send_acceptance" name="yes" sourceRef="acceptance" targetRef="send_acceptance" />
    <bpmn:sequenceFlow id="f-acceptance-send_rejection" name="no" sourceRef="acceptance" targetRef="send_rejection" />
    <bpmn:sequenceFlow id="f-send_acceptance-confirm_enrollment" sourceRef="send_acceptance" targetRef="confirm_enrollment" />
    <bpmn:sequenceFlow id="f-send_rejection-end_process" sourceRef="send_rejection" targetRef="end_process" />
    <bpmn:sequenceFlow id="f-confirm_enrollment-receive_orientation" name="yes" sourceRef="confirm_enrollment" targetRef="receive_orientation" />
    <bpmn:sequenceFlow id="f-confirm_enrollment-setup_accounts" name="yes" sourceRef="confirm_enrollment" targetRef="setup_accounts" />
    <bpmn:sequenceFlow id="f-confirm_enrollment-cancel_application" name="no" sourceRef="confirm_enrollment" targetRef="cancel_application" />
    <bpmn:sequenceFlow id="f-receive_orientation-post_confirm_join" sourceRef="receive_orientation" targetRef="post_confirm_join" />
    <bpmn:sequenceFlow id="f-setup_accounts-post_confirm_join" sourceRef="setup_accounts" targetRef="post_confirm_join" />
    <bpmn:sequenceFlow id="f-post_confirm_join-obtain_id_card" sourceRef="post_confirm_join" targetRef="obtain_id_card" />
    <bpmn:sequenceFlow id="f-obtain_id_card-create_study_plan" sourceRef="obtain_id_card" targetRef="create_study_plan" />
    <bpmn:sequenceFlow id="f-create_study_plan-international_student" sourceRef="create_study_plan" targetRef="international_student" />
    <bpmn:sequenceFlow id="f-international_student-assist_visa" name="yes" sourceRef="international_student" targetRef="assist_visa" />
    <bpmn:sequenceFlow id="f-international_student-intl_join" name="no" sourceRef="international_student" targetRef="intl_join" />
    <bpmn:sequenceFlow id="f-assist_visa-intl_join" sourceRef="assist_visa" targetRef="intl_join" />
    <bpmn:sequenceFlow id="f-intl_join-meet_advisor" sourceRef="intl_join" targetRef="meet_advisor" />
    <bpmn:sequenceFlow id="f-meet_advisor-select_courses" sourceRef="meet_advisor" targetRef="select_courses" />
    <bpmn:sequenceFlow id="f-select_courses-resolve_conflicts" sourceRef="select_courses" targetRef="resolve_conflicts" />
    <bpmn:sequenceFlow id="f-resolve_conflicts-begin_classes" sourceRef="resolve_conflicts" targetRef="begin_classes" />
    <bpmn:sequenceFlow id="f-begin_classes-add_drop_courses" sourceRef="begin_classes" targetRef="add_drop_courses" />
    <bpmn:sequenceFlow id="f-add_drop_courses-post_grades" sourceRef="add_drop_courses" targetRef="post_grades" />
    <bpmn:sequenceFlow id="f-post_grades-review_grades" sourceRef="post_grades" targetRef="review_grades" />
    <bpmn:sequenceFlow id="f-review_grades-grievance" sourceRef="review_grades" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-submit_appeal" name="yes" sourceRef="grievance" targetRef="submit_appeal" />
    <bpmn:sequenceFlow id="f-grievance-another_semester" name="no" sourceRef="grievance" targetRef="another_semester" />
    <bpmn:sequenceFlow id="f-submit_appeal-meet_appeals" sourceRef="submit_appeal" targetRef="meet_appeals" />
    <bpmn:sequenceFlow id="f-meet_appeals-await_decision" sourceRef="meet_appeals" targetRef="await_decision" />
    <bpmn:sequenceFlow id="f-await_decision-another_semester" sourceRef="await_decision" targetRef="another_semester" />
    <bpmn:sequenceFlow id="f-another_semester-add_drop_courses" name="yes" sourceRef="another_semester" targetRef="add_drop_courses" />
    <bpmn:sequenceFlow id="f-another_semester-end_process" name="no" sourceRef="another_semester" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
