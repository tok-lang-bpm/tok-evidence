<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Online shop purchase process" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setpayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start order" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="parallel1" />
    <bpmn:task id="select" name="Select items to purchase" />
    <bpmn:task id="setpayment" name="Set payment method" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:parallelGateway id="parallel2" />
    <bpmn:exclusiveGateway id="payment_choice" name="Payment choice?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:task id="reward" name="Choose free reward" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="return_dec" name="Return items?" />
    <bpmn:task id="return" name="Return items for exchange" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="f-start-login" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-parallel1" sourceRef="login" targetRef="parallel1" />
    <bpmn:sequenceFlow id="f-parallel1-select" sourceRef="parallel1" targetRef="select" />
    <bpmn:sequenceFlow id="f-parallel1-setpayment" sourceRef="parallel1" targetRef="setpayment" />
    <bpmn:sequenceFlow id="f-select-join1" sourceRef="select" targetRef="join1" />
    <bpmn:sequenceFlow id="f-setpayment-join1" sourceRef="setpayment" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-parallel2" sourceRef="join1" targetRef="parallel2" />
    <bpmn:sequenceFlow id="f-parallel2-payment_choice" sourceRef="parallel2" targetRef="payment_choice" />
    <bpmn:sequenceFlow id="f-parallel2-reward" sourceRef="parallel2" targetRef="reward" />
    <bpmn:sequenceFlow id="f-payment_choice-pay" name="pay" sourceRef="payment_choice" targetRef="pay" />
    <bpmn:sequenceFlow id="f-payment_choice-installment" name="installment" sourceRef="payment_choice" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-join2" sourceRef="pay" targetRef="join2" />
    <bpmn:sequenceFlow id="f-installment-join2" sourceRef="installment" targetRef="join2" />
    <bpmn:sequenceFlow id="f-reward-join2" sourceRef="reward" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-deliver" sourceRef="join2" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-return_dec" sourceRef="deliver" targetRef="return_dec" />
    <bpmn:sequenceFlow id="f-return_dec-return" name="yes" sourceRef="return_dec" targetRef="return" />
    <bpmn:sequenceFlow id="f-return_dec-end" name="no" sourceRef="return_dec" targetRef="end" />
    <bpmn:sequenceFlow id="f-return-deliver" sourceRef="return" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>
