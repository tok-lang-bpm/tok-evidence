tok 1.0 "Online shop purchase process"

pool shop "Online shop"
  lane user "User"
    start start "Start order"
    task login "Log in to account"
    and parallel1
    task select "Select items to purchase"
    task setpayment "Set payment method"
    and join1
    and parallel2
    xor payment_choice "Payment choice?"
    task pay "Pay"
    task installment "Complete installment agreement"
    task reward "Choose free reward"
    and join2
    task deliver "Deliver items"
    xor return_dec "Return items?"
    task return "Return items for exchange"
    end end "Process end"

    flow start -> login -> parallel1
    flow parallel1 -> select
    flow parallel1 -> setpayment
    flow select -> join1
    flow setpayment -> join1
    flow join1 -> parallel2
    flow parallel2 -> payment_choice
    flow parallel2 -> reward
    flow payment_choice -> pay "pay"
    flow payment_choice -> installment "installment"
    flow pay -> join2
    flow installment -> join2
    flow reward -> join2
    flow join2 -> deliver
    flow deliver -> return_dec
    flow return_dec -> return "yes"
    flow return_dec -> end "no"
    flow return -> deliver
