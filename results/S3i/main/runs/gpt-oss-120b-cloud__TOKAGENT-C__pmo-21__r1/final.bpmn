<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Shipping Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Shipping Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gshipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_pre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics_head" name="Logistics Department Head">
        <bpmn:flowNodeRef>t_insurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>t_package</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistic_company" name="Logistic Company">
        <bpmn:flowNodeRef>t_prepare</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="gshipped" name="Goods shall be shipped?" />
    <bpmn:task id="t_clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="g_large" name="Large amount?" />
    <bpmn:task id="t_invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="t_select" name="Select one logistic company" />
    <bpmn:task id="t_label" name="Write package label" />
    <bpmn:exclusiveGateway id="g_ins" name="Parcel insurance needed?" />
    <bpmn:exclusiveGateway id="join_pre" />
    <bpmn:parallelGateway id="and_fork" />
    <bpmn:parallelGateway id="join_and" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="t_insurance" name="Take parcel insurance" />
    <bpmn:task id="t_package" name="Package the goods" />
    <bpmn:task id="t_prepare" name="Prepare goods for pickup" />
    <bpmn:sequenceFlow id="f-s-gshipped" sourceRef="s" targetRef="gshipped" />
    <bpmn:sequenceFlow id="f-gshipped-t_clarify" name="yes" sourceRef="gshipped" targetRef="t_clarify" />
    <bpmn:sequenceFlow id="f-gshipped-e" name="no" sourceRef="gshipped" targetRef="e" />
    <bpmn:sequenceFlow id="f-t_clarify-g_large" sourceRef="t_clarify" targetRef="g_large" />
    <bpmn:sequenceFlow id="f-g_large-t_invite" name="yes" sourceRef="g_large" targetRef="t_invite" />
    <bpmn:sequenceFlow id="f-g_large-t_label" name="no" sourceRef="g_large" targetRef="t_label" />
    <bpmn:sequenceFlow id="f-t_invite-t_select" sourceRef="t_invite" targetRef="t_select" />
    <bpmn:sequenceFlow id="f-t_select-t_label" sourceRef="t_select" targetRef="t_label" />
    <bpmn:sequenceFlow id="f-t_label-g_ins" sourceRef="t_label" targetRef="g_ins" />
    <bpmn:sequenceFlow id="f-g_ins-join_pre" name="no" sourceRef="g_ins" targetRef="join_pre" />
    <bpmn:sequenceFlow id="f-g_ins-t_insurance" name="yes" sourceRef="g_ins" targetRef="t_insurance" />
    <bpmn:sequenceFlow id="f-t_insurance-join_pre" sourceRef="t_insurance" targetRef="join_pre" />
    <bpmn:sequenceFlow id="f-join_pre-and_fork" sourceRef="join_pre" targetRef="and_fork" />
    <bpmn:sequenceFlow id="f-and_fork-t_package" sourceRef="and_fork" targetRef="t_package" />
    <bpmn:sequenceFlow id="f-and_fork-t_prepare" sourceRef="and_fork" targetRef="t_prepare" />
    <bpmn:sequenceFlow id="f-t_package-join_and" sourceRef="t_package" targetRef="join_and" />
    <bpmn:sequenceFlow id="f-t_prepare-join_and" sourceRef="t_prepare" targetRef="join_and" />
    <bpmn:sequenceFlow id="f-join_and-e" sourceRef="join_and" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
