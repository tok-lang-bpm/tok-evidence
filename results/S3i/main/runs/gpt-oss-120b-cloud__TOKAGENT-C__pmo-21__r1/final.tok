tok 1.0 "Shipping Process"

pool org "Organization"
  lane secretary "Secretary"
    start s "Start"
    xor gshipped "Goods shall be shipped?"
    task t_clarify "Clarify who will do the shipping"
    xor g_large "Large amount?"
    task t_invite "Invite three logistic companies to make offers"
    task t_select "Select one logistic company"
    task t_label "Write package label"
    xor g_ins "Parcel insurance needed?"
    xor join_pre
    and and_fork
    and join_and
    end e "End"
  lane logistics_head "Logistics Department Head"
    task t_insurance "Take parcel insurance"
  lane warehousemen "Warehousemen"
    task t_package "Package the goods"
  lane logistic_company "Logistic Company"
    task t_prepare "Prepare goods for pickup"

flow s -> gshipped
flow gshipped -> t_clarify "yes"
flow gshipped -> e "no"
flow t_clarify -> g_large
flow g_large -> t_invite "yes"
flow g_large -> t_label "no"
flow t_invite -> t_select
flow t_select -> t_label
flow t_label -> g_ins
flow g_ins -> join_pre "no"
flow g_ins -> t_insurance "yes"
flow t_insurance -> join_pre
flow join_pre -> and_fork
flow and_fork -> t_package
flow and_fork -> t_prepare
flow t_package -> join_and
flow t_prepare -> join_and
flow join_and -> e
