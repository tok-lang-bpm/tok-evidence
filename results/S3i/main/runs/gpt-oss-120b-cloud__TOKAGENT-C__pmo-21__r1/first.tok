tok 1.0 "Shipping Process"

pool org "Organization"
  lane secretary "Secretary"
    start s "Start"
    xor goods_shipped "Goods shall be shipped?"
    task clarify "Clarify who will do the shipping"
    xor large_amount "Large amount?"
    task invite_offers "Invite three logistic companies to make offers"
    task select_company "Select one logistic company"
    task write_label "Write package label"
    xor insurance_needed "Parcel insurance needed?"
    task take_insurance "Take parcel insurance"
    and parallel1
    and join_parallel1
    task prepare_pickup "Prepare goods for pickup"
    end e "End"
  lane logistics_head "Logistics Department Head"
    task take_insurance "Take parcel insurance"
  lane warehousemen "Warehousemen"
    task package_goods "Package the goods"
  lane logistic_company "Logistic Company"
    task prepare_pickup "Prepare goods for pickup"

flow s -> goods_shipped
flow goods_shipped "yes" -> clarify
flow goods_shipped "no" -> e
flow clarify -> large_amount
flow large_amount "yes" -> invite_offers
flow large_amount "no" -> write_label
flow invite_offers -> select_company
flow select_company -> write_label
flow write_label -> insurance_needed
flow insurance_needed "yes" -> take_insurance
flow insurance_needed "no" -> parallel1
flow take_insurance -> parallel1
flow parallel1 -> package_goods
flow parallel1 -> prepare_pickup
flow package_goods -> join_parallel1
flow prepare_pickup -> join_parallel1
flow join_parallel1 -> e