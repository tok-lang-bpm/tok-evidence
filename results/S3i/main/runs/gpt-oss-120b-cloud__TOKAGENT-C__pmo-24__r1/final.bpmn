<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Restaurant ordering process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant ordering process" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>react</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endproc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Guest enters restaurant" />
    <bpmn:task id="g1" name="Choose a dish" />
    <bpmn:task id="g2" name="Wait for turn" />
    <bpmn:task id="g3" name="Place order with employee" />
    <bpmn:task id="g4" name="Pick up meal" />
    <bpmn:task id="g5" name="Eat the meal" />
    <bpmn:task id="e1" name="Enter order into POS" />
    <bpmn:task id="e2" name="Collect money from guest" />
    <bpmn:task id="e3" name="Set up buzzer and give to guest" />
    <bpmn:task id="e4" name="Inform chef of new meal order" />
    <bpmn:task id="e5" name="Set off guest's buzzer" />
    <bpmn:task id="e6" name="Call guest after 5 minutes" />
    <bpmn:exclusiveGateway id="react" name="Guest reacts to buzzer?" />
    <bpmn:parallelGateway id="parallel" name="Parallel serving" />
    <bpmn:parallelGateway id="join" name="Serving completed" />
    <bpmn:endEvent id="endproc" name="Process completed" />
    <bpmn:task id="c1" name="Prepare the meal" />
    <bpmn:task id="c2" name="Place meal in service hatch" />
    <bpmn:task id="c3" name="Inform employee meal placed" />
    <bpmn:task id="c4" name="Hand over meal to guest" />
    <bpmn:sequenceFlow id="f-s1-g1" sourceRef="s1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-g2" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-g3" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-e1" sourceRef="g3" targetRef="e1" />
    <bpmn:sequenceFlow id="f-e1-e2" sourceRef="e1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-e2-e3" sourceRef="e2" targetRef="e3" />
    <bpmn:sequenceFlow id="f-e3-e4" sourceRef="e3" targetRef="e4" />
    <bpmn:sequenceFlow id="f-e4-c1" sourceRef="e4" targetRef="c1" />
    <bpmn:sequenceFlow id="f-c1-c2" sourceRef="c1" targetRef="c2" />
    <bpmn:sequenceFlow id="f-c2-c3" sourceRef="c2" targetRef="c3" />
    <bpmn:sequenceFlow id="f-c3-e5" sourceRef="c3" targetRef="e5" />
    <bpmn:sequenceFlow id="f-e5-react" sourceRef="e5" targetRef="react" />
    <bpmn:sequenceFlow id="f-react-parallel" name="yes" sourceRef="react" targetRef="parallel" />
    <bpmn:sequenceFlow id="f-react-e6" name="no" sourceRef="react" targetRef="e6" />
    <bpmn:sequenceFlow id="f-e6-e5" sourceRef="e6" targetRef="e5" />
    <bpmn:sequenceFlow id="f-parallel-g4" sourceRef="parallel" targetRef="g4" />
    <bpmn:sequenceFlow id="f-parallel-c4" sourceRef="parallel" targetRef="c4" />
    <bpmn:sequenceFlow id="f-g4-g5" sourceRef="g4" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-join" sourceRef="g5" targetRef="join" />
    <bpmn:sequenceFlow id="f-c4-join" sourceRef="c4" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-endproc" sourceRef="join" targetRef="endproc" />
  </bpmn:process>
</bpmn:definitions>
