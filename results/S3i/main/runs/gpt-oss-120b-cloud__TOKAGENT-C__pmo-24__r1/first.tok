tok 1.0 "Restaurant ordering process" [executable]
    pool restaurant "Restaurant"
      lane guest "Guest"
        start s1 "Guest enters restaurant"
        task g1 "Choose a dish"
        task g2 "Wait for turn"
        task g3 "Place order with employee"
        task g4 "Pick up meal"
        task g5 "Eat the meal"
        end e_end "Process completed"
      lane employee "Employee"
        task e1 "Enter order into POS"
        task e2 "Collect money from guest"
        task e3 "Set up buzzer and give to guest"
        task e4 "Inform chef of new meal order"
        task e5 "Set off guest's buzzer"
        task e6 "Call guest after 5 minutes"
      lane chef "Chef"
        task c1 "Prepare the meal"
        task c2 "Place meal in service hatch"
        task c3 "Inform employee meal placed"
        task c4 "Hand over meal to guest"
    xor react "Guest reacts to buzzer?"
    and parallel "Parallel serving"
    and join "Serving completed"
    flow s1 -> g1 -> g2 -> g3 -> e1 -> e2 -> e3 -> e4 -> c1 -> c2 -> c3 -> e5 -> react
    flow react "yes" -> parallel
    flow react "no" -> e6 -> react
    flow parallel -> g4
    flow parallel -> c4
    flow g4 -> g5 -> join
    flow c4 -> join
    flow join -> e_end