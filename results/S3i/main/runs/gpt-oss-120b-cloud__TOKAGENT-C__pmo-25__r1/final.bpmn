<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Job Finding Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_one_year</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view_reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rating_low_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continue_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_applicant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="report" name="Report job applications" />
    <bpmn:task id="receive_offers" name="Receive potential job offers" />
    <bpmn:task id="interview" name="Negotiate job interview" />
    <bpmn:task id="probation" name="Enter probation phase" />
    <bpmn:task id="rate_company" name="Rate company" />
    <bpmn:task id="wait_one_year" name="Wait 1 year" />
    <bpmn:task id="view_reviews" name="View company reviews" />
    <bpmn:exclusiveGateway id="interview_gate" name="Interview negotiated?" />
    <bpmn:exclusiveGateway id="merge_interview" name="After interview decision" />
    <bpmn:exclusiveGateway id="offer_gate" name="Company wants you to work?" />
    <bpmn:parallelGateway id="rating_split" name="Rating split" />
    <bpmn:parallelGateway id="rating_join" />
    <bpmn:exclusiveGateway id="permanent_gate" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="rating_low_gate" name="Rating &lt;= C?" />
    <bpmn:task id="continue_offers" name="Continue receiving job offers" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="confirm" name="Confirm receipt and rate application" />
    <bpmn:task id="rate_applicant" name="Rate applicant" />
    <bpmn:sequenceFlow id="f-start-report" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-receive_offers" sourceRef="report" targetRef="receive_offers" />
    <bpmn:sequenceFlow id="f-receive_offers-confirm" sourceRef="receive_offers" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-interview_gate" sourceRef="confirm" targetRef="interview_gate" />
    <bpmn:sequenceFlow id="f-interview_gate-interview" name="yes" sourceRef="interview_gate" targetRef="interview" />
    <bpmn:sequenceFlow id="f-interview_gate-merge_interview" name="no" sourceRef="interview_gate" targetRef="merge_interview" />
    <bpmn:sequenceFlow id="f-interview-merge_interview" sourceRef="interview" targetRef="merge_interview" />
    <bpmn:sequenceFlow id="f-merge_interview-offer_gate" sourceRef="merge_interview" targetRef="offer_gate" />
    <bpmn:sequenceFlow id="f-offer_gate-probation" name="yes" sourceRef="offer_gate" targetRef="probation" />
    <bpmn:sequenceFlow id="f-offer_gate-receive_offers" name="no" sourceRef="offer_gate" targetRef="receive_offers" />
    <bpmn:sequenceFlow id="f-probation-rating_split" sourceRef="probation" targetRef="rating_split" />
    <bpmn:sequenceFlow id="f-rating_split-rate_company" sourceRef="rating_split" targetRef="rate_company" />
    <bpmn:sequenceFlow id="f-rating_split-rate_applicant" sourceRef="rating_split" targetRef="rate_applicant" />
    <bpmn:sequenceFlow id="f-rate_company-rating_join" sourceRef="rate_company" targetRef="rating_join" />
    <bpmn:sequenceFlow id="f-rate_applicant-rating_join" sourceRef="rate_applicant" targetRef="rating_join" />
    <bpmn:sequenceFlow id="f-rating_join-wait_one_year" sourceRef="rating_join" targetRef="wait_one_year" />
    <bpmn:sequenceFlow id="f-wait_one_year-view_reviews" sourceRef="wait_one_year" targetRef="view_reviews" />
    <bpmn:sequenceFlow id="f-view_reviews-permanent_gate" sourceRef="view_reviews" targetRef="permanent_gate" />
    <bpmn:sequenceFlow id="f-permanent_gate-rating_low_gate" name="yes" sourceRef="permanent_gate" targetRef="rating_low_gate" />
    <bpmn:sequenceFlow id="f-permanent_gate-receive_offers" name="no" sourceRef="permanent_gate" targetRef="receive_offers" />
    <bpmn:sequenceFlow id="f-rating_low_gate-continue_offers" name="yes" sourceRef="rating_low_gate" targetRef="continue_offers" />
    <bpmn:sequenceFlow id="f-rating_low_gate-end" name="no" sourceRef="rating_low_gate" targetRef="end" />
    <bpmn:sequenceFlow id="f-continue_offers-receive_offers" sourceRef="continue_offers" targetRef="receive_offers" />
  </bpmn:process>
</bpmn:definitions>
