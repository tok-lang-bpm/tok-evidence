tok 1.0 "Find a Job"

pool org "Job Finding Process"
  lane applicant "Applicant"
    start start "Start"
    task report "Report job applications"
    task receive_offers "Receive potential job offers"
    task interview "Negotiate job interview"
    task probation "Enter probation phase"
    task rate_company "Rate company"
    task wait_one_year "Wait 1 year"
    task view_reviews "View company reviews"
    xor interview_gate "Interview negotiated?"
    xor merge_interview "After interview decision"
    xor offer_gate "Company wants you to work?"
    and rating_split "Rating split"
    and rating_join
    xor permanent_gate "Job becomes permanent?"
    xor rating_low_gate "Rating <= C?"
    task continue_offers "Continue receiving job offers"
    end end "End"
  lane company "Company"
    task confirm "Confirm receipt and rate application"
    task rate_applicant "Rate applicant"

flow start -> report -> receive_offers -> confirm -> interview_gate
flow interview_gate -> interview "yes"
flow interview_gate -> merge_interview "no"
flow interview -> merge_interview
flow merge_interview -> offer_gate
flow offer_gate -> probation "yes"
flow offer_gate -> receive_offers "no"
flow probation -> rating_split
flow rating_split -> rate_company
flow rating_split -> rate_applicant
flow rate_company -> rating_join
flow rate_applicant -> rating_join
flow rating_join -> wait_one_year -> view_reviews -> permanent_gate
flow permanent_gate -> rating_low_gate "yes"
flow permanent_gate -> receive_offers "no"
flow rating_low_gate -> continue_offers "yes"
flow rating_low_gate -> end "no"
flow continue_offers -> receive_offers
