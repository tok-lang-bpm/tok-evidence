tok 1.0 "Becoming A Parent"

pool org "Organization"
  lane parent "Parent"
    start s "Start planning maternity leave"
    task t_fetch "Fetch information about potential models (months duration, split between parents)"
    task t_select "Select maternity leave model"
    task t_collect "Collect relevant information"
    and g_split "Notify split"
    and g_join "Notify join"
    xor g_extend "Extend leave?"
    task t_extend "Extend maternity leave"
    task t_noext "Do not extend leave"
    end e_extended "Leave extended"
    end e_completed "Leave completed"
  lane social_security "Social Security"
    task t_notifySS "Notify Social Security"
  lane company "Company"
    task t_notifyCo "Notify Company"
    task t_gather "Gather information from companies"
    task t_endPeriod "End of the leave period"

flow s -> t_fetch -> t_select -> t_collect -> g_split
flow g_split -> t_notifySS
flow g_split -> t_notifyCo
flow t_notifySS -> g_join
flow t_notifyCo -> g_join
flow g_join -> t_gather
flow t_gather -> t_endPeriod
flow t_endPeriod -> g_extend
flow g_extend -> t_extend "yes"
flow g_extend -> t_noext "no"
flow t_extend -> e_extended
flow t_noext -> e_completed
