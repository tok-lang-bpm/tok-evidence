<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_noext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_extended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="social_security" name="Social Security">
        <bpmn:flowNodeRef>t_notifySS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>t_notifyCo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_endPeriod</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start planning maternity leave" />
    <bpmn:task id="t_fetch" name="Fetch information about potential models (months duration, split between parents)" />
    <bpmn:task id="t_select" name="Select maternity leave model" />
    <bpmn:task id="t_collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="g_split" name="Notify split" />
    <bpmn:parallelGateway id="g_join" name="Notify join" />
    <bpmn:exclusiveGateway id="g_extend" name="Extend leave?" />
    <bpmn:task id="t_extend" name="Extend maternity leave" />
    <bpmn:task id="t_noext" name="Do not extend leave" />
    <bpmn:endEvent id="e_extended" name="Leave extended" />
    <bpmn:endEvent id="e_completed" name="Leave completed" />
    <bpmn:task id="t_notifySS" name="Notify Social Security" />
    <bpmn:task id="t_notifyCo" name="Notify Company" />
    <bpmn:task id="t_gather" name="Gather information from companies" />
    <bpmn:task id="t_endPeriod" name="End of the leave period" />
    <bpmn:sequenceFlow id="f-s-t_fetch" sourceRef="s" targetRef="t_fetch" />
    <bpmn:sequenceFlow id="f-t_fetch-t_select" sourceRef="t_fetch" targetRef="t_select" />
    <bpmn:sequenceFlow id="f-t_select-t_collect" sourceRef="t_select" targetRef="t_collect" />
    <bpmn:sequenceFlow id="f-t_collect-g_split" sourceRef="t_collect" targetRef="g_split" />
    <bpmn:sequenceFlow id="f-g_split-t_notifySS" sourceRef="g_split" targetRef="t_notifySS" />
    <bpmn:sequenceFlow id="f-g_split-t_notifyCo" sourceRef="g_split" targetRef="t_notifyCo" />
    <bpmn:sequenceFlow id="f-t_notifySS-g_join" sourceRef="t_notifySS" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-t_notifyCo-g_join" sourceRef="t_notifyCo" targetRef="g_join" />
    <bpmn:sequenceFlow id="f-g_join-t_gather" sourceRef="g_join" targetRef="t_gather" />
    <bpmn:sequenceFlow id="f-t_gather-t_endPeriod" sourceRef="t_gather" targetRef="t_endPeriod" />
    <bpmn:sequenceFlow id="f-t_endPeriod-g_extend" sourceRef="t_endPeriod" targetRef="g_extend" />
    <bpmn:sequenceFlow id="f-g_extend-t_extend" name="yes" sourceRef="g_extend" targetRef="t_extend" />
    <bpmn:sequenceFlow id="f-g_extend-t_noext" name="no" sourceRef="g_extend" targetRef="t_noext" />
    <bpmn:sequenceFlow id="f-t_extend-e_extended" sourceRef="t_extend" targetRef="e_extended" />
    <bpmn:sequenceFlow id="f-t_noext-e_completed" sourceRef="t_noext" targetRef="e_completed" />
  </bpmn:process>
</bpmn:definitions>
