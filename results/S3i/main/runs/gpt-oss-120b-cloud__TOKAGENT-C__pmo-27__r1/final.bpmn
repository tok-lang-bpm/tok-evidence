<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>party</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_inspector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_insurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done_emp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="self_employed" name="Self-Employed">
        <bpmn:flowNodeRef>self_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done_self</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="education" name="Education">
        <bpmn:flowNodeRef>report_directorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>school_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done_edu</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="acc" name="Accident occurs" />
    <bpmn:task id="gather" name="Gather accident information" />
    <bpmn:task id="inform" name="Inform employer of accident" />
    <bpmn:exclusiveGateway id="party" name="Accident party type?" />
    <bpmn:task id="receive" name="Receive accident report" />
    <bpmn:exclusiveGateway id="serious" name="Fatal or serious injury?" />
    <bpmn:task id="report_inspector" name="Report to Labour Inspectorate" />
    <bpmn:task id="report_insurer" name="Report to accident insurance provider" />
    <bpmn:endEvent id="done_emp" name="Process completed (employee)" />
    <bpmn:task id="self_report" name="Report to accident insurance provider (self-employed)" />
    <bpmn:endEvent id="done_self" name="Process completed (self-employed)" />
    <bpmn:task id="report_directorate" name="Report accident to directorate" />
    <bpmn:task id="school_report" name="School reports to accident insurance provider" />
    <bpmn:endEvent id="done_edu" name="Process completed (education)" />
    <bpmn:sequenceFlow id="f-acc-gather" sourceRef="acc" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-inform" sourceRef="gather" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-party" sourceRef="inform" targetRef="party" />
    <bpmn:sequenceFlow id="f-self_report-done_self" sourceRef="self_report" targetRef="done_self" />
    <bpmn:sequenceFlow id="f-report_directorate-school_report" sourceRef="report_directorate" targetRef="school_report" />
    <bpmn:sequenceFlow id="f-school_report-done_edu" sourceRef="school_report" targetRef="done_edu" />
    <bpmn:sequenceFlow id="f-party-receive" name="Employee" sourceRef="party" targetRef="receive" />
    <bpmn:sequenceFlow id="f-party-self_report" name="Self-Employed" sourceRef="party" targetRef="self_report" />
    <bpmn:sequenceFlow id="f-party-report_directorate" name="Student/School" sourceRef="party" targetRef="report_directorate" />
    <bpmn:sequenceFlow id="f-receive-serious" sourceRef="receive" targetRef="serious" />
    <bpmn:sequenceFlow id="f-serious-report_inspector" name="Yes" sourceRef="serious" targetRef="report_inspector" />
    <bpmn:sequenceFlow id="f-serious-report_insurer" name="No" sourceRef="serious" targetRef="report_insurer" />
    <bpmn:sequenceFlow id="f-report_inspector-report_insurer" sourceRef="report_inspector" targetRef="report_insurer" />
    <bpmn:sequenceFlow id="f-report_insurer-done_emp" sourceRef="report_insurer" targetRef="done_emp" />
  </bpmn:process>
</bpmn:definitions>
