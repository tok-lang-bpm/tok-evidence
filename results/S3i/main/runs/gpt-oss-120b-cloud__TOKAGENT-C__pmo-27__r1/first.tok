tok 1.0 "Work Accident" [executable]
    pool org "Organization"
      lane employee "Employee"
        start acc "Accident occurs"
        task gather "Gather accident information"
        task inform "Inform employer of accident"
        xor party "Accident party type?"
        flow acc -> gather -> inform -> party
        # Employee branch
        lane employer "Employer"
          task receive "Receive accident report"
          xor serious "Fatal or serious injury?"
          task report_inspector "Report to Labour Inspectorate"
          task report_insurer "Report to accident insurance provider"
          end done_emp "Process completed (employee)"
        lane self_employed "Self-Employed"
          task self_report "Report to accident insurance provider (self-employed)"
          end done_self "Process completed (self-employed)"
        lane education "Education"
          task report_directorate "Report accident to directorate"
          task school_report "School reports to accident insurance provider"
          end done_edu "Process completed (education)"
        # Flows for branches
        flow party -> receive "Employee"
        flow party -> self_report "Self-Employed"
        flow party -> report_directorate "Student/School"
        # Employee path flows
        flow receive -> serious
        flow serious -> report_inspector "Yes"
        flow serious -> report_insurer "No"
        flow report_inspector -> report_insurer
        flow report_insurer -> done_emp
        # Education path flows
        flow report_directorate -> school_report -> done_edu
