<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="intern" name="Intern">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_prefs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_intern_update1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_intern_update2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_intern_update3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweets_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweets_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>write_company_update1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_company_update2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_company_update3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enter_prefs" name="Enter preferences" />
    <bpmn:task id="receive_offer" name="Receive offer" />
    <bpmn:exclusiveGateway id="accept_dec" name="Offer accepted?" />
    <bpmn:task id="accept_offer" name="Accept offer" />
    <bpmn:parallelGateway id="updates_fork" name="Updates fork" />
    <bpmn:task id="write_intern_update1" name="Write intern status update 1" />
    <bpmn:task id="write_intern_update2" name="Write intern status update 2" />
    <bpmn:task id="write_intern_update3" name="Write intern status update 3" />
    <bpmn:parallelGateway id="updates_join" name="Updates join" />
    <bpmn:parallelGateway id="tweets_fork" name="Tweets fork" />
    <bpmn:task id="tweet1" name="Tweet friend 1" />
    <bpmn:task id="tweet2" name="Tweet friend 2" />
    <bpmn:parallelGateway id="tweets_join" name="Tweets join" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="write_company_update1" name="Write company status update 1" />
    <bpmn:task id="write_company_update2" name="Write company status update 2" />
    <bpmn:task id="write_company_update3" name="Write company status update 3" />
    <bpmn:sequenceFlow id="f-start-enter_prefs" sourceRef="start" targetRef="enter_prefs" />
    <bpmn:sequenceFlow id="f-enter_prefs-receive_offer" sourceRef="enter_prefs" targetRef="receive_offer" />
    <bpmn:sequenceFlow id="f-receive_offer-accept_dec" sourceRef="receive_offer" targetRef="accept_dec" />
    <bpmn:sequenceFlow id="f-accept_dec-accept_offer" name="yes" sourceRef="accept_dec" targetRef="accept_offer" />
    <bpmn:sequenceFlow id="f-accept_dec-receive_offer" name="no" sourceRef="accept_dec" targetRef="receive_offer" />
    <bpmn:sequenceFlow id="f-accept_offer-updates_fork" sourceRef="accept_offer" targetRef="updates_fork" />
    <bpmn:sequenceFlow id="f-updates_fork-write_intern_update1" sourceRef="updates_fork" targetRef="write_intern_update1" />
    <bpmn:sequenceFlow id="f-updates_fork-write_company_update1" sourceRef="updates_fork" targetRef="write_company_update1" />
    <bpmn:sequenceFlow id="f-write_intern_update1-write_intern_update2" sourceRef="write_intern_update1" targetRef="write_intern_update2" />
    <bpmn:sequenceFlow id="f-write_intern_update2-write_intern_update3" sourceRef="write_intern_update2" targetRef="write_intern_update3" />
    <bpmn:sequenceFlow id="f-write_intern_update3-updates_join" sourceRef="write_intern_update3" targetRef="updates_join" />
    <bpmn:sequenceFlow id="f-write_company_update1-write_company_update2" sourceRef="write_company_update1" targetRef="write_company_update2" />
    <bpmn:sequenceFlow id="f-write_company_update2-write_company_update3" sourceRef="write_company_update2" targetRef="write_company_update3" />
    <bpmn:sequenceFlow id="f-write_company_update3-updates_join" sourceRef="write_company_update3" targetRef="updates_join" />
    <bpmn:sequenceFlow id="f-updates_join-tweets_fork" sourceRef="updates_join" targetRef="tweets_fork" />
    <bpmn:sequenceFlow id="f-tweets_fork-tweet1" sourceRef="tweets_fork" targetRef="tweet1" />
    <bpmn:sequenceFlow id="f-tweets_fork-tweet2" sourceRef="tweets_fork" targetRef="tweet2" />
    <bpmn:sequenceFlow id="f-tweet1-tweets_join" sourceRef="tweet1" targetRef="tweets_join" />
    <bpmn:sequenceFlow id="f-tweet2-tweets_join" sourceRef="tweet2" targetRef="tweets_join" />
    <bpmn:sequenceFlow id="f-tweets_join-end" sourceRef="tweets_join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
