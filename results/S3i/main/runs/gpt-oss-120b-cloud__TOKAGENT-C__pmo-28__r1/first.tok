tok 1.0 "Internship" [executable]
    pool org "Organisation"
      lane intern "Intern"
        start start "Start"
        task enter_prefs "Enter preferences"
        task receive_offer "Receive offer"
        xor accept_dec "Offer accepted?"
        task accept_offer "Accept offer"
        and updates_parallel "Updates parallel"
        task write_intern_update1 "Write intern status update 1"
        task write_intern_update2 "Write intern status update 2"
        task write_intern_update3 "Write intern status update 3"
        and updates_join "Updates join"
        and tweets_parallel "Send tweets"
        task tweet1 "Tweet friend 1"
        task tweet2 "Tweet friend 2"
        and tweets_join "Tweets join"
        end end "End"
      lane company "Company"
        task write_company_update1 "Write company status update 1"
        task write_company_update2 "Write company status update 2"
        task write_company_update3 "Write company status update 3"

    flow start -> enter_prefs -> receive_offer -> accept_dec
    flow accept_dec "yes" -> accept_offer
    flow accept_dec "no" -> receive_offer
    flow accept_offer -> updates_parallel
    flow updates_parallel -> write_intern_update1
    flow updates_parallel -> write_company_update1
    flow write_intern_update1 -> write_intern_update2
    flow write_intern_update2 -> write_intern_update3
    flow write_intern_update3 -> updates_join
    flow write_company_update1 -> write_company_update2
    flow write_company_update2 -> write_company_update3
    flow write_company_update3 -> updates_join
    flow updates_join -> tweets_parallel
    flow tweets_parallel -> tweet1
    flow tweets_parallel -> tweet2
    flow tweet1 -> tweets_join
    flow tweet2 -> tweets_join
    flow tweets_join -> end