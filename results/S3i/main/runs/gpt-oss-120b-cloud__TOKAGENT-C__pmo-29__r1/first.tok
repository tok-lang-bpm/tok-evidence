tok 1.0 "Work and Live in Austria" [executable]

pool org "Austria Relocation Process"
  lane applicant "Applicant"
    start start1 "Start"
    task check_requirements "Check requirements for working and living in Austria"
    and and_split "Parallel preparation"
    task organize_accommodation_bank "Organize accommodation and bank account (negotiation)"
    task collect_visa_form "Collect visa application form"
    task collect_travel_document "Collect travel document (valid > visa +3 months, 2 empty pages, issued <10 years)"
    task collect_passport_photo "Collect passport photo (35x45mm, criteria)"
    task collect_health_insurance "Collect travel health insurance (30,000 Euro, Schengen)"
    task collect_means_of_subsistence "Collect proof of sufficient means of subsistence"
    task collect_other_evidence "Collect other evidence (hotel reservations, invitations, etc.)"
    xor visa_docs_ready "All visa documents ready?"
    task submit_visa_application "Submit visa application to representation"
    and and_join "Join preparation"
    end end1 "Process completed"
  lane representation "Representation"
    task review_application "Review visa application"
    xor visa_decision "Visa approved?"
    task issue_visa "Issue visa"
    task request_additional_documents "Request additional documents"

flow start1 -> check_requirements -> and_split
flow and_split -> organize_accommodation_bank
flow and_split -> collect_visa_form -> collect_travel_document -> collect_passport_photo -> collect_health_insurance -> collect_means_of_subsistence -> collect_other_evidence -> visa_docs_ready
flow visa_docs_ready "yes" -> submit_visa_application
flow visa_docs_ready "no" -> request_additional_documents
flow submit_visa_application -> review_application
flow review_application -> visa_decision
flow visa_decision "yes" -> issue_visa
flow visa_decision "no" -> request_additional_documents
flow request_additional_documents -> collect_visa_form
flow issue_visa -> and_join
flow organize_accommodation_bank -> and_join
flow and_join -> end1