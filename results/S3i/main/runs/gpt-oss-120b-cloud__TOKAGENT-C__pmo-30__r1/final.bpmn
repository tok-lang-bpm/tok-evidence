<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN Party Planning" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="organizer" name="Organizer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download_games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gate_join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer_enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start planning" />
    <bpmn:task id="send_inv" name="Send invitations" />
    <bpmn:task id="find_games" name="Find out games" />
    <bpmn:parallelGateway id="gate1" name="Parallel split" />
    <bpmn:task id="appoint_date" name="Appoint date" />
    <bpmn:exclusiveGateway id="agree" name="8 or more agree?" />
    <bpmn:task id="check_games" name="Check games availability" />
    <bpmn:exclusiveGateway id="games_missing" name="Games missing?" />
    <bpmn:task id="download_games" name="Download missing games" />
    <bpmn:parallelGateway id="gate_join1" name="Parallel join" />
    <bpmn:task id="find_beer" name="Find out beer requirement" />
    <bpmn:exclusiveGateway id="beer_enough" name="Enough beer?" />
    <bpmn:task id="buy_beer" name="Buy missing beer" />
    <bpmn:task id="enjoy" name="Enjoy LAN party" />
    <bpmn:endEvent id="e" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f-s-send_inv" sourceRef="s" targetRef="send_inv" />
    <bpmn:sequenceFlow id="f-send_inv-find_games" sourceRef="send_inv" targetRef="find_games" />
    <bpmn:sequenceFlow id="f-find_games-gate1" sourceRef="find_games" targetRef="gate1" />
    <bpmn:sequenceFlow id="f-gate1-appoint_date" sourceRef="gate1" targetRef="appoint_date" />
    <bpmn:sequenceFlow id="f-appoint_date-agree" sourceRef="appoint_date" targetRef="agree" />
    <bpmn:sequenceFlow id="f-gate1-check_games" sourceRef="gate1" targetRef="check_games" />
    <bpmn:sequenceFlow id="f-check_games-games_missing" sourceRef="check_games" targetRef="games_missing" />
    <bpmn:sequenceFlow id="f-agree-gate_join1" name="yes" sourceRef="agree" targetRef="gate_join1" />
    <bpmn:sequenceFlow id="f-agree-appoint_date" name="no" sourceRef="agree" targetRef="appoint_date" />
    <bpmn:sequenceFlow id="f-games_missing-download_games" name="yes" sourceRef="games_missing" targetRef="download_games" />
    <bpmn:sequenceFlow id="f-download_games-gate_join1" sourceRef="download_games" targetRef="gate_join1" />
    <bpmn:sequenceFlow id="f-games_missing-gate_join1" name="no" sourceRef="games_missing" targetRef="gate_join1" />
    <bpmn:sequenceFlow id="f-gate_join1-find_beer" sourceRef="gate_join1" targetRef="find_beer" />
    <bpmn:sequenceFlow id="f-find_beer-beer_enough" sourceRef="find_beer" targetRef="beer_enough" />
    <bpmn:sequenceFlow id="f-beer_enough-enjoy" name="yes" sourceRef="beer_enough" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-beer_enough-buy_beer" name="no" sourceRef="beer_enough" targetRef="buy_beer" />
    <bpmn:sequenceFlow id="f-buy_beer-enjoy" sourceRef="buy_beer" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-e" sourceRef="enjoy" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
