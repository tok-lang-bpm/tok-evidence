tok 1.0 "LAN Party"

pool org "LAN Party Planning"
  lane organizer "Organizer"
    start s "Start planning"
    task send_inv "Send invitations"
    task find_games "Find out games"
    and gate1 "Parallel split"
    task appoint_date "Appoint date"
    xor agree "8 or more agree?"
    task check_games "Check games availability"
    xor games_missing "Games missing?"
    task download_games "Download missing games"
    and gate_join1 "Parallel join"
    task find_beer "Find out beer requirement"
    xor beer_enough "Enough beer?"
    task buy_beer "Buy missing beer"
    task enjoy "Enjoy LAN party"
    end e "LAN party enjoyed"

    flow s -> send_inv -> find_games -> gate1
    flow gate1 -> appoint_date -> agree
    flow gate1 -> check_games -> games_missing
    flow agree -> gate_join1 "yes"
    flow agree -> appoint_date "no"
    flow games_missing -> download_games "yes"
    flow download_games -> gate_join1
    flow games_missing -> gate_join1 "no"
    flow gate_join1 -> find_beer -> beer_enough
    flow beer_enough -> enjoy "yes"
    flow beer_enough -> buy_beer "no"
    flow buy_beer -> enjoy
    flow enjoy -> e
