<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Blizzard" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_pw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name_ideas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_pw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_character</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>check_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payment_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_bank</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start character creation" />
    <bpmn:parallelGateway id="split_pw" name="Setup and naming in parallel" />
    <bpmn:task id="name_ideas" name="Come up with good character names" />
    <bpmn:parallelGateway id="join_pw" name="Join after setup and naming" />
    <bpmn:task id="log_in" name="Log into the game" />
    <bpmn:task id="select_character" name="Select realm, race and class of your character" />
    <bpmn:task id="enter_name" name="Enter character name" />
    <bpmn:exclusiveGateway id="name_ok" name="Name available?" />
    <bpmn:task id="get_confirmation" name="Receive confirmation and character selfies" />
    <bpmn:exclusiveGateway id="expansion" name="Expansion released?" />
    <bpmn:task id="expansion_msg" name="Receive expansion message" />
    <bpmn:endEvent id="e_yes" name="End (process completed)" />
    <bpmn:endEvent id="e_no" name="End (no expansion)" />
    <bpmn:task id="check_account" name="Check battle.net account" />
    <bpmn:exclusiveGateway id="has_account" name="Battle.net account?" />
    <bpmn:task id="enter_account" name="Enter account information" />
    <bpmn:task id="click_confirmation" name="Click confirmation link" />
    <bpmn:task id="check_subscription" name="Check active WoW subscription" />
    <bpmn:exclusiveGateway id="has_subscription" name="Active WoW subscription?" />
    <bpmn:task id="select_payment" name="Select payment method" />
    <bpmn:exclusiveGateway id="payment_method" name="Payment method?" />
    <bpmn:task id="enter_credit" name="Enter credit card information" />
    <bpmn:task id="enter_bank" name="Enter IBAN and BIC numbers" />
    <bpmn:sequenceFlow id="f-s-split_pw" sourceRef="s" targetRef="split_pw" />
    <bpmn:sequenceFlow id="f-split_pw-name_ideas" sourceRef="split_pw" targetRef="name_ideas" />
    <bpmn:sequenceFlow id="f-split_pw-check_account" sourceRef="split_pw" targetRef="check_account" />
    <bpmn:sequenceFlow id="f-name_ideas-join_pw" sourceRef="name_ideas" targetRef="join_pw" />
    <bpmn:sequenceFlow id="f-check_account-has_account" sourceRef="check_account" targetRef="has_account" />
    <bpmn:sequenceFlow id="f-has_account-check_subscription" name="yes" sourceRef="has_account" targetRef="check_subscription" />
    <bpmn:sequenceFlow id="f-has_account-enter_account" name="no" sourceRef="has_account" targetRef="enter_account" />
    <bpmn:sequenceFlow id="f-enter_account-click_confirmation" sourceRef="enter_account" targetRef="click_confirmation" />
    <bpmn:sequenceFlow id="f-click_confirmation-check_subscription" sourceRef="click_confirmation" targetRef="check_subscription" />
    <bpmn:sequenceFlow id="f-check_subscription-has_subscription" sourceRef="check_subscription" targetRef="has_subscription" />
    <bpmn:sequenceFlow id="f-has_subscription-join_pw" name="yes" sourceRef="has_subscription" targetRef="join_pw" />
    <bpmn:sequenceFlow id="f-has_subscription-select_payment" name="no" sourceRef="has_subscription" targetRef="select_payment" />
    <bpmn:sequenceFlow id="f-select_payment-payment_method" sourceRef="select_payment" targetRef="payment_method" />
    <bpmn:sequenceFlow id="f-payment_method-enter_credit" name="credit card" sourceRef="payment_method" targetRef="enter_credit" />
    <bpmn:sequenceFlow id="f-enter_credit-join_pw" sourceRef="enter_credit" targetRef="join_pw" />
    <bpmn:sequenceFlow id="f-payment_method-enter_bank" name="bank account" sourceRef="payment_method" targetRef="enter_bank" />
    <bpmn:sequenceFlow id="f-enter_bank-join_pw" sourceRef="enter_bank" targetRef="join_pw" />
    <bpmn:sequenceFlow id="f-join_pw-log_in" sourceRef="join_pw" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-log_in-select_character" sourceRef="log_in" targetRef="select_character" />
    <bpmn:sequenceFlow id="f-select_character-enter_name" sourceRef="select_character" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-enter_name-name_ok" sourceRef="enter_name" targetRef="name_ok" />
    <bpmn:sequenceFlow id="f-name_ok-get_confirmation" name="yes" sourceRef="name_ok" targetRef="get_confirmation" />
    <bpmn:sequenceFlow id="f-name_ok-enter_name" name="no" sourceRef="name_ok" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-get_confirmation-expansion" sourceRef="get_confirmation" targetRef="expansion" />
    <bpmn:sequenceFlow id="f-expansion-expansion_msg" name="yes" sourceRef="expansion" targetRef="expansion_msg" />
    <bpmn:sequenceFlow id="f-expansion_msg-e_yes" sourceRef="expansion_msg" targetRef="e_yes" />
    <bpmn:sequenceFlow id="f-expansion-e_no" name="no" sourceRef="expansion" targetRef="e_no" />
  </bpmn:process>
</bpmn:definitions>
