tok 1.0 "Blizzard Online Character Generator"

pool org "Blizzard"
  lane user "User"
    start s "Start character creation"
    and split_pw "Setup and naming in parallel"
    task name_ideas "Come up with good character names"
    and join_pw "Join after setup and naming"
    task log_in "Log into the game"
    task select_character "Select realm, race and class of your character"
    task enter_name "Enter character name"
    xor name_ok "Name available?"
    task get_confirmation "Receive confirmation and character selfies"
    xor expansion "Expansion released?"
    task expansion_msg "Receive expansion message"
    end e_yes "End (process completed)"
    end e_no "End (no expansion)"
  lane system "System"
    task check_account "Check battle.net account"
    xor has_account "Battle.net account?"
    task enter_account "Enter account information"
    task click_confirmation "Click confirmation link"
    task check_subscription "Check active WoW subscription"
    xor has_subscription "Active WoW subscription?"
    task select_payment "Select payment method"
    xor payment_method "Payment method?"
    task enter_credit "Enter credit card information"
    task enter_bank "Enter IBAN and BIC numbers"

flow s -> split_pw
flow split_pw -> name_ideas
flow split_pw -> check_account
flow name_ideas -> join_pw
flow check_account -> has_account
flow has_account -> check_subscription "yes"
flow has_account -> enter_account "no"
flow enter_account -> click_confirmation
flow click_confirmation -> check_subscription
flow check_subscription -> has_subscription
flow has_subscription -> join_pw "yes"
flow has_subscription -> select_payment "no"
flow select_payment -> payment_method
flow payment_method -> enter_credit "credit card"
flow enter_credit -> join_pw
flow payment_method -> enter_bank "bank account"
flow enter_bank -> join_pw
flow join_pw -> log_in
flow log_in -> select_character
flow select_character -> enter_name
flow enter_name -> name_ok
flow name_ok -> get_confirmation "yes"
flow name_ok -> enter_name "no"
flow get_confirmation -> expansion
flow expansion -> expansion_msg "yes"
flow expansion_msg -> e_yes
flow expansion -> e_no "no"
