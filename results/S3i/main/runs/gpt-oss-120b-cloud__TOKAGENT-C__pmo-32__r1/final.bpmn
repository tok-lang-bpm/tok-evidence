<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Farming Bot" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Farming Bot" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bot" name="Bot">
        <bpmn:flowNodeRef>and1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cr1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cr2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>br</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="dp" name="Define resource preferences" />
    <bpmn:parallelGateway id="and1" name="Collect resources split" />
    <bpmn:task id="cr1" name="Collect resource" />
    <bpmn:task id="cr2" name="Collect additional resource" />
    <bpmn:parallelGateway id="and3" name="Join collected resources" />
    <bpmn:exclusiveGateway id="tn" name="Tools needed?" />
    <bpmn:task id="ct" name="Create tools" />
    <bpmn:task id="sf" name="Start farming" />
    <bpmn:exclusiveGateway id="disc" name="Disaster occurs?" />
    <bpmn:task id="hd" name="Handle disaster" />
    <bpmn:task id="nm" name="Notify milestone" />
    <bpmn:exclusiveGateway id="share" name="Share results?" />
    <bpmn:task id="br" name="Brag to selected friends" />
    <bpmn:task id="sm" name="Send materials to selected friends" />
    <bpmn:endEvent id="e" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-dp" sourceRef="s" targetRef="dp" />
    <bpmn:sequenceFlow id="f-dp-and1" sourceRef="dp" targetRef="and1" />
    <bpmn:sequenceFlow id="f-and1-cr1" sourceRef="and1" targetRef="cr1" />
    <bpmn:sequenceFlow id="f-and1-cr2" sourceRef="and1" targetRef="cr2" />
    <bpmn:sequenceFlow id="f-cr1-and3" sourceRef="cr1" targetRef="and3" />
    <bpmn:sequenceFlow id="f-cr2-and3" sourceRef="cr2" targetRef="and3" />
    <bpmn:sequenceFlow id="f-and3-tn" sourceRef="and3" targetRef="tn" />
    <bpmn:sequenceFlow id="f-tn-ct" name="yes" sourceRef="tn" targetRef="ct" />
    <bpmn:sequenceFlow id="f-tn-sf" name="no" sourceRef="tn" targetRef="sf" />
    <bpmn:sequenceFlow id="f-ct-sf" sourceRef="ct" targetRef="sf" />
    <bpmn:sequenceFlow id="f-sf-disc" sourceRef="sf" targetRef="disc" />
    <bpmn:sequenceFlow id="f-disc-hd" name="yes" sourceRef="disc" targetRef="hd" />
    <bpmn:sequenceFlow id="f-hd-sf" sourceRef="hd" targetRef="sf" />
    <bpmn:sequenceFlow id="f-disc-nm" name="no" sourceRef="disc" targetRef="nm" />
    <bpmn:sequenceFlow id="f-nm-share" sourceRef="nm" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-br" name="brag" sourceRef="share" targetRef="br" />
    <bpmn:sequenceFlow id="f-share-sm" name="send" sourceRef="share" targetRef="sm" />
    <bpmn:sequenceFlow id="f-br-e" sourceRef="br" targetRef="e" />
    <bpmn:sequenceFlow id="f-sm-e" sourceRef="sm" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
