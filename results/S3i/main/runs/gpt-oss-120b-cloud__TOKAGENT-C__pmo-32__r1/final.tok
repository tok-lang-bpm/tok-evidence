tok 1.0 "Farming Bot"

pool org "Organization"
  lane player "Player"
    start s "Start"
    task dp "Define resource preferences"
  lane bot "Bot"
    and and1 "Collect resources split"
    task cr1 "Collect resource"
    task cr2 "Collect additional resource"
    and and3 "Join collected resources"
    xor tn "Tools needed?"
    task ct "Create tools"
    task sf "Start farming"
    xor disc "Disaster occurs?"
    task hd "Handle disaster"
    task nm "Notify milestone"
    xor share "Share results?"
    task br "Brag to selected friends"
    task sm "Send materials to selected friends"
    end e "Process completed"

flow s -> dp -> and1
flow and1 -> cr1
flow and1 -> cr2
flow cr1 -> and3
flow cr2 -> and3
flow and3 -> tn
flow tn -> ct "yes"
flow tn -> sf "no"
flow ct -> sf
flow sf -> disc
flow disc -> hd "yes"
flow hd -> sf
flow disc -> nm "no"
flow nm -> share
flow share -> br "brag"
flow share -> sm "send"
flow br -> e
flow sm -> e
