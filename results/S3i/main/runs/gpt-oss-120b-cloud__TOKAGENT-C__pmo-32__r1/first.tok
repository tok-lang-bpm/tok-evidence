tok 1.0 "Farming Bot"

pool org "Organization"
  lane player "Player"
    start s "Start"
    task dp "Define resource preferences"
    end e "Process completed"
  lane bot "Bot"
    and and1 "Collect resources split"
    task cr "Collect resources"
    xor tn "Tools needed?"
    task ct "Create tools"
    and and2 "Join collection and tools"
    task sf "Start farming"
    xor disc "Disaster occurs?"
    task hd "Handle disaster"
    task nm "Notify milestone"
    xor share "Share results"
    task br "Brag to selected friends"
    task sm "Send materials to selected friends"
    end e "Process completed"

flow s -> dp -> and1
flow and1 -> cr
flow cr -> tn
flow tn -> ct "yes"
flow tn -> and2 "no"
flow ct -> and2
flow and2 -> sf
flow sf -> disc
flow disc -> hd "yes"
flow hd -> sf
flow disc -> nm "no"
flow nm -> share
flow share -> br "brag"
flow share -> sm "send"
flow br -> e
flow sm -> e