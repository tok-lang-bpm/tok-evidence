<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Instruct artist to create 3D model and print it" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="3D Model Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Instruct artist to create 3D model and print it" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose_color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>in_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount_low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_on_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_before_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turn_on</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create_model</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="instruct" name="Instruct artist to create project" />
    <bpmn:task id="send_sketches" name="Send sketches to artist" />
    <bpmn:task id="tell_changes" name="Tell artist changes" />
    <bpmn:exclusiveGateway id="satisfied" name="Result satisfied?" />
    <bpmn:task id="choose_color" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="in_stock" name="Color in stock?" />
    <bpmn:task id="check_amount" name="Check color amount" />
    <bpmn:exclusiveGateway id="amount_low" name="Amount under 100g?" />
    <bpmn:task id="put_on_list" name="Put color on shopping list" />
    <bpmn:task id="order_color" name="Order plastic color" />
    <bpmn:parallelGateway id="join_before_parallel" name="Ready for parallel split" />
    <bpmn:parallelGateway id="parallel_split" name="Prepare printing" />
    <bpmn:task id="turn_on" name="Turn printer on and heat up" />
    <bpmn:task id="generate_gcode" name="Generate gcode file" />
    <bpmn:parallelGateway id="parallel_join" name="Ready to print" />
    <bpmn:task id="print_model" name="Print the model" />
    <bpmn:endEvent id="end1" name="Process completed" />
    <bpmn:task id="create_model" name="Create 3D model" />
    <bpmn:sequenceFlow id="f-start1-instruct" sourceRef="start1" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-send_sketches" sourceRef="instruct" targetRef="send_sketches" />
    <bpmn:sequenceFlow id="f-send_sketches-tell_changes" sourceRef="send_sketches" targetRef="tell_changes" />
    <bpmn:sequenceFlow id="f-tell_changes-satisfied" sourceRef="tell_changes" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-satisfied-tell_changes" name="no" sourceRef="satisfied" targetRef="tell_changes" />
    <bpmn:sequenceFlow id="f-satisfied-create_model" name="yes" sourceRef="satisfied" targetRef="create_model" />
    <bpmn:sequenceFlow id="f-create_model-choose_color" sourceRef="create_model" targetRef="choose_color" />
    <bpmn:sequenceFlow id="f-choose_color-in_stock" sourceRef="choose_color" targetRef="in_stock" />
    <bpmn:sequenceFlow id="f-in_stock-check_amount" name="yes" sourceRef="in_stock" targetRef="check_amount" />
    <bpmn:sequenceFlow id="f-in_stock-order_color" name="no" sourceRef="in_stock" targetRef="order_color" />
    <bpmn:sequenceFlow id="f-check_amount-amount_low" sourceRef="check_amount" targetRef="amount_low" />
    <bpmn:sequenceFlow id="f-amount_low-put_on_list" name="yes" sourceRef="amount_low" targetRef="put_on_list" />
    <bpmn:sequenceFlow id="f-amount_low-join_before_parallel" name="no" sourceRef="amount_low" targetRef="join_before_parallel" />
    <bpmn:sequenceFlow id="f-order_color-join_before_parallel" sourceRef="order_color" targetRef="join_before_parallel" />
    <bpmn:sequenceFlow id="f-put_on_list-join_before_parallel" sourceRef="put_on_list" targetRef="join_before_parallel" />
    <bpmn:sequenceFlow id="f-join_before_parallel-parallel_split" sourceRef="join_before_parallel" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f-parallel_split-turn_on" sourceRef="parallel_split" targetRef="turn_on" />
    <bpmn:sequenceFlow id="f-parallel_split-generate_gcode" sourceRef="parallel_split" targetRef="generate_gcode" />
    <bpmn:sequenceFlow id="f-turn_on-parallel_join" sourceRef="turn_on" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-generate_gcode-parallel_join" sourceRef="generate_gcode" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-parallel_join-print_model" sourceRef="parallel_join" targetRef="print_model" />
    <bpmn:sequenceFlow id="f-print_model-end1" sourceRef="print_model" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
