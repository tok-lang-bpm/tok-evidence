<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="dev" name="Develop basic design" />
    <bpmn:task id="ord" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give Lego sets to children" />
    <bpmn:task id="build" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="parts_check" name="Parts available?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="test" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="test_check" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign subcomponent" />
    <bpmn:task id="assemble" name="Assemble subcomponents" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:task id="sort" name="Sort parts into containers" />
    <bpmn:sequenceFlow id="f-s-dev" sourceRef="s" targetRef="dev" />
    <bpmn:sequenceFlow id="f-dev-ord" sourceRef="dev" targetRef="ord" />
    <bpmn:sequenceFlow id="f-ord-give" sourceRef="ord" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-build" sourceRef="sort" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-parts_check" sourceRef="build" targetRef="parts_check" />
    <bpmn:sequenceFlow id="f-parts_check-reorder" name="no" sourceRef="parts_check" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-parts_check-test" name="yes" sourceRef="parts_check" targetRef="test" />
    <bpmn:sequenceFlow id="f-reorder-build" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f-test-test_check" sourceRef="test" targetRef="test_check" />
    <bpmn:sequenceFlow id="f-test_check-assemble" name="yes" sourceRef="test_check" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-test_check-redesign" name="no" sourceRef="test_check" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-redesign-build" sourceRef="redesign" targetRef="build" />
    <bpmn:sequenceFlow id="f-assemble-e" sourceRef="assemble" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
