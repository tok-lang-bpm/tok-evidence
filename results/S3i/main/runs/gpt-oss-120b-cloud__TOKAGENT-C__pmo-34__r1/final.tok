tok 1.0 "Building a custom machine out of Lego bricks"

pool org "Organization"
  lane builder "Builder"
    start s "Start"
    task dev "Develop basic design"
    task ord "Order Lego brick sets"
    task give "Give Lego sets to children"
    task build "Build subcomponent"
    xor parts_check "Parts available?"
    task reorder "Reorder individual parts"
    task test "Test subcomponent"
    xor test_check "Test successful?"
    task redesign "Redesign subcomponent"
    task assemble "Assemble subcomponents"
    end e "End"
  lane children "Children"
    task sort "Sort parts into containers"

flow s -> dev -> ord -> give -> sort -> build -> parts_check
flow parts_check -> reorder "no"
flow parts_check -> test "yes"
flow reorder -> build
flow test -> test_check
flow test_check -> assemble "yes"
flow test_check -> redesign "no"
flow redesign -> build
flow assemble -> e
