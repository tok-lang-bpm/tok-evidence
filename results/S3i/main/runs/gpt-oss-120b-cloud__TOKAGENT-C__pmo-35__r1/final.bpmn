<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Chainsaw production" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Chainsaw" isExecutable="true">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="maker" name="Maker">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveSpecs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderGuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderChain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMotor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspectParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer" name="Customer" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order received" />
    <bpmn:task id="receiveSpecs" name="Receive order specifications" />
    <bpmn:parallelGateway id="split" name="Order parts in parallel" />
    <bpmn:task id="orderGuideBar" name="Order guide bar" />
    <bpmn:task id="orderChain" name="Order chain" />
    <bpmn:task id="orderMotor" name="Order motor" />
    <bpmn:parallelGateway id="join" name="Parts ordered" />
    <bpmn:task id="receiveParts" name="Receive parts" />
    <bpmn:task id="inspectParts" name="Inspect parts" />
    <bpmn:task id="assemble" name="Assemble chainsaw" />
    <bpmn:task id="sendUpdates" name="Send production updates" />
    <bpmn:task id="produceFirst" name="Produce first saw" />
    <bpmn:task id="sendFirst" name="Send first saw" />
    <bpmn:exclusiveGateway id="likeDecision" name="Customer likes first saw?" default="f-likeDecision-endFail" />
    <bpmn:task id="produceRest" name="Produce remaining saws" />
    <bpmn:endEvent id="endSuccess" name="Order completed" />
    <bpmn:endEvent id="endFail" name="Order not completed" />
    <bpmn:sequenceFlow id="f-start-receiveSpecs" sourceRef="start" targetRef="receiveSpecs" />
    <bpmn:sequenceFlow id="f-receiveSpecs-split" sourceRef="receiveSpecs" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-orderGuideBar" sourceRef="split" targetRef="orderGuideBar" />
    <bpmn:sequenceFlow id="f-split-orderChain" sourceRef="split" targetRef="orderChain" />
    <bpmn:sequenceFlow id="f-split-orderMotor" sourceRef="split" targetRef="orderMotor" />
    <bpmn:sequenceFlow id="f-orderGuideBar-join" sourceRef="orderGuideBar" targetRef="join" />
    <bpmn:sequenceFlow id="f-orderChain-join" sourceRef="orderChain" targetRef="join" />
    <bpmn:sequenceFlow id="f-orderMotor-join" sourceRef="orderMotor" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-receiveParts" sourceRef="join" targetRef="receiveParts" />
    <bpmn:sequenceFlow id="f-receiveParts-inspectParts" sourceRef="receiveParts" targetRef="inspectParts" />
    <bpmn:sequenceFlow id="f-inspectParts-assemble" sourceRef="inspectParts" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-sendUpdates" sourceRef="assemble" targetRef="sendUpdates" />
    <bpmn:sequenceFlow id="f-sendUpdates-produceFirst" sourceRef="sendUpdates" targetRef="produceFirst" />
    <bpmn:sequenceFlow id="f-produceFirst-sendFirst" sourceRef="produceFirst" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f-sendFirst-likeDecision" sourceRef="sendFirst" targetRef="likeDecision" />
    <bpmn:sequenceFlow id="f-likeDecision-produceRest" sourceRef="likeDecision" targetRef="produceRest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-produceRest-endSuccess" sourceRef="produceRest" targetRef="endSuccess" />
    <bpmn:sequenceFlow id="f-likeDecision-endFail" sourceRef="likeDecision" targetRef="endFail" />
  </bpmn:process>
</bpmn:definitions>
