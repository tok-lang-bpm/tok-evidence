tok 1.0 "Chainsaw" executable
    pool company "Chainsaw production"
      lane maker "Maker"
        start start "Order received"
        task receiveSpecs "Receive order specifications"
        and split "Order parts in parallel"
        task orderGuideBar "Order guide bar"
        task orderChain "Order chain"
        task orderMotor "Order motor"
        and join "Parts ordered"
        task receiveParts "Receive parts"
        task inspectParts "Inspect parts"
        task assemble "Assemble chainsaw"
        task sendUpdates "Send production updates"
        task produceFirst "Produce first saw"
        task sendFirst "Send first saw"
        xor likeDecision "Customer likes first saw?"
        task produceRest "Produce remaining saws"
        end endSuccess "Order completed"
        end endFail "Order not completed"
      lane customer "Customer"
        # No internal activities
      flow start -> receiveSpecs
      flow receiveSpecs -> split
      flow split -> orderGuideBar
      flow split -> orderChain
      flow split -> orderMotor
      flow orderGuideBar -> join
      flow orderChain -> join
      flow orderMotor -> join
      flow join -> receiveParts
      flow receiveParts -> inspectParts
      flow inspectParts -> assemble
      flow assemble -> sendUpdates
      flow sendUpdates -> produceFirst
      flow produceFirst -> sendFirst
      flow sendFirst -> likeDecision
      flow likeDecision -> produceRest when="true"
      flow produceRest -> endSuccess
      flow likeDecision -> endFail default
