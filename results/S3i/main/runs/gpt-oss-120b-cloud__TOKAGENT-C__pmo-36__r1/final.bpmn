<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="luxury" name="Luxury Airplane" processRef="luxury-process" />
  </bpmn:collaboration>
  <bpmn:process id="luxury-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="luxury-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_specs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="production" name="Production">
        <bpmn:flowNodeRef>receive_specs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manuf_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manuf_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble_interior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver_plane</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="russian" name="Russian Team">
        <bpmn:flowNodeRef>manufacture_vodka_bar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="irish" name="Irish Team">
        <bpmn:flowNodeRef>manufacture_whiskey_bar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="testflight" name="Test Flight">
        <bpmn:flowNodeRef>test_flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_protocol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="decide_specs" name="Decide interior specifications" />
    <bpmn:task id="receive_specs" name="Receive specifications" />
    <bpmn:task id="produce_base" name="Produce base model" />
    <bpmn:parallelGateway id="manuf_start" name="Manufacturing start" />
    <bpmn:parallelGateway id="manuf_end" name="Manufacturing end" />
    <bpmn:task id="assemble_interior" name="Assemble interior" />
    <bpmn:task id="deliver_plane" name="Deliver plane to customer" />
    <bpmn:endEvent id="e" name="Process completed" />
    <bpmn:task id="manufacture_vodka_bar" name="Manufacture vodka bar" />
    <bpmn:task id="manufacture_whiskey_bar" name="Manufacture whiskey bar" />
    <bpmn:task id="test_flight" name="Conduct test flight" />
    <bpmn:task id="create_protocol" name="Create test protocol" />
    <bpmn:sequenceFlow id="f-s-decide_specs" sourceRef="s" targetRef="decide_specs" />
    <bpmn:sequenceFlow id="f-decide_specs-receive_specs" sourceRef="decide_specs" targetRef="receive_specs" />
    <bpmn:sequenceFlow id="f-receive_specs-produce_base" sourceRef="receive_specs" targetRef="produce_base" />
    <bpmn:sequenceFlow id="f-produce_base-manuf_start" sourceRef="produce_base" targetRef="manuf_start" />
    <bpmn:sequenceFlow id="f-manuf_start-manufacture_vodka_bar" sourceRef="manuf_start" targetRef="manufacture_vodka_bar" />
    <bpmn:sequenceFlow id="f-manuf_start-manufacture_whiskey_bar" sourceRef="manuf_start" targetRef="manufacture_whiskey_bar" />
    <bpmn:sequenceFlow id="f-manufacture_vodka_bar-manuf_end" sourceRef="manufacture_vodka_bar" targetRef="manuf_end" />
    <bpmn:sequenceFlow id="f-manufacture_whiskey_bar-manuf_end" sourceRef="manufacture_whiskey_bar" targetRef="manuf_end" />
    <bpmn:sequenceFlow id="f-manuf_end-assemble_interior" sourceRef="manuf_end" targetRef="assemble_interior" />
    <bpmn:sequenceFlow id="f-assemble_interior-test_flight" sourceRef="assemble_interior" targetRef="test_flight" />
    <bpmn:sequenceFlow id="f-test_flight-create_protocol" sourceRef="test_flight" targetRef="create_protocol" />
    <bpmn:sequenceFlow id="f-create_protocol-deliver_plane" sourceRef="create_protocol" targetRef="deliver_plane" />
    <bpmn:sequenceFlow id="f-deliver_plane-e" sourceRef="deliver_plane" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
