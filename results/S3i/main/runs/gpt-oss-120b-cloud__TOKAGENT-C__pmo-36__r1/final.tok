tok 1.0 "Luxury Airplane"

pool luxury "Luxury Airplane"
  lane customer "Customer"
    start s "Start"
    task decide_specs "Decide interior specifications"
  lane production "Production"
    task receive_specs "Receive specifications"
    task produce_base "Produce base model"
    and manuf_start "Manufacturing start"
    and manuf_end "Manufacturing end"
    task assemble_interior "Assemble interior"
    task deliver_plane "Deliver plane to customer"
    end e "Process completed"
  lane russian "Russian Team"
    task manufacture_vodka_bar "Manufacture vodka bar"
  lane irish "Irish Team"
    task manufacture_whiskey_bar "Manufacture whiskey bar"
  lane testflight "Test Flight"
    task test_flight "Conduct test flight"
    task create_protocol "Create test protocol"

flow s -> decide_specs -> receive_specs -> produce_base -> manuf_start
flow manuf_start -> manufacture_vodka_bar
flow manuf_start -> manufacture_whiskey_bar
flow manufacture_vodka_bar -> manuf_end
flow manufacture_whiskey_bar -> manuf_end
flow manuf_end -> assemble_interior -> test_flight -> create_protocol -> deliver_plane -> e
