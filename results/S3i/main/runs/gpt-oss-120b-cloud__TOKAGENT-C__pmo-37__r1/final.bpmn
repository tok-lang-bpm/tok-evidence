<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="manager" name="Project Manager">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rfast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rcost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Start contract process" />
    <bpmn:task id="q1" name="Query web shops" />
    <bpmn:task id="l1" name="Create list of parts per shop" />
    <bpmn:exclusiveGateway id="g1" name="Single shop has enough parts?" />
    <bpmn:task id="o1" name="Order parts from cheapest shop" />
    <bpmn:task id="o2" name="Order parts from multiple shops (cheapest)" />
    <bpmn:task id="r1" name="Receive parts batch" />
    <bpmn:task id="b1" name="Start building" />
    <bpmn:exclusiveGateway id="g2" name="Stock zero?" />
    <bpmn:task id="m1" name="Write mail to friends complaining" />
    <bpmn:exclusiveGateway id="g3" name="Stock below 3?" />
    <bpmn:task id="rfast" name="Reorder parts (fastest)" />
    <bpmn:exclusiveGateway id="g4" name="Stock below 5?" />
    <bpmn:task id="rcost" name="Reorder parts (cheapest)" />
    <bpmn:endEvent id="e1" name="Contract completed" />
    <bpmn:endEvent id="e2" name="Process ended after complaint" />
    <bpmn:sequenceFlow id="f-s1-q1" sourceRef="s1" targetRef="q1" />
    <bpmn:sequenceFlow id="f-q1-l1" sourceRef="q1" targetRef="l1" />
    <bpmn:sequenceFlow id="f-l1-g1" sourceRef="l1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-o1" name="yes" sourceRef="g1" targetRef="o1" />
    <bpmn:sequenceFlow id="f-g1-o2" name="no" sourceRef="g1" targetRef="o2" />
    <bpmn:sequenceFlow id="f-o1-r1" sourceRef="o1" targetRef="r1" />
    <bpmn:sequenceFlow id="f-o2-r1" sourceRef="o2" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-b1" sourceRef="r1" targetRef="b1" />
    <bpmn:sequenceFlow id="f-b1-g2" sourceRef="b1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-m1" name="yes" sourceRef="g2" targetRef="m1" />
    <bpmn:sequenceFlow id="f-m1-e2" sourceRef="m1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-g2-g3" name="no" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-rfast" name="yes" sourceRef="g3" targetRef="rfast" />
    <bpmn:sequenceFlow id="f-rfast-r1" sourceRef="rfast" targetRef="r1" />
    <bpmn:sequenceFlow id="f-g3-g4" name="no" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-rcost" name="yes" sourceRef="g4" targetRef="rcost" />
    <bpmn:sequenceFlow id="f-rcost-r1" sourceRef="rcost" targetRef="r1" />
    <bpmn:sequenceFlow id="f-g4-e1" name="no" sourceRef="g4" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
