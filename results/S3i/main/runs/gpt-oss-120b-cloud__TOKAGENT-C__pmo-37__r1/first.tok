tok 1.0 "Contract" [executable]

pool org "Organization"
  lane manager "Project Manager"
    start s1 "Start contract process"
    task q1 "Query web shops"
    task l1 "Create list of parts per shop"
    xor g1 "Single shop has enough parts?"
    task o1 "Order parts from cheapest shop"
    task o2 "Order parts from multiple shops (cheapest)"
    task r1 "Receive parts batch"
    task b1 "Start building"
    xor g2 "Stock zero?"
    task m1 "Write mail to friends complaining"
    xor g3 "Stock below 3?"
    task rfast "Reorder parts (fastest)"
    xor g4 "Stock below 5?"
    task rcost "Reorder parts (cheapest)"
    end e1 "Contract completed"
    end e2 "Process ended after complaint"

    flow s1 -> q1 -> l1 -> g1
    flow g1 "yes" -> o1
    flow g1 "no" -> o2
    flow o1 -> r1
    flow o2 -> r1
    flow r1 -> b1
    flow b1 -> g2
    flow g2 "yes" -> m1 -> e2
    flow g2 "no" -> g3
    flow g3 "yes" -> rfast -> r1
    flow g3 "no" -> g4
    flow g4 "yes" -> rcost -> r1
    flow g4 "no" -> e1