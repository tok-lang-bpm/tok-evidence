<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a Tree House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="building" name="Building a Tree House" processRef="building-process" />
  </bpmn:collaboration>
  <bpmn:process id="building-process" name="Building a Tree House" isExecutable="false">
    <bpmn:laneSet id="building-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_messages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_attendee_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>send_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online Stores">
        <bpmn:flowNodeRef>process_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build_house</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start building a tree house" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="send_requirements" name="Send requirements to architect" />
    <bpmn:task id="refine" name="Refine draft with additional requirements" />
    <bpmn:task id="create_materials" name="Create materials list" />
    <bpmn:task id="order_materials" name="Order materials from online stores" />
    <bpmn:parallelGateway id="and1" name="" />
    <bpmn:task id="send_messages" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="and2" name="" />
    <bpmn:task id="send_invitations" name="Send invitations for tree house party" />
    <bpmn:task id="create_attendee_list" name="Create attendee list for snacks" />
    <bpmn:endEvent id="end1" name="Process completed" />
    <bpmn:task id="send_draft" name="Send draft to builder" />
    <bpmn:task id="process_order" name="Process material order" />
    <bpmn:task id="build_house" name="Build the house" />
    <bpmn:sequenceFlow id="f-start1-collect" sourceRef="start1" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-send_requirements" sourceRef="collect" targetRef="send_requirements" />
    <bpmn:sequenceFlow id="f-send_requirements-send_draft" sourceRef="send_requirements" targetRef="send_draft" />
    <bpmn:sequenceFlow id="f-send_draft-refine" sourceRef="send_draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-create_materials" sourceRef="refine" targetRef="create_materials" />
    <bpmn:sequenceFlow id="f-create_materials-order_materials" sourceRef="create_materials" targetRef="order_materials" />
    <bpmn:sequenceFlow id="f-order_materials-and1" sourceRef="order_materials" targetRef="and1" />
    <bpmn:sequenceFlow id="f-and1-process_order" sourceRef="and1" targetRef="process_order" />
    <bpmn:sequenceFlow id="f-and1-send_messages" sourceRef="and1" targetRef="send_messages" />
    <bpmn:sequenceFlow id="f-send_messages-build_house" sourceRef="send_messages" targetRef="build_house" />
    <bpmn:sequenceFlow id="f-process_order-and2" sourceRef="process_order" targetRef="and2" />
    <bpmn:sequenceFlow id="f-build_house-and2" sourceRef="build_house" targetRef="and2" />
    <bpmn:sequenceFlow id="f-and2-send_invitations" sourceRef="and2" targetRef="send_invitations" />
    <bpmn:sequenceFlow id="f-send_invitations-create_attendee_list" sourceRef="send_invitations" targetRef="create_attendee_list" />
    <bpmn:sequenceFlow id="f-create_attendee_list-end1" sourceRef="create_attendee_list" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
