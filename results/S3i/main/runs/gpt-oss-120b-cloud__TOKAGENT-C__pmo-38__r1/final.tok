tok 1.0 "Building a Tree House"

pool building "Building a Tree House"
  lane builder "Builder"
    start start1 "Start building a tree house"
    task collect "Collect requirements"
    task send_requirements "Send requirements to architect"
    task refine "Refine draft with additional requirements"
    task create_materials "Create materials list"
    task order_materials "Order materials from online stores"
    and and1 ""
    task send_messages "Send messages to friends to build the house"
    and and2 ""
    task send_invitations "Send invitations for tree house party"
    task create_attendee_list "Create attendee list for snacks"
    end end1 "Process completed"
  lane architect "Architect"
    task send_draft "Send draft to builder"
  lane stores "Online Stores"
    task process_order "Process material order"
  lane friends "Friends"
    task build_house "Build the house"

flow start1 -> collect -> send_requirements -> send_draft -> refine -> create_materials -> order_materials -> and1
flow and1 -> process_order
flow and1 -> send_messages -> build_house
flow process_order -> and2
flow build_house -> and2
flow and2 -> send_invitations -> create_attendee_list -> end1
