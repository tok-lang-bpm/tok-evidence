<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="DIY Repair Process" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>need_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_items_and</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>borrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>items_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Tool">
        <bpmn:flowNodeRef>get_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_instructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start DIY repair" />
    <bpmn:task id="enter" name="Enter model and broken part" />
    <bpmn:task id="identify" name="Identify owned items" />
    <bpmn:exclusiveGateway id="need_items" name="Need additional items?" />
    <bpmn:parallelGateway id="get_items_and" name="Obtain missing items" />
    <bpmn:task id="contact" name="Contact friends" />
    <bpmn:task id="borrow" name="Borrow/buy from friend" />
    <bpmn:task id="purchase" name="Purchase missing items" />
    <bpmn:parallelGateway id="items_join" name="Items ready" />
    <bpmn:task id="fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="success" name="Repair successful?" />
    <bpmn:task id="send_review" name="Send review and/or video" />
    <bpmn:task id="send_expert" name="Send phone to expert" />
    <bpmn:endEvent id="end_success" name="Repair completed successfully" />
    <bpmn:endEvent id="end_failure" name="Repair sent to expert" />
    <bpmn:task id="get_list" name="Get list of materials, tools, and ordering choices" />
    <bpmn:task id="receive_instructions" name="Receive repair instructions" />
    <bpmn:sequenceFlow id="f-start1-enter" sourceRef="start1" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-get_list" sourceRef="enter" targetRef="get_list" />
    <bpmn:sequenceFlow id="f-get_list-identify" sourceRef="get_list" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-need_items" sourceRef="identify" targetRef="need_items" />
    <bpmn:sequenceFlow id="f-need_items-get_items_and" name="yes" sourceRef="need_items" targetRef="get_items_and" />
    <bpmn:sequenceFlow id="f-need_items-receive_instructions" name="no" sourceRef="need_items" targetRef="receive_instructions" />
    <bpmn:sequenceFlow id="f-get_items_and-contact" sourceRef="get_items_and" targetRef="contact" />
    <bpmn:sequenceFlow id="f-get_items_and-purchase" sourceRef="get_items_and" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-contact-borrow" sourceRef="contact" targetRef="borrow" />
    <bpmn:sequenceFlow id="f-borrow-items_join" sourceRef="borrow" targetRef="items_join" />
    <bpmn:sequenceFlow id="f-purchase-items_join" sourceRef="purchase" targetRef="items_join" />
    <bpmn:sequenceFlow id="f-items_join-receive_instructions" sourceRef="items_join" targetRef="receive_instructions" />
    <bpmn:sequenceFlow id="f-receive_instructions-fix" sourceRef="receive_instructions" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-success" sourceRef="fix" targetRef="success" />
    <bpmn:sequenceFlow id="f-success-send_review" name="yes" sourceRef="success" targetRef="send_review" />
    <bpmn:sequenceFlow id="f-send_review-end_success" sourceRef="send_review" targetRef="end_success" />
    <bpmn:sequenceFlow id="f-success-send_expert" name="no" sourceRef="success" targetRef="send_expert" />
    <bpmn:sequenceFlow id="f-send_expert-end_failure" sourceRef="send_expert" targetRef="end_failure" />
  </bpmn:process>
</bpmn:definitions>
