tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool org "DIY Repair Process"
  lane user "User"
    start start1 "Start DIY repair"
    task enter "Enter model and broken part"
    task identify "Identify owned items"
    xor need_items "Need additional items?"
    and get_items_and "Obtain missing items"
    task contact "Contact friends"
    task borrow "Borrow/buy from friend"
    task purchase "Purchase missing items"
    and items_join "Items ready"
    task fix "Fix the phone"
    xor success "Repair successful?"
    task send_review "Send review and/or video"
    task send_expert "Send phone to expert"
    end end_success "Repair completed successfully"
    end end_failure "Repair sent to expert"
  lane tool "Tool"
    task get_list "Get list of materials, tools, and ordering choices"
    task receive_instructions "Receive repair instructions"

flow start1 -> enter -> get_list -> identify -> need_items
flow need_items -> get_items_and "yes"
flow need_items -> receive_instructions "no"
flow get_items_and -> contact
flow get_items_and -> purchase
flow contact -> borrow
flow borrow -> items_join
flow purchase -> items_join
flow items_join -> receive_instructions
flow receive_instructions -> fix
flow fix -> success
flow success -> send_review "yes"
flow send_review -> end_success
flow success -> send_expert "no"
flow send_expert -> end_failure
