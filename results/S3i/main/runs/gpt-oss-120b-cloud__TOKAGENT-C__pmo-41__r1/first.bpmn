<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="operator" name="Operator">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_serial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer_questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press_buttons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start inspection" />
    <bpmn:task id="enter_type" name="Enter the type of the machine" />
    <bpmn:task id="enter_serial" name="Enter the serial number" />
    <bpmn:parallelGateway id="parallel_start" />
    <bpmn:task id="answer_questions" name="Answer inspection questions" />
    <bpmn:task id="press_buttons" name="Press buttons and collect values" />
    <bpmn:parallelGateway id="parallel_end" />
    <bpmn:exclusiveGateway id="additional" name="Additional questions required?" />
    <bpmn:task id="ask_additional" name="Answer additional questions" />
    <bpmn:endEvent id="end1" name="Inspection completed" />
    <bpmn:sequenceFlow id="f-start1-enter_type" sourceRef="start1" targetRef="enter_type" />
    <bpmn:sequenceFlow id="f-enter_type-enter_serial" sourceRef="enter_type" targetRef="enter_serial" />
    <bpmn:sequenceFlow id="f-enter_serial-parallel_start" sourceRef="enter_serial" targetRef="parallel_start" />
    <bpmn:sequenceFlow id="f-parallel_start-answer_questions" sourceRef="parallel_start" targetRef="answer_questions" />
    <bpmn:sequenceFlow id="f-parallel_start-press_buttons" sourceRef="parallel_start" targetRef="press_buttons" />
    <bpmn:sequenceFlow id="f-answer_questions-parallel_end" sourceRef="answer_questions" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-press_buttons-parallel_end" sourceRef="press_buttons" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-parallel_end-additional" sourceRef="parallel_end" targetRef="additional" />
    <bpmn:sequenceFlow id="f-additional-ask_additional" name="yes" sourceRef="additional" targetRef="ask_additional" />
    <bpmn:sequenceFlow id="f-additional-end1" name="no" sourceRef="additional" targetRef="end1" />
    <bpmn:sequenceFlow id="f-ask_additional-end1" sourceRef="ask_additional" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
