tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool org "Organization"
  lane operator "Operator"
    start start1 "Start inspection"
    task enter_type "Enter the type of the machine"
    task enter_serial "Enter the serial number"
    and parallel_start
    task answer_questions "Answer inspection questions"
    task press_buttons "Press buttons and collect values"
    and parallel_end
    xor additional "Additional questions required?"
    task ask_additional "Answer additional questions"
    end end1 "Inspection completed"

    flow start1 -> enter_type -> enter_serial -> parallel_start
    flow parallel_start -> answer_questions
    flow parallel_start -> press_buttons
    flow answer_questions -> parallel_end
    flow press_buttons -> parallel_end
    flow parallel_end -> additional
    flow additional -> ask_additional "yes"
    flow additional -> end1 "no"
    flow ask_additional -> end1
