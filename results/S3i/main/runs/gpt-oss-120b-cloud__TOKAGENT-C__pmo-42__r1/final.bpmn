<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="fridge_service" name="Fridge Service" processRef="fridge_service-process" />
  </bpmn:collaboration>
  <bpmn:process id="fridge_service-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="fridge_service-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe_and_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_incomplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Service Center">
        <bpmn:flowNodeRef>select_facility</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Service Facility">
        <bpmn:flowNodeRef>make_appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="describe_and_send" name="Describe symptoms and send to service center" />
    <bpmn:task id="confirm_ok" name="Confirm fridge is OK" />
    <bpmn:exclusiveGateway id="rate_decision" name="Rate service?" />
    <bpmn:task id="rate" name="Rate service facility" />
    <bpmn:endEvent id="e_success" name="Service completed" />
    <bpmn:endEvent id="e_incomplete" name="Service incomplete" />
    <bpmn:task id="select_facility" name="Select local service facility" />
    <bpmn:task id="make_appointment" name="Make appointment" />
    <bpmn:task id="arrive" name="Arrive at customer location" />
    <bpmn:exclusiveGateway id="parts_needed" name="Additional parts needed?" />
    <bpmn:task id="repair" name="Repair fridge" />
    <bpmn:sequenceFlow id="f-s-describe_and_send" sourceRef="s" targetRef="describe_and_send" />
    <bpmn:sequenceFlow id="f-describe_and_send-select_facility" sourceRef="describe_and_send" targetRef="select_facility" />
    <bpmn:sequenceFlow id="f-select_facility-make_appointment" sourceRef="select_facility" targetRef="make_appointment" />
    <bpmn:sequenceFlow id="f-make_appointment-arrive" sourceRef="make_appointment" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-parts_needed" sourceRef="arrive" targetRef="parts_needed" />
    <bpmn:sequenceFlow id="f-parts_needed-repair" name="no" sourceRef="parts_needed" targetRef="repair" />
    <bpmn:sequenceFlow id="f-parts_needed-e_incomplete" name="yes" sourceRef="parts_needed" targetRef="e_incomplete" />
    <bpmn:sequenceFlow id="f-repair-confirm_ok" sourceRef="repair" targetRef="confirm_ok" />
    <bpmn:sequenceFlow id="f-confirm_ok-rate_decision" sourceRef="confirm_ok" targetRef="rate_decision" />
    <bpmn:sequenceFlow id="f-rate_decision-rate" name="yes" sourceRef="rate_decision" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate_decision-e_success" name="no" sourceRef="rate_decision" targetRef="e_success" />
    <bpmn:sequenceFlow id="f-rate-e_success" sourceRef="rate" targetRef="e_success" />
  </bpmn:process>
</bpmn:definitions>
