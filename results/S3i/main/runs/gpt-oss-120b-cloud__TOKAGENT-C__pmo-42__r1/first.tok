tok 1.0 "Service for Your Fridge"

pool fridge_service "Fridge Service"
  lane customer "Customer"
    start s "Start"
    task describe_and_send "Describe symptoms and send to service center"
    task confirm_ok "Confirm fridge is OK"
    xor rate_decision "Rate service?"
    task rate "Rate service facility"
    end e_success "Service completed"
    end e_incomplete "Service incomplete"
  lane center "Service Center"
    task select_facility "Select local service facility"
  lane facility "Service Facility"
    task make_appointment "Make appointment"
    task arrive "Arrive at customer location"
    xor parts_needed "Additional parts needed?"
    task repair "Repair fridge"

flow s -> describe_and_send -> select_facility -> make_appointment -> arrive -> parts_needed
flow parts_needed -> repair "no"
flow parts_needed -> e_incomplete "yes"
flow repair -> confirm_ok -> rate_decision
flow rate_decision -> rate "yes"
flow rate_decision -> e_success "no"
flow rate -> e_success