<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car Service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Car Service Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Car Service" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="system" name="Police App">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>su</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ef</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>ep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>en</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="user" name="Customer">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start after successful service" />
    <bpmn:task id="cr" name="Check car registration" />
    <bpmn:task id="nu" name="Notify user" />
    <bpmn:exclusiveGateway id="gs" name="User goes to service?" />
    <bpmn:task id="su" name="Send status updates via email" />
    <bpmn:task id="fine" name="Fine after 30 days" />
    <bpmn:endEvent id="ef" name="Process ended with fine" />
    <bpmn:task id="ep" name="Enter car problems" />
    <bpmn:parallelGateway id="par_split" name="Parallel activities" />
    <bpmn:task id="rs" name="Enter repair successful and Pickerl" />
    <bpmn:task id="en" name="Enter next service time" />
    <bpmn:parallelGateway id="par_join" name="Parallel join" />
    <bpmn:task id="pay" name="Pay through app" />
    <bpmn:endEvent id="es" name="Process completed" />
    <bpmn:sequenceFlow id="f-s-cr" sourceRef="s" targetRef="cr" />
    <bpmn:sequenceFlow id="f-cr-nu" sourceRef="cr" targetRef="nu" />
    <bpmn:sequenceFlow id="f-nu-gs" sourceRef="nu" targetRef="gs" />
    <bpmn:sequenceFlow id="f-gs-ep" name="yes" sourceRef="gs" targetRef="ep" />
    <bpmn:sequenceFlow id="f-gs-fine" name="no" sourceRef="gs" targetRef="fine" />
    <bpmn:sequenceFlow id="f-ep-par_split" sourceRef="ep" targetRef="par_split" />
    <bpmn:sequenceFlow id="f-par_split-su" sourceRef="par_split" targetRef="su" />
    <bpmn:sequenceFlow id="f-par_split-rs" sourceRef="par_split" targetRef="rs" />
    <bpmn:sequenceFlow id="f-rs-en" sourceRef="rs" targetRef="en" />
    <bpmn:sequenceFlow id="f-en-par_join" sourceRef="en" targetRef="par_join" />
    <bpmn:sequenceFlow id="f-su-par_join" sourceRef="su" targetRef="par_join" />
    <bpmn:sequenceFlow id="f-par_join-pay" sourceRef="par_join" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-es" sourceRef="pay" targetRef="es" />
    <bpmn:sequenceFlow id="f-fine-ef" sourceRef="fine" targetRef="ef" />
  </bpmn:process>
</bpmn:definitions>
