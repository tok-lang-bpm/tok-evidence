tok 1.0 "Car Service"

pool org "Car Service Organisation"
  lane system "Police App"
    start s "Start after successful service"
    task cr "Check car registration"
    task nu "Notify user"
    xor gs "User goes to service?"
    task su "Send status updates via email"
    task fine "Fine after 30 days"
    end ef "Process ended with fine"
  lane mechanic "Mechanic"
    task ep "Enter car problems"
    and par_split "Parallel activities"
    task rs "Enter repair successful and Pickerl"
    task en "Enter next service time"
    and par_join "Parallel join"
  lane user "Customer"
    task pay "Pay through app"
    end es "Process completed"

flow s -> cr -> nu -> gs
flow gs -> ep "yes"
flow gs -> fine "no"
flow ep -> par_split
flow par_split -> su
flow par_split -> rs
flow rs -> en
flow en -> par_join
flow su -> par_join
flow par_join -> pay
flow pay -> es
flow fine -> ef
