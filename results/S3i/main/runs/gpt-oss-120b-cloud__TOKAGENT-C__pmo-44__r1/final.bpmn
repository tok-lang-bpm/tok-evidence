<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Robotic Burger Seller" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Robotic Burger Seller" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Robotic Burger Seller" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>friesPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedgesPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order received" />
    <bpmn:task id="receive" name="Receive order" />
    <bpmn:exclusiveGateway id="menu" name="Menu or just burger?" />
    <bpmn:parallelGateway id="split" name="Parallel split" />
    <bpmn:task id="drink" name="Prepare drink" />
    <bpmn:exclusiveGateway id="fries" name="Fries or wedges?" />
    <bpmn:task id="friesPrep" name="Prepare fries" />
    <bpmn:task id="wedgesPrep" name="Prepare wedges" />
    <bpmn:parallelGateway id="join" name="Parallel join" />
    <bpmn:task id="burger" name="Prepare burger" />
    <bpmn:task id="status" name="Give enthusiastic status updates" />
    <bpmn:task id="deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="end" name="Order delivered" />
    <bpmn:sequenceFlow id="f-start-receive" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-menu" sourceRef="receive" targetRef="menu" />
    <bpmn:sequenceFlow id="f-menu-split" name="menu" sourceRef="menu" targetRef="split" />
    <bpmn:sequenceFlow id="f-menu-burger" name="just burger" sourceRef="menu" targetRef="burger" />
    <bpmn:sequenceFlow id="f-split-drink" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-drink-join" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-fries" sourceRef="split" targetRef="fries" />
    <bpmn:sequenceFlow id="f-fries-friesPrep" name="fries" sourceRef="fries" targetRef="friesPrep" />
    <bpmn:sequenceFlow id="f-friesPrep-join" sourceRef="friesPrep" targetRef="join" />
    <bpmn:sequenceFlow id="f-fries-wedgesPrep" name="wedges" sourceRef="fries" targetRef="wedgesPrep" />
    <bpmn:sequenceFlow id="f-wedgesPrep-join" sourceRef="wedgesPrep" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-burger" sourceRef="join" targetRef="burger" />
    <bpmn:sequenceFlow id="f-burger-status" sourceRef="burger" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-deliver" sourceRef="status" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-end" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
