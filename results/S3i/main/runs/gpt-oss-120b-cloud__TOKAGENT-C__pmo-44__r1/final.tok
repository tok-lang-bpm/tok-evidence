tok 1.0 "Robotic Burger Seller"

pool org "Robotic Burger Seller"
  lane robot "Robot"
    start start "Order received"
    task receive "Receive order"
    xor menu "Menu or just burger?"
    and split "Parallel split"
    task drink "Prepare drink"
    xor fries "Fries or wedges?"
    task friesPrep "Prepare fries"
    task wedgesPrep "Prepare wedges"
    and join "Parallel join"
    task burger "Prepare burger"
    task status "Give enthusiastic status updates"
    task deliver "Deliver order via conveyor belt"
    end end "Order delivered"

    flow start -> receive -> menu
    flow menu -> split "menu"
    flow menu -> burger "just burger"
    flow split -> drink -> join
    flow split -> fries
    flow fries -> friesPrep "fries"
    flow friesPrep -> join
    flow fries -> wedgesPrep "wedges"
    flow wedgesPrep -> join
    flow join -> burger -> status -> deliver -> end
