tok 1.0 "Ordering in an Online Shop"

pool shop "Online Shop"
  lane customer "Customer"
    start start "Start"
    task login "log into the E-Shop system"
    task select "select product"
    task add "add product to shopping cart"
    task save "save product"
    xor all_selected "All products selected?"
    task pay_data "enter payment data"
    and payment_parallel "Payment parallel"
    task ship_addr "enter shipping address"
    xor address_equal "Shipping address equals billing address?"
    task bill_addr "enter billing address"
    end login_failed "Login failed"
    end done "Process completed"
  lane system "E-Shop System"
    task check "check credentials"
    xor login_gate "Login successful?"
    task finish "finish order"
    and overall_parallel "Overall parallel"
    task shipment "prepare shipment"
    and join_all "Join all"
    task finalize "finalize order"
  lane bank "Bank"
    task confirm "confirm payment"

  flow start -> login
  flow login -> check
  flow check -> login_gate
  flow login_gate -> select "yes"
  flow login_gate -> login_failed "no"
  flow select -> add
  flow add -> save
  flow save -> all_selected
  flow all_selected -> select "no"
  flow all_selected -> finish "yes"
  flow finish -> overall_parallel
  flow overall_parallel -> shipment
  flow overall_parallel -> pay_data
  flow pay_data -> payment_parallel
  flow payment_parallel -> confirm
  flow payment_parallel -> ship_addr
  flow ship_addr -> address_equal
  flow address_equal -> confirm "yes"
  flow address_equal -> bill_addr "no"
  flow bill_addr -> confirm
  flow confirm -> join_all
  flow shipment -> join_all
  flow join_all -> finalize
  flow finalize -> done
