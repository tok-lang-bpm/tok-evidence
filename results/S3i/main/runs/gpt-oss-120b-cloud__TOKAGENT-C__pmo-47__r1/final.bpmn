<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New Application for Registering for an USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Sports Institute" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_one</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>log_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ticket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>slots_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>account_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no_slots</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="select_course" name="Select a course" />
    <bpmn:task id="select_one" name="Select one" />
    <bpmn:task id="log_in" name="Log into account" />
    <bpmn:parallelGateway id="parallel_start" />
    <bpmn:task id="tweet" name="Connect Twitter and tweet" />
    <bpmn:task id="complete_registration" name="Complete registration and provide payment" />
    <bpmn:parallelGateway id="parallel_end" />
    <bpmn:task id="receive_ticket" name="Receive course ticket" />
    <bpmn:endEvent id="end_ticket" name="Course ticket received" />
    <bpmn:exclusiveGateway id="slots_free" name="Slots free?" />
    <bpmn:task id="show_courses" name="Show courses and dates" />
    <bpmn:exclusiveGateway id="account_exists" name="Account exists?" />
    <bpmn:exclusiveGateway id="eligible_uni" name="Eligible university?" />
    <bpmn:task id="register_account" name="Register account" />
    <bpmn:task id="request_activation" name="Request activation" />
    <bpmn:task id="wait_activation" name="Wait for activation response" />
    <bpmn:endEvent id="end_no_slots" name="No slots available" />
    <bpmn:sequenceFlow id="f-start-select_course" sourceRef="start" targetRef="select_course" />
    <bpmn:sequenceFlow id="f-select_course-slots_free" sourceRef="select_course" targetRef="slots_free" />
    <bpmn:sequenceFlow id="f-slots_free-show_courses" name="yes" sourceRef="slots_free" targetRef="show_courses" />
    <bpmn:sequenceFlow id="f-slots_free-end_no_slots" name="no" sourceRef="slots_free" targetRef="end_no_slots" />
    <bpmn:sequenceFlow id="f-show_courses-select_one" sourceRef="show_courses" targetRef="select_one" />
    <bpmn:sequenceFlow id="f-select_one-account_exists" sourceRef="select_one" targetRef="account_exists" />
    <bpmn:sequenceFlow id="f-account_exists-log_in" name="yes" sourceRef="account_exists" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-account_exists-eligible_uni" name="no" sourceRef="account_exists" targetRef="eligible_uni" />
    <bpmn:sequenceFlow id="f-eligible_uni-register_account" name="yes" sourceRef="eligible_uni" targetRef="register_account" />
    <bpmn:sequenceFlow id="f-eligible_uni-request_activation" name="no" sourceRef="eligible_uni" targetRef="request_activation" />
    <bpmn:sequenceFlow id="f-register_account-log_in" sourceRef="register_account" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-request_activation-wait_activation" sourceRef="request_activation" targetRef="wait_activation" />
    <bpmn:sequenceFlow id="f-wait_activation-log_in" sourceRef="wait_activation" targetRef="log_in" />
    <bpmn:sequenceFlow id="f-log_in-parallel_start" sourceRef="log_in" targetRef="parallel_start" />
    <bpmn:sequenceFlow id="f-parallel_start-tweet" sourceRef="parallel_start" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-parallel_start-complete_registration" sourceRef="parallel_start" targetRef="complete_registration" />
    <bpmn:sequenceFlow id="f-tweet-parallel_end" sourceRef="tweet" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-complete_registration-parallel_end" sourceRef="complete_registration" targetRef="parallel_end" />
    <bpmn:sequenceFlow id="f-parallel_end-receive_ticket" sourceRef="parallel_end" targetRef="receive_ticket" />
    <bpmn:sequenceFlow id="f-receive_ticket-end_ticket" sourceRef="receive_ticket" targetRef="end_ticket" />
  </bpmn:process>
</bpmn:definitions>
