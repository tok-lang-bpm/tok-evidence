<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="App For Participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="participant" name="Participant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run_measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>time_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>good</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work_day</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go_home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>night_run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="select_block" name="Select a starting block" />
    <bpmn:task id="run_measure" name="Run for 5km and measure the time" />
    <bpmn:exclusiveGateway id="time_check" name="Time less than 25 minutes?" />
    <bpmn:task id="good" name="You are good" />
    <bpmn:task id="train_check" name="Train and check until goal achieved" />
    <bpmn:task id="get_number" name="Get your starting number" />
    <bpmn:exclusiveGateway id="work_day" name="More than one hour left between starting time and end of workday?" />
    <bpmn:task id="go_home" name="Go there from home" />
    <bpmn:task id="leave_work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="merge" name="Merge paths" />
    <bpmn:parallelGateway id="split" name="Parallel split" />
    <bpmn:task id="night_run" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="join" name="Parallel join" />
    <bpmn:task id="final_time" name="Receive your final running time" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-select_block" sourceRef="start" targetRef="select_block" />
    <bpmn:sequenceFlow id="f-select_block-run_measure" sourceRef="select_block" targetRef="run_measure" />
    <bpmn:sequenceFlow id="f-run_measure-time_check" sourceRef="run_measure" targetRef="time_check" />
    <bpmn:sequenceFlow id="f-time_check-good" name="yes" sourceRef="time_check" targetRef="good" />
    <bpmn:sequenceFlow id="f-time_check-train_check" name="no" sourceRef="time_check" targetRef="train_check" />
    <bpmn:sequenceFlow id="f-train_check-time_check" sourceRef="train_check" targetRef="time_check" />
    <bpmn:sequenceFlow id="f-good-get_number" sourceRef="good" targetRef="get_number" />
    <bpmn:sequenceFlow id="f-get_number-work_day" sourceRef="get_number" targetRef="work_day" />
    <bpmn:sequenceFlow id="f-work_day-go_home" name="yes" sourceRef="work_day" targetRef="go_home" />
    <bpmn:sequenceFlow id="f-work_day-leave_work" name="no" sourceRef="work_day" targetRef="leave_work" />
    <bpmn:sequenceFlow id="f-go_home-merge" sourceRef="go_home" targetRef="merge" />
    <bpmn:sequenceFlow id="f-leave_work-merge" sourceRef="leave_work" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-split" sourceRef="merge" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-night_run" sourceRef="split" targetRef="night_run" />
    <bpmn:sequenceFlow id="f-split-drink" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-night_run-join" sourceRef="night_run" targetRef="join" />
    <bpmn:sequenceFlow id="f-drink-join" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-final_time" sourceRef="join" targetRef="final_time" />
    <bpmn:sequenceFlow id="f-final_time-done" sourceRef="final_time" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
