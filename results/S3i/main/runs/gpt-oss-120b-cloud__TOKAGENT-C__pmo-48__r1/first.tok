tok 1.0 "App For Participating at the Vienna Night Run"

pool org "Organisation"
  lane participant "Participant"
    start start "Start"
    task select_block "Select a starting block"
    task run_measure "Run for 5km and measure the time"
    xor time_check "Time less than 25 minutes?"
    task good "You are good"
    task train_check "Train and check until goal achieved"
    task get_number "Get your starting number"
    xor work_day "More than one hour left between starting time and end of workday?"
    task go_home "Go there from home"
    task leave_work "Leave directly from work"
    and run_drink_split
      task night_run "Run at the Night Run"
      task drink "Drink"
    and run_drink_join
    task final_time "Receive your final running time"
    end done "Process completed"

flow start -> select_block -> run_measure -> time_check
flow time_check -> good "yes"
flow time_check -> train_check "no"
flow train_check -> time_check
flow good -> get_number
flow get_number -> work_day
flow work_day -> go_home "yes"
flow work_day -> leave_work "no"
flow go_home -> run_drink_split
flow leave_work -> run_drink_split
flow night_run -> run_drink_join
flow drink -> run_drink_join
flow run_drink_join -> final_time -> done