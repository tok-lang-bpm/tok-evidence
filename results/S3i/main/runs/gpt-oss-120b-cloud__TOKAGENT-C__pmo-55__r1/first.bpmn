<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Peripheral Vein Access Procedure" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hospital" name="Hospital" processRef="hospital-process" />
  </bpmn:collaboration>
  <bpmn:process id="hospital-process" name="Peripheral Vein Access Procedure" isExecutable="false">
    <bpmn:laneSet id="hospital-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_prep_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_identify_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_wire_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_wire_check_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t28</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Start" />
    <bpmn:parallelGateway id="and_start" />
    <bpmn:task id="t1" name="Prepare the implements" />
    <bpmn:task id="t2" name="Wash the hands" />
    <bpmn:task id="t3" name="Get in sterile clothes" />
    <bpmn:parallelGateway id="and_prep_done" />
    <bpmn:task id="t4" name="Clean the puncture area" />
    <bpmn:task id="t5" name="Drape the puncture zone" />
    <bpmn:task id="t6" name="Configure the ultrasound" />
    <bpmn:task id="t7" name="Put gel in the probe" />
    <bpmn:task id="t8" name="Cover the probe" />
    <bpmn:task id="t9" name="Put the sterile gel" />
    <bpmn:task id="t10" name="Position the probe" />
    <bpmn:task id="t11" name="Position the patient" />
    <bpmn:exclusiveGateway id="xor_identify" name="Vein identification method?" />
    <bpmn:task id="t12" name="Identify vein anatomic" />
    <bpmn:task id="t13" name="Identify vein doppler" />
    <bpmn:task id="t14" name="Identify vein compression" />
    <bpmn:exclusiveGateway id="xor_identify_end" />
    <bpmn:task id="t15" name="Anesthetize the patient" />
    <bpmn:task id="t16" name="Puncture" />
    <bpmn:task id="t17" name="Check blood return" />
    <bpmn:exclusiveGateway id="xor_blood_return" name="Blood return correct?" />
    <bpmn:task id="t18" name="Drop the probe" />
    <bpmn:task id="t19" name="Remove the syringe" />
    <bpmn:task id="t20" name="Install the guidewire" />
    <bpmn:task id="t21" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="xor_wire_check" name="Wire axis check" />
    <bpmn:task id="t22" name="Check wire long axis" />
    <bpmn:task id="t23" name="Check wire short axis" />
    <bpmn:exclusiveGateway id="xor_wire_check_end" />
    <bpmn:exclusiveGateway id="xor_wire_position" name="Wire in good position?" />
    <bpmn:task id="t25" name="Widen the pathway" />
    <bpmn:task id="t26" name="Advance the catheter" />
    <bpmn:task id="t27" name="Remove the guidewire" />
    <bpmn:task id="t28" name="Verify the flow" />
    <bpmn:task id="t29" name="Verify the reflow" />
    <bpmn:task id="t30" name="Check catheter position" />
    <bpmn:endEvent id="e0" name="End" />
    <bpmn:sequenceFlow id="f-s0-and_start" sourceRef="s0" targetRef="and_start" />
    <bpmn:sequenceFlow id="f-and_start-t1" sourceRef="and_start" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-and_prep_done" sourceRef="t3" targetRef="and_prep_done" />
    <bpmn:sequenceFlow id="f-and_prep_done-t4" sourceRef="and_prep_done" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-t11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-xor_identify" sourceRef="t11" targetRef="xor_identify" />
    <bpmn:sequenceFlow id="f-xor_identify-t12" name="anatomic" sourceRef="xor_identify" targetRef="t12" />
    <bpmn:sequenceFlow id="f-xor_identify-t13" name="doppler" sourceRef="xor_identify" targetRef="t13" />
    <bpmn:sequenceFlow id="f-xor_identify-t14" name="compression" sourceRef="xor_identify" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t12-xor_identify_end" sourceRef="t12" targetRef="xor_identify_end" />
    <bpmn:sequenceFlow id="f-t13-xor_identify_end" sourceRef="t13" targetRef="xor_identify_end" />
    <bpmn:sequenceFlow id="f-t14-xor_identify_end" sourceRef="t14" targetRef="xor_identify_end" />
    <bpmn:sequenceFlow id="f-xor_identify_end-t15" sourceRef="xor_identify_end" targetRef="t15" />
    <bpmn:sequenceFlow id="f-t15-t16" sourceRef="t15" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t16-t17" sourceRef="t16" targetRef="t17" />
    <bpmn:sequenceFlow id="f-t17-xor_blood_return" sourceRef="t17" targetRef="xor_blood_return" />
    <bpmn:sequenceFlow id="f-xor_blood_return-t18" name="yes" sourceRef="xor_blood_return" targetRef="t18" />
    <bpmn:sequenceFlow id="f-xor_blood_return-t16" name="no" sourceRef="xor_blood_return" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t18-t19" sourceRef="t18" targetRef="t19" />
    <bpmn:sequenceFlow id="f-t19-t20" sourceRef="t19" targetRef="t20" />
    <bpmn:sequenceFlow id="f-t20-t21" sourceRef="t20" targetRef="t21" />
    <bpmn:sequenceFlow id="f-t21-xor_wire_check" sourceRef="t21" targetRef="xor_wire_check" />
    <bpmn:sequenceFlow id="f-xor_wire_check-t22" name="long" sourceRef="xor_wire_check" targetRef="t22" />
    <bpmn:sequenceFlow id="f-xor_wire_check-t23" name="short" sourceRef="xor_wire_check" targetRef="t23" />
    <bpmn:sequenceFlow id="f-t22-xor_wire_check_end" sourceRef="t22" targetRef="xor_wire_check_end" />
    <bpmn:sequenceFlow id="f-t23-xor_wire_check_end" sourceRef="t23" targetRef="xor_wire_check_end" />
    <bpmn:sequenceFlow id="f-xor_wire_check_end-xor_wire_position" sourceRef="xor_wire_check_end" targetRef="xor_wire_position" />
    <bpmn:sequenceFlow id="f-xor_wire_position-t25" name="yes" sourceRef="xor_wire_position" targetRef="t25" />
    <bpmn:sequenceFlow id="f-xor_wire_position-t16" name="no" sourceRef="xor_wire_position" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t25-t26" sourceRef="t25" targetRef="t26" />
    <bpmn:sequenceFlow id="f-t26-t27" sourceRef="t26" targetRef="t27" />
    <bpmn:sequenceFlow id="f-t27-t28" sourceRef="t27" targetRef="t28" />
    <bpmn:sequenceFlow id="f-t28-t29" sourceRef="t28" targetRef="t29" />
    <bpmn:sequenceFlow id="f-t29-t30" sourceRef="t29" targetRef="t30" />
    <bpmn:sequenceFlow id="f-t30-e0" sourceRef="t30" targetRef="e0" />
  </bpmn:process>
</bpmn:definitions>
