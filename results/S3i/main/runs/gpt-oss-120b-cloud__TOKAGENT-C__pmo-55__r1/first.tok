tok 1.0 "Peripheral Vein Access Procedure"

pool hospital "Hospital"
  lane doctor "Doctor"
    start s0 "Start"
    and and_start
    task t1 "Prepare the implements"
    task t2 "Wash the hands"
    task t3 "Get in sterile clothes"
    and and_prep_done
    task t4 "Clean the puncture area"
    task t5 "Drape the puncture zone"
    task t6 "Configure the ultrasound"
    task t7 "Put gel in the probe"
    task t8 "Cover the probe"
    task t9 "Put the sterile gel"
    task t10 "Position the probe"
    task t11 "Position the patient"
    xor xor_identify "Vein identification method?"
    task t12 "Identify vein anatomic"
    task t13 "Identify vein doppler"
    task t14 "Identify vein compression"
    xor xor_identify_end
    task t15 "Anesthetize the patient"
    task t16 "Puncture"
    task t17 "Check blood return"
    xor xor_blood_return "Blood return correct?"
    task t18 "Drop the probe"
    task t19 "Remove the syringe"
    task t20 "Install the guidewire"
    task t21 "Remove the trocar"
    xor xor_wire_check "Wire axis check"
    task t22 "Check wire long axis"
    task t23 "Check wire short axis"
    xor xor_wire_check_end
    xor xor_wire_position "Wire in good position?"
    task t25 "Widen the pathway"
    task t26 "Advance the catheter"
    task t27 "Remove the guidewire"
    task t28 "Verify the flow"
    task t29 "Verify the reflow"
    task t30 "Check catheter position"
    end e0 "End"

    flow s0 -> and_start
    flow and_start -> t1 -> t2 -> t3 -> and_prep_done
    flow and_prep_done -> t4 -> t5 -> t6 -> t7 -> t8 -> t9 -> t10 -> t11 -> xor_identify
    flow xor_identify -> t12 "anatomic"
    flow xor_identify -> t13 "doppler"
    flow xor_identify -> t14 "compression"
    flow t12 -> xor_identify_end
    flow t13 -> xor_identify_end
    flow t14 -> xor_identify_end
    flow xor_identify_end -> t15 -> t16 -> t17 -> xor_blood_return
    flow xor_blood_return -> t18 "yes"
    flow xor_blood_return -> t16 "no"
    flow t18 -> t19 -> t20 -> t21 -> xor_wire_check
    flow xor_wire_check -> t22 "long"
    flow xor_wire_check -> t23 "short"
    flow t22 -> xor_wire_check_end
    flow t23 -> xor_wire_check_end
    flow xor_wire_check_end -> xor_wire_position
    flow xor_wire_position -> t25 "yes"
    flow xor_wire_position -> t16 "no"
    flow t25 -> t26 -> t27 -> t28 -> t29 -> t30 -> e0
