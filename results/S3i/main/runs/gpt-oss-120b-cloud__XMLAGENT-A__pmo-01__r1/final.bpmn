<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process" />
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>Start_Inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Terminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lane_sales_staff" name="Sales Staff / Customer Support">
        <bpmn:flowNodeRef>Collect_Info</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lane_sales_rep" name="Sales Representative">
        <bpmn:flowNodeRef>Guide_Selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Provide_Quote</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>Record_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Confirmation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="Start_Inquiry" name="Customer inquires about product or service" />
    <bpmn:task id="Collect_Info" name="Collect relevant information and address concerns" />
    <bpmn:exclusiveGateway id="gw_interest" name="Customer interested?" />
    <bpmn:task id="Guide_Selection" name="Guide customer through selecting appropriate product or service" />
    <bpmn:task id="Provide_Quote" name="Provide quote to customer" />
    <bpmn:exclusiveGateway id="gw_approval" name="Customer approves quote?" />
    <bpmn:task id="Record_Order" name="Record order in system" />
    <bpmn:task id="Send_Confirmation" name="Send order confirmation to customer" />
    <bpmn:endEvent id="End_Completed" name="Order placed and confirmed" />
    <bpmn:endEvent id="End_Terminated" name="Process terminated" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="Start_Inquiry" targetRef="Collect_Info" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Collect_Info" targetRef="gw_interest" />
    <bpmn:sequenceFlow id="flow3_yes" name="yes" sourceRef="gw_interest" targetRef="Guide_Selection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        interested == true
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow3_no" name="no" sourceRef="gw_interest" targetRef="End_Terminated" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Guide_Selection" targetRef="Provide_Quote" />
    <bpmn:sequenceFlow id="flow5_yes" name="yes" sourceRef="gw_approval" targetRef="Record_Order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        approved == true
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow5_no" name="no" sourceRef="gw_approval" targetRef="End_Terminated" />
    <bpmn:sequenceFlow id="flow6" sourceRef="Record_Order" targetRef="Send_Confirmation" />
    <bpmn:sequenceFlow id="flow7" sourceRef="Send_Confirmation" targetRef="End_Completed" />
  </bpmn:process>
</bpmn:definitions>
