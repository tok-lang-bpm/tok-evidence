<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Org" name="Organisation" processRef="Process_Org" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Org" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Org">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CandidateChosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnboardingStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnboardingEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Integrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Process start" />
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new hire" />
    <bpmn:task id="Task_CreateJob" name="Create job description and post on job boards" />
    <bpmn:task id="Task_ScreenResumes" name="Collect and screen resumes" />
    <bpmn:task id="Task_PhoneInterviews" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="Gateway_InterviewMode" name="Interview mode?" />
    <bpmn:task id="Task_InPersonInterview" name="In-person interview" />
    <bpmn:task id="Task_VirtualInterview" name="Virtual interview" />
    <bpmn:exclusiveGateway id="Gateway_InterviewMerge" name="Interview completed" />
    <bpmn:exclusiveGateway id="Gateway_CandidateChosen" name="Candidate chosen?" />
    <bpmn:task id="Task_ExtendOffer" name="Extend offer and negotiate salary" />
    <bpmn:exclusiveGateway id="Gateway_OfferAccepted" name="Offer accepted?" />
    <bpmn:parallelGateway id="Gateway_OnboardingStart" />
    <bpmn:task id="Task_Paperwork" name="Complete paperwork" />
    <bpmn:task id="Task_Orientation" name="Orientation" />
    <bpmn:task id="Task_Training" name="Training" />
    <bpmn:parallelGateway id="Gateway_OnboardingEnd" />
    <bpmn:endEvent id="End_Integrated" name="New hire fully integrated" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent" targetRef="Task_IdentifyNeed" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_IdentifyNeed" targetRef="Task_CreateJob" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_CreateJob" targetRef="Task_ScreenResumes" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterviews" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Task_PhoneInterviews" targetRef="Gateway_InterviewMode" />
    <bpmn:sequenceFlow id="flow6" name="In-person" sourceRef="Gateway_InterviewMode" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">preference == 'in-person'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow7" name="Virtual" sourceRef="Gateway_InterviewMode" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">preference == 'virtual'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewMerge" />
    <bpmn:sequenceFlow id="flow9" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewMerge" />
    <bpmn:sequenceFlow id="flow10" sourceRef="Gateway_InterviewMerge" targetRef="Gateway_CandidateChosen" />
    <bpmn:sequenceFlow id="flow11" name="yes" sourceRef="Gateway_CandidateChosen" targetRef="Task_ExtendOffer" >
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow12" name="no" sourceRef="Gateway_CandidateChosen" targetRef="End_Integrated" />
    <bpmn:sequenceFlow id="flow13" sourceRef="Task_ExtendOffer" targetRef="Gateway_OfferAccepted" />
    <bpmn:sequenceFlow id="flow14" name="yes" sourceRef="Gateway_OfferAccepted" targetRef="Gateway_OnboardingStart" >
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow15" name="no" sourceRef="Gateway_OfferAccepted" targetRef="End_Integrated" />
    <bpmn:sequenceFlow id="flow16" sourceRef="Gateway_OnboardingStart" targetRef="Task_Paperwork" />
    <bpmn:sequenceFlow id="flow17" sourceRef="Gateway_OnboardingStart" targetRef="Task_Orientation" />
    <bpmn:sequenceFlow id="flow18" sourceRef="Gateway_OnboardingStart" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="flow19" sourceRef="Task_Paperwork" targetRef="Gateway_OnboardingEnd" />
    <bpmn:sequenceFlow id="flow20" sourceRef="Task_Orientation" targetRef="Gateway_OnboardingEnd" />
    <bpmn:sequenceFlow id="flow21" sourceRef="Task_Training" targetRef="Gateway_OnboardingEnd" />
    <bpmn:sequenceFlow id="flow22" sourceRef="Gateway_OnboardingEnd" targetRef="End_Integrated" />
  </bpmn:process>
</bpmn:definitions>