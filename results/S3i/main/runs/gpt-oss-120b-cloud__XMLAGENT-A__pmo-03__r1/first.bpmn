<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_INVENTORY" name="Inventory System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockThreshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignalReorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateExpected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateLevels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoReorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PROCUREMENT" name="Procurement Team">
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_WAREHOUSE" name="Warehouse">
        <bpmn:flowNodeRef>Task_ReceiveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordInSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOnShelves</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="Gateway_StockThreshold" name="Stock reaches threshold?" />
    <bpmn:task id="Task_SignalReorder" name="Signal need to reorder" />
    <bpmn:task id="Task_PlaceOrder" name="Place order with suppliers" />
    <bpmn:task id="Task_UpdateExpected" name="Update system with delivery dates" />
    <bpmn:task id="Task_ReceiveStock" name="Receive stock" />
    <bpmn:task id="Task_InspectQuality" name="Inspect quality" />
    <bpmn:task id="Task_RecordInSystem" name="Record stock in system" />
    <bpmn:task id="Task_PlaceOnShelves" name="Place stock on shelves" />
    <bpmn:task id="Task_UpdateLevels" name="Update inventory levels" />
    <bpmn:endEvent id="EndEvent_NoReorder" name="No reorder needed" />
    <bpmn:endEvent id="EndEvent_Done" name="Restock process complete" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Monitor" targetRef="Gateway_StockThreshold" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_StockThreshold" name="yes" targetRef="Task_SignalReorder" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_StockThreshold" name="no" targetRef="EndEvent_NoReorder" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SignalReorder" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_PlaceOrder" targetRef="Task_UpdateExpected" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_UpdateExpected" targetRef="Task_ReceiveStock" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ReceiveStock" targetRef="Task_InspectQuality" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_InspectQuality" targetRef="Task_RecordInSystem" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RecordInSystem" targetRef="Task_PlaceOnShelves" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PlaceOnShelves" targetRef="Task_UpdateLevels" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_UpdateLevels" targetRef="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>