<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_procurement" name="Procurement Team">
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_supplier" name="Supplier">
        <bpmn:flowNodeRef>Task_S1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_0" name="Start" />
    <bpmn:task id="Task_1" name="1. Identify need for new supplier" />
    <bpmn:task id="Task_2" name="2. Issue request for proposals (RFP)" />
    <bpmn:task id="Task_S1" name="3. Submit proposal" />
    <bpmn:task id="Task_3" name="4. Receive proposals" />
    <bpmn:task id="Task_4" name="5. Evaluate proposals" />
    <bpmn:task id="Task_5" name="6. Conduct site visits or interviews" />
    <bpmn:exclusiveGateway id="Gw_6" name="7. Supplier selected?" />
    <bpmn:task id="Task_7" name="8. Select supplier" />
    <bpmn:task id="Task_8" name="9. Conduct contract negotiations" />
    <bpmn:task id="Task_9" name="10. Sign contract" />
    <bpmn:task id="Task_10" name="11. Onboard supplier and execute contract" />
    <bpmn:endEvent id="End_11" name="End - Supplier onboarded" />
    <bpmn:endEvent id="End_12" name="End - Supplier not selected" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_0" targetRef="Task_1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_2" targetRef="Task_S1" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_S1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_5" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="Gw_6" targetRef="Task_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">selected == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="Gw_6" targetRef="End_12" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_10" targetRef="End_11" />
  </bpmn:process>
</bpmn:definitions>