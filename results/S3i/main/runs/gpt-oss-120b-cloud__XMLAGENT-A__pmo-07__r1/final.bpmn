<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Org" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JourneyComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BookingSystem" name="Booking System">
        <bpmn:flowNodeRef>Task_GenerateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SendMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendSMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinSend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TravelCompany" name="Travel Company">
        <bpmn:flowNodeRef>Task_UpdateInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReminders</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1"
                    name="Customer searches for flight, train, or bus ticket" />

    <bpmn:task id="Task_SelectRoute"
               name="Select preferred route, date, and time" />

    <bpmn:task id="Task_ProvideInfo"
               name="Provide personal information and payment details" />

    <bpmn:task id="Task_GenerateTicket"
               name="Generate ticket" />

    <bpmn:exclusiveGateway id="Gateway_SendMethod"
                           name="Send ticket via email or SMS?" />

    <bpmn:task id="Task_SendEmail"
               name="Send ticket via email" />

    <bpmn:task id="Task_SendSMS"
               name="Send ticket via SMS" />

    <bpmn:exclusiveGateway id="Gateway_JoinSend"
                           name="Ticket sent" />

    <bpmn:task id="Task_UpdateInventory"
               name="Update seat inventory" />

    <bpmn:exclusiveGateway id="Gateway_Reminder"
                           name="Send reminders and instructions?" />

    <bpmn:task id="Task_SendReminders"
               name="Send reminders and instructions for check-in or boarding" />

    <bpmn:task id="Task_JourneyComplete"
               name="Customer completes journey" />

    <bpmn:endEvent id="End_1"
                   name="Process completed" />

    <bpmn:sequenceFlow id="Flow_f1"
                        sourceRef="Start_1"
                        targetRef="Task_SelectRoute" />
    <bpmn:sequenceFlow id="Flow_f2"
                        sourceRef="Task_SelectRoute"
                        targetRef="Task_ProvideInfo" />
    <bpmn:sequenceFlow id="Flow_f3"
                        sourceRef="Task_ProvideInfo"
                        targetRef="Task_GenerateTicket" />
    <bpmn:sequenceFlow id="Flow_f4"
                        sourceRef="Task_GenerateTicket"
                        targetRef="Gateway_SendMethod" />
    <bpmn:sequenceFlow id="Flow_f5"
                        name="email"
                        sourceRef="Gateway_SendMethod"
                        targetRef="Task_SendEmail" />
    <bpmn:sequenceFlow id="Flow_f6"
                        name="sms"
                        sourceRef="Gateway_SendMethod"
                        targetRef="Task_SendSMS" />
    <bpmn:sequenceFlow id="Flow_f7"
                        sourceRef="Task_SendEmail"
                        targetRef="Gateway_JoinSend" />
    <bpmn:sequenceFlow id="Flow_f8"
                        sourceRef="Task_SendSMS"
                        targetRef="Gateway_JoinSend" />
    <bpmn:sequenceFlow id="Flow_f9"
                        sourceRef="Gateway_JoinSend"
                        targetRef="Task_UpdateInventory" />
    <bpmn:sequenceFlow id="Flow_f10"
                        sourceRef="Task_UpdateInventory"
                        targetRef="Gateway_Reminder" />
    <bpmn:sequenceFlow id="Flow_f11"
                        name="yes"
                        sourceRef="Gateway_Reminder"
                        targetRef="Task_SendReminders" />
    <bpmn:sequenceFlow id="Flow_f12"
                        name="no"
                        sourceRef="Gateway_Reminder"
                        targetRef="Task_JourneyComplete"
                        default="true" />
    <bpmn:sequenceFlow id="Flow_f13"
                        sourceRef="Task_SendReminders"
                        targetRef="Task_JourneyComplete" />
    <bpmn:sequenceFlow id="Flow_f14"
                        sourceRef="Task_JourneyComplete"
                        targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
