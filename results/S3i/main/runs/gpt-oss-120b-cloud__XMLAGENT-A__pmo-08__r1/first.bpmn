<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_reporter" name="Reporter">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="Tracking System">
        <bpmn:flowNodeRef>Task_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_team" name="Investigation Team">
        <bpmn:flowNodeRef>Task_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_solution_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_merge_solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Incident reported" />
    <bpmn:task id="Task_report" name="Report incident" />
    <bpmn:task id="Task_log" name="Log incident in tracking system" />
    <bpmn:task id="Task_assign" name="Assign incident to appropriate team" />
    <bpmn:task id="Task_gather" name="Gather information" />
    <bpmn:task id="Task_identify" name="Identify cause of incident" />
    <bpmn:task id="Task_propose" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="Gateway_solution_type" name="Solution type?" />
    <bpmn:task id="Task_fix" name="Implement fix" />
    <bpmn:task id="Task_training" name="Conduct training" />
    <bpmn:task id="Task_policy" name="Update policy" />
    <bpmn:exclusiveGateway id="Gateway_merge_solution" name="Merge solution" />
    <bpmn:task id="Task_followup" name="Follow-up to ensure issue won't recur" />
    <bpmn:task id="Task_close" name="Close incident report and notify stakeholders" />
    <bpmn:endEvent id="End_1" name="Process completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_report" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_report" targetRef="Task_log" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_log" targetRef="Task_assign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_assign" targetRef="Task_gather" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_gather" targetRef="Task_identify" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_identify" targetRef="Task_propose" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_propose" targetRef="Gateway_solution_type" />
    <bpmn:sequenceFlow id="Flow_8" name="Fix" sourceRef="Gateway_solution_type" targetRef="Task_fix" />
    <bpmn:sequenceFlow id="Flow_9" name="Training" sourceRef="Gateway_solution_type" targetRef="Task_training" />
    <bpmn:sequenceFlow id="Flow_10" name="Policy" sourceRef="Gateway_solution_type" targetRef="Task_policy" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_fix" targetRef="Gateway_merge_solution" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_training" targetRef="Gateway_merge_solution" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_policy" targetRef="Gateway_merge_solution" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_merge_solution" targetRef="Task_followup" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_followup" targetRef="Task_close" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_close" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>