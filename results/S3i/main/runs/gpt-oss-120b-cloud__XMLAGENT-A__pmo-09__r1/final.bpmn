<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Lane set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_RnD" name="R&D Team">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyIdea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResearchFeasibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildPrototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestPrototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RefinementNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefinePrototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_IdentifyIdea" name="Identify idea" />
    <bpmn:task id="Task_ResearchFeasibility" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="Task_DraftDesign" name="Draft design concepts" />
    <bpmn:task id="Task_BuildPrototype" name="Build prototype" />
    <bpmn:task id="Task_TestPrototype" name="Test prototype" />
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback" />
    <bpmn:exclusiveGateway id="Gateway_RefinementNeeded" name="Refinement needed?" />
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype" />
    <bpmn:exclusiveGateway id="Gateway_Approval" name="Prototype approved?" />
    <bpmn:endEvent id="End_Approved" name="Prototype approved for further development" />
    <bpmn:endEvent id="End_Discarded" name="Prototype discarded" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_IdentifyIdea" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyIdea" targetRef="Task_ResearchFeasibility" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ResearchFeasibility" targetRef="Task_DraftDesign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_DraftDesign" targetRef="Task_BuildPrototype" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_BuildPrototype" targetRef="Task_TestPrototype" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_TestPrototype" targetRef="Task_CollectFeedback" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementNeeded" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_RefinementNeeded" name="yes" targetRef="Task_RefinePrototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refinementNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_RefinementNeeded" name="no" targetRef="Gateway_Approval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!refinementNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RefinePrototype" targetRef="Task_TestPrototype" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Approval" name="yes" targetRef="End_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Approval" name="no" targetRef="End_Discarded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
