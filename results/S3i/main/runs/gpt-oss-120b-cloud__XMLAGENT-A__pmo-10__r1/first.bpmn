<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_requester" name="Requester">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_it" name="IT">
        <bpmn:flowNodeRef>Task_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TrainingDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Request submitted" />
    <bpmn:task id="Task_Request" name="Submit IT solution request" />
    <bpmn:task id="Task_Assess" name="Assess request for compatibility, cost and resources" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" />
    <bpmn:task id="Task_Procure" name="Procure tools or licenses" />
    <bpmn:task id="Task_Install" name="Install the solution" />
    <bpmn:task id="Task_Test" name="Test solution in controlled environment" />
    <bpmn:exclusiveGateway id="Gateway_TestSuccess" name="Test successful?" />
    <bpmn:task id="Task_Rollout" name="Roll out solution to requesting department" />
    <bpmn:exclusiveGateway id="Gateway_TrainingDecision" name="Provide training?" />
    <bpmn:task id="Task_Training" name="Provide training" />
    <bpmn:task id="Task_Support" name="Provide IT support" />
    <bpmn:endEvent id="End_Reject" name="Request rejected" />
    <bpmn:endEvent id="End_Completed" name="Process completed" />
    <bpmn:sequenceFlow id="flow_start_to_request" sourceRef="StartEvent_1" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="flow_request_to_assess" sourceRef="Task_Request" targetRef="Task_Assess" />
    <bpmn:sequenceFlow id="flow_assess_to_approved" sourceRef="Task_Assess" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="flow_approved_yes" name="yes" sourceRef="Gateway_Approved" targetRef="Task_Procure" />
    <bpmn:sequenceFlow id="flow_approved_no" name="no" sourceRef="Gateway_Approved" targetRef="End_Reject" />
    <bpmn:sequenceFlow id="flow_procure_to_install" sourceRef="Task_Procure" targetRef="Task_Install" />
    <bpmn:sequenceFlow id="flow_install_to_test" sourceRef="Task_Install" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="flow_test_to_success" name="yes" sourceRef="Task_Test" targetRef="Gateway_TestSuccess" />
    <bpmn:sequenceFlow id="flow_test_to_fail" name="no" sourceRef="Task_Test" targetRef="End_Reject" />
    <bpmn:sequenceFlow id="flow_success_to_rollout" sourceRef="Gateway_TestSuccess" targetRef="Task_Rollout" />
    <bpmn:sequenceFlow id="flow_rollout_to_training_decision" sourceRef="Task_Rollout" targetRef="Gateway_TrainingDecision" />
    <bpmn:sequenceFlow id="flow_train_yes" name="yes" sourceRef="Gateway_TrainingDecision" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="flow_train_no" name="no" sourceRef="Gateway_TrainingDecision" targetRef="Task_Support" />
    <bpmn:sequenceFlow id="flow_training_to_support" sourceRef="Task_Training" targetRef="Task_Support" />
    <bpmn:sequenceFlow id="flow_support_to_end" sourceRef="Task_Support" targetRef="End_Completed" />
  </bpmn:process>
</bpmn:definitions>