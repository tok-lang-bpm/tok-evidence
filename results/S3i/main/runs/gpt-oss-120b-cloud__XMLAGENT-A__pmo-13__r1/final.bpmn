<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="OrgPool" name="Organisation" processRef="OrgProcess" />
  </bpmn:collaboration>
  <bpmn:process id="OrgProcess" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Event</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>Task_LogComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkResolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Investigation" name="Investigation Team">
        <bpmn:flowNodeRef>Task_ReviewComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Financial" name="Financial Team">
        <bpmn:flowNodeRef>Task_ProcessReimbursement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Event" name="Customer files complaint" />
    <bpmn:task id="Task_LogComplaint" name="Log complaint" />
    <bpmn:task id="Task_AssignComplaint" name="Assign complaint to relevant department" />
    <bpmn:task id="Task_ReviewComplaint" name="Review complaint details" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Complaint valid and refund justified?" />
    <bpmn:task id="Task_NotifyApproval" name="Notify customer of refund approval" />
    <bpmn:task id="Task_NotifyRejection" name="Notify customer of refund rejection" />
    <bpmn:task id="Task_ProcessReimbursement" name="Process reimbursement" />
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Merge paths" />
    <bpmn:task id="Task_MarkResolved" name="Mark complaint as resolved" />
    <bpmn:task id="Task_ProvideFeedback" name="Provide feedback" />
    <bpmn:endEvent id="End_Event" name="Process completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Event" targetRef="Task_LogComplaint" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogComplaint" targetRef="Task_AssignComplaint" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AssignComplaint" targetRef="Task_ReviewComplaint" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReviewComplaint" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gateway_Decision" targetRef="Task_NotifyApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gateway_Decision" targetRef="Task_NotifyRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_NotifyApproval" targetRef="Task_ProcessReimbursement" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ProcessReimbursement" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_NotifyRejection" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Merge" targetRef="Task_MarkResolved" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_MarkResolved" targetRef="Task_ProvideFeedback" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProvideFeedback" targetRef="End_Event" />
  </bpmn:process>
</bpmn:definitions>
