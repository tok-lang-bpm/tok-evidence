<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Multinational Company" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LANESET_1">
      <bpmn:lane id="lane_coord" name="Audit Coordinator">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_regional" name="Regional Office">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Fork1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_compliance" name="Compliance Team">
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_central" name="Central Audit Team">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_auditteam" name="Audit Team">
        <bpmn:flowNodeRef>PG_Risk_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Risk_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Fork_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Join_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Fork_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Join_Final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_director" name="Audit Director">
        <bpmn:flowNodeRef>Task_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_executive" name="Executive Board">
        <!-- No direct flow nodes; receives distribution -->
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start Audit Process" />
    <bpmn:task id="Task_1" name="Send audit notification" />
    <bpmn:task id="Task_2" name="Prepare financial statements and gather documents" />
    <bpmn:parallelGateway id="PG_Fork1" name="Parallel Fork - Preparation" />
    <bpmn:task id="Task_3" name="Check regulatory updates" />
    <bpmn:task id="Task_4" name="Submit documents to central audit team" />
    <bpmn:parallelGateway id="PG_Join1" name="Parallel Join - Preparation" />
    <bpmn:task id="Task_5" name="Review submission" />
    <bpmn:exclusiveGateway id="GW_Discrepancies" name="Discrepancies found?" />
    <bpmn:task id="Task_6" name="Request clarifications" />
    <bpmn:task id="Task_7" name="Provide clarifications" />
    <bpmn:parallelGateway id="PG_Risk_Fork" name="Risk Assessment Fork" />
    <bpmn:task id="Task_8" name="Evaluate financial risks" />
    <bpmn:task id="Task_9" name="Evaluate operational risks" />
    <bpmn:task id="Task_10" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="PG_Risk_Join" name="Risk Assessment Join" />
    <bpmn:exclusiveGateway id="GW_HighRisk" name="High risk identified?" />
    <bpmn:parallelGateway id="PG_Fork_Investigate" name="Investigation Fork" />
    <bpmn:task id="Task_11" name="Perform data analysis" />
    <bpmn:task id="Task_12" name="Conduct interviews" />
    <bpmn:task id="Task_13" name="Perform site visits" />
    <bpmn:parallelGateway id="PG_Join_Investigate" name="Investigation Join" />
    <bpmn:task id="Task_14" name="Compile audit report" />
    <bpmn:task id="Task_15" name="Review audit report" />
    <bpmn:exclusiveGateway id="GW_Approval" name="Report approved?" />
    <bpmn:task id="Task_16" name="Update audit report" />
    <bpmn:parallelGateway id="PG_Fork_Final" name="Final Distribution Fork" />
    <bpmn:task id="Task_17" name="Distribute report to executive board" />
    <bpmn:task id="Task_18" name="Archive report" />
    <bpmn:parallelGateway id="PG_Join_Final" name="Final Join" />
    <bpmn:endEvent id="EndEvent_1" name="Audit Process Closed" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_2" targetRef="PG_Fork1" />
    <bpmn:sequenceFlow id="F4" sourceRef="PG_Fork1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="F5" sourceRef="PG_Fork1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_3" targetRef="PG_Join1" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_4" targetRef="PG_Join1" />
    <bpmn:sequenceFlow id="F8" sourceRef="PG_Join1" targetRef="Task_5" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_5" targetRef="GW_Discrepancies" />
    <bpmn:sequenceFlow id="F10_yes" sourceRef="GW_Discrepancies" targetRef="Task_6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">discrepanciesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11_no" sourceRef="GW_Discrepancies" targetRef="PG_Risk_Fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!discrepanciesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_7" targetRef="Task_5" />
    <bpmn:sequenceFlow id="F14" sourceRef="PG_Risk_Fork" targetRef="Task_8" />
    <bpmn:sequenceFlow id="F15" sourceRef="PG_Risk_Fork" targetRef="Task_9" />
    <bpmn:sequenceFlow id="F16" sourceRef="PG_Risk_Fork" targetRef="Task_10" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_8" targetRef="PG_Risk_Join" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_9" targetRef="PG_Risk_Join" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_10" targetRef="PG_Risk_Join" />
    <bpmn:sequenceFlow id="F20" sourceRef="PG_Risk_Join" targetRef="GW_HighRisk" />
    <bpmn:sequenceFlow id="F21_yes" sourceRef="GW_HighRisk" targetRef="PG_Fork_Investigate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">highRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22_no" sourceRef="GW_HighRisk" targetRef="Task_14">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!highRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F23" sourceRef="PG_Fork_Investigate" targetRef="Task_11" />
    <bpmn:sequenceFlow id="F24" sourceRef="PG_Fork_Investigate" targetRef="Task_12" />
    <bpmn:sequenceFlow id="F25" sourceRef="PG_Fork_Investigate" targetRef="Task_13" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_11" targetRef="PG_Join_Investigate" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_12" targetRef="PG_Join_Investigate" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_13" targetRef="PG_Join_Investigate" />
    <bpmn:sequenceFlow id="F29" sourceRef="PG_Join_Investigate" targetRef="Task_14" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_14" targetRef="Task_15" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_15" targetRef="GW_Approval" />
    <bpmn:sequenceFlow id="F32_yes" sourceRef="GW_Approval" targetRef="PG_Fork_Final">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F33_no" sourceRef="GW_Approval" targetRef="Task_16">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F34" sourceRef="Task_16" targetRef="Task_15" />
    <bpmn:sequenceFlow id="F35" sourceRef="PG_Fork_Final" targetRef="Task_17" />
    <bpmn:sequenceFlow id="F36" sourceRef="PG_Fork_Final" targetRef="Task_18" />
    <bpmn:sequenceFlow id="F37" sourceRef="Task_17" targetRef="PG_Join_Final" />
    <bpmn:sequenceFlow id="F38" sourceRef="Task_18" targetRef="PG_Join_Final" />
    <bpmn:sequenceFlow id="F39" sourceRef="PG_Join_Final" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
