<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Org" name="E-commerce Company" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PaymentProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyPaymentFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShippingConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUpEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inventory" name="Inventory System">
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateBackorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveBackorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateInventory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Task_PickItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Packaging</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shipping" name="Shipping Department">
        <bpmn:flowNodeRef>Task_PrepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Returns" name="Returns Process">
        <bpmn:flowNodeRef>Task_SendReturnLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessRefund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Events -->
    <bpmn:startEvent id="Start" name="Order placed by customer" />
    <bpmn:endEvent id="End_Failure" name="Process ended (payment failure)" />
    <bpmn:endEvent id="End_Success" name="Process completed" />
    <bpmn:endEvent id="End_Returns" name="Returns process completed" />

    <!-- System tasks -->
    <bpmn:task id="Task_RecordOrder" name="Record order details" />
    <bpmn:task id="Task_PaymentProcessing" name="Begin payment processing" />
    <bpmn:task id="Task_NotifyPaymentFailure" name="Notify customer of payment failure" />
    <bpmn:task id="Task_InformDelay" name="Inform customer about delay" />
    <bpmn:task id="Task_ShippingConfirmation" name="Send shipping confirmation to customer" />
    <bpmn:task id="Task_FollowUpEmail" name="Send follow-up email for feedback" />

    <!-- Inventory tasks -->
    <bpmn:task id="Task_CheckStock" name="Check stock availability" />
    <bpmn:task id="Task_InitiateBackorder" name="Initiate back-order" />
    <bpmn:task id="Task_ReceiveBackorder" name="Receive back-order" />
    <bpmn:task id="Task_UpdateInventory" name="Update inventory levels" />

    <!-- Warehouse tasks -->
    <bpmn:task id="Task_PickItems" name="Pick items from warehouse" />
    <bpmn:task id="Task_QC" name="Perform quality control checks" />
    <bpmn:task id="Task_Packaging" name="Package items (including gift wrap if requested)" />

    <!-- Shipping tasks -->
    <bpmn:task id="Task_PrepareDocs" name="Prepare shipping documents and labels" />
    <bpmn:task id="Task_Customs" name="Prepare customs documentation" />
    <bpmn:task id="Task_Dispatch" name="Dispatch order" />

    <!-- Returns tasks -->
    <bpmn:task id="Task_SendReturnLabel" name="Send return shipping label" />
    <bpmn:task id="Task_ReceiveReturned" name="Receive returned items" />
    <bpmn:task id="Task_InspectReturned" name="Inspect returned items" />
    <bpmn:task id="Task_ProcessRefund" name="Process refund or replacement" />

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment successful?" />
    <bpmn:exclusiveGateway id="Gateway_Stock" name="Items in stock?" />
    <bpmn:parallelGateway id="Gateway_Split" name="Parallel split for packaging and shipping docs" />
    <bpmn:parallelGateway id="Gateway_Join" name="Parallel join before dispatch" />
    <bpmn:exclusiveGateway id="Gateway_International" name="Order is international?" />
    <bpmn:exclusiveGateway id="Gateway_Issues" name="Customer reports issues?" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="F_Start_Record" sourceRef="Start" targetRef="Task_RecordOrder" />
    <bpmn:sequenceFlow id="F_Record_Payment" sourceRef="Task_RecordOrder" targetRef="Task_PaymentProcessing" />
    <bpmn:sequenceFlow id="F_Payment_Gateway" sourceRef="Task_PaymentProcessing" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="F_PaymentSuccess" name="yes" sourceRef="Gateway_Payment" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="F_PaymentFailure" name="no" sourceRef="Gateway_Payment" targetRef="Task_NotifyPaymentFailure" />
    <bpmn:sequenceFlow id="F_NotifyFailure_End" sourceRef="Task_NotifyPaymentFailure" targetRef="End_Failure" />
    <bpmn:sequenceFlow id="F_CheckStock_Gateway" sourceRef="Task_CheckStock" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="F_InStock" name="yes" sourceRef="Gateway_Stock" targetRef="Task_PickItems" />
    <bpmn:sequenceFlow id="F_OutOfStock" name="no" sourceRef="Gateway_Stock" targetRef="Task_InitiateBackorder" />
    <bpmn:sequenceFlow id="F_Initiate_Inform" sourceRef="Task_InitiateBackorder" targetRef="Task_InformDelay" />
    <bpmn:sequenceFlow id="F_Inform_Receive" sourceRef="Task_InformDelay" targetRef="Task_ReceiveBackorder" />
    <bpmn:sequenceFlow id="F_Receive_Pick" sourceRef="Task_ReceiveBackorder" targetRef="Task_PickItems" />
    <bpmn:sequenceFlow id="F_Pick_QC" sourceRef="Task_PickItems" targetRef="Task_QC" />
    <bpmn:sequenceFlow id="F_QC_Split" sourceRef="Task_QC" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="F_Split_Packaging" sourceRef="Gateway_Split" targetRef="Task_Packaging" />
    <bpmn:sequenceFlow id="F_Split_PrepareDocs" sourceRef="Gateway_Split" targetRef="Task_PrepareDocs" />
    <bpmn:sequenceFlow id="F_PrepareDocs_International" sourceRef="Task_PrepareDocs" targetRef="Gateway_International" />
    <bpmn:sequenceFlow id="F_International_Yes" name="yes" sourceRef="Gateway_International" targetRef="Task_Customs" />
    <bpmn:sequenceFlow id="F_International_No" name="no" sourceRef="Gateway_International" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F_Customs_Join" sourceRef="Task_Customs" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F_Packaging_Join" sourceRef="Task_Packaging" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F_Join_Dispatch" sourceRef="Gateway_Join" targetRef="Task_Dispatch" />
    <bpmn:sequenceFlow id="F_Dispatch_Confirmation" sourceRef="Task_Dispatch" targetRef="Task_ShippingConfirmation" />
    <bpmn:sequenceFlow id="F_Confirmation_UpdateInv" sourceRef="Task_ShippingConfirmation" targetRef="Task_UpdateInventory" />
    <bpmn:sequenceFlow id="F_UpdateInv_FollowUp" sourceRef="Task_UpdateInventory" targetRef="Task_FollowUpEmail" />
    <bpmn:sequenceFlow id="F_FollowUp_Issues" sourceRef="Task_FollowUpEmail" targetRef="Gateway_Issues" />
    <bpmn:sequenceFlow id="F_Issues_Yes" name="yes" sourceRef="Gateway_Issues" targetRef="Task_SendReturnLabel" />
    <bpmn:sequenceFlow id="F_Issues_No" name="no" sourceRef="Gateway_Issues" targetRef="End_Success" />
    <bpmn:sequenceFlow id="F_ReturnLabel_Receive" sourceRef="Task_SendReturnLabel" targetRef="Task_ReceiveReturned" />
    <bpmn:sequenceFlow id="F_Receive_Inspect" sourceRef="Task_ReceiveReturned" targetRef="Task_InspectReturned" />
    <bpmn:sequenceFlow id="F_Inspect_Process" sourceRef="Task_InspectReturned" targetRef="Task_ProcessRefund" />
    <bpmn:sequenceFlow id="F_Process_ReturnEnd" sourceRef="Task_ProcessRefund" targetRef="End_Returns" />
  </bpmn:process>
</bpmn:definitions>
