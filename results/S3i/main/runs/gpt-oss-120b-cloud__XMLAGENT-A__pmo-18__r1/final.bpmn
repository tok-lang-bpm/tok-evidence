<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="University" name="University" processRef="University_Process" />
  </bpmn:collaboration>
  <bpmn:process id="University_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_Control" name="Process Control">
        <bpmn:flowNodeRef>Gateway_DocumentsMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_FinanceEval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_FinanceEval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnrollmentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_PostConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_PostConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContinueSemester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GraduateOrWithdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_Student" name="Student">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainIDCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeginClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FileAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppealForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContinueSemester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GraduateOrWithdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_AdmissionsOffice" name="Admissions Office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsMissing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_AdmissionsCommittee" name="Admissions Committee">
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptanceLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionLetter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_FinanceEval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_FinanceEval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_PostConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_PostConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_InternationalOffice" name="International Student Office">
        <bpmn:flowNodeRef>Gateway_InternationalStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssistVisa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Start" />

    <bpmn:task id="Task_SubmitApplication" name="Submit application online" />
    <bpmn:task id="Task_ReviewApplication" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="Gateway_DocumentsMissing" name="Documents missing?" />
    <bpmn:task id="Task_NotifyMissing" name="Notify applicant to provide missing items" />
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application by admissions committee" />
    <bpmn:parallelGateway id="ParallelSplit_FinanceEval" />
    <bpmn:task id="Task_ProcessFees" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="ParallelJoin_FinanceEval" />
    <bpmn:exclusiveGateway id="Gateway_ApplicationAccepted" name="Application accepted?" />
    <bpmn:task id="Task_SendAcceptanceLetter" name="Send acceptance letter" />
    <bpmn:task id="Task_SendRejectionLetter" name="Send rejection letter" />
    <bpmn:endEvent id="EndEvent_Rejection" name="Process ends (rejection)" />
    <bpmn:task id="Task_ConfirmEnrollment" name="Confirm enrollment by deadline" />
    <bpmn:exclusiveGateway id="Gateway_EnrollmentConfirmed" name="Enrollment confirmed?" />
    <bpmn:task id="Task_CancelApplication" name="Cancel application" />
    <bpmn:endEvent id="EndEvent_Cancel" name="Process ends (cancellation)" />
    <bpmn:parallelGateway id="ParallelSplit_PostConfirm" />
    <bpmn:task id="Task_ReceiveOrientation" name="Receive orientation materials" />
    <bpmn:task id="Task_SetupAccounts" name="Set up student accounts for email, online portals, and library access" />
    <bpmn:parallelGateway id="ParallelJoin_PostConfirm" />
    <bpmn:exclusiveGateway id="Gateway_InternationalStudent" name="International student?" />
    <bpmn:task id="Task_AssistVisa" name="Assist with visa processing" />
    <bpmn:task id="Task_ObtainIDCard" name="Obtain student ID card" />
    <bpmn:task id="Task_MeetAdvisor" name="Meeting with an academic advisor" />
    <bpmn:task id="Task_SelectCourses" name="Selecting courses" />
    <bpmn:task id="Task_ResolveConflicts" name="Resolving any schedule conflicts" />
    <bpmn:task id="Task_BeginClasses" name="Begin attending classes" />
    <bpmn:task id="Task_AddDropCourses" name="Add or drop courses within the add/drop period" />
    <bpmn:task id="Task_PostGrades" name="Grades are posted" />
    <bpmn:task id="Task_ReviewGrades" name="Review grades online" />
    <bpmn:exclusiveGateway id="Gateway_Appeal" name="Has grievance?" />
    <bpmn:task id="Task_FileAppeal" name="File an appeal" />
    <bpmn:task id="Task_SubmitAppealForm" name="Submitting an appeal form" />
    <bpmn:task id="Task_MeetAppealsCommittee" name="Meeting with the appeals committee" />
    <bpmn:task id="Task_AwaitDecision" name="Awaiting a decision" />
    <bpmn:exclusiveGateway id="Gateway_ContinueSemester" name="Continue next semester?" />
    <bpmn:endEvent id="EndEvent_GraduateOrWithdraw" name="Student graduates or withdraws" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent_1" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocumentsMissing" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Gateway_DocumentsMissing" name="yes" targetRef="Task_NotifyMissing" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Gateway_DocumentsMissing" name="no" targetRef="ParallelSplit_FinanceEval" />
    <bpmn:sequenceFlow id="flow6" sourceRef="Task_NotifyMissing" targetRef="ParallelSplit_FinanceEval" />
    <bpmn:sequenceFlow id="flow7" sourceRef="ParallelSplit_FinanceEval" targetRef="Task_EvaluateApplication" />
    <bpmn:sequenceFlow id="flow8" sourceRef="ParallelSplit_FinanceEval" targetRef="Task_ProcessFees" />
    <bpmn:sequenceFlow id="flow9" sourceRef="Task_EvaluateApplication" targetRef="ParallelJoin_FinanceEval" />
    <bpmn:sequenceFlow id="flow10" sourceRef="Task_ProcessFees" targetRef="ParallelJoin_FinanceEval" />
    <bpmn:sequenceFlow id="flow11" sourceRef="ParallelJoin_FinanceEval" targetRef="Gateway_ApplicationAccepted" />
    <bpmn:sequenceFlow id="flow12" sourceRef="Gateway_ApplicationAccepted" name="yes" targetRef="Task_SendAcceptanceLetter" />
    <bpmn:sequenceFlow id="flow13" sourceRef="Gateway_ApplicationAccepted" name="no" targetRef="Task_SendRejectionLetter" />
    <bpmn:sequenceFlow id="flow14" sourceRef="Task_SendRejectionLetter" targetRef="EndEvent_Rejection" />
    <bpmn:sequenceFlow id="flow15" sourceRef="Task_SendAcceptanceLetter" targetRef="Task_ConfirmEnrollment" />
    <bpmn:sequenceFlow id="flow16" sourceRef="Task_ConfirmEnrollment" targetRef="Gateway_EnrollmentConfirmed" />
    <bpmn:sequenceFlow id="flow17" sourceRef="Gateway_EnrollmentConfirmed" name="yes" targetRef="ParallelSplit_PostConfirm" />
    <bpmn:sequenceFlow id="flow18" sourceRef="Gateway_EnrollmentConfirmed" name="no" targetRef="Task_CancelApplication" />
    <bpmn:sequenceFlow id="flow19" sourceRef="Task_CancelApplication" targetRef="EndEvent_Cancel" />
    <bpmn:sequenceFlow id="flow20" sourceRef="ParallelSplit_PostConfirm" targetRef="Task_ReceiveOrientation" />
    <bpmn:sequenceFlow id="flow21" sourceRef="ParallelSplit_PostConfirm" targetRef="Task_SetupAccounts" />
    <bpmn:sequenceFlow id="flow22" sourceRef="Task_ReceiveOrientation" targetRef="ParallelJoin_PostConfirm" />
    <bpmn:sequenceFlow id="flow23" sourceRef="Task_SetupAccounts" targetRef="ParallelJoin_PostConfirm" />
    <bpmn:sequenceFlow id="flow24" sourceRef="ParallelJoin_PostConfirm" targetRef="Gateway_InternationalStudent" />
    <bpmn:sequenceFlow id="flow25" sourceRef="Gateway_InternationalStudent" name="yes" targetRef="Task_AssistVisa" />
    <bpmn:sequenceFlow id="flow26" sourceRef="Gateway_InternationalStudent" name="no" targetRef="Task_ObtainIDCard" />
    <bpmn:sequenceFlow id="flow27" sourceRef="Task_AssistVisa" targetRef="Task_ObtainIDCard" />
    <bpmn:sequenceFlow id="flow28" sourceRef="Task_ObtainIDCard" targetRef="Task_MeetAdvisor" />
    <bpmn:sequenceFlow id="flow29" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses" />
    <bpmn:sequenceFlow id="flow30" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts" />
    <bpmn:sequenceFlow id="flow31" sourceRef="Task_ResolveConflicts" targetRef="Task_BeginClasses" />
    <bpmn:sequenceFlow id="flow32" sourceRef="Task_BeginClasses" targetRef="Task_AddDropCourses" />
    <bpmn:sequenceFlow id="flow33" sourceRef="Task_AddDropCourses" targetRef="Task_PostGrades" />
    <bpmn:sequenceFlow id="flow34" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades" />
    <bpmn:sequenceFlow id="flow35" sourceRef="Task_ReviewGrades" targetRef="Gateway_Appeal" />
    <bpmn:sequenceFlow id="flow36" sourceRef="Gateway_Appeal" name="yes" targetRef="Task_FileAppeal" />
    <bpmn:sequenceFlow id="flow37" sourceRef="Gateway_Appeal" name="no" targetRef="Gateway_ContinueSemester" />
    <bpmn:sequenceFlow id="flow38" sourceRef="Task_FileAppeal" targetRef="Task_SubmitAppealForm" />
    <bpmn:sequenceFlow id="flow39" sourceRef="Task_SubmitAppealForm" targetRef="Task_MeetAppealsCommittee" />
    <bpmn:sequenceFlow id="flow40" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitDecision" />
    <bpmn:sequenceFlow id="flow41" sourceRef="Task_AwaitDecision" targetRef="Gateway_ContinueSemester" />
    <bpmn:sequenceFlow id="flow42" sourceRef="Gateway_ContinueSemester" name="yes" targetRef="Task_AddDropCourses" />
    <bpmn:sequenceFlow id="flow43" sourceRef="Gateway_ContinueSemester" name="no" targetRef="EndEvent_GraduateOrWithdraw" />
  </bpmn:process>
</bpmn:definitions>
