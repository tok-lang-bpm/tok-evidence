<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneSet_1">
      <bpmn:lane id="lane_secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotShip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_logistics_head" name="Logistics Dept Head">
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="1. Ship goods?" />
    <bpmn:exclusiveGateway id="Gateway_1" name="1. Ship goods?" />
    <bpmn:task id="Task_2" name="2. Clarify shipping responsibility" />
    <bpmn:exclusiveGateway id="Gateway_3" name="3. Large amounts?" />
    <bpmn:task id="Task_4" name="4. Invite logistic companies" />
    <bpmn:task id="Task_4_1" name="4.1. Select logistic company" />
    <bpmn:task id="Task_5" name="5. Use normal post shipment" />
    <bpmn:exclusiveGateway id="Gateway_3_join" />
    <bpmn:parallelGateway id="ParallelGateway_6" />
    <bpmn:task id="Task_6" name="6. Write package label" />
    <bpmn:exclusiveGateway id="Gateway_7" name="7. Insurance needed?" />
    <bpmn:task id="Task_8" name="8. Take parcel insurance" />
    <bpmn:task id="Task_9" name="9. Package goods" />
    <bpmn:parallelGateway id="ParallelGateway_10" />
    <bpmn:task id="Task_10" name="10. Prepare goods for pickup" />
    <bpmn:endEvent id="EndEvent_Final" name="End" />
    <bpmn:endEvent id="EndEvent_NotShip" name="Not shipped" />
    <bpmn:sequenceFlow id="flow_start_to_gw1" sourceRef="StartEvent_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="flow_gw1_yes" sourceRef="Gateway_1" targetRef="Task_2" name="yes" />
    <bpmn:sequenceFlow id="flow_gw1_no" sourceRef="Gateway_1" targetRef="EndEvent_NotShip" name="no" />
    <bpmn:sequenceFlow id="flow_task2_to_gw3" sourceRef="Task_2" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="flow_gw3_yes" sourceRef="Gateway_3" targetRef="Task_4" name="yes" />
    <bpmn:sequenceFlow id="flow_gw3_no" sourceRef="Gateway_3" targetRef="Task_5" name="no" />
    <bpmn:sequenceFlow id="flow_task4_to_task4_1" sourceRef="Task_4" targetRef="Task_4_1" />
    <bpmn:sequenceFlow id="flow_task4_1_to_join" sourceRef="Task_4_1" targetRef="Gateway_3_join" />
    <bpmn:sequenceFlow id="flow_task5_to_join" sourceRef="Task_5" targetRef="Gateway_3_join" />
    <bpmn:sequenceFlow id="flow_join_to_parallel" sourceRef="Gateway_3_join" targetRef="ParallelGateway_6" />
    <bpmn:sequenceFlow id="flow_parallel_to_label" sourceRef="ParallelGateway_6" targetRef="Task_6" />
    <bpmn:sequenceFlow id="flow_parallel_to_insurance_gw" sourceRef="ParallelGateway_6" targetRef="Gateway_7" />
    <bpmn:sequenceFlow id="flow_parallel_to_packaging" sourceRef="ParallelGateway_6" targetRef="Task_9" />
    <bpmn:sequenceFlow id="flow_insurance_yes" sourceRef="Gateway_7" targetRef="Task_8" name="yes" />
    <bpmn:sequenceFlow id="flow_insurance_no" sourceRef="Gateway_7" targetRef="ParallelGateway_10" name="no" />
    <bpmn:sequenceFlow id="flow_label_to_join" sourceRef="Task_6" targetRef="ParallelGateway_10" />
    <bpmn:sequenceFlow id="flow_insurance_to_join" sourceRef="Task_8" targetRef="ParallelGateway_10" />
    <bpmn:sequenceFlow id="flow_packaging_to_join" sourceRef="Task_9" targetRef="ParallelGateway_10" />
    <bpmn:sequenceFlow id="flow_join_to_prepare" sourceRef="ParallelGateway_10" targetRef="Task_10" />
    <bpmn:sequenceFlow id="flow_prepare_to_end" sourceRef="Task_10" targetRef="EndEvent_Final" />
  </bpmn:process>
</bpmn:definitions>