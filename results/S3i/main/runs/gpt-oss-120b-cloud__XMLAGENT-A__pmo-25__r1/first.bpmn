<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Applicant" name="Job Applicant">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_17</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Company" name="Company">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_16</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start" />
    <bpmn:task id="Task_1" name="Report companies you wrote job applications to" />
    <bpmn:task id="Task_2" name="Send potential job offers based on applications" />
    <bpmn:task id="Task_3" name="Confirm receipt of job application" />
    <bpmn:task id="Task_4" name="Rate the application" />
    <bpmn:exclusiveGateway id="Gateway_5" name="Negotiate interview?" />
    <bpmn:task id="Task_6" name="Negotiate job interview" />
    <bpmn:exclusiveGateway id="Gateway_7" name="Company wants to hire?" />
    <bpmn:task id="Task_8" name="Enter probation phase" />
    <bpmn:parallelGateway id="Gateway_9" name="Parallel split" />
    <bpmn:task id="Task_10" name="Rate the company" />
    <bpmn:task id="Task_11" name="Company rates you" />
    <bpmn:parallelGateway id="Gateway_12" name="Parallel join" />
    <bpmn:exclusiveGateway id="Gateway_13" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="Gateway_15" name="Rating <= C?" />
    <bpmn:task id="Task_16" name="Continue receiving job offers (no reporting)" />
    <bpmn:endEvent id="End_14" name="Process ends" />
    <bpmn:endEvent id="End_17" name="Ongoing process" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_4" targetRef="Gateway_5" />
    <bpmn:sequenceFlow id="F6_yes" name="yes" sourceRef="Gateway_5" targetRef="Task_6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6_no" name="no" sourceRef="Gateway_5" targetRef="Gateway_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_6" targetRef="Gateway_7" />
    <bpmn:sequenceFlow id="F8_yes" name="yes" sourceRef="Gateway_7" targetRef="Task_8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8_no" name="no" sourceRef="Gateway_7" targetRef="End_14">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_8" targetRef="Gateway_9" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gateway_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gateway_9" targetRef="Task_11" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_10" targetRef="Gateway_12" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_11" targetRef="Gateway_12" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gateway_12" targetRef="Gateway_13" />
    <bpmn:sequenceFlow id="F15_no" name="no" sourceRef="Gateway_13" targetRef="End_14">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15_yes" name="yes" sourceRef="Gateway_13" targetRef="Gateway_15">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16_yes" name="yes" sourceRef="Gateway_15" targetRef="Task_16">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16_no" name="no" sourceRef="Gateway_15" targetRef="End_14">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_16" targetRef="End_17" />
  </bpmn:process>
</bpmn:definitions>