<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Parent" name="Parent">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_EndPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideExtension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExtensionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoExtension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Extended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR / Company">
        <bpmn:flowNodeRef>Task_FetchModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherCompanyInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessExtension</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SocialSecurity" name="Social Security">
        <bpmn:flowNodeRef>Task_NotifySocialSecurity</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_FetchModels" name="Fetch information about potential models (months duration, split between parents)" />
    <bpmn:task id="Task_SelectModel" name="Select maternity leave model" />
    <bpmn:task id="Task_CollectInfo" name="Collect relevant information" />
    <bpmn:parallelGateway id="Gateway_NotifySplit" name="Notify split" />
    <bpmn:task id="Task_NotifyCompany" name="Notify Company" />
    <bpmn:task id="Task_NotifySocialSecurity" name="Notify Social Security" />
    <bpmn:parallelGateway id="Gateway_NotifyJoin" name="Notify join" />
    <bpmn:task id="Task_GatherCompanyInfo" name="Gather information from companies" />
    <bpmn:intermediateCatchEvent id="Catch_EndPeriod" name="End of leave period">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT0S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_DecideExtension" name="Parent decides about extension" />
    <bpmn:exclusiveGateway id="Gateway_ExtensionDecision" name="Extension?" />
    <bpmn:task id="Task_ProcessExtension" name="Process extension of maternity leave" />
    <bpmn:endEvent id="End_NoExtension" name="Leave ends" />
    <bpmn:endEvent id="End_Extended" name="Leave extended" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_FetchModels" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FetchModels" targetRef="Task_SelectModel" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectModel" targetRef="Task_CollectInfo" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CollectInfo" targetRef="Gateway_NotifySplit" />
    <bpmn:sequenceFlow id="Flow_5a" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifyCompany" />
    <bpmn:sequenceFlow id="Flow_5b" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifySocialSecurity" />
    <bpmn:sequenceFlow id="Flow_6a" sourceRef="Task_NotifyCompany" targetRef="Gateway_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_6b" sourceRef="Task_NotifySocialSecurity" targetRef="Gateway_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_NotifyJoin" targetRef="Task_GatherCompanyInfo" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_GatherCompanyInfo" targetRef="Catch_EndPeriod" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Catch_EndPeriod" targetRef="Task_DecideExtension" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DecideExtension" targetRef="Gateway_ExtensionDecision" />
    <bpmn:sequenceFlow id="Flow_11_yes" sourceRef="Gateway_ExtensionDecision" targetRef="Task_ProcessExtension" name="yes" />
    <bpmn:sequenceFlow id="Flow_12_yes" sourceRef="Task_ProcessExtension" targetRef="End_Extended" />
    <bpmn:sequenceFlow id="Flow_13_no" sourceRef="Gateway_ExtensionDecision" targetRef="End_NoExtension" name="no" />
  </bpmn:process>
</bpmn:definitions>
