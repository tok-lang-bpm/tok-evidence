<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="Lane_Intern" name="Intern">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InternUpdate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InternUpdate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InternUpdate3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_SplitTweets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_JoinTweets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_SplitUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_JoinUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Task_CompanyUpdate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpdate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpdate3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_ReceiveOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invalidate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start" />
    <bpmn:task id="Task_EnterDetails" name="Enter topic, money, experience and hobbies" />
    <bpmn:task id="Task_ReceiveOffer" name="Receive offer" />
    <bpmn:exclusiveGateway id="GW_Accept" name="Accept offer?" />
    <bpmn:task id="Task_Invalidate" name="Invalidate other offers" />
    <bpmn:parallelGateway id="PG_SplitUpdates" />
    <bpmn:task id="Task_InternUpdate1" name="Write intern status update 1" />
    <bpmn:task id="Task_InternUpdate2" name="Write intern status update 2" />
    <bpmn:task id="Task_InternUpdate3" name="Write intern status update 3" />
    <bpmn:task id="Task_CompanyUpdate1" name="Write company status update 1" />
    <bpmn:task id="Task_CompanyUpdate2" name="Write company status update 2" />
    <bpmn:task id="Task_CompanyUpdate3" name="Write company status update 3" />
    <bpmn:parallelGateway id="PG_JoinUpdates" />
    <bpmn:task id="Task_Recommend" name="Recommend company via Twitter" />
    <bpmn:parallelGateway id="PG_SplitTweets" />
    <bpmn:task id="Task_Tweet1" name="Send tweet 1" />
    <bpmn:task id="Task_Tweet2" name="Send tweet 2" />
    <bpmn:task id="Task_Tweet3" name="Send tweet 3" />
    <bpmn:parallelGateway id="PG_JoinTweets" />
    <bpmn:endEvent id="End_1" name="End" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_EnterDetails" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_EnterDetails" targetRef="Task_ReceiveOffer" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_ReceiveOffer" targetRef="GW_Accept" />
    <bpmn:sequenceFlow id="F4" sourceRef="GW_Accept" targetRef="Task_Invalidate" name="accept" />
    <bpmn:sequenceFlow id="F5" sourceRef="GW_Accept" targetRef="Task_ReceiveOffer" name="deny" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Invalidate" targetRef="PG_SplitUpdates" />
    <bpmn:sequenceFlow id="F7" sourceRef="PG_SplitUpdates" targetRef="Task_InternUpdate1" />
    <bpmn:sequenceFlow id="F8" sourceRef="PG_SplitUpdates" targetRef="Task_CompanyUpdate1" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_InternUpdate1" targetRef="Task_InternUpdate2" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_InternUpdate2" targetRef="Task_InternUpdate3" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_InternUpdate3" targetRef="PG_JoinUpdates" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_CompanyUpdate1" targetRef="Task_CompanyUpdate2" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_CompanyUpdate2" targetRef="Task_CompanyUpdate3" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_CompanyUpdate3" targetRef="PG_JoinUpdates" />
    <bpmn:sequenceFlow id="F15" sourceRef="PG_JoinUpdates" targetRef="Task_Recommend" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Recommend" targetRef="PG_SplitTweets" />
    <bpmn:sequenceFlow id="F17" sourceRef="PG_SplitTweets" targetRef="Task_Tweet1" />
    <bpmn:sequenceFlow id="F18" sourceRef="PG_SplitTweets" targetRef="Task_Tweet2" />
    <bpmn:sequenceFlow id="F19" sourceRef="PG_SplitTweets" targetRef="Task_Tweet3" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Tweet1" targetRef="PG_JoinTweets" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Tweet2" targetRef="PG_JoinTweets" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_Tweet3" targetRef="PG_JoinTweets" />
    <bpmn:sequenceFlow id="F23" sourceRef="PG_JoinTweets" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>