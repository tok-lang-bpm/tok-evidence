<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL_Org" name="Organisation" processRef="LANPartyProcess" />
  </bpmn:collaboration>
  <bpmn:process id="LANPartyProcess" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Organizer" name="Organizer">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MissingGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DownloadGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectDateResponses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DateAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnoughBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnjoyParty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Start" />
    <bpmn:task id="Task_SendInvitations" name="Send invitations to 10 friends" />
    <bpmn:task id="Task_FindGames" name="Find out which games friends want to play" />
    <bpmn:task id="Task_AppointDate" name="Appoint a date for the LAN party" />
    <bpmn:parallelGateway id="ParallelSplit" name="Parallel split (date &amp; games)" />
    <bpmn:task id="Task_CheckGames" name="Check if all requested games are available" />
    <bpmn:exclusiveGateway id="Gateway_MissingGames" name="Missing games?" />
    <bpmn:task id="Task_DownloadGames" name="Download missing games" />
    <bpmn:task id="Task_CollectDateResponses" name="Collect friends' availability for the date" />
    <bpmn:exclusiveGateway id="Gateway_DateAgreement" name="8 or more people agree?" />
    <bpmn:parallelGateway id="ParallelJoin" name="Parallel join" />
    <bpmn:task id="Task_DetermineBeer" name="Determine required amount of beer" />
    <bpmn:exclusiveGateway id="Gateway_EnoughBeer" name="Enough beer available?" />
    <bpmn:task id="Task_BuyBeer" name="Buy missing beer" />
    <bpmn:task id="Task_EnjoyParty" name="Enjoy the LAN party" />
    <bpmn:endEvent id="EndEvent" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent" targetRef="Task_SendInvitations" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_SendInvitations" targetRef="Task_FindGames" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_FindGames" targetRef="Task_AppointDate" />
    <bpmn:sequenceFlow id="f4" sourceRef="Task_AppointDate" targetRef="ParallelSplit" />
    <bpmn:sequenceFlow id="f5" sourceRef="ParallelSplit" targetRef="Task_CheckGames" />
    <bpmn:sequenceFlow id="f6" sourceRef="ParallelSplit" targetRef="Task_CollectDateResponses" />
    <bpmn:sequenceFlow id="f7" sourceRef="Task_CheckGames" targetRef="Gateway_MissingGames" />
    <bpmn:sequenceFlow id="f8" sourceRef="Gateway_MissingGames" name="yes" targetRef="Task_DownloadGames" />
    <bpmn:sequenceFlow id="f9" sourceRef="Gateway_MissingGames" name="no" targetRef="ParallelJoin" />
    <bpmn:sequenceFlow id="f10" sourceRef="Task_DownloadGames" targetRef="ParallelJoin" />
    <bpmn:sequenceFlow id="f11" sourceRef="Task_CollectDateResponses" targetRef="Gateway_DateAgreement" />
    <bpmn:sequenceFlow id="f12" sourceRef="Gateway_DateAgreement" name="yes" targetRef="ParallelJoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="Gateway_DateAgreement" name="no" targetRef="Task_AppointDate" />
    <bpmn:sequenceFlow id="f14" sourceRef="ParallelJoin" targetRef="Task_DetermineBeer" />
    <bpmn:sequenceFlow id="f15" sourceRef="Task_DetermineBeer" targetRef="Gateway_EnoughBeer" />
    <bpmn:sequenceFlow id="f16" sourceRef="Gateway_EnoughBeer" name="yes" targetRef="Task_EnjoyParty" />
    <bpmn:sequenceFlow id="f17" sourceRef="Gateway_EnoughBeer" name="no" targetRef="Task_BuyBeer" />
    <bpmn:sequenceFlow id="f18" sourceRef="Task_BuyBeer" targetRef="Task_EnjoyParty" />
    <bpmn:sequenceFlow id="f19" sourceRef="Task_EnjoyParty" targetRef="EndEvent" />
  </bpmn:process>
</bpmn:definitions>