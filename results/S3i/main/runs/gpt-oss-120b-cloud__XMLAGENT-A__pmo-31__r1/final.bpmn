<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="laneSet">
      <bpmn:lane id="UserLane" name="User">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BNAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BankInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginSelect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NameBrainstorm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCharName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_NameAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_WaitExpansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExpansionMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Expansion</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="Start" name="Start" />
    <bpmn:parallelGateway id="ParallelSplit" name="Start Parallel" />
    <bpmn:task id="Task_NameBrainstorm" name="Come up with good character names" />
    <bpmn:exclusiveGateway id="GW_BNAccount" name="Do you have a battle.net account?" />
    <bpmn:task id="Task_EnterAccount" name="Enter account information and click confirmation link" />
    <bpmn:exclusiveGateway id="GW_Subscription" name="Do you have an active WoW subscription?" />
    <bpmn:task id="Task_SelectPayment" name="Select payment method" />
    <bpmn:exclusiveGateway id="GW_PaymentMethod" name="Payment method?" />
    <bpmn:task id="Task_CreditCard" name="Enter credit card information" />
    <bpmn:task id="Task_BankInfo" name="Enter IBAN and BIC numbers" />
    <bpmn:task id="Task_LoginSelect" name="Log into game and select realm, race and class" />
    <bpmn:parallelGateway id="ParallelJoin1" name="Join Account and Name" />
    <bpmn:task id="Task_EnterCharName" name="Enter character name" />
    <bpmn:exclusiveGateway id="GW_NameAvailable" name="Is name available?" />
    <bpmn:task id="Task_Confirmation" name="Receive confirmation and character selfies" />
    <bpmn:parallelGateway id="ParallelSplit2" name="Post‑creation parallel" />
    <bpmn:endEvent id="End_Complete" name="Character creation complete" />
    <bpmn:intermediateCatchEvent id="Timer_WaitExpansion" name="Wait for expansion release">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT0S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_ExpansionMessage" name="Receive expansion release message" />
    <bpmn:endEvent id="End_Expansion" name="Expansion message received" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow_start_to_split" sourceRef="Start" targetRef="ParallelSplit" />
    <bpmn:sequenceFlow id="flow_split_to_name" sourceRef="ParallelSplit" targetRef="Task_NameBrainstorm" />
    <bpmn:sequenceFlow id="flow_split_to_account" sourceRef="ParallelSplit" targetRef="GW_BNAccount" />
    <bpmn:sequenceFlow id="flow_bn_yes" sourceRef="GW_BNAccount" targetRef="GW_Subscription" name="yes" />
    <bpmn:sequenceFlow id="flow_bn_no" sourceRef="GW_BNAccount" targetRef="Task_EnterAccount" name="no" />
    <bpmn:sequenceFlow id="flow_enteraccount_to_sub" sourceRef="Task_EnterAccount" targetRef="GW_Subscription" />
    <bpmn:sequenceFlow id="flow_sub_yes" sourceRef="GW_Subscription" targetRef="Task_LoginSelect" name="yes" />
    <bpmn:sequenceFlow id="flow_sub_no" sourceRef="GW_Subscription" targetRef="Task_SelectPayment" name="no" />
    <bpmn:sequenceFlow id="flow_select_to_paymentgw" sourceRef="Task_SelectPayment" targetRef="GW_PaymentMethod" />
    <bpmn:sequenceFlow id="flow_payment_credit" sourceRef="GW_PaymentMethod" targetRef="Task_CreditCard" name="credit card" />
    <bpmn:sequenceFlow id="flow_payment_bank" sourceRef="GW_PaymentMethod" targetRef="Task_BankInfo" name="bank" />
    <bpmn:sequenceFlow id="flow_credit_to_login" sourceRef="Task_CreditCard" targetRef="Task_LoginSelect" />
    <bpmn:sequenceFlow id="flow_bank_to_login" sourceRef="Task_BankInfo" targetRef="Task_LoginSelect" />
    <bpmn:sequenceFlow id="flow_name_to_join" sourceRef="Task_NameBrainstorm" targetRef="ParallelJoin1" />
    <bpmn:sequenceFlow id="flow_login_to_join" sourceRef="Task_LoginSelect" targetRef="ParallelJoin1" />
    <bpmn:sequenceFlow id="flow_join_to_entername" sourceRef="ParallelJoin1" targetRef="Task_EnterCharName" />
    <bpmn:sequenceFlow id="flow_entername_to_check" sourceRef="Task_EnterCharName" targetRef="GW_NameAvailable" />
    <bpmn:sequenceFlow id="flow_name_yes" sourceRef="GW_NameAvailable" targetRef="Task_Confirmation" name="yes" />
    <bpmn:sequenceFlow id="flow_name_no" sourceRef="GW_NameAvailable" targetRef="Task_EnterCharName" name="no" />
    <bpmn:sequenceFlow id="flow_conf_to_split2" sourceRef="Task_Confirmation" targetRef="ParallelSplit2" />
    <bpmn:sequenceFlow id="flow_split2_to_end" sourceRef="ParallelSplit2" targetRef="End_Complete" />
    <bpmn:sequenceFlow id="flow_split2_to_timer" sourceRef="ParallelSplit2" targetRef="Timer_WaitExpansion" />
    <bpmn:sequenceFlow id="flow_timer_to_exp_msg" sourceRef="Timer_WaitExpansion" targetRef="Task_ExpansionMessage" />
    <bpmn:sequenceFlow id="flow_exp_msg_to_end" sourceRef="Task_ExpansionMessage" targetRef="End_Expansion" />
  </bpmn:process>
</bpmn:definitions>
