<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneSet_1">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_artist" name="Artist">
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_printer" name="3D Printer">
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_16</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start: Want custom 3D model" />
    <bpmn:task id="Task_1" name="Instruct artist to create project" />
    <bpmn:task id="Task_2" name="Send sketches to artist" />
    <bpmn:task id="Task_3" name="Create/Update 3D model" />
    <bpmn:task id="Task_4" name="Review model and request changes" />
    <bpmn:exclusiveGateway id="Gateway_5" name="Satisfied?" />
    <bpmn:task id="Task_6" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="Gateway_7" name="Color in stock?" />
    <bpmn:task id="Task_8" name="Check color amount" />
    <bpmn:exclusiveGateway id="Gateway_9" name="Enough color (>100g)?" />
    <bpmn:task id="Task_10" name="Add color to shopping list" />
    <bpmn:task id="Task_11" name="Order plastic color" />
    <bpmn:parallelGateway id="Gateway_12" name="Prepare for printing" />
    <bpmn:task id="Task_13" name="Turn printer on and heat up" />
    <bpmn:task id="Task_14" name="Generate Gcode from STL" />
    <bpmn:parallelGateway id="Gateway_15" name="Preparation done" />
    <bpmn:task id="Task_16" name="Print the model" />
    <bpmn:endEvent id="End_1" name="Process completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Gateway_5" />
    <bpmn:sequenceFlow id="Flow_5_yes" name="yes" sourceRef="Gateway_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_5_no" name="no" sourceRef="Gateway_5" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_6" targetRef="Gateway_7" />
    <bpmn:sequenceFlow id="Flow_7_inStock" name="in stock" sourceRef="Gateway_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_7_outStock" name="out of stock" sourceRef="Gateway_7" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_8" targetRef="Gateway_9" />
    <bpmn:sequenceFlow id="Flow_9_enough" name="enough" sourceRef="Gateway_9" targetRef="Gateway_12" />
    <bpmn:sequenceFlow id="Flow_9_notEnough" name="not enough" sourceRef="Gateway_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_10" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_11" targetRef="Gateway_12" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_12" targetRef="Task_13" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_12" targetRef="Task_14" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_13" targetRef="Gateway_15" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_14" targetRef="Gateway_15" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_15" targetRef="Task_16" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_16" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>