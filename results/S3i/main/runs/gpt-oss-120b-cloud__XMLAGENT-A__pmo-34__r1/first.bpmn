<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_designer" name="Designer">
        <bpmn:flowNodeRef>Task_DevelopDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_purchaser" name="Purchaser">
        <bpmn:flowNodeRef>Task_OrderSets</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_children" name="Children">
        <bpmn:flowNodeRef>Task_SortParts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_builder" name="Builder">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReorderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RedesignRebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_DevelopDesign" name="Develop basic design" />
    <bpmn:task id="Task_OrderSets" name="Order Lego brick sets" />
    <bpmn:task id="Task_GiveSets" name="Give Lego sets to children" />
    <bpmn:task id="Task_SortParts" name="Children sort parts into containers" />
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="Parts available?" />
    <bpmn:task id="Task_ReorderParts" name="Reorder individual parts" />
    <bpmn:task id="Task_BuildSubcomponent" name="Build subcomponent" />
    <bpmn:task id="Task_TestSubcomponent" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test successful?" />
    <bpmn:task id="Task_RedesignRebuild" name="Redesign and rebuild subcomponent" />
    <bpmn:task id="Task_Assemble" name="Assemble subcomponents" />
    <bpmn:endEvent id="EndEvent_Success" name="Process completed" />
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent_1" targetRef="Task_DevelopDesign" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_DevelopDesign" targetRef="Task_OrderSets" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_OrderSets" targetRef="Task_GiveSets" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Task_GiveSets" targetRef="Task_SortParts" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Task_SortParts" targetRef="Gateway_PartsAvailable" />
    <bpmn:sequenceFlow id="flow6_yes" name="yes" sourceRef="Gateway_PartsAvailable" targetRef="Task_BuildSubcomponent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">partsAvailable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow6_no" name="no" sourceRef="Gateway_PartsAvailable" targetRef="Task_ReorderParts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!partsAvailable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_ReorderParts" targetRef="Gateway_PartsAvailable" />
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent" />
    <bpmn:sequenceFlow id="flow9_yes" name="yes" sourceRef="Gateway_TestResult" targetRef="Task_Assemble">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">testSuccess</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow9_no" name="no" sourceRef="Gateway_TestResult" targetRef="Task_RedesignRebuild">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!testSuccess</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow10" sourceRef="Task_RedesignRebuild" targetRef="Task_BuildSubcomponent" />
    <bpmn:sequenceFlow id="flow11" sourceRef="Task_Assemble" targetRef="EndEvent_Success" />
  </bpmn:process>
</bpmn:definitions>