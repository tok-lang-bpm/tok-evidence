<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="customerPool" name="Customer" />
    <bpmn:participant id="orgPool" name="Organisation" processRef="orgProcess" />
  </bpmn:collaboration>
  <bpmn:process id="orgProcess" isExecutable="false">
    <bpmn:laneSet id="laneSet1">
      <bpmn:lane id="laneOrg" name="Organisation">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSource1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSource2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinOrders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Customer tells properties" />
    <bpmn:parallelGateway id="Gateway_Split" />
    <bpmn:task id="Task_OrderSource1" name="Order parts from source 1" />
    <bpmn:task id="Task_OrderSource2" name="Order parts from source 2" />
    <bpmn:parallelGateway id="Gateway_JoinOrders" />
    <bpmn:task id="Task_InspectParts" name="Inspect received parts" />
    <bpmn:task id="Task_AssembleParts" name="Assemble the parts" />
    <bpmn:task id="Task_SendUpdates" name="Send production updates to customer" />
    <bpmn:task id="Task_ProduceFirstSaw" name="Produce first saw" />
    <bpmn:task id="Task_SendFirstSaw" name="Send first saw to customer" />
    <bpmn:exclusiveGateway id="Gateway_CustomerFeedback" name="Customer likes the saw?" />
    <bpmn:task id="Task_ProduceRest" name="Produce remaining order" />
    <bpmn:endEvent id="End_Success" name="Order completed" />
    <bpmn:endEvent id="End_Cancel" name="Order cancelled" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent_1" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Gateway_Split" targetRef="Task_OrderSource1" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Gateway_Split" targetRef="Task_OrderSource2" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Task_OrderSource1" targetRef="Gateway_JoinOrders" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Task_OrderSource2" targetRef="Gateway_JoinOrders" />
    <bpmn:sequenceFlow id="flow6" sourceRef="Gateway_JoinOrders" targetRef="Task_InspectParts" />
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_InspectParts" targetRef="Task_AssembleParts" />
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_AssembleParts" targetRef="Task_SendUpdates" />
    <bpmn:sequenceFlow id="flow9" sourceRef="Task_SendUpdates" targetRef="Task_ProduceFirstSaw" />
    <bpmn:sequenceFlow id="flow10" sourceRef="Task_ProduceFirstSaw" targetRef="Task_SendFirstSaw" />
    <bpmn:sequenceFlow id="flow11" sourceRef="Task_SendFirstSaw" targetRef="Gateway_CustomerFeedback" />
    <bpmn:sequenceFlow id="flow12" sourceRef="Gateway_CustomerFeedback" targetRef="Task_ProduceRest" name="yes" />
    <bpmn:sequenceFlow id="flow13" sourceRef="Task_ProduceRest" targetRef="End_Success" />
    <bpmn:sequenceFlow id="flow14" sourceRef="Gateway_CustomerFeedback" targetRef="End_Cancel" name="no" />
  </bpmn:process>
</bpmn:definitions>