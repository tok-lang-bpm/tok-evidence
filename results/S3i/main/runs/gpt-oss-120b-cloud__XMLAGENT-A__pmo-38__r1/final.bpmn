<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_You" name="You">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_J1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Architect" name="Architect">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_OnlineStores" name="Online Stores">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Friends" name="Friends">
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="S1" name="Start" />
    <bpmn:task id="T1" name="Collect requirements" />
    <bpmn:task id="T2" name="Send requirements to architect" />
    <bpmn:task id="T3" name="Send draft to you" />
    <bpmn:task id="T4" name="Refine draft with additional requirements" />
    <bpmn:task id="T5" name="Create list of needed materials" />
    <bpmn:task id="T6" name="Order materials from online stores" />
    <bpmn:parallelGateway id="G_F1" name="Parallel Split" />
    <bpmn:task id="T7" name="Process order" />
    <bpmn:task id="T8" name="Send messages to friends to build house" />
    <bpmn:parallelGateway id="G_J1" name="Parallel Join" />
    <bpmn:task id="T9" name="Build house" />
    <bpmn:task id="T10" name="Send invitations for tree house party" />
    <bpmn:task id="T11" name="Create attendance list for snacks" />
    <bpmn:endEvent id="E1" name="End" />

    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="G_F1" />
    <bpmn:sequenceFlow id="F8" sourceRef="G_F1" targetRef="T7" />
    <bpmn:sequenceFlow id="F9" sourceRef="G_F1" targetRef="T8" />
    <bpmn:sequenceFlow id="F10" sourceRef="T7" targetRef="G_J1" />
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="G_J1" />
    <bpmn:sequenceFlow id="F12" sourceRef="G_J1" targetRef="T9" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F14" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F15" sourceRef="T11" targetRef="E1" />
  </bpmn:process>
</bpmn:definitions>
