<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_org" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="lane_user" name="User">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_tool" name="Tool">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="0. Start" />
    <bpmn:task id="Task_1" name="1. Enter smartphone model and broken part" />
    <bpmn:task id="Task_2" name="2. Provide list of materials, tools, ordering choices" />
    <bpmn:task id="Task_3" name="3. Identify owned items" />
    <bpmn:exclusiveGateway id="Gateway_4" name="4. All needed items available?" />
    <bpmn:task id="Task_5" name="5. Contact friends for borrowing/buying cheap" />
    <bpmn:exclusiveGateway id="Gateway_6" name="6. Friends can provide?" />
    <bpmn:task id="Task_7" name="7. Buy missing items" />
    <bpmn:task id="Task_8" name="8. Provide repair instructions" />
    <bpmn:task id="Task_9" name="9. Fix phone" />
    <bpmn:exclusiveGateway id="Gateway_10" name="10. Repair successful?" />
    <bpmn:task id="Task_11" name="11. Send review and/or video" />
    <bpmn:task id="Task_12" name="12. Send phone to expert" />
    <bpmn:endEvent id="EndEvent_success" name="End - Review sent" />
    <bpmn:endEvent id="EndEvent_expert" name="End - Sent to expert" />

    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Task_3" targetRef="Gateway_4" />
    <bpmn:sequenceFlow id="flow5_yes" name="yes" sourceRef="Gateway_4" targetRef="Task_8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">allAvailable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow5_no" name="no" sourceRef="Gateway_4" targetRef="Task_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">needAcquire</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow5_continue" sourceRef="Task_5" targetRef="Gateway_6" />
    <bpmn:sequenceFlow id="flow6_yes" name="yes" sourceRef="Gateway_6" targetRef="Task_8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">friendProvided</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow6_no" name="no" sourceRef="Gateway_6" targetRef="Task_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">friendNotProvided</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="flow9" sourceRef="Task_9" targetRef="Gateway_10" />
    <bpmn:sequenceFlow id="flow10_yes" name="yes" sourceRef="Gateway_10" targetRef="Task_11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">repairSuccess</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow10_no" name="no" sourceRef="Gateway_10" targetRef="Task_12">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">repairFail</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow11_success" sourceRef="Task_11" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="flow12_expert" sourceRef="Task_12" targetRef="EndEvent_expert" />
  </bpmn:process>
</bpmn:definitions>
