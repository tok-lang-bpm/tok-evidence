<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="InspectionProcess" />
  </bpmn:collaboration>
  <bpmn:process id="InspectionProcess" isExecutable="false">
    <bpmn:laneSet id="laneSet_1">
      <bpmn:lane id="lane_Inspector" name="Inspector">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSerial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PressButtons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskAdditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_No</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Yes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_System" name="System">
        <bpmn:flowNodeRef>Task_CollectValues</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start inspection" />
    <bpmn:task id="Task_EnterType" name="Enter machine type" />
    <bpmn:task id="Task_EnterSerial" name="Enter serial number" />
    <bpmn:task id="Task_AskInitial" name="Answer inspection questions" />
    <bpmn:task id="Task_PressButtons" name="Press inspection buttons" />
    <bpmn:task id="Task_CollectValues" name="Collect values from machine" />
    <bpmn:exclusiveGateway id="Gateway_Additional" name="Additional questions needed?" />
    <bpmn:task id="Task_AskAdditional" name="Answer additional questions" />
    <bpmn:endEvent id="End_No" name="Inspection finished" />
    <bpmn:endEvent id="End_Yes" name="Inspection finished" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_EnterType" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_EnterType" targetRef="Task_EnterSerial" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_EnterSerial" targetRef="Task_AskInitial" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AskInitial" targetRef="Task_PressButtons" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_PressButtons" targetRef="Task_CollectValues" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CollectValues" targetRef="Gateway_Additional" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Additional" targetRef="Task_AskAdditional" name="yes" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Additional" targetRef="End_No" name="no" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AskAdditional" targetRef="End_Yes" />
  </bpmn:process>
</bpmn:definitions>
