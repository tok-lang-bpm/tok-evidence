<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="CustomerPool" name="Customer" />
    <bpmn:participant id="ServiceOrgPool" name="Service Organisation" processRef="ServiceProcess" />
  </bpmn:collaboration>
  <bpmn:process id="ServiceProcess" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_describeSymptoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_sendInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_confirmOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_rateFacility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Central" name="Central Service Center">
        <bpmn:flowNodeRef>Task_selectFacility</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Facility" name="Service Facility">
        <bpmn:flowNodeRef>Task_makeAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_partsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_repairFridge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_leaveWithoutRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_aborted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start" />
    <bpmn:task id="Task_describeSymptoms" name="Describe symptoms" />
    <bpmn:task id="Task_sendInfo" name="Send symptoms and fridge type" />
    <bpmn:task id="Task_selectFacility" name="Select local service facility" />
    <bpmn:task id="Task_makeAppointment" name="Make appointment" />
    <bpmn:exclusiveGateway id="Gateway_partsAvailable" name="Parts available?" />
    <bpmn:task id="Task_repairFridge" name="Repair fridge" />
    <bpmn:task id="Task_leaveWithoutRepair" name="Leave without repair (need parts)" />
    <bpmn:task id="Task_confirmOK" name="Confirm fridge is OK" />
    <bpmn:task id="Task_rateFacility" name="Rate service facility" />
    <bpmn:endEvent id="End_success" name="Process completed" />
    <bpmn:endEvent id="End_aborted" name="Visit aborted" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_describeSymptoms" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_describeSymptoms" targetRef="Task_sendInfo" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_sendInfo" targetRef="Task_selectFacility" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_selectFacility" targetRef="Task_makeAppointment" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_makeAppointment" targetRef="Gateway_partsAvailable" />
    <bpmn:sequenceFlow id="F6_yes" name="yes" sourceRef="Gateway_partsAvailable" targetRef="Task_repairFridge" />
    <bpmn:sequenceFlow id="F7_no" name="no" sourceRef="Gateway_partsAvailable" targetRef="Task_leaveWithoutRepair" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_repairFridge" targetRef="Task_confirmOK" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_confirmOK" targetRef="Task_rateFacility" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_rateFacility" targetRef="End_success" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_leaveWithoutRepair" targetRef="End_aborted" />
  </bpmn:process>
</bpmn:definitions>