<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="RobotSellerPool"
                      name="Robotic Burger Seller"
                      processRef="RobotSellerProcess" />
  </bpmn:collaboration>

  <bpmn:process id="RobotSellerProcess"
                isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_Robot">
      <bpmn:lane id="Lane_Robot" name="Robot">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecideMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SideChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="Start_1" name="Order received" />

    <bpmn:exclusiveGateway id="Gateway_DecideMenu"
                            name="Menu or just burger?" />

    <!-- Menu path -->
    <bpmn:parallelGateway id="ParallelSplit_1" name="Menu parallel start" />
    <bpmn:task id="Task_PrepareDrink" name="Prepare drink" />
    <bpmn:task id="Task_AskSide" name="Ask fries or wedges" />
    <bpmn:exclusiveGateway id="Gateway_SideChoice"
                            name="Fries or wedges?" />
    <bpmn:task id="Task_PrepareFries" name="Prepare fries" />
    <bpmn:task id="Task_PrepareWedges" name="Prepare wedges" />
    <bpmn:parallelGateway id="ParallelJoin_1" name="Menu parallel join" />

    <!-- Common path -->
    <bpmn:task id="Task_PrepareBurger" name="Prepare burger" />
    <bpmn:task id="Task_DeliverOrder" name="Deliver order (conveyor belt)" />
    <bpmn:endEvent id="End_1" name="Order delivered" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_DecideMenu"
                       sourceRef="Start_1"
                       targetRef="Gateway_DecideMenu" />

    <bpmn:sequenceFlow id="Flow_DecideMenu_To_Menu"
                       name="Menu"
                       sourceRef="Gateway_DecideMenu"
                       targetRef="ParallelSplit_1" />

    <bpmn:sequenceFlow id="Flow_DecideMenu_To_BurgerOnly"
                       name="Burger only"
                       sourceRef="Gateway_DecideMenu"
                       targetRef="Task_PrepareBurger" />

    <bpmn:sequenceFlow id="Flow_Split_To_Drink"
                       sourceRef="ParallelSplit_1"
                       targetRef="Task_PrepareDrink" />

    <bpmn:sequenceFlow id="Flow_Split_To_AskSide"
                       sourceRef="ParallelSplit_1"
                       targetRef="Task_AskSide" />

    <bpmn:sequenceFlow id="Flow_AskSide_To_SideChoice"
                       sourceRef="Task_AskSide"
                       targetRef="Gateway_SideChoice" />

    <bpmn:sequenceFlow id="Flow_SideChoice_To_Fries"
                       name="Fries"
                       sourceRef="Gateway_SideChoice"
                       targetRef="Task_PrepareFries" />

    <bpmn:sequenceFlow id="Flow_SideChoice_To_Wedges"
                       name="Wedges"
                       sourceRef="Gateway_SideChoice"
                       targetRef="Task_PrepareWedges" />

    <bpmn:sequenceFlow id="Flow_Drink_To_Join"
                       sourceRef="Task_PrepareDrink"
                       targetRef="ParallelJoin_1" />

    <bpmn:sequenceFlow id="Flow_Fries_To_Join"
                       sourceRef="Task_PrepareFries"
                       targetRef="ParallelJoin_1" />

    <bpmn:sequenceFlow id="Flow_Wedges_To_Join"
                       sourceRef="Task_PrepareWedges"
                       targetRef="ParallelJoin_1" />

    <bpmn:sequenceFlow id="Flow_Join_To_Burger"
                       sourceRef="ParallelJoin_1"
                       targetRef="Task_PrepareBurger" />

    <bpmn:sequenceFlow id="Flow_Burger_To_Deliver"
                       sourceRef="Task_PrepareBurger"
                       targetRef="Task_DeliverOrder" />

    <bpmn:sequenceFlow id="Flow_Deliver_To_End"
                       sourceRef="Task_DeliverOrder"
                       targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
