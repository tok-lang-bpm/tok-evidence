<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LANESET_1">
      <bpmn:lane id="LANE_Doctor" name="Doctor">
        <bpmn:flowNodeRef>start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prepare_impl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_wash_hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_get_sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clean_puncture_area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drape_puncture_zone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_configure_ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_put_gel_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cover_probe_and_put_sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_position_probe_and_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ident_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ident_anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ident_doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ident_compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ident_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_anesthetize_and_puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drop_probe_and_remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_install_guidewire_and_remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_check_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_wire_long_axis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_wire_short_axis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_check_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_widen_pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_advance_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_verify_flow_and_reflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check_catheter_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Patient" name="Patient" />
    </bpmn:laneSet>

    <bpmn:startEvent id="start_1" name="Start" />
    <bpmn:task id="t_prepare_impl" name="Prepare implements" />
    <bpmn:task id="t_wash_hands" name="Wash hands" />
    <bpmn:task id="t_get_sterile_clothes" name="Get sterile clothes" />
    <bpmn:task id="t_clean_puncture_area" name="Clean puncture area" />
    <bpmn:task id="t_drape_puncture_zone" name="Drape puncture zone" />
    <bpmn:task id="t_configure_ultrasound" name="Configure ultrasound" />
    <bpmn:task id="t_put_gel_probe" name="Put gel in probe" />
    <bpmn:task id="t_cover_probe_and_put_sterile_gel" name="Cover probe and put sterile gel" />
    <bpmn:task id="t_position_probe_and_patient" name="Position probe and patient" />
    <bpmn:exclusiveGateway id="gw_ident_split" name="Which vein identification method?" />
    <bpmn:task id="t_ident_anatomic" name="Identify vein using anatomic identification" />
    <bpmn:task id="t_ident_doppler" name="Identify vein using doppler identification" />
    <bpmn:task id="t_ident_compression" name="Identify vein using compression identification" />
    <bpmn:exclusiveGateway id="gw_ident_merge" name="Vein identified" />
    <bpmn:task id="t_anesthetize_and_puncture" name="Anesthetize patient and puncture" />
    <bpmn:task id="t_check_blood_return" name="Check blood return" />
    <bpmn:exclusiveGateway id="gw_blood_return" name="Blood return correct?" />
    <bpmn:task id="t_drop_probe_and_remove_syringe" name="Drop probe and remove syringe" />
    <bpmn:task id="t_install_guidewire_and_remove_trocar" name="Install guidewire and remove trocar" />
    <bpmn:exclusiveGateway id="gw_wire_check_split" name="Which wire check method?" />
    <bpmn:task id="t_check_wire_long_axis" name="Check wire in long axis" />
    <bpmn:task id="t_check_wire_short_axis" name="Check wire in short axis" />
    <bpmn:exclusiveGateway id="gw_wire_check_merge" name="Wire checked" />
    <bpmn:exclusiveGateway id="gw_wire_position" name="Wire in good position?" />
    <bpmn:task id="t_widen_pathway" name="Widen pathway" />
    <bpmn:task id="t_advance_catheter" name="Advance catheter" />
    <bpmn:task id="t_remove_guidewire" name="Remove guidewire" />
    <bpmn:task id="t_verify_flow_and_reflow" name="Verify flow and reflow" />
    <bpmn:task id="t_check_catheter_position" name="Check catheter position" />
    <bpmn:endEvent id="end_1" name="End" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start_1" targetRef="t_prepare_impl" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_prepare_impl" targetRef="t_wash_hands" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_wash_hands" targetRef="t_get_sterile_clothes" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_get_sterile_clothes" targetRef="t_clean_puncture_area" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_clean_puncture_area" targetRef="t_drape_puncture_zone" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_drape_puncture_zone" targetRef="t_configure_ultrasound" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_configure_ultrasound" targetRef="t_put_gel_probe" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_put_gel_probe" targetRef="t_cover_probe_and_put_sterile_gel" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_cover_probe_and_put_sterile_gel" targetRef="t_position_probe_and_patient" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_position_probe_and_patient" targetRef="gw_ident_split" />
    <bpmn:sequenceFlow id="f11" sourceRef="gw_ident_split" targetRef="t_ident_anatomic" name="anatomic" />
    <bpmn:sequenceFlow id="f12" sourceRef="gw_ident_split" targetRef="t_ident_doppler" name="doppler" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_ident_split" targetRef="t_ident_compression" name="compression" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_ident_anatomic" targetRef="gw_ident_merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_ident_doppler" targetRef="gw_ident_merge" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_ident_compression" targetRef="gw_ident_merge" />
    <bpmn:sequenceFlow id="f17" sourceRef="gw_ident_merge" targetRef="t_anesthetize_and_puncture" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_anesthetize_and_puncture" targetRef="t_check_blood_return" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_check_blood_return" targetRef="gw_blood_return" />
    <bpmn:sequenceFlow id="f20" sourceRef="gw_blood_return" targetRef="t_anesthetize_and_puncture" name="blood not correct" />
    <bpmn:sequenceFlow id="f21" sourceRef="gw_blood_return" targetRef="t_drop_probe_and_remove_syringe" name="blood correct" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_drop_probe_and_remove_syringe" targetRef="t_install_guidewire_and_remove_trocar" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_install_guidewire_and_remove_trocar" targetRef="gw_wire_check_split" />
    <bpmn:sequenceFlow id="f24" sourceRef="gw_wire_check_split" targetRef="t_check_wire_long_axis" name="long axis" />
    <bpmn:sequenceFlow id="f25" sourceRef="gw_wire_check_split" targetRef="t_check_wire_short_axis" name="short axis" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_check_wire_long_axis" targetRef="gw_wire_check_merge" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_check_wire_short_axis" targetRef="gw_wire_check_merge" />
    <bpmn:sequenceFlow id="f28" sourceRef="gw_wire_check_merge" targetRef="gw_wire_position" />
    <bpmn:sequenceFlow id="f29" sourceRef="gw_wire_position" targetRef="t_anesthetize_and_puncture" name="wire not good" />
    <bpmn:sequenceFlow id="f30" sourceRef="gw_wire_position" targetRef="t_widen_pathway" name="wire good" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_widen_pathway" targetRef="t_advance_catheter" />
    <bpmn:sequenceFlow id="f32" sourceRef="t_advance_catheter" targetRef="t_remove_guidewire" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_remove_guidewire" targetRef="t_verify_flow_and_reflow" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_verify_flow_and_reflow" targetRef="t_check_catheter_position" />
    <bpmn:sequenceFlow id="f35" sourceRef="t_check_catheter_position" targetRef="end_1" />
  </bpmn:process>
</bpmn:definitions>
