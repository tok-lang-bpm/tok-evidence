<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_quote_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales" name="Sales/Support">
        <bpmn:flowNodeRef>collectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guideSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_quote_approval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>recordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer inquiry" />
    <bpmn:task id="collectInfo" name="Collect information and address concerns or questions" />
    <bpmn:exclusiveGateway id="decision_interest" name="Customer interested?" />
    <bpmn:task id="guideSelection" name="Guide selection of appropriate product or service" />
    <bpmn:task id="provideQuote" name="Provide quote" />
    <bpmn:exclusiveGateway id="decision_quote_approval" name="Quote approved?" />
    <bpmn:task id="recordOrder" name="Record order" />
    <bpmn:task id="sendConfirmation" name="Send order confirmation to customer" />
    <bpmn:endEvent id="end_success" name="Order placed and confirmed" />
    <bpmn:endEvent id="end_not_interested" name="Process ended - not interested" />
    <bpmn:endEvent id="end_quote_rejected" name="Process ended - quote not approved" />
    <bpmn:sequenceFlow id="sf1" sourceRef="start" targetRef="collectInfo" />
    <bpmn:sequenceFlow id="sf2" sourceRef="collectInfo" targetRef="decision_interest" />
    <bpmn:sequenceFlow id="sf3_yes" name="yes" sourceRef="decision_interest" targetRef="guideSelection" />
    <bpmn:sequenceFlow id="sf3_no" name="no" sourceRef="decision_interest" targetRef="end_not_interested" />
    <bpmn:sequenceFlow id="sf4" sourceRef="guideSelection" targetRef="provideQuote" />
    <bpmn:sequenceFlow id="sf5" sourceRef="provideQuote" targetRef="decision_quote_approval" />
    <bpmn:sequenceFlow id="sf6_yes" name="yes" sourceRef="decision_quote_approval" targetRef="recordOrder" />
    <bpmn:sequenceFlow id="sf6_no" name="no" sourceRef="decision_quote_approval" targetRef="end_quote_rejected" />
    <bpmn:sequenceFlow id="sf7" sourceRef="recordOrder" targetRef="sendConfirmation" />
    <bpmn:sequenceFlow id="sf8" sourceRef="sendConfirmation" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>