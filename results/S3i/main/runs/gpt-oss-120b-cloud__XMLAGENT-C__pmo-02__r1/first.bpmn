<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneDept" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneHR" name="HR">
        <bpmn:flowNodeRef>createJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phoneInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwInterviewType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwInterviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwCandidateChosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNegotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salaryNegotiations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNegotiationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwOfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwOnboardSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwOnboardJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newHireIntegrated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need identified" />
    <bpmn:task id="identifyNeed" name="Identify need for new hire" />
    <bpmn:task id="createJob" name="Create job description and post on job boards" />
    <bpmn:task id="collectResumes" name="Collect and screen resumes" />
    <bpmn:task id="phoneInterviews" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="gwInterviewType" name="Interview preference" />
    <bpmn:task id="inPersonInterview" name="Conduct in-person interview" />
    <bpmn:task id="virtualInterview" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="gwInterviewMerge" name="Merge interview type" />
    <bpmn:exclusiveGateway id="gwCandidateChosen" name="Candidate chosen?" />
    <bpmn:task id="extendOffer" name="Extend offer" />
    <bpmn:exclusiveGateway id="gwNegotiation" name="Negotiation needed?" />
    <bpmn:task id="salaryNegotiations" name="Conduct salary negotiations" />
    <bpmn:exclusiveGateway id="gwNegotiationMerge" name="Merge negotiation" />
    <bpmn:exclusiveGateway id="gwOfferAccepted" name="Offer accepted?" />
    <bpmn:parallelGateway id="gwOnboardSplit" name="Onboarding parallel start" />
    <bpmn:task id="paperwork" name="Complete paperwork" />
    <bpmn:task id="orientation" name="Orientation" />
    <bpmn:task id="training" name="Training" />
    <bpmn:parallelGateway id="gwOnboardJoin" name="Onboarding parallel end" />
    <bpmn:endEvent id="newHireIntegrated" name="New hire fully integrated" />
    <bpmn:endEvent id="rejected" name="Offer rejected" />
    <bpmn:endEvent id="terminated" name="Hiring process terminated" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identifyNeed" />
    <bpmn:sequenceFlow id="f2" sourceRef="identifyNeed" targetRef="createJob" />
    <bpmn:sequenceFlow id="f3" sourceRef="createJob" targetRef="collectResumes" />
    <bpmn:sequenceFlow id="f4" sourceRef="collectResumes" targetRef="phoneInterviews" />
    <bpmn:sequenceFlow id="f5" sourceRef="phoneInterviews" targetRef="gwInterviewType" />
    <bpmn:sequenceFlow id="f6" name="in-person" sourceRef="gwInterviewType" targetRef="inPersonInterview" />
    <bpmn:sequenceFlow id="f7" name="virtual" sourceRef="gwInterviewType" targetRef="virtualInterview" />
    <bpmn:sequenceFlow id="f8" sourceRef="inPersonInterview" targetRef="gwInterviewMerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="virtualInterview" targetRef="gwInterviewMerge" />
    <bpmn:sequenceFlow id="f10" sourceRef="gwInterviewMerge" targetRef="gwCandidateChosen" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gwCandidateChosen" targetRef="extendOffer" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gwCandidateChosen" targetRef="terminated" />
    <bpmn:sequenceFlow id="f13" sourceRef="extendOffer" targetRef="gwNegotiation" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="gwNegotiation" targetRef="salaryNegotiations" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="gwNegotiation" targetRef="gwNegotiationMerge" />
    <bpmn:sequenceFlow id="f16" sourceRef="salaryNegotiations" targetRef="gwNegotiationMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="gwNegotiationMerge" targetRef="gwOfferAccepted" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="gwOfferAccepted" targetRef="gwOnboardSplit" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="gwOfferAccepted" targetRef="rejected" />
    <bpmn:sequenceFlow id="f20" sourceRef="gwOnboardSplit" targetRef="paperwork" />
    <bpmn:sequenceFlow id="f21" sourceRef="gwOnboardSplit" targetRef="orientation" />
    <bpmn:sequenceFlow id="f22" sourceRef="gwOnboardSplit" targetRef="training" />
    <bpmn:sequenceFlow id="f23" sourceRef="paperwork" targetRef="gwOnboardJoin" />
    <bpmn:sequenceFlow id="f24" sourceRef="orientation" targetRef="gwOnboardJoin" />
    <bpmn:sequenceFlow id="f25" sourceRef="training" targetRef="gwOnboardJoin" />
    <bpmn:sequenceFlow id="f26" sourceRef="gwOnboardJoin" targetRef="newHireIntegrated" />
  </bpmn:process>
</bpmn:definitions>