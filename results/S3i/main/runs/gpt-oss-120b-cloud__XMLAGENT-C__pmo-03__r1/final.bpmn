<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwThreshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeShelves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitorContinue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Procurement" name="Procurement Team">
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_InventorySystem" name="Inventory System">
        <bpmn:flowNodeRef>updateSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start monitoring" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="gwThreshold" name="Stock reaches threshold?" />
    <bpmn:task id="signal" name="Signal need to reorder" />
    <bpmn:task id="placeOrder" name="Place order with supplier" />
    <bpmn:task id="updateSystem" name="Update inventory system with expected delivery dates" />
    <bpmn:task id="receiveStock" name="Receive stock" />
    <bpmn:task id="inspect" name="Inspect stock for quality" />
    <bpmn:task id="record" name="Record stock in system" />
    <bpmn:task id="placeShelves" name="Place stock on shelves" />
    <bpmn:endEvent id="end" name="Restock complete" />
    <bpmn:endEvent id="monitorContinue" name="Monitoring continues" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="monitor" />
    <bpmn:sequenceFlow id="f2" sourceRef="monitor" targetRef="gwThreshold" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gwThreshold" targetRef="signal" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gwThreshold" targetRef="monitorContinue" />
    <bpmn:sequenceFlow id="f5" sourceRef="signal" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="f6" sourceRef="placeOrder" targetRef="updateSystem" />
    <bpmn:sequenceFlow id="f7" sourceRef="updateSystem" targetRef="receiveStock" />
    <bpmn:sequenceFlow id="f8" sourceRef="receiveStock" targetRef="inspect" />
    <bpmn:sequenceFlow id="f9" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f10" sourceRef="record" targetRef="placeShelves" />
    <bpmn:sequenceFlow id="f11" sourceRef="placeShelves" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
