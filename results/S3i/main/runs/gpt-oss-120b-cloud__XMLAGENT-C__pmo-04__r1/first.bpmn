<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>defineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>designVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzePerformance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CRM" name="CRM System">
        <bpmn:flowNodeRef>collectLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Sales" name="Sales Team">
        <bpmn:flowNodeRef>followUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process starts" />
    <bpmn:task id="defineObjectives" name="Define objectives of marketing campaign" />
    <bpmn:parallelGateway id="splitParallel" />
    <bpmn:task id="createContent" name="Create content" />
    <bpmn:task id="designVisuals" name="Design visuals" />
    <bpmn:task id="selectChannels" name="Select promotion channels" />
    <bpmn:parallelGateway id="joinParallel" />
    <bpmn:task id="launchCampaign" name="Launch campaign" />
    <bpmn:task id="trackPerformance" name="Track performance in real-time" />
    <bpmn:task id="collectLeads" name="Collect leads in CRM system" />
    <bpmn:task id="followUpLeads" name="Follow up leads" />
    <bpmn:task id="analyzePerformance" name="Analyze performance for future optimization" />
    <bpmn:endEvent id="end" name="Process ends" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="defineObjectives" />
    <bpmn:sequenceFlow id="f2" sourceRef="defineObjectives" targetRef="splitParallel" />
    <bpmn:sequenceFlow id="f3" sourceRef="splitParallel" targetRef="createContent" />
    <bpmn:sequenceFlow id="f4" sourceRef="splitParallel" targetRef="designVisuals" />
    <bpmn:sequenceFlow id="f5" sourceRef="splitParallel" targetRef="selectChannels" />
    <bpmn:sequenceFlow id="f6" sourceRef="createContent" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f7" sourceRef="designVisuals" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f8" sourceRef="selectChannels" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="f9" sourceRef="joinParallel" targetRef="launchCampaign" />
    <bpmn:sequenceFlow id="f10" sourceRef="launchCampaign" targetRef="trackPerformance" />
    <bpmn:sequenceFlow id="f11" sourceRef="trackPerformance" targetRef="collectLeads" />
    <bpmn:sequenceFlow id="f12" sourceRef="collectLeads" targetRef="followUpLeads" />
    <bpmn:sequenceFlow id="f13" sourceRef="followUpLeads" targetRef="analyzePerformance" />
    <bpmn:sequenceFlow id="f14" sourceRef="analyzePerformance" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>