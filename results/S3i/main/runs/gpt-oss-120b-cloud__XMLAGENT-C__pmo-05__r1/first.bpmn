<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_PROC" name="Procurement Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need identified" />
    <bpmn:task id="t1" name="Identify need for new supplier or vendor" />
    <bpmn:task id="t2" name="Issue request for proposals (RFP)" />
    <bpmn:task id="t3" name="Receive proposals from suppliers" />
    <bpmn:parallelGateway id="pg1" />
    <bpmn:task id="t4" name="Evaluate proposals based on criteria" />
    <bpmn:task id="t5" name="Conduct site visits or interviews with suppliers" />
    <bpmn:parallelGateway id="pg2" />
    <bpmn:exclusiveGateway id="eg1" name="Supplier selected?" />
    <bpmn:task id="t6" name="Select supplier" />
    <bpmn:endEvent id="end_no" name="Process ended without supplier" />
    <bpmn:task id="t7" name="Begin contract negotiations" />
    <bpmn:exclusiveGateway id="eg2" name="Agreement reached?" />
    <bpmn:task id="t8" name="Sign contract" />
    <bpmn:task id="t9" name="Onboard supplier and execute contract" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="pg1" />
    <bpmn:sequenceFlow id="f5" sourceRef="pg1" targetRef="t4" />
    <bpmn:sequenceFlow id="f6" sourceRef="pg1" targetRef="t5" />
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="pg2" />
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="pg2" />
    <bpmn:sequenceFlow id="f9" sourceRef="pg2" targetRef="eg1" />
    <bpmn:sequenceFlow id="f10" sourceRef="eg1" targetRef="t6" name="yes" />
    <bpmn:sequenceFlow id="f11" sourceRef="eg1" targetRef="end_no" name="no" />
    <bpmn:sequenceFlow id="f12" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f13" sourceRef="t7" targetRef="eg2" />
    <bpmn:sequenceFlow id="f14" sourceRef="eg2" targetRef="t8" name="yes" />
    <bpmn:sequenceFlow id="f15" sourceRef="eg2" targetRef="t7" name="no" />
    <bpmn:sequenceFlow id="f16" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f17" sourceRef="t9" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>