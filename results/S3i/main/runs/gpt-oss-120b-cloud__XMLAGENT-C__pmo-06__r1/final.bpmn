<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehouse" name="Warehouse Team">
        <bpmn:flowNodeRef>pickPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>genLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handOver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_logistics" name="Logistics Provider">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer places order (online or phone)" />
    <bpmn:task id="confirm" name="Generate and send order confirmation" />
    <bpmn:task id="pickPack" name="Pick and pack items" />
    <bpmn:task id="genLabel" name="Generate shipping label" />
    <bpmn:task id="handOver" name="Hand over order to logistics provider" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="sendTracking" name="Send tracking information to customer" />
    <bpmn:task id="monitor" name="Monitor shipment" />
    <bpmn:task id="deliver" name="Deliver shipment" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="confirm" />
    <bpmn:sequenceFlow id="f2" sourceRef="confirm" targetRef="pickPack" />
    <bpmn:sequenceFlow id="f3" sourceRef="pickPack" targetRef="genLabel" />
    <bpmn:sequenceFlow id="f4" sourceRef="genLabel" targetRef="handOver" />
    <bpmn:sequenceFlow id="f5" sourceRef="handOver" targetRef="fork" />
    <bpmn:sequenceFlow id="f6" sourceRef="fork" targetRef="sendTracking" />
    <bpmn:sequenceFlow id="f7" sourceRef="fork" targetRef="deliver" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendTracking" targetRef="monitor" />
    <bpmn:sequenceFlow id="f9" sourceRef="monitor" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="deliver" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
