<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_with_feedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="Booking System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_merge_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminder_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_reminder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COMPANY" name="Travel Company">
        <bpmn:flowNodeRef>update_inventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process Start" />
    <bpmn:task id="search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="select" name="Select preferred route, date, and time" />
    <bpmn:task id="provide" name="Provide personal information and payment details" />
    <bpmn:task id="generate" name="Generate ticket" />
    <bpmn:exclusiveGateway id="gateway_send" name="Send ticket via" />
    <bpmn:task id="send_email" name="Send ticket via email" />
    <bpmn:task id="send_sms" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="gateway_merge_send" />
    <bpmn:task id="update_inventory" name="Update seat inventory" />
    <bpmn:exclusiveGateway id="reminder_gateway" name="Send reminders?" />
    <bpmn:task id="send_reminder" name="Send reminders and instructions" />
    <bpmn:task id="journey" name="Customer completes journey" />
    <bpmn:exclusiveGateway id="feedback_gateway" name="Provide feedback?" />
    <bpmn:task id="feedback" name="Provide post-travel feedback" />
    <bpmn:endEvent id="end_no_feedback" name="Process End (no feedback)" />
    <bpmn:endEvent id="end_with_feedback" name="Process End (with feedback)" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="search" />
    <bpmn:sequenceFlow id="f2" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f3" sourceRef="select" targetRef="provide" />
    <bpmn:sequenceFlow id="f4" sourceRef="provide" targetRef="generate" />
    <bpmn:sequenceFlow id="f5" sourceRef="generate" targetRef="gateway_send" />
    <bpmn:sequenceFlow id="f6" name="email" sourceRef="gateway_send" targetRef="send_email" />
    <bpmn:sequenceFlow id="f7" name="sms" sourceRef="gateway_send" targetRef="send_sms" />
    <bpmn:sequenceFlow id="f8" sourceRef="send_email" targetRef="gateway_merge_send" />
    <bpmn:sequenceFlow id="f9" sourceRef="send_sms" targetRef="gateway_merge_send" />
    <bpmn:sequenceFlow id="f10" sourceRef="gateway_merge_send" targetRef="update_inventory" />
    <bpmn:sequenceFlow id="f11" sourceRef="update_inventory" targetRef="reminder_gateway" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="reminder_gateway" targetRef="send_reminder" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="reminder_gateway" targetRef="journey" />
    <bpmn:sequenceFlow id="f14" sourceRef="send_reminder" targetRef="journey" />
    <bpmn:sequenceFlow id="f15" sourceRef="journey" targetRef="feedback_gateway" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="feedback_gateway" targetRef="feedback" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="feedback_gateway" targetRef="end_no_feedback" />
    <bpmn:sequenceFlow id="f18" sourceRef="feedback" targetRef="end_with_feedback" />
  </bpmn:process>
</bpmn:definitions>