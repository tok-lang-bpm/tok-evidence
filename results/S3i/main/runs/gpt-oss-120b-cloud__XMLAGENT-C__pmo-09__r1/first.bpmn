<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_RnD" name="R&D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identifyIdea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conductResearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draftDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buildPrototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testPrototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refinePrototype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayRefine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discardedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="identifyIdea" name="Identify idea for new product or improvement" />
    <bpmn:task id="conductResearch" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draftDesign" name="Draft design concepts" />
    <bpmn:task id="selectDesign" name="Select promising design" />
    <bpmn:task id="buildPrototype" name="Build prototype using available materials and resources" />
    <bpmn:task id="testPrototype" name="Test prototype for functionality, safety and market potential" />
    <bpmn:task id="collectFeedback" name="Collect feedback from testing phase" />
    <bpmn:exclusiveGateway id="gatewayRefine" name="Refinement needed?" />
    <bpmn:task id="refinePrototype" name="Refine prototype" />
    <bpmn:exclusiveGateway id="gatewayApproval" name="Prototype approved?" />
    <bpmn:endEvent id="approvedEnd" name="Prototype approved for further development" />
    <bpmn:endEvent id="discardedEnd" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identifyIdea" />
    <bpmn:sequenceFlow id="f2" sourceRef="identifyIdea" targetRef="conductResearch" />
    <bpmn:sequenceFlow id="f3" sourceRef="conductResearch" targetRef="draftDesign" />
    <bpmn:sequenceFlow id="f4" sourceRef="draftDesign" targetRef="selectDesign" />
    <bpmn:sequenceFlow id="f5" sourceRef="selectDesign" targetRef="buildPrototype" />
    <bpmn:sequenceFlow id="f6" sourceRef="buildPrototype" targetRef="testPrototype" />
    <bpmn:sequenceFlow id="f7" sourceRef="testPrototype" targetRef="collectFeedback" />
    <bpmn:sequenceFlow id="f8" sourceRef="collectFeedback" targetRef="gatewayRefine" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gatewayRefine" targetRef="refinePrototype" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gatewayRefine" targetRef="gatewayApproval" />
    <bpmn:sequenceFlow id="f11" sourceRef="refinePrototype" targetRef="testPrototype" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="gatewayApproval" targetRef="approvedEnd" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="gatewayApproval" targetRef="discardedEnd" />
  </bpmn:process>
</bpmn:definitions>