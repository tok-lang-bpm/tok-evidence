<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_REQUESTER" name="Requester">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_IT" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Request submitted" />
    <bpmn:task id="submit" name="Submit request for an IT solution" />
    <bpmn:task id="assess" name="Assess request for compatibility, cost and resources" />
    <bpmn:exclusiveGateway id="decision" name="Approved?" />
    <bpmn:task id="procure" name="Procure necessary tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in a controlled environment" />
    <bpmn:task id="rollout" name="Roll out the new solution to the requesting department" />
    <bpmn:parallelGateway id="parallelSplit" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:parallelGateway id="parallelJoin" />
    <bpmn:endEvent id="endApproved" name="Process completed" />
    <bpmn:task id="reject" name="Reject request" />
    <bpmn:endEvent id="endReject" name="Request rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f3" sourceRef="assess" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="approved" sourceRef="decision" targetRef="procure" />
    <bpmn:sequenceFlow id="f5" name="rejected" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="endReject" />
    <bpmn:sequenceFlow id="f7" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f8" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f9" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f10" sourceRef="rollout" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="f11" sourceRef="parallelSplit" targetRef="training" />
    <bpmn:sequenceFlow id="f12" sourceRef="parallelSplit" targetRef="support" />
    <bpmn:sequenceFlow id="f13" sourceRef="training" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="support" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="parallelJoin" targetRef="endApproved" />
  </bpmn:process>
</bpmn:definitions>