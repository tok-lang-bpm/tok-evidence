<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endActive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>generateAccount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SUPPORT" name="Support Team">
        <bpmn:flowNodeRef>processCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refundDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>applyCharges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivateAndSettle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDeactivated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Subscription process start" />
    <bpmn:task id="signUp" name="Sign up for subscription service, entering personal and payment information" />
    <bpmn:task id="generateAccount" name="Generate account, assign access, and trigger automated billing cycles" />
    <bpmn:task id="receiveUpdates" name="Receive regular updates, product enhancements, or renewal notifications" />
    <bpmn:exclusiveGateway id="cancelDecision" name="Cancel subscription?" />
    <bpmn:endEvent id="endActive" name="Subscription active" />
    <bpmn:task id="submitCancel" name="Submit cancellation request" />
    <bpmn:task id="processCancel" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="refundDecision" name="Refund applicable?" />
    <bpmn:task id="applyRefund" name="Apply refund" />
    <bpmn:task id="applyCharges" name="Apply charges" />
    <bpmn:exclusiveGateway id="mergeRefund" name="Merge refund/charges" />
    <bpmn:task id="deactivateAndSettle" name="Deactivate subscription and settle final account balance" />
    <bpmn:endEvent id="endDeactivated" name="Subscription deactivated" />
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="signUp" />
    <bpmn:sequenceFlow id="f2" sourceRef="signUp" targetRef="generateAccount" />
    <bpmn:sequenceFlow id="f3" sourceRef="generateAccount" targetRef="receiveUpdates" />
    <bpmn:sequenceFlow id="f4" sourceRef="receiveUpdates" targetRef="cancelDecision" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="cancelDecision" targetRef="endActive" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="cancelDecision" targetRef="submitCancel" />
    <bpmn:sequenceFlow id="f7" sourceRef="submitCancel" targetRef="processCancel" />
    <bpmn:sequenceFlow id="f8" sourceRef="processCancel" targetRef="refundDecision" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="refundDecision" targetRef="applyRefund" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="refundDecision" targetRef="applyCharges" />
    <bpmn:sequenceFlow id="f11" sourceRef="applyRefund" targetRef="mergeRefund" />
    <bpmn:sequenceFlow id="f12" sourceRef="applyCharges" targetRef="mergeRefund" />
    <bpmn:sequenceFlow id="f13" sourceRef="mergeRefund" targetRef="deactivateAndSettle" />
    <bpmn:sequenceFlow id="f14" sourceRef="deactivateAndSettle" targetRef="endDeactivated" />
  </bpmn:process>
</bpmn:definitions>