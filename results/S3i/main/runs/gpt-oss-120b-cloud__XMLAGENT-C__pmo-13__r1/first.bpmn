<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCS" name="Customer Service">
        <bpmn:flowNodeRef>logComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolveComplaint</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneDept" name="Department">
        <bpmn:flowNodeRef>reviewComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayRefund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneFinancial" name="Financial Team">
        <bpmn:flowNodeRef>processRefund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer files complaint" />
    <bpmn:task id="logComplaint" name="Log complaint" />
    <bpmn:task id="assignComplaint" name="Assign complaint to department" />
    <bpmn:task id="reviewComplaint" name="Review complaint and determine decision" />
    <bpmn:task id="notifyCustomer" name="Notify customer of decision" />
    <bpmn:exclusiveGateway id="gatewayRefund" name="Refund approved?" />
    <bpmn:task id="processRefund" name="Process refund" />
    <bpmn:task id="resolveComplaint" name="Mark complaint as resolved" />
    <bpmn:task id="provideFeedback" name="Provide feedback" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="logComplaint" />
    <bpmn:sequenceFlow id="f2" sourceRef="logComplaint" targetRef="assignComplaint" />
    <bpmn:sequenceFlow id="f3" sourceRef="assignComplaint" targetRef="reviewComplaint" />
    <bpmn:sequenceFlow id="f4" sourceRef="reviewComplaint" targetRef="notifyCustomer" />
    <bpmn:sequenceFlow id="f5" sourceRef="notifyCustomer" targetRef="gatewayRefund" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="gatewayRefund" targetRef="processRefund" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="gatewayRefund" targetRef="resolveComplaint" />
    <bpmn:sequenceFlow id="f8" sourceRef="processRefund" targetRef="resolveComplaint" />
    <bpmn:sequenceFlow id="f9" sourceRef="resolveComplaint" targetRef="provideFeedback" />
    <bpmn:sequenceFlow id="f10" sourceRef="provideFeedback" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>