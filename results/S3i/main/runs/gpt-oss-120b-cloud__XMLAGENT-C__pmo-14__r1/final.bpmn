<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_DEPT" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outlineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distributeAndImplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TEAM" name="Team">
        <bpmn:flowNodeRef>draftPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_STRATEGIC" name="Strategic Review">
        <bpmn:flowNodeRef>strategicReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FINANCE" name="Finance Department">
        <bpmn:flowNodeRef>financeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needAdjustment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocateBudget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_STAKEHOLDERS" name="Stakeholders">
        <bpmn:flowNodeRef>documentAdjustments</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start process" />
    <bpmn:task id="outlineObjectives" name="Outline objectives for the upcoming period" />
    <bpmn:task id="draftPlan" name="Draft plan with cost estimates and justifications" />
    <bpmn:task id="strategicReview" name="Review plan in strategic alignment meeting" />
    <bpmn:task id="financeReview" name="Perform detailed finance review" />
    <bpmn:exclusiveGateway id="needAdjustment" name="Adjustments needed?" />
    <bpmn:task id="documentAdjustments" name="Document adjustments and obtain stakeholder approval" />
    <bpmn:task id="allocateBudget" name="Allocate budget to department" />
    <bpmn:task id="distributeAndImplement" name="Distribute budget and begin implementing plan" />
    <bpmn:endEvent id="end" name="End process" />
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="outlineObjectives" />
    <bpmn:sequenceFlow id="flow2" sourceRef="outlineObjectives" targetRef="draftPlan" />
    <bpmn:sequenceFlow id="flow3" sourceRef="draftPlan" targetRef="strategicReview" />
    <bpmn:sequenceFlow id="flow4" sourceRef="strategicReview" targetRef="financeReview" />
    <bpmn:sequenceFlow id="flow5" sourceRef="financeReview" targetRef="needAdjustment" />
    <bpmn:sequenceFlow id="flow6" name="yes" sourceRef="needAdjustment" targetRef="documentAdjustments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">adjustmentsNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow7" name="no" sourceRef="needAdjustment" targetRef="allocateBudget">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!adjustmentsNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow8" sourceRef="documentAdjustments" targetRef="financeReview" />
    <bpmn:sequenceFlow id="flow9" sourceRef="allocateBudget" targetRef="distributeAndImplement" />
    <bpmn:sequenceFlow id="flow10" sourceRef="distributeAndImplement" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
