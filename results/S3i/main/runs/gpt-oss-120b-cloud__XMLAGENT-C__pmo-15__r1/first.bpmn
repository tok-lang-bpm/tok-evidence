<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make_corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no_cert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_internal" name="Internal Teams">
        <bpmn:flowNodeRef>prepare_docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_auditor" name="Auditors">
        <bpmn:flowNodeRef>review_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_audit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="schedule_audit" name="Schedule compliance audit" />
    <bpmn:task id="prepare_docs" name="Prepare documentation, gather evidence, and conduct self-assessment" />
    <bpmn:task id="review_process" name="Review processes and identify gaps or issues" />
    <bpmn:task id="make_corrections" name="Make corrections or improvements" />
    <bpmn:task id="final_audit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="gateway_all_met" name="All criteria met?" />
    <bpmn:task id="award_cert" name="Award certification and issue official documents" />
    <bpmn:endEvent id="end_cert" name="Process completed with certification" />
    <bpmn:endEvent id="end_no_cert" name="Process completed without certification" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="schedule_audit" />
    <bpmn:sequenceFlow id="f2" sourceRef="schedule_audit" targetRef="prepare_docs" />
    <bpmn:sequenceFlow id="f3" sourceRef="prepare_docs" targetRef="review_process" />
    <bpmn:sequenceFlow id="f4" sourceRef="review_process" targetRef="make_corrections" />
    <bpmn:sequenceFlow id="f5" sourceRef="make_corrections" targetRef="final_audit" />
    <bpmn:sequenceFlow id="f6" sourceRef="final_audit" targetRef="gateway_all_met" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gateway_all_met" targetRef="award_cert" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gateway_all_met" targetRef="end_no_cert" />
    <bpmn:sequenceFlow id="f9" sourceRef="award_cert" targetRef="end_cert" />
  </bpmn:process>
</bpmn:definitions>