<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archiveReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneRegional" name="Regional Office">
        <bpmn:flowNodeRef>prepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideClarif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCompliance" name="Compliance Team">
        <bpmn:flowNodeRef>checkUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCentral" name="Central Audit Team">
        <bpmn:flowNodeRef>reviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestClarif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conductRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalFinancial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalOperational</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launchInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>siteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmitReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneDirector" name="Audit Director">
        <bpmn:flowNodeRef>reviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRevisions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start1" name="Start audit process" />
    <bpmn:task id="sendNotification" name="Send notification to regional office" />
    <bpmn:parallelGateway id="pg1" />
    <bpmn:task id="prepareDocs" name="Prepare financial statements and gather necessary documents" />
    <bpmn:task id="checkUpdates" name="Check for regulatory updates" />
    <bpmn:parallelGateway id="pg2" />
    <bpmn:task id="submitDocs" name="Submit documents to central audit team" />
    <bpmn:task id="reviewSubmission" name="Review submission" />
    <bpmn:exclusiveGateway id="gwDiscrepancy" name="Discrepancies found?" />
    <bpmn:task id="requestClarif" name="Request clarifications from regional office" />
    <bpmn:task id="provideClarif" name="Provide clarifications" />
    <bpmn:task id="conductRiskAssessment" name="Conduct risk assessment" />
    <bpmn:parallelGateway id="pgRiskSplit" />
    <bpmn:task id="evalFinancial" name="Evaluate financial risks" />
    <bpmn:task id="evalOperational" name="Evaluate operational risks" />
    <bpmn:task id="evalCompliance" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="pgRiskJoin" />
    <bpmn:exclusiveGateway id="gwHighRisk" name="High risk identified?" />
    <bpmn:task id="launchInvestigation" name="Launch detailed investigation" />
    <bpmn:parallelGateway id="pgInvSplit" />
    <bpmn:task id="dataAnalysis" name="Perform data analysis" />
    <bpmn:task id="interviews" name="Conduct interviews" />
    <bpmn:task id="siteVisits" name="Perform site visits" />
    <bpmn:parallelGateway id="pgInvJoin" />
    <bpmn:task id="compileReport" name="Compile audit report" />
    <bpmn:task id="reviewReport" name="Review audit report" />
    <bpmn:exclusiveGateway id="gwApprove" name="Report approved?" />
    <bpmn:task id="sendRevisions" name="Send report for revisions" />
    <bpmn:task id="updateReport" name="Update audit report" />
    <bpmn:task id="resubmitReport" name="Resubmit audit report" />
    <bpmn:task id="distributeReport" name="Distribute final report to executive board" />
    <bpmn:task id="archiveReport" name="Archive report" />
    <bpmn:endEvent id="end1" name="Audit process closed" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f_start_to_send" sourceRef="start1" targetRef="sendNotification" />
    <bpmn:sequenceFlow id="f_send_to_pg1" sourceRef="sendNotification" targetRef="pg1" />
    <bpmn:sequenceFlow id="f_pg1_to_prepare" sourceRef="pg1" targetRef="prepareDocs" />
    <bpmn:sequenceFlow id="f_pg1_to_check" sourceRef="pg1" targetRef="checkUpdates" />
    <bpmn:sequenceFlow id="f_prepare_to_pg2" sourceRef="prepareDocs" targetRef="pg2" />
    <bpmn:sequenceFlow id="f_check_to_pg2" sourceRef="checkUpdates" targetRef="pg2" />
    <bpmn:sequenceFlow id="f_pg2_to_submit" sourceRef="pg2" targetRef="submitDocs" />
    <bpmn:sequenceFlow id="f_submit_to_review" sourceRef="submitDocs" targetRef="reviewSubmission" />
    <bpmn:sequenceFlow id="f_review_to_gw" sourceRef="reviewSubmission" targetRef="gwDiscrepancy" />
    <bpmn:sequenceFlow id="f_gw_yes" name="yes" sourceRef="gwDiscrepancy" targetRef="requestClarif" />
    <bpmn:sequenceFlow id="f_request_to_provide" sourceRef="requestClarif" targetRef="provideClarif" />
    <bpmn:sequenceFlow id="f_provide_to_review" sourceRef="provideClarif" targetRef="reviewSubmission" />
    <bpmn:sequenceFlow id="f_gw_no" name="no" sourceRef="gwDiscrepancy" targetRef="conductRiskAssessment" />
    <bpmn:sequenceFlow id="f_conduct_to_riskSplit" sourceRef="conductRiskAssessment" targetRef="pgRiskSplit" />
    <bpmn:sequenceFlow id="f_riskSplit_to_fin" sourceRef="pgRiskSplit" targetRef="evalFinancial" />
    <bpmn:sequenceFlow id="f_riskSplit_to_op" sourceRef="pgRiskSplit" targetRef="evalOperational" />
    <bpmn:sequenceFlow id="f_riskSplit_to_comp" sourceRef="pgRiskSplit" targetRef="evalCompliance" />
    <bpmn:sequenceFlow id="f_fin_to_riskJoin" sourceRef="evalFinancial" targetRef="pgRiskJoin" />
    <bpmn:sequenceFlow id="f_op_to_riskJoin" sourceRef="evalOperational" targetRef="pgRiskJoin" />
    <bpmn:sequenceFlow id="f_comp_to_riskJoin" sourceRef="evalCompliance" targetRef="pgRiskJoin" />
    <bpmn:sequenceFlow id="f_riskJoin_to_highRiskGw" sourceRef="pgRiskJoin" targetRef="gwHighRisk" />
    <bpmn:sequenceFlow id="f_high_yes" name="yes" sourceRef="gwHighRisk" targetRef="launchInvestigation" />
    <bpmn:sequenceFlow id="f_high_no" name="no" sourceRef="gwHighRisk" targetRef="compileReport" />
    <bpmn:sequenceFlow id="f_launch_to_invSplit" sourceRef="launchInvestigation" targetRef="pgInvSplit" />
    <bpmn:sequenceFlow id="f_invSplit_to_analysis" sourceRef="pgInvSplit" targetRef="dataAnalysis" />
    <bpmn:sequenceFlow id="f_invSplit_to_interviews" sourceRef="pgInvSplit" targetRef="interviews" />
    <bpmn:sequenceFlow id="f_invSplit_to_site" sourceRef="pgInvSplit" targetRef="siteVisits" />
    <bpmn:sequenceFlow id="f_analysis_to_invJoin" sourceRef="dataAnalysis" targetRef="pgInvJoin" />
    <bpmn:sequenceFlow id="f_interviews_to_invJoin" sourceRef="interviews" targetRef="pgInvJoin" />
    <bpmn:sequenceFlow id="f_site_to_invJoin" sourceRef="siteVisits" targetRef="pgInvJoin" />
    <bpmn:sequenceFlow id="f_invJoin_to_compile" sourceRef="pgInvJoin" targetRef="compileReport" />
    <bpmn:sequenceFlow id="f_compile_to_review" sourceRef="compileReport" targetRef="reviewReport" />
    <bpmn:sequenceFlow id="f_review_to_approve" sourceRef="reviewReport" targetRef="gwApprove" />
    <bpmn:sequenceFlow id="f_approve_yes" name="yes" sourceRef="gwApprove" targetRef="distributeReport" />
    <bpmn:sequenceFlow id="f_approve_no" name="no" sourceRef="gwApprove" targetRef="sendRevisions" />
    <bpmn:sequenceFlow id="f_sendRev_to_update" sourceRef="sendRevisions" targetRef="updateReport" />
    <bpmn:sequenceFlow id="f_update_to_resubmit" sourceRef="updateReport" targetRef="resubmitReport" />
    <bpmn:sequenceFlow id="f_resubmit_to_review" sourceRef="resubmitReport" targetRef="reviewReport" />
    <bpmn:sequenceFlow id="f_distribute_to_archive" sourceRef="distributeReport" targetRef="archiveReport" />
    <bpmn:sequenceFlow id="f_archive_to_end" sourceRef="archiveReport" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>