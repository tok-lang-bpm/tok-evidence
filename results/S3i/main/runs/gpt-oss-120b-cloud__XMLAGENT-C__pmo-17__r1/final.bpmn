<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="E-Commerce Company" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>t1_customerPlace</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2_recordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3_paymentBegin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4_notifyFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5_inventoryCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6_backorderInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7_informDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8_backorderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3_parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4_parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5_international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15_shippingConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16_inventoryUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17_followUpEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_returns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>t9_pickItems</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_quality" name="Quality Control">
        <bpmn:flowNodeRef>t10_qualityCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_packaging" name="Packaging">
        <bpmn:flowNodeRef>t11_packaging</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_shipping" name="Shipping">
        <bpmn:flowNodeRef>t12_shippingDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13_customsDoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14_dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_returns" name="Returns">
        <bpmn:flowNodeRef>t18_returnLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19_receiveReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t20_inspectReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21_processRefund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1_customerPlace" name="Customer places an order" />
    <bpmn:task id="t2_recordOrder" name="System records the order details" />
    <bpmn:task id="t3_paymentBegin" name="Payment processing begins" />
    <bpmn:exclusiveGateway id="g1_payment" name="Payment successful?" />
    <bpmn:task id="t4_notifyFail" name="Customer is notified" />
    <bpmn:endEvent id="end_fail" name="Process ends due to payment failure" />
    <bpmn:task id="t5_inventoryCheck" name="Inventory system checks stock availability" />
    <bpmn:exclusiveGateway id="g2_stock" name="Items in stock?" />
    <bpmn:task id="t6_backorderInitiated" name="Back-order is initiated" />
    <bpmn:task id="t7_informDelay" name="Customer is informed about the delay" />
    <bpmn:task id="t8_backorderReceived" name="Back-order received and items available" />
    <bpmn:task id="t9_pickItems" name="Items are picked from the warehouse" />
    <bpmn:task id="t10_qualityCheck" name="Quality control checks are performed on the picked items" />
    <bpmn:parallelGateway id="g3_parallelSplit" />
    <bpmn:task id="t11_packaging" name="Packaging is done (including gift wrapping if requested)" />
    <bpmn:task id="t12_shippingDocs" name="Shipping documents and labels are prepared" />
    <bpmn:parallelGateway id="g4_parallelJoin" />
    <bpmn:exclusiveGateway id="g5_international" name="Order is international?" />
    <bpmn:task id="t13_customsDoc" name="Customs documentation is prepared" />
    <bpmn:task id="t14_dispatch" name="Order is dispatched" />
    <bpmn:task id="t15_shippingConfirmation" name="Shipping confirmation is sent to the customer" />
    <bpmn:task id="t16_inventoryUpdate" name="Inventory levels are updated" />
    <bpmn:task id="t17_followUpEmail" name="Follow-up email for feedback is sent" />
    <bpmn:exclusiveGateway id="g6_issue" name="Customer reports any issues?" />
    <bpmn:task id="t18_returnLabel" name="Return shipping label is sent" />
    <bpmn:task id="t19_receiveReturned" name="Returned items are received" />
    <bpmn:task id="t20_inspectReturned" name="Returned items are inspected" />
    <bpmn:task id="t21_processRefund" name="Refund or replacement is processed" />
    <bpmn:endEvent id="end_success" name="Order process completed successfully" />
    <bpmn:endEvent id="end_returns" name="Returns process completed" />

    <bpmn:sequenceFlow id="f_start_to_place" sourceRef="start" targetRef="t1_customerPlace" />
    <bpmn:sequenceFlow id="f_place_to_record" sourceRef="t1_customerPlace" targetRef="t2_recordOrder" />
    <bpmn:sequenceFlow id="f_record_to_payment" sourceRef="t2_recordOrder" targetRef="t3_paymentBegin" />
    <bpmn:sequenceFlow id="f_payment_to_gateway" sourceRef="t3_paymentBegin" targetRef="g1_payment" />
    <bpmn:sequenceFlow id="f_gateway_to_fail" name="no" sourceRef="g1_payment" targetRef="t4_notifyFail" />
    <bpmn:sequenceFlow id="f_fail_to_end" sourceRef="t4_notifyFail" targetRef="end_fail" />
    <bpmn:sequenceFlow id="f_gateway_to_success" name="yes" sourceRef="g1_payment" targetRef="t5_inventoryCheck" />
    <bpmn:sequenceFlow id="f_inventory_to_stockgateway" sourceRef="t5_inventoryCheck" targetRef="g2_stock" />
    <bpmn:sequenceFlow id="f_stock_yes" name="yes" sourceRef="g2_stock" targetRef="t9_pickItems" />
    <bpmn:sequenceFlow id="f_stock_no" name="no" sourceRef="g2_stock" targetRef="t6_backorderInitiated" />
    <bpmn:sequenceFlow id="f_backorder_to_inform" sourceRef="t6_backorderInitiated" targetRef="t7_informDelay" />
    <bpmn:sequenceFlow id="f_inform_to_received" sourceRef="t7_informDelay" targetRef="t8_backorderReceived" />
    <bpmn:sequenceFlow id="f_received_to_pick" sourceRef="t8_backorderReceived" targetRef="t9_pickItems" />
    <bpmn:sequenceFlow id="f_pick_to_quality" sourceRef="t9_pickItems" targetRef="t10_qualityCheck" />
    <bpmn:sequenceFlow id="f_quality_to_parallel" sourceRef="t10_qualityCheck" targetRef="g3_parallelSplit" />
    <bpmn:sequenceFlow id="f_parallel_to_packaging" sourceRef="g3_parallelSplit" targetRef="t11_packaging" />
    <bpmn:sequenceFlow id="f_parallel_to_shippingDocs" sourceRef="g3_parallelSplit" targetRef="t12_shippingDocs" />
    <bpmn:sequenceFlow id="f_packaging_to_join" sourceRef="t11_packaging" targetRef="g4_parallelJoin" />
    <bpmn:sequenceFlow id="f_shippingDocs_to_join" sourceRef="t12_shippingDocs" targetRef="g4_parallelJoin" />
    <bpmn:sequenceFlow id="f_join_to_international" sourceRef="g4_parallelJoin" targetRef="g5_international" />
    <bpmn:sequenceFlow id="f_international_yes" name="yes" sourceRef="g5_international" targetRef="t13_customsDoc" />
    <bpmn:sequenceFlow id="f_international_no" name="no" sourceRef="g5_international" targetRef="t14_dispatch" />
    <bpmn:sequenceFlow id="f_customs_to_dispatch" sourceRef="t13_customsDoc" targetRef="t14_dispatch" />
    <bpmn:sequenceFlow id="f_dispatch_to_confirmation" sourceRef="t14_dispatch" targetRef="t15_shippingConfirmation" />
    <bpmn:sequenceFlow id="f_confirmation_to_update" sourceRef="t15_shippingConfirmation" targetRef="t16_inventoryUpdate" />
    <bpmn:sequenceFlow id="f_update_to_followup" sourceRef="t16_inventoryUpdate" targetRef="t17_followUpEmail" />
    <bpmn:sequenceFlow id="f_followup_to_issue" sourceRef="t17_followUpEmail" targetRef="g6_issue" />
    <bpmn:sequenceFlow id="f_issue_yes" name="yes" sourceRef="g6_issue" targetRef="t18_returnLabel" />
    <bpmn:sequenceFlow id="f_issue_no" name="no" sourceRef="g6_issue" targetRef="end_success" />
    <bpmn:sequenceFlow id="f_returnLabel_to_receive" sourceRef="t18_returnLabel" targetRef="t19_receiveReturned" />
    <bpmn:sequenceFlow id="f_receive_to_inspect" sourceRef="t19_receiveReturned" targetRef="t20_inspectReturned" />
    <bpmn:sequenceFlow id="f_inspect_to_process" sourceRef="t20_inspectReturned" targetRef="t21_processRefund" />
    <bpmn:sequenceFlow id="f_process_to_endreturns" sourceRef="t21_processRefund" targetRef="end_returns" />
  </bpmn:process>
</bpmn:definitions>
