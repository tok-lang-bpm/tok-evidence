<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="UNIVERSITY" name="University" processRef="UNIVERSITY_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="UNIVERSITY_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_PROSPECTIVE" name="Prospective Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_provide_missing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ADMISSIONS_OFFICE" name="Admissions Office">
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_accept_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_orientation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ADMISSIONS_COMMITTEE" name="Admissions Committee">
        <bpmn:flowNodeRef>t_evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FINANCE" name="Finance Department">
        <bpmn:flowNodeRef>t_finance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PROCESS" name="Process Logic">
        <bpmn:flowNodeRef>gw_docs_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg2_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg2_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_international</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_grievance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_STUDENT" name="Student">
        <bpmn:flowNodeRef>t_confirm_enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_id_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_meet_advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select_courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resolve_conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_attend_classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_post_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review_grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit_appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_grievance_resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_IT" name="IT Department">
        <bpmn:flowNodeRef>t_it_setup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_INTERNATIONAL" name="International Student Office">
        <bpmn:flowNodeRef>t_visa_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_APPEALS" name="Appeals Committee">
        <bpmn:flowNodeRef>t_meet_appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_await_decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t_submit" name="Submit application online" />
    <bpmn:task id="t_review" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="gw_docs_missing" name="Documents missing?" />
    <bpmn:task id="t_notify_missing" name="Notify applicant to provide missing items" />
    <bpmn:task id="t_provide_missing" name="Provide missing items" />
    <bpmn:parallelGateway id="pg_split" name="Parallel split after review" />
    <bpmn:task id="t_finance" name="Process application fees or waivers" />
    <bpmn:task id="t_evaluate" name="Evaluate application" />
    <bpmn:parallelGateway id="pg_join" name="Parallel join after finance and evaluation" />
    <bpmn:exclusiveGateway id="gw_accepted" name="Application accepted?" />
    <bpmn:task id="t_accept_letter" name="Send acceptance letter" />
    <bpmn:task id="t_reject_letter" name="Send rejection letter" />
    <bpmn:exclusiveGateway id="gw_confirm" name="Student confirms enrollment?" />
    <bpmn:task id="t_confirm_enrollment" name="Confirm enrollment by deadline" />
    <bpmn:parallelGateway id="pg2_split" name="Parallel after confirmation" />
    <bpmn:task id="t_orientation" name="Send orientation materials" />
    <bpmn:task id="t_it_setup" name="Set up student accounts (email, portals, library)" />
    <bpmn:parallelGateway id="pg2_join" name="Join after orientation and IT setup" />
    <bpmn:exclusiveGateway id="gw_international" name="Student is international?" />
    <bpmn:task id="t_visa_process" name="Assist with visa processing" />
    <bpmn:task id="t_id_card" name="Obtain student ID card" />
    <bpmn:task id="t_meet_advisor" name="Meeting with an academic advisor" />
    <bpmn:task id="t_select_courses" name="Selecting courses" />
    <bpmn:task id="t_resolve_conflicts" name="Resolving any schedule conflicts" />
    <bpmn:task id="t_attend_classes" name="Begin attending classes" />
    <bpmn:task id="t_post_grades" name="Grades are posted" />
    <bpmn:task id="t_review_grades" name="Review grades online" />
    <bpmn:exclusiveGateway id="gw_grievance" name="Has grievance?" />
    <bpmn:task id="t_submit_appeal" name="Submitting an appeal form" />
    <bpmn:task id="t_meet_appeals" name="Meeting with the appeals committee" />
    <bpmn:task id="t_await_decision" name="Awaiting a decision" />
    <bpmn:endEvent id="end_success" name="Process completed successfully" />
    <bpmn:endEvent id="end_reject" name="Process ends after rejection" />
    <bpmn:endEvent id="end_canceled" name="Application canceled due to no confirmation" />
    <bpmn:endEvent id="end_grievance_resolved" name="Process ends after grievance resolution" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_submit" targetRef="t_review" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_review" targetRef="gw_docs_missing" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gw_docs_missing" targetRef="t_notify_missing" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gw_docs_missing" targetRef="pg_split" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_notify_missing" targetRef="t_provide_missing" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_provide_missing" targetRef="t_review" />
    <bpmn:sequenceFlow id="f8" sourceRef="pg_split" targetRef="t_finance" />
    <bpmn:sequenceFlow id="f9" sourceRef="pg_split" targetRef="t_evaluate" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_finance" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_evaluate" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="pg_join" targetRef="gw_accepted" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="gw_accepted" targetRef="t_accept_letter" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gw_accepted" targetRef="t_reject_letter" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_accept_letter" targetRef="gw_confirm" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_reject_letter" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="gw_confirm" targetRef="t_confirm_enrollment" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="gw_confirm" targetRef="end_canceled" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_confirm_enrollment" targetRef="pg2_split" />
    <bpmn:sequenceFlow id="f20" sourceRef="pg2_split" targetRef="t_orientation" />
    <bpmn:sequenceFlow id="f21" sourceRef="pg2_split" targetRef="t_it_setup" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_orientation" targetRef="pg2_join" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_it_setup" targetRef="pg2_join" />
    <bpmn:sequenceFlow id="f24" sourceRef="pg2_join" targetRef="gw_international" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="gw_international" targetRef="t_visa_process" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="gw_international" targetRef="t_id_card" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_visa_process" targetRef="t_id_card" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_id_card" targetRef="t_meet_advisor" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_meet_advisor" targetRef="t_select_courses" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_select_courses" targetRef="t_resolve_conflicts" />
    <bpmn:sequenceFlow id="f31" sourceRef="t_resolve_conflicts" targetRef="t_attend_classes" />
    <bpmn:sequenceFlow id="f32" sourceRef="t_attend_classes" targetRef="t_post_grades" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_post_grades" targetRef="t_review_grades" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_review_grades" targetRef="gw_grievance" />
    <bpmn:sequenceFlow id="f35" name="yes" sourceRef="gw_grievance" targetRef="t_submit_appeal" />
    <bpmn:sequenceFlow id="f36" name="no" sourceRef="gw_grievance" targetRef="end_success" />
    <bpmn:sequenceFlow id="f37" sourceRef="t_submit_appeal" targetRef="t_meet_appeals" />
    <bpmn:sequenceFlow id="f38" sourceRef="t_meet_appeals" targetRef="t_await_decision" />
    <bpmn:sequenceFlow id="f39" sourceRef="t_await_decision" targetRef="end_grievance_resolved" />
  </bpmn:process>
</bpmn:definitions>
