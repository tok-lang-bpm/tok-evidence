<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_USER" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rewardChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SHOP" name="Shop System">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="pgSplit" />
    <bpmn:task id="selectItems" name="Select items to purchase" />
    <bpmn:task id="setPaymentMethod" name="Set payment method" />
    <bpmn:parallelGateway id="pgJoin" />
    <bpmn:task id="rewardChoice" name="Choose free reward" />
    <bpmn:exclusiveGateway id="paymentGateway" name="Payment choice" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="returnGateway" name="Return items?" />
    <bpmn:task id="returnItems" name="Return items for exchange" />
    <bpmn:endEvent id="endNoReturn" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="pgSplit" />
    <bpmn:sequenceFlow id="f3" sourceRef="pgSplit" targetRef="selectItems" />
    <bpmn:sequenceFlow id="f4" sourceRef="pgSplit" targetRef="setPaymentMethod" />
    <bpmn:sequenceFlow id="f5" sourceRef="selectItems" targetRef="rewardChoice" />
    <bpmn:sequenceFlow id="f6" sourceRef="setPaymentMethod" targetRef="paymentGateway" />
    <bpmn:sequenceFlow id="f7" sourceRef="rewardChoice" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f8" sourceRef="paymentGateway" targetRef="pay" name="pay" />
    <bpmn:sequenceFlow id="f9" sourceRef="paymentGateway" targetRef="installment" name="installment" />
    <bpmn:sequenceFlow id="f10" sourceRef="pay" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f11" sourceRef="installment" targetRef="pgJoin" />
    <bpmn:sequenceFlow id="f12" sourceRef="pgJoin" targetRef="deliver" />
    <bpmn:sequenceFlow id="f13" sourceRef="deliver" targetRef="returnGateway" />
    <bpmn:sequenceFlow id="f14" sourceRef="returnGateway" targetRef="returnItems" name="return" />
    <bpmn:sequenceFlow id="f15" sourceRef="returnGateway" targetRef="endNoReturn" name="no return" />
    <bpmn:sequenceFlow id="f16" sourceRef="returnItems" targetRef="deliver" />
  </bpmn:process>
</bpmn:definitions>