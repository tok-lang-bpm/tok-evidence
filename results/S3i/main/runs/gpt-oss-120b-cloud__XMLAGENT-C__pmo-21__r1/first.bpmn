<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="L_SECRETARY" name="Secretary">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>usePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preparePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endShip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_LOGISTICS" name="Logistics Department Head">
        <bpmn:flowNodeRef>insuranceDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>takeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_WAREHOUSE" name="Warehousemen">
        <bpmn:flowNodeRef>packageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="gwShip" name="Goods shall be shipped?" />
    <bpmn:endEvent id="endNoShip" name="No shipping needed" />
    <bpmn:task id="clarify" name="Secretary clarifies who will do the shipping" />
    <bpmn:parallelGateway id="splitParallel" name="Parallel split" />
    <bpmn:exclusiveGateway id="gwAmount" name="Large amounts?" />
    <bpmn:task id="invite" name="Secretary invites three logistic companies" />
    <bpmn:task id="select" name="Secretary selects one logistic company" />
    <bpmn:exclusiveGateway id="insuranceDecision" name="Parcel insurance necessary?" />
    <bpmn:task id="takeInsurance" name="Logistics department head takes parcel insurance" />
    <bpmn:task id="usePost" name="Secretary uses normal post shipment" />
    <bpmn:task id="writeLabel" name="Secretary writes package label" />
    <bpmn:task id="packageGoods" name="Warehousemen package the goods" />
    <bpmn:parallelGateway id="joinParallel" name="Parallel join" />
    <bpmn:task id="preparePickup" name="Secretary prepares goods for pickup by logistic company" />
    <bpmn:endEvent id="endShip" name="Shipping process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="sf1" sourceRef="start" targetRef="gwShip" />
    <bpmn:sequenceFlow id="sf2" name="yes" sourceRef="gwShip" targetRef="clarify" />
    <bpmn:sequenceFlow id="sf3" name="no" sourceRef="gwShip" targetRef="endNoShip" />
    <bpmn:sequenceFlow id="sf4" sourceRef="clarify" targetRef="splitParallel" />
    <!-- Branch A: Logistics preparation -->
    <bpmn:sequenceFlow id="sf5" sourceRef="splitParallel" targetRef="gwAmount" />
    <bpmn:sequenceFlow id="sf6" name="yes" sourceRef="gwAmount" targetRef="invite" />
    <bpmn:sequenceFlow id="sf7" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="sf8" sourceRef="select" targetRef="insuranceDecision" />
    <bpmn:sequenceFlow id="sf9" name="yes" sourceRef="insuranceDecision" targetRef="takeInsurance" />
    <bpmn:sequenceFlow id="sf10" name="no" sourceRef="insuranceDecision" targetRef="writeLabel" />
    <bpmn:sequenceFlow id="sf11" sourceRef="takeInsurance" targetRef="writeLabel" />
    <bpmn:sequenceFlow id="sf12" name="no" sourceRef="gwAmount" targetRef="usePost" />
    <bpmn:sequenceFlow id="sf13" sourceRef="usePost" targetRef="writeLabel" />
    <!-- Branch B: Packaging -->
    <bpmn:sequenceFlow id="sf14" sourceRef="splitParallel" targetRef="packageGoods" />
    <!-- Join -->
    <bpmn:sequenceFlow id="sf15" sourceRef="writeLabel" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="sf16" sourceRef="packageGoods" targetRef="joinParallel" />
    <bpmn:sequenceFlow id="sf17" sourceRef="joinParallel" targetRef="preparePickup" />
    <bpmn:sequenceFlow id="sf18" sourceRef="preparePickup" targetRef="endShip" />
  </bpmn:process>
</bpmn:definitions>