<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Restaurant" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_GUEST" name="Guest">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>placeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickAndEat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_EMPLOYEE" name="Employee">
        <bpmn:flowNodeRef>enterOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setupBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>activateBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwGuestArrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handOverMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CHEF" name="Chef">
        <bpmn:flowNodeRef>prepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Guest enters restaurant" />
    <bpmn:task id="chooseDish" name="Choose dish and wait for turn" />
    <bpmn:task id="placeOrder" name="Place order with employee" />
    <bpmn:task id="enterOrder" name="Enter order into POS system" />
    <bpmn:task id="collectMoney" name="Collect money from guest" />
    <bpmn:task id="setupBuzzer" name="Set up buzzer and give to guest" />
    <bpmn:task id="informChef" name="Inform chef of new meal order" />
    <bpmn:task id="prepareMeal" name="Prepare meal and place in service hatch" />
    <bpmn:task id="informEmployee" name="Inform employee meal ready" />
    <bpmn:task id="activateBuzzer" name="Activate buzzer" />
    <bpmn:exclusiveGateway id="gwGuestArrives" name="Guest arrived?" />
    <bpmn:task id="callGuest" name="Call guest" />
    <bpmn:task id="handOverMeal" name="Hand over meal to guest" />
    <bpmn:task id="pickAndEat" name="Pick up meal and eat" />
    <bpmn:endEvent id="end" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="chooseDish" />
    <bpmn:sequenceFlow id="f2" sourceRef="chooseDish" targetRef="placeOrder" />
    <bpmn:sequenceFlow id="f3" sourceRef="placeOrder" targetRef="enterOrder" />
    <bpmn:sequenceFlow id="f4" sourceRef="enterOrder" targetRef="collectMoney" />
    <bpmn:sequenceFlow id="f5" sourceRef="collectMoney" targetRef="setupBuzzer" />
    <bpmn:sequenceFlow id="f6" sourceRef="setupBuzzer" targetRef="informChef" />
    <bpmn:sequenceFlow id="f7" sourceRef="informChef" targetRef="prepareMeal" />
    <bpmn:sequenceFlow id="f8" sourceRef="prepareMeal" targetRef="informEmployee" />
    <bpmn:sequenceFlow id="f9" sourceRef="informEmployee" targetRef="activateBuzzer" />
    <bpmn:sequenceFlow id="f10" sourceRef="activateBuzzer" targetRef="gwGuestArrives" />
    <bpmn:sequenceFlow id="f11_yes" name="yes" sourceRef="gwGuestArrives" targetRef="handOverMeal" />
    <bpmn:sequenceFlow id="f11_no" name="no" sourceRef="gwGuestArrives" targetRef="callGuest" />
    <bpmn:sequenceFlow id="f12" sourceRef="callGuest" targetRef="handOverMeal" />
    <bpmn:sequenceFlow id="f13" sourceRef="handOverMeal" targetRef="pickAndEat" />
    <bpmn:sequenceFlow id="f14" sourceRef="pickAndEat" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
