<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_org" name="Organisation" processRef="process_find_job" />
  </bpmn:collaboration>
  <bpmn:process id="process_find_job" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_receive_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_negotiate_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_rate_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_continue_offers_no_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_rating_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_rating_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_permanent_good</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_hired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_company" name="Company">
        <bpmn:flowNodeRef>task_confirm_and_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_company_wants_to_hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_rate_applicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_rating_good</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="task_report" name="Report job applications" />
    <bpmn:task id="task_confirm_and_rate" name="Company confirms receipt and rates application" />
    <bpmn:task id="task_receive_offers" name="Receive job offers" />
    <bpmn:task id="task_negotiate_interview" name="Negotiate job interview" />
    <bpmn:exclusiveGateway id="gateway_company_wants_to_hire" name="Company wants to hire?" />
    <bpmn:task id="task_probation" name="Enter probation phase" />
    <bpmn:parallelGateway id="parallel_rating_start" />
    <bpmn:task id="task_rate_company" name="You rate the company" />
    <bpmn:task id="task_rate_applicant" name="Company rates you" />
    <bpmn:parallelGateway id="parallel_rating_end" />
    <bpmn:exclusiveGateway id="gateway_permanent" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="gateway_rating_good" name="Rating &gt; C?" />
    <bpmn:task id="task_continue_offers_no_report" name="Continue receiving job offers (no reporting)" />
    <bpmn:endEvent id="end_permanent_good" name="Process ends (good rating)" />
    <bpmn:endEvent id="end_not_permanent" name="Process ends (not permanent)" />
    <bpmn:endEvent id="end_not_hired" name="Process ends (not hired)" />

    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="task_report" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_report" targetRef="task_confirm_and_rate" />
    <bpmn:sequenceFlow id="flow3" sourceRef="task_confirm_and_rate" targetRef="task_receive_offers" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_receive_offers" targetRef="task_negotiate_interview" />
    <bpmn:sequenceFlow id="flow5" sourceRef="task_negotiate_interview" targetRef="gateway_company_wants_to_hire" />
    <bpmn:sequenceFlow id="flow5_yes" name="yes" sourceRef="gateway_company_wants_to_hire" targetRef="task_probation" />
    <bpmn:sequenceFlow id="flow5_no" name="no" sourceRef="gateway_company_wants_to_hire" targetRef="end_not_hired" />
    <bpmn:sequenceFlow id="flow6" sourceRef="task_probation" targetRef="parallel_rating_start" />
    <bpmn:sequenceFlow id="flow7a" sourceRef="parallel_rating_start" targetRef="task_rate_company" />
    <bpmn:sequenceFlow id="flow7b" sourceRef="parallel_rating_start" targetRef="task_rate_applicant" />
    <bpmn:sequenceFlow id="flow8a" sourceRef="task_rate_company" targetRef="parallel_rating_end" />
    <bpmn:sequenceFlow id="flow8b" sourceRef="task_rate_applicant" targetRef="parallel_rating_end" />
    <bpmn:sequenceFlow id="flow9" sourceRef="parallel_rating_end" targetRef="gateway_permanent" />
    <bpmn:sequenceFlow id="flow9_yes" name="yes" sourceRef="gateway_permanent" targetRef="gateway_rating_good" />
    <bpmn:sequenceFlow id="flow9_no" name="no" sourceRef="gateway_permanent" targetRef="end_not_permanent" />
    <bpmn:sequenceFlow id="flow10_yes" name="good" sourceRef="gateway_rating_good" targetRef="end_permanent_good" />
    <bpmn:sequenceFlow id="flow10_no" name="bad" sourceRef="gateway_rating_good" targetRef="task_continue_offers_no_report" />
    <bpmn:sequenceFlow id="flow11" sourceRef="task_continue_offers_no_report" targetRef="task_receive_offers" />
  </bpmn:process>
</bpmn:definitions>
