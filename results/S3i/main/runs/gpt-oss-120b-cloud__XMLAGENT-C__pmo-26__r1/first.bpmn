<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="parentLane" name="Parent">
        <bpmn:flowNodeRef>fetchInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letParentSelect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planExtension</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="companyLane" name="Company">
        <bpmn:flowNodeRef>gatherInfo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="socialSecurityLane" name="Social Security" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="fetchInfo" name="Fetch information about potential models (months duration, split between parents)" />
    <bpmn:task id="letParentSelect" name="Let parent select" />
    <bpmn:task id="collectInfo" name="Collect relevant information" />
    <bpmn:task id="notify" name="Notify Social Security, Company in time" />
    <bpmn:task id="gatherInfo" name="Gather information from companies" />
    <bpmn:exclusiveGateway id="decision" name="Extension decision" />
    <bpmn:task id="planExtension" name="Plan extended maternity leave" />
    <bpmn:endEvent id="endExtended" name="Extension granted" />
    <bpmn:endEvent id="endCompleted" name="Maternity leave completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fetchInfo" />
    <bpmn:sequenceFlow id="f2" sourceRef="fetchInfo" targetRef="letParentSelect" />
    <bpmn:sequenceFlow id="f3" sourceRef="letParentSelect" targetRef="collectInfo" />
    <bpmn:sequenceFlow id="f4" sourceRef="collectInfo" targetRef="notify" />
    <bpmn:sequenceFlow id="f5" sourceRef="notify" targetRef="gatherInfo" />
    <bpmn:sequenceFlow id="f6" sourceRef="gatherInfo" targetRef="decision" />
    <bpmn:sequenceFlow id="f7" sourceRef="decision" targetRef="planExtension" name="extend" />
    <bpmn:sequenceFlow id="f8" sourceRef="decision" targetRef="endCompleted" name="no extension" />
    <bpmn:sequenceFlow id="f9" sourceRef="planExtension" targetRef="endExtended" />
  </bpmn:process>
</bpmn:definitions>