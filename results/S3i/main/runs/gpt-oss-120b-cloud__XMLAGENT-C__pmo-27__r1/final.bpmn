<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_EMPLOYEE" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reportLabour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reportInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endLabour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SELF" name="Self‑employed">
        <bpmn:flowNodeRef>se_reportInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSelf</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_STUDENT" name="Student / Schoolchild">
        <bpmn:flowNodeRef>st_reportDirectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endStudent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SCHOOL" name="School / Educational Facility">
        <bpmn:flowNodeRef>sc_reportInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSchool</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PRIVATE" name="Privately insured person">
        <bpmn:flowNodeRef>pi_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endPrivate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Work accident occurs" />
    <bpmn:parallelGateway id="split" />

    <bpmn:task id="e_inform" name="Inform the employer immediately" />
    <bpmn:parallelGateway id="reportSplit" />
    <bpmn:task id="e_reportLabour" name="Report to Labour Inspectorate" />
    <bpmn:task id="e_reportInsurance" name="Report to Accident Insurance Provider" />
    <bpmn:endEvent id="endLabour" name="Reported to Labour Inspectorate" />
    <bpmn:endEvent id="endInsurance" name="Reported to Accident Insurance Provider" />

    <bpmn:task id="se_reportInsurance" name="Report accident involving self‑employed person to Accident Insurance Provider" />
    <bpmn:endEvent id="endSelf" name="Self‑employed accident reported" />

    <bpmn:task id="st_reportDirectorate" name="Report accident to the competent directorate" />
    <bpmn:endEvent id="endStudent" name="Student accident reported" />

    <bpmn:task id="sc_reportInsurance" name="Report work accident to Accident Insurance Provider within five days in triplicate" />
    <bpmn:endEvent id="endSchool" name="School accident reported" />

    <bpmn:task id="pi_report" name="Report accident in writing to the insurance provider immediately" />
    <bpmn:endEvent id="endPrivate" name="Privately insured accident reported" />

    <bpmn:sequenceFlow id="f_start_split" sourceRef="start" targetRef="split" />
    <bpmn:sequenceFlow id="f_split_employee" sourceRef="split" targetRef="e_inform" />
    <bpmn:sequenceFlow id="f_split_self" sourceRef="split" targetRef="se_reportInsurance" />
    <bpmn:sequenceFlow id="f_split_student" sourceRef="split" targetRef="st_reportDirectorate" />
    <bpmn:sequenceFlow id="f_split_school" sourceRef="split" targetRef="sc_reportInsurance" />
    <bpmn:sequenceFlow id="f_split_private" sourceRef="split" targetRef="pi_report" />

    <bpmn:sequenceFlow id="f_inform_reportSplit" sourceRef="e_inform" targetRef="reportSplit" />
    <bpmn:sequenceFlow id="f_reportSplit_labour" sourceRef="reportSplit" targetRef="e_reportLabour" />
    <bpmn:sequenceFlow id="f_reportSplit_insurance" sourceRef="reportSplit" targetRef="e_reportInsurance" />
    <bpmn:sequenceFlow id="f_labour_end" sourceRef="e_reportLabour" targetRef="endLabour" />
    <bpmn:sequenceFlow id="f_insurance_end" sourceRef="e_reportInsurance" targetRef="endInsurance" />

    <bpmn:sequenceFlow id="f_self_end" sourceRef="se_reportInsurance" targetRef="endSelf" />
    <bpmn:sequenceFlow id="f_student_end" sourceRef="st_reportDirectorate" targetRef="endStudent" />
    <bpmn:sequenceFlow id="f_school_end" sourceRef="sc_reportInsurance" targetRef="endSchool" />
    <bpmn:sequenceFlow id="f_private_end" sourceRef="pi_report" targetRef="endPrivate" />
  </bpmn:process>
</bpmn:definitions>
