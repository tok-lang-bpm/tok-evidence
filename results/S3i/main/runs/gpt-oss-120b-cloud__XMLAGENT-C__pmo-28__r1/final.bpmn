<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_INTERN" name="Intern">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COMPANY" name="Company">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1" name="Enter internship preferences (topic, desired money, experience, hobbies)" />
    <bpmn:task id="t2" name="Receive offer" />
    <bpmn:exclusiveGateway id="g1" name="Accept offer?" />
    <bpmn:task id="t3" name="Accept offer" />
    <bpmn:task id="t4" name="Deny offer" />
    <bpmn:parallelGateway id="g2" name="Parallel start for status updates" />
    <bpmn:task id="t5" name="Write at least 3 weekly status updates about internship" />
    <bpmn:task id="t6" name="Company writes 3 status updates about intern" />
    <bpmn:parallelGateway id="g3" name="Parallel join after status updates" />
    <bpmn:task id="t7" name="Recommend company to friends via Twitter" />
    <bpmn:parallelGateway id="g4" name="Parallel start for tweets" />
    <bpmn:task id="t8" name="Send tweet 1" />
    <bpmn:task id="t9" name="Send tweet 2" />
    <bpmn:task id="t10" name="Send tweet 3" />
    <bpmn:parallelGateway id="g5" name="Parallel join after tweets" />
    <bpmn:endEvent id="end" name="End" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" name="accept" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" name="deny" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f5" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="t2" />
    <bpmn:sequenceFlow id="f7" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="f8" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="g3" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="f11" sourceRef="g3" targetRef="t7" />
    <bpmn:sequenceFlow id="f12" sourceRef="t7" targetRef="g4" />
    <bpmn:sequenceFlow id="f13" sourceRef="g4" targetRef="t8" />
    <bpmn:sequenceFlow id="f14" sourceRef="g4" targetRef="t9" />
    <bpmn:sequenceFlow id="f15" sourceRef="g4" targetRef="t10" />
    <bpmn:sequenceFlow id="f16" sourceRef="t8" targetRef="g5" />
    <bpmn:sequenceFlow id="f17" sourceRef="t9" targetRef="g5" />
    <bpmn:sequenceFlow id="f18" sourceRef="t10" targetRef="g5" />
    <bpmn:sequenceFlow id="f19" sourceRef="g5" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
