<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>organize_accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_passport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obtain_insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prove_means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_additional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="representation" name="Representation Office">
        <bpmn:flowNodeRef>determine_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visa_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_visa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start process for working and living in Austria" />
    <bpmn:task id="organize_accommodation" name="Organize accommodation and bank account (negotiation)" />
    <bpmn:task id="prepare_form" name="Prepare visa application form" />
    <bpmn:task id="gather_passport" name="Gather travel document (passport) meeting validity requirements" />
    <bpmn:task id="obtain_photo" name="Obtain passport photo (35 x 45 mm)" />
    <bpmn:task id="obtain_insurance" name="Obtain travel health insurance (30,000 Euro, Schengen)" />
    <bpmn:task id="prove_means" name="Provide proof of sufficient means of subsistence" />
    <bpmn:task id="gather_evidence" name="Gather other evidence (hotel reservations, invitations, booking confirmations, return flight ticket, proof of employment, etc.)" />
    <bpmn:task id="check_refusal" name="Check absence of grounds for refusal" />
    <bpmn:task id="submit_application" name="Submit visa application to representation office" />
    <bpmn:exclusiveGateway id="determine_rep" name="Determine competent representation office" />
    <bpmn:task id="review_application" name="Review visa application" />
    <bpmn:exclusiveGateway id="additional_docs" name="Additional documents required?" />
    <bpmn:task id="request_additional" name="Request additional documents" />
    <bpmn:task id="provide_additional" name="Provide additional documents" />
    <bpmn:exclusiveGateway id="visa_decision" name="Visa approved?" />
    <bpmn:task id="issue_visa" name="Issue visa (Rot‑Weiss‑Rot Card)" />
    <bpmn:endEvent id="visa_received" name="Visa received" />
    <bpmn:task id="reject_visa" name="Reject visa" />
    <bpmn:endEvent id="visa_rejected" name="Visa rejected" />
    <bpmn:endEvent id="process_end_other" name="Contact other representation office" />
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="organize_accommodation" />
    <bpmn:sequenceFlow id="f2" sourceRef="organize_accommodation" targetRef="prepare_form" />
    <bpmn:sequenceFlow id="f3" sourceRef="prepare_form" targetRef="gather_passport" />
    <bpmn:sequenceFlow id="f4" sourceRef="gather_passport" targetRef="obtain_photo" />
    <bpmn:sequenceFlow id="f5" sourceRef="obtain_photo" targetRef="obtain_insurance" />
    <bpmn:sequenceFlow id="f6" sourceRef="obtain_insurance" targetRef="prove_means" />
    <bpmn:sequenceFlow id="f7" sourceRef="prove_means" targetRef="gather_evidence" />
    <bpmn:sequenceFlow id="f8" sourceRef="gather_evidence" targetRef="check_refusal" />
    <bpmn:sequenceFlow id="f9" sourceRef="check_refusal" targetRef="submit_application" />
    <bpmn:sequenceFlow id="f10" sourceRef="submit_application" targetRef="determine_rep" />
    <bpmn:sequenceFlow id="f11" sourceRef="determine_rep" targetRef="review_application" name="competent" />
    <bpmn:sequenceFlow id="f12" sourceRef="determine_rep" targetRef="process_end_other" name="other" />
    <bpmn:sequenceFlow id="f13" sourceRef="review_application" targetRef="additional_docs" />
    <bpmn:sequenceFlow id="f14" sourceRef="additional_docs" targetRef="request_additional" name="yes" />
    <bpmn:sequenceFlow id="f15" sourceRef="additional_docs" targetRef="visa_decision" name="no" />
    <bpmn:sequenceFlow id="f16" sourceRef="request_additional" targetRef="provide_additional" />
    <bpmn:sequenceFlow id="f17" sourceRef="provide_additional" targetRef="review_application" />
    <bpmn:sequenceFlow id="f18" sourceRef="visa_decision" targetRef="issue_visa" name="approved" />
    <bpmn:sequenceFlow id="f19" sourceRef="visa_decision" targetRef="reject_visa" name="rejected" />
    <bpmn:sequenceFlow id="f20" sourceRef="issue_visa" targetRef="visa_received" />
    <bpmn:sequenceFlow id="f21" sourceRef="reject_visa" targetRef="visa_rejected" />
  </bpmn:process>
</bpmn:definitions>