<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="plannerLane" name="Planner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enoughPeople</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gamesMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>downloadGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enoughBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoyParty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="sendInvitations" name="Send invitations to 10 friends" />
    <bpmn:task id="findGames" name="Find out which games friends want to play" />
    <bpmn:parallelGateway id="splitGateway" />
    <bpmn:task id="appointDate" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="enoughPeople" name="8 or more people agree on date?" />
    <bpmn:task id="checkGames" name="Check if you have all requested games" />
    <bpmn:exclusiveGateway id="gamesMissing" name="Some games missing?" />
    <bpmn:task id="downloadGames" name="Download missing games" />
    <bpmn:parallelGateway id="joinGateway" />
    <bpmn:task id="findBeer" name="Find out how much beer is required" />
    <bpmn:exclusiveGateway id="enoughBeer" name="Enough beer?" />
    <bpmn:task id="buyBeer" name="Buy missing beer" />
    <bpmn:task id="enjoyParty" name="Enjoy the LAN party" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendInvitations" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendInvitations" targetRef="findGames" />
    <bpmn:sequenceFlow id="f3" sourceRef="findGames" targetRef="splitGateway" />
    <bpmn:sequenceFlow id="f4" sourceRef="splitGateway" targetRef="appointDate" />
    <bpmn:sequenceFlow id="f5" sourceRef="splitGateway" targetRef="checkGames" />
    <bpmn:sequenceFlow id="f6" sourceRef="appointDate" targetRef="enoughPeople" />
    <bpmn:sequenceFlow id="f7" sourceRef="enoughPeople" targetRef="joinGateway" name="yes" />
    <bpmn:sequenceFlow id="f8" sourceRef="enoughPeople" targetRef="appointDate" name="no" />
    <bpmn:sequenceFlow id="f9" sourceRef="checkGames" targetRef="gamesMissing" />
    <bpmn:sequenceFlow id="f10" sourceRef="gamesMissing" targetRef="downloadGames" name="yes" />
    <bpmn:sequenceFlow id="f11" sourceRef="downloadGames" targetRef="joinGateway" />
    <bpmn:sequenceFlow id="f12" sourceRef="gamesMissing" targetRef="joinGateway" name="no" />
    <bpmn:sequenceFlow id="f13" sourceRef="joinGateway" targetRef="findBeer" />
    <bpmn:sequenceFlow id="f14" sourceRef="findBeer" targetRef="enoughBeer" />
    <bpmn:sequenceFlow id="f15" sourceRef="enoughBeer" targetRef="enjoyParty" name="yes" />
    <bpmn:sequenceFlow id="f16" sourceRef="enoughBeer" targetRef="buyBeer" name="no" />
    <bpmn:sequenceFlow id="f17" sourceRef="buyBeer" targetRef="enjoyParty" />
    <bpmn:sequenceFlow id="f18" sourceRef="enjoyParty" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
