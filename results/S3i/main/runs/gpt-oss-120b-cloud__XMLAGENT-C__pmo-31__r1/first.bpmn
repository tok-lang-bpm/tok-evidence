<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Blizzard" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="System" name="System">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Player" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clickLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterCC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCharacter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comeupNames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="checkAccount" name="Check for Battle.net account" />
    <bpmn:exclusiveGateway id="gwAccount" name="Battle.net account?" />
    <bpmn:task id="enterInfo" name="Enter account information" />
    <bpmn:task id="clickLink" name="Click confirmation link" />
    <bpmn:task id="checkSubscription" name="Check active WoW subscription" />
    <bpmn:exclusiveGateway id="gwSub" name="WoW subscription active?" />
    <bpmn:task id="selectPayment" name="Select payment method" />
    <bpmn:exclusiveGateway id="gwPayment" name="Payment method?" />
    <bpmn:task id="enterCC" name="Enter credit card information" />
    <bpmn:task id="enterBank" name="Enter IBAN and BIC numbers" />
    <bpmn:task id="selectCharacter" name="Log into game and select realm, race and class" />
    <bpmn:task id="comeupNames" name="Come up with character names" />
    <bpmn:task id="enterName" name="Enter character name" />
    <bpmn:exclusiveGateway id="gwName" name="Name available?" />
    <bpmn:task id="confirm" name="Get confirmation and character selfies" />
    <bpmn:task id="expMsg" name="Receive expansion release message" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="end" name="End" />
    <!-- sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="split" />
    <bpmn:sequenceFlow id="f2" sourceRef="split" targetRef="checkAccount" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="comeupNames" />
    <bpmn:sequenceFlow id="f4" sourceRef="checkAccount" targetRef="gwAccount" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="gwAccount" targetRef="checkSubscription" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="gwAccount" targetRef="enterInfo" />
    <bpmn:sequenceFlow id="f7" sourceRef="enterInfo" targetRef="clickLink" />
    <bpmn:sequenceFlow id="f8" sourceRef="clickLink" targetRef="checkAccount" />
    <bpmn:sequenceFlow id="f9" sourceRef="checkSubscription" targetRef="gwSub" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="gwSub" targetRef="selectCharacter" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="gwSub" targetRef="selectPayment" />
    <bpmn:sequenceFlow id="f12" sourceRef="selectPayment" targetRef="gwPayment" />
    <bpmn:sequenceFlow id="f13" name="credit card" sourceRef="gwPayment" targetRef="enterCC" />
    <bpmn:sequenceFlow id="f14" name="bank account" sourceRef="gwPayment" targetRef="enterBank" />
    <bpmn:sequenceFlow id="f15" sourceRef="enterCC" targetRef="checkSubscription" />
    <bpmn:sequenceFlow id="f16" sourceRef="enterBank" targetRef="checkSubscription" />
    <bpmn:sequenceFlow id="f17" sourceRef="selectCharacter" targetRef="join" />
    <bpmn:sequenceFlow id="f18" sourceRef="comeupNames" targetRef="enterName" />
    <bpmn:sequenceFlow id="f19" sourceRef="enterName" targetRef="gwName" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="gwName" targetRef="confirm" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="gwName" targetRef="enterName" />
    <bpmn:sequenceFlow id="f22" sourceRef="confirm" targetRef="expMsg" />
    <bpmn:sequenceFlow id="f23" sourceRef="expMsg" targetRef="join" />
    <bpmn:sequenceFlow id="f24" sourceRef="join" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>