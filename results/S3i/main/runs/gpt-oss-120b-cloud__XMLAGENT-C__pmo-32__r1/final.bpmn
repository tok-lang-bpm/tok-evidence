<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="PLAYER" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyMilestone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNormal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BOT" name="Bot">
        <bpmn:flowNodeRef>botStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwDisaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handleDisaster</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="selectResources" name="Find out which resources you want" />
    <bpmn:task id="botStart" name="Bot starts farming" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="collect1" name="Collect resource 1" />
    <bpmn:task id="collect2" name="Collect resource 2" />
    <bpmn:task id="collect3" name="Collect resource 3" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="gwDisaster" name="Disaster occurred?" />
    <bpmn:task id="notifyMilestone" name="Notify player of milestone" />
    <bpmn:task id="handleDisaster" name="Handle natural disaster (reset bot)" />
    <bpmn:task id="brag" name="Brag to selected friends and/or send them materials" />
    <bpmn:endEvent id="endNormal" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectResources" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectResources" targetRef="botStart" />
    <bpmn:sequenceFlow id="f3" sourceRef="botStart" targetRef="split" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="collect1" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="collect2" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="collect3" />
    <bpmn:sequenceFlow id="f7" sourceRef="collect1" targetRef="join" />
    <bpmn:sequenceFlow id="f8" sourceRef="collect2" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="collect3" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="join" targetRef="gwDisaster" />
    <bpmn:sequenceFlow id="f11" name="no disaster" sourceRef="gwDisaster" targetRef="notifyMilestone" />
    <bpmn:sequenceFlow id="f12" sourceRef="notifyMilestone" targetRef="brag" />
    <bpmn:sequenceFlow id="f13" sourceRef="brag" targetRef="endNormal" />
    <bpmn:sequenceFlow id="f14" name="disaster" sourceRef="gwDisaster" targetRef="handleDisaster" />
    <bpmn:sequenceFlow id="f15" sourceRef="handleDisaster" targetRef="botStart" />
  </bpmn:process>
</bpmn:definitions>
