<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructArtist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellArtistChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chooseColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkRemaining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayRemaining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addToShoppingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plasticReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ARTIST" name="Artist">
        <bpmn:flowNodeRef>createModel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PRINTER" name="Printer">
        <bpmn:flowNodeRef>turnPrinterOnAndHeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generateGcode</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="instructArtist" name="Instruct artist to create a project" />
    <bpmn:task id="sendSketches" name="Send sketches to artist" />
    <bpmn:task id="tellArtistChanges" name="Tell artist what to change until satisfied" />
    <bpmn:task id="createModel" name="Artist creates 3D model (STL)" />
    <bpmn:task id="chooseColor" name="Choose plastic color" />
    <bpmn:exclusiveGateway id="gatewayStock" name="Color in stock?" />
    <bpmn:task id="checkRemaining" name="Check remaining color" />
    <bpmn:exclusiveGateway id="gatewayRemaining" name="Remaining < 100g?" />
    <bpmn:task id="addToShoppingList" name="Add color to shopping list" />
    <bpmn:task id="orderColor" name="Order plastic color" />
    <bpmn:exclusiveGateway id="plasticReady" name="Plastic ready" />
    <bpmn:parallelGateway id="parallelSplit" />
    <bpmn:task id="turnPrinterOnAndHeat" name="Turn printer on and heat up" />
    <bpmn:task id="generateGcode" name="Generate gcode file from STL" />
    <bpmn:parallelGateway id="parallelJoin" />
    <bpmn:task id="printModel" name="Print the model" />
    <bpmn:endEvent id="endEvent" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="instructArtist" />
    <bpmn:sequenceFlow id="f2" sourceRef="instructArtist" targetRef="sendSketches" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendSketches" targetRef="tellArtistChanges" />
    <bpmn:sequenceFlow id="f4" sourceRef="tellArtistChanges" targetRef="createModel" />
    <bpmn:sequenceFlow id="f5" sourceRef="createModel" targetRef="chooseColor" />
    <bpmn:sequenceFlow id="f6" sourceRef="chooseColor" targetRef="gatewayStock" />
    <bpmn:sequenceFlow id="f7" sourceRef="gatewayStock" targetRef="checkRemaining" name="yes" />
    <bpmn:sequenceFlow id="f8" sourceRef="gatewayStock" targetRef="orderColor" name="no" />
    <bpmn:sequenceFlow id="f9" sourceRef="checkRemaining" targetRef="gatewayRemaining" />
    <bpmn:sequenceFlow id="f10" sourceRef="gatewayRemaining" targetRef="addToShoppingList" name="yes" />
    <bpmn:sequenceFlow id="f11" sourceRef="gatewayRemaining" targetRef="plasticReady" name="no" />
    <bpmn:sequenceFlow id="f12" sourceRef="addToShoppingList" targetRef="plasticReady" />
    <bpmn:sequenceFlow id="f13" sourceRef="orderColor" targetRef="plasticReady" />
    <bpmn:sequenceFlow id="f14" sourceRef="plasticReady" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="f15" sourceRef="parallelSplit" targetRef="turnPrinterOnAndHeat" />
    <bpmn:sequenceFlow id="f16" sourceRef="parallelSplit" targetRef="generateGcode" />
    <bpmn:sequenceFlow id="f17" sourceRef="turnPrinterOnAndHeat" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="generateGcode" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="parallelJoin" targetRef="printModel" />
    <bpmn:sequenceFlow id="f20" sourceRef="printModel" targetRef="endEvent" />
  </bpmn:process>
</bpmn:definitions>