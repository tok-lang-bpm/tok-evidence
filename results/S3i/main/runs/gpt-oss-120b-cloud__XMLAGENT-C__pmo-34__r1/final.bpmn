<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Builder" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>developDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderLegoSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveLegoSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buildSubcomponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkNoParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesignSubcomponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebuildSubcomponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assembleSubcomponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Children" name="Children">
        <bpmn:flowNodeRef>sortParts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="developDesign" name="Develop the basic design" />
    <bpmn:task id="orderLegoSets" name="Order certain Lego brick sets" />
    <bpmn:task id="giveLegoSets" name="Give Lego sets to children" />
    <bpmn:task id="sortParts" name="Sort parts into containers" />
    <bpmn:task id="buildSubcomponents" name="Build subcomponents using parts from containers" />
    <bpmn:exclusiveGateway id="checkNoParts" name="No more parts in container?" />
    <bpmn:task id="reorderParts" name="Reorder individual parts" />
    <bpmn:task id="testSubcomponent" name="Test subcomponent" />
    <bpmn:exclusiveGateway id="testResult" name="Test successful?" />
    <bpmn:task id="redesignSubcomponents" name="Redesign subcomponents" />
    <bpmn:task id="rebuildSubcomponents" name="Rebuild subcomponents" />
    <bpmn:task id="assembleSubcomponents" name="Assemble subcomponents" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="developDesign" />
    <bpmn:sequenceFlow id="f2" sourceRef="developDesign" targetRef="orderLegoSets" />
    <bpmn:sequenceFlow id="f3" sourceRef="orderLegoSets" targetRef="giveLegoSets" />
    <bpmn:sequenceFlow id="f4" sourceRef="giveLegoSets" targetRef="sortParts" />
    <bpmn:sequenceFlow id="f5" sourceRef="sortParts" targetRef="buildSubcomponents" />
    <bpmn:sequenceFlow id="f6" sourceRef="buildSubcomponents" targetRef="checkNoParts" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="checkNoParts" targetRef="testSubcomponent" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="checkNoParts" targetRef="reorderParts" />
    <bpmn:sequenceFlow id="f9" sourceRef="reorderParts" targetRef="buildSubcomponents" />
    <bpmn:sequenceFlow id="f10" sourceRef="testSubcomponent" targetRef="testResult" />
    <bpmn:sequenceFlow id="f11" name="success" sourceRef="testResult" targetRef="assembleSubcomponents" />
    <bpmn:sequenceFlow id="f12" name="failure" sourceRef="testResult" targetRef="redesignSubcomponents" />
    <bpmn:sequenceFlow id="f13" sourceRef="redesignSubcomponents" targetRef="rebuildSubcomponents" />
    <bpmn:sequenceFlow id="f14" sourceRef="rebuildSubcomponents" targetRef="testSubcomponent" />
    <bpmn:sequenceFlow id="f15" sourceRef="assembleSubcomponents" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
