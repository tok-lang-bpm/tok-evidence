<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_PROD" name="Production">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveProps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderGuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderChain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMotor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceRemaining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="receiveProps" name="Receive chain saw properties" />
    <bpmn:parallelGateway id="pg_split" />
    <bpmn:task id="orderGuideBar" name="Order guide bar" />
    <bpmn:task id="orderChain" name="Order chain" />
    <bpmn:task id="orderMotor" name="Order motor" />
    <bpmn:parallelGateway id="pg_join" />
    <bpmn:task id="inspect" name="Inspect parts" />
    <bpmn:task id="assemble" name="Assemble parts" />
    <bpmn:task id="sendUpdates" name="Send production updates to customer" />
    <bpmn:task id="sendFirstSaw" name="Send first saw to customer" />
    <bpmn:exclusiveGateway id="decision" name="Customer likes first saw?" />
    <bpmn:task id="produceRemaining" name="Produce remaining saws" />
    <bpmn:endEvent id="endCompleted" name="Order completed" />
    <bpmn:endEvent id="endCancelled" name="Order cancelled" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receiveProps" />
    <bpmn:sequenceFlow id="f2" sourceRef="receiveProps" targetRef="pg_split" />
    <bpmn:sequenceFlow id="f3" sourceRef="pg_split" targetRef="orderGuideBar" />
    <bpmn:sequenceFlow id="f4" sourceRef="pg_split" targetRef="orderChain" />
    <bpmn:sequenceFlow id="f5" sourceRef="pg_split" targetRef="orderMotor" />
    <bpmn:sequenceFlow id="f6" sourceRef="orderGuideBar" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f7" sourceRef="orderChain" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f8" sourceRef="orderMotor" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f9" sourceRef="pg_join" targetRef="inspect" />
    <bpmn:sequenceFlow id="f10" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f11" sourceRef="assemble" targetRef="sendUpdates" />
    <bpmn:sequenceFlow id="f12" sourceRef="sendUpdates" targetRef="sendFirstSaw" />
    <bpmn:sequenceFlow id="f13" sourceRef="sendFirstSaw" targetRef="decision" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="decision" targetRef="produceRemaining" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="decision" targetRef="endCancelled" />
    <bpmn:sequenceFlow id="f16" sourceRef="produceRemaining" targetRef="endCompleted" />
  </bpmn:process>
</bpmn:definitions>
