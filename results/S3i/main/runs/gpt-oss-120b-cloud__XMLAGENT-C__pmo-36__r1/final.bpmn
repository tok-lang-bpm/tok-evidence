<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>selectSpecs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COORDINATOR" name="Coordinator">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveSpecs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manufactureMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_RUSSIAN" name="Russian Team">
        <bpmn:flowNodeRef>vodkaBar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_IRISH" name="Irish Team">
        <bpmn:flowNodeRef>whiskeyBar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ASSEMBLY" name="Assembly Team">
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TEST" name="Test Team">
        <bpmn:flowNodeRef>testFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendProtocol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_DELIVERY" name="Delivery Team">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="selectSpecs" name="Customer selects specifications" />
    <bpmn:task id="receiveSpecs" name="Receive specifications" />
    <bpmn:exclusiveGateway id="gatewayBar" name="Chosen bar type?" />
    <bpmn:task id="vodkaBar" name="Manufacture vodka bar" />
    <bpmn:task id="whiskeyBar" name="Manufacture whiskey bar" />
    <bpmn:exclusiveGateway id="manufactureMerge" name="Manufacturing complete" />
    <bpmn:task id="assemble" name="Assemble interior" />
    <bpmn:task id="testFlight" name="Conduct test flight" />
    <bpmn:task id="sendProtocol" name="Send test protocol to customer and coordinator" />
    <bpmn:task id="deliver" name="Deliver plane to customer" />
    <bpmn:task id="confirm" name="Customer confirms delivery" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectSpecs" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectSpecs" targetRef="receiveSpecs" />
    <bpmn:sequenceFlow id="f3" sourceRef="receiveSpecs" targetRef="gatewayBar" />
    <bpmn:sequenceFlow id="f4" name="vodka" sourceRef="gatewayBar" targetRef="vodkaBar" />
    <bpmn:sequenceFlow id="f5" name="whiskey" sourceRef="gatewayBar" targetRef="whiskeyBar" />
    <bpmn:sequenceFlow id="f6" sourceRef="vodkaBar" targetRef="manufactureMerge" />
    <bpmn:sequenceFlow id="f7" sourceRef="whiskeyBar" targetRef="manufactureMerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="manufactureMerge" targetRef="assemble" />
    <bpmn:sequenceFlow id="f9" sourceRef="assemble" targetRef="testFlight" />
    <bpmn:sequenceFlow id="f10" sourceRef="testFlight" targetRef="sendProtocol" />
    <bpmn:sequenceFlow id="f11" sourceRef="sendProtocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f12" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f13" sourceRef="confirm" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
