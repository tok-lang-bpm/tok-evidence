<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE" name="Project Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>queryShops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shopEnough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderSingle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderSeveral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>startBuilding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderCheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderFast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitReorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endComplain</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="queryShops" name="Query all web shops for parts availability, price and delivery time" />
    <bpmn:task id="createList" name="Create list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="shopEnough" name="Is one shop sufficient?" />
    <bpmn:task id="orderSingle" name="Order parts from selected shop" />
    <bpmn:task id="orderSeveral" name="Order parts from several shops" />
    <bpmn:exclusiveGateway id="orderMerge" name="Order merge" />
    <bpmn:task id="waitParts" name="Wait for parts to arrive (first batch)" />
    <bpmn:task id="startBuilding" name="Start building" />
    <bpmn:exclusiveGateway id="checkStock" name="Check stock level" />
    <bpmn:task id="complain" name="Write mail to friends complaining about the webshops" />
    <bpmn:task id="reorderCheap" name="Reorder parts (cheapest)" />
    <bpmn:task id="reorderFast" name="Reorder parts (fastest)" />
    <bpmn:task id="waitReorder" name="Wait for reordered parts" />
    <bpmn:endEvent id="endComplete" name="Construction completed" />
    <bpmn:endEvent id="endComplain" name="Complaint sent" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="queryShops" />
    <bpmn:sequenceFlow id="f2" sourceRef="queryShops" targetRef="createList" />
    <bpmn:sequenceFlow id="f3" sourceRef="createList" targetRef="shopEnough" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="shopEnough" targetRef="orderSeveral" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="shopEnough" targetRef="orderSingle" />
    <bpmn:sequenceFlow id="f6" sourceRef="orderSingle" targetRef="orderMerge" />
    <bpmn:sequenceFlow id="f7" sourceRef="orderSeveral" targetRef="orderMerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="orderMerge" targetRef="waitParts" />
    <bpmn:sequenceFlow id="f9" sourceRef="waitParts" targetRef="startBuilding" />
    <bpmn:sequenceFlow id="f10" sourceRef="startBuilding" targetRef="checkStock" />
    <bpmn:sequenceFlow id="f11" name="zero" sourceRef="checkStock" targetRef="complain" />
    <bpmn:sequenceFlow id="f12" name="fast" sourceRef="checkStock" targetRef="reorderFast" />
    <bpmn:sequenceFlow id="f13" name="cheap" sourceRef="checkStock" targetRef="reorderCheap" />
    <bpmn:sequenceFlow id="f14" name="enough" sourceRef="checkStock" targetRef="endComplete" />
    <bpmn:sequenceFlow id="f15" sourceRef="reorderFast" targetRef="waitReorder" />
    <bpmn:sequenceFlow id="f16" sourceRef="reorderCheap" targetRef="waitReorder" />
    <bpmn:sequenceFlow id="f17" sourceRef="waitReorder" targetRef="waitParts" />
    <bpmn:sequenceFlow id="f18" sourceRef="complain" targetRef="endComplain" />
  </bpmn:process>
</bpmn:definitions>