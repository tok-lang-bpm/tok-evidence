<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_builder" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1_collect_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2_send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4_refine_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5_create_material_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6_order_materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7_process_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8_send_messages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10_send_invitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11_create_attendee_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_architect" name="Architect">
        <bpmn:flowNodeRef>t3_send_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_friends" name="Friends">
        <bpmn:flowNodeRef>t9_build_house</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1_collect_req" name="Collect requirements" />
    <bpmn:task id="t2_send_req" name="Send requirements to architect" />
    <bpmn:task id="t3_send_draft" name="Send draft to builder" />
    <bpmn:task id="t4_refine_draft" name="Refine draft with additional requirements" />
    <bpmn:task id="t5_create_material_list" name="Create list of needed materials" />
    <bpmn:task id="t6_order_materials" name="Order materials from online stores" />
    <bpmn:parallelGateway id="pg_split" />
    <bpmn:task id="t7_process_order" name="Process material order" />
    <bpmn:task id="t8_send_messages" name="Send messages to friends to build house" />
    <bpmn:task id="t9_build_house" name="Build the house" />
    <bpmn:parallelGateway id="pg_join" />
    <bpmn:task id="t10_send_invitations" name="Send invitations for tree house party" />
    <bpmn:task id="t11_create_attendee_list" name="Create list of party attendees" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="s1" sourceRef="start" targetRef="t1_collect_req" />
    <bpmn:sequenceFlow id="s2" sourceRef="t1_collect_req" targetRef="t2_send_req" />
    <bpmn:sequenceFlow id="s3" sourceRef="t2_send_req" targetRef="t3_send_draft" />
    <bpmn:sequenceFlow id="s4" sourceRef="t3_send_draft" targetRef="t4_refine_draft" />
    <bpmn:sequenceFlow id="s5" sourceRef="t4_refine_draft" targetRef="t5_create_material_list" />
    <bpmn:sequenceFlow id="s6" sourceRef="t5_create_material_list" targetRef="t6_order_materials" />
    <bpmn:sequenceFlow id="s7" sourceRef="t6_order_materials" targetRef="pg_split" />
    <bpmn:sequenceFlow id="s8" sourceRef="pg_split" targetRef="t7_process_order" />
    <bpmn:sequenceFlow id="s9" sourceRef="pg_split" targetRef="t8_send_messages" />
    <bpmn:sequenceFlow id="s10" sourceRef="t8_send_messages" targetRef="t9_build_house" />
    <bpmn:sequenceFlow id="s11" sourceRef="t9_build_house" targetRef="pg_join" />
    <bpmn:sequenceFlow id="s12" sourceRef="t7_process_order" targetRef="pg_join" />
    <bpmn:sequenceFlow id="s13" sourceRef="pg_join" targetRef="t10_send_invitations" />
    <bpmn:sequenceFlow id="s14" sourceRef="t10_send_invitations" targetRef="t11_create_attendee_list" />
    <bpmn:sequenceFlow id="s15" sourceRef="t11_create_attendee_list" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>