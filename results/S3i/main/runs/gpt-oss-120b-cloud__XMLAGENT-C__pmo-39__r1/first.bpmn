<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="USER" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquireDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquireStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contactFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquireJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attemptRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repairDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="TOOL" name="Tool">
        <bpmn:flowNodeRef>receiveLists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveInstructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="enterModel" name="Enter model and what is broken" />
    <bpmn:task id="receiveLists" name="Receive lists of materials, tools, and ordering choices" />
    <bpmn:exclusiveGateway id="acquireDecision" name="Acquisition needed?" />
    <bpmn:parallelGateway id="acquireStart" />
    <bpmn:task id="contactFriends" name="Contact friends to borrow or buy items" />
    <bpmn:task id="buyItems" name="Buy remaining items" />
    <bpmn:parallelGateway id="acquireJoin" />
    <bpmn:task id="receiveInstructions" name="Receive repair instructions" />
    <bpmn:task id="attemptRepair" name="Attempt repair" />
    <bpmn:exclusiveGateway id="repairDecision" name="Repair successful?" />
    <bpmn:task id="sendReview" name="Send review and video" />
    <bpmn:task id="sendExpert" name="Send phone to expert" />
    <bpmn:endEvent id="endSuccess" name="Process completed successfully" />
    <bpmn:endEvent id="endFail" name="Process ended with expert assistance" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enterModel" />
    <bpmn:sequenceFlow id="f2" sourceRef="enterModel" targetRef="receiveLists" />
    <bpmn:sequenceFlow id="f3" sourceRef="receiveLists" targetRef="acquireDecision" />
    <bpmn:sequenceFlow id="f4" name="need items" sourceRef="acquireDecision" targetRef="acquireStart" />
    <bpmn:sequenceFlow id="f5" name="already have" sourceRef="acquireDecision" targetRef="receiveInstructions" />
    <bpmn:sequenceFlow id="f6" sourceRef="acquireStart" targetRef="contactFriends" />
    <bpmn:sequenceFlow id="f7" sourceRef="acquireStart" targetRef="buyItems" />
    <bpmn:sequenceFlow id="f8" sourceRef="contactFriends" targetRef="acquireJoin" />
    <bpmn:sequenceFlow id="f9" sourceRef="buyItems" targetRef="acquireJoin" />
    <bpmn:sequenceFlow id="f10" sourceRef="acquireJoin" targetRef="receiveInstructions" />
    <bpmn:sequenceFlow id="f11" sourceRef="receiveInstructions" targetRef="attemptRepair" />
    <bpmn:sequenceFlow id="f12" sourceRef="attemptRepair" targetRef="repairDecision" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="repairDecision" targetRef="sendReview" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="repairDecision" targetRef="sendExpert" />
    <bpmn:sequenceFlow id="f15" sourceRef="sendReview" targetRef="endSuccess" />
    <bpmn:sequenceFlow id="f16" sourceRef="sendExpert" targetRef="endFail" />
  </bpmn:process>
</bpmn:definitions>