<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calcOEE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayOEE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopMachine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayMachineEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endProcess</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="collectInfo" name="Collect relevant information from machine" />
    <bpmn:task id="calcOEE" name="Calculate the Overall Equipment Efficiency (OEE)" />
    <bpmn:exclusiveGateway id="gatewayOEE" name="Is OEE below threshold?" />
    <bpmn:task id="stopMachine" name="Stop the machine" />
    <bpmn:task id="sendEmail" name="Send email to engineer" />
    <bpmn:exclusiveGateway id="gatewayMachineEvent" name="Is machine restarted?" />
    <bpmn:endEvent id="endProcess" name="End Process" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collectInfo" />
    <bpmn:sequenceFlow id="f2" sourceRef="collectInfo" targetRef="calcOEE" />
    <bpmn:sequenceFlow id="f3" sourceRef="calcOEE" targetRef="gatewayOEE" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gatewayOEE" targetRef="stopMachine" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gatewayOEE" targetRef="collectInfo" />
    <bpmn:sequenceFlow id="f6" sourceRef="stopMachine" targetRef="sendEmail" />
    <bpmn:sequenceFlow id="f7" sourceRef="sendEmail" targetRef="gatewayMachineEvent" />
    <bpmn:sequenceFlow id="f8" name="restart" sourceRef="gatewayMachineEvent" targetRef="collectInfo" />
    <bpmn:sequenceFlow id="f9" name="disconnect" sourceRef="gatewayMachineEvent" targetRef="endProcess" />
  </bpmn:process>
</bpmn:definitions>
