<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="inspection-process" />
  </bpmn:collaboration>
  <bpmn:process id="inspection-process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="userLane" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answerQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pressButtons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endYes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start inspection" />
    <bpmn:task id="enterData" name="Enter machine type and serial number" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="answerQuestions" name="Answer questions and input values" />
    <bpmn:task id="pressButtons" name="Press buttons and collect values" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="decision" name="Additional questions needed?" />
    <bpmn:task id="additionalQuestions" name="Answer additional questions" />
    <bpmn:endEvent id="endYes" name="Inspection complete with additional questions" />
    <bpmn:endEvent id="endNo" name="Inspection complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enterData" />
    <bpmn:sequenceFlow id="f2" sourceRef="enterData" targetRef="split" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="answerQuestions" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="pressButtons" />
    <bpmn:sequenceFlow id="f5" sourceRef="answerQuestions" targetRef="join" />
    <bpmn:sequenceFlow id="f6" sourceRef="pressButtons" targetRef="join" />
    <bpmn:sequenceFlow id="f7" sourceRef="join" targetRef="decision" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="decision" targetRef="additionalQuestions" />
    <bpmn:sequenceFlow id="f9" sourceRef="additionalQuestions" targetRef="endYes" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="decision" targetRef="endNo" />
  </bpmn:process>
</bpmn:definitions>
