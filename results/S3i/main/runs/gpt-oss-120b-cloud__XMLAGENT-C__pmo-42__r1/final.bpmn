<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribeSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SERVICE_CENTER" name="Service Center">
        <bpmn:flowNodeRef>Task_SelectFacility</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SERVICE_FACILITY" name="Service Facility">
        <bpmn:flowNodeRef>Task_MakeAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaveWithoutRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Fridge produces strange noises" />
    <bpmn:task id="Task_DescribeSend" name="Describe symptoms and send to central service center" />
    <bpmn:task id="Task_SelectFacility" name="Select local service facility" />
    <bpmn:task id="Task_MakeAppointment" name="Make appointment" />
    <bpmn:task id="Task_Arrive" name="Arrive at customer location" />
    <bpmn:exclusiveGateway id="Gateway_PartsDecision" name="Parts available?" />
    <bpmn:task id="Task_LeaveWithoutRepair" name="Leave without repairing (need additional parts)" />
    <bpmn:task id="Task_Repair" name="Repair fridge" />
    <bpmn:task id="Task_ConfirmOK" name="Confirm fridge is OK" />
    <bpmn:task id="Task_Rate" name="Rate service facility" />
    <bpmn:endEvent id="End_Completed" name="Service completed" />
    <bpmn:endEvent id="End_NotCompleted" name="Service not completed" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_DescribeSend" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_DescribeSend" targetRef="Task_SelectFacility" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_SelectFacility" targetRef="Task_MakeAppointment" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_MakeAppointment" targetRef="Task_Arrive" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Arrive" targetRef="Gateway_PartsDecision" />
    <bpmn:sequenceFlow id="F6_yes" name="yes" sourceRef="Gateway_PartsDecision" targetRef="Task_Repair" />
    <bpmn:sequenceFlow id="F7_no" name="no" sourceRef="Gateway_PartsDecision" targetRef="Task_LeaveWithoutRepair" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Repair" targetRef="Task_ConfirmOK" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_ConfirmOK" targetRef="Task_Rate" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Rate" targetRef="End_Completed" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_LeaveWithoutRepair" targetRef="End_NotCompleted" />
  </bpmn:process>
</bpmn:definitions>
