<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_userDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_notRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_fine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_user" name="User">
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mechanic" name="Mechanic">
        <bpmn:flowNodeRef>t_enterProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recordRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nextService</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Service necessary" />
    <bpmn:task id="t_check" name="Check if car is still registered" />
    <bpmn:exclusiveGateway id="gw_registered" name="Car registered?" />
    <bpmn:task id="t_notify" name="Notify user" />
    <bpmn:exclusiveGateway id="gw_userDecision" name="User attends service?" />
    <bpmn:task id="t_fine" name="Fine after 30 days" />
    <bpmn:endEvent id="end_fine" name="Process ended with fine" />
    <bpmn:task id="t_enterProblems" name="Enter car problems" />
    <bpmn:parallelGateway id="pg_split" name="Parallel split" />
    <bpmn:task id="t_status" name="Send status updates via email" />
    <bpmn:task id="t_repair" name="Repair completed" />
    <bpmn:parallelGateway id="pg_join" name="Parallel join" />
    <bpmn:task id="t_pay" name="Pay through the app" />
    <bpmn:task id="t_recordRepair" name="Enter successful repair and Pickerl" />
    <bpmn:task id="t_nextService" name="Enter next service time" />
    <bpmn:endEvent id="end_success" name="Process completed" />
    <bpmn:endEvent id="end_notRegistered" name="Not registered - process ends" />
    <!-- sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_check" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_check" targetRef="gw_registered" />
    <bpmn:sequenceFlow id="f3_yes" name="yes" sourceRef="gw_registered" targetRef="t_notify" />
    <bpmn:sequenceFlow id="f3_no" name="no" sourceRef="gw_registered" targetRef="end_notRegistered" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_notify" targetRef="gw_userDecision" />
    <bpmn:sequenceFlow id="f5_yes" name="go" sourceRef="gw_userDecision" targetRef="t_enterProblems" />
    <bpmn:sequenceFlow id="f5_no" name="no" sourceRef="gw_userDecision" targetRef="t_fine" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_fine" targetRef="end_fine" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_enterProblems" targetRef="pg_split" />
    <bpmn:sequenceFlow id="f8" sourceRef="pg_split" targetRef="t_status" />
    <bpmn:sequenceFlow id="f9" sourceRef="pg_split" targetRef="t_repair" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_status" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_repair" targetRef="pg_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="pg_join" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_pay" targetRef="t_recordRepair" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_recordRepair" targetRef="t_nextService" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_nextService" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>