<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_ROBOT" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Robot receives an order" />
    <bpmn:exclusiveGateway id="gw_menu" name="Menu or just burger?" />
    <bpmn:parallelGateway id="pg_split1" />
    <bpmn:task id="prepare_drink" name="Prepare the drink" />
    <bpmn:exclusiveGateway id="gw_fries" name="Fries or wedges?" />
    <bpmn:task id="prepare_fries" name="Prepare fries" />
    <bpmn:task id="prepare_wedges" name="Prepare wedges" />
    <bpmn:parallelGateway id="pg_join1" />
    <bpmn:task id="prepare_burger" name="Prepare the burger" />
    <bpmn:task id="deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="end" name="Order completed" />
    <bpmn:sequenceFlow id="f_start_menu" sourceRef="start" targetRef="gw_menu" />
    <bpmn:sequenceFlow id="f_menu_yes" name="menu" sourceRef="gw_menu" targetRef="pg_split1" />
    <bpmn:sequenceFlow id="f_menu_no" name="just burger" sourceRef="gw_menu" targetRef="prepare_burger" />
    <bpmn:sequenceFlow id="f_split_drink" sourceRef="pg_split1" targetRef="prepare_drink" />
    <bpmn:sequenceFlow id="f_split_fries" sourceRef="pg_split1" targetRef="gw_fries" />
    <bpmn:sequenceFlow id="f_fries_yes" name="fries" sourceRef="gw_fries" targetRef="prepare_fries" />
    <bpmn:sequenceFlow id="f_fries_no" name="wedges" sourceRef="gw_fries" targetRef="prepare_wedges" />
    <bpmn:sequenceFlow id="f_drink_join" sourceRef="prepare_drink" targetRef="pg_join1" />
    <bpmn:sequenceFlow id="f_fries_join" sourceRef="prepare_fries" targetRef="pg_join1" />
    <bpmn:sequenceFlow id="f_wedges_join" sourceRef="prepare_wedges" targetRef="pg_join1" />
    <bpmn:sequenceFlow id="f_join_burger" sourceRef="pg_join1" targetRef="prepare_burger" />
    <bpmn:sequenceFlow id="f_burger_deliver" sourceRef="prepare_burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f_deliver_end" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>