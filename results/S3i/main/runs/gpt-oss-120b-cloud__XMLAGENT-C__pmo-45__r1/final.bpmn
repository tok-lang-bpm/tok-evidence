<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Online Shop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tSelectProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tAddToCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tSaveProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tEnterPaymentData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tEnterShippingAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tEnterBillingAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endLoginFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="E-Shop System">
        <bpmn:flowNodeRef>tCheckCredentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gLoginSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tCheckAllProductsSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAllProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pParallelSplit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tWaitBankConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tPrepareShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tFinalizeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAddressCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="s0" name="Start" />
    <bpmn:task id="tLogin" name="Customer logs into E-Shop system" />
    <bpmn:task id="tCheckCredentials" name="System checks credentials" />
    <bpmn:exclusiveGateway id="gLoginSuccess" name="Login successful?" />
    <bpmn:endEvent id="endLoginFailed" name="Shopping experience stopped" />
    <bpmn:task id="tSelectProduct" name="Customer selects product" />
    <bpmn:task id="tAddToCart" name="Customer adds product to shopping cart" />
    <bpmn:task id="tSaveProduct" name="Customer saves product" />
    <bpmn:task id="tCheckAllProductsSelected" name="System checks if all products selected" />
    <bpmn:exclusiveGateway id="gAllProducts" name="All products selected?" />
    <bpmn:parallelGateway id="pParallelSplit1" name="Prepare payment and shipment" />
    <bpmn:task id="tEnterPaymentData" name="Customer enters payment data" />
    <bpmn:task id="tWaitBankConfirmation" name="System waits for bank confirmation" />
    <bpmn:task id="tEnterShippingAddress" name="Customer enters shipping address" />
    <bpmn:exclusiveGateway id="gAddressCheck" name="Shipping address equals billing address?" />
    <bpmn:task id="tEnterBillingAddress" name="Customer enters billing address" />
    <bpmn:task id="tPrepareShipment" name="System prepares shipment" />
    <bpmn:parallelGateway id="pParallelJoin" name="Join payment, address and shipment" />
    <bpmn:task id="tFinalizeOrder" name="System finalizes order" />
    <bpmn:endEvent id="endProcess" name="Order completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f0" sourceRef="s0" targetRef="tLogin" />
    <bpmn:sequenceFlow id="f1" sourceRef="tLogin" targetRef="tCheckCredentials" />
    <bpmn:sequenceFlow id="f2" sourceRef="tCheckCredentials" targetRef="gLoginSuccess" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gLoginSuccess" targetRef="tSelectProduct" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gLoginSuccess" targetRef="endLoginFailed" />
    <bpmn:sequenceFlow id="f5" sourceRef="tSelectProduct" targetRef="tAddToCart" />
    <bpmn:sequenceFlow id="f6" sourceRef="tAddToCart" targetRef="tSaveProduct" />
    <bpmn:sequenceFlow id="f7" sourceRef="tSaveProduct" targetRef="tCheckAllProductsSelected" />
    <bpmn:sequenceFlow id="f8" sourceRef="tCheckAllProductsSelected" targetRef="gAllProducts" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gAllProducts" targetRef="pParallelSplit1" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gAllProducts" targetRef="tSelectProduct" />
    <bpmn:sequenceFlow id="f11" sourceRef="pParallelSplit1" targetRef="tEnterPaymentData" />
    <bpmn:sequenceFlow id="f12" sourceRef="pParallelSplit1" targetRef="tEnterShippingAddress" />
    <bpmn:sequenceFlow id="f13" sourceRef="pParallelSplit1" targetRef="tPrepareShipment" />
    <bpmn:sequenceFlow id="f14" sourceRef="tEnterPaymentData" targetRef="tWaitBankConfirmation" />
    <bpmn:sequenceFlow id="f15" sourceRef="tEnterShippingAddress" targetRef="gAddressCheck" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="gAddressCheck" targetRef="tPrepareShipment" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="gAddressCheck" targetRef="tEnterBillingAddress" />
    <bpmn:sequenceFlow id="f18" sourceRef="tEnterBillingAddress" targetRef="tPrepareShipment" />
    <bpmn:sequenceFlow id="f19" sourceRef="tWaitBankConfirmation" targetRef="pParallelJoin" />
    <bpmn:sequenceFlow id="f20" sourceRef="tPrepareShipment" targetRef="pParallelJoin" />
    <bpmn:sequenceFlow id="f21" sourceRef="pParallelJoin" targetRef="tFinalizeOrder" />
    <bpmn:sequenceFlow id="f22" sourceRef="tFinalizeOrder" targetRef="endProcess" />
  </bpmn:process>
</bpmn:definitions>
