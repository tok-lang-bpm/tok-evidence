<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_USER" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoSlots</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>gwSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAccountReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start registration" />
    <bpmn:task id="selectCourse" name="Select a course" />
    <bpmn:exclusiveGateway id="gwSlots" name="Slots free?" />
    <bpmn:task id="tellCourses" name="System tells courses and dates" />
    <bpmn:task id="selectOne" name="Select one" />
    <bpmn:exclusiveGateway id="gwAccount" name="Have account?" />
    <bpmn:exclusiveGateway id="gwUniversity" name="Eligible university?" />
    <bpmn:task id="registerAccount" name="Register your account" />
    <bpmn:task id="requestActivation" name="Request activation" />
    <bpmn:task id="waitActivation" name="Wait for activation response" />
    <bpmn:exclusiveGateway id="gwAccountReady" name="Account ready" />
    <bpmn:task id="login" name="Log into account" />
    <bpmn:parallelGateway id="pgStart" />
    <bpmn:task id="tweetFriends" name="Tweet to friends" />
    <bpmn:task id="completeReg" name="Complete registration and provide payment information" />
    <bpmn:parallelGateway id="pgEnd" />
    <bpmn:task id="receiveTicket" name="Receive course ticket" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:endEvent id="endNoSlots" name="No slots available" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectCourse" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectCourse" targetRef="gwSlots" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gwSlots" targetRef="tellCourses" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gwSlots" targetRef="endNoSlots" />
    <bpmn:sequenceFlow id="f5" sourceRef="tellCourses" targetRef="selectOne" />
    <bpmn:sequenceFlow id="f6" sourceRef="selectOne" targetRef="gwAccount" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gwAccount" targetRef="login" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gwAccount" targetRef="gwUniversity" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gwUniversity" targetRef="registerAccount" />
    <bpmn:sequenceFlow id="f10" sourceRef="registerAccount" targetRef="gwAccountReady" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="gwUniversity" targetRef="requestActivation" />
    <bpmn:sequenceFlow id="f12" sourceRef="requestActivation" targetRef="waitActivation" />
    <bpmn:sequenceFlow id="f13" sourceRef="waitActivation" targetRef="gwAccountReady" />
    <bpmn:sequenceFlow id="f14" sourceRef="gwAccountReady" targetRef="login" />
    <bpmn:sequenceFlow id="f15" sourceRef="login" targetRef="pgStart" />
    <bpmn:sequenceFlow id="f16" sourceRef="pgStart" targetRef="tweetFriends" />
    <bpmn:sequenceFlow id="f17" sourceRef="pgStart" targetRef="completeReg" />
    <bpmn:sequenceFlow id="f18" sourceRef="tweetFriends" targetRef="pgEnd" />
    <bpmn:sequenceFlow id="f19" sourceRef="completeReg" targetRef="pgEnd" />
    <bpmn:sequenceFlow id="f20" sourceRef="pgEnd" targetRef="receiveTicket" />
    <bpmn:sequenceFlow id="f21" sourceRef="receiveTicket" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
