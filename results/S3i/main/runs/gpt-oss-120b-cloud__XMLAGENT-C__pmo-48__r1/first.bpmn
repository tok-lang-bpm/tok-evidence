<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_RUNNER" name="Runner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RunMeasure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TrainCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GetNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WorkTimeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GoHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LeaveWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RunRace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start" />
    <bpmn:task id="SelectBlock" name="Select a starting block" />
    <bpmn:task id="RunMeasure" name="Run for 5km and measure the time" />
    <bpmn:exclusiveGateway id="CheckTime" name="Time < 25 minutes?" />
    <bpmn:task id="TrainCheck" name="Train and check until goal achieved" />
    <bpmn:task id="GetNumber" name="Get your starting number" />
    <bpmn:exclusiveGateway id="WorkTimeDecision" name="More than one hour left before workday ends?" />
    <bpmn:task id="GoHome" name="Go there from home" />
    <bpmn:task id="LeaveWork" name="Leave directly from work" />
    <bpmn:parallelGateway id="ParallelStart" />
    <bpmn:task id="RunRace" name="Run at the Night Run" />
    <bpmn:task id="Drink" name="Drink" />
    <bpmn:parallelGateway id="ParallelEnd" />
    <bpmn:task id="ReceiveTime" name="Receive final running time" />
    <bpmn:endEvent id="End" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="SelectBlock" />
    <bpmn:sequenceFlow id="f2" sourceRef="SelectBlock" targetRef="RunMeasure" />
    <bpmn:sequenceFlow id="f3" sourceRef="RunMeasure" targetRef="CheckTime" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="CheckTime" targetRef="GetNumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><![CDATA[time < 25]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="CheckTime" targetRef="TrainCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><![CDATA[time >= 25]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" sourceRef="TrainCheck" targetRef="RunMeasure" />
    <bpmn:sequenceFlow id="f7" sourceRef="GetNumber" targetRef="WorkTimeDecision" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="WorkTimeDecision" targetRef="GoHome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><![CDATA[workTimeLeft > 1h]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="WorkTimeDecision" targetRef="LeaveWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><![CDATA[workTimeLeft <= 1h]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="GoHome" targetRef="ParallelStart" />
    <bpmn:sequenceFlow id="f11" sourceRef="LeaveWork" targetRef="ParallelStart" />
    <bpmn:sequenceFlow id="f12" sourceRef="ParallelStart" targetRef="RunRace" />
    <bpmn:sequenceFlow id="f13" sourceRef="ParallelStart" targetRef="Drink" />
    <bpmn:sequenceFlow id="f14" sourceRef="RunRace" targetRef="ParallelEnd" />
    <bpmn:sequenceFlow id="f15" sourceRef="Drink" targetRef="ParallelEnd" />
    <bpmn:sequenceFlow id="f16" sourceRef="ParallelEnd" targetRef="ReceiveTime" />
    <bpmn:sequenceFlow id="f17" sourceRef="ReceiveTime" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>