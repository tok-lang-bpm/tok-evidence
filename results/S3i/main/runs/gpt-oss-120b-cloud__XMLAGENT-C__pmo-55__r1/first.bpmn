<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="doctorLane" name="Doctor">
        <!-- flowNodeRef entries will be added later -->
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:parallelGateway id="prepSplit" name="Preparation split" />
    <bpmn:task id="prepImple" name="Prepare implements" />
    <bpmn:task id="washHands" name="Wash hands" />
    <bpmn:task id="donSterileClothes" name="Don sterile clothes" />
    <bpmn:parallelGateway id="prepJoin" name="Preparation join" />
    <bpmn:task id="cleanArea" name="Clean puncture area" />
    <bpmn:task id="drapeZone" name="Drape puncture zone" />
    <bpmn:task id="configUS" name="Configure ultrasound" />
    <bpmn:task id="gelProbe" name="Put gel in probe" />
    <bpmn:task id="coverProbe" name="Cover probe" />
    <bpmn:task id="sterileGel" name="Put sterile gel" />
    <bpmn:task id="positionProbe" name="Position probe" />
    <bpmn:task id="positionPatient" name="Position patient" />
    <bpmn:exclusiveGateway id="veinIdGateway" name="Vein identification method" />
    <bpmn:task id="identifyAnatomic" name="Identify vein (anatomic)" />
    <bpmn:task id="identifyDoppler" name="Identify vein (doppler)" />
    <bpmn:task id="identifyCompression" name="Identify vein (compression)" />
    <bpmn:exclusiveGateway id="veinIdMerge" name="Vein identification merge" />
    <bpmn:task id="anesthetize" name="Anesthetize patient" />
    <bpmn:task id="puncture" name="Puncture patient" />
    <bpmn:task id="checkBlood" name="Check blood return" />
    <bpmn:exclusiveGateway id="bloodReturnGateway" name="Blood return correct?" />
    <bpmn:task id="dropProbe" name="Drop probe" />
    <bpmn:task id="removeSyringe" name="Remove syringe" />
    <bpmn:task id="installGuidewire" name="Install guidewire" />
    <bpmn:task id="removeTrocar" name="Remove trocar" />
    <bpmn:exclusiveGateway id="wireCheckMethodGateway" name="Wire check method" />
    <bpmn:task id="checkWireLong" name="Check wire (long axis)" />
    <bpmn:task id="checkWireShort" name="Check wire (short axis)" />
    <bpmn:exclusiveGateway id="wireCheckMerge" name="Wire check merge" />
    <bpmn:task id="checkWirePos" name="Check wire position" />
    <bpmn:exclusiveGateway id="wirePosGateway" name="Wire position good?" />
    <bpmn:task id="widenPath" name="Widen pathway" />
    <bpmn:task id="advanceCatheter" name="Advance catheter" />
    <bpmn:task id="removeGuidewire" name="Remove guidewire" />
    <bpmn:task id="verifyFlow" name="Verify flow and reflow" />
    <bpmn:task id="checkCatheterPos" name="Check catheter position" />
    <bpmn:endEvent id="end" name="End" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f_start_prepSplit" sourceRef="start" targetRef="prepSplit" />
    <bpmn:sequenceFlow id="f_split_imp" sourceRef="prepSplit" targetRef="prepImple" />
    <bpmn:sequenceFlow id="f_split_wash" sourceRef="prepSplit" targetRef="washHands" />
    <bpmn:sequenceFlow id="f_split_don" sourceRef="prepSplit" targetRef="donSterileClothes" />
    <bpmn:sequenceFlow id="f_imp_join" sourceRef="prepImple" targetRef="prepJoin" />
    <bpmn:sequenceFlow id="f_wash_join" sourceRef="washHands" targetRef="prepJoin" />
    <bpmn:sequenceFlow id="f_don_join" sourceRef="donSterileClothes" targetRef="prepJoin" />
    <bpmn:sequenceFlow id="f_join_clean" sourceRef="prepJoin" targetRef="cleanArea" />
    <bpmn:sequenceFlow id="f_clean_drape" sourceRef="cleanArea" targetRef="drapeZone" />
    <bpmn:sequenceFlow id="f_drape_config" sourceRef="drapeZone" targetRef="configUS" />
    <bpmn:sequenceFlow id="f_config_gel" sourceRef="configUS" targetRef="gelProbe" />
    <bpmn:sequenceFlow id="f_gel_cover" sourceRef="gelProbe" targetRef="coverProbe" />
    <bpmn:sequenceFlow id="f_cover_sterile" sourceRef="coverProbe" targetRef="sterileGel" />
    <bpmn:sequenceFlow id="f_sterile_positionProbe" sourceRef="sterileGel" targetRef="positionProbe" />
    <bpmn:sequenceFlow id="f_positionProbe_positionPatient" sourceRef="positionProbe" targetRef="positionPatient" />
    <bpmn:sequenceFlow id="f_positionPatient_veinId" sourceRef="positionPatient" targetRef="veinIdGateway" />
    <bpmn:sequenceFlow id="f_vein_anatomic" sourceRef="veinIdGateway" targetRef="identifyAnatomic" name="anatomic" />
    <bpmn:sequenceFlow id="f_vein_doppler" sourceRef="veinIdGateway" targetRef="identifyDoppler" name="doppler" />
    <bpmn:sequenceFlow id="f_vein_compression" sourceRef="veinIdGateway" targetRef="identifyCompression" name="compression" />
    <bpmn:sequenceFlow id="f_anatomic_merge" sourceRef="identifyAnatomic" targetRef="veinIdMerge" />
    <bpmn:sequenceFlow id="f_doppler_merge" sourceRef="identifyDoppler" targetRef="veinIdMerge" />
    <bpmn:sequenceFlow id="f_compression_merge" sourceRef="identifyCompression" targetRef="veinIdMerge" />
    <bpmn:sequenceFlow id="f_merge_anesthetize" sourceRef="veinIdMerge" targetRef="anesthetize" />
    <bpmn:sequenceFlow id="f_anesthetize_puncture" sourceRef="anesthetize" targetRef="puncture" />
    <bpmn:sequenceFlow id="f_puncture_checkBlood" sourceRef="puncture" targetRef="checkBlood" />
    <bpmn:sequenceFlow id="f_checkBlood_gateway" sourceRef="checkBlood" targetRef="bloodReturnGateway" />
    <bpmn:sequenceFlow id="f_blood_correct" sourceRef="bloodReturnGateway" targetRef="dropProbe" name="correct" />
    <bpmn:sequenceFlow id="f_blood_incorrect" sourceRef="bloodReturnGateway" targetRef="puncture" name="incorrect" />
    <bpmn:sequenceFlow id="f_drop_removeSyringe" sourceRef="dropProbe" targetRef="removeSyringe" />
    <bpmn:sequenceFlow id="f_removeSyringe_installGuidewire" sourceRef="removeSyringe" targetRef="installGuidewire" />
    <bpmn:sequenceFlow id="f_installGuidewire_removeTrocar" sourceRef="installGuidewire" targetRef="removeTrocar" />
    <bpmn:sequenceFlow id="f_removeTrocar_wireCheck" sourceRef="removeTrocar" targetRef="wireCheckMethodGateway" />
    <bpmn:sequenceFlow id="f_wire_long" sourceRef="wireCheckMethodGateway" targetRef="checkWireLong" name="long axis" />
    <bpmn:sequenceFlow id="f_wire_short" sourceRef="wireCheckMethodGateway" targetRef="checkWireShort" name="short axis" />
    <bpmn:sequenceFlow id="f_long_merge" sourceRef="checkWireLong" targetRef="wireCheckMerge" />
    <bpmn:sequenceFlow id="f_short_merge" sourceRef="checkWireShort" targetRef="wireCheckMerge" />
    <bpmn:sequenceFlow id="f_merge_checkPos" sourceRef="wireCheckMerge" targetRef="checkWirePos" />
    <bpmn:sequenceFlow id="f_checkPos_gateway" sourceRef="checkWirePos" targetRef="wirePosGateway" />
    <bpmn:sequenceFlow id="f_wire_good" sourceRef="wirePosGateway" targetRef="widenPath" name="good" />
    <bpmn:sequenceFlow id="f_wire_bad" sourceRef="wirePosGateway" targetRef="puncture" name="bad" />
    <bpmn:sequenceFlow id="f_widen_advance" sourceRef="widenPath" targetRef="advanceCatheter" />
    <bpmn:sequenceFlow id="f_advance_removeGuidewire" sourceRef="advanceCatheter" targetRef="removeGuidewire" />
    <bpmn:sequenceFlow id="f_removeGuidewire_verify" sourceRef="removeGuidewire" targetRef="verifyFlow" />
    <bpmn:sequenceFlow id="f_verify_checkCatheter" sourceRef="verifyFlow" targetRef="checkCatheterPos" />
    <bpmn:sequenceFlow id="f_checkCatheter_end" sourceRef="checkCatheterPos" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>