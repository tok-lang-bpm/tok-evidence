tok 1.0 "New hire process"

pool org "Organisation"
  lane dept "Department"
    start need "Need for a new hire"
    task identify "Identify the need for a new hire"
    task choose "Choose the candidate"
    task integrate "Integrate the new hire into the team"
    end done "New hire fully integrated"
  lane hr "HR"
    task create "Create the job description"
    task post "Post the job description on job boards"
    task collect "Collect the resumes"
    task screen "Screen the resumes"
    task phone "Conduct the initial phone interviews"
    task invite "Invite the selected candidates for interviews"
    xor pref "Candidate's preferred interview format?"
    task inperson "Conduct the in-person interview"
    task virtual "Conduct the virtual interview"
    xor pref_end
    task offer "Extend the offer"
    xor neg "Salary negotiation needed?"
    task negotiate "Negotiate the salary"
    xor neg_end
    and onb
    task paper "Complete the paperwork"
    task orient "Hold the orientation"
    task train "Provide the training"
    and onb_end
  lane candidate "Candidate"
    task accept "Accept the offer"

flow need -> identify -> create -> post -> collect -> screen -> phone -> invite -> pref
flow pref -> inperson "in person"
flow pref -> virtual "virtual"
flow inperson -> pref_end
flow virtual -> pref_end
flow pref_end -> choose -> offer -> neg
flow neg -> negotiate "yes"
flow neg -> neg_end "no"
flow negotiate -> neg_end
flow neg_end -> accept -> onb
flow onb -> paper -> onb_end
flow onb -> orient -> onb_end
flow onb -> train -> onb_end
flow onb_end -> integrate -> done
