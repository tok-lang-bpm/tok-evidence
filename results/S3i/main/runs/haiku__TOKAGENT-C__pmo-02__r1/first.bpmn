<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New hire process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="New hire process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pref_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onb_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="candidate" name="Candidate">
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new hire" />
    <bpmn:task id="identify" name="Identify the need for a new hire" />
    <bpmn:task id="choose" name="Choose the candidate" />
    <bpmn:task id="integrate" name="Integrate the new hire into the team" />
    <bpmn:endEvent id="done" name="New hire fully integrated" />
    <bpmn:task id="create" name="Create the job description" />
    <bpmn:task id="post" name="Post the job description on job boards" />
    <bpmn:task id="collect" name="Collect the resumes" />
    <bpmn:task id="screen" name="Screen the resumes" />
    <bpmn:task id="phone" name="Conduct the initial phone interviews" />
    <bpmn:task id="invite" name="Invite the selected candidates for interviews" />
    <bpmn:exclusiveGateway id="pref" name="Candidate's preferred interview format?" />
    <bpmn:task id="inperson" name="Conduct the in-person interview" />
    <bpmn:task id="virtual" name="Conduct the virtual interview" />
    <bpmn:exclusiveGateway id="pref_end" />
    <bpmn:task id="offer" name="Extend the offer" />
    <bpmn:exclusiveGateway id="neg" name="Salary negotiation needed?" />
    <bpmn:task id="negotiate" name="Negotiate the salary" />
    <bpmn:exclusiveGateway id="neg_end" />
    <bpmn:parallelGateway id="onb" />
    <bpmn:task id="paper" name="Complete the paperwork" />
    <bpmn:task id="orient" name="Hold the orientation" />
    <bpmn:task id="train" name="Provide the training" />
    <bpmn:parallelGateway id="onb_end" />
    <bpmn:task id="accept" name="Accept the offer" />
    <bpmn:sequenceFlow id="f-need-identify" sourceRef="need" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-post" sourceRef="create" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-invite" sourceRef="phone" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-pref" sourceRef="invite" targetRef="pref" />
    <bpmn:sequenceFlow id="f-pref-inperson" name="in person" sourceRef="pref" targetRef="inperson" />
    <bpmn:sequenceFlow id="f-pref-virtual" name="virtual" sourceRef="pref" targetRef="virtual" />
    <bpmn:sequenceFlow id="f-inperson-pref_end" sourceRef="inperson" targetRef="pref_end" />
    <bpmn:sequenceFlow id="f-virtual-pref_end" sourceRef="virtual" targetRef="pref_end" />
    <bpmn:sequenceFlow id="f-pref_end-choose" sourceRef="pref_end" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-offer" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-neg" sourceRef="offer" targetRef="neg" />
    <bpmn:sequenceFlow id="f-neg-negotiate" name="yes" sourceRef="neg" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-neg-neg_end" name="no" sourceRef="neg" targetRef="neg_end" />
    <bpmn:sequenceFlow id="f-negotiate-neg_end" sourceRef="negotiate" targetRef="neg_end" />
    <bpmn:sequenceFlow id="f-neg_end-accept" sourceRef="neg_end" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-onb" sourceRef="accept" targetRef="onb" />
    <bpmn:sequenceFlow id="f-onb-paper" sourceRef="onb" targetRef="paper" />
    <bpmn:sequenceFlow id="f-paper-onb_end" sourceRef="paper" targetRef="onb_end" />
    <bpmn:sequenceFlow id="f-onb-orient" sourceRef="onb" targetRef="orient" />
    <bpmn:sequenceFlow id="f-orient-onb_end" sourceRef="orient" targetRef="onb_end" />
    <bpmn:sequenceFlow id="f-onb-train" sourceRef="onb" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-onb_end" sourceRef="train" targetRef="onb_end" />
    <bpmn:sequenceFlow id="f-onb_end-integrate" sourceRef="onb_end" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-done" sourceRef="integrate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
