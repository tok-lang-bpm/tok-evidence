<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inventory restocking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="store" name="Warehouse or store" processRef="store-process" />
  </bpmn:collaboration>
  <bpmn:process id="store-process" name="Inventory restocking" isExecutable="false">
    <bpmn:laneSet id="store-lanes">
      <bpmn:lane id="staff" name="Warehouse staff">
        <bpmn:flowNodeRef>begins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Inventory system">
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begins" name="Monitoring begins" />
    <bpmn:task id="monitor" name="Monitor the inventory levels" />
    <bpmn:exclusiveGateway id="threshold" name="Stock reached the predefined threshold?" />
    <bpmn:task id="receive_stock" name="Receive the stock" />
    <bpmn:task id="inspect" name="Inspect the stock for quality" />
    <bpmn:task id="record" name="Record the stock in the system" />
    <bpmn:task id="shelve" name="Place the stock on shelves or in storage" />
    <bpmn:task id="order" name="Place the order with suppliers, considering cost, delivery time and supplier reliability" />
    <bpmn:task id="alert" name="Send the automated reorder alert" />
    <bpmn:task id="dates" name="Update the inventory system with expected delivery dates" />
    <bpmn:task id="update" name="Update the inventory levels" />
    <bpmn:endEvent id="done" name="Inventory levels updated" />
    <bpmn:sequenceFlow id="f-begins-monitor" sourceRef="begins" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-threshold" sourceRef="monitor" targetRef="threshold" />
    <bpmn:sequenceFlow id="f-threshold-alert" name="yes" sourceRef="threshold" targetRef="alert" />
    <bpmn:sequenceFlow id="f-threshold-monitor" name="no" sourceRef="threshold" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-alert-order" sourceRef="alert" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-dates" sourceRef="order" targetRef="dates" />
    <bpmn:sequenceFlow id="f-dates-receive_stock" sourceRef="dates" targetRef="receive_stock" />
    <bpmn:sequenceFlow id="f-receive_stock-inspect" sourceRef="receive_stock" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-shelve" sourceRef="record" targetRef="shelve" />
    <bpmn:sequenceFlow id="f-shelve-update" sourceRef="shelve" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-done" sourceRef="update" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
