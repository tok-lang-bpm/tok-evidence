tok 1.0 "Inventory restocking"

pool store "Warehouse or store"
  lane staff "Warehouse staff"
    start begins "Monitoring begins"
    task monitor "Monitor the inventory levels"
    xor threshold "Stock reached the predefined threshold?"
    task receive_stock "Receive the stock"
    task inspect "Inspect the stock for quality"
    task record "Record the stock in the system"
    task shelve "Place the stock on shelves or in storage"
  lane procurement "Procurement team"
    task order "Place the order with suppliers, considering cost, delivery time and supplier reliability"
  lane system "Inventory system"
    task alert "Send the automated reorder alert"
    task dates "Update the inventory system with expected delivery dates"
    task update "Update the inventory levels"
    end done "Inventory levels updated"

flow begins -> monitor -> threshold
flow threshold -> alert "yes"
flow threshold -> monitor "no"
flow alert -> order -> dates -> receive_stock -> inspect -> record -> shelve -> update -> done
