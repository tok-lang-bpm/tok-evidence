<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Marketing company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concluded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Campaign process started" />
    <bpmn:task id="define" name="Define the objectives of the campaign" />
    <bpmn:task id="content" name="Create the content" />
    <bpmn:task id="visuals" name="Design the visuals" />
    <bpmn:task id="channels" name="Select the promotion channels" />
    <bpmn:task id="launch" name="Launch the campaign" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="track" name="Track the performance in real time" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="analyse" name="Analyse the performance for future optimisation" />
    <bpmn:endEvent id="concluded" name="Campaign period ended" />
    <bpmn:task id="collect" name="Collect the generated leads in the CRM system" />
    <bpmn:task id="followup" name="Follow up the leads" />
    <bpmn:sequenceFlow id="f-begin-define" sourceRef="begin" targetRef="define" />
    <bpmn:sequenceFlow id="f-define-content" sourceRef="define" targetRef="content" />
    <bpmn:sequenceFlow id="f-content-visuals" sourceRef="content" targetRef="visuals" />
    <bpmn:sequenceFlow id="f-visuals-channels" sourceRef="visuals" targetRef="channels" />
    <bpmn:sequenceFlow id="f-channels-launch" sourceRef="channels" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-fork" sourceRef="launch" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-track" sourceRef="fork" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-join" sourceRef="track" targetRef="join" />
    <bpmn:sequenceFlow id="f-fork-collect" sourceRef="fork" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-followup" sourceRef="collect" targetRef="followup" />
    <bpmn:sequenceFlow id="f-followup-join" sourceRef="followup" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-analyse" sourceRef="join" targetRef="analyse" />
    <bpmn:sequenceFlow id="f-analyse-concluded" sourceRef="analyse" targetRef="concluded" />
  </bpmn:process>
</bpmn:definitions>
