tok 1.0 "Marketing campaign"

pool company "Marketing company"
  lane marketing "Marketing team"
    start begin "Campaign process started"
    task define "Define the objectives of the campaign"
    task content "Create the content"
    task visuals "Design the visuals"
    task channels "Select the promotion channels"
    task launch "Launch the campaign"
    and fork
    task track "Track the performance in real time"
    and join
    task analyse "Analyse the performance for future optimisation"
    end concluded "Campaign period ended"
  lane crm "CRM system"
    task collect "Collect the generated leads in the CRM system"
  lane sales "Sales team"
    task followup "Follow up the leads"

flow begin -> define -> content -> visuals -> channels -> launch -> fork
flow fork -> track -> join
flow fork -> collect -> followup -> join
flow join -> analyse -> concluded
