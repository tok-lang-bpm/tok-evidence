tok 1.0 "Supplier onboarding"

pool company "Company"
  lane management "Company"
    start need "Need for a new supplier"
    task identify "Identify the need for a new supplier"
  lane procurement "Procurement team"
    task rfp "Issue the request for proposals (RFP)"
    task evaluate "Evaluate each proposal by cost, quality and delivery time"
    xor visitq "Site visits or interviews needed?"
    task visit "Conduct site visits or interviews with suppliers"
    xor merged
    task select "Select a supplier"
    task negotiate "Negotiate the contract terms"
    xor agreed "Both parties agree on the terms?"
    task sign "Sign the contract"
    and split
    task onboard "Onboard the supplier"
    task execute "Execute the contract"
    and joined
    end done "Supplier onboarded and contract executed"
  lane supplier "Supplier"
    task respond "Submit a proposal"

flow need -> identify -> rfp -> respond -> evaluate -> visitq
flow visitq -> visit "yes"
flow visitq -> merged "no"
flow visit -> merged
flow merged -> select -> negotiate -> agreed
flow agreed -> sign "yes"
flow agreed -> negotiate "no"
flow sign -> split
flow split -> onboard
flow split -> execute
flow onboard -> joined
flow execute -> joined
flow joined -> done
