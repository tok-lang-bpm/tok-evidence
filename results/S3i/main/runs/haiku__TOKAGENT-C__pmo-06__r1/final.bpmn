<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Online order fulfilment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Order needed" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:endEvent id="delivered" name="Order delivered" />
    <bpmn:task id="confirm" name="Generate the order confirmation" />
    <bpmn:task id="sendconf" name="Send the order confirmation to the customer" />
    <bpmn:task id="track" name="Send the tracking information to the customer" />
    <bpmn:task id="pick" name="Pick the items" />
    <bpmn:task id="pack" name="Pack the items" />
    <bpmn:task id="label" name="Generate the shipping label" />
    <bpmn:task id="handover" name="Hand over the order to the logistics provider" />
    <bpmn:task id="monitor" name="Monitor the shipment" />
    <bpmn:exclusiveGateway id="arrived" name="Shipment at the customer's address?" />
    <bpmn:sequenceFlow id="f-needed-place" sourceRef="needed" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-confirm" sourceRef="place" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-sendconf" sourceRef="confirm" targetRef="sendconf" />
    <bpmn:sequenceFlow id="f-sendconf-pick" sourceRef="sendconf" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-pack" sourceRef="pick" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-label" sourceRef="pack" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-handover" sourceRef="label" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-track" sourceRef="handover" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-monitor" sourceRef="track" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-arrived" sourceRef="monitor" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-arrived-delivered" name="yes" sourceRef="arrived" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-arrived-monitor" name="no" sourceRef="arrived" targetRef="monitor" />
    <bpmn:textAnnotation id="fb">
      <bpmn:text>Customer feedback or returns may trigger further actions</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="fb-assoc" sourceRef="fb" targetRef="delivered" />
  </bpmn:process>
</bpmn:definitions>
