tok 1.0 "Online order fulfilment"

pool shop "Online shop"
  lane customer "Customer"
    start needed "Order needed"
    task place "Place the order"
    end delivered "Order delivered"
  lane system "System"
    task confirm "Generate the order confirmation"
    task sendconf "Send the order confirmation to the customer"
    task track "Send the tracking information to the customer"
  lane warehouse "Warehouse team"
    task pick "Pick the items"
    task pack "Pack the items"
    task label "Generate the shipping label"
    task handover "Hand over the order to the logistics provider"
  lane logistics "Logistics provider"
    task monitor "Monitor the shipment"
    xor arrived "Shipment at the customer's address?"

flow needed -> place -> confirm -> sendconf -> pick -> pack -> label -> handover -> track -> monitor -> arrived
flow arrived -> delivered "yes"
flow arrived -> monitor "no"

note fb "Customer feedback or returns may trigger further actions" on=delivered