tok 1.0 "Ticket booking and travel"

pool company "Travel company"
  lane customer "Customer"
    start begin "Customer needs a ticket"
    task search "Search for a flight, train, or bus ticket"
    task select "Select the route, date, and time"
    task provide "Provide personal information and payment details"
    task complete "Complete the journey"
    xor feedback_q "Feedback or services wanted?"
    task feedback "Give post-travel feedback or use services"
    end done "Process concluded"
  lane system "Booking system"
    task generate "Generate the ticket"
    and split_ticket "Ticket generated"
    task send "Send the ticket by email or SMS"
    and join_ticket "Ticket sent and seats updated"
  lane travel "Travel company"
    task inventory "Update the seat inventory"
    xor remind_q "Send reminders before travel?"
    task remind "Send reminders and check-in or boarding instructions"
    xor merge_r "Reminders handled"

flow begin -> search -> select -> provide -> generate -> split_ticket
flow split_ticket -> send -> join_ticket
flow split_ticket -> inventory -> join_ticket
flow join_ticket -> remind_q
flow remind_q -> remind "yes"
flow remind_q -> merge_r "no"
flow remind -> merge_r
flow merge_r -> complete -> feedback_q
flow feedback_q -> feedback "yes"
flow feedback_q -> done "no"
flow feedback -> done
