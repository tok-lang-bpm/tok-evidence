tok 1.0 "Incident handling"

pool org "Organisation"
  lane reporter "Employee or customer"
    start occurs "Incident occurs"
    task report "Report the incident"
  lane system "Tracking system"
    task log "Log the report in the tracking system"
    task assign "Assign the report to the appropriate team"
    and close_split "Close and notify"
    task close "Close the incident report"
    task notify "Notify all stakeholders"
    and joined "Joined"
    end closed "Incident report closed"
  lane team "Investigation team"
    task gather "Gather the necessary information"
    task identify "Identify the cause of the incident"
    task propose "Propose corrective actions"
    task implement "Implement the solution: fix, training or policy change"
    task followup "Follow up to ensure the issue will not recur"

flow occurs -> report -> log -> assign -> gather -> identify -> propose -> implement -> followup -> close_split
flow close_split -> close -> joined
flow close_split -> notify -> joined
flow joined -> closed
