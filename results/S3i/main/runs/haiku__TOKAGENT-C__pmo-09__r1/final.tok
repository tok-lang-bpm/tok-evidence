tok 1.0 "New product development"

pool rd "R&D"
  lane team "R&D team"
    start needed "Idea needed"
    task identify "Identify an idea for a new product or improvement"
    task research "Conduct initial research and feasibility studies"
    task design "Draft design concepts"
    task select "Select a promising design"
    task build "Build a prototype from available materials and resources"
    task test "Test the prototype for functionality, safety and market potential"
    task feedback "Collect feedback from the testing phase"
    xor refine_q "Refinement needed?"
    task refine "Refine the prototype"
    xor outcome "Approved for further development?"
    task approve "Approve the prototype for further development"
    task discard "Discard the prototype"
    end approved "Prototype approved"
    end discarded "Prototype discarded"

flow needed -> identify -> research -> design -> select -> build -> test -> feedback -> refine_q
flow refine_q -> refine "yes"
flow refine_q -> outcome "no"
flow refine -> test
flow outcome -> approve "yes"
flow outcome -> discard "no"
flow approve -> approved
flow discard -> discarded
