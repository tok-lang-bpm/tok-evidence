<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New product development" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="rd" name="R&amp;D" processRef="rd-process" />
  </bpmn:collaboration>
  <bpmn:process id="rd-process" name="New product development" isExecutable="false">
    <bpmn:laneSet id="rd-lanes">
      <bpmn:lane id="team" name="R&amp;D team">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Idea needed" />
    <bpmn:task id="identify" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="design" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype from available materials and resources" />
    <bpmn:task id="test" name="Test the prototype for functionality, safety and market potential" />
    <bpmn:task id="feedback" name="Collect feedback from the testing phase" />
    <bpmn:exclusiveGateway id="refine_q" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="outcome" name="Approved for further development?" />
    <bpmn:task id="approve" name="Approve the prototype for further development" />
    <bpmn:task id="discard" name="Discard the prototype" />
    <bpmn:endEvent id="approved" name="Prototype approved" />
    <bpmn:endEvent id="discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f-needed-identify" sourceRef="needed" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-research" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f-research-design" sourceRef="research" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-select" sourceRef="design" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-build" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-feedback" sourceRef="test" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-refine_q" sourceRef="feedback" targetRef="refine_q" />
    <bpmn:sequenceFlow id="f-refine_q-refine" name="yes" sourceRef="refine_q" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine_q-outcome" name="no" sourceRef="refine_q" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-refine-test" sourceRef="refine" targetRef="test" />
    <bpmn:sequenceFlow id="f-outcome-approve" name="yes" sourceRef="outcome" targetRef="approve" />
    <bpmn:sequenceFlow id="f-outcome-discard" name="no" sourceRef="outcome" targetRef="discard" />
    <bpmn:sequenceFlow id="f-approve-approved" sourceRef="approve" targetRef="approved" />
    <bpmn:sequenceFlow id="f-discard-discarded" sourceRef="discard" targetRef="discarded" />
  </bpmn:process>
</bpmn:definitions>
