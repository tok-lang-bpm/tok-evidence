<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IT solution request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Organisation" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="IT solution request" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="requester" name="Employee or department">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Request needed" />
    <bpmn:task id="submit" name="Submit a request for an IT solution" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" />
    <bpmn:task id="procure" name="Procure the necessary tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in a controlled environment" />
    <bpmn:task id="rollout" name="Roll out the solution to the requesting department" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="training_q" name="Training provided?" />
    <bpmn:task id="training" name="Provide training" />
    <bpmn:exclusiveGateway id="training_done" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="delivered" name="IT solution in use" />
    <bpmn:endEvent id="declined" name="Request declined" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-assess" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-approved" sourceRef="assess" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-procure" name="yes" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f-approved-declined" name="no" sourceRef="approved" targetRef="declined" />
    <bpmn:sequenceFlow id="f-procure-install" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-test" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-rollout" sourceRef="test" targetRef="rollout" />
    <bpmn:sequenceFlow id="f-rollout-split" sourceRef="rollout" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-training_q" sourceRef="split" targetRef="training_q" />
    <bpmn:sequenceFlow id="f-split-support" sourceRef="split" targetRef="support" />
    <bpmn:sequenceFlow id="f-training_q-training" name="yes" sourceRef="training_q" targetRef="training" />
    <bpmn:sequenceFlow id="f-training_q-training_done" name="no" sourceRef="training_q" targetRef="training_done" />
    <bpmn:sequenceFlow id="f-training-training_done" sourceRef="training" targetRef="training_done" />
    <bpmn:sequenceFlow id="f-training_done-join" sourceRef="training_done" targetRef="join" />
    <bpmn:sequenceFlow id="f-support-join" sourceRef="support" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-delivered" sourceRef="join" targetRef="delivered" />
  </bpmn:process>
</bpmn:definitions>
