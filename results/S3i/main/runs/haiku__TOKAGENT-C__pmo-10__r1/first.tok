tok 1.0 "IT solution request"

pool company "Organisation"
  lane requester "Employee or department"
    start submitted "Request needed"
    task submit "Submit a request for an IT solution"
  lane it "IT"
    task assess "Assess the request"
    xor approved "Request approved?"
    task procure "Procure the necessary tools or licenses"
    task install "Install the solution"
    task test "Test the solution in a controlled environment"
    task rollout "Roll out the solution to the requesting department"
    and split
    xor training_q "Training provided?"
    task training "Provide training"
    xor training_done
    task support "Provide IT support for troubleshooting"
    and join
    end delivered "IT solution in use"
    end declined "Request declined"

flow submitted -> submit -> assess -> approved
flow approved -> procure "yes"
flow approved -> declined "no"
flow procure -> install -> test -> rollout -> split
flow split -> training_q
flow split -> support
flow training_q -> training "yes"
flow training_q -> training_done "no"
flow training -> training_done
flow training_done -> join
flow support -> join
flow join -> delivered