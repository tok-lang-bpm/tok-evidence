tok 1.0 "Subscription lifecycle"

pool shop "Subscription service"
  lane customer "Customer"
    start signup "Subscription requested"
    task enter "Enter personal and payment information"
    xor cancels "Customer decides to cancel?"
    task request "Submit a cancellation request"
  lane system "System"
    task account "Generate the account"
    task access "Assign access"
    task billing "Trigger automated billing cycles"
    task updates "Send updates, product enhancements or renewal notifications"
  lane support "Support team"
    task process "Process the cancellation request"
    task refund "Apply refunds or charges according to the terms"
    and fork
    task deactivate "Deactivate the subscription"
    task balance "Settle the final account balance"
    and join
    end closed "Subscription closed"

flow signup -> enter -> account -> access -> billing -> updates -> cancels
flow cancels -> request "yes"
flow cancels -> updates "no"
flow request -> process -> refund -> fork
flow fork -> deactivate
flow fork -> balance
flow deactivate -> join
flow balance -> join
flow join -> closed
