<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Subscription lifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Subscription service" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Subscription lifecycle" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support team">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>balance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="signup" name="Subscription requested" />
    <bpmn:task id="enter" name="Enter personal and payment information" />
    <bpmn:exclusiveGateway id="cancels" name="Customer decides to cancel?" />
    <bpmn:task id="request" name="Submit a cancellation request" />
    <bpmn:task id="account" name="Generate the account" />
    <bpmn:task id="access" name="Assign access" />
    <bpmn:task id="billing" name="Trigger automated billing cycles" />
    <bpmn:task id="updates" name="Send updates, product enhancements or renewal notifications" />
    <bpmn:task id="process" name="Process the cancellation request" />
    <bpmn:task id="refund" name="Apply refunds or charges according to the terms" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="deactivate" name="Deactivate the subscription" />
    <bpmn:task id="balance" name="Settle the final account balance" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="closed" name="Subscription closed" />
    <bpmn:sequenceFlow id="f-signup-enter" sourceRef="signup" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-account" sourceRef="enter" targetRef="account" />
    <bpmn:sequenceFlow id="f-account-access" sourceRef="account" targetRef="access" />
    <bpmn:sequenceFlow id="f-access-billing" sourceRef="access" targetRef="billing" />
    <bpmn:sequenceFlow id="f-billing-updates" sourceRef="billing" targetRef="updates" />
    <bpmn:sequenceFlow id="f-updates-cancels" sourceRef="updates" targetRef="cancels" />
    <bpmn:sequenceFlow id="f-cancels-request" name="yes" sourceRef="cancels" targetRef="request" />
    <bpmn:sequenceFlow id="f-cancels-updates" name="no" sourceRef="cancels" targetRef="updates" />
    <bpmn:sequenceFlow id="f-request-process" sourceRef="request" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-refund" sourceRef="process" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-fork" sourceRef="refund" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-deactivate" sourceRef="fork" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f-fork-balance" sourceRef="fork" targetRef="balance" />
    <bpmn:sequenceFlow id="f-deactivate-join" sourceRef="deactivate" targetRef="join" />
    <bpmn:sequenceFlow id="f-balance-join" sourceRef="balance" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-closed" sourceRef="join" targetRef="closed" />
  </bpmn:process>
</bpmn:definitions>
