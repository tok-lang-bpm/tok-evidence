tok 1.0 "Complaint handling"

pool company "Organisation"
  lane customer "Customer"
    start filed "Complaint to be filed"
    task file "File a complaint about a product or service"
    task feedback "Provide feedback on satisfaction"
    end done "Feedback provided"
  lane service "Customer service"
    task log "Log the complaint"
    task assign "Assign the complaint to the relevant department"
    xor merged
    task resolve "Mark the complaint as resolved"
  lane dept "Relevant department"
    task review "Review the details"
    task determine "Determine whether the complaint is valid and whether a refund is justified"
    task notify "Notify the customer of the decision"
    xor approved "Refund approved?"
  lane finance "Financial team"
    task reimburse "Process the reimbursement"

flow filed -> file -> log -> assign -> review -> determine -> notify -> approved
flow approved -> reimburse "yes"
flow approved -> merged "no"
flow reimburse -> merged
flow merged -> resolve -> feedback -> done