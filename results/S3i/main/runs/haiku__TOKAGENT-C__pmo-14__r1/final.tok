tok 1.0 "Departmental budget planning"

pool org "Organisation"
  lane dept "Department"
    start begin "Planning period starts"
    task outline "Outline the objectives for the upcoming period"
    task draft "Draft the plan with cost estimates and justifications"
    task document "Document the adjustment"
    task distribute "Distribute the budget and begin implementing the plan"
    end done "Plan implemented"
  lane strategy "Strategy committee"
    task align "Review the plan in a strategic alignment meeting"
  lane finance "Finance department"
    task review "Perform the detailed budget review"
    xor feasible "Adjustments needed?"
    task allocate "Allocate the budget to the department"
  lane stakeholders "Stakeholders"
    task approve "Approve the adjustment"

flow begin -> outline -> draft -> align -> review -> feasible
flow feasible -> document "yes"
flow document -> approve
flow approve -> review
flow feasible -> allocate "no"
flow allocate -> distribute -> done
