<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Departmental budget planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Departmental budget planning" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="strategy" name="Strategy committee">
        <bpmn:flowNodeRef>align</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feasible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Planning period starts" />
    <bpmn:task id="outline" name="Outline the objectives for the upcoming period" />
    <bpmn:task id="draft" name="Draft the plan with cost estimates and justifications" />
    <bpmn:task id="document" name="Document the adjustment" />
    <bpmn:task id="distribute" name="Distribute the budget and begin implementing the plan" />
    <bpmn:endEvent id="done" name="Plan implemented" />
    <bpmn:task id="align" name="Review the plan in a strategic alignment meeting" />
    <bpmn:task id="review" name="Perform the detailed budget review" />
    <bpmn:exclusiveGateway id="feasible" name="Adjustments needed?" />
    <bpmn:task id="allocate" name="Allocate the budget to the department" />
    <bpmn:task id="approve" name="Approve the adjustment" />
    <bpmn:sequenceFlow id="f-begin-outline" sourceRef="begin" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-align" sourceRef="draft" targetRef="align" />
    <bpmn:sequenceFlow id="f-align-review" sourceRef="align" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-feasible" sourceRef="review" targetRef="feasible" />
    <bpmn:sequenceFlow id="f-feasible-document" name="yes" sourceRef="feasible" targetRef="document" />
    <bpmn:sequenceFlow id="f-document-approve" sourceRef="document" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-review" sourceRef="approve" targetRef="review" />
    <bpmn:sequenceFlow id="f-feasible-allocate" name="no" sourceRef="feasible" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-done" sourceRef="distribute" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
