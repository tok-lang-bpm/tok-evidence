<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teams" name="Internal teams">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gapq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notcert</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="scheduled" name="Company schedules a compliance audit" />
    <bpmn:task id="corrections" name="Make the necessary corrections or improvements" />
    <bpmn:task id="docs" name="Prepare the documentation" />
    <bpmn:task id="evidence" name="Gather the evidence" />
    <bpmn:task id="self" name="Conduct the self-assessment" />
    <bpmn:task id="review" name="Review the company's processes" />
    <bpmn:task id="gaps" name="Identify any gaps or issues" />
    <bpmn:exclusiveGateway id="gapq" name="Gaps or issues found?" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="final" name="Carry out the final audit" />
    <bpmn:exclusiveGateway id="met" name="All criteria met?" default="f-met-notcert" />
    <bpmn:task id="award" name="Award the certification" />
    <bpmn:task id="issue" name="Issue the official documents" />
    <bpmn:endEvent id="done" name="Certification issued" />
    <bpmn:endEvent id="notcert" name="Certification not awarded" />
    <bpmn:sequenceFlow id="f-scheduled-docs" sourceRef="scheduled" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-evidence" sourceRef="docs" targetRef="evidence" />
    <bpmn:sequenceFlow id="f-evidence-self" sourceRef="evidence" targetRef="self" />
    <bpmn:sequenceFlow id="f-self-review" sourceRef="self" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-gaps" sourceRef="review" targetRef="gaps" />
    <bpmn:sequenceFlow id="f-gaps-gapq" sourceRef="gaps" targetRef="gapq" />
    <bpmn:sequenceFlow id="f-gapq-corrections" name="Yes" sourceRef="gapq" targetRef="corrections" />
    <bpmn:sequenceFlow id="f-gapq-merged" name="No" sourceRef="gapq" targetRef="merged" />
    <bpmn:sequenceFlow id="f-corrections-merged" sourceRef="corrections" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-final" sourceRef="merged" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-met" sourceRef="final" targetRef="met" />
    <bpmn:sequenceFlow id="f-met-award" name="Yes" sourceRef="met" targetRef="award">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-met-notcert" name="No" sourceRef="met" targetRef="notcert" />
    <bpmn:sequenceFlow id="f-award-issue" sourceRef="award" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-done" sourceRef="issue" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
