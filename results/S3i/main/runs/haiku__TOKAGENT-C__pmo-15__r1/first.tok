tok 1.0 "Compliance audit"

pool org "Organisation"
  lane company "Company"
    start scheduled "Company schedules a compliance audit"
    task corrections "Make the necessary corrections or improvements"
  lane teams "Internal teams"
    task docs "Prepare the documentation"
    task evidence "Gather the evidence"
    task self "Conduct the self-assessment"
  lane auditors "Auditors"
    task review "Review the company's processes"
    task gaps "Identify any gaps or issues"
    xor gapq "Gaps or issues found?"
    xor merged
    task final "Carry out the final audit"
    xor met "All criteria met?"
    task award "Award the certification"
    task issue "Issue the official documents"
    end done "Certification issued"
    end notcert "Certification not awarded"

flow scheduled -> docs -> evidence -> self -> review -> gaps -> gapq
flow gapq -> corrections "Yes"
flow gapq -> merged "No"
flow corrections -> merged
flow merged -> final -> met
flow met -> award "Yes" when="true"
flow met -> notcert "No" default
flow award -> issue -> done
