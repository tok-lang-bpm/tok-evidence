<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual audit process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Multinational company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="coord" name="Audit coordinator">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>check_reg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central audit team">
        <bpmn:flowNodeRef>merge_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>high</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>review_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Audit process initiated" />
    <bpmn:task id="notify" name="Send the notification to the regional office" />
    <bpmn:parallelGateway id="fork_start" />
    <bpmn:endEvent id="closed" name="Audit process closed" />
    <bpmn:task id="prepare" name="Prepare the financial statements" />
    <bpmn:task id="gather" name="Gather the necessary documents" />
    <bpmn:parallelGateway id="join_start" />
    <bpmn:task id="submit" name="Submit the documents to the central audit team" />
    <bpmn:task id="clarify" name="Provide the necessary clarifications" />
    <bpmn:task id="check_reg" name="Check for regulatory updates" />
    <bpmn:exclusiveGateway id="merge_review" />
    <bpmn:task id="review" name="Review the submission" />
    <bpmn:exclusiveGateway id="discrepancy" name="Discrepancies found?" />
    <bpmn:task id="request" name="Request clarifications from the regional office" />
    <bpmn:parallelGateway id="fork_risk" />
    <bpmn:task id="fin_risk" name="Evaluate the financial risks" />
    <bpmn:task id="op_risk" name="Evaluate the operational risks" />
    <bpmn:task id="comp_risk" name="Evaluate the compliance risks" />
    <bpmn:parallelGateway id="join_risk" />
    <bpmn:exclusiveGateway id="high" name="High risk identified?" />
    <bpmn:task id="analyse" name="Analyse the data" />
    <bpmn:task id="interview" name="Conduct the interviews" />
    <bpmn:exclusiveGateway id="site" name="Site visit required?" />
    <bpmn:task id="visit" name="Conduct the site visit" />
    <bpmn:exclusiveGateway id="merge_risks" />
    <bpmn:task id="compile" name="Compile the audit report" />
    <bpmn:exclusiveGateway id="merge_report" />
    <bpmn:task id="update" name="Update the report accordingly" />
    <bpmn:task id="resubmit" name="Resubmit the report to the audit director" />
    <bpmn:task id="distribute" name="Distribute the final report to the executive board" />
    <bpmn:task id="archive" name="Archive the final report" />
    <bpmn:task id="review_report" name="Review the audit report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:sequenceFlow id="f-started-notify" sourceRef="started" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-fork_start" sourceRef="notify" targetRef="fork_start" />
    <bpmn:sequenceFlow id="f-fork_start-prepare" sourceRef="fork_start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-gather" sourceRef="prepare" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-join_start" sourceRef="gather" targetRef="join_start" />
    <bpmn:sequenceFlow id="f-fork_start-check_reg" sourceRef="fork_start" targetRef="check_reg" />
    <bpmn:sequenceFlow id="f-check_reg-join_start" sourceRef="check_reg" targetRef="join_start" />
    <bpmn:sequenceFlow id="f-join_start-submit" sourceRef="join_start" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-merge_review" sourceRef="submit" targetRef="merge_review" />
    <bpmn:sequenceFlow id="f-merge_review-review" sourceRef="merge_review" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-discrepancy" sourceRef="review" targetRef="discrepancy" />
    <bpmn:sequenceFlow id="f-discrepancy-request" name="Yes" sourceRef="discrepancy" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-clarify" sourceRef="request" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-merge_review" sourceRef="clarify" targetRef="merge_review" />
    <bpmn:sequenceFlow id="f-discrepancy-fork_risk" name="No" sourceRef="discrepancy" targetRef="fork_risk" />
    <bpmn:sequenceFlow id="f-fork_risk-fin_risk" sourceRef="fork_risk" targetRef="fin_risk" />
    <bpmn:sequenceFlow id="f-fin_risk-join_risk" sourceRef="fin_risk" targetRef="join_risk" />
    <bpmn:sequenceFlow id="f-fork_risk-op_risk" sourceRef="fork_risk" targetRef="op_risk" />
    <bpmn:sequenceFlow id="f-op_risk-join_risk" sourceRef="op_risk" targetRef="join_risk" />
    <bpmn:sequenceFlow id="f-fork_risk-comp_risk" sourceRef="fork_risk" targetRef="comp_risk" />
    <bpmn:sequenceFlow id="f-comp_risk-join_risk" sourceRef="comp_risk" targetRef="join_risk" />
    <bpmn:sequenceFlow id="f-join_risk-high" sourceRef="join_risk" targetRef="high" />
    <bpmn:sequenceFlow id="f-high-analyse" name="Yes" sourceRef="high" targetRef="analyse" />
    <bpmn:sequenceFlow id="f-analyse-interview" sourceRef="analyse" targetRef="interview" />
    <bpmn:sequenceFlow id="f-interview-site" sourceRef="interview" targetRef="site" />
    <bpmn:sequenceFlow id="f-site-visit" name="Yes" sourceRef="site" targetRef="visit" />
    <bpmn:sequenceFlow id="f-visit-merge_risks" sourceRef="visit" targetRef="merge_risks" />
    <bpmn:sequenceFlow id="f-site-merge_risks" name="No" sourceRef="site" targetRef="merge_risks" />
    <bpmn:sequenceFlow id="f-high-merge_risks" name="No" sourceRef="high" targetRef="merge_risks" />
    <bpmn:sequenceFlow id="f-merge_risks-compile" sourceRef="merge_risks" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compile-merge_report" sourceRef="compile" targetRef="merge_report" />
    <bpmn:sequenceFlow id="f-merge_report-review_report" sourceRef="merge_report" targetRef="review_report" />
    <bpmn:sequenceFlow id="f-review_report-approved" sourceRef="review_report" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-distribute" name="Yes" sourceRef="approved" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-archive" sourceRef="distribute" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-closed" sourceRef="archive" targetRef="closed" />
    <bpmn:sequenceFlow id="f-approved-update" name="No" sourceRef="approved" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-resubmit" sourceRef="update" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f-resubmit-merge_report" sourceRef="resubmit" targetRef="merge_report" />
  </bpmn:process>
</bpmn:definitions>
