<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_delivery_confirmed" name="delivery confirmed" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="E-commerce company" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateInv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping department">
        <bpmn:flowNodeRef>prepDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnLabel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order" name="Customer places an order" />
    <bpmn:intermediateCatchEvent id="delivered" name="Successful delivery confirmed">
      <bpmn:messageEventDefinition id="delivered-def" messageRef="Message_delivery_confirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="issue" name="Customer reports an issue?" />
    <bpmn:endEvent id="failed" name="Order ends: payment failed" />
    <bpmn:endEvent id="handled" name="Order completed" />
    <bpmn:endEvent id="returned" name="Return handled" />
    <bpmn:task id="record" name="Record the order details" />
    <bpmn:task id="pay" name="Process the payment" />
    <bpmn:exclusiveGateway id="paid" name="Payment successful?" />
    <bpmn:task id="notifyFail" name="Notify the customer about the failed payment" />
    <bpmn:task id="check" name="Check the stock availability" />
    <bpmn:exclusiveGateway id="instock" name="Items in stock?" />
    <bpmn:task id="backorder" name="Initiate a back-order" />
    <bpmn:task id="informDelay" name="Inform the customer about the delay" />
    <bpmn:task id="confirm" name="Send the shipping confirmation to the customer" />
    <bpmn:task id="updateInv" name="Update the inventory levels" />
    <bpmn:task id="followUp" name="Send the feedback follow-up email" />
    <bpmn:task id="refund" name="Process a refund or replacement" />
    <bpmn:exclusiveGateway id="avail" name="All required items available" />
    <bpmn:task id="receiveBack" name="Receive the back-order" />
    <bpmn:task id="pick" name="Pick the items from the warehouse" />
    <bpmn:task id="qc" name="Perform the quality control check" />
    <bpmn:parallelGateway id="split" name="Start packaging and shipping documents" />
    <bpmn:exclusiveGateway id="gift" name="Gift wrapping requested?" />
    <bpmn:task id="wrap" name="Gift-wrap the order" />
    <bpmn:exclusiveGateway id="giftMerge" />
    <bpmn:task id="pack" name="Package the order" />
    <bpmn:task id="receiveReturn" name="Receive the returned items" />
    <bpmn:task id="inspect" name="Inspect the returned items" />
    <bpmn:task id="prepDocs" name="Prepare the shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs" name="Prepare the customs documentation" />
    <bpmn:exclusiveGateway id="intlMerge" />
    <bpmn:parallelGateway id="ready" name="Packaging and documents ready" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:task id="returnLabel" name="Send a return shipping label" />
    <bpmn:sequenceFlow id="f-order-record" sourceRef="order" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-pay" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-paid" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f-paid-notifyFail" name="no" sourceRef="paid" targetRef="notifyFail" />
    <bpmn:sequenceFlow id="f-notifyFail-failed" sourceRef="notifyFail" targetRef="failed" />
    <bpmn:sequenceFlow id="f-paid-check" name="yes" sourceRef="paid" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-instock" sourceRef="check" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-backorder" name="no" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-backorder-informDelay" sourceRef="backorder" targetRef="informDelay" />
    <bpmn:sequenceFlow id="f-informDelay-receiveBack" sourceRef="informDelay" targetRef="receiveBack" />
    <bpmn:sequenceFlow id="f-receiveBack-avail" sourceRef="receiveBack" targetRef="avail" />
    <bpmn:sequenceFlow id="f-instock-avail" name="yes" sourceRef="instock" targetRef="avail" />
    <bpmn:sequenceFlow id="f-avail-pick" sourceRef="avail" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-split" sourceRef="qc" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-gift" sourceRef="split" targetRef="gift" />
    <bpmn:sequenceFlow id="f-split-prepDocs" sourceRef="split" targetRef="prepDocs" />
    <bpmn:sequenceFlow id="f-gift-wrap" name="yes" sourceRef="gift" targetRef="wrap" />
    <bpmn:sequenceFlow id="f-wrap-giftMerge" sourceRef="wrap" targetRef="giftMerge" />
    <bpmn:sequenceFlow id="f-gift-giftMerge" name="no" sourceRef="gift" targetRef="giftMerge" />
    <bpmn:sequenceFlow id="f-giftMerge-pack" sourceRef="giftMerge" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-ready" sourceRef="pack" targetRef="ready" />
    <bpmn:sequenceFlow id="f-prepDocs-intl" sourceRef="prepDocs" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-customs" name="yes" sourceRef="intl" targetRef="customs" />
    <bpmn:sequenceFlow id="f-customs-intlMerge" sourceRef="customs" targetRef="intlMerge" />
    <bpmn:sequenceFlow id="f-intl-intlMerge" name="no" sourceRef="intl" targetRef="intlMerge" />
    <bpmn:sequenceFlow id="f-intlMerge-ready" sourceRef="intlMerge" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-dispatch" sourceRef="ready" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-confirm" sourceRef="dispatch" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-updateInv" sourceRef="confirm" targetRef="updateInv" />
    <bpmn:sequenceFlow id="f-updateInv-delivered" sourceRef="updateInv" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-issue" sourceRef="delivered" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-followUp" name="no" sourceRef="issue" targetRef="followUp" />
    <bpmn:sequenceFlow id="f-followUp-handled" sourceRef="followUp" targetRef="handled" />
    <bpmn:sequenceFlow id="f-issue-returnLabel" name="yes" sourceRef="issue" targetRef="returnLabel" />
    <bpmn:sequenceFlow id="f-returnLabel-receiveReturn" sourceRef="returnLabel" targetRef="receiveReturn" />
    <bpmn:sequenceFlow id="f-receiveReturn-inspect" sourceRef="receiveReturn" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-refund" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-returned" sourceRef="refund" targetRef="returned" />
  </bpmn:process>
</bpmn:definitions>
