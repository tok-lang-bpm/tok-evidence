<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="uni" name="University" processRef="uni-process" />
  </bpmn:collaboration>
  <bpmn:process id="uni-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="uni-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enrollfork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enrolled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewgrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitappeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>semesterend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions office">
        <bpmn:flowNodeRef>reviewapp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendaccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Admissions committee">
        <bpmn:flowNodeRef>parstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="intlo" name="International student office">
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT department">
        <bpmn:flowNodeRef>accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="faculty" name="Faculty">
        <bpmn:flowNodeRef>grades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="appeals" name="Appeals committee">
        <bpmn:flowNodeRef>meetappeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>awaitdec</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="applied" name="Application needed" />
    <bpmn:task id="submit" name="Submit the application online" />
    <bpmn:task id="provide" name="Provide the missing items" />
    <bpmn:task id="confirm" name="Confirm enrollment by the deadline" />
    <bpmn:exclusiveGateway id="confirmed" name="Enrollment confirmed by the deadline?" />
    <bpmn:endEvent id="canceled" name="Application canceled" />
    <bpmn:exclusiveGateway id="intl" name="International student?" />
    <bpmn:exclusiveGateway id="intlmerge" name="Visa step done or not needed" />
    <bpmn:parallelGateway id="enrollfork" name="Start enrollment work" />
    <bpmn:task id="orient" name="Receive the orientation materials" />
    <bpmn:parallelGateway id="enrolled" name="Enrollment work done" />
    <bpmn:task id="card" name="Obtain the student ID card" />
    <bpmn:task id="meet" name="Meet with an academic advisor" />
    <bpmn:task id="select" name="Select courses" />
    <bpmn:task id="resolve" name="Resolve any schedule conflicts" />
    <bpmn:task id="attend" name="Attend classes" />
    <bpmn:task id="adddrop" name="Add or drop courses within the add/drop period" />
    <bpmn:task id="reviewgrades" name="Review the grades online" />
    <bpmn:exclusiveGateway id="grievance" name="Grievance?" />
    <bpmn:task id="submitappeal" name="Submit an appeal form" />
    <bpmn:exclusiveGateway id="gmerge" name="Appeal decided or no grievance" />
    <bpmn:exclusiveGateway id="semesterend" name="Graduates or withdraws?" />
    <bpmn:endEvent id="done" name="Graduated or withdrawn" />
    <bpmn:task id="reviewapp" name="Review the application and supporting documents" />
    <bpmn:exclusiveGateway id="docsok" name="All documents received?" />
    <bpmn:task id="notify" name="Notify the applicant to provide the missing items" />
    <bpmn:task id="sendaccept" name="Send the acceptance letter" />
    <bpmn:task id="sendreject" name="Send the rejection letter" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:parallelGateway id="parstart" name="Evaluate and process fees" />
    <bpmn:task id="evaluate" name="Evaluate the application" />
    <bpmn:parallelGateway id="parend" name="Evaluation and fees done" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" />
    <bpmn:task id="fees" name="Process the application fees or waivers" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:task id="accounts" name="Set up student accounts for email, online portals, and library access" />
    <bpmn:task id="grades" name="Post the grades" />
    <bpmn:task id="meetappeal" name="Meet with the appeals committee" />
    <bpmn:task id="awaitdec" name="Await the decision" />
    <bpmn:sequenceFlow id="f-applied-submit" sourceRef="applied" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-reviewapp" sourceRef="submit" targetRef="reviewapp" />
    <bpmn:sequenceFlow id="f-reviewapp-docsok" sourceRef="reviewapp" targetRef="docsok" />
    <bpmn:sequenceFlow id="f-docsok-notify" name="no" sourceRef="docsok" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-provide" sourceRef="notify" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-reviewapp" sourceRef="provide" targetRef="reviewapp" />
    <bpmn:sequenceFlow id="f-docsok-parstart" name="yes" sourceRef="docsok" targetRef="parstart" />
    <bpmn:sequenceFlow id="f-parstart-evaluate" sourceRef="parstart" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-parend" sourceRef="evaluate" targetRef="parend" />
    <bpmn:sequenceFlow id="f-parstart-fees" sourceRef="parstart" targetRef="fees" />
    <bpmn:sequenceFlow id="f-fees-parend" sourceRef="fees" targetRef="parend" />
    <bpmn:sequenceFlow id="f-parend-accepted" sourceRef="parend" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-sendaccept" name="yes" sourceRef="accepted" targetRef="sendaccept" />
    <bpmn:sequenceFlow id="f-accepted-sendreject" name="no" sourceRef="accepted" targetRef="sendreject" />
    <bpmn:sequenceFlow id="f-sendreject-rejected" sourceRef="sendreject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-sendaccept-confirm" sourceRef="sendaccept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-canceled" name="no" sourceRef="confirmed" targetRef="canceled" />
    <bpmn:sequenceFlow id="f-confirmed-intl" name="yes" sourceRef="confirmed" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-visa" name="yes" sourceRef="intl" targetRef="visa" />
    <bpmn:sequenceFlow id="f-visa-intlmerge" sourceRef="visa" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intl-intlmerge" name="no" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intlmerge-enrollfork" sourceRef="intlmerge" targetRef="enrollfork" />
    <bpmn:sequenceFlow id="f-enrollfork-orient" sourceRef="enrollfork" targetRef="orient" />
    <bpmn:sequenceFlow id="f-enrollfork-accounts" sourceRef="enrollfork" targetRef="accounts" />
    <bpmn:sequenceFlow id="f-orient-enrolled" sourceRef="orient" targetRef="enrolled" />
    <bpmn:sequenceFlow id="f-accounts-enrolled" sourceRef="accounts" targetRef="enrolled" />
    <bpmn:sequenceFlow id="f-enrolled-card" sourceRef="enrolled" targetRef="card" />
    <bpmn:sequenceFlow id="f-card-meet" sourceRef="card" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-select" sourceRef="meet" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-resolve" sourceRef="select" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-attend" sourceRef="resolve" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-adddrop" sourceRef="attend" targetRef="adddrop" />
    <bpmn:sequenceFlow id="f-adddrop-grades" sourceRef="adddrop" targetRef="grades" />
    <bpmn:sequenceFlow id="f-grades-reviewgrades" sourceRef="grades" targetRef="reviewgrades" />
    <bpmn:sequenceFlow id="f-reviewgrades-grievance" sourceRef="reviewgrades" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-submitappeal" name="yes" sourceRef="grievance" targetRef="submitappeal" />
    <bpmn:sequenceFlow id="f-submitappeal-meetappeal" sourceRef="submitappeal" targetRef="meetappeal" />
    <bpmn:sequenceFlow id="f-meetappeal-awaitdec" sourceRef="meetappeal" targetRef="awaitdec" />
    <bpmn:sequenceFlow id="f-awaitdec-gmerge" sourceRef="awaitdec" targetRef="gmerge" />
    <bpmn:sequenceFlow id="f-grievance-gmerge" name="no" sourceRef="grievance" targetRef="gmerge" />
    <bpmn:sequenceFlow id="f-gmerge-semesterend" sourceRef="gmerge" targetRef="semesterend" />
    <bpmn:sequenceFlow id="f-semesterend-done" name="yes" sourceRef="semesterend" targetRef="done" />
    <bpmn:sequenceFlow id="f-semesterend-attend" name="no" sourceRef="semesterend" targetRef="attend" />
  </bpmn:process>
</bpmn:definitions>
