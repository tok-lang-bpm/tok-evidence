tok 1.0 "University enrollment"

pool uni "University"
  lane student "Student"
    start applied "Application needed"
    task submit "Submit the application online"
    task provide "Provide the missing items"
    task confirm "Confirm enrollment by the deadline"
    xor confirmed "Enrollment confirmed by the deadline?"
    end canceled "Application canceled"
    xor intl "International student?"
    xor intlmerge "Visa step done or not needed"
    and enrollfork "Start enrollment work"
    task orient "Receive the orientation materials"
    and enrolled "Enrollment work done"
    task card "Obtain the student ID card"
    task meet "Meet with an academic advisor"
    task select "Select courses"
    task resolve "Resolve any schedule conflicts"
    task attend "Attend classes"
    task adddrop "Add or drop courses within the add/drop period"
    task reviewgrades "Review the grades online"
    xor grievance "Grievance?"
    task submitappeal "Submit an appeal form"
    xor gmerge "Appeal decided or no grievance"
    xor semesterend "Graduates or withdraws?"
    end done "Graduated or withdrawn"
  lane admissions "Admissions office"
    task reviewapp "Review the application and supporting documents"
    xor docsok "All documents received?"
    task notify "Notify the applicant to provide the missing items"
    task sendaccept "Send the acceptance letter"
    task sendreject "Send the rejection letter"
    end rejected "Application rejected"
  lane committee "Admissions committee"
    and parstart "Evaluate and process fees"
    task evaluate "Evaluate the application"
    and parend "Evaluation and fees done"
    xor accepted "Application accepted?"
  lane finance "Finance department"
    task fees "Process the application fees or waivers"
  lane intlo "International student office"
    task visa "Assist with visa processing"
  lane it "IT department"
    task accounts "Set up student accounts for email, online portals, and library access"
  lane faculty "Faculty"
    task grades "Post the grades"
  lane appeals "Appeals committee"
    task meetappeal "Meet with the appeals committee"
    task awaitdec "Await the decision"

flow applied -> submit -> reviewapp -> docsok
flow docsok -> notify "no"
flow notify -> provide -> reviewapp
flow docsok -> parstart "yes"
flow parstart -> evaluate -> parend
flow parstart -> fees -> parend
flow parend -> accepted
flow accepted -> sendaccept "yes"
flow accepted -> sendreject "no"
flow sendreject -> rejected
flow sendaccept -> confirm -> confirmed
flow confirmed -> canceled "no"
flow confirmed -> intl "yes"
flow intl -> visa "yes"
flow visa -> intlmerge
flow intl -> intlmerge "no"
flow intlmerge -> enrollfork
flow enrollfork -> orient
flow enrollfork -> accounts
flow orient -> enrolled
flow accounts -> enrolled
flow enrolled -> card -> meet -> select -> resolve -> attend -> adddrop -> grades -> reviewgrades -> grievance
flow grievance -> submitappeal "yes"
flow submitappeal -> meetappeal -> awaitdec -> gmerge
flow grievance -> gmerge "no"
flow gmerge -> semesterend
flow semesterend -> done "yes"
flow semesterend -> attend "no"