<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Online shop purchase" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Online shop purchase" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Online shop system">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order" name="Order started" />
    <bpmn:task id="login" name="Log in to the account" />
    <bpmn:parallelGateway id="split_par" />
    <bpmn:task id="select" name="Select the items to purchase" />
    <bpmn:task id="reward" name="Choose a free reward option" />
    <bpmn:task id="method" name="Set the payment method" />
    <bpmn:parallelGateway id="join_par" />
    <bpmn:exclusiveGateway id="pay_choice" name="Payment method?" />
    <bpmn:task id="pay" name="Pay for the items" />
    <bpmn:task id="installment" name="Complete the installment agreement" />
    <bpmn:exclusiveGateway id="merge_pay" />
    <bpmn:task id="return_items" name="Return items for exchange" />
    <bpmn:exclusiveGateway id="returned" name="Items returned?" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:task id="deliver" name="Deliver the items" />
    <bpmn:sequenceFlow id="f-order-login" sourceRef="order" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split_par" sourceRef="login" targetRef="split_par" />
    <bpmn:sequenceFlow id="f-split_par-select" sourceRef="split_par" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-reward" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f-reward-join_par" sourceRef="reward" targetRef="join_par" />
    <bpmn:sequenceFlow id="f-split_par-method" sourceRef="split_par" targetRef="method" />
    <bpmn:sequenceFlow id="f-method-join_par" sourceRef="method" targetRef="join_par" />
    <bpmn:sequenceFlow id="f-join_par-pay_choice" sourceRef="join_par" targetRef="pay_choice" />
    <bpmn:sequenceFlow id="f-pay_choice-pay" name="Pay" sourceRef="pay_choice" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay_choice-installment" name="Installment agreement" sourceRef="pay_choice" targetRef="installment" />
    <bpmn:sequenceFlow id="f-pay-merge_pay" sourceRef="pay" targetRef="merge_pay" />
    <bpmn:sequenceFlow id="f-installment-merge_pay" sourceRef="installment" targetRef="merge_pay" />
    <bpmn:sequenceFlow id="f-merge_pay-deliver" sourceRef="merge_pay" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-returned" sourceRef="deliver" targetRef="returned" />
    <bpmn:sequenceFlow id="f-returned-return_items" name="Yes" sourceRef="returned" targetRef="return_items" />
    <bpmn:sequenceFlow id="f-return_items-deliver" sourceRef="return_items" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-returned-done" name="No" sourceRef="returned" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
