tok 1.0 "Online shop purchase"

pool shop "Online shop"
  lane user "User"
    start order "Order started"
    task login "Log in to the account"
    and split_par
    task select "Select the items to purchase"
    task reward "Choose a free reward option"
    task method "Set the payment method"
    and join_par
    xor pay_choice "Payment method?"
    task pay "Pay for the items"
    task installment "Complete the installment agreement"
    xor merge_pay
    task return_items "Return items for exchange"
    xor returned "Items returned?"
    end done "Order completed"
  lane system "Online shop system"
    task deliver "Deliver the items"

flow order -> login -> split_par
flow split_par -> select -> reward -> join_par
flow split_par -> method -> join_par
flow join_par -> pay_choice
flow pay_choice -> pay "Pay"
flow pay_choice -> installment "Installment agreement"
flow pay -> merge_pay
flow installment -> merge_pay
flow merge_pay -> deliver -> returned
flow returned -> return_items "Yes"
flow return_items -> deliver
flow returned -> done "No"
