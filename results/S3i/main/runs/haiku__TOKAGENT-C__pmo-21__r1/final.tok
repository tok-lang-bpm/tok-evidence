tok 1.0 "Goods shipping"

pool company "Company"
  lane secretary "Secretary"
    start shipping "Goods shall be shipped"
    xor need "Goods shall be shipped?"
    task clarify "Clarify who will do the shipping"
    xor amount "Large amounts?"
    task invite "Invite three logistic companies to make offers"
    task select "Select one of the logistic companies"
    task post "Use normal post shipment"
    xor merge1
    and fork
    task writelabel "Write a package label"
    end noship "No shipment"
  lane logistics "Logistics department head"
    xor insurance "Parcel insurance necessary?"
    task insure "Take out a parcel insurance"
    xor merge2
  lane warehouse "Warehousemen"
    task pack "Package the goods"
    and joined
    task prepare "Prepare the packaged goods for pickup by the logistic company"
    end ready "Goods ready for pickup"

flow shipping -> need
flow need -> clarify "yes"
flow need -> noship "no"
flow clarify -> amount
flow amount -> invite "yes"
flow invite -> select -> merge1
flow amount -> post "no"
flow post -> merge1
flow merge1 -> fork
flow fork -> writelabel -> joined
flow fork -> insurance
flow insurance -> insure "yes"
flow insurance -> merge2 "no"
flow insure -> merge2
flow merge2 -> joined
flow fork -> pack -> joined
flow joined -> prepare -> ready
