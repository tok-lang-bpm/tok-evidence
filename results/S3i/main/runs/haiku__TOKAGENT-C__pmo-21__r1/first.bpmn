<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Goods shipping" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Goods shipping" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="secretary" name="Secretary">
        <bpmn:flowNodeRef>shipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writelabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noship</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics department head">
        <bpmn:flowNodeRef>insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="shipping" name="Goods shall be shipped" />
    <bpmn:exclusiveGateway id="need" name="Goods shall be shipped?" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="amount" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one of the logistic companies" />
    <bpmn:task id="post" name="Use normal post shipment" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="writelabel" name="Write a package label" />
    <bpmn:endEvent id="noship" name="No shipment" />
    <bpmn:exclusiveGateway id="insurance" name="Parcel insurance necessary?" />
    <bpmn:task id="insure" name="Take out a parcel insurance" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:task id="pack" name="Package the goods" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="prepare" name="Prepare the packaged goods for pickup by the logistic company" />
    <bpmn:endEvent id="ready" name="Goods ready for pickup" />
    <bpmn:sequenceFlow id="f-shipping-need" sourceRef="shipping" targetRef="need" />
    <bpmn:sequenceFlow id="f-need-clarify" name="yes" sourceRef="need" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-need-noship" name="no" sourceRef="need" targetRef="noship" />
    <bpmn:sequenceFlow id="f-clarify-amount" sourceRef="clarify" targetRef="amount" />
    <bpmn:sequenceFlow id="f-amount-invite" name="yes" sourceRef="amount" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-merge1" sourceRef="select" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-amount-post" name="no" sourceRef="amount" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-merge1" sourceRef="post" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-fork" sourceRef="merge1" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-writelabel" sourceRef="fork" targetRef="writelabel" />
    <bpmn:sequenceFlow id="f-writelabel-joined" sourceRef="writelabel" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-insurance" sourceRef="fork" targetRef="insurance" />
    <bpmn:sequenceFlow id="f-insurance-insure" name="yes" sourceRef="insurance" targetRef="insure" />
    <bpmn:sequenceFlow id="f-insurance-merge2" name="no" sourceRef="insurance" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-insure-merge2" sourceRef="insure" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-merge2-joined" sourceRef="merge2" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-pack" sourceRef="fork" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-joined" sourceRef="pack" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-prepare" sourceRef="joined" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-ready" sourceRef="prepare" targetRef="ready" />
  </bpmn:process>
</bpmn:definitions>
