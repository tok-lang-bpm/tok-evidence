<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>see</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shown</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="banking" name="Banking system">
        <bpmn:flowNodeRef>start_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Credit agency">
        <bpmn:flowNodeRef>level1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="request" name="Credit scoring requested" />
    <bpmn:task id="ask" name="Request the credit scoring in the frontend" />
    <bpmn:task id="check" name="Check the result again later" />
    <bpmn:task id="see" name="See the result at the frontend" />
    <bpmn:endEvent id="shown" name="Result shown at the frontend" />
    <bpmn:task id="start_process" name="Start the scoring process" />
    <bpmn:task id="send" name="Send the scoring request to the agency" />
    <bpmn:task id="receive_delay" name="Receive the delay information" />
    <bpmn:task id="display_delay" name="Display the delay message to the clerk" />
    <bpmn:task id="receive_result" name="Receive the scoring result" />
    <bpmn:task id="present" name="Present the result to the clerk" />
    <bpmn:parallelGateway id="split_delay" />
    <bpmn:parallelGateway id="join_delay" />
    <bpmn:exclusiveGateway id="merge_result" />
    <bpmn:task id="level1" name="Do the first quick scoring (level 1)" />
    <bpmn:exclusiveGateway id="immediate" name="Result determined immediately?" />
    <bpmn:task id="return1" name="Return the result to the banking system" />
    <bpmn:task id="inform" name="Inform the banking process of the delay" />
    <bpmn:task id="level2" name="Do the level 2 scoring" />
    <bpmn:task id="send_result" name="Send the scoring result to the banking process" />
    <bpmn:sequenceFlow id="f-request-ask" sourceRef="request" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-start_process" sourceRef="ask" targetRef="start_process" />
    <bpmn:sequenceFlow id="f-start_process-send" sourceRef="start_process" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-level1" sourceRef="send" targetRef="level1" />
    <bpmn:sequenceFlow id="f-level1-immediate" sourceRef="level1" targetRef="immediate" />
    <bpmn:sequenceFlow id="f-immediate-return1" name="yes" sourceRef="immediate" targetRef="return1" />
    <bpmn:sequenceFlow id="f-return1-merge_result" sourceRef="return1" targetRef="merge_result" />
    <bpmn:sequenceFlow id="f-immediate-inform" name="no" sourceRef="immediate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-receive_delay" sourceRef="inform" targetRef="receive_delay" />
    <bpmn:sequenceFlow id="f-receive_delay-split_delay" sourceRef="receive_delay" targetRef="split_delay" />
    <bpmn:sequenceFlow id="f-split_delay-display_delay" sourceRef="split_delay" targetRef="display_delay" />
    <bpmn:sequenceFlow id="f-display_delay-check" sourceRef="display_delay" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-join_delay" sourceRef="check" targetRef="join_delay" />
    <bpmn:sequenceFlow id="f-split_delay-level2" sourceRef="split_delay" targetRef="level2" />
    <bpmn:sequenceFlow id="f-level2-send_result" sourceRef="level2" targetRef="send_result" />
    <bpmn:sequenceFlow id="f-send_result-receive_result" sourceRef="send_result" targetRef="receive_result" />
    <bpmn:sequenceFlow id="f-receive_result-join_delay" sourceRef="receive_result" targetRef="join_delay" />
    <bpmn:sequenceFlow id="f-join_delay-merge_result" sourceRef="join_delay" targetRef="merge_result" />
    <bpmn:sequenceFlow id="f-merge_result-present" sourceRef="merge_result" targetRef="present" />
    <bpmn:sequenceFlow id="f-present-see" sourceRef="present" targetRef="see" />
    <bpmn:sequenceFlow id="f-see-shown" sourceRef="see" targetRef="shown" />
  </bpmn:process>
</bpmn:definitions>
