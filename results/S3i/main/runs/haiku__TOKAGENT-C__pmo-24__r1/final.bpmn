<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Restaurant meal service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="restaurant" name="Restaurant" processRef="restaurant-process" />
  </bpmn:collaboration>
  <bpmn:process id="restaurant-process" name="Restaurant meal service" isExecutable="false">
    <bpmn:laneSet id="restaurant-lanes">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>hungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go_hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="hungry" name="Guest feels hungry" />
    <bpmn:task id="enter" name="Enter the restaurant" />
    <bpmn:task id="choose" name="Choose a dish from the changing meal range" />
    <bpmn:task id="wait" name="Wait until it is his turn" />
    <bpmn:task id="order" name="Place the order with the employee" />
    <bpmn:task id="go_hatch" name="Go to the service hatch" />
    <bpmn:task id="eat" name="Eat the meal" />
    <bpmn:exclusiveGateway id="ring" name="Buzzer sounds" />
    <bpmn:exclusiveGateway id="reacts" name="Guest reacts to the buzzer?" />
    <bpmn:endEvent id="done" name="Meal eaten" />
    <bpmn:task id="pos" name="Enter the order into the POS system" />
    <bpmn:task id="collect" name="Collect the money from the guest" />
    <bpmn:task id="setup" name="Set up the buzzer" />
    <bpmn:task id="pass_buzzer" name="Pass the buzzer on to the guest with the information" />
    <bpmn:task id="inform_chef" name="Inform the chef of the new meal order" />
    <bpmn:task id="setoff" name="Set off the guest's buzzer" />
    <bpmn:task id="call" name="Call the guest after 5 minutes" />
    <bpmn:task id="serve" name="Hand over the meal" />
    <bpmn:task id="prepare" name="Prepare the meal" />
    <bpmn:task id="hatch" name="Place the meal in the service hatch" />
    <bpmn:task id="inform_ready" name="Inform the employee that the meal is in the service hatch" />
    <bpmn:sequenceFlow id="f-hungry-enter" sourceRef="hungry" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-choose" sourceRef="enter" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-wait" sourceRef="choose" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-order" sourceRef="wait" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-pos" sourceRef="order" targetRef="pos" />
    <bpmn:sequenceFlow id="f-pos-collect" sourceRef="pos" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-setup" sourceRef="collect" targetRef="setup" />
    <bpmn:sequenceFlow id="f-setup-pass_buzzer" sourceRef="setup" targetRef="pass_buzzer" />
    <bpmn:sequenceFlow id="f-pass_buzzer-inform_chef" sourceRef="pass_buzzer" targetRef="inform_chef" />
    <bpmn:sequenceFlow id="f-inform_chef-prepare" sourceRef="inform_chef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-hatch" sourceRef="prepare" targetRef="hatch" />
    <bpmn:sequenceFlow id="f-hatch-inform_ready" sourceRef="hatch" targetRef="inform_ready" />
    <bpmn:sequenceFlow id="f-inform_ready-setoff" sourceRef="inform_ready" targetRef="setoff" />
    <bpmn:sequenceFlow id="f-setoff-ring" sourceRef="setoff" targetRef="ring" />
    <bpmn:sequenceFlow id="f-call-ring" sourceRef="call" targetRef="ring" />
    <bpmn:sequenceFlow id="f-ring-reacts" sourceRef="ring" targetRef="reacts" />
    <bpmn:sequenceFlow id="f-reacts-go_hatch" name="yes" sourceRef="reacts" targetRef="go_hatch" />
    <bpmn:sequenceFlow id="f-reacts-call" name="no" sourceRef="reacts" targetRef="call" />
    <bpmn:sequenceFlow id="f-go_hatch-serve" sourceRef="go_hatch" targetRef="serve" />
    <bpmn:sequenceFlow id="f-serve-eat" sourceRef="serve" targetRef="eat" />
    <bpmn:sequenceFlow id="f-eat-done" sourceRef="eat" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
