tok 1.0 "Restaurant meal service"

pool restaurant "Restaurant"
  lane guest "Guest"
    start hungry "Guest feels hungry"
    task enter "Enter the restaurant"
    task choose "Choose a dish from the changing meal range"
    task wait "Wait until it is his turn"
    task order "Place the order with the employee"
    task go_hatch "Go to the service hatch"
    task eat "Eat the meal"
    xor reacts "Guest reacts to the buzzer?"
    end done "Meal eaten"
  lane employee "Employee"
    task pos "Enter the order into the POS system"
    task collect "Collect the money from the guest"
    task setup "Set up the buzzer"
    task pass_buzzer "Pass the buzzer on to the guest with the information"
    task inform_chef "Inform the chef of the new meal order"
    task setoff "Set off the guest's buzzer"
    task call "Call the guest after 5 minutes"
    task serve "Hand over the meal"
  lane chef "Chef"
    task prepare "Prepare the meal"
    task hatch "Place the meal in the service hatch"
    task inform_ready "Inform the employee that the meal is in the service hatch"

flow hungry -> enter -> choose -> wait -> order -> pos -> collect -> setup -> pass_buzzer -> inform_chef -> prepare -> hatch -> inform_ready -> setoff -> reacts
flow reacts -> go_hatch "yes"
flow reacts -> call "no"
flow call -> reacts
flow go_hatch -> serve -> eat -> done