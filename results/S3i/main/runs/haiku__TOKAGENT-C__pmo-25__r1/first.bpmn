<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="seeker" name="Find a Job" processRef="seeker-process" />
  </bpmn:collaboration>
  <bpmn:process id="seeker-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="seeker-lanes">
      <bpmn:lane id="jobseeker" name="Job seeker">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low_rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_seeker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>not_permanent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>send_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_later</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Job search started" />
    <bpmn:task id="report" name="Report the companies you wrote job applications to" />
    <bpmn:task id="rate_company" name="Rate the company" />
    <bpmn:exclusiveGateway id="low_rating" name="Company rated C or less?" />
    <bpmn:endEvent id="ended" name="Job search ended" />
    <bpmn:task id="confirm" name="Confirm the receipt of the job application" />
    <bpmn:task id="rate_application" name="Rate the job application" />
    <bpmn:task id="negotiate" name="Negotiate a job interview" />
    <bpmn:exclusiveGateway id="wants" name="Company wants you to work for them?" />
    <bpmn:endEvent id="rejected" name="Application not pursued" />
    <bpmn:task id="probation" name="Enter the probation phase" />
    <bpmn:parallelGateway id="split_review" />
    <bpmn:task id="rate_seeker" name="Rate the job applicant" />
    <bpmn:parallelGateway id="join_review" />
    <bpmn:exclusiveGateway id="permanent" name="Job becomes permanent?" />
    <bpmn:endEvent id="not_permanent" name="Probation ended" />
    <bpmn:task id="send_offers" name="Send new potential job offers" />
    <bpmn:task id="send_later" name="Send job offers without reporting" />
    <bpmn:endEvent id="offers" name="Job offers continue" />
    <bpmn:sequenceFlow id="f-started-report" sourceRef="started" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-send_offers" sourceRef="report" targetRef="send_offers" />
    <bpmn:sequenceFlow id="f-send_offers-confirm" sourceRef="send_offers" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rate_application" sourceRef="confirm" targetRef="rate_application" />
    <bpmn:sequenceFlow id="f-rate_application-negotiate" sourceRef="rate_application" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-wants" sourceRef="negotiate" targetRef="wants" />
    <bpmn:sequenceFlow id="f-wants-rejected" name="no" sourceRef="wants" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-wants-probation" name="yes" sourceRef="wants" targetRef="probation" />
    <bpmn:sequenceFlow id="f-probation-split_review" sourceRef="probation" targetRef="split_review" />
    <bpmn:sequenceFlow id="f-split_review-rate_company" sourceRef="split_review" targetRef="rate_company" />
    <bpmn:sequenceFlow id="f-split_review-rate_seeker" sourceRef="split_review" targetRef="rate_seeker" />
    <bpmn:sequenceFlow id="f-rate_company-join_review" sourceRef="rate_company" targetRef="join_review" />
    <bpmn:sequenceFlow id="f-rate_seeker-join_review" sourceRef="rate_seeker" targetRef="join_review" />
    <bpmn:sequenceFlow id="f-join_review-permanent" sourceRef="join_review" targetRef="permanent" />
    <bpmn:sequenceFlow id="f-permanent-not_permanent" name="no" sourceRef="permanent" targetRef="not_permanent" />
    <bpmn:sequenceFlow id="f-permanent-low_rating" name="yes" sourceRef="permanent" targetRef="low_rating" />
    <bpmn:sequenceFlow id="f-low_rating-send_later" name="C or less" sourceRef="low_rating" targetRef="send_later" />
    <bpmn:sequenceFlow id="f-low_rating-ended" name="better than C" sourceRef="low_rating" targetRef="ended" />
    <bpmn:sequenceFlow id="f-send_later-offers" sourceRef="send_later" targetRef="offers" />
  </bpmn:process>
</bpmn:definitions>
