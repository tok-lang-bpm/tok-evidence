<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming A Parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Organisation" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyCo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extendLeave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ss" name="Social Security">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Maternity leave needed" />
    <bpmn:task id="select" name="Select the leave model" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="notifySS" name="Notify Social Security in time" />
    <bpmn:task id="notifyCo" name="Notify the company in time" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="decide" name="Decide about the extension" />
    <bpmn:exclusiveGateway id="extend" name="Extend the leave?" />
    <bpmn:task id="extendLeave" name="Extend the maternity leave" />
    <bpmn:endEvent id="ended" name="Leave ended" />
    <bpmn:endEvent id="extended" name="Leave extended" />
    <bpmn:task id="fetch" name="Fetch information about leave models" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:sequenceFlow id="f-needed-fetch" sourceRef="needed" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-collect" sourceRef="select" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-split" sourceRef="collect" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-notifySS" sourceRef="split" targetRef="notifySS" />
    <bpmn:sequenceFlow id="f-notifySS-joined" sourceRef="notifySS" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-notifyCo" sourceRef="split" targetRef="notifyCo" />
    <bpmn:sequenceFlow id="f-notifyCo-joined" sourceRef="notifyCo" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-gather" sourceRef="joined" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-decide" sourceRef="gather" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-extend" sourceRef="decide" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-extendLeave" name="yes" sourceRef="extend" targetRef="extendLeave" />
    <bpmn:sequenceFlow id="f-extend-ended" name="no" sourceRef="extend" targetRef="ended" />
    <bpmn:sequenceFlow id="f-extendLeave-extended" sourceRef="extendLeave" targetRef="extended" />
  </bpmn:process>
</bpmn:definitions>
