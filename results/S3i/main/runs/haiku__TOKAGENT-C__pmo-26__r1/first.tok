tok 1.0 "Becoming A Parent"

pool office "Organisation"
  lane parent "Parent"
    start needed "Maternity leave needed"
    task select "Select the leave model"
    task collect "Collect relevant information"
    and split
    task notifySS "Notify Social Security in time"
    task notifyCo "Notify the company in time"
    and joined
    task decide "Decide about the extension"
    xor extend "Extend the leave?"
    task extendLeave "Extend the maternity leave"
    end ended "Leave ended"
    end extended "Leave extended"
  lane ss "Social Security"
    task fetch "Fetch information about leave models"
    task gather "Gather information from companies"

flow needed -> fetch -> select -> collect -> split
flow split -> notifySS -> joined
flow split -> notifyCo -> joined
flow joined -> gather -> decide -> extend
flow extend -> extendLeave "yes"
flow extend -> ended "no"
flow extendLeave -> extended