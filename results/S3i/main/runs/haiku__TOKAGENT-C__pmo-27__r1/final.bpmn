<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work accident" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Insured employee">
        <bpmn:flowNodeRef>occurred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEmployer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>workAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordNear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nearDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportLabour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportInsurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="insurer" name="Accident insurance provider">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="occurred" name="Accident or near miss occurs" />
    <bpmn:task id="informEmployer" name="Inform the employer immediately" />
    <bpmn:task id="gather" name="Gather information about the accident" />
    <bpmn:exclusiveGateway id="workAcc" name="Work accident?" />
    <bpmn:task id="recordNear" name="Record the near miss" />
    <bpmn:endEvent id="nearDone" name="Near miss recorded" />
    <bpmn:exclusiveGateway id="serious" name="Fatality or serious injury?" />
    <bpmn:task id="reportLabour" name="Report the accident to the Labour Inspectorate immediately" />
    <bpmn:exclusiveGateway id="days" name="Killed or unable to work for three days?" />
    <bpmn:task id="reportInsurer" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:endEvent id="noReport" name="No insurer report required" />
    <bpmn:task id="process" name="Process the accident report" />
    <bpmn:endEvent id="processed" name="Accident report processed" />
    <bpmn:sequenceFlow id="f-occurred-informEmployer" sourceRef="occurred" targetRef="informEmployer" />
    <bpmn:sequenceFlow id="f-informEmployer-gather" sourceRef="informEmployer" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-workAcc" sourceRef="gather" targetRef="workAcc" />
    <bpmn:sequenceFlow id="f-workAcc-recordNear" name="no" sourceRef="workAcc" targetRef="recordNear" />
    <bpmn:sequenceFlow id="f-recordNear-nearDone" sourceRef="recordNear" targetRef="nearDone" />
    <bpmn:sequenceFlow id="f-workAcc-serious" name="yes" sourceRef="workAcc" targetRef="serious" />
    <bpmn:sequenceFlow id="f-serious-reportLabour" name="yes" sourceRef="serious" targetRef="reportLabour" />
    <bpmn:sequenceFlow id="f-reportLabour-days" sourceRef="reportLabour" targetRef="days" />
    <bpmn:sequenceFlow id="f-serious-days" name="no" sourceRef="serious" targetRef="days" />
    <bpmn:sequenceFlow id="f-days-reportInsurer" name="yes" sourceRef="days" targetRef="reportInsurer" />
    <bpmn:sequenceFlow id="f-days-noReport" name="no" sourceRef="days" targetRef="noReport" />
    <bpmn:sequenceFlow id="f-reportInsurer-process" sourceRef="reportInsurer" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-processed" sourceRef="process" targetRef="processed" />
  </bpmn:process>
</bpmn:definitions>
