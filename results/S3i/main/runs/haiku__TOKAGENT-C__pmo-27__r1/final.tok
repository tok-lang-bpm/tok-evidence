tok 1.0 "Work accident"

pool org "Organisation"
  lane employee "Insured employee"
    start occurred "Accident or near miss occurs"
    task informEmployer "Inform the employer immediately"
  lane employer "Employer"
    task gather "Gather information about the accident"
    xor workAcc "Work accident?"
    task recordNear "Record the near miss"
    end nearDone "Near miss recorded"
    xor serious "Fatality or serious injury?"
    task reportLabour "Report the accident to the Labour Inspectorate immediately"
    xor days "Killed or unable to work for three days?"
    task reportInsurer "Report the accident to the accident insurance provider within five days"
    end noReport "No insurer report required"
  lane insurer "Accident insurance provider"
    task process "Process the accident report"
    end processed "Accident report processed"

flow occurred -> informEmployer -> gather -> workAcc
flow workAcc -> recordNear "no"
flow recordNear -> nearDone
flow workAcc -> serious "yes"
flow serious -> reportLabour "yes"
flow reportLabour -> days
flow serious -> days "no"
flow days -> reportInsurer "yes"
flow days -> noReport "no"
flow reportInsurer -> process -> processed
