<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Internship" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wish" name="Student wants an internship" />
    <bpmn:task id="enter" name="Enter the topic of interest, the wanted salary, experience and hobbies" />
    <bpmn:exclusiveGateway id="wait" name="Wait for offers" />
    <bpmn:exclusiveGateway id="accepted" name="Offer accepted?" />
    <bpmn:task id="accept" name="Accept the offer" />
    <bpmn:task id="deny" name="Deny the offer" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="write" name="Write a status update about the internship">
      <bpmn:standardLoopCharacteristics loopMaximum="3">
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">weeks &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="recommend" name="Recommend the company to friends on Twitter">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="done" name="Internship finished" />
    <bpmn:task id="offer" name="Send an offer" />
    <bpmn:task id="invalidate" name="Invalidate all other offers" />
    <bpmn:task id="report" name="Write a status update about the student">
      <bpmn:standardLoopCharacteristics loopMaximum="3">
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">weeks &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:sequenceFlow id="f-wish-enter" sourceRef="wish" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-wait" sourceRef="enter" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-offer" sourceRef="wait" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-accepted" sourceRef="offer" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-accept" name="yes" sourceRef="accepted" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accepted-deny" name="no" sourceRef="accepted" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-wait" sourceRef="deny" targetRef="wait" />
    <bpmn:sequenceFlow id="f-accept-invalidate" sourceRef="accept" targetRef="invalidate" />
    <bpmn:sequenceFlow id="f-invalidate-split" sourceRef="invalidate" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-write" sourceRef="split" targetRef="write" />
    <bpmn:sequenceFlow id="f-split-report" sourceRef="split" targetRef="report" />
    <bpmn:sequenceFlow id="f-write-joined" sourceRef="write" targetRef="joined" />
    <bpmn:sequenceFlow id="f-report-joined" sourceRef="report" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-recommend" sourceRef="joined" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-done" sourceRef="recommend" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
