tok 1.0 "Internship"

pool org "Internship"
  lane student "Student"
    start wish "Student wants an internship"
    task enter "Enter the topic of interest, the wanted salary, experience and hobbies"
    xor wait "Wait for offers"
    xor accepted "Offer accepted?"
    task accept "Accept the offer"
    task deny "Deny the offer"
    and split
    task write "Write a status update about the internship" loop while="weeks < 3" loop-max=3
    and joined
    task recommend "Recommend the company to friends on Twitter" parallel
    end done "Internship finished"
  lane company "Company"
    task offer "Send an offer"
    task invalidate "Invalidate all other offers"
    task report "Write a status update about the student" loop while="weeks < 3" loop-max=3

flow wish -> enter -> wait -> offer -> accepted
flow accepted -> accept "yes"
flow accepted -> deny "no"
flow deny -> wait
flow accept -> invalidate -> split
flow split -> write
flow split -> report
flow write -> joined
flow report -> joined
flow joined -> recommend -> done