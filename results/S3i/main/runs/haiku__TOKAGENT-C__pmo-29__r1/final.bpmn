<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and Live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>supplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>renew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="office" name="Representation office (BMEIA)">
        <bpmn:flowNodeRef>competence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Move to Austria planned" />
    <bpmn:parallelGateway id="split" name="Start in parallel?" />
    <bpmn:task id="negotiate" name="Negotiate accommodation" />
    <bpmn:task id="bank" name="Open bank account" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="prepare" name="Gather visa documents" />
    <bpmn:task id="apply" name="Submit visa application form" />
    <bpmn:task id="supplement" name="Supply the missing documents" />
    <bpmn:task id="renew" name="Plan visa renewal" />
    <bpmn:endEvent id="done" name="Stay in Austria with valid visa" />
    <bpmn:task id="competence" name="Check territorial competence" />
    <bpmn:exclusiveGateway id="complete" name="Application complete?" />
    <bpmn:task id="request" name="Request additional documents" />
    <bpmn:exclusiveGateway id="decide" name="Visa granted?" />
    <bpmn:task id="issue" name="Issue Rot-Weiss-Rot visa" />
    <bpmn:task id="refuse" name="Refuse visa" />
    <bpmn:endEvent id="refused" name="Application refused" />
    <bpmn:sequenceFlow id="f-needed-split" sourceRef="needed" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-negotiate" sourceRef="split" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-split-bank" sourceRef="split" targetRef="bank" />
    <bpmn:sequenceFlow id="f-negotiate-joined" sourceRef="negotiate" targetRef="joined" />
    <bpmn:sequenceFlow id="f-bank-joined" sourceRef="bank" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-prepare" sourceRef="joined" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-apply" sourceRef="prepare" targetRef="apply" />
    <bpmn:sequenceFlow id="f-apply-competence" sourceRef="apply" targetRef="competence" />
    <bpmn:sequenceFlow id="f-competence-complete" sourceRef="competence" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-decide" name="yes" sourceRef="complete" targetRef="decide" />
    <bpmn:sequenceFlow id="f-complete-request" name="no" sourceRef="complete" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-supplement" sourceRef="request" targetRef="supplement" />
    <bpmn:sequenceFlow id="f-supplement-complete" sourceRef="supplement" targetRef="complete" />
    <bpmn:sequenceFlow id="f-decide-issue" name="yes" sourceRef="decide" targetRef="issue" />
    <bpmn:sequenceFlow id="f-decide-refuse" name="no" sourceRef="decide" targetRef="refuse" />
    <bpmn:sequenceFlow id="f-issue-renew" sourceRef="issue" targetRef="renew" />
    <bpmn:sequenceFlow id="f-renew-done" sourceRef="renew" targetRef="done" />
    <bpmn:sequenceFlow id="f-refuse-refused" sourceRef="refuse" targetRef="refused" />
  </bpmn:process>
</bpmn:definitions>
