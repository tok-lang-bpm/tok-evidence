tok 1.0 "Work and Live in Austria"

pool austria "Work and Live in Austria"
  lane applicant "Applicant"
    start needed "Move to Austria planned"
    and split "Start in parallel?"
    task negotiate "Negotiate accommodation"
    task bank "Open bank account"
    and joined
    task prepare "Gather visa documents"
    task apply "Submit visa application form"
    task supplement "Supply the missing documents"
    task renew "Plan visa renewal"
    end done "Stay in Austria with valid visa"
  lane office "Representation office (BMEIA)"
    task competence "Check territorial competence"
    xor complete "Application complete?"
    task request "Request additional documents"
    xor decide "Visa granted?"
    task issue "Issue Rot-Weiss-Rot visa"
    task refuse "Refuse visa"
    end refused "Application refused"

flow needed -> split
flow split -> negotiate
flow split -> bank
flow negotiate -> joined
flow bank -> joined
flow joined -> prepare -> apply -> competence -> complete
flow complete -> decide "yes"
flow complete -> request "no"
flow request -> supplement -> complete
flow decide -> issue "yes"
flow decide -> refuse "no"
flow issue -> renew -> done
flow refuse -> refused