<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organiser" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="me" name="Organiser (you)">
        <bpmn:flowNodeRef>planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>other-date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="planning" name="LAN party planning started" />
    <bpmn:task id="invite" name="Send the invitations to the 10 friends" />
    <bpmn:task id="find-games" name="Find out which games the friends want to play" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="appoint-date" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree on the date?" />
    <bpmn:task id="other-date" name="Appoint another date" />
    <bpmn:task id="check-games" name="Check whether you have all the games" />
    <bpmn:exclusiveGateway id="missing" name="Games missing?" />
    <bpmn:task id="download" name="Download the missing games" />
    <bpmn:exclusiveGateway id="games-merge" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="find-beer" name="Find out how much beer the friends will require" />
    <bpmn:exclusiveGateway id="enough" name="Enough beer?" />
    <bpmn:task id="buy-beer" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="beer-merge" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="done" name="LAN party enjoyed" />
    <bpmn:sequenceFlow id="f-planning-invite" sourceRef="planning" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-find-games" sourceRef="invite" targetRef="find-games" />
    <bpmn:sequenceFlow id="f-find-games-split" sourceRef="find-games" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-appoint-date" sourceRef="split" targetRef="appoint-date" />
    <bpmn:sequenceFlow id="f-appoint-date-agree" sourceRef="appoint-date" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-joined" name="yes" sourceRef="agree" targetRef="joined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreed &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-agree-other-date" name="no" sourceRef="agree" targetRef="other-date">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreed &lt; 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-other-date-appoint-date" sourceRef="other-date" targetRef="appoint-date" />
    <bpmn:sequenceFlow id="f-split-check-games" sourceRef="split" targetRef="check-games" />
    <bpmn:sequenceFlow id="f-check-games-missing" sourceRef="check-games" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-download" name="yes" sourceRef="missing" targetRef="download">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">games_missing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-games-merge" name="no" sourceRef="missing" targetRef="games-merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">games_missing = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-download-games-merge" sourceRef="download" targetRef="games-merge" />
    <bpmn:sequenceFlow id="f-games-merge-joined" sourceRef="games-merge" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-find-beer" sourceRef="joined" targetRef="find-beer" />
    <bpmn:sequenceFlow id="f-find-beer-enough" sourceRef="find-beer" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-beer-merge" name="yes" sourceRef="enough" targetRef="beer-merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">beer_enough = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-enough-buy-beer" name="no" sourceRef="enough" targetRef="buy-beer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">beer_enough = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-buy-beer-beer-merge" sourceRef="buy-beer" targetRef="beer-merge" />
    <bpmn:sequenceFlow id="f-beer-merge-enjoy" sourceRef="beer-merge" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-done" sourceRef="enjoy" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
