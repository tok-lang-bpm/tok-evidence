<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Expansion_released" name="Expansion released" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Blizzard system">
        <bpmn:flowNodeRef>check_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Character creation started" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="names" name="Come up with character names" />
    <bpmn:task id="enter_account" name="Enter the account information" />
    <bpmn:task id="click_link" name="Click the link in the confirmation mail" />
    <bpmn:exclusiveGateway id="pay_choice" name="Payment method?" />
    <bpmn:task id="card" name="Enter the credit card information" />
    <bpmn:task id="iban" name="Enter the IBAN and BIC numbers" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="select" name="Select realm, race and class" />
    <bpmn:task id="enter_name" name="Enter a character name" />
    <bpmn:task id="receive" name="Receive the confirmation and selfies" />
    <bpmn:intermediateCatchEvent id="expansion" name="Expansion released">
      <bpmn:messageEventDefinition id="expansion-def" messageRef="Message_Expansion_released" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="done" name="Character created" />
    <bpmn:task id="check_account" name="Check whether a battle.net account exists" />
    <bpmn:exclusiveGateway id="has_account" name="Battle.net account?" />
    <bpmn:exclusiveGateway id="merge_account" />
    <bpmn:task id="check_sub" name="Check whether an active WoW subscription exists" />
    <bpmn:exclusiveGateway id="has_sub" name="Active WoW subscription?" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:exclusiveGateway id="name_ok" name="Name still available?" />
    <bpmn:sequenceFlow id="f-begin-split" sourceRef="begin" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-names" sourceRef="split" targetRef="names" />
    <bpmn:sequenceFlow id="f-names-joined" sourceRef="names" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-check_account" sourceRef="split" targetRef="check_account" />
    <bpmn:sequenceFlow id="f-check_account-has_account" sourceRef="check_account" targetRef="has_account" />
    <bpmn:sequenceFlow id="f-has_account-enter_account" name="no" sourceRef="has_account" targetRef="enter_account" />
    <bpmn:sequenceFlow id="f-enter_account-click_link" sourceRef="enter_account" targetRef="click_link" />
    <bpmn:sequenceFlow id="f-click_link-merge_account" sourceRef="click_link" targetRef="merge_account" />
    <bpmn:sequenceFlow id="f-has_account-merge_account" name="yes" sourceRef="has_account" targetRef="merge_account" />
    <bpmn:sequenceFlow id="f-merge_account-check_sub" sourceRef="merge_account" targetRef="check_sub" />
    <bpmn:sequenceFlow id="f-check_sub-has_sub" sourceRef="check_sub" targetRef="has_sub" />
    <bpmn:sequenceFlow id="f-has_sub-ready" name="yes" sourceRef="has_sub" targetRef="ready" />
    <bpmn:sequenceFlow id="f-has_sub-pay_choice" name="no" sourceRef="has_sub" targetRef="pay_choice" />
    <bpmn:sequenceFlow id="f-pay_choice-card" name="credit card" sourceRef="pay_choice" targetRef="card" />
    <bpmn:sequenceFlow id="f-pay_choice-iban" name="bank account" sourceRef="pay_choice" targetRef="iban" />
    <bpmn:sequenceFlow id="f-card-ready" sourceRef="card" targetRef="ready" />
    <bpmn:sequenceFlow id="f-iban-ready" sourceRef="iban" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-joined" sourceRef="ready" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-login" sourceRef="joined" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-select" sourceRef="login" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-enter_name" sourceRef="select" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-enter_name-name_ok" sourceRef="enter_name" targetRef="name_ok" />
    <bpmn:sequenceFlow id="f-name_ok-enter_name" name="taken" sourceRef="name_ok" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f-name_ok-receive" name="available" sourceRef="name_ok" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-expansion" sourceRef="receive" targetRef="expansion" />
    <bpmn:sequenceFlow id="f-expansion-done" sourceRef="expansion" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
