<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Custom 3D model: artist and 3D printing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="3D printing project" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Custom 3D model: artist and 3D printing" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>craving</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkLeft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendStl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="craving" name="Custom 3D model wanted" />
    <bpmn:task id="instruct" name="Instruct the artist to create a project" />
    <bpmn:task id="sketches" name="Send several sketches to the artist" />
    <bpmn:task id="review" name="Review the result" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with the result?" />
    <bpmn:task id="tell" name="Tell the artist what to change" />
    <bpmn:task id="choose" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="inStock" name="Color in stock at home?" />
    <bpmn:task id="checkLeft" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under" name="Under 100 grams?" />
    <bpmn:task id="addList" name="Put the plastic on the shopping list" />
    <bpmn:task id="order" name="Order the plastic" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:parallelGateway id="prep" />
    <bpmn:task id="heat" name="Turn the printer on and heat up the bed and the extruder">
      <bpmn:documentation>The printer continuously sends its status back.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="gcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="prepped" />
    <bpmn:task id="print" name="Print the model" />
    <bpmn:endEvent id="done" name="Model printed" />
    <bpmn:task id="create" name="Create the project" />
    <bpmn:task id="change" name="Change the project" />
    <bpmn:task id="sendStl" name="Send the STL file" />
    <bpmn:sequenceFlow id="f-craving-instruct" sourceRef="craving" targetRef="instruct" />
    <bpmn:sequenceFlow id="f-instruct-sketches" sourceRef="instruct" targetRef="sketches" />
    <bpmn:sequenceFlow id="f-sketches-create" sourceRef="sketches" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-review" sourceRef="create" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-satisfied" sourceRef="review" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-satisfied-tell" name="no" sourceRef="satisfied" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-change" sourceRef="tell" targetRef="change" />
    <bpmn:sequenceFlow id="f-change-review" sourceRef="change" targetRef="review" />
    <bpmn:sequenceFlow id="f-satisfied-sendStl" name="yes" sourceRef="satisfied" targetRef="sendStl" />
    <bpmn:sequenceFlow id="f-sendStl-choose" sourceRef="sendStl" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-inStock" sourceRef="choose" targetRef="inStock" />
    <bpmn:sequenceFlow id="f-inStock-checkLeft" name="yes" sourceRef="inStock" targetRef="checkLeft" />
    <bpmn:sequenceFlow id="f-inStock-order" name="no" sourceRef="inStock" targetRef="order" />
    <bpmn:sequenceFlow id="f-checkLeft-under" sourceRef="checkLeft" targetRef="under" />
    <bpmn:sequenceFlow id="f-under-addList" name="yes" sourceRef="under" targetRef="addList" />
    <bpmn:sequenceFlow id="f-under-ready" name="no" sourceRef="under" targetRef="ready" />
    <bpmn:sequenceFlow id="f-addList-ready" sourceRef="addList" targetRef="ready" />
    <bpmn:sequenceFlow id="f-order-ready" sourceRef="order" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-prep" sourceRef="ready" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-heat" sourceRef="prep" targetRef="heat" />
    <bpmn:sequenceFlow id="f-prep-gcode" sourceRef="prep" targetRef="gcode" />
    <bpmn:sequenceFlow id="f-heat-prepped" sourceRef="heat" targetRef="prepped" />
    <bpmn:sequenceFlow id="f-gcode-prepped" sourceRef="gcode" targetRef="prepped" />
    <bpmn:sequenceFlow id="f-prepped-print" sourceRef="prepped" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-done" sourceRef="print" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
