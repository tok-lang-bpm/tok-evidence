tok 1.0 "Custom 3D model: artist and 3D printing"

pool shop "3D printing project"
  lane customer "Customer"
    start craving "Custom 3D model wanted"
    task instruct "Instruct the artist to create a project"
    task sketches "Send several sketches to the artist"
    task review "Review the result"
    xor satisfied "Satisfied with the result?"
    task tell "Tell the artist what to change"
    task choose "Choose a plastic color"
    xor inStock "Color in stock at home?"
    task checkLeft "Check how much color is left"
    xor under "Under 100 grams?"
    task addList "Put the plastic on the shopping list"
    task order "Order the plastic"
    xor ready
    and prep
    task heat "Turn the printer on and heat up the bed and the extruder" doc="The printer continuously sends its status back."
    task gcode "Generate the gcode file from the STL"
    and prepped
    task print "Print the model"
    end done "Model printed"
  lane artist "Artist"
    task create "Create the project"
    task change "Change the project"
    task sendStl "Send the STL file"

flow craving -> instruct -> sketches -> create -> review -> satisfied
flow satisfied -> tell "no"
flow tell -> change -> review
flow satisfied -> sendStl "yes"
flow sendStl -> choose -> inStock
flow inStock -> checkLeft "yes"
flow inStock -> order "no"
flow checkLeft -> under
flow under -> addList "yes"
flow under -> ready "no"
flow addList -> ready
flow order -> ready
flow ready -> prep
flow prep -> heat
flow prep -> gcode
flow heat -> prepped
flow gcode -> prepped
flow prepped -> print -> done