tok 1.0 "Building a custom machine out of Lego bricks"

pool org "Lego machine project"
  lane builder "Builder"
    start begin "Custom machine project started"
    task design "Develop the basic design"
    task order "Order the Lego brick sets"
    task give "Give the sets to the children"
    xor parts "Parts left in the container?"
    task reorder "Reorder individual parts"
    xor ready "Parts ready"
    task build "Build the subcomponent"
    task test "Test the subcomponent individually"
    xor tested "Test successful?"
    task redesign "Redesign and rebuild the subcomponent"
    task assemble "Assemble the subcomponents"
    end done "Machine built"
  lane children "Group of children"
    task sort "Sort the parts into the containers"

flow begin -> design -> order -> give -> sort -> parts
flow parts -> ready "yes"
flow parts -> reorder "no"
flow reorder -> ready
flow redesign -> ready
flow ready -> build -> test -> tested
flow tested -> assemble "yes"
flow tested -> redesign "no"
flow assemble -> done
