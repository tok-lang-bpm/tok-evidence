<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a custom machine out of Lego bricks" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Lego machine project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a custom machine out of Lego bricks" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Group of children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Custom machine project started" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order the Lego brick sets" />
    <bpmn:task id="give" name="Give the sets to the children" />
    <bpmn:exclusiveGateway id="parts" name="Parts left in the container?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:exclusiveGateway id="ready" name="Parts ready" />
    <bpmn:task id="build" name="Build the subcomponent" />
    <bpmn:task id="test" name="Test the subcomponent individually" />
    <bpmn:exclusiveGateway id="tested" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign and rebuild the subcomponent" />
    <bpmn:task id="assemble" name="Assemble the subcomponents" />
    <bpmn:endEvent id="done" name="Machine built" />
    <bpmn:task id="sort" name="Sort the parts into the containers" />
    <bpmn:sequenceFlow id="f-begin-design" sourceRef="begin" targetRef="design" />
    <bpmn:sequenceFlow id="f-design-order" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-give" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-sort" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f-sort-parts" sourceRef="sort" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-ready" name="yes" sourceRef="parts" targetRef="ready" />
    <bpmn:sequenceFlow id="f-parts-reorder" name="no" sourceRef="parts" targetRef="reorder" />
    <bpmn:sequenceFlow id="f-reorder-ready" sourceRef="reorder" targetRef="ready" />
    <bpmn:sequenceFlow id="f-redesign-ready" sourceRef="redesign" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-build" sourceRef="ready" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f-test-tested" sourceRef="test" targetRef="tested" />
    <bpmn:sequenceFlow id="f-tested-assemble" name="yes" sourceRef="tested" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-tested-redesign" name="no" sourceRef="tested" targetRef="redesign" />
    <bpmn:sequenceFlow id="f-assemble-done" sourceRef="assemble" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
