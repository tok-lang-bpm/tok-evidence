<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Chainsaw workshop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="workshop" name="Workshop">
        <bpmn:flowNodeRef>order_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assembly_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assembly_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_rest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ordered" name="Order placed" />
    <bpmn:task id="specify" name="Specify the properties of the chainsaw" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes the first saw?" />
    <bpmn:endEvent id="declined" name="Rest of the order not produced" />
    <bpmn:endEvent id="delivered" name="Order completed" />
    <bpmn:parallelGateway id="order_split" />
    <bpmn:task id="order_a" name="Order the parts from an online source" />
    <bpmn:task id="order_b" name="Order the parts from another online source" />
    <bpmn:parallelGateway id="order_join" />
    <bpmn:task id="inspect" name="Inspect all parts manually" />
    <bpmn:parallelGateway id="assembly_split" />
    <bpmn:task id="assemble" name="Assemble the first saw" />
    <bpmn:task id="update" name="Send production updates to the customer">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:parallelGateway id="assembly_join" />
    <bpmn:task id="send_first" name="Send the first saw to the customer" />
    <bpmn:task id="produce_rest" name="Produce the rest of the order" />
    <bpmn:sequenceFlow id="f-ordered-specify" sourceRef="ordered" targetRef="specify" />
    <bpmn:sequenceFlow id="f-specify-order_split" sourceRef="specify" targetRef="order_split" />
    <bpmn:sequenceFlow id="f-order_split-order_a" sourceRef="order_split" targetRef="order_a" />
    <bpmn:sequenceFlow id="f-order_a-order_join" sourceRef="order_a" targetRef="order_join" />
    <bpmn:sequenceFlow id="f-order_split-order_b" sourceRef="order_split" targetRef="order_b" />
    <bpmn:sequenceFlow id="f-order_b-order_join" sourceRef="order_b" targetRef="order_join" />
    <bpmn:sequenceFlow id="f-order_join-inspect" sourceRef="order_join" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-assembly_split" sourceRef="inspect" targetRef="assembly_split" />
    <bpmn:sequenceFlow id="f-assembly_split-assemble" sourceRef="assembly_split" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-assembly_join" sourceRef="assemble" targetRef="assembly_join" />
    <bpmn:sequenceFlow id="f-assembly_split-update" sourceRef="assembly_split" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-assembly_join" sourceRef="update" targetRef="assembly_join" />
    <bpmn:sequenceFlow id="f-assembly_join-send_first" sourceRef="assembly_join" targetRef="send_first" />
    <bpmn:sequenceFlow id="f-send_first-likes" sourceRef="send_first" targetRef="likes" />
    <bpmn:sequenceFlow id="f-likes-produce_rest" name="yes" sourceRef="likes" targetRef="produce_rest" />
    <bpmn:sequenceFlow id="f-produce_rest-delivered" sourceRef="produce_rest" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-likes-declined" name="no" sourceRef="likes" targetRef="declined" />
  </bpmn:process>
</bpmn:definitions>
