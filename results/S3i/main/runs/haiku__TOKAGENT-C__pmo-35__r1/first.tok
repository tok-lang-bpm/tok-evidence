tok 1.0 "Chainsaw"

pool shop "Chainsaw workshop"
  lane customer "Customer"
    start ordered "Order placed"
    task specify "Specify the properties of the chainsaw"
    xor likes "Customer likes the first saw?"
    end declined "Rest of the order not produced"
    end delivered "Order completed"
  lane workshop "Workshop"
    and order_split
    task order_a "Order the parts from an online source"
    task order_b "Order the parts from another online source"
    and order_join
    task inspect "Inspect all parts manually"
    and assembly_split
    task assemble "Assemble the first saw"
    task update "Send production updates to the customer" loop
    and assembly_join
    task send_first "Send the first saw to the customer"
    task produce_rest "Produce the rest of the order"

flow ordered -> specify -> order_split
flow order_split -> order_a -> order_join
flow order_split -> order_b -> order_join
flow order_join -> inspect -> assembly_split
flow assembly_split -> assemble -> assembly_join
flow assembly_split -> update -> assembly_join
flow assembly_join -> send_first -> likes
flow likes -> produce_rest "yes" -> delivered
flow likes -> declined "no"
