tok 1.0 "Luxury Airplane"

pool airplane "Airplane manufacturer"
  lane customer "Customer"
    start wish "Customer wants a luxury airplane"
    task specify "Specify the interior"
    task confirm "Confirm the delivery"
    end done "Delivery confirmed"
  lane sales "Sales"
    task receive "Receive the specifications"
    task send "Send the requirements to the teams"
    and split "Split the work"
    and joined "Join the parts"
    task deliver "Deliver the plane to the customer"
  lane russian "Russian team"
    task vodka "Manufacture the vodka bar"
  lane irish "Irish team"
    task whiskey "Manufacture the whiskey bar"
  lane interiors "Interior teams"
    task parts "Manufacture seats, colour and toilet water system"
  lane assembly "Assembly team"
    task assemble "Assemble the interior of the plane"
  lane pilot "Test pilot"
    task flight "Test flight the plane"
    task protocol "Create the test protocol"
    task report "Send the test protocol to the company and the customer"

flow wish -> specify -> receive -> send -> split
flow split -> vodka
flow split -> whiskey
flow split -> parts
flow vodka -> joined
flow whiskey -> joined
flow parts -> joined
flow joined -> assemble -> flight -> protocol -> report -> deliver -> confirm -> done
