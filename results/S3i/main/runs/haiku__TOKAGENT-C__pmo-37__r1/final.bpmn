<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="project" name="Contract project" processRef="project-process" />
  </bpmn:collaboration>
  <bpmn:process id="project-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="project-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>zeroq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderCheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorderFast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop" name="Web shop">
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Parts needed for the contract project" />
    <bpmn:task id="query" name="Query all web shops" />
    <bpmn:task id="compare" name="Find the web shop with the right parts, quantity, price and delivery time" />
    <bpmn:task id="list" name="Create a list of the parts ordered from each shop" />
    <bpmn:exclusiveGateway id="enough" name="One shop has enough parts?" />
    <bpmn:task id="order1" name="Order the cheapest parts from one shop" />
    <bpmn:task id="orderN" name="Order the cheapest parts from several shops" />
    <bpmn:exclusiveGateway id="ordered" />
    <bpmn:task id="receive" name="Receive the first parts" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:task id="check" name="Check the stock of a single part" />
    <bpmn:exclusiveGateway id="zeroq" name="Stock is zero?" />
    <bpmn:task id="mail" name="Write a mail to friends complaining about the web shops" />
    <bpmn:exclusiveGateway id="low5" name="Stock below 5?" />
    <bpmn:task id="reorderCheap" name="Reorder the cheapest parts" />
    <bpmn:exclusiveGateway id="low3" name="Stock below 3?" />
    <bpmn:task id="reorderFast" name="Reorder the fastest parts" />
    <bpmn:exclusiveGateway id="rest" />
    <bpmn:exclusiveGateway id="finished" name="Contract finished?" />
    <bpmn:endEvent id="done" name="Contract finished" />
    <bpmn:task id="answer" name="Answer with quantity, price and delivery time" />
    <bpmn:task id="deliver" name="Deliver the parts in batches in a random order" />
    <bpmn:sequenceFlow id="f-needed-query" sourceRef="needed" targetRef="query" />
    <bpmn:sequenceFlow id="f-query-answer" sourceRef="query" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-compare" sourceRef="answer" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-list" sourceRef="compare" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-enough" sourceRef="list" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-order1" name="yes" sourceRef="enough" targetRef="order1" />
    <bpmn:sequenceFlow id="f-enough-orderN" name="no" sourceRef="enough" targetRef="orderN" />
    <bpmn:sequenceFlow id="f-order1-ordered" sourceRef="order1" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-orderN-ordered" sourceRef="orderN" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-ordered-deliver" sourceRef="ordered" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-receive" sourceRef="deliver" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-build" sourceRef="receive" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-check" sourceRef="build" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-zeroq" sourceRef="check" targetRef="zeroq" />
    <bpmn:sequenceFlow id="f-zeroq-mail" name="zero" sourceRef="zeroq" targetRef="mail" />
    <bpmn:sequenceFlow id="f-zeroq-low5" name="not zero" sourceRef="zeroq" targetRef="low5" />
    <bpmn:sequenceFlow id="f-mail-rest" sourceRef="mail" targetRef="rest" />
    <bpmn:sequenceFlow id="f-low5-reorderCheap" name="below 5" sourceRef="low5" targetRef="reorderCheap" />
    <bpmn:sequenceFlow id="f-low5-rest" name="5 or more" sourceRef="low5" targetRef="rest" />
    <bpmn:sequenceFlow id="f-reorderCheap-low3" sourceRef="reorderCheap" targetRef="low3" />
    <bpmn:sequenceFlow id="f-low3-reorderFast" name="below 3" sourceRef="low3" targetRef="reorderFast" />
    <bpmn:sequenceFlow id="f-low3-rest" name="3 or more" sourceRef="low3" targetRef="rest" />
    <bpmn:sequenceFlow id="f-reorderFast-rest" sourceRef="reorderFast" targetRef="rest" />
    <bpmn:sequenceFlow id="f-rest-finished" sourceRef="rest" targetRef="finished" />
    <bpmn:sequenceFlow id="f-finished-done" name="yes" sourceRef="finished" targetRef="done" />
    <bpmn:sequenceFlow id="f-finished-check" name="no" sourceRef="finished" targetRef="check" />
  </bpmn:process>
</bpmn:definitions>
