tok 1.0 "Contract"

pool project "Contract project"
  lane builder "Builder"
    start needed "Parts needed for the contract project"
    task query "Query all web shops"
    task compare "Find the web shop with the right parts, quantity, price and delivery time"
    task list "Create a list of the parts ordered from each shop"
    xor enough "One shop has enough parts?"
    task order1 "Order the cheapest parts from one shop"
    task orderN "Order the cheapest parts from several shops"
    xor ordered
    task receive "Receive the first parts"
    task build "Start building"
    task check "Check the stock of a single part"
    xor zeroq "Stock is zero?"
    task mail "Write a mail to friends complaining about the web shops"
    xor low5 "Stock below 5?"
    task reorderCheap "Reorder the cheapest parts"
    xor low3 "Stock below 3?"
    task reorderFast "Reorder the fastest parts"
    xor rest
    xor finished "Contract finished?"
    end done "Contract finished"
  lane shop "Web shop"
    task answer "Answer with quantity, price and delivery time"
    task deliver "Deliver the parts in batches in a random order"

flow needed -> query -> answer -> compare -> list -> enough
flow enough -> order1 "yes"
flow enough -> orderN "no"
flow order1 -> ordered
flow orderN -> ordered
flow ordered -> deliver -> receive -> build -> check -> zeroq
flow zeroq -> mail "zero"
flow zeroq -> low5 "not zero"
flow mail -> rest
flow low5 -> reorderCheap "below 5"
flow low5 -> rest "5 or more"
flow reorderCheap -> low3
flow low3 -> reorderFast "below 3"
flow low3 -> rest "3 or more"
flow reorderFast -> rest
flow rest -> finished
flow finished -> done "yes"
flow finished -> check "no"
