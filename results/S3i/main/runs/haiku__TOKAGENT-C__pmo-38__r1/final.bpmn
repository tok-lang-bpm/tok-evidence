<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="house" name="Tree house project" processRef="house-process" />
  </bpmn:collaboration>
  <bpmn:process id="house-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="house-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>wanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="stores" name="Online stores">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wanted" name="Tree house wanted" />
    <bpmn:task id="collect" name="Collect the requirements" />
    <bpmn:task id="send" name="Send the requirements to the architect" />
    <bpmn:task id="refine" name="Refine the draft with additional requirements" />
    <bpmn:exclusiveGateway id="final" name="Plan final?" />
    <bpmn:task id="materials" name="Create the list of needed materials" />
    <bpmn:task id="order" name="Order the materials from several online stores" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="msg" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="invite" name="Send invitations for the tree house party" />
    <bpmn:task id="list" name="Create the list of people attending the party" />
    <bpmn:task id="snacks" name="Buy the snacks for the party" />
    <bpmn:endEvent id="done" name="Party prepared" />
    <bpmn:task id="draft" name="Draft the plan" />
    <bpmn:task id="sendback" name="Send the draft back" />
    <bpmn:task id="build" name="Build the tree house" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:sequenceFlow id="f-wanted-collect" sourceRef="wanted" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-send" sourceRef="collect" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-draft" sourceRef="send" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-sendback" sourceRef="draft" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-refine" sourceRef="sendback" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-final" sourceRef="refine" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-refine" name="no" sourceRef="final" targetRef="refine" />
    <bpmn:sequenceFlow id="f-final-materials" name="yes" sourceRef="final" targetRef="materials" />
    <bpmn:sequenceFlow id="f-materials-order" sourceRef="materials" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-split" sourceRef="order" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-process" sourceRef="split" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-joined" sourceRef="process" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-msg" sourceRef="split" targetRef="msg" />
    <bpmn:sequenceFlow id="f-msg-joined" sourceRef="msg" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-build" sourceRef="joined" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-invite" sourceRef="build" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-list" sourceRef="invite" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-snacks" sourceRef="list" targetRef="snacks" />
    <bpmn:sequenceFlow id="f-snacks-done" sourceRef="snacks" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
