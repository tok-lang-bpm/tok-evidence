tok 1.0 "Building a House"

pool house "Tree house project"
  lane you "You"
    start wanted "Tree house wanted"
    task collect "Collect the requirements"
    task send "Send the requirements to the architect"
    task refine "Refine the draft with additional requirements"
    xor final "Plan final?"
    task materials "Create the list of needed materials"
    task order "Order the materials from several online stores"
    and split
    task msg "Send messages to friends to build the house"
    and joined
    task invite "Send invitations for the tree house party"
    task list "Create the list of people attending the party"
    task snacks "Buy the snacks for the party"
    end done "Party prepared"
  lane architect "Architect"
    task draft "Draft the plan"
    task sendback "Send the draft back"
  lane friends "Friends"
    task build "Build the tree house"
  lane stores "Online stores"
    task process "Process the order"

flow wanted -> collect -> send -> draft -> sendback -> refine -> final
flow final -> refine "no"
flow final -> materials "yes"
flow materials -> order -> split
flow split -> process -> joined
flow split -> msg -> joined
flow joined -> build -> invite -> list -> snacks -> done
