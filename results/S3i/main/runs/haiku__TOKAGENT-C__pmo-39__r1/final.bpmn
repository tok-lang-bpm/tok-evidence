<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="DIY Repair of a Broken Smartphone Screen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online repair tool" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>broken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>canborrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gathered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>works</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendexpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online tool">
        <bpmn:flowNodeRef>materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instructions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="friends" name="Friends">
        <bpmn:flowNodeRef>lend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="expert" name="Expert">
        <bpmn:flowNodeRef>expertrepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expertdone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="broken" name="Smartphone broken" />
    <bpmn:task id="enter" name="Enter the phone model and the damage" />
    <bpmn:task id="check" name="Check what you already have" />
    <bpmn:exclusiveGateway id="canborrow" name="Can friends lend or sell something cheaply?" default="f-canborrow-gathered" />
    <bpmn:task id="contact" name="Contact friends" />
    <bpmn:exclusiveGateway id="gathered" name="Items gathered" />
    <bpmn:task id="buy" name="Buy the remaining items" />
    <bpmn:task id="repair" name="Repair the phone" />
    <bpmn:exclusiveGateway id="works" name="Did the repair work?" default="f-works-sendexpert" />
    <bpmn:task id="review" name="Send a review and/or video of the repair" />
    <bpmn:task id="sendexpert" name="Send the phone to an expert" />
    <bpmn:endEvent id="done" name="Repair finished" />
    <bpmn:task id="materials" name="Show the list of materials and tools" />
    <bpmn:task id="choices" name="Offer the ordering choices for each part" />
    <bpmn:task id="instructions" name="Send the repair instructions" />
    <bpmn:task id="lend" name="Lend or sell items cheaply" />
    <bpmn:task id="expertrepair" name="Repair the phone" />
    <bpmn:endEvent id="expertdone" name="Phone repaired by an expert" />
    <bpmn:sequenceFlow id="f-broken-enter" sourceRef="broken" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-materials" sourceRef="enter" targetRef="materials" />
    <bpmn:sequenceFlow id="f-materials-choices" sourceRef="materials" targetRef="choices" />
    <bpmn:sequenceFlow id="f-choices-check" sourceRef="choices" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-canborrow" sourceRef="check" targetRef="canborrow" />
    <bpmn:sequenceFlow id="f-canborrow-contact" name="yes" sourceRef="canborrow" targetRef="contact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">friends_help = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-canborrow-gathered" name="no" sourceRef="canborrow" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-contact-lend" sourceRef="contact" targetRef="lend" />
    <bpmn:sequenceFlow id="f-lend-gathered" sourceRef="lend" targetRef="gathered" />
    <bpmn:sequenceFlow id="f-gathered-buy" sourceRef="gathered" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-instructions" sourceRef="buy" targetRef="instructions" />
    <bpmn:sequenceFlow id="f-instructions-repair" sourceRef="instructions" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-works" sourceRef="repair" targetRef="works" />
    <bpmn:sequenceFlow id="f-works-review" name="yes" sourceRef="works" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">repair_ok = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-works-sendexpert" name="no" sourceRef="works" targetRef="sendexpert" />
    <bpmn:sequenceFlow id="f-review-done" sourceRef="review" targetRef="done" />
    <bpmn:sequenceFlow id="f-sendexpert-expertrepair" sourceRef="sendexpert" targetRef="expertrepair" />
    <bpmn:sequenceFlow id="f-expertrepair-expertdone" sourceRef="expertrepair" targetRef="expertdone" />
  </bpmn:process>
</bpmn:definitions>
