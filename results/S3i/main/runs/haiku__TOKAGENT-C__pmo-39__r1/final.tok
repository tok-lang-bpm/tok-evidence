tok 1.0 "DIY Repair of a Broken Smartphone Screen"

pool shop "Online repair tool"
  lane customer "Customer"
    start broken "Smartphone broken"
    task enter "Enter the phone model and the damage"
    task check "Check what you already have"
    xor canborrow "Can friends lend or sell something cheaply?"
    task contact "Contact friends"
    xor gathered "Items gathered"
    task buy "Buy the remaining items"
    task repair "Repair the phone"
    xor works "Did the repair work?"
    task review "Send a review and/or video of the repair"
    task sendexpert "Send the phone to an expert"
    end done "Repair finished"
  lane tool "Online tool"
    task materials "Show the list of materials and tools"
    task choices "Offer the ordering choices for each part"
    task instructions "Send the repair instructions"
  lane friends "Friends"
    task lend "Lend or sell items cheaply"
  lane expert "Expert"
    task expertrepair "Repair the phone"
    end expertdone "Phone repaired by an expert"

flow broken -> enter -> materials -> choices -> check -> canborrow
flow canborrow -> contact "yes" when="friends_help = true"
flow canborrow -> gathered "no" default
flow contact -> lend -> gathered
flow gathered -> buy -> instructions -> repair -> works
flow works -> review "yes" when="repair_ok = true"
flow works -> sendexpert "no" default
flow review -> done
flow sendexpert -> expertrepair -> expertdone
