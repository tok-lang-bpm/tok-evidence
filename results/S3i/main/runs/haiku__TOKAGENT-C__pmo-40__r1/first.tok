tok 1.0 "OEE"

pool plant "Plant"
  lane system "Monitoring system"
    start begin "Measurement started"
    task collect "Collect the data from the machine"
    task calc "Calculate the OEE"
    xor low "OEE below the limit?"
    task stop "Stop the machine"
    task mail "Send an email to the engineer"
    catch restarted "Machine restarted" message="Machine restarted"
    boundary disc "Machine disconnected" on=collect message="Machine disconnected"
    end stopped "Process stopped"
  lane engineer "Engineer"
    task restart "Restart the machine"

flow begin -> collect -> calc -> low
flow low -> stop "yes"
flow low -> collect "no"
flow stop -> mail -> restart -> restarted -> collect
flow disc -> stopped
