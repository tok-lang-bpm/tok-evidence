tok 1.0 "Inspection of an Energy Drink Bottling Machine"

pool org "Inspection application"
  lane inspector "Inspector"
    start begin "Inspection started"
    user enterType "Enter the type of the machine"
    user enterSerial "Enter the serial number of the machine"
    user inputValues "Input the values"
    user pressButtons "Press the buttons"
    user inputAdditional "Input the values of the additional questions"
    end done "Inspection completed"
  lane app "Application"
    task askQuestions "Ask the questions"
    service collect "Collect the values from the machine"
    task showValues "Show the values"
    xor additional "Additional questions needed?"
    task askAdditional "Ask the additional questions"

flow begin -> enterType -> enterSerial -> askQuestions -> inputValues -> pressButtons -> collect -> showValues -> additional
flow additional -> askAdditional "yes"
flow additional -> done "no"
flow askAdditional -> inputAdditional -> done
