<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inspection of an Energy Drink Bottling Machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Inspection application" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterSerial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inputValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pressButtons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inputAdditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Application">
        <bpmn:flowNodeRef>askQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>showValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askAdditional</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inspection started" />
    <bpmn:userTask id="enterType" name="Enter the type of the machine" />
    <bpmn:userTask id="enterSerial" name="Enter the serial number of the machine" />
    <bpmn:userTask id="inputValues" name="Input the values" />
    <bpmn:userTask id="pressButtons" name="Press the buttons" />
    <bpmn:userTask id="inputAdditional" name="Input the values of the additional questions" />
    <bpmn:endEvent id="done" name="Inspection completed" />
    <bpmn:task id="askQuestions" name="Ask the questions" />
    <bpmn:serviceTask id="collect" name="Collect the values from the machine" />
    <bpmn:task id="showValues" name="Show the values" />
    <bpmn:exclusiveGateway id="additional" name="Additional questions needed?" />
    <bpmn:task id="askAdditional" name="Ask the additional questions" />
    <bpmn:sequenceFlow id="f-begin-enterType" sourceRef="begin" targetRef="enterType" />
    <bpmn:sequenceFlow id="f-enterType-enterSerial" sourceRef="enterType" targetRef="enterSerial" />
    <bpmn:sequenceFlow id="f-enterSerial-askQuestions" sourceRef="enterSerial" targetRef="askQuestions" />
    <bpmn:sequenceFlow id="f-askQuestions-inputValues" sourceRef="askQuestions" targetRef="inputValues" />
    <bpmn:sequenceFlow id="f-inputValues-pressButtons" sourceRef="inputValues" targetRef="pressButtons" />
    <bpmn:sequenceFlow id="f-pressButtons-collect" sourceRef="pressButtons" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-showValues" sourceRef="collect" targetRef="showValues" />
    <bpmn:sequenceFlow id="f-showValues-additional" sourceRef="showValues" targetRef="additional" />
    <bpmn:sequenceFlow id="f-additional-askAdditional" name="yes" sourceRef="additional" targetRef="askAdditional" />
    <bpmn:sequenceFlow id="f-additional-done" name="no" sourceRef="additional" targetRef="done" />
    <bpmn:sequenceFlow id="f-askAdditional-inputAdditional" sourceRef="askAdditional" targetRef="inputAdditional" />
    <bpmn:sequenceFlow id="f-inputAdditional-done" sourceRef="inputAdditional" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
