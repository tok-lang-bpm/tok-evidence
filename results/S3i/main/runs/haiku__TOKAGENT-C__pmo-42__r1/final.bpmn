<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Fridge service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>noise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Service facility">
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noise" name="Fridge makes strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send the symptoms and the fridge type" />
    <bpmn:task id="confirm" name="Confirm the fridge is OK again" />
    <bpmn:exclusiveGateway id="rated" name="Rate the service facility?" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:endEvent id="done" name="Service finished" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:task id="appoint" name="Make an appointment" />
    <bpmn:task id="arrive" name="Arrive at a random time" />
    <bpmn:exclusiveGateway id="repaired" name="Fridge repaired?" />
    <bpmn:task id="repair" name="Repair the fridge" />
    <bpmn:task id="leave" name="Leave without repairing the fridge" />
    <bpmn:task id="parts" name="Order the additional parts" />
    <bpmn:sequenceFlow id="f-noise-describe" sourceRef="noise" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appoint" sourceRef="select" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-arrive" sourceRef="appoint" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-repaired" sourceRef="arrive" targetRef="repaired" />
    <bpmn:sequenceFlow id="f-repaired-repair" name="yes" sourceRef="repaired" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-confirm" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rated" sourceRef="confirm" targetRef="rated" />
    <bpmn:sequenceFlow id="f-repaired-leave" name="no" sourceRef="repaired" targetRef="leave" />
    <bpmn:sequenceFlow id="f-leave-parts" sourceRef="leave" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-appoint" sourceRef="parts" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-rated-rate" name="yes" sourceRef="rated" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-done" sourceRef="rate" targetRef="done" />
    <bpmn:sequenceFlow id="f-rated-done" name="no" sourceRef="rated" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
