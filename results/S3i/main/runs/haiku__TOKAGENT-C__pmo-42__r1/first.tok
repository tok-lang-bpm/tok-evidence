tok 1.0 "Service for Your Fridge"

pool org "Fridge service"
  lane customer "Customer"
    start noise "Fridge makes strange noises"
    task describe "Describe the symptoms"
    task send "Send the symptoms and the fridge type"
    task confirm "Confirm the fridge is OK again"
    xor rated "Rate the service facility?"
    task rate "Rate the service facility"
    end done "Service finished"
  lane center "Central fridge service center"
    task select "Select a local service facility"
  lane facility "Service facility"
    task appoint "Make an appointment"
    task arrive "Arrive at a random time"
    xor repaired "Fridge repaired?"
    task repair "Repair the fridge"
    task leave "Leave without repairing the fridge"
    task parts "Order the additional parts"

flow noise -> describe -> send -> select -> appoint -> arrive -> repaired
flow repaired -> repair "yes" -> confirm -> rated
flow repaired -> leave "no" -> parts -> appoint
flow rated -> rate "yes" -> done
flow rated -> done "no"