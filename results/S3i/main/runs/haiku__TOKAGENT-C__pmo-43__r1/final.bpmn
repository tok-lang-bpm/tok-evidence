<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Car Service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="police" name="Police" processRef="police-process" />
  </bpmn:collaboration>
  <bpmn:process id="police-process" name="Car Service" isExecutable="false">
    <bpmn:laneSet id="police-lanes">
      <bpmn:lane id="owner" name="Car owner">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nextDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Police app">
        <bpmn:flowNodeRef>checkNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mechanic" name="Mechanic">
        <bpmn:flowNodeRef>enterProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickerl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterNext</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Successful service completed" />
    <bpmn:task id="pay" name="Pay the repair through the app" />
    <bpmn:endEvent id="nextDone" name="Next service recorded" />
    <bpmn:task id="checkNeed" name="Check that a service is necessary" />
    <bpmn:exclusiveGateway id="registered" name="Car still registered?" />
    <bpmn:task id="notify" name="Notify the owner" />
    <bpmn:exclusiveGateway id="goes" name="Owner goes to the service?" />
    <bpmn:intermediateCatchEvent id="wait30" name="Wait 30 days">
      <bpmn:timerEventDefinition id="wait30-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fine" name="Fine the owner" />
    <bpmn:task id="status" name="Send status updates via email" />
    <bpmn:endEvent id="notRegistered" name="Car no longer registered" />
    <bpmn:endEvent id="fined" name="Owner fined" />
    <bpmn:task id="enterProblems" name="Enter the problems of the car" />
    <bpmn:parallelGateway id="forkWork" />
    <bpmn:task id="repair" name="Repair the car" />
    <bpmn:parallelGateway id="joinWork" />
    <bpmn:task id="enterSuccess" name="Enter that the repair was successful" />
    <bpmn:task id="pickerl" name="Enter that the Pickerl was issued" />
    <bpmn:task id="enterNext" name="Enter the time of the next service" />
    <bpmn:sequenceFlow id="f-started-checkNeed" sourceRef="started" targetRef="checkNeed" />
    <bpmn:sequenceFlow id="f-checkNeed-registered" sourceRef="checkNeed" targetRef="registered" />
    <bpmn:sequenceFlow id="f-registered-notify" name="yes" sourceRef="registered" targetRef="notify" />
    <bpmn:sequenceFlow id="f-registered-notRegistered" name="no" sourceRef="registered" targetRef="notRegistered" />
    <bpmn:sequenceFlow id="f-notify-goes" sourceRef="notify" targetRef="goes" />
    <bpmn:sequenceFlow id="f-goes-enterProblems" name="yes" sourceRef="goes" targetRef="enterProblems" />
    <bpmn:sequenceFlow id="f-goes-wait30" name="no" sourceRef="goes" targetRef="wait30" />
    <bpmn:sequenceFlow id="f-wait30-fine" sourceRef="wait30" targetRef="fine" />
    <bpmn:sequenceFlow id="f-fine-fined" sourceRef="fine" targetRef="fined" />
    <bpmn:sequenceFlow id="f-enterProblems-forkWork" sourceRef="enterProblems" targetRef="forkWork" />
    <bpmn:sequenceFlow id="f-forkWork-repair" sourceRef="forkWork" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-pay" sourceRef="repair" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-joinWork" sourceRef="pay" targetRef="joinWork" />
    <bpmn:sequenceFlow id="f-forkWork-status" sourceRef="forkWork" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-joinWork" sourceRef="status" targetRef="joinWork" />
    <bpmn:sequenceFlow id="f-joinWork-enterSuccess" sourceRef="joinWork" targetRef="enterSuccess" />
    <bpmn:sequenceFlow id="f-enterSuccess-pickerl" sourceRef="enterSuccess" targetRef="pickerl" />
    <bpmn:sequenceFlow id="f-pickerl-enterNext" sourceRef="pickerl" targetRef="enterNext" />
    <bpmn:sequenceFlow id="f-enterNext-nextDone" sourceRef="enterNext" targetRef="nextDone" />
  </bpmn:process>
</bpmn:definitions>
