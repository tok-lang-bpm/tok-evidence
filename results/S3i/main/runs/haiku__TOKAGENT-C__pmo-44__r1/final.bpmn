<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Robotic Burger Seller near the University of Vienna" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Robotic Burger Seller" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask_side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status_given</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order" name="Customer orders" />
    <bpmn:task id="receive" name="Receive the order" />
    <bpmn:task id="ask_menu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="menu" name="Menu or just the burger?" />
    <bpmn:parallelGateway id="split_menu" />
    <bpmn:task id="drink" name="Prepare the drink" />
    <bpmn:task id="ask_side" name="Ask whether fries or wedges" />
    <bpmn:exclusiveGateway id="side" name="Fries or wedges?" />
    <bpmn:task id="fries" name="Prepare the fries" />
    <bpmn:task id="wedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="side_done" />
    <bpmn:parallelGateway id="join_menu" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:task id="burger" name="Prepare the burger" />
    <bpmn:boundaryEvent id="tick" name="Every 30 seconds" attachedToRef="burger" cancelActivity="false">
      <bpmn:timerEventDefinition id="tick-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="status" name="Give an enthusiastic status update" />
    <bpmn:endEvent id="status_given" name="Status update given" />
    <bpmn:task id="deliver" name="Deliver the order via the conveyor belt" />
    <bpmn:endEvent id="delivered" name="Order delivered" />
    <bpmn:sequenceFlow id="f-order-receive" sourceRef="order" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-ask_menu" sourceRef="receive" targetRef="ask_menu" />
    <bpmn:sequenceFlow id="f-ask_menu-menu" sourceRef="ask_menu" targetRef="menu" />
    <bpmn:sequenceFlow id="f-menu-split_menu" name="Menu" sourceRef="menu" targetRef="split_menu" />
    <bpmn:sequenceFlow id="f-menu-ready" name="Just the burger" sourceRef="menu" targetRef="ready" />
    <bpmn:sequenceFlow id="f-split_menu-drink" sourceRef="split_menu" targetRef="drink" />
    <bpmn:sequenceFlow id="f-drink-join_menu" sourceRef="drink" targetRef="join_menu" />
    <bpmn:sequenceFlow id="f-split_menu-ask_side" sourceRef="split_menu" targetRef="ask_side" />
    <bpmn:sequenceFlow id="f-ask_side-side" sourceRef="ask_side" targetRef="side" />
    <bpmn:sequenceFlow id="f-side-fries" name="Fries" sourceRef="side" targetRef="fries" />
    <bpmn:sequenceFlow id="f-side-wedges" name="Wedges" sourceRef="side" targetRef="wedges" />
    <bpmn:sequenceFlow id="f-fries-side_done" sourceRef="fries" targetRef="side_done" />
    <bpmn:sequenceFlow id="f-wedges-side_done" sourceRef="wedges" targetRef="side_done" />
    <bpmn:sequenceFlow id="f-side_done-join_menu" sourceRef="side_done" targetRef="join_menu" />
    <bpmn:sequenceFlow id="f-join_menu-ready" sourceRef="join_menu" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-burger" sourceRef="ready" targetRef="burger" />
    <bpmn:sequenceFlow id="f-burger-deliver" sourceRef="burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-delivered" sourceRef="deliver" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-tick-status" sourceRef="tick" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-status_given" sourceRef="status" targetRef="status_given" />
  </bpmn:process>
</bpmn:definitions>
