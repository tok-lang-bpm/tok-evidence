tok 1.0 "Robotic Burger Seller near the University of Vienna"

pool shop "Robotic Burger Seller"
  lane customer "Customer"
    start order "Customer orders"
  lane robot "Robot"
    task receive "Receive the order"
    task ask_menu "Ask whether the customer wants a menu or just the burger"
    xor menu "Menu or just the burger?"
    and split_menu
    task drink "Prepare the drink"
    task ask_side "Ask whether fries or wedges"
    xor side "Fries or wedges?"
    task fries "Prepare the fries"
    task wedges "Prepare the wedges"
    xor side_done
    and join_menu
    xor ready
    task burger "Prepare the burger"
    boundary tick "Every 30 seconds" on=burger timer=PT30S noninterrupting
    task status "Give an enthusiastic status update"
    end status_given "Status update given"
    task deliver "Deliver the order via the conveyor belt"
    end delivered "Order delivered"

flow order -> receive -> ask_menu -> menu
flow menu -> split_menu "Menu"
flow menu -> ready "Just the burger"
flow split_menu -> drink -> join_menu
flow split_menu -> ask_side -> side
flow side -> fries "Fries"
flow side -> wedges "Wedges"
flow fries -> side_done
flow wedges -> side_done
flow side_done -> join_menu -> ready
flow ready -> burger -> deliver -> delivered
flow tick -> status -> status_given
