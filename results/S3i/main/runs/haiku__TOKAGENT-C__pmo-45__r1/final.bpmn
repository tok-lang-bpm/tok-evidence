<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loginOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saveProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enterBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billingMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="E-Shop system">
        <bpmn:flowNodeRef>checkCreds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finishOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkPar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinPar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>confirmPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="arrive" name="Customer logs in" />
    <bpmn:task id="login" name="Log in to the E-Shop" />
    <bpmn:task id="waitLogin" name="Wait for the login confirmation" />
    <bpmn:exclusiveGateway id="loginOk" name="Login successful?" />
    <bpmn:endEvent id="stopped" name="Shopping experience stops" />
    <bpmn:exclusiveGateway id="selectMerge" />
    <bpmn:task id="select" name="Select a product" />
    <bpmn:task id="addCart" name="Add the product to the shopping cart" />
    <bpmn:task id="saveProduct" name="Save the product" />
    <bpmn:exclusiveGateway id="allSelected" name="All products selected?" />
    <bpmn:task id="enterPayment" name="Enter the payment data" />
    <bpmn:task id="waitPayment" name="Wait for the payment confirmation" />
    <bpmn:task id="shipAddr" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="billing" name="Billing address differs from shipping address?" />
    <bpmn:task id="enterBilling" name="Enter the independent billing address" />
    <bpmn:exclusiveGateway id="billingMerge" />
    <bpmn:task id="checkCreds" name="Check the credentials" />
    <bpmn:task id="finishOrder" name="Finish the order" />
    <bpmn:parallelGateway id="forkPar" />
    <bpmn:parallelGateway id="joinPar" />
    <bpmn:task id="completeOrder" name="Complete the order" />
    <bpmn:endEvent id="done" name="Order finished" />
    <bpmn:task id="confirmPayment" name="Confirm the payment" />
    <bpmn:sequenceFlow id="f-arrive-login" sourceRef="arrive" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-checkCreds" sourceRef="login" targetRef="checkCreds" />
    <bpmn:sequenceFlow id="f-checkCreds-waitLogin" sourceRef="checkCreds" targetRef="waitLogin" />
    <bpmn:sequenceFlow id="f-waitLogin-loginOk" sourceRef="waitLogin" targetRef="loginOk" />
    <bpmn:sequenceFlow id="f-loginOk-stopped" name="no" sourceRef="loginOk" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-loginOk-selectMerge" name="yes" sourceRef="loginOk" targetRef="selectMerge" />
    <bpmn:sequenceFlow id="f-selectMerge-select" sourceRef="selectMerge" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-addCart" sourceRef="select" targetRef="addCart" />
    <bpmn:sequenceFlow id="f-addCart-saveProduct" sourceRef="addCart" targetRef="saveProduct" />
    <bpmn:sequenceFlow id="f-saveProduct-allSelected" sourceRef="saveProduct" targetRef="allSelected" />
    <bpmn:sequenceFlow id="f-allSelected-selectMerge" name="no" sourceRef="allSelected" targetRef="selectMerge" />
    <bpmn:sequenceFlow id="f-allSelected-finishOrder" name="yes" sourceRef="allSelected" targetRef="finishOrder" />
    <bpmn:sequenceFlow id="f-finishOrder-forkPar" sourceRef="finishOrder" targetRef="forkPar" />
    <bpmn:sequenceFlow id="f-forkPar-enterPayment" sourceRef="forkPar" targetRef="enterPayment" />
    <bpmn:sequenceFlow id="f-enterPayment-confirmPayment" sourceRef="enterPayment" targetRef="confirmPayment" />
    <bpmn:sequenceFlow id="f-confirmPayment-waitPayment" sourceRef="confirmPayment" targetRef="waitPayment" />
    <bpmn:sequenceFlow id="f-waitPayment-joinPar" sourceRef="waitPayment" targetRef="joinPar" />
    <bpmn:sequenceFlow id="f-forkPar-shipAddr" sourceRef="forkPar" targetRef="shipAddr" />
    <bpmn:sequenceFlow id="f-shipAddr-billing" sourceRef="shipAddr" targetRef="billing" />
    <bpmn:sequenceFlow id="f-billing-enterBilling" name="yes" sourceRef="billing" targetRef="enterBilling" />
    <bpmn:sequenceFlow id="f-billing-billingMerge" name="no" sourceRef="billing" targetRef="billingMerge" />
    <bpmn:sequenceFlow id="f-enterBilling-billingMerge" sourceRef="enterBilling" targetRef="billingMerge" />
    <bpmn:sequenceFlow id="f-billingMerge-joinPar" sourceRef="billingMerge" targetRef="joinPar" />
    <bpmn:sequenceFlow id="f-joinPar-completeOrder" sourceRef="joinPar" targetRef="completeOrder" />
    <bpmn:sequenceFlow id="f-completeOrder-done" sourceRef="completeOrder" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
