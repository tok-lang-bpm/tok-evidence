tok 1.0 "New application for registering for a USI course"

pool inst "Sports institute"
  lane applicant "Applicant"
    start wants "Want to register for a course"
    task select "Select a course"
    task pick "Select one course and date"
    task acc "Check whether you have an account"
    xor acctq "Account at the sports institute?"
    task elig "Check whether you are registered at an eligible university"
    xor eligq "Registered at an eligible university?"
    task reg "Register the account"
    task req "Request an activation"
    task wait "Wait for a response"
    xor ready
    task login "Log into the account"
    and fork
    task tweet "Tweet to friends who might want to join"
    task complete "Complete the registration for the course"
    task pay "Provide the payment information"
    and joined
  lane system "Sports institute system"
    xor slots "Are slots free?"
    task show "Show the courses and dates"
    end noslots "No free slots"
    task ticket "Issue the course ticket"
    end ticketed "Course ticket received"

flow wants -> select -> slots
flow slots -> show "yes"
flow slots -> noslots "no"
flow show -> pick -> acc -> acctq
flow acctq -> ready "yes"
flow acctq -> elig "no"
flow elig -> eligq
flow eligq -> reg "yes"
flow eligq -> req "no"
flow reg -> ready
flow req -> wait -> ready
flow ready -> login -> fork
flow fork -> tweet -> joined
flow fork -> complete -> pay -> joined
flow joined -> ticket -> ticketed
