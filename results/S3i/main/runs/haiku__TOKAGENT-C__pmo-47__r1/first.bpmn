<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="New application for registering for a USI course" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="inst" name="Sports institute" processRef="inst-process" />
  </bpmn:collaboration>
  <bpmn:process id="inst-process" name="New application for registering for a USI course" isExecutable="false">
    <bpmn:laneSet id="inst-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acctq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>elig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Sports institute system">
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noslots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticketed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wants" name="Want to register for a course" />
    <bpmn:task id="select" name="Select a course" />
    <bpmn:task id="pick" name="Select one course and date" />
    <bpmn:task id="acc" name="Check whether you have an account" />
    <bpmn:exclusiveGateway id="acctq" name="Account at the sports institute?" />
    <bpmn:task id="elig" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligq" name="Registered at an eligible university?" />
    <bpmn:task id="reg" name="Register the account" />
    <bpmn:task id="req" name="Request an activation" />
    <bpmn:task id="wait" name="Wait for a response" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:task id="login" name="Log into the account" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="tweet" name="Tweet to friends who might want to join" />
    <bpmn:task id="complete" name="Complete the registration for the course" />
    <bpmn:task id="pay" name="Provide the payment information" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:exclusiveGateway id="slots" name="Are slots free?" />
    <bpmn:task id="show" name="Show the courses and dates" />
    <bpmn:endEvent id="noslots" name="No free slots" />
    <bpmn:task id="ticket" name="Issue the course ticket" />
    <bpmn:endEvent id="ticketed" name="Course ticket received" />
    <bpmn:sequenceFlow id="f-wants-select" sourceRef="wants" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-slots" sourceRef="select" targetRef="slots" />
    <bpmn:sequenceFlow id="f-slots-show" name="yes" sourceRef="slots" targetRef="show" />
    <bpmn:sequenceFlow id="f-slots-noslots" name="no" sourceRef="slots" targetRef="noslots" />
    <bpmn:sequenceFlow id="f-show-pick" sourceRef="show" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-acc" sourceRef="pick" targetRef="acc" />
    <bpmn:sequenceFlow id="f-acc-acctq" sourceRef="acc" targetRef="acctq" />
    <bpmn:sequenceFlow id="f-acctq-ready" name="yes" sourceRef="acctq" targetRef="ready" />
    <bpmn:sequenceFlow id="f-acctq-elig" name="no" sourceRef="acctq" targetRef="elig" />
    <bpmn:sequenceFlow id="f-elig-eligq" sourceRef="elig" targetRef="eligq" />
    <bpmn:sequenceFlow id="f-eligq-reg" name="yes" sourceRef="eligq" targetRef="reg" />
    <bpmn:sequenceFlow id="f-eligq-req" name="no" sourceRef="eligq" targetRef="req" />
    <bpmn:sequenceFlow id="f-reg-ready" sourceRef="reg" targetRef="ready" />
    <bpmn:sequenceFlow id="f-req-wait" sourceRef="req" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-ready" sourceRef="wait" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-login" sourceRef="ready" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-fork" sourceRef="login" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-tweet" sourceRef="fork" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-joined" sourceRef="tweet" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-complete" sourceRef="fork" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-pay" sourceRef="complete" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-joined" sourceRef="pay" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-ticket" sourceRef="joined" targetRef="ticket" />
    <bpmn:sequenceFlow id="f-ticket-ticketed" sourceRef="ticket" targetRef="ticketed" />
  </bpmn:process>
</bpmn:definitions>
