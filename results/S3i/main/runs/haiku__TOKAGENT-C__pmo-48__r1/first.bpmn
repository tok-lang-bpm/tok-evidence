<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="App For Participating at the Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Vienna Night Run" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="runner" name="Participant">
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>race</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measureFinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ready" name="Participation wanted" />
    <bpmn:task id="select" name="Select a starting block" />
    <bpmn:task id="run" name="Run 5km" />
    <bpmn:task id="enter" name="Enter the running time into the app" />
    <bpmn:exclusiveGateway id="fast" name="Less than 25 minutes?" />
    <bpmn:task id="train" name="Train and check" />
    <bpmn:task id="number" name="Get the starting number" />
    <bpmn:exclusiveGateway id="left" name="More than one hour left before the end of the workday?" />
    <bpmn:task id="home" name="Go to the start from home" />
    <bpmn:task id="work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="travel" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="race" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink while running" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="receive" name="Receive the final running time" />
    <bpmn:endEvent id="done" name="Final running time received" />
    <bpmn:task id="measure" name="Measure the running time" />
    <bpmn:task id="measureFinal" name="Measure the final running time" />
    <bpmn:sequenceFlow id="f-ready-select" sourceRef="ready" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-run" sourceRef="select" targetRef="run" />
    <bpmn:sequenceFlow id="f-run-measure" sourceRef="run" targetRef="measure" />
    <bpmn:sequenceFlow id="f-measure-enter" sourceRef="measure" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-fast" sourceRef="enter" targetRef="fast" />
    <bpmn:sequenceFlow id="f-fast-number" name="yes" sourceRef="fast" targetRef="number" />
    <bpmn:sequenceFlow id="f-fast-train" name="no" sourceRef="fast" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-run" sourceRef="train" targetRef="run" />
    <bpmn:sequenceFlow id="f-number-left" sourceRef="number" targetRef="left" />
    <bpmn:sequenceFlow id="f-left-home" name="yes" sourceRef="left" targetRef="home" />
    <bpmn:sequenceFlow id="f-left-work" name="no" sourceRef="left" targetRef="work" />
    <bpmn:sequenceFlow id="f-home-travel" sourceRef="home" targetRef="travel" />
    <bpmn:sequenceFlow id="f-work-travel" sourceRef="work" targetRef="travel" />
    <bpmn:sequenceFlow id="f-travel-fork" sourceRef="travel" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-race" sourceRef="fork" targetRef="race" />
    <bpmn:sequenceFlow id="f-fork-drink" sourceRef="fork" targetRef="drink" />
    <bpmn:sequenceFlow id="f-race-join" sourceRef="race" targetRef="join" />
    <bpmn:sequenceFlow id="f-drink-join" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-measureFinal" sourceRef="join" targetRef="measureFinal" />
    <bpmn:sequenceFlow id="f-measureFinal-receive" sourceRef="measureFinal" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-done" sourceRef="receive" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
