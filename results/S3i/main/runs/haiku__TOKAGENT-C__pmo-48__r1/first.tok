tok 1.0 "App For Participating at the Vienna Night Run"

pool org "Vienna Night Run"
  lane runner "Participant"
    start ready "Participation wanted"
    task select "Select a starting block"
    task run "Run 5km"
    task enter "Enter the running time into the app"
    xor fast "Less than 25 minutes?"
    task train "Train and check"
    task number "Get the starting number"
    xor left "More than one hour left before the end of the workday?"
    task home "Go to the start from home"
    task work "Leave directly from work"
    xor travel
    and fork
    task race "Run at the Night Run"
    task drink "Drink while running"
    and join
    task receive "Receive the final running time"
    end done "Final running time received"
  lane gadget "Fitness gadget"
    task measure "Measure the running time"
    task measureFinal "Measure the final running time"

flow ready -> select -> run -> measure -> enter -> fast
flow fast -> number "yes"
flow fast -> train "no"
flow train -> run
flow number -> left
flow left -> home "yes"
flow left -> work "no"
flow home -> travel
flow work -> travel
flow travel -> fork
flow fork -> race
flow fork -> drink
flow race -> join
flow drink -> join
flow join -> measureFinal -> receive -> done
