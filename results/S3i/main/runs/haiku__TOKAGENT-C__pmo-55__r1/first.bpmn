<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ultrasound-guided vein puncture" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="unit" name="Vascular access unit" processRef="unit-process" />
  </bpmn:collaboration>
  <bpmn:process id="unit-process" name="Ultrasound-guided vein puncture" isExecutable="false">
    <bpmn:laneSet id="unit-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gelprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stergel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pospat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vein</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dopp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>punct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloodok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>syr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wiremeth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>longax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shortax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wiremerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wirepos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goodpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rmguide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifyflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Puncture needed" />
    <bpmn:task id="prepare" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="gown" name="Put on sterile clothes" />
    <bpmn:task id="clean" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="configure" name="Configure the ultrasound" />
    <bpmn:task id="gelprobe" name="Put gel in the probe" />
    <bpmn:task id="cover" name="Cover the probe" />
    <bpmn:task id="stergel" name="Put the sterile gel" />
    <bpmn:task id="posprobe" name="Position the probe" />
    <bpmn:task id="pospat" name="Position the patient" />
    <bpmn:exclusiveGateway id="vein" name="Vein identification method?" />
    <bpmn:task id="anat" name="Identify the vein by anatomic identification" />
    <bpmn:task id="dopp" name="Identify the vein by doppler identification" />
    <bpmn:task id="comp" name="Identify the vein by compression identification" />
    <bpmn:exclusiveGateway id="veinok" name="Vein identified" />
    <bpmn:task id="punct" name="Anesthetize and puncture the patient" />
    <bpmn:task id="blood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="bloodok" name="Blood return correct?" />
    <bpmn:task id="dropp" name="Drop the probe" />
    <bpmn:task id="syr" name="Remove the syringe" />
    <bpmn:task id="guide" name="Install the guidewire" />
    <bpmn:task id="trocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="wiremeth" name="Wire check method?" />
    <bpmn:task id="longax" name="Check the wire in the long axis" />
    <bpmn:task id="shortax" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="wiremerge" name="Wire checked" />
    <bpmn:task id="wirepos" name="Check whether the wire is in good position" />
    <bpmn:exclusiveGateway id="goodpos" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="rmguide" name="Remove the guidewire" />
    <bpmn:task id="verifyflow" name="Verify the flow and the reflow" />
    <bpmn:task id="catpos" name="Check the catheter position" />
    <bpmn:endEvent id="done" name="Puncture completed" />
    <bpmn:sequenceFlow id="f-begin-prepare" sourceRef="begin" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-wash" sourceRef="prepare" targetRef="wash" />
    <bpmn:sequenceFlow id="f-wash-gown" sourceRef="wash" targetRef="gown" />
    <bpmn:sequenceFlow id="f-gown-clean" sourceRef="gown" targetRef="clean" />
    <bpmn:sequenceFlow id="f-clean-drape" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-configure" sourceRef="drape" targetRef="configure" />
    <bpmn:sequenceFlow id="f-configure-gelprobe" sourceRef="configure" targetRef="gelprobe" />
    <bpmn:sequenceFlow id="f-gelprobe-cover" sourceRef="gelprobe" targetRef="cover" />
    <bpmn:sequenceFlow id="f-cover-stergel" sourceRef="cover" targetRef="stergel" />
    <bpmn:sequenceFlow id="f-stergel-posprobe" sourceRef="stergel" targetRef="posprobe" />
    <bpmn:sequenceFlow id="f-posprobe-pospat" sourceRef="posprobe" targetRef="pospat" />
    <bpmn:sequenceFlow id="f-pospat-vein" sourceRef="pospat" targetRef="vein" />
    <bpmn:sequenceFlow id="f-vein-anat" name="anatomic" sourceRef="vein" targetRef="anat" />
    <bpmn:sequenceFlow id="f-vein-dopp" name="doppler" sourceRef="vein" targetRef="dopp" />
    <bpmn:sequenceFlow id="f-vein-comp" name="compression" sourceRef="vein" targetRef="comp" />
    <bpmn:sequenceFlow id="f-anat-veinok" sourceRef="anat" targetRef="veinok" />
    <bpmn:sequenceFlow id="f-dopp-veinok" sourceRef="dopp" targetRef="veinok" />
    <bpmn:sequenceFlow id="f-comp-veinok" sourceRef="comp" targetRef="veinok" />
    <bpmn:sequenceFlow id="f-veinok-punct" sourceRef="veinok" targetRef="punct" />
    <bpmn:sequenceFlow id="f-punct-blood" sourceRef="punct" targetRef="blood" />
    <bpmn:sequenceFlow id="f-blood-bloodok" sourceRef="blood" targetRef="bloodok" />
    <bpmn:sequenceFlow id="f-bloodok-punct" name="no" sourceRef="bloodok" targetRef="punct" />
    <bpmn:sequenceFlow id="f-bloodok-dropp" name="yes" sourceRef="bloodok" targetRef="dropp" />
    <bpmn:sequenceFlow id="f-dropp-syr" sourceRef="dropp" targetRef="syr" />
    <bpmn:sequenceFlow id="f-syr-guide" sourceRef="syr" targetRef="guide" />
    <bpmn:sequenceFlow id="f-guide-trocar" sourceRef="guide" targetRef="trocar" />
    <bpmn:sequenceFlow id="f-trocar-wiremeth" sourceRef="trocar" targetRef="wiremeth" />
    <bpmn:sequenceFlow id="f-wiremeth-longax" name="long axis" sourceRef="wiremeth" targetRef="longax" />
    <bpmn:sequenceFlow id="f-wiremeth-shortax" name="short axis" sourceRef="wiremeth" targetRef="shortax" />
    <bpmn:sequenceFlow id="f-longax-wiremerge" sourceRef="longax" targetRef="wiremerge" />
    <bpmn:sequenceFlow id="f-shortax-wiremerge" sourceRef="shortax" targetRef="wiremerge" />
    <bpmn:sequenceFlow id="f-wiremerge-wirepos" sourceRef="wiremerge" targetRef="wirepos" />
    <bpmn:sequenceFlow id="f-wirepos-goodpos" sourceRef="wirepos" targetRef="goodpos" />
    <bpmn:sequenceFlow id="f-goodpos-punct" name="no" sourceRef="goodpos" targetRef="punct" />
    <bpmn:sequenceFlow id="f-goodpos-widen" name="yes" sourceRef="goodpos" targetRef="widen" />
    <bpmn:sequenceFlow id="f-widen-advance" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f-advance-rmguide" sourceRef="advance" targetRef="rmguide" />
    <bpmn:sequenceFlow id="f-rmguide-verifyflow" sourceRef="rmguide" targetRef="verifyflow" />
    <bpmn:sequenceFlow id="f-verifyflow-catpos" sourceRef="verifyflow" targetRef="catpos" />
    <bpmn:sequenceFlow id="f-catpos-done" sourceRef="catpos" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
