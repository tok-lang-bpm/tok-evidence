<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Hiring" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hiring" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Dept" name="Department">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeInt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeNeg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" />
    <bpmn:task id="Task_Identify" name="Identify the need for a new hire" />
    <bpmn:task id="Task_CreateJD" name="Create a job description" />
    <bpmn:task id="Task_Post" name="Post the job description on job boards" />
    <bpmn:task id="Task_Collect" name="Collect resumes" />
    <bpmn:task id="Task_Screen" name="Screen resumes" />
    <bpmn:task id="Task_PhoneInt" name="Conduct initial phone interviews" />
    <bpmn:task id="Task_Invite" name="Invite selected candidates for interview" />
    <bpmn:exclusiveGateway id="Gw_Pref" name="Interview preference?" />
    <bpmn:task id="Task_InPerson" name="Conduct in-person interview" />
    <bpmn:task id="Task_Virtual" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="Gw_MergeInt" />
    <bpmn:task id="Task_Choose" name="Choose a candidate" />
    <bpmn:task id="Task_Offer" name="Extend an offer" />
    <bpmn:exclusiveGateway id="Gw_Neg" name="Salary negotiation needed?" />
    <bpmn:task id="Task_Negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="Gw_MergeNeg" />
    <bpmn:task id="Task_Accept" name="Record acceptance of the offer" />
    <bpmn:task id="Task_Begin" name="Begin the onboarding process" />
    <bpmn:task id="Task_Paper" name="Complete paperwork" />
    <bpmn:task id="Task_Orient" name="Conduct orientation" />
    <bpmn:task id="Task_Train" name="Provide training" />
    <bpmn:task id="Task_Integrate" name="Integrate the new hire into the team" />
    <bpmn:endEvent id="End_1" name="New hire fully integrated" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Identify" targetRef="Task_CreateJD" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateJD" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Post" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Collect" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Screen" targetRef="Task_PhoneInt" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_PhoneInt" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Invite" targetRef="Gw_Pref" />
    <bpmn:sequenceFlow id="Flow_9" name="in-person" sourceRef="Gw_Pref" targetRef="Task_InPerson" />
    <bpmn:sequenceFlow id="Flow_10" name="virtual" sourceRef="Gw_Pref" targetRef="Task_Virtual" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InPerson" targetRef="Gw_MergeInt" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Virtual" targetRef="Gw_MergeInt" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_MergeInt" targetRef="Task_Choose" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Choose" targetRef="Task_Offer" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Offer" targetRef="Gw_Neg" />
    <bpmn:sequenceFlow id="Flow_16" name="yes" sourceRef="Gw_Neg" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="Flow_17" name="no" sourceRef="Gw_Neg" targetRef="Gw_MergeNeg" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Negotiate" targetRef="Gw_MergeNeg" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gw_MergeNeg" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Accept" targetRef="Task_Begin" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Begin" targetRef="Task_Paper" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Paper" targetRef="Task_Orient" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Orient" targetRef="Task_Train" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Train" targetRef="Task_Integrate" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Integrate" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
