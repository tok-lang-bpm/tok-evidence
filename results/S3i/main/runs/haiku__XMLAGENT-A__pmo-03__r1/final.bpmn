<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_System" name="Inventory system">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AlertType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateLevels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Warehouse" name="Warehouse staff">
        <bpmn:flowNodeRef>Task_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Shelve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParJoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Inventory monitoring begins" />
    <bpmn:exclusiveGateway id="Gw_Merge_Monitor" />
    <bpmn:task id="Task_Monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="Gw_Threshold" name="Threshold reached?" />
    <bpmn:exclusiveGateway id="Gw_AlertType" name="Automated alert or manual check?" />
    <bpmn:task id="Task_Alert" name="Generate automated alert" />
    <bpmn:task id="Task_Manual" name="Perform manual check" />
    <bpmn:exclusiveGateway id="Gw_Merge_Signal" />
    <bpmn:task id="Task_Evaluate" name="Consider cost, delivery time and supplier reliability" />
    <bpmn:task id="Task_PlaceOrder" name="Place order with suppliers" />
    <bpmn:task id="Task_UpdateDelivery" name="Update inventory system with expected delivery dates" />
    <bpmn:task id="Task_Receive" name="Receive stock" />
    <bpmn:task id="Task_Inspect" name="Inspect stock for quality" />
    <bpmn:parallelGateway id="Gw_ParSplit" />
    <bpmn:task id="Task_Record" name="Record stock in system" />
    <bpmn:task id="Task_Shelve" name="Place stock on shelves or in storage" />
    <bpmn:parallelGateway id="Gw_ParJoin" />
    <bpmn:task id="Task_UpdateLevels" name="Update inventory levels" />
    <bpmn:endEvent id="End_1" name="Inventory levels updated" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Gw_Merge_Monitor" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gw_Merge_Monitor" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Monitor" targetRef="Gw_Threshold" />
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="Gw_Threshold" targetRef="Gw_Merge_Monitor" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="Gw_Threshold" targetRef="Gw_AlertType" />
    <bpmn:sequenceFlow id="F6" name="automated alert" sourceRef="Gw_AlertType" targetRef="Task_Alert" />
    <bpmn:sequenceFlow id="F7" name="manual check" sourceRef="Gw_AlertType" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Alert" targetRef="Gw_Merge_Signal" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Manual" targetRef="Gw_Merge_Signal" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Merge_Signal" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Evaluate" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_PlaceOrder" targetRef="Task_UpdateDelivery" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_UpdateDelivery" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Receive" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Inspect" targetRef="Gw_ParSplit" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_ParSplit" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_ParSplit" targetRef="Task_Shelve" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Record" targetRef="Gw_ParJoin" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Shelve" targetRef="Gw_ParJoin" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_ParJoin" targetRef="Task_UpdateLevels" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_UpdateLevels" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
