<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MARKETING" name="Marketing team">
        <bpmn:flowNodeRef>Start_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Launch_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_PeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Campaign_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalysePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Campaign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CRM" name="CRM system">
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SALES" name="Sales team">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Campaign" name="Campaign process started" />
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives" />
    <bpmn:task id="Task_CreateContent" name="Create content" />
    <bpmn:task id="Task_DesignVisuals" name="Design visuals" />
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels" />
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign" />
    <bpmn:parallelGateway id="Gw_Launch_Split" name="Split after launch" />
    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time" />
    <bpmn:intermediateCatchEvent id="Timer_PeriodEnds" name="Campaign period ends">
      <bpmn:timerEventDefinition id="TimerDef_PeriodEnds">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CollectLeads" name="Collect generated leads in CRM" />
    <bpmn:task id="Task_FollowUpLeads" name="Follow up on leads" />
    <bpmn:parallelGateway id="Gw_Campaign_Join" name="Join before analysis" />
    <bpmn:task id="Task_AnalysePerformance" name="Analyse campaign performance for future optimisation" />
    <bpmn:endEvent id="End_Campaign" name="Campaign concluded" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Campaign" targetRef="Task_DefineObjectives" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_DefineObjectives" targetRef="Task_CreateContent" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateContent" targetRef="Task_DesignVisuals" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_DesignVisuals" targetRef="Task_SelectChannels" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SelectChannels" targetRef="Task_LaunchCampaign" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_LaunchCampaign" targetRef="Gw_Launch_Split" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_Launch_Split" targetRef="Task_TrackPerformance" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_Launch_Split" targetRef="Task_CollectLeads" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_TrackPerformance" targetRef="Timer_PeriodEnds" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Timer_PeriodEnds" targetRef="Gw_Campaign_Join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CollectLeads" targetRef="Task_FollowUpLeads" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_FollowUpLeads" targetRef="Gw_Campaign_Join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_Campaign_Join" targetRef="Task_AnalysePerformance" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AnalysePerformance" targetRef="End_Campaign" />
  </bpmn:process>
</bpmn:definitions>
