<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Company" name="Company" processRef="Process_Supplier" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Supplier" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VisitsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Process begins" />
    <bpmn:task id="Task_Identify" name="Identify need for new supplier or vendor" />
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)" />
    <bpmn:task id="Task_Receive" name="Receive proposals from various suppliers" />
    <bpmn:task id="Task_Evaluate" name="Evaluate each proposal by cost, quality and delivery time" />
    <bpmn:exclusiveGateway id="Gw_Visits" name="Site visits or interviews needed?" />
    <bpmn:task id="Task_Visits" name="Conduct site visits or interviews with suppliers" />
    <bpmn:exclusiveGateway id="Gw_VisitsJoin" />
    <bpmn:task id="Task_Select" name="Select a supplier after careful analysis" />
    <bpmn:task id="Task_Negotiate" name="Negotiate contract terms" />
    <bpmn:exclusiveGateway id="Gw_Agree" name="Both parties agree on terms?" />
    <bpmn:task id="Task_Sign" name="Sign contract" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Onboard" name="Officially onboard supplier" />
    <bpmn:task id="Task_Execute" name="Execute contract" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:endEvent id="End_1" name="Process ends" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Identify" targetRef="Task_IssueRFP" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueRFP" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Receive" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Evaluate" targetRef="Gw_Visits" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_Visits" targetRef="Task_Visits" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_Visits" targetRef="Gw_VisitsJoin" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Visits" targetRef="Gw_VisitsJoin" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_VisitsJoin" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Select" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Negotiate" targetRef="Gw_Agree" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gw_Agree" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gw_Agree" targetRef="Task_Sign" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Sign" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_Split" targetRef="Task_Onboard" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_Split" targetRef="Task_Execute" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Onboard" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Execute" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gw_Join" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
