<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Order" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Order" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlacePhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ChannelMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_GenerateConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTracking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>Task_PickPack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics provider">
        <bpmn:flowNodeRef>Gw_SplitMonitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinMonitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Order" name="Order placed" />
    <bpmn:exclusiveGateway id="Gw_Channel" name="Ordering channel?" />
    <bpmn:task id="Task_PlaceOnline" name="Place order through online platform" />
    <bpmn:task id="Task_PlacePhone" name="Place order over the phone" />
    <bpmn:exclusiveGateway id="Gw_ChannelMerge" />
    <bpmn:task id="Task_GenerateConfirmation" name="Generate order confirmation" />
    <bpmn:task id="Task_SendConfirmation" name="Send order confirmation to customer" />
    <bpmn:task id="Task_PickPack" name="Pick and pack the items" />
    <bpmn:task id="Task_GenerateLabel" name="Generate shipping label" />
    <bpmn:task id="Task_HandOver" name="Hand over order to logistics provider" />
    <bpmn:parallelGateway id="Gw_SplitMonitor" />
    <bpmn:task id="Task_SendTracking" name="Send tracking information to customer" />
    <bpmn:task id="Task_MonitorShipment" name="Monitor shipment" />
    <bpmn:exclusiveGateway id="Gw_Arrived" name="Shipment reached customer's address?" />
    <bpmn:parallelGateway id="Gw_JoinMonitor" />
    <bpmn:endEvent id="End_Delivered" name="Delivery completed" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Order" targetRef="Gw_Channel" />
    <bpmn:sequenceFlow id="F02" name="online" sourceRef="Gw_Channel" targetRef="Task_PlaceOnline" />
    <bpmn:sequenceFlow id="F03" name="phone" sourceRef="Gw_Channel" targetRef="Task_PlacePhone" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_PlaceOnline" targetRef="Gw_ChannelMerge" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_PlacePhone" targetRef="Gw_ChannelMerge" />
    <bpmn:sequenceFlow id="F06" sourceRef="Gw_ChannelMerge" targetRef="Task_GenerateConfirmation" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_GenerateConfirmation" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_SendConfirmation" targetRef="Task_PickPack" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_PickPack" targetRef="Task_GenerateLabel" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_GenerateLabel" targetRef="Task_HandOver" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_HandOver" targetRef="Gw_SplitMonitor" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_SplitMonitor" targetRef="Task_SendTracking" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_SplitMonitor" targetRef="Task_MonitorShipment" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_SendTracking" targetRef="Gw_JoinMonitor" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_MonitorShipment" targetRef="Gw_Arrived" />
    <bpmn:sequenceFlow id="F16" name="no" sourceRef="Gw_Arrived" targetRef="Task_MonitorShipment" />
    <bpmn:sequenceFlow id="F17" name="yes" sourceRef="Gw_Arrived" targetRef="Gw_JoinMonitor" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_JoinMonitor" targetRef="End_Delivered" />
  </bpmn:process>
</bpmn:definitions>
