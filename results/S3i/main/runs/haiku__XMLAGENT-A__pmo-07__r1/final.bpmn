<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Travel company" processRef="travel-process" />
  </bpmn:collaboration>
  <bpmn:process id="travel-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeJourney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedbackDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedbackMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-booking" name="Booking system">
        <bpmn:flowNodeRef>generateTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channelDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channelMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinDelivery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-travel" name="Travel company">
        <bpmn:flowNodeRef>updateInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminderDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reminderMerge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Journey begins" />
    <bpmn:task id="search" name="Search for flight, train or bus ticket" />
    <bpmn:task id="select" name="Select preferred route, date and time" />
    <bpmn:task id="provideInfo" name="Provide personal information and payment details" />
    <bpmn:task id="generateTicket" name="Generate ticket" />
    <bpmn:parallelGateway id="forkDelivery" />
    <bpmn:exclusiveGateway id="channelDecision" name="Delivery channel?" />
    <bpmn:task id="sendEmail" name="Send ticket via email" />
    <bpmn:task id="sendSms" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="channelMerge" />
    <bpmn:task id="updateInventory" name="Update seat inventory" />
    <bpmn:parallelGateway id="joinDelivery" />
    <bpmn:exclusiveGateway id="reminderDecision" name="Reminders or instructions due?" />
    <bpmn:task id="sendReminders" name="Send reminders and check-in or boarding instructions" />
    <bpmn:exclusiveGateway id="reminderMerge" />
    <bpmn:task id="completeJourney" name="Complete journey" />
    <bpmn:exclusiveGateway id="feedbackDecision" name="Post-travel feedback or services?" />
    <bpmn:task id="provideFeedback" name="Provide post-travel feedback or services" />
    <bpmn:exclusiveGateway id="feedbackMerge" />
    <bpmn:endEvent id="end" name="Process concluded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="search" />
    <bpmn:sequenceFlow id="f2" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f3" sourceRef="select" targetRef="provideInfo" />
    <bpmn:sequenceFlow id="f4" sourceRef="provideInfo" targetRef="generateTicket" />
    <bpmn:sequenceFlow id="f5" sourceRef="generateTicket" targetRef="forkDelivery" />
    <bpmn:sequenceFlow id="f6" sourceRef="forkDelivery" targetRef="channelDecision" />
    <bpmn:sequenceFlow id="f7" name="email" sourceRef="channelDecision" targetRef="sendEmail" />
    <bpmn:sequenceFlow id="f8" name="SMS" sourceRef="channelDecision" targetRef="sendSms" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendEmail" targetRef="channelMerge" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendSms" targetRef="channelMerge" />
    <bpmn:sequenceFlow id="f11" sourceRef="channelMerge" targetRef="joinDelivery" />
    <bpmn:sequenceFlow id="f12" sourceRef="forkDelivery" targetRef="updateInventory" />
    <bpmn:sequenceFlow id="f13" sourceRef="updateInventory" targetRef="joinDelivery" />
    <bpmn:sequenceFlow id="f14" sourceRef="joinDelivery" targetRef="reminderDecision" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="reminderDecision" targetRef="sendReminders" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="reminderDecision" targetRef="reminderMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="sendReminders" targetRef="reminderMerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="reminderMerge" targetRef="completeJourney" />
    <bpmn:sequenceFlow id="f19" sourceRef="completeJourney" targetRef="feedbackDecision" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="feedbackDecision" targetRef="provideFeedback" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="feedbackDecision" targetRef="feedbackMerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="provideFeedback" targetRef="feedbackMerge" />
    <bpmn:sequenceFlow id="f23" sourceRef="feedbackMerge" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
