<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Incident" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Incident" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Reporter" name="Employee or customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Tracking system">
        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Investigation team">
        <bpmn:flowNodeRef>Task_Gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Followup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Incident reported" />
    <bpmn:task id="Task_Report" name="Report the incident" />
    <bpmn:task id="Task_Log" name="Log the report in the tracking system" />
    <bpmn:task id="Task_Assign" name="Assign the report to the appropriate team" />
    <bpmn:task id="Task_Gather" name="Gather the necessary information" />
    <bpmn:task id="Task_Identify" name="Identify the cause of the incident" />
    <bpmn:task id="Task_Propose" name="Propose corrective actions" />
    <bpmn:task id="Task_Implement" name="Implement the solution (fix, training or policy change)" />
    <bpmn:task id="Task_Followup" name="Follow up to ensure the issue will not recur" />
    <bpmn:parallelGateway id="Gw_Split" name="Split" />
    <bpmn:task id="Task_Close" name="Close the incident report" />
    <bpmn:task id="Task_Notify" name="Notify all stakeholders" />
    <bpmn:parallelGateway id="Gw_Join" name="Join" />
    <bpmn:endEvent id="End_1" name="Incident closed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Report" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Log" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Assign" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Gather" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Identify" targetRef="Task_Propose" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Propose" targetRef="Task_Implement" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Implement" targetRef="Task_Followup" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Followup" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_Split" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_Split" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Close" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Notify" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_Join" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>