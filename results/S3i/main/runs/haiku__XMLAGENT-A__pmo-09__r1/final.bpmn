<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_NewProduct" />
  </bpmn:collaboration>
  <bpmn:process id="Process_NewProduct" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_RD" name="R&amp;D team">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Discard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Process started" />
    <bpmn:task id="Task_Identify" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="Task_Research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="Task_Design" name="Draft design concepts" />
    <bpmn:task id="Task_Select" name="Select a promising design" />
    <bpmn:task id="Task_Build" name="Build a prototype from available materials and resources" />
    <bpmn:task id="Task_Test" name="Test the prototype for functionality, safety and market potential" />
    <bpmn:task id="Task_Feedback" name="Collect feedback from the testing phase" />
    <bpmn:exclusiveGateway id="Gw_Refine" name="Refinement needed?" />
    <bpmn:task id="Task_Refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="Gw_Approve" name="Prototype approved for further development?" />
    <bpmn:task id="Task_Approve" name="Approve the prototype for further development" />
    <bpmn:task id="Task_Discard" name="Discard the prototype" />
    <bpmn:endEvent id="End_Approved" name="Prototype approved" />
    <bpmn:endEvent id="End_Discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Identify" targetRef="Task_Research" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Research" targetRef="Task_Design" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Design" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Select" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Build" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Test" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Feedback" targetRef="Gw_Refine" />
    <bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_Refine" targetRef="Task_Refine" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Refine" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_Refine" targetRef="Gw_Approve" />
    <bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gw_Approve" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_Approve" targetRef="Task_Discard" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Approve" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Discard" targetRef="End_Discarded" />
  </bpmn:process>
</bpmn:definitions>
