<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="IT_Solution_Process" />
  </bpmn:collaboration>
  <bpmn:process id="IT_Solution_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Requester" name="Employee or department">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Task_CheckCompat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvalCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TrainingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="IT solution needed" />
    <bpmn:task id="Task_Submit" name="Submit request for IT solution" />
    <bpmn:task id="Task_CheckCompat" name="Check compatibility with existing systems" />
    <bpmn:task id="Task_EvalCost" name="Evaluate cost and resource needs" />
    <bpmn:exclusiveGateway id="Gw_Approved" name="Approved?" />
    <bpmn:task id="Task_Procure" name="Procure tools or licenses" />
    <bpmn:task id="Task_Install" name="Install the solution" />
    <bpmn:task id="Task_Test" name="Test the solution in a controlled environment" />
    <bpmn:task id="Task_Rollout" name="Roll out the solution to requesting department" />
    <bpmn:exclusiveGateway id="Gw_Training" name="Training provided?" />
    <bpmn:task id="Task_Training" name="Provide training" />
    <bpmn:exclusiveGateway id="Gw_TrainingJoin" />
    <bpmn:task id="Task_Support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="End_Rejected" name="Request not approved" />
    <bpmn:endEvent id="End_Done" name="IT solution in use" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Request" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submit" targetRef="Task_CheckCompat" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckCompat" targetRef="Task_EvalCost" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EvalCost" targetRef="Gw_Approved" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_Approved" targetRef="Task_Procure" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_Approved" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Procure" targetRef="Task_Install" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Install" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Test" targetRef="Task_Rollout" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Rollout" targetRef="Gw_Training" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_Training" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gw_Training" targetRef="Gw_TrainingJoin" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Training" targetRef="Gw_TrainingJoin" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_TrainingJoin" targetRef="Task_Support" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Support" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>