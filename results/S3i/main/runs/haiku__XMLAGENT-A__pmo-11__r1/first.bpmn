<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Subscription" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="Collaboration_Subscription">
    <bpmn:participant id="Pool_Organisation" name="Subscription service" processRef="Process_Subscription" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Subscription" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Subscription">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Subscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CustomerCancels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_GenerateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriggerBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support team">
        <bpmn:flowNodeRef>Task_ProcessCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RefundDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SettleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Subscription</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Subscription" name="Customer signs up for subscription" />
    <bpmn:task id="Task_SignUp" name="Sign up for subscription service" />
    <bpmn:task id="Task_EnterInfo" name="Enter personal and payment information" />
    <bpmn:task id="Task_GenerateAccount" name="Generate account" />
    <bpmn:task id="Task_AssignAccess" name="Assign access" />
    <bpmn:task id="Task_TriggerBilling" name="Trigger automated billing cycles" />
    <bpmn:exclusiveGateway id="Gw_Loop" name="Subscription running" />
    <bpmn:exclusiveGateway id="Gw_CustomerCancels" name="Customer decides to cancel?" />
    <bpmn:task id="Task_SendUpdates" name="Send updates, product enhancements or renewal notifications" />
    <bpmn:task id="Task_SubmitCancel" name="Submit cancellation request" />
    <bpmn:task id="Task_ProcessCancel" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="Gw_RefundDue" name="Refund or charge due under terms?" />
    <bpmn:task id="Task_ApplyRefund" name="Apply refund or charge" />
    <bpmn:exclusiveGateway id="Gw_Merge" name="Settlement merge" />
    <bpmn:parallelGateway id="Gw_Fork" name="Start closing" />
    <bpmn:task id="Task_Deactivate" name="Deactivate subscription" />
    <bpmn:task id="Task_SettleBalance" name="Settle final account balance" />
    <bpmn:parallelGateway id="Gw_Join" name="Closing complete" />
    <bpmn:endEvent id="End_Subscription" name="Subscription closed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Subscription" targetRef="Task_SignUp" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SignUp" targetRef="Task_EnterInfo" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_EnterInfo" targetRef="Task_GenerateAccount" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GenerateAccount" targetRef="Task_AssignAccess" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AssignAccess" targetRef="Task_TriggerBilling" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_TriggerBilling" targetRef="Gw_Loop" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_Loop" targetRef="Gw_CustomerCancels" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_CustomerCancels" targetRef="Task_SendUpdates" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SendUpdates" targetRef="Gw_Loop" />
    <bpmn:sequenceFlow id="Flow_10" name="yes" sourceRef="Gw_CustomerCancels" targetRef="Task_SubmitCancel" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SubmitCancel" targetRef="Task_ProcessCancel" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProcessCancel" targetRef="Gw_RefundDue" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gw_RefundDue" targetRef="Task_ApplyRefund" />
    <bpmn:sequenceFlow id="Flow_14" name="no" sourceRef="Gw_RefundDue" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ApplyRefund" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_Merge" targetRef="Gw_Fork" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_Fork" targetRef="Task_Deactivate" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gw_Fork" targetRef="Task_SettleBalance" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Deactivate" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SettleBalance" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gw_Join" targetRef="End_Subscription" />
  </bpmn:process>
</bpmn:definitions>
