<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="ComplaintProcess" />
  </bpmn:collaboration>
  <bpmn:process id="ComplaintProcess" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service" name="Customer service">
        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dept" name="Relevant department">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Financial team">
        <bpmn:flowNodeRef>Task_Reimburse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Complaint process begins" />
    <bpmn:task id="Task_File" name="File a complaint" />
    <bpmn:task id="Task_Log" name="Log the complaint" />
    <bpmn:task id="Task_Assign" name="Assign the complaint to the relevant department" />
    <bpmn:task id="Task_Review" name="Review the details" />
    <bpmn:task id="Task_Determine" name="Determine whether the complaint is valid and whether a refund is justified" />
    <bpmn:task id="Task_Notify" name="Notify the customer of the decision" />
    <bpmn:exclusiveGateway id="Gw_Refund" name="Refund approved?" />
    <bpmn:task id="Task_Reimburse" name="Process the reimbursement" />
    <bpmn:task id="Task_Receive" name="Receive the refund" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Resolve" name="Mark the complaint as resolved" />
    <bpmn:task id="Task_Feedback" name="Provide feedback on satisfaction" />
    <bpmn:endEvent id="End_1" name="Case closed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_File" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_File" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Log" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Assign" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Review" targetRef="Task_Determine" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Determine" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Notify" targetRef="Gw_Refund" />
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_Refund" targetRef="Task_Reimburse" />
    <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gw_Refund" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Reimburse" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Receive" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gw_Merge" targetRef="Task_Resolve" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Resolve" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Feedback" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
