<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Budget" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Budget" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>Task_Strategic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveAdjustment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveFinal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance department">
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinanceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Adjustments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Distribute</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Budget planning period begins" />
    <bpmn:task id="Task_Outline" name="Outline the objectives for the upcoming period" />
    <bpmn:task id="Task_Draft" name="Draft the plan with cost estimates and justifications" />
    <bpmn:task id="Task_Strategic" name="Review the plan in a strategic alignment meeting" />
    <bpmn:exclusiveGateway id="Gw_Merge" name="Merge" />
    <bpmn:task id="Task_FinanceReview" name="Perform a detailed budget review" />
    <bpmn:exclusiveGateway id="Gw_Adjustments" name="Adjustments needed?" default="Flow_NoAdjustments" />
    <bpmn:task id="Task_Adjust" name="Adjust the plan based on feedback" />
    <bpmn:task id="Task_Document" name="Document the adjustment" />
    <bpmn:task id="Task_ApproveAdjustment" name="Approve the adjustment" />
    <bpmn:task id="Task_ApproveFinal" name="Approve the final version of the budget" />
    <bpmn:task id="Task_Allocate" name="Allocate the budget to the department" />
    <bpmn:task id="Task_Distribute" name="Distribute the budget" />
    <bpmn:task id="Task_Implement" name="Begin implementing the plan" />
    <bpmn:endEvent id="End_1" name="Budget distributed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Outline" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Outline" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Draft" targetRef="Task_Strategic" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Strategic" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_Merge" targetRef="Task_FinanceReview" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_FinanceReview" targetRef="Gw_Adjustments" />
    <bpmn:sequenceFlow id="Flow_Yes" name="yes" sourceRef="Gw_Adjustments" targetRef="Task_Adjust" />
    <bpmn:sequenceFlow id="Flow_NoAdjustments" name="no" sourceRef="Gw_Adjustments" targetRef="Task_ApproveFinal" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Adjust" targetRef="Task_Document" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Document" targetRef="Task_ApproveAdjustment" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ApproveAdjustment" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ApproveFinal" targetRef="Task_Allocate" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Allocate" targetRef="Task_Distribute" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Distribute" targetRef="Task_Implement" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Implement" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>