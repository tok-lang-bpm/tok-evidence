<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Multinational company" processRef="Process_Audit" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Audit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>Start_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork_Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Regional" name="Regional office">
        <bpmn:flowNodeRef>Task_Prepare_Statements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gather_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Provide_Clarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Compliance team">
        <bpmn:flowNodeRef>Task_Check_Regulatory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Central" name="Central audit team">
        <bpmn:flowNodeRef>Gw_Merge_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review_Submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request_Clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate_Financial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate_Operational</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate_Compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_High_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch_Investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Analyse_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conduct_Interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Site_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conduct_Site_Visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Risks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compile_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resubmit_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork_Distribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Distribute_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archive_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_Distribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="Audit director">
        <bpmn:flowNodeRef>Task_Review_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approve_Report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Audit" name="Audit process initiated" />
    <bpmn:task id="Task_Notify" name="Send notification to regional office" />
    <bpmn:parallelGateway id="Gw_Fork_Start" name="" />
    <bpmn:task id="Task_Prepare_Statements" name="Prepare financial statements" />
    <bpmn:task id="Task_Gather_Documents" name="Gather necessary documents" />
    <bpmn:task id="Task_Check_Regulatory" name="Check for regulatory updates" />
    <bpmn:parallelGateway id="Gw_Join_Start" name="" />
    <bpmn:task id="Task_Submit_Documents" name="Submit documents to central audit team" />
    <bpmn:exclusiveGateway id="Gw_Merge_Review" name="" />
    <bpmn:task id="Task_Review_Submission" name="Review submission" />
    <bpmn:exclusiveGateway id="Gw_Discrepancies" name="Discrepancies found?" />
    <bpmn:task id="Task_Request_Clarifications" name="Request clarifications" />
    <bpmn:task id="Task_Provide_Clarifications" name="Provide clarifications" />
    <bpmn:parallelGateway id="Gw_Fork_Risk" name="" />
    <bpmn:task id="Task_Evaluate_Financial" name="Evaluate financial risks" />
    <bpmn:task id="Task_Evaluate_Operational" name="Evaluate operational risks" />
    <bpmn:task id="Task_Evaluate_Compliance" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="Gw_Join_Risk" name="" />
    <bpmn:exclusiveGateway id="Gw_High_Risk" name="High risk identified?" />
    <bpmn:task id="Task_Launch_Investigation" name="Launch detailed investigation" />
    <bpmn:task id="Task_Analyse_Data" name="Analyse data" />
    <bpmn:task id="Task_Conduct_Interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="Gw_Site_Visit" name="Site visit required?" />
    <bpmn:task id="Task_Conduct_Site_Visits" name="Conduct site visits" />
    <bpmn:exclusiveGateway id="Gw_Merge_Investigation" name="" />
    <bpmn:exclusiveGateway id="Gw_Merge_Risks" name="" />
    <bpmn:task id="Task_Compile_Report" name="Compile audit report" />
    <bpmn:exclusiveGateway id="Gw_Merge_Report" name="" />
    <bpmn:task id="Task_Review_Report" name="Review report" />
    <bpmn:exclusiveGateway id="Gw_Approve_Report" name="Approve report?" />
    <bpmn:task id="Task_Update_Report" name="Update report accordingly" />
    <bpmn:task id="Task_Resubmit_Report" name="Resubmit report for review" />
    <bpmn:parallelGateway id="Gw_Fork_Distribution" name="" />
    <bpmn:task id="Task_Distribute_Report" name="Distribute final report to executive board" />
    <bpmn:task id="Task_Archive_Report" name="Archive report" />
    <bpmn:parallelGateway id="Gw_Join_Distribution" name="" />
    <bpmn:task id="Task_Close_Audit" name="Close audit process" />
    <bpmn:endEvent id="End_Audit" name="Audit process closed" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Audit" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Notify" targetRef="Gw_Fork_Start" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gw_Fork_Start" targetRef="Task_Prepare_Statements" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gw_Fork_Start" targetRef="Task_Check_Regulatory" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Prepare_Statements" targetRef="Task_Gather_Documents" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Gather_Documents" targetRef="Gw_Join_Start" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Check_Regulatory" targetRef="Gw_Join_Start" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gw_Join_Start" targetRef="Task_Submit_Documents" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Submit_Documents" targetRef="Gw_Merge_Review" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Provide_Clarifications" targetRef="Gw_Merge_Review" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_Merge_Review" targetRef="Task_Review_Submission" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Review_Submission" targetRef="Gw_Discrepancies" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gw_Discrepancies" targetRef="Task_Request_Clarifications" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Request_Clarifications" targetRef="Task_Provide_Clarifications" />
    <bpmn:sequenceFlow id="Flow_15" name="no" sourceRef="Gw_Discrepancies" targetRef="Gw_Fork_Risk" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_Fork_Risk" targetRef="Task_Evaluate_Financial" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_Fork_Risk" targetRef="Task_Evaluate_Operational" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gw_Fork_Risk" targetRef="Task_Evaluate_Compliance" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Evaluate_Financial" targetRef="Gw_Join_Risk" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Evaluate_Operational" targetRef="Gw_Join_Risk" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Evaluate_Compliance" targetRef="Gw_Join_Risk" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gw_Join_Risk" targetRef="Gw_High_Risk" />
    <bpmn:sequenceFlow id="Flow_23" name="yes" sourceRef="Gw_High_Risk" targetRef="Task_Launch_Investigation" />
    <bpmn:sequenceFlow id="Flow_24" name="no" sourceRef="Gw_High_Risk" targetRef="Gw_Merge_Risks" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Launch_Investigation" targetRef="Task_Analyse_Data" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Analyse_Data" targetRef="Task_Conduct_Interviews" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Conduct_Interviews" targetRef="Gw_Site_Visit" />
    <bpmn:sequenceFlow id="Flow_28" name="yes" sourceRef="Gw_Site_Visit" targetRef="Task_Conduct_Site_Visits" />
    <bpmn:sequenceFlow id="Flow_29" name="no" sourceRef="Gw_Site_Visit" targetRef="Gw_Merge_Investigation" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_Conduct_Site_Visits" targetRef="Gw_Merge_Investigation" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gw_Merge_Investigation" targetRef="Gw_Merge_Risks" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Gw_Merge_Risks" targetRef="Task_Compile_Report" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_Compile_Report" targetRef="Gw_Merge_Report" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_Resubmit_Report" targetRef="Gw_Merge_Report" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gw_Merge_Report" targetRef="Task_Review_Report" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_Review_Report" targetRef="Gw_Approve_Report" />
    <bpmn:sequenceFlow id="Flow_37" name="yes" sourceRef="Gw_Approve_Report" targetRef="Gw_Fork_Distribution" />
    <bpmn:sequenceFlow id="Flow_38" name="no (revisions required)" sourceRef="Gw_Approve_Report" targetRef="Task_Update_Report" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_Update_Report" targetRef="Task_Resubmit_Report" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Gw_Fork_Distribution" targetRef="Task_Distribute_Report" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Gw_Fork_Distribution" targetRef="Task_Archive_Report" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_Distribute_Report" targetRef="Gw_Join_Distribution" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_Archive_Report" targetRef="Gw_Join_Distribution" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Gw_Join_Distribution" targetRef="Task_Close_Audit" />
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Task_Close_Audit" targetRef="End_Audit" />
  </bpmn:process>
</bpmn:definitions>
