<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="University" name="University" processRef="enrollment-process" />
  </bpmn:collaboration>
  <bpmn:process id="enrollment-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Provide_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm_Enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Study_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select_Courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolve_Conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Attend_Classes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Add_Drop_Courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review_Grades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit_Appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Review_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_Enroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Enroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Admissions Committee">
        <bpmn:flowNodeRef>Evaluate_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Process_Fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Setup_Accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_International" name="International Student Office">
        <bpmn:flowNodeRef>Visa_Processing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>Meet_Advisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registrar" name="Registrar">
        <bpmn:flowNodeRef>Post_Grades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>Meet_Appeals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Await_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Application" name="Application needed" />
    <bpmn:task id="Submit_Application" name="Submit application online" />
    <bpmn:task id="Review_Application" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="Gw_Complete" name="Documents complete?" />
    <bpmn:task id="Notify_Missing" name="Notify applicant of missing documents" />
    <bpmn:task id="Provide_Missing" name="Provide missing items" />
    <bpmn:parallelGateway id="Fork_Docs" name="Documents received" />
    <bpmn:task id="Evaluate_Application" name="Evaluate application" />
    <bpmn:task id="Process_Fees" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="Join_Docs" />
    <bpmn:exclusiveGateway id="Gw_Accepted" name="Application accepted?" />
    <bpmn:task id="Send_Rejection" name="Send rejection letter" />
    <bpmn:endEvent id="End_Rejected" name="Application rejected" />
    <bpmn:task id="Send_Acceptance" name="Send acceptance letter" />
    <bpmn:task id="Confirm_Enrollment" name="Confirm enrollment by deadline" />
    <bpmn:exclusiveGateway id="Gw_Deadline" name="Enrollment confirmed by deadline?" />
    <bpmn:task id="Cancel_Application" name="Cancel application" />
    <bpmn:endEvent id="End_Canceled" name="Application canceled" />
    <bpmn:parallelGateway id="Fork_Enroll" name="Enrollment confirmed" />
    <bpmn:task id="Send_Orientation" name="Send orientation materials" />
    <bpmn:task id="Setup_Accounts" name="Set up student accounts for email, online portals and library access" />
    <bpmn:parallelGateway id="Join_Enroll" />
    <bpmn:exclusiveGateway id="Gw_Intl" name="International student?" />
    <bpmn:task id="Visa_Processing" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="Merge_Intl" />
    <bpmn:task id="Create_Study_Plan" name="Create study plan" />
    <bpmn:task id="Meet_Advisor" name="Meet with academic advisor" />
    <bpmn:task id="Select_Courses" name="Select courses" />
    <bpmn:task id="Resolve_Conflicts" name="Resolve schedule conflicts" />
    <bpmn:task id="Attend_Classes" name="Attend classes" />
    <bpmn:exclusiveGateway id="Gw_AddDrop" name="Add or drop courses?" />
    <bpmn:task id="Add_Drop_Courses" name="Add or drop courses within add/drop period" />
    <bpmn:exclusiveGateway id="Merge_AddDrop" />
    <bpmn:task id="Post_Grades" name="Post grades" />
    <bpmn:task id="Review_Grades" name="Review grades online" />
    <bpmn:exclusiveGateway id="Gw_Grievance" name="Grievance?" />
    <bpmn:task id="Submit_Appeal" name="Submit appeal form" />
    <bpmn:task id="Meet_Appeals" name="Meet with appeals committee" />
    <bpmn:task id="Await_Decision" name="Await decision" />
    <bpmn:exclusiveGateway id="Merge_Appeal" />
    <bpmn:exclusiveGateway id="Gw_Next" name="Next semester, graduation or withdrawal?" />
    <bpmn:endEvent id="End_Graduated" name="Student graduates" />
    <bpmn:endEvent id="End_Withdrawn" name="Student withdraws" />

    <bpmn:sequenceFlow id="F01" sourceRef="Start_Application" targetRef="Submit_Application" />
    <bpmn:sequenceFlow id="F02" sourceRef="Submit_Application" targetRef="Review_Application" />
    <bpmn:sequenceFlow id="F03" sourceRef="Review_Application" targetRef="Gw_Complete" />
    <bpmn:sequenceFlow id="F04" name="no" sourceRef="Gw_Complete" targetRef="Notify_Missing" />
    <bpmn:sequenceFlow id="F05" sourceRef="Notify_Missing" targetRef="Provide_Missing" />
    <bpmn:sequenceFlow id="F06" sourceRef="Provide_Missing" targetRef="Review_Application" />
    <bpmn:sequenceFlow id="F07" name="yes" sourceRef="Gw_Complete" targetRef="Fork_Docs" />
    <bpmn:sequenceFlow id="F08" sourceRef="Fork_Docs" targetRef="Evaluate_Application" />
    <bpmn:sequenceFlow id="F09" sourceRef="Fork_Docs" targetRef="Process_Fees" />
    <bpmn:sequenceFlow id="F10" sourceRef="Evaluate_Application" targetRef="Join_Docs" />
    <bpmn:sequenceFlow id="F11" sourceRef="Process_Fees" targetRef="Join_Docs" />
    <bpmn:sequenceFlow id="F12" sourceRef="Join_Docs" targetRef="Gw_Accepted" />
    <bpmn:sequenceFlow id="F13" name="no" sourceRef="Gw_Accepted" targetRef="Send_Rejection" />
    <bpmn:sequenceFlow id="F14" sourceRef="Send_Rejection" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F15" name="yes" sourceRef="Gw_Accepted" targetRef="Send_Acceptance" />
    <bpmn:sequenceFlow id="F16" sourceRef="Send_Acceptance" targetRef="Confirm_Enrollment" />
    <bpmn:sequenceFlow id="F17" sourceRef="Confirm_Enrollment" targetRef="Gw_Deadline" />
    <bpmn:sequenceFlow id="F18" name="no" sourceRef="Gw_Deadline" targetRef="Cancel_Application" />
    <bpmn:sequenceFlow id="F19" sourceRef="Cancel_Application" targetRef="End_Canceled" />
    <bpmn:sequenceFlow id="F20" name="yes" sourceRef="Gw_Deadline" targetRef="Fork_Enroll" />
    <bpmn:sequenceFlow id="F21" sourceRef="Fork_Enroll" targetRef="Send_Orientation" />
    <bpmn:sequenceFlow id="F22" sourceRef="Fork_Enroll" targetRef="Setup_Accounts" />
    <bpmn:sequenceFlow id="F23" sourceRef="Send_Orientation" targetRef="Join_Enroll" />
    <bpmn:sequenceFlow id="F24" sourceRef="Setup_Accounts" targetRef="Join_Enroll" />
    <bpmn:sequenceFlow id="F25" sourceRef="Join_Enroll" targetRef="Gw_Intl" />
    <bpmn:sequenceFlow id="F26" name="yes" sourceRef="Gw_Intl" targetRef="Visa_Processing" />
    <bpmn:sequenceFlow id="F27" name="no" sourceRef="Gw_Intl" targetRef="Merge_Intl" />
    <bpmn:sequenceFlow id="F28" sourceRef="Visa_Processing" targetRef="Merge_Intl" />
    <bpmn:sequenceFlow id="F29" sourceRef="Merge_Intl" targetRef="Create_Study_Plan" />
    <bpmn:sequenceFlow id="F30" sourceRef="Create_Study_Plan" targetRef="Meet_Advisor" />
    <bpmn:sequenceFlow id="F31" sourceRef="Meet_Advisor" targetRef="Select_Courses" />
    <bpmn:sequenceFlow id="F32" sourceRef="Select_Courses" targetRef="Resolve_Conflicts" />
    <bpmn:sequenceFlow id="F33" sourceRef="Resolve_Conflicts" targetRef="Attend_Classes" />
    <bpmn:sequenceFlow id="F34" sourceRef="Attend_Classes" targetRef="Gw_AddDrop" />
    <bpmn:sequenceFlow id="F35" name="yes" sourceRef="Gw_AddDrop" targetRef="Add_Drop_Courses" />
    <bpmn:sequenceFlow id="F36" name="no" sourceRef="Gw_AddDrop" targetRef="Merge_AddDrop" />
    <bpmn:sequenceFlow id="F37" sourceRef="Add_Drop_Courses" targetRef="Merge_AddDrop" />
    <bpmn:sequenceFlow id="F38" sourceRef="Merge_AddDrop" targetRef="Post_Grades" />
    <bpmn:sequenceFlow id="F39" sourceRef="Post_Grades" targetRef="Review_Grades" />
    <bpmn:sequenceFlow id="F40" sourceRef="Review_Grades" targetRef="Gw_Grievance" />
    <bpmn:sequenceFlow id="F41" name="no" sourceRef="Gw_Grievance" targetRef="Merge_Appeal" />
    <bpmn:sequenceFlow id="F42" name="yes" sourceRef="Gw_Grievance" targetRef="Submit_Appeal" />
    <bpmn:sequenceFlow id="F43" sourceRef="Submit_Appeal" targetRef="Meet_Appeals" />
    <bpmn:sequenceFlow id="F44" sourceRef="Meet_Appeals" targetRef="Await_Decision" />
    <bpmn:sequenceFlow id="F45" sourceRef="Await_Decision" targetRef="Merge_Appeal" />
    <bpmn:sequenceFlow id="F46" sourceRef="Merge_Appeal" targetRef="Gw_Next" />
    <bpmn:sequenceFlow id="F47" name="next semester" sourceRef="Gw_Next" targetRef="Select_Courses" />
    <bpmn:sequenceFlow id="F48" name="graduates" sourceRef="Gw_Next" targetRef="End_Graduated" />
    <bpmn:sequenceFlow id="F49" name="withdraws" sourceRef="Gw_Next" targetRef="End_Withdrawn" />
  </bpmn:process>
</bpmn:definitions>
