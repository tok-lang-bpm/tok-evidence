<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Shop" name="Online shop" processRef="ShopPurchase" />
  </bpmn:collaboration>
  <bpmn:process id="ShopPurchase" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PayChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PayMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shop" name="Online shop">
        <bpmn:flowNodeRef>Gw_DeliveryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Order" name="Order started" />
    <bpmn:task id="Task_Login" name="Log in to account" />
    <bpmn:parallelGateway id="Gw_Split" name="Split" />
    <bpmn:task id="Task_Select" name="Select items to purchase" />
    <bpmn:task id="Task_Reward" name="Choose a free reward option" />
    <bpmn:task id="Task_Payment" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gw_PayChoice" name="Pay or complete installment agreement?" default="Flow_Installment" />
    <bpmn:task id="Task_Pay" name="Pay" />
    <bpmn:task id="Task_Installment" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gw_PayMerge" name="Payment completed" />
    <bpmn:parallelGateway id="Gw_Join" name="Join" />
    <bpmn:exclusiveGateway id="Gw_DeliveryMerge" name="Delivery" />
    <bpmn:task id="Task_Deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="Gw_Returned" name="Items returned for exchange?" default="Flow_NoReturn" />
    <bpmn:task id="Task_Return" name="Return items for exchange" />
    <bpmn:endEvent id="End_Order" name="Order completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Order" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Login" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_Split" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_Split" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Select" targetRef="Task_Reward" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Payment" targetRef="Gw_PayChoice" />
    <bpmn:sequenceFlow id="Flow_7" name="pay" sourceRef="Gw_PayChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_Installment" name="installment agreement" sourceRef="Gw_PayChoice" targetRef="Task_Installment" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Pay" targetRef="Gw_PayMerge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Installment" targetRef="Gw_PayMerge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Reward" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_PayMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gw_Join" targetRef="Gw_DeliveryMerge" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_DeliveryMerge" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Deliver" targetRef="Gw_Returned" />
    <bpmn:sequenceFlow id="Flow_Return" name="yes" sourceRef="Gw_Returned" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="Flow_NoReturn" name="no" sourceRef="Gw_Returned" targetRef="End_Order" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Return" targetRef="Gw_DeliveryMerge" />
  </bpmn:process>
</bpmn:definitions>