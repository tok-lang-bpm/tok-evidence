<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Organisation" name="Organisation" processRef="shipping-process" />
  </bpmn:collaboration>
  <bpmn:process id="shipping-process" isExecutable="false">
    <bpmn:laneSet id="shipping-lanes">
      <bpmn:lane id="Secretary" name="Secretary">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Label</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LogisticsHead" name="Logistics department head">
        <bpmn:flowNodeRef>GwIns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeIns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>Pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Goods shall be shipped" />
    <bpmn:exclusiveGateway id="GwShip" name="Goods shall be shipped?" />
    <bpmn:endEvent id="EndNoShip" name="No shipment" />
    <bpmn:task id="Clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="GwAmount" name="Large amounts?" />
    <bpmn:task id="Invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="Select" name="Select one of the offers" />
    <bpmn:task id="Post" name="Ship by normal post" />
    <bpmn:exclusiveGateway id="MergeAmount" />
    <bpmn:parallelGateway id="GwSplit" />
    <bpmn:task id="Label" name="Write package label" />
    <bpmn:exclusiveGateway id="GwIns" name="Parcel insurance necessary?" />
    <bpmn:task id="Insure" name="Take out parcel insurance" />
    <bpmn:exclusiveGateway id="MergeIns" />
    <bpmn:task id="Pack" name="Package the goods" />
    <bpmn:parallelGateway id="GwJoin" />
    <bpmn:task id="Prepare" name="Prepare the packaged goods for pickup by the logistic company" />
    <bpmn:endEvent id="End" name="Goods ready for pickup" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="GwShip" />
    <bpmn:sequenceFlow id="F2" name="yes" sourceRef="GwShip" targetRef="Clarify" />
    <bpmn:sequenceFlow id="F3" name="no" sourceRef="GwShip" targetRef="EndNoShip" />
    <bpmn:sequenceFlow id="F4" sourceRef="Clarify" targetRef="GwAmount" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="GwAmount" targetRef="Invite" />
    <bpmn:sequenceFlow id="F6" name="no" sourceRef="GwAmount" targetRef="Post" />
    <bpmn:sequenceFlow id="F7" sourceRef="Invite" targetRef="Select" />
    <bpmn:sequenceFlow id="F8" sourceRef="Select" targetRef="MergeAmount" />
    <bpmn:sequenceFlow id="F9" sourceRef="Post" targetRef="MergeAmount" />
    <bpmn:sequenceFlow id="F10" sourceRef="MergeAmount" targetRef="GwSplit" />
    <bpmn:sequenceFlow id="F11" sourceRef="GwSplit" targetRef="Label" />
    <bpmn:sequenceFlow id="F12" sourceRef="GwSplit" targetRef="GwIns" />
    <bpmn:sequenceFlow id="F13" sourceRef="GwSplit" targetRef="Pack" />
    <bpmn:sequenceFlow id="F14" name="yes" sourceRef="GwIns" targetRef="Insure" />
    <bpmn:sequenceFlow id="F15" name="no" sourceRef="GwIns" targetRef="MergeIns" />
    <bpmn:sequenceFlow id="F16" sourceRef="Insure" targetRef="MergeIns" />
    <bpmn:sequenceFlow id="F17" sourceRef="MergeIns" targetRef="GwJoin" />
    <bpmn:sequenceFlow id="F18" sourceRef="Label" targetRef="GwJoin" />
    <bpmn:sequenceFlow id="F19" sourceRef="Pack" targetRef="GwJoin" />
    <bpmn:sequenceFlow id="F20" sourceRef="GwJoin" targetRef="Prepare" />
    <bpmn:sequenceFlow id="F21" sourceRef="Prepare" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
