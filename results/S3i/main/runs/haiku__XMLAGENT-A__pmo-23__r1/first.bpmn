<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Bank" name="Bank" processRef="CreditScoring" />
  </bpmn:collaboration>
  <bpmn:process id="CreditScoring" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Clerk" name="Sales clerk">
        <bpmn:flowNodeRef>Start_Clerk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLater</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Banking" name="Banking system">
        <bpmn:flowNodeRef>Task_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisplayDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Present</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Agency" name="Scoring agency">
        <bpmn:flowNodeRef>Task_Level1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnImmediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnLevel2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Clerk" name="Credit scoring needed" />
    <bpmn:task id="Task_Request" name="Request credit scoring" />
    <bpmn:task id="Task_Start" name="Start scoring process" />
    <bpmn:task id="Task_SendRequest" name="Send scoring request to agency" />
    <bpmn:task id="Task_Level1" name="Perform level 1 scoring" />
    <bpmn:exclusiveGateway id="Gw_Immediate" name="Result immediate?" />
    <bpmn:task id="Task_ReturnImmediate" name="Return immediate result to banking system" />
    <bpmn:task id="Task_InformDelay" name="Inform banking system of delay" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Level2" name="Perform level 2 scoring" />
    <bpmn:task id="Task_DisplayDelay" name="Display delay message to clerk" />
    <bpmn:task id="Task_CheckLater" name="Check again later" />
    <bpmn:task id="Task_ReturnLevel2" name="Return scoring result to banking system" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Present" name="Present result to clerk" />
    <bpmn:task id="Task_View" name="View result at frontend" />
    <bpmn:endEvent id="End_Done" name="Scoring result viewed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Clerk" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Request" targetRef="Task_Start" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Start" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_SendRequest" targetRef="Task_Level1" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Level1" targetRef="Gw_Immediate" />
    <bpmn:sequenceFlow id="F6" name="yes" sourceRef="Gw_Immediate" targetRef="Task_ReturnImmediate" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_ReturnImmediate" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F8" name="no" sourceRef="Gw_Immediate" targetRef="Task_InformDelay" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_InformDelay" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_Level2" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_DisplayDelay" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_DisplayDelay" targetRef="Task_CheckLater" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_CheckLater" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Level2" targetRef="Task_ReturnLevel2" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_ReturnLevel2" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Join" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_Merge" targetRef="Task_Present" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Present" targetRef="Task_View" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_View" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>