<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Becoming A Parent" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_PARENT" name="Parent">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SS" name="Social Security">
        <bpmn:flowNodeRef>Task_Gather</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Planning of maternity leave starts" />
    <bpmn:task id="Task_Fetch" name="Fetch information about potential leave models (months, split between parents)" />
    <bpmn:task id="Task_Select" name="Let parent select a leave model" />
    <bpmn:task id="Task_Collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_NotifySS" name="Notify Social Security in time" />
    <bpmn:task id="Task_NotifyCompany" name="Notify Company in time" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Gather" name="Gather information from companies" />
    <bpmn:task id="Task_Decide" name="Decide about extension at the end of the period" />
    <bpmn:exclusiveGateway id="Gw_Extend" name="Extension wanted?" default="F13" />
    <bpmn:endEvent id="End" name="Leave period finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Fetch" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Fetch" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Select" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Collect" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split" targetRef="Task_NotifySS" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Split" targetRef="Task_NotifyCompany" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_NotifySS" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_NotifyCompany" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Join" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Gather" targetRef="Task_Decide" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Decide" targetRef="Gw_Extend" />
    <bpmn:sequenceFlow id="F12" name="yes" sourceRef="Gw_Extend" targetRef="Task_Select">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">extension = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" name="no" sourceRef="Gw_Extend" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
