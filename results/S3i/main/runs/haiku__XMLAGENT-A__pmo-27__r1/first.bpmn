<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Work accident reporting" processRef="WorkAccident" />
  </bpmn:collaboration>
  <bpmn:process id="WorkAccident" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Insured" name="Insured person">
        <bpmn:flowNodeRef>Start_Accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Directorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrivateFatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrivateFatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Private</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employer" name="Employer or school">
        <bpmn:flowNodeRef>Gw_WorkAccident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NearMiss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Incapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Insurer5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Insurer5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_School</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Triplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_School</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reported</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Accident" name="Accident or near miss occurs" />
    <bpmn:task id="Task_Inform" name="Inform the employer immediately" />
    <bpmn:exclusiveGateway id="Gw_WorkAccident" name="Work accident?" />
    <bpmn:task id="Task_Gather" name="Gather information on the work accident" />
    <bpmn:task id="Task_Record" name="Record the near miss, risk or defect" />
    <bpmn:endEvent id="End_NearMiss" name="Near miss, risk or defect recorded" />
    <bpmn:exclusiveGateway id="Gw_Fatal" name="Fatality or serious injury?" />
    <bpmn:exclusiveGateway id="Gw_Emergency" name="Reported to emergency services?" />
    <bpmn:task id="Task_Labour" name="Report the accident immediately to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="Merge_Labour" />
    <bpmn:exclusiveGateway id="Gw_Incapacity" name="Killed or unable to work for three days?" />
    <bpmn:task id="Task_Insurer5" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="Merge_Insurer5" />
    <bpmn:exclusiveGateway id="Gw_Self" name="Self-employed person involved?" />
    <bpmn:task id="Task_Self" name="Report own accident to the accident insurance provider in good time" />
    <bpmn:exclusiveGateway id="Merge_Self" />
    <bpmn:exclusiveGateway id="Gw_Student" name="Student or schoolchild involved?" />
    <bpmn:task id="Task_Directorate" name="Report the accident to the competent directorate" />
    <bpmn:exclusiveGateway id="Merge_Student" />
    <bpmn:exclusiveGateway id="Gw_School" name="School, educational facility or university involved?" />
    <bpmn:task id="Task_Triplicate" name="Report the accident in triplicate to the accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="Merge_School" />
    <bpmn:exclusiveGateway id="Gw_Private" name="Privately insured?" />
    <bpmn:task id="Task_Private" name="Report the accident in writing immediately to the private insurer" />
    <bpmn:exclusiveGateway id="Gw_PrivateFatal" name="Fatality?" />
    <bpmn:task id="Task_PrivateFatal" name="Report the fatality to the private insurer within three days" />
    <bpmn:exclusiveGateway id="Merge_Private" />
    <bpmn:endEvent id="End_Reported" name="Accident reported" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Accident" targetRef="Task_Inform" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Inform" targetRef="Gw_WorkAccident" />
    <bpmn:sequenceFlow id="Flow_03" name="yes" sourceRef="Gw_WorkAccident" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="Flow_04" name="no" sourceRef="Gw_WorkAccident" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Record" targetRef="End_NearMiss" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Gather" targetRef="Gw_Fatal" />
    <bpmn:sequenceFlow id="Flow_07" name="yes" sourceRef="Gw_Fatal" targetRef="Gw_Emergency" />
    <bpmn:sequenceFlow id="Flow_08" name="no" sourceRef="Gw_Fatal" targetRef="Merge_Labour" />
    <bpmn:sequenceFlow id="Flow_09" name="yes" sourceRef="Gw_Emergency" targetRef="Merge_Labour" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_Emergency" targetRef="Task_Labour" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Labour" targetRef="Merge_Labour" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Merge_Labour" targetRef="Gw_Incapacity" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gw_Incapacity" targetRef="Task_Insurer5" />
    <bpmn:sequenceFlow id="Flow_14" name="no" sourceRef="Gw_Incapacity" targetRef="Merge_Insurer5" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Insurer5" targetRef="Merge_Insurer5" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Merge_Insurer5" targetRef="Gw_Self" />
    <bpmn:sequenceFlow id="Flow_17" name="yes" sourceRef="Gw_Self" targetRef="Task_Self" />
    <bpmn:sequenceFlow id="Flow_18" name="no" sourceRef="Gw_Self" targetRef="Merge_Self" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Self" targetRef="Merge_Self" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Merge_Self" targetRef="Gw_Student" />
    <bpmn:sequenceFlow id="Flow_21" name="yes" sourceRef="Gw_Student" targetRef="Task_Directorate" />
    <bpmn:sequenceFlow id="Flow_22" name="no" sourceRef="Gw_Student" targetRef="Merge_Student" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Directorate" targetRef="Merge_Student" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Merge_Student" targetRef="Gw_School" />
    <bpmn:sequenceFlow id="Flow_25" name="yes" sourceRef="Gw_School" targetRef="Task_Triplicate" />
    <bpmn:sequenceFlow id="Flow_26" name="no" sourceRef="Gw_School" targetRef="Merge_School" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Triplicate" targetRef="Merge_School" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Merge_School" targetRef="Gw_Private" />
    <bpmn:sequenceFlow id="Flow_29" name="yes" sourceRef="Gw_Private" targetRef="Task_Private" />
    <bpmn:sequenceFlow id="Flow_30" name="no" sourceRef="Gw_Private" targetRef="Merge_Private" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Private" targetRef="Gw_PrivateFatal" />
    <bpmn:sequenceFlow id="Flow_32" name="yes" sourceRef="Gw_PrivateFatal" targetRef="Task_PrivateFatal" />
    <bpmn:sequenceFlow id="Flow_33" name="no" sourceRef="Gw_PrivateFatal" targetRef="Merge_Private" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_PrivateFatal" targetRef="Merge_Private" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Merge_Private" targetRef="End_Reported" />
  </bpmn:process>
</bpmn:definitions>