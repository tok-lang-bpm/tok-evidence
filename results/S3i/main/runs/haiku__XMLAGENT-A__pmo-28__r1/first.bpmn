<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Internship" name="Internship" processRef="Process_Internship" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Internship" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterExperience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptDeny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_StudentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_StudentUpdatesDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recommended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Gw_OffersMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CompanyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CompanyUpdatesDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform" name="Platform">
        <bpmn:flowNodeRef>Task_Invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ForkInternship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinInternship</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Twitter" name="Twitter">
        <bpmn:flowNodeRef>Gw_ForkTweets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinTweets</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Search" name="Internship search started" />
    <bpmn:task id="Task_EnterProfile" name="Enter topic and desired salary" />
    <bpmn:task id="Task_EnterExperience" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="Gw_OffersMerge" name="Offers" />
    <bpmn:task id="Task_SendOffer" name="Send offer" />
    <bpmn:task id="Task_AcceptDeny" name="Accept or deny offer" />
    <bpmn:exclusiveGateway id="Gw_Accepted" name="Offer accepted?" />
    <bpmn:task id="Task_Invalidate" name="Invalidate all other offers" />
    <bpmn:parallelGateway id="Gw_ForkInternship" name="Start internship" />

    <bpmn:exclusiveGateway id="Gw_StudentMerge" name="Student updates" />
    <bpmn:task id="Task_WriteUpdate" name="Write status update about internship" />
    <bpmn:exclusiveGateway id="Gw_StudentUpdatesDone" name="3 status updates written?" />
    <bpmn:exclusiveGateway id="Gw_CompanyMerge" name="Company updates" />
    <bpmn:task id="Task_CompanyUpdate" name="Write status update about student" />
    <bpmn:exclusiveGateway id="Gw_CompanyUpdatesDone" name="3 status updates written?" />
    <bpmn:parallelGateway id="Gw_JoinInternship" name="Internship finished" />

    <bpmn:task id="Task_Recommend" name="Recommend company to friends" />
    <bpmn:parallelGateway id="Gw_ForkTweets" name="Send tweets" />
    <bpmn:task id="Task_Tweet" name="Send tweet to friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:parallelGateway id="Gw_JoinTweets" name="Tweets sent" />
    <bpmn:endEvent id="End_Recommended" name="Company recommended" />

    <bpmn:sequenceFlow id="F_01" sourceRef="Start_Search" targetRef="Task_EnterProfile" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_EnterProfile" targetRef="Task_EnterExperience" />
    <bpmn:sequenceFlow id="F_03" sourceRef="Task_EnterExperience" targetRef="Gw_OffersMerge" />
    <bpmn:sequenceFlow id="F_04" sourceRef="Gw_OffersMerge" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="F_05" sourceRef="Task_SendOffer" targetRef="Task_AcceptDeny" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Task_AcceptDeny" targetRef="Gw_Accepted" />
    <bpmn:sequenceFlow id="F_07" name="no" sourceRef="Gw_Accepted" targetRef="Gw_OffersMerge" />
    <bpmn:sequenceFlow id="F_08" name="yes" sourceRef="Gw_Accepted" targetRef="Task_Invalidate" />
    <bpmn:sequenceFlow id="F_09" sourceRef="Task_Invalidate" targetRef="Gw_ForkInternship" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Gw_ForkInternship" targetRef="Gw_StudentMerge" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Gw_ForkInternship" targetRef="Gw_CompanyMerge" />
    <bpmn:sequenceFlow id="F_12" sourceRef="Gw_StudentMerge" targetRef="Task_WriteUpdate" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_WriteUpdate" targetRef="Gw_StudentUpdatesDone" />
    <bpmn:sequenceFlow id="F_14" name="no" sourceRef="Gw_StudentUpdatesDone" targetRef="Gw_StudentMerge" />
    <bpmn:sequenceFlow id="F_15" name="yes" sourceRef="Gw_StudentUpdatesDone" targetRef="Gw_JoinInternship" />
    <bpmn:sequenceFlow id="F_16" sourceRef="Gw_CompanyMerge" targetRef="Task_CompanyUpdate" />
    <bpmn:sequenceFlow id="F_17" sourceRef="Task_CompanyUpdate" targetRef="Gw_CompanyUpdatesDone" />
    <bpmn:sequenceFlow id="F_18" name="no" sourceRef="Gw_CompanyUpdatesDone" targetRef="Gw_CompanyMerge" />
    <bpmn:sequenceFlow id="F_19" name="yes" sourceRef="Gw_CompanyUpdatesDone" targetRef="Gw_JoinInternship" />
    <bpmn:sequenceFlow id="F_20" sourceRef="Gw_JoinInternship" targetRef="Task_Recommend" />
    <bpmn:sequenceFlow id="F_21" sourceRef="Task_Recommend" targetRef="Gw_ForkTweets" />
    <bpmn:sequenceFlow id="F_22" sourceRef="Gw_ForkTweets" targetRef="Task_Tweet" />
    <bpmn:sequenceFlow id="F_23" sourceRef="Task_Tweet" targetRef="Gw_JoinTweets" />
    <bpmn:sequenceFlow id="F_24" sourceRef="Gw_JoinTweets" targetRef="End_Recommended" />
  </bpmn:process>
</bpmn:definitions>