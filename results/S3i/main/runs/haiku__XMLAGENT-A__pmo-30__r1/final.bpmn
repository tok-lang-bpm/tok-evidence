<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="LAN party organiser" processRef="LAN_PARTY" />
  </bpmn:collaboration>
  <bpmn:process id="LAN_PARTY" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_HOST" name="Organiser">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DownloadGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GamesMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BeerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Planning of the LAN party started" />
    <bpmn:task id="Task_Invite" name="Send invitations to 10 friends" />
    <bpmn:task id="Task_FindGames" name="Find out which games they want to play" />
    <bpmn:parallelGateway id="Gw_Split" name="Split" />
    <bpmn:task id="Task_AppointDate" name="Appoint a date for the LAN party" />
    <bpmn:task id="Task_FindAgreement" name="Find out how many people agree on this date" />
    <bpmn:exclusiveGateway id="Gw_Agree" name="8 or more people agree?" />
    <bpmn:task id="Task_CheckGames" name="Check whether you have all the games the guests want" />
    <bpmn:exclusiveGateway id="Gw_Missing" name="Some games missing?" />
    <bpmn:task id="Task_DownloadGames" name="Download the missing games" />
    <bpmn:exclusiveGateway id="Gw_GamesMerge" name="Games checked" />
    <bpmn:parallelGateway id="Gw_Join" name="Join" />
    <bpmn:task id="Task_FindBeer" name="Find out how much beer the friends will require" />
    <bpmn:exclusiveGateway id="Gw_Beer" name="Enough beer?" />
    <bpmn:task id="Task_BuyBeer" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="Gw_BeerMerge" name="Beer checked" />
    <bpmn:task id="Task_Enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="End" name="LAN party finished" />
    <bpmn:sequenceFlow id="F_01" sourceRef="Start" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_Invite" targetRef="Task_FindGames" />
    <bpmn:sequenceFlow id="F_03" sourceRef="Task_FindGames" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F_04" sourceRef="Gw_Split" targetRef="Task_AppointDate" />
    <bpmn:sequenceFlow id="F_05" sourceRef="Gw_Split" targetRef="Task_CheckGames" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Task_AppointDate" targetRef="Task_FindAgreement" />
    <bpmn:sequenceFlow id="F_07" sourceRef="Task_FindAgreement" targetRef="Gw_Agree" />
    <bpmn:sequenceFlow id="F_08" name="yes" sourceRef="Gw_Agree" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_09" name="no, appoint another date" sourceRef="Gw_Agree" targetRef="Task_AppointDate" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_CheckGames" targetRef="Gw_Missing" />
    <bpmn:sequenceFlow id="F_11" name="yes" sourceRef="Gw_Missing" targetRef="Task_DownloadGames" />
    <bpmn:sequenceFlow id="F_12" name="no" sourceRef="Gw_Missing" targetRef="Gw_GamesMerge" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_DownloadGames" targetRef="Gw_GamesMerge" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Gw_GamesMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_15" sourceRef="Gw_Join" targetRef="Task_FindBeer" />
    <bpmn:sequenceFlow id="F_16" sourceRef="Task_FindBeer" targetRef="Gw_Beer" />
    <bpmn:sequenceFlow id="F_17" name="yes" sourceRef="Gw_Beer" targetRef="Gw_BeerMerge" />
    <bpmn:sequenceFlow id="F_18" name="no" sourceRef="Gw_Beer" targetRef="Task_BuyBeer" />
    <bpmn:sequenceFlow id="F_19" sourceRef="Task_BuyBeer" targetRef="Gw_BeerMerge" />
    <bpmn:sequenceFlow id="F_20" sourceRef="Gw_BeerMerge" targetRef="Task_Enjoy" />
    <bpmn:sequenceFlow id="F_21" sourceRef="Task_Enjoy" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
