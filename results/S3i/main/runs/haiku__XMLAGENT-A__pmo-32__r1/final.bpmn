<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_Update" name="Materials list changed" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Game" name="Farming Bot" processRef="FarmingBot_Process" />
  </bpmn:collaboration>
  <bpmn:process id="FarmingBot_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Player" name="Player">
        <bpmn:flowNodeRef>Start_Wanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrefFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Urgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dependencies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrefJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ShareJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bot" name="Farming bot">
        <bpmn:flowNodeRef>Task_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bdy_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Disaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Setback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Milestone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Wanted" name="Custom farming bot wanted" />
    <bpmn:task id="Task_Select" name="Select the resources to farm" />
    <bpmn:parallelGateway id="Gw_PrefFork" />
    <bpmn:task id="Task_Urgency" name="Set the urgency of each resource" />
    <bpmn:task id="Task_Dependencies" name="Define the dependencies of the tools" />
    <bpmn:parallelGateway id="Gw_PrefJoin" />
    <bpmn:task id="Task_Start" name="Start farming" />
    <bpmn:task id="Task_Gather" name="Gather resources" />
    <bpmn:boundaryEvent id="Bdy_Update" name="Materials list changed" attachedToRef="Task_Gather" cancelActivity="false">
      <bpmn:messageEventDefinition messageRef="Msg_Update" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Update" name="Update the list of materials to be farmed" />
    <bpmn:endEvent id="End_Update" name="Materials list updated" />
    <bpmn:exclusiveGateway id="Gw_Disaster" name="Natural disaster strikes?" />
    <bpmn:task id="Task_Setback" name="Set the bot back" />
    <bpmn:exclusiveGateway id="Gw_Merge1" />
    <bpmn:exclusiveGateway id="Gw_Milestone" name="Milestone reached?" />
    <bpmn:task id="Task_Notify" name="Notify the player of the milestone" />
    <bpmn:exclusiveGateway id="Gw_Merge2" />
    <bpmn:exclusiveGateway id="Gw_Done" name="All resources gathered?" />
    <bpmn:inclusiveGateway id="Gw_Share" name="Brag and/or send?" default="Flow_NoShare" />
    <bpmn:task id="Task_Brag" name="Brag to selected friends" />
    <bpmn:task id="Task_SendMaterials" name="Send materials to selected friends" />
    <bpmn:inclusiveGateway id="Gw_ShareJoin" />
    <bpmn:endEvent id="End_Finished" name="Farming bot finished" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Wanted" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="Gw_PrefFork" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_PrefFork" targetRef="Task_Urgency" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_PrefFork" targetRef="Task_Dependencies" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Urgency" targetRef="Gw_PrefJoin" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Dependencies" targetRef="Gw_PrefJoin" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_PrefJoin" targetRef="Task_Start" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Start" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Bdy_Update" targetRef="Task_Update" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Update" targetRef="End_Update" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Gather" targetRef="Gw_Disaster" />
    <bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gw_Disaster" targetRef="Task_Setback" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_Disaster" targetRef="Gw_Merge1" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Setback" targetRef="Gw_Merge1" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_Merge1" targetRef="Gw_Milestone" />
    <bpmn:sequenceFlow id="Flow_16" name="yes" sourceRef="Gw_Milestone" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_17" name="no" sourceRef="Gw_Milestone" targetRef="Gw_Merge2" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Notify" targetRef="Gw_Merge2" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gw_Merge2" targetRef="Gw_Done" />
    <bpmn:sequenceFlow id="Flow_20" name="no" sourceRef="Gw_Done" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="Flow_21" name="yes" sourceRef="Gw_Done" targetRef="Gw_Share" />
    <bpmn:sequenceFlow id="Flow_22" name="brag" sourceRef="Gw_Share" targetRef="Task_Brag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">brag = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" name="send" sourceRef="Gw_Share" targetRef="Task_SendMaterials">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">send = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoShare" name="neither" sourceRef="Gw_Share" targetRef="Gw_ShareJoin" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Brag" targetRef="Gw_ShareJoin" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_SendMaterials" targetRef="Gw_ShareJoin" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gw_ShareJoin" targetRef="End_Finished" />
  </bpmn:process>
</bpmn:definitions>
