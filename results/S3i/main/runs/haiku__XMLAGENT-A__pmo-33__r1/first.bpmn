<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_1" name="Customer and artist" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Artist" name="Artist">
        <bpmn:flowNodeRef>Task_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Craving a custom 3D model" />
    <bpmn:task id="Task_1" name="Instruct an artist to create a project" />
    <bpmn:task id="Task_2" name="Send several sketches to the artist" />
    <bpmn:task id="Task_A1" name="Create the project" />
    <bpmn:task id="Task_3" name="Review the project" />
    <bpmn:exclusiveGateway id="Gw_1" name="Satisfied with the result?" />
    <bpmn:task id="Task_4" name="Tell the artist what to change" />
    <bpmn:task id="Task_A2" name="Change the project" />
    <bpmn:task id="Task_A3" name="Send the STL file to the customer" />
    <bpmn:task id="Task_5" name="Choose a plastic color for 3D printing" />
    <bpmn:exclusiveGateway id="Gw_2" name="Color in stock?" />
    <bpmn:task id="Task_6" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="Gw_3" name="Under 100 grams?" />
    <bpmn:task id="Task_7" name="Put the color on the shopping list" />
    <bpmn:task id="Task_8" name="Order the color" />
    <bpmn:exclusiveGateway id="Gw_4" name="Plastic available" />
    <bpmn:parallelGateway id="Gw_5" name="Split" />
    <bpmn:task id="Task_10" name="Turn the printer on and heat up the bed and the extruder" />
    <bpmn:task id="Task_11" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="Gw_6" name="Join" />
    <bpmn:task id="Task_13" name="Print the model" />
    <bpmn:endEvent id="End_1" name="Model printed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_2" targetRef="Task_A1" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_A1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_3" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="F6" name="no" sourceRef="Gw_1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_4" targetRef="Task_A2" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_A2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="F9" name="yes" sourceRef="Gw_1" targetRef="Task_A3" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_A3" targetRef="Task_5" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_5" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="F12" name="yes" sourceRef="Gw_2" targetRef="Task_6" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_6" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="F14" name="yes" sourceRef="Gw_3" targetRef="Task_7" />
    <bpmn:sequenceFlow id="F15" name="no" sourceRef="Gw_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_7" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="F17" name="no" sourceRef="Gw_2" targetRef="Task_8" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_8" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_4" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_5" targetRef="Task_10" />
    <bpmn:sequenceFlow id="F21" sourceRef="Gw_5" targetRef="Task_11" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_10" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_11" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_6" targetRef="Task_13" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_13" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>