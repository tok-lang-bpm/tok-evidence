<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Lego machine project" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_BUILDER" name="Builder">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OrderSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GiveSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HasParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeBuilt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TestOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MoreSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CHILDREN" name="Group of children">
        <bpmn:flowNodeRef>Sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Machine project started" />
    <bpmn:task id="Design" name="Develop basic design" />
    <bpmn:task id="OrderSets" name="Order Lego brick sets" />
    <bpmn:task id="GiveSets" name="Give Lego sets to children" />
    <bpmn:task id="Sort" name="Sort parts into containers" />
    <bpmn:exclusiveGateway id="MergeParts" name="Parts needed" />
    <bpmn:exclusiveGateway id="HasParts" name="Container has parts?" />
    <bpmn:task id="Reorder" name="Reorder individual parts" />
    <bpmn:task id="Build" name="Build subcomponent" />
    <bpmn:exclusiveGateway id="MergeBuilt" name="Subcomponent built" />
    <bpmn:task id="Test" name="Test subcomponent individually" />
    <bpmn:exclusiveGateway id="TestOk" name="Test successful?" />
    <bpmn:task id="Redesign" name="Redesign subcomponent" />
    <bpmn:task id="Rebuild" name="Rebuild subcomponent" />
    <bpmn:task id="Assemble" name="Assemble subcomponent" />
    <bpmn:exclusiveGateway id="MoreSub" name="More subcomponents?" />
    <bpmn:endEvent id="End" name="Machine completed" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="Design" />
    <bpmn:sequenceFlow id="F02" sourceRef="Design" targetRef="OrderSets" />
    <bpmn:sequenceFlow id="F03" sourceRef="OrderSets" targetRef="GiveSets" />
    <bpmn:sequenceFlow id="F04" sourceRef="GiveSets" targetRef="Sort" />
    <bpmn:sequenceFlow id="F05" sourceRef="Sort" targetRef="MergeParts" />
    <bpmn:sequenceFlow id="F06" sourceRef="MergeParts" targetRef="HasParts" />
    <bpmn:sequenceFlow id="F07" name="yes" sourceRef="HasParts" targetRef="Build" />
    <bpmn:sequenceFlow id="F08" name="no" sourceRef="HasParts" targetRef="Reorder" />
    <bpmn:sequenceFlow id="F09" sourceRef="Reorder" targetRef="MergeParts" />
    <bpmn:sequenceFlow id="F10" sourceRef="Build" targetRef="MergeBuilt" />
    <bpmn:sequenceFlow id="F11" sourceRef="Rebuild" targetRef="MergeBuilt" />
    <bpmn:sequenceFlow id="F12" sourceRef="MergeBuilt" targetRef="Test" />
    <bpmn:sequenceFlow id="F13" sourceRef="Test" targetRef="TestOk" />
    <bpmn:sequenceFlow id="F14" name="yes" sourceRef="TestOk" targetRef="Assemble" />
    <bpmn:sequenceFlow id="F15" name="no" sourceRef="TestOk" targetRef="Redesign" />
    <bpmn:sequenceFlow id="F16" sourceRef="Redesign" targetRef="Rebuild" />
    <bpmn:sequenceFlow id="F17" sourceRef="Assemble" targetRef="MoreSub" />
    <bpmn:sequenceFlow id="F18" name="yes" sourceRef="MoreSub" targetRef="MergeParts" />
    <bpmn:sequenceFlow id="F19" name="no" sourceRef="MoreSub" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
