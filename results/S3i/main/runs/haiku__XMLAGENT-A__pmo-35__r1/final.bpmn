<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_PartsArrived" name="Parts arrived" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Org" name="Chainsaw manufacturer" processRef="Process_Chainsaw" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Chainsaw" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotContinued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Production" name="Production">
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_Assembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Assembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="1. Order placed" />
    <bpmn:task id="Task_2" name="2. Specify the chainsaw properties" />
    <bpmn:task id="Task_3" name="3. Order the parts from various online sources">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_4" name="4. Parts arrived">
      <bpmn:messageEventDefinition id="MED_4" messageRef="Msg_PartsArrived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_5" name="5. Inspect all parts manually" />
    <bpmn:parallelGateway id="Fork_Assembly" />
    <bpmn:task id="Task_6" name="6. Assemble the parts" />
    <bpmn:task id="Task_6_1" name="6.1. Send production update to the customer" />
    <bpmn:parallelGateway id="Join_Assembly" />
    <bpmn:task id="Task_7" name="7. Send the first saw to the customer" />
    <bpmn:task id="Task_8" name="8. Test the first saw" />
    <bpmn:exclusiveGateway id="Gw_9" name="9. Customer likes the saw?" />
    <bpmn:task id="Task_10" name="10. Produce the rest of the order" />
    <bpmn:endEvent id="End_NotContinued" name="Order ended without the rest of the order" />
    <bpmn:endEvent id="End_Completed" name="11. Order completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Catch_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Catch_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="Fork_Assembly" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Fork_Assembly" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Fork_Assembly" targetRef="Task_6_1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_6" targetRef="Join_Assembly" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_6_1" targetRef="Join_Assembly" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Join_Assembly" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_8" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gw_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_14" name="no" sourceRef="Gw_9" targetRef="End_NotContinued" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_10" targetRef="End_Completed" />
  </bpmn:process>
</bpmn:definitions>
