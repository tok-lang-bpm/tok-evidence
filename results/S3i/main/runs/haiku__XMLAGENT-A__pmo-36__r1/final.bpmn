<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Airplane" name="Airplane manufacturer" processRef="Process_Luxury_Airplane" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Luxury_Airplane" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Production" name="Production">
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendProtocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Russian" name="Russian team">
        <bpmn:flowNodeRef>Task_Vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Irish" name="Irish team">
        <bpmn:flowNodeRef>Task_Whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Other" name="Other teams">
        <bpmn:flowNodeRef>Task_Other</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Order" name="Airplane ordered" />
    <bpmn:task id="Task_Specify" name="Specify interior (bars, seats, colour, toilet water)" />
    <bpmn:task id="Task_Receive" name="Receive specifications" />
    <bpmn:task id="Task_SendReq" name="Send requirements to teams" />
    <bpmn:parallelGateway id="Gw_Fork" name="Split requirements" />
    <bpmn:task id="Task_Vodka" name="Manufacture vodka bar" />
    <bpmn:task id="Task_Whiskey" name="Manufacture whiskey bar" />
    <bpmn:task id="Task_Other" name="Manufacture other bars and interior parts" />
    <bpmn:parallelGateway id="Gw_Join" name="Join parts" />
    <bpmn:task id="Task_Assemble" name="Assemble interior" />
    <bpmn:task id="Task_Flight" name="Conduct test flight" />
    <bpmn:task id="Task_Protocol" name="Create test protocol" />
    <bpmn:task id="Task_SendProtocol" name="Send test protocol to customer" />
    <bpmn:task id="Task_Deliver" name="Deliver plane to customer" />
    <bpmn:task id="Task_Confirm" name="Confirm delivery" />
    <bpmn:endEvent id="End_Confirmed" name="Plane delivered and confirmed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Order" targetRef="Task_Specify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Specify" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Receive" targetRef="Task_SendReq" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SendReq" targetRef="Gw_Fork" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_Fork" targetRef="Task_Vodka" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_Fork" targetRef="Task_Whiskey" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_Fork" targetRef="Task_Other" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Vodka" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Whiskey" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Other" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_Join" targetRef="Task_Assemble" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Assemble" targetRef="Task_Flight" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Flight" targetRef="Task_Protocol" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Protocol" targetRef="Task_SendProtocol" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendProtocol" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Deliver" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Confirm" targetRef="End_Confirmed" />
  </bpmn:process>
</bpmn:definitions>
