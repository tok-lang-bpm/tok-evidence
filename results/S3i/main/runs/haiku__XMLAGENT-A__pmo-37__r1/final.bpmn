<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_PartsArrived" name="Parts arrived" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Contract" name="Contract project" processRef="Process_Contract" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Contract" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Contract">
      <bpmn:lane id="Lane_Builder" name="Contract builder">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSeveral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OrderMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_First</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Below3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReorderFast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Below5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReorderCheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_StockMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Need" name="Contract project needs parts" />
    <bpmn:task id="Task_Query" name="Query the web shops for parts, prices and delivery times" />
    <bpmn:task id="Task_List" name="Create a list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="Gw_Enough" name="One shop has enough parts?" />
    <bpmn:task id="Task_OrderOne" name="Order the cheapest parts from one shop" />
    <bpmn:task id="Task_OrderSeveral" name="Order the cheapest parts from several shops" />
    <bpmn:exclusiveGateway id="Gw_OrderMerge" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:intermediateCatchEvent id="Catch_First" name="First parts arrive">
      <bpmn:messageEventDefinition id="MED_First" messageRef="Msg_PartsArrived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Receive" name="Receive the remaining parts in batches" />
    <bpmn:endEvent id="End_Received" name="All parts received" />
    <bpmn:task id="Task_Build" name="Build the product from the parts" />
    <bpmn:task id="Task_Check" name="Check the stock of each part" />
    <bpmn:exclusiveGateway id="Gw_Zero" name="Stock of a part is zero?" />
    <bpmn:task id="Task_Mail" name="Write a mail to friends complaining about the web shops" />
    <bpmn:exclusiveGateway id="Gw_Below3" name="Stock below 3?" />
    <bpmn:task id="Task_ReorderFast" name="Reorder the fastest parts" />
    <bpmn:exclusiveGateway id="Gw_Below5" name="Stock below 5?" />
    <bpmn:task id="Task_ReorderCheap" name="Reorder the cheapest parts" />
    <bpmn:exclusiveGateway id="Gw_StockMerge" />
    <bpmn:exclusiveGateway id="Gw_Done" name="Contract complete?" />
    <bpmn:endEvent id="End_Done" name="Contract built" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Need" targetRef="Task_Query" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Query" targetRef="Task_List" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_List" targetRef="Gw_Enough" />
    <bpmn:sequenceFlow id="F4" name="yes" sourceRef="Gw_Enough" targetRef="Task_OrderOne" />
    <bpmn:sequenceFlow id="F5" name="no" sourceRef="Gw_Enough" targetRef="Task_OrderSeveral" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_OrderOne" targetRef="Gw_OrderMerge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_OrderSeveral" targetRef="Gw_OrderMerge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_OrderMerge" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Split" targetRef="Catch_First" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F11" sourceRef="Catch_First" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Receive" targetRef="End_Received" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Build" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Check" targetRef="Gw_Zero" />
    <bpmn:sequenceFlow id="F15" name="yes" sourceRef="Gw_Zero" targetRef="Task_Mail" />
    <bpmn:sequenceFlow id="F16" name="no" sourceRef="Gw_Zero" targetRef="Gw_Below3" />
    <bpmn:sequenceFlow id="F17" name="yes" sourceRef="Gw_Below3" targetRef="Task_ReorderFast" />
    <bpmn:sequenceFlow id="F18" name="no" sourceRef="Gw_Below3" targetRef="Gw_Below5" />
    <bpmn:sequenceFlow id="F19" name="yes" sourceRef="Gw_Below5" targetRef="Task_ReorderCheap" />
    <bpmn:sequenceFlow id="F20" name="no" sourceRef="Gw_Below5" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Mail" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ReorderFast" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_ReorderCheap" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_StockMerge" targetRef="Gw_Done" />
    <bpmn:sequenceFlow id="F25" name="yes" sourceRef="Gw_Done" targetRef="End_Done" />
    <bpmn:sequenceFlow id="F26" name="no" sourceRef="Gw_Done" targetRef="Task_Build" />
  </bpmn:process>
</bpmn:definitions>
