<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Building a House" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_owner" name="Owner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>messageFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createAttendeeList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buySnacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>holdParty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_architect" name="Tree house architect">
        <bpmn:flowNodeRef>prepareDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDraft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_stores" name="Online stores">
        <bpmn:flowNodeRef>processOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliverMaterials</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_friends" name="Friends">
        <bpmn:flowNodeRef>buildHouse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Tree house wanted" />
    <bpmn:task id="collect" name="Collect requirements" />
    <bpmn:task id="sendReq" name="Send requirements to architect" />
    <bpmn:task id="prepareDraft" name="Prepare draft" />
    <bpmn:task id="sendDraft" name="Send draft to owner" />
    <bpmn:task id="refine" name="Refine draft with additional requirements" />
    <bpmn:exclusiveGateway id="planFinal" name="Plan final?" />
    <bpmn:task id="createList" name="Create list of needed materials from plan" />
    <bpmn:task id="orderMaterials" name="Order materials from several online stores" />
    <bpmn:parallelGateway id="forkOrder" />
    <bpmn:task id="processOrder" name="Process order" />
    <bpmn:task id="deliverMaterials" name="Deliver materials" />
    <bpmn:task id="messageFriends" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="joinOrder" />
    <bpmn:task id="buildHouse" name="Build the house" />
    <bpmn:task id="sendInvitations" name="Send invitations to tree house party" />
    <bpmn:task id="createAttendeeList" name="Create list of people attending the party" />
    <bpmn:task id="buySnacks" name="Buy snacks for the party" />
    <bpmn:task id="holdParty" name="Hold tree house party" />
    <bpmn:endEvent id="end" name="Party held" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="sendReq" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendReq" targetRef="prepareDraft" />
    <bpmn:sequenceFlow id="f4" sourceRef="prepareDraft" targetRef="sendDraft" />
    <bpmn:sequenceFlow id="f5" sourceRef="sendDraft" targetRef="refine" />
    <bpmn:sequenceFlow id="f6" sourceRef="refine" targetRef="planFinal" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="planFinal" targetRef="createList" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="planFinal" targetRef="refine" />
    <bpmn:sequenceFlow id="f9" sourceRef="createList" targetRef="orderMaterials" />
    <bpmn:sequenceFlow id="f10" sourceRef="orderMaterials" targetRef="forkOrder" />
    <bpmn:sequenceFlow id="f11" sourceRef="forkOrder" targetRef="processOrder" />
    <bpmn:sequenceFlow id="f12" sourceRef="forkOrder" targetRef="messageFriends" />
    <bpmn:sequenceFlow id="f13" sourceRef="processOrder" targetRef="deliverMaterials" />
    <bpmn:sequenceFlow id="f14" sourceRef="deliverMaterials" targetRef="joinOrder" />
    <bpmn:sequenceFlow id="f15" sourceRef="messageFriends" targetRef="joinOrder" />
    <bpmn:sequenceFlow id="f16" sourceRef="joinOrder" targetRef="buildHouse" />
    <bpmn:sequenceFlow id="f17" sourceRef="buildHouse" targetRef="sendInvitations" />
    <bpmn:sequenceFlow id="f18" sourceRef="sendInvitations" targetRef="createAttendeeList" />
    <bpmn:sequenceFlow id="f19" sourceRef="createAttendeeList" targetRef="buySnacks" />
    <bpmn:sequenceFlow id="f20" sourceRef="buySnacks" targetRef="holdParty" />
    <bpmn:sequenceFlow id="f21" sourceRef="holdParty" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
