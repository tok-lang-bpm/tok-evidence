<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="DIY Smartphone Screen Repair" processRef="Process_DIY" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DIY" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Broken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDefect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_Parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOwned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ItemsToBuy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RepairSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tool" name="Online repair tool">
        <bpmn:flowNodeRef>Task_ProvideLists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideInstructions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Expert" name="Expert">
        <bpmn:flowNodeRef>Task_ExpertRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ExpertRepaired</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Broken" name="Smartphone screen broken" />
    <bpmn:task id="Task_EnterDefect" name="Enter phone model and defect" />
    <bpmn:task id="Task_ProvideLists" name="Provide list of materials, tools and ordering options" />
    <bpmn:parallelGateway id="Fork_Parallel" />
    <bpmn:task id="Task_CheckOwned" name="Check which tools and screws are already owned" />
    <bpmn:task id="Task_ContactFriends" name="Contact friends about lending or cheap purchase" />
    <bpmn:parallelGateway id="Join_Parallel" />
    <bpmn:exclusiveGateway id="Gw_ItemsToBuy" name="Items still to buy?" />
    <bpmn:task id="Task_BuyItems" name="Buy the remaining items" />
    <bpmn:exclusiveGateway id="Gw_Merge_Items" />
    <bpmn:task id="Task_ProvideInstructions" name="Provide repair instructions" />
    <bpmn:task id="Task_Repair" name="Repair the phone" />
    <bpmn:exclusiveGateway id="Gw_RepairSuccessful" name="Repair successful?" />
    <bpmn:task id="Task_SendReview" name="Send review and/or video of the repair" />
    <bpmn:endEvent id="End_Completed" name="Repair completed" />
    <bpmn:task id="Task_SendToExpert" name="Send phone to expert" />
    <bpmn:task id="Task_ExpertRepair" name="Repair the phone" />
    <bpmn:endEvent id="End_ExpertRepaired" name="Phone repaired by expert" />

    <bpmn:sequenceFlow id="F_01" sourceRef="Start_Broken" targetRef="Task_EnterDefect" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_EnterDefect" targetRef="Task_ProvideLists" />
    <bpmn:sequenceFlow id="F_03" sourceRef="Task_ProvideLists" targetRef="Fork_Parallel" />
    <bpmn:sequenceFlow id="F_04" sourceRef="Fork_Parallel" targetRef="Task_CheckOwned" />
    <bpmn:sequenceFlow id="F_05" sourceRef="Fork_Parallel" targetRef="Task_ContactFriends" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Task_CheckOwned" targetRef="Join_Parallel" />
    <bpmn:sequenceFlow id="F_07" sourceRef="Task_ContactFriends" targetRef="Join_Parallel" />
    <bpmn:sequenceFlow id="F_08" sourceRef="Join_Parallel" targetRef="Gw_ItemsToBuy" />
    <bpmn:sequenceFlow id="F_09" name="yes" sourceRef="Gw_ItemsToBuy" targetRef="Task_BuyItems" />
    <bpmn:sequenceFlow id="F_10" name="no" sourceRef="Gw_ItemsToBuy" targetRef="Gw_Merge_Items" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Task_BuyItems" targetRef="Gw_Merge_Items" />
    <bpmn:sequenceFlow id="F_12" sourceRef="Gw_Merge_Items" targetRef="Task_ProvideInstructions" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_ProvideInstructions" targetRef="Task_Repair" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_Repair" targetRef="Gw_RepairSuccessful" />
    <bpmn:sequenceFlow id="F_15" name="yes" sourceRef="Gw_RepairSuccessful" targetRef="Task_SendReview" />
    <bpmn:sequenceFlow id="F_16" name="no" sourceRef="Gw_RepairSuccessful" targetRef="Task_SendToExpert" />
    <bpmn:sequenceFlow id="F_17" sourceRef="Task_SendReview" targetRef="End_Completed" />
    <bpmn:sequenceFlow id="F_18" sourceRef="Task_SendToExpert" targetRef="Task_ExpertRepair" />
    <bpmn:sequenceFlow id="F_19" sourceRef="Task_ExpertRepair" targetRef="End_ExpertRepaired" />
  </bpmn:process>
</bpmn:definitions>