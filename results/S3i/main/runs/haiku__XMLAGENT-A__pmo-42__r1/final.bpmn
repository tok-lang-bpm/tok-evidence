<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Service for Your Fridge" processRef="fridge-process" />
  </bpmn:collaboration>
  <bpmn:process id="fridge-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start_noise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rate_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_center" name="Central fridge service center">
        <bpmn:flowNodeRef>task_select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_facility" name="Local service facility">
        <bpmn:flowNodeRef>task_appt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_repaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_leave</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_noise" name="Fridge makes strange noises" />
    <bpmn:task id="task_describe" name="Describe the symptoms" />
    <bpmn:task id="task_send" name="Send symptoms and fridge type to central fridge service center" />
    <bpmn:task id="task_select" name="Select local service facility" />
    <bpmn:task id="task_appt" name="Make appointment" />
    <bpmn:task id="task_arrive" name="Arrive at random time" />
    <bpmn:task id="task_repair" name="Repair the fridge" />
    <bpmn:exclusiveGateway id="gw_repaired" name="Fridge repaired?" />
    <bpmn:task id="task_leave" name="Leave without repairing (additional parts needed)" />
    <bpmn:task id="task_confirm" name="Confirm that the fridge is OK" />
    <bpmn:exclusiveGateway id="gw_rate" name="Rate the service facility?" />
    <bpmn:task id="task_rate" name="Rate the service facility" />
    <bpmn:exclusiveGateway id="gw_rate_merge" />
    <bpmn:endEvent id="end_done" name="Fridge service completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start_noise" targetRef="task_describe" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_describe" targetRef="task_send" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_send" targetRef="task_select" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_select" targetRef="task_appt" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_appt" targetRef="task_arrive" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_arrive" targetRef="task_repair" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_repair" targetRef="gw_repaired" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="gw_repaired" targetRef="task_confirm" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="gw_repaired" targetRef="task_leave" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_leave" targetRef="task_appt" />
    <bpmn:sequenceFlow id="f11" sourceRef="task_confirm" targetRef="gw_rate" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="gw_rate" targetRef="task_rate" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="gw_rate" targetRef="gw_rate_merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_rate" targetRef="gw_rate_merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_rate_merge" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
