<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Robotic Burger Seller near the University of Vienna" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Robot" name="Robot">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MenuChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SideChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SideMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StatusGiven</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Order" name="Order placed" />
    <bpmn:task id="Task_Receive" name="Receive order" />
    <bpmn:task id="Task_AskMenu" name="Ask whether customer wants menu or burger only" />
    <bpmn:exclusiveGateway id="Gw_MenuChoice" name="Menu or burger only?" />
    <bpmn:parallelGateway id="Gw_ParSplit" />
    <bpmn:task id="Task_PrepDrink" name="Prepare drink" />
    <bpmn:task id="Task_AskSide" name="Ask whether fries or wedges" />
    <bpmn:exclusiveGateway id="Gw_SideChoice" name="Fries or wedges?" />
    <bpmn:task id="Task_Fries" name="Prepare fries" />
    <bpmn:task id="Task_Wedges" name="Prepare wedges" />
    <bpmn:exclusiveGateway id="Gw_SideMerge" />
    <bpmn:parallelGateway id="Gw_ParJoin" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Burger" name="Prepare burger" />
    <bpmn:boundaryEvent id="BE_Status" name="Every 30 seconds" attachedToRef="Task_Burger" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Status" name="Give enthusiastic status update" />
    <bpmn:endEvent id="End_StatusGiven" name="Status update given" />
    <bpmn:task id="Task_Deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="End_Delivered" name="Order delivered" />
    <bpmn:sequenceFlow id="F_01" sourceRef="Start_Order" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_Receive" targetRef="Task_AskMenu" />
    <bpmn:sequenceFlow id="F_03" sourceRef="Task_AskMenu" targetRef="Gw_MenuChoice" />
    <bpmn:sequenceFlow id="F_04" name="menu" sourceRef="Gw_MenuChoice" targetRef="Gw_ParSplit" />
    <bpmn:sequenceFlow id="F_05" name="burger only" sourceRef="Gw_MenuChoice" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Gw_ParSplit" targetRef="Task_PrepDrink" />
    <bpmn:sequenceFlow id="F_07" sourceRef="Gw_ParSplit" targetRef="Task_AskSide" />
    <bpmn:sequenceFlow id="F_08" sourceRef="Task_AskSide" targetRef="Gw_SideChoice" />
    <bpmn:sequenceFlow id="F_09" name="fries" sourceRef="Gw_SideChoice" targetRef="Task_Fries" />
    <bpmn:sequenceFlow id="F_10" name="wedges" sourceRef="Gw_SideChoice" targetRef="Task_Wedges" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Task_Fries" targetRef="Gw_SideMerge" />
    <bpmn:sequenceFlow id="F_12" sourceRef="Task_Wedges" targetRef="Gw_SideMerge" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Gw_SideMerge" targetRef="Gw_ParJoin" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_PrepDrink" targetRef="Gw_ParJoin" />
    <bpmn:sequenceFlow id="F_15" sourceRef="Gw_ParJoin" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_16" sourceRef="Gw_Merge" targetRef="Task_Burger" />
    <bpmn:sequenceFlow id="F_17" sourceRef="Task_Burger" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="F_18" sourceRef="BE_Status" targetRef="Task_Status" />
    <bpmn:sequenceFlow id="F_19" sourceRef="Task_Status" targetRef="End_StatusGiven" />
    <bpmn:sequenceFlow id="F_20" sourceRef="Task_Deliver" targetRef="End_Delivered" />
  </bpmn:process>
</bpmn:definitions>