<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_shop" name="Online Shop" processRef="process_order" />
  </bpmn:collaboration>
  <bpmn:process id="process_order" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_waitLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_addCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_saveProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_allSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enterPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_waitPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enterShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_billingDiff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enterBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_billingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="Shopping system">
        <bpmn:flowNodeRef>t_checkCred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_loginOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_finishOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPar_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPar_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_completeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_bank" name="Bank">
        <bpmn:flowNodeRef>t_confirmPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_order" name="Customer starts ordering" />
    <bpmn:task id="t_login" name="Log in to E-Shop system" />
    <bpmn:task id="t_checkCred" name="Check credentials" />
    <bpmn:exclusiveGateway id="gw_loginOk" name="Login successful?" />
    <bpmn:task id="t_waitLogin" name="Wait for login confirmation" />
    <bpmn:endEvent id="end_stopped" name="Shopping experience stopped" />
    <bpmn:task id="t_select" name="Select product" />
    <bpmn:task id="t_addCart" name="Add product to shopping cart" />
    <bpmn:task id="t_saveProduct" name="Save product" />
    <bpmn:exclusiveGateway id="gw_allSelected" name="All products selected?" />
    <bpmn:task id="t_finishOrder" name="Finish order" />
    <bpmn:parallelGateway id="gwPar_split" />
    <bpmn:task id="t_enterPayment" name="Enter payment data" />
    <bpmn:task id="t_waitPayment" name="Wait for payment confirmation" />
    <bpmn:task id="t_confirmPayment" name="Confirm payment" />
    <bpmn:task id="t_enterShipping" name="Enter shipping address" />
    <bpmn:exclusiveGateway id="gw_billingDiff" name="Billing address differs from shipping address?" />
    <bpmn:task id="t_enterBilling" name="Enter billing address" />
    <bpmn:exclusiveGateway id="gw_billingMerge" />
    <bpmn:parallelGateway id="gwPar_join" />
    <bpmn:task id="t_completeOrder" name="Complete order" />
    <bpmn:endEvent id="end_done" name="Order completed" />
    <bpmn:sequenceFlow id="f01" sourceRef="start_order" targetRef="t_login" />
    <bpmn:sequenceFlow id="f02" sourceRef="t_login" targetRef="t_checkCred" />
    <bpmn:sequenceFlow id="f03" sourceRef="t_checkCred" targetRef="gw_loginOk" />
    <bpmn:sequenceFlow id="f04" name="no" sourceRef="gw_loginOk" targetRef="end_stopped" />
    <bpmn:sequenceFlow id="f05" name="yes" sourceRef="gw_loginOk" targetRef="t_waitLogin" />
    <bpmn:sequenceFlow id="f06" sourceRef="t_waitLogin" targetRef="t_select" />
    <bpmn:sequenceFlow id="f07" sourceRef="t_select" targetRef="t_addCart" />
    <bpmn:sequenceFlow id="f08" sourceRef="t_addCart" targetRef="t_saveProduct" />
    <bpmn:sequenceFlow id="f09" sourceRef="t_saveProduct" targetRef="gw_allSelected" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gw_allSelected" targetRef="t_select" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gw_allSelected" targetRef="t_finishOrder" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_finishOrder" targetRef="gwPar_split" />
    <bpmn:sequenceFlow id="f13" sourceRef="gwPar_split" targetRef="t_enterPayment" />
    <bpmn:sequenceFlow id="f14" sourceRef="gwPar_split" targetRef="t_enterShipping" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_enterPayment" targetRef="t_waitPayment" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_waitPayment" targetRef="t_confirmPayment" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_confirmPayment" targetRef="gwPar_join" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_enterShipping" targetRef="gw_billingDiff" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="gw_billingDiff" targetRef="t_enterBilling" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="gw_billingDiff" targetRef="gw_billingMerge" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_enterBilling" targetRef="gw_billingMerge" />
    <bpmn:sequenceFlow id="f22" sourceRef="gw_billingMerge" targetRef="gwPar_join" />
    <bpmn:sequenceFlow id="f23" sourceRef="gwPar_join" targetRef="t_completeOrder" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_completeOrder" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>