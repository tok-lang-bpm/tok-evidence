<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg_activation" name="Activation response" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_institute" name="Sports institute" processRef="usi_registration" />
  </bpmn:collaboration>
  <bpmn:process id="usi_registration" name="New application for registering for a USI course" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_selectOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_requestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_activation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_accountJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_completeReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="Application system">
        <bpmn:flowNodeRef>gw_slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_full</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ticket</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Wish to register for a course" />
    <bpmn:task id="t_select" name="Select a course" />
    <bpmn:exclusiveGateway id="gw_slots" name="Slots free?" />
    <bpmn:task id="t_show" name="Show the courses and dates" />
    <bpmn:endEvent id="end_full" name="No slots free" />
    <bpmn:task id="t_selectOne" name="Select one course" />
    <bpmn:exclusiveGateway id="gw_account" name="Account at the sports institute exists?" />
    <bpmn:exclusiveGateway id="gw_eligible" name="Registered at an eligible university?" />
    <bpmn:task id="t_register" name="Register the account" />
    <bpmn:task id="t_requestActivation" name="Request an activation" />
    <bpmn:intermediateCatchEvent id="ev_activation" name="Activation response received">
      <bpmn:messageEventDefinition messageRef="msg_activation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gw_accountJoin" />
    <bpmn:task id="t_login" name="Log into the account" />
    <bpmn:parallelGateway id="gw_split" />
    <bpmn:task id="t_tweet" name="Tweet to friends" />
    <bpmn:task id="t_completeReg" name="Complete the registration for the course" />
    <bpmn:task id="t_payment" name="Provide the payment information" />
    <bpmn:parallelGateway id="gw_join" />
    <bpmn:task id="t_ticket" name="Issue the course ticket" />
    <bpmn:endEvent id="end_ticket" name="Course ticket received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_select" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_select" targetRef="gw_slots" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gw_slots" targetRef="t_show" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gw_slots" targetRef="end_full" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_show" targetRef="t_selectOne" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_selectOne" targetRef="gw_account" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gw_account" targetRef="gw_accountJoin" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gw_account" targetRef="gw_eligible" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gw_eligible" targetRef="t_register" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gw_eligible" targetRef="t_requestActivation" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_register" targetRef="gw_accountJoin" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_requestActivation" targetRef="ev_activation" />
    <bpmn:sequenceFlow id="f13" sourceRef="ev_activation" targetRef="gw_accountJoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="gw_accountJoin" targetRef="t_login" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_login" targetRef="gw_split" />
    <bpmn:sequenceFlow id="f16" sourceRef="gw_split" targetRef="t_tweet" />
    <bpmn:sequenceFlow id="f17" sourceRef="gw_split" targetRef="t_completeReg" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_completeReg" targetRef="t_payment" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_tweet" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_payment" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f21" sourceRef="gw_join" targetRef="t_ticket" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_ticket" targetRef="end_ticket" />
  </bpmn:process>
</bpmn:definitions>
