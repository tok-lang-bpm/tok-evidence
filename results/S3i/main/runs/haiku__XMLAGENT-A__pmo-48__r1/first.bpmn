<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Vienna Night Run participation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Runner" name="Runner">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckWorkday</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OneHour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaveWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunNight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>Task_Measure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_App" name="App">
        <bpmn:flowNodeRef>Gw_Under25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Want to participate in the Night Run" />
    <bpmn:task id="Task_SelectBlock" name="Select a starting block" />
    <bpmn:task id="Task_Run5" name="Run 5 km" />
    <bpmn:task id="Task_Measure" name="Measure the time" />
    <bpmn:task id="Task_EnterTime" name="Enter the 5 km time into the app" />
    <bpmn:exclusiveGateway id="Gw_Under25" name="Time under 25 minutes?" />
    <bpmn:task id="Task_Train" name="Train and check" />
    <bpmn:task id="Task_GetNumber" name="Get the starting number" />
    <bpmn:task id="Task_CheckWorkday" name="Find out when the workday ends" />
    <bpmn:exclusiveGateway id="Gw_OneHour" name="More than one hour between starting time and end of workday?" />
    <bpmn:task id="Task_GoHome" name="Go there from home" />
    <bpmn:task id="Task_LeaveWork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="Gw_Merge1" />
    <bpmn:parallelGateway id="Gw_ParFork" />
    <bpmn:task id="Task_RunNight" name="Run the Night Run" />
    <bpmn:task id="Task_Drink" name="Drink while running" />
    <bpmn:parallelGateway id="Gw_ParJoin" />
    <bpmn:task id="Task_ReceiveTime" name="Receive the final running time" />
    <bpmn:endEvent id="End_1" name="Final running time received" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SelectBlock" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SelectBlock" targetRef="Task_Run5" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Run5" targetRef="Task_Measure" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Measure" targetRef="Task_EnterTime" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EnterTime" targetRef="Gw_Under25" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_Under25" targetRef="Task_Train" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Train" targetRef="Task_Run5" />
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_Under25" targetRef="Task_GetNumber" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_GetNumber" targetRef="Task_CheckWorkday" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckWorkday" targetRef="Gw_OneHour" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_OneHour" targetRef="Task_GoHome" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gw_OneHour" targetRef="Task_LeaveWork" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_GoHome" targetRef="Gw_Merge1" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_LeaveWork" targetRef="Gw_Merge1" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_Merge1" targetRef="Gw_ParFork" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_ParFork" targetRef="Task_RunNight" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_ParFork" targetRef="Task_Drink" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RunNight" targetRef="Gw_ParJoin" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Drink" targetRef="Gw_ParJoin" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gw_ParJoin" targetRef="Task_ReceiveTime" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReceiveTime" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>