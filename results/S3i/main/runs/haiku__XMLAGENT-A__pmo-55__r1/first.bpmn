<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_hospital" name="Hospital" processRef="puncture_process" />
  </bpmn:collaboration>
  <bpmn:process id="puncture_process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_doctor" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_implements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash_hands</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile_clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean_area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape_zone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure_ultrasound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gel_in_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile_gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>position_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_vein_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify_compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_vein_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesthetize_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_blood_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wire_long</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wire_short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_wire_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_wire_good</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen_pathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance_catheter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove_guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify_flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_catheter_position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="prepare_implements" name="Prepare the implements" />
    <bpmn:task id="wash_hands" name="Wash the hands" />
    <bpmn:task id="sterile_clothes" name="Get into sterile clothes" />
    <bpmn:task id="clean_area" name="Clean the puncture area" />
    <bpmn:task id="drape_zone" name="Drape the puncture zone" />
    <bpmn:task id="configure_ultrasound" name="Configure the ultrasound" />
    <bpmn:task id="gel_in_probe" name="Put gel in the probe" />
    <bpmn:task id="cover_probe" name="Cover the probe" />
    <bpmn:task id="sterile_gel" name="Put the sterile gel" />
    <bpmn:task id="position_probe" name="Position the probe" />
    <bpmn:task id="position_patient" name="Position the patient" />
    <bpmn:exclusiveGateway id="gw_vein_method" name="Vein identification method?" />
    <bpmn:task id="identify_anatomic" name="Identify the vein using an anatomic identification" />
    <bpmn:task id="identify_doppler" name="Identify the vein using a doppler identification" />
    <bpmn:task id="identify_compression" name="Identify the vein using a compression identification" />
    <bpmn:exclusiveGateway id="gw_vein_join" />
    <bpmn:task id="anesthetize_patient" name="Anesthetize the patient" />
    <bpmn:task id="puncture_patient" name="Puncture the patient" />
    <bpmn:task id="check_blood_return" name="Check the blood return" />
    <bpmn:exclusiveGateway id="gw_blood_return" name="Blood return correct?" />
    <bpmn:task id="drop_probe" name="Drop the probe" />
    <bpmn:task id="remove_syringe" name="Remove the syringe" />
    <bpmn:task id="install_guidewire" name="Install the guidewire" />
    <bpmn:task id="remove_trocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="gw_wire_method" name="Wire check method?" />
    <bpmn:task id="check_wire_long" name="Check the wire in the long axis" />
    <bpmn:task id="check_wire_short" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="gw_wire_join" />
    <bpmn:task id="check_wire_position" name="Check the wire position" />
    <bpmn:exclusiveGateway id="gw_wire_good" name="Wire in good position?" />
    <bpmn:task id="widen_pathway" name="Widen the pathway" />
    <bpmn:task id="advance_catheter" name="Advance the catheter" />
    <bpmn:task id="remove_guidewire" name="Remove the guidewire" />
    <bpmn:task id="verify_flow" name="Verify the flow and the reflow" />
    <bpmn:task id="check_catheter_position" name="Check the catheter position" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f01" sourceRef="start" targetRef="prepare_implements" />
    <bpmn:sequenceFlow id="f02" sourceRef="prepare_implements" targetRef="wash_hands" />
    <bpmn:sequenceFlow id="f03" sourceRef="wash_hands" targetRef="sterile_clothes" />
    <bpmn:sequenceFlow id="f04" sourceRef="sterile_clothes" targetRef="clean_area" />
    <bpmn:sequenceFlow id="f05" sourceRef="clean_area" targetRef="drape_zone" />
    <bpmn:sequenceFlow id="f06" sourceRef="drape_zone" targetRef="configure_ultrasound" />
    <bpmn:sequenceFlow id="f07" sourceRef="configure_ultrasound" targetRef="gel_in_probe" />
    <bpmn:sequenceFlow id="f08" sourceRef="gel_in_probe" targetRef="cover_probe" />
    <bpmn:sequenceFlow id="f09" sourceRef="cover_probe" targetRef="sterile_gel" />
    <bpmn:sequenceFlow id="f10" sourceRef="sterile_gel" targetRef="position_probe" />
    <bpmn:sequenceFlow id="f11" sourceRef="position_probe" targetRef="position_patient" />
    <bpmn:sequenceFlow id="f12" sourceRef="position_patient" targetRef="gw_vein_method" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_vein_method" targetRef="identify_anatomic" name="anatomic" />
    <bpmn:sequenceFlow id="f14" sourceRef="gw_vein_method" targetRef="identify_doppler" name="doppler" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_vein_method" targetRef="identify_compression" name="compression" />
    <bpmn:sequenceFlow id="f16" sourceRef="identify_anatomic" targetRef="gw_vein_join" />
    <bpmn:sequenceFlow id="f17" sourceRef="identify_doppler" targetRef="gw_vein_join" />
    <bpmn:sequenceFlow id="f18" sourceRef="identify_compression" targetRef="gw_vein_join" />
    <bpmn:sequenceFlow id="f19" sourceRef="gw_vein_join" targetRef="anesthetize_patient" />
    <bpmn:sequenceFlow id="f20" sourceRef="anesthetize_patient" targetRef="puncture_patient" />
    <bpmn:sequenceFlow id="f21" sourceRef="puncture_patient" targetRef="check_blood_return" />
    <bpmn:sequenceFlow id="f22" sourceRef="check_blood_return" targetRef="gw_blood_return" />
    <bpmn:sequenceFlow id="f23" sourceRef="gw_blood_return" targetRef="puncture_patient" name="no" />
    <bpmn:sequenceFlow id="f24" sourceRef="gw_blood_return" targetRef="drop_probe" name="yes" />
    <bpmn:sequenceFlow id="f25" sourceRef="drop_probe" targetRef="remove_syringe" />
    <bpmn:sequenceFlow id="f26" sourceRef="remove_syringe" targetRef="install_guidewire" />
    <bpmn:sequenceFlow id="f27" sourceRef="install_guidewire" targetRef="remove_trocar" />
    <bpmn:sequenceFlow id="f28" sourceRef="remove_trocar" targetRef="gw_wire_method" />
    <bpmn:sequenceFlow id="f29" sourceRef="gw_wire_method" targetRef="check_wire_long" name="long axis" />
    <bpmn:sequenceFlow id="f30" sourceRef="gw_wire_method" targetRef="check_wire_short" name="short axis" />
    <bpmn:sequenceFlow id="f31" sourceRef="check_wire_long" targetRef="gw_wire_join" />
    <bpmn:sequenceFlow id="f32" sourceRef="check_wire_short" targetRef="gw_wire_join" />
    <bpmn:sequenceFlow id="f33" sourceRef="gw_wire_join" targetRef="check_wire_position" />
    <bpmn:sequenceFlow id="f34" sourceRef="check_wire_position" targetRef="gw_wire_good" />
    <bpmn:sequenceFlow id="f35" sourceRef="gw_wire_good" targetRef="puncture_patient" name="no" />
    <bpmn:sequenceFlow id="f36" sourceRef="gw_wire_good" targetRef="widen_pathway" name="yes" />
    <bpmn:sequenceFlow id="f37" sourceRef="widen_pathway" targetRef="advance_catheter" />
    <bpmn:sequenceFlow id="f38" sourceRef="advance_catheter" targetRef="remove_guidewire" />
    <bpmn:sequenceFlow id="f39" sourceRef="remove_guidewire" targetRef="verify_flow" />
    <bpmn:sequenceFlow id="f40" sourceRef="verify_flow" targetRef="check_catheter_position" />
    <bpmn:sequenceFlow id="f41" sourceRef="check_catheter_position" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>