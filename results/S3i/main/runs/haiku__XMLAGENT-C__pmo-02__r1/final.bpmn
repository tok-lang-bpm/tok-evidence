<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="HIRING" />
  </bpmn:collaboration>
  <bpmn:process id="HIRING" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="DEPT" name="Department">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IDENTIFY_NEED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INTEGRATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="HR" name="HR">
        <bpmn:flowNodeRef>CREATE_JD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POST_JD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SCREEN_RESUMES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHONE_INTERVIEWS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INVITE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FORMAT_GW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN_PERSON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VIRTUAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INTERVIEW_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CHOOSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EXTEND_OFFER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NEGOTIATE_GW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NEGOTIATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NEGOTIATE_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ONBOARD_FORK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PAPERWORK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ORIENTATION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRAINING</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ONBOARD_JOIN</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Need for new hire arises" />
    <bpmn:task id="IDENTIFY_NEED" name="Identify need for new hire" />
    <bpmn:task id="CREATE_JD" name="Create job description" />
    <bpmn:task id="POST_JD" name="Post job description on job boards" />
    <bpmn:task id="SCREEN_RESUMES" name="Collect and screen resumes" />
    <bpmn:task id="PHONE_INTERVIEWS" name="Conduct initial phone interviews" />
    <bpmn:task id="INVITE" name="Invite selected candidates to interviews" />
    <bpmn:exclusiveGateway id="FORMAT_GW" name="Interview format preferred by candidate?" />
    <bpmn:task id="IN_PERSON" name="Conduct in-person interview" />
    <bpmn:task id="VIRTUAL" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="INTERVIEW_MERGE" />
    <bpmn:task id="CHOOSE" name="Choose candidate" />
    <bpmn:task id="EXTEND_OFFER" name="Extend offer" />
    <bpmn:exclusiveGateway id="NEGOTIATE_GW" name="Salary negotiation needed?" />
    <bpmn:task id="NEGOTIATE" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="NEGOTIATE_MERGE" />
    <bpmn:parallelGateway id="ONBOARD_FORK" />
    <bpmn:task id="PAPERWORK" name="Complete paperwork" />
    <bpmn:task id="ORIENTATION" name="Conduct orientation" />
    <bpmn:task id="TRAINING" name="Provide training" />
    <bpmn:parallelGateway id="ONBOARD_JOIN" />
    <bpmn:task id="INTEGRATE" name="Integrate new hire into team" />
    <bpmn:endEvent id="END" name="New hire fully integrated" />
    <bpmn:sequenceFlow id="F01" sourceRef="START" targetRef="IDENTIFY_NEED" />
    <bpmn:sequenceFlow id="F02" sourceRef="IDENTIFY_NEED" targetRef="CREATE_JD" />
    <bpmn:sequenceFlow id="F03" sourceRef="CREATE_JD" targetRef="POST_JD" />
    <bpmn:sequenceFlow id="F04" sourceRef="POST_JD" targetRef="SCREEN_RESUMES" />
    <bpmn:sequenceFlow id="F05" sourceRef="SCREEN_RESUMES" targetRef="PHONE_INTERVIEWS" />
    <bpmn:sequenceFlow id="F06" sourceRef="PHONE_INTERVIEWS" targetRef="INVITE" />
    <bpmn:sequenceFlow id="F07" sourceRef="INVITE" targetRef="FORMAT_GW" />
    <bpmn:sequenceFlow id="F08" name="In-person" sourceRef="FORMAT_GW" targetRef="IN_PERSON" />
    <bpmn:sequenceFlow id="F09" name="Virtual" sourceRef="FORMAT_GW" targetRef="VIRTUAL" />
    <bpmn:sequenceFlow id="F10" sourceRef="IN_PERSON" targetRef="INTERVIEW_MERGE" />
    <bpmn:sequenceFlow id="F11" sourceRef="VIRTUAL" targetRef="INTERVIEW_MERGE" />
    <bpmn:sequenceFlow id="F12" sourceRef="INTERVIEW_MERGE" targetRef="CHOOSE" />
    <bpmn:sequenceFlow id="F13" sourceRef="CHOOSE" targetRef="EXTEND_OFFER" />
    <bpmn:sequenceFlow id="F14" sourceRef="EXTEND_OFFER" targetRef="NEGOTIATE_GW" />
    <bpmn:sequenceFlow id="F15" name="Yes" sourceRef="NEGOTIATE_GW" targetRef="NEGOTIATE" />
    <bpmn:sequenceFlow id="F16" name="No" sourceRef="NEGOTIATE_GW" targetRef="NEGOTIATE_MERGE" />
    <bpmn:sequenceFlow id="F17" sourceRef="NEGOTIATE" targetRef="NEGOTIATE_MERGE" />
    <bpmn:sequenceFlow id="F18" sourceRef="NEGOTIATE_MERGE" targetRef="ONBOARD_FORK" />
    <bpmn:sequenceFlow id="F19" sourceRef="ONBOARD_FORK" targetRef="PAPERWORK" />
    <bpmn:sequenceFlow id="F20" sourceRef="ONBOARD_FORK" targetRef="ORIENTATION" />
    <bpmn:sequenceFlow id="F21" sourceRef="ONBOARD_FORK" targetRef="TRAINING" />
    <bpmn:sequenceFlow id="F22" sourceRef="PAPERWORK" targetRef="ONBOARD_JOIN" />
    <bpmn:sequenceFlow id="F23" sourceRef="ORIENTATION" targetRef="ONBOARD_JOIN" />
    <bpmn:sequenceFlow id="F24" sourceRef="TRAINING" targetRef="ONBOARD_JOIN" />
    <bpmn:sequenceFlow id="F25" sourceRef="ONBOARD_JOIN" targetRef="INTEGRATE" />
    <bpmn:sequenceFlow id="F26" sourceRef="INTEGRATE" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
