<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_WAREHOUSE" name="Warehouse staff">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MONITOR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>THRESHOLD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ALERT_TYPE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MANUAL_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REORDER_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RECEIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INSPECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>STORE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PROCUREMENT" name="Procurement team">
        <bpmn:flowNodeRef>ORDER</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="Inventory system">
        <bpmn:flowNodeRef>AUTO_ALERT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UPDATE_DELIVERY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RECORD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UPDATE_LEVELS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Monitoring begins" />
    <bpmn:task id="MONITOR" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="THRESHOLD" name="Stock at threshold?" />
    <bpmn:exclusiveGateway id="ALERT_TYPE" name="Alert or manual check?" />
    <bpmn:task id="AUTO_ALERT" name="Send automated alert" />
    <bpmn:task id="MANUAL_CHECK" name="Perform manual check" />
    <bpmn:exclusiveGateway id="REORDER_MERGE" name="Reorder needed" />
    <bpmn:task id="ORDER" name="Place order with suppliers considering cost, delivery time and supplier reliability" />
    <bpmn:task id="UPDATE_DELIVERY" name="Update inventory with expected delivery dates" />
    <bpmn:task id="RECEIVE" name="Receive stock" />
    <bpmn:task id="INSPECT" name="Inspect stock for quality" />
    <bpmn:task id="RECORD" name="Record stock in system" />
    <bpmn:task id="STORE" name="Place stock on shelves or in storage" />
    <bpmn:task id="UPDATE_LEVELS" name="Update inventory levels" />
    <bpmn:endEvent id="END" name="Restock complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="START" targetRef="MONITOR" />
    <bpmn:sequenceFlow id="f2" sourceRef="MONITOR" targetRef="THRESHOLD" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="THRESHOLD" targetRef="ALERT_TYPE" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="THRESHOLD" targetRef="MONITOR" />
    <bpmn:sequenceFlow id="f5" name="automated alert" sourceRef="ALERT_TYPE" targetRef="AUTO_ALERT" />
    <bpmn:sequenceFlow id="f6" name="manual check" sourceRef="ALERT_TYPE" targetRef="MANUAL_CHECK" />
    <bpmn:sequenceFlow id="f7" sourceRef="AUTO_ALERT" targetRef="REORDER_MERGE" />
    <bpmn:sequenceFlow id="f8" sourceRef="MANUAL_CHECK" targetRef="REORDER_MERGE" />
    <bpmn:sequenceFlow id="f9" sourceRef="REORDER_MERGE" targetRef="ORDER" />
    <bpmn:sequenceFlow id="f10" sourceRef="ORDER" targetRef="UPDATE_DELIVERY" />
    <bpmn:sequenceFlow id="f11" sourceRef="UPDATE_DELIVERY" targetRef="RECEIVE" />
    <bpmn:sequenceFlow id="f12" sourceRef="RECEIVE" targetRef="INSPECT" />
    <bpmn:sequenceFlow id="f13" sourceRef="INSPECT" targetRef="RECORD" />
    <bpmn:sequenceFlow id="f14" sourceRef="RECORD" targetRef="STORE" />
    <bpmn:sequenceFlow id="f15" sourceRef="STORE" targetRef="UPDATE_LEVELS" />
    <bpmn:sequenceFlow id="f16" sourceRef="UPDATE_LEVELS" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>