<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Travel Company" processRef="TICKET-PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="TICKET-PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BOOKING" name="Booking system">
        <bpmn:flowNodeRef>t_generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reminders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TRAVEL" name="Travel company">
        <bpmn:flowNodeRef>t_inventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer begins ticket search" />
    <bpmn:task id="t_search" name="Search for a flight, train, or bus ticket" />
    <bpmn:task id="t_select" name="Select the preferred route, date, and time" />
    <bpmn:task id="t_provide" name="Provide personal information and payment details" />
    <bpmn:task id="t_generate" name="Generate the ticket" />
    <bpmn:task id="t_send" name="Send the ticket by email or SMS" />
    <bpmn:parallelGateway id="p_split" name="Split" />
    <bpmn:task id="t_inventory" name="Update the seat inventory" />
    <bpmn:task id="t_reminders" name="Send reminders and check-in or boarding instructions" />
    <bpmn:parallelGateway id="p_join" name="Join" />
    <bpmn:task id="t_travel" name="Complete the journey" />
    <bpmn:exclusiveGateway id="x_feedback" name="Post-travel feedback or services?" />
    <bpmn:task id="t_feedback" name="Give post-travel feedback or use services" />
    <bpmn:endEvent id="end_feedback" name="Feedback given" />
    <bpmn:endEvent id="end_done" name="Process concluded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_search" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_search" targetRef="t_select" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_select" targetRef="t_provide" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_provide" targetRef="t_generate" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_generate" targetRef="t_send" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_send" targetRef="p_split" />
    <bpmn:sequenceFlow id="f7" sourceRef="p_split" targetRef="t_inventory" />
    <bpmn:sequenceFlow id="f8" sourceRef="p_split" targetRef="t_reminders" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_inventory" targetRef="p_join" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_reminders" targetRef="p_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="p_join" targetRef="t_travel" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_travel" targetRef="x_feedback" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="x_feedback" targetRef="t_feedback" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="x_feedback" targetRef="end_done" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_feedback" targetRef="end_feedback" />
  </bpmn:process>
</bpmn:definitions>
