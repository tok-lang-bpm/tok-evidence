<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="RD" name="R&amp;D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwRefine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDiscarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Idea needed" />
    <bpmn:task id="identify" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="design" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype from available materials and resources" />
    <bpmn:exclusiveGateway id="merge1" name="Testing entry" />
    <bpmn:task id="test" name="Test the prototype for functionality, safety and market potential" />
    <bpmn:task id="feedback" name="Collect feedback from the testing phase" />
    <bpmn:exclusiveGateway id="gwRefine" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="gwDecision" name="Prototype approved or discarded?" />
    <bpmn:task id="approve" name="Approve the prototype for further development" />
    <bpmn:task id="discard" name="Discard the prototype" />
    <bpmn:endEvent id="endApproved" name="Prototype approved" />
    <bpmn:endEvent id="endDiscarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f3" sourceRef="research" targetRef="design" />
    <bpmn:sequenceFlow id="f4" sourceRef="design" targetRef="select" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f6" sourceRef="build" targetRef="merge1" />
    <bpmn:sequenceFlow id="f7" sourceRef="merge1" targetRef="test" />
    <bpmn:sequenceFlow id="f8" sourceRef="test" targetRef="feedback" />
    <bpmn:sequenceFlow id="f9" sourceRef="feedback" targetRef="gwRefine" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="gwRefine" targetRef="refine" />
    <bpmn:sequenceFlow id="f11" sourceRef="refine" targetRef="merge1" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gwRefine" targetRef="gwDecision" />
    <bpmn:sequenceFlow id="f13" name="approved" sourceRef="gwDecision" targetRef="approve" />
    <bpmn:sequenceFlow id="f14" name="discarded" sourceRef="gwDecision" targetRef="discard" />
    <bpmn:sequenceFlow id="f15" sourceRef="approve" targetRef="endApproved" />
    <bpmn:sequenceFlow id="f16" sourceRef="discard" targetRef="endDiscarded" />
  </bpmn:process>
</bpmn:definitions>