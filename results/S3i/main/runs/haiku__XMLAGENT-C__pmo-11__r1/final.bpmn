<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Subscription service" processRef="SUBSCRIPTION" />
  </bpmn:collaboration>
  <bpmn:process id="SUBSCRIPTION" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ENTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CANCEL_REQ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>T_GENERATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ASSIGN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_BILLING</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RUNNING</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NOTIFY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_CANCEL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SUPPORT" name="Support team">
        <bpmn:flowNodeRef>T_PROCESS_CANCEL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_REFUND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DEACTIVATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SETTLE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Customer signs up for a subscription" />
    <bpmn:task id="T_ENTER" name="Enter personal and payment information" />
    <bpmn:task id="T_GENERATE" name="Generate account" />
    <bpmn:task id="T_ASSIGN" name="Assign access" />
    <bpmn:task id="T_BILLING" name="Trigger automated billing cycles" />
    <bpmn:exclusiveGateway id="M_RUNNING" name="Subscription running" />
    <bpmn:task id="T_NOTIFY" name="Send updates, product enhancements or renewal notifications" />
    <bpmn:exclusiveGateway id="D_CANCEL" name="Customer decides to cancel?" />
    <bpmn:task id="T_CANCEL_REQ" name="Submit cancellation request" />
    <bpmn:task id="T_PROCESS_CANCEL" name="Process cancellation request" />
    <bpmn:task id="T_REFUND" name="Apply refunds or charges according to the terms" />
    <bpmn:task id="T_DEACTIVATE" name="Deactivate subscription" />
    <bpmn:task id="T_SETTLE" name="Settle final account balance" />
    <bpmn:endEvent id="END" name="Subscription concluded" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="T_ENTER" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_ENTER" targetRef="T_GENERATE" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_GENERATE" targetRef="T_ASSIGN" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_ASSIGN" targetRef="T_BILLING" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_BILLING" targetRef="M_RUNNING" />
    <bpmn:sequenceFlow id="F6" sourceRef="M_RUNNING" targetRef="T_NOTIFY" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_NOTIFY" targetRef="D_CANCEL" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="D_CANCEL" targetRef="T_CANCEL_REQ" />
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="D_CANCEL" targetRef="M_RUNNING" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_CANCEL_REQ" targetRef="T_PROCESS_CANCEL" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_PROCESS_CANCEL" targetRef="T_REFUND" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_REFUND" targetRef="T_DEACTIVATE" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_DEACTIVATE" targetRef="T_SETTLE" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_SETTLE" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
