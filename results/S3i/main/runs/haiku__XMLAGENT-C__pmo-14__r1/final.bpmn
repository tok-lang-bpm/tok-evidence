<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_DEPT" name="Department">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FIN" name="Finance department">
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_STK" name="Stakeholders">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Upcoming period objectives outlined" />
    <bpmn:task id="T1" name="Outline the objectives for the upcoming period" />
    <bpmn:task id="T2" name="Draft the plan with cost estimates and justifications" />
    <bpmn:task id="T3" name="Review the plan in a strategic alignment meeting" />
    <bpmn:exclusiveGateway id="M0" />
    <bpmn:task id="T4" name="Perform the detailed budget review" />
    <bpmn:exclusiveGateway id="G2" name="Adjustments needed?" />
    <bpmn:task id="T5" name="Adjust the plan based on feedback" />
    <bpmn:task id="T6" name="Document the adjustment" />
    <bpmn:task id="T7" name="Approve the adjustment" />
    <bpmn:task id="T8" name="Approve the final version of the budget" />
    <bpmn:task id="T9" name="Allocate the budget to the department" />
    <bpmn:task id="T10" name="Distribute the budget" />
    <bpmn:task id="T11" name="Implement the plan" />
    <bpmn:endEvent id="E1" name="Budget distributed and implementation begun" />
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="M0" />
    <bpmn:sequenceFlow id="F5" sourceRef="M0" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" name="Yes" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F9" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F10" sourceRef="T7" targetRef="M0" />
    <bpmn:sequenceFlow id="F11" name="No" sourceRef="G2" targetRef="T8" />
    <bpmn:sequenceFlow id="F12" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F14" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F15" sourceRef="T11" targetRef="E1" />
  </bpmn:process>
</bpmn:definitions>
