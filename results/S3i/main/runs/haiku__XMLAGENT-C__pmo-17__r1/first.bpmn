<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="E-commerce company" processRef="fulfillment-process" />
  </bpmn:collaboration>
  <bpmn:process id="fulfillment-process" isExecutable="false">
    <bpmn:laneSet id="fulfillment-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_issues</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="order-system" name="Order system">
        <bpmn:flowNodeRef>t_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_payfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inform_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_stock_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gP3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gP4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_returns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>t_receive_backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_giftwrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_gift_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gP2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive_returns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inspect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping department">
        <bpmn:flowNodeRef>t_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_intl_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_return_label</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="s_start" name="Order needed" />
    <bpmn:task id="t_place" name="Place order" />
    <bpmn:task id="t_record" name="Record order details" />
    <bpmn:task id="t_pay" name="Process payment" />
    <bpmn:exclusiveGateway id="g_pay" name="Payment successful?" />
    <bpmn:task id="t_notify_fail" name="Notify customer of payment failure" />
    <bpmn:endEvent id="e_payfail" name="Process ended, payment failed" />
    <bpmn:task id="t_check" name="Check stock availability" />
    <bpmn:exclusiveGateway id="g_stock" name="Items in stock?" />
    <bpmn:task id="t_backorder" name="Initiate back-order" />
    <bpmn:task id="t_inform_delay" name="Inform customer of delay" />
    <bpmn:task id="t_receive_backorder" name="Receive back-order" />
    <bpmn:exclusiveGateway id="g_stock_m" />
    <bpmn:task id="t_pick" name="Pick items from warehouse" />
    <bpmn:task id="t_qc" name="Perform quality control checks" />
    <bpmn:parallelGateway id="gP1" name="Split packing and shipping documents" />
    <bpmn:exclusiveGateway id="g_gift" name="Gift wrapping requested?" />
    <bpmn:task id="t_giftwrap" name="Gift wrap items" />
    <bpmn:exclusiveGateway id="g_gift_m" />
    <bpmn:task id="t_pack" name="Pack order" />
    <bpmn:task id="t_docs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="g_intl" name="International order?" />
    <bpmn:task id="t_customs" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="g_intl_m" />
    <bpmn:parallelGateway id="gP2" name="Join packing and shipping documents" />
    <bpmn:task id="t_dispatch" name="Dispatch order" />
    <bpmn:parallelGateway id="gP3" name="Split after dispatch" />
    <bpmn:task id="t_confirm" name="Send shipping confirmation to customer" />
    <bpmn:task id="t_inventory" name="Update inventory levels" />
    <bpmn:parallelGateway id="gP4" name="Join after dispatch" />
    <bpmn:task id="t_confirm_delivery" name="Confirm successful delivery" />
    <bpmn:exclusiveGateway id="g_issues" name="Issues reported upon delivery?" />
    <bpmn:task id="t_return_label" name="Send return shipping label" />
    <bpmn:task id="t_receive_returns" name="Receive returned items" />
    <bpmn:task id="t_inspect" name="Inspect returned items" />
    <bpmn:task id="t_refund" name="Process refund or replacement" />
    <bpmn:endEvent id="e_returns" name="Returns process completed" />
    <bpmn:task id="t_feedback" name="Send feedback follow-up email" />
    <bpmn:endEvent id="e_done" name="Order fulfilled" />

    <bpmn:sequenceFlow id="f1" sourceRef="s_start" targetRef="t_place" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_place" targetRef="t_record" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_record" targetRef="t_pay" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_pay" targetRef="g_pay" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="g_pay" targetRef="t_notify_fail" />
    <bpmn:sequenceFlow id="f6" name="Yes" sourceRef="g_pay" targetRef="t_check" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_notify_fail" targetRef="e_payfail" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_check" targetRef="g_stock" />
    <bpmn:sequenceFlow id="f9" name="Yes" sourceRef="g_stock" targetRef="g_stock_m" />
    <bpmn:sequenceFlow id="f10" name="No" sourceRef="g_stock" targetRef="t_backorder" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_backorder" targetRef="t_inform_delay" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_inform_delay" targetRef="t_receive_backorder" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_receive_backorder" targetRef="g_stock_m" />
    <bpmn:sequenceFlow id="f14" sourceRef="g_stock_m" targetRef="t_pick" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_pick" targetRef="t_qc" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_qc" targetRef="gP1" />
    <bpmn:sequenceFlow id="f17" sourceRef="gP1" targetRef="g_gift" />
    <bpmn:sequenceFlow id="f18" sourceRef="gP1" targetRef="t_docs" />
    <bpmn:sequenceFlow id="f19" name="Yes" sourceRef="g_gift" targetRef="t_giftwrap" />
    <bpmn:sequenceFlow id="f20" name="No" sourceRef="g_gift" targetRef="g_gift_m" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_giftwrap" targetRef="g_gift_m" />
    <bpmn:sequenceFlow id="f22" sourceRef="g_gift_m" targetRef="t_pack" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_docs" targetRef="g_intl" />
    <bpmn:sequenceFlow id="f24" name="Yes" sourceRef="g_intl" targetRef="t_customs" />
    <bpmn:sequenceFlow id="f25" name="No" sourceRef="g_intl" targetRef="g_intl_m" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_customs" targetRef="g_intl_m" />
    <bpmn:sequenceFlow id="f27" sourceRef="g_intl_m" targetRef="gP2" />
    <bpmn:sequenceFlow id="f28" sourceRef="t_pack" targetRef="gP2" />
    <bpmn:sequenceFlow id="f29" sourceRef="gP2" targetRef="t_dispatch" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_dispatch" targetRef="gP3" />
    <bpmn:sequenceFlow id="f31" sourceRef="gP3" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f32" sourceRef="gP3" targetRef="t_inventory" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_confirm" targetRef="gP4" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_inventory" targetRef="gP4" />
    <bpmn:sequenceFlow id="f35" sourceRef="gP4" targetRef="t_confirm_delivery" />
    <bpmn:sequenceFlow id="f36" sourceRef="t_confirm_delivery" targetRef="g_issues" />
    <bpmn:sequenceFlow id="f37" name="Yes" sourceRef="g_issues" targetRef="t_return_label" />
    <bpmn:sequenceFlow id="f38" name="No" sourceRef="g_issues" targetRef="t_feedback" />
    <bpmn:sequenceFlow id="f39" sourceRef="t_return_label" targetRef="t_receive_returns" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_receive_returns" targetRef="t_inspect" />
    <bpmn:sequenceFlow id="f41" sourceRef="t_inspect" targetRef="t_refund" />
    <bpmn:sequenceFlow id="f42" sourceRef="t_refund" targetRef="e_returns" />
    <bpmn:sequenceFlow id="f43" sourceRef="t_feedback" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>