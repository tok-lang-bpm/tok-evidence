<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="University" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_STUDENT" name="Student">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ADMISSIONS" name="Admissions Office">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COMMITTEE" name="Admissions Committee">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FINANCE" name="Finance Department">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_IT" name="IT Department">
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_INTERNATIONAL" name="International Student Office">
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ADVISOR" name="Academic Advisor">
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_UNIVERSITY" name="University">
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_APPEALS" name="Appeals Committee">
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="S0" name="Application process starts" />
    <bpmn:task id="T1" name="Submit the application online" />
    <bpmn:task id="T2" name="Review the application and supporting documents" />
    <bpmn:exclusiveGateway id="G1" name="Documents complete?" />
    <bpmn:task id="T3" name="Notify the applicant to provide the missing items" />
    <bpmn:task id="T4" name="Provide the missing items" />
    <bpmn:parallelGateway id="P1" name="Split" />
    <bpmn:task id="T5" name="Evaluate the application" />
    <bpmn:task id="T6" name="Process the application fees or waivers" />
    <bpmn:parallelGateway id="P2" name="Join" />
    <bpmn:exclusiveGateway id="G2" name="Application accepted?" />
    <bpmn:task id="T7" name="Send the rejection letter" />
    <bpmn:endEvent id="E1" name="Application rejected" />
    <bpmn:task id="T8" name="Send the acceptance letter" />
    <bpmn:task id="T9" name="Confirm enrollment by the deadline" />
    <bpmn:boundaryEvent id="B1" name="Deadline passed" attachedToRef="T9" cancelActivity="true">
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E2" name="Application canceled" />
    <bpmn:parallelGateway id="P3" name="Split" />
    <bpmn:task id="T10" name="Send the orientation materials" />
    <bpmn:task id="T11" name="Set up the student accounts for email, online portals and library access" />
    <bpmn:parallelGateway id="P4" name="Join" />
    <bpmn:exclusiveGateway id="G3" name="International student?" />
    <bpmn:task id="T12" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="M1" name="Merge" />
    <bpmn:task id="T13" name="Obtain the student ID card" />
    <bpmn:task id="T14" name="Meet with an academic advisor" />
    <bpmn:task id="T15" name="Select courses" />
    <bpmn:task id="T16" name="Resolve any schedule conflicts" />
    <bpmn:exclusiveGateway id="M0" name="Merge" />
    <bpmn:task id="T17" name="Attend classes" />
    <bpmn:exclusiveGateway id="G4" name="Add or drop courses?" />
    <bpmn:task id="T18" name="Add or drop courses within the add/drop period" />
    <bpmn:exclusiveGateway id="M2" name="Merge" />
    <bpmn:task id="T19" name="Post the grades" />
    <bpmn:task id="T20" name="Review the grades online" />
    <bpmn:exclusiveGateway id="G5" name="Grievance filed?" />
    <bpmn:task id="T21" name="Submit the appeal form" />
    <bpmn:task id="T22" name="Meet with the appeals committee" />
    <bpmn:task id="T23" name="Await the decision" />
    <bpmn:exclusiveGateway id="M3" name="Merge" />
    <bpmn:exclusiveGateway id="G6" name="Next step?" />
    <bpmn:endEvent id="E3" name="Student graduates" />
    <bpmn:endEvent id="E4" name="Student withdraws" />

    <bpmn:sequenceFlow id="F01" sourceRef="S0" targetRef="T1" />
    <bpmn:sequenceFlow id="F02" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F03" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F04" name="Yes" sourceRef="G1" targetRef="P1" />
    <bpmn:sequenceFlow id="F05" name="No" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F06" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F07" sourceRef="T4" targetRef="T2" />
    <bpmn:sequenceFlow id="F08" sourceRef="P1" targetRef="T5" />
    <bpmn:sequenceFlow id="F09" sourceRef="P1" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" sourceRef="T5" targetRef="P2" />
    <bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="P2" />
    <bpmn:sequenceFlow id="F12" sourceRef="P2" targetRef="G2" />
    <bpmn:sequenceFlow id="F13" name="Yes" sourceRef="G2" targetRef="T8" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="F15" sourceRef="T7" targetRef="E1" />
    <bpmn:sequenceFlow id="F16" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F17" sourceRef="T9" targetRef="P3" />
    <bpmn:sequenceFlow id="F18" sourceRef="B1" targetRef="E2" />
    <bpmn:sequenceFlow id="F19" sourceRef="P3" targetRef="T10" />
    <bpmn:sequenceFlow id="F20" sourceRef="P3" targetRef="T11" />
    <bpmn:sequenceFlow id="F21" sourceRef="T10" targetRef="P4" />
    <bpmn:sequenceFlow id="F22" sourceRef="T11" targetRef="P4" />
    <bpmn:sequenceFlow id="F23" sourceRef="P4" targetRef="G3" />
    <bpmn:sequenceFlow id="F24" name="Yes" sourceRef="G3" targetRef="T12" />
    <bpmn:sequenceFlow id="F25" name="No" sourceRef="G3" targetRef="M1" />
    <bpmn:sequenceFlow id="F26" sourceRef="T12" targetRef="M1" />
    <bpmn:sequenceFlow id="F27" sourceRef="M1" targetRef="T13" />
    <bpmn:sequenceFlow id="F28" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F29" sourceRef="T14" targetRef="T15" />
    <bpmn:sequenceFlow id="F30" sourceRef="T15" targetRef="T16" />
    <bpmn:sequenceFlow id="F31" sourceRef="T16" targetRef="M0" />
    <bpmn:sequenceFlow id="F32" sourceRef="M0" targetRef="T17" />
    <bpmn:sequenceFlow id="F33" sourceRef="T17" targetRef="G4" />
    <bpmn:sequenceFlow id="F34" name="Yes" sourceRef="G4" targetRef="T18" />
    <bpmn:sequenceFlow id="F35" name="No" sourceRef="G4" targetRef="M2" />
    <bpmn:sequenceFlow id="F36" sourceRef="T18" targetRef="M2" />
    <bpmn:sequenceFlow id="F37" sourceRef="M2" targetRef="T19" />
    <bpmn:sequenceFlow id="F38" sourceRef="T19" targetRef="T20" />
    <bpmn:sequenceFlow id="F39" sourceRef="T20" targetRef="G5" />
    <bpmn:sequenceFlow id="F40" name="Yes" sourceRef="G5" targetRef="T21" />
    <bpmn:sequenceFlow id="F41" name="No" sourceRef="G5" targetRef="M3" />
    <bpmn:sequenceFlow id="F42" sourceRef="T21" targetRef="T22" />
    <bpmn:sequenceFlow id="F43" sourceRef="T22" targetRef="T23" />
    <bpmn:sequenceFlow id="F44" sourceRef="T23" targetRef="M3" />
    <bpmn:sequenceFlow id="F45" sourceRef="M3" targetRef="G6" />
    <bpmn:sequenceFlow id="F46" name="Continue to next semester" sourceRef="G6" targetRef="M0" />
    <bpmn:sequenceFlow id="F47" name="Graduate" sourceRef="G6" targetRef="E3" />
    <bpmn:sequenceFlow id="F48" name="Withdraw" sourceRef="G6" targetRef="E4" />
  </bpmn:process>
</bpmn:definitions>
