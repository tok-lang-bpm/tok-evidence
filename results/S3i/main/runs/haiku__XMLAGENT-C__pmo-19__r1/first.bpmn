<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Online shop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="USER" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymentChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paidMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnedChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnItems</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SHOP" name="Online shop">
        <bpmn:flowNodeRef>deliverMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order started" />
    <bpmn:task id="login" name="Log in to account" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="select" name="Select items to purchase" />
    <bpmn:task id="reward" name="Choose free reward option" />
    <bpmn:task id="payMethod" name="Set payment method" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="paymentChoice" name="Payment method chosen?" />
    <bpmn:task id="pay" name="Pay for items" />
    <bpmn:task id="installment" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="paidMerge" />
    <bpmn:exclusiveGateway id="deliverMerge" />
    <bpmn:task id="deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="returnedChoice" name="Items returned for exchange?" />
    <bpmn:task id="returnItems" name="Return items for exchange" />
    <bpmn:endEvent id="end" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="fork" />
    <bpmn:sequenceFlow id="f3" sourceRef="fork" targetRef="select" />
    <bpmn:sequenceFlow id="f4" sourceRef="fork" targetRef="payMethod" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f6" sourceRef="reward" targetRef="join" />
    <bpmn:sequenceFlow id="f7" sourceRef="payMethod" targetRef="join" />
    <bpmn:sequenceFlow id="f8" sourceRef="join" targetRef="paymentChoice" />
    <bpmn:sequenceFlow id="f9" name="pay" sourceRef="paymentChoice" targetRef="pay" />
    <bpmn:sequenceFlow id="f10" name="installment" sourceRef="paymentChoice" targetRef="installment" />
    <bpmn:sequenceFlow id="f11" sourceRef="pay" targetRef="paidMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="installment" targetRef="paidMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="paidMerge" targetRef="deliverMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="deliverMerge" targetRef="deliver" />
    <bpmn:sequenceFlow id="f15" sourceRef="deliver" targetRef="returnedChoice" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="returnedChoice" targetRef="returnItems" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="returnedChoice" targetRef="end" />
    <bpmn:sequenceFlow id="f18" sourceRef="returnItems" targetRef="deliverMerge" />
  </bpmn:process>
</bpmn:definitions>