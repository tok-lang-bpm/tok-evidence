<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="SHIPPING" />
  </bpmn:collaboration>
  <bpmn:process id="SHIPPING" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="SECRETARY" name="Secretary">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>largeAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inviteCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normalPost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shippingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>writeLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LOGISTICS" name="Logistics department head">
        <bpmn:flowNodeRef>insuranceDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>takeInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insuranceMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WAREHOUSE" name="Warehousemen">
        <bpmn:flowNodeRef>packageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preparePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="largeAmounts" name="Large amounts?" />
    <bpmn:task id="inviteCompanies" name="Invite three logistic companies to make offers" />
    <bpmn:task id="selectCompany" name="Select one logistic company" />
    <bpmn:task id="normalPost" name="Use normal post shipment" />
    <bpmn:exclusiveGateway id="shippingMerge" />
    <bpmn:parallelGateway id="splitPrep" />
    <bpmn:task id="writeLabel" name="Write a package label" />
    <bpmn:task id="packageGoods" name="Package the goods" />
    <bpmn:exclusiveGateway id="insuranceDecision" name="Parcel insurance necessary?" />
    <bpmn:task id="takeInsurance" name="Take a parcel insurance" />
    <bpmn:exclusiveGateway id="insuranceMerge" />
    <bpmn:parallelGateway id="joinPrep" />
    <bpmn:task id="preparePickup" name="Prepare the packaged goods for pickup by the logistic company" />
    <bpmn:endEvent id="end" name="Goods ready for pickup" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="clarify" />
    <bpmn:sequenceFlow id="f2" sourceRef="clarify" targetRef="largeAmounts" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="largeAmounts" targetRef="inviteCompanies" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="largeAmounts" targetRef="normalPost" />
    <bpmn:sequenceFlow id="f5" sourceRef="inviteCompanies" targetRef="selectCompany" />
    <bpmn:sequenceFlow id="f6" sourceRef="selectCompany" targetRef="shippingMerge" />
    <bpmn:sequenceFlow id="f7" sourceRef="normalPost" targetRef="shippingMerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="shippingMerge" targetRef="splitPrep" />
    <bpmn:sequenceFlow id="f9" sourceRef="splitPrep" targetRef="writeLabel" />
    <bpmn:sequenceFlow id="f10" sourceRef="splitPrep" targetRef="packageGoods" />
    <bpmn:sequenceFlow id="f11" sourceRef="splitPrep" targetRef="insuranceDecision" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="insuranceDecision" targetRef="takeInsurance" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="insuranceDecision" targetRef="insuranceMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="takeInsurance" targetRef="insuranceMerge" />
    <bpmn:sequenceFlow id="f15" sourceRef="insuranceMerge" targetRef="joinPrep" />
    <bpmn:sequenceFlow id="f16" sourceRef="writeLabel" targetRef="joinPrep" />
    <bpmn:sequenceFlow id="f17" sourceRef="packageGoods" targetRef="joinPrep" />
    <bpmn:sequenceFlow id="f18" sourceRef="joinPrep" targetRef="preparePickup" />
    <bpmn:sequenceFlow id="f19" sourceRef="preparePickup" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>