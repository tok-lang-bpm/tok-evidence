<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Bank" processRef="credit-scoring" />
  </bpmn:collaboration>
  <bpmn:process id="credit-scoring" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CLERK" name="Sales clerk">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BANK" name="Banking system">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_AGENCY" name="Credit agency">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Credit scoring requested" />
    <bpmn:task id="T1" name="Request credit scoring" />
    <bpmn:task id="T2" name="Start the scoring process" />
    <bpmn:task id="T3" name="Send scoring request to agency" />
    <bpmn:task id="T4" name="Perform level 1 scoring" />
    <bpmn:exclusiveGateway id="G1" name="Immediate result?" />
    <bpmn:task id="T5" name="Return result to banking system" />
    <bpmn:task id="T8" name="Inform banking system of delay" />
    <bpmn:parallelGateway id="P1" />
    <bpmn:task id="T9" name="Perform level 2 scoring" />
    <bpmn:task id="T10" name="Return scoring result to banking system" />
    <bpmn:task id="T12" name="Display delay message to clerk" />
    <bpmn:task id="T13" name="Check the scoring result again later" />
    <bpmn:endEvent id="E2" name="Clerk asked to check again" />
    <bpmn:exclusiveGateway id="G2" name="Result received" />
    <bpmn:task id="T6" name="Present result to clerk" />
    <bpmn:task id="T7" name="View the scoring result at the frontend" />
    <bpmn:endEvent id="E1" name="Result viewed" />
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="G1" />
    <bpmn:sequenceFlow id="F6" name="yes" sourceRef="G1" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" name="no" sourceRef="G1" targetRef="T8" />
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="G2" />
    <bpmn:sequenceFlow id="F9" sourceRef="T8" targetRef="P1" />
    <bpmn:sequenceFlow id="F10" sourceRef="P1" targetRef="T9" />
    <bpmn:sequenceFlow id="F11" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F12" sourceRef="T10" targetRef="G2" />
    <bpmn:sequenceFlow id="F13" sourceRef="P1" targetRef="T12" />
    <bpmn:sequenceFlow id="F14" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="F15" sourceRef="T13" targetRef="E2" />
    <bpmn:sequenceFlow id="F16" sourceRef="G2" targetRef="T6" />
    <bpmn:sequenceFlow id="F17" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F18" sourceRef="T7" targetRef="E1" />
  </bpmn:process>
</bpmn:definitions>
