<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Restaurant" processRef="RESTAURANT" />
  </bpmn:collaboration>
  <bpmn:process id="RESTAURANT" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="GUEST" name="Guest">
        <bpmn:flowNodeRef>S_HUNGRY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ENTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CHOOSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_WAIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_BUZZER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HATCH_GO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PICKUP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_EAT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="EMPLOYEE" name="Employee">
        <bpmn:flowNodeRef>T_POS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_COLLECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SETUP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HANDOVER_BUZZER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_INFORM_CHEF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SETOFF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EB_WAIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TM_5MIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CALL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HANDOVER_MEAL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CHEF" name="Chef">
        <bpmn:flowNodeRef>T_PREPARE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PLACE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_INFORM_EMP</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_HUNGRY" name="Guest feels hungry" />
    <bpmn:task id="T_ENTER" name="Enter the restaurant" />
    <bpmn:task id="T_CHOOSE" name="Choose a dish from the meal range" />
    <bpmn:task id="T_WAIT" name="Wait until it is his turn" />
    <bpmn:task id="T_ORDER" name="Place the order with the employee" />
    <bpmn:task id="T_POS" name="Enter the order into the POS system" />
    <bpmn:task id="T_COLLECT" name="Collect the money from the guest" />
    <bpmn:task id="T_SETUP" name="Set up the buzzer" />
    <bpmn:task id="T_HANDOVER_BUZZER" name="Hand over the buzzer to the guest">
      <bpmn:documentation>When the buzzer rings, your dinner is ready</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="T_INFORM_CHEF" name="Inform the chef of the new meal order" />
    <bpmn:task id="T_PREPARE" name="Prepare the meal" />
    <bpmn:task id="T_PLACE" name="Place the meal in the service hatch" />
    <bpmn:task id="T_INFORM_EMP" name="Inform the employee that the meal is in the service hatch" />
    <bpmn:task id="T_SETOFF" name="Set off the guest's buzzer" />
    <bpmn:eventBasedGateway id="EB_WAIT" name="Buzzer rings or 5 minutes pass?" />
    <bpmn:intermediateCatchEvent id="E_BUZZER" name="Buzzer rings">
      <bpmn:messageEventDefinition id="MD_BUZZER" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TM_5MIN" name="5 minutes pass">
      <bpmn:timerEventDefinition id="TD_5MIN">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_CALL" name="Call the guest" />
    <bpmn:task id="T_HATCH_GO" name="Go to the service hatch" />
    <bpmn:task id="T_HANDOVER_MEAL" name="Hand over the meal to the guest" />
    <bpmn:task id="T_PICKUP" name="Pick up the meal" />
    <bpmn:task id="T_EAT" name="Eat the meal" />
    <bpmn:endEvent id="END_EAT" name="Meal eaten" />
    <bpmn:sequenceFlow id="F1" sourceRef="S_HUNGRY" targetRef="T_ENTER" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_ENTER" targetRef="T_CHOOSE" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_CHOOSE" targetRef="T_WAIT" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_WAIT" targetRef="T_ORDER" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_ORDER" targetRef="T_POS" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_POS" targetRef="T_COLLECT" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_COLLECT" targetRef="T_SETUP" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_SETUP" targetRef="T_HANDOVER_BUZZER" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_HANDOVER_BUZZER" targetRef="T_INFORM_CHEF" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_INFORM_CHEF" targetRef="T_PREPARE" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_PREPARE" targetRef="T_PLACE" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_PLACE" targetRef="T_INFORM_EMP" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_INFORM_EMP" targetRef="T_SETOFF" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_SETOFF" targetRef="EB_WAIT" />
    <bpmn:sequenceFlow id="F15" sourceRef="EB_WAIT" targetRef="E_BUZZER" />
    <bpmn:sequenceFlow id="F16" sourceRef="EB_WAIT" targetRef="TM_5MIN" />
    <bpmn:sequenceFlow id="F17" sourceRef="TM_5MIN" targetRef="T_CALL" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_CALL" targetRef="EB_WAIT" />
    <bpmn:sequenceFlow id="F19" sourceRef="E_BUZZER" targetRef="T_HATCH_GO" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_HATCH_GO" targetRef="T_HANDOVER_MEAL" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_HANDOVER_MEAL" targetRef="T_PICKUP" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_PICKUP" targetRef="T_EAT" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_EAT" targetRef="END_EAT" />
  </bpmn:process>
</bpmn:definitions>