<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Find a Job" processRef="FIND_JOB" />
  </bpmn:collaboration>
  <bpmn:process id="FIND_JOB" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="APPLICANT" name="Job applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_applications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rated_c_or_less</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_search_over</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="COMPANY" name="Company">
        <bpmn:flowNodeRef>confirm_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wants_to_hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate_applicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PLATFORM" name="Job platform">
        <bpmn:flowNodeRef>send_offers_potential</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>one_year_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show_reviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offers_continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reviews_published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_offers_continue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start job search" />
    <bpmn:task id="write_application" name="Write a job application" />
    <bpmn:task id="report_applications" name="Report the companies you applied to" />
    <bpmn:task id="send_offers_potential" name="Send potential job offers" />
    <bpmn:task id="confirm_receipt" name="Confirm receipt of the application" />
    <bpmn:task id="rate_application" name="Rate the application" />
    <bpmn:task id="negotiate_interview" name="Negotiate a job interview" />
    <bpmn:exclusiveGateway id="wants_to_hire" name="Company wants you to work for them?" />
    <bpmn:task id="enter_probation" name="Enter the probation phase" />
    <bpmn:parallelGateway id="split_rating" name="Split rating" />
    <bpmn:task id="rate_company" name="Rate the company" />
    <bpmn:task id="rate_applicant" name="Rate the job applicant" />
    <bpmn:parallelGateway id="join_rating" name="Join rating" />
    <bpmn:parallelGateway id="split_review" name="Split review" />
    <bpmn:intermediateCatchEvent id="one_year_timer" name="One year later">
      <bpmn:timerEventDefinition id="timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="show_reviews" name="Show company reviews to job applicants" />
    <bpmn:endEvent id="end_reviews_published" name="Reviews published" />
    <bpmn:exclusiveGateway id="permanent_gateway" name="Job becomes permanent?" />
    <bpmn:exclusiveGateway id="rated_c_or_less" name="Rated company C or less?" />
    <bpmn:task id="send_offers_continue" name="Send job offers" />
    <bpmn:endEvent id="end_offers_continue" name="Job offers continue without reporting" />
    <bpmn:endEvent id="end_search_over" name="Job search over" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="write_application" />
    <bpmn:sequenceFlow id="f2" sourceRef="write_application" targetRef="report_applications" />
    <bpmn:sequenceFlow id="f3" sourceRef="report_applications" targetRef="send_offers_potential" />
    <bpmn:sequenceFlow id="f4" sourceRef="send_offers_potential" targetRef="confirm_receipt" />
    <bpmn:sequenceFlow id="f5" sourceRef="confirm_receipt" targetRef="rate_application" />
    <bpmn:sequenceFlow id="f6" sourceRef="rate_application" targetRef="negotiate_interview" />
    <bpmn:sequenceFlow id="f7" sourceRef="negotiate_interview" targetRef="wants_to_hire" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="wants_to_hire" targetRef="enter_probation" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="wants_to_hire" targetRef="report_applications" />
    <bpmn:sequenceFlow id="f10" sourceRef="enter_probation" targetRef="split_rating" />
    <bpmn:sequenceFlow id="f11" sourceRef="split_rating" targetRef="rate_company" />
    <bpmn:sequenceFlow id="f12" sourceRef="split_rating" targetRef="rate_applicant" />
    <bpmn:sequenceFlow id="f13" sourceRef="rate_company" targetRef="join_rating" />
    <bpmn:sequenceFlow id="f14" sourceRef="rate_applicant" targetRef="join_rating" />
    <bpmn:sequenceFlow id="f15" sourceRef="join_rating" targetRef="split_review" />
    <bpmn:sequenceFlow id="f16" sourceRef="split_review" targetRef="one_year_timer" />
    <bpmn:sequenceFlow id="f17" sourceRef="one_year_timer" targetRef="show_reviews" />
    <bpmn:sequenceFlow id="f18" sourceRef="show_reviews" targetRef="end_reviews_published" />
    <bpmn:sequenceFlow id="f19" sourceRef="split_review" targetRef="permanent_gateway" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="permanent_gateway" targetRef="rated_c_or_less" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="permanent_gateway" targetRef="report_applications" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="rated_c_or_less" targetRef="send_offers_continue" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="rated_c_or_less" targetRef="end_search_over" />
    <bpmn:sequenceFlow id="f24" sourceRef="send_offers_continue" targetRef="end_offers_continue" />
  </bpmn:process>
</bpmn:definitions>