<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="PARENT" name="Parent">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FETCH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SELECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>COLLECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOTIFY_SS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOTIFY_COMPANY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DECIDE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EXTEND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SOCIAL_SECURITY" name="Social Security">
        <bpmn:flowNodeRef>GATHER</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Plan maternity leave" />
    <bpmn:task id="FETCH" name="Fetch information about leave models" />
    <bpmn:task id="SELECT" name="Select leave model" />
    <bpmn:task id="COLLECT" name="Collect relevant information" />
    <bpmn:parallelGateway id="SPLIT" />
    <bpmn:task id="NOTIFY_SS" name="Notify Social Security in time" />
    <bpmn:task id="NOTIFY_COMPANY" name="Notify company in time" />
    <bpmn:parallelGateway id="JOIN" />
    <bpmn:task id="GATHER" name="Gather information from companies" />
    <bpmn:task id="DECIDE" name="Decide about extension" />
    <bpmn:exclusiveGateway id="EXTEND" name="Extend leave?" />
    <bpmn:endEvent id="END" name="Maternity leave ends" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="FETCH" />
    <bpmn:sequenceFlow id="F2" sourceRef="FETCH" targetRef="SELECT" />
    <bpmn:sequenceFlow id="F3" sourceRef="SELECT" targetRef="COLLECT" />
    <bpmn:sequenceFlow id="F4" sourceRef="COLLECT" targetRef="SPLIT" />
    <bpmn:sequenceFlow id="F5" sourceRef="SPLIT" targetRef="NOTIFY_SS" />
    <bpmn:sequenceFlow id="F6" sourceRef="SPLIT" targetRef="NOTIFY_COMPANY" />
    <bpmn:sequenceFlow id="F7" sourceRef="NOTIFY_SS" targetRef="JOIN" />
    <bpmn:sequenceFlow id="F8" sourceRef="NOTIFY_COMPANY" targetRef="JOIN" />
    <bpmn:sequenceFlow id="F9" sourceRef="JOIN" targetRef="GATHER" />
    <bpmn:sequenceFlow id="F10" sourceRef="GATHER" targetRef="DECIDE" />
    <bpmn:sequenceFlow id="F11" sourceRef="DECIDE" targetRef="EXTEND" />
    <bpmn:sequenceFlow id="F12" name="yes" sourceRef="EXTEND" targetRef="FETCH" />
    <bpmn:sequenceFlow id="F13" name="no" sourceRef="EXTEND" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
