<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Work Accident Reporting" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_PERSON" name="Insured person">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_EMPLOYER" name="Employer">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SCHOOL" name="School or university">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Accident or near miss occurs" />
    <bpmn:task id="T1" name="Inform the employer immediately" />
    <bpmn:exclusiveGateway id="G1" name="Work accident or near miss?" />
    <bpmn:task id="T2" name="Record the near miss" />
    <bpmn:endEvent id="E1" name="Near miss recorded" />
    <bpmn:exclusiveGateway id="G7" name="Fatality or serious injury?" />
    <bpmn:exclusiveGateway id="G8" name="Reported to emergency services?" />
    <bpmn:task id="T6" name="Report the accident to the Labour Inspectorate immediately" />
    <bpmn:exclusiveGateway id="M1" />
    <bpmn:exclusiveGateway id="G2" name="Insured as student or schoolchild?" />
    <bpmn:task id="T3" name="Report the accident to the competent directorate" />
    <bpmn:task id="T4" name="Report the accident in triplicate to the accident insurance provider within five days" />
    <bpmn:endEvent id="E2" name="Accident reported to directorate and insurance provider" />
    <bpmn:exclusiveGateway id="G3" name="Killed or unable to work for three days?" />
    <bpmn:task id="T5" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:endEvent id="E3" name="Accident reported to insurance provider" />
    <bpmn:endEvent id="E4" name="Accident recorded" />
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="Near miss" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" sourceRef="T2" targetRef="E1" />
    <bpmn:sequenceFlow id="F5" name="Work accident" sourceRef="G1" targetRef="G7" />
    <bpmn:sequenceFlow id="F6" name="Yes" sourceRef="G7" targetRef="G8" />
    <bpmn:sequenceFlow id="F7" name="No" sourceRef="G7" targetRef="M1" />
    <bpmn:sequenceFlow id="F8" name="Yes" sourceRef="G8" targetRef="M1" />
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="G8" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" sourceRef="T6" targetRef="M1" />
    <bpmn:sequenceFlow id="F11" sourceRef="M1" targetRef="G2" />
    <bpmn:sequenceFlow id="F12" name="Yes" sourceRef="G2" targetRef="T3" />
    <bpmn:sequenceFlow id="F13" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F14" sourceRef="T4" targetRef="E2" />
    <bpmn:sequenceFlow id="F15" name="No" sourceRef="G2" targetRef="G3" />
    <bpmn:sequenceFlow id="F16" name="Yes" sourceRef="G3" targetRef="T5" />
    <bpmn:sequenceFlow id="F17" sourceRef="T5" targetRef="E3" />
    <bpmn:sequenceFlow id="F18" name="No" sourceRef="G3" targetRef="E4" />
  </bpmn:process>
</bpmn:definitions>