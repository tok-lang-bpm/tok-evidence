<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Internship" processRef="INTERNSHIP" />
  </bpmn:collaboration>
  <bpmn:process id="INTERNSHIP" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="STUDENT" name="Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_experience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="COMPANY" name="Company">
        <bpmn:flowNodeRef>offer_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invalidate_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>company_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_company_updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_updates</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Internship search started" />
    <bpmn:task id="enter_topic" name="Enter topic and desired salary" />
    <bpmn:task id="enter_experience" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="offer_merge" name="Offer pending" />
    <bpmn:task id="send_offer" name="Send internship offer" />
    <bpmn:task id="review_offer" name="Review the offer" />
    <bpmn:exclusiveGateway id="decide_offer" name="Offer accepted?" />
    <bpmn:task id="accept_offer" name="Accept the offer" />
    <bpmn:task id="deny_offer" name="Deny the offer" />
    <bpmn:task id="invalidate_offers" name="Invalidate all other offers" />
    <bpmn:parallelGateway id="split_updates" />
    <bpmn:task id="write_update" name="Write status update about the internship" />
    <bpmn:exclusiveGateway id="check_updates" name="Three updates written?" />
    <bpmn:task id="company_update" name="Write status update about the student" />
    <bpmn:exclusiveGateway id="check_company_updates" name="Three updates written?" />
    <bpmn:parallelGateway id="join_updates" />
    <bpmn:task id="recommend" name="Recommend the company to friends" />
    <bpmn:task id="tweet" name="Send recommendation tweet to a friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="end" name="Internship finished" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter_topic" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter_topic" targetRef="enter_experience" />
    <bpmn:sequenceFlow id="f3" sourceRef="enter_experience" targetRef="offer_merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="offer_merge" targetRef="send_offer" />
    <bpmn:sequenceFlow id="f5" sourceRef="send_offer" targetRef="review_offer" />
    <bpmn:sequenceFlow id="f6" sourceRef="review_offer" targetRef="decide_offer" />
    <bpmn:sequenceFlow id="f7" name="accepted" sourceRef="decide_offer" targetRef="accept_offer" />
    <bpmn:sequenceFlow id="f8" name="denied" sourceRef="decide_offer" targetRef="deny_offer" />
    <bpmn:sequenceFlow id="f9" sourceRef="deny_offer" targetRef="offer_merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="accept_offer" targetRef="invalidate_offers" />
    <bpmn:sequenceFlow id="f11" sourceRef="invalidate_offers" targetRef="split_updates" />
    <bpmn:sequenceFlow id="f12" sourceRef="split_updates" targetRef="write_update" />
    <bpmn:sequenceFlow id="f13" sourceRef="split_updates" targetRef="company_update" />
    <bpmn:sequenceFlow id="f14" sourceRef="write_update" targetRef="check_updates" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="check_updates" targetRef="write_update" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="check_updates" targetRef="join_updates" />
    <bpmn:sequenceFlow id="f17" sourceRef="company_update" targetRef="check_company_updates" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="check_company_updates" targetRef="company_update" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="check_company_updates" targetRef="join_updates" />
    <bpmn:sequenceFlow id="f20" sourceRef="join_updates" targetRef="recommend" />
    <bpmn:sequenceFlow id="f21" sourceRef="recommend" targetRef="tweet" />
    <bpmn:sequenceFlow id="f22" sourceRef="tweet" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>