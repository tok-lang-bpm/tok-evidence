<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="LAN Party Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="HOST" name="Host">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_INVITATIONS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIND_GAMES_WANTED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DATE_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>APPOINT_DATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DATE_AGREED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CHECK_OWNED_GAMES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GAMES_MISSING</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DOWNLOAD_GAMES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GAMES_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIND_BEER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ENOUGH_BEER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUY_BEER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BEER_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ENJOY_PARTY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="LAN party planning started" />
    <bpmn:task id="SEND_INVITATIONS" name="Send invitations to the 10 friends" />
    <bpmn:task id="FIND_GAMES_WANTED" name="Find out which games the friends want to play" />
    <bpmn:parallelGateway id="SPLIT" />
    <bpmn:exclusiveGateway id="DATE_MERGE" />
    <bpmn:task id="APPOINT_DATE" name="Appoint a date for the LAN party" />
    <bpmn:exclusiveGateway id="DATE_AGREED" name="8 or more people agree on the date?" />
    <bpmn:task id="CHECK_OWNED_GAMES" name="Check if you have all the games the guests want" />
    <bpmn:exclusiveGateway id="GAMES_MISSING" name="Games missing?" />
    <bpmn:task id="DOWNLOAD_GAMES" name="Download the missing games" />
    <bpmn:exclusiveGateway id="GAMES_MERGE" />
    <bpmn:parallelGateway id="JOIN" />
    <bpmn:task id="FIND_BEER" name="Find out how much beer the friends will require" />
    <bpmn:exclusiveGateway id="ENOUGH_BEER" name="Enough beer?" />
    <bpmn:task id="BUY_BEER" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="BEER_MERGE" />
    <bpmn:task id="ENJOY_PARTY" name="Enjoy the LAN party" />
    <bpmn:endEvent id="END" name="LAN party finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="SEND_INVITATIONS" />
    <bpmn:sequenceFlow id="F2" sourceRef="SEND_INVITATIONS" targetRef="FIND_GAMES_WANTED" />
    <bpmn:sequenceFlow id="F3" sourceRef="FIND_GAMES_WANTED" targetRef="SPLIT" />
    <bpmn:sequenceFlow id="F4" sourceRef="SPLIT" targetRef="DATE_MERGE" />
    <bpmn:sequenceFlow id="F5" sourceRef="SPLIT" targetRef="CHECK_OWNED_GAMES" />
    <bpmn:sequenceFlow id="F6" sourceRef="DATE_MERGE" targetRef="APPOINT_DATE" />
    <bpmn:sequenceFlow id="F7" sourceRef="APPOINT_DATE" targetRef="DATE_AGREED" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="DATE_AGREED" targetRef="JOIN" />
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="DATE_AGREED" targetRef="DATE_MERGE" />
    <bpmn:sequenceFlow id="F10" sourceRef="CHECK_OWNED_GAMES" targetRef="GAMES_MISSING" />
    <bpmn:sequenceFlow id="F11" name="yes" sourceRef="GAMES_MISSING" targetRef="DOWNLOAD_GAMES" />
    <bpmn:sequenceFlow id="F12" name="no" sourceRef="GAMES_MISSING" targetRef="GAMES_MERGE" />
    <bpmn:sequenceFlow id="F13" sourceRef="DOWNLOAD_GAMES" targetRef="GAMES_MERGE" />
    <bpmn:sequenceFlow id="F14" sourceRef="GAMES_MERGE" targetRef="JOIN" />
    <bpmn:sequenceFlow id="F15" sourceRef="JOIN" targetRef="FIND_BEER" />
    <bpmn:sequenceFlow id="F16" sourceRef="FIND_BEER" targetRef="ENOUGH_BEER" />
    <bpmn:sequenceFlow id="F17" name="yes" sourceRef="ENOUGH_BEER" targetRef="BEER_MERGE" />
    <bpmn:sequenceFlow id="F18" name="no" sourceRef="ENOUGH_BEER" targetRef="BUY_BEER" />
    <bpmn:sequenceFlow id="F19" sourceRef="BUY_BEER" targetRef="BEER_MERGE" />
    <bpmn:sequenceFlow id="F20" sourceRef="BEER_MERGE" targetRef="ENJOY_PARTY" />
    <bpmn:sequenceFlow id="F21" sourceRef="ENJOY_PARTY" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>