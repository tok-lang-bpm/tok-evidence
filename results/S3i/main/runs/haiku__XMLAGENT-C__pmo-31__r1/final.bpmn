<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="expansionMsg" name="Expansion released" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Blizzard" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="PLAYER" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>click_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_realm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_name</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SYSTEM" name="Blizzard System">
        <bpmn:flowNodeRef>check_bnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bnet_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bnet_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>name_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_expansion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Character creation started" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="task_names" name="Come up with good character names" />
    <bpmn:task id="check_bnet" name="Check whether a battle.net account exists" />
    <bpmn:exclusiveGateway id="bnet_q" name="Battle.net account?" />
    <bpmn:task id="enter_account" name="Enter the account information" />
    <bpmn:task id="click_link" name="Click the confirmation link" />
    <bpmn:exclusiveGateway id="bnet_merge" />
    <bpmn:task id="check_sub" name="Check the active WoW subscription" />
    <bpmn:exclusiveGateway id="sub_q" name="Active WoW subscription?" />
    <bpmn:task id="select_pay" name="Select the payment method" />
    <bpmn:exclusiveGateway id="pay_q" name="Payment method?" />
    <bpmn:task id="enter_cc" name="Enter the credit card information" />
    <bpmn:task id="enter_iban" name="Enter the IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="pay_merge" />
    <bpmn:exclusiveGateway id="sub_merge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="select_realm" name="Select realm, race and class" />
    <bpmn:task id="enter_name" name="Enter a character name" />
    <bpmn:task id="check_name" name="Check whether the name is available" />
    <bpmn:exclusiveGateway id="name_q" name="Name available?" />
    <bpmn:task id="send_confirm" name="Send the confirmation and the selfies" />
    <bpmn:intermediateCatchEvent id="expansion" name="Expansion released">
      <bpmn:messageEventDefinition messageRef="expansionMsg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="send_expansion" name="Send the expansion message" />
    <bpmn:endEvent id="end" name="Character created" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fork" />
    <bpmn:sequenceFlow id="f2" sourceRef="fork" targetRef="task_names" />
    <bpmn:sequenceFlow id="f3" sourceRef="fork" targetRef="check_bnet" />
    <bpmn:sequenceFlow id="f4" sourceRef="check_bnet" targetRef="bnet_q" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="bnet_q" targetRef="enter_account" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="bnet_q" targetRef="bnet_merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="enter_account" targetRef="click_link" />
    <bpmn:sequenceFlow id="f8" sourceRef="click_link" targetRef="bnet_merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="bnet_merge" targetRef="check_sub" />
    <bpmn:sequenceFlow id="f10" sourceRef="check_sub" targetRef="sub_q" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="sub_q" targetRef="select_pay" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="sub_q" targetRef="sub_merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="select_pay" targetRef="pay_q" />
    <bpmn:sequenceFlow id="f14" name="credit card" sourceRef="pay_q" targetRef="enter_cc" />
    <bpmn:sequenceFlow id="f15" name="bank account" sourceRef="pay_q" targetRef="enter_iban" />
    <bpmn:sequenceFlow id="f16" sourceRef="enter_cc" targetRef="pay_merge" />
    <bpmn:sequenceFlow id="f17" sourceRef="enter_iban" targetRef="pay_merge" />
    <bpmn:sequenceFlow id="f18" sourceRef="pay_merge" targetRef="sub_merge" />
    <bpmn:sequenceFlow id="f19" sourceRef="sub_merge" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="task_names" targetRef="join" />
    <bpmn:sequenceFlow id="f21" sourceRef="join" targetRef="login" />
    <bpmn:sequenceFlow id="f22" sourceRef="login" targetRef="select_realm" />
    <bpmn:sequenceFlow id="f23" sourceRef="select_realm" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f24" sourceRef="enter_name" targetRef="check_name" />
    <bpmn:sequenceFlow id="f25" sourceRef="check_name" targetRef="name_q" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="name_q" targetRef="enter_name" />
    <bpmn:sequenceFlow id="f27" name="yes" sourceRef="name_q" targetRef="send_confirm" />
    <bpmn:sequenceFlow id="f28" sourceRef="send_confirm" targetRef="expansion" />
    <bpmn:sequenceFlow id="f29" sourceRef="expansion" targetRef="send_expansion" />
    <bpmn:sequenceFlow id="f30" sourceRef="send_expansion" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
