<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Farming Bot Service" processRef="FARMING_BOT" />
  </bpmn:collaboration>
  <bpmn:process id="FARMING_BOT" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="PLAYER" name="Player">
        <bpmn:flowNodeRef>wanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setUrgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>defineDeps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1J</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BOT" name="Farming Bot">
        <bpmn:flowNodeRef>startFarm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="wanted" name="Farming bot wanted" />
    <bpmn:task id="selectRes" name="Select the resources to farm" />
    <bpmn:parallelGateway id="P1" name="Split preferences" />
    <bpmn:task id="setUrgency" name="Set the urgency of each resource" />
    <bpmn:task id="defineDeps" name="Define the tool dependencies" />
    <bpmn:parallelGateway id="P1J" name="Preferences collected" />
    <bpmn:task id="startFarm" name="Start farming" />
    <bpmn:parallelGateway id="P2" name="Farming and updates" />
    <bpmn:exclusiveGateway id="M1" />
    <bpmn:task id="gather" name="Gather up to 10 resources in parallel" />
    <bpmn:exclusiveGateway id="X1" name="Disaster strikes?" />
    <bpmn:task id="recover" name="Recover the bot from the disaster" />
    <bpmn:exclusiveGateway id="M2" />
    <bpmn:exclusiveGateway id="X2" name="Milestone reached?" />
    <bpmn:task id="notify" name="Notify the player of the milestone" />
    <bpmn:exclusiveGateway id="M3" />
    <bpmn:exclusiveGateway id="X4" name="Farming finished?" />
    <bpmn:exclusiveGateway id="M4" />
    <bpmn:task id="updateList" name="Update the list of materials to farm" />
    <bpmn:exclusiveGateway id="X5" name="Stop updating?" />
    <bpmn:parallelGateway id="J2" name="Bot finished" />
    <bpmn:inclusiveGateway id="I1" name="Brag and/or send materials?" />
    <bpmn:task id="brag" name="Brag to selected friends" />
    <bpmn:task id="sendMat" name="Send materials to selected friends" />
    <bpmn:inclusiveGateway id="I2" />
    <bpmn:endEvent id="done" name="Farming bot done" />

    <bpmn:sequenceFlow id="f1" sourceRef="wanted" targetRef="selectRes" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectRes" targetRef="P1" />
    <bpmn:sequenceFlow id="f3" sourceRef="P1" targetRef="setUrgency" />
    <bpmn:sequenceFlow id="f4" sourceRef="P1" targetRef="defineDeps" />
    <bpmn:sequenceFlow id="f5" sourceRef="setUrgency" targetRef="P1J" />
    <bpmn:sequenceFlow id="f6" sourceRef="defineDeps" targetRef="P1J" />
    <bpmn:sequenceFlow id="f7" sourceRef="P1J" targetRef="startFarm" />
    <bpmn:sequenceFlow id="f8" sourceRef="startFarm" targetRef="P2" />
    <bpmn:sequenceFlow id="f9" sourceRef="P2" targetRef="M1" />
    <bpmn:sequenceFlow id="f10" sourceRef="P2" targetRef="M4" />
    <bpmn:sequenceFlow id="f11" sourceRef="M1" targetRef="gather" />
    <bpmn:sequenceFlow id="f12" sourceRef="gather" targetRef="X1" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="X1" targetRef="recover" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="X1" targetRef="M2" />
    <bpmn:sequenceFlow id="f15" sourceRef="recover" targetRef="M2" />
    <bpmn:sequenceFlow id="f16" sourceRef="M2" targetRef="X2" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="X2" targetRef="notify" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="X2" targetRef="M3" />
    <bpmn:sequenceFlow id="f19" sourceRef="notify" targetRef="M3" />
    <bpmn:sequenceFlow id="f20" sourceRef="M3" targetRef="X4" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="X4" targetRef="J2" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="X4" targetRef="M1" />
    <bpmn:sequenceFlow id="f23" sourceRef="M4" targetRef="updateList" />
    <bpmn:sequenceFlow id="f24" sourceRef="updateList" targetRef="X5" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="X5" targetRef="J2" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="X5" targetRef="M4" />
    <bpmn:sequenceFlow id="f27" sourceRef="J2" targetRef="I1" />
    <bpmn:sequenceFlow id="f28" name="brag" sourceRef="I1" targetRef="brag" />
    <bpmn:sequenceFlow id="f29" name="send" sourceRef="I1" targetRef="sendMat" />
    <bpmn:sequenceFlow id="f30" sourceRef="brag" targetRef="I2" />
    <bpmn:sequenceFlow id="f31" sourceRef="sendMat" targetRef="I2" />
    <bpmn:sequenceFlow id="f32" sourceRef="I2" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>