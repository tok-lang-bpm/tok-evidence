<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="3D Model Creation and Printing" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_INSTRUCT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3_SKETCHES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4_CHANGES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_SATISFIED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5_CHOOSE_COLOR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_IN_STOCK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6_CHECK_LEFT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3_UNDER_100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7_SHOPPING_LIST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9_ORDER_PLASTIC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4_HAVE_PLASTIC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10_PRINTER_ON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_FORK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13_GCODE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14_PRINT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ARTIST" name="Artist">
        <bpmn:flowNodeRef>T2_CREATE_PROJECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15_SEND_STL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PRINTER" name="3D Printer">
        <bpmn:flowNodeRef>T11_HEAT_UP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12_STATUS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="START" name="Craving a custom 3D model" />
    <bpmn:task id="T1_INSTRUCT" name="Instruct an artist to create a project" />
    <bpmn:task id="T2_CREATE_PROJECT" name="Create the 3D model project" />
    <bpmn:task id="T3_SKETCHES" name="Send several sketches to the artist" />
    <bpmn:task id="T4_CHANGES" name="Tell the artist what to change" />
    <bpmn:exclusiveGateway id="G1_SATISFIED" name="Satisfied with the result?" />
    <bpmn:task id="T15_SEND_STL" name="Send the STL file to the customer" />
    <bpmn:task id="T5_CHOOSE_COLOR" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="G2_IN_STOCK" name="Color in stock?" />
    <bpmn:task id="T6_CHECK_LEFT" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="G3_UNDER_100" name="Under 100 grams?" />
    <bpmn:task id="T7_SHOPPING_LIST" name="Put the plastic on the shopping list" />
    <bpmn:task id="T9_ORDER_PLASTIC" name="Order the plastic" />
    <bpmn:exclusiveGateway id="G4_HAVE_PLASTIC" name="Have the plastic" />
    <bpmn:task id="T10_PRINTER_ON" name="Turn the printer on" />
    <bpmn:parallelGateway id="P1_FORK" name="" />
    <bpmn:task id="T11_HEAT_UP" name="Heat up the bed and the extruder" />
    <bpmn:task id="T12_STATUS" name="Send the printer status back" />
    <bpmn:task id="T13_GCODE" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="P2_JOIN" name="" />
    <bpmn:task id="T14_PRINT" name="Print the model" />
    <bpmn:endEvent id="END" name="Model printed" />

    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="T1_INSTRUCT" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1_INSTRUCT" targetRef="T2_CREATE_PROJECT" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2_CREATE_PROJECT" targetRef="T3_SKETCHES" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3_SKETCHES" targetRef="T4_CHANGES" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4_CHANGES" targetRef="G1_SATISFIED" />
    <bpmn:sequenceFlow id="F6" name="yes" sourceRef="G1_SATISFIED" targetRef="T15_SEND_STL" />
    <bpmn:sequenceFlow id="F7" name="no" sourceRef="G1_SATISFIED" targetRef="T4_CHANGES" />
    <bpmn:sequenceFlow id="F8" sourceRef="T15_SEND_STL" targetRef="T5_CHOOSE_COLOR" />
    <bpmn:sequenceFlow id="F9" sourceRef="T5_CHOOSE_COLOR" targetRef="G2_IN_STOCK" />
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="G2_IN_STOCK" targetRef="T6_CHECK_LEFT" />
    <bpmn:sequenceFlow id="F11" name="no" sourceRef="G2_IN_STOCK" targetRef="T9_ORDER_PLASTIC" />
    <bpmn:sequenceFlow id="F12" sourceRef="T6_CHECK_LEFT" targetRef="G3_UNDER_100" />
    <bpmn:sequenceFlow id="F13" name="yes" sourceRef="G3_UNDER_100" targetRef="T7_SHOPPING_LIST" />
    <bpmn:sequenceFlow id="F14" name="no" sourceRef="G3_UNDER_100" targetRef="G4_HAVE_PLASTIC" />
    <bpmn:sequenceFlow id="F15" sourceRef="T7_SHOPPING_LIST" targetRef="G4_HAVE_PLASTIC" />
    <bpmn:sequenceFlow id="F16" sourceRef="T9_ORDER_PLASTIC" targetRef="G4_HAVE_PLASTIC" />
    <bpmn:sequenceFlow id="F17" sourceRef="G4_HAVE_PLASTIC" targetRef="T10_PRINTER_ON" />
    <bpmn:sequenceFlow id="F18" sourceRef="T10_PRINTER_ON" targetRef="P1_FORK" />
    <bpmn:sequenceFlow id="F19" sourceRef="P1_FORK" targetRef="T11_HEAT_UP" />
    <bpmn:sequenceFlow id="F20" sourceRef="P1_FORK" targetRef="T12_STATUS" />
    <bpmn:sequenceFlow id="F21" sourceRef="P1_FORK" targetRef="T13_GCODE" />
    <bpmn:sequenceFlow id="F22" sourceRef="T11_HEAT_UP" targetRef="P2_JOIN" />
    <bpmn:sequenceFlow id="F23" sourceRef="T12_STATUS" targetRef="P2_JOIN" />
    <bpmn:sequenceFlow id="F24" sourceRef="T13_GCODE" targetRef="P2_JOIN" />
    <bpmn:sequenceFlow id="F25" sourceRef="P2_JOIN" targetRef="T14_PRINT" />
    <bpmn:sequenceFlow id="F26" sourceRef="T14_PRINT" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
