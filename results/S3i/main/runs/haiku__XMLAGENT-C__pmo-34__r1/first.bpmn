<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Lego machine builder" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="BUILDER" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>emptyGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moreGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CHILDREN" name="Group of children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Machine building started" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order the Lego brick sets" />
    <bpmn:task id="sort" name="Sort the parts into containers" />
    <bpmn:task id="build" name="Build the subcomponent" />
    <bpmn:exclusiveGateway id="emptyGw" name="Container empty?" />
    <bpmn:task id="reorder" name="Reorder the individual parts" />
    <bpmn:task id="test" name="Test the subcomponent" />
    <bpmn:exclusiveGateway id="testGw" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign and rebuild the subcomponent" />
    <bpmn:task id="assemble" name="Assemble the subcomponent" />
    <bpmn:exclusiveGateway id="moreGw" name="More subcomponents?" />
    <bpmn:endEvent id="end" name="Machine built" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="design" />
    <bpmn:sequenceFlow id="f2" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f3" sourceRef="order" targetRef="sort" />
    <bpmn:sequenceFlow id="f4" sourceRef="sort" targetRef="build" />
    <bpmn:sequenceFlow id="f5" sourceRef="build" targetRef="emptyGw" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="emptyGw" targetRef="reorder" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="emptyGw" targetRef="test" />
    <bpmn:sequenceFlow id="f8" sourceRef="reorder" targetRef="build" />
    <bpmn:sequenceFlow id="f9" sourceRef="test" targetRef="testGw" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="testGw" targetRef="assemble" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="testGw" targetRef="redesign" />
    <bpmn:sequenceFlow id="f12" sourceRef="redesign" targetRef="build" />
    <bpmn:sequenceFlow id="f13" sourceRef="assemble" targetRef="moreGw" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="moreGw" targetRef="build" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="moreGw" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>