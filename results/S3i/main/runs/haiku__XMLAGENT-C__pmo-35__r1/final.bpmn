<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Chainsaw workshop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_WORKSHOP" name="Workshop">
        <bpmn:flowNodeRef>orderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forkProd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinProd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order" name="Order placed" />
    <bpmn:task id="specify" name="Specify the chainsaw properties" />
    <bpmn:task id="orderParts" name="Order the parts from various online sources">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:task id="receive" name="Receive the parts" />
    <bpmn:task id="inspect" name="Inspect all parts manually" />
    <bpmn:parallelGateway id="forkProd" />
    <bpmn:task id="assemble" name="Assemble the parts" />
    <bpmn:task id="update" name="Send a production update to the customer" />
    <bpmn:parallelGateway id="joinProd" />
    <bpmn:task id="sendFirst" name="Send the first saw to the customer" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes the saw?" />
    <bpmn:task id="produceRest" name="Produce the rest of the order" />
    <bpmn:endEvent id="endNo" name="Order ended" />
    <bpmn:endEvent id="endDone" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="order" targetRef="specify" />
    <bpmn:sequenceFlow id="f2" sourceRef="specify" targetRef="orderParts" />
    <bpmn:sequenceFlow id="f3" sourceRef="orderParts" targetRef="receive" />
    <bpmn:sequenceFlow id="f4" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f5" sourceRef="inspect" targetRef="forkProd" />
    <bpmn:sequenceFlow id="f6" sourceRef="forkProd" targetRef="assemble" />
    <bpmn:sequenceFlow id="f7" sourceRef="forkProd" targetRef="update" />
    <bpmn:sequenceFlow id="f8" sourceRef="assemble" targetRef="joinProd" />
    <bpmn:sequenceFlow id="f9" sourceRef="update" targetRef="joinProd" />
    <bpmn:sequenceFlow id="f10" sourceRef="joinProd" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f11" sourceRef="sendFirst" targetRef="likes" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="likes" targetRef="produceRest" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="likes" targetRef="endNo" />
    <bpmn:sequenceFlow id="f14" sourceRef="produceRest" targetRef="endDone" />
  </bpmn:process>
</bpmn:definitions>
