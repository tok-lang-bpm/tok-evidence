<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Airplane Producer" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PRODUCER" name="Airplane Producer">
        <bpmn:flowNodeRef>receive_spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test_flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_RUSSIA" name="Russian Team">
        <bpmn:flowNodeRef>make_vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_IRELAND" name="Irish Team">
        <bpmn:flowNodeRef>make_whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_OTHER" name="Other Part Teams">
        <bpmn:flowNodeRef>make_other</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Configuration started" />
    <bpmn:task id="specify" name="Specify the interior options" />
    <bpmn:task id="receive_spec" name="Receive the specifications" />
    <bpmn:task id="send_req" name="Send the requirements to the teams" />
    <bpmn:parallelGateway id="fork" name="Split requirements" />
    <bpmn:task id="make_vodka" name="Manufacture the vodka bar" />
    <bpmn:task id="make_whiskey" name="Manufacture the whiskey bar" />
    <bpmn:task id="make_other" name="Manufacture the other bars and interior parts" />
    <bpmn:parallelGateway id="join" name="Parts complete" />
    <bpmn:task id="receive_parts" name="Receive the individual parts" />
    <bpmn:task id="assemble" name="Assemble the interior" />
    <bpmn:task id="test_flight" name="Conduct the test flight" />
    <bpmn:task id="protocol" name="Create the test protocol" />
    <bpmn:task id="send_protocol" name="Send the test protocol to the customer" />
    <bpmn:task id="deliver" name="Deliver the plane to the customer" />
    <bpmn:task id="confirm" name="Confirm the delivery" />
    <bpmn:endEvent id="end" name="Plane delivered and confirmed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="specify" />
    <bpmn:sequenceFlow id="f2" sourceRef="specify" targetRef="receive_spec" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive_spec" targetRef="send_req" />
    <bpmn:sequenceFlow id="f4" sourceRef="send_req" targetRef="fork" />
    <bpmn:sequenceFlow id="f5" sourceRef="fork" targetRef="make_vodka" />
    <bpmn:sequenceFlow id="f6" sourceRef="fork" targetRef="make_whiskey" />
    <bpmn:sequenceFlow id="f7" sourceRef="fork" targetRef="make_other" />
    <bpmn:sequenceFlow id="f8" sourceRef="make_vodka" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="make_whiskey" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="make_other" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="join" targetRef="receive_parts" />
    <bpmn:sequenceFlow id="f12" sourceRef="receive_parts" targetRef="assemble" />
    <bpmn:sequenceFlow id="f13" sourceRef="assemble" targetRef="test_flight" />
    <bpmn:sequenceFlow id="f14" sourceRef="test_flight" targetRef="protocol" />
    <bpmn:sequenceFlow id="f15" sourceRef="protocol" targetRef="send_protocol" />
    <bpmn:sequenceFlow id="f16" sourceRef="send_protocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f17" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f18" sourceRef="confirm" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
