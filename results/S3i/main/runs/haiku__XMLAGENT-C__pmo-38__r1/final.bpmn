<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Tree house project" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="OWNER" name="You (house owner)">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ARCHITECT" name="Tree house architect">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="STORES" name="Online stores">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FRIENDS" name="Friends">
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Want to build a tree house" />
    <bpmn:task id="T1" name="Collect the requirements" />
    <bpmn:task id="T2" name="Send the requirements to the architect" />
    <bpmn:task id="T3" name="Create the draft" />
    <bpmn:task id="T4" name="Send the draft back to you" />
    <bpmn:exclusiveGateway id="M1" name="Draft received" />
    <bpmn:task id="T5" name="Refine the draft with additional requirements" />
    <bpmn:exclusiveGateway id="G1" name="Plan final?" />
    <bpmn:task id="T6" name="Send the additional requirements to the architect" />
    <bpmn:task id="T7" name="Create the revised draft" />
    <bpmn:task id="T8" name="Create the list of needed materials" />
    <bpmn:task id="T9" name="Order the materials from several online stores" />
    <bpmn:parallelGateway id="P1" name="Order placed" />
    <bpmn:task id="T10" name="Process the order" />
    <bpmn:task id="T11" name="Send messages to friends to build the house" />
    <bpmn:task id="T12" name="Build the house" />
    <bpmn:parallelGateway id="P2" name="Order processed and house built" />
    <bpmn:task id="T13" name="Send invitations to the tree house party" />
    <bpmn:task id="T14" name="Create the list of people attending the party" />
    <bpmn:task id="T15" name="Buy the snacks for the party" />
    <bpmn:endEvent id="END" name="Party prepared" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="M1" />
    <bpmn:sequenceFlow id="F6" sourceRef="M1" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="G1" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="G1" targetRef="T8" />
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="G1" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F11" sourceRef="T7" targetRef="M1" />
    <bpmn:sequenceFlow id="F12" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="P1" />
    <bpmn:sequenceFlow id="F14" sourceRef="P1" targetRef="T10" />
    <bpmn:sequenceFlow id="F15" sourceRef="P1" targetRef="T11" />
    <bpmn:sequenceFlow id="F16" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="F17" sourceRef="T10" targetRef="P2" />
    <bpmn:sequenceFlow id="F18" sourceRef="T12" targetRef="P2" />
    <bpmn:sequenceFlow id="F19" sourceRef="P2" targetRef="T13" />
    <bpmn:sequenceFlow id="F20" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F21" sourceRef="T14" targetRef="T15" />
    <bpmn:sequenceFlow id="F22" sourceRef="T15" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
