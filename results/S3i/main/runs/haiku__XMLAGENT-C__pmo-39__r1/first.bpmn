<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="DIY Smartphone Repair" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ENTER_MODEL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IDENTIFY_OWNED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FRIEND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONTACT_FRIENDS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MERGE_FRIENDS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BUY_REST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REPAIR_SCREEN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_WORKED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_REVIEW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_TO_EXPERT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_REPAIRED</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TOOL" name="Online Tool">
        <bpmn:flowNodeRef>LIST_MATERIALS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PROVIDE_INSTRUCTIONS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FRIEND" name="Friend">
        <bpmn:flowNodeRef>LEND_OR_SELL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_EXPERT" name="Expert">
        <bpmn:flowNodeRef>EXPERT_REPAIR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_EXPERT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Start DIY repair" />
    <bpmn:task id="ENTER_MODEL" name="Enter the phone model and the damage" />
    <bpmn:task id="LIST_MATERIALS" name="Provide the list of materials, tools and ordering choices" />
    <bpmn:task id="IDENTIFY_OWNED" name="Identify the items already owned" />
    <bpmn:exclusiveGateway id="GW_FRIEND" name="Friend can lend or sell cheaply?" />
    <bpmn:task id="CONTACT_FRIENDS" name="Contact friends" />
    <bpmn:task id="LEND_OR_SELL" name="Lend or sell the item cheaply" />
    <bpmn:exclusiveGateway id="GW_MERGE_FRIENDS" />
    <bpmn:task id="BUY_REST" name="Buy the remaining items" />
    <bpmn:task id="PROVIDE_INSTRUCTIONS" name="Provide repair instructions" />
    <bpmn:task id="REPAIR_SCREEN" name="Repair the screen" />
    <bpmn:exclusiveGateway id="GW_WORKED" name="Repair worked?" />
    <bpmn:task id="SEND_REVIEW" name="Send a review and/or video of the repair" />
    <bpmn:task id="SEND_TO_EXPERT" name="Send the phone to an expert" />
    <bpmn:task id="EXPERT_REPAIR" name="Repair the phone" />
    <bpmn:endEvent id="END_REPAIRED" name="Phone repaired" />
    <bpmn:endEvent id="END_EXPERT" name="Phone repaired by expert" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="ENTER_MODEL" />
    <bpmn:sequenceFlow id="F2" sourceRef="ENTER_MODEL" targetRef="LIST_MATERIALS" />
    <bpmn:sequenceFlow id="F3" sourceRef="LIST_MATERIALS" targetRef="IDENTIFY_OWNED" />
    <bpmn:sequenceFlow id="F4" sourceRef="IDENTIFY_OWNED" targetRef="GW_FRIEND" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="GW_FRIEND" targetRef="CONTACT_FRIENDS" />
    <bpmn:sequenceFlow id="F6" name="no" sourceRef="GW_FRIEND" targetRef="GW_MERGE_FRIENDS" />
    <bpmn:sequenceFlow id="F7" sourceRef="CONTACT_FRIENDS" targetRef="LEND_OR_SELL" />
    <bpmn:sequenceFlow id="F8" sourceRef="LEND_OR_SELL" targetRef="GW_MERGE_FRIENDS" />
    <bpmn:sequenceFlow id="F9" sourceRef="GW_MERGE_FRIENDS" targetRef="BUY_REST" />
    <bpmn:sequenceFlow id="F10" sourceRef="BUY_REST" targetRef="PROVIDE_INSTRUCTIONS" />
    <bpmn:sequenceFlow id="F11" sourceRef="PROVIDE_INSTRUCTIONS" targetRef="REPAIR_SCREEN" />
    <bpmn:sequenceFlow id="F12" sourceRef="REPAIR_SCREEN" targetRef="GW_WORKED" />
    <bpmn:sequenceFlow id="F13" name="yes" sourceRef="GW_WORKED" targetRef="SEND_REVIEW" />
    <bpmn:sequenceFlow id="F14" name="no" sourceRef="GW_WORKED" targetRef="SEND_TO_EXPERT" />
    <bpmn:sequenceFlow id="F15" sourceRef="SEND_REVIEW" targetRef="END_REPAIRED" />
    <bpmn:sequenceFlow id="F16" sourceRef="SEND_TO_EXPERT" targetRef="EXPERT_REPAIR" />
    <bpmn:sequenceFlow id="F17" sourceRef="EXPERT_REPAIR" targetRef="END_EXPERT" />
  </bpmn:process>
</bpmn:definitions>