<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Energy Drink Bottling" processRef="INSPECTION" />
  </bpmn:collaboration>
  <bpmn:process id="INSPECTION" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_INSPECTOR" name="Inspector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askadd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_APP" name="Inspection application">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Inspection requested" />
    <bpmn:task id="enter" name="Enter the machine type and serial number" />
    <bpmn:task id="ask" name="Ask the questions" />
    <bpmn:task id="input" name="Input the values" />
    <bpmn:task id="press" name="Press the buttons" />
    <bpmn:task id="collect" name="Collect the values from the machine" />
    <bpmn:task id="show" name="Show the values to the inspector" />
    <bpmn:exclusiveGateway id="addq" name="Additional questions needed?" />
    <bpmn:task id="askadd" name="Ask the additional questions" />
    <bpmn:exclusiveGateway id="merge" name="Questions finished?" />
    <bpmn:endEvent id="end" name="Inspection completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter" targetRef="ask" />
    <bpmn:sequenceFlow id="f3" sourceRef="ask" targetRef="input" />
    <bpmn:sequenceFlow id="f4" sourceRef="input" targetRef="press" />
    <bpmn:sequenceFlow id="f5" sourceRef="press" targetRef="collect" />
    <bpmn:sequenceFlow id="f6" sourceRef="collect" targetRef="show" />
    <bpmn:sequenceFlow id="f7" sourceRef="show" targetRef="addq" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="addq" targetRef="askadd" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="addq" targetRef="merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="askadd" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="merge" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>