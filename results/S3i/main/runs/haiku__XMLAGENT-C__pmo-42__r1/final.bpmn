<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Fridge Service" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doneEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ratedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central Fridge Service Center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Local Service Facility">
        <bpmn:flowNodeRef>appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repairedGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Fridge makes strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send the symptoms and the fridge type" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:task id="appointment" name="Make an appointment" />
    <bpmn:task id="arrive" name="Arrive at a random time" />
    <bpmn:exclusiveGateway id="repairedGateway" name="Fridge repaired?" />
    <bpmn:task id="repair" name="Repair the fridge" />
    <bpmn:task id="leave" name="Leave without repairing the fridge" />
    <bpmn:task id="order" name="Order the additional parts" />
    <bpmn:task id="confirm" name="Confirm the fridge is OK again" />
    <bpmn:exclusiveGateway id="rateGateway" name="Rate the service facility?" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:endEvent id="doneEnd" name="Service completed" />
    <bpmn:endEvent id="ratedEnd" name="Service rated" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="describe" />
    <bpmn:sequenceFlow id="f2" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f3" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f4" sourceRef="select" targetRef="appointment" />
    <bpmn:sequenceFlow id="f5" sourceRef="appointment" targetRef="arrive" />
    <bpmn:sequenceFlow id="f6" sourceRef="arrive" targetRef="repairedGateway" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="repairedGateway" targetRef="repair" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="repairedGateway" targetRef="leave" />
    <bpmn:sequenceFlow id="f9" sourceRef="leave" targetRef="order" />
    <bpmn:sequenceFlow id="f10" sourceRef="order" targetRef="appointment" />
    <bpmn:sequenceFlow id="f11" sourceRef="repair" targetRef="confirm" />
    <bpmn:sequenceFlow id="f12" sourceRef="confirm" targetRef="rateGateway" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="rateGateway" targetRef="rate" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="rateGateway" targetRef="doneEnd" />
    <bpmn:sequenceFlow id="f15" sourceRef="rate" targetRef="ratedEnd" />
  </bpmn:process>
</bpmn:definitions>
