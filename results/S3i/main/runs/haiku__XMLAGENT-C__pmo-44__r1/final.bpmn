<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Robotic Burger Seller near the University of Vienna" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="ROBOT" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinBurger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CONVEYOR" name="Conveyor belt">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order placed" />
    <bpmn:task id="receive" name="Receive the order" />
    <bpmn:task id="askMenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="gwMenu" name="Menu or just burger?" />
    <bpmn:parallelGateway id="splitDrink" />
    <bpmn:task id="drink" name="Prepare the drink" />
    <bpmn:task id="askSide" name="Ask whether the customer wants fries or wedges" />
    <bpmn:parallelGateway id="joinDrink" />
    <bpmn:exclusiveGateway id="gwSide" name="Fries or wedges?" />
    <bpmn:task id="fries" name="Prepare the fries" />
    <bpmn:task id="wedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="mergeSide" />
    <bpmn:exclusiveGateway id="mergeMenu" />
    <bpmn:parallelGateway id="splitBurger" />
    <bpmn:task id="burger" name="Prepare the burger" />
    <bpmn:task id="status" name="Give status updates every 30 seconds" />
    <bpmn:parallelGateway id="joinBurger" />
    <bpmn:task id="deliver" name="Deliver the order via conveyor belt" />
    <bpmn:endEvent id="end" name="Order delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="askMenu" />
    <bpmn:sequenceFlow id="f3" sourceRef="askMenu" targetRef="gwMenu" />
    <bpmn:sequenceFlow id="f4" name="Menu" sourceRef="gwMenu" targetRef="splitDrink" />
    <bpmn:sequenceFlow id="f5" name="Just burger" sourceRef="gwMenu" targetRef="mergeMenu" />
    <bpmn:sequenceFlow id="f6" sourceRef="splitDrink" targetRef="drink" />
    <bpmn:sequenceFlow id="f7" sourceRef="splitDrink" targetRef="askSide" />
    <bpmn:sequenceFlow id="f8" sourceRef="drink" targetRef="joinDrink" />
    <bpmn:sequenceFlow id="f9" sourceRef="askSide" targetRef="joinDrink" />
    <bpmn:sequenceFlow id="f10" sourceRef="joinDrink" targetRef="gwSide" />
    <bpmn:sequenceFlow id="f11" name="Fries" sourceRef="gwSide" targetRef="fries" />
    <bpmn:sequenceFlow id="f12" name="Wedges" sourceRef="gwSide" targetRef="wedges" />
    <bpmn:sequenceFlow id="f13" sourceRef="fries" targetRef="mergeSide" />
    <bpmn:sequenceFlow id="f14" sourceRef="wedges" targetRef="mergeSide" />
    <bpmn:sequenceFlow id="f15" sourceRef="mergeSide" targetRef="mergeMenu" />
    <bpmn:sequenceFlow id="f16" sourceRef="mergeMenu" targetRef="splitBurger" />
    <bpmn:sequenceFlow id="f17" sourceRef="splitBurger" targetRef="burger" />
    <bpmn:sequenceFlow id="f18" sourceRef="splitBurger" targetRef="status" />
    <bpmn:sequenceFlow id="f19" sourceRef="burger" targetRef="joinBurger" />
    <bpmn:sequenceFlow id="f20" sourceRef="status" targetRef="joinBurger" />
    <bpmn:sequenceFlow id="f21" sourceRef="joinBurger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f22" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
