<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Sports Institute" processRef="USI_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="USI_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_APPLICANT" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>checkSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>showCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issueTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTicket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_INSTITUTE" name="Sports Institute Staff">
        <bpmn:flowNodeRef>respondActivation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Course registration needed" />
    <bpmn:task id="selectCourse" name="Select a course" />
    <bpmn:task id="checkSlots" name="Check whether slots are free" />
    <bpmn:exclusiveGateway id="gwSlots" name="Slots free?" />
    <bpmn:task id="showCourses" name="Show the courses and dates" />
    <bpmn:endEvent id="endFull" name="Course fully booked" />
    <bpmn:task id="selectDate" name="Select a course date" />
    <bpmn:task id="checkAccount" name="Check whether you have an account" />
    <bpmn:exclusiveGateway id="gwAccount" name="Have an account?" />
    <bpmn:task id="checkUniversity" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="gwUniversity" name="Registered at an eligible university?" />
    <bpmn:task id="registerAccount" name="Register your account" />
    <bpmn:task id="requestActivation" name="Request an activation" />
    <bpmn:task id="respondActivation" name="Respond to the activation request" />
    <bpmn:exclusiveGateway id="mergeAccount" />
    <bpmn:task id="login" name="Log into your account" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="completeRegistration" name="Complete the course registration and provide payment information" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="issueTicket" name="Issue the course ticket" />
    <bpmn:endEvent id="endTicket" name="Course ticket received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selectCourse" />
    <bpmn:sequenceFlow id="f2" sourceRef="selectCourse" targetRef="checkSlots" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkSlots" targetRef="gwSlots" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="gwSlots" targetRef="showCourses" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="gwSlots" targetRef="endFull" />
    <bpmn:sequenceFlow id="f6" sourceRef="showCourses" targetRef="selectDate" />
    <bpmn:sequenceFlow id="f7" sourceRef="selectDate" targetRef="checkAccount" />
    <bpmn:sequenceFlow id="f8" sourceRef="checkAccount" targetRef="gwAccount" />
    <bpmn:sequenceFlow id="f9" name="Yes" sourceRef="gwAccount" targetRef="mergeAccount" />
    <bpmn:sequenceFlow id="f10" name="No" sourceRef="gwAccount" targetRef="checkUniversity" />
    <bpmn:sequenceFlow id="f11" sourceRef="checkUniversity" targetRef="gwUniversity" />
    <bpmn:sequenceFlow id="f12" name="Yes" sourceRef="gwUniversity" targetRef="registerAccount" />
    <bpmn:sequenceFlow id="f13" name="No" sourceRef="gwUniversity" targetRef="requestActivation" />
    <bpmn:sequenceFlow id="f14" sourceRef="registerAccount" targetRef="mergeAccount" />
    <bpmn:sequenceFlow id="f15" sourceRef="requestActivation" targetRef="respondActivation" />
    <bpmn:sequenceFlow id="f16" sourceRef="respondActivation" targetRef="mergeAccount" />
    <bpmn:sequenceFlow id="f17" sourceRef="mergeAccount" targetRef="login" />
    <bpmn:sequenceFlow id="f18" sourceRef="login" targetRef="fork" />
    <bpmn:sequenceFlow id="f19" sourceRef="fork" targetRef="tweet" />
    <bpmn:sequenceFlow id="f20" sourceRef="fork" targetRef="completeRegistration" />
    <bpmn:sequenceFlow id="f21" sourceRef="tweet" targetRef="join" />
    <bpmn:sequenceFlow id="f22" sourceRef="completeRegistration" targetRef="join" />
    <bpmn:sequenceFlow id="f23" sourceRef="join" targetRef="issueTicket" />
    <bpmn:sequenceFlow id="f24" sourceRef="issueTicket" targetRef="endTicket" />
  </bpmn:process>
</bpmn:definitions>