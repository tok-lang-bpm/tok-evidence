<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Vienna Night Run Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="RUNNER" name="Runner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkDay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hourGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leaveWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>runNight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="APP" name="App">
        <bpmn:flowNodeRef>enterTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>goalGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GADGET" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measureFinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Want to participate in the Vienna Night Run" />
    <bpmn:task id="selBlock" name="Select a starting block" />
    <bpmn:exclusiveGateway id="merge1" name="Join before running" />
    <bpmn:task id="run5" name="Run 5 km" />
    <bpmn:task id="measure" name="Measure the 5 km time" />
    <bpmn:task id="enterTime" name="Enter the 5 km time into the app" />
    <bpmn:exclusiveGateway id="goalGate" name="Under 25 minutes?" />
    <bpmn:task id="train" name="Train" />
    <bpmn:task id="getNumber" name="Get the starting number" />
    <bpmn:task id="checkDay" name="Check when the work day ends" />
    <bpmn:exclusiveGateway id="hourGate" name="More than one hour left?" />
    <bpmn:task id="goHome" name="Go to the Night Run from home" />
    <bpmn:task id="leaveWork" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="merge2" name="Join before the Night Run" />
    <bpmn:parallelGateway id="split" name="Start running and drinking" />
    <bpmn:task id="runNight" name="Run the Night Run" />
    <bpmn:task id="drink" name="Drink while running" />
    <bpmn:parallelGateway id="join" name="Running and drinking done" />
    <bpmn:task id="measureFinal" name="Measure the final running time" />
    <bpmn:task id="receiveTime" name="Receive the final running time" />
    <bpmn:endEvent id="end" name="Final running time received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="selBlock" />
    <bpmn:sequenceFlow id="f2" sourceRef="selBlock" targetRef="merge1" />
    <bpmn:sequenceFlow id="f3" sourceRef="merge1" targetRef="run5" />
    <bpmn:sequenceFlow id="f4" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f5" sourceRef="measure" targetRef="enterTime" />
    <bpmn:sequenceFlow id="f6" sourceRef="enterTime" targetRef="goalGate" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="goalGate" targetRef="getNumber" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="goalGate" targetRef="train" />
    <bpmn:sequenceFlow id="f9" sourceRef="train" targetRef="merge1" />
    <bpmn:sequenceFlow id="f10" sourceRef="getNumber" targetRef="checkDay" />
    <bpmn:sequenceFlow id="f11" sourceRef="checkDay" targetRef="hourGate" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="hourGate" targetRef="goHome" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="hourGate" targetRef="leaveWork" />
    <bpmn:sequenceFlow id="f14" sourceRef="goHome" targetRef="merge2" />
    <bpmn:sequenceFlow id="f15" sourceRef="leaveWork" targetRef="merge2" />
    <bpmn:sequenceFlow id="f16" sourceRef="merge2" targetRef="split" />
    <bpmn:sequenceFlow id="f17" sourceRef="split" targetRef="runNight" />
    <bpmn:sequenceFlow id="f18" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f19" sourceRef="runNight" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f21" sourceRef="join" targetRef="measureFinal" />
    <bpmn:sequenceFlow id="f22" sourceRef="measureFinal" targetRef="receiveTime" />
    <bpmn:sequenceFlow id="f23" sourceRef="receiveTime" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>