<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="DOCTOR" name="Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cleanArea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gelProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coverProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterileGel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anatId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doppId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloodGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeSyringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installWire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeTrocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>axisSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkLong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkShort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>axisMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wireGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>removeGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verifyFlow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Procedure starts" />
    <bpmn:task id="prep" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="clothes" name="Put on sterile clothes" />
    <bpmn:task id="cleanArea" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="config" name="Configure the ultrasound" />
    <bpmn:task id="gelProbe" name="Put gel in the probe" />
    <bpmn:task id="coverProbe" name="Cover the probe" />
    <bpmn:task id="sterileGel" name="Put the sterile gel" />
    <bpmn:task id="posProbe" name="Position the probe" />
    <bpmn:task id="posPatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="veinSplit" name="Vein identification method?" />
    <bpmn:task id="anatId" name="Identify the vein anatomically" />
    <bpmn:task id="doppId" name="Identify the vein using doppler" />
    <bpmn:task id="compId" name="Identify the vein using compression" />
    <bpmn:exclusiveGateway id="veinMerge" />
    <bpmn:exclusiveGateway id="pMerge" />
    <bpmn:task id="anesth" name="Anesthetize the patient" />
    <bpmn:task id="puncture" name="Puncture the vein" />
    <bpmn:exclusiveGateway id="bloodGw" name="Blood return correct?" />
    <bpmn:task id="dropProbe" name="Drop the probe" />
    <bpmn:task id="removeSyringe" name="Remove the syringe" />
    <bpmn:task id="installWire" name="Install the guidewire" />
    <bpmn:task id="removeTrocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="axisSplit" name="Wire check method?" />
    <bpmn:task id="checkLong" name="Check the wire in the long axis" />
    <bpmn:task id="checkShort" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="axisMerge" />
    <bpmn:exclusiveGateway id="wireGw" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="removeGuide" name="Remove the guidewire" />
    <bpmn:task id="verifyFlow" name="Verify the flow and the reflow" />
    <bpmn:task id="checkCath" name="Check the catheter position" />
    <bpmn:endEvent id="end" name="Catheter placed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="prep" />
    <bpmn:sequenceFlow id="f2" sourceRef="prep" targetRef="wash" />
    <bpmn:sequenceFlow id="f3" sourceRef="wash" targetRef="clothes" />
    <bpmn:sequenceFlow id="f4" sourceRef="clothes" targetRef="cleanArea" />
    <bpmn:sequenceFlow id="f5" sourceRef="cleanArea" targetRef="drape" />
    <bpmn:sequenceFlow id="f6" sourceRef="drape" targetRef="config" />
    <bpmn:sequenceFlow id="f7" sourceRef="config" targetRef="gelProbe" />
    <bpmn:sequenceFlow id="f8" sourceRef="gelProbe" targetRef="coverProbe" />
    <bpmn:sequenceFlow id="f9" sourceRef="coverProbe" targetRef="sterileGel" />
    <bpmn:sequenceFlow id="f10" sourceRef="sterileGel" targetRef="posProbe" />
    <bpmn:sequenceFlow id="f11" sourceRef="posProbe" targetRef="posPatient" />
    <bpmn:sequenceFlow id="f12" sourceRef="posPatient" targetRef="veinSplit" />
    <bpmn:sequenceFlow id="f13" name="anatomic" sourceRef="veinSplit" targetRef="anatId" />
    <bpmn:sequenceFlow id="f14" name="doppler" sourceRef="veinSplit" targetRef="doppId" />
    <bpmn:sequenceFlow id="f15" name="compression" sourceRef="veinSplit" targetRef="compId" />
    <bpmn:sequenceFlow id="f16" sourceRef="anatId" targetRef="veinMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="doppId" targetRef="veinMerge" />
    <bpmn:sequenceFlow id="f18" sourceRef="compId" targetRef="veinMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="veinMerge" targetRef="pMerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="pMerge" targetRef="anesth" />
    <bpmn:sequenceFlow id="f21" sourceRef="anesth" targetRef="puncture" />
    <bpmn:sequenceFlow id="f22" sourceRef="puncture" targetRef="bloodGw" />
    <bpmn:sequenceFlow id="f23" name="No" sourceRef="bloodGw" targetRef="pMerge" />
    <bpmn:sequenceFlow id="f24" name="Yes" sourceRef="bloodGw" targetRef="dropProbe" />
    <bpmn:sequenceFlow id="f25" sourceRef="dropProbe" targetRef="removeSyringe" />
    <bpmn:sequenceFlow id="f26" sourceRef="removeSyringe" targetRef="installWire" />
    <bpmn:sequenceFlow id="f27" sourceRef="installWire" targetRef="removeTrocar" />
    <bpmn:sequenceFlow id="f28" sourceRef="removeTrocar" targetRef="axisSplit" />
    <bpmn:sequenceFlow id="f29" name="long axis" sourceRef="axisSplit" targetRef="checkLong" />
    <bpmn:sequenceFlow id="f30" name="short axis" sourceRef="axisSplit" targetRef="checkShort" />
    <bpmn:sequenceFlow id="f31" sourceRef="checkLong" targetRef="axisMerge" />
    <bpmn:sequenceFlow id="f32" sourceRef="checkShort" targetRef="axisMerge" />
    <bpmn:sequenceFlow id="f33" sourceRef="axisMerge" targetRef="wireGw" />
    <bpmn:sequenceFlow id="f34" name="No" sourceRef="wireGw" targetRef="pMerge" />
    <bpmn:sequenceFlow id="f35" name="Yes" sourceRef="wireGw" targetRef="widen" />
    <bpmn:sequenceFlow id="f36" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f37" sourceRef="advance" targetRef="removeGuide" />
    <bpmn:sequenceFlow id="f38" sourceRef="removeGuide" targetRef="verifyFlow" />
    <bpmn:sequenceFlow id="f39" sourceRef="verifyFlow" targetRef="checkCath" />
    <bpmn:sequenceFlow id="f40" sourceRef="checkCath" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>