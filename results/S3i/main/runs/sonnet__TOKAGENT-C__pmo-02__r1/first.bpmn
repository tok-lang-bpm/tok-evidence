<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Hiring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Hiring" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR">
        <bpmn:flowNodeRef>jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obdone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new hire identified" />
    <bpmn:task id="jd" name="Create a job description" />
    <bpmn:task id="post" name="Post the job on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct phone interviews" />
    <bpmn:task id="select" name="Select candidates" />
    <bpmn:exclusiveGateway id="pref" name="Candidate preference?" />
    <bpmn:task id="inperson" name="Interview in person" />
    <bpmn:task id="virtual" name="Interview virtually" />
    <bpmn:exclusiveGateway id="joini" />
    <bpmn:task id="choose" name="Choose a candidate" />
    <bpmn:task id="offer" name="Extend an offer" />
    <bpmn:exclusiveGateway id="neg" name="Negotiate salary?" />
    <bpmn:task id="negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="accjoin" />
    <bpmn:task id="accept" name="Receive offer acceptance" />
    <bpmn:parallelGateway id="ob" />
    <bpmn:task id="paper" name="Complete paperwork" />
    <bpmn:task id="orient" name="Hold orientation" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:parallelGateway id="obdone" />
    <bpmn:task id="integrate" name="Integrate the new hire into the team" />
    <bpmn:endEvent id="done" name="New hire integrated" />
    <bpmn:sequenceFlow id="f-need-jd" sourceRef="need" targetRef="jd" />
    <bpmn:sequenceFlow id="f-jd-post" sourceRef="jd" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-collect" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-screen" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f-screen-phone" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f-phone-select" sourceRef="phone" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-pref" sourceRef="select" targetRef="pref" />
    <bpmn:sequenceFlow id="f-pref-inperson" name="in person" sourceRef="pref" targetRef="inperson" />
    <bpmn:sequenceFlow id="f-pref-virtual" name="virtual" sourceRef="pref" targetRef="virtual" />
    <bpmn:sequenceFlow id="f-inperson-joini" sourceRef="inperson" targetRef="joini" />
    <bpmn:sequenceFlow id="f-virtual-joini" sourceRef="virtual" targetRef="joini" />
    <bpmn:sequenceFlow id="f-joini-choose" sourceRef="joini" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-offer" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-neg" sourceRef="offer" targetRef="neg" />
    <bpmn:sequenceFlow id="f-neg-negotiate" name="yes" sourceRef="neg" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-neg-accjoin" name="no" sourceRef="neg" targetRef="accjoin" />
    <bpmn:sequenceFlow id="f-negotiate-accjoin" sourceRef="negotiate" targetRef="accjoin" />
    <bpmn:sequenceFlow id="f-accjoin-accept" sourceRef="accjoin" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-ob" sourceRef="accept" targetRef="ob" />
    <bpmn:sequenceFlow id="f-ob-paper" sourceRef="ob" targetRef="paper" />
    <bpmn:sequenceFlow id="f-ob-orient" sourceRef="ob" targetRef="orient" />
    <bpmn:sequenceFlow id="f-ob-train" sourceRef="ob" targetRef="train" />
    <bpmn:sequenceFlow id="f-paper-obdone" sourceRef="paper" targetRef="obdone" />
    <bpmn:sequenceFlow id="f-orient-obdone" sourceRef="orient" targetRef="obdone" />
    <bpmn:sequenceFlow id="f-train-obdone" sourceRef="train" targetRef="obdone" />
    <bpmn:sequenceFlow id="f-obdone-integrate" sourceRef="obdone" targetRef="integrate" />
    <bpmn:sequenceFlow id="f-integrate-done" sourceRef="integrate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
