<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inventory restock" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Inventory restock" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inv" name="Inventory system">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="proc" name="Procurement team">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wh" name="Warehouse staff">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Stock reaches threshold" />
    <bpmn:task id="monitor" name="Monitor inventory levels" />
    <bpmn:task id="alert" name="Signal the need to reorder" />
    <bpmn:task id="update" name="Update expected delivery dates" />
    <bpmn:task id="record" name="Record the stock in the system" />
    <bpmn:task id="levels" name="Update inventory levels" />
    <bpmn:endEvent id="e" name="Restock complete" />
    <bpmn:task id="order" name="Place an order with suppliers" />
    <bpmn:task id="receive" name="Receive the stock" />
    <bpmn:task id="inspect" name="Inspect the stock for quality" />
    <bpmn:task id="shelve" name="Place the stock on shelves" />
    <bpmn:sequenceFlow id="f-s-monitor" sourceRef="s" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-alert" sourceRef="monitor" targetRef="alert" />
    <bpmn:sequenceFlow id="f-alert-order" sourceRef="alert" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-update" sourceRef="order" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-receive" sourceRef="update" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-record" sourceRef="inspect" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-shelve" sourceRef="record" targetRef="shelve" />
    <bpmn:sequenceFlow id="f-shelve-levels" sourceRef="shelve" targetRef="levels" />
    <bpmn:sequenceFlow id="f-levels-e" sourceRef="levels" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
