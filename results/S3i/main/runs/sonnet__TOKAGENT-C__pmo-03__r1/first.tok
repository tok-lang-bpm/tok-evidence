tok 1.0 "Inventory restock"

pool org "Organisation"
  lane inv "Inventory system"
    start s "Stock reaches threshold"
    task monitor "Monitor inventory levels"
    task alert "Signal the need to reorder"
    task update "Update expected delivery dates"
    task record "Record the stock in the system"
    task levels "Update inventory levels"
    end e "Restock complete"
  lane proc "Procurement team"
    task order "Place an order with suppliers"
  lane wh "Warehouse staff"
    task receive "Receive the stock"
    task inspect "Inspect the stock for quality"
    task shelve "Place the stock on shelves"

flow s -> monitor -> alert -> order -> update -> receive -> inspect -> record -> shelve -> levels -> e
