tok 1.0 "Marketing campaign"

pool org "Organisation"
  lane team "Marketing team"
    start begin "Campaign needed"
    task define "Define the campaign objectives"
    and split
    task content "Create the content"
    task visuals "Design the visuals"
    task channels "Select the channels"
    and join
    task launch "Launch the campaign"
    and run
    task track "Track the campaign performance"
    and runend
    task analyze "Analyze the performance"
    end done "Campaign concluded"
  lane crm "CRM system"
    task collect "Collect the leads"
  lane sales "Sales team"
    task follow "Follow up the leads"

flow begin -> define -> split
flow split -> content -> join
flow split -> visuals -> join
flow split -> channels -> join
flow join -> launch -> run
flow run -> track -> runend
flow run -> collect -> follow -> runend
flow runend -> analyze -> done
