<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Marketing campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="team" name="Marketing team">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>follow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Campaign needed" />
    <bpmn:task id="define" name="Define the campaign objectives" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="content" name="Create the content" />
    <bpmn:task id="visuals" name="Design the visuals" />
    <bpmn:task id="channels" name="Select the channels" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="launch" name="Launch the campaign" />
    <bpmn:task id="track" name="Track the campaign performance" />
    <bpmn:task id="analyze" name="Analyze the performance" />
    <bpmn:endEvent id="done" name="Campaign concluded" />
    <bpmn:task id="collect" name="Collect the leads" />
    <bpmn:task id="follow" name="Follow up the leads" />
    <bpmn:endEvent id="followed" name="Leads followed up" />
    <bpmn:sequenceFlow id="f-begin-define" sourceRef="begin" targetRef="define" />
    <bpmn:sequenceFlow id="f-define-split" sourceRef="define" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-content" sourceRef="split" targetRef="content" />
    <bpmn:sequenceFlow id="f-content-join" sourceRef="content" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-visuals" sourceRef="split" targetRef="visuals" />
    <bpmn:sequenceFlow id="f-visuals-join" sourceRef="visuals" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-channels" sourceRef="split" targetRef="channels" />
    <bpmn:sequenceFlow id="f-channels-join" sourceRef="channels" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-launch" sourceRef="join" targetRef="launch" />
    <bpmn:sequenceFlow id="f-launch-track" sourceRef="launch" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-analyze" sourceRef="track" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-done" sourceRef="analyze" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
