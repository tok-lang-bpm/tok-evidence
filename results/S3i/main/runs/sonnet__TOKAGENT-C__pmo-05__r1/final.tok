tok 1.0 "Supplier selection"

pool company "Company"
  lane procurement "Procurement team"
    start need "Need for a new supplier identified"
    task rfp "Issue a request for proposals"
    task receive "Receive supplier responses"
    task evaluate "Evaluate the proposals"
    xor visit "Site visits or interviews needed?"
    task conduct "Conduct site visits or interviews"
    xor merge
    task select "Select a supplier"
    task negotiate "Negotiate the contract"
    task sign "Sign the contract"
    task onboard "Onboard the supplier"
    task execute "Execute the contract"
    end done "Supplier onboarded and contract executed"

flow need -> rfp -> receive -> evaluate -> visit
flow visit -> conduct "yes"
flow visit -> merge "no"
flow conduct -> merge
flow merge -> select -> negotiate -> sign -> onboard -> execute -> done
