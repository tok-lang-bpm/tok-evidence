<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Supplier selection" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Supplier selection" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="procurement" name="Procurement team">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="need" name="Need for a new supplier identified" />
    <bpmn:task id="rfp" name="Issue a request for proposals" />
    <bpmn:task id="receive" name="Receive supplier responses" />
    <bpmn:task id="evaluate" name="Evaluate the proposals" />
    <bpmn:exclusiveGateway id="visit" name="Site visits or interviews needed?" />
    <bpmn:task id="conduct" name="Conduct site visits or interviews" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="select" name="Select a supplier" />
    <bpmn:task id="negotiate" name="Negotiate the contract" />
    <bpmn:task id="sign" name="Sign the contract" />
    <bpmn:task id="onboard" name="Onboard the supplier" />
    <bpmn:task id="execute" name="Execute the contract" />
    <bpmn:endEvent id="done" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="f-need-rfp" sourceRef="need" targetRef="rfp" />
    <bpmn:sequenceFlow id="f-rfp-receive" sourceRef="rfp" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-evaluate" sourceRef="receive" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-evaluate-visit" sourceRef="evaluate" targetRef="visit" />
    <bpmn:sequenceFlow id="f-visit-conduct" name="yes" sourceRef="visit" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-visit-merge" name="no" sourceRef="visit" targetRef="merge" />
    <bpmn:sequenceFlow id="f-conduct-merge" sourceRef="conduct" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-select" sourceRef="merge" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-negotiate" sourceRef="select" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-sign" sourceRef="negotiate" targetRef="sign" />
    <bpmn:sequenceFlow id="f-sign-onboard" sourceRef="sign" targetRef="onboard" />
    <bpmn:sequenceFlow id="f-onboard-execute" sourceRef="onboard" targetRef="execute" />
    <bpmn:sequenceFlow id="f-execute-done" sourceRef="execute" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
