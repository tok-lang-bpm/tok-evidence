<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfilment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="logistics" name="Logistics provider">
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:task id="confirm" name="Generate the order confirmation" />
    <bpmn:task id="sendconf" name="Send the order confirmation to the customer" />
    <bpmn:task id="label" name="Generate the shipping label" />
    <bpmn:task id="track" name="Send the tracking information to the customer" />
    <bpmn:task id="pick" name="Pick and pack the items" />
    <bpmn:task id="handover" name="Deliver the order" />
    <bpmn:task id="monitor" name="Monitor the shipment" />
    <bpmn:endEvent id="delivered" name="Order delivered" />
    <bpmn:sequenceFlow id="f-placed-confirm" sourceRef="placed" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-sendconf" sourceRef="confirm" targetRef="sendconf" />
    <bpmn:sequenceFlow id="f-sendconf-pick" sourceRef="sendconf" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-label" sourceRef="pick" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-handover" sourceRef="label" targetRef="handover" />
    <bpmn:sequenceFlow id="f-handover-track" sourceRef="handover" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-monitor" sourceRef="track" targetRef="monitor" />
    <bpmn:sequenceFlow id="f-monitor-delivered" sourceRef="monitor" targetRef="delivered" />
  </bpmn:process>
</bpmn:definitions>
