<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ticket booking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Travel company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Ticket booking" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>searching</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Booking system">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="searching" name="Customer searches for a ticket" />
    <bpmn:task id="select" name="Select the route, date and time" />
    <bpmn:task id="provide" name="Provide personal information and payment details" />
    <bpmn:task id="travel" name="Complete the journey" />
    <bpmn:endEvent id="done" name="Journey completed" />
    <bpmn:task id="generate" name="Generate the ticket" />
    <bpmn:exclusiveGateway id="channel" name="Send by email or SMS?" />
    <bpmn:task id="email" name="Send the ticket by email" />
    <bpmn:task id="sms" name="Send the ticket by SMS" />
    <bpmn:exclusiveGateway id="sent" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="update" name="Update the seat inventory" />
    <bpmn:task id="remind" name="Send reminders and check-in instructions" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:sequenceFlow id="f-searching-select" sourceRef="searching" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-provide" sourceRef="select" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-generate" sourceRef="provide" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-channel" sourceRef="generate" targetRef="channel" />
    <bpmn:sequenceFlow id="f-channel-email" name="email" sourceRef="channel" targetRef="email" />
    <bpmn:sequenceFlow id="f-channel-sms" name="SMS" sourceRef="channel" targetRef="sms" />
    <bpmn:sequenceFlow id="f-email-sent" sourceRef="email" targetRef="sent" />
    <bpmn:sequenceFlow id="f-sms-sent" sourceRef="sms" targetRef="sent" />
    <bpmn:sequenceFlow id="f-sent-split" sourceRef="sent" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-update" sourceRef="split" targetRef="update" />
    <bpmn:sequenceFlow id="f-split-remind" sourceRef="split" targetRef="remind" />
    <bpmn:sequenceFlow id="f-update-joined" sourceRef="update" targetRef="joined" />
    <bpmn:sequenceFlow id="f-remind-joined" sourceRef="remind" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-travel" sourceRef="joined" targetRef="travel" />
    <bpmn:sequenceFlow id="f-travel-done" sourceRef="travel" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
