tok 1.0 "Incident handling"

pool org "Organisation"
  lane reporter "Employee or customer"
    start begin "Incident reported"
    task report "Report the incident"
  lane support "Support system"
    task log "Log the report in the tracking system"
    task assign "Assign the report to the appropriate team"
  lane team "Investigation team"
    task gather "Gather necessary information"
    task identify "Identify the cause of the incident"
    task propose "Propose corrective actions"
    task implement "Implement the solution"
    task followup "Follow up on the resolution"
    task close "Close the incident report"
    task notify "Notify all stakeholders"
    end done "Incident closed"

flow begin -> report -> log -> assign -> gather -> identify -> propose -> implement -> followup -> close -> notify -> done
