<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Subscription" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Subscription service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Subscription" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support team">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="signup" name="Customer signs up" />
    <bpmn:task id="enter" name="Enter personal and payment information" />
    <bpmn:task id="receive" name="Receive updates and notifications" />
    <bpmn:exclusiveGateway id="cancel" name="Cancel subscription?" />
    <bpmn:task id="request" name="Submit cancellation request" />
    <bpmn:task id="generate" name="Generate account" />
    <bpmn:task id="assign" name="Assign access" />
    <bpmn:task id="bill" name="Trigger automated billing cycles" />
    <bpmn:task id="process" name="Process cancellation request" />
    <bpmn:task id="apply" name="Apply refunds or charges" />
    <bpmn:task id="deactivate" name="Deactivate subscription" />
    <bpmn:task id="settle" name="Settle final account balance" />
    <bpmn:endEvent id="done" name="Subscription closed" />
    <bpmn:sequenceFlow id="f-signup-enter" sourceRef="signup" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-generate" sourceRef="enter" targetRef="generate" />
    <bpmn:sequenceFlow id="f-generate-assign" sourceRef="generate" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-bill" sourceRef="assign" targetRef="bill" />
    <bpmn:sequenceFlow id="f-bill-receive" sourceRef="bill" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-cancel" sourceRef="receive" targetRef="cancel" />
    <bpmn:sequenceFlow id="f-cancel-receive" name="no" sourceRef="cancel" targetRef="receive" />
    <bpmn:sequenceFlow id="f-cancel-request" name="yes" sourceRef="cancel" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-process" sourceRef="request" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-apply" sourceRef="process" targetRef="apply" />
    <bpmn:sequenceFlow id="f-apply-deactivate" sourceRef="apply" targetRef="deactivate" />
    <bpmn:sequenceFlow id="f-deactivate-settle" sourceRef="deactivate" targetRef="settle" />
    <bpmn:sequenceFlow id="f-settle-done" sourceRef="settle" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
