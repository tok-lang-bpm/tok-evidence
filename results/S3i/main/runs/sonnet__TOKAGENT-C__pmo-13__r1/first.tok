tok 1.0 "Complaint handling"

pool org "Organisation"
  lane customer "Customer"
    start filed "Complaint filed"
    task file "File the complaint"
    task feedback "Provide feedback"
    end done "Feedback provided"
  lane service "Customer service"
    task log "Log the complaint"
    task assign "Assign the complaint to the department"
    task notify "Notify the customer with the decision"
    xor approved "Refund approved?"
    xor merge
    task resolve "Mark the complaint as resolved"
  lane dept "Department"
    task investigate "Investigate the complaint"
    task decide "Decide on validity and refund"
  lane finance "Financial team"
    task reimburse "Process the reimbursement"

flow filed -> file -> log -> assign -> investigate -> decide -> notify -> approved
flow approved -> reimburse "yes"
flow approved -> merge "no"
flow reimburse -> merge
flow merge -> resolve -> feedback -> done
