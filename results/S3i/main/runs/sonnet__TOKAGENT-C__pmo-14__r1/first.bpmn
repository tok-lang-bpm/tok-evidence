<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Budget planning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Budget planning" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveadj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mgmt" name="Management">
        <bpmn:flowNodeRef>align</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aligned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Finance department">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feasible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Budget period approaching" />
    <bpmn:task id="outline" name="Outline the objectives" />
    <bpmn:task id="draft" name="Draft the plan" />
    <bpmn:task id="adjust" name="Adjust the plan" />
    <bpmn:task id="document" name="Document the adjustment" />
    <bpmn:task id="approveadj" name="Approve the adjustment" />
    <bpmn:task id="implement" name="Begin implementing the plan" />
    <bpmn:task id="align" name="Review the plan in the strategic alignment meeting" />
    <bpmn:exclusiveGateway id="aligned" name="Plan aligned?" />
    <bpmn:task id="allocate" name="Allocate the budget" />
    <bpmn:task id="distribute" name="Distribute the budget" />
    <bpmn:task id="review" name="Review the budget feasibility" />
    <bpmn:exclusiveGateway id="feasible" name="Budget feasible?" />
    <bpmn:exclusiveGateway id="merge" name="" />
    <bpmn:endEvent id="done" name="Budget distributed" />
    <bpmn:sequenceFlow id="f-begin-outline" sourceRef="begin" targetRef="outline" />
    <bpmn:sequenceFlow id="f-outline-draft" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-merge" sourceRef="draft" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-align" sourceRef="merge" targetRef="align" />
    <bpmn:sequenceFlow id="f-align-aligned" sourceRef="align" targetRef="aligned" />
    <bpmn:sequenceFlow id="f-aligned-review" name="yes" sourceRef="aligned" targetRef="review" />
    <bpmn:sequenceFlow id="f-aligned-adjust" name="no" sourceRef="aligned" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-review-feasible" sourceRef="review" targetRef="feasible" />
    <bpmn:sequenceFlow id="f-feasible-allocate" name="yes" sourceRef="feasible" targetRef="allocate" />
    <bpmn:sequenceFlow id="f-feasible-adjust" name="no" sourceRef="feasible" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjust-document" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f-document-approveadj" sourceRef="document" targetRef="approveadj" />
    <bpmn:sequenceFlow id="f-approveadj-merge" sourceRef="approveadj" targetRef="merge" />
    <bpmn:sequenceFlow id="f-allocate-distribute" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-implement" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f-implement-done" sourceRef="implement" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
