<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Compliance audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Compliance audit" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>sched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="auditors" name="Auditors">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gaps</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="sched" name="Compliance audit scheduled" />
    <bpmn:task id="docs" name="Prepare documentation" />
    <bpmn:task id="evidence" name="Gather evidence" />
    <bpmn:task id="self" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="correct" name="Make corrections or improvements" />
    <bpmn:task id="final" name="Undergo final audit" />
    <bpmn:exclusiveGateway id="met" name="All criteria met?" />
    <bpmn:task id="cert" name="Award certification" />
    <bpmn:task id="issue" name="Issue official documents" />
    <bpmn:endEvent id="done" name="Certification issued" />
    <bpmn:endEvent id="failed" name="Certification not awarded" />
    <bpmn:task id="review" name="Review the company's processes" />
    <bpmn:task id="gaps" name="Identify gaps or issues" />
    <bpmn:sequenceFlow id="f-sched-split" sourceRef="sched" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-docs" sourceRef="split" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-join" sourceRef="docs" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-evidence" sourceRef="split" targetRef="evidence" />
    <bpmn:sequenceFlow id="f-evidence-join" sourceRef="evidence" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-self" sourceRef="join" targetRef="self" />
    <bpmn:sequenceFlow id="f-self-review" sourceRef="self" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-gaps" sourceRef="review" targetRef="gaps" />
    <bpmn:sequenceFlow id="f-gaps-correct" sourceRef="gaps" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-final" sourceRef="correct" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-met" sourceRef="final" targetRef="met" />
    <bpmn:sequenceFlow id="f-met-cert" name="yes" sourceRef="met" targetRef="cert" />
    <bpmn:sequenceFlow id="f-met-failed" name="no" sourceRef="met" targetRef="failed" />
    <bpmn:sequenceFlow id="f-cert-issue" sourceRef="cert" targetRef="issue" />
    <bpmn:sequenceFlow id="f-issue-done" sourceRef="issue" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
