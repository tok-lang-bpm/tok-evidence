<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual audit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Annual audit" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="audit" name="Central audit team">
        <bpmn:flowNodeRef>reviewIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>riskSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>riskJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>high</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>siteEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>riskEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>approveReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Audit initiated" />
    <bpmn:task id="notify" name="Send notification to the regional office" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="prepare" name="Prepare financial statements and gather documents" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="submit" name="Submit the documents to the central audit team" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:task id="updates" name="Check regulatory updates" />
    <bpmn:exclusiveGateway id="reviewIn" />
    <bpmn:task id="review" name="Review the submission" />
    <bpmn:exclusiveGateway id="issues" name="Discrepancies found?" />
    <bpmn:task id="request" name="Request clarifications from the regional office" />
    <bpmn:task id="assess" name="Conduct risk assessment" />
    <bpmn:parallelGateway id="riskSplit" />
    <bpmn:task id="fin" name="Evaluate financial risks" />
    <bpmn:task id="oper" name="Evaluate operational risks" />
    <bpmn:task id="comp" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="riskJoin" />
    <bpmn:exclusiveGateway id="high" name="High risk identified?" />
    <bpmn:task id="analysis" name="Analyse data" />
    <bpmn:task id="interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="site" name="Site visit needed?" />
    <bpmn:task id="visit" name="Conduct site visit" />
    <bpmn:exclusiveGateway id="siteEnd" />
    <bpmn:exclusiveGateway id="riskEnd" />
    <bpmn:task id="compile" name="Compile the audit report" />
    <bpmn:exclusiveGateway id="reportIn" />
    <bpmn:task id="update" name="Update the report" />
    <bpmn:task id="approveReview" name="Review the report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:parallelGateway id="distSplit" />
    <bpmn:task id="distribute" name="Distribute the final report to the executive board" />
    <bpmn:task id="archive" name="Archive the final report" />
    <bpmn:parallelGateway id="distJoin" />
    <bpmn:endEvent id="done" name="Audit process closed" />
    <bpmn:sequenceFlow id="f-begin-notify" sourceRef="begin" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-split" sourceRef="notify" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-prepare" sourceRef="split" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-joined" sourceRef="prepare" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-updates" sourceRef="split" targetRef="updates" />
    <bpmn:sequenceFlow id="f-updates-joined" sourceRef="updates" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-submit" sourceRef="joined" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-reviewIn" sourceRef="submit" targetRef="reviewIn" />
    <bpmn:sequenceFlow id="f-reviewIn-review" sourceRef="reviewIn" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-issues" sourceRef="review" targetRef="issues" />
    <bpmn:sequenceFlow id="f-issues-request" name="yes" sourceRef="issues" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-clarify" sourceRef="request" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-reviewIn" sourceRef="clarify" targetRef="reviewIn" />
    <bpmn:sequenceFlow id="f-issues-assess" name="no" sourceRef="issues" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-riskSplit" sourceRef="assess" targetRef="riskSplit" />
    <bpmn:sequenceFlow id="f-riskSplit-fin" sourceRef="riskSplit" targetRef="fin" />
    <bpmn:sequenceFlow id="f-fin-riskJoin" sourceRef="fin" targetRef="riskJoin" />
    <bpmn:sequenceFlow id="f-riskSplit-oper" sourceRef="riskSplit" targetRef="oper" />
    <bpmn:sequenceFlow id="f-oper-riskJoin" sourceRef="oper" targetRef="riskJoin" />
    <bpmn:sequenceFlow id="f-riskSplit-comp" sourceRef="riskSplit" targetRef="comp" />
    <bpmn:sequenceFlow id="f-comp-riskJoin" sourceRef="comp" targetRef="riskJoin" />
    <bpmn:sequenceFlow id="f-riskJoin-high" sourceRef="riskJoin" targetRef="high" />
    <bpmn:sequenceFlow id="f-high-analysis" name="yes" sourceRef="high" targetRef="analysis" />
    <bpmn:sequenceFlow id="f-analysis-interviews" sourceRef="analysis" targetRef="interviews" />
    <bpmn:sequenceFlow id="f-interviews-site" sourceRef="interviews" targetRef="site" />
    <bpmn:sequenceFlow id="f-site-visit" name="yes" sourceRef="site" targetRef="visit" />
    <bpmn:sequenceFlow id="f-visit-siteEnd" sourceRef="visit" targetRef="siteEnd" />
    <bpmn:sequenceFlow id="f-site-siteEnd" name="no" sourceRef="site" targetRef="siteEnd" />
    <bpmn:sequenceFlow id="f-siteEnd-riskEnd" sourceRef="siteEnd" targetRef="riskEnd" />
    <bpmn:sequenceFlow id="f-high-riskEnd" name="no" sourceRef="high" targetRef="riskEnd" />
    <bpmn:sequenceFlow id="f-riskEnd-reportIn" sourceRef="riskEnd" targetRef="reportIn" />
    <bpmn:sequenceFlow id="f-reportIn-compile" sourceRef="reportIn" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compile-approveReview" sourceRef="compile" targetRef="approveReview" />
    <bpmn:sequenceFlow id="f-approveReview-approved" sourceRef="approveReview" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-update" name="no" sourceRef="approved" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-approveReview" sourceRef="update" targetRef="approveReview" />
    <bpmn:sequenceFlow id="f-approved-distSplit" name="yes" sourceRef="approved" targetRef="distSplit" />
    <bpmn:sequenceFlow id="f-distSplit-distribute" sourceRef="distSplit" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-distJoin" sourceRef="distribute" targetRef="distJoin" />
    <bpmn:sequenceFlow id="f-distSplit-archive" sourceRef="distSplit" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-distJoin" sourceRef="archive" targetRef="distJoin" />
    <bpmn:sequenceFlow id="f-distJoin-done" sourceRef="distJoin" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
