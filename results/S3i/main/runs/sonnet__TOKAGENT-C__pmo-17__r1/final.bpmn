<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Order fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="E-commerce company" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Order fulfillment" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stockmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giftmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shipping" name="Shipping department">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intlmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>labels</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="placed" name="Order placed" />
    <bpmn:task id="record" name="Record the order details" />
    <bpmn:task id="pay" name="Process the payment" />
    <bpmn:exclusiveGateway id="payok" name="Payment successful?" />
    <bpmn:task id="notifyfail" name="Notify the customer" />
    <bpmn:endEvent id="failed" name="Order failed" />
    <bpmn:task id="check" name="Check stock availability" />
    <bpmn:exclusiveGateway id="instock" name="Items in stock?" />
    <bpmn:task id="backorder" name="Initiate a back-order" />
    <bpmn:task id="delay" name="Inform the customer about the delay" />
    <bpmn:task id="receiveback" name="Receive the back-order" />
    <bpmn:exclusiveGateway id="stockmerge" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:task id="confirm" name="Send a shipping confirmation" />
    <bpmn:task id="update" name="Update the inventory levels" />
    <bpmn:task id="delivered" name="Confirm the delivery" />
    <bpmn:task id="feedback" name="Send a follow-up email for feedback" />
    <bpmn:exclusiveGateway id="issues" name="Issues reported?" />
    <bpmn:task id="label" name="Send a return shipping label" />
    <bpmn:task id="receive" name="Receive the returned items" />
    <bpmn:task id="inspect" name="Inspect the returned items" />
    <bpmn:task id="refund" name="Process a refund or replacement" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:endEvent id="returned" name="Return handled" />
    <bpmn:task id="pick" name="Pick the items from the warehouse" />
    <bpmn:task id="qc" name="Perform quality control on the picked items" />
    <bpmn:exclusiveGateway id="gift" name="Gift wrapping requested?" />
    <bpmn:task id="wrap" name="Wrap the gift" />
    <bpmn:exclusiveGateway id="giftmerge" />
    <bpmn:task id="pack" name="Package the items" />
    <bpmn:task id="docs" name="Prepare shipping documents" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="intlmerge" />
    <bpmn:task id="labels" name="Prepare shipping labels" />
    <bpmn:sequenceFlow id="f-placed-record" sourceRef="placed" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-pay" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-payok" sourceRef="pay" targetRef="payok" />
    <bpmn:sequenceFlow id="f-payok-notifyfail" name="no" sourceRef="payok" targetRef="notifyfail" />
    <bpmn:sequenceFlow id="f-notifyfail-failed" sourceRef="notifyfail" targetRef="failed" />
    <bpmn:sequenceFlow id="f-payok-check" name="yes" sourceRef="payok" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-instock" sourceRef="check" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-backorder" name="no" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-backorder-delay" sourceRef="backorder" targetRef="delay" />
    <bpmn:sequenceFlow id="f-delay-receiveback" sourceRef="delay" targetRef="receiveback" />
    <bpmn:sequenceFlow id="f-receiveback-stockmerge" sourceRef="receiveback" targetRef="stockmerge" />
    <bpmn:sequenceFlow id="f-instock-stockmerge" name="yes" sourceRef="instock" targetRef="stockmerge" />
    <bpmn:sequenceFlow id="f-stockmerge-pick" sourceRef="stockmerge" targetRef="pick" />
    <bpmn:sequenceFlow id="f-pick-qc" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f-qc-split" sourceRef="qc" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-gift" sourceRef="split" targetRef="gift" />
    <bpmn:sequenceFlow id="f-gift-wrap" name="yes" sourceRef="gift" targetRef="wrap" />
    <bpmn:sequenceFlow id="f-gift-giftmerge" name="no" sourceRef="gift" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f-wrap-giftmerge" sourceRef="wrap" targetRef="giftmerge" />
    <bpmn:sequenceFlow id="f-giftmerge-pack" sourceRef="giftmerge" targetRef="pack" />
    <bpmn:sequenceFlow id="f-pack-join" sourceRef="pack" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-docs" sourceRef="split" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-intl" sourceRef="docs" targetRef="intl" />
    <bpmn:sequenceFlow id="f-intl-customs" name="yes" sourceRef="intl" targetRef="customs" />
    <bpmn:sequenceFlow id="f-intl-intlmerge" name="no" sourceRef="intl" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-customs-intlmerge" sourceRef="customs" targetRef="intlmerge" />
    <bpmn:sequenceFlow id="f-intlmerge-labels" sourceRef="intlmerge" targetRef="labels" />
    <bpmn:sequenceFlow id="f-labels-join" sourceRef="labels" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-dispatch" sourceRef="join" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-confirm" sourceRef="dispatch" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-update" sourceRef="confirm" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-delivered" sourceRef="update" targetRef="delivered" />
    <bpmn:sequenceFlow id="f-delivered-feedback" sourceRef="delivered" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-issues" sourceRef="feedback" targetRef="issues" />
    <bpmn:sequenceFlow id="f-issues-label" name="yes" sourceRef="issues" targetRef="label" />
    <bpmn:sequenceFlow id="f-label-receive" sourceRef="label" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-refund" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f-refund-returned" sourceRef="refund" targetRef="returned" />
    <bpmn:sequenceFlow id="f-issues-done" name="no" sourceRef="issues" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
