<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="University enrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="uni" name="University" processRef="uni-process" />
  </bpmn:collaboration>
  <bpmn:process id="uni-process" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="uni-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>griefjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admissions" name="Admissions office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT department">
        <bpmn:flowNodeRef>accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="intl" name="International student office">
        <bpmn:flowNodeRef>isintl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intljoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Application needed" />
    <bpmn:task id="submit" name="Submit the application online" />
    <bpmn:task id="confirm" name="Confirm enrollment" />
    <bpmn:task id="getid" name="Obtain the student ID card" />
    <bpmn:task id="meet" name="Meet with an academic advisor" />
    <bpmn:task id="select" name="Select courses" />
    <bpmn:task id="resolve" name="Resolve schedule conflicts" />
    <bpmn:task id="attend" name="Attend classes" />
    <bpmn:exclusiveGateway id="change" name="Change courses?" />
    <bpmn:task id="adddrop" name="Add or drop courses" />
    <bpmn:exclusiveGateway id="changed" />
    <bpmn:task id="reviewg" name="Review the grades online" />
    <bpmn:exclusiveGateway id="grievance" name="Grievance?" />
    <bpmn:task id="form" name="Submit an appeal form" />
    <bpmn:task id="meetc" name="Meet with the appeals committee" />
    <bpmn:task id="await" name="Await a decision" />
    <bpmn:exclusiveGateway id="griefjoin" />
    <bpmn:exclusiveGateway id="done" name="Graduated or withdrawn?" />
    <bpmn:endEvent id="finished" name="Process finished" />
    <bpmn:endEvent id="cancelled" name="Application canceled" />
    <bpmn:task id="review" name="Review the application and supporting documents" />
    <bpmn:exclusiveGateway id="complete" name="Documents complete?" />
    <bpmn:task id="notify" name="Notify the applicant to provide the missing items" />
    <bpmn:exclusiveGateway id="reviewin" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="evaluate" name="Evaluate the application" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" />
    <bpmn:task id="accept" name="Send an acceptance letter" />
    <bpmn:task id="reject" name="Send a rejection letter" />
    <bpmn:exclusiveGateway id="confirmed" name="Enrollment confirmed by the deadline?" />
    <bpmn:task id="cancel" name="Cancel the application" />
    <bpmn:task id="orient" name="Send orientation materials" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:parallelGateway id="joined2" />
    <bpmn:task id="post" name="Post the grades" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:task id="fees" name="Process application fees or waivers" />
    <bpmn:task id="accounts" name="Set up student accounts" />
    <bpmn:exclusiveGateway id="isintl" name="International student?" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="intljoin" />
    <bpmn:sequenceFlow id="f-begin-submit" sourceRef="begin" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-reviewin" sourceRef="submit" targetRef="reviewin" />
    <bpmn:sequenceFlow id="f-reviewin-review" sourceRef="reviewin" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-complete" sourceRef="review" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-notify" name="no" sourceRef="complete" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-reviewin" sourceRef="notify" targetRef="reviewin" />
    <bpmn:sequenceFlow id="f-complete-split" name="yes" sourceRef="complete" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-evaluate" sourceRef="split" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-split-fees" sourceRef="split" targetRef="fees" />
    <bpmn:sequenceFlow id="f-evaluate-joined" sourceRef="evaluate" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fees-joined" sourceRef="fees" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-accepted" sourceRef="joined" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-accept" name="yes" sourceRef="accepted" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-confirm" sourceRef="accept" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-split2" name="yes" sourceRef="confirmed" targetRef="split2" />
    <bpmn:sequenceFlow id="f-confirmed-cancel" name="no" sourceRef="confirmed" targetRef="cancel" />
    <bpmn:sequenceFlow id="f-cancel-cancelled" sourceRef="cancel" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-split2-orient" sourceRef="split2" targetRef="orient" />
    <bpmn:sequenceFlow id="f-split2-accounts" sourceRef="split2" targetRef="accounts" />
    <bpmn:sequenceFlow id="f-split2-isintl" sourceRef="split2" targetRef="isintl" />
    <bpmn:sequenceFlow id="f-isintl-visa" name="yes" sourceRef="isintl" targetRef="visa" />
    <bpmn:sequenceFlow id="f-isintl-intljoin" name="no" sourceRef="isintl" targetRef="intljoin" />
    <bpmn:sequenceFlow id="f-visa-intljoin" sourceRef="visa" targetRef="intljoin" />
    <bpmn:sequenceFlow id="f-orient-joined2" sourceRef="orient" targetRef="joined2" />
    <bpmn:sequenceFlow id="f-accounts-joined2" sourceRef="accounts" targetRef="joined2" />
    <bpmn:sequenceFlow id="f-intljoin-joined2" sourceRef="intljoin" targetRef="joined2" />
    <bpmn:sequenceFlow id="f-joined2-getid" sourceRef="joined2" targetRef="getid" />
    <bpmn:sequenceFlow id="f-getid-meet" sourceRef="getid" targetRef="meet" />
    <bpmn:sequenceFlow id="f-meet-select" sourceRef="meet" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-resolve" sourceRef="select" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-attend" sourceRef="resolve" targetRef="attend" />
    <bpmn:sequenceFlow id="f-attend-change" sourceRef="attend" targetRef="change" />
    <bpmn:sequenceFlow id="f-change-adddrop" name="yes" sourceRef="change" targetRef="adddrop" />
    <bpmn:sequenceFlow id="f-change-changed" name="no" sourceRef="change" targetRef="changed" />
    <bpmn:sequenceFlow id="f-adddrop-changed" sourceRef="adddrop" targetRef="changed" />
    <bpmn:sequenceFlow id="f-changed-post" sourceRef="changed" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-reviewg" sourceRef="post" targetRef="reviewg" />
    <bpmn:sequenceFlow id="f-reviewg-grievance" sourceRef="reviewg" targetRef="grievance" />
    <bpmn:sequenceFlow id="f-grievance-form" name="yes" sourceRef="grievance" targetRef="form" />
    <bpmn:sequenceFlow id="f-grievance-griefjoin" name="no" sourceRef="grievance" targetRef="griefjoin" />
    <bpmn:sequenceFlow id="f-form-meetc" sourceRef="form" targetRef="meetc" />
    <bpmn:sequenceFlow id="f-meetc-await" sourceRef="meetc" targetRef="await" />
    <bpmn:sequenceFlow id="f-await-griefjoin" sourceRef="await" targetRef="griefjoin" />
    <bpmn:sequenceFlow id="f-griefjoin-done" sourceRef="griefjoin" targetRef="done" />
    <bpmn:sequenceFlow id="f-done-finished" name="yes" sourceRef="done" targetRef="finished" />
    <bpmn:sequenceFlow id="f-done-change" name="no" sourceRef="done" targetRef="change" />
  </bpmn:process>
</bpmn:definitions>
