tok 1.0 "Online shop purchase"

pool shop "Online shop"
  lane user "User"
    start begin "Order needed"
    task login "Log in to the account"
    and split
    task select "Select the items"
    task reward "Choose a free reward"
    task method "Set a payment method"
    xor how "Pay or installment?"
    task pay "Pay"
    task install "Complete an installment agreement"
    xor paid
    and join
    xor again
    task deliver "Deliver the items"
    xor ret "Return items for exchange?"
    task back "Return the items"
    end done "Order completed"

flow begin -> login -> split
flow split -> select -> reward -> join
flow split -> method -> how
flow how -> pay "pay"
flow how -> install "installment"
flow pay -> paid
flow install -> paid
flow paid -> join
flow join -> again -> deliver -> ret
flow ret -> back "yes"
flow ret -> done "no"
flow back -> again
