<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Shipping" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Shipping" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sec" name="Secretary">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Logistics department head">
        <bpmn:flowNodeRef>need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wh" name="Warehouse">
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="large" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one logistic company" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="label" name="Write the package label" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="prepare" name="Prepare the packaged goods for pick up" />
    <bpmn:endEvent id="e" name="Goods ready for pick up" />
    <bpmn:exclusiveGateway id="need" name="Insurance necessary?" />
    <bpmn:task id="insure" name="Take a parcel insurance" />
    <bpmn:exclusiveGateway id="needed" />
    <bpmn:task id="pack" name="Package the goods" />
    <bpmn:sequenceFlow id="f-s-clarify" sourceRef="s" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-large" sourceRef="clarify" targetRef="large" />
    <bpmn:sequenceFlow id="f-large-invite" name="yes" sourceRef="large" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-select" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-merge" sourceRef="select" targetRef="merge" />
    <bpmn:sequenceFlow id="f-large-split" name="no" sourceRef="large" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-label" sourceRef="split" targetRef="label" />
    <bpmn:sequenceFlow id="f-split-need" sourceRef="split" targetRef="need" />
    <bpmn:sequenceFlow id="f-split-pack" sourceRef="split" targetRef="pack" />
    <bpmn:sequenceFlow id="f-need-insure" name="yes" sourceRef="need" targetRef="insure" />
    <bpmn:sequenceFlow id="f-need-needed" name="no" sourceRef="need" targetRef="needed" />
    <bpmn:sequenceFlow id="f-insure-needed" sourceRef="insure" targetRef="needed" />
    <bpmn:sequenceFlow id="f-label-joined" sourceRef="label" targetRef="joined" />
    <bpmn:sequenceFlow id="f-needed-joined" sourceRef="needed" targetRef="joined" />
    <bpmn:sequenceFlow id="f-pack-joined" sourceRef="pack" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-merge" sourceRef="joined" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-prepare" sourceRef="merge" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-e" sourceRef="prepare" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
