tok 1.0 "Shipping"

pool org "Company"
  lane sec "Secretary"
    start s "Goods shall be shipped"
    task clarify "Clarify who will do the shipping"
    xor large "Large amounts?"
    task invite "Invite three logistic companies to make offers"
    task select "Select one logistic company"
    and split
    task label "Write the package label"
    and joined
    xor merge
    task prepare "Prepare the packaged goods for pick up"
    end e "Goods ready for pick up"
  lane head "Logistics department head"
    xor need "Insurance necessary?"
    task insure "Take a parcel insurance"
    xor needed
  lane wh "Warehouse"
    task pack "Package the goods"

flow s -> clarify -> large
flow large -> invite "yes"
flow invite -> select -> merge
flow large -> split "no"
flow split -> label
flow split -> need
flow split -> pack
flow need -> insure "yes"
flow need -> needed "no"
flow insure -> needed
flow label -> joined
flow needed -> joined
flow pack -> joined
flow joined -> merge
flow merge -> prepare -> e