tok 1.0 "Credit scoring"

pool bank "Bank"
  lane clerk "Sales clerk"
    start begin "Scoring needed"
    task request "Request the credit-scoring"
    task view "View the result"
  lane system "Banking system"
    task send "Send the scoring request"
    task present "Present the result"
    and split
    task delay "Display the delay message"
    and joined
    task display "Display the result"
    end done "Result shown"
    end done2 "Result shown late"
  lane agency "Agency"
    task quick "Do the quick scoring"
    xor immediate "Immediate result?"
    task ret "Return the result"
    task inform "Inform the banking process of the delay"
    task level2 "Do the level 2 scoring"
    task back "Send the result back"

flow begin -> request -> send -> quick -> immediate
flow immediate -> ret "yes"
flow immediate -> inform "no"
flow ret -> present -> view -> done
flow inform -> split
flow split -> delay
flow split -> level2
flow level2 -> back
flow delay -> joined
flow back -> joined
flow joined -> display -> done2
