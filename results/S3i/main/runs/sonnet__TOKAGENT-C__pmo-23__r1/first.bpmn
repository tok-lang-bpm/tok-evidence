<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Credit scoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Credit scoring" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>view</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Banking system">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Agency">
        <bpmn:flowNodeRef>quick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Scoring needed" />
    <bpmn:task id="request" name="Request the credit-scoring" />
    <bpmn:task id="view" name="View the result" />
    <bpmn:task id="send" name="Send the scoring request" />
    <bpmn:task id="present" name="Present the result" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="delay" name="Display the delay message" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="display" name="Display the result" />
    <bpmn:endEvent id="done" name="Result shown" />
    <bpmn:endEvent id="done2" name="Result shown late" />
    <bpmn:task id="quick" name="Do the quick scoring" />
    <bpmn:exclusiveGateway id="immediate" name="Immediate result?" />
    <bpmn:task id="ret" name="Return the result" />
    <bpmn:task id="inform" name="Inform the banking process of the delay" />
    <bpmn:task id="level2" name="Do the level 2 scoring" />
    <bpmn:task id="back" name="Send the result back" />
    <bpmn:sequenceFlow id="f-begin-request" sourceRef="begin" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-send" sourceRef="request" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-quick" sourceRef="send" targetRef="quick" />
    <bpmn:sequenceFlow id="f-quick-immediate" sourceRef="quick" targetRef="immediate" />
    <bpmn:sequenceFlow id="f-immediate-ret" name="yes" sourceRef="immediate" targetRef="ret" />
    <bpmn:sequenceFlow id="f-immediate-inform" name="no" sourceRef="immediate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-ret-present" sourceRef="ret" targetRef="present" />
    <bpmn:sequenceFlow id="f-present-view" sourceRef="present" targetRef="view" />
    <bpmn:sequenceFlow id="f-view-done" sourceRef="view" targetRef="done" />
    <bpmn:sequenceFlow id="f-inform-split" sourceRef="inform" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-delay" sourceRef="split" targetRef="delay" />
    <bpmn:sequenceFlow id="f-split-level2" sourceRef="split" targetRef="level2" />
    <bpmn:sequenceFlow id="f-level2-back" sourceRef="level2" targetRef="back" />
    <bpmn:sequenceFlow id="f-delay-joined" sourceRef="delay" targetRef="joined" />
    <bpmn:sequenceFlow id="f-back-joined" sourceRef="back" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-display" sourceRef="joined" targetRef="display" />
    <bpmn:sequenceFlow id="f-display-done2" sourceRef="display" targetRef="done2" />
  </bpmn:process>
</bpmn:definitions>
