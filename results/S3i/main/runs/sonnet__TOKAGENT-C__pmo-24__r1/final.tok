tok 1.0 "Restaurant"

pool restaurant "Restaurant"
  lane guest "Guest"
    start hungry "Guest feels hungry"
    task enter "Enter the restaurant"
    task choose "Choose a dish"
    task wait "Wait for his turn"
    task order "Place the order"
    task pickup "Pick up the meal"
    task eat "Eat the meal"
    end done "Meal eaten"
  lane employee "Employee"
    task enterorder "Enter the order into the POS system"
    task collect "Collect the money"
    task setup "Set up the buzzer"
    task pass "Pass the buzzer on to the guest"
    task informchef "Inform the chef of the new order"
    task setoff "Set off the buzzer"
    eventgw wait2
    catch appears "Guest appears at the service hatch" message="Guest at hatch"
    catch five "5 minutes passed" timer=PT5M
    task callguest "Call for the guest"
    task handover "Hand over the meal"
  lane chef "Chef"
    task prepare "Prepare the meal"
    task place "Place the meal in the service hatch"
    task informemp "Inform the employee that the meal is ready"

flow hungry -> enter -> choose -> wait -> order -> enterorder -> collect -> setup -> pass -> informchef -> prepare -> place -> informemp -> setoff -> wait2
flow wait2 -> appears -> handover -> pickup -> eat -> done
flow wait2 -> five -> callguest -> wait2
