tok 1.0 "Find a Job"

pool p "Job search"
  lane applicant "Job applicant"
    start s "Job search started"
    task report "Report job applications"
    task offers "Receive new job offers"
    task negotiate "Negotiate job interview"
    task probation "Enter probation phase"
    and split
    task rateco "Rate the company"
    and join
    xor permanent "Job permanent?"
    xor low "Company rated C or less?"
    task cont "Continue to receive job offers"
    end e1 "Process ended"
    end e2 "Process ended without job"
    end e3 "Receiving offers ended"
  lane company "Company"
    task confirm "Confirm receipt of application"
    task rateapp "Rate the application"
    xor want "Company wants applicant?"
    task rateappl "Rate the applicant"

flow s -> report -> confirm -> rateapp -> offers -> negotiate -> want
flow want -> probation "yes"
flow want -> e2 "no"
flow probation -> split
flow split -> rateco
flow split -> rateappl
flow rateco -> join
flow rateappl -> join
flow join -> permanent
flow permanent -> low "yes"
flow permanent -> e2 "no"
flow low -> cont "yes"
flow low -> e1 "no"
flow cont -> e3
