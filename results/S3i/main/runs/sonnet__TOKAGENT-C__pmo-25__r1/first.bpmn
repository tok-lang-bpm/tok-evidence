<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Find a Job" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Job search" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Find a Job" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="applicant" name="Job applicant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateapp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>want</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateappl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Job search started" />
    <bpmn:task id="report" name="Report job applications" />
    <bpmn:task id="offers" name="Receive new job offers" />
    <bpmn:task id="negotiate" name="Negotiate job interview" />
    <bpmn:task id="probation" name="Enter probation phase" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="rateco" name="Rate the company" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="permanent" name="Job permanent?" />
    <bpmn:exclusiveGateway id="low" name="Company rated C or less?" />
    <bpmn:task id="cont" name="Continue to receive job offers" />
    <bpmn:endEvent id="e1" name="Process ended" />
    <bpmn:endEvent id="e2" name="Process ended without job" />
    <bpmn:endEvent id="e3" name="Receiving offers ended" />
    <bpmn:task id="confirm" name="Confirm receipt of application" />
    <bpmn:task id="rateapp" name="Rate the application" />
    <bpmn:exclusiveGateway id="want" name="Company wants applicant?" />
    <bpmn:task id="rateappl" name="Rate the applicant" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-confirm" sourceRef="report" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-rateapp" sourceRef="confirm" targetRef="rateapp" />
    <bpmn:sequenceFlow id="f-rateapp-offers" sourceRef="rateapp" targetRef="offers" />
    <bpmn:sequenceFlow id="f-offers-negotiate" sourceRef="offers" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-want" sourceRef="negotiate" targetRef="want" />
    <bpmn:sequenceFlow id="f-want-probation" name="yes" sourceRef="want" targetRef="probation" />
    <bpmn:sequenceFlow id="f-want-e2" name="no" sourceRef="want" targetRef="e2" />
    <bpmn:sequenceFlow id="f-probation-split" sourceRef="probation" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-rateco" sourceRef="split" targetRef="rateco" />
    <bpmn:sequenceFlow id="f-split-rateappl" sourceRef="split" targetRef="rateappl" />
    <bpmn:sequenceFlow id="f-rateco-join" sourceRef="rateco" targetRef="join" />
    <bpmn:sequenceFlow id="f-rateappl-join" sourceRef="rateappl" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-permanent" sourceRef="join" targetRef="permanent" />
    <bpmn:sequenceFlow id="f-permanent-low" name="yes" sourceRef="permanent" targetRef="low" />
    <bpmn:sequenceFlow id="f-permanent-e2" name="no" sourceRef="permanent" targetRef="e2" />
    <bpmn:sequenceFlow id="f-low-cont" name="yes" sourceRef="low" targetRef="cont" />
    <bpmn:sequenceFlow id="f-low-e1" name="no" sourceRef="low" targetRef="e1" />
    <bpmn:sequenceFlow id="f-cont-e3" sourceRef="cont" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>
