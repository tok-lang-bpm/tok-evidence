<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Becoming a parent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Maternity leave support" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Becoming a parent" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Leave system">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extendleave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Leave planning needed" />
    <bpmn:task id="select" name="Select a model" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="decide" name="Decide about extension" />
    <bpmn:exclusiveGateway id="extend" name="Extend the leave?" />
    <bpmn:endEvent id="done" name="Leave ended" />
    <bpmn:task id="fetch" name="Fetch information about potential models" />
    <bpmn:parallelGateway id="notify" />
    <bpmn:task id="nss" name="Notify Social Security" />
    <bpmn:task id="nco" name="Notify Company" />
    <bpmn:parallelGateway id="notified" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:task id="extendleave" name="Extend the leave" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:sequenceFlow id="f-begin-fetch" sourceRef="begin" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-select" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-collect" sourceRef="select" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-notify" sourceRef="collect" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-nss" sourceRef="notify" targetRef="nss" />
    <bpmn:sequenceFlow id="f-nss-notified" sourceRef="nss" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notify-nco" sourceRef="notify" targetRef="nco" />
    <bpmn:sequenceFlow id="f-nco-notified" sourceRef="nco" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notified-gather" sourceRef="notified" targetRef="gather" />
    <bpmn:sequenceFlow id="f-gather-decide" sourceRef="gather" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-extend" sourceRef="decide" targetRef="extend" />
    <bpmn:sequenceFlow id="f-extend-extendleave" name="yes" sourceRef="extend" targetRef="extendleave" />
    <bpmn:sequenceFlow id="f-extend-done" name="no" sourceRef="extend" targetRef="done" />
    <bpmn:sequenceFlow id="f-extendleave-done" sourceRef="extendleave" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
