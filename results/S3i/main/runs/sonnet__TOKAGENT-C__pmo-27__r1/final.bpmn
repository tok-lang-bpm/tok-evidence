<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Work Accident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Work Accident" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>unable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="accident" name="Work accident or near accident occurred" />
    <bpmn:task id="inform" name="Inform the employer" />
    <bpmn:task id="record" name="Record the accident" />
    <bpmn:exclusiveGateway id="serious" name="Fatality or serious injury not reported to emergency services?" default="f-serious-merge" />
    <bpmn:task id="labour" name="Report the accident to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:exclusiveGateway id="unable" name="Insured person killed or unable to work for three days?" default="f-unable-closed" />
    <bpmn:task id="insurer" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:endEvent id="reported" name="Accident reported" />
    <bpmn:endEvent id="closed" name="Accident recorded" />
    <bpmn:sequenceFlow id="f-accident-inform" sourceRef="accident" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-record" sourceRef="inform" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-serious" sourceRef="record" targetRef="serious" />
    <bpmn:sequenceFlow id="f-serious-labour" name="yes" sourceRef="serious" targetRef="labour">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">seriousInjury = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-serious-merge" name="no" sourceRef="serious" targetRef="merge" />
    <bpmn:sequenceFlow id="f-labour-merge" sourceRef="labour" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-unable" sourceRef="merge" targetRef="unable" />
    <bpmn:sequenceFlow id="f-unable-insurer" name="yes" sourceRef="unable" targetRef="insurer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">unableToWork = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-unable-closed" name="no" sourceRef="unable" targetRef="closed" />
    <bpmn:sequenceFlow id="f-insurer-reported" sourceRef="insurer" targetRef="reported" />
  </bpmn:process>
</bpmn:definitions>
