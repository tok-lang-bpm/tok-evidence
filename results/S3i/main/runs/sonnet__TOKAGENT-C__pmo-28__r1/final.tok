tok 1.0 "Internship"

pool org "Internship"
  lane student "Student"
    start begin "Internship wanted"
    task topic "Enter topic and desired money"
    task exp "Enter experience and hobbies"
    xor again
    receive offer "Receive offer" message="Offer"
    xor decide "Accept offer?"
    task deny "Deny offer"
    task accept "Accept offer"
    and split
    task write "Write status update" loop while="count < 3"
    and join
    task finish "Finish internship"
    task tweet "Send tweet to friend" parallel
    end done "Recommendation sent"
  lane company "Company"
    task cwrite "Write status update about student" loop while="count < 3"

flow begin -> topic -> exp -> again -> offer -> decide
flow decide -> accept "accept"
flow decide -> deny "deny"
flow deny -> again
flow accept -> split
flow split -> write
flow split -> cwrite
flow write -> join
flow cwrite -> join
flow join -> finish -> tweet -> done
