<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Internship" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Offer" name="Offer" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Internship" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Internship" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>cwrite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Internship wanted" />
    <bpmn:task id="topic" name="Enter topic and desired money" />
    <bpmn:task id="exp" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:receiveTask id="offer" name="Receive offer" messageRef="Message_Offer" />
    <bpmn:exclusiveGateway id="decide" name="Accept offer?" />
    <bpmn:task id="deny" name="Deny offer" />
    <bpmn:task id="accept" name="Accept offer" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="write" name="Write status update">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">count &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="finish" name="Finish internship" />
    <bpmn:task id="tweet" name="Send tweet to friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="done" name="Recommendation sent" />
    <bpmn:task id="cwrite" name="Write status update about student">
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">count &lt; 3</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:task>
    <bpmn:sequenceFlow id="f-begin-topic" sourceRef="begin" targetRef="topic" />
    <bpmn:sequenceFlow id="f-topic-exp" sourceRef="topic" targetRef="exp" />
    <bpmn:sequenceFlow id="f-exp-again" sourceRef="exp" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-offer" sourceRef="again" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-decide" sourceRef="offer" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-accept" name="accept" sourceRef="decide" targetRef="accept" />
    <bpmn:sequenceFlow id="f-decide-deny" name="deny" sourceRef="decide" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-again" sourceRef="deny" targetRef="again" />
    <bpmn:sequenceFlow id="f-accept-split" sourceRef="accept" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-write" sourceRef="split" targetRef="write" />
    <bpmn:sequenceFlow id="f-split-cwrite" sourceRef="split" targetRef="cwrite" />
    <bpmn:sequenceFlow id="f-write-join" sourceRef="write" targetRef="join" />
    <bpmn:sequenceFlow id="f-cwrite-join" sourceRef="cwrite" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-finish" sourceRef="join" targetRef="finish" />
    <bpmn:sequenceFlow id="f-finish-tweet" sourceRef="finish" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-tweet-done" sourceRef="tweet" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
