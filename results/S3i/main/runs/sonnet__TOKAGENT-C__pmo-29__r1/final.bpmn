<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Work and Live in Austria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="austria" name="Work and Live in Austria" processRef="austria-process" />
  </bpmn:collaboration>
  <bpmn:process id="austria-process" name="Work and Live in Austria" isExecutable="false">
    <bpmn:laneSet id="austria-lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>competent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>living</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="office" name="Representation office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Move to Austria planned" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="accommodation" name="Organize accommodation" />
    <bpmn:task id="bank" name="Open bank account" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="check" name="Check the visa requirements" />
    <bpmn:task id="competent" name="Determine the competent representation office" />
    <bpmn:task id="prepare" name="Prepare the visa documents" />
    <bpmn:task id="submit" name="Submit the visa application" />
    <bpmn:endEvent id="living" name="Living and working in Austria" />
    <bpmn:task id="review" name="Review the application" />
    <bpmn:exclusiveGateway id="complete" name="Application complete and no grounds for refusal?" />
    <bpmn:task id="issue" name="Issue the Rot-Weiss-Rot visa" />
    <bpmn:endEvent id="refused" name="Visa refused" />
    <bpmn:sequenceFlow id="f-needed-split" sourceRef="needed" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-accommodation" sourceRef="split" targetRef="accommodation" />
    <bpmn:sequenceFlow id="f-accommodation-joined" sourceRef="accommodation" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-bank" sourceRef="split" targetRef="bank" />
    <bpmn:sequenceFlow id="f-bank-joined" sourceRef="bank" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-check" sourceRef="joined" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-competent" sourceRef="check" targetRef="competent" />
    <bpmn:sequenceFlow id="f-competent-prepare" sourceRef="competent" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-submit" sourceRef="prepare" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-complete" sourceRef="review" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-issue" name="yes" sourceRef="complete" targetRef="issue" />
    <bpmn:sequenceFlow id="f-complete-refused" name="no" sourceRef="complete" targetRef="refused" />
    <bpmn:sequenceFlow id="f-issue-living" sourceRef="issue" targetRef="living" />
  </bpmn:process>
</bpmn:definitions>
