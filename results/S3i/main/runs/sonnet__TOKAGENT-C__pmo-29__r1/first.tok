tok 1.0 "Work and Live in Austria"

pool austria "Work and Live in Austria"
  lane applicant "Applicant"
    start needed "Move to Austria planned"
    and split
    task accommodation "Organize accommodation"
    task bank "Open bank account"
    and joined
    task check "Check the visa requirements"
    task competent "Determine the competent representation office"
    task prepare "Prepare the visa documents"
    task submit "Submit the visa application"
    end living "Living and working in Austria"
  lane office "Representation office"
    task review "Review the application"
    xor complete "Application complete and no grounds for refusal?"
    task issue "Issue the Rot-Weiss-Rot visa"
    end refused "Visa refused"

flow needed -> split
flow split -> accommodation -> joined
flow split -> bank -> joined
flow joined -> check -> competent -> prepare -> submit -> review -> complete
flow complete -> issue "yes"
flow complete -> refused "no"
flow issue -> living
