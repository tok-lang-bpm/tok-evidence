tok 1.0 "LAN Party"

pool org "LAN party"
  lane host "Host"
    start begin "LAN party planned"
    task invite "Send invitations to the friends"
    task ask "Find out which games they want to play"
    task receive "Receive the list of games"
    and split
    xor again
    task appoint "Appoint a date"
    xor agree "8 or more people agree?"
    task check "Find out if you have all the games"
    xor missing "Games missing?"
    task download "Download the missing games"
    xor gamesok
    and joined
    task beer "Find out how much beer is required"
    xor enough "Enough beer?"
    task buy "Buy the missing beer"
    xor beerok
    task enjoy "Enjoy the LAN party"
    end done "LAN party held"

flow begin -> invite -> ask -> receive -> split
flow split -> again
flow again -> appoint -> agree
flow agree -> joined "yes"
flow agree -> again "no"
flow split -> check -> missing
flow missing -> download "yes"
flow download -> gamesok
flow missing -> gamesok "no"
flow gamesok -> joined
flow joined -> beer -> enough
flow enough -> buy "no"
flow buy -> beerok
flow enough -> beerok "yes"
flow beerok -> enjoy -> done
