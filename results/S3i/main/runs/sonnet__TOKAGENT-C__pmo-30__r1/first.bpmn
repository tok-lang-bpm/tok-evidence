<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="LAN Party" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="LAN party" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="LAN Party" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="host" name="Host">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gamesok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beerok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="LAN party planned" />
    <bpmn:task id="invite" name="Send invitations to the friends" />
    <bpmn:task id="ask" name="Find out which games they want to play" />
    <bpmn:task id="receive" name="Receive the list of games" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="appoint" name="Appoint a date" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree?" />
    <bpmn:task id="check" name="Find out if you have all the games" />
    <bpmn:exclusiveGateway id="missing" name="Games missing?" />
    <bpmn:task id="download" name="Download the missing games" />
    <bpmn:exclusiveGateway id="gamesok" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="beer" name="Find out how much beer is required" />
    <bpmn:exclusiveGateway id="enough" name="Enough beer?" />
    <bpmn:task id="buy" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="beerok" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="done" name="LAN party held" />
    <bpmn:sequenceFlow id="f-begin-invite" sourceRef="begin" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-ask" sourceRef="invite" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-receive" sourceRef="ask" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-split" sourceRef="receive" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-again" sourceRef="split" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-appoint" sourceRef="again" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-agree" sourceRef="appoint" targetRef="agree" />
    <bpmn:sequenceFlow id="f-agree-joined" name="yes" sourceRef="agree" targetRef="joined" />
    <bpmn:sequenceFlow id="f-agree-again" name="no" sourceRef="agree" targetRef="again" />
    <bpmn:sequenceFlow id="f-split-check" sourceRef="split" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-download" name="yes" sourceRef="missing" targetRef="download" />
    <bpmn:sequenceFlow id="f-download-gamesok" sourceRef="download" targetRef="gamesok" />
    <bpmn:sequenceFlow id="f-missing-gamesok" name="no" sourceRef="missing" targetRef="gamesok" />
    <bpmn:sequenceFlow id="f-gamesok-joined" sourceRef="gamesok" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-beer" sourceRef="joined" targetRef="beer" />
    <bpmn:sequenceFlow id="f-beer-enough" sourceRef="beer" targetRef="enough" />
    <bpmn:sequenceFlow id="f-enough-buy" name="no" sourceRef="enough" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-beerok" sourceRef="buy" targetRef="beerok" />
    <bpmn:sequenceFlow id="f-enough-beerok" name="yes" sourceRef="enough" targetRef="beerok" />
    <bpmn:sequenceFlow id="f-beerok-enjoy" sourceRef="beerok" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f-enjoy-done" sourceRef="enjoy" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
