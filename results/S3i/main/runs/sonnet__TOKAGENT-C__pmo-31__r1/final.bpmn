<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Character generator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="blizzard" name="Blizzard online character generator" processRef="blizzard-process" />
  </bpmn:collaboration>
  <bpmn:process id="blizzard-process" name="Character generator" isExecutable="false">
    <bpmn:laneSet id="blizzard-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasacc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checksub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hassub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paymerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entername</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Character creation started" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="names" name="Come up with character names" />
    <bpmn:task id="checkacc" name="Check for battle.net account" />
    <bpmn:exclusiveGateway id="hasacc" name="Battle.net account?" />
    <bpmn:task id="info" name="Enter the account information" />
    <bpmn:task id="link" name="Click the link in the confirmation mail" />
    <bpmn:exclusiveGateway id="accmerge" />
    <bpmn:task id="checksub" name="Check for active WoW subscription" />
    <bpmn:exclusiveGateway id="hassub" name="Active subscription?" />
    <bpmn:task id="pay" name="Select the payment method" />
    <bpmn:exclusiveGateway id="method" name="Payment method?" />
    <bpmn:task id="card" name="Enter the credit card information" />
    <bpmn:task id="iban" name="Enter the IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="paymerge" />
    <bpmn:exclusiveGateway id="submerge" />
    <bpmn:task id="login" name="Log into the game" />
    <bpmn:task id="select" name="Select realm, race and class" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="entername" name="Enter a name" />
    <bpmn:exclusiveGateway id="avail" name="Name available?" />
    <bpmn:task id="confirm" name="Send confirmation and selfies" />
    <bpmn:endEvent id="done" name="Character created" />
    <bpmn:sequenceFlow id="f-begin-split" sourceRef="begin" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-names" sourceRef="split" targetRef="names" />
    <bpmn:sequenceFlow id="f-split-checkacc" sourceRef="split" targetRef="checkacc" />
    <bpmn:sequenceFlow id="f-checkacc-hasacc" sourceRef="checkacc" targetRef="hasacc" />
    <bpmn:sequenceFlow id="f-hasacc-info" name="no" sourceRef="hasacc" targetRef="info" />
    <bpmn:sequenceFlow id="f-hasacc-accmerge" name="yes" sourceRef="hasacc" targetRef="accmerge" />
    <bpmn:sequenceFlow id="f-info-link" sourceRef="info" targetRef="link" />
    <bpmn:sequenceFlow id="f-link-accmerge" sourceRef="link" targetRef="accmerge" />
    <bpmn:sequenceFlow id="f-accmerge-checksub" sourceRef="accmerge" targetRef="checksub" />
    <bpmn:sequenceFlow id="f-checksub-hassub" sourceRef="checksub" targetRef="hassub" />
    <bpmn:sequenceFlow id="f-hassub-pay" name="no" sourceRef="hassub" targetRef="pay" />
    <bpmn:sequenceFlow id="f-hassub-submerge" name="yes" sourceRef="hassub" targetRef="submerge" />
    <bpmn:sequenceFlow id="f-pay-method" sourceRef="pay" targetRef="method" />
    <bpmn:sequenceFlow id="f-method-card" name="credit card" sourceRef="method" targetRef="card" />
    <bpmn:sequenceFlow id="f-method-iban" name="bank account" sourceRef="method" targetRef="iban" />
    <bpmn:sequenceFlow id="f-card-paymerge" sourceRef="card" targetRef="paymerge" />
    <bpmn:sequenceFlow id="f-iban-paymerge" sourceRef="iban" targetRef="paymerge" />
    <bpmn:sequenceFlow id="f-paymerge-submerge" sourceRef="paymerge" targetRef="submerge" />
    <bpmn:sequenceFlow id="f-submerge-login" sourceRef="submerge" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-select" sourceRef="login" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-join" sourceRef="select" targetRef="join" />
    <bpmn:sequenceFlow id="f-names-join" sourceRef="names" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-entername" sourceRef="join" targetRef="entername" />
    <bpmn:sequenceFlow id="f-entername-avail" sourceRef="entername" targetRef="avail" />
    <bpmn:sequenceFlow id="f-avail-confirm" name="yes" sourceRef="avail" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-avail-entername" name="no" sourceRef="avail" targetRef="entername" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
