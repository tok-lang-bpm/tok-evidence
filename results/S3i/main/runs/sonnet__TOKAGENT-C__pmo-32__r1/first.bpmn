<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Farming Bot" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="game" name="Farming game" processRef="game-process" />
  </bpmn:collaboration>
  <bpmn:process id="game-process" name="Farming Bot" isExecutable="false">
    <bpmn:laneSet id="game-lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noshare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bot" name="Bot">
        <bpmn:flowNodeRef>farm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Bot wanted" />
    <bpmn:task id="find" name="Find out the wanted resources" />
    <bpmn:task id="prio" name="Set the urgency of the resources" />
    <bpmn:task id="deps" name="Define the dependencies of the resources" />
    <bpmn:task id="update" name="Update the list of resources" />
    <bpmn:exclusiveGateway id="share" name="Share with friends?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="brag" name="Brag to selected friends" />
    <bpmn:task id="send" name="Send materials to selected friends" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:endEvent id="done" name="Bot finished" />
    <bpmn:endEvent id="noshare" name="Bot finished without sharing" />
    <bpmn:task id="farm" name="Farm the resources" />
    <bpmn:task id="disaster" name="Handle the natural disaster" />
    <bpmn:task id="notify" name="Notify the player of the milestone" />
    <bpmn:sequenceFlow id="f-begin-find" sourceRef="begin" targetRef="find" />
    <bpmn:sequenceFlow id="f-find-prio" sourceRef="find" targetRef="prio" />
    <bpmn:sequenceFlow id="f-prio-deps" sourceRef="prio" targetRef="deps" />
    <bpmn:sequenceFlow id="f-deps-farm" sourceRef="deps" targetRef="farm" />
    <bpmn:sequenceFlow id="f-farm-share" sourceRef="farm" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-split" name="yes" sourceRef="share" targetRef="split" />
    <bpmn:sequenceFlow id="f-share-noshare" name="no" sourceRef="share" targetRef="noshare" />
    <bpmn:sequenceFlow id="f-split-brag" sourceRef="split" targetRef="brag" />
    <bpmn:sequenceFlow id="f-split-send" sourceRef="split" targetRef="send" />
    <bpmn:sequenceFlow id="f-brag-joined" sourceRef="brag" targetRef="joined" />
    <bpmn:sequenceFlow id="f-send-joined" sourceRef="send" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-done" sourceRef="joined" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
