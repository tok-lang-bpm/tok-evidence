<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="3D model printing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Customer" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="3D model printing" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="cust" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sketch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkleft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Model needed" />
    <bpmn:task id="sketch" name="Send sketches to the artist" />
    <bpmn:task id="change" name="Tell the artist what to change" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with the result?" />
    <bpmn:task id="choose" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="instock" name="Color in stock?" />
    <bpmn:task id="checkleft" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under" name="Under 100 grams?" />
    <bpmn:task id="list" name="Put the color on the shopping list" />
    <bpmn:task id="order" name="Order the color" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="heat" name="Turn on the printer and heat up the bed and extruder" />
    <bpmn:task id="gcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="print" name="Print the model" />
    <bpmn:endEvent id="e" name="Model printed" />
    <bpmn:sequenceFlow id="f-s-sketch" sourceRef="s" targetRef="sketch" />
    <bpmn:sequenceFlow id="f-sketch-change" sourceRef="sketch" targetRef="change" />
    <bpmn:sequenceFlow id="f-change-satisfied" sourceRef="change" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f-satisfied-change" name="no" sourceRef="satisfied" targetRef="change" />
    <bpmn:sequenceFlow id="f-satisfied-choose" name="yes" sourceRef="satisfied" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-instock" sourceRef="choose" targetRef="instock" />
    <bpmn:sequenceFlow id="f-instock-checkleft" name="yes" sourceRef="instock" targetRef="checkleft" />
    <bpmn:sequenceFlow id="f-instock-order" name="no" sourceRef="instock" targetRef="order" />
    <bpmn:sequenceFlow id="f-checkleft-under" sourceRef="checkleft" targetRef="under" />
    <bpmn:sequenceFlow id="f-under-list" name="yes" sourceRef="under" targetRef="list" />
    <bpmn:sequenceFlow id="f-under-merge1" name="no" sourceRef="under" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-list-merge1" sourceRef="list" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-merge2" sourceRef="merge1" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-order-merge2" sourceRef="order" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-merge2-split" sourceRef="merge2" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-heat" sourceRef="split" targetRef="heat" />
    <bpmn:sequenceFlow id="f-split-gcode" sourceRef="split" targetRef="gcode" />
    <bpmn:sequenceFlow id="f-heat-join" sourceRef="heat" targetRef="join" />
    <bpmn:sequenceFlow id="f-gcode-join" sourceRef="gcode" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-print" sourceRef="join" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-e" sourceRef="print" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
