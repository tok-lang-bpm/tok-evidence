tok 1.0 "Building a custom machine out of Lego bricks"

pool org "Lego workshop"
  lane builder "Builder"
    start begin "Machine needed"
    task design "Develop the basic design"
    task order "Order the Lego brick sets"
    task give "Give the Lego sets to the children"
    xor again
    xor parts "Parts left in the container?"
    task reorder "Reorder individual parts"
    xor ready
    task build "Build the subcomponent"
    task test "Test the subcomponent"
    xor ok "Test successful?"
    task redesign "Redesign the subcomponent"
    task assemble "Assemble the subcomponents"
    end done "Machine built"
  lane children "Children"
    task sort "Sort the parts into containers"

flow begin -> design -> order -> give -> sort -> again -> parts
flow parts -> reorder "no"
flow parts -> ready "yes"
flow reorder -> ready
flow ready -> build -> test -> ok
flow ok -> assemble "yes"
flow ok -> redesign "no"
flow redesign -> again
flow assemble -> done
