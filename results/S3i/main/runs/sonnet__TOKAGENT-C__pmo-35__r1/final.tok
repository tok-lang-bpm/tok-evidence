tok 1.0 "Chainsaw"

pool shop "Chainsaw producer"
  lane customer "Customer"
    start wish "Customer wants a chainsaw"
    task tell "Tell the properties"
    task try "Try the first saw"
    xor likes "Customer likes the saw?"
  lane producer "Producer"
    and order "Order parts"
    task orderA "Order parts from online source 1"
    task orderB "Order parts from online source 2"
    and ordered
    task inspect "Inspect all parts manually"
    and produce
    task assemble "Assemble the parts"
    task update "Send updates to the customer"
    and produced
    task sendFirst "Send the first saw to the customer"
    task rest "Produce the rest of the order"
    end done "Order completed"
    end stopped "Order stopped"

flow wish -> tell -> order
flow order -> orderA -> ordered
flow order -> orderB -> ordered
flow ordered -> inspect -> produce
flow produce -> assemble -> produced
flow produce -> update -> produced
flow produced -> sendFirst -> try -> likes
flow likes -> rest "yes"
flow likes -> stopped "no"
flow rest -> done
