<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Chainsaw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Chainsaw producer" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Chainsaw" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>try</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orderB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wish" name="Customer wants a chainsaw" />
    <bpmn:task id="tell" name="Tell the properties" />
    <bpmn:task id="try" name="Try the first saw" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes the saw?" />
    <bpmn:parallelGateway id="order" name="Order parts" />
    <bpmn:task id="orderA" name="Order parts from online source 1" />
    <bpmn:task id="orderB" name="Order parts from online source 2" />
    <bpmn:parallelGateway id="ordered" />
    <bpmn:task id="inspect" name="Inspect all parts manually" />
    <bpmn:parallelGateway id="produce" />
    <bpmn:task id="assemble" name="Assemble the parts" />
    <bpmn:task id="update" name="Send updates to the customer" />
    <bpmn:parallelGateway id="produced" />
    <bpmn:task id="sendFirst" name="Send the first saw to the customer" />
    <bpmn:task id="rest" name="Produce the rest of the order" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:endEvent id="stopped" name="Order stopped" />
    <bpmn:sequenceFlow id="f-wish-tell" sourceRef="wish" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-order" sourceRef="tell" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-orderA" sourceRef="order" targetRef="orderA" />
    <bpmn:sequenceFlow id="f-orderA-ordered" sourceRef="orderA" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-order-orderB" sourceRef="order" targetRef="orderB" />
    <bpmn:sequenceFlow id="f-orderB-ordered" sourceRef="orderB" targetRef="ordered" />
    <bpmn:sequenceFlow id="f-ordered-inspect" sourceRef="ordered" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-produce" sourceRef="inspect" targetRef="produce" />
    <bpmn:sequenceFlow id="f-produce-assemble" sourceRef="produce" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-produced" sourceRef="assemble" targetRef="produced" />
    <bpmn:sequenceFlow id="f-produce-update" sourceRef="produce" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-produced" sourceRef="update" targetRef="produced" />
    <bpmn:sequenceFlow id="f-produced-sendFirst" sourceRef="produced" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f-sendFirst-try" sourceRef="sendFirst" targetRef="try" />
    <bpmn:sequenceFlow id="f-try-likes" sourceRef="try" targetRef="likes" />
    <bpmn:sequenceFlow id="f-likes-rest" name="yes" sourceRef="likes" targetRef="rest" />
    <bpmn:sequenceFlow id="f-likes-stopped" name="no" sourceRef="likes" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-rest-done" sourceRef="rest" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
