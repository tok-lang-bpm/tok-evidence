<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Luxury Airplane" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="maker" name="Airplane manufacturer" processRef="maker-process" />
  </bpmn:collaboration>
  <bpmn:process id="maker-process" name="Luxury Airplane" isExecutable="false">
    <bpmn:laneSet id="maker-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Manufacturer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>testflight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendprotocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="teams" name="Manufacturing teams">
        <bpmn:flowNodeRef>vodka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>whiskey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seats</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wish" name="Customer wants an airplane" />
    <bpmn:task id="specify" name="Decide the interior specifications" />
    <bpmn:task id="confirm" name="Confirm the delivery" />
    <bpmn:endEvent id="done" name="Airplane accepted" />
    <bpmn:task id="receive" name="Receive the specifications" />
    <bpmn:task id="send" name="Send the requirements to the teams" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="assemble" name="Assemble the interior" />
    <bpmn:task id="testflight" name="Perform the test flight" />
    <bpmn:task id="protocol" name="Create the test protocol" />
    <bpmn:task id="sendprotocol" name="Send the test protocol to the customer" />
    <bpmn:task id="deliver" name="Deliver the plane" />
    <bpmn:task id="vodka" name="Manufacture the vodka bar" />
    <bpmn:task id="whiskey" name="Manufacture the whiskey bar" />
    <bpmn:task id="seats" name="Manufacture the seats" />
    <bpmn:sequenceFlow id="f-wish-specify" sourceRef="wish" targetRef="specify" />
    <bpmn:sequenceFlow id="f-specify-receive" sourceRef="specify" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-send" sourceRef="receive" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-split" sourceRef="send" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-vodka" sourceRef="split" targetRef="vodka" />
    <bpmn:sequenceFlow id="f-split-whiskey" sourceRef="split" targetRef="whiskey" />
    <bpmn:sequenceFlow id="f-split-seats" sourceRef="split" targetRef="seats" />
    <bpmn:sequenceFlow id="f-vodka-joined" sourceRef="vodka" targetRef="joined" />
    <bpmn:sequenceFlow id="f-whiskey-joined" sourceRef="whiskey" targetRef="joined" />
    <bpmn:sequenceFlow id="f-seats-joined" sourceRef="seats" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-assemble" sourceRef="joined" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-testflight" sourceRef="assemble" targetRef="testflight" />
    <bpmn:sequenceFlow id="f-testflight-protocol" sourceRef="testflight" targetRef="protocol" />
    <bpmn:sequenceFlow id="f-protocol-sendprotocol" sourceRef="protocol" targetRef="sendprotocol" />
    <bpmn:sequenceFlow id="f-sendprotocol-deliver" sourceRef="sendprotocol" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-confirm" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-done" sourceRef="confirm" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
