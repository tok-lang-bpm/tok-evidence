tok 1.0 "Luxury Airplane"

pool maker "Airplane manufacturer"
  lane customer "Customer"
    start wish "Customer wants an airplane"
    task specify "Decide the interior specifications"
    task confirm "Confirm the delivery"
    end done "Airplane accepted"
  lane sales "Manufacturer"
    task receive "Receive the specifications"
    task send "Send the requirements to the teams"
    and split
    and joined
    task assemble "Assemble the interior"
    task testflight "Perform the test flight"
    task protocol "Create the test protocol"
    task sendprotocol "Send the test protocol to the customer"
    task deliver "Deliver the plane"
  lane teams "Manufacturing teams"
    task vodka "Manufacture the vodka bar"
    task whiskey "Manufacture the whiskey bar"
    task seats "Manufacture the seats"

flow wish -> specify -> receive -> send -> split
flow split -> vodka
flow split -> whiskey
flow split -> seats
flow vodka -> joined
flow whiskey -> joined
flow seats -> joined
flow joined -> assemble -> testflight -> protocol -> sendprotocol -> deliver -> confirm -> done
