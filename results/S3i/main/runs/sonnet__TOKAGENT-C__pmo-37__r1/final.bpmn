<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Contract project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Contract" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Parts needed" />
    <bpmn:task id="query" name="Query the web shops" />
    <bpmn:task id="list" name="Create a list of parts to order from each shop" />
    <bpmn:task id="order" name="Order the cheapest parts" />
    <bpmn:task id="arrive" name="Receive the first parts" />
    <bpmn:task id="build" name="Start building" />
    <bpmn:task id="check" name="Check the stock of a part" />
    <bpmn:exclusiveGateway id="s5" name="Stock below 5?" />
    <bpmn:task id="cheap" name="Reorder the cheapest parts" />
    <bpmn:exclusiveGateway id="s3" name="Stock below 3?" />
    <bpmn:task id="fast" name="Reorder the fastest parts" />
    <bpmn:exclusiveGateway id="s0" name="Stock zero?" />
    <bpmn:task id="mail" name="Write a mail to friends complaining about the webshops" />
    <bpmn:endEvent id="done" name="Building continues" />
    <bpmn:endEvent id="done2" name="Stock sufficient" />
    <bpmn:endEvent id="done3" name="Stock reordered" />
    <bpmn:endEvent id="done4" name="Complaint sent" />
    <bpmn:sequenceFlow id="f-begin-query" sourceRef="begin" targetRef="query" />
    <bpmn:sequenceFlow id="f-query-list" sourceRef="query" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-order" sourceRef="list" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-arrive" sourceRef="order" targetRef="arrive" />
    <bpmn:sequenceFlow id="f-arrive-build" sourceRef="arrive" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-check" sourceRef="build" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-s5" sourceRef="check" targetRef="s5" />
    <bpmn:sequenceFlow id="f-s5-cheap" name="yes" sourceRef="s5" targetRef="cheap" />
    <bpmn:sequenceFlow id="f-s5-done2" name="no" sourceRef="s5" targetRef="done2" />
    <bpmn:sequenceFlow id="f-cheap-s3" sourceRef="cheap" targetRef="s3" />
    <bpmn:sequenceFlow id="f-s3-fast" name="yes" sourceRef="s3" targetRef="fast" />
    <bpmn:sequenceFlow id="f-s3-done3" name="no" sourceRef="s3" targetRef="done3" />
    <bpmn:sequenceFlow id="f-fast-s0" sourceRef="fast" targetRef="s0" />
    <bpmn:sequenceFlow id="f-s0-mail" name="yes" sourceRef="s0" targetRef="mail" />
    <bpmn:sequenceFlow id="f-s0-done" name="no" sourceRef="s0" targetRef="done" />
    <bpmn:sequenceFlow id="f-mail-done4" sourceRef="mail" targetRef="done4" />
  </bpmn:process>
</bpmn:definitions>
