tok 1.0 "Contract"

pool org "Contract project"
  lane builder "Builder"
    start begin "Parts needed"
    task query "Query the web shops"
    task list "Create a list of parts to order from each shop"
    task order "Order the cheapest parts"
    task arrive "Receive the first parts"
    task build "Start building"
    task check "Check the stock of a part"
    xor s5 "Stock below 5?"
    task cheap "Reorder the cheapest parts"
    xor s3 "Stock below 3?"
    task fast "Reorder the fastest parts"
    xor s0 "Stock zero?"
    task mail "Write a mail to friends complaining about the webshops"
    end done "Building continues"
    end done2 "Stock sufficient"
    end done3 "Stock reordered"
    end done4 "Complaint sent"

flow begin -> query -> list -> order -> arrive -> build -> check -> s5
flow s5 -> cheap "yes"
flow s5 -> done2 "no"
flow cheap -> s3
flow s3 -> fast "yes"
flow s3 -> done3 "no"
flow fast -> s0
flow s0 -> mail "yes"
flow s0 -> done "no"
flow mail -> done4
