<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Building a House" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Tree house project" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Building a House" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="architect" name="Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Want to build a tree house" />
    <bpmn:task id="collect" name="Collect the requirements" />
    <bpmn:task id="sendreq" name="Send the requirements to the architect" />
    <bpmn:task id="refine" name="Refine the draft with additional requirements">
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="list" name="Create the list of needed materials" />
    <bpmn:task id="order" name="Order the materials from the online stores">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:task id="message" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="build" name="Build the house" />
    <bpmn:task id="invite" name="Send invitations for the party" />
    <bpmn:task id="attendees" name="Create the list of people that attend the party" />
    <bpmn:task id="snacks" name="Buy the snacks" />
    <bpmn:endEvent id="done" name="Party prepared" />
    <bpmn:task id="draft" name="Send the draft" />
    <bpmn:sequenceFlow id="f-begin-collect" sourceRef="begin" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sendreq" sourceRef="collect" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-draft" sourceRef="sendreq" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-refine" sourceRef="draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f-refine-list" sourceRef="refine" targetRef="list" />
    <bpmn:sequenceFlow id="f-list-order" sourceRef="list" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-split" sourceRef="order" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-process" sourceRef="split" targetRef="process" />
    <bpmn:sequenceFlow id="f-split-message" sourceRef="split" targetRef="message" />
    <bpmn:sequenceFlow id="f-process-join" sourceRef="process" targetRef="join" />
    <bpmn:sequenceFlow id="f-message-join" sourceRef="message" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-build" sourceRef="join" targetRef="build" />
    <bpmn:sequenceFlow id="f-build-invite" sourceRef="build" targetRef="invite" />
    <bpmn:sequenceFlow id="f-invite-attendees" sourceRef="invite" targetRef="attendees" />
    <bpmn:sequenceFlow id="f-attendees-snacks" sourceRef="attendees" targetRef="snacks" />
    <bpmn:sequenceFlow id="f-snacks-done" sourceRef="snacks" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
