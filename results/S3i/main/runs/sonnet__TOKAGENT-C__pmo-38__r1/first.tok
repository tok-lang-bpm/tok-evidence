tok 1.0 "Building a House"

pool org "Tree house project"
  lane builder "Builder"
    start begin "Want to build a tree house"
    task collect "Collect the requirements"
    task sendreq "Send the requirements to the architect"
    task refine "Refine the draft with additional requirements" loop
    task list "Create the list of needed materials"
    task order "Order the materials from the online stores" parallel
    and split
    task process "Process the order"
    task message "Send messages to friends to build the house"
    and join
    task build "Build the house"
    task invite "Send invitations for the party"
    task attendees "Create the list of people that attend the party"
    task snacks "Buy the snacks"
    end done "Party prepared"
  lane architect "Architect"
    task draft "Send the draft"

flow begin -> collect -> sendreq -> draft -> refine -> list -> order -> split
flow split -> process
flow split -> message
flow process -> join
flow message -> join
flow join -> build -> invite -> attendees -> snacks -> done
