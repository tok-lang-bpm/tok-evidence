<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="DIY smartphone screen repair" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Repair" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="DIY smartphone screen repair" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="you" name="You">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>own</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tool" name="Online tool">
        <bpmn:flowNodeRef>lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Phone is broken" />
    <bpmn:task id="enter" name="Enter the model and what is broken" />
    <bpmn:task id="own" name="Check the stuff you already have" />
    <bpmn:task id="contact" name="Contact friends to borrow or buy something" />
    <bpmn:task id="buy" name="Buy the rest" />
    <bpmn:task id="fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="worked" name="Did it work?" />
    <bpmn:task id="review" name="Send a review and video" />
    <bpmn:task id="expert" name="Send the phone to an expert" />
    <bpmn:endEvent id="done" name="Phone repaired" />
    <bpmn:endEvent id="sent" name="Phone sent to expert" />
    <bpmn:task id="lists" name="Give the lists of materials, tools and ordering choices" />
    <bpmn:task id="instr" name="Give the repair instructions" />
    <bpmn:sequenceFlow id="f-begin-enter" sourceRef="begin" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-lists" sourceRef="enter" targetRef="lists" />
    <bpmn:sequenceFlow id="f-lists-own" sourceRef="lists" targetRef="own" />
    <bpmn:sequenceFlow id="f-own-contact" sourceRef="own" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact-buy" sourceRef="contact" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-instr" sourceRef="buy" targetRef="instr" />
    <bpmn:sequenceFlow id="f-instr-fix" sourceRef="instr" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-worked" sourceRef="fix" targetRef="worked" />
    <bpmn:sequenceFlow id="f-worked-review" name="yes" sourceRef="worked" targetRef="review" />
    <bpmn:sequenceFlow id="f-worked-expert" name="no" sourceRef="worked" targetRef="expert" />
    <bpmn:sequenceFlow id="f-review-done" sourceRef="review" targetRef="done" />
    <bpmn:sequenceFlow id="f-expert-sent" sourceRef="expert" targetRef="sent" />
  </bpmn:process>
</bpmn:definitions>
