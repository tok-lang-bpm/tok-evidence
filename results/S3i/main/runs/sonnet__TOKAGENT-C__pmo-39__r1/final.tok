tok 1.0 "DIY smartphone screen repair"

pool org "Repair"
  lane you "You"
    start begin "Phone is broken"
    task enter "Enter the model and what is broken"
    task own "Check the stuff you already have"
    task contact "Contact friends to borrow or buy something"
    task buy "Buy the rest"
    task fix "Fix the phone"
    xor worked "Did it work?"
    task review "Send a review and video"
    task expert "Send the phone to an expert"
    end done "Phone repaired"
    end sent "Phone sent to expert"
  lane tool "Online tool"
    task lists "Give the lists of materials, tools and ordering choices"
    task instr "Give the repair instructions"

flow begin -> enter -> lists -> own -> contact -> buy -> instr -> fix -> worked
flow worked -> review "yes"
flow worked -> expert "no"
flow review -> done
flow expert -> sent
