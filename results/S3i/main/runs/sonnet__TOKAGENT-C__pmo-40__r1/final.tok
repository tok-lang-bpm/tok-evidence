tok 1.0 "OEE"

pool plant "Plant"
  lane system "Monitoring system"
    start begin "Monitoring started"
    xor merge
    task collect "Collect information from the machine"
    task calc "Calculate the OEE"
    xor low "OEE below the value?"
    task stop "Stop the machine"
    task mail "Send an email to the engineer"
    catch restarted "Machine restarted" message="Restarted"
    xor conn "Machine disconnected?"
    end done "Process stopped"

flow begin -> merge -> collect -> calc -> low
flow low -> stop "yes"
flow low -> conn "no"
flow stop -> mail -> restarted -> merge
flow conn -> done "yes"
flow conn -> merge "no"
