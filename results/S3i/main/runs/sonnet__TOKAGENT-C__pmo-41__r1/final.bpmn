<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Inspection of a machine" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insp" name="Inspection" processRef="insp-process" />
  </bpmn:collaboration>
  <bpmn:process id="insp-process" name="Inspection of a machine" isExecutable="false">
    <bpmn:laneSet id="insp-lanes">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Inspection needed" />
    <bpmn:task id="enter" name="Enter the machine type and serial number" />
    <bpmn:task id="answer" name="Input values for the questions" />
    <bpmn:task id="press" name="Press the buttons" />
    <bpmn:task id="show" name="Show the collected values" />
    <bpmn:exclusiveGateway id="more" name="Additional questions needed?" />
    <bpmn:task id="extra" name="Answer the additional questions" />
    <bpmn:exclusiveGateway id="join" />
    <bpmn:endEvent id="done" name="Inspection finished" />
    <bpmn:sequenceFlow id="f-begin-enter" sourceRef="begin" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-answer" sourceRef="enter" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-press" sourceRef="answer" targetRef="press" />
    <bpmn:sequenceFlow id="f-press-show" sourceRef="press" targetRef="show" />
    <bpmn:sequenceFlow id="f-show-more" sourceRef="show" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-extra" name="yes" sourceRef="more" targetRef="extra" />
    <bpmn:sequenceFlow id="f-more-join" name="no" sourceRef="more" targetRef="join" />
    <bpmn:sequenceFlow id="f-extra-join" sourceRef="extra" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-done" sourceRef="join" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
