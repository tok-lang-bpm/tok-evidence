tok 1.0 "Inspection of a machine"

pool insp "Inspection"
  lane inspector "Inspector"
    start begin "Inspection needed"
    task enter "Enter the machine type and serial number"
    task answer "Input values for the questions"
    task press "Press the buttons"
    task show "Show the collected values"
    xor more "Additional questions needed?"
    task extra "Answer the additional questions"
    xor join
    end done "Inspection finished"

flow begin -> enter -> answer -> press -> show -> more
flow more -> extra "yes"
flow more -> join "no"
flow extra -> join
flow join -> done
