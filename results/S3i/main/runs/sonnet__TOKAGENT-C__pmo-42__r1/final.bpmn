<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service for Your Fridge" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Fridge service" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Service for Your Fridge" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>noise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="center" name="Central fridge service center">
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="facility" name="Service facility">
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="noise" name="Fridge produces strange noises" />
    <bpmn:task id="describe" name="Describe the symptoms" />
    <bpmn:task id="send" name="Send the symptoms and the type of fridge to the service center" />
    <bpmn:task id="confirm" name="Confirm that the fridge is OK" />
    <bpmn:task id="rate" name="Rate the service facility" />
    <bpmn:endEvent id="done" name="Fridge service finished" />
    <bpmn:task id="select" name="Select a local service facility" />
    <bpmn:task id="appoint" name="Make an appointment" />
    <bpmn:task id="repair" name="Arrive and repair the fridge" />
    <bpmn:exclusiveGateway id="fixed" name="Fridge repaired?" />
    <bpmn:task id="parts" name="Get additional parts" />
    <bpmn:sequenceFlow id="f-noise-describe" sourceRef="noise" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-send" sourceRef="describe" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-select" sourceRef="send" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-appoint" sourceRef="select" targetRef="appoint" />
    <bpmn:sequenceFlow id="f-appoint-repair" sourceRef="appoint" targetRef="repair" />
    <bpmn:sequenceFlow id="f-repair-fixed" sourceRef="repair" targetRef="fixed" />
    <bpmn:sequenceFlow id="f-fixed-confirm" name="yes" sourceRef="fixed" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-fixed-parts" name="no" sourceRef="fixed" targetRef="parts" />
    <bpmn:sequenceFlow id="f-parts-repair" sourceRef="parts" targetRef="repair" />
    <bpmn:sequenceFlow id="f-confirm-rate" sourceRef="confirm" targetRef="rate" />
    <bpmn:sequenceFlow id="f-rate-done" sourceRef="rate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
