tok 1.0 "Robotic Burger Seller"

pool shop "Burger Seller"
  lane robot "Robot"
    start begin "Order wanted"
    task receive "Receive the order"
    task askmenu "Ask whether the customer wants a menu or just the burger"
    xor menu "Menu?"
    and split
    task drink "Prepare the drink"
    task askside "Ask whether the customer wants fries or wedges"
    xor side "Fries or wedges?"
    task fries "Prepare the fries"
    task wedges "Prepare the wedges"
    xor sidedone
    and joined
    xor merge
    task burger "Prepare the burger"
    boundary tick on=burger timer=PT30S noninterrupting
    task status "Give a status update"
    end updated "Update given"
    task deliver "Deliver the order via the conveyor belt"
    end done "Order delivered"

flow begin -> receive -> askmenu -> menu
flow menu -> split "menu"
flow menu -> merge "just the burger"
flow split -> drink
flow split -> askside
flow askside -> side
flow side -> fries "fries"
flow side -> wedges "wedges"
flow fries -> sidedone
flow wedges -> sidedone
flow drink -> joined
flow sidedone -> joined
flow joined -> merge
flow merge -> burger -> deliver -> done
flow tick -> status -> updated
