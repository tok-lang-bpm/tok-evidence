<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="shop" name="Online shop" processRef="shop-process" />
  </bpmn:collaboration>
  <bpmn:process id="shop-process" name="Ordering in an Online Shop" isExecutable="false">
    <bpmn:laneSet id="shop-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paydata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>differs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Shopping system">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Customer wants to order" />
    <bpmn:task id="login" name="Log into the E-Shop" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="select" name="Select a product" />
    <bpmn:task id="add" name="Add the product to the shopping cart" />
    <bpmn:task id="save" name="Save the product" />
    <bpmn:exclusiveGateway id="all" name="Every product selected?" />
    <bpmn:task id="paydata" name="Enter the payment data" />
    <bpmn:task id="address" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="differs" name="Billing address different?" />
    <bpmn:task id="billing" name="Enter the billing address" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="check" name="Check the credentials" />
    <bpmn:exclusiveGateway id="ok" name="Login successful?" />
    <bpmn:task id="finish" name="Finish the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="complete" name="Complete the order" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:endEvent id="stopped" name="Shopping stopped" />
    <bpmn:task id="confirm" name="Confirm the payment" />
    <bpmn:sequenceFlow id="f-begin-login" sourceRef="begin" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-check" sourceRef="login" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-again" name="yes" sourceRef="ok" targetRef="again" />
    <bpmn:sequenceFlow id="f-ok-stopped" name="no" sourceRef="ok" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-again-select" sourceRef="again" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-add" sourceRef="select" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-save" sourceRef="add" targetRef="save" />
    <bpmn:sequenceFlow id="f-save-all" sourceRef="save" targetRef="all" />
    <bpmn:sequenceFlow id="f-all-again" name="no" sourceRef="all" targetRef="again" />
    <bpmn:sequenceFlow id="f-all-finish" name="yes" sourceRef="all" targetRef="finish" />
    <bpmn:sequenceFlow id="f-finish-split" sourceRef="finish" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-paydata" sourceRef="split" targetRef="paydata" />
    <bpmn:sequenceFlow id="f-paydata-confirm" sourceRef="paydata" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-join" sourceRef="confirm" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-address" sourceRef="split" targetRef="address" />
    <bpmn:sequenceFlow id="f-address-differs" sourceRef="address" targetRef="differs" />
    <bpmn:sequenceFlow id="f-differs-billing" name="yes" sourceRef="differs" targetRef="billing" />
    <bpmn:sequenceFlow id="f-differs-merged" name="no" sourceRef="differs" targetRef="merged" />
    <bpmn:sequenceFlow id="f-billing-merged" sourceRef="billing" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-join" sourceRef="merged" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-complete" sourceRef="join" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-done" sourceRef="complete" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
