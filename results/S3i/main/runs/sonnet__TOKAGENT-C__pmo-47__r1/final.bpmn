<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="USI course registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Sports institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="USI course registration" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>has_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>none</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wants" name="Want to register for a course" />
    <bpmn:task id="check_account" name="Check if you have an account" />
    <bpmn:exclusiveGateway id="has_account" name="Account exists?" />
    <bpmn:task id="check_uni" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Eligible university?" />
    <bpmn:task id="register" name="Register your account" />
    <bpmn:task id="request" name="Request an activation" />
    <bpmn:task id="wait" name="Wait for a response" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="login" name="Log into the account" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete" name="Complete the registration and provide the payment information" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="receive" name="Receive the course ticket" />
    <bpmn:endEvent id="done" name="Registered" />
    <bpmn:task id="select" name="Select a course" />
    <bpmn:task id="show" name="Tell the courses and dates" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" />
    <bpmn:endEvent id="none" name="No slots" />
    <bpmn:sequenceFlow id="f-wants-show" sourceRef="wants" targetRef="show" />
    <bpmn:sequenceFlow id="f-show-slots" sourceRef="show" targetRef="slots" />
    <bpmn:sequenceFlow id="f-slots-select" name="yes" sourceRef="slots" targetRef="select" />
    <bpmn:sequenceFlow id="f-slots-none" name="no" sourceRef="slots" targetRef="none" />
    <bpmn:sequenceFlow id="f-select-check_account" sourceRef="select" targetRef="check_account" />
    <bpmn:sequenceFlow id="f-check_account-has_account" sourceRef="check_account" targetRef="has_account" />
    <bpmn:sequenceFlow id="f-has_account-merge" name="yes" sourceRef="has_account" targetRef="merge" />
    <bpmn:sequenceFlow id="f-has_account-check_uni" name="no" sourceRef="has_account" targetRef="check_uni" />
    <bpmn:sequenceFlow id="f-check_uni-eligible" sourceRef="check_uni" targetRef="eligible" />
    <bpmn:sequenceFlow id="f-eligible-register" name="yes" sourceRef="eligible" targetRef="register" />
    <bpmn:sequenceFlow id="f-eligible-request" name="no" sourceRef="eligible" targetRef="request" />
    <bpmn:sequenceFlow id="f-register-merge" sourceRef="register" targetRef="merge" />
    <bpmn:sequenceFlow id="f-request-wait" sourceRef="request" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-merge" sourceRef="wait" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-login" sourceRef="merge" targetRef="login" />
    <bpmn:sequenceFlow id="f-login-split" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-tweet" sourceRef="split" targetRef="tweet" />
    <bpmn:sequenceFlow id="f-split-complete" sourceRef="split" targetRef="complete" />
    <bpmn:sequenceFlow id="f-tweet-join" sourceRef="tweet" targetRef="join" />
    <bpmn:sequenceFlow id="f-complete-join" sourceRef="complete" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-receive" sourceRef="join" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-done" sourceRef="receive" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
