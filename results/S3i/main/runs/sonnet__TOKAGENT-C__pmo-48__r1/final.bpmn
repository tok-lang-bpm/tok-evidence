<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vienna Night Run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Vienna Night Run app" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vienna Night Run" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="runner" name="Runner">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>when</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Want to participate" />
    <bpmn:task id="select" name="Select a starting block" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="run5" name="Run 5km and measure the time" />
    <bpmn:exclusiveGateway id="fast" name="Time under 25 minutes?" default="f-fast-train" />
    <bpmn:task id="train" name="Train and check" />
    <bpmn:task id="number" name="Get the starting number" />
    <bpmn:exclusiveGateway id="when" name="More than one hour between start and end of workday?" default="f-when-work" />
    <bpmn:task id="home" name="Go there from home" />
    <bpmn:task id="work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="arrived" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="run" name="Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="receive" name="Receive the final running time" />
    <bpmn:endEvent id="done" name="Night Run completed" />
    <bpmn:sequenceFlow id="f-begin-select" sourceRef="begin" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-again" sourceRef="select" targetRef="again" />
    <bpmn:sequenceFlow id="f-again-run5" sourceRef="again" targetRef="run5" />
    <bpmn:sequenceFlow id="f-run5-fast" sourceRef="run5" targetRef="fast" />
    <bpmn:sequenceFlow id="f-fast-number" name="yes" sourceRef="fast" targetRef="number">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-fast-train" name="no" sourceRef="fast" targetRef="train" />
    <bpmn:sequenceFlow id="f-train-again" sourceRef="train" targetRef="again" />
    <bpmn:sequenceFlow id="f-number-when" sourceRef="number" targetRef="when" />
    <bpmn:sequenceFlow id="f-when-home" name="yes" sourceRef="when" targetRef="home">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hoursLeft &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-when-work" name="no" sourceRef="when" targetRef="work" />
    <bpmn:sequenceFlow id="f-home-arrived" sourceRef="home" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-work-arrived" sourceRef="work" targetRef="arrived" />
    <bpmn:sequenceFlow id="f-arrived-split" sourceRef="arrived" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-run" sourceRef="split" targetRef="run" />
    <bpmn:sequenceFlow id="f-split-drink" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f-run-joined" sourceRef="run" targetRef="joined" />
    <bpmn:sequenceFlow id="f-drink-joined" sourceRef="drink" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-receive" sourceRef="joined" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-done" sourceRef="receive" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
