tok 1.0 "Vienna Night Run"

pool org "Vienna Night Run app"
  lane runner "Runner"
    start begin "Want to participate"
    task select "Select a starting block"
    xor again
    task run5 "Run 5km and measure the time"
    xor fast "Time under 25 minutes?"
    task train "Train and check"
    task number "Get the starting number"
    xor when "More than one hour between start and end of workday?"
    task home "Go there from home"
    task work "Leave directly from work"
    xor arrived
    and split
    task run "Run"
    task drink "Drink"
    and joined
    task receive "Receive the final running time"
    end done "Night Run completed"

flow begin -> select -> again -> run5 -> fast
flow fast -> number "yes" when="time < 25"
flow fast -> train "no" default
flow train -> again
flow number -> when
flow when -> home "yes" when="hoursLeft > 1"
flow when -> work "no" default
flow home -> arrived
flow work -> arrived
flow arrived -> split
flow split -> run
flow split -> drink
flow run -> joined
flow drink -> joined
flow joined -> receive -> done
