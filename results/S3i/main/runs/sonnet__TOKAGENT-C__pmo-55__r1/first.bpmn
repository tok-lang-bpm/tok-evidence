<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Central venous puncture" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hospital" name="Hospital" processRef="hospital-process" />
  </bpmn:collaboration>
  <bpmn:process id="hospital-process" name="Central venous puncture" isExecutable="false">
    <bpmn:laneSet id="hospital-lanes">
      <bpmn:lane id="doctor" name="Doctor">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sterile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pospatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vein</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>veinj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>anesth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloodok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dropprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>syringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>axis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>longax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shortax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>axisj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remwire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catpos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Procedure needed" />
    <bpmn:task id="prepare" name="Prepare the implements" />
    <bpmn:task id="wash" name="Wash the hands" />
    <bpmn:task id="dress" name="Get in sterile clothes" />
    <bpmn:task id="clean" name="Clean the puncture area" />
    <bpmn:task id="drape" name="Drape the puncture zone" />
    <bpmn:task id="configure" name="Configure the ultrasound" />
    <bpmn:task id="gel" name="Put gel in the probe" />
    <bpmn:task id="cover" name="Cover the probe" />
    <bpmn:task id="sterile" name="Put the sterile gel" />
    <bpmn:task id="posprobe" name="Position the probe" />
    <bpmn:task id="pospatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="vein" name="Identification method?" />
    <bpmn:task id="anat" name="Identify the vein by anatomic identification" />
    <bpmn:task id="dop" name="Identify the vein by doppler identification" />
    <bpmn:task id="comp" name="Identify the vein by compression identification" />
    <bpmn:exclusiveGateway id="veinj" />
    <bpmn:task id="anesth" name="Anesthetize the patient" />
    <bpmn:task id="puncture" name="Puncture the patient" />
    <bpmn:task id="blood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="bloodok" name="Blood return correct?" />
    <bpmn:task id="dropprobe" name="Drop the probe" />
    <bpmn:task id="syringe" name="Remove the syringe" />
    <bpmn:task id="install" name="Install the guidewire" />
    <bpmn:task id="trocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="axis" name="Axis of the check?" />
    <bpmn:task id="longax" name="Check the wire in the long axis" />
    <bpmn:task id="shortax" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="axisj" />
    <bpmn:task id="pos" name="Check the wire position" />
    <bpmn:exclusiveGateway id="posok" name="Wire in good position?" />
    <bpmn:task id="widen" name="Widen the pathway" />
    <bpmn:task id="advance" name="Advance the catheter" />
    <bpmn:task id="remwire" name="Remove the guidewire" />
    <bpmn:task id="flow" name="Verify the flow and the reflow" />
    <bpmn:task id="catpos" name="Check the catheter position" />
    <bpmn:endEvent id="done" name="Catheter placed" />
    <bpmn:sequenceFlow id="f-begin-prepare" sourceRef="begin" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-wash" sourceRef="prepare" targetRef="wash" />
    <bpmn:sequenceFlow id="f-wash-dress" sourceRef="wash" targetRef="dress" />
    <bpmn:sequenceFlow id="f-dress-clean" sourceRef="dress" targetRef="clean" />
    <bpmn:sequenceFlow id="f-clean-drape" sourceRef="clean" targetRef="drape" />
    <bpmn:sequenceFlow id="f-drape-configure" sourceRef="drape" targetRef="configure" />
    <bpmn:sequenceFlow id="f-configure-gel" sourceRef="configure" targetRef="gel" />
    <bpmn:sequenceFlow id="f-gel-cover" sourceRef="gel" targetRef="cover" />
    <bpmn:sequenceFlow id="f-cover-sterile" sourceRef="cover" targetRef="sterile" />
    <bpmn:sequenceFlow id="f-sterile-posprobe" sourceRef="sterile" targetRef="posprobe" />
    <bpmn:sequenceFlow id="f-posprobe-pospatient" sourceRef="posprobe" targetRef="pospatient" />
    <bpmn:sequenceFlow id="f-pospatient-vein" sourceRef="pospatient" targetRef="vein" />
    <bpmn:sequenceFlow id="f-vein-anat" name="anatomic" sourceRef="vein" targetRef="anat" />
    <bpmn:sequenceFlow id="f-vein-dop" name="doppler" sourceRef="vein" targetRef="dop" />
    <bpmn:sequenceFlow id="f-vein-comp" name="compression" sourceRef="vein" targetRef="comp" />
    <bpmn:sequenceFlow id="f-anat-veinj" sourceRef="anat" targetRef="veinj" />
    <bpmn:sequenceFlow id="f-dop-veinj" sourceRef="dop" targetRef="veinj" />
    <bpmn:sequenceFlow id="f-comp-veinj" sourceRef="comp" targetRef="veinj" />
    <bpmn:sequenceFlow id="f-veinj-anesth" sourceRef="veinj" targetRef="anesth" />
    <bpmn:sequenceFlow id="f-anesth-puncture" sourceRef="anesth" targetRef="puncture" />
    <bpmn:sequenceFlow id="f-puncture-blood" sourceRef="puncture" targetRef="blood" />
    <bpmn:sequenceFlow id="f-blood-bloodok" sourceRef="blood" targetRef="bloodok" />
    <bpmn:sequenceFlow id="f-bloodok-anesth" name="no" sourceRef="bloodok" targetRef="anesth" />
    <bpmn:sequenceFlow id="f-bloodok-dropprobe" name="yes" sourceRef="bloodok" targetRef="dropprobe" />
    <bpmn:sequenceFlow id="f-dropprobe-syringe" sourceRef="dropprobe" targetRef="syringe" />
    <bpmn:sequenceFlow id="f-syringe-install" sourceRef="syringe" targetRef="install" />
    <bpmn:sequenceFlow id="f-install-trocar" sourceRef="install" targetRef="trocar" />
    <bpmn:sequenceFlow id="f-trocar-axis" sourceRef="trocar" targetRef="axis" />
    <bpmn:sequenceFlow id="f-axis-longax" name="long axis" sourceRef="axis" targetRef="longax" />
    <bpmn:sequenceFlow id="f-axis-shortax" name="short axis" sourceRef="axis" targetRef="shortax" />
    <bpmn:sequenceFlow id="f-longax-axisj" sourceRef="longax" targetRef="axisj" />
    <bpmn:sequenceFlow id="f-shortax-axisj" sourceRef="shortax" targetRef="axisj" />
    <bpmn:sequenceFlow id="f-axisj-pos" sourceRef="axisj" targetRef="pos" />
    <bpmn:sequenceFlow id="f-pos-posok" sourceRef="pos" targetRef="posok" />
    <bpmn:sequenceFlow id="f-posok-anesth" name="no" sourceRef="posok" targetRef="anesth" />
    <bpmn:sequenceFlow id="f-posok-widen" name="yes" sourceRef="posok" targetRef="widen" />
    <bpmn:sequenceFlow id="f-widen-advance" sourceRef="widen" targetRef="advance" />
    <bpmn:sequenceFlow id="f-advance-remwire" sourceRef="advance" targetRef="remwire" />
    <bpmn:sequenceFlow id="f-remwire-flow" sourceRef="remwire" targetRef="flow" />
    <bpmn:sequenceFlow id="f-flow-catpos" sourceRef="flow" targetRef="catpos" />
    <bpmn:sequenceFlow id="f-catpos-done" sourceRef="catpos" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
