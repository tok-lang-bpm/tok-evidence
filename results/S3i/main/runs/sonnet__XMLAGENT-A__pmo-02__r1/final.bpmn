<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Hiring" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hiring" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Dept" name="Department">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrefJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NegJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Need" name="Need for a new hire identified" />
    <bpmn:task id="Task_Create" name="Create job description" />
    <bpmn:task id="Task_Post" name="Post job description on job boards" />
    <bpmn:task id="Task_Collect" name="Collect resumes" />
    <bpmn:task id="Task_Screen" name="Screen resumes" />
    <bpmn:task id="Task_Phone" name="Conduct initial phone interviews" />
    <bpmn:task id="Task_Invite" name="Invite selected candidates to interviews" />
    <bpmn:exclusiveGateway id="Gw_Pref" name="Candidate prefers in-person interview?" />
    <bpmn:task id="Task_InPerson" name="Conduct in-person interview" />
    <bpmn:task id="Task_Virtual" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="Gw_PrefJoin" />
    <bpmn:task id="Task_Choose" name="Choose candidate" />
    <bpmn:task id="Task_Offer" name="Extend offer" />
    <bpmn:exclusiveGateway id="Gw_Neg" name="Salary negotiation needed?" />
    <bpmn:task id="Task_Negotiate" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="Gw_NegJoin" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Paperwork" name="Complete paperwork" />
    <bpmn:task id="Task_Orientation" name="Hold orientation" />
    <bpmn:task id="Task_Training" name="Provide training" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:endEvent id="End_Done" name="New hire integrated into the team" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Need" targetRef="Task_Create" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Create" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Post" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Collect" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Screen" targetRef="Task_Phone" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Phone" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Invite" targetRef="Gw_Pref" />
    <bpmn:sequenceFlow id="F_InPerson" name="yes" sourceRef="Gw_Pref" targetRef="Task_InPerson" />
    <bpmn:sequenceFlow id="F_Virtual" name="no" sourceRef="Gw_Pref" targetRef="Task_Virtual" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_InPerson" targetRef="Gw_PrefJoin" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Virtual" targetRef="Gw_PrefJoin" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_PrefJoin" targetRef="Task_Choose" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Choose" targetRef="Task_Offer" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Offer" targetRef="Gw_Neg" />
    <bpmn:sequenceFlow id="F_Neg" name="yes" sourceRef="Gw_Neg" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="F_NoNeg" name="no" sourceRef="Gw_Neg" targetRef="Gw_NegJoin" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Negotiate" targetRef="Gw_NegJoin" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_NegJoin" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_Split" targetRef="Task_Paperwork" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_Split" targetRef="Task_Orientation" />
    <bpmn:sequenceFlow id="F21" sourceRef="Gw_Split" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_Paperwork" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Orientation" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_Training" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F25" sourceRef="Gw_Join" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>
