<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Inventory replenishment" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Sys" name="Inventory system">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Levels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proc" name="Procurement team">
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Wh" name="Warehouse staff">
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Place</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Inventory monitoring begins" />
    <bpmn:task id="Task_Monitor" name="Monitor inventory levels" />
    <bpmn:exclusiveGateway id="Gw_Threshold" name="Stock reached threshold?" default="F_no" />
    <bpmn:task id="Task_Signal" name="Signal need to reorder" />
    <bpmn:task id="Task_Order" name="Place order with suppliers" />
    <bpmn:task id="Task_Update" name="Update inventory system with expected delivery dates" />
    <bpmn:task id="Task_Receive" name="Receive stock" />
    <bpmn:task id="Task_Inspect" name="Inspect stock for quality" />
    <bpmn:task id="Task_Record" name="Record stock in system" />
    <bpmn:task id="Task_Place" name="Place stock on shelves or in storage" />
    <bpmn:task id="Task_Levels" name="Update inventory levels" />
    <bpmn:endEvent id="End" name="Restock complete" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Monitor" targetRef="Gw_Threshold" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Threshold" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Threshold" targetRef="Task_Signal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock reached threshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Signal" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Order" targetRef="Task_Update" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Update" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Receive" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Inspect" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Record" targetRef="Task_Place" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Place" targetRef="Task_Levels" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Levels" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
