<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Marketing organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Marketing" name="Marketing team">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM system">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales team">
        <bpmn:flowNodeRef>Task_Follow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Campaign started" />
    <bpmn:task id="Task_Define" name="Define the objectives of the marketing campaign" />
    <bpmn:parallelGateway id="Gw_Split1" />
    <bpmn:task id="Task_Content" name="Create the content" />
    <bpmn:task id="Task_Visuals" name="Design the visuals" />
    <bpmn:task id="Task_Channels" name="Select channels for promotion" />
    <bpmn:parallelGateway id="Gw_Join1" />
    <bpmn:task id="Task_Launch" name="Launch the campaign" />
    <bpmn:parallelGateway id="Gw_Split2" />
    <bpmn:task id="Task_Track" name="Track the performance of the campaign" />
    <bpmn:task id="Task_Collect" name="Collect leads in the CRM system" />
    <bpmn:task id="Task_Follow" name="Follow up on leads" />
    <bpmn:parallelGateway id="Gw_Join2" />
    <bpmn:task id="Task_Analyze" name="Analyze the performance for future optimization" />
    <bpmn:endEvent id="End_1" name="Campaign concluded" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Define" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Define" targetRef="Gw_Split1" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Split1" targetRef="Task_Content" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split1" targetRef="Task_Visuals" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split1" targetRef="Task_Channels" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Content" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Visuals" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Channels" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Join1" targetRef="Task_Launch" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Launch" targetRef="Gw_Split2" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split2" targetRef="Task_Track" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Split2" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Collect" targetRef="Task_Follow" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Track" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Follow" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Join2" targetRef="Task_Analyze" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Analyze" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
