<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Procurement team">
        <bpmn:flowNodeRef>Task_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Need for new supplier arises" />
    <bpmn:task id="Task_Identify" name="Identify need for new supplier" />
    <bpmn:task id="Task_Issue" name="Issue request for proposals" />
    <bpmn:task id="Task_Receive" name="Receive responses from suppliers" />
    <bpmn:task id="Task_Evaluate" name="Evaluate proposals" />
    <bpmn:exclusiveGateway id="Gw_Visit" name="Site visits or interviews needed?" default="F_no" />
    <bpmn:task id="Task_Visit" name="Conduct site visits or interviews" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Select" name="Select supplier" />
    <bpmn:task id="Task_Negotiate" name="Negotiate contract" />
    <bpmn:task id="Task_Sign" name="Sign contract" />
    <bpmn:task id="Task_Onboard" name="Onboard supplier" />
    <bpmn:task id="Task_Execute" name="Execute contract" />
    <bpmn:endEvent id="End_1" name="Supplier onboarded and contract executed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Identify" targetRef="Task_Issue" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Issue" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Receive" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Evaluate" targetRef="Gw_Visit" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Visit" targetRef="Task_Visit" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Visit" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Visit" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Merge" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Select" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Negotiate" targetRef="Task_Sign" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Sign" targetRef="Task_Onboard" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Onboard" targetRef="Task_Execute" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Execute" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
