<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Order fulfilment" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tracking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>Task_Pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics provider">
        <bpmn:flowNodeRef>Task_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Order placed" />
    <bpmn:task id="Task_Place" name="Place order" />
    <bpmn:task id="Task_Generate" name="Generate order confirmation" />
    <bpmn:task id="Task_Send" name="Send order confirmation to customer" />
    <bpmn:task id="Task_Pick" name="Pick and pack items" />
    <bpmn:task id="Task_Label" name="Generate shipping label" />
    <bpmn:task id="Task_Handover" name="Hand over order to logistics provider" />
    <bpmn:task id="Task_Tracking" name="Send tracking information to customer" />
    <bpmn:task id="Task_Monitor" name="Monitor shipment until delivery" />
    <bpmn:endEvent id="End_1" name="Order delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_Place" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Place" targetRef="Task_Generate" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Generate" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="f4" sourceRef="Task_Send" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_Pick" targetRef="Task_Label" />
    <bpmn:sequenceFlow id="f6" sourceRef="Task_Label" targetRef="Task_Handover" />
    <bpmn:sequenceFlow id="f7" sourceRef="Task_Handover" targetRef="Task_Tracking" />
    <bpmn:sequenceFlow id="f8" sourceRef="Task_Tracking" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="f9" sourceRef="Task_Monitor" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
