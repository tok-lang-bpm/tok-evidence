<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Ticket booking" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Booking system">
        <bpmn:flowNodeRef>Task_Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Company" name="Travel company">
        <bpmn:flowNodeRef>Task_Inventory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Customer searches for a ticket" />
    <bpmn:task id="Task_Search" name="Search for a flight, train or bus ticket" />
    <bpmn:task id="Task_Select" name="Select route, date and time" />
    <bpmn:task id="Task_Provide" name="Provide personal information and payment details" />
    <bpmn:task id="Task_Generate" name="Generate ticket" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:exclusiveGateway id="Gw_Channel" name="Email or SMS?" default="F_Sms" />
    <bpmn:task id="Task_Email" name="Send ticket via email" />
    <bpmn:task id="Task_Sms" name="Send ticket via SMS" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Inventory" name="Update seat inventory" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Remind" name="Receive reminders and instructions for check-in or boarding" />
    <bpmn:task id="Task_Journey" name="Complete journey" />
    <bpmn:endEvent id="End_1" name="Journey completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Search" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Search" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Select" targetRef="Task_Provide" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Provide" targetRef="Task_Generate" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Generate" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Split" targetRef="Gw_Channel" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Split" targetRef="Task_Inventory" />
    <bpmn:sequenceFlow id="F_Email" name="email" sourceRef="Gw_Channel" targetRef="Task_Email" />
    <bpmn:sequenceFlow id="F_Sms" name="SMS" sourceRef="Gw_Channel" targetRef="Task_Sms" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Email" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Sms" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Merge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Inventory" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Join" targetRef="Task_Remind" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Remind" targetRef="Task_Journey" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Journey" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>