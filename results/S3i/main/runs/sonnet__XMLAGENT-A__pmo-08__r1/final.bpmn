<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Reporter" name="Employee or customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Incident team">
        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Follow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Incident noticed" />
    <bpmn:task id="Task_Report" name="Report incident" />
    <bpmn:task id="Task_Log" name="Log report in tracking system" />
    <bpmn:task id="Task_Assign" name="Assign report to appropriate team" />
    <bpmn:task id="Task_Gather" name="Gather necessary information" />
    <bpmn:task id="Task_Cause" name="Identify cause of incident" />
    <bpmn:task id="Task_Propose" name="Propose corrective actions" />
    <bpmn:exclusiveGateway id="Gw_Split" name="Which solution?" />
    <bpmn:task id="Task_Fix" name="Implement fix" />
    <bpmn:task id="Task_Training" name="Implement training" />
    <bpmn:task id="Task_Policy" name="Implement policy change" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Follow" name="Follow up on resolved incident" />
    <bpmn:parallelGateway id="Gw_Fork" />
    <bpmn:task id="Task_Close" name="Close incident report" />
    <bpmn:task id="Task_Notify" name="Notify all stakeholders" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:endEvent id="End_1" name="Incident closed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Report" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Log" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Assign" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Gather" targetRef="Task_Cause" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Cause" targetRef="Task_Propose" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Propose" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F_Fix" name="fix" sourceRef="Gw_Split" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="F_Training" name="training" sourceRef="Gw_Split" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="F_Policy" name="policy change" sourceRef="Gw_Split" targetRef="Task_Policy" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Fix" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Training" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Policy" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Merge" targetRef="Task_Follow" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Follow" targetRef="Gw_Fork" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_Fork" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Fork" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Close" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Notify" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_Join" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
