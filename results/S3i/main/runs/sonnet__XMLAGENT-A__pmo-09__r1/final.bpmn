<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Product development" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_RD" name="R&amp;D team">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Idea needed" />
    <bpmn:task id="Task_Identify" name="Identify idea for new product or improvement" />
    <bpmn:task id="Task_Research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="Task_Draft" name="Draft design concepts" />
    <bpmn:task id="Task_Select" name="Select promising design" />
    <bpmn:task id="Task_Build" name="Build prototype" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Test" name="Test prototype" />
    <bpmn:task id="Task_Collect" name="Collect feedback" />
    <bpmn:exclusiveGateway id="Gw_Refine" name="Refinement needed?" />
    <bpmn:task id="Task_Refine" name="Refine prototype" />
    <bpmn:exclusiveGateway id="Gw_Approved" name="Prototype approved?" />
    <bpmn:endEvent id="End_Approved" name="Prototype approved for further development" />
    <bpmn:endEvent id="End_Discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Identify" targetRef="Task_Research" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Research" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Draft" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Select" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Build" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Merge" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Test" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Collect" targetRef="Gw_Refine" />
    <bpmn:sequenceFlow id="F_Refine" name="yes" sourceRef="Gw_Refine" targetRef="Task_Refine" />
    <bpmn:sequenceFlow id="F_NoRefine" name="no" sourceRef="Gw_Refine" targetRef="Gw_Approved" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Refine" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_Approve" name="yes" sourceRef="Gw_Approved" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="F_Discard" name="no" sourceRef="Gw_Approved" targetRef="End_Discarded" />
  </bpmn:process>
</bpmn:definitions>
