<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Requester" name="Employee or department">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Task_Compat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Tested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Request for IT solution needed" />
    <bpmn:task id="Task_Submit" name="Submit request for IT solution" />
    <bpmn:task id="Task_Compat" name="Check compatibility with existing systems" />
    <bpmn:task id="Task_Cost" name="Evaluate cost and resource needs" />
    <bpmn:exclusiveGateway id="Gw_Approved" name="Approved?" />
    <bpmn:task id="Task_Procure" name="Procure tools or licenses" />
    <bpmn:task id="Task_Install" name="Install solution" />
    <bpmn:task id="Task_Test" name="Test solution in controlled environment" />
    <bpmn:exclusiveGateway id="Gw_Tested" name="Testing successful?" />
    <bpmn:task id="Task_Rollout" name="Roll out solution to requesting department" />
    <bpmn:exclusiveGateway id="Gw_Training" name="Training provided?" />
    <bpmn:task id="Task_Train" name="Provide training" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="End_Done" name="Solution in use" />
    <bpmn:endEvent id="End_Rejected" name="Request rejected" />
    <bpmn:endEvent id="End_Failed" name="Solution not rolled out" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Submit" targetRef="Task_Compat" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Compat" targetRef="Task_Cost" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Cost" targetRef="Gw_Approved" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Approved" targetRef="Task_Procure" />
    <bpmn:sequenceFlow id="F_NoAppr" name="no" sourceRef="Gw_Approved" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Procure" targetRef="Task_Install" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Install" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Test" targetRef="Gw_Tested" />
    <bpmn:sequenceFlow id="F_YesTest" name="yes" sourceRef="Gw_Tested" targetRef="Task_Rollout" />
    <bpmn:sequenceFlow id="F_NoTest" name="no" sourceRef="Gw_Tested" targetRef="End_Failed" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Rollout" targetRef="Gw_Training" />
    <bpmn:sequenceFlow id="F_YesTrain" name="yes" sourceRef="Gw_Training" targetRef="Task_Train" />
    <bpmn:sequenceFlow id="F_NoTrain" name="no" sourceRef="Gw_Training" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Train" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Merge" targetRef="Task_Support" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Support" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>
