<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Subscription service" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support team">
        <bpmn:flowNodeRef>Task_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RefundMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deactivate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Customer signs up" />
    <bpmn:task id="Task_SignUp" name="Enter personal and payment information" />
    <bpmn:task id="Task_Account" name="Generate account" />
    <bpmn:task id="Task_Access" name="Assign access" />
    <bpmn:task id="Task_Billing" name="Trigger automated billing cycles" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Updates" name="Send updates, product enhancements or renewal notifications" />
    <bpmn:exclusiveGateway id="Gw_Cancel" name="Does the customer cancel?" />
    <bpmn:task id="Task_Cancel" name="Submit cancellation request" />
    <bpmn:task id="Task_Process" name="Process cancellation request" />
    <bpmn:exclusiveGateway id="Gw_Refund" name="Refunds or charges due?" />
    <bpmn:task id="Task_Apply" name="Apply refunds or charges" />
    <bpmn:exclusiveGateway id="Gw_RefundMerge" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Deactivate" name="Deactivate subscription" />
    <bpmn:task id="Task_Settle" name="Settle final account balance" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:endEvent id="End_1" name="Subscription closed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_SignUp" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_SignUp" targetRef="Task_Account" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Account" targetRef="Task_Access" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Access" targetRef="Task_Billing" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Billing" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Merge" targetRef="Task_Updates" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Updates" targetRef="Gw_Cancel" />
    <bpmn:sequenceFlow id="F_NoCancel" name="no" sourceRef="Gw_Cancel" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_Cancel" name="yes" sourceRef="Gw_Cancel" targetRef="Task_Cancel" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Cancel" targetRef="Task_Process" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Process" targetRef="Gw_Refund" />
    <bpmn:sequenceFlow id="F_Refund" name="yes" sourceRef="Gw_Refund" targetRef="Task_Apply" />
    <bpmn:sequenceFlow id="F_NoRefund" name="no" sourceRef="Gw_Refund" targetRef="Gw_RefundMerge" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Apply" targetRef="Gw_RefundMerge" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_RefundMerge" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Split" targetRef="Task_Deactivate" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_Split" targetRef="Task_Settle" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Deactivate" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Settle" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_Join" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
