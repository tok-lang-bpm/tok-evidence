<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="Customer service">
        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dept" name="Relevant department">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fin" name="Financial team">
        <bpmn:flowNodeRef>Task_Refund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Complaint needed" />
    <bpmn:task id="Task_File" name="File complaint" />
    <bpmn:task id="Task_Log" name="Log complaint" />
    <bpmn:task id="Task_Assign" name="Assign complaint to department" />
    <bpmn:task id="Task_Review" name="Review complaint details and determine validity and refund" />
    <bpmn:task id="Task_Notify" name="Notify customer with decision" />
    <bpmn:exclusiveGateway id="Gw_Refund" name="Refund approved?" default="F_no" />
    <bpmn:task id="Task_Refund" name="Process reimbursement" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Resolve" name="Mark complaint as resolved" />
    <bpmn:task id="Task_Feedback" name="Provide feedback on satisfaction" />
    <bpmn:endEvent id="End_1" name="Case closed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_File" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_File" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Log" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Assign" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Review" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Notify" targetRef="Gw_Refund" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Refund" targetRef="Task_Refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refundApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Refund" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Refund" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Merge" targetRef="Task_Resolve" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Resolve" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Feedback" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
