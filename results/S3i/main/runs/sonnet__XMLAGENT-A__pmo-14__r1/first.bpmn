<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Dept" name="Department">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveAdj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fin" name="Finance department">
        <bpmn:flowNodeRef>Task_FinReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Adj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Distribute</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Period objectives needed" />
    <bpmn:task id="Task_Outline" name="Outline objectives" />
    <bpmn:task id="Task_Draft" name="Draft plan with cost estimates and justifications" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Meeting" name="Review plan in strategic alignment meeting" />
    <bpmn:task id="Task_FinReview" name="Perform detailed budget review" />
    <bpmn:exclusiveGateway id="Gw_Adj" name="Adjustments needed?" default="F_no" />
    <bpmn:task id="Task_Adjust" name="Adjust plan" />
    <bpmn:task id="Task_Document" name="Document adjustment" />
    <bpmn:task id="Task_ApproveAdj" name="Approve adjustment by stakeholders" />
    <bpmn:task id="Task_Allocate" name="Allocate approved budget to department" />
    <bpmn:task id="Task_Distribute" name="Distribute budget" />
    <bpmn:task id="Task_Implement" name="Implement plan" />
    <bpmn:endEvent id="End_1" name="Plan implementation begun" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Outline" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Outline" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Draft" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Merge" targetRef="Task_Meeting" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Meeting" targetRef="Task_FinReview" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_FinReview" targetRef="Gw_Adj" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Adj" targetRef="Task_Adjust" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Adj" targetRef="Task_Allocate" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Adjust" targetRef="Task_Document" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Document" targetRef="Task_ApproveAdj" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_ApproveAdj" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Allocate" targetRef="Task_Distribute" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Distribute" targetRef="Task_Implement" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Implement" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>