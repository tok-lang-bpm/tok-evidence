<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Compliance audit" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Award</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auditors" name="Auditors">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Issue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Compliance audit scheduled" />
    <bpmn:task id="Task_Prepare" name="Prepare documentation" />
    <bpmn:task id="Task_Gather" name="Gather evidence" />
    <bpmn:task id="Task_Self" name="Conduct self-assessment" />
    <bpmn:task id="Task_Review" name="Review company's processes" />
    <bpmn:task id="Task_Identify" name="Identify gaps or issues" />
    <bpmn:task id="Task_Correct" name="Make corrections or improvements" />
    <bpmn:task id="Task_Final" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="Gw_Met" name="All criteria met?" default="F_no" />
    <bpmn:task id="Task_Award" name="Award certification" />
    <bpmn:task id="Task_Issue" name="Issue official documents" />
    <bpmn:endEvent id="End_Done" name="Certification issued" />
    <bpmn:endEvent id="End_Denied" name="Certification not awarded" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Prepare" targetRef="Task_Gather" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Gather" targetRef="Task_Self" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Self" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Review" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Identify" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Correct" targetRef="Task_Final" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Final" targetRef="Gw_Met" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Met" targetRef="Task_Award" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Met" targetRef="End_Denied" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Award" targetRef="Task_Issue" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Issue" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>