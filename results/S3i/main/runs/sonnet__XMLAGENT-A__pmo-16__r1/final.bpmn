<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Multinational company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_coord" name="Audit coordinator">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_region" name="Regional office">
        <bpmn:flowNodeRef>Gw_split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_comp" name="Compliance team">
        <bpmn:flowNodeRef>Task_regul</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_central" name="Central audit team">
        <bpmn:flowNodeRef>Gw_mreview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_rsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_op</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_rjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_high</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_isplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_smerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ijoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_hmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_dsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_djoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_dir" name="Audit director">
        <bpmn:flowNodeRef>Gw_mrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_dreview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_app</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Annual audit started" />
    <bpmn:task id="Task_notify" name="Send notification to the regional office" />
    <bpmn:parallelGateway id="Gw_split1" />
    <bpmn:task id="Task_prepare" name="Prepare financial statements" />
    <bpmn:task id="Task_gather" name="Gather necessary documents" />
    <bpmn:task id="Task_regul" name="Check regulatory updates" />
    <bpmn:parallelGateway id="Gw_join1" />
    <bpmn:task id="Task_submit" name="Submit documents to the central audit team" />
    <bpmn:exclusiveGateway id="Gw_mreview" />
    <bpmn:task id="Task_review" name="Review the submission" />
    <bpmn:exclusiveGateway id="Gw_disc" name="Discrepancies found?" />
    <bpmn:task id="Task_request" name="Request clarifications from the regional office" />
    <bpmn:task id="Task_clarify" name="Provide necessary clarifications" />
    <bpmn:parallelGateway id="Gw_rsplit" />
    <bpmn:task id="Task_fin" name="Evaluate financial risks" />
    <bpmn:task id="Task_op" name="Evaluate operational risks" />
    <bpmn:task id="Task_comp" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="Gw_rjoin" />
    <bpmn:exclusiveGateway id="Gw_high" name="High risk identified?" />
    <bpmn:task id="Task_launch" name="Launch detailed investigation" />
    <bpmn:parallelGateway id="Gw_isplit" />
    <bpmn:task id="Task_data" name="Perform data analysis" />
    <bpmn:task id="Task_interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="Gw_site" name="Site visit needed?" />
    <bpmn:task id="Task_site" name="Conduct site visits" />
    <bpmn:exclusiveGateway id="Gw_smerge" />
    <bpmn:parallelGateway id="Gw_ijoin" />
    <bpmn:exclusiveGateway id="Gw_hmerge" />
    <bpmn:task id="Task_compile" name="Compile the audit report" />
    <bpmn:exclusiveGateway id="Gw_mrep" />
    <bpmn:task id="Task_dreview" name="Review the report" />
    <bpmn:exclusiveGateway id="Gw_app" name="Report approved?" />
    <bpmn:task id="Task_update" name="Update the report" />
    <bpmn:parallelGateway id="Gw_dsplit" />
    <bpmn:task id="Task_distribute" name="Distribute the final report to the executive board" />
    <bpmn:task id="Task_archive" name="Archive the final report" />
    <bpmn:parallelGateway id="Gw_djoin" />
    <bpmn:task id="Task_close" name="Close the audit process" />
    <bpmn:endEvent id="End_1" name="Audit process closed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_notify" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_notify" targetRef="Gw_split1" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_split1" targetRef="Task_prepare" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_split1" targetRef="Task_regul" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_prepare" targetRef="Task_gather" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_gather" targetRef="Gw_join1" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_regul" targetRef="Gw_join1" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_join1" targetRef="Task_submit" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_submit" targetRef="Gw_mreview" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_mreview" targetRef="Task_review" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_review" targetRef="Gw_disc" />
    <bpmn:sequenceFlow id="F_yesdisc" name="yes" sourceRef="Gw_disc" targetRef="Task_request" />
    <bpmn:sequenceFlow id="F_nodisc" name="no" sourceRef="Gw_disc" targetRef="Gw_rsplit" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_request" targetRef="Task_clarify" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_clarify" targetRef="Gw_mreview" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_rsplit" targetRef="Task_fin" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_rsplit" targetRef="Task_op" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_rsplit" targetRef="Task_comp" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_fin" targetRef="Gw_rjoin" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_op" targetRef="Gw_rjoin" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_comp" targetRef="Gw_rjoin" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_rjoin" targetRef="Gw_high" />
    <bpmn:sequenceFlow id="F_yeshigh" name="yes" sourceRef="Gw_high" targetRef="Task_launch" />
    <bpmn:sequenceFlow id="F_nohigh" name="no" sourceRef="Gw_high" targetRef="Gw_hmerge" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_launch" targetRef="Gw_isplit" />
    <bpmn:sequenceFlow id="F22" sourceRef="Gw_isplit" targetRef="Task_data" />
    <bpmn:sequenceFlow id="F23" sourceRef="Gw_isplit" targetRef="Task_interviews" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_isplit" targetRef="Gw_site" />
    <bpmn:sequenceFlow id="F_yessite" name="yes" sourceRef="Gw_site" targetRef="Task_site" />
    <bpmn:sequenceFlow id="F_nosite" name="no" sourceRef="Gw_site" targetRef="Gw_smerge" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_site" targetRef="Gw_smerge" />
    <bpmn:sequenceFlow id="F26" sourceRef="Gw_smerge" targetRef="Gw_ijoin" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_data" targetRef="Gw_ijoin" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_interviews" targetRef="Gw_ijoin" />
    <bpmn:sequenceFlow id="F29" sourceRef="Gw_ijoin" targetRef="Gw_hmerge" />
    <bpmn:sequenceFlow id="F30" sourceRef="Gw_hmerge" targetRef="Task_compile" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_compile" targetRef="Gw_mrep" />
    <bpmn:sequenceFlow id="F32" sourceRef="Gw_mrep" targetRef="Task_dreview" />
    <bpmn:sequenceFlow id="F33" sourceRef="Task_dreview" targetRef="Gw_app" />
    <bpmn:sequenceFlow id="F_appno" name="no" sourceRef="Gw_app" targetRef="Task_update" />
    <bpmn:sequenceFlow id="F_appyes" name="yes" sourceRef="Gw_app" targetRef="Gw_dsplit" />
    <bpmn:sequenceFlow id="F34" sourceRef="Task_update" targetRef="Gw_mrep" />
    <bpmn:sequenceFlow id="F35" sourceRef="Gw_dsplit" targetRef="Task_distribute" />
    <bpmn:sequenceFlow id="F36" sourceRef="Gw_dsplit" targetRef="Task_archive" />
    <bpmn:sequenceFlow id="F37" sourceRef="Task_distribute" targetRef="Gw_djoin" />
    <bpmn:sequenceFlow id="F38" sourceRef="Task_archive" targetRef="Gw_djoin" />
    <bpmn:sequenceFlow id="F39" sourceRef="Gw_djoin" targetRef="Task_close" />
    <bpmn:sequenceFlow id="F40" sourceRef="Task_close" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
