<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="E-commerce company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveBackorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_StockMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PostSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PostJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Task_Pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_FulfilSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GiftMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shipping" name="Shipping department">
        <bpmn:flowNodeRef>Task_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_IntlMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_FulfilJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Order" name="Order placed" />
    <bpmn:task id="Task_Record" name="Record order details" />
    <bpmn:task id="Task_Payment" name="Process payment" />
    <bpmn:exclusiveGateway id="Gw_Payment" name="Payment successful?" />
    <bpmn:task id="Task_NotifyFail" name="Notify customer of failed payment" />
    <bpmn:endEvent id="End_Failed" name="Order cancelled" />
    <bpmn:task id="Task_CheckStock" name="Check stock availability" />
    <bpmn:exclusiveGateway id="Gw_Stock" name="Items in stock?" />
    <bpmn:task id="Task_Backorder" name="Initiate back-order" />
    <bpmn:task id="Task_InformDelay" name="Inform customer about delay" />
    <bpmn:task id="Task_ReceiveBackorder" name="Receive back-order" />
    <bpmn:exclusiveGateway id="Gw_StockMerge" />
    <bpmn:task id="Task_Pick" name="Pick items from warehouse" />
    <bpmn:task id="Task_QC" name="Perform quality control checks" />
    <bpmn:parallelGateway id="Gw_FulfilSplit" />
    <bpmn:task id="Task_Package" name="Package items" />
    <bpmn:exclusiveGateway id="Gw_Gift" name="Gift wrapping requested?" />
    <bpmn:task id="Task_Gift" name="Wrap gift" />
    <bpmn:exclusiveGateway id="Gw_GiftMerge" />
    <bpmn:task id="Task_Docs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="Gw_Intl" name="Order international?" />
    <bpmn:task id="Task_Customs" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="Gw_IntlMerge" />
    <bpmn:parallelGateway id="Gw_FulfilJoin" />
    <bpmn:task id="Task_Dispatch" name="Dispatch order" />
    <bpmn:parallelGateway id="Gw_PostSplit" />
    <bpmn:task id="Task_SendConfirmation" name="Send shipping confirmation" />
    <bpmn:task id="Task_UpdateInventory" name="Update inventory levels" />
    <bpmn:parallelGateway id="Gw_PostJoin" />
    <bpmn:task id="Task_ConfirmDelivery" name="Confirm delivery" />
    <bpmn:exclusiveGateway id="Gw_Issues" name="Issues reported by customer?" />
    <bpmn:task id="Task_Feedback" name="Send follow-up email for feedback" />
    <bpmn:endEvent id="End_Done" name="Order completed" />
    <bpmn:task id="Task_SendLabel" name="Send return shipping label" />
    <bpmn:task id="Task_ReceiveReturn" name="Receive returned items" />
    <bpmn:task id="Task_InspectReturn" name="Inspect returned items" />
    <bpmn:task id="Task_Refund" name="Process refund or replacement" />
    <bpmn:endEvent id="End_Returned" name="Return handled" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Order" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Record" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Payment" targetRef="Gw_Payment" />
    <bpmn:sequenceFlow id="F_PayNo" name="no" sourceRef="Gw_Payment" targetRef="Task_NotifyFail" />
    <bpmn:sequenceFlow id="F_PayYes" name="yes" sourceRef="Gw_Payment" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_NotifyFail" targetRef="End_Failed" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_CheckStock" targetRef="Gw_Stock" />
    <bpmn:sequenceFlow id="F_StockNo" name="no" sourceRef="Gw_Stock" targetRef="Task_Backorder" />
    <bpmn:sequenceFlow id="F_StockYes" name="yes" sourceRef="Gw_Stock" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Backorder" targetRef="Task_InformDelay" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_InformDelay" targetRef="Task_ReceiveBackorder" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_ReceiveBackorder" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_StockMerge" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Pick" targetRef="Task_QC" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_QC" targetRef="Gw_FulfilSplit" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_FulfilSplit" targetRef="Task_Package" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_FulfilSplit" targetRef="Task_Docs" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Package" targetRef="Gw_Gift" />
    <bpmn:sequenceFlow id="F_GiftYes" name="yes" sourceRef="Gw_Gift" targetRef="Task_Gift" />
    <bpmn:sequenceFlow id="F_GiftNo" name="no" sourceRef="Gw_Gift" targetRef="Gw_GiftMerge" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Gift" targetRef="Gw_GiftMerge" />
    <bpmn:sequenceFlow id="F22" sourceRef="Gw_GiftMerge" targetRef="Gw_FulfilJoin" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Docs" targetRef="Gw_Intl" />
    <bpmn:sequenceFlow id="F_IntlYes" name="yes" sourceRef="Gw_Intl" targetRef="Task_Customs" />
    <bpmn:sequenceFlow id="F_IntlNo" name="no" sourceRef="Gw_Intl" targetRef="Gw_IntlMerge" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Customs" targetRef="Gw_IntlMerge" />
    <bpmn:sequenceFlow id="F27" sourceRef="Gw_IntlMerge" targetRef="Gw_FulfilJoin" />
    <bpmn:sequenceFlow id="F28" sourceRef="Gw_FulfilJoin" targetRef="Task_Dispatch" />
    <bpmn:sequenceFlow id="F29" sourceRef="Task_Dispatch" targetRef="Gw_PostSplit" />
    <bpmn:sequenceFlow id="F30" sourceRef="Gw_PostSplit" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="F31" sourceRef="Gw_PostSplit" targetRef="Task_UpdateInventory" />
    <bpmn:sequenceFlow id="F32" sourceRef="Task_SendConfirmation" targetRef="Gw_PostJoin" />
    <bpmn:sequenceFlow id="F33" sourceRef="Task_UpdateInventory" targetRef="Gw_PostJoin" />
    <bpmn:sequenceFlow id="F34" sourceRef="Gw_PostJoin" targetRef="Task_ConfirmDelivery" />
    <bpmn:sequenceFlow id="F35" sourceRef="Task_ConfirmDelivery" targetRef="Gw_Issues" />
    <bpmn:sequenceFlow id="F_IssuesNo" name="no" sourceRef="Gw_Issues" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="F_IssuesYes" name="yes" sourceRef="Gw_Issues" targetRef="Task_SendLabel" />
    <bpmn:sequenceFlow id="F38" sourceRef="Task_Feedback" targetRef="End_Done" />
    <bpmn:sequenceFlow id="F39" sourceRef="Task_SendLabel" targetRef="Task_ReceiveReturn" />
    <bpmn:sequenceFlow id="F40" sourceRef="Task_ReceiveReturn" targetRef="Task_InspectReturn" />
    <bpmn:sequenceFlow id="F41" sourceRef="Task_InspectReturn" targetRef="Task_Refund" />
    <bpmn:sequenceFlow id="F42" sourceRef="Task_Refund" targetRef="End_Returned" />
  </bpmn:process>
</bpmn:definitions>
