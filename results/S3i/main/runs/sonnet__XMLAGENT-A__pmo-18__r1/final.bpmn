<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="University" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_Student" name="Student">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_IdCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Semester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AddDropM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GrievanceM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Finished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Gw_ReviewM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReviewApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_Split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_Join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PostGrades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Committee" name="Admissions Committee">
        <bpmn:flowNodeRef>T_Evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Finance" name="Finance Department">
        <bpmn:flowNodeRef>T_Fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_IT" name="IT Department">
        <bpmn:flowNodeRef>T_Accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Intl" name="International Student Office">
        <bpmn:flowNodeRef>Gw_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_IntlM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>T_MeetAppeals</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Application needed" />
    <bpmn:task id="T_Submit" name="Submit application online" />
    <bpmn:exclusiveGateway id="Gw_ReviewM" />
    <bpmn:task id="T_ReviewApp" name="Review application and supporting documents" />
    <bpmn:exclusiveGateway id="Gw_Docs" name="Documents missing?" default="F_DocsNo" />
    <bpmn:task id="T_Notify" name="Notify applicant to provide missing items" />
    <bpmn:task id="T_Provide" name="Provide missing documents" />
    <bpmn:parallelGateway id="Par_Split1" />
    <bpmn:task id="T_Evaluate" name="Evaluate application" />
    <bpmn:task id="T_Fees" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="Par_Join1" />
    <bpmn:exclusiveGateway id="Gw_Accepted" name="Application accepted?" default="F_AccNo" />
    <bpmn:task id="T_Reject" name="Send rejection letter" />
    <bpmn:endEvent id="End_Rejected" name="Application rejected" />
    <bpmn:task id="T_Accept" name="Send acceptance letter" />
    <bpmn:task id="T_Confirm" name="Confirm enrollment" />
    <bpmn:boundaryEvent id="B_Deadline" name="Deadline passed" attachedToRef="T_Confirm">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="T_Cancel" name="Cancel application" />
    <bpmn:endEvent id="End_Canceled" name="Application canceled" />
    <bpmn:parallelGateway id="Par_Split2" />
    <bpmn:task id="T_Orientation" name="Receive orientation materials" />
    <bpmn:task id="T_Accounts" name="Set up student accounts for email, online portals and library access" />
    <bpmn:exclusiveGateway id="Gw_Intl" name="Student international?" default="F_IntlNo" />
    <bpmn:task id="T_Visa" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="Gw_IntlM" />
    <bpmn:parallelGateway id="Par_Join2" />
    <bpmn:task id="T_IdCard" name="Obtain student ID card" />
    <bpmn:task id="T_Advisor" name="Meet with academic advisor" />
    <bpmn:task id="T_Select" name="Select courses" />
    <bpmn:task id="T_Resolve" name="Resolve schedule conflicts" />
    <bpmn:exclusiveGateway id="Gw_Semester" />
    <bpmn:task id="T_Attend" name="Attend classes" />
    <bpmn:exclusiveGateway id="Gw_AddDrop" name="Add or drop courses?" default="F_AdNo" />
    <bpmn:task id="T_AddDrop" name="Add or drop courses" />
    <bpmn:exclusiveGateway id="Gw_AddDropM" />
    <bpmn:task id="T_PostGrades" name="Post grades" />
    <bpmn:task id="T_ReviewGrades" name="Review grades online" />
    <bpmn:exclusiveGateway id="Gw_Grievance" name="Grievances?" default="F_GrNo" />
    <bpmn:task id="T_Form" name="Submit appeal form" />
    <bpmn:task id="T_MeetAppeals" name="Meet with appeals committee" />
    <bpmn:task id="T_Await" name="Await decision" />
    <bpmn:exclusiveGateway id="Gw_GrievanceM" />
    <bpmn:exclusiveGateway id="Gw_Finished" name="Graduated or withdrawn?" default="F_FinNo" />
    <bpmn:endEvent id="End_Done" name="Student graduated or withdrew" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Submit" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Submit" targetRef="Gw_ReviewM" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_ReviewM" targetRef="T_ReviewApp" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_ReviewApp" targetRef="Gw_Docs" />
    <bpmn:sequenceFlow id="F_DocsYes" name="yes" sourceRef="Gw_Docs" targetRef="T_Notify">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">documentsMissing = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_DocsNo" name="no" sourceRef="Gw_Docs" targetRef="Par_Split1" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Notify" targetRef="T_Provide" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_Provide" targetRef="Gw_ReviewM" />
    <bpmn:sequenceFlow id="F9" sourceRef="Par_Split1" targetRef="T_Evaluate" />
    <bpmn:sequenceFlow id="F10" sourceRef="Par_Split1" targetRef="T_Fees" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Evaluate" targetRef="Par_Join1" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Fees" targetRef="Par_Join1" />
    <bpmn:sequenceFlow id="F13" sourceRef="Par_Join1" targetRef="Gw_Accepted" />
    <bpmn:sequenceFlow id="F_AccYes" name="yes" sourceRef="Gw_Accepted" targetRef="T_Accept">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_AccNo" name="no" sourceRef="Gw_Accepted" targetRef="T_Reject" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Accept" targetRef="T_Confirm" />
    <bpmn:sequenceFlow id="F18" sourceRef="B_Deadline" targetRef="T_Cancel" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Cancel" targetRef="End_Canceled" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_Confirm" targetRef="Par_Split2" />
    <bpmn:sequenceFlow id="F21" sourceRef="Par_Split2" targetRef="T_Orientation" />
    <bpmn:sequenceFlow id="F22" sourceRef="Par_Split2" targetRef="T_Accounts" />
    <bpmn:sequenceFlow id="F23" sourceRef="Par_Split2" targetRef="Gw_Intl" />
    <bpmn:sequenceFlow id="F_IntlYes" name="yes" sourceRef="Gw_Intl" targetRef="T_Visa">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_IntlNo" name="no" sourceRef="Gw_Intl" targetRef="Gw_IntlM" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_Visa" targetRef="Gw_IntlM" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_Orientation" targetRef="Par_Join2" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_Accounts" targetRef="Par_Join2" />
    <bpmn:sequenceFlow id="F29" sourceRef="Gw_IntlM" targetRef="Par_Join2" />
    <bpmn:sequenceFlow id="F30" sourceRef="Par_Join2" targetRef="T_IdCard" />
    <bpmn:sequenceFlow id="F31" sourceRef="T_IdCard" targetRef="T_Advisor" />
    <bpmn:sequenceFlow id="F32" sourceRef="T_Advisor" targetRef="T_Select" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_Select" targetRef="T_Resolve" />
    <bpmn:sequenceFlow id="F34" sourceRef="T_Resolve" targetRef="Gw_Semester" />
    <bpmn:sequenceFlow id="F35" sourceRef="Gw_Semester" targetRef="T_Attend" />
    <bpmn:sequenceFlow id="F36" sourceRef="T_Attend" targetRef="Gw_AddDrop" />
    <bpmn:sequenceFlow id="F_AdYes" name="yes" sourceRef="Gw_AddDrop" targetRef="T_AddDrop">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">changeCourses = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_AdNo" name="no" sourceRef="Gw_AddDrop" targetRef="Gw_AddDropM" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_AddDrop" targetRef="Gw_AddDropM" />
    <bpmn:sequenceFlow id="F40" sourceRef="Gw_AddDropM" targetRef="T_PostGrades" />
    <bpmn:sequenceFlow id="F41" sourceRef="T_PostGrades" targetRef="T_ReviewGrades" />
    <bpmn:sequenceFlow id="F42" sourceRef="T_ReviewGrades" targetRef="Gw_Grievance" />
    <bpmn:sequenceFlow id="F_GrYes" name="yes" sourceRef="Gw_Grievance" targetRef="T_Form">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">grievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_GrNo" name="no" sourceRef="Gw_Grievance" targetRef="Gw_GrievanceM" />
    <bpmn:sequenceFlow id="F45" sourceRef="T_Form" targetRef="T_MeetAppeals" />
    <bpmn:sequenceFlow id="F46" sourceRef="T_MeetAppeals" targetRef="T_Await" />
    <bpmn:sequenceFlow id="F47" sourceRef="T_Await" targetRef="Gw_GrievanceM" />
    <bpmn:sequenceFlow id="F48" sourceRef="Gw_GrievanceM" targetRef="Gw_Finished" />
    <bpmn:sequenceFlow id="F_FinYes" name="yes" sourceRef="Gw_Finished" targetRef="End_Done">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">finished = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_FinNo" name="no, next semester" sourceRef="Gw_Finished" targetRef="Gw_Semester" />
  </bpmn:process>
</bpmn:definitions>
