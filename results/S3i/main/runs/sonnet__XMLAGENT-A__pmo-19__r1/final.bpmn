<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Online shop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PayJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shop" name="Online shop">
        <bpmn:flowNodeRef>Gw_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Order started" />
    <bpmn:task id="Task_Login" name="Log in to account" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Select" name="Select items" />
    <bpmn:task id="Task_Reward" name="Choose free reward" />
    <bpmn:task id="Task_Method" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gw_Pay" name="Pay or installment?" />
    <bpmn:task id="Task_Pay" name="Pay" />
    <bpmn:task id="Task_Install" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gw_PayJoin" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:exclusiveGateway id="Gw_Deliver" />
    <bpmn:task id="Task_Deliver" name="Deliver items" />
    <bpmn:exclusiveGateway id="Gw_Return" name="Items returned for exchange?" />
    <bpmn:task id="Task_Return" name="Return items" />
    <bpmn:endEvent id="End" name="Order completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Login" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Split" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split" targetRef="Task_Method" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Select" targetRef="Task_Reward" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Method" targetRef="Gw_Pay" />
    <bpmn:sequenceFlow id="F_Pay" name="pay" sourceRef="Gw_Pay" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="F_Inst" name="installment" sourceRef="Gw_Pay" targetRef="Task_Install" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Pay" targetRef="Gw_PayJoin" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Install" targetRef="Gw_PayJoin" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_PayJoin" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Reward" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_Join" targetRef="Gw_Deliver" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Deliver" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Deliver" targetRef="Gw_Return" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Return" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="F_No" name="no" sourceRef="Gw_Return" targetRef="End" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Return" targetRef="Gw_Deliver" />
  </bpmn:process>
</bpmn:definitions>
