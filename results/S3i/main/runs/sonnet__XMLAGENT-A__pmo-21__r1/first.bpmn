<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Shipping organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_InsuranceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Head" name="Logistics department head">
        <bpmn:flowNodeRef>Task_Insurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>Task_Package</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Goods shall be shipped" />
    <bpmn:task id="Task_Clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="Gw_Large" name="Large amounts?" default="F_Small" />
    <bpmn:task id="Task_Invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="Task_Select" name="Select one logistic company" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Label" name="Write package label" />
    <bpmn:exclusiveGateway id="Gw_Insurance" name="Insurance necessary?" default="F_NoIns" />
    <bpmn:task id="Task_Insurance" name="Take parcel insurance" />
    <bpmn:exclusiveGateway id="Gw_InsuranceMerge" />
    <bpmn:task id="Task_Package" name="Package the goods" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Prepare" name="Prepare the packaged goods for being picked up" />
    <bpmn:endEvent id="End" name="Goods ready for pick-up" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Clarify" targetRef="Gw_Large" />
    <bpmn:sequenceFlow id="F_Large" name="yes" sourceRef="Gw_Large" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="F_Small" name="no" sourceRef="Gw_Large" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Invite" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Select" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split" targetRef="Task_Label" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Split" targetRef="Task_Package" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Label" targetRef="Gw_Insurance" />
    <bpmn:sequenceFlow id="F_Ins" name="yes" sourceRef="Gw_Insurance" targetRef="Task_Insurance" />
    <bpmn:sequenceFlow id="F_NoIns" name="no" sourceRef="Gw_Insurance" targetRef="Gw_InsuranceMerge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Insurance" targetRef="Gw_InsuranceMerge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_InsuranceMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Package" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Join" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Merge" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Prepare" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>