<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Bank" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Clerk" name="Sales clerk">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bank" name="Banking system">
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agency" name="Agency">
        <bpmn:flowNodeRef>Task_Quick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Credit-scoring needed" />
    <bpmn:task id="Task_Receive" name="Receive credit-scoring" />
    <bpmn:task id="Task_Send" name="Send scoring request" />
    <bpmn:task id="Task_Quick" name="Do first quick scoring" />
    <bpmn:exclusiveGateway id="Gw_Immediate" name="Result immediately available?" default="F_no" />
    <bpmn:task id="Task_Return" name="Return result to banking system" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Inform" name="Inform banking process of delay" />
    <bpmn:task id="Task_Display" name="Display message to check again later" />
    <bpmn:task id="Task_Level2" name="Do level 2 scoring" />
    <bpmn:task id="Task_SendBack" name="Send scoring result back to banking process" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Present" name="Present result to clerk" />
    <bpmn:endEvent id="End_1" name="Result seen at frontend" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Receive" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Send" targetRef="Task_Quick" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Quick" targetRef="Gw_Immediate" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Immediate" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Immediate" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Return" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Split" targetRef="Task_Inform" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Split" targetRef="Task_Level2" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Inform" targetRef="Task_Display" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Display" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Level2" targetRef="Task_SendBack" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_SendBack" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Join" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Merge" targetRef="Task_Present" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Present" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>