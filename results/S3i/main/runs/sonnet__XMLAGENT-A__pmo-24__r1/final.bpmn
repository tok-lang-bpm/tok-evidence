<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Restaurant" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_POS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Money</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform_Chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_React</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Hand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform_Emp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Guest feels hungry" />
    <bpmn:task id="Task_Enter" name="Enter the restaurant" />
    <bpmn:task id="Task_Choose" name="Choose a dish from the changing meal range" />
    <bpmn:task id="Task_Wait" name="Wait until it is his turn" />
    <bpmn:task id="Task_Order" name="Place the order with the employee" />
    <bpmn:task id="Task_POS" name="Enter the order into the POS system" />
    <bpmn:task id="Task_Money" name="Collect the money from the guest" />
    <bpmn:task id="Task_Buzzer" name="Set up a buzzer" />
    <bpmn:task id="Task_Pass" name="Pass the buzzer on to the guest" />
    <bpmn:task id="Task_Inform_Chef" name="Inform the chef of the new meal order" />
    <bpmn:task id="Task_Prepare" name="Prepare the meal" />
    <bpmn:task id="Task_Place" name="Place the meal in the service hatch" />
    <bpmn:task id="Task_Inform_Emp" name="Inform the employee that the meal is in the service hatch" />
    <bpmn:task id="Task_SetOff" name="Set off the guest's buzzer" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:exclusiveGateway id="Gw_React" name="Guest reacted to the buzzer?" />
    <bpmn:intermediateCatchEvent id="Timer_5" name="5 minutes">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Call" name="Call for the guest" />
    <bpmn:task id="Task_Hand" name="Hand over the meal" />
    <bpmn:task id="Task_Pickup" name="Pick up the meal" />
    <bpmn:task id="Task_Eat" name="Eat the meal" />
    <bpmn:endEvent id="End_1" name="Meal eaten" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Enter" targetRef="Task_Choose" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Choose" targetRef="Task_Wait" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Wait" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Order" targetRef="Task_POS" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_POS" targetRef="Task_Money" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Money" targetRef="Task_Buzzer" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Buzzer" targetRef="Task_Pass" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Pass" targetRef="Task_Inform_Chef" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Inform_Chef" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Prepare" targetRef="Task_Place" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Place" targetRef="Task_Inform_Emp" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Inform_Emp" targetRef="Task_SetOff" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_SetOff" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Merge" targetRef="Gw_React" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_React" targetRef="Task_Hand" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_React" targetRef="Timer_5" />
    <bpmn:sequenceFlow id="F16" sourceRef="Timer_5" targetRef="Task_Call" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Call" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Hand" targetRef="Task_Pickup" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Pickup" targetRef="Task_Eat" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Eat" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
