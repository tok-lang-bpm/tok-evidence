<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Find a Job" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_A" name="Job applicant">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_rateco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_j2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="Company">
        <bpmn:flowNodeRef>Task_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_want</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_rateap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_year</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_perm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Job search started" />
    <bpmn:exclusiveGateway id="Gw_m1" />
    <bpmn:task id="Task_write" name="Write job application" />
    <bpmn:parallelGateway id="Gw_s1" />
    <bpmn:task id="Task_report" name="Report job applications" />
    <bpmn:task id="Task_confirm" name="Confirm receipt of job application" />
    <bpmn:task id="Task_rate" name="Rate job application" />
    <bpmn:parallelGateway id="Gw_j1" />
    <bpmn:task id="Task_offers" name="Send new job offers" />
    <bpmn:exclusiveGateway id="Gw_int" name="Job interview negotiated?" />
    <bpmn:task id="Task_neg" name="Negotiate job interview" />
    <bpmn:exclusiveGateway id="Gw_m2" />
    <bpmn:exclusiveGateway id="Gw_want" name="Company wants you to work for them?" />
    <bpmn:task id="Task_prob" name="Enter probation phase" />
    <bpmn:parallelGateway id="Gw_s2" />
    <bpmn:task id="Task_rateco" name="Rate company" />
    <bpmn:task id="Task_rateap" name="Rate applicant" />
    <bpmn:parallelGateway id="Gw_j2" />
    <bpmn:intermediateCatchEvent id="Catch_year" name="After 1 year">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_show" name="Show company reviews to job applicants" />
    <bpmn:exclusiveGateway id="Gw_perm" name="Job permanent?" />
    <bpmn:exclusiveGateway id="Gw_c" name="Company rated C or less?" />
    <bpmn:task id="Task_cont" name="Continue to receive job offers" />
    <bpmn:endEvent id="End_1" name="Process ended" />
    <bpmn:endEvent id="End_2" name="Offers continue without reporting" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Gw_m1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gw_m1" targetRef="Task_write" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_write" targetRef="Gw_s1" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_s1" targetRef="Task_report" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_s1" targetRef="Task_confirm" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_confirm" targetRef="Task_rate" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_report" targetRef="Gw_j1" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_rate" targetRef="Gw_j1" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_j1" targetRef="Task_offers" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_offers" targetRef="Gw_int" />
    <bpmn:sequenceFlow id="F_int_yes" name="yes" sourceRef="Gw_int" targetRef="Task_neg" />
    <bpmn:sequenceFlow id="F_int_no" name="no" sourceRef="Gw_int" targetRef="Gw_m2" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_neg" targetRef="Gw_m2" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_m2" targetRef="Gw_want" />
    <bpmn:sequenceFlow id="F_want_yes" name="yes" sourceRef="Gw_want" targetRef="Task_prob" />
    <bpmn:sequenceFlow id="F_want_no" name="no" sourceRef="Gw_want" targetRef="Gw_m1" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_prob" targetRef="Gw_s2" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_s2" targetRef="Task_rateco" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_s2" targetRef="Task_rateap" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_rateco" targetRef="Gw_j2" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_rateap" targetRef="Gw_j2" />
    <bpmn:sequenceFlow id="F22" sourceRef="Gw_j2" targetRef="Catch_year" />
    <bpmn:sequenceFlow id="F23" sourceRef="Catch_year" targetRef="Task_show" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_show" targetRef="Gw_perm" />
    <bpmn:sequenceFlow id="F_perm_yes" name="yes" sourceRef="Gw_perm" targetRef="Gw_c" />
    <bpmn:sequenceFlow id="F_perm_no" name="no" sourceRef="Gw_perm" targetRef="Gw_m1" />
    <bpmn:sequenceFlow id="F_c_yes" name="yes" sourceRef="Gw_c" targetRef="Task_cont" />
    <bpmn:sequenceFlow id="F_c_no" name="no" sourceRef="Gw_c" targetRef="End_1" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_cont" targetRef="End_2" />
  </bpmn:process>
</bpmn:definitions>
