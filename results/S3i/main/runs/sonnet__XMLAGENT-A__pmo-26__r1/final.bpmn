<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_1" name="Maternity leave" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_Parent" name="Parent">
        <bpmn:flowNodeRef>Select_Model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decide_Extension</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service" name="Leave service">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fetch_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Collect_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_SS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify_Company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gather_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Maternity leave planned" />
    <bpmn:task id="Fetch_Info" name="Fetch information about potential models" />
    <bpmn:task id="Select_Model" name="Select model" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Collect_Info" name="Collect relevant information" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Notify_SS" name="Notify Social Security" />
    <bpmn:task id="Notify_Company" name="Notify Company" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Gather_Info" name="Gather information from companies" />
    <bpmn:task id="Decide_Extension" name="Decide about extension" />
    <bpmn:exclusiveGateway id="Gw_Extend" name="Extend leave?" />
    <bpmn:endEvent id="End_1" name="Maternity leave finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Fetch_Info" />
    <bpmn:sequenceFlow id="F2" sourceRef="Fetch_Info" targetRef="Select_Model" />
    <bpmn:sequenceFlow id="F3" sourceRef="Select_Model" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Merge" targetRef="Collect_Info" />
    <bpmn:sequenceFlow id="F5" sourceRef="Collect_Info" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Split" targetRef="Notify_SS" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Split" targetRef="Notify_Company" />
    <bpmn:sequenceFlow id="F8" sourceRef="Notify_SS" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F9" sourceRef="Notify_Company" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Join" targetRef="Gather_Info" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gather_Info" targetRef="Decide_Extension" />
    <bpmn:sequenceFlow id="F12" sourceRef="Decide_Extension" targetRef="Gw_Extend" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Extend" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_No" name="no" sourceRef="Gw_Extend" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
