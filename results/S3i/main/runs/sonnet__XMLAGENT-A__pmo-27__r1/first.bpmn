<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employer" name="Employer">
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Near</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Near</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Serious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Labour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Insurer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Accident or near accident occurs" />
    <bpmn:task id="Task_Inform" name="Inform the employer immediately" />
    <bpmn:task id="Task_Record" name="Record the accident information" />
    <bpmn:exclusiveGateway id="Gw_Work" name="Work accident?" default="F_NoWork" />
    <bpmn:task id="Task_Near" name="Document the near accident" />
    <bpmn:endEvent id="End_Near" name="Near accident documented" />
    <bpmn:exclusiveGateway id="Gw_Serious" name="Fatality or serious injury not reported to emergency services?" default="F_NoSerious" />
    <bpmn:task id="Task_Labour" name="Report the accident to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:exclusiveGateway id="Gw_Insured" name="Insured person killed or unable to work for three days?" default="F_NoInsured" />
    <bpmn:task id="Task_Insurer" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:exclusiveGateway id="Gw_Merge2" />
    <bpmn:endEvent id="End_1" name="Accident reported" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Inform" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Inform" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Record" targetRef="Gw_Work" />
    <bpmn:sequenceFlow id="F_NoWork" name="no" sourceRef="Gw_Work" targetRef="Task_Near" />
    <bpmn:sequenceFlow id="F_YesWork" name="yes" sourceRef="Gw_Work" targetRef="Gw_Serious" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Near" targetRef="End_Near" />
    <bpmn:sequenceFlow id="F_YesSerious" name="yes" sourceRef="Gw_Serious" targetRef="Task_Labour" />
    <bpmn:sequenceFlow id="F_NoSerious" name="no" sourceRef="Gw_Serious" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Labour" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Merge" targetRef="Gw_Insured" />
    <bpmn:sequenceFlow id="F_YesInsured" name="yes" sourceRef="Gw_Insured" targetRef="Task_Insurer" />
    <bpmn:sequenceFlow id="F_NoInsured" name="no" sourceRef="Gw_Insured" targetRef="Gw_Merge2" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Insurer" targetRef="Gw_Merge2" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Merge2" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>