<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Internship" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StudentUpd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Task_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Internship wanted" />
    <bpmn:task id="Task_Topic" name="Enter topic and salary" />
    <bpmn:task id="Task_Exp" name="Enter experience and hobbies" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Offer" name="Send offer" />
    <bpmn:task id="Task_Review" name="Review offer" />
    <bpmn:exclusiveGateway id="Gw_Accept" name="Offer accepted?" />
    <bpmn:task id="Task_Deny" name="Deny offer" />
    <bpmn:task id="Task_Accept" name="Accept offer" />
    <bpmn:task id="Task_Invalid" name="Invalidate all other offers" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_StudentUpd" name="Write status update about the internship">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:task>
    <bpmn:task id="Task_CompanyUpd" name="Write status update about the student">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:task>
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Finish" name="Finish internship" />
    <bpmn:task id="Task_Tweet" name="Tweet recommendation to friend">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="End" name="Internship completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Topic" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Topic" targetRef="Task_Exp" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Exp" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Merge" targetRef="Task_Offer" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Offer" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Review" targetRef="Gw_Accept" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Accept" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="F_No" name="no" sourceRef="Gw_Accept" targetRef="Task_Deny" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Deny" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Accept" targetRef="Task_Invalid" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Invalid" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_StudentUpd" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_CompanyUpd" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_StudentUpd" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_CompanyUpd" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Join" targetRef="Task_Finish" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Finish" targetRef="Task_Tweet" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Tweet" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
