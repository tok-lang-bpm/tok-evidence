<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Work and Live in Austria" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_travel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_means</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_evid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_office</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_live_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_live</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Office" name="Representation office">
        <bpmn:flowNodeRef>Gw_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Stay in Austria planned" />
    <bpmn:task id="Task_check" name="Check the requirements for working and living in Austria" />
    <bpmn:parallelGateway id="Gw_split" />
    <bpmn:task id="Task_acc" name="Organize accommodation" />
    <bpmn:task id="Task_bank" name="Open bank account" />
    <bpmn:task id="Task_form" name="Fill in visa application form" />
    <bpmn:task id="Task_travel" name="Check travel document" />
    <bpmn:task id="Task_photo" name="Take passport photo" />
    <bpmn:task id="Task_ins" name="Arrange travel health insurance" />
    <bpmn:task id="Task_means" name="Prove means of subsistence" />
    <bpmn:task id="Task_evid" name="Collect other evidence" />
    <bpmn:parallelGateway id="Gw_join" />
    <bpmn:task id="Task_office" name="Determine the competent representation office" />
    <bpmn:task id="Task_submit" name="Submit visa application" />
    <bpmn:exclusiveGateway id="Gw_merge" />
    <bpmn:task id="Task_exam" name="Examine visa application" />
    <bpmn:exclusiveGateway id="Gw_complete" name="Application complete?" default="F_incomplete" />
    <bpmn:task id="Task_request" name="Request additional documents" />
    <bpmn:task id="Task_provide" name="Provide additional documents" />
    <bpmn:task id="Task_decide" name="Check grounds for refusal" />
    <bpmn:exclusiveGateway id="Gw_ok" name="Visa granted?" default="F_no" />
    <bpmn:task id="Task_issue" name="Issue visa" />
    <bpmn:task id="Task_refuse" name="Refuse visa" />
    <bpmn:endEvent id="End_refused" name="Visa refused" />
    <bpmn:task id="Task_collect" name="Collect visa" />
    <bpmn:exclusiveGateway id="Gw_live_merge" />
    <bpmn:task id="Task_live" name="Work and live in Austria" />
    <bpmn:exclusiveGateway id="Gw_ext" name="Visa extension needed?" default="F_noext" />
    <bpmn:task id="Task_extend" name="Apply for visa extension" />
    <bpmn:endEvent id="End_done" name="Stay ended" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_check" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_check" targetRef="Gw_split" />
    <bpmn:sequenceFlow id="F3a" sourceRef="Gw_split" targetRef="Task_acc" />
    <bpmn:sequenceFlow id="F3b" sourceRef="Gw_split" targetRef="Task_bank" />
    <bpmn:sequenceFlow id="F3c" sourceRef="Gw_split" targetRef="Task_form" />
    <bpmn:sequenceFlow id="F3d" sourceRef="Gw_split" targetRef="Task_travel" />
    <bpmn:sequenceFlow id="F3e" sourceRef="Gw_split" targetRef="Task_photo" />
    <bpmn:sequenceFlow id="F3f" sourceRef="Gw_split" targetRef="Task_ins" />
    <bpmn:sequenceFlow id="F3g" sourceRef="Gw_split" targetRef="Task_means" />
    <bpmn:sequenceFlow id="F3h" sourceRef="Gw_split" targetRef="Task_evid" />
    <bpmn:sequenceFlow id="F4a" sourceRef="Task_acc" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4b" sourceRef="Task_bank" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4c" sourceRef="Task_form" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4d" sourceRef="Task_travel" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4e" sourceRef="Task_photo" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4f" sourceRef="Task_ins" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4g" sourceRef="Task_means" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F4h" sourceRef="Task_evid" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_join" targetRef="Task_office" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_office" targetRef="Task_submit" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_submit" targetRef="Gw_merge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_merge" targetRef="Task_exam" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_exam" targetRef="Gw_complete" />
    <bpmn:sequenceFlow id="F_yes1" name="yes" sourceRef="Gw_complete" targetRef="Task_decide" />
    <bpmn:sequenceFlow id="F_incomplete" name="no" sourceRef="Gw_complete" targetRef="Task_request" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_request" targetRef="Task_provide" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_provide" targetRef="Gw_merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_decide" targetRef="Gw_ok" />
    <bpmn:sequenceFlow id="F_yes2" name="yes" sourceRef="Gw_ok" targetRef="Task_issue" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_ok" targetRef="Task_refuse" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_refuse" targetRef="End_refused" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_issue" targetRef="Task_collect" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_collect" targetRef="Gw_live_merge" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_live_merge" targetRef="Task_live" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_live" targetRef="Gw_ext" />
    <bpmn:sequenceFlow id="F_ext" name="yes" sourceRef="Gw_ext" targetRef="Task_extend" />
    <bpmn:sequenceFlow id="F_noext" name="no" sourceRef="Gw_ext" targetRef="End_done" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_extend" targetRef="Gw_live_merge" />
  </bpmn:process>
</bpmn:definitions>