<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Party" name="LAN Party" processRef="Process_Party" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Party" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Host" name="Host">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DateMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GamesMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BeerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="LAN party planned" />
    <bpmn:task id="Task_Invite" name="Send invitations to 10 friends" />
    <bpmn:task id="Task_Games" name="Find out which games friends want to play" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:exclusiveGateway id="Gw_DateMerge" />
    <bpmn:task id="Task_Date" name="Appoint a date" />
    <bpmn:exclusiveGateway id="Gw_Agree" name="8 or more people agree?" />
    <bpmn:task id="Task_CheckGames" name="Find out if you have all the games" />
    <bpmn:exclusiveGateway id="Gw_Missing" name="Some games missing?" />
    <bpmn:task id="Task_Download" name="Download missing games" />
    <bpmn:exclusiveGateway id="Gw_GamesMerge" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Beer" name="Find out how much beer friends require" />
    <bpmn:exclusiveGateway id="Gw_Enough" name="Enough beer?" />
    <bpmn:task id="Task_Buy" name="Buy missing beer" />
    <bpmn:exclusiveGateway id="Gw_BeerMerge" />
    <bpmn:task id="Task_Enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="End" name="LAN party held" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Invite" targetRef="Task_Games" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Games" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split" targetRef="Gw_DateMerge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split" targetRef="Task_CheckGames" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_DateMerge" targetRef="Task_Date" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Date" targetRef="Gw_Agree" />
    <bpmn:sequenceFlow id="F_AgreeNo" name="no" sourceRef="Gw_Agree" targetRef="Gw_DateMerge" />
    <bpmn:sequenceFlow id="F_AgreeYes" name="yes" sourceRef="Gw_Agree" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_CheckGames" targetRef="Gw_Missing" />
    <bpmn:sequenceFlow id="F_MissYes" name="yes" sourceRef="Gw_Missing" targetRef="Task_Download" />
    <bpmn:sequenceFlow id="F_MissNo" name="no" sourceRef="Gw_Missing" targetRef="Gw_GamesMerge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Download" targetRef="Gw_GamesMerge" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_GamesMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Join" targetRef="Task_Beer" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Beer" targetRef="Gw_Enough" />
    <bpmn:sequenceFlow id="F_EnoughNo" name="no" sourceRef="Gw_Enough" targetRef="Task_Buy" />
    <bpmn:sequenceFlow id="F_EnoughYes" name="yes" sourceRef="Gw_Enough" targetRef="Gw_BeerMerge" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Buy" targetRef="Gw_BeerMerge" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_BeerMerge" targetRef="Task_Enjoy" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Enjoy" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
