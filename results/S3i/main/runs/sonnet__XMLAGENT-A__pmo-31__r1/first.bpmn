<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Blizzard Online Character Generator" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Player" name="Player">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_names</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_checkAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_enterAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_accMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_checkSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_iban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_payMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_subMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_nameMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_enterName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Character creation started" />
    <bpmn:parallelGateway id="Gw_split" />
    <bpmn:task id="Task_names" name="Come up with character names" />
    <bpmn:task id="Task_checkAcc" name="Check battle.net account" />
    <bpmn:exclusiveGateway id="Gw_acc" name="Battle.net account exists?" default="F_accYes" />
    <bpmn:task id="Task_enterAcc" name="Enter account information" />
    <bpmn:task id="Task_link" name="Click link in confirmation mail" />
    <bpmn:exclusiveGateway id="Gw_accMerge" />
    <bpmn:task id="Task_checkSub" name="Check WoW subscription" />
    <bpmn:exclusiveGateway id="Gw_sub" name="Subscription active?" default="F_subYes" />
    <bpmn:task id="Task_payment" name="Select payment method" />
    <bpmn:exclusiveGateway id="Gw_pay" name="Payment method?" default="F_payBank" />
    <bpmn:task id="Task_card" name="Enter credit card information" />
    <bpmn:task id="Task_iban" name="Enter IBAN and BIC numbers" />
    <bpmn:exclusiveGateway id="Gw_payMerge" />
    <bpmn:exclusiveGateway id="Gw_subMerge" />
    <bpmn:task id="Task_login" name="Log into game" />
    <bpmn:task id="Task_select" name="Select realm, race and class" />
    <bpmn:parallelGateway id="Gw_join" />
    <bpmn:exclusiveGateway id="Gw_nameMerge" />
    <bpmn:task id="Task_enterName" name="Enter character name" />
    <bpmn:exclusiveGateway id="Gw_avail" name="Name available?" default="F_availNo" />
    <bpmn:task id="Task_confirm" name="Receive confirmation and selfies" />
    <bpmn:task id="Task_release" name="Receive message about expansion release" />
    <bpmn:endEvent id="End_1" name="Character created" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Gw_split" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gw_split" targetRef="Task_names" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_split" targetRef="Task_checkAcc" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_checkAcc" targetRef="Gw_acc" />
    <bpmn:sequenceFlow id="F_accNo" name="no" sourceRef="Gw_acc" targetRef="Task_enterAcc">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">no account</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_accYes" name="yes" sourceRef="Gw_acc" targetRef="Gw_accMerge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_enterAcc" targetRef="Task_link" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_link" targetRef="Gw_accMerge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_accMerge" targetRef="Task_checkSub" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_checkSub" targetRef="Gw_sub" />
    <bpmn:sequenceFlow id="F_subNo" name="no" sourceRef="Gw_sub" targetRef="Task_payment">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">no subscription</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_subYes" name="yes" sourceRef="Gw_sub" targetRef="Gw_subMerge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_payment" targetRef="Gw_pay" />
    <bpmn:sequenceFlow id="F_payCard" name="credit card" sourceRef="Gw_pay" targetRef="Task_card">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">credit card</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_payBank" name="bank account" sourceRef="Gw_pay" targetRef="Task_iban" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_card" targetRef="Gw_payMerge" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_iban" targetRef="Gw_payMerge" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_payMerge" targetRef="Gw_subMerge" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_subMerge" targetRef="Task_login" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_login" targetRef="Task_select" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_select" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_names" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F23" sourceRef="Gw_join" targetRef="Gw_nameMerge" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_nameMerge" targetRef="Task_enterName" />
    <bpmn:sequenceFlow id="F25" sourceRef="Task_enterName" targetRef="Gw_avail" />
    <bpmn:sequenceFlow id="F_availNo" name="no" sourceRef="Gw_avail" targetRef="Gw_nameMerge" />
    <bpmn:sequenceFlow id="F_availYes" name="yes" sourceRef="Gw_avail" targetRef="Task_confirm">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">name available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F28" sourceRef="Task_confirm" targetRef="Task_release" />
    <bpmn:sequenceFlow id="F29" sourceRef="Task_release" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
