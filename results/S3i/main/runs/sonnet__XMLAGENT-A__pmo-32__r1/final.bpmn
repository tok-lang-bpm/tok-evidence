<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Farming Bot" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Player" name="Player">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Urgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Deps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bot" name="Bot">
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Farm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Disaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Farming bot wanted" />
    <bpmn:task id="T_Find" name="Find out which resources you want" />
    <bpmn:task id="T_Urgency" name="Set urgency of resources" />
    <bpmn:task id="T_Deps" name="Define dependencies of resources and tools" />
    <bpmn:task id="T_Start" name="Start farming" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="T_Farm" name="Farm resources" />
    <bpmn:exclusiveGateway id="Gw_Disaster" name="Natural disaster strikes?" default="F_No" />
    <bpmn:task id="T_Recover" name="Recover from setback" />
    <bpmn:task id="T_Notify" name="Notify player of milestones" />
    <bpmn:task id="T_Update" name="Update list of materials to be farmed" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:parallelGateway id="Gw_Split2" />
    <bpmn:task id="T_Brag" name="Brag to selected friends" />
    <bpmn:task id="T_Send" name="Send materials to friends" />
    <bpmn:parallelGateway id="Gw_Join2" />
    <bpmn:endEvent id="End" name="Bot finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Find" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Find" targetRef="T_Urgency" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Urgency" targetRef="T_Deps" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Deps" targetRef="T_Start" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Start" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Split" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Split" targetRef="T_Notify" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Split" targetRef="T_Update" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Merge" targetRef="T_Farm" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Farm" targetRef="Gw_Disaster" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Disaster" targetRef="T_Recover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">disaster = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_No" name="no" sourceRef="Gw_Disaster" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Recover" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Notify" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Update" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Join" targetRef="Gw_Split2" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Split2" targetRef="T_Brag" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Split2" targetRef="T_Send" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Brag" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_Send" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_Join2" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
