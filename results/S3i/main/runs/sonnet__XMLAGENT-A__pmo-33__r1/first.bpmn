<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="3D printing" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_You" name="You">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_UnderMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_StockMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_On</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Custom 3D model needed" />
    <bpmn:task id="Task_Instruct" name="Instruct an artist to create a project" />
    <bpmn:task id="Task_Sketches" name="Send sketches to the artist" />
    <bpmn:task id="Task_Change" name="Tell the artist what to change" />
    <bpmn:exclusiveGateway id="Gw_Satisfied" name="Satisfied with the result?" default="F_NotSat" />
    <bpmn:task id="Task_Choose" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="Gw_Stock" name="Color in stock?" default="F_NoStock" />
    <bpmn:task id="Task_Check" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="Gw_Under" name="Under 100 grams?" default="F_Over" />
    <bpmn:task id="Task_List" name="Put the color on the shopping list" />
    <bpmn:exclusiveGateway id="Gw_UnderMerge" />
    <bpmn:task id="Task_Order" name="Order the color" />
    <bpmn:exclusiveGateway id="Gw_StockMerge" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_On" name="Turn the printer on" />
    <bpmn:task id="Task_Heat" name="Heat up the bed and the extruder" />
    <bpmn:task id="Task_Gcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Print" name="Print the model" />
    <bpmn:endEvent id="End" name="Model printed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Instruct" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Instruct" targetRef="Task_Sketches" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Sketches" targetRef="Task_Change" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Change" targetRef="Gw_Satisfied" />
    <bpmn:sequenceFlow id="F_NotSat" name="no" sourceRef="Gw_Satisfied" targetRef="Task_Change" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="Gw_Satisfied" targetRef="Task_Choose" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Choose" targetRef="Gw_Stock" />
    <bpmn:sequenceFlow id="F7" name="yes" sourceRef="Gw_Stock" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F_NoStock" name="no" sourceRef="Gw_Stock" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Check" targetRef="Gw_Under" />
    <bpmn:sequenceFlow id="F9" name="yes" sourceRef="Gw_Under" targetRef="Task_List" />
    <bpmn:sequenceFlow id="F_Over" name="no" sourceRef="Gw_Under" targetRef="Gw_UnderMerge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_List" targetRef="Gw_UnderMerge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_UnderMerge" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Order" targetRef="Gw_StockMerge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_StockMerge" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Split" targetRef="Task_On" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Split" targetRef="Task_Gcode" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_On" targetRef="Task_Heat" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Heat" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Gcode" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_Join" targetRef="Task_Print" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Print" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
