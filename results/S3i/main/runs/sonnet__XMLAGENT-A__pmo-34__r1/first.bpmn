<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Lego machine building" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Builder" name="Builder">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PartsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TestJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Children" name="Children">
        <bpmn:flowNodeRef>Task_Sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Machine requested" />
    <bpmn:task id="Task_Design" name="Develop the basic design" />
    <bpmn:task id="Task_Order" name="Order Lego brick sets" />
    <bpmn:task id="Task_Give" name="Give the Lego sets to the children" />
    <bpmn:task id="Task_Sort" name="Sort the parts into containers" />
    <bpmn:exclusiveGateway id="Gw_Parts" name="No more parts in a container?" default="F_PartsNo" />
    <bpmn:task id="Task_Reorder" name="Reorder individual parts" />
    <bpmn:exclusiveGateway id="Gw_PartsJoin" />
    <bpmn:task id="Task_Build" name="Build the subcomponent" />
    <bpmn:task id="Task_Test" name="Test the subcomponent" />
    <bpmn:exclusiveGateway id="Gw_Test" name="Test successful?" default="F_TestNo" />
    <bpmn:task id="Task_Redesign" name="Redesign the subcomponent" />
    <bpmn:task id="Task_Rebuild" name="Rebuild the subcomponent" />
    <bpmn:exclusiveGateway id="Gw_TestJoin" />
    <bpmn:task id="Task_Assemble" name="Assemble the subcomponents" />
    <bpmn:endEvent id="End_1" name="Machine built" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Design" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Design" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Order" targetRef="Task_Give" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Give" targetRef="Task_Sort" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Sort" targetRef="Gw_Parts" />
    <bpmn:sequenceFlow id="F_PartsYes" name="yes" sourceRef="Gw_Parts" targetRef="Task_Reorder" />
    <bpmn:sequenceFlow id="F_PartsNo" name="no" sourceRef="Gw_Parts" targetRef="Gw_PartsJoin" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Reorder" targetRef="Gw_PartsJoin" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_PartsJoin" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Build" targetRef="Gw_TestJoin" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_TestJoin" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Test" targetRef="Gw_Test" />
    <bpmn:sequenceFlow id="F_TestYes" name="yes" sourceRef="Gw_Test" targetRef="Task_Assemble" />
    <bpmn:sequenceFlow id="F_TestNo" name="no" sourceRef="Gw_Test" targetRef="Task_Redesign" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Redesign" targetRef="Task_Rebuild" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Rebuild" targetRef="Gw_TestJoin" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Assemble" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
