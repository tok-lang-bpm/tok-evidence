<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Chainsaw production" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Producer" name="Producer">
        <bpmn:flowNodeRef>Gw_Split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Likes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Order for custom chainsaw" />
    <bpmn:task id="Task_Tell" name="Tell the properties of the chainsaw" />
    <bpmn:parallelGateway id="Gw_Split1" />
    <bpmn:task id="Task_Order1" name="Order the parts from online source 1" />
    <bpmn:task id="Task_Order2" name="Order the parts from online source 2" />
    <bpmn:task id="Task_Order3" name="Order the parts from online source 3" />
    <bpmn:parallelGateway id="Gw_Join1" />
    <bpmn:task id="Task_Inspect" name="Inspect all parts manually" />
    <bpmn:parallelGateway id="Gw_Split2" />
    <bpmn:task id="Task_Assemble" name="Assemble the parts" />
    <bpmn:task id="Task_Update" name="Send updates to the customer" />
    <bpmn:parallelGateway id="Gw_Join2" />
    <bpmn:task id="Task_Send" name="Send the first saw to the customer" />
    <bpmn:exclusiveGateway id="Gw_Likes" name="Does the customer like the saw?" default="F_no" />
    <bpmn:task id="Task_Rest" name="Produce the rest of the order" />
    <bpmn:endEvent id="End_Done" name="Order produced" />
    <bpmn:endEvent id="End_Rejected" name="Order cancelled" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Tell" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Tell" targetRef="Gw_Split1" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Split1" targetRef="Task_Order1" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split1" targetRef="Task_Order2" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split1" targetRef="Task_Order3" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Order1" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Order2" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Order3" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Join1" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Inspect" targetRef="Gw_Split2" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split2" targetRef="Task_Assemble" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Split2" targetRef="Task_Update" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Assemble" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Update" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Join2" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Send" targetRef="Gw_Likes" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Likes" targetRef="Task_Rest" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Likes" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Rest" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>