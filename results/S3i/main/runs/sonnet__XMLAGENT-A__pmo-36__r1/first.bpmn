<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Airplane producer" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_Producer" name="Airplane producer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Other</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Flight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendProtocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Russian" name="Russian team">
        <bpmn:flowNodeRef>T_Vodka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Irish" name="Irish team">
        <bpmn:flowNodeRef>T_Whiskey</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Customer" name="Customer">
        <bpmn:flowNodeRef>T_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Order received" />
    <bpmn:task id="T_Receive" name="Receive the specifications" />
    <bpmn:task id="T_Send" name="Send the requirements to the teams" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="T_Vodka" name="Manufacture the vodka bar" />
    <bpmn:task id="T_Whiskey" name="Manufacture the whiskey bar" />
    <bpmn:task id="T_Other" name="Manufacture the other interior parts" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="T_Assemble" name="Assemble the interior" />
    <bpmn:task id="T_Flight" name="Send the plane on a test flight" />
    <bpmn:task id="T_Protocol" name="Create the test protocol" />
    <bpmn:task id="T_SendProtocol" name="Send the test protocol to you and the customer" />
    <bpmn:task id="T_Deliver" name="Deliver the plane to the customer" />
    <bpmn:task id="T_Confirm" name="Confirm the delivery" />
    <bpmn:endEvent id="End" name="Plane delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T_Receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="T_Receive" targetRef="T_Send" />
    <bpmn:sequenceFlow id="f3" sourceRef="T_Send" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="f4" sourceRef="Gw_Split" targetRef="T_Vodka" />
    <bpmn:sequenceFlow id="f5" sourceRef="Gw_Split" targetRef="T_Whiskey" />
    <bpmn:sequenceFlow id="f6" sourceRef="Gw_Split" targetRef="T_Other" />
    <bpmn:sequenceFlow id="f7" sourceRef="T_Vodka" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="f8" sourceRef="T_Whiskey" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="f9" sourceRef="T_Other" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="f10" sourceRef="Gw_Join" targetRef="T_Assemble" />
    <bpmn:sequenceFlow id="f11" sourceRef="T_Assemble" targetRef="T_Flight" />
    <bpmn:sequenceFlow id="f12" sourceRef="T_Flight" targetRef="T_Protocol" />
    <bpmn:sequenceFlow id="f13" sourceRef="T_Protocol" targetRef="T_SendProtocol" />
    <bpmn:sequenceFlow id="f14" sourceRef="T_SendProtocol" targetRef="T_Deliver" />
    <bpmn:sequenceFlow id="f15" sourceRef="T_Deliver" targetRef="T_Confirm" />
    <bpmn:sequenceFlow id="f16" sourceRef="T_Confirm" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>