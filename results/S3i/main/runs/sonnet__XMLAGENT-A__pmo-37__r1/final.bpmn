<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Contract project" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE" name="Contractor">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSeveral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Below5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Below3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fastest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Mail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Parts needed for contract project" />
    <bpmn:task id="Task_Query" name="Query all web shops" />
    <bpmn:task id="Task_Find" name="Find out quantity, price and delivery time" />
    <bpmn:task id="Task_List" name="Create list of parts to order from each shop" />
    <bpmn:exclusiveGateway id="Gw_Enough" name="One shop has enough parts?" />
    <bpmn:task id="Task_OrderOne" name="Order cheapest parts from one shop" />
    <bpmn:task id="Task_OrderSeveral" name="Order cheapest parts from several shops" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Receive" name="Receive first batch of parts" />
    <bpmn:task id="Task_Build" name="Start building" />
    <bpmn:task id="Task_Check" name="Check stock of part" />
    <bpmn:exclusiveGateway id="Gw_Below5" name="Stock below 5?" />
    <bpmn:task id="Task_Cheapest" name="Reorder cheapest parts" />
    <bpmn:exclusiveGateway id="Gw_Below3" name="Stock below 3?" />
    <bpmn:task id="Task_Fastest" name="Reorder fastest parts" />
    <bpmn:exclusiveGateway id="Gw_Zero" name="Stock zero?" />
    <bpmn:task id="Task_Mail" name="Write mail to friends complaining about webshops" />
    <bpmn:endEvent id="End_Ok" name="Stock sufficient" />
    <bpmn:endEvent id="End_Reordered" name="Parts reordered" />
    <bpmn:endEvent id="End_Cheapest" name="Reorder placed" />
    <bpmn:endEvent id="End_Mail" name="Complaint sent" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Query" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Query" targetRef="Task_Find" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Find" targetRef="Task_List" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_List" targetRef="Gw_Enough" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Enough" targetRef="Task_OrderOne" />
    <bpmn:sequenceFlow id="F_NoEnough" name="no" sourceRef="Gw_Enough" targetRef="Task_OrderSeveral" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_OrderOne" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_OrderSeveral" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Merge" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Receive" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Build" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Check" targetRef="Gw_Below5" />
    <bpmn:sequenceFlow id="F_Yes5" name="yes" sourceRef="Gw_Below5" targetRef="Task_Cheapest" />
    <bpmn:sequenceFlow id="F_No5" name="no" sourceRef="Gw_Below5" targetRef="End_Ok" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Cheapest" targetRef="Gw_Below3" />
    <bpmn:sequenceFlow id="F_Yes3" name="yes" sourceRef="Gw_Below3" targetRef="Task_Fastest" />
    <bpmn:sequenceFlow id="F_No3" name="no" sourceRef="Gw_Below3" targetRef="End_Cheapest" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Fastest" targetRef="Gw_Zero" />
    <bpmn:sequenceFlow id="F_YesZero" name="yes" sourceRef="Gw_Zero" targetRef="Task_Mail" />
    <bpmn:sequenceFlow id="F_NoZero" name="no" sourceRef="Gw_Zero" targetRef="End_Reordered" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Mail" targetRef="End_Mail" />
  </bpmn:process>
</bpmn:definitions>
