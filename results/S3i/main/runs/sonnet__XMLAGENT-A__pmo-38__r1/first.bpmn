<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Building a House" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_You" name="You">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Architect" name="Tree house architect">
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Tree house wanted" />
    <bpmn:task id="Task_Collect" name="Collect your requirements" />
    <bpmn:task id="Task_SendReq" name="Send requirements to the architect" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Draft" name="Send a draft back" />
    <bpmn:exclusiveGateway id="Gw_Draft" name="Draft final?" default="F_Final" />
    <bpmn:task id="Task_Refine" name="Refine the draft with additional requirements" />
    <bpmn:task id="Task_List" name="Create the list of needed materials" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Order" name="Order materials from online stores" />
    <bpmn:task id="Task_Friends" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Build" name="Build the house" />
    <bpmn:task id="Task_Invite" name="Send invitations for the party" />
    <bpmn:task id="Task_Attendees" name="Create the list of attending people" />
    <bpmn:task id="Task_Snacks" name="Buy the snacks" />
    <bpmn:endEvent id="End" name="Party prepared" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Collect" targetRef="Task_SendReq" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_SendReq" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Merge" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Draft" targetRef="Gw_Draft" />
    <bpmn:sequenceFlow id="F_Refine" name="no" sourceRef="Gw_Draft" targetRef="Task_Refine" />
    <bpmn:sequenceFlow id="F_Final" name="yes" sourceRef="Gw_Draft" targetRef="Task_List" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Refine" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_List" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_Friends" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Order" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Friends" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Join" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Build" targetRef="Task_Invite" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Invite" targetRef="Task_Attendees" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Attendees" targetRef="Task_Snacks" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Snacks" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>