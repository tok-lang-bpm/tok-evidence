<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="DIY Smartphone Screen Repair" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_User" name="You">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Worked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tool" name="Online tool">
        <bpmn:flowNodeRef>Task_Lists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Instr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Phone screen broken" />
    <bpmn:task id="Task_Enter" name="Enter the model and what is broken" />
    <bpmn:task id="Task_Lists" name="Give the list of materials, the list of tools and the ordering choices" />
    <bpmn:task id="Task_Check" name="Check what you already have" />
    <bpmn:task id="Task_Contact" name="Contact friends to borrow or buy something" />
    <bpmn:task id="Task_Buy" name="Buy the rest" />
    <bpmn:task id="Task_Instr" name="Give instructions how to fix the phone" />
    <bpmn:task id="Task_Fix" name="Fix the phone" />
    <bpmn:exclusiveGateway id="Gw_Worked" name="Did it work?" />
    <bpmn:task id="Task_Review" name="Send a review and/or video" />
    <bpmn:task id="Task_Expert" name="Send the phone to an expert" />
    <bpmn:endEvent id="End_Done" name="Phone repaired" />
    <bpmn:endEvent id="End_Expert" name="Phone sent to expert" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Enter" targetRef="Task_Lists" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Lists" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Check" targetRef="Task_Contact" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Contact" targetRef="Task_Buy" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Buy" targetRef="Task_Instr" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Instr" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Fix" targetRef="Gw_Worked" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Worked" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Worked" targetRef="Task_Expert" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Review" targetRef="End_Done" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Expert" targetRef="End_Expert" />
  </bpmn:process>
</bpmn:definitions>
