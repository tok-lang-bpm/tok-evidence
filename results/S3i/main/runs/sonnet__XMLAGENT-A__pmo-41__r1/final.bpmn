<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Machine inspection" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Inspector" name="Inspector">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Press</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputAdd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Application">
        <bpmn:flowNodeRef>Task_Ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_More</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskAdd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Inspection needed" />
    <bpmn:task id="Task_Enter" name="Enter type and serial number of the machine" />
    <bpmn:task id="Task_Ask" name="Ask questions" />
    <bpmn:task id="Task_Input" name="Input values" />
    <bpmn:task id="Task_Press" name="Press buttons" />
    <bpmn:task id="Task_Collect" name="Collect values from the machine" />
    <bpmn:task id="Task_Show" name="Show values" />
    <bpmn:exclusiveGateway id="Gw_More" name="Additional questions needed?" />
    <bpmn:task id="Task_AskAdd" name="Ask additional questions" />
    <bpmn:task id="Task_InputAdd" name="Input additional values" />
    <bpmn:exclusiveGateway id="Gw_Join" />
    <bpmn:endEvent id="End_1" name="Inspection finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Enter" targetRef="Task_Ask" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Ask" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Input" targetRef="Task_Press" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Press" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Collect" targetRef="Task_Show" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Show" targetRef="Gw_More" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_More" targetRef="Task_AskAdd" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_More" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_AskAdd" targetRef="Task_InputAdd" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_InputAdd" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Join" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
