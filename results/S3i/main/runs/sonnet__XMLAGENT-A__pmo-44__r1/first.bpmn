<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Robotic Burger Seller" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Robot" name="Robot">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SideMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MenuMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Order received" />
    <bpmn:task id="Task_Receive" name="Receive order" />
    <bpmn:task id="Task_AskMenu" name="Ask whether customer wants menu or just burger" />
    <bpmn:exclusiveGateway id="Gw_Menu" name="Menu?" default="F_MenuNo" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Drink" name="Prepare drink" />
    <bpmn:task id="Task_AskSide" name="Ask if customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="Gw_Side" name="Fries or wedges?" default="F_Wedges" />
    <bpmn:task id="Task_Fries" name="Prepare fries" />
    <bpmn:task id="Task_Wedges" name="Prepare wedges" />
    <bpmn:exclusiveGateway id="Gw_SideMerge" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:exclusiveGateway id="Gw_MenuMerge" />
    <bpmn:task id="Task_Burger" name="Prepare burger" />
    <bpmn:boundaryEvent id="Timer_30" name="Every 30 seconds" attachedToRef="Task_Burger" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Update" name="Give status update" />
    <bpmn:endEvent id="End_Update" name="Update given" />
    <bpmn:task id="Task_Deliver" name="Deliver order via conveyor belt" />
    <bpmn:endEvent id="End" name="Order delivered" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Receive" targetRef="Task_AskMenu" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_AskMenu" targetRef="Gw_Menu" />
    <bpmn:sequenceFlow id="F_MenuYes" name="menu" sourceRef="Gw_Menu" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F_MenuNo" name="just burger" sourceRef="Gw_Menu" targetRef="Gw_MenuMerge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split" targetRef="Task_Drink" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split" targetRef="Task_AskSide" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_AskSide" targetRef="Gw_Side" />
    <bpmn:sequenceFlow id="F_Fries" name="fries" sourceRef="Gw_Side" targetRef="Task_Fries" />
    <bpmn:sequenceFlow id="F_Wedges" name="wedges" sourceRef="Gw_Side" targetRef="Task_Wedges" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Fries" targetRef="Gw_SideMerge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Wedges" targetRef="Gw_SideMerge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_SideMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Drink" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Join" targetRef="Gw_MenuMerge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_MenuMerge" targetRef="Task_Burger" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Burger" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="F14" sourceRef="Timer_30" targetRef="Task_Update" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Update" targetRef="End_Update" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Deliver" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>