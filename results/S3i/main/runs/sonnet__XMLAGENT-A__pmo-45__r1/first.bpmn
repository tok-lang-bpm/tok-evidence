<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Shop" name="Online Shop" processRef="Process_Order" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Order" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BillAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BillingMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="E-Shop System">
        <bpmn:flowNodeRef>Task_Credentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_All</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinishOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bank" name="Bank">
        <bpmn:flowNodeRef>Task_ConfirmPay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Customer wants to order" />
    <bpmn:task id="Task_Login" name="Log into the E-Shop system" />
    <bpmn:task id="Task_Credentials" name="Check the credentials" />
    <bpmn:exclusiveGateway id="Gw_Login" name="Login successful?" default="F_LoginNo" />
    <bpmn:endEvent id="End_Stopped" name="Shopping stopped" />
    <bpmn:exclusiveGateway id="Gw_Merge_Select" />
    <bpmn:task id="Task_Select" name="Select a product" />
    <bpmn:task id="Task_Add" name="Add the product to the shopping cart" />
    <bpmn:task id="Task_Save" name="Save the product" />
    <bpmn:task id="Task_CheckAll" name="Check if every product was selected" />
    <bpmn:exclusiveGateway id="Gw_All" name="Every product selected?" default="F_AllNo" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_FinishOrder" name="Finish the order" />
    <bpmn:task id="Task_PayData" name="Enter the payment data" />
    <bpmn:task id="Task_ConfirmPay" name="Confirm the payment" />
    <bpmn:task id="Task_ShipAddr" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="Gw_Billing" name="Shipping address equal to billing address?" default="F_BillNo" />
    <bpmn:task id="Task_BillAddr" name="Enter the billing address" />
    <bpmn:exclusiveGateway id="Gw_BillingMerge" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Complete" name="Finish the order after address and payment" />
    <bpmn:endEvent id="End_Done" name="Order finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Login" targetRef="Task_Credentials" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Credentials" targetRef="Gw_Login" />
    <bpmn:sequenceFlow id="F_LoginYes" name="yes" sourceRef="Gw_Login" targetRef="Gw_Merge_Select" />
    <bpmn:sequenceFlow id="F_LoginNo" name="no" sourceRef="Gw_Login" targetRef="End_Stopped" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Merge_Select" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Select" targetRef="Task_Add" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Add" targetRef="Task_Save" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Save" targetRef="Task_CheckAll" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_CheckAll" targetRef="Gw_All" />
    <bpmn:sequenceFlow id="F_AllNo" name="no" sourceRef="Gw_All" targetRef="Gw_Merge_Select" />
    <bpmn:sequenceFlow id="F_AllYes" name="yes" sourceRef="Gw_All" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Split" targetRef="Task_FinishOrder" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_PayData" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_ShipAddr" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_PayData" targetRef="Task_ConfirmPay" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ShipAddr" targetRef="Gw_Billing" />
    <bpmn:sequenceFlow id="F_BillYes" name="yes" sourceRef="Gw_Billing" targetRef="Gw_BillingMerge" />
    <bpmn:sequenceFlow id="F_BillNo" name="no" sourceRef="Gw_Billing" targetRef="Task_BillAddr" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_BillAddr" targetRef="Gw_BillingMerge" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_BillingMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_FinishOrder" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_ConfirmPay" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_Join" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Complete" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>