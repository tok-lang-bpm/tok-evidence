<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_USI" name="Sports institute" processRef="Process_USI" />
  </bpmn:collaboration>
  <bpmn:process id="Process_USI" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Uni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_Tell</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Wish to register for a course" />
    <bpmn:task id="Task_Tell" name="Tell the courses and dates" />
    <bpmn:task id="Task_Select" name="Select a course" />
    <bpmn:exclusiveGateway id="Gw_Account" name="Account at the sports institute exists?" default="F_AccNo" />
    <bpmn:task id="Task_CheckUni" name="Check whether registered at an eligible university" />
    <bpmn:exclusiveGateway id="Gw_Uni" name="Registered at an eligible university?" default="F_UniNo" />
    <bpmn:task id="Task_Register" name="Register the account" />
    <bpmn:task id="Task_Request" name="Request an activation" />
    <bpmn:task id="Task_Wait" name="Wait for a response" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Login" name="Log into the account" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Tweet" name="Tweet to friends" />
    <bpmn:task id="Task_Complete" name="Complete the registration for the course" />
    <bpmn:task id="Task_Pay" name="Provide the payment information" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Ticket" name="Receive a course ticket" />
    <bpmn:endEvent id="End" name="Registration completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Tell" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Tell" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Select" targetRef="Gw_Account" />
    <bpmn:sequenceFlow id="F_AccYes" name="yes" sourceRef="Gw_Account" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_AccNo" name="no" sourceRef="Gw_Account" targetRef="Task_CheckUni" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_CheckUni" targetRef="Gw_Uni" />
    <bpmn:sequenceFlow id="F_UniYes" name="yes" sourceRef="Gw_Uni" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="F_UniNo" name="no" sourceRef="Gw_Uni" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Register" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Request" targetRef="Task_Wait" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Wait" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Merge" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Login" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_Tweet" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Complete" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Tweet" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Pay" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Join" targetRef="Task_Ticket" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Ticket" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>