<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Vienna Night Run" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Runner" name="Runner">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Hour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Want to participate" />
    <bpmn:task id="Task_Select" name="Select starting block" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Run5" name="Run 5km and measure time" />
    <bpmn:exclusiveGateway id="Gw_Time" name="Time less than 25 minutes?" default="F_no" />
    <bpmn:task id="Task_Train" name="Train and check" />
    <bpmn:task id="Task_Number" name="Get starting number" />
    <bpmn:exclusiveGateway id="Gw_Hour" name="More than one hour between workday end and start?" default="F_hno" />
    <bpmn:task id="Task_Home" name="Go to the run from home" />
    <bpmn:task id="Task_Work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="Gw_Merge2" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Run" name="Run" />
    <bpmn:task id="Task_Drink" name="Drink" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Receive" name="Receive final running time" />
    <bpmn:endEvent id="End_1" name="Run finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Select" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Merge" targetRef="Task_Run5" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Run5" targetRef="Gw_Time" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Time" targetRef="Task_Number" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Time" targetRef="Task_Train" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Train" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Number" targetRef="Gw_Hour" />
    <bpmn:sequenceFlow id="F_hyes" name="yes" sourceRef="Gw_Hour" targetRef="Task_Home" />
    <bpmn:sequenceFlow id="F_hno" name="no" sourceRef="Gw_Hour" targetRef="Task_Work" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Home" targetRef="Gw_Merge2" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Work" targetRef="Gw_Merge2" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Merge2" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_Run" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_Drink" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Run" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Drink" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Join" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Receive" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>