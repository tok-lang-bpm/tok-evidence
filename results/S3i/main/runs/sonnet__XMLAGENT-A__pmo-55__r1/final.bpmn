<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool" name="Hospital" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Doctor" name="Doctor">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Implements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Wash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Clothes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Drape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GelProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SterileGel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PosProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PosPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VeinSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Anatomic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Doppler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Compression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VeinJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PunctureMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Anesthetize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Puncture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckBlood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Blood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DropProbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RemoveSyringe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Guidewire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RemoveTrocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WireSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_LongAxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ShortAxis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WireJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckPosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Position</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Widen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Advance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RemoveWire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Flow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CathPosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Procedure started" />
    <bpmn:task id="T_Implements" name="Prepare the implements" />
    <bpmn:task id="T_Wash" name="Wash the hands" />
    <bpmn:task id="T_Clothes" name="Get in sterile clothes" />
    <bpmn:task id="T_Clean" name="Clean the puncture area" />
    <bpmn:task id="T_Drape" name="Drape the puncture zone" />
    <bpmn:task id="T_Configure" name="Configure the ultrasound" />
    <bpmn:task id="T_GelProbe" name="Put gel in the probe" />
    <bpmn:task id="T_Cover" name="Cover the probe" />
    <bpmn:task id="T_SterileGel" name="Put the sterile gel" />
    <bpmn:task id="T_PosProbe" name="Position the probe" />
    <bpmn:task id="T_PosPatient" name="Position the patient" />
    <bpmn:exclusiveGateway id="Gw_VeinSplit" name="Identification method?" />
    <bpmn:task id="T_Anatomic" name="Identify the vein using an anatomic identification" />
    <bpmn:task id="T_Doppler" name="Identify the vein using a doppler identification" />
    <bpmn:task id="T_Compression" name="Identify the vein using a compression identification" />
    <bpmn:exclusiveGateway id="Gw_VeinJoin" />
    <bpmn:exclusiveGateway id="Gw_PunctureMerge" />
    <bpmn:task id="T_Anesthetize" name="Anesthetize the patient" />
    <bpmn:task id="T_Puncture" name="Puncture the patient" />
    <bpmn:task id="T_CheckBlood" name="Check the blood return" />
    <bpmn:exclusiveGateway id="Gw_Blood" name="Blood return correct?" />
    <bpmn:task id="T_DropProbe" name="Drop the probe" />
    <bpmn:task id="T_RemoveSyringe" name="Remove the syringe" />
    <bpmn:task id="T_Guidewire" name="Install the guidewire" />
    <bpmn:task id="T_RemoveTrocar" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="Gw_WireSplit" name="Check method?" />
    <bpmn:task id="T_LongAxis" name="Check the wire in the long axis" />
    <bpmn:task id="T_ShortAxis" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="Gw_WireJoin" />
    <bpmn:task id="T_CheckPosition" name="Check if the wire is in good position" />
    <bpmn:exclusiveGateway id="Gw_Position" name="Wire in good position?" />
    <bpmn:task id="T_Widen" name="Widen the pathway" />
    <bpmn:task id="T_Advance" name="Advance the catheter" />
    <bpmn:task id="T_RemoveWire" name="Remove the guidewire" />
    <bpmn:task id="T_Flow" name="Verify the flow and the reflow" />
    <bpmn:task id="T_CathPosition" name="Check the catheter position" />
    <bpmn:endEvent id="End" name="Procedure finished" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Implements" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Implements" targetRef="T_Wash" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Wash" targetRef="T_Clothes" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Clothes" targetRef="T_Clean" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Clean" targetRef="T_Drape" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_Drape" targetRef="T_Configure" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Configure" targetRef="T_GelProbe" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_GelProbe" targetRef="T_Cover" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_Cover" targetRef="T_SterileGel" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_SterileGel" targetRef="T_PosProbe" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_PosProbe" targetRef="T_PosPatient" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_PosPatient" targetRef="Gw_VeinSplit" />
    <bpmn:sequenceFlow id="F_Vein1" name="anatomic" sourceRef="Gw_VeinSplit" targetRef="T_Anatomic" />
    <bpmn:sequenceFlow id="F_Vein2" name="doppler" sourceRef="Gw_VeinSplit" targetRef="T_Doppler" />
    <bpmn:sequenceFlow id="F_Vein3" name="compression" sourceRef="Gw_VeinSplit" targetRef="T_Compression" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Anatomic" targetRef="Gw_VeinJoin" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Doppler" targetRef="Gw_VeinJoin" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_Compression" targetRef="Gw_VeinJoin" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_VeinJoin" targetRef="Gw_PunctureMerge" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_PunctureMerge" targetRef="T_Anesthetize" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_Anesthetize" targetRef="T_Puncture" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Puncture" targetRef="T_CheckBlood" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_CheckBlood" targetRef="Gw_Blood" />
    <bpmn:sequenceFlow id="F_BloodYes" name="yes" sourceRef="Gw_Blood" targetRef="T_DropProbe" />
    <bpmn:sequenceFlow id="F_BloodNo" name="no" sourceRef="Gw_Blood" targetRef="Gw_PunctureMerge" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_DropProbe" targetRef="T_RemoveSyringe" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_RemoveSyringe" targetRef="T_Guidewire" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_Guidewire" targetRef="T_RemoveTrocar" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_RemoveTrocar" targetRef="Gw_WireSplit" />
    <bpmn:sequenceFlow id="F_Wire1" name="long axis" sourceRef="Gw_WireSplit" targetRef="T_LongAxis" />
    <bpmn:sequenceFlow id="F_Wire2" name="short axis" sourceRef="Gw_WireSplit" targetRef="T_ShortAxis" />
    <bpmn:sequenceFlow id="F25" sourceRef="T_LongAxis" targetRef="Gw_WireJoin" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_ShortAxis" targetRef="Gw_WireJoin" />
    <bpmn:sequenceFlow id="F27" sourceRef="Gw_WireJoin" targetRef="T_CheckPosition" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_CheckPosition" targetRef="Gw_Position" />
    <bpmn:sequenceFlow id="F_PosYes" name="yes" sourceRef="Gw_Position" targetRef="T_Widen" />
    <bpmn:sequenceFlow id="F_PosNo" name="no" sourceRef="Gw_Position" targetRef="Gw_PunctureMerge" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_Widen" targetRef="T_Advance" />
    <bpmn:sequenceFlow id="F30" sourceRef="T_Advance" targetRef="T_RemoveWire" />
    <bpmn:sequenceFlow id="F31" sourceRef="T_RemoveWire" targetRef="T_Flow" />
    <bpmn:sequenceFlow id="F32" sourceRef="T_Flow" targetRef="T_CathPosition" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_CathPosition" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
