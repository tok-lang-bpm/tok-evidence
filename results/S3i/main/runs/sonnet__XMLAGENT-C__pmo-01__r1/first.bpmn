<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Sales organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endPlaced</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_staff" name="Sales staff">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>address</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNotInterested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_rep" name="Sales representative">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Inquiry started" />
    <bpmn:task id="inquire" name="Inquire about a product or service" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:task id="address" name="Address concerns and questions" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:task id="guide" name="Guide the customer through selecting the product or service" />
    <bpmn:task id="quote" name="Provide a quote" />
    <bpmn:task id="approve" name="Approve the quote" />
    <bpmn:exclusiveGateway id="approved" name="Quote approved?" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="record" name="Record the order in the system" />
    <bpmn:task id="confirm" name="Send order confirmation to the customer" />
    <bpmn:endEvent id="endPlaced" name="Order placed and confirmed" />
    <bpmn:endEvent id="endNotInterested" name="Customer not interested" />
    <bpmn:endEvent id="endDeclined" name="Quote declined" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="inquire" />
    <bpmn:sequenceFlow id="f2" sourceRef="inquire" targetRef="collect" />
    <bpmn:sequenceFlow id="f3" sourceRef="collect" targetRef="address" />
    <bpmn:sequenceFlow id="f4" sourceRef="address" targetRef="interested" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="interested" targetRef="guide" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="interested" targetRef="endNotInterested" />
    <bpmn:sequenceFlow id="f7" sourceRef="guide" targetRef="quote" />
    <bpmn:sequenceFlow id="f8" sourceRef="quote" targetRef="approve" />
    <bpmn:sequenceFlow id="f9" sourceRef="approve" targetRef="approved" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="approved" targetRef="place" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="approved" targetRef="endDeclined" />
    <bpmn:sequenceFlow id="f12" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f13" sourceRef="record" targetRef="confirm" />
    <bpmn:sequenceFlow id="f14" sourceRef="confirm" targetRef="endPlaced" />
  </bpmn:process>
</bpmn:definitions>