<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_DEP" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_HR" name="HR">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inperson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>virtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prefm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negtask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need for new hire identified" />
    <bpmn:task id="identify" name="Identify the need for a new hire" />
    <bpmn:task id="create" name="Create a job description" />
    <bpmn:task id="post" name="Post the job description on job boards" />
    <bpmn:task id="collect" name="Collect resumes" />
    <bpmn:task id="screen" name="Screen resumes" />
    <bpmn:task id="phone" name="Conduct initial phone interviews" />
    <bpmn:exclusiveGateway id="pref" name="Candidate's preference?" />
    <bpmn:task id="inperson" name="Conduct in-person interview" />
    <bpmn:task id="virtual" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="prefm" />
    <bpmn:task id="choose" name="Choose a candidate" />
    <bpmn:task id="offer" name="Extend an offer" />
    <bpmn:exclusiveGateway id="neg" name="Salary negotiation needed?" />
    <bpmn:task id="negtask" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="negm" />
    <bpmn:exclusiveGateway id="acc" name="Offer accepted?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="paper" name="Complete paperwork" />
    <bpmn:task id="orient" name="Conduct orientation" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="integrate" name="Integrate the new hire into the team" />
    <bpmn:endEvent id="done" name="New hire integrated" />
    <bpmn:endEvent id="declined" name="Offer declined" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f3" sourceRef="create" targetRef="post" />
    <bpmn:sequenceFlow id="f4" sourceRef="post" targetRef="collect" />
    <bpmn:sequenceFlow id="f5" sourceRef="collect" targetRef="screen" />
    <bpmn:sequenceFlow id="f6" sourceRef="screen" targetRef="phone" />
    <bpmn:sequenceFlow id="f7" sourceRef="phone" targetRef="pref" />
    <bpmn:sequenceFlow id="f8" name="in-person" sourceRef="pref" targetRef="inperson" />
    <bpmn:sequenceFlow id="f9" name="virtual" sourceRef="pref" targetRef="virtual" />
    <bpmn:sequenceFlow id="f10" sourceRef="inperson" targetRef="prefm" />
    <bpmn:sequenceFlow id="f11" sourceRef="virtual" targetRef="prefm" />
    <bpmn:sequenceFlow id="f12" sourceRef="prefm" targetRef="choose" />
    <bpmn:sequenceFlow id="f13" sourceRef="choose" targetRef="offer" />
    <bpmn:sequenceFlow id="f14" sourceRef="offer" targetRef="neg" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="neg" targetRef="negtask" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="neg" targetRef="negm" />
    <bpmn:sequenceFlow id="f17" sourceRef="negtask" targetRef="negm" />
    <bpmn:sequenceFlow id="f18" sourceRef="negm" targetRef="acc" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="acc" targetRef="split" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="acc" targetRef="declined" />
    <bpmn:sequenceFlow id="f21" sourceRef="split" targetRef="paper" />
    <bpmn:sequenceFlow id="f22" sourceRef="split" targetRef="orient" />
    <bpmn:sequenceFlow id="f23" sourceRef="split" targetRef="train" />
    <bpmn:sequenceFlow id="f24" sourceRef="paper" targetRef="join" />
    <bpmn:sequenceFlow id="f25" sourceRef="orient" targetRef="join" />
    <bpmn:sequenceFlow id="f26" sourceRef="train" targetRef="join" />
    <bpmn:sequenceFlow id="f27" sourceRef="join" targetRef="integrate" />
    <bpmn:sequenceFlow id="f28" sourceRef="integrate" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
