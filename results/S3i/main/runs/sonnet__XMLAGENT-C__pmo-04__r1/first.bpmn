<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="marketing" name="Marketing team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crm" name="CRM system">
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales team">
        <bpmn:flowNodeRef>follow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Campaign started" />
    <bpmn:task id="define" name="Define the objectives of the campaign" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="content" name="Create the content" />
    <bpmn:task id="visuals" name="Design the visuals" />
    <bpmn:task id="channels" name="Select the channels for promotion" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="launch" name="Launch the campaign" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="track" name="Track the performance of the campaign" />
    <bpmn:task id="collect" name="Collect the leads in the CRM" />
    <bpmn:task id="follow" name="Follow up on the leads" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="analyze" name="Analyze the performance of the campaign" />
    <bpmn:endEvent id="end" name="Campaign concluded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="define" />
    <bpmn:sequenceFlow id="f2" sourceRef="define" targetRef="split1" />
    <bpmn:sequenceFlow id="f3" sourceRef="split1" targetRef="content" />
    <bpmn:sequenceFlow id="f4" sourceRef="split1" targetRef="visuals" />
    <bpmn:sequenceFlow id="f5" sourceRef="split1" targetRef="channels" />
    <bpmn:sequenceFlow id="f6" sourceRef="content" targetRef="join1" />
    <bpmn:sequenceFlow id="f7" sourceRef="visuals" targetRef="join1" />
    <bpmn:sequenceFlow id="f8" sourceRef="channels" targetRef="join1" />
    <bpmn:sequenceFlow id="f9" sourceRef="join1" targetRef="launch" />
    <bpmn:sequenceFlow id="f10" sourceRef="launch" targetRef="split2" />
    <bpmn:sequenceFlow id="f11" sourceRef="split2" targetRef="track" />
    <bpmn:sequenceFlow id="f12" sourceRef="split2" targetRef="collect" />
    <bpmn:sequenceFlow id="f13" sourceRef="collect" targetRef="follow" />
    <bpmn:sequenceFlow id="f14" sourceRef="track" targetRef="join2" />
    <bpmn:sequenceFlow id="f15" sourceRef="follow" targetRef="join2" />
    <bpmn:sequenceFlow id="f16" sourceRef="join2" targetRef="analyze" />
    <bpmn:sequenceFlow id="f17" sourceRef="analyze" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>