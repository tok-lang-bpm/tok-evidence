<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Travel company" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Booking system">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Travel company">
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Ticket needed" />
    <bpmn:task id="search" name="Search for a ticket" />
    <bpmn:task id="select" name="Select the route, date and time" />
    <bpmn:task id="provide" name="Provide personal information and payment details" />
    <bpmn:task id="generate" name="Generate the ticket" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="channel" name="Delivery channel?" />
    <bpmn:task id="email" name="Send the ticket by email" />
    <bpmn:task id="sms" name="Send the ticket by SMS" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="update" name="Update the seat inventory" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="remind" name="Send reminders and check-in instructions" />
    <bpmn:task id="journey" name="Complete the journey" />
    <bpmn:endEvent id="end" name="Journey completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="search" />
    <bpmn:sequenceFlow id="f2" sourceRef="search" targetRef="select" />
    <bpmn:sequenceFlow id="f3" sourceRef="select" targetRef="provide" />
    <bpmn:sequenceFlow id="f4" sourceRef="provide" targetRef="generate" />
    <bpmn:sequenceFlow id="f5" sourceRef="generate" targetRef="split" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="channel" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="update" />
    <bpmn:sequenceFlow id="f8" name="email" sourceRef="channel" targetRef="email" />
    <bpmn:sequenceFlow id="f9" name="SMS" sourceRef="channel" targetRef="sms" />
    <bpmn:sequenceFlow id="f10" sourceRef="email" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="sms" targetRef="merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="merge" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="update" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="join" targetRef="remind" />
    <bpmn:sequenceFlow id="f15" sourceRef="remind" targetRef="journey" />
    <bpmn:sequenceFlow id="f16" sourceRef="journey" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>