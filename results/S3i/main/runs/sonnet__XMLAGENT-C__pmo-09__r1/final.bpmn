<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="RD" name="R&amp;D team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refineq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>discarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Idea needed" />
    <bpmn:task id="identify" name="Identify an idea for a new product or improvement" />
    <bpmn:task id="research" name="Conduct initial research and feasibility studies" />
    <bpmn:task id="draft" name="Draft design concepts" />
    <bpmn:task id="select" name="Select a promising design" />
    <bpmn:task id="build" name="Build a prototype" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="test" name="Test the prototype" />
    <bpmn:task id="collect" name="Collect feedback from testing" />
    <bpmn:exclusiveGateway id="refineq" name="Refinement needed?" />
    <bpmn:task id="refine" name="Refine the prototype" />
    <bpmn:exclusiveGateway id="approveq" name="Prototype approved?" />
    <bpmn:endEvent id="approved" name="Prototype approved" />
    <bpmn:endEvent id="discarded" name="Prototype discarded" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="identify" />
    <bpmn:sequenceFlow id="f2" sourceRef="identify" targetRef="research" />
    <bpmn:sequenceFlow id="f3" sourceRef="research" targetRef="draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="draft" targetRef="select" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="build" />
    <bpmn:sequenceFlow id="f6" sourceRef="build" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="merge" targetRef="test" />
    <bpmn:sequenceFlow id="f8" sourceRef="test" targetRef="collect" />
    <bpmn:sequenceFlow id="f9" sourceRef="collect" targetRef="refineq" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="refineq" targetRef="refine" />
    <bpmn:sequenceFlow id="f11" sourceRef="refine" targetRef="merge" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="refineq" targetRef="approveq" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="approveq" targetRef="approved" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="approveq" targetRef="discarded" />
  </bpmn:process>
</bpmn:definitions>
