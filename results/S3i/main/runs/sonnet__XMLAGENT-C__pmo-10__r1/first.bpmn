<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="requester" name="Employee or department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="it" name="IT">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="IT solution needed" />
    <bpmn:task id="submit" name="Submit a request for an IT solution" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="approved" name="Request approved?" />
    <bpmn:task id="procure" name="Procure the tools or licenses" />
    <bpmn:task id="install" name="Install the solution" />
    <bpmn:task id="test" name="Test the solution in a controlled environment" />
    <bpmn:exclusiveGateway id="passed" name="Test successful?" />
    <bpmn:task id="rollout" name="Roll out the solution to the requesting department" />
    <bpmn:exclusiveGateway id="training" name="Training needed?" />
    <bpmn:task id="train" name="Provide training" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="support" name="Provide IT support for troubleshooting" />
    <bpmn:endEvent id="done" name="Solution in use" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="failed" name="Solution not rolled out" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="assess" />
    <bpmn:sequenceFlow id="f3" sourceRef="assess" targetRef="approved" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="approved" targetRef="procure" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="approved" targetRef="rejected" />
    <bpmn:sequenceFlow id="f6" sourceRef="procure" targetRef="install" />
    <bpmn:sequenceFlow id="f7" sourceRef="install" targetRef="test" />
    <bpmn:sequenceFlow id="f8" sourceRef="test" targetRef="passed" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="passed" targetRef="rollout" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="passed" targetRef="failed" />
    <bpmn:sequenceFlow id="f11" sourceRef="rollout" targetRef="training" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="training" targetRef="train" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="training" targetRef="merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="train" targetRef="merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="merge" targetRef="support" />
    <bpmn:sequenceFlow id="f16" sourceRef="support" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>