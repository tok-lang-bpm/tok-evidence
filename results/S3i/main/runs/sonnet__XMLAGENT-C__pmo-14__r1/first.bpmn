<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>strategic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approveadj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="fin" name="Finance Department">
        <bpmn:flowNodeRef>detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvefinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Upcoming period planned" />
    <bpmn:task id="outline" name="Outline the objectives" />
    <bpmn:task id="draft" name="Draft the plan with cost estimates and justifications" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="strategic" name="Review the plan in the strategic alignment meeting" />
    <bpmn:task id="detailed" name="Perform the detailed review of the budget" />
    <bpmn:exclusiveGateway id="needed" name="Adjustments needed?" />
    <bpmn:task id="adjust" name="Adjust the plan" />
    <bpmn:task id="document" name="Document the adjustment" />
    <bpmn:task id="approveadj" name="Approve the adjustment" />
    <bpmn:task id="approvefinal" name="Approve the final budget" />
    <bpmn:task id="allocate" name="Allocate the budget to the department" />
    <bpmn:task id="distribute" name="Distribute the budget" />
    <bpmn:task id="implement" name="Begin implementing the plan" />
    <bpmn:endEvent id="end" name="Plan implementation begun" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="outline" />
    <bpmn:sequenceFlow id="f2" sourceRef="outline" targetRef="draft" />
    <bpmn:sequenceFlow id="f3" sourceRef="draft" targetRef="merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="merge" targetRef="strategic" />
    <bpmn:sequenceFlow id="f5" sourceRef="strategic" targetRef="detailed" />
    <bpmn:sequenceFlow id="f6" sourceRef="detailed" targetRef="needed" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="needed" targetRef="adjust" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="needed" targetRef="approvefinal" />
    <bpmn:sequenceFlow id="f9" sourceRef="adjust" targetRef="document" />
    <bpmn:sequenceFlow id="f10" sourceRef="document" targetRef="approveadj" />
    <bpmn:sequenceFlow id="f11" sourceRef="approveadj" targetRef="merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="approvefinal" targetRef="allocate" />
    <bpmn:sequenceFlow id="f13" sourceRef="allocate" targetRef="distribute" />
    <bpmn:sequenceFlow id="f14" sourceRef="distribute" targetRef="implement" />
    <bpmn:sequenceFlow id="f15" sourceRef="implement" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>