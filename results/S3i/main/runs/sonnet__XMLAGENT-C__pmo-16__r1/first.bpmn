<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Multinational company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="coord" name="Audit coordinator">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="regional" name="Regional office">
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provClar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="compliance" name="Compliance team">
        <bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="central" name="Central audit team">
        <bpmn:flowNodeRef>mergeR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gDisc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqClar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evalC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gHigh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gSite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>visits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeSite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeHigh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="Audit director">
        <bpmn:flowNodeRef>reviewRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAppr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Annual audit due" />
    <bpmn:task id="notify" name="Send a notification to the regional office" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="prep" name="Prepare the financial statements" />
    <bpmn:task id="gather" name="Gather the necessary documents" />
    <bpmn:task id="comp" name="Check for regulatory updates" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="submit" name="Submit the documents to the central audit team" />
    <bpmn:exclusiveGateway id="mergeR" />
    <bpmn:task id="review" name="Review the submission" />
    <bpmn:exclusiveGateway id="gDisc" name="Discrepancies found?" />
    <bpmn:task id="reqClar" name="Request clarifications from the regional office" />
    <bpmn:task id="provClar" name="Provide the necessary clarifications" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="evalF" name="Evaluate financial risks" />
    <bpmn:task id="evalO" name="Evaluate operational risks" />
    <bpmn:task id="evalC" name="Evaluate compliance risks" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:exclusiveGateway id="gHigh" name="High risk identified?" />
    <bpmn:task id="analysis" name="Perform data analysis" />
    <bpmn:task id="interviews" name="Conduct interviews" />
    <bpmn:exclusiveGateway id="gSite" name="Site visit needed?" />
    <bpmn:task id="visits" name="Conduct site visits" />
    <bpmn:exclusiveGateway id="mergeSite" />
    <bpmn:exclusiveGateway id="mergeHigh" />
    <bpmn:task id="compile" name="Compile the audit report" />
    <bpmn:exclusiveGateway id="mergeRev" />
    <bpmn:task id="reviewRep" name="Review the report" />
    <bpmn:exclusiveGateway id="gAppr" name="Report approved?" />
    <bpmn:task id="update" name="Update the report" />
    <bpmn:parallelGateway id="split3" />
    <bpmn:task id="distribute" name="Distribute the final report to the executive board" />
    <bpmn:task id="archive" name="Archive the final report" />
    <bpmn:parallelGateway id="join3" />
    <bpmn:task id="close" name="Close the audit process" />
    <bpmn:endEvent id="end" name="Audit closed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="notify" />
    <bpmn:sequenceFlow id="f2" sourceRef="notify" targetRef="split1" />
    <bpmn:sequenceFlow id="f3" sourceRef="split1" targetRef="prep" />
    <bpmn:sequenceFlow id="f4" sourceRef="prep" targetRef="gather" />
    <bpmn:sequenceFlow id="f5" sourceRef="split1" targetRef="comp" />
    <bpmn:sequenceFlow id="f6" sourceRef="gather" targetRef="join1" />
    <bpmn:sequenceFlow id="f7" sourceRef="comp" targetRef="join1" />
    <bpmn:sequenceFlow id="f8" sourceRef="join1" targetRef="submit" />
    <bpmn:sequenceFlow id="f9" sourceRef="submit" targetRef="mergeR" />
    <bpmn:sequenceFlow id="f10" sourceRef="mergeR" targetRef="review" />
    <bpmn:sequenceFlow id="f11" sourceRef="review" targetRef="gDisc" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="gDisc" targetRef="reqClar" />
    <bpmn:sequenceFlow id="f13" sourceRef="reqClar" targetRef="provClar" />
    <bpmn:sequenceFlow id="f14" sourceRef="provClar" targetRef="mergeR" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="gDisc" targetRef="split2" />
    <bpmn:sequenceFlow id="f16" sourceRef="split2" targetRef="evalF" />
    <bpmn:sequenceFlow id="f17" sourceRef="split2" targetRef="evalO" />
    <bpmn:sequenceFlow id="f18" sourceRef="split2" targetRef="evalC" />
    <bpmn:sequenceFlow id="f19" sourceRef="evalF" targetRef="join2" />
    <bpmn:sequenceFlow id="f20" sourceRef="evalO" targetRef="join2" />
    <bpmn:sequenceFlow id="f21" sourceRef="evalC" targetRef="join2" />
    <bpmn:sequenceFlow id="f22" sourceRef="join2" targetRef="gHigh" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="gHigh" targetRef="analysis" />
    <bpmn:sequenceFlow id="f24" sourceRef="analysis" targetRef="interviews" />
    <bpmn:sequenceFlow id="f25" sourceRef="interviews" targetRef="gSite" />
    <bpmn:sequenceFlow id="f26" name="yes" sourceRef="gSite" targetRef="visits" />
    <bpmn:sequenceFlow id="f27" name="no" sourceRef="gSite" targetRef="mergeSite" />
    <bpmn:sequenceFlow id="f28" sourceRef="visits" targetRef="mergeSite" />
    <bpmn:sequenceFlow id="f29" sourceRef="mergeSite" targetRef="mergeHigh" />
    <bpmn:sequenceFlow id="f30" name="no" sourceRef="gHigh" targetRef="mergeHigh" />
    <bpmn:sequenceFlow id="f31" sourceRef="mergeHigh" targetRef="compile" />
    <bpmn:sequenceFlow id="f32" sourceRef="compile" targetRef="mergeRev" />
    <bpmn:sequenceFlow id="f33" sourceRef="mergeRev" targetRef="reviewRep" />
    <bpmn:sequenceFlow id="f34" sourceRef="reviewRep" targetRef="gAppr" />
    <bpmn:sequenceFlow id="f35" name="no" sourceRef="gAppr" targetRef="update" />
    <bpmn:sequenceFlow id="f36" sourceRef="update" targetRef="mergeRev" />
    <bpmn:sequenceFlow id="f37" name="yes" sourceRef="gAppr" targetRef="split3" />
    <bpmn:sequenceFlow id="f38" sourceRef="split3" targetRef="distribute" />
    <bpmn:sequenceFlow id="f39" sourceRef="split3" targetRef="archive" />
    <bpmn:sequenceFlow id="f40" sourceRef="distribute" targetRef="join3" />
    <bpmn:sequenceFlow id="f41" sourceRef="archive" targetRef="join3" />
    <bpmn:sequenceFlow id="f42" sourceRef="join3" targetRef="close" />
    <bpmn:sequenceFlow id="f43" sourceRef="close" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>