<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="E-commerce company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_system" name="System">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informdelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivebo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endret</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wrap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_shipping" name="Shipping department">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order needed" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="record" name="Record the order details" />
    <bpmn:task id="pay" name="Process the payment" />
    <bpmn:exclusiveGateway id="paid" name="Payment successful?" />
    <bpmn:task id="notifyfail" name="Notify the customer about the failed payment" />
    <bpmn:endEvent id="endfail" name="Order cancelled" />
    <bpmn:task id="stock" name="Check the stock availability" />
    <bpmn:exclusiveGateway id="instock" name="Items in stock?" />
    <bpmn:task id="backorder" name="Initiate the back-order" />
    <bpmn:task id="informdelay" name="Inform the customer about the delay" />
    <bpmn:task id="receivebo" name="Receive the back-order" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="pick" name="Pick the items from the warehouse" />
    <bpmn:task id="qc" name="Perform quality control on the picked items" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="pack" name="Pack the items" />
    <bpmn:exclusiveGateway id="gift" name="Gift wrapping requested?" />
    <bpmn:task id="wrap" name="Wrap the gift" />
    <bpmn:exclusiveGateway id="mg" />
    <bpmn:task id="docs" name="Prepare shipping documents and labels" />
    <bpmn:exclusiveGateway id="intl" name="International order?" />
    <bpmn:task id="customs" name="Prepare customs documentation" />
    <bpmn:exclusiveGateway id="mi" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="dispatch" name="Dispatch the order" />
    <bpmn:task id="confirm" name="Send the shipping confirmation to the customer" />
    <bpmn:task id="update" name="Update the inventory levels" />
    <bpmn:task id="delivered" name="Confirm the successful delivery" />
    <bpmn:exclusiveGateway id="issues" name="Issues reported?" />
    <bpmn:task id="followup" name="Send the follow-up email for feedback" />
    <bpmn:endEvent id="endok" name="Order completed" />
    <bpmn:task id="label" name="Send the return shipping label" />
    <bpmn:task id="receive" name="Receive the returned items" />
    <bpmn:task id="inspect" name="Inspect the returned items" />
    <bpmn:task id="refund" name="Process the refund or replacement" />
    <bpmn:endEvent id="endret" name="Return handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="place" />
    <bpmn:sequenceFlow id="f2" sourceRef="place" targetRef="record" />
    <bpmn:sequenceFlow id="f3" sourceRef="record" targetRef="pay" />
    <bpmn:sequenceFlow id="f4" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="paid" targetRef="notifyfail" />
    <bpmn:sequenceFlow id="f6" sourceRef="notifyfail" targetRef="endfail" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="paid" targetRef="stock" />
    <bpmn:sequenceFlow id="f8" sourceRef="stock" targetRef="instock" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="instock" targetRef="backorder" />
    <bpmn:sequenceFlow id="f10" sourceRef="backorder" targetRef="informdelay" />
    <bpmn:sequenceFlow id="f11" sourceRef="informdelay" targetRef="receivebo" />
    <bpmn:sequenceFlow id="f12" sourceRef="receivebo" targetRef="m1" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="instock" targetRef="m1" />
    <bpmn:sequenceFlow id="f14" sourceRef="m1" targetRef="pick" />
    <bpmn:sequenceFlow id="f15" sourceRef="pick" targetRef="qc" />
    <bpmn:sequenceFlow id="f16" sourceRef="qc" targetRef="split" />
    <bpmn:sequenceFlow id="f17" sourceRef="split" targetRef="pack" />
    <bpmn:sequenceFlow id="f18" sourceRef="split" targetRef="docs" />
    <bpmn:sequenceFlow id="f19" sourceRef="pack" targetRef="gift" />
    <bpmn:sequenceFlow id="f20" name="yes" sourceRef="gift" targetRef="wrap" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="gift" targetRef="mg" />
    <bpmn:sequenceFlow id="f22" sourceRef="wrap" targetRef="mg" />
    <bpmn:sequenceFlow id="f23" sourceRef="mg" targetRef="join" />
    <bpmn:sequenceFlow id="f24" sourceRef="docs" targetRef="intl" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="intl" targetRef="customs" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="intl" targetRef="mi" />
    <bpmn:sequenceFlow id="f27" sourceRef="customs" targetRef="mi" />
    <bpmn:sequenceFlow id="f28" sourceRef="mi" targetRef="join" />
    <bpmn:sequenceFlow id="f29" sourceRef="join" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f30" sourceRef="dispatch" targetRef="confirm" />
    <bpmn:sequenceFlow id="f31" sourceRef="confirm" targetRef="update" />
    <bpmn:sequenceFlow id="f32" sourceRef="update" targetRef="delivered" />
    <bpmn:sequenceFlow id="f33" sourceRef="delivered" targetRef="issues" />
    <bpmn:sequenceFlow id="f34" name="no" sourceRef="issues" targetRef="followup" />
    <bpmn:sequenceFlow id="f35" sourceRef="followup" targetRef="endok" />
    <bpmn:sequenceFlow id="f36" name="yes" sourceRef="issues" targetRef="label" />
    <bpmn:sequenceFlow id="f37" sourceRef="label" targetRef="receive" />
    <bpmn:sequenceFlow id="f38" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f39" sourceRef="inspect" targetRef="refund" />
    <bpmn:sequenceFlow id="f40" sourceRef="refund" targetRef="endret" />
  </bpmn:process>
</bpmn:definitions>
