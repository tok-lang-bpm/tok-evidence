<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="University" processRef="P" />
  </bpmn:collaboration>
  <bpmn:process id="P" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_stu" name="Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>idcard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>courses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>semStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gGriev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mGriev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endGrad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gIntl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mIntl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pSplit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pJoin2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_adm" name="Admissions Office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pSplit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pJoin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_com" name="Admissions Committee">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_fin" name="Finance Department">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_it" name="IT Department">
        <bpmn:flowNodeRef>accounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_intl" name="International Student Office">
        <bpmn:flowNodeRef>visa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_adv" name="Academic Advisor">
        <bpmn:flowNodeRef>advisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_app" name="Appeals Committee">
        <bpmn:flowNodeRef>meetApp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Application needed" />
    <bpmn:task id="submit" name="Submit the application online" />
    <bpmn:exclusiveGateway id="mReview" />
    <bpmn:task id="review" name="Review the application and supporting documents" />
    <bpmn:exclusiveGateway id="gDocs" name="Documents complete?" />
    <bpmn:task id="notify" name="Notify the applicant to provide the missing items" />
    <bpmn:task id="provide" name="Provide the missing documents" />
    <bpmn:parallelGateway id="pSplit1" />
    <bpmn:task id="evaluate" name="Evaluate the application" />
    <bpmn:task id="fees" name="Process application fees or waivers" />
    <bpmn:parallelGateway id="pJoin1" />
    <bpmn:exclusiveGateway id="gAcc" name="Application accepted?" />
    <bpmn:task id="reject" name="Send a rejection letter" />
    <bpmn:endEvent id="endRej" name="Application rejected" />
    <bpmn:task id="accept" name="Send an acceptance letter" />
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Enrollment confirmed">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="deadline" name="Deadline passed">
      <bpmn:timerEventDefinition><bpmn:timeDate>deadline</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endCancel" name="Application canceled" />
    <bpmn:parallelGateway id="pSplit2" />
    <bpmn:task id="orient" name="Receive orientation materials" />
    <bpmn:task id="accounts" name="Set up student accounts for email, online portals and library access" />
    <bpmn:exclusiveGateway id="gIntl" name="Student international?" />
    <bpmn:task id="visa" name="Assist with visa processing" />
    <bpmn:exclusiveGateway id="mIntl" />
    <bpmn:parallelGateway id="pJoin2" />
    <bpmn:task id="idcard" name="Obtain a student ID card" />
    <bpmn:task id="advisor" name="Meet with an academic advisor" />
    <bpmn:task id="courses" name="Select courses" />
    <bpmn:task id="conflicts" name="Resolve schedule conflicts" />
    <bpmn:exclusiveGateway id="semStart" />
    <bpmn:task id="attend" name="Attend classes" />
    <bpmn:exclusiveGateway id="gChange" name="Change courses?" />
    <bpmn:task id="addDrop" name="Add or drop courses" />
    <bpmn:exclusiveGateway id="mChange" />
    <bpmn:task id="post" name="Post grades" />
    <bpmn:task id="reviewGrades" name="Review grades online" />
    <bpmn:exclusiveGateway id="gGriev" name="Grievances?" />
    <bpmn:task id="form" name="Submit an appeal form" />
    <bpmn:task id="meetApp" name="Meet with the appeals committee" />
    <bpmn:task id="await" name="Await a decision" />
    <bpmn:exclusiveGateway id="mGriev" />
    <bpmn:exclusiveGateway id="gDone" name="Graduated or withdrawn?" />
    <bpmn:endEvent id="endGrad" name="Student left the university" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="mReview" />
    <bpmn:sequenceFlow id="f3" sourceRef="mReview" targetRef="review" />
    <bpmn:sequenceFlow id="f4" sourceRef="review" targetRef="gDocs" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gDocs" targetRef="notify" />
    <bpmn:sequenceFlow id="f6" sourceRef="notify" targetRef="provide" />
    <bpmn:sequenceFlow id="f7" sourceRef="provide" targetRef="mReview" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="gDocs" targetRef="pSplit1" />
    <bpmn:sequenceFlow id="f9" sourceRef="pSplit1" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f10" sourceRef="pSplit1" targetRef="fees" />
    <bpmn:sequenceFlow id="f11" sourceRef="evaluate" targetRef="pJoin1" />
    <bpmn:sequenceFlow id="f12" sourceRef="fees" targetRef="pJoin1" />
    <bpmn:sequenceFlow id="f13" sourceRef="pJoin1" targetRef="gAcc" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gAcc" targetRef="reject" />
    <bpmn:sequenceFlow id="f15" sourceRef="reject" targetRef="endRej" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="gAcc" targetRef="accept" />
    <bpmn:sequenceFlow id="f17" sourceRef="accept" targetRef="wait" />
    <bpmn:sequenceFlow id="f18" sourceRef="wait" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f19" sourceRef="wait" targetRef="deadline" />
    <bpmn:sequenceFlow id="f20" sourceRef="deadline" targetRef="endCancel" />
    <bpmn:sequenceFlow id="f21" sourceRef="confirmed" targetRef="pSplit2" />
    <bpmn:sequenceFlow id="f22" sourceRef="pSplit2" targetRef="orient" />
    <bpmn:sequenceFlow id="f23" sourceRef="pSplit2" targetRef="accounts" />
    <bpmn:sequenceFlow id="f24" sourceRef="pSplit2" targetRef="gIntl" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="gIntl" targetRef="visa" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="gIntl" targetRef="mIntl" />
    <bpmn:sequenceFlow id="f27" sourceRef="visa" targetRef="mIntl" />
    <bpmn:sequenceFlow id="f28" sourceRef="orient" targetRef="pJoin2" />
    <bpmn:sequenceFlow id="f29" sourceRef="accounts" targetRef="pJoin2" />
    <bpmn:sequenceFlow id="f30" sourceRef="mIntl" targetRef="pJoin2" />
    <bpmn:sequenceFlow id="f31" sourceRef="pJoin2" targetRef="idcard" />
    <bpmn:sequenceFlow id="f32" sourceRef="idcard" targetRef="advisor" />
    <bpmn:sequenceFlow id="f33" sourceRef="advisor" targetRef="courses" />
    <bpmn:sequenceFlow id="f34" sourceRef="courses" targetRef="conflicts" />
    <bpmn:sequenceFlow id="f35" sourceRef="conflicts" targetRef="semStart" />
    <bpmn:sequenceFlow id="f36" sourceRef="semStart" targetRef="attend" />
    <bpmn:sequenceFlow id="f37" sourceRef="attend" targetRef="gChange" />
    <bpmn:sequenceFlow id="f38" name="yes" sourceRef="gChange" targetRef="addDrop" />
    <bpmn:sequenceFlow id="f39" name="no" sourceRef="gChange" targetRef="mChange" />
    <bpmn:sequenceFlow id="f40" sourceRef="addDrop" targetRef="mChange" />
    <bpmn:sequenceFlow id="f41" sourceRef="mChange" targetRef="post" />
    <bpmn:sequenceFlow id="f42" sourceRef="post" targetRef="reviewGrades" />
    <bpmn:sequenceFlow id="f43" sourceRef="reviewGrades" targetRef="gGriev" />
    <bpmn:sequenceFlow id="f44" name="yes" sourceRef="gGriev" targetRef="form" />
    <bpmn:sequenceFlow id="f45" sourceRef="form" targetRef="meetApp" />
    <bpmn:sequenceFlow id="f46" sourceRef="meetApp" targetRef="await" />
    <bpmn:sequenceFlow id="f47" sourceRef="await" targetRef="mGriev" />
    <bpmn:sequenceFlow id="f48" name="no" sourceRef="gGriev" targetRef="mGriev" />
    <bpmn:sequenceFlow id="f49" sourceRef="mGriev" targetRef="gDone" />
    <bpmn:sequenceFlow id="f50" name="yes" sourceRef="gDone" targetRef="endGrad" />
    <bpmn:sequenceFlow id="f51" name="no, next semester" sourceRef="gDone" targetRef="semStart" />
  </bpmn:process>
</bpmn:definitions>
