<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Online shop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="user" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>how</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>installment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="shop" name="Shop">
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exchange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order started" />
    <bpmn:task id="login" name="Log in to the account" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="select" name="Select the items" />
    <bpmn:task id="reward" name="Choose a free reward" />
    <bpmn:task id="method" name="Set a payment method" />
    <bpmn:exclusiveGateway id="how" name="Pay or installment?" />
    <bpmn:task id="pay" name="Pay" />
    <bpmn:task id="installment" name="Complete an installment agreement" />
    <bpmn:exclusiveGateway id="paid" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="again" />
    <bpmn:task id="deliver" name="Deliver the items" />
    <bpmn:exclusiveGateway id="exchange" name="Items returned for exchange?" />
    <bpmn:task id="retu" name="Return the items" />
    <bpmn:endEvent id="end" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="select" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="method" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="reward" />
    <bpmn:sequenceFlow id="f6" sourceRef="method" targetRef="how" />
    <bpmn:sequenceFlow id="f7" name="pay" sourceRef="how" targetRef="pay" />
    <bpmn:sequenceFlow id="f8" name="installment" sourceRef="how" targetRef="installment" />
    <bpmn:sequenceFlow id="f9" sourceRef="pay" targetRef="paid" />
    <bpmn:sequenceFlow id="f10" sourceRef="installment" targetRef="paid" />
    <bpmn:sequenceFlow id="f11" sourceRef="paid" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="reward" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="join" targetRef="again" />
    <bpmn:sequenceFlow id="f14" sourceRef="again" targetRef="deliver" />
    <bpmn:sequenceFlow id="f15" sourceRef="deliver" targetRef="exchange" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="exchange" targetRef="retu" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="exchange" targetRef="end" />
    <bpmn:sequenceFlow id="f18" sourceRef="retu" targetRef="again" />
  </bpmn:process>
</bpmn:definitions>