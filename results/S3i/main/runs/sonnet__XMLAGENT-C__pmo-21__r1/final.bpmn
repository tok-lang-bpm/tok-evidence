<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Shipping organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="sec" name="Secretary">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>large</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>needIns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Logistics department head">
        <bpmn:flowNodeRef>insure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="wh" name="Warehouseman">
        <bpmn:flowNodeRef>pack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Goods shall be shipped" />
    <bpmn:task id="clarify" name="Clarify who will do the shipping" />
    <bpmn:exclusiveGateway id="large" name="Large amounts?" />
    <bpmn:task id="invite" name="Invite three logistic companies to make offers" />
    <bpmn:task id="select" name="Select one logistic company" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="label" name="Write package label" />
    <bpmn:exclusiveGateway id="needIns" name="Insurance necessary?" />
    <bpmn:task id="insure" name="Take parcel insurance" />
    <bpmn:exclusiveGateway id="insMerge" />
    <bpmn:task id="pack" name="Package the goods" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="prepare" name="Prepare the packaged goods for pick-up" />
    <bpmn:endEvent id="end" name="Goods ready for pick-up" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="clarify" />
    <bpmn:sequenceFlow id="f2" sourceRef="clarify" targetRef="large" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="large" targetRef="invite" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="large" targetRef="split" />
    <bpmn:sequenceFlow id="f5" sourceRef="invite" targetRef="select" />
    <bpmn:sequenceFlow id="f6" sourceRef="select" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="label" />
    <bpmn:sequenceFlow id="f8" sourceRef="split" targetRef="needIns" />
    <bpmn:sequenceFlow id="f9" sourceRef="split" targetRef="pack" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="needIns" targetRef="insure" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="needIns" targetRef="insMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="insure" targetRef="insMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="label" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="insMerge" targetRef="join" />
    <bpmn:sequenceFlow id="f15" sourceRef="pack" targetRef="join" />
    <bpmn:sequenceFlow id="f16" sourceRef="join" targetRef="merge" />
    <bpmn:sequenceFlow id="f17" sourceRef="merge" targetRef="prepare" />
    <bpmn:sequenceFlow id="f18" sourceRef="prepare" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
