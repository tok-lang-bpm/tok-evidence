<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Bank" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="clerk" name="Sales clerk">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>see</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Banking system">
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agency" name="Agency">
        <bpmn:flowNodeRef>quick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>immediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>level2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Credit-scoring needed" />
    <bpmn:task id="receive" name="Receive the credit-scoring" />
    <bpmn:task id="send" name="Send the scoring request to the agency" />
    <bpmn:task id="quick" name="Do the first quick scoring (level 1)" />
    <bpmn:exclusiveGateway id="immediate" name="Result immediately available?" />
    <bpmn:task id="returnr" name="Return the result to the banking system" />
    <bpmn:task id="inform" name="Inform the banking process of the delay" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="display" name="Display the delay message to the clerk" />
    <bpmn:task id="level2" name="Do the level 2 scoring" />
    <bpmn:task id="sendback" name="Send the result to the banking process" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="present" name="Present the result to the clerk" />
    <bpmn:task id="see" name="See the result at the frontend" />
    <bpmn:endEvent id="end" name="Credit-scoring received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="send" />
    <bpmn:sequenceFlow id="f3" sourceRef="send" targetRef="quick" />
    <bpmn:sequenceFlow id="f4" sourceRef="quick" targetRef="immediate" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="immediate" targetRef="returnr" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="immediate" targetRef="inform" />
    <bpmn:sequenceFlow id="f7" sourceRef="returnr" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="inform" targetRef="split" />
    <bpmn:sequenceFlow id="f9" sourceRef="split" targetRef="display" />
    <bpmn:sequenceFlow id="f10" sourceRef="split" targetRef="level2" />
    <bpmn:sequenceFlow id="f11" sourceRef="level2" targetRef="sendback" />
    <bpmn:sequenceFlow id="f12" sourceRef="display" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="sendback" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="join" targetRef="merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="merge" targetRef="present" />
    <bpmn:sequenceFlow id="f16" sourceRef="present" targetRef="see" />
    <bpmn:sequenceFlow id="f17" sourceRef="see" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>