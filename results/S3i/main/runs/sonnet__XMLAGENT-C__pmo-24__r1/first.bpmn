<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Restaurant" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="guest" name="Guest">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informchef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appears</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chef" name="Chef">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informemp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Guest feels hungry" />
    <bpmn:task id="choose" name="Choose a dish" />
    <bpmn:task id="wait" name="Wait until it is his turn" />
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="enter" name="Enter the order into the POS system" />
    <bpmn:task id="collect" name="Collect the money" />
    <bpmn:task id="setup" name="Set up a buzzer" />
    <bpmn:task id="pass" name="Pass the buzzer to the guest" />
    <bpmn:task id="informchef" name="Inform the chef of the new meal order" />
    <bpmn:task id="prepare" name="Prepare the meal" />
    <bpmn:task id="hatch" name="Place the meal in the service hatch" />
    <bpmn:task id="informemp" name="Inform the employee that the meal is in the service hatch" />
    <bpmn:task id="ready" name="Become aware that the meal is ready" />
    <bpmn:task id="ring" name="Set off the guest's buzzer" />
    <bpmn:eventBasedGateway id="evgw" />
    <bpmn:intermediateCatchEvent id="appears" name="Guest appears at the service hatch">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer" name="5 minutes passed">
      <bpmn:timerEventDefinition><bpmn:timeDuration>PT5M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="call" name="Call for the guest" />
    <bpmn:task id="handover" name="Hand over the meal" />
    <bpmn:task id="pickup" name="Pick up the meal" />
    <bpmn:task id="eat" name="Eat the meal" />
    <bpmn:endEvent id="end" name="Meal eaten" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="choose" />
    <bpmn:sequenceFlow id="f2" sourceRef="choose" targetRef="wait" />
    <bpmn:sequenceFlow id="f3" sourceRef="wait" targetRef="place" />
    <bpmn:sequenceFlow id="f4" sourceRef="place" targetRef="enter" />
    <bpmn:sequenceFlow id="f5" sourceRef="enter" targetRef="collect" />
    <bpmn:sequenceFlow id="f6" sourceRef="collect" targetRef="setup" />
    <bpmn:sequenceFlow id="f7" sourceRef="setup" targetRef="pass" />
    <bpmn:sequenceFlow id="f8" sourceRef="pass" targetRef="informchef" />
    <bpmn:sequenceFlow id="f9" sourceRef="informchef" targetRef="prepare" />
    <bpmn:sequenceFlow id="f10" sourceRef="prepare" targetRef="hatch" />
    <bpmn:sequenceFlow id="f11" sourceRef="hatch" targetRef="informemp" />
    <bpmn:sequenceFlow id="f12" sourceRef="informemp" targetRef="ready" />
    <bpmn:sequenceFlow id="f13" sourceRef="ready" targetRef="ring" />
    <bpmn:sequenceFlow id="f14" sourceRef="ring" targetRef="evgw" />
    <bpmn:sequenceFlow id="f15" sourceRef="evgw" targetRef="appears" />
    <bpmn:sequenceFlow id="f16" sourceRef="evgw" targetRef="timer" />
    <bpmn:sequenceFlow id="f17" sourceRef="timer" targetRef="call" />
    <bpmn:sequenceFlow id="f18" sourceRef="call" targetRef="evgw" />
    <bpmn:sequenceFlow id="f19" sourceRef="appears" targetRef="handover" />
    <bpmn:sequenceFlow id="f20" sourceRef="handover" targetRef="pickup" />
    <bpmn:sequenceFlow id="f21" sourceRef="pickup" targetRef="eat" />
    <bpmn:sequenceFlow id="f22" sourceRef="eat" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>