<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Find a Job" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="applicant" name="Job applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ratedLow</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rateApplicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>permanent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notPermanent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="portal" name="Job portal">
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continueOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Job search started" />
    <bpmn:task id="write" name="Write job application" />
    <bpmn:task id="report" name="Report job application" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="offers" name="Send potential job offers" />
    <bpmn:task id="confirm" name="Confirm receipt of job application" />
    <bpmn:task id="rateApplication" name="Rate job application" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:exclusiveGateway id="intGw" name="Interview negotiated?" />
    <bpmn:task id="negotiate" name="Negotiate job interview" />
    <bpmn:exclusiveGateway id="intMerge" />
    <bpmn:exclusiveGateway id="wants" name="Company wants applicant?" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:task id="probation" name="Enter probation phase" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="rateCompany" name="Rate company" />
    <bpmn:task id="rateApplicant" name="Rate applicant" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:task id="publish" name="Publish company review after 1 year" />
    <bpmn:exclusiveGateway id="permanent" name="Job permanent?" />
    <bpmn:endEvent id="notPermanent" name="Job not permanent" />
    <bpmn:exclusiveGateway id="ratedLow" name="Company rated C or less?" />
    <bpmn:task id="continueOffers" name="Receive job offers without reporting" />
    <bpmn:endEvent id="endContinue" name="Offers continue" />
    <bpmn:endEvent id="endDone" name="Process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="write" />
    <bpmn:sequenceFlow id="f2" sourceRef="write" targetRef="report" />
    <bpmn:sequenceFlow id="f3" sourceRef="report" targetRef="split1" />
    <bpmn:sequenceFlow id="f4" sourceRef="split1" targetRef="offers" />
    <bpmn:sequenceFlow id="f5" sourceRef="split1" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="confirm" targetRef="rateApplication" />
    <bpmn:sequenceFlow id="f7" sourceRef="offers" targetRef="join1" />
    <bpmn:sequenceFlow id="f8" sourceRef="rateApplication" targetRef="join1" />
    <bpmn:sequenceFlow id="f9" sourceRef="join1" targetRef="intGw" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="intGw" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="intGw" targetRef="intMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="negotiate" targetRef="intMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="intMerge" targetRef="wants" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="wants" targetRef="rejected" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="wants" targetRef="probation" />
    <bpmn:sequenceFlow id="f16" sourceRef="probation" targetRef="split2" />
    <bpmn:sequenceFlow id="f17" sourceRef="split2" targetRef="rateCompany" />
    <bpmn:sequenceFlow id="f18" sourceRef="split2" targetRef="rateApplicant" />
    <bpmn:sequenceFlow id="f19" sourceRef="rateCompany" targetRef="join2" />
    <bpmn:sequenceFlow id="f20" sourceRef="rateApplicant" targetRef="join2" />
    <bpmn:sequenceFlow id="f21" sourceRef="join2" targetRef="publish" />
    <bpmn:sequenceFlow id="f22" sourceRef="publish" targetRef="permanent" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="permanent" targetRef="notPermanent" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="permanent" targetRef="ratedLow" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="ratedLow" targetRef="continueOffers" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="ratedLow" targetRef="endDone" />
    <bpmn:sequenceFlow id="f27" sourceRef="continueOffers" targetRef="endContinue" />
  </bpmn:process>
</bpmn:definitions>
