<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Maternity leave support" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="parent" name="Parent">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Leave support system">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyCo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Maternity leave planned" />
    <bpmn:task id="fetch" name="Fetch information about potential models" />
    <bpmn:task id="select" name="Select a model" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="collect" name="Collect relevant information" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="notifySS" name="Notify Social Security" />
    <bpmn:task id="notifyCo" name="Notify Company" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="gather" name="Gather information from companies" />
    <bpmn:exclusiveGateway id="decide" name="Extend the leave?" />
    <bpmn:task id="extend" name="Decide about extension" />
    <bpmn:endEvent id="endOk" name="Leave ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fetch" />
    <bpmn:sequenceFlow id="f2" sourceRef="fetch" targetRef="select" />
    <bpmn:sequenceFlow id="f3" sourceRef="select" targetRef="merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="merge" targetRef="collect" />
    <bpmn:sequenceFlow id="f5" sourceRef="collect" targetRef="split" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="notifySS" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="notifyCo" />
    <bpmn:sequenceFlow id="f8" sourceRef="notifySS" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="notifyCo" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="join" targetRef="gather" />
    <bpmn:sequenceFlow id="f11" sourceRef="gather" targetRef="extend" />
    <bpmn:sequenceFlow id="f12" sourceRef="extend" targetRef="decide" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="decide" targetRef="merge" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="decide" targetRef="endOk" />
  </bpmn:process>
</bpmn:definitions>
