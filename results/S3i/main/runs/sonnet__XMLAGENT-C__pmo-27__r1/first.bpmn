<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Work Accident" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="employer" name="Employer">
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportIns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Accident or near accident occurred" />
    <bpmn:task id="inform" name="Inform the employer immediately" />
    <bpmn:task id="record" name="Record the incident" />
    <bpmn:exclusiveGateway id="g1" name="Work accident?" />
    <bpmn:exclusiveGateway id="g2" name="Fatality or serious injury not reported to emergency services?" />
    <bpmn:task id="reportLab" name="Report the accident to the Labour Inspectorate" />
    <bpmn:exclusiveGateway id="m" />
    <bpmn:exclusiveGateway id="g3" name="Person killed or unable to work for three days?" />
    <bpmn:task id="reportIns" name="Report the accident to the accident insurance provider within five days" />
    <bpmn:endEvent id="end1" name="Near accident recorded" />
    <bpmn:endEvent id="end2" name="Accident reported" />
    <bpmn:endEvent id="end3" name="Accident handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="inform" />
    <bpmn:sequenceFlow id="f2" sourceRef="inform" targetRef="record" />
    <bpmn:sequenceFlow id="f3" sourceRef="record" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="no, near accident" sourceRef="g1" targetRef="end1" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="g2" targetRef="reportLab" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="g2" targetRef="m" />
    <bpmn:sequenceFlow id="f8" sourceRef="reportLab" targetRef="m" />
    <bpmn:sequenceFlow id="f9" sourceRef="m" targetRef="g3" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="g3" targetRef="reportIns" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="g3" targetRef="end3" />
    <bpmn:sequenceFlow id="f12" sourceRef="reportIns" targetRef="end2" />
  </bpmn:process>
</bpmn:definitions>