<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Internship" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="student" name="Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>topic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>theirs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Internship wanted" />
    <bpmn:task id="topic" name="Enter topic and desired money" />
    <bpmn:task id="exp" name="Enter experience and hobbies" />
    <bpmn:task id="offer" name="Receive offer" />
    <bpmn:exclusiveGateway id="acc" name="Accept offer?" />
    <bpmn:task id="accept" name="Accept offer and invalidate all other offers" />
    <bpmn:task id="deny" name="Deny offer" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="mine" name="Write 3 status updates about internship" />
    <bpmn:task id="theirs" name="Write 3 status updates about student" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="tweet" name="Recommend company to friend via twitter">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="end" name="Internship finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="topic" />
    <bpmn:sequenceFlow id="f2" sourceRef="topic" targetRef="exp" />
    <bpmn:sequenceFlow id="f3" sourceRef="exp" targetRef="offer" />
    <bpmn:sequenceFlow id="f4" sourceRef="offer" targetRef="acc" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="acc" targetRef="accept" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="acc" targetRef="deny" />
    <bpmn:sequenceFlow id="f7" sourceRef="deny" targetRef="offer" />
    <bpmn:sequenceFlow id="f8" sourceRef="accept" targetRef="split" />
    <bpmn:sequenceFlow id="f9" sourceRef="split" targetRef="mine" />
    <bpmn:sequenceFlow id="f10" sourceRef="split" targetRef="theirs" />
    <bpmn:sequenceFlow id="f11" sourceRef="mine" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="theirs" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="join" targetRef="tweet" />
    <bpmn:sequenceFlow id="f14" sourceRef="tweet" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>