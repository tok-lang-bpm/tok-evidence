<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Work and Live in Austria" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findOffice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>additional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="office" name="Representation Office">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moreDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>granted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Work and living in Austria planned" />
    <bpmn:task id="checkReq" name="Check the requirements" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="accom" name="Organize the accommodation" />
    <bpmn:task id="bank" name="Open the bank account" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="findOffice" name="Determine the competent representation office" />
    <bpmn:task id="prepare" name="Prepare the visa documents" />
    <bpmn:task id="submit" name="Submit the visa application" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="review" name="Review the visa application" />
    <bpmn:exclusiveGateway id="moreDocs" name="Additional documents needed?" />
    <bpmn:task id="request" name="Request the additional documents" />
    <bpmn:task id="additional" name="Provide the additional documents" />
    <bpmn:exclusiveGateway id="granted" name="Visa granted?" />
    <bpmn:task id="issue" name="Issue the Rot-Weiss-Rot Card visa" />
    <bpmn:task id="receive" name="Receive the visa" />
    <bpmn:task id="refuse" name="Refuse the visa" />
    <bpmn:endEvent id="endOk" name="Visa received" />
    <bpmn:endEvent id="endNo" name="Visa refused" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkReq" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkReq" targetRef="split" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="accom" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="bank" />
    <bpmn:sequenceFlow id="f5" sourceRef="accom" targetRef="join" />
    <bpmn:sequenceFlow id="f6" sourceRef="bank" targetRef="join" />
    <bpmn:sequenceFlow id="f7" sourceRef="join" targetRef="findOffice" />
    <bpmn:sequenceFlow id="f8" sourceRef="findOffice" targetRef="prepare" />
    <bpmn:sequenceFlow id="f9" sourceRef="prepare" targetRef="submit" />
    <bpmn:sequenceFlow id="f10" sourceRef="submit" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="merge" targetRef="review" />
    <bpmn:sequenceFlow id="f12" sourceRef="review" targetRef="moreDocs" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="moreDocs" targetRef="request" />
    <bpmn:sequenceFlow id="f14" sourceRef="request" targetRef="additional" />
    <bpmn:sequenceFlow id="f15" sourceRef="additional" targetRef="merge" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="moreDocs" targetRef="granted" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="granted" targetRef="issue" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="granted" targetRef="refuse" />
    <bpmn:sequenceFlow id="f19" sourceRef="issue" targetRef="receive" />
    <bpmn:sequenceFlow id="f20" sourceRef="receive" targetRef="endOk" />
    <bpmn:sequenceFlow id="f21" sourceRef="refuse" targetRef="endNo" />
  </bpmn:process>
</bpmn:definitions>