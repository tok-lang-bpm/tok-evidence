<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="LAN party" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="host" name="Host">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>games</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dateMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>appoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gameMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>beerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enjoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="LAN party planned" />
    <bpmn:task id="invite" name="Send invitations to the 10 friends" />
    <bpmn:task id="games" name="Find out which games the friends want to play" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="dateMerge" />
    <bpmn:task id="appoint" name="Appoint a date" />
    <bpmn:exclusiveGateway id="agree" name="8 or more people agree?" />
    <bpmn:task id="check" name="Find out if you have all the games" />
    <bpmn:exclusiveGateway id="missing" name="Some games missing?" />
    <bpmn:task id="download" name="Download the missing games" />
    <bpmn:exclusiveGateway id="gameMerge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="beer" name="Find out how much beer the friends require" />
    <bpmn:exclusiveGateway id="enough" name="Enough beer?" />
    <bpmn:task id="buy" name="Buy the missing beer" />
    <bpmn:exclusiveGateway id="beerMerge" />
    <bpmn:task id="enjoy" name="Enjoy the LAN party" />
    <bpmn:endEvent id="end" name="LAN party over" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="invite" />
    <bpmn:sequenceFlow id="f2" sourceRef="invite" targetRef="games" />
    <bpmn:sequenceFlow id="f3" sourceRef="games" targetRef="split" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="dateMerge" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="check" />
    <bpmn:sequenceFlow id="f6" sourceRef="dateMerge" targetRef="appoint" />
    <bpmn:sequenceFlow id="f7" sourceRef="appoint" targetRef="agree" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="agree" targetRef="dateMerge" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="agree" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="missing" targetRef="download" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="missing" targetRef="gameMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="download" targetRef="gameMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="gameMerge" targetRef="join" />
    <bpmn:sequenceFlow id="f15" sourceRef="join" targetRef="beer" />
    <bpmn:sequenceFlow id="f16" sourceRef="beer" targetRef="enough" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="enough" targetRef="buy" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="enough" targetRef="beerMerge" />
    <bpmn:sequenceFlow id="f19" sourceRef="buy" targetRef="beerMerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="beerMerge" targetRef="enjoy" />
    <bpmn:sequenceFlow id="f21" sourceRef="enjoy" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>