<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Farming game" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="player" name="Player">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>brag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shareSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shareJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notshared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shareGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bot" name="Bot">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>farm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Bot wanted" />
    <bpmn:task id="find" name="Find out which resources you want" />
    <bpmn:task id="prio" name="Define priorities and dependencies of resources" />
    <bpmn:parallelGateway id="split" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="farm" name="Farm resources" />
    <bpmn:exclusiveGateway id="disaster" name="Natural disaster struck?" />
    <bpmn:task id="recover" name="Recover from the natural disaster" />
    <bpmn:task id="notify" name="Notify the player of reached milestones" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="shareGw" name="Share with friends?" />
    <bpmn:parallelGateway id="shareSplit" />
    <bpmn:task id="brag" name="Brag to selected friends" />
    <bpmn:task id="send" name="Send materials to selected friends" />
    <bpmn:parallelGateway id="shareJoin" />
    <bpmn:endEvent id="shared" name="Shared with friends" />
    <bpmn:endEvent id="notshared" name="Farming finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="find" />
    <bpmn:sequenceFlow id="f2" sourceRef="find" targetRef="prio" />
    <bpmn:sequenceFlow id="f3" sourceRef="prio" targetRef="split" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="merge" />
    <bpmn:sequenceFlow id="f5" sourceRef="merge" targetRef="farm" />
    <bpmn:sequenceFlow id="f6" sourceRef="farm" targetRef="disaster" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="disaster" targetRef="recover" />
    <bpmn:sequenceFlow id="f8" sourceRef="recover" targetRef="merge" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="disaster" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="split" targetRef="notify" />
    <bpmn:sequenceFlow id="f11" sourceRef="notify" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="join" targetRef="shareGw" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="shareGw" targetRef="shareSplit" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="shareGw" targetRef="notshared" />
    <bpmn:sequenceFlow id="f15" sourceRef="shareSplit" targetRef="brag" />
    <bpmn:sequenceFlow id="f16" sourceRef="shareSplit" targetRef="send" />
    <bpmn:sequenceFlow id="f17" sourceRef="brag" targetRef="shareJoin" />
    <bpmn:sequenceFlow id="f18" sourceRef="send" targetRef="shareJoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="shareJoin" targetRef="shared" />
  </bpmn:process>
</bpmn:definitions>
