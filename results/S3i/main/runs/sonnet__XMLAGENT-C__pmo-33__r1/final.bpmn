<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="3D printing" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instruct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>satisfied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>instock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkleft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>under</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="artist" name="Artist">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="printer" name="Printer">
        <bpmn:flowNodeRef>turnon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>heat</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="3D model needed" />
    <bpmn:task id="instruct" name="Instruct the artist to create a project" />
    <bpmn:task id="sketches" name="Send sketches to the artist" />
    <bpmn:task id="create" name="Create the 3D model" />
    <bpmn:exclusiveGateway id="satisfied" name="Satisfied with the result?" />
    <bpmn:task id="tell" name="Tell the artist what to change" />
    <bpmn:task id="choose" name="Choose a plastic color" />
    <bpmn:exclusiveGateway id="instock" name="Color in stock?" />
    <bpmn:task id="checkleft" name="Check how much color is left" />
    <bpmn:exclusiveGateway id="under" name="Under 100 grams?" />
    <bpmn:task id="shop" name="Put the color on the shopping list" />
    <bpmn:task id="order" name="Order the color" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="turnon" name="Turn the printer on" />
    <bpmn:task id="heat" name="Heat up the bed and the extruder" />
    <bpmn:task id="gcode" name="Generate the gcode file from the STL" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="print" name="Print the model" />
    <bpmn:endEvent id="end" name="Model printed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="instruct" />
    <bpmn:sequenceFlow id="f2" sourceRef="instruct" targetRef="sketches" />
    <bpmn:sequenceFlow id="f3" sourceRef="sketches" targetRef="create" />
    <bpmn:sequenceFlow id="f4" sourceRef="create" targetRef="satisfied" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="satisfied" targetRef="tell" />
    <bpmn:sequenceFlow id="f6" sourceRef="tell" targetRef="create" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="satisfied" targetRef="choose" />
    <bpmn:sequenceFlow id="f8" sourceRef="choose" targetRef="instock" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="instock" targetRef="checkleft" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="instock" targetRef="order" />
    <bpmn:sequenceFlow id="f11" sourceRef="checkleft" targetRef="under" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="under" targetRef="shop" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="under" targetRef="merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="shop" targetRef="merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="order" targetRef="merge" />
    <bpmn:sequenceFlow id="f16" sourceRef="merge" targetRef="split" />
    <bpmn:sequenceFlow id="f17" sourceRef="split" targetRef="turnon" />
    <bpmn:sequenceFlow id="f18" sourceRef="turnon" targetRef="heat" />
    <bpmn:sequenceFlow id="f19" sourceRef="split" targetRef="gcode" />
    <bpmn:sequenceFlow id="f20" sourceRef="heat" targetRef="join" />
    <bpmn:sequenceFlow id="f21" sourceRef="gcode" targetRef="join" />
    <bpmn:sequenceFlow id="f22" sourceRef="join" targetRef="print" />
    <bpmn:sequenceFlow id="f23" sourceRef="print" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
