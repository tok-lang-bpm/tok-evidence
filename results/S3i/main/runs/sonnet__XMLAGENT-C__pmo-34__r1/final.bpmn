<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Lego machine building" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="builder" name="Builder">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>redesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="children" name="Group of children">
        <bpmn:flowNodeRef>sort</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Machine needed" />
    <bpmn:task id="design" name="Develop the basic design" />
    <bpmn:task id="order" name="Order Lego brick sets" />
    <bpmn:task id="give" name="Give the Lego sets to the children" />
    <bpmn:task id="sort" name="Sort the parts into containers" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:exclusiveGateway id="parts" name="Parts left in container?" />
    <bpmn:task id="reorder" name="Reorder individual parts" />
    <bpmn:task id="build" name="Build the subcomponent" />
    <bpmn:task id="test" name="Test the subcomponent" />
    <bpmn:exclusiveGateway id="ok" name="Test successful?" />
    <bpmn:task id="redesign" name="Redesign the subcomponent" />
    <bpmn:task id="assemble" name="Assemble the machine" />
    <bpmn:endEvent id="end" name="Machine built" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="design" />
    <bpmn:sequenceFlow id="f2" sourceRef="design" targetRef="order" />
    <bpmn:sequenceFlow id="f3" sourceRef="order" targetRef="give" />
    <bpmn:sequenceFlow id="f4" sourceRef="give" targetRef="sort" />
    <bpmn:sequenceFlow id="f5" sourceRef="sort" targetRef="merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="merge" targetRef="parts" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="parts" targetRef="reorder" />
    <bpmn:sequenceFlow id="f8" sourceRef="reorder" targetRef="merge" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="parts" targetRef="build" />
    <bpmn:sequenceFlow id="f10" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="f11" sourceRef="test" targetRef="ok" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="ok" targetRef="redesign" />
    <bpmn:sequenceFlow id="f13" sourceRef="redesign" targetRef="merge" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="ok" targetRef="assemble" />
    <bpmn:sequenceFlow id="f15" sourceRef="assemble" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
