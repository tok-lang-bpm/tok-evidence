<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Chainsaw manufacturer" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>likes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="producer" name="Producer">
        <bpmn:flowNodeRef>osplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ojoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Chainsaw wanted" />
    <bpmn:task id="tell" name="Tell the properties of the chainsaw" />
    <bpmn:parallelGateway id="osplit" />
    <bpmn:task id="order1" name="Order parts from online source 1" />
    <bpmn:task id="order2" name="Order parts from online source 2" />
    <bpmn:parallelGateway id="ojoin" />
    <bpmn:intermediateCatchEvent id="arrive" name="Parts arrived">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="psplit" />
    <bpmn:task id="inspect" name="Inspect all parts manually" />
    <bpmn:task id="assemble" name="Assemble the parts" />
    <bpmn:task id="updates" name="Send updates to the customer" />
    <bpmn:parallelGateway id="pjoin" />
    <bpmn:task id="sendfirst" name="Send the first saw to the customer" />
    <bpmn:exclusiveGateway id="likes" name="Customer likes the saw?" />
    <bpmn:task id="rest" name="Produce the rest of the order" />
    <bpmn:endEvent id="done" name="Order produced" />
    <bpmn:endEvent id="rejected" name="Order cancelled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="tell" />
    <bpmn:sequenceFlow id="f2" sourceRef="tell" targetRef="osplit" />
    <bpmn:sequenceFlow id="f3" sourceRef="osplit" targetRef="order1" />
    <bpmn:sequenceFlow id="f4" sourceRef="osplit" targetRef="order2" />
    <bpmn:sequenceFlow id="f5" sourceRef="order1" targetRef="ojoin" />
    <bpmn:sequenceFlow id="f6" sourceRef="order2" targetRef="ojoin" />
    <bpmn:sequenceFlow id="f7" sourceRef="ojoin" targetRef="arrive" />
    <bpmn:sequenceFlow id="f8" sourceRef="arrive" targetRef="psplit" />
    <bpmn:sequenceFlow id="f9" sourceRef="psplit" targetRef="inspect" />
    <bpmn:sequenceFlow id="f10" sourceRef="psplit" targetRef="updates" />
    <bpmn:sequenceFlow id="f11" sourceRef="inspect" targetRef="assemble" />
    <bpmn:sequenceFlow id="f12" sourceRef="assemble" targetRef="pjoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="updates" targetRef="pjoin" />
    <bpmn:sequenceFlow id="f14" sourceRef="pjoin" targetRef="sendfirst" />
    <bpmn:sequenceFlow id="f15" sourceRef="sendfirst" targetRef="likes" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="likes" targetRef="rest" />
    <bpmn:sequenceFlow id="f17" name="no" sourceRef="likes" targetRef="rejected" />
    <bpmn:sequenceFlow id="f18" sourceRef="rest" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
