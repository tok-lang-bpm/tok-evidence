<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Airplane producer" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L1" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Producer">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendprot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Manufacturing teams">
        <bpmn:flowNodeRef>bar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>seats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>toilet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer wants a plane" />
    <bpmn:task id="decide" name="Decide on the specifications" />
    <bpmn:task id="receive" name="Receive the specifications" />
    <bpmn:task id="send" name="Send the requirements to the teams" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="bar" name="Manufacture the bar" />
    <bpmn:task id="seats" name="Manufacture the seats" />
    <bpmn:task id="toilet" name="Manufacture the toilet equipment" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="assemble" name="Assemble the interior" />
    <bpmn:task id="fly" name="Perform the test flight" />
    <bpmn:task id="protocol" name="Create the test protocol" />
    <bpmn:task id="sendprot" name="Send the test protocol to the customer" />
    <bpmn:task id="deliver" name="Deliver the plane" />
    <bpmn:task id="confirm" name="Confirm the delivery" />
    <bpmn:endEvent id="end" name="Plane delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="decide" />
    <bpmn:sequenceFlow id="f2" sourceRef="decide" targetRef="receive" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive" targetRef="send" />
    <bpmn:sequenceFlow id="f4" sourceRef="send" targetRef="split" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="bar" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="seats" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="toilet" />
    <bpmn:sequenceFlow id="f8" sourceRef="bar" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="seats" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="toilet" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f12" sourceRef="assemble" targetRef="fly" />
    <bpmn:sequenceFlow id="f13" sourceRef="fly" targetRef="protocol" />
    <bpmn:sequenceFlow id="f14" sourceRef="protocol" targetRef="sendprot" />
    <bpmn:sequenceFlow id="f15" sourceRef="sendprot" targetRef="deliver" />
    <bpmn:sequenceFlow id="f16" sourceRef="deliver" targetRef="confirm" />
    <bpmn:sequenceFlow id="f17" sourceRef="confirm" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
