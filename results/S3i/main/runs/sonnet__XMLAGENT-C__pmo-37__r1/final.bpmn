<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Contract project" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE" name="Project owner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cheap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Parts needed for contract project" />
    <bpmn:task id="query" name="Query all web shops for quantity, price and delivery time" />
    <bpmn:task id="list" name="Create list of parts to order from each shop" />
    <bpmn:task id="order" name="Order the cheapest parts from one or several shops" />
    <bpmn:intermediateCatchEvent id="arrive" name="First parts arrive">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="build" name="Start building" />
    <bpmn:task id="check" name="Check stock of each part" />
    <bpmn:exclusiveGateway id="g5" name="Stock below 5?" />
    <bpmn:task id="cheap" name="Reorder the cheapest parts" />
    <bpmn:exclusiveGateway id="g3" name="Stock below 3?" />
    <bpmn:task id="fast" name="Reorder the fastest parts" />
    <bpmn:exclusiveGateway id="g0" name="Stock zero?" />
    <bpmn:task id="mail" name="Write mail to friends complaining about the webshops" />
    <bpmn:endEvent id="end1" name="Stock sufficient" />
    <bpmn:endEvent id="end2" name="Cheapest parts reordered" />
    <bpmn:endEvent id="end3" name="Fastest parts reordered" />
    <bpmn:endEvent id="end4" name="Complaint sent" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="query" />
    <bpmn:sequenceFlow id="f2" sourceRef="query" targetRef="list" />
    <bpmn:sequenceFlow id="f3" sourceRef="list" targetRef="order" />
    <bpmn:sequenceFlow id="f4" sourceRef="order" targetRef="arrive" />
    <bpmn:sequenceFlow id="f5" sourceRef="arrive" targetRef="build" />
    <bpmn:sequenceFlow id="f6" sourceRef="build" targetRef="check" />
    <bpmn:sequenceFlow id="f7" sourceRef="check" targetRef="g5" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="g5" targetRef="end1" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="g5" targetRef="cheap" />
    <bpmn:sequenceFlow id="f10" sourceRef="cheap" targetRef="g3" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="g3" targetRef="end2" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="g3" targetRef="fast" />
    <bpmn:sequenceFlow id="f13" sourceRef="fast" targetRef="g0" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="g0" targetRef="end3" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="g0" targetRef="mail" />
    <bpmn:sequenceFlow id="f16" sourceRef="mail" targetRef="end4" />
  </bpmn:process>
</bpmn:definitions>
