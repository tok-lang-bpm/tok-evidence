<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Tree house project" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="you" name="Builder">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snacks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="arch" name="Architect">
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store" name="Online store">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Tree house wanted" />
    <bpmn:task id="collect" name="Collect the requirements" />
    <bpmn:task id="sendreq" name="Send the requirements to the architect" />
    <bpmn:task id="draft" name="Send the draft back" />
    <bpmn:task id="refine" name="Refine the draft with additional requirements" />
    <bpmn:exclusiveGateway id="more" name="Further refinement needed?" />
    <bpmn:task id="list" name="Create the list of needed materials" />
    <bpmn:task id="order" name="Order the materials from online stores" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:task id="msg" name="Send messages to friends to build the house" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="build" name="Build the tree house" />
    <bpmn:task id="invite" name="Send invitations for the tree house party" />
    <bpmn:task id="attendees" name="Create the list of people that attend the party" />
    <bpmn:task id="snacks" name="Buy the snacks" />
    <bpmn:endEvent id="e" name="Party prepared" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendreq" targetRef="draft" />
    <bpmn:sequenceFlow id="f4" sourceRef="draft" targetRef="refine" />
    <bpmn:sequenceFlow id="f5" sourceRef="refine" targetRef="more" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="more" targetRef="draft" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="more" targetRef="list" />
    <bpmn:sequenceFlow id="f8" sourceRef="list" targetRef="order" />
    <bpmn:sequenceFlow id="f9" sourceRef="order" targetRef="split" />
    <bpmn:sequenceFlow id="f10" sourceRef="split" targetRef="process" />
    <bpmn:sequenceFlow id="f11" sourceRef="split" targetRef="msg" />
    <bpmn:sequenceFlow id="f12" sourceRef="process" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="msg" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="join" targetRef="build" />
    <bpmn:sequenceFlow id="f15" sourceRef="build" targetRef="invite" />
    <bpmn:sequenceFlow id="f16" sourceRef="invite" targetRef="attendees" />
    <bpmn:sequenceFlow id="f17" sourceRef="attendees" targetRef="snacks" />
    <bpmn:sequenceFlow id="f18" sourceRef="snacks" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>