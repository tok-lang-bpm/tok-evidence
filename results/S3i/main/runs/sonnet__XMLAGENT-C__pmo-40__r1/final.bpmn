<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L1" name="OEE system">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>restarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>disc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Measuring started" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="collect" name="Collect relevant information from the machine" />
    <bpmn:task id="calc" name="Calculate the OEE" />
    <bpmn:exclusiveGateway id="low" name="OEE below the value?" />
    <bpmn:task id="stop" name="Stop the machine" />
    <bpmn:task id="email" name="Send an email to the engineer" />
    <bpmn:intermediateCatchEvent id="restarted" name="Machine restarted">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="disc" name="Machine disconnected?" />
    <bpmn:endEvent id="end" name="Process stopped" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="merge" />
    <bpmn:sequenceFlow id="f2" sourceRef="merge" targetRef="collect" />
    <bpmn:sequenceFlow id="f3" sourceRef="collect" targetRef="calc" />
    <bpmn:sequenceFlow id="f4" sourceRef="calc" targetRef="low" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="low" targetRef="stop" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="low" targetRef="disc" />
    <bpmn:sequenceFlow id="f7" sourceRef="stop" targetRef="email" />
    <bpmn:sequenceFlow id="f8" sourceRef="email" targetRef="restarted" />
    <bpmn:sequenceFlow id="f9" sourceRef="restarted" targetRef="merge" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="disc" targetRef="end" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="disc" targetRef="merge" />
  </bpmn:process>
</bpmn:definitions>
