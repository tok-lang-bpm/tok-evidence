<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Machine inspection" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="inspector" name="Inspector">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>press</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="app" name="Application">
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Inspection needed" />
    <bpmn:task id="enter" name="Enter the machine type and serial number" />
    <bpmn:task id="ask" name="Ask questions" />
    <bpmn:task id="input" name="Input values" />
    <bpmn:task id="press" name="Press buttons" />
    <bpmn:task id="collect" name="Collect values from the machine" />
    <bpmn:task id="show" name="Show values" />
    <bpmn:exclusiveGateway id="more" name="Additional questions needed?" />
    <bpmn:endEvent id="end" name="Inspection finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="enter" />
    <bpmn:sequenceFlow id="f2" sourceRef="enter" targetRef="ask" />
    <bpmn:sequenceFlow id="f3" sourceRef="ask" targetRef="input" />
    <bpmn:sequenceFlow id="f4" sourceRef="input" targetRef="press" />
    <bpmn:sequenceFlow id="f5" sourceRef="press" targetRef="collect" />
    <bpmn:sequenceFlow id="f6" sourceRef="collect" targetRef="show" />
    <bpmn:sequenceFlow id="f7" sourceRef="show" targetRef="more" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="more" targetRef="ask" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="more" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
