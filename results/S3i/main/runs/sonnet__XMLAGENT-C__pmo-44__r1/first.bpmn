<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Robotic Burger Seller" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="robot" name="Robot">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askSide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sideMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>burger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer wants to order" />
    <bpmn:task id="receive" name="Receive the order" />
    <bpmn:task id="askMenu" name="Ask whether the customer wants a menu or just the burger" />
    <bpmn:exclusiveGateway id="isMenu" name="Menu or just the burger?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="drink" name="Prepare the drink" />
    <bpmn:task id="askSide" name="Ask whether the customer wants fries or wedges" />
    <bpmn:exclusiveGateway id="side" name="Fries or wedges?" />
    <bpmn:task id="fries" name="Prepare the fries" />
    <bpmn:task id="wedges" name="Prepare the wedges" />
    <bpmn:exclusiveGateway id="sideMerge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="burger" name="Prepare the burger" />
    <bpmn:boundaryEvent id="timer" name="Every 30 seconds" attachedToRef="burger" cancelActivity="false">
      <bpmn:timerEventDefinition><bpmn:timeCycle>R/PT30S</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="update" name="Give an enthusiastic status update" />
    <bpmn:endEvent id="updated" name="Status update given" />
    <bpmn:task id="deliver" name="Deliver the order via the conveyor belt" />
    <bpmn:endEvent id="end" name="Order delivered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="askMenu" />
    <bpmn:sequenceFlow id="f3" sourceRef="askMenu" targetRef="isMenu" />
    <bpmn:sequenceFlow id="f4" name="menu" sourceRef="isMenu" targetRef="split" />
    <bpmn:sequenceFlow id="f5" name="just the burger" sourceRef="isMenu" targetRef="merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="askSide" />
    <bpmn:sequenceFlow id="f8" sourceRef="askSide" targetRef="side" />
    <bpmn:sequenceFlow id="f9" name="fries" sourceRef="side" targetRef="fries" />
    <bpmn:sequenceFlow id="f10" name="wedges" sourceRef="side" targetRef="wedges" />
    <bpmn:sequenceFlow id="f11" sourceRef="fries" targetRef="sideMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="wedges" targetRef="sideMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="sideMerge" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f15" sourceRef="join" targetRef="merge" />
    <bpmn:sequenceFlow id="f16" sourceRef="merge" targetRef="burger" />
    <bpmn:sequenceFlow id="f17" sourceRef="timer" targetRef="update" />
    <bpmn:sequenceFlow id="f18" sourceRef="update" targetRef="updated" />
    <bpmn:sequenceFlow id="f19" sourceRef="burger" targetRef="deliver" />
    <bpmn:sequenceFlow id="f20" sourceRef="deliver" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>