<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Online Shop" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paydata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipaddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billaddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billmerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="E-Shop System">
        <bpmn:flowNodeRef>creds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loginok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>loopm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bank" name="Bank">
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer wants to order" />
    <bpmn:task id="login" name="Log into the E-Shop system" />
    <bpmn:task id="creds" name="Check the credentials" />
    <bpmn:exclusiveGateway id="loginok" name="Login successful?" />
    <bpmn:endEvent id="stopped" name="Shopping stopped" />
    <bpmn:exclusiveGateway id="loopm" />
    <bpmn:task id="select" name="Select a product" />
    <bpmn:task id="add" name="Add the product to the shopping cart" />
    <bpmn:task id="save" name="Save the product" />
    <bpmn:task id="checkall" name="Check if every product was selected" />
    <bpmn:exclusiveGateway id="allgw" name="Every product selected?" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="finish" name="Finish the order" />
    <bpmn:task id="paydata" name="Enter the payment data" />
    <bpmn:task id="confirm" name="Confirm the payment" />
    <bpmn:task id="shipaddr" name="Enter the shipping address" />
    <bpmn:exclusiveGateway id="billgw" name="Billing address different?" />
    <bpmn:task id="billaddr" name="Enter the billing address" />
    <bpmn:exclusiveGateway id="billmerge" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="complete" name="Complete the order" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="login" />
    <bpmn:sequenceFlow id="f2" sourceRef="login" targetRef="creds" />
    <bpmn:sequenceFlow id="f3" sourceRef="creds" targetRef="loginok" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="loginok" targetRef="stopped" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="loginok" targetRef="loopm" />
    <bpmn:sequenceFlow id="f6" sourceRef="loopm" targetRef="select" />
    <bpmn:sequenceFlow id="f7" sourceRef="select" targetRef="add" />
    <bpmn:sequenceFlow id="f8" sourceRef="add" targetRef="save" />
    <bpmn:sequenceFlow id="f9" sourceRef="save" targetRef="checkall" />
    <bpmn:sequenceFlow id="f10" sourceRef="checkall" targetRef="allgw" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="allgw" targetRef="loopm" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="allgw" targetRef="split" />
    <bpmn:sequenceFlow id="f13" sourceRef="split" targetRef="finish" />
    <bpmn:sequenceFlow id="f14" sourceRef="split" targetRef="paydata" />
    <bpmn:sequenceFlow id="f15" sourceRef="split" targetRef="shipaddr" />
    <bpmn:sequenceFlow id="f16" sourceRef="paydata" targetRef="confirm" />
    <bpmn:sequenceFlow id="f17" sourceRef="shipaddr" targetRef="billgw" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="billgw" targetRef="billaddr" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="billgw" targetRef="billmerge" />
    <bpmn:sequenceFlow id="f20" sourceRef="billaddr" targetRef="billmerge" />
    <bpmn:sequenceFlow id="f21" sourceRef="finish" targetRef="join" />
    <bpmn:sequenceFlow id="f22" sourceRef="confirm" targetRef="join" />
    <bpmn:sequenceFlow id="f23" sourceRef="billmerge" targetRef="join" />
    <bpmn:sequenceFlow id="f24" sourceRef="join" targetRef="complete" />
    <bpmn:sequenceFlow id="f25" sourceRef="complete" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>