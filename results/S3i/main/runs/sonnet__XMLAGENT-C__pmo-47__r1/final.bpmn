<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Sports institute" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="USER" name="User">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkUni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>none</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SYSTEM" name="System">
        <bpmn:flowNodeRef>slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Course wanted" />
    <bpmn:exclusiveGateway id="slots" name="Slots free?" />
    <bpmn:task id="tell" name="Tell the courses and dates" />
    <bpmn:task id="select" name="Select a course" />
    <bpmn:task id="checkAcc" name="Check if you have an account" />
    <bpmn:exclusiveGateway id="hasAcc" name="Account exists?" />
    <bpmn:task id="checkUni" name="Check whether you are registered at an eligible university" />
    <bpmn:exclusiveGateway id="eligible" name="Registered at an eligible university?" />
    <bpmn:task id="register" name="Register your account" />
    <bpmn:task id="request" name="Request an activation" />
    <bpmn:task id="wait" name="Wait for a response" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="login" name="Log into the account" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="tweet" name="Tweet to friends" />
    <bpmn:task id="complete" name="Complete the registration and provide the payment information" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="ticket" name="Send the course ticket" />
    <bpmn:endEvent id="done" name="Course ticket received" />
    <bpmn:endEvent id="none" name="No slots free" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="slots" />
    <bpmn:sequenceFlow id="f2" name="yes" sourceRef="slots" targetRef="tell" />
    <bpmn:sequenceFlow id="f3" name="no" sourceRef="slots" targetRef="none" />
    <bpmn:sequenceFlow id="f4" sourceRef="tell" targetRef="select" />
    <bpmn:sequenceFlow id="f5" sourceRef="select" targetRef="checkAcc" />
    <bpmn:sequenceFlow id="f6" sourceRef="checkAcc" targetRef="hasAcc" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="hasAcc" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="hasAcc" targetRef="checkUni" />
    <bpmn:sequenceFlow id="f9" sourceRef="checkUni" targetRef="eligible" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="eligible" targetRef="register" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="eligible" targetRef="request" />
    <bpmn:sequenceFlow id="f12" sourceRef="request" targetRef="wait" />
    <bpmn:sequenceFlow id="f13" sourceRef="register" targetRef="merge" />
    <bpmn:sequenceFlow id="f14" sourceRef="wait" targetRef="merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="merge" targetRef="login" />
    <bpmn:sequenceFlow id="f16" sourceRef="login" targetRef="split" />
    <bpmn:sequenceFlow id="f17" sourceRef="split" targetRef="tweet" />
    <bpmn:sequenceFlow id="f18" sourceRef="split" targetRef="complete" />
    <bpmn:sequenceFlow id="f19" sourceRef="tweet" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="complete" targetRef="join" />
    <bpmn:sequenceFlow id="f21" sourceRef="join" targetRef="ticket" />
    <bpmn:sequenceFlow id="f22" sourceRef="ticket" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
