<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Vienna Night Run" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="runner" name="Runner">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>findout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gadget" name="Fitness gadget">
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Wish to participate" />
    <bpmn:task id="block" name="Select a starting block" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:task id="run5" name="Run 5km" />
    <bpmn:task id="measure" name="Measure the time" />
    <bpmn:exclusiveGateway id="fast" name="Less than 25 minutes?" />
    <bpmn:task id="train" name="Train and check" />
    <bpmn:task id="number" name="Get the starting number" />
    <bpmn:task id="findout" name="Find out when the work day ends" />
    <bpmn:exclusiveGateway id="hour" name="More than one hour left?" />
    <bpmn:task id="home" name="Go to the Night Run from home" />
    <bpmn:task id="work" name="Leave directly from work" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="run" name="Run at the Night Run" />
    <bpmn:task id="drink" name="Drink" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="receive" name="Receive the final running time" />
    <bpmn:endEvent id="end" name="Night Run finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="block" />
    <bpmn:sequenceFlow id="f2" sourceRef="block" targetRef="merge1" />
    <bpmn:sequenceFlow id="f3" sourceRef="merge1" targetRef="run5" />
    <bpmn:sequenceFlow id="f4" sourceRef="run5" targetRef="measure" />
    <bpmn:sequenceFlow id="f5" sourceRef="measure" targetRef="fast" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="fast" targetRef="train" />
    <bpmn:sequenceFlow id="f7" sourceRef="train" targetRef="merge1" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="fast" targetRef="number" />
    <bpmn:sequenceFlow id="f9" sourceRef="number" targetRef="findout" />
    <bpmn:sequenceFlow id="f10" sourceRef="findout" targetRef="hour" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="hour" targetRef="home" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="hour" targetRef="work" />
    <bpmn:sequenceFlow id="f13" sourceRef="home" targetRef="merge2" />
    <bpmn:sequenceFlow id="f14" sourceRef="work" targetRef="merge2" />
    <bpmn:sequenceFlow id="f15" sourceRef="merge2" targetRef="split" />
    <bpmn:sequenceFlow id="f16" sourceRef="split" targetRef="run" />
    <bpmn:sequenceFlow id="f17" sourceRef="split" targetRef="drink" />
    <bpmn:sequenceFlow id="f18" sourceRef="run" targetRef="join" />
    <bpmn:sequenceFlow id="f19" sourceRef="drink" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="join" targetRef="receive" />
    <bpmn:sequenceFlow id="f21" sourceRef="receive" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
