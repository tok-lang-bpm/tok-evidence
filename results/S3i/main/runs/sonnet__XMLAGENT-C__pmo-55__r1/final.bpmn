<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Hospital" processRef="P" />
  </bpmn:collaboration>
  <bpmn:process id="P" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L1" name="Doctor">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Procedure started" />
    <bpmn:task id="t1" name="Prepare the implements" />
    <bpmn:task id="t2" name="Wash the hands" />
    <bpmn:task id="t3" name="Put on sterile clothes" />
    <bpmn:task id="t4" name="Clean the puncture area" />
    <bpmn:task id="t5" name="Drape the puncture zone" />
    <bpmn:task id="t6" name="Configure the ultrasound" />
    <bpmn:task id="t7" name="Put gel in the probe" />
    <bpmn:task id="t8" name="Cover the probe" />
    <bpmn:task id="t9" name="Put the sterile gel" />
    <bpmn:task id="t10" name="Position the probe" />
    <bpmn:task id="t11" name="Position the patient" />
    <bpmn:exclusiveGateway id="g1" name="Identification method?" />
    <bpmn:task id="v1" name="Identify the vein using an anatomic identification" />
    <bpmn:task id="v2" name="Identify the vein using a doppler identification" />
    <bpmn:task id="v3" name="Identify the vein using a compression identification" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="t12" name="Anesthetize the patient" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="t13" name="Puncture the patient" />
    <bpmn:task id="t14" name="Check the blood return" />
    <bpmn:exclusiveGateway id="g3" name="Blood return correct?" />
    <bpmn:task id="t15" name="Drop the probe" />
    <bpmn:task id="t16" name="Remove the syringe" />
    <bpmn:task id="t17" name="Install the guidewire" />
    <bpmn:task id="t18" name="Remove the trocar" />
    <bpmn:exclusiveGateway id="g4" name="Check method?" />
    <bpmn:task id="w1" name="Check the wire in the long axis" />
    <bpmn:task id="w2" name="Check the wire in the short axis" />
    <bpmn:exclusiveGateway id="g5" />
    <bpmn:task id="t19" name="Check if the wire is in good position" />
    <bpmn:exclusiveGateway id="g6" name="Wire in good position?" />
    <bpmn:task id="t20" name="Widen the pathway" />
    <bpmn:task id="t21" name="Advance the catheter" />
    <bpmn:task id="t22" name="Remove the guidewire" />
    <bpmn:task id="t23" name="Verify the flow and the reflow" />
    <bpmn:task id="t24" name="Check the catheter position" />
    <bpmn:endEvent id="e" name="Procedure completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f12" sourceRef="t11" targetRef="g1" />
    <bpmn:sequenceFlow id="f13" name="anatomic" sourceRef="g1" targetRef="v1" />
    <bpmn:sequenceFlow id="f14" name="doppler" sourceRef="g1" targetRef="v2" />
    <bpmn:sequenceFlow id="f15" name="compression" sourceRef="g1" targetRef="v3" />
    <bpmn:sequenceFlow id="f16" sourceRef="v1" targetRef="g2" />
    <bpmn:sequenceFlow id="f17" sourceRef="v2" targetRef="g2" />
    <bpmn:sequenceFlow id="f18" sourceRef="v3" targetRef="g2" />
    <bpmn:sequenceFlow id="f19" sourceRef="g2" targetRef="t12" />
    <bpmn:sequenceFlow id="f20" sourceRef="t12" targetRef="m1" />
    <bpmn:sequenceFlow id="f21" sourceRef="m1" targetRef="t13" />
    <bpmn:sequenceFlow id="f22" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f23" sourceRef="t14" targetRef="g3" />
    <bpmn:sequenceFlow id="f24" name="no" sourceRef="g3" targetRef="m1" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="g3" targetRef="t15" />
    <bpmn:sequenceFlow id="f26" sourceRef="t15" targetRef="t16" />
    <bpmn:sequenceFlow id="f27" sourceRef="t16" targetRef="t17" />
    <bpmn:sequenceFlow id="f28" sourceRef="t17" targetRef="t18" />
    <bpmn:sequenceFlow id="f29" sourceRef="t18" targetRef="g4" />
    <bpmn:sequenceFlow id="f30" name="long axis" sourceRef="g4" targetRef="w1" />
    <bpmn:sequenceFlow id="f31" name="short axis" sourceRef="g4" targetRef="w2" />
    <bpmn:sequenceFlow id="f32" sourceRef="w1" targetRef="g5" />
    <bpmn:sequenceFlow id="f33" sourceRef="w2" targetRef="g5" />
    <bpmn:sequenceFlow id="f34" sourceRef="g5" targetRef="t19" />
    <bpmn:sequenceFlow id="f35" sourceRef="t19" targetRef="g6" />
    <bpmn:sequenceFlow id="f36" name="no" sourceRef="g6" targetRef="m1" />
    <bpmn:sequenceFlow id="f37" name="yes" sourceRef="g6" targetRef="t20" />
    <bpmn:sequenceFlow id="f38" sourceRef="t20" targetRef="t21" />
    <bpmn:sequenceFlow id="f39" sourceRef="t21" targetRef="t22" />
    <bpmn:sequenceFlow id="f40" sourceRef="t22" targetRef="t23" />
    <bpmn:sequenceFlow id="f41" sourceRef="t23" targetRef="t24" />
    <bpmn:sequenceFlow id="f42" sourceRef="t24" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
