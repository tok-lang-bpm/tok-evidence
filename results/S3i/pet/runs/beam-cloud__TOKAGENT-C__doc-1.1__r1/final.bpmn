<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customized bicycles" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Customized bicycles" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>item_processed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Order received" />
    <bpmn:exclusiveGateway id="accept" name="Accept order?" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:parallelGateway id="parallel" name="Inform departments" />
    <bpmn:task id="ship" name="Ship the bicycle" />
    <bpmn:endEvent id="finished" name="Process finished" />
    <bpmn:task id="process" name="Process the part list" />
    <bpmn:exclusiveGateway id="available" name="Part available in-house?" />
    <bpmn:task id="reserve" name="Reserve the part" />
    <bpmn:task id="backorder" name="Back-order the part" />
    <bpmn:exclusiveGateway id="item_processed" name="Item processed" />
    <bpmn:exclusiveGateway id="more" name="More items on part list?" />
    <bpmn:task id="prepare" name="Prepare everything for assembling" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:parallelGateway id="parallel_join" name="All items processed" />
    <bpmn:sequenceFlow id="f-received-accept" sourceRef="received" targetRef="accept" />
    <bpmn:sequenceFlow id="f-accept-rejected" name="reject" sourceRef="accept" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-parallel" name="accept" sourceRef="accept" targetRef="parallel" />
    <bpmn:sequenceFlow id="f-parallel-process" sourceRef="parallel" targetRef="process" />
    <bpmn:sequenceFlow id="f-parallel-prepare" sourceRef="parallel" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-process-available" sourceRef="process" targetRef="available" />
    <bpmn:sequenceFlow id="f-available-reserve" name="yes" sourceRef="available" targetRef="reserve" />
    <bpmn:sequenceFlow id="f-available-backorder" name="no" sourceRef="available" targetRef="backorder" />
    <bpmn:sequenceFlow id="f-reserve-item_processed" sourceRef="reserve" targetRef="item_processed" />
    <bpmn:sequenceFlow id="f-backorder-item_processed" sourceRef="backorder" targetRef="item_processed" />
    <bpmn:sequenceFlow id="f-item_processed-more" sourceRef="item_processed" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-process" name="yes" sourceRef="more" targetRef="process" />
    <bpmn:sequenceFlow id="f-more-parallel_join" name="no" sourceRef="more" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-prepare-parallel_join" sourceRef="prepare" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-parallel_join-assemble" sourceRef="parallel_join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-finished" sourceRef="ship" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
