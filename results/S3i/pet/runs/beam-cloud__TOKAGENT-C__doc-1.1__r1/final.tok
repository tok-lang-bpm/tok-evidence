tok 1.0 "Customized bicycles"

pool company "Company"
  lane sales "Sales department"
    start received "Order received"
    xor accept "Accept order?"
    end rejected "Order rejected"
    and parallel "Inform departments"
    task ship "Ship the bicycle"
    end finished "Process finished"
  lane storehouse "Storehouse"
    task process "Process the part list"
    xor available "Part available in-house?"
    task reserve "Reserve the part"
    task backorder "Back-order the part"
    xor item_processed "Item processed"
    xor more "More items on part list?"
  lane engineering "Engineering department"
    task prepare "Prepare everything for assembling"
    task assemble "Assemble the bicycle"
    and parallel_join "All items processed"

flow received -> accept
flow accept -> rejected "reject"
flow accept -> parallel "accept"

flow parallel -> process
flow parallel -> prepare

flow process -> available
flow available -> reserve "yes"
flow available -> backorder "no"
flow reserve -> item_processed
flow backorder -> item_processed

flow item_processed -> more
flow more -> process "yes"
flow more -> parallel_join "no"

flow prepare -> parallel_join
flow parallel_join -> assemble
flow assemble -> ship
flow ship -> finished
