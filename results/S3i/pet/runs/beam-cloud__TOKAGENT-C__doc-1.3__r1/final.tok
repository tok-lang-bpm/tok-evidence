tok 1.0 "Room Service at The Evanstonian"

pool hotel "The Evanstonian"
  lane manager "Room-Service Manager"
    start call "Guest calls room service"
    task take "Take down the order"
    task submit "Submit order ticket to kitchen"
    task assign "Assign order to waiter"
    or split "Order includes wine or alcoholic beverage?"
    task give "Give order to sommelier"
    or join "Work complete?"
  lane kitchen "Kitchen"
    task prepare "Prepare food"
  lane sommelier "Sommelier"
    task fetch "Fetch wine and prepare alcoholic beverages"
  lane waiter "Waiter"
    task cart "Ready a cart"
    task drinks "Prepare nonalcoholic drinks"
    task deliver "Deliver order to guest's room"
    task debit "Debit guest's account"
    end done "Order completed"

flow call -> take -> submit -> assign -> split
flow split -> give "yes" when="wine" p=0.8
flow split -> prepare when="true"
flow split -> cart when="true"
flow split -> join default
flow give -> fetch
flow fetch -> join
flow prepare -> join
flow cart -> drinks
flow drinks -> join
flow join -> deliver -> debit -> done
