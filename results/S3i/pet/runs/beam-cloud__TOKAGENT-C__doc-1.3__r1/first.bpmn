<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room Service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room Service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="call" name="Guest calls room service" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:task id="submit" name="Submit order ticket to kitchen" />
    <bpmn:task id="give" name="Give order to sommelier" />
    <bpmn:task id="assign" name="Assign order to waiter" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="prepare" name="Prepare food" />
    <bpmn:task id="wine" name="Fetch wine and prepare alcoholic beverages" />
    <bpmn:task id="cart" name="Ready a cart" />
    <bpmn:task id="drinks" name="Prepare nonalcoholic drinks" />
    <bpmn:task id="deliver" name="Deliver order to guest's room" />
    <bpmn:task id="debit" name="Debit guest's account" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:sequenceFlow id="f-call-take" sourceRef="call" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-submit" sourceRef="take" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-give" sourceRef="submit" targetRef="give" />
    <bpmn:sequenceFlow id="f-give-assign" sourceRef="give" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-split" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-prepare" sourceRef="split" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-split-wine" sourceRef="split" targetRef="wine" />
    <bpmn:sequenceFlow id="f-split-cart" sourceRef="split" targetRef="cart" />
    <bpmn:sequenceFlow id="f-cart-drinks" sourceRef="cart" targetRef="drinks" />
    <bpmn:sequenceFlow id="f-prepare-join" sourceRef="prepare" targetRef="join" />
    <bpmn:sequenceFlow id="f-wine-join" sourceRef="wine" targetRef="join" />
    <bpmn:sequenceFlow id="f-drinks-join" sourceRef="drinks" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-deliver" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-debit" sourceRef="deliver" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-done" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
