<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Going public" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>facts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>road</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notHandled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decided" name="Decision to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:exclusiveGateway id="facts" name="Facts presented fairly?" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare a registration statement" />
    <bpmn:parallelGateway id="parallel1" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="blue" name="Check compliance with blue-sky laws" />
    <bpmn:parallelGateway id="joined1" />
    <bpmn:parallelGateway id="parallel2" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="road" name="Arrange a road show" />
    <bpmn:parallelGateway id="joined2" />
    <bpmn:task id="receive" name="Receive clearance from the SEC" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to proceed?" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="offer" name="Offer it to the public" />
    <bpmn:endEvent id="offered" name="Issue offered to the public" />
    <bpmn:endEvent id="cancelled" name="Offering cancelled" />
    <bpmn:endEvent id="notHandled" name="Issue not handled" />
    <bpmn:sequenceFlow id="f-decided-select" sourceRef="decided" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-facts" sourceRef="select" targetRef="facts" />
    <bpmn:sequenceFlow id="f-facts-advise" name="yes" sourceRef="facts" targetRef="advise" />
    <bpmn:sequenceFlow id="f-facts-notHandled" name="no" sourceRef="facts" targetRef="notHandled" />
    <bpmn:sequenceFlow id="f-advise-prepare" sourceRef="advise" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-parallel1" sourceRef="prepare" targetRef="parallel1" />
    <bpmn:sequenceFlow id="f-parallel1-register" sourceRef="parallel1" targetRef="register" />
    <bpmn:sequenceFlow id="f-parallel1-blue" sourceRef="parallel1" targetRef="blue" />
    <bpmn:sequenceFlow id="f-register-joined1" sourceRef="register" targetRef="joined1" />
    <bpmn:sequenceFlow id="f-blue-joined1" sourceRef="blue" targetRef="joined1" />
    <bpmn:sequenceFlow id="f-joined1-parallel2" sourceRef="joined1" targetRef="parallel2" />
    <bpmn:sequenceFlow id="f-parallel2-firm" sourceRef="parallel2" targetRef="firm" />
    <bpmn:sequenceFlow id="f-parallel2-road" sourceRef="parallel2" targetRef="road" />
    <bpmn:sequenceFlow id="f-firm-joined2" sourceRef="firm" targetRef="joined2" />
    <bpmn:sequenceFlow id="f-road-joined2" sourceRef="road" targetRef="joined2" />
    <bpmn:sequenceFlow id="f-joined2-receive" sourceRef="joined2" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-fix" sourceRef="receive" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-reason" sourceRef="fix" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-commit" name="no" sourceRef="reason" targetRef="commit" />
    <bpmn:sequenceFlow id="f-reason-cancelled" name="yes" sourceRef="reason" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-commit-offer" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-offered" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
