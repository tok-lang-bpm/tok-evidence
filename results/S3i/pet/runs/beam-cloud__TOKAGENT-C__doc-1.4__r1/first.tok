tok 1.0 "Going public"

pool organisation "Organisation"
  lane company "Company"
    start decided "Decision to go public"
    task select "Select the underwriters"
    xor facts "Facts presented fairly?"
  lane underwriters "Underwriters"
    task advise "Provide procedural and financial advice"
    task prepare "Prepare a registration statement"
    and parallel1
    task register "Register the issue with the SEC"
    task blue "Check compliance with blue-sky laws"
    and joined1
    and parallel2
    task firm "Firm up the issue price"
    task road "Arrange a road show"
    and joined2
    task receive "Receive clearance from the SEC"
    task fix "Fix the issue price"
    xor reason "Reason not to proceed?"
    task commit "Enter into a firm commitment to buy the stock"
    task offer "Offer it to the public"
    end offered "Issue offered to the public"
    end cancelled "Offering cancelled"
    end notHandled "Issue not handled"

flow decided -> select -> facts
flow facts -> advise "yes"
flow facts -> notHandled "no" default
flow advise -> prepare -> parallel1
flow parallel1 -> register
flow parallel1 -> blue
flow register -> joined1
flow blue -> joined1
flow joined1 -> parallel2
flow parallel2 -> firm
flow parallel2 -> road
flow firm -> joined2
flow road -> joined2
flow joined2 -> receive -> fix -> reason
flow reason -> commit "no" default
flow reason -> cancelled "yes"
flow commit -> offer -> offered
