<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Failure handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Failure handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="fault_detector" name="Fault detector">
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_msp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_go_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_msp_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="report" name="Report the failure to the MPO" />
    <bpmn:startEvent id="failure" name="Failure reported or suspected" />
    <bpmn:exclusiveGateway id="trigger" name="Failure source?" />
    <bpmn:task id="suspect" name="Have a suspicion of own fault" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="decide" name="Failure of fault detector?" />
    <bpmn:task id="reject" name="Reject the failure of the fault detector" />
    <bpmn:task id="confirm" name="Confirm the failure of the fault detector" />
    <bpmn:parallelGateway id="notify" />
    <bpmn:task id="inform_go" name="Inform the GO" />
    <bpmn:task id="inform_msp" name="Inform the MSP" />
    <bpmn:parallelGateway id="notified" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="share" name="Share the results of the repairs carried out with the fault detector" />
    <bpmn:task id="inform_go_resolution" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="inform_msp_resolution" name="Inform the MSP about the resolution of the interference" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:endEvent id="resolved" name="Interference resolved" />
    <bpmn:sequenceFlow id="f-failure-trigger" sourceRef="failure" targetRef="trigger" />
    <bpmn:sequenceFlow id="f-trigger-report" name="The fault detector reports a failure to the MPO" sourceRef="trigger" targetRef="report" />
    <bpmn:sequenceFlow id="f-trigger-suspect" name="The MPO has a suspicion of their own fault" sourceRef="trigger" targetRef="suspect" />
    <bpmn:sequenceFlow id="f-report-merged" sourceRef="report" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-examine" sourceRef="merged" targetRef="examine" />
    <bpmn:sequenceFlow id="f-suspect-merged" sourceRef="suspect" targetRef="merged" />
    <bpmn:sequenceFlow id="f-examine-decide" sourceRef="examine" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="The MPO rejects the failure of the fault detector" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="The MPO confirms the failure of the fault detector" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-notify" sourceRef="confirm" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-inform_go" sourceRef="notify" targetRef="inform_go" />
    <bpmn:sequenceFlow id="f-notify-inform_msp" sourceRef="notify" targetRef="inform_msp" />
    <bpmn:sequenceFlow id="f-inform_go-notified" sourceRef="inform_go" targetRef="notified" />
    <bpmn:sequenceFlow id="f-inform_msp-notified" sourceRef="inform_msp" targetRef="notified" />
    <bpmn:sequenceFlow id="f-notified-fix" sourceRef="notified" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-inform_go_resolution" sourceRef="share" targetRef="inform_go_resolution" />
    <bpmn:sequenceFlow id="f-inform_go_resolution-inform_msp_resolution" sourceRef="inform_go_resolution" targetRef="inform_msp_resolution" />
    <bpmn:sequenceFlow id="f-inform_msp_resolution-resolved" sourceRef="inform_msp_resolution" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
