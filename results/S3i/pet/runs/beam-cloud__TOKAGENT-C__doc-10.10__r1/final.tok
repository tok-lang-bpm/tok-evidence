tok 1.0 "Failure handling"

pool organisation "Organisation"
  lane fault_detector "Fault detector"
    task report "Report the failure to the MPO"
  lane mpo "MPO"
    start failure "Failure reported or suspected"
    xor trigger "Failure source?"
    task suspect "Have a suspicion of own fault"
    xor merged
    task examine "Examine the failure"
    xor decide "Failure of fault detector?"
    task reject "Reject the failure of the fault detector"
    task confirm "Confirm the failure of the fault detector"
    and notify
    task inform_go "Inform the GO"
    task inform_msp "Inform the MSP"
    and notified
    task fix "Fix the fault at the measuring device"
    task share "Share the results of the repairs carried out with the fault detector"
    task inform_go_resolution "Inform the GO about the resolution of the interference"
    task inform_msp_resolution "Inform the MSP about the resolution of the interference"
    end rejected "Failure rejected"
    end resolved "Interference resolved"

flow failure -> trigger
flow trigger -> report "The fault detector reports a failure to the MPO"
flow trigger -> suspect "The MPO has a suspicion of their own fault"
flow report -> merged
flow merged -> examine
flow suspect -> merged
flow examine -> decide
flow decide -> reject "The MPO rejects the failure of the fault detector"
flow decide -> confirm "The MPO confirms the failure of the fault detector"
flow reject -> rejected
flow confirm -> notify
flow notify -> inform_go
flow notify -> inform_msp
flow inform_go -> notified
flow inform_msp -> notified
flow notified -> fix
flow fix -> share
flow share -> inform_go_resolution
flow inform_go_resolution -> inform_msp_resolution
flow inform_msp_resolution -> resolved
