<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="GO, MSP and SP process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="GO, MSP and SP process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitReadings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFailure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="request" name="Request the measurements to the MSP" />
    <bpmn:task id="processValues" name="Process the measured values" />
    <bpmn:task id="sendChanged" name="Send the changed values to the MSP" />
    <bpmn:task id="transmitReadings" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="endSuccess" name="End" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="decision" name="Deny or perform?" />
    <bpmn:task id="deny" name="Deny the request of the GO" />
    <bpmn:task id="perform" name="Perform the measurement" />
    <bpmn:task id="inform" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="transmitValues" name="Transmit the measured values to the GO" />
    <bpmn:endEvent id="endFailure" name="End" />
    <bpmn:sequenceFlow id="f-start-request" sourceRef="start" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-check" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-decision" sourceRef="check" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-deny" name="deny" sourceRef="decision" targetRef="deny" />
    <bpmn:sequenceFlow id="f-decision-perform" name="perform" sourceRef="decision" targetRef="perform" />
    <bpmn:sequenceFlow id="f-deny-inform" sourceRef="deny" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-endFailure" sourceRef="inform" targetRef="endFailure" />
    <bpmn:sequenceFlow id="f-perform-transmitValues" sourceRef="perform" targetRef="transmitValues" />
    <bpmn:sequenceFlow id="f-transmitValues-processValues" sourceRef="transmitValues" targetRef="processValues" />
    <bpmn:sequenceFlow id="f-processValues-sendChanged" sourceRef="processValues" targetRef="sendChanged" />
    <bpmn:sequenceFlow id="f-sendChanged-transmitReadings" sourceRef="sendChanged" targetRef="transmitReadings" />
    <bpmn:sequenceFlow id="f-transmitReadings-endSuccess" sourceRef="transmitReadings" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>
