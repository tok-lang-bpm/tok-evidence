tok 1.0 "GO, MSP and SP process"

pool organisation "Organisation"
  lane go "GO"
    start start "Start"
    task request "Request the measurements to the MSP"
    task processValues "Process the measured values"
    task sendChanged "Send the changed values to the MSP"
    task transmitReadings "Transmit the readings to the SP"
    end endSuccess "End"
  lane msp "MSP"
    task check "Check the received request"
    xor decision "Deny or perform?"
    task deny "Deny the request of the GO"
    task perform "Perform the measurement"
    task inform "Inform the GO about the failure of the reading"
    task transmitValues "Transmit the measured values to the GO"
    end endFailure "End"

flow start -> request -> check -> decision
flow decision -> deny "deny"
flow decision -> perform "perform"
flow deny -> inform -> endFailure
flow perform -> transmitValues
flow transmitValues -> processValues
flow processValues -> sendChanged -> transmitReadings -> endSuccess
