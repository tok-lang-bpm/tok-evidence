tok 1.0 "INQ IP process"

pool org "Organisation"
  lane inq "INQ"
    start s "Start"
    task transmit "Transmit the transaction data request"
  lane ip "IP"
    task check "Check the request"
    xor outcome "Outcome of the examination?"
    end transmitted "Transmission of data"
    end rejected "Rejection"

flow s -> transmit -> check -> outcome
flow outcome -> transmitted "Transmission of data"
flow outcome -> rejected "Rejection"
