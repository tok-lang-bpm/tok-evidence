<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Billing process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Billing process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billtype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_temp_ops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recipient</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>send_temp_meas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_add_read</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_go_confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_go_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>examine_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_mpon_confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_mpon_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Process started" />
    <bpmn:exclusiveGateway id="billtype" name="Bill type?" />
    <bpmn:task id="send_temp_ops" name="Send the bill for the temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="send_equip" name="Send the bill for the equipment acquisition to the MPON or the GO" />
    <bpmn:exclusiveGateway id="recipient" name="Sent to MPON or GO?" />
    <bpmn:task id="send_temp_meas" name="Send the bill for the temporary continuation of the measurement to the GO" />
    <bpmn:task id="send_add_read" name="Send the bill for additional readings to the GO" />
    <bpmn:task id="examine_go" name="Examine the bill" />
    <bpmn:exclusiveGateway id="outcome_go" name="Confirm or reject?" />
    <bpmn:task id="confirm_go" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject_go" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:endEvent id="end_go_confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="end_go_rejected" name="Invoice rejected" />
    <bpmn:task id="examine_mpon" name="Examine the bill" />
    <bpmn:exclusiveGateway id="outcome_mpon" name="Confirm or reject?" />
    <bpmn:task id="confirm_mpon" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="reject_mpon" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:endEvent id="end_mpon_confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="end_mpon_rejected" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f-s-billtype" sourceRef="s" targetRef="billtype" />
    <bpmn:sequenceFlow id="f-billtype-send_temp_ops" name="MPOO temporary continuation" sourceRef="billtype" targetRef="send_temp_ops" />
    <bpmn:sequenceFlow id="f-billtype-send_temp_meas" name="MSPO temporary measurement" sourceRef="billtype" targetRef="send_temp_meas" />
    <bpmn:sequenceFlow id="f-billtype-send_add_read" name="MSPO additional readings" sourceRef="billtype" targetRef="send_add_read" />
    <bpmn:sequenceFlow id="f-billtype-send_equip" name="MPOO equipment acquisition" sourceRef="billtype" targetRef="send_equip" />
    <bpmn:sequenceFlow id="f-send_temp_ops-examine_go" sourceRef="send_temp_ops" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_temp_meas-examine_go" sourceRef="send_temp_meas" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_add_read-examine_go" sourceRef="send_add_read" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-send_equip-recipient" sourceRef="send_equip" targetRef="recipient" />
    <bpmn:sequenceFlow id="f-recipient-examine_mpon" name="to the MPON" sourceRef="recipient" targetRef="examine_mpon" />
    <bpmn:sequenceFlow id="f-recipient-examine_go" name="to the GO" sourceRef="recipient" targetRef="examine_go" />
    <bpmn:sequenceFlow id="f-examine_go-outcome_go" sourceRef="examine_go" targetRef="outcome_go" />
    <bpmn:sequenceFlow id="f-outcome_go-confirm_go" name="Confirm" sourceRef="outcome_go" targetRef="confirm_go" />
    <bpmn:sequenceFlow id="f-outcome_go-reject_go" name="Reject" sourceRef="outcome_go" targetRef="reject_go" />
    <bpmn:sequenceFlow id="f-confirm_go-end_go_confirmed" sourceRef="confirm_go" targetRef="end_go_confirmed" />
    <bpmn:sequenceFlow id="f-reject_go-end_go_rejected" sourceRef="reject_go" targetRef="end_go_rejected" />
    <bpmn:sequenceFlow id="f-examine_mpon-outcome_mpon" sourceRef="examine_mpon" targetRef="outcome_mpon" />
    <bpmn:sequenceFlow id="f-outcome_mpon-confirm_mpon" name="Confirm" sourceRef="outcome_mpon" targetRef="confirm_mpon" />
    <bpmn:sequenceFlow id="f-outcome_mpon-reject_mpon" name="Reject" sourceRef="outcome_mpon" targetRef="reject_mpon" />
    <bpmn:sequenceFlow id="f-confirm_mpon-end_mpon_confirmed" sourceRef="confirm_mpon" targetRef="end_mpon_confirmed" />
    <bpmn:sequenceFlow id="f-reject_mpon-end_mpon_rejected" sourceRef="reject_mpon" targetRef="end_mpon_rejected" />
  </bpmn:process>
</bpmn:definitions>
