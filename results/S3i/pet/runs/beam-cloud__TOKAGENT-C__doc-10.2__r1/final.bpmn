<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPON meter operation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="MPON meter operation" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performMp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpooreg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMspoReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpoofail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMspoFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpoosuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMspoSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSpSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcomeTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>performMpo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO" />
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Meter operation needed" />
    <bpmn:task id="report" name="Report the meter operation" />
    <bpmn:task id="performMp" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="informFailure" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="informSuccess" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:exclusiveGateway id="outcome" name="Entire process outcome?" />
    <bpmn:task id="examine" name="Examine the application" />
    <bpmn:exclusiveGateway id="application" name="Application rejected or confirmed?" />
    <bpmn:task id="reject" name="Reject the application" />
    <bpmn:task id="confirm" name="Confirm the application" />
    <bpmn:task id="informMpooreg" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="informMspoReg" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="equipStart" />
    <bpmn:parallelGateway id="equipDone" />
    <bpmn:task id="informTimeout" name="Inform the MPON about the failure of the overall transaction" />
    <bpmn:task id="confirmFailure" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confirmAssignment" name="Confirm the assignment to the MPON" />
    <bpmn:task id="informMpoofail" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="informMspoFail" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:task id="informMpoosuccess" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="informMspoSuccess" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="informSpSuccess" name="Inform the SP about the assignment of the MPON" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="outcomeFailure" name="Assignment failed" />
    <bpmn:endEvent id="outcomeSuccess" name="Assignment completed" />
    <bpmn:endEvent id="outcomeTimeout" name="Transaction failed by deadline" />
    <bpmn:task id="performMpo" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:sequenceFlow id="f-needed-report" sourceRef="needed" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-examine" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-application" sourceRef="examine" targetRef="application" />
    <bpmn:sequenceFlow id="f-application-reject" name="rejected" sourceRef="application" targetRef="reject" />
    <bpmn:sequenceFlow id="f-application-confirm" name="confirmed" sourceRef="application" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-informMpooreg" sourceRef="confirm" targetRef="informMpooreg" />
    <bpmn:sequenceFlow id="f-informMpooreg-informMspoReg" sourceRef="informMpooreg" targetRef="informMspoReg" />
    <bpmn:sequenceFlow id="f-informMspoReg-equipStart" sourceRef="informMspoReg" targetRef="equipStart" />
    <bpmn:sequenceFlow id="f-equipStart-performMp" sourceRef="equipStart" targetRef="performMp" />
    <bpmn:sequenceFlow id="f-equipStart-performMpo" sourceRef="equipStart" targetRef="performMpo" />
    <bpmn:sequenceFlow id="f-performMp-equipDone" sourceRef="performMp" targetRef="equipDone" />
    <bpmn:sequenceFlow id="f-performMpo-equipDone" sourceRef="performMpo" targetRef="equipDone" />
    <bpmn:sequenceFlow id="f-equipDone-outcome" sourceRef="equipDone" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-informFailure" name="failure of the entire process" sourceRef="outcome" targetRef="informFailure" />
    <bpmn:sequenceFlow id="f-outcome-informSuccess" name="successful completion of the entire process" sourceRef="outcome" targetRef="informSuccess" />
    <bpmn:sequenceFlow id="f-outcome-informTimeout" name="maximum time limit" sourceRef="outcome" targetRef="informTimeout" />
    <bpmn:sequenceFlow id="f-informFailure-confirmFailure" sourceRef="informFailure" targetRef="confirmFailure" />
    <bpmn:sequenceFlow id="f-confirmFailure-informMpoofail" sourceRef="confirmFailure" targetRef="informMpoofail" />
    <bpmn:sequenceFlow id="f-informMpoofail-informMspoFail" sourceRef="informMpoofail" targetRef="informMspoFail" />
    <bpmn:sequenceFlow id="f-informMspoFail-outcomeFailure" sourceRef="informMspoFail" targetRef="outcomeFailure" />
    <bpmn:sequenceFlow id="f-informSuccess-assign" sourceRef="informSuccess" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-confirmAssignment" sourceRef="assign" targetRef="confirmAssignment" />
    <bpmn:sequenceFlow id="f-confirmAssignment-informMpoosuccess" sourceRef="confirmAssignment" targetRef="informMpoosuccess" />
    <bpmn:sequenceFlow id="f-informMpoosuccess-informMspoSuccess" sourceRef="informMpoosuccess" targetRef="informMspoSuccess" />
    <bpmn:sequenceFlow id="f-informMspoSuccess-informSpSuccess" sourceRef="informMspoSuccess" targetRef="informSpSuccess" />
    <bpmn:sequenceFlow id="f-informSpSuccess-outcomeSuccess" sourceRef="informSpSuccess" targetRef="outcomeSuccess" />
    <bpmn:sequenceFlow id="f-informTimeout-outcomeTimeout" sourceRef="informTimeout" targetRef="outcomeTimeout" />
  </bpmn:process>
</bpmn:definitions>
