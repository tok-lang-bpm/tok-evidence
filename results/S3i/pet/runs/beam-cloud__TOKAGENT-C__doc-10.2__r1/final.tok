tok 1.0 "MPON meter operation"

pool organisation "Organisation"
  lane mpon "MPON"
    start needed "Meter operation needed"
    task report "Report the meter operation"
    task performMp "Perform the equipment acquisition and / or equipment changes"
    task informFailure "Inform the GO about the failure of the entire process"
    task informSuccess "Inform the GO about the successful completion of the entire process"
    xor outcome "Entire process outcome?"
  lane go "GO"
    task examine "Examine the application"
    xor application "Application rejected or confirmed?"
    task reject "Reject the application"
    task confirm "Confirm the application"
    task informMpooreg "Inform the MPOO about the registration confirmation of the MPON"
    task informMspoReg "Inform the MSPO about the registration confirmation of the MPON"
    and equipStart
    and equipDone
    task informTimeout "Inform the MPON about the failure of the overall transaction"
    task confirmFailure "Confirm the failure of the assignment to the MPON"
    task assign "Assign the MPON"
    task confirmAssignment "Confirm the assignment to the MPON"
    task informMpoofail "Inform the MPOO about the failure of the assignment of the MPON"
    task informMspoFail "Inform the MSPO about the failure of the assignment of the MPON"
    task informMpoosuccess "Inform the MPOO about the assignment of the MPON"
    task informMspoSuccess "Inform the MSPO about the assignment of the MPON"
    task informSpSuccess "Inform the SP about the assignment of the MPON"
    end rejected "Application rejected"
    end outcomeFailure "Assignment failed"
    end outcomeSuccess "Assignment completed"
    end outcomeTimeout "Transaction failed by deadline"
  lane mpoo "MPOO"
    task performMpo "Perform the equipment acquisition and / or equipment changes"
  lane mspo "MSPO"
  lane sp "SP"

flow needed -> report -> examine -> application
flow application -> reject "rejected"
flow application -> confirm "confirmed"
flow reject -> rejected
flow confirm -> informMpooreg -> informMspoReg -> equipStart
flow equipStart -> performMp
flow equipStart -> performMpo
flow performMp -> equipDone
flow performMpo -> equipDone
flow equipDone -> outcome
flow outcome -> informFailure "failure of the entire process"
flow outcome -> informSuccess "successful completion of the entire process"
flow outcome -> informTimeout "maximum time limit"
flow informFailure -> confirmFailure -> informMpoofail -> informMspoFail -> outcomeFailure
flow informSuccess -> assign -> confirmAssignment -> informMpoosuccess -> informMspoSuccess -> informSpSuccess -> outcomeSuccess
flow informTimeout -> outcomeTimeout
