<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Deregistration of MPOO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Deregistration of MPOO" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_continuation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Deregistration started" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="confirm_continuation" name="Confirm the continuation" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="verification" name="Reject or preliminarily confirm?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:task id="prelim" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige" name="Oblige to continue operations?" />
    <bpmn:task id="oblige_task" name="Oblige the MPOO to continue the operations" />
    <bpmn:inclusiveGateway id="equipment" name="Perform equipment acquisition and/or changes?" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:task id="changes" name="Perform the equipment changes" />
    <bpmn:inclusiveGateway id="equipment_done" name="Equipment done?" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-deregister" sourceRef="start" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-verification" sourceRef="verify" targetRef="verification" />
    <bpmn:sequenceFlow id="f-verification-reject" name="reject" sourceRef="verification" targetRef="reject" />
    <bpmn:sequenceFlow id="f-verification-prelim" name="preliminarily confirm" sourceRef="verification" targetRef="prelim" />
    <bpmn:sequenceFlow id="f-reject-done" sourceRef="reject" targetRef="done" />
    <bpmn:sequenceFlow id="f-prelim-prepare" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige" sourceRef="prepare" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige-oblige_task" name="yes" sourceRef="oblige" targetRef="oblige_task" />
    <bpmn:sequenceFlow id="f-oblige-equipment" name="no" sourceRef="oblige" targetRef="equipment" />
    <bpmn:sequenceFlow id="f-oblige_task-confirm_continuation" sourceRef="oblige_task" targetRef="confirm_continuation" />
    <bpmn:sequenceFlow id="f-confirm_continuation-equipment" sourceRef="confirm_continuation" targetRef="equipment" />
    <bpmn:sequenceFlow id="f-equipment-acquire" name="acquisition" sourceRef="equipment" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-equipment-changes" name="changes" sourceRef="equipment" targetRef="changes" />
    <bpmn:sequenceFlow id="f-acquire-equipment_done" sourceRef="acquire" targetRef="equipment_done" />
    <bpmn:sequenceFlow id="f-changes-equipment_done" sourceRef="changes" targetRef="equipment_done" />
    <bpmn:sequenceFlow id="f-equipment_done-assign" sourceRef="equipment_done" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_mpoo" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f-inform_mpoo-inform_mspo" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f-inform_mspo-inform_sp" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-done" sourceRef="inform_sp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
