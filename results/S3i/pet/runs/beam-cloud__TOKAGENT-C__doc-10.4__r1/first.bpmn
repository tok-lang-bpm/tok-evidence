<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_intentions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpon_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpon_dismount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read_installed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpoo_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mpoo_dismount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>go_notify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="notify_intentions" name="Notify the MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="self" name="Self dismounting?" />
    <bpmn:task id="mpon_read" name="Perform the final reading" />
    <bpmn:task id="mpon_dismount" name="Dismount the old equipment" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="read_installed" name="Read the meter count from the installed meter" />
    <bpmn:task id="send_final" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tell_go" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:task id="announce" name="Announce self dismounting to the MPON" />
    <bpmn:task id="notify_no" name="Notify the MPON about no self-dismounting of the MPOO" />
    <bpmn:task id="mpoo_read" name="Perform the final reading" />
    <bpmn:task id="mpoo_dismount" name="Dismount the old equipment" />
    <bpmn:task id="go_notify" name="Notify the MSP about the device changes, the master data, the meter count at dismounting, and the meter count at installation" />
    <bpmn:sequenceFlow id="f-start-notify_intentions" sourceRef="start" targetRef="notify_intentions" />
    <bpmn:sequenceFlow id="f-notify_intentions-self" sourceRef="notify_intentions" targetRef="self" />
    <bpmn:sequenceFlow id="f-self-announce" name="self-dismounting" sourceRef="self" targetRef="announce" />
    <bpmn:sequenceFlow id="f-self-notify_no" name="no self-dismounting" sourceRef="self" targetRef="notify_no" />
    <bpmn:sequenceFlow id="f-announce-mpoo_read" sourceRef="announce" targetRef="mpoo_read" />
    <bpmn:sequenceFlow id="f-mpoo_read-mpoo_dismount" sourceRef="mpoo_read" targetRef="mpoo_dismount" />
    <bpmn:sequenceFlow id="f-mpoo_dismount-merge" sourceRef="mpoo_dismount" targetRef="merge" />
    <bpmn:sequenceFlow id="f-notify_no-mpon_read" sourceRef="notify_no" targetRef="mpon_read" />
    <bpmn:sequenceFlow id="f-mpon_read-mpon_dismount" sourceRef="mpon_read" targetRef="mpon_dismount" />
    <bpmn:sequenceFlow id="f-mpon_dismount-merge" sourceRef="mpon_dismount" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-mount" sourceRef="merge" targetRef="mount" />
    <bpmn:sequenceFlow id="f-mount-read_installed" sourceRef="mount" targetRef="read_installed" />
    <bpmn:sequenceFlow id="f-read_installed-send_final" sourceRef="read_installed" targetRef="send_final" />
    <bpmn:sequenceFlow id="f-send_final-tell_go" sourceRef="send_final" targetRef="tell_go" />
    <bpmn:sequenceFlow id="f-tell_go-go_notify" sourceRef="tell_go" targetRef="go_notify" />
    <bpmn:sequenceFlow id="f-go_notify-end" sourceRef="go_notify" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
