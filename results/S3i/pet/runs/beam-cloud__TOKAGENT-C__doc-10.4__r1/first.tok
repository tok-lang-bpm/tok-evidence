tok 1.0 "Equipment change"

pool org "Organisation"
  lane mpon "MPON"
    start start "Start"
    task notify_intentions "Notify the MPOO about equipment change intentions"
    xor self "Self dismounting?"
    task mpon_read "Perform the final reading"
    task mpon_dismount "Dismount the old equipment"
    task mount "Mount the new device"
    task read_installed "Read the meter count from the installed meter"
    task send_final "Send the values of the final reading to the GO"
    task tell_go "Tell the GO about the device changes, the master data and the meter count at installation"
    xor merge
    end end "End"
  lane mpoo "MPOO"
    task announce "Announce self dismounting to the MPON"
    task notify_no "Notify the MPON about no self-dismounting of the MPOO"
    task mpoo_read "Perform the final reading"
    task mpoo_dismount "Dismount the old equipment"
  lane go "GO"
    task go_notify "Notify the MSP about the device changes, the master data, the meter count at dismounting, and the meter count at installation"

flow start -> notify_intentions -> self
flow self -> announce "self-dismounting"
flow self -> notify_no "no self-dismounting"
flow announce -> mpoo_read -> mpoo_dismount -> merge
flow notify_no -> mpon_read -> mpon_dismount -> merge
flow merge -> mount -> read_installed -> send_final -> tell_go -> go_notify -> end
