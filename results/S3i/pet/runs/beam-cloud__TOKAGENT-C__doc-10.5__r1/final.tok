tok 1.0 "Device takeover"

pool organisation "Organisation"
  lane mpon "MPON"
    start start "Start"
    task request "Request a device takeover bid"
    task place_order "Place an order"
  lane mpoo "MPOO"
    task send_tender "Send tender for the equipment takeover"
    task confirm_order "Confirm the order"
    task send_master_data "Send the master data"
    end end "End"

flow start -> request -> send_tender -> place_order -> confirm_order -> send_master_data -> end
