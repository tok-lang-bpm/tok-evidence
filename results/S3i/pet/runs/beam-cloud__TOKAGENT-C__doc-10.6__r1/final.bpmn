<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Dismissal needed" />
    <bpmn:task id="send" name="Send dismissal" />
    <bpmn:task id="review" name="Review dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal outcome?" />
    <bpmn:task id="reject" name="Reject dismissal" />
    <bpmn:task id="confirm" name="Confirm dismissal" />
    <bpmn:endEvent id="rejected" name="Dismissal rejected" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="Reject" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="Confirm" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
