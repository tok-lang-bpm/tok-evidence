<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>start_mspn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_msppo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mppo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_mspn" name="Start" />
    <bpmn:task id="register" name="Register the measurement at the GO" />
    <bpmn:task id="examine" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="decision" name="Application confirmed?" />
    <bpmn:task id="reject" name="Reject the application of the MSPN" />
    <bpmn:task id="confirm" name="Confirm the application of the MSPN" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:task id="inform_msppo" name="Inform the MSPO about the assignment of MSPN" />
    <bpmn:task id="inform_mppo" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of MSPN" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="completed" name="Application handled" />
    <bpmn:sequenceFlow id="f-start_mspn-register" sourceRef="start_mspn" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-examine" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-decision" sourceRef="examine" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="rejected" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="confirmed" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-assign" sourceRef="confirm" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-inform_msppo" sourceRef="assign" targetRef="inform_msppo" />
    <bpmn:sequenceFlow id="f-inform_msppo-inform_mppo" sourceRef="inform_msppo" targetRef="inform_mppo" />
    <bpmn:sequenceFlow id="f-inform_mppo-inform_sp" sourceRef="inform_mppo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_sp-completed" sourceRef="inform_sp" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
