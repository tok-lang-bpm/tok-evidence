tok 1.0 "MSPN process"

pool org "Organisation"
  lane mspn "MSPN"
    start start_mspn "Start"
    task register "Register the measurement at the GO"
  lane go "GO"
    task examine "Examine the application of the MSPN"
    xor decision "Application confirmed?"
    task reject "Reject the application of the MSPN"
    task confirm "Confirm the application of the MSPN"
    task assign "Assign the MSPN"
    task inform_msppo "Inform the MSPO about the assignment of MSPN"
    task inform_mppo "Inform the MPO about the assignment of the MSPN"
    task inform_sp "Inform the SP about the assignment of MSPN"
    end rejected "Application rejected"
    end completed "Application handled"

flow start_mspn -> register -> examine -> decision
flow decision -> reject "rejected"
flow decision -> confirm "confirmed"
flow reject -> rejected
flow confirm -> assign
flow assign -> inform_msppo -> inform_mppo -> inform_sp -> completed
