tok 1.0 "Change of measuring point"

pool organisation "Organisation"
  lane sp_pu_go "SP / PU / GO"
    start start1 "Change needed"
    task request "Request changes"
    end rejected "Change rejected"
    end reported "Implementation reported"
    end failed "Failure notified"
  lane mpo "MPO"
    task cause "Cause a change"
    task review "Review the change request"
    xor init "Who causes the change?"
    xor init_merge "Change initiated"
    xor decision "Change approved?"
    task reject "Reject the change"
    task confirm "Confirm the request"
    task perform "Perform the measuring point change"
    xor result "Change successful?"
    task report "Report the implementation"
    task notify "Notify about the failure"

flow start1 -> init
flow init -> request "Requested by SP / PU / GO" when="bySpPuGo"
flow init -> cause "Caused by MPO" default
flow request -> init_merge
flow cause -> init_merge
flow init_merge -> review
flow review -> decision
flow decision -> reject "No" when="rejected"
flow decision -> confirm "Yes" default
flow reject -> rejected
flow confirm -> perform
flow perform -> result
flow result -> report "Implemented" when="implemented"
flow result -> notify "Failed" default
flow report -> reported
flow notify -> failed
