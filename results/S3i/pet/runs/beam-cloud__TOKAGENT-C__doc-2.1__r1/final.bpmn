<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Service degradation process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_send_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_recv_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer_service" name="Customer Service">
        <bpmn:flowNodeRef>cs_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_create_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_recv_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_recv_prr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_recv_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_par_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_create_cust_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_cust_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_report_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_par_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_send_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="electronic_service" name="Electronic Service">
        <bpmn:flowNodeRef>es_determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_sig_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_sig_split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service_management" name="Service Management">
        <bpmn:flowNodeRef>sm_recv_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_detail_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_status_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_recv_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_prepare_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_correct_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_prr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_prr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_create_restreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_restreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_recv_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_perf_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_send_prr_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_end_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_end_prr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="resource_provisioning" name="Resource Provisioning">
        <bpmn:flowNodeRef>rp_recv_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_notify_normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_create_trouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_create_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_send_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_create_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_send_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_send_ts_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_end_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>b_adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c_start" name="Start" />
    <bpmn:task id="c_perceive" name="Perceive service degradation" />
    <bpmn:task id="c_send_params" name="Send list of problem parameters" />
    <bpmn:task id="c_recv_final" name="Receive report about service performance and problem resolution" />
    <bpmn:endEvent id="c_end" name="Process ends at customer" />
    <bpmn:task id="cs_enter" name="Enter problem report into system T" />
    <bpmn:task id="cs_compare" name="Compare problem report to customer SLA" />
    <bpmn:task id="cs_determine" name="Determine necessary counter measures" />
    <bpmn:task id="cs_create_detail" name="Create detailed problem report" />
    <bpmn:task id="cs_send_detail" name="Send detailed problem report to Service Management" />
    <bpmn:task id="cs_recv_perf" name="Receive actual service performance" />
    <bpmn:task id="cs_recv_prr" name="Receive problem resolution report" />
    <bpmn:exclusiveGateway id="cs_recv_join" name="Report received?" />
    <bpmn:parallelGateway id="cs_par_split" name="Trigger concurrent activities" />
    <bpmn:task id="cs_create_cust_report" name="Create report for customer" />
    <bpmn:task id="cs_send_cust_report" name="Send report to customer" />
    <bpmn:task id="cs_report_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="cs_par_join" name="All activities completed?" />
    <bpmn:parallelGateway id="cs_send_fork" name="Send completes" />
    <bpmn:endEvent id="cs_end" name="Process ends in Customer Service" />
    <bpmn:task id="es_determine" name="Determine significance of customer" />
    <bpmn:task id="es_extra" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="es_premium" name="Customer premium?" default="f-es_premium-es_sig_join" />
    <bpmn:exclusiveGateway id="es_sig_join" name="Significance assessed" />
    <bpmn:exclusiveGateway id="es_sig_split" name="Customer significance affects counter measures?" default="f-es_sig_split-cs_create_detail" />
    <bpmn:task id="sm_recv_detail" name="Receive detailed problem report" />
    <bpmn:task id="sm_investigate" name="Investigate problem analyzability" />
    <bpmn:exclusiveGateway id="sm_analyzable" name="Problem analyzable by Service Management?" default="f-sm_analyzable-sm_analyze" />
    <bpmn:task id="sm_send_detail_rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="sm_analyze" name="Perform analysis" />
    <bpmn:task id="sm_create_trouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="sm_status_join" name="Status ready?" />
    <bpmn:task id="sm_recv_status" name="Receive status report from Resource Provisioning" />
    <bpmn:task id="sm_prepare_final" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="sm_cm" name="Counter measures decision?" default="f-sm_cm-sm_create_restreq" />
    <bpmn:task id="sm_send_perf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="sm_correct_minor" name="Undertake corrective actions" />
    <bpmn:task id="sm_create_prr" name="Create problem resolution report" />
    <bpmn:task id="sm_send_prr" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="sm_create_restreq" name="Create request for automatic resource restoration" />
    <bpmn:task id="sm_send_restreq" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="sm_recv_ts" name="Receive trouble-shooting report" />
    <bpmn:parallelGateway id="sm_send_perf_split" name="Send performance completes" />
    <bpmn:parallelGateway id="sm_send_prr_split" name="Send report completes" />
    <bpmn:endEvent id="sm_end_no" name="End after sending actual service performance" />
    <bpmn:endEvent id="sm_end_prr" name="End after sending problem resolution report" />
    <bpmn:task id="rp_recv_detail" name="Receive detailed problem report" />
    <bpmn:task id="rp_check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="rp_problems" name="Problems detected?" default="f-rp_problems-rp_notify_normal" />
    <bpmn:task id="rp_notify_normal" name="Create notification about normal service execution" />
    <bpmn:task id="rp_analyze" name="Analyze problem" />
    <bpmn:task id="rp_create_trouble" name="Create trouble report" />
    <bpmn:task id="rp_create_status" name="Create status report" />
    <bpmn:task id="rp_send_status" name="Send status report to Service Management" />
    <bpmn:task id="rp_wait" name="Wait for restoration request" default="f-rp_wait-rp_track" />
    <bpmn:boundaryEvent id="rt" attachedToRef="rp_wait">
      <bpmn:timerEventDefinition id="rt-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="rp_track" name="Track all possible errors" />
    <bpmn:task id="rp_correct" name="Undertake corrective actions" />
    <bpmn:task id="rp_create_ts" name="Create trouble-shooting report" />
    <bpmn:task id="rp_send_ts" name="Send trouble-shooting report to Service Management" />
    <bpmn:parallelGateway id="rp_send_ts_split" name="Send trouble-shooting completes" />
    <bpmn:endEvent id="rp_end_timeout" name="Resource Provisioning terminates process" />
    <bpmn:endEvent id="rp_end" name="End after sending trouble-shooting report" />
    <bpmn:task id="b_adjust" name="Adjust billing" />
    <bpmn:sequenceFlow id="f-c_start-c_perceive" sourceRef="c_start" targetRef="c_perceive" />
    <bpmn:sequenceFlow id="f-c_perceive-c_send_params" sourceRef="c_perceive" targetRef="c_send_params" />
    <bpmn:sequenceFlow id="f-c_send_params-cs_enter" sourceRef="c_send_params" targetRef="cs_enter" />
    <bpmn:sequenceFlow id="f-cs_enter-cs_compare" sourceRef="cs_enter" targetRef="cs_compare" />
    <bpmn:sequenceFlow id="f-cs_compare-cs_determine" sourceRef="cs_compare" targetRef="cs_determine" />
    <bpmn:sequenceFlow id="f-cs_determine-es_determine" sourceRef="cs_determine" targetRef="es_determine" />
    <bpmn:sequenceFlow id="f-es_determine-es_premium" sourceRef="es_determine" targetRef="es_premium" />
    <bpmn:sequenceFlow id="f-es_premium-es_extra" name="premium" sourceRef="es_premium" targetRef="es_extra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">premium</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-es_premium-es_sig_join" name="not premium" sourceRef="es_premium" targetRef="es_sig_join" />
    <bpmn:sequenceFlow id="f-es_extra-es_sig_join" sourceRef="es_extra" targetRef="es_sig_join" />
    <bpmn:sequenceFlow id="f-es_sig_join-es_sig_split" sourceRef="es_sig_join" targetRef="es_sig_split" />
    <bpmn:sequenceFlow id="f-es_sig_split-cs_determine" name="affects" sourceRef="es_sig_split" targetRef="cs_determine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">affects</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-es_sig_split-cs_create_detail" name="does not affect" sourceRef="es_sig_split" targetRef="cs_create_detail" />
    <bpmn:sequenceFlow id="f-cs_create_detail-cs_send_detail" sourceRef="cs_create_detail" targetRef="cs_send_detail" />
    <bpmn:sequenceFlow id="f-cs_send_detail-sm_recv_detail" sourceRef="cs_send_detail" targetRef="sm_recv_detail" />
    <bpmn:sequenceFlow id="f-sm_recv_detail-sm_investigate" sourceRef="sm_recv_detail" targetRef="sm_investigate" />
    <bpmn:sequenceFlow id="f-sm_investigate-sm_analyzable" sourceRef="sm_investigate" targetRef="sm_analyzable" />
    <bpmn:sequenceFlow id="f-sm_analyzable-sm_send_detail_rp" name="not analyzable" sourceRef="sm_analyzable" targetRef="sm_send_detail_rp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notAnalyzable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sm_analyzable-sm_analyze" name="analyzable" sourceRef="sm_analyzable" targetRef="sm_analyze" />
    <bpmn:sequenceFlow id="f-sm_analyze-sm_create_trouble" sourceRef="sm_analyze" targetRef="sm_create_trouble" />
    <bpmn:sequenceFlow id="f-sm_send_detail_rp-rp_recv_detail" sourceRef="sm_send_detail_rp" targetRef="rp_recv_detail" />
    <bpmn:sequenceFlow id="f-rp_recv_detail-rp_check" sourceRef="rp_recv_detail" targetRef="rp_check" />
    <bpmn:sequenceFlow id="f-rp_check-rp_problems" sourceRef="rp_check" targetRef="rp_problems" />
    <bpmn:sequenceFlow id="f-rp_problems-rp_notify_normal" name="no problems" sourceRef="rp_problems" targetRef="rp_notify_normal" />
    <bpmn:sequenceFlow id="f-rp_problems-rp_analyze" name="problems detected" sourceRef="rp_problems" targetRef="rp_analyze">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasProblems</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-rp_analyze-rp_create_trouble" sourceRef="rp_analyze" targetRef="rp_create_trouble" />
    <bpmn:sequenceFlow id="f-rp_notify_normal-rp_create_status" sourceRef="rp_notify_normal" targetRef="rp_create_status" />
    <bpmn:sequenceFlow id="f-rp_create_trouble-rp_create_status" sourceRef="rp_create_trouble" targetRef="rp_create_status" />
    <bpmn:sequenceFlow id="f-rp_create_status-rp_send_status" sourceRef="rp_create_status" targetRef="rp_send_status" />
    <bpmn:sequenceFlow id="f-rp_send_status-sm_recv_status" sourceRef="rp_send_status" targetRef="sm_recv_status" />
    <bpmn:sequenceFlow id="f-sm_create_trouble-sm_status_join" sourceRef="sm_create_trouble" targetRef="sm_status_join" />
    <bpmn:sequenceFlow id="f-sm_recv_status-sm_status_join" sourceRef="sm_recv_status" targetRef="sm_status_join" />
    <bpmn:sequenceFlow id="f-sm_status_join-sm_prepare_final" sourceRef="sm_status_join" targetRef="sm_prepare_final" />
    <bpmn:sequenceFlow id="f-sm_prepare_final-sm_cm" sourceRef="sm_prepare_final" targetRef="sm_cm" />
    <bpmn:sequenceFlow id="f-sm_cm-sm_send_perf" name="no problem" sourceRef="sm_cm" targetRef="sm_send_perf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noProblem</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sm_cm-sm_correct_minor" name="minor" sourceRef="sm_cm" targetRef="sm_correct_minor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">minor</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sm_cm-sm_create_restreq" name="automatic restoration" sourceRef="sm_cm" targetRef="sm_create_restreq" />
    <bpmn:sequenceFlow id="f-sm_correct_minor-sm_create_prr" sourceRef="sm_correct_minor" targetRef="sm_create_prr" />
    <bpmn:sequenceFlow id="f-sm_create_restreq-sm_send_restreq" sourceRef="sm_create_restreq" targetRef="sm_send_restreq" />
    <bpmn:sequenceFlow id="f-sm_send_restreq-rp_wait" sourceRef="sm_send_restreq" targetRef="rp_wait" />
    <bpmn:sequenceFlow id="f-rp_wait-rp_track" name="request received" sourceRef="rp_wait" targetRef="rp_track" />
    <bpmn:sequenceFlow id="f-rp_track-rp_correct" sourceRef="rp_track" targetRef="rp_correct" />
    <bpmn:sequenceFlow id="f-rp_correct-rp_create_ts" sourceRef="rp_correct" targetRef="rp_create_ts" />
    <bpmn:sequenceFlow id="f-rp_create_ts-rp_send_ts" sourceRef="rp_create_ts" targetRef="rp_send_ts" />
    <bpmn:sequenceFlow id="f-rp_send_ts-rp_send_ts_split" sourceRef="rp_send_ts" targetRef="rp_send_ts_split" />
    <bpmn:sequenceFlow id="f-rp_send_ts_split-sm_recv_ts" sourceRef="rp_send_ts_split" targetRef="sm_recv_ts" />
    <bpmn:sequenceFlow id="f-rp_send_ts_split-rp_end" sourceRef="rp_send_ts_split" targetRef="rp_end" />
    <bpmn:sequenceFlow id="f-sm_recv_ts-sm_create_prr" sourceRef="sm_recv_ts" targetRef="sm_create_prr" />
    <bpmn:sequenceFlow id="f-sm_create_prr-sm_send_prr" sourceRef="sm_create_prr" targetRef="sm_send_prr" />
    <bpmn:sequenceFlow id="f-sm_send_perf-sm_send_perf_split" sourceRef="sm_send_perf" targetRef="sm_send_perf_split" />
    <bpmn:sequenceFlow id="f-sm_send_perf_split-cs_recv_perf" sourceRef="sm_send_perf_split" targetRef="cs_recv_perf" />
    <bpmn:sequenceFlow id="f-sm_send_perf_split-sm_end_no" sourceRef="sm_send_perf_split" targetRef="sm_end_no" />
    <bpmn:sequenceFlow id="f-sm_send_prr-sm_send_prr_split" sourceRef="sm_send_prr" targetRef="sm_send_prr_split" />
    <bpmn:sequenceFlow id="f-sm_send_prr_split-cs_recv_prr" sourceRef="sm_send_prr_split" targetRef="cs_recv_prr" />
    <bpmn:sequenceFlow id="f-sm_send_prr_split-sm_end_prr" sourceRef="sm_send_prr_split" targetRef="sm_end_prr" />
    <bpmn:sequenceFlow id="f-cs_recv_perf-cs_recv_join" sourceRef="cs_recv_perf" targetRef="cs_recv_join" />
    <bpmn:sequenceFlow id="f-cs_recv_prr-cs_recv_join" sourceRef="cs_recv_prr" targetRef="cs_recv_join" />
    <bpmn:sequenceFlow id="f-cs_recv_join-cs_par_split" sourceRef="cs_recv_join" targetRef="cs_par_split" />
    <bpmn:sequenceFlow id="f-cs_par_split-cs_create_cust_report" sourceRef="cs_par_split" targetRef="cs_create_cust_report" />
    <bpmn:sequenceFlow id="f-cs_par_split-cs_report_rebate" sourceRef="cs_par_split" targetRef="cs_report_rebate" />
    <bpmn:sequenceFlow id="f-cs_create_cust_report-cs_send_cust_report" sourceRef="cs_create_cust_report" targetRef="cs_send_cust_report" />
    <bpmn:sequenceFlow id="f-cs_send_cust_report-cs_send_fork" sourceRef="cs_send_cust_report" targetRef="cs_send_fork" />
    <bpmn:sequenceFlow id="f-cs_send_fork-c_recv_final" sourceRef="cs_send_fork" targetRef="c_recv_final" />
    <bpmn:sequenceFlow id="f-cs_send_fork-cs_par_join" sourceRef="cs_send_fork" targetRef="cs_par_join" />
    <bpmn:sequenceFlow id="f-cs_report_rebate-b_adjust" sourceRef="cs_report_rebate" targetRef="b_adjust" />
    <bpmn:sequenceFlow id="f-b_adjust-cs_par_join" sourceRef="b_adjust" targetRef="cs_par_join" />
    <bpmn:sequenceFlow id="f-cs_par_join-cs_end" sourceRef="cs_par_join" targetRef="cs_end" />
    <bpmn:sequenceFlow id="f-c_recv_final-c_end" sourceRef="c_recv_final" targetRef="c_end" />
    <bpmn:sequenceFlow id="f-rt-rp_end_timeout" sourceRef="rt" targetRef="rp_end_timeout" />
  </bpmn:process>
</bpmn:definitions>
