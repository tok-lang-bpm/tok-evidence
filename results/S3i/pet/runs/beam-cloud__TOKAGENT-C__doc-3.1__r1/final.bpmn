<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Small Claims Registry Operations" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Warrant possession request handling" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_physical_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_respective_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_expanded_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>send_report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Warrant possession request needed" />
    <bpmn:task id="send" name="Send warrant possession request asking a warrant to be released" />
    <bpmn:task id="receive_request" name="Receive the request" />
    <bpmn:task id="retrieve_sct_file" name="Retrieve the SCT file" />
    <bpmn:task id="forward" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store_physical_file" name="Store the SCT physical file" />
    <bpmn:task id="retrieve_respective_file" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach_document" name="Attach the new SCT document" />
    <bpmn:task id="store_expanded_file" name="Store the expanded SCT physical file" />
    <bpmn:endEvent id="handled" name="Expanded SCT physical file stored" />
    <bpmn:task id="send_report" name="Send the report" />
    <bpmn:sequenceFlow id="f-needed-send" sourceRef="needed" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-receive_request" sourceRef="send" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f-receive_request-retrieve_sct_file" sourceRef="receive_request" targetRef="retrieve_sct_file" />
    <bpmn:sequenceFlow id="f-retrieve_sct_file-forward" sourceRef="retrieve_sct_file" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-store_physical_file" sourceRef="forward" targetRef="store_physical_file" />
    <bpmn:sequenceFlow id="f-store_physical_file-send_report" sourceRef="store_physical_file" targetRef="send_report" />
    <bpmn:sequenceFlow id="f-send_report-retrieve_respective_file" sourceRef="send_report" targetRef="retrieve_respective_file" />
    <bpmn:sequenceFlow id="f-retrieve_respective_file-attach_document" sourceRef="retrieve_respective_file" targetRef="attach_document" />
    <bpmn:sequenceFlow id="f-attach_document-store_expanded_file" sourceRef="attach_document" targetRef="store_expanded_file" />
    <bpmn:sequenceFlow id="f-store_expanded_file-handled" sourceRef="store_expanded_file" targetRef="handled" />
  </bpmn:process>
</bpmn:definitions>
