tok 1.0 "Warrant possession request handling"

pool organisation "Organisation"
  lane party "Party"
    start needed "Warrant possession request needed"
    task send "Send warrant possession request asking a warrant to be released"
  lane backoffice "Client Service Back Office"
    task receive_request "Receive the request"
    task retrieve_sct_file "Retrieve the SCT file"
    task forward "Forward SCT Warrant Possession to Queensland Police"
    task store_physical_file "Store the SCT physical file"
    task receive_report "Receive the report"
    task retrieve_respective_file "Retrieve the respective SCT file"
    task attach_document "Attach the new SCT document"
    task store_expanded_file "Store the expanded SCT physical file"
  lane police "Queensland Police"
    task receive_warrant "Receive SCT Warrant Possession"
    task send_report "Send the report"
  lane mc "MC internal staff"
    task receive_physical_file "Receive the physical SCT file"
    end received "Physical SCT file received"

flow needed -> send -> receive_request -> retrieve_sct_file -> forward -> receive_warrant -> store_physical_file -> send_report -> receive_report -> retrieve_respective_file -> attach_document -> store_expanded_file -> receive_physical_file -> received