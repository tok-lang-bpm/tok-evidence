<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Files for court hearing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Office" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Files for court hearing" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="court" name="Court">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>both</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Morning" />
    <bpmn:task id="check" name="Check the files" />
    <bpmn:exclusiveGateway id="missing" name="Some files missing?" />
    <bpmn:task id="search" name="Initiate a search" />
    <bpmn:task id="track" name="Track files to intended location" />
    <bpmn:exclusiveGateway id="ready" name="Files ready?" />
    <bpmn:parallelGateway id="parallel" name="Ready work" />
    <bpmn:task id="hand" name="Hand files to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist" />
    <bpmn:parallelGateway id="both" name="Both done" />
    <bpmn:task id="conduct" name="Conduct the directions hearings" />
    <bpmn:endEvent id="done" name="Directions hearings conducted" />
    <bpmn:sequenceFlow id="f-start-check" sourceRef="start" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">filesMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not(filesMissing)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-parallel" sourceRef="ready" targetRef="parallel" />
    <bpmn:sequenceFlow id="f-parallel-hand" sourceRef="parallel" targetRef="hand" />
    <bpmn:sequenceFlow id="f-parallel-distribute" sourceRef="parallel" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-both" sourceRef="hand" targetRef="both" />
    <bpmn:sequenceFlow id="f-distribute-both" sourceRef="distribute" targetRef="both" />
    <bpmn:sequenceFlow id="f-both-conduct" sourceRef="both" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-done" sourceRef="conduct" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
