tok 1.0 "Files for court hearing"

pool office "Office"
  lane court "Court"
    start start "Morning"
    task check "Check the files"
    xor missing "Some files missing?"
    task search "Initiate a search"
    task track "Track files to intended location"
    xor ready "Files ready?"
    and parallel "Ready work"
    task hand "Hand files to the Associate"
    task distribute "Distribute the Judge's Lawlist"
    and both "Both done"
    task conduct "Conduct the directions hearings"
    end done "Directions hearings conducted"

flow start -> check -> missing
flow missing -> search "yes" when="filesMissing"
flow missing -> track "no" when="not(filesMissing)"
flow search -> ready
flow track -> ready
flow ready -> parallel
flow parallel -> hand
flow parallel -> distribute
flow hand -> both
flow distribute -> both
flow both -> conduct -> done
