tok 1.0 "Claim handling"

pool organisation "Organisation"
  lane claims_officer "Claims Officer"
    start registered "Claim registered"
    task examine "Examine the claim"
    task write "Write a settlement recommendation"
    end proceeds "Claim handling proceeds"
  lane senior_claims_officer "Senior Claims Officer"
    task check "Check the recommendation"
    xor ok "Claim OK?"

flow registered -> examine -> write -> check -> ok
flow ok -> write "Not OK"
flow ok -> proceeds "OK"
