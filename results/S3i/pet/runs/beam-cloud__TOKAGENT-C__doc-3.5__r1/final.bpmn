<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Mail processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Mail processing" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="mail_processing" name="Mail Processing Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mail_clerk" name="Mail Clerk">
        <bpmn:flowNodeRef>sort_unopened</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort_groups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture_matter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>take_fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture_party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="collect" name="Collect the mail" />
    <bpmn:task id="distribute" name="Distribute the mail" />
    <bpmn:task id="sort_unopened" name="Sort the unopened mail into business areas" />
    <bpmn:task id="open" name="Open the mail" />
    <bpmn:task id="sort_groups" name="Sort the mail into groups" />
    <bpmn:task id="register" name="Register the mail" />
    <bpmn:task id="quality" name="Perform quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="compile" name="Compile requisition list" />
    <bpmn:task id="send_back" name="Send requisition list to party" />
    <bpmn:endEvent id="rejected" name="Mail rejected" />
    <bpmn:task id="capture_matter" name="Capture matter details" />
    <bpmn:task id="put_envelope" name="Put receipt and copied documents into an envelope" />
    <bpmn:task id="post" name="Post receipt and copied documents to party" />
    <bpmn:parallelGateway id="split" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="take_fees" name="Take applicable fees" />
    <bpmn:task id="capture_party" name="Capture Party Details" />
    <bpmn:task id="print_file" name="Print Physical Court File" />
    <bpmn:endEvent id="processed" name="Mail processed" />
    <bpmn:sequenceFlow id="f-start-collect" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sort_unopened" sourceRef="collect" targetRef="sort_unopened" />
    <bpmn:sequenceFlow id="f-sort_unopened-distribute" sourceRef="sort_unopened" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-open" sourceRef="distribute" targetRef="open" />
    <bpmn:sequenceFlow id="f-open-sort_groups" sourceRef="open" targetRef="sort_groups" />
    <bpmn:sequenceFlow id="f-sort_groups-register" sourceRef="sort_groups" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-quality" sourceRef="register" targetRef="quality" />
    <bpmn:sequenceFlow id="f-quality-compliant" sourceRef="quality" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-compile" name="No" sourceRef="compliant" targetRef="compile" />
    <bpmn:sequenceFlow id="f-compliant-capture_matter" name="Yes" sourceRef="compliant" targetRef="capture_matter" />
    <bpmn:sequenceFlow id="f-compile-send_back" sourceRef="compile" targetRef="send_back" />
    <bpmn:sequenceFlow id="f-send_back-rejected" sourceRef="send_back" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-capture_matter-take_fees" sourceRef="capture_matter" targetRef="take_fees" />
    <bpmn:sequenceFlow id="f-take_fees-split" sourceRef="take_fees" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-put_envelope" sourceRef="split" targetRef="put_envelope" />
    <bpmn:sequenceFlow id="f-split-capture_party" sourceRef="split" targetRef="capture_party" />
    <bpmn:sequenceFlow id="f-put_envelope-post" sourceRef="put_envelope" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-join" sourceRef="post" targetRef="join" />
    <bpmn:sequenceFlow id="f-capture_party-print_file" sourceRef="capture_party" targetRef="print_file" />
    <bpmn:sequenceFlow id="f-print_file-join" sourceRef="print_file" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-processed" sourceRef="join" targetRef="processed" />
  </bpmn:process>
</bpmn:definitions>
