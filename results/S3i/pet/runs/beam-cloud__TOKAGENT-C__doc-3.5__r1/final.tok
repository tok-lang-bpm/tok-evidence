tok 1.0 "Mail processing"

pool organisation "Organisation"
  lane mail_processing "Mail Processing Unit"
    start start "Start"
    task collect "Collect the mail"
    task distribute "Distribute the mail"
  lane mail_clerk "Mail Clerk"
    task sort_unopened "Sort the unopened mail into business areas"
  lane registry "Registry"
    task open "Open the mail"
    task sort_groups "Sort the mail into groups"
    task register "Register the mail"
  lane assistant "Assistant Registry Manager"
    task quality "Perform quality check"
    xor compliant "Mail compliant?"
    task compile "Compile requisition list"
    task send_back "Send requisition list to party"
    end rejected "Mail rejected"
    task capture_matter "Capture matter details"
    task put_envelope "Put receipt and copied documents into an envelope"
    task post "Post receipt and copied documents to party"
    and split
    and join
  lane cashier "Cashier"
    task take_fees "Take applicable fees"
    task capture_party "Capture Party Details"
    task print_file "Print Physical Court File"
    end processed "Mail processed"

flow start -> collect -> sort_unopened -> distribute -> open -> sort_groups -> register -> quality -> compliant
flow compliant -> compile "No"
flow compliant -> capture_matter "Yes"
flow compile -> send_back -> rejected
flow capture_matter -> take_fees
flow take_fees -> split
flow split -> put_envelope
flow split -> capture_party
flow put_envelope -> post
flow post -> join
flow capture_party -> print_file
flow print_file -> join
flow join -> processed
