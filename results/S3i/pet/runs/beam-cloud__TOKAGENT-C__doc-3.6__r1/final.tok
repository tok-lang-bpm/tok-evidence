tok 1.0 "Claims Notification"

pool organisation "Organisation"
  lane claimant "Claimant"
    task returnForms "Return the forms"
    task updateForms "Update the forms"
  lane claims "Claims Department"
    start claimReceived "Claim received"
    task checkInsured "Check whether claimant is insured"
    xor insured "Claimant insured?"
    task informRejection "Inform claimant of rejection"
    task evaluateSeverity "Evaluate severity of claim"
    xor severity "Simple or complex claim?"
    task sendSimple "Send simple forms to claimant"
    task sendComplex "Send complex forms to claimant"
    xor formsSent "Relevant forms sent?"
    task checkCompleteness "Check forms for completeness"
    xor complete "Forms complete?"
    task informUpdate "Inform claimant to update forms"
    end processEnded "Claims Notification process ended"
  lane cms "Claims Management System"
    task registerClaim "Register the claim"

flow claimReceived -> checkInsured -> insured
flow insured -> informRejection "no"
flow insured -> evaluateSeverity "yes"
flow evaluateSeverity -> severity
flow severity -> sendSimple "simple"
flow severity -> sendComplex "complex"
flow sendSimple -> formsSent
flow sendComplex -> formsSent
flow formsSent -> returnForms
flow returnForms -> checkCompleteness
flow checkCompleteness -> complete
flow complete -> registerClaim "yes"
flow complete -> informUpdate "no"
flow registerClaim -> processEnded
flow informUpdate -> updateForms
flow updateForms -> checkCompleteness
flow informRejection -> processEnded
