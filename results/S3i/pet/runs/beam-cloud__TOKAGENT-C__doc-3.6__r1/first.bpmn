<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims Notification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Claims Notification" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="claimant" name="Claimant">
        <bpmn:flowNodeRef>returnForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateForms</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims" name="Claims Department">
        <bpmn:flowNodeRef>claimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processEnded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cms" name="Claims Management System">
        <bpmn:flowNodeRef>registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="returnForms" name="Return the forms" />
    <bpmn:task id="updateForms" name="Update the forms" />
    <bpmn:startEvent id="claimReceived" name="Claim received" />
    <bpmn:task id="checkInsured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" />
    <bpmn:task id="informRejection" name="Inform claimant of rejection" />
    <bpmn:task id="evaluateSeverity" name="Evaluate severity of claim" />
    <bpmn:exclusiveGateway id="severity" name="Simple or complex claim?" />
    <bpmn:task id="sendForms" name="Send relevant forms to claimant" />
    <bpmn:task id="checkCompleteness" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="complete" name="Forms complete?" />
    <bpmn:task id="informUpdate" name="Inform claimant to update forms" />
    <bpmn:endEvent id="processEnded" name="Claims Notification process ended" />
    <bpmn:task id="registerClaim" name="Register the claim" />
    <bpmn:sequenceFlow id="f-claimReceived-checkInsured" sourceRef="claimReceived" targetRef="checkInsured" />
    <bpmn:sequenceFlow id="f-checkInsured-insured" sourceRef="checkInsured" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-informRejection" name="no" sourceRef="insured" targetRef="informRejection" />
    <bpmn:sequenceFlow id="f-insured-evaluateSeverity" name="yes" sourceRef="insured" targetRef="evaluateSeverity" />
    <bpmn:sequenceFlow id="f-evaluateSeverity-severity" sourceRef="evaluateSeverity" targetRef="severity" />
    <bpmn:sequenceFlow id="f-severity-sendForms" name="simple" sourceRef="severity" targetRef="sendForms" />
    <bpmn:sequenceFlow id="f-severity-sendForms-2" name="complex" sourceRef="severity" targetRef="sendForms" />
    <bpmn:sequenceFlow id="f-sendForms-returnForms" sourceRef="sendForms" targetRef="returnForms" />
    <bpmn:sequenceFlow id="f-returnForms-checkCompleteness" sourceRef="returnForms" targetRef="checkCompleteness" />
    <bpmn:sequenceFlow id="f-checkCompleteness-complete" sourceRef="checkCompleteness" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-registerClaim" name="yes" sourceRef="complete" targetRef="registerClaim" />
    <bpmn:sequenceFlow id="f-complete-informUpdate" name="no" sourceRef="complete" targetRef="informUpdate" />
    <bpmn:sequenceFlow id="f-registerClaim-processEnded" sourceRef="registerClaim" targetRef="processEnded" />
    <bpmn:sequenceFlow id="f-informUpdate-updateForms" sourceRef="informUpdate" targetRef="updateForms" />
    <bpmn:sequenceFlow id="f-updateForms-checkCompleteness" sourceRef="updateForms" targetRef="checkCompleteness" />
    <bpmn:sequenceFlow id="f-informRejection-processEnded" sourceRef="informRejection" targetRef="processEnded" />
  </bpmn:process>
</bpmn:definitions>
