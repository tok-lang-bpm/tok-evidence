<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Car accident claim" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="claims_handler" name="Claims handler">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claims_manager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Police report needed" />
    <bpmn:task id="search" name="Search Police Report in database" />
    <bpmn:task id="file" name="Put Police Report in file with Claim Documentation" />
    <bpmn:task id="calculate" name="Calculate initial claim estimate" />
    <bpmn:task id="create" name="Create Action Plan" />
    <bpmn:task id="negotiate" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="inform" name="Inform claimant of outcome" />
    <bpmn:endEvent id="done" name="Claimant informed" />
    <bpmn:sequenceFlow id="f-needed-search" sourceRef="needed" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-file" sourceRef="search" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-calculate" sourceRef="file" targetRef="calculate" />
    <bpmn:sequenceFlow id="f-calculate-create" sourceRef="calculate" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-negotiate" sourceRef="create" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-inform" sourceRef="negotiate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-done" sourceRef="inform" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
