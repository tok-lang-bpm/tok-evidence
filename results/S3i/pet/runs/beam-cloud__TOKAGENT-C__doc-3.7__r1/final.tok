tok 1.0 "Car accident claim"

pool organisation "Organisation"
  lane claims_handler "Claims handler"
    start needed "Police report needed"
    task search "Search Police Report in database"
    task file "Put Police Report in file with Claim Documentation"
    task calculate "Calculate initial claim estimate"
    task create "Create Action Plan"
  lane claims_manager "Claims manager"
    task negotiate "Negotiate settlement on claim estimate"
    task inform "Inform claimant of outcome"
    end done "Claimant informed"

flow needed -> search -> file -> calculate -> create -> negotiate -> inform -> done
