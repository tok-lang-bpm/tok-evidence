<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>pick_up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone_garage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome_join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Claim needed" />
    <bpmn:task id="submit" name="Submit the claim" />
    <bpmn:task id="check_docs" name="Check the documents" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="send_letter" name="Send a letter to the customer" />
    <bpmn:endEvent id="complete" name="Claim handled" />
    <bpmn:task id="pick_up" name="Pick up the claim" />
    <bpmn:task id="check_insurance" name="Check the insurance" />
    <bpmn:task id="assess" name="Perform an assessment" />
    <bpmn:exclusiveGateway id="assessment" name="Assessment positive?" />
    <bpmn:task id="phone_garage" name="Phone a garage to authorise the repairs" />
    <bpmn:task id="schedule_payment" name="Schedule the payment" />
    <bpmn:task id="reject" name="Reject the claim" />
    <bpmn:exclusiveGateway id="outcome_join" />
    <bpmn:sequenceFlow id="f-needed-submit" sourceRef="needed" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check_docs" sourceRef="submit" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f-check_docs-register" sourceRef="check_docs" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-pick_up" sourceRef="register" targetRef="pick_up" />
    <bpmn:sequenceFlow id="f-pick_up-check_insurance" sourceRef="pick_up" targetRef="check_insurance" />
    <bpmn:sequenceFlow id="f-check_insurance-assess" sourceRef="check_insurance" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-assessment" sourceRef="assess" targetRef="assessment" />
    <bpmn:sequenceFlow id="f-assessment-phone_garage" name="positive" sourceRef="assessment" targetRef="phone_garage" />
    <bpmn:sequenceFlow id="f-assessment-reject" name="negative" sourceRef="assessment" targetRef="reject" />
    <bpmn:sequenceFlow id="f-phone_garage-schedule_payment" sourceRef="phone_garage" targetRef="schedule_payment" />
    <bpmn:sequenceFlow id="f-schedule_payment-outcome_join" sourceRef="schedule_payment" targetRef="outcome_join" />
    <bpmn:sequenceFlow id="f-reject-outcome_join" sourceRef="reject" targetRef="outcome_join" />
    <bpmn:sequenceFlow id="f-outcome_join-send_letter" sourceRef="outcome_join" targetRef="send_letter" />
    <bpmn:sequenceFlow id="f-send_letter-complete" sourceRef="send_letter" targetRef="complete" />
  </bpmn:process>
</bpmn:definitions>
