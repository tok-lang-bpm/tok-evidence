tok 1.0 "Claim handling"

pool insurer "Car insurer"
  lane customer "Customer"
    start needed "Claim needed"
    task submit "Submit the claim"
  lane notification "Notification department"
    task check_docs "Check the documents"
    task register "Register the claim"
    task send_letter "Send a letter to the customer"
    end complete "Claim handled"
  lane handling "Handling department"
    task pick_up "Pick up the claim"
    task check_insurance "Check the insurance"
    task assess "Perform an assessment"
    xor assessment "Assessment positive?"
    task phone_garage "Phone a garage to authorise the repairs"
    task schedule_payment "Schedule the payment"
    task reject "Reject the claim"
    xor outcome_join

flow needed -> submit -> check_docs -> register -> pick_up -> check_insurance -> assess -> assessment
flow assessment -> phone_garage "positive"
flow assessment -> reject "negative"
flow phone_garage -> schedule_payment
flow schedule_payment -> outcome_join
flow reject -> outcome_join
flow outcome_join -> send_letter
flow send_letter -> complete
