<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental Health Care Institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="family_doctor" name="Family doctor">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_copy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secretarial" name="Secretarial office">
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_through</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new_patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new_patient_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_notices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_assignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>medical_required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>medical_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type_tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_taped_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetings_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing_officer" name="Nursing officer">
        <bpmn:flowNodeRef>full_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_form</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team_leader" name="Team-leader">
        <bpmn:flowNodeRef>hold_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record_assignment_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_assignment_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>formulate_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="social_worker" name="Social-medical worker">
        <bpmn:flowNodeRef>first_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_observe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_checklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="physician" name="Physician">
        <bpmn:flowNodeRef>second_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_meet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_record</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Notice needed" />
    <bpmn:task id="notice" name="Notice by telephone" />
    <bpmn:task id="send_copy" name="Send a copy of the medical file" />
    <bpmn:task id="inquire" name="Inquire after the name and residence of the patient" />
    <bpmn:task id="put_through" name="Put the doctor through to the nursing officer" />
    <bpmn:task id="store" name="Store the information on the form in the information system" />
    <bpmn:task id="print" name="Print the information" />
    <bpmn:exclusiveGateway id="new_patient" name="New patient?" default="f-new_patient-new_patient_join" />
    <bpmn:task id="create_file" name="Create a patient file" />
    <bpmn:exclusiveGateway id="new_patient_join" name="New patient checked?" />
    <bpmn:task id="store_docs" name="Store the registration form and the print in the patient file" />
    <bpmn:task id="produce_cards" name="Produce two registration cards" />
    <bpmn:task id="add_notices" name="Add the new patient to the list of new notices" />
    <bpmn:task id="store_assignments" name="Store the assignment of each patient in the information system" />
    <bpmn:task id="pass_cards" name="Pass the registration cards to the first and second intaker" />
    <bpmn:parallelGateway id="split_intake" name="Start intake meetings" />
    <bpmn:exclusiveGateway id="medical_required" name="Medical file required?" default="f-medical_required-medical_merge" />
    <bpmn:task id="prepare_letter" name="Prepare and send a letter to the family doctor requesting a copy of the medical file" />
    <bpmn:task id="receive_copy" name="Receive a copy of the medical file" />
    <bpmn:task id="inform_second" name="Inform the second intaker" />
    <bpmn:task id="add_copy" name="Add the copy to the patient file" />
    <bpmn:exclusiveGateway id="medical_merge" name="Medical file checked?" />
    <bpmn:task id="type_tapes" name="Type out the tapes" />
    <bpmn:task id="add_taped_info" name="Add the information to the patient file" />
    <bpmn:task id="status_list" name="Put the patient on the list of patients that reach this status" />
    <bpmn:task id="provide_list" name="Provide the team-leader with a list of these patients" />
    <bpmn:parallelGateway id="meetings_done" name="Meetings completed" />
    <bpmn:task id="full_inquiry" name="Make a full inquiry into the mental, health, and social state" />
    <bpmn:task id="record_form" name="Record the information on a registration form" />
    <bpmn:task id="hand_form" name="Hand in the registration form at the secretarial office" />
    <bpmn:task id="hold_meeting" name="Hold a staff meeting of the medical team" />
    <bpmn:task id="assign" name="Assign all new patients on the list to members of the team" />
    <bpmn:task id="record_assignment_list" name="Record the assignments on an assignment list" />
    <bpmn:task id="hand_assignment_list" name="Hand the assignment list to the secretarial office" />
    <bpmn:task id="formulate_plan" name="Formulate a treatment plan" />
    <bpmn:endEvent id="ended" name="Intake procedure ended" />
    <bpmn:task id="first_plan" name="Plan a meeting with the patient" />
    <bpmn:task id="first_examine" name="Examine the patient using a standard checklist" />
    <bpmn:task id="first_observe" name="Register additional observations in a personal notebook" />
    <bpmn:task id="first_notes" name="Put a copy of the notes in the patient file" />
    <bpmn:task id="first_checklist" name="Add the standard checklist to the patient file" />
    <bpmn:task id="second_plan" name="Plan the first meeting" />
    <bpmn:task id="second_meet" name="Meet with the patient" />
    <bpmn:task id="second_record" name="Record observations using a dictaphone" />
    <bpmn:sequenceFlow id="f-needed-notice" sourceRef="needed" targetRef="notice" />
    <bpmn:sequenceFlow id="f-notice-inquire" sourceRef="notice" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-put_through" sourceRef="inquire" targetRef="put_through" />
    <bpmn:sequenceFlow id="f-put_through-full_inquiry" sourceRef="put_through" targetRef="full_inquiry" />
    <bpmn:sequenceFlow id="f-full_inquiry-record_form" sourceRef="full_inquiry" targetRef="record_form" />
    <bpmn:sequenceFlow id="f-record_form-hand_form" sourceRef="record_form" targetRef="hand_form" />
    <bpmn:sequenceFlow id="f-hand_form-store" sourceRef="hand_form" targetRef="store" />
    <bpmn:sequenceFlow id="f-store-print" sourceRef="store" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-new_patient" sourceRef="print" targetRef="new_patient" />
    <bpmn:sequenceFlow id="f-new_patient-create_file" name="New patient" sourceRef="new_patient" targetRef="create_file" />
    <bpmn:sequenceFlow id="f-new_patient-new_patient_join" name="Existing patient" sourceRef="new_patient" targetRef="new_patient_join" />
    <bpmn:sequenceFlow id="f-create_file-new_patient_join" sourceRef="create_file" targetRef="new_patient_join" />
    <bpmn:sequenceFlow id="f-new_patient_join-store_docs" sourceRef="new_patient_join" targetRef="store_docs" />
    <bpmn:sequenceFlow id="f-store_docs-produce_cards" sourceRef="store_docs" targetRef="produce_cards" />
    <bpmn:sequenceFlow id="f-produce_cards-add_notices" sourceRef="produce_cards" targetRef="add_notices" />
    <bpmn:sequenceFlow id="f-add_notices-hold_meeting" sourceRef="add_notices" targetRef="hold_meeting" />
    <bpmn:sequenceFlow id="f-hold_meeting-assign" sourceRef="hold_meeting" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-record_assignment_list" sourceRef="assign" targetRef="record_assignment_list" />
    <bpmn:sequenceFlow id="f-record_assignment_list-hand_assignment_list" sourceRef="record_assignment_list" targetRef="hand_assignment_list" />
    <bpmn:sequenceFlow id="f-hand_assignment_list-store_assignments" sourceRef="hand_assignment_list" targetRef="store_assignments" />
    <bpmn:sequenceFlow id="f-store_assignments-pass_cards" sourceRef="store_assignments" targetRef="pass_cards" />
    <bpmn:sequenceFlow id="f-pass_cards-split_intake" sourceRef="pass_cards" targetRef="split_intake" />
    <bpmn:sequenceFlow id="f-split_intake-first_plan" sourceRef="split_intake" targetRef="first_plan" />
    <bpmn:sequenceFlow id="f-split_intake-medical_required" sourceRef="split_intake" targetRef="medical_required" />
    <bpmn:sequenceFlow id="f-first_plan-first_examine" sourceRef="first_plan" targetRef="first_examine" />
    <bpmn:sequenceFlow id="f-first_examine-first_observe" sourceRef="first_examine" targetRef="first_observe" />
    <bpmn:sequenceFlow id="f-first_observe-first_notes" sourceRef="first_observe" targetRef="first_notes" />
    <bpmn:sequenceFlow id="f-first_notes-first_checklist" sourceRef="first_notes" targetRef="first_checklist" />
    <bpmn:sequenceFlow id="f-first_checklist-meetings_done" sourceRef="first_checklist" targetRef="meetings_done" />
    <bpmn:sequenceFlow id="f-medical_required-prepare_letter" name="Yes" sourceRef="medical_required" targetRef="prepare_letter" />
    <bpmn:sequenceFlow id="f-medical_required-medical_merge" name="No" sourceRef="medical_required" targetRef="medical_merge" />
    <bpmn:sequenceFlow id="f-prepare_letter-send_copy" sourceRef="prepare_letter" targetRef="send_copy" />
    <bpmn:sequenceFlow id="f-send_copy-receive_copy" sourceRef="send_copy" targetRef="receive_copy" />
    <bpmn:sequenceFlow id="f-receive_copy-inform_second" sourceRef="receive_copy" targetRef="inform_second" />
    <bpmn:sequenceFlow id="f-inform_second-add_copy" sourceRef="inform_second" targetRef="add_copy" />
    <bpmn:sequenceFlow id="f-add_copy-medical_merge" sourceRef="add_copy" targetRef="medical_merge" />
    <bpmn:sequenceFlow id="f-medical_merge-second_plan" sourceRef="medical_merge" targetRef="second_plan" />
    <bpmn:sequenceFlow id="f-second_plan-second_meet" sourceRef="second_plan" targetRef="second_meet" />
    <bpmn:sequenceFlow id="f-second_meet-second_record" sourceRef="second_meet" targetRef="second_record" />
    <bpmn:sequenceFlow id="f-second_record-type_tapes" sourceRef="second_record" targetRef="type_tapes" />
    <bpmn:sequenceFlow id="f-type_tapes-add_taped_info" sourceRef="type_tapes" targetRef="add_taped_info" />
    <bpmn:sequenceFlow id="f-add_taped_info-meetings_done" sourceRef="add_taped_info" targetRef="meetings_done" />
    <bpmn:sequenceFlow id="f-meetings_done-status_list" sourceRef="meetings_done" targetRef="status_list" />
    <bpmn:sequenceFlow id="f-status_list-provide_list" sourceRef="status_list" targetRef="provide_list" />
    <bpmn:sequenceFlow id="f-provide_list-formulate_plan" sourceRef="provide_list" targetRef="formulate_plan" />
    <bpmn:sequenceFlow id="f-formulate_plan-ended" sourceRef="formulate_plan" targetRef="ended" />
  </bpmn:process>
</bpmn:definitions>
