<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Loan approval process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="loan" name="Loan approval organisation" processRef="loan-process" />
  </bpmn:collaboration>
  <bpmn:process id="loan-process" name="Loan approval process" isExecutable="false">
    <bpmn:laneSet id="loan-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="risk" name="Risk assessment Web service">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Loan request received" />
    <bpmn:task id="receive_feedback" name="Receive feedback" />
    <bpmn:endEvent id="done" name="Feedback received" />
    <bpmn:task id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="result" name="Assessment result?" />
    <bpmn:task id="approve" name="Approve the loan" />
    <bpmn:task id="deny" name="Deny the loan" />
    <bpmn:task id="send" name="Send the request to the approver Web service" />
    <bpmn:sequenceFlow id="f-received-assess" sourceRef="received" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-result" sourceRef="assess" targetRef="result" />
    <bpmn:sequenceFlow id="f-result-approve" name="Small loan and low risk customer" sourceRef="result" targetRef="approve" />
    <bpmn:sequenceFlow id="f-result-deny" name="High risk customer" sourceRef="result" targetRef="deny" />
    <bpmn:sequenceFlow id="f-result-send" name="Needs further review or loan amount of $10,000 or more" sourceRef="result" targetRef="send" />
    <bpmn:sequenceFlow id="f-approve-receive_feedback" sourceRef="approve" targetRef="receive_feedback" />
    <bpmn:sequenceFlow id="f-deny-receive_feedback" sourceRef="deny" targetRef="receive_feedback" />
    <bpmn:sequenceFlow id="f-send-receive_feedback" sourceRef="send" targetRef="receive_feedback" />
    <bpmn:sequenceFlow id="f-receive_feedback-done" sourceRef="receive_feedback" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
