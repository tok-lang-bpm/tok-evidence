tok 1.0 "Loan approval process"

pool loan "Loan approval organisation"
  lane customer "Customer"
    start received "Loan request received"
    task receive_feedback "Receive feedback"
    end done "Feedback received"
  lane risk "Risk assessment Web service"
    task assess "Assess the request"
    xor result "Assessment result?"
    task approve "Approve the loan"
    task deny "Deny the loan"
    task send "Send the request to the approver Web service"

flow received -> assess
flow assess -> result
flow result -> approve "Small loan and low risk customer"
flow result -> deny "High risk customer"
flow result -> send "Needs further review or loan amount of $10,000 or more"
flow approve -> receive_feedback
flow deny -> receive_feedback
flow send -> receive_feedback
flow receive_feedback -> done
