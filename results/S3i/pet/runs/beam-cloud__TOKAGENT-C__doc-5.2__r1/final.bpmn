<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacations Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Vacation request submitted" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="review" name="Review rejection reasons" />
    <bpmn:endEvent id="reviewed" name="Rejection reviewed" />
    <bpmn:task id="receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="decision" name="Approve or reject?" />
    <bpmn:task id="return" name="Return application" />
    <bpmn:task id="notify" name="Notify Human Resources Representative" />
    <bpmn:task id="complete" name="Complete management procedures" />
    <bpmn:endEvent id="completed" name="Management procedures completed" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-receive" sourceRef="submit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decision" sourceRef="receive" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-return" name="Reject" sourceRef="decision" targetRef="return" />
    <bpmn:sequenceFlow id="f-decision-notify" name="Approve" sourceRef="decision" targetRef="notify" />
    <bpmn:sequenceFlow id="f-return-review" sourceRef="return" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-reviewed" sourceRef="review" targetRef="reviewed" />
    <bpmn:sequenceFlow id="f-notify-complete" sourceRef="notify" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-completed" sourceRef="complete" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
