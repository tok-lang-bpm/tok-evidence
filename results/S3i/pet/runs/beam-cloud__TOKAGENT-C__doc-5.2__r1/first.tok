tok 1.0 "Vacations Request"

pool organization "Organization"
  lane employee "Employee"
    start submitted "Vacation request submitted"
    task submit "Submit vacation request"
    task review "Review rejection reasons"
    end reviewed "Rejection reviewed"
  lane supervisor "Immediate supervisor"
    task receive "Receive vacation request"
    xor decision "Approve or reject?"
    task return "Return application"
    task notify "Notify Human Resources Representative"
  lane hr "Human Resources Representative"
    task complete "Complete management procedures"
    end completed "Management procedures completed"

flow submitted -> submit -> receive -> decision
flow decision -> return "Reject"
flow decision -> notify "Approve"
flow return -> review -> reviewed
flow notify -> complete -> completed
