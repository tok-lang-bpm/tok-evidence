tok 1.0 "Expense report handling"

pool company "Company"
  lane employee "Employee"
    start required "Expense required"
    task purchase "Purchase product or service"
    task submit "Submit expense report"
    task edit "Edit expense report"
  lane supervisor "Supervisor"
    task review "Review expense report"
    xor approved "Expense report approved?"
  lane treasurer "Treasurer"
    task check "Check receipts"
    xor receipts "All receipts in order?"
    task accept "Accept expenses for processing"
    task sendback "Send report back to employee"
  lane payment "Payment system"
    task link "Link to payment system"
    task confirm "Receive payment confirmation"
    end paid "Expense paid"

flow required -> purchase -> submit -> review -> approved
flow approved -> edit "Rejected"
flow approved -> check "Approved"
flow edit -> review
flow check -> receipts
flow receipts -> accept "Yes"
flow receipts -> sendback "No"
flow accept -> link
flow link -> confirm -> paid
flow sendback -> edit
