<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice processing" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_sec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_ccm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify_vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult_ccm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend_ccm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_comm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file_signature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult_needed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ccm" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_internal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_accounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>all_correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="comm" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>check_4eyes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received" />
    <bpmn:task id="receive" name="Receive invoice" />
    <bpmn:task id="forward_sec" name="Forward invoice to accounting employee" />
    <bpmn:task id="identify" name="Identify charging suppliers" />
    <bpmn:task id="create" name="Create new invoice instance" />
    <bpmn:task id="check_items" name="Check invoice items" />
    <bpmn:task id="note_docket" name="Note cost centers and cost center managers on docket" />
    <bpmn:task id="send_ccm" name="Send docket and invoice copy to first cost center manager" />
    <bpmn:task id="clarify_vendor" name="Proceed with clarification with vendor" />
    <bpmn:task id="consult_ccm" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:task id="resend_ccm" name="Send invoice copy to cost center managers again" />
    <bpmn:task id="forward_comm" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="resolve_complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="file_signature" name="File invoice copy in signature file" />
    <bpmn:task id="pay" name="Give payment instructions" />
    <bpmn:task id="close" name="Close invoice instance" />
    <bpmn:endEvent id="done" name="Invoice processed" />
    <bpmn:exclusiveGateway id="consult_needed" name="Need to consult cost center managers?" />
    <bpmn:task id="review" name="Review content for accuracy" />
    <bpmn:task id="note_ap" name="Note accurate position (AP) on docket" />
    <bpmn:task id="return_internal" name="Return invoice copy to internal mail" />
    <bpmn:task id="reject_ap" name="Reject AP with note and explanatory statement" />
    <bpmn:task id="return_accounting" name="Send invoice copy back to accounting" />
    <bpmn:exclusiveGateway id="order" name="Everything in order?" />
    <bpmn:exclusiveGateway id="all_correct" name="All items marked correct?" />
    <bpmn:task id="audit" name="Make commercial audit" />
    <bpmn:task id="issue_approval" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint during commercial audit?" />
    <bpmn:exclusiveGateway id="amount" name="Bill amount exceeds EUR 20?" />
    <bpmn:task id="check_4eyes" name="Check invoice (4-eyes principle)" />
    <bpmn:sequenceFlow id="f-received-receive" sourceRef="received" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-forward_sec" sourceRef="receive" targetRef="forward_sec" />
    <bpmn:sequenceFlow id="f-forward_sec-identify" sourceRef="forward_sec" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-create" sourceRef="identify" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-check_items" sourceRef="create" targetRef="check_items" />
    <bpmn:sequenceFlow id="f-check_items-note_docket" sourceRef="check_items" targetRef="note_docket" />
    <bpmn:sequenceFlow id="f-note_docket-send_ccm" sourceRef="note_docket" targetRef="send_ccm" />
    <bpmn:sequenceFlow id="f-send_ccm-review" sourceRef="send_ccm" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-order" sourceRef="review" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-note_ap" name="yes" sourceRef="order" targetRef="note_ap" />
    <bpmn:sequenceFlow id="f-order-reject_ap" name="no" sourceRef="order" targetRef="reject_ap" />
    <bpmn:sequenceFlow id="f-note_ap-return_internal" sourceRef="note_ap" targetRef="return_internal" />
    <bpmn:sequenceFlow id="f-return_internal-all_correct" sourceRef="return_internal" targetRef="all_correct" />
    <bpmn:sequenceFlow id="f-all_correct-forward_comm" name="yes" sourceRef="all_correct" targetRef="forward_comm" />
    <bpmn:sequenceFlow id="f-all_correct-review" name="no" sourceRef="all_correct" targetRef="review" />
    <bpmn:sequenceFlow id="f-reject_ap-return_accounting" sourceRef="reject_ap" targetRef="return_accounting" />
    <bpmn:sequenceFlow id="f-return_accounting-clarify_vendor" sourceRef="return_accounting" targetRef="clarify_vendor" />
    <bpmn:sequenceFlow id="f-clarify_vendor-consult_needed" sourceRef="clarify_vendor" targetRef="consult_needed" />
    <bpmn:sequenceFlow id="f-consult_needed-consult_ccm" name="yes" sourceRef="consult_needed" targetRef="consult_ccm" />
    <bpmn:sequenceFlow id="f-consult_needed-resend_ccm" name="no" sourceRef="consult_needed" targetRef="resend_ccm" />
    <bpmn:sequenceFlow id="f-consult_ccm-resend_ccm" sourceRef="consult_ccm" targetRef="resend_ccm" />
    <bpmn:sequenceFlow id="f-resend_ccm-review" sourceRef="resend_ccm" targetRef="review" />
    <bpmn:sequenceFlow id="f-forward_comm-audit" sourceRef="forward_comm" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve_complaint" name="yes" sourceRef="complaint" targetRef="resolve_complaint" />
    <bpmn:sequenceFlow id="f-complaint-issue_approval" name="no" sourceRef="complaint" targetRef="issue_approval" />
    <bpmn:sequenceFlow id="f-resolve_complaint-audit" sourceRef="resolve_complaint" targetRef="audit" />
    <bpmn:sequenceFlow id="f-issue_approval-amount" sourceRef="issue_approval" targetRef="amount" />
    <bpmn:sequenceFlow id="f-amount-check_4eyes" name="yes" sourceRef="amount" targetRef="check_4eyes" />
    <bpmn:sequenceFlow id="f-amount-file_signature" name="no" sourceRef="amount" targetRef="file_signature" />
    <bpmn:sequenceFlow id="f-check_4eyes-file_signature" sourceRef="check_4eyes" targetRef="file_signature" />
    <bpmn:sequenceFlow id="f-file_signature-pay" sourceRef="file_signature" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-close" sourceRef="pay" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-done" sourceRef="close" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
