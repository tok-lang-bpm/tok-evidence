<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Order handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Organisation" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Order handling" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>monthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthly" name="Monthly on the first">
      <bpmn:timerEventDefinition id="monthly-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="place" name="Place the order" />
    <bpmn:task id="send" name="Send the order" />
    <bpmn:task id="receive" name="Receive the invoice" />
    <bpmn:endEvent id="done" name="Order handled" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:task id="invoice" name="Send an invoice" />
    <bpmn:sequenceFlow id="f-monthly-place" sourceRef="monthly" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-send" sourceRef="place" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-process" sourceRef="send" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-invoice" sourceRef="process" targetRef="invoice" />
    <bpmn:sequenceFlow id="f-invoice-receive" sourceRef="invoice" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-done" sourceRef="receive" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
