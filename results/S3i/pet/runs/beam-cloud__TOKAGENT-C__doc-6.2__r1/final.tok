tok 1.0 "Order handling"

pool company "Organisation"
  lane assembler "Assembler AG"
    start monthly "Monthly on the first" timer=P1M
    task place "Place the order"
    task send "Send the order"
    task receive "Receive the invoice"
    end done "Order handled"
  lane supplier "Supplier"
    task process "Process the order"
    task invoice "Send an invoice"

flow monthly -> place -> send -> process -> invoice -> receive -> done
