<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Potential customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Potential customer acquisition" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cb_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget_huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="development" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>pres_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pres_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentation_sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contacted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pres_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quotation_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>won</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>presentation_presales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="source_method" name="How to determine contact details?" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Know somebody interested in the product" />
    <bpmn:exclusiveGateway id="source_join" />
    <bpmn:task id="call" name="Start calling the customer" />
    <bpmn:parallelGateway id="contact_budget" />
    <bpmn:task id="contact" name="Determine contact person" />
    <bpmn:task id="budget" name="Determine budget available for project" />
    <bpmn:parallelGateway id="cb_join" />
    <bpmn:task id="ask" name="Ask whether generally interested" />
    <bpmn:exclusiveGateway id="interested" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="budget_huge" name="Potential project budget huge?" />
    <bpmn:exclusiveGateway id="interested_end" name="Customer interested in the end?" />
    <bpmn:task id="leave" name="Leave customer alone" />
    <bpmn:endEvent id="lost" name="Customer not acquired" />
    <bpmn:task id="acquire" name="Try to acquire the customer" />
    <bpmn:exclusiveGateway id="pres_merge" />
    <bpmn:exclusiveGateway id="pres_type" name="More technical presentation?" />
    <bpmn:task id="presentation_sales" name="Give detailed online presentation" />
    <bpmn:task id="call_customer" name="Call the customer" />
    <bpmn:task id="wait" name="Wait for customer to come back" />
    <bpmn:exclusiveGateway id="contacted" name="Contacted within 2 weeks?" />
    <bpmn:exclusiveGateway id="pres_join" />
    <bpmn:exclusiveGateway id="quotation_join" />
    <bpmn:task id="quotation" name="Create quotation" />
    <bpmn:endEvent id="won" name="Quotation created" />
    <bpmn:task id="presentation_presales" name="Give detailed online presentation" />
    <bpmn:sequenceFlow id="f-start-source_method" sourceRef="start" targetRef="source_method" />
    <bpmn:sequenceFlow id="f-source_method-buy" name="Buy details for cold calls" sourceRef="source_method" targetRef="buy" />
    <bpmn:sequenceFlow id="f-source_method-exhibit" name="Participate in exhibitions" sourceRef="source_method" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-source_method-know" name="Know somebody interested in the product" sourceRef="source_method" targetRef="know" />
    <bpmn:sequenceFlow id="f-buy-source_join" sourceRef="buy" targetRef="source_join" />
    <bpmn:sequenceFlow id="f-exhibit-source_join" sourceRef="exhibit" targetRef="source_join" />
    <bpmn:sequenceFlow id="f-know-source_join" sourceRef="know" targetRef="source_join" />
    <bpmn:sequenceFlow id="f-source_join-call" sourceRef="source_join" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-contact_budget" sourceRef="call" targetRef="contact_budget" />
    <bpmn:sequenceFlow id="f-contact_budget-contact" sourceRef="contact_budget" targetRef="contact" />
    <bpmn:sequenceFlow id="f-contact_budget-budget" sourceRef="contact_budget" targetRef="budget" />
    <bpmn:sequenceFlow id="f-contact-cb_join" sourceRef="contact" targetRef="cb_join" />
    <bpmn:sequenceFlow id="f-budget-cb_join" sourceRef="budget" targetRef="cb_join" />
    <bpmn:sequenceFlow id="f-cb_join-ask" sourceRef="cb_join" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-interested" sourceRef="ask" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-pres_merge" name="yes" sourceRef="interested" targetRef="pres_merge" />
    <bpmn:sequenceFlow id="f-interested-budget_huge" name="no" sourceRef="interested" targetRef="budget_huge" />
    <bpmn:sequenceFlow id="f-budget_huge-acquire" name="yes" sourceRef="budget_huge" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-budget_huge-leave" name="no" sourceRef="budget_huge" targetRef="leave" />
    <bpmn:sequenceFlow id="f-acquire-interested_end" sourceRef="acquire" targetRef="interested_end" />
    <bpmn:sequenceFlow id="f-interested_end-pres_merge" name="yes" sourceRef="interested_end" targetRef="pres_merge" />
    <bpmn:sequenceFlow id="f-interested_end-leave" name="no" sourceRef="interested_end" targetRef="leave" />
    <bpmn:sequenceFlow id="f-pres_merge-pres_type" sourceRef="pres_merge" targetRef="pres_type" />
    <bpmn:sequenceFlow id="f-pres_type-presentation_sales" name="no" sourceRef="pres_type" targetRef="presentation_sales" />
    <bpmn:sequenceFlow id="f-pres_type-presentation_presales" name="yes" sourceRef="pres_type" targetRef="presentation_presales" />
    <bpmn:sequenceFlow id="f-presentation_sales-pres_join" sourceRef="presentation_sales" targetRef="pres_join" />
    <bpmn:sequenceFlow id="f-presentation_presales-pres_join" sourceRef="presentation_presales" targetRef="pres_join" />
    <bpmn:sequenceFlow id="f-pres_join-wait" sourceRef="pres_join" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-contacted" sourceRef="wait" targetRef="contacted" />
    <bpmn:sequenceFlow id="f-contacted-quotation_join" name="yes" sourceRef="contacted" targetRef="quotation_join" />
    <bpmn:sequenceFlow id="f-contacted-call_customer" name="no" sourceRef="contacted" targetRef="call_customer" />
    <bpmn:sequenceFlow id="f-call_customer-quotation_join" sourceRef="call_customer" targetRef="quotation_join" />
    <bpmn:sequenceFlow id="f-quotation_join-quotation" sourceRef="quotation_join" targetRef="quotation" />
    <bpmn:sequenceFlow id="f-quotation-won" sourceRef="quotation" targetRef="won" />
    <bpmn:sequenceFlow id="f-leave-lost" sourceRef="leave" targetRef="lost" />
  </bpmn:process>
</bpmn:definitions>
