tok 1.0 "Potential customer acquisition"

pool org "Organisation"
  lane marketing "Marketing staff"
    start start "Start"
    xor source_method "How to determine contact details?"
    task buy "Buy details for cold calls"
    task exhibit "Participate in exhibitions"
    task know "Know somebody interested in the product"
    xor source_join
  lane callcenter "Call center staff"
    task call "Start calling the customer"
    and contact_budget
    task contact "Determine contact person"
    task budget "Determine budget available for project"
    and cb_join
    task ask "Ask whether generally interested"
    xor interested "Customer generally interested?"
    xor budget_huge "Potential project budget huge?"
    xor interested_end "Customer interested in the end?"
    task leave "Leave customer alone"
    end lost "Customer not acquired"
  lane development "Head of development"
    task acquire "Try to acquire the customer"
  lane sales "Sales representative"
    xor pres_merge
    xor pres_type "More technical presentation?"
    task presentation_sales "Give detailed online presentation"
    task call_customer "Call the customer"
    task wait "Wait for customer to come back"
    xor contacted "Contacted within 2 weeks?"
    xor pres_join
    xor quotation_join
    task quotation "Create quotation"
    end won "Quotation created"
  lane presales "Pre-sales employee"
    task presentation_presales "Give detailed online presentation"

flow start -> source_method
flow source_method -> buy "Buy details for cold calls"
flow source_method -> exhibit "Participate in exhibitions"
flow source_method -> know "Know somebody interested in the product"
flow buy -> source_join
flow exhibit -> source_join
flow know -> source_join
flow source_join -> call

flow call -> contact_budget
flow contact_budget -> contact
flow contact_budget -> budget
flow contact -> cb_join
flow budget -> cb_join
flow cb_join -> ask
flow ask -> interested

flow interested -> pres_merge "yes"
flow interested -> budget_huge "no"
flow budget_huge -> acquire "yes"
flow budget_huge -> leave "no"
flow acquire -> interested_end
flow interested_end -> pres_merge "yes"
flow interested_end -> leave "no"

flow pres_merge -> pres_type
flow pres_type -> presentation_sales "no"
flow pres_type -> presentation_presales "yes"
flow presentation_sales -> pres_join
flow presentation_presales -> pres_join
flow pres_join -> wait
flow wait -> contacted

flow contacted -> quotation_join "yes"
flow contacted -> call_customer "no"
flow call_customer -> quotation_join
flow quotation_join -> quotation
flow quotation -> won

flow leave -> lost
