tok 1.0 "Lead handling"

pool office "Office"
  lane manager "Manager"
    start s "Start"
    task check "Check the open leads"
    task select "Select the top five ones"
    task tell "Tell Sales Assistant to call the contact person of the leads"
    task process "Process the lead"
  lane assistant "Sales Assistant"
    xor morej "Join customers"
    xor mores "More customers to call?"
    task call "Call each customer"
    xor interested "Someone is interested?"
    task note "Send a note to the Manager"
    task next "Call the next customer"
    end e "All customers called"

flow s -> check -> select -> tell -> morej
flow morej -> mores
flow mores -> call "yes" default
flow mores -> e "no" when="noMoreCustomers"
flow call -> interested
flow interested -> note "interested" when="interested"
flow interested -> next "not interested" default
flow note -> process
flow process -> morej
flow next -> morej
