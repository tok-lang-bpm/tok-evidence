<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Lead handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Office" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Lead handling" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="check" name="Check the open leads" />
    <bpmn:task id="select" name="Select the top five ones" />
    <bpmn:task id="tell" name="Tell Sales Assistant to call the contact person of the leads" />
    <bpmn:task id="process" name="Process the lead" />
    <bpmn:endEvent id="e1" name="Lead processed" />
    <bpmn:task id="call" name="Call each customer" default="f-call-e2" />
    <bpmn:exclusiveGateway id="interested" name="Someone is interested?" default="f-interested-next" />
    <bpmn:task id="note" name="Send a note to the Manager" />
    <bpmn:task id="next" name="Call the next customer" />
    <bpmn:endEvent id="e2" name="All customers called" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-select" sourceRef="check" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-tell" sourceRef="select" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-call" sourceRef="tell" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-interested" sourceRef="call" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-note" name="yes" sourceRef="interested" targetRef="note">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-interested-next" name="no" sourceRef="interested" targetRef="next" />
    <bpmn:sequenceFlow id="f-note-process" sourceRef="note" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-e1" sourceRef="process" targetRef="e1" />
    <bpmn:sequenceFlow id="f-next-call" sourceRef="next" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-e2" sourceRef="call" targetRef="e2" />
  </bpmn:process>
</bpmn:definitions>
