tok 1.0 "Fill a post"

pool organisation "Organisation"
  lane process "Organisation"
    start demand "Demand to fill a post"
    task advertise "Advertise the post"
    task apply "Apply"
    task check "Check the applications"
    task conclude "Conclude the contract of employment"
    end filled "Post filled"

flow demand -> advertise -> apply -> check -> conclude -> filled
