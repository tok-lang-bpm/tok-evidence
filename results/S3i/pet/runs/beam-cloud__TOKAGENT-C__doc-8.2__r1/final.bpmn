<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job description handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job description handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="hr" name="HR clerk">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Vacancy reported" />
    <bpmn:task id="create" name="Create job description" />
    <bpmn:exclusiveGateway id="confusion" name="Confusion in message?" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:task id="submit" name="Submit job description for consideration" />
    <bpmn:task id="wait" name="Wait for approval" />
    <bpmn:task id="correct" name="Correct the description" />
    <bpmn:task id="post" name="Post the job" />
    <bpmn:endEvent id="posted" name="Job posted" />
    <bpmn:task id="reject" name="Reject and request correction" />
    <bpmn:exclusiveGateway id="approved" name="Job description approved?" />
    <bpmn:sequenceFlow id="f-reported-create" sourceRef="reported" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-confusion" sourceRef="create" targetRef="confusion" />
    <bpmn:sequenceFlow id="f-confusion-ask" name="yes" sourceRef="confusion" targetRef="ask" />
    <bpmn:sequenceFlow id="f-confusion-submit" name="no" sourceRef="confusion" targetRef="submit" />
    <bpmn:sequenceFlow id="f-ask-create" sourceRef="ask" targetRef="create" />
    <bpmn:sequenceFlow id="f-submit-wait" sourceRef="submit" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-approved" sourceRef="wait" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-post" name="yes" sourceRef="approved" targetRef="post" />
    <bpmn:sequenceFlow id="f-approved-reject" name="no" sourceRef="approved" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-correct" sourceRef="reject" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-submit" sourceRef="correct" targetRef="submit" />
    <bpmn:sequenceFlow id="f-post-posted" sourceRef="post" targetRef="posted" />
  </bpmn:process>
</bpmn:definitions>
