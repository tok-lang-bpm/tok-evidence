tok 1.0 "Job description handling"

pool org "Organisation"
  lane hr "HR clerk"
    start reported "Vacancy reported"
    task create "Create job description"
    xor confusion "Confusion in message?"
    task ask "Ask the Department again"
    task submit "Submit job description for consideration"
    task wait "Wait for approval"
    task correct "Correct the description"
    task post "Post the job"
    end posted "Job posted"
  lane dept "Department"
    task reject "Reject and request correction"
    xor approved "Job description approved?"

flow reported -> create -> confusion
flow confusion -> ask "yes"
flow confusion -> submit "no"
flow ask -> create
flow submit -> wait -> approved
flow approved -> post "yes"
flow approved -> reject "no"
flow reject -> correct -> submit
flow post -> posted
