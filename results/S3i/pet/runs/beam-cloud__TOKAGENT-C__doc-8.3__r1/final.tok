tok 1.0 "Personnel requirements"

pool organisation "Organisation"
  lane head "Head of functional department"
    start needed "Personnel requirements detected"
    task report "Report the vacancy"
    task clarify "Provide clarifications"
    task review "Review the job description"
    xor corrections "Corrections needed?"
    task request "Ask for corrections"
    task approve "Approve the job description"
  lane personnel "Personnel Department"
    xor questions "Questions about tasks and requirements?"
    task ask "Ask questions about tasks and requirements"
    task describe "Describe the job"
    task correct "Correct the job description"
    task advertise "Advertise the job description"
    end advertised "Job description advertised"

flow needed -> report
flow report -> questions
flow questions -> ask "yes" when="true"
flow questions -> describe "no" default
flow ask -> clarify
flow clarify -> describe
flow describe -> review
flow review -> corrections
flow corrections -> request "yes" when="true"
flow corrections -> approve "no" default
flow request -> correct
flow correct -> review
flow approve -> advertise
flow advertise -> advertised
