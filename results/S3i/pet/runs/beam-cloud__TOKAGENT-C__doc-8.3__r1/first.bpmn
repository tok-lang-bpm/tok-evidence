<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Personnel requirements" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Personnel requirements" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="personnel" name="Personnel Department">
        <bpmn:flowNodeRef>questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advertised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report the vacancy" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corrections" name="Corrections needed?" default="f-corrections-approve" />
    <bpmn:task id="request" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:exclusiveGateway id="questions" name="Questions about tasks and requirements?" default="f-questions-describe" />
    <bpmn:task id="ask" name="Ask questions about tasks and requirements" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="correct" name="Correct the job description" />
    <bpmn:task id="advertise" name="Advertise the job description" />
    <bpmn:endEvent id="advertised" name="Job description advertised" />
    <bpmn:sequenceFlow id="f-needed-report" sourceRef="needed" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-questions" sourceRef="report" targetRef="questions" />
    <bpmn:sequenceFlow id="f-questions-ask" name="yes" sourceRef="questions" targetRef="ask" />
    <bpmn:sequenceFlow id="f-questions-describe" name="no" sourceRef="questions" targetRef="describe" />
    <bpmn:sequenceFlow id="f-ask-clarify" sourceRef="ask" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-describe" sourceRef="clarify" targetRef="describe" />
    <bpmn:sequenceFlow id="f-describe-review" sourceRef="describe" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-corrections" sourceRef="review" targetRef="corrections" />
    <bpmn:sequenceFlow id="f-corrections-request" name="yes" sourceRef="corrections" targetRef="request" />
    <bpmn:sequenceFlow id="f-corrections-approve" name="no" sourceRef="corrections" targetRef="approve" />
    <bpmn:sequenceFlow id="f-request-correct" sourceRef="request" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-review" sourceRef="correct" targetRef="review" />
    <bpmn:sequenceFlow id="f-approve-advertise" sourceRef="approve" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-advertised" sourceRef="advertise" targetRef="advertised" />
  </bpmn:process>
</bpmn:definitions>
