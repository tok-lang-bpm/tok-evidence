<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Account defaulters processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" name="Account defaulters processing" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="team" name="Team">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_defaulter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_crm_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returns_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_crm_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returns_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert_supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message_supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_defaulter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_crm_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_crm_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>message_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Every weekday morning" />
    <bpmn:task id="backup" name="Back up the database" />
    <bpmn:task id="check_defaulter" name="Check the Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="found" name="New records found?" />
    <bpmn:task id="check_crm_first" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="returns_first" name="New returns exist?" />
    <bpmn:task id="register" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="advised" name="Previously advised?" />
    <bpmn:task id="report" name="Produce another table of defaulting accounts and send to account management" />
    <bpmn:task id="check_crm_second" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="returns_second" name="New returns filed?" />
    <bpmn:task id="reconcile" name="Reconcile with the existing account defaulters table" />
    <bpmn:task id="alert_supplier" name="Send an alert to the supervisor" />
    <bpmn:task id="message_supplier" name="Send a message to the supervisor" />
    <bpmn:boundaryEvent id="b_defaulter" name="Not completed by 2:30 pm" attachedToRef="check_defaulter">
      <bpmn:timerEventDefinition id="b_defaulter-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_crm_first" name="Not completed by 2:30 pm" attachedToRef="check_crm_first">
      <bpmn:timerEventDefinition id="b_crm_first-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_register" name="Not completed by 2:30 pm" attachedToRef="register">
      <bpmn:timerEventDefinition id="b_register-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_report" name="Not completed by 2:30 pm" attachedToRef="report">
      <bpmn:timerEventDefinition id="b_report-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_crm_second" name="Not completed by 4:00 pm" attachedToRef="check_crm_second">
      <bpmn:timerEventDefinition id="b_crm_second-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_reconcile" name="Not completed by 4:00 pm" attachedToRef="reconcile">
      <bpmn:timerEventDefinition id="b_reconcile-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="done" name="Process complete" />
    <bpmn:endEvent id="no_action" name="No further action" />
    <bpmn:endEvent id="alert_end" name="Alert sent" />
    <bpmn:endEvent id="message_end" name="Message sent" />
    <bpmn:sequenceFlow id="f-morning-backup" sourceRef="morning" targetRef="backup" />
    <bpmn:sequenceFlow id="f-backup-check_defaulter" sourceRef="backup" targetRef="check_defaulter" />
    <bpmn:sequenceFlow id="f-check_defaulter-found" sourceRef="check_defaulter" targetRef="found" />
    <bpmn:sequenceFlow id="f-found-check_crm_first" name="no" sourceRef="found" targetRef="check_crm_first" />
    <bpmn:sequenceFlow id="f-found-check_crm_second" name="yes" sourceRef="found" targetRef="check_crm_second" />
    <bpmn:sequenceFlow id="f-check_crm_first-returns_first" sourceRef="check_crm_first" targetRef="returns_first" />
    <bpmn:sequenceFlow id="f-returns_first-register" name="yes" sourceRef="returns_first" targetRef="register" />
    <bpmn:sequenceFlow id="f-returns_first-no_action" name="no" sourceRef="returns_first" targetRef="no_action" />
    <bpmn:sequenceFlow id="f-register-advised" sourceRef="register" targetRef="advised" />
    <bpmn:sequenceFlow id="f-advised-report" name="no" sourceRef="advised" targetRef="report" />
    <bpmn:sequenceFlow id="f-advised-check_crm_second" name="yes" sourceRef="advised" targetRef="check_crm_second" />
    <bpmn:sequenceFlow id="f-report-check_crm_second" sourceRef="report" targetRef="check_crm_second" />
    <bpmn:sequenceFlow id="f-check_crm_second-returns_second" sourceRef="check_crm_second" targetRef="returns_second" />
    <bpmn:sequenceFlow id="f-returns_second-reconcile" name="yes" sourceRef="returns_second" targetRef="reconcile" />
    <bpmn:sequenceFlow id="f-returns_second-done" name="no" sourceRef="returns_second" targetRef="done" />
    <bpmn:sequenceFlow id="f-reconcile-done" sourceRef="reconcile" targetRef="done" />
    <bpmn:sequenceFlow id="f-b_defaulter-alert_supplier" sourceRef="b_defaulter" targetRef="alert_supplier" />
    <bpmn:sequenceFlow id="f-b_crm_first-alert_supplier" sourceRef="b_crm_first" targetRef="alert_supplier" />
    <bpmn:sequenceFlow id="f-b_register-alert_supplier" sourceRef="b_register" targetRef="alert_supplier" />
    <bpmn:sequenceFlow id="f-b_report-alert_supplier" sourceRef="b_report" targetRef="alert_supplier" />
    <bpmn:sequenceFlow id="f-b_crm_second-message_supplier" sourceRef="b_crm_second" targetRef="message_supplier" />
    <bpmn:sequenceFlow id="f-b_reconcile-message_supplier" sourceRef="b_reconcile" targetRef="message_supplier" />
    <bpmn:sequenceFlow id="f-alert_supplier-alert_end" sourceRef="alert_supplier" targetRef="alert_end" />
    <bpmn:sequenceFlow id="f-message_supplier-message_end" sourceRef="message_supplier" targetRef="message_end" />
  </bpmn:process>
</bpmn:definitions>
