<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Mortgage offer handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Organisation" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Mortgage offer handling" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send" name="Send Mortgage offer" />
    <bpmn:task id="wait" name="Wait for reply" />
    <bpmn:exclusiveGateway id="response" name="Customer reply?" />
    <bpmn:task id="update" name="Update case details" />
    <bpmn:task id="archive" name="Archive work" />
    <bpmn:endEvent id="cancelled" name="Case cancelled" />
    <bpmn:exclusiveGateway id="docs" name="All prerequisite documents provided?" />
    <bpmn:task id="move" name="Move case to administration for completion" />
    <bpmn:endEvent id="handed" name="Case handed to administration" />
    <bpmn:task id="request" name="Generate message requesting outstanding documents" />
    <bpmn:endEvent id="requested" name="Outstanding documents requested" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-wait" sourceRef="send" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-response" sourceRef="wait" targetRef="response" />
    <bpmn:sequenceFlow id="f-response-update" name="Customer declines the mortgage" sourceRef="response" targetRef="update" />
    <bpmn:sequenceFlow id="f-response-docs" name="Customer sends completed offer documents" sourceRef="response" targetRef="docs" />
    <bpmn:sequenceFlow id="f-response-update-2" name="No answer after 2 weeks" sourceRef="response" targetRef="update" />
    <bpmn:sequenceFlow id="f-docs-move" name="All prerequisite documents provided" sourceRef="docs" targetRef="move" />
    <bpmn:sequenceFlow id="f-docs-request" name="All prerequisite documents not provided" sourceRef="docs" targetRef="request" />
    <bpmn:sequenceFlow id="f-update-archive" sourceRef="update" targetRef="archive" />
    <bpmn:sequenceFlow id="f-archive-cancelled" sourceRef="archive" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-move-handed" sourceRef="move" targetRef="handed" />
    <bpmn:sequenceFlow id="f-request-requested" sourceRef="request" targetRef="requested" />
  </bpmn:process>
</bpmn:definitions>
