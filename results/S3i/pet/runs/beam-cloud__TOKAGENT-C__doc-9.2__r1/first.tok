tok 1.0 "Mortgage offer handling"

pool office "Organisation"
  lane csr "Customer Service Representative"
    start s "Start"
    task send "Send Mortgage offer"
    task wait "Wait for reply"
    xor response "Customer reply?"
    task update "Update case details"
    task archive "Archive work"
    end cancelled "Case cancelled"
    xor docs "All prerequisite documents provided?"
    task move "Move case to administration for completion"
    end handed "Case handed to administration"
    task request "Generate message requesting outstanding documents"
    end requested "Outstanding documents requested"

flow s -> send -> wait -> response
flow response -> update "Customer declines the mortgage"
flow response -> docs "Customer sends completed offer documents"
flow response -> update "No answer after 2 weeks"
flow docs -> move "All prerequisite documents provided"
flow docs -> request "All prerequisite documents not provided"
flow update -> archive -> cancelled
flow move -> handed
flow request -> requested
