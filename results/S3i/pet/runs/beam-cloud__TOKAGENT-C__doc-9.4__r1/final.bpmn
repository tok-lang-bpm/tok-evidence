<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>finalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>update_calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ensure_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>hold_meeting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="office" name="Support Office">
        <bpmn:flowNodeRef>produce_minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_minutes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="finalized" name="Dates finalized" />
    <bpmn:task id="qa" name="Conduct QA check on the minutes" />
    <bpmn:task id="update_calendars" name="Update all group calendars" />
    <bpmn:task id="create_folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="ensure_docs" name="Ensure all appropriate documents are uploaded to system" />
    <bpmn:task id="advise" name="Advise Committee Members to read related documents" />
    <bpmn:task id="update_records" name="Update all departmental records" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:task id="hold_meeting" name="Hold meeting" />
    <bpmn:task id="produce_minutes" name="Produce minutes including Action Points" />
    <bpmn:task id="send_minutes" name="Send minutes to all Committee Members" />
    <bpmn:sequenceFlow id="f-finalized-update_calendars" sourceRef="finalized" targetRef="update_calendars" />
    <bpmn:sequenceFlow id="f-update_calendars-create_folders" sourceRef="update_calendars" targetRef="create_folders" />
    <bpmn:sequenceFlow id="f-create_folders-ensure_docs" sourceRef="create_folders" targetRef="ensure_docs" />
    <bpmn:sequenceFlow id="f-ensure_docs-advise" sourceRef="ensure_docs" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-hold_meeting" sourceRef="advise" targetRef="hold_meeting" />
    <bpmn:sequenceFlow id="f-hold_meeting-produce_minutes" sourceRef="hold_meeting" targetRef="produce_minutes" />
    <bpmn:sequenceFlow id="f-produce_minutes-qa" sourceRef="produce_minutes" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send_minutes" sourceRef="qa" targetRef="send_minutes" />
    <bpmn:sequenceFlow id="f-send_minutes-update_records" sourceRef="send_minutes" targetRef="update_records" />
    <bpmn:sequenceFlow id="f-update_records-done" sourceRef="update_records" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
