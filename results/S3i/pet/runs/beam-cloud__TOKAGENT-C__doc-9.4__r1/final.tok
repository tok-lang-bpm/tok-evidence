tok 1.0 "Committee meeting process"

pool org "Organisation"
  lane coordination "Coordination Unit"
    start finalized "Dates finalized"
    task qa "Conduct QA check on the minutes"
  lane support "Support Officer"
    task update_calendars "Update all group calendars"
    task create_folders "Create meeting folders for each meeting"
    task ensure_docs "Ensure all appropriate documents are uploaded to system"
    task advise "Advise Committee Members to read related documents"
    task update_records "Update all departmental records"
    end done "Process completed"
  lane members "Committee Members"
    task hold_meeting "Hold meeting"
  lane office "Support Office"
    task produce_minutes "Produce minutes including Action Points"
    task send_minutes "Send minutes to all Committee Members"

flow finalized -> update_calendars -> create_folders -> ensure_docs -> advise -> hold_meeting -> produce_minutes -> qa -> send_minutes -> update_records -> done
