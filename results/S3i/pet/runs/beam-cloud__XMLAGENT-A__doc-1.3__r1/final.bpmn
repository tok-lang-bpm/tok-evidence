assistant to=check_bpmnanalysis xml">
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Hotel" name="The Evanstonian" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>StartCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubmitTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AssignWaiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AlcGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GiveSomm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>FetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepNonAlc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOrder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartCall" name="Guest calls room service" />
    <bpmn:task id="TakeOrder" name="Take down order" />
    <bpmn:task id="SubmitTicket" name="Submit order ticket to kitchen" />
    <bpmn:task id="AssignWaiter" name="Assign order to waiter" />
    <bpmn:parallelGateway id="Split" />
    <bpmn:task id="PrepareFood" name="Prepare food" />
    <bpmn:exclusiveGateway id="AlcGate" name="Includes alcoholic beverage?" default="F_AlCNo" />
    <bpmn:task id="GiveSomm" name="Give order to sommelier" />
    <bpmn:task id="FetchWine" name="Fetch wine from cellar" />
    <bpmn:task id="PrepAlcohol" name="Prepare alcoholic beverages" />
    <bpmn:task id="ReadyCart" name="Ready cart" />
    <bpmn:task id="PrepNonAlc" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="Join" />
    <bpmn:task id="Deliver" name="Deliver to guest room" />
    <bpmn:task id="ReturnStation" name="Return to room-service station" />
    <bpmn:task id="Debit" name="Debit guest account" />
    <bpmn:endEvent id="EndOrder" name="Order completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="StartCall" targetRef="TakeOrder" />
    <bpmn:sequenceFlow id="F2" sourceRef="TakeOrder" targetRef="SubmitTicket" />
    <bpmn:sequenceFlow id="F3" sourceRef="SubmitTicket" targetRef="AssignWaiter" />
    <bpmn:sequenceFlow id<rfl:parameter name="="F4" sourceRef="AssignWaiter" targetRef="Split" />
    <bpmn:sequenceFlow id="F5" sourceRef="Split" targetRef="PrepareFood" />
    <bpmn:sequenceFlow id="F6" sourceRef="Split" targetRef="AlcGate" />
    <bpmn:sequenceFlow id="F7" sourceRef="Split" targetRef="ReadyCart" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="AlcGate" targetRef="GiveSomm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">includes alcohol</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_AlCNo" sourceRef="AlcGate" targetRef="Join" />
    <bpmn:sequenceFlow id="F9" sourceRef="GiveSomm" targetRef="FetchWine" />
    <bpmn:sequenceFlow id="F10" sourceRef="FetchWine" targetRef="PrepAlcohol" />
    <bpmn:sequenceFlow id="F11" sourceRef="PrepAlcohol" targetRef="Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="PrepareFood" targetRef="Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="ReadyCart" targetRef="PrepNonAlc" />
    <bpmn:sequenceFlow id="F14" sourceRef="PrepNonAlc" targetRef="Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Join" targetRef="Deliver" />
    <bpmn:sequenceFlow id="F16" sourceRef="Deliver" targetRef="ReturnStation" />
    <bpmn:sequenceFlow id="F17" sourceRef="ReturnStation" targetRef="Debit" />
    <bpmn:sequenceFlow id="F18" sourceRef="Debit" targetRef="EndOrder" />
  </bpmn:process>
</bpmn:definitions>
</rfl:parameter>
