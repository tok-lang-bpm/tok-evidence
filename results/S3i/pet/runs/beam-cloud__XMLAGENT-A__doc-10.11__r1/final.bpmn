<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_msp" name="MSP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_fail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1" name="Request the measurements to the MSP" />
    <bpmn:task id="t2" name="Check the received request" />
    <bpmn:exclusiveGateway id="g1" name="Deny or perform?" default="f4" />
    <bpmn:task id="t3a" name="Deny the request of the GO" />
    <bpmn:task id="t3b" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="g2" name="Reading failed?" default="f9" />
    <bpmn:task id="t4a" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="t4b" name="Transmit the measured values to the GO" />
    <bpmn:task id="t5" name="Process the measured values" />
    <bpmn:task id="t6" name="Send the changed values to the MSP" />
    <bpmn:task id="t7" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="end_fail" name="End" />
    <bpmn:endEvent id="end_success" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="deny" sourceRef="g1" targetRef="t3a" />
    <bpmn:sequenceFlow id="f5" name="perform" sourceRef="g1" targetRef="t3b" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3a" targetRef="t4a" />
    <bpmn:sequenceFlow id="f7" sourceRef="t3b" targetRef="g2" />
    <bpmn:sequenceFlow id="f8" name="failure" sourceRef="g2" targetRef="t4a" />
    <bpmn:sequenceFlow id="f9" name="success" sourceRef="g2" targetRef="t4b" />
    <bpmn:sequenceFlow id="f10" sourceRef="t4a" targetRef="end_fail" />
    <bpmn:sequenceFlow id="f11" sourceRef="t4b" targetRef="t5" />
    <bpmn:sequenceFlow id="f12" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f13" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f14" sourceRef="t7" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>
