<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="EC" name="EC">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Tell" name="tell INQ about change of master data" />
    <bpmn:task id="Task_Notify" name="notify IP of change" />
    <bpmn:task id="Task_Check" name="check whether master data can be changed at desired time" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Can master data be changed at desired time?" />
    <bpmn:task id="Task_Confirm" name="confirm changes of INQ" />
    <bpmn:task id="Task_Reject" name="reject changes of INQ" />
    <bpmn:endEvent id="EndEvent_Confirmed" name="Changes confirmed" />
    <bpmn:endEvent id="EndEvent_Rejected" name="Changes rejected" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Tell" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Tell" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Notify" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Check" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gateway_Decision" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gateway_Decision" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Confirm" targetRef="EndEvent_Confirmed" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Reject" targetRef="EndEvent_Rejected" />
  </bpmn:process>
</bpmn:definitions>
