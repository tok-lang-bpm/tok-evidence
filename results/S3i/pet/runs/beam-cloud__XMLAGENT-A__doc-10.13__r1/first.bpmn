<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-transmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process started" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request" />
    <bpmn:task id="answer" name="Answer the question" />
    <bpmn:exclusiveGateway id="outcome" name="Examination outcome?" />
    <bpmn:endEvent id="end-transmission" name="Transmission of data" />
    <bpmn:endEvent id="end-rejection" name="Rejection" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="transmit" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="answer" />
    <bpmn:sequenceFlow id="f4" sourceRef="answer" targetRef="outcome" />
    <bpmn:sequenceFlow id="f5" name="Transmission of data" sourceRef="outcome" targetRef="end-transmission" />
    <bpmn:sequenceFlow id="f6" name="Rejection" sourceRef="outcome" targetRef="end-rejection" />
  </bpmn:process>
</bpmn:definitions>