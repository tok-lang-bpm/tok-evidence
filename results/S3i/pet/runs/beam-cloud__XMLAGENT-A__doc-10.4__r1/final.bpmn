<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpoo" name="MPOO">
        <bpmn:flowNodeRef>gw_self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_go" name="GO">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_msp" name="MSP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1" name="Notify the MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="gw_self" name="Self dismounting?" default="f_no" />
    <bpmn:task id="t2a" name="Announce self dismounting to the MPON" />
    <bpmn:task id="t2b" name="Notify about no self-dismounting" />
    <bpmn:task id="t3a" name="Perform the final reading" />
    <bpmn:task id="t4a" name="Dismount the old equipment" />
    <bpmn:task id="t3b" name="Perform the final reading" />
    <bpmn:task id="t4b" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="gw_merge" />
    <bpmn:task id="t5" name="Mount the new device" />
    <bpmn:task id="t6" name="Read the meter count from the installed meter" />
    <bpmn:task id="t7" name="Send the values of the final reading to the GO" />
    <bpmn:task id="t8" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:task id="t9" name="Notify the MSP about the device changes, the master data, the meter count at dismounting, and the meter count at installation" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f_start" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f_t1_gw" sourceRef="t1" targetRef="gw_self" />
    <bpmn:sequenceFlow id="f_yes" name="self dismounting" sourceRef="gw_self" targetRef="t2a" />
    <bpmn:sequenceFlow id="f_no" name="no self-dismounting" sourceRef="gw_self" targetRef="t2b" />
    <bpmn:sequenceFlow id="f_t2a_t3a" sourceRef="t2a" targetRef="t3a" />
    <bpmn:sequenceFlow id="f_t3a_t4a" sourceRef="t3a" targetRef="t4a" />
    <bpmn:sequenceFlow id="f_t4a_merge" sourceRef="t4a" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="f_t2b_t3b" sourceRef="t2b" targetRef="t3b" />
    <bpmn:sequenceFlow id="f_t3b_t4b" sourceRef="t3b" targetRef="t4b" />
    <bpmn:sequenceFlow id="f_t4b_merge" sourceRef="t4b" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="f_merge_t5" sourceRef="gw_merge" targetRef="t5" />
    <bpmn:sequenceFlow id="f_t5_t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f_t6_t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f_t7_t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f_t8_t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f_t9_end" sourceRef="t9" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
