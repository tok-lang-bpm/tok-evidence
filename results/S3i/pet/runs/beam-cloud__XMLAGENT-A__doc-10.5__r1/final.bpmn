<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_bid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpoo" name="MPOO">
        <bpmn:flowNodeRef>send_tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_master_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process started" />
    <bpmn:task id="request_bid" name="Request a device takeover bid" />
    <bpmn:task id="send_tender" name="Send a tender for the equipment takeover" />
    <bpmn:task id="place_order" name="Place an order" />
    <bpmn:task id="confirm_order" name="Confirm the order" />
    <bpmn:task id="send_master_data" name="Send the master data" />
    <bpmn:endEvent id="end" name="Process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request_bid" />
    <bpmn:sequenceFlow id="f2" sourceRef="request_bid" targetRef="send_tender" />
    <bpmn:sequenceFlow id="f3" sourceRef="send_tender" targetRef="place_order" />
    <bpmn:sequenceFlow id="f4" sourceRef="place_order" targetRef="confirm_order" />
    <bpmn:sequenceFlow id="f5" sourceRef="confirm_order" targetRef="send_master_data" />
    <bpmn:sequenceFlow id="f6" sourceRef="send_master_data" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
