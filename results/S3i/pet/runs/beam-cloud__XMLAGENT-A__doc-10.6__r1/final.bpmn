<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="dismissal-process" />
  </bpmn:collaboration>
  <bpmn:process id="dismissal-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-mspn" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mspo" name="MSPO">
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" />
    <bpmn:task id="send-dismissal" name="Send a dismissal" />
    <bpmn:task id="review-dismissal" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Reject or confirm?" />
    <bpmn:task id="reject-dismissal" name="Reject the dismissal of the MSPN" />
    <bpmn:task id="confirm-dismissal" name="Confirm the dismissal of the MSPN" />
    <bpmn:endEvent id="end-rejected" />
    <bpmn:endEvent id="end-confirmed" />
    <bpmn:sequenceFlow id="flow-start-send" sourceRef="start" targetRef="send-dismissal" />
    <bpmn:sequenceFlow id="flow-send-review" sourceRef="send-dismissal" targetRef="review-dismissal" />
    <bpmn:sequenceFlow id="flow-review-decision" sourceRef="review-dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="flow-decision-reject" name="rejects" sourceRef="decision" targetRef="reject-dismissal" />
    <bpmn:sequenceFlow id="flow-decision-confirm" name="confirms" sourceRef="decision" targetRef="confirm-dismissal" />
    <bpmn:sequenceFlow id="flow-reject-end" sourceRef="reject-dismissal" targetRef="end-rejected" />
    <bpmn:sequenceFlow id="flow-confirm-end" sourceRef="confirm-dismissal" targetRef="end-confirmed" />
  </bpmn:process>
</bpmn:definitions>
