<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="TELECO" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customer-lane" name="Customer">
        <bpmn:flowNodeRef>start-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-perceive-degradation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-parameters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-receive-customer-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs-lane" name="Customer Service">
        <bpmn:flowNodeRef>task-enter-problem-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-compare-sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-determine-countermeasures-priorities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-reprioritize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-detailed-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-detailed-to-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-receive-actual-performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-receive-resolution-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-merge-reports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-cs-parallel-split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-customer-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-customer-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-report-rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-cs-parallel-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm-lane" name="Service Management">
        <bpmn:flowNodeRef>task-investigate-analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-detailed-to-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-analyze-problem-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-trouble-report-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-sm-analysis-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-prepare-final-status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-determine-countermeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-countermeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-actual-performance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-undertake-corrective-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-resolution-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-request-restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-restore-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-receive-troubleshoot-sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-resolution-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-resolution-report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp-lane" name="Resource Provisioning">
        <bpmn:flowNodeRef>task-receive-detailed-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-check-problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-problems-detected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-normal-notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-analyze-problem-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-trouble-report-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-rp-problems-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-include-status-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-status-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-receive-restore-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-track-errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-undertake-corrective-rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-troubleshoot-report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-troubleshoot-report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="es-lane" name="Electronic service">
        <bpmn:flowNodeRef>task-determine-significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing-lane" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>task-adjust-billing</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start-customer" name="Service degradation perceived" />
    <bpmn:task id="task-perceive-degradation" name="Perceive service degradation" />
    <bpmn:task id="task-send-parameters" name="Send problem parameters to Customer Service" />

    <bpmn:task id="task-enter-problem-report" name="Enter problem report into system T" />
    <bpmn:task id="task-compare-sla" name="Compare problem report to customer SLA" />
    <bpmn:task id="task-determine-countermeasures-priorities" name="Determine necessary counter measures and priorities" />
    <bpmn:task id="task-reprioritize" name="Re-prioritize counter measures" />
    <bpmn:task id="task-create-detailed-report" name="Create detailed problem report" />
    <bpmn:task id="task-send-detailed-to-sm" name="Send detailed problem report to Service Management" />
    <bpmn:task id="task-receive-actual-performance" name="Receive actual service performance" />
    <bpmn:task id="task-receive-resolution-report" name="Receive problem resolution report" />
    <bpmn:exclusiveGateway id="gw-merge-reports" name="Report received?" />
    <bpmn:parallelGateway id="gw-cs-parallel-split" />
    <bpmn:task id="task-create-customer-report" name="Create report for customer" />
    <bpmn:task id="task-send-customer-report" name="Send report to customer" />
    <bpmn:task id="task-report-rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="gw-cs-parallel-join" />
    <bpmn:endEvent id="end-cs" name="Process ends within Customer Service" />

    <bpmn:task id="task-investigate-analyzable" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="gw-analyzable" name="Problem analyzable by Service Management?" />
    <bpmn:task id="task-send-detailed-to-rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="task-analyze-problem-sm" name="Analyze problem" />
    <bpmn:task id="task-create-trouble-report-sm" name="Create trouble report" />
    <bpmn:exclusiveGateway id="gw-sm-analysis-join" name="Analysis joined" />
    <bpmn:task id="task-prepare-final-status" name="Prepare final status report" />
    <bpmn:task id="task-determine-countermeasures" name="Determine counter measures from final status report" />
    <bpmn:exclusiveGateway id="gw-countermeasures" name="Counter measures required?" />
    <bpmn:task id="task-send-actual-performance" name="Send actual service performance to Customer Service" />
    <bpmn:task id="task-undertake-corrective-sm" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="gw-resolution-join" name="Resolution path joined" />
    <bpmn:task id="task-create-request-restore" name="Create request for automatic resource restoration" />
    <bpmn:task id="task-send-restore-request" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="task-receive-troubleshoot-sm" name="Receive trouble-shooting report from Resource Provisioning" />
    <bpmn:task id="task-create-resolution-report" name="Create problem resolution report" />
    <bpmn:task id="task-send-resolution-report" name="Send problem resolution report to Customer Service" />

    <bpmn:task id="task-receive-detailed-rp" name="Receive detailed problem report" />
    <bpmn:task id="task-check-problems" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="gw-problems-detected" name="Problems detected?" />
    <bpmn:task id="task-create-normal-notification" name="Create notification about normal service execution" />
    <bpmn:task id="task-analyze-problem-rp" name="Analyze problem" />
    <bpmn:task id="task-create-trouble-report-rp" name="Create trouble report" />
    <bpmn:exclusiveGateway id="gw-rp-problems-join" name="Problem branch joined" />
    <bpmn:task id="task-include-status-report" name="Include trouble report or notification in status report" />
    <bpmn:task id="task-send-status-report" name="Send status report to Service Management" />
    <bpmn:task id="task-receive-restore-request" name="Receive restoration request" />
    <bpmn:task id="task-track-errors" name="Track all possible errors" />
    <bpmn:task id="task-undertake-corrective-rp" name="Undertake corrective actions" />
    <bpmn:task id="task-create-troubleshoot-report" name="Create trouble-shooting report" />
    <bpmn:task id="task-send-troubleshoot-report" name="Send trouble-shooting report to Service Management" />

    <bpmn:task id="task-determine-significance" name="Determine customer significance" />

    <bpmn:task id="task-adjust-billing" name="Adjust billing" />

    <bpmn:exclusiveGateway id="gw-premium" name="Customer premium?" />
    <bpmn:task id="task-link-extra-fix" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="gw-premium-join" name="Premium branch joined" />
    <bpmn:exclusiveGateway id="gw-affects" name="Customer significance affects counter measures?" />
    <bpmn:exclusiveGateway id="gw-affects-join" name="Significance branch joined" />

    <bpmn:endEvent id="end-customer" name="Process flow ends at customer" />
    <bpmn:task id="task-receive-customer-report" name="Receive report about service performance and problem resolution" />

    <!-- main flow -->
    <bpmn:sequenceFlow id="f-start-perceive" sourceRef="start-customer" targetRef="task-perceive-degradation" />
    <bpmn:sequenceFlow id="f-perceive-send" sourceRef="task-perceive-degradation" targetRef="task-send-parameters" />
    <bpmn:sequenceFlow id="f-send-enter" sourceRef="task-send-parameters" targetRef="task-enter-problem-report" />
    <bpmn:sequenceFlow id="f-enter-compare" sourceRef="task-enter-problem-report" targetRef="task-compare-sla" />
    <bpmn:sequenceFlow id="f-compare-determine" sourceRef="task-compare-sla" targetRef="task-determine-countermeasures-priorities" />
    <bpmn:sequenceFlow id="f-determine-significancegateway" sourceRef="task-determine-countermeasures-priorities" targetRef="gw-premium" />
    <bpmn:sequenceFlow id="f-premium-yes" name="yes" sourceRef="gw-premium" targetRef="task-link-extra-fix" />
    <bpmn:sequenceFlow id="f-premium-no" name="no" sourceRef="gw-premium" targetRef="gw-premium-join" />
    <bpmn:sequenceFlow id="f-link-join" sourceRef="task-link-extra-fix" targetRef="gw-premium-join" />
    <bpmn:sequenceFlow id="f-premiumjoin-affects" sourceRef="gw-premium-join" targetRef="gw-affects" />
    <bpmn:sequenceFlow id="f-affects-yes" name="yes" sourceRef="gw-affects" targetRef="task-reprioritize" />
    <bpmn:sequenceFlow id="f-affects-no" name="no" sourceRef="gw-affects" targetRef="gw-affects-join" />
    <bpmn:sequenceFlow id="f-reprioritize-join" sourceRef="task-reprioritize" targetRef="gw-affects-join" />
    <bpmn:sequenceFlow id="f-affectsjoin-detailed" sourceRef="gw-affects-join" targetRef="task-create-detailed-report" />
    <bpmn:sequenceFlow id="f-detailed-send" sourceRef="task-create-detailed-report" targetRef="task-send-detailed-to-sm" />

    <bpmn:sequenceFlow id="f-send-sm-investigate" sourceRef="task-send-detailed-to-sm" targetRef="task-investigate-analyzable" />
    <bpmn:sequenceFlow id="f-investigate-gateway" sourceRef="task-investigate-analyzable" targetRef="gw-analyzable" />
    <bpmn:sequenceFlow id="f-analyzable-no" name="not analyzable" sourceRef="gw-analyzable" targetRef="task-send-detailed-to-rp" />
    <bpmn:sequenceFlow id="f-sendrp-receive" sourceRef="task-send-detailed-to-rp" targetRef="task-receive-detailed-rp" />
    <bpmn:sequenceFlow id="f-receive-check" sourceRef="task-receive-detailed-rp" targetRef="task-check-problems" />
    <bpmn:sequenceFlow id="f-check-gateway" sourceRef="task-check-problems" targetRef="gw-problems-detected" />
    <bpmn:sequenceFlow id="f-problems-no" name="no" sourceRef="gw-problems-detected" targetRef="task-create-normal-notification" />
    <bpmn:sequenceFlow id="f-normal-include" sourceRef="task-create-normal-notification" targetRef="task-include-status-report" />
    <bpmn:sequenceFlow id="f-problems-yes" name="yes" sourceRef="gw-problems-detected" targetRef="task-analyze-problem-rp" />
    <bpmn:sequenceFlow id="f-analyze-trouble" sourceRef="task-analyze-problem-rp" targetRef="task-create-trouble-report-rp" />
    <bpmn:sequenceFlow id="f-trouble-include" sourceRef="task-create-trouble-report-rp" targetRef="task-include-status-report" />
    <bpmn:sequenceFlow id="f-include-sendstatus" sourceRef="task-include-status-report" targetRef="task-send-status-report" />
    <bpmn:sequenceFlow id="f-status-join" sourceRef="task-send-status-report" targetRef="gw-sm-analysis-join" />
    <bpmn:sequenceFlow id="f-analyzable-yes" name="analyzable" sourceRef="gw-analyzable" targetRef="task-analyze-problem-sm" />
    <bpmn:sequenceFlow id="f-analyze-trouble-sm" sourceRef="task-analyze-problem-sm" targetRef="task-create-trouble-report-sm" />
    <bpmn:sequenceFlow id="f-trouble-sm-join" sourceRef="task-create-trouble-report-sm" targetRef="gw-sm-analysis-join" />
    <bpmn:sequenceFlow id="f-smjoin-prepare" sourceRef="gw-sm-analysis-join" targetRef="task-prepare-final-status" />
    <bpmn:sequenceFlow id="f-prepare-determine" sourceRef="task-prepare-final-status" targetRef="task-determine-countermeasures" />
    <bpmn:sequenceFlow id="f-determine-gateway" sourceRef="task-determine-countermeasures" targetRef="gw-countermeasures" />

    <bpmn:sequenceFlow id="f-counter-no-problem" name="No problem detected" sourceRef="gw-countermeasures" targetRef="task-send-actual-performance" />
    <bpmn:sequenceFlow id="f-performance-receive" sourceRef="task-send-actual-performance" targetRef="task-receive-actual-performance" />

    <bpmn:sequenceFlow id="f-counter-minor" name="Minor corrective actions" sourceRef="gw-countermeasures" targetRef="task-undertake-corrective-sm" />
    <bpmn:sequenceFlow id="f-corrective-join" sourceRef="task-undertake-corrective-sm" targetRef="gw-resolution-join" />

    <bpmn:sequenceFlow id="f-counter-restore" name="Automatic resource restoration" sourceRef="gw-countermeasures" targetRef="task-create-request-restore" />
    <bpmn:sequenceFlow id="f-create-send-request" sourceRef="task-create-request-restore" targetRef="task-send-restore-request" />
    <bpmn:sequenceFlow id="f-sendrequest-receive" sourceRef="task-send-restore-request" targetRef="task-receive-restore-request" />
    <bpmn:sequenceFlow id="f-receive-track" sourceRef="task-receive-restore-request" targetRef="task-track-errors" />
    <bpmn:sequenceFlow id="f-track-corrective" sourceRef="task-track-errors" targetRef="task-undertake-corrective-rp" />
    <bpmn:sequenceFlow id="f-corrective-troubleshoot" sourceRef="task-undertake-corrective-rp" targetRef="task-create-troubleshoot-report" />
    <bpmn:sequenceFlow id="f-troubleshoot-send" sourceRef="task-create-troubleshoot-report" targetRef="task-send-troubleshoot-report" />
    <bpmn:sequenceFlow id="f-send-troubleshoot-receive" sourceRef="task-send-troubleshoot-report" targetRef="task-receive-troubleshoot-sm" />
    <bpmn:sequenceFlow id="f-receive-troubleshoot-resolutionjoin" sourceRef="task-receive-troubleshoot-sm" targetRef="gw-resolution-join" />

    <bpmn:sequenceFlow id="f-resolutionjoin-create" sourceRef="gw-resolution-join" targetRef="task-create-resolution-report" />
    <bpmn:sequenceFlow id="f-create-resolution-send" sourceRef="task-create-resolution-report" targetRef="task-send-resolution-report" />
    <bpmn:sequenceFlow id="f-send-resolution-receive" sourceRef="task-send-resolution-report" targetRef="task-receive-resolution-report" />

    <bpmn:sequenceFlow id="f-performance-merge" sourceRef="task-receive-actual-performance" targetRef="gw-merge-reports" />
    <bpmn:sequenceFlow id="f-resolution-merge" sourceRef="task-receive-resolution-report" targetRef="gw-merge-reports" />
    <bpmn:sequenceFlow id="f-merge-split" sourceRef="gw-merge-reports" targetRef="gw-cs-parallel-split" />
    <bpmn:sequenceFlow id="f-split-create" sourceRef="gw-cs-parallel-split" targetRef="task-create-customer-report" />
    <bpmn:sequenceFlow id="f-split-rebate" sourceRef="gw-cs-parallel-split" targetRef="task-report-rebate" />
    <bpmn:sequenceFlow id="f-create-send" sourceRef="task-create-customer-report" targetRef="task-send-customer-report" />
    <bpmn:sequenceFlow id="f-send-report-join" sourceRef="task-send-customer-report" targetRef="gw-cs-parallel-join" />
    <bpmn:sequenceFlow id="f-rebate-adjust" sourceRef="task-report-rebate" targetRef="task-adjust-billing" />
    <bpmn:sequenceFlow id="f-adjust-join" sourceRef="task-adjust-billing" targetRef="gw-cs-parallel-join" />
    <bpmn:sequenceFlow id="f-join-endcs" sourceRef="gw-cs-parallel-join" targetRef="end-cs" />
    <bpmn:sequenceFlow id="f-send-customer-report-customer" sourceRef="task-send-customer-report" targetRef="task-receive-customer-report" />
    <bpmn:sequenceFlow id="f-customer-report-end" sourceRef="task-receive-customer-report" targetRef="end-customer" />
  </bpmn:process>
</bpmn:definitions>
