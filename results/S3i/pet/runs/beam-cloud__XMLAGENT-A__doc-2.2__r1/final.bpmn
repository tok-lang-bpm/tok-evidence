<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckContractDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_SevenDays</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WithdrawOrConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ContractWithdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CustomerEnded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCustomerService" name="Customer service">
        <bpmn:flowNodeRef>Task_ReceiveData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCustomerObject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExistsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContractDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeAndResolveIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmationDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCISContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ImportMeterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CustomerServiceEnded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCIS" name="CIS">
        <bpmn:flowNodeRef>Task_CheckDocumentsInCIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsGenerated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegenerateDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequestToGridOperator</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneGridOperator" name="Grid operator">
        <bpmn:flowNodeRef>Task_CheckSupplierConcurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplierConcurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSuppliersDemandResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommunicateWithOldSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TerminateSalesAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SupplierConcurrenceResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MeterDataSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitMeterDataToCustomerService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitMeterDataToOldSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComputeFinalBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MeterDataJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostMeterSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GridOperatorEnded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneOldSupplier" name="Old supplier">
        <bpmn:flowNodeRef>Task_CreateFinalBillingAndSendToCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalBillingSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OldSupplierEnded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Switch-over request" />

    <bpmn:task id="Task_TransmitData" name="Transmit customer data to customer service" />
    <bpmn:task id="Task_ReceiveData" name="Receive customer data" />
    <bpmn:task id="Task_EnterCRM" name="Enter customer data into CRM system" />
    <bpmn:task id="Task_CheckCompleteness" name="Check data for completeness and plausibility" />
    <bpmn:exclusiveGateway id="Gateway_DataErrors" name="Data errors found?" default="Flow_8" />
    <bpmn:task id="Task_CorrectErrors" name="Correct errors based on error list" />
    <bpmn:exclusiveGateway id="Gateway_CustomerExists" name="Customer exists in database?" default="Flow_11" />
    <bpmn:task id="Task_CreateCustomerObject" name="Create new customer object" />
    <bpmn:exclusiveGateway id="Gateway_ExistsJoin" />
    <bpmn:task id="Task_PrepareContractDocuments" name="Prepare contract documents" />
    <bpmn:task id="Task_CheckDocumentsInCIS" name="Check contract documents in CIS" />
    <bpmn:exclusiveGateway id="Gateway_DocumentsGenerated" name="Contract documents generated successfully?" default="Flow_15" />
    <bpmn:task id="Task_AnalyzeAndResolveIssues" name="Analyze and resolve issues" />
    <bpmn:task id="Task_RegenerateDocuments" name="Regenerate contract documents" />
    <bpmn:task id="Task_SendConfirmationDocument" name="Send confirmation document to customer" />
    <bpmn:task id="Task_SendRequestToGridOperator" name="Send switch-over request to grid operator" />
    <bpmn:task id="Task_CheckSupplierConcurrence" name="Check request for supplier concurrence" />
    <bpmn:exclusiveGateway id="Gateway_SupplierConcurrence" name="Supplier concurrence?" default="Flow_26" />
    <bpmn:task id="Task_InformSuppliersDemandResolution" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:task id="Task_CommunicateWithOldSupplier" name="Communicate with old supplier" />
    <bpmn:task id="Task_TerminateSalesAgreement" name="Terminate sales agreement with old supplier" />
    <bpmn:endEvent id="EndEvent_SupplierConcurrenceResolved" name="Supplier concurrence resolved" />
    <bpmn:task id="Task_CreateCISContract" name="Create CIS contract" />
    <bpmn:task id="Task_CheckContractDetails" name="Check contract details" />
    <bpmn:boundaryEvent id="BoundaryEvent_SevenDays" attachedToRef="Task_CheckContractDetails" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_WithdrawOrConfirm" name="Contract withdrawn?" default="Flow_31" />
    <bpmn:exclusiveGateway id="Gateway_CustomerAccepted" />
    <bpmn:parallelGateway id="Gateway_MeterDataSplit" />
    <bpmn:task id="Task_TransmitMeterDataToCustomerService" name="Transmit power meter data to customer service" />
    <bpmn:task id="Task_TransmitMeterDataToOldSupplier" name="Transmit power meter data to old supplier" />
    <bpmn:task id="Task_ComputeFinalBilling" name="Compute final billing and send to old supplier" />
    <bpmn:parallelGateway id="Gateway_MeterDataJoin" />
    <bpmn:parallelGateway id="Gateway_PostMeterSplit" />
    <bpmn:task id="Task_ImportMeterData" name="Import meter data to systems" />
    <bpmn:endEvent id="EndEvent_CustomerServiceEnded" name="Process ended for customer service" />
    <bpmn:endEvent id="EndEvent_GridOperatorEnded" name="Process ended for grid operator" />
    <bpmn:task id="Task_CreateFinalBillingAndSendToCustomer" name="Create final billing and send to customer" />
    <bpmn:parallelGateway id="Gateway_FinalBillingSplit" />
    <bpmn:endEvent id="EndEvent_OldSupplierEnded" name="Process ended for old supplier" />
    <bpmn:endEvent id="EndEvent_CustomerEnded" name="Process ended for customer" />
    <bpmn:endEvent id="EndEvent_ContractWithdrawn" name="Contract withdrawn" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_TransmitData" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TransmitData" targetRef="Task_ReceiveData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReceiveData" targetRef="Task_EnterCRM" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EnterCRM" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckCompleteness" targetRef="Gateway_DataErrors" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gateway_DataErrors" targetRef="Task_CorrectErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">errorsFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CorrectErrors" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_DataErrors" targetRef="Gateway_CustomerExists" />
    <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gateway_CustomerExists" targetRef="Task_CreateCustomerObject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not customerExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CreateCustomerObject" targetRef="Gateway_ExistsJoin" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gateway_CustomerExists" targetRef="Gateway_ExistsJoin" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_ExistsJoin" targetRef="Task_PrepareContractDocuments" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareContractDocuments" targetRef="Task_CheckDocumentsInCIS" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CheckDocumentsInCIS" targetRef="Gateway_DocumentsGenerated" />
    <bpmn:sequenceFlow id="Flow_15" name="yes" sourceRef="Gateway_DocumentsGenerated" targetRef="Task_SendConfirmationDocument" />
    <bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="Gateway_DocumentsGenerated" targetRef="Task_AnalyzeAndResolveIssues">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not documentsGenerated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_AnalyzeAndResolveIssues" targetRef="Task_RegenerateDocuments" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RegenerateDocuments" targetRef="Task_CheckDocumentsInCIS" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SendConfirmationDocument" targetRef="Task_SendRequestToGridOperator" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SendRequestToGridOperator" targetRef="Task_CheckSupplierConcurrence" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CheckSupplierConcurrence" targetRef="Gateway_SupplierConcurrence" />
    <bpmn:sequenceFlow id="Flow_22" name="yes" sourceRef="Gateway_SupplierConcurrence" targetRef="Task_InformSuppliersDemandResolution">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supplierConcurrence</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_InformSuppliersDemandResolution" targetRef="Task_CommunicateWithOldSupplier" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_CommunicateWithOldSupplier" targetRef="Task_TerminateSalesAgreement" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_TerminateSalesAgreement" targetRef="EndEvent_SupplierConcurrenceResolved" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_SupplierConcurrence" targetRef="Task_CreateCISContract" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_CreateCISContract" targetRef="Task_CheckContractDetails" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_CheckContractDetails" targetRef="Gateway_WithdrawOrConfirm" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="BoundaryEvent_SevenDays" targetRef="Gateway_CustomerAccepted" />
    <bpmn:sequenceFlow id="Flow_30" name="yes" sourceRef="Gateway_WithdrawOrConfirm" targetRef="EndEvent_ContractWithdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">contractWithdrawn</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_WithdrawOrConfirm" targetRef="Gateway_CustomerAccepted" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Gateway_CustomerAccepted" targetRef="Gateway_MeterDataSplit" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_MeterDataSplit" targetRef="Task_TransmitMeterDataToCustomerService" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_MeterDataSplit" targetRef="Task_TransmitMeterDataToOldSupplier" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gateway_MeterDataSplit" targetRef="Task_ComputeFinalBilling" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_TransmitMeterDataToCustomerService" targetRef="Task_ImportMeterData" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_ImportMeterData" targetRef="EndEvent_CustomerServiceEnded" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_TransmitMeterDataToOldSupplier" targetRef="Gateway_MeterDataJoin" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_ComputeFinalBilling" targetRef="Gateway_MeterDataJoin" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Gateway_MeterDataJoin" targetRef="Gateway_PostMeterSplit" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Gateway_PostMeterSplit" targetRef="EndEvent_GridOperatorEnded" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Gateway_PostMeterSplit" targetRef="Task_CreateFinalBillingAndSendToCustomer" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_CreateFinalBillingAndSendToCustomer" targetRef="Gateway_FinalBillingSplit" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Gateway_FinalBillingSplit" targetRef="EndEvent_OldSupplierEnded" />
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Gateway_FinalBillingSplit" targetRef="EndEvent_CustomerEnded" />
  </bpmn:process>
</bpmn:definitions>
