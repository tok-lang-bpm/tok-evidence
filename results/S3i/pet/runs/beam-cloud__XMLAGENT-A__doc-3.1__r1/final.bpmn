assistant to=check_bpmnanalysis xml">
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneSet_1">
      <bpmn:lane id="lane_party" name="Party">
        <bpmn:flowNodeRef>start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_back_office" name="Client Service Back Office">
        <bpmn:flowNodeRef>task_receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_retrieve_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_forward_warrant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_store_physical_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_retrieve_respective_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_attach_new_sct_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_store_expanded_physical_file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_police" name="Queensland Police">
        <bpmn:flowNodeRef>task_send_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mc_staff" name="MC internal staff">
        <bpmn:flowNodeRef>task_receive_physical_sct_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_1" name="Start" />
    <bpmn:task id="task_send_request" name="Send warrant possession request" />
    <bpmn:task id="task_receive_request" name="Receive warrant possession request" />
    <bpmn:task id="task_retrieve_sct_file" name="Retrieve SCT file" />
    <bpmn:task id="task_forward_warrant" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="task_store_physical_file" name="Store SCT physical file" />
    <bpmn:task id="task_send_report" name="Send report" />
    <bpmn:task id="task_receive_report" name="Receive report" />
    <bpmn:task id="task_retrieve_respective_sct_file" name="Retrieve respective SCT file" />
    <bpmn:task id="task_attach_new_sct_document" name="Attach new SCT document" />
    <bpmn:task id="task_store_expanded_physical_file" name="Store expanded SCT physical file" />
    <bpmn:task id="task_receive_physical_sct_file" name="Receive physical SCT file" />
    <bpmn:endEvent id="end_1" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start_1" targetRef="task_send_request" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_send_request" targetRef="task_receive_request" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_receive_request" targetRef="task_retrieve_sct_file" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_retrieve_sct_file" targetRef="task_forward_warrant" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_forward_warrant" targetRef="task_store_physical_file" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_store_physical_file" targetRef="task_send_report" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_send_report" targetRef="task_receive_report" />
    <bpmn:sequenceFlow id="f8" sourceRef="task_receive_report" targetRef="task_retrieve_respective_sct_file" />
    <bpmn:sequenceFlow id="f9" sourceRef="task_retrieve_respective_sct_file" targetRef="task_attach_new_sct_document" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_attach_new_sct_document" targetRef="task_store_expanded_physical_file" />
    <bpmn:sequenceFlow id="f11" sourceRef="task_store_expanded_physical_file" targetRef="task_receive_physical_sct_file" />
    <bpmn:sequenceFlow id="f12" sourceRef="task_receive_physical_sct_file" targetRef="end_1" />
  </bpmn:process>
</bpmn:definitions>
</rfl:parameter>
