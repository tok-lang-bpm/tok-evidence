<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="court-staff" name="Court staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>files_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initiate_search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track_files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>files_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand_files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute_lawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct_hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Morning" />
    <bpmn:task id="check_files" name="Check files" />
    <bpmn:exclusiveGateway id="files_missing" name="Some files missing?" default="flow_track" />
    <bpmn:task id="initiate_search" name="Initiate a search" />
    <bpmn:task id="track_files" name="Track files to intended location" />
    <bpmn:exclusiveGateway id="files_ready" name="Files ready" />
    <bpmn:parallelGateway id="split_ready" />
    <bpmn:task id="hand_files" name="Hand files to Associate" />
    <bpmn:task id="distribute_lawlist" name="Distribute Judge's Lawlist" />
    <bpmn:parallelGateway id="join_ready" />
    <bpmn:task id="conduct_hearings" name="Conduct directions hearings" />
    <bpmn:endEvent id="end" name="Hearings conducted" />
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="check_files" />
    <bpmn:sequenceFlow id="flow_check" sourceRef="check_files" targetRef="files_missing" />
    <bpmn:sequenceFlow id="flow_missing" name="yes" sourceRef="files_missing" targetRef="initiate_search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">missing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_track" name="no" sourceRef="files_missing" targetRef="track_files" />
    <bpmn:sequenceFlow id="flow_search_ready" sourceRef="initiate_search" targetRef="files_ready" />
    <bpmn:sequenceFlow id="flow_track_ready" sourceRef="track_files" targetRef="files_ready" />
    <bpmn:sequenceFlow id="flow_ready_split" sourceRef="files_ready" targetRef="split_ready" />
    <bpmn:sequenceFlow id="flow_split_hand" sourceRef="split_ready" targetRef="hand_files" />
    <bpmn:sequenceFlow id="flow_split_distribute" sourceRef="split_ready" targetRef="distribute_lawlist" />
    <bpmn:sequenceFlow id="flow_hand_join" sourceRef="hand_files" targetRef="join_ready" />
    <bpmn:sequenceFlow id="flow_distribute_join" sourceRef="distribute_lawlist" targetRef="join_ready" />
    <bpmn:sequenceFlow id="flow_join_conduct" sourceRef="join_ready" targetRef="conduct_hearings" />
    <bpmn:sequenceFlow id="flow_conduct_end" sourceRef="conduct_hearings" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
