<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="claims_officer" name="Claims officer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior_claims_officer" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="recommend" name="Write a settlement recommendation" />
    <bpmn:task id="check" name="Check the settlement recommendation" />
    <bpmn:exclusiveGateway id="gateway" name="Claim OK?" />
    <bpmn:endEvent id="end_ok" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="examine" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f3" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f4" sourceRef="check" targetRef="gateway" />
    <bpmn:sequenceFlow id="f5" name="Not OK" sourceRef="gateway" targetRef="recommend" />
    <bpmn:sequenceFlow id="f6" name="OK" sourceRef="gateway" targetRef="end_ok" />
  </bpmn:process>
</bpmn:definitions>
