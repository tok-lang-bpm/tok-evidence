<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
    <bpmn:participant id="party" name="Party" />
    <bpmn:messageFlow id="mf_in" sourceRef="party" targetRef="start" />
    <bpmn:messageFlow id="mf_reject" sourceRef="send_back" targetRef="party" />
    <bpmn:messageFlow id="mf_post" sourceRef="post" targetRef="party" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mpu" name="Mail Processing Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mc" name="Mail Clerk">
        <bpmn:flowNodeRef>sort_unopened</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_registry" name="Registry">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sort_groups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_arm" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compile_requisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture_matter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_cashier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>put_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cashier" name="Cashier">
        <bpmn:flowNodeRef>take_fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture_party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Mail from party" />
    <bpmn:task id="collect" name="Collect mail" />
    <bpmn:task id="sort_unopened" name="Sort unopened mail" />
    <bpmn:task id="distribute" name="Distribute mail" />
    <bpmn:task id="open" name="Open mail" />
    <bpmn:task id="sort_groups" name="Sort mail into groups for distribution" />
    <bpmn:task id="register" name="Register mail in incoming Mail Register" />
    <bpmn:task id="quality" name="Perform quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="compile_requisition" name="Compile list of requisition" />
    <bpmn:task id="send_back" name="Send back to party" />
    <bpmn:endEvent id="end_rejected" name="Mail rejected" />
    <bpmn:task id="capture_matter" name="Capture matter details" />
    <bpmn:task id="provide_cashier" name="Provide matter details to Cashier" />
    <bpmn:task id="take_fees" name="Take applicable fees" />
    <bpmn:parallelGateway id="parallel_split" />
    <bpmn:task id="put_receipt" name="Put receipt and copied documents into an envelope" />
    <bpmn:task id="post" name="Post envelope to party" />
    <bpmn:task id="capture_party" name="Capture Party Details" />
    <bpmn:task id="print_file" name="Print Physical Court File" />
    <bpmn:parallelGateway id="parallel_join" />
    <bpmn:endEvent id="end_completed" name="Mail processed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="sort_unopened" />
    <bpmn:sequenceFlow id="f3" sourceRef="sort_unopened" targetRef="distribute" />
    <bpmn:sequenceFlow id="f4" sourceRef="distribute" targetRef="open" />
    <bpmn:sequenceFlow id="f5" sourceRef="open" targetRef="sort_groups" />
    <bpmn:sequenceFlow id="f6" sourceRef="sort_groups" targetRef="register" />
    <bpmn:sequenceFlow id="f7" sourceRef="register" targetRef="quality" />
    <bpmn:sequenceFlow id="f8" sourceRef="quality" targetRef="compliant" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="compliant" targetRef="compile_requisition" />
    <bpmn:sequenceFlow id="f10" sourceRef="compile_requisition" targetRef="send_back" />
    <bpmn:sequenceFlow id="f11" sourceRef="send_back" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="compliant" targetRef="capture_matter" />
    <bpmn:sequenceFlow id="f13" sourceRef="capture_matter" targetRef="provide_cashier" />
    <bpmn:sequenceFlow id="f14" sourceRef="provide_cashier" targetRef="take_fees" />
    <bpmn:sequenceFlow id="f15" sourceRef="take_fees" targetRef="parallel_split" />
    <bpmn:sequenceFlow id="f16" sourceRef="parallel_split" targetRef="put_receipt" />
    <bpmn:sequenceFlow id="f17" sourceRef="parallel_split" targetRef="capture_party" />
    <bpmn:sequenceFlow id="f18" sourceRef="put_receipt" targetRef="post" />
    <bpmn:sequenceFlow id="f19" sourceRef="post" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="capture_party" targetRef="print_file" />
    <bpmn:sequenceFlow id="f21" sourceRef="print_file" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f22" sourceRef="parallel_join" targetRef="end_completed" />
  </bpmn:process>
</bpmn:definitions>
