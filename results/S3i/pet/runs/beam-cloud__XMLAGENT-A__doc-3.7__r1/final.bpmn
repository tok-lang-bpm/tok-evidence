<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-claims-handler" name="Claims handler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search-and-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculate-estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-action-plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-claims-manager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate-settlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-claimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="search-and-file" name="Search the Police Report and put it in a file with the Claim Documentation" />
    <bpmn:task id="calculate-estimate" name="Calculate an initial claim estimate" />
    <bpmn:task id="create-action-plan" name="Create an Action Plan based on the Action Plan Checklist" />
    <bpmn:task id="negotiate-settlement" name="Negotiate a settlement on the claim estimate" />
    <bpmn:task id="inform-claimant" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="search-and-file" />
    <bpmn:sequenceFlow id="f2" sourceRef="search-and-file" targetRef="calculate-estimate" />
    <bpmn:sequenceFlow id="f3" sourceRef="calculate-estimate" targetRef="create-action-plan" />
    <bpmn:sequenceFlow id="f4" sourceRef="create-action-plan" targetRef="negotiate-settlement" />
    <bpmn:sequenceFlow id="f5" sourceRef="negotiate-settlement" targetRef="inform-claimant" />
    <bpmn:sequenceFlow id="f6" sourceRef="inform-claimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
