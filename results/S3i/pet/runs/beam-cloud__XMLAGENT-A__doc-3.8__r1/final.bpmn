<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="customerLane" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notificationLane" name="Notification department">
        <bpmn:flowNodeRef>checkDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handlingLane" name="Handling department">
        <bpmn:flowNodeRef>pickUpClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assessmentGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" />
    <bpmn:task id="submitClaim" name="Submit a claim" />
    <bpmn:task id="checkDocuments" name="Check documents upon completeness" />
    <bpmn:task id="registerClaim" name="Register claim" />
    <bpmn:task id="pickUpClaim" name="Pick up claim" />
    <bpmn:task id="checkInsurance" name="Check insurance" />
    <bpmn:task id="performAssessment" name="Perform assessment" />
    <bpmn:exclusiveGateway id="assessmentGateway" name="Assessment positive?" />
    <bpmn:task id="phoneGarage" name="Phone garage to authorise repairs" />
    <bpmn:task id="schedulePayment" name="Schedule payment" />
    <bpmn:task id="rejectClaim" name="Reject claim" />
    <bpmn:exclusiveGateway id="mergeGateway" />
    <bpmn:task id="sendLetter" name="Send letter to customer" />
    <bpmn:endEvent id="endEvent" name="Claim handled" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submitClaim" />
    <bpmn:sequenceFlow id="f2" sourceRef="submitClaim" targetRef="checkDocuments" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkDocuments" targetRef="registerClaim" />
    <bpmn:sequenceFlow id="f4" sourceRef="registerClaim" targetRef="pickUpClaim" />
    <bpmn:sequenceFlow id="f5" sourceRef="pickUpClaim" targetRef="checkInsurance" />
    <bpmn:sequenceFlow id="f6" sourceRef="checkInsurance" targetRef="performAssessment" />
    <bpmn:sequenceFlow id="f7" sourceRef="performAssessment" targetRef="assessmentGateway" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="assessmentGateway" targetRef="phoneGarage" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="assessmentGateway" targetRef="rejectClaim" />
    <bpmn:sequenceFlow id="f10" sourceRef="phoneGarage" targetRef="schedulePayment" />
    <bpmn:sequenceFlow id="f11" sourceRef="schedulePayment" targetRef="mergeGateway" />
    <bpmn:sequenceFlow id="f12" sourceRef="rejectClaim" targetRef="mergeGateway" />
    <bpmn:sequenceFlow id="f13" sourceRef="mergeGateway" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f14" sourceRef="sendLetter" targetRef="endEvent" />
  </bpmn:process>
</bpmn:definitions>
