<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental Health Care Institute" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneFamilyDoctor" name="Family Doctor">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskFdNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskFdSendCopy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSecretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>taskSoInquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoPutThrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoPrint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMergeNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoStoreDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoAddList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timerWed1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoStoreAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoPassCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwPar1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catchCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoInform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoAddCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMergeFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoAddTyped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwParJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timerWed2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSoProvide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneNursingOfficer" name="Nursing Officer">
        <bpmn:flowNodeRef>taskNoInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskNoRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskNoHandIn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSocialMedicalWorker" name="Social-Medical Worker">
        <bpmn:flowNodeRef>taskSmPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSmExamine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSmObservations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSmCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSmChecklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lanePhysician" name="Physician">
        <bpmn:flowNodeRef>taskPhPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskPhRecord</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lanePsychiatrist" name="Psychiatrist">
        <bpmn:flowNodeRef>taskPsyPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneTeamLeader" name="Team Leader">
        <bpmn:flowNodeRef>taskTlAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskTlMedicalFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskTlRecordAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskTlHandOver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Patient in need of mental treatment" />
    <bpmn:task id="taskFdNotice" name="Give notice by telephone" />
    <bpmn:task id="taskSoInquire" name="Inquire after name and residence" />
    <bpmn:task id="taskSoPutThrough" name="Put doctor through to nursing officer" />
    <bpmn:task id="taskNoInquiry" name="Make full inquiry into patient state" />
    <bpmn:task id="taskNoRecord" name="Record information on registration form" />
    <bpmn:task id="taskNoHandIn" name="Hand in registration form at secretarial office" />
    <bpmn:task id="taskSoStore" name="Store information in information system" />
    <bpmn:task id="taskSoPrint" name="Print information" />
    <bpmn:exclusiveGateway id="gwNew" name="New patient?" />
    <bpmn:task id="taskSoCreate" name="Create patient file" />
    <bpmn:exclusiveGateway id="gwMergeNew" />
    <bpmn:task id="taskSoStoreDocs" name="Store registration form and print in patient file" />
    <bpmn:task id="taskSoCards" name="Produce two registration cards" />
    <bpmn:task id="taskSoAddList" name="Add patient to list of new notices" />
    <bpmn:intermediateCatchEvent id="timerWed1" name="Wednesday staff meeting">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="taskTlAssign" name="Assign patients to team members" />
    <bpmn:task id="taskTlMedicalFile" name="Determine whether medical file required" />
    <bpmn:task id="taskTlRecordAssign" name="Record assignments on assignment list" />
    <bpmn:task id="taskTlHandOver" name="Hand over assignment list to secretarial office" />
    <bpmn:task id="taskSoStoreAssign" name="Store assignments in information system" />
    <bpmn:task id="taskSoPassCards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="gwPar1" />
    <bpmn:task id="taskSmPlan" name="Plan meeting with patient" />
    <bpmn:task id="taskSmExamine" name="Examine patient using standard checklist" />
    <bpmn:task id="taskSmObservations" name="Register additional observations in personal notebook" />
    <bpmn:task id="taskSmCopy" name="Put copy of notes in patient file" />
    <bpmn:task id="taskSmChecklist" name="Add standard checklist to patient file" />
    <bpmn:exclusiveGateway id="gwFile" name="Medical file required?" />
    <bpmn:task id="taskSoLetter" name="Prepare and send letter requesting medical file" />
    <bpmn:task id="taskFdSendCopy" name="Send copy of medical file" />
    <bpmn:intermediateCatchEvent id="catchCopy" name="Copy of medical file received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="taskSoInform" name="Inform second intaker" />
    <bpmn:task id="taskSoAddCopy" name="Add copy of medical file to patient file" />
    <bpmn:exclusiveGateway id="gwMergeFile" />
    <bpmn:task id="taskPhPlan" name="Plan first meeting with patient" />
    <bpmn:task id="taskPhRecord" name="Record observations on dictaphone" />
    <bpmn:task id="taskSoType" name="Type out dictaphone tapes" />
    <bpmn:task id="taskSoAddTyped" name="Add information to patient file" />
    <bpmn:parallelGateway id="gwParJoin" />
    <bpmn:task id="taskSoStatus" name="Put patient on list of patients that reach this status" />
    <bpmn:intermediateCatchEvent id="timerWed2" name="Wednesday staff meeting">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="taskSoProvide" name="Provide team leader with list" />
    <bpmn:task id="taskPsyPlan" name="Formulate treatment plan" />
    <bpmn:endEvent id="end" name="Intake ended" />
    <bpmn:sequenceFlow id="F01" sourceRef="start" targetRef="taskFdNotice" />
    <bpmn:sequenceFlow id="F02" sourceRef="taskFdNotice" targetRef="taskSoInquire" />
    <bpmn:sequenceFlow id="F03" sourceRef="taskSoInquire" targetRef="taskSoPutThrough" />
    <bpmn:sequenceFlow id="F04" sourceRef="taskSoPutThrough" targetRef="taskNoInquiry" />
    <bpmn:sequenceFlow id="F05" sourceRef="taskNoInquiry" targetRef="taskNoRecord" />
    <bpmn:sequenceFlow id="F06" sourceRef="taskNoRecord" targetRef="taskNoHandIn" />
    <bpmn:sequenceFlow id="F07" sourceRef="taskNoHandIn" targetRef="taskSoStore" />
    <bpmn:sequenceFlow id="F08" sourceRef="taskSoStore" targetRef="taskSoPrint" />
    <bpmn:sequenceFlow id="F09" sourceRef="taskSoPrint" targetRef="gwNew" />
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="gwNew" targetRef="taskSoCreate" />
    <bpmn:sequenceFlow id="F11" sourceRef="taskSoCreate" targetRef="gwMergeNew" />
    <bpmn:sequenceFlow id="F12" name="no" sourceRef="gwNew" targetRef="gwMergeNew" default="F12" />
    <bpmn:sequenceFlow id="F13" sourceRef="gwMergeNew" targetRef="taskSoStoreDocs" />
    <bpmn:sequenceFlow id="F14" sourceRef="taskSoStoreDocs" targetRef="taskSoCards" />
    <bpmn:sequenceFlow id="F15" sourceRef="taskSoCards" targetRef="taskSoAddList" />
    <bpmn:sequenceFlow id="F16" sourceRef="taskSoAddList" targetRef="timerWed1" />
    <bpmn:sequenceFlow id="F17" sourceRef="timerWed1" targetRef="taskTlAssign" />
    <bpmn:sequenceFlow id="F18" sourceRef="taskTlAssign" targetRef="taskTlMedicalFile" />
    <bpmn:sequenceFlow id="F19" sourceRef="taskTlMedicalFile" targetRef="taskTlRecordAssign" />
    <bpmn:sequenceFlow id="F20" sourceRef="taskTlRecordAssign" targetRef="taskTlHandOver" />
    <bpmn:sequenceFlow id="F21" sourceRef="taskTlHandOver" targetRef="taskSoStoreAssign" />
    <bpmn:sequenceFlow id="F22" sourceRef="taskSoStoreAssign" targetRef="taskSoPassCards" />
    <bpmn:sequenceFlow id="F23" sourceRef="taskSoPassCards" targetRef="gwPar1" />
    <bpmn:sequenceFlow id="F24" sourceRef="gwPar1" targetRef="taskSmPlan" />
    <bpmn:sequenceFlow id="F25" sourceRef="gwPar1" targetRef="gwFile" />
    <bpmn:sequenceFlow id="F26" sourceRef="taskSmPlan" targetRef="taskSmExamine" />
    <bpmn:sequenceFlow id="F27" sourceRef="taskSmExamine" targetRef="taskSmObservations" />
    <bpmn:sequenceFlow id="F28" sourceRef="taskSmObservations" targetRef="taskSmCopy" />
    <bpmn:sequenceFlow id="F29" sourceRef="taskSmCopy" targetRef="taskSmChecklist" />
    <bpmn:sequenceFlow id="F30" sourceRef="taskSmChecklist" targetRef="gwParJoin" />
    <bpmn:sequenceFlow id="F31" name="yes" sourceRef="gwFile" targetRef="taskSoLetter" />
    <bpmn:sequenceFlow id="F32" sourceRef="taskSoLetter" targetRef="taskFdSendCopy" />
    <bpmn:sequenceFlow id="F33" sourceRef="taskFdSendCopy" targetRef="catchCopy" />
    <bpmn:sequenceFlow id="F34" sourceRef="catchCopy" targetRef="taskSoInform" />
    <bpmn:sequenceFlow id="F35" sourceRef="taskSoInform" targetRef="taskSoAddCopy" />
    <bpmn:sequenceFlow id="F36" sourceRef="taskSoAddCopy" targetRef="gwMergeFile" />
    <bpmn:sequenceFlow id="F37" name="no" sourceRef="gwFile" targetRef="gwMergeFile" default="F37" />
    <bpmn:sequenceFlow id="F38" sourceRef="gwMergeFile" targetRef="taskPhPlan" />
    <bpmn:sequenceFlow id="F39" sourceRef="taskPhPlan" targetRef="taskPhRecord" />
    <bpmn:sequenceFlow id="F40" sourceRef="taskPhRecord" targetRef="taskSoType" />
    <bpmn:sequenceFlow id="F41" sourceRef="taskSoType" targetRef="taskSoAddTyped" />
    <bpmn:sequenceFlow id="F42" sourceRef="taskSoAddTyped" targetRef="gwParJoin" />
    <bpmn:sequenceFlow id="F43" sourceRef="gwParJoin" targetRef="taskSoStatus" />
    <bpmn:sequenceFlow id="F44" sourceRef="taskSoStatus" targetRef="timerWed2" />
    <bpmn:sequenceFlow id="F45" sourceRef="timerWed2" targetRef="taskSoProvide" />
    <bpmn:sequenceFlow id="F46" sourceRef="taskSoProvide" targetRef="taskPsyPlan" />
    <bpmn:sequenceFlow id="F47" sourceRef="taskPsyPlan" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
