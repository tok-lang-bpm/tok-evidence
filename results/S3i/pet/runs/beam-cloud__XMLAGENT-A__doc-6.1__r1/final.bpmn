<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ACME" name="ACME AG" processRef="ACME_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="ACME_PROCESS" isExecutable="false">
    <bpmn:laneSet id="ACME_LANES">
      <bpmn:lane id="LANE_SECRETARIAT" name="Secretariat">
        <bpmn:flowNodeRef>Start_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardVisual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ACCOUNTING" name="Accounting Employee">
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardCommercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Signature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvoiceProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COSTCENTER" name="Cost Center Manager">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Accurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_All</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COMMERCIAL" name="Commercial Manager">
        <bpmn:flowNodeRef>Task_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Amount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BOARD" name="Board">
        <bpmn:flowNodeRef>Task_4Eyes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_InvoiceReceived" name="Invoice received on paper or fax" />
    <bpmn:task id="Task_ReceiveInvoice" name="Receive invoice in central inbox" />
    <bpmn:task id="Task_ForwardVisual" name="Forward invoice after visual inspection" />
    <bpmn:task id="Task_Identify" name="Identify charging suppliers and create invoice instance" />
    <bpmn:task id="Task_Docket" name="Check invoice items and create docket" />
    <bpmn:task id="Task_SendFirst" name="Send invoice copy and docket to first cost center manager" />
    <bpmn:task id="Task_Review" name="Review invoice content for accuracy" />
    <bpmn:exclusiveGateway id="G_Accurate" name="Content accurate?" default="Flow_Reject" />
    <bpmn:task id="Task_AP" name="Note AP on docket and return invoice copy to internal mail" />
    <bpmn:exclusiveGateway id="G_All" name="All items marked AP?" default="Flow_Next" />
    <bpmn:task id="Task_Next" name="Forward invoice copy to next cost center manager" />
    <bpmn:task id="Task_Reject" name="Reject AP with note and return invoice copy to accounting" />
    <bpmn:task id="Task_Clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="G_Consult" name="Consult cost center managers?" default="Flow_Resend" />
    <bpmn:task id="Task_Consult" name="Consult cost center managers by telephone or email" />
    <bpmn:task id="Task_Resend" name="Resend invoice copy to cost center managers" />
    <bpmn:task id="Task_ForwardCommercial" name="Forward invoice copy to commercial manager" />
    <bpmn:task id="Task_Audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="G_Complaint" name="Complaint during audit?" default="Flow_Approval" />
    <bpmn:task id="Task_ResolveComplaint" name="Resolve complaint with supplier" />
    <bpmn:task id="Task_Approval" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="G_Amount" name="Invoice amount exceeds EUR 20?" default="Flow_Payment" />
    <bpmn:task id="Task_4Eyes" name="Perform 4-eyes check" />
    <bpmn:task id="Task_Signature" name="Receive invoice copy in signature file" />
    <bpmn:task id="Task_Payment" name="Give payment instructions" />
    <bpmn:task id="Task_Close" name="Close invoice instance in accounting system" />
    <bpmn:endEvent id="End_InvoiceProcessed" name="Invoice processed" />
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_InvoiceReceived" targetRef="Task_ReceiveInvoice" />
    <bpmn:sequenceFlow id="Flow_Receive" sourceRef="Task_ReceiveInvoice" targetRef="Task_ForwardVisual" />
    <bpmn:sequenceFlow id="Flow_Forward" sourceRef="Task_ForwardVisual" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_Identify" sourceRef="Task_Identify" targetRef="Task_Docket" />
    <bpmn:sequenceFlow id="Flow_Docket" sourceRef="Task_Docket" targetRef="Task_SendFirst" />
    <bpmn:sequenceFlow id="Flow_SendFirst" sourceRef="Task_SendFirst" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Review" sourceRef="Task_Review" targetRef="G_Accurate" />
    <bpmn:sequenceFlow id="Flow_AP" name="yes" sourceRef="G_Accurate" targetRef="Task_AP" />
    <bpmn:sequenceFlow id="Flow_Reject" name="no" sourceRef="G_Accurate" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_APDone" sourceRef="Task_AP" targetRef="G_All" />
    <bpmn:sequenceFlow id="Flow_AllDone" name="yes" sourceRef="G_All" targetRef="Task_ForwardCommercial" />
    <bpmn:sequenceFlow id="Flow_Next" name="no" sourceRef="G_All" targetRef="Task_Next" />
    <bpmn:sequenceFlow id="Flow_NextDone" sourceRef="Task_Next" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Task_Reject" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="Flow_Clarify" sourceRef="Task_Clarify" targetRef="G_Consult" />
    <bpmn:sequenceFlow id="Flow_ConsultYes" name="yes" sourceRef="G_Consult" targetRef="Task_Consult" />
    <bpmn:sequenceFlow id="Flow_Resend" name="no" sourceRef="G_Consult" targetRef="Task_Resend" />
    <bpmn:sequenceFlow id="Flow_ConsultDone" sourceRef="Task_Consult" targetRef="Task_Resend" />
    <bpmn:sequenceFlow id="Flow_ResendDone" sourceRef="Task_Resend" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Commercial" sourceRef="Task_ForwardCommercial" targetRef="Task_Audit" />
    <bpmn:sequenceFlow id="Flow_Audit" sourceRef="Task_Audit" targetRef="G_Complaint" />
    <bpmn:sequenceFlow id="Flow_ComplaintYes" name="yes" sourceRef="G_Complaint" targetRef="Task_ResolveComplaint" />
    <bpmn:sequenceFlow id="Flow_Approval" name="no" sourceRef="G_Complaint" targetRef="Task_Approval" />
    <bpmn:sequenceFlow id="Flow_ResolveDone" sourceRef="Task_ResolveComplaint" targetRef="Task_Audit" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Task_Approval" targetRef="G_Amount" />
    <bpmn:sequenceFlow id="Flow_Over20" name="yes" sourceRef="G_Amount" targetRef="Task_4Eyes" />
    <bpmn:sequenceFlow id="Flow_Payment" name="no" sourceRef="G_Amount" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_4EyesDone" sourceRef="Task_4Eyes" targetRef="Task_Signature" />
    <bpmn:sequenceFlow id="Flow_SignatureDone" sourceRef="Task_Signature" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_PaymentDone" sourceRef="Task_Payment" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="Flow_Close" sourceRef="Task_Close" targetRef="End_InvoiceProcessed" />
  </bpmn:process>
</bpmn:definitions>
