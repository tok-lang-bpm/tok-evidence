<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_assembler" name="Assembler AG">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_supplier" name="Supplier">
        <bpmn:flowNodeRef>task_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_c</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="First of each month">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="task_a" name="a. Assembler AG sends the order to the supplier" />
    <bpmn:task id="task_b" name="b. Supplier processes the order" />
    <bpmn:task id="task_c" name="c. Supplier sends the invoice to Assembler AG" />
    <bpmn:task id="task_d" name="d. Assembler AG receives the invoice" />
    <bpmn:endEvent id="end_event" name="Process complete" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_event" targetRef="task_a" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_a" targetRef="task_b" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_b" targetRef="task_c" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_c" targetRef="task_d" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_d" targetRef="end_event" />
  </bpmn:process>
</bpmn:definitions>
