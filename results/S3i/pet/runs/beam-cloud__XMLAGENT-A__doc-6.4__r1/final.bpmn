<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="MsgCustomerResponse" name="Customer response" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-org" name="Organisation">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-methods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy-details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know-person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-methods-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev-wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch-msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch-timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave-alone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-marketing" name="Marketing staff">
        <bpmn:flowNodeRef>exhibitions</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-callcenter" name="Call center staff">
        <bpmn:flowNodeRef>start-calling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask-interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-budget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-development" name="Head of development">
        <bpmn:flowNodeRef>acquire-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-interested-after</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-sales" name="Sales representative">
        <bpmn:flowNodeRef>gw-to-presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-technical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present-sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-pres-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-wait-merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-quotation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-presales" name="Pre-sales employee">
        <bpmn:flowNodeRef>present-presales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="gw-methods" name="How to get contact details?" />
    <bpmn:task id="buy-details" name="Buy details for cold calls" />
    <bpmn:task id="exhibitions" name="Participate in exhibitions" />
    <bpmn:task id="know-person" name="Know somebody interested in the product" />
    <bpmn:exclusiveGateway id="gw-methods-merge" />
    <bpmn:task id="start-calling" name="Start calling the customer" />
    <bpmn:task id="determine-contact" name="Determine the contact person" />
    <bpmn:task id="determine-budget" name="Determine the available budget" />
    <bpmn:task id="ask-interested" name="Ask whether customer is interested" />
    <bpmn:exclusiveGateway id="gw-interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="gw-budget" name="Budget huge?" />
    <bpmn:task id="acquire-customer" name="Acquire the customer personally" />
    <bpmn:exclusiveGateway id="gw-interested-after" name="Customer interested after acquisition?" />
    <bpmn:exclusiveGateway id="gw-to-presentation" />
    <bpmn:exclusiveGateway id="gw-technical" name="Technical presentation?" />
    <bpmn:task id="present-sales" name="Give detailed online presentation" />
    <bpmn:task id="present-presales" name="Give detailed online presentation (technical)" />
    <bpmn:exclusiveGateway id="gw-pres-merge" />
    <bpmn:eventBasedGateway id="ev-wait" />
    <bpmn:intermediateCatchEvent id="catch-msg" name="Customer contacts us">
      <bpmn:messageEventDefinition messageRef="MsgCustomerResponse" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch-timer" name="Not contacted within 2 weeks">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT2W</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="call-customer" name="Call the customer" />
    <bpmn:exclusiveGateway id="gw-wait-merge" />
    <bpmn:task id="create-quotation" name="Create a quotation" />
    <bpmn:endEvent id="leave-alone" name="Leave customer alone" />
    <bpmn:endEvent id="end" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gw-methods" />
    <bpmn:sequenceFlow id="f2" name="Buy" sourceRef="gw-methods" targetRef="buy-details" />
    <bpmn:sequenceFlow id="f3" name="Exhibitions" sourceRef="gw-methods" targetRef="exhibitions" />
    <bpmn:sequenceFlow id="f4" name="Personal contact" sourceRef="gw-methods" targetRef="know-person" />
    <bpmn:sequenceFlow id="f5" sourceRef="buy-details" targetRef="gw-methods-merge" />
    <bpmn:sequenceFlow id="f6" sourceRef="exhibitions" targetRef="gw-methods-merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="know-person" targetRef="gw-methods-merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="gw-methods-merge" targetRef="start-calling" />
    <bpmn:sequenceFlow id="f9" sourceRef="start-calling" targetRef="determine-contact" />
    <bpmn:sequenceFlow id="f10" sourceRef="determine-contact" targetRef="determine-budget" />
    <bpmn:sequenceFlow id="f11" sourceRef="determine-budget" targetRef="ask-interested" />
    <bpmn:sequenceFlow id="f12" sourceRef="ask-interested" targetRef="gw-interested" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="gw-interested" targetRef="gw-to-presentation" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="gw-interested" targetRef="gw-budget" />
    <bpmn:sequenceFlow id="f15" name="yes" sourceRef="gw-budget" targetRef="acquire-customer" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gw-budget" targetRef="leave-alone" />
    <bpmn:sequenceFlow id="f17" sourceRef="acquire-customer" targetRef="gw-interested-after" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="gw-interested-after" targetRef="gw-to-presentation" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="gw-interested-after" targetRef="leave-alone" />
    <bpmn:sequenceFlow id="f20" sourceRef="gw-to-presentation" targetRef="gw-technical" />
    <bpmn:sequenceFlow id="f21" name="no" sourceRef="gw-technical" targetRef="present-sales" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="gw-technical" targetRef="present-presales" />
    <bpmn:sequenceFlow id="f23" sourceRef="present-sales" targetRef="gw-pres-merge" />
    <bpmn:sequenceFlow id="f24" sourceRef="present-presales" targetRef="gw-pres-merge" />
    <bpmn:sequenceFlow id="f25" sourceRef="gw-pres-merge" targetRef="ev-wait" />
    <bpmn:sequenceFlow id="f26" sourceRef="ev-wait" targetRef="catch-msg" />
    <bpmn:sequenceFlow id="f27" sourceRef="ev-wait" targetRef="catch-timer" />
    <bpmn:sequenceFlow id="f28" sourceRef="catch-msg" targetRef="gw-wait-merge" />
    <bpmn:sequenceFlow id="f29" sourceRef="catch-timer" targetRef="call-customer" />
    <bpmn:sequenceFlow id="f30" sourceRef="call-customer" targetRef="gw-wait-merge" />
    <bpmn:sequenceFlow id="f31" sourceRef="gw-wait-merge" targetRef="create-quotation" />
    <bpmn:sequenceFlow id="f32" sourceRef="create-quotation" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
