<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="manager" name="Manager">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkOpenLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellSalesAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="salesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>callContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestedGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callNext</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="checkOpenLeads" name="Check the open leads" />
    <bpmn:task id="selectTopFive" name="Select the top five leads" />
    <bpmn:task id="tellSalesAssistant" name="Tell the Sales Assistant to call the contact person of the leads" />
    <bpmn:task id="callContact" name="Call the contact person of the leads" />
    <bpmn:exclusiveGateway id="interestedGw" name="Is the customer interested?" />
    <bpmn:task id="sendNote" name="Send a note to the Manager" />
    <bpmn:task id="processLead" name="Process the lead" />
    <bpmn:task id="callNext" name="Call the next customer" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="checkOpenLeads" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkOpenLeads" targetRef="selectTopFive" />
    <bpmn:sequenceFlow id="f3" sourceRef="selectTopFive" targetRef="tellSalesAssistant" />
    <bpmn:sequenceFlow id="f4" sourceRef="tellSalesAssistant" targetRef="callContact" />
    <bpmn:sequenceFlow id="f5" sourceRef="callContact" targetRef="interestedGw" />
    <bpmn:sequenceFlow id="f6" name="Interested" sourceRef="interestedGw" targetRef="sendNote" />
    <bpmn:sequenceFlow id="f7" sourceRef="sendNote" targetRef="processLead" />
    <bpmn:sequenceFlow id="f8" sourceRef="processLead" targetRef="end1" />
    <bpmn:sequenceFlow id="f9" name="Not interested" sourceRef="interestedGw" targetRef="callNext" />
    <bpmn:sequenceFlow id="f10" sourceRef="callNext" targetRef="callContact" />
  </bpmn:process>
</bpmn:definitions>
