<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="coordination-unit" name="Coordination Unit">
        <bpmn:flowNodeRef>dates-finalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct-qa-check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support-officer" name="Support Officer">
        <bpmn:flowNodeRef>update-calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-meeting-folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ensure-documents-uploaded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise-committee-members</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce-minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update-departmental-records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process-complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee-members" name="Committee Members">
        <bpmn:flowNodeRef>read-related-documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold-meeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="dates-finalized" name="Dates finalized" />
    <bpmn:task id="update-calendars" name="Update all group calendars" />
    <bpmn:task id="create-meeting-folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="ensure-documents-uploaded" name="Ensure all appropriate documents are uploaded to system" />
    <bpmn:task id="advise-committee-members" name="Advise Committee Members a week before each meeting" />
    <bpmn:task id="read-related-documents" name="Read all related documents" />
    <bpmn:task id="hold-meeting" name="Hold meeting" />
    <bpmn:task id="produce-minutes" name="Produce minutes including Action Points" />
    <bpmn:task id="conduct-qa-check" name="Conduct QA check on minutes" />
    <bpmn:task id="send-minutes" name="Send minutes to all Committee Members" />
    <bpmn:task id="update-departmental-records" name="Update all departmental records" />
    <bpmn:endEvent id="process-complete" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="dates-finalized" targetRef="update-calendars" />
    <bpmn:sequenceFlow id="f2" sourceRef="update-calendars" targetRef="create-meeting-folders" />
    <bpmn:sequenceFlow id="f3" sourceRef="create-meeting-folders" targetRef="ensure-documents-uploaded" />
    <bpmn:sequenceFlow id="f4" sourceRef="ensure-documents-uploaded" targetRef="advise-committee-members" />
    <bpmn:sequenceFlow id="f5" sourceRef="advise-committee-members" targetRef="read-related-documents" />
    <bpmn:sequenceFlow id="f6" sourceRef="read-related-documents" targetRef="hold-meeting" />
    <bpmn:sequenceFlow id="f7" sourceRef="hold-meeting" targetRef="produce-minutes" />
    <bpmn:sequenceFlow id="f8" sourceRef="produce-minutes" targetRef="conduct-qa-check" />
    <bpmn:sequenceFlow id="f9" sourceRef="conduct-qa-check" targetRef="send-minutes" />
    <bpmn:sequenceFlow id="f10" sourceRef="send-minutes" targetRef="update-departmental-records" />
    <bpmn:sequenceFlow id="f11" sourceRef="update-departmental-records" targetRef="process-complete" />
  </bpmn:process>
</bpmn:definitions>
