<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_waiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prepare_food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>fetch_wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>ready_cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_nonalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Guest calls room service" />
    <bpmn:task id="take_order" name="Take down the order" />
    <bpmn:task id="submit_ticket" name="Submit an order ticket to the kitchen" />
    <bpmn:task id="give_order" name="Give an order to the sommelier" />
    <bpmn:task id="assign_waiter" name="Assign the order to the waiter" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="prepare_food" name="Prepare the food" />
    <bpmn:task id="fetch_wine" name="Fetch wine from the cellar and prepare alcoholic beverages" />
    <bpmn:task id="ready_cart" name="Ready a cart" />
    <bpmn:task id="prepare_nonalc" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="end" name="Order handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="take_order" />
    <bpmn:sequenceFlow id="f2" sourceRef="take_order" targetRef="submit_ticket" />
    <bpmn:sequenceFlow id="f3" sourceRef="submit_ticket" targetRef="give_order" />
    <bpmn:sequenceFlow id="f4" sourceRef="give_order" targetRef="assign_waiter" />
    <bpmn:sequenceFlow id="f5" sourceRef="assign_waiter" targetRef="split" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="prepare_food" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="fetch_wine" />
    <bpmn:sequenceFlow id="f8" sourceRef="split" targetRef="ready_cart" />
    <bpmn:sequenceFlow id="f9" sourceRef="prepare_food" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="fetch_wine" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="ready_cart" targetRef="prepare_nonalc" />
    <bpmn:sequenceFlow id="f12" sourceRef="prepare_nonalc" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f14" sourceRef="deliver" targetRef="debit" />
    <bpmn:sequenceFlow id="f15" sourceRef="debit" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
