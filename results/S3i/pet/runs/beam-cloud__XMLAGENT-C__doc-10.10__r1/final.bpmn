assistant to=check_bpmnanalysis xml"xml">
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="fault_detector" name="Fault detector">
        <bpmn:flowNodeRef>start_reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>start_suspicion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_go_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_msp_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_go_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_msp_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_reported" name="Failure reported" />
    <bpmn:task id="report" name="Report a failure" />
    <bpmn:startEvent id="start_suspicion" name="Suspicion of own fault" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="decision" name="Fault confirmed?" />
    <bpmn:task id="reject" name="Reject the failure of the fault detector" />
    <bpmn:task id="confirm" name="Confirm the failure of the fault detector" />
    <bpmn:parallelGateway id="notify_split" />
    <bpmn:task id="inform_go_fail" name="Inform the GO" />
    <bpmn:task id="inform_msp_fail" name="Inform the MSP" />
    <bpmn:parallelGateway id="notify_join" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="share" name="Share the results of the repairs carried out with the fault detector" />
    <bpmn:task id="inform_go_res" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="inform_msp_res" name="Inform the MSP about the resolution of the interference" />
    <bpmn:endEvent id="end_rejected" name="Failure rejected" />
    <bpmn:endEvent id="end_done" name="Interference resolved" />
    <bpmn:sequenceFlow id="f01" sourceRef="start_reported" targetRef="report" />
    <bpmn:sequenceFlow id="f02" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f03" sourceRef="start_suspicion" targetRef="examine" />
    <bpmn:sequenceFlow id="f04" sourceRef="examine" targetRef="decision" />
    <bpmn:sequenceFlow id="f05" name="rejected" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f06" name="confirmed" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f07" sourceRef="reject" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f08" sourceRef="confirm" targetRef="notify_split" />
    <bpmn:sequenceFlow id="f09" sourceRef="notify_split" targetRef="inform_go_fail" />
    <bpmn:sequenceFlow id="f10" sourceRef="notify_split" targetRef="inform_msp_fail" />
    <bpmn:sequenceFlow id="f11" sourceRef="inform_go_fail" targetRef="notify_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="inform_msp_fail" targetRef="notify_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="notify_join" targetRef="fix" />
    <bpmn:sequenceFlow id="f14" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f15" sourceRef="share" targetRef="inform_go_res" />
    <bpmn:sequenceFlow id="f16" sourceRef="inform_go_res" targetRef="inform_msp_res" />
    <bpmn:sequenceFlow id="f17" sourceRef="inform_msp_res" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
</rfl:parameter>
