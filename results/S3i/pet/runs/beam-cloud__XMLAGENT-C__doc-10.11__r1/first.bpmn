<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_measurements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_readings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_measurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_values</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="request_measurements" name="Request the measurements to the MSP" />
    <bpmn:task id="check_request" name="Check the received request" />
    <bpmn:exclusiveGateway id="handling" name="Deny or perform?" />
    <bpmn:task id="deny_request" name="Deny the request of the GO" />
    <bpmn:task id="perform_measurement" name="Perform the measurement" />
    <bpmn:task id="inform_failure" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="transmit_values" name="Transmit the measured values to the GO" />
    <bpmn:task id="process_values" name="Process the measured values" />
    <bpmn:task id="send_changed" name="Send the changed values to the MSP" />
    <bpmn:task id="transmit_readings" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="end_failure" name="Request denied" />
    <bpmn:endEvent id="end_success" name="Readings transmitted" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request_measurements" />
    <bpmn:sequenceFlow id="f2" sourceRef="request_measurements" targetRef="check_request" />
    <bpmn:sequenceFlow id="f3" sourceRef="check_request" targetRef="handling" />
    <bpmn:sequenceFlow id="f4" name="deny" sourceRef="handling" targetRef="deny_request" />
    <bpmn:sequenceFlow id="f5" name="perform" sourceRef="handling" targetRef="perform_measurement" />
    <bpmn:sequenceFlow id="f6" sourceRef="deny_request" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="f7" sourceRef="inform_failure" targetRef="end_failure" />
    <bpmn:sequenceFlow id="f8" sourceRef="perform_measurement" targetRef="transmit_values" />
    <bpmn:sequenceFlow id="f9" sourceRef="transmit_values" targetRef="process_values" />
    <bpmn:sequenceFlow id="f10" sourceRef="process_values" targetRef="send_changed" />
    <bpmn:sequenceFlow id="f11" sourceRef="send_changed" targetRef="transmit_readings" />
    <bpmn:sequenceFlow id="f12" sourceRef="transmit_readings" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>