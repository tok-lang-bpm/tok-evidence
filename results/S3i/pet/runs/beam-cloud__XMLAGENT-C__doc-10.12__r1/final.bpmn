assistant to=check_bpmnanalysis xml="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"definitions\" targetNamespace=\"http://example.org/bpmn\">
  <bpmn:collaboration id=\"collaboration\">
    <bpmn:participant id=\"org\" name=\"Organisation\" processRef=\"process\" />
  </bpmn:collaboration>
  <bpmn:process id=\"process\" isExecutable=\"false\">
    <bpmn:laneSet id=\"lanes\">
      <bpmn:lane id=\"lane-ec\" name=\"EC\">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id=\"lane-inq\" name=\"INQ\">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id=\"lane-ip\" name=\"IP\">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id=\"start\" name=\"Start\" />
    <bpmn:task id=\"tell\" name=\"EC tells the INQ about the change of his master data\" />
    <bpmn:task id=\"notify\" name=\"The INQ notifies the IP of the change\" />
    <bpmn:task id=\"check\" name=\"The IP checks whether the master data can be changed at the desired time\" />
    <bpmn:exclusiveGateway id=\"decision\" name=\"Master data can be changed at the desired time?\" />
    <bpmn:task id=\"confirm\" name=\"The IP confirms the changes of the INQ\" />
    <bpmn:task id=\"reject\" name=\"The IP rejects the changes of the INQ\" />
    <bpmn:endEvent id=\"end-confirmed\" name=\"Changes confirmed\" />
    <bpmn:endEvent id=\"end-rejected\" name=\"Changes rejected\" />
    <bpmn:sequenceFlow id=\"f1\" sourceRef=\"start\" targetRef=\"tell\" />
    <bpmn:sequenceFlow id=\"f2\" sourceRef=\"tell\" targetRef=\"notify\" />
    <bpmn:sequenceFlow id=\"f3\" sourceRef=\"notify\" targetRef=\"check\" />
    <bpmn:sequenceFlow id=\"f4\" sourceRef=\"check\" targetRef=\"decision\" />
    <bpmn:sequenceFlow id=\"f5\" name=\"yes\" sourceRef=\"decision\" targetRef=\"confirm\" />
    <bpmn:sequenceFlow id=\"f6\" name=\"no\" sourceRef=\"decision\" targetRef=\"reject\" />
    <bpmn:sequenceFlow id=\"f7\" sourceRef=\"confirm\" targetRef=\"end-confirmed\" />
    <bpmn:sequenceFlow id=\"f8\" sourceRef=\"reject\" targetRef=\"end-rejected\" />
  </bpmn:process>
</bpmn:definitions>
</rfl:parameter>
