<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit-request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check-request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>data-transmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Transaction data request needed" />
    <bpmn:task id="transmit-request" name="Transmit the transaction data request" />
    <bpmn:task id="check-request" name="Check the request" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome of the examination?" />
    <bpmn:endEvent id="data-transmitted" name="Transmission of data" />
    <bpmn:endEvent id="rejected" name="Rejection" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="transmit-request" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmit-request" targetRef="check-request" />
    <bpmn:sequenceFlow id="f3" sourceRef="check-request" targetRef="outcome" />
    <bpmn:sequenceFlow id="f4" name="Transmission of data" sourceRef="outcome" targetRef="data-transmitted" />
    <bpmn:sequenceFlow id="f5" name="Rejection" sourceRef="outcome" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
