assistant to=check_bpmnanalysis xml="<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn='http://www.omg.org/spec/BPMN/20100524/MODEL' id='definitions' targetNamespace='http://example.org/bpmn'>
  <bpmn:collaboration id='collaboration'>
    <bpmn:participant id='org' name='Organisation' processRef='process' />
  </bpmn:collaboration>
  <bpmn:process id='process' isExecutable='false'>
    <bpmn:laneSet id='lanes'>
      <bpmn:lane id='lane-MPON' name='MPON'>
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id='lane-MPOO' name='MPOO'>
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id='start' name='Start' />
    <bpmn:task id='send-dismissal' name='Send the dismissal' />
    <bpmn:task id='review-dismissal' name='Review the dismissal' />
    <bpmn:exclusiveGateway id='decision' name='Opposes or confirms?' />
    <bpmn:task id='oppose-dismissal' name='Oppose the dismissal' />
    <bpmn:task id='confirm-dismissal' name='Confirm the dismissal' />
    <bpmn:endEvent id='end-opposed' name='Dismissal opposed' />
    <bpmn:endEvent id='end-confirmed' name='Dismissal confirmed' />
    <bpmn:sequenceFlow id='f1' sourceRef='start' targetRef='send-dismissal' />
    <bpmn:sequenceFlow id='f2' sourceRef='send-dismissal' targetRef='review-dismissal' />
    <bpmn:sequenceFlow id='f3' sourceRef='review-dismissal' targetRef='decision' />
    <bpmn:sequenceFlow id='f4' name='opposes' sourceRef='decision' targetRef='oppose-dismissal' />
    <bpmn:sequenceFlow id='f5' name='confirms' sourceRef='decision' targetRef='confirm-dismissal' />
    <bpmn:sequenceFlow id='f6' sourceRef='oppose-dismissal' targetRef='end-opposed' />
    <bpmn:sequenceFlow id='f7' sourceRef='confirm-dismissal' targetRef='end-confirmed' />
  </bpmn:process>
</bpmn:definitions>
</rfl:parameter>
