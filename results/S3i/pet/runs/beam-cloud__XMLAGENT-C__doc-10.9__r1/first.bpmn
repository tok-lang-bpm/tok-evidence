<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>se_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mpo" name="MPO">
        <bpmn:flowNodeRef>se_mpo_cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_handled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="se_req" name="Change requested by SP / PU / GO" />
    <bpmn:task id="task_request" name="Request changes" />
    <bpmn:startEvent id="se_mpo_cause" name="MPO causes a change" />
    <bpmn:task id="task_review" name="Review the change request" />
    <bpmn:exclusiveGateway id="gw_decision" name="Change confirmed?" />
    <bpmn:task id="task_perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="gw_outcome" name="Change successful?" />
    <bpmn:task id="task_report" name="Report the implementation" />
    <bpmn:task id="task_notify" name="Notify about the failure of the changes" />
    <bpmn:endEvent id="end_rejected" name="Change rejected" />
    <bpmn:endEvent id="end_handled" name="Change implemented" />
    <bpmn:endEvent id="end_failed" name="Change failed" />
    <bpmn:sequenceFlow id="f1" sourceRef="se_req" targetRef="task_request" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_request" targetRef="task_review" />
    <bpmn:sequenceFlow id="f3" sourceRef="se_mpo_cause" targetRef="task_review" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_review" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="f5" name="rejects" sourceRef="gw_decision" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f6" name="confirms" sourceRef="gw_decision" targetRef="task_perform" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_perform" targetRef="gw_outcome" />
    <bpmn:sequenceFlow id="f8" name="implementation" sourceRef="gw_outcome" targetRef="task_report" />
    <bpmn:sequenceFlow id="f9" name="failure" sourceRef="gw_outcome" targetRef="task_notify" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_report" targetRef="end_handled" />
    <bpmn:sequenceFlow id="f11" sourceRef="task_notify" targetRef="end_failed" />
  </bpmn:process>
</bpmn:definitions>