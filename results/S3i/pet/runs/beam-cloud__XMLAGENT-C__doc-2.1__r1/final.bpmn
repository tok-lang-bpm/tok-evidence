<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendparams</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivereport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_customer_service" name="Customer Service">
        <bpmn:flowNodeRef>cs_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_createDetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_sendDetailedSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_receivedmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_psplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_createCustomerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_sendCustomerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_pgsend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_pjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_rebate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_electronic_service" name="Electronic Service">
        <bpmn:flowNodeRef>es_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es_linkextra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_premiummerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sigaffected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_service_management" name="Service Management">
        <bpmn:flowNodeRef>sm_receivedetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_sendDetailedRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_createTroubleSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_preparefinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_sendActual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_createPR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_sendPR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_createReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_sendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sm_receivets</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_resource_provisioning" name="Resource Provisioning">
        <bpmn:flowNodeRef>rp_receivedetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_checkproblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rpproblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_createnotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_createTroubleRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_createStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_sendStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_trackerrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_correctiveRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_createTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rp_sendTS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>b_adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Service degraded" />
    <bpmn:task id="perceive" name="Perceive that service has degraded" />
    <bpmn:task id="sendparams" name="Send list with all problem parameters to Customer Service" />
    <bpmn:task id="cs_enter" name="Enter problem report into system T" />
    <bpmn:task id="cs_compare" name="Compare problem report to customer SLA" />
    <bpmn:task id="cs_determine" name="Determine necessary counter measures including priorities" />
    <bpmn:task id="cs_createDetailed" name="Create detailed problem report" />
    <bpmn:task id="cs_sendDetailedSM" name="Send detailed problem report to Service Management" />
    <bpmn:task id="cs_createCustomerReport" name="Create report for customer about service performance and resolution" />
    <bpmn:task id="cs_sendCustomerReport" name="Send report about service performance and problem resolution to customer" />
    <bpmn:task id="cs_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="cs_psplit" name="Parallel split" />
    <bpmn:exclusiveGateway id="cs_receivedmerge" name="Report received" />
    <bpmn:parallelGateway id="cs_pgsend" name="Parallel split after send" />
    <bpmn:parallelGateway id="cs_pjoin" name="Parallel join" />
    <bpmn:endEvent id="cs_end" name="Customer Service process completed" />
    <bpmn:task id="es_significance" name="Determine significance of customer" />
    <bpmn:exclusiveGateway id="gw_premium" name="Customer premium?" />
    <bpmn:task id="es_linkextra" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="gw_premiummerge" name="Merge" />
    <bpmn:exclusiveGateway id="gw_sigaffected" name="Customer significance affects counter measures?" />
    <bpmn:task id="sm_receivedetailed" name="Receive detailed problem report" />
    <bpmn:task id="sm_investigate" name="Investigate whether problem analyzable at department level" />
    <bpmn:exclusiveGateway id="gw_analyzable" name="Problem analyzable by Service Management?" />
    <bpmn:task id="sm_sendDetailedRP" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="sm_analyze" name="Analyze the problem" />
    <bpmn:task id="sm_createTroubleSM" name="Create trouble report indicating type of problem" />
    <bpmn:task id="sm_preparefinal" name="Prepare final status report based on received information" />
    <bpmn:exclusiveGateway id="gw_counter" name="Counter measures required?" />
    <bpmn:task id="sm_sendActual" name="Send actual service performance to Customer Service" />
    <bpmn:task id="sm_corrective" name="Undertake corrective actions" />
    <bpmn:task id="sm_createPR" name="Create problem resolution report" />
    <bpmn:task id="sm_sendPR" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="sm_createReq" name="Create request for automatic resource restoration" />
    <bpmn:task id="sm_sendReq" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="sm_receivets" name="Receive trouble-shooting report" />
    <bpmn:task id="rp_receivedetailed" name="Receive detailed problem report" />
    <bpmn:task id="rp_checkproblems" name="Check whether there are any possible problems" />
    <bpmn:exclusiveGateway id="gw_rpproblems" name="Any possible problems?" />
    <bpmn:task id="rp_createnotify" name="Create notification about normal service execution" />
    <bpmn:task id="rp_analyze" name="Analyze detected problem" />
    <bpmn:task id="rp_createTroubleRP" name="Create trouble report" />
    <bpmn:task id="rp_createStatusReport" name="Include trouble report or notification in status report" />
    <bpmn:task id="rp_sendStatusReport" name="Send status report to Service Management" />
    <bpmn:task id="rp_trackerrors" name="Track all possible errors" />
    <bpmn:task id="rp_correctiveRP" name="Undertake necessary corrective actions" />
    <bpmn:task id="rp_createTS" name="Create trouble-shooting report" />
    <bpmn:task id="rp_sendTS" name="Send trouble-shooting report to Service Management" />
    <bpmn:task id="b_adjust" name="Adjust the billing" />
    <bpmn:task id="receivereport" name="Receive report about service performance and problem resolution" />
    <bpmn:endEvent id="end_customer" name="Service degradation process ended" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="perceive" />
    <bpmn:sequenceFlow id="f2" sourceRef="perceive" targetRef="sendparams" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendparams" targetRef="cs_enter" />
    <bpmn:sequenceFlow id="f4" sourceRef="cs_enter" targetRef="cs_compare" />
    <bpmn:sequenceFlow id="f5" sourceRef="cs_compare" targetRef="cs_determine" />
    <bpmn:sequenceFlow id="f6" sourceRef="cs_determine" targetRef="es_significance" />
    <bpmn:sequenceFlow id="f7" sourceRef="es_significance" targetRef="gw_premium" />
    <bpmn:sequenceFlow id="f_premium_yes" name="premium" sourceRef="gw_premium" targetRef="es_linkextra" />
    <bpmn:sequenceFlow id="f_premium_no" name="not premium" sourceRef="gw_premium" targetRef="gw_premiummerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="es_linkextra" targetRef="gw_premiummerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="gw_premiummerge" targetRef="gw_sigaffected" />
    <bpmn:sequenceFlow id="f_sig_yes" name="yes" sourceRef="gw_sigaffected" targetRef="cs_determine" />
    <bpmn:sequenceFlow id="f_sig_no" name="no" sourceRef="gw_sigaffected" targetRef="cs_createDetailed" />
    <bpmn:sequenceFlow id="f10" sourceRef="cs_createDetailed" targetRef="cs_sendDetailedSM" />
    <bpmn:sequenceFlow id="f11" sourceRef="cs_sendDetailedSM" targetRef="sm_receivedetailed" />
    <bpmn:sequenceFlow id="f12" sourceRef="sm_receivedetailed" targetRef="sm_investigate" />
    <bpmn:sequenceFlow id="f13" sourceRef="sm_investigate" targetRef="gw_analyzable" />
    <bpmn:sequenceFlow id="f_analyzable_no" name="not analyzable" sourceRef="gw_analyzable" targetRef="sm_sendDetailedRP" />
    <bpmn:sequenceFlow id="f_analyzable_yes" name="analyzable" sourceRef="gw_analyzable" targetRef="sm_analyze" />
    <bpmn:sequenceFlow id="f14" sourceRef="sm_sendDetailedRP" targetRef="rp_receivedetailed" />
    <bpmn:sequenceFlow id="f15" sourceRef="rp_receivedetailed" targetRef="rp_checkproblems" />
    <bpmn:sequenceFlow id="f16" sourceRef="rp_checkproblems" targetRef="gw_rpproblems" />
    <bpmn:sequenceFlow id="f_rp_no" name="no problems detected" sourceRef="gw_rpproblems" targetRef="rp_createnotify" />
    <bpmn:sequenceFlow id="f_rp_yes" name="problem detected" sourceRef="gw_rpproblems" targetRef="rp_analyze" />
    <bpmn:sequenceFlow id="f17" sourceRef="rp_analyze" targetRef="rp_createTroubleRP" />
    <bpmn:sequenceFlow id="f18" sourceRef="rp_createnotify" targetRef="rp_createStatusReport" />
    <bpmn:sequenceFlow id="f19" sourceRef="rp_createTroubleRP" targetRef="rp_createStatusReport" />
    <bpmn:sequenceFlow id="f20" sourceRef="rp_createStatusReport" targetRef="rp_sendStatusReport" />
    <bpmn:sequenceFlow id="f21" sourceRef="rp_sendStatusReport" targetRef="sm_preparefinal" />
    <bpmn:sequenceFlow id="f22" sourceRef="sm_analyze" targetRef="sm_createTroubleSM" />
    <bpmn:sequenceFlow id="f23" sourceRef="sm_createTroubleSM" targetRef="sm_preparefinal" />
    <bpmn:sequenceFlow id="f24" sourceRef="sm_preparefinal" targetRef="gw_counter" />
    <bpmn:sequenceFlow id="f_counter_noproblem" name="no problem detected at all" sourceRef="gw_counter" targetRef="sm_sendActual" />
    <bpmn:sequenceFlow id="f_counter_minor" name="minor corrective actions required" sourceRef="gw_counter" targetRef="sm_corrective" />
    <bpmn:sequenceFlow id="f_counter_auto" name="automatic resource restoration required" sourceRef="gw_counter" targetRef="sm_createReq" />
    <bpmn:sequenceFlow id="f25" sourceRef="sm_sendActual" targetRef="cs_receivedmerge" />
    <bpmn:sequenceFlow id="f26" sourceRef="sm_corrective" targetRef="sm_createPR" />
    <bpmn:sequenceFlow id="f27" sourceRef="sm_createReq" targetRef="sm_sendReq" />
    <bpmn:sequenceFlow id="f28" sourceRef="sm_sendReq" targetRef="rp_trackerrors" />
    <bpmn:sequenceFlow id="f29" sourceRef="rp_trackerrors" targetRef="rp_correctiveRP" />
    <bpmn:sequenceFlow id="f30" sourceRef="rp_correctiveRP" targetRef="rp_createTS" />
    <bpmn:sequenceFlow id="f31" sourceRef="rp_createTS" targetRef="rp_sendTS" />
    <bpmn:sequenceFlow id="f32" sourceRef="rp_sendTS" targetRef="sm_receivets" />
    <bpmn:sequenceFlow id="f33" sourceRef="sm_receivets" targetRef="sm_createPR" />
    <bpmn:sequenceFlow id="f34" sourceRef="sm_createPR" targetRef="sm_sendPR" />
    <bpmn:sequenceFlow id="f35" sourceRef="sm_sendPR" targetRef="cs_receivedmerge" />
    <bpmn:sequenceFlow id="f36" sourceRef="cs_receivedmerge" targetRef="cs_psplit" />
    <bpmn:sequenceFlow id="f37" sourceRef="cs_psplit" targetRef="cs_createCustomerReport" />
    <bpmn:sequenceFlow id="f38" sourceRef="cs_createCustomerReport" targetRef="cs_sendCustomerReport" />
    <bpmn:sequenceFlow id="f39" sourceRef="cs_sendCustomerReport" targetRef="cs_pgsend" />
    <bpmn:sequenceFlow id="f40" sourceRef="cs_pgsend" targetRef="cs_pjoin" />
    <bpmn:sequenceFlow id="f41" sourceRef="cs_pgsend" targetRef="receivereport" />
    <bpmn:sequenceFlow id="f42" sourceRef="receivereport" targetRef="end_customer" />
    <bpmn:sequenceFlow id="f43" sourceRef="cs_psplit" targetRef="cs_rebate" />
    <bpmn:sequenceFlow id="f44" sourceRef="cs_rebate" targetRef="b_adjust" />
    <bpmn:sequenceFlow id="f45" sourceRef="b_adjust" targetRef="cs_pjoin" />
    <bpmn:sequenceFlow id="f46" sourceRef="cs_pjoin" targetRef="cs_end" />
  </bpmn:process>
</bpmn:definitions>
