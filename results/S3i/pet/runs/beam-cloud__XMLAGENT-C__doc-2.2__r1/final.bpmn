<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start_switch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_contract_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customer_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_customer_service" name="Customer Service">
        <bpmn:flowNodeRef>receive_customer_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_customer_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_customer_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_customer_object</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_contracts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_resolve_issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regenerate_contracts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_cis_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import_meter_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_end_withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs_end_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cis" name="CIS">
        <bpmn:flowNodeRef>automated_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request_grid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_grid" name="Grid Operator">
        <bpmn:flowNodeRef>check_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate_old_agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grid_end_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_meter_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute_final_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grid_end_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_old_supplier" name="Old Supplier">
        <bpmn:flowNodeRef>create_send_final_billing</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_switch" name="Switch-over request" />

    <bpmn:task id="transmit_data" name="Transmit data to customer service" />
    <bpmn:task id="receive_customer_data" name="Receive customer data" />
    <bpmn:task id="enter_customer_data" name="Enter customer data object into CRM system" />
    <bpmn:task id="compare_check" name="Compare customer data with internal database and check completeness and plausibility" />
    <bpmn:task id="correct_errors" name="Correct errors based on simple error list" />
    <bpmn:exclusiveGateway id="gw_errors" name="Errors found?" />
    <bpmn:exclusiveGateway id="gw_merge_errors" name="Errors resolved" />
    <bpmn:exclusiveGateway id="gw_customer_exists" name="Customer exists in database?" />
    <bpmn:task id="create_customer_object" name="Create new customer object" />
    <bpmn:exclusiveGateway id="gw_merge_exists" name="Customer object ready" />
    <bpmn:task id="prepare_contracts" name="Prepare contract documents for power supplier switch" />
    <bpmn:task id="automated_check" name="Check contract documents automatically within CIS" />
    <bpmn:exclusiveGateway id="gw_docs" name="Contract documents generated successfully?" />
    <bpmn:task id="analyze_resolve_issues" name="Analyze and resolve contract document issues" />
    <bpmn:task id="regenerate_contracts" name="Generate contract documents again" />
    <bpmn:task id="send_confirmation" name="Send confirmation document to customer" />
    <bpmn:task id="send_request_grid" name="Send request to grid operator automatically" />
    <bpmn:task id="check_concurrence" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="transmit_response" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="gw_concurrence" name="Supplier concurrence?" />
    <bpmn:task id="inform_suppliers" name="Inform all involved suppliers and demand conflict resolution" />
    <bpmn:task id="terminate_old_agreement" name="Communicate with old supplier and terminate sales agreement" />
    <bpmn:endEvent id="grid_end_concurrence" name="Process ended" />
    <bpmn:task id="create_cis_contract" name="Create CIS contract" />
    <bpmn:task id="check_contract_details" name="Check contract details" />
    <bpmn:exclusiveGateway id="gw_withdraw" name="Customer withdraws within 7 days?" />
    <bpmn:endEvent id="cs_end_withdrawn" name="Switch contract withdrawn" />
    <bpmn:task id="transmit_meter_data" name="Transmit power meter data to customer service and old supplier" />
    <bpmn:parallelGateway id="parallel_meter" />
    <bpmn:task id="import_meter_data" name="Import meter data into systems" />
    <bpmn:endEvent id="cs_end_complete" name="New customer won" />
    <bpmn:task id="compute_final_billing" name="Compute final billing based on meter data and send to old supplier" />
    <bpmn:endEvent id="grid_end_complete" name="Grid operator process ended" />
    <bpmn:task id="create_send_final_billing" name="Create and send final billing to customer" />
    <bpmn:endEvent id="customer_end" name="Customer process ended" />

    <bpmn:sequenceFlow id="f1" sourceRef="start_switch" targetRef="transmit_data" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmit_data" targetRef="receive_customer_data" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive_customer_data" targetRef="enter_customer_data" />
    <bpmn:sequenceFlow id="f4" sourceRef="enter_customer_data" targetRef="compare_check" />
    <bpmn:sequenceFlow id="f5" sourceRef="compare_check" targetRef="gw_errors" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="gw_errors" targetRef="correct_errors" />
    <bpmn:sequenceFlow id="f7" sourceRef="correct_errors" targetRef="gw_merge_errors" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gw_errors" targetRef="gw_merge_errors" />
    <bpmn:sequenceFlow id="f9" sourceRef="gw_merge_errors" targetRef="gw_customer_exists" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gw_customer_exists" targetRef="create_customer_object" />
    <bpmn:sequenceFlow id="f11" sourceRef="create_customer_object" targetRef="gw_merge_exists" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="gw_customer_exists" targetRef="gw_merge_exists" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_merge_exists" targetRef="prepare_contracts" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepare_contracts" targetRef="automated_check" />
    <bpmn:sequenceFlow id="f15" sourceRef="automated_check" targetRef="gw_docs" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gw_docs" targetRef="analyze_resolve_issues" />
    <bpmn:sequenceFlow id="f17" sourceRef="analyze_resolve_issues" targetRef="regenerate_contracts" />
    <bpmn:sequenceFlow id="f18" sourceRef="regenerate_contracts" targetRef="automated_check" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="gw_docs" targetRef="send_confirmation" />
    <bpmn:sequenceFlow id="f20" sourceRef="send_confirmation" targetRef="send_request_grid" />
    <bpmn:sequenceFlow id="f21" sourceRef="send_request_grid" targetRef="check_concurrence" />
    <bpmn:sequenceFlow id="f22" sourceRef="check_concurrence" targetRef="transmit_response" />
    <bpmn:sequenceFlow id="f23" sourceRef="transmit_response" targetRef="gw_concurrence" />
    <bpmn:sequenceFlow id="f24" name="supplier concurrence" sourceRef="gw_concurrence" targetRef="inform_suppliers" />
    <bpmn:sequenceFlow id="f25" sourceRef="inform_suppliers" targetRef="terminate_old_agreement" />
    <bpmn:sequenceFlow id="f26" sourceRef="terminate_old_agreement" targetRef="grid_end_concurrence" />
    <bpmn:sequenceFlow id="f27" name="no supplier concurrence" sourceRef="gw_concurrence" targetRef="create_cis_contract" />
    <bpmn:sequenceFlow id="f28" sourceRef="create_cis_contract" targetRef="check_contract_details" />
    <bpmn:sequenceFlow id="f29" sourceRef="check_contract_details" targetRef="gw_withdraw" />
    <bpmn:sequenceFlow id="f30" name="withdraws" sourceRef="gw_withdraw" targetRef="cs_end_withdrawn" />
    <bpmn:sequenceFlow id="f31" name="accepted" sourceRef="gw_withdraw" targetRef="transmit_meter_data" />
    <bpmn:sequenceFlow id="f32" sourceRef="transmit_meter_data" targetRef="parallel_meter" />
    <bpmn:sequenceFlow id="f33" sourceRef="parallel_meter" targetRef="import_meter_data" />
    <bpmn:sequenceFlow id="f34" sourceRef="import_meter_data" targetRef="cs_end_complete" />
    <bpmn:sequenceFlow id="f35" sourceRef="parallel_meter" targetRef="compute_final_billing" />
    <bpmn:sequenceFlow id="f36" sourceRef="compute_final_billing" targetRef="grid_end_complete" />
    <bpmn:sequenceFlow id="f37" sourceRef="parallel_meter" targetRef="create_send_final_billing" />
    <bpmn:sequenceFlow id="f38" sourceRef="create_send_final_billing" targetRef="customer_end" />
  </bpmn:process>
</bpmn:definitions>
