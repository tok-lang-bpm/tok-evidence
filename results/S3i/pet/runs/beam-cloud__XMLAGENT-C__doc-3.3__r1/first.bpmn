<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="claims-officer" name="Claims officer">
        <bpmn:flowNodeRef>claim-registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write-settlement-recommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior-claims-officer" name="Senior claims officer">
        <bpmn:flowNodeRef>check-recommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-handling-proceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim-registered" name="Claim registered" />
    <bpmn:task id="examine-claim" name="Examine the claim" />
    <bpmn:task id="write-settlement-recommendation" name="Write settlement recommendation" />
    <bpmn:task id="check-recommendation" name="Check the recommendation" />
    <bpmn:exclusiveGateway id="claim-ok" name="Claim OK?" />
    <bpmn:endEvent id="claim-handling-proceeds" name="Claim handling process proceeds" />
    <bpmn:sequenceFlow id="f1" sourceRef="claim-registered" targetRef="examine-claim" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine-claim" targetRef="write-settlement-recommendation" />
    <bpmn:sequenceFlow id="f3" sourceRef="write-settlement-recommendation" targetRef="check-recommendation" />
    <bpmn:sequenceFlow id="f4" sourceRef="check-recommendation" targetRef="claim-ok" />
    <bpmn:sequenceFlow id="f5" name="Not OK" sourceRef="claim-ok" targetRef="write-settlement-recommendation" />
    <bpmn:sequenceFlow id="f6" name="OK" sourceRef="claim-ok" targetRef="claim-handling-proceeds" />
  </bpmn:process>
</bpmn:definitions>