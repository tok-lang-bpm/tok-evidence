<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="organisation-process" />
  </bpmn:collaboration>
  <bpmn:process id="organisation-process" isExecutable="false">
    <bpmn:laneSet id="organisation-lanes">
      <bpmn:lane id="organisation-lane" name="Organisation">
        <bpmn:flowNodeRef>claim-received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-rejected-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate-severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forms-returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completion-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register-claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>claim-registered-end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform-update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updated-forms-received</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim-received" name="Claim received" />
    <bpmn:task id="check-insured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="insured-gateway" name="Claimant insured?" />
    <bpmn:task id="inform-rejected" name="Inform claimant that claim must be rejected" />
    <bpmn:endEvent id="claim-rejected-end" name="Claim rejected" />
    <bpmn:task id="evaluate-severity" name="Evaluate severity of claim" />
    <bpmn:exclusiveGateway id="severity-gateway" name="Claim severity?" />
    <bpmn:task id="send-forms" name="Send relevant forms to claimant" />
    <bpmn:intermediateCatchEvent id="forms-returned" name="Forms returned" />
    <bpmn:task id="check-forms" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="completion-gateway" name="Forms complete?" />
    <bpmn:task id="register-claim" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="claim-registered-end" name="Claim registered" />
    <bpmn:task id="inform-update" name="Inform claimant to update forms" />
    <bpmn:intermediateCatchEvent id="updated-forms-received" name="Updated forms received" />
    <bpmn:sequenceFlow id="f1" sourceRef="claim-received" targetRef="check-insured" />
    <bpmn:sequenceFlow id="f2" sourceRef="check-insured" targetRef="insured-gateway" />
    <bpmn:sequenceFlow id="f3" name="No" sourceRef="insured-gateway" targetRef="inform-rejected" />
    <bpmn:sequenceFlow id="f4" sourceRef="inform-rejected" targetRef="claim-rejected-end" />
    <bpmn:sequenceFlow id="f5" name="Yes" sourceRef="insured-gateway" targetRef="evaluate-severity" />
    <bpmn:sequenceFlow id="f6" sourceRef="evaluate-severity" targetRef="severity-gateway" />
    <bpmn:sequenceFlow id="f7" name="Simple" sourceRef="severity-gateway" targetRef="send-forms" />
    <bpmn:sequenceFlow id="f8" name="Complex" sourceRef="severity-gateway" targetRef="send-forms" />
    <bpmn:sequenceFlow id="f9" sourceRef="send-forms" targetRef="forms-returned" />
    <bpmn:sequenceFlow id="f10" sourceRef="forms-returned" targetRef="check-forms" />
    <bpmn:sequenceFlow id="f11" sourceRef="check-forms" targetRef="completion-gateway" />
    <bpmn:sequenceFlow id="f12" name="Yes" sourceRef="completion-gateway" targetRef="register-claim" />
    <bpmn:sequenceFlow id="f13" sourceRef="register-claim" targetRef="claim-registered-end" />
    <bpmn:sequenceFlow id="f14" name="No" sourceRef="completion-gateway" targetRef="inform-update" />
    <bpmn:sequenceFlow id="f15" sourceRef="inform-update" targetRef="updated-forms-received" />
    <bpmn:sequenceFlow id="f16" sourceRef="updated-forms-received" targetRef="check-forms" />
  </bpmn:process>
</bpmn:definitions>
