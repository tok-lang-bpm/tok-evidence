<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="claimsHandler" name="Claims handler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>searchReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calcEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createActionPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claimsManager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Car accident claim received" />
    <bpmn:task id="searchReport" name="Search Police Report in database" />
    <bpmn:task id="fileReport" name="Put Police Report in file with Claim Documentation" />
    <bpmn:task id="calcEstimate" name="Calculate initial claim estimate" />
    <bpmn:task id="createActionPlan" name="Create Action Plan" />
    <bpmn:task id="negotiate" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="informClaimant" name="Inform claimant of outcome" />
    <bpmn:endEvent id="end" name="Outcome communicated" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="searchReport" />
    <bpmn:sequenceFlow id="f2" sourceRef="searchReport" targetRef="fileReport" />
    <bpmn:sequenceFlow id="f3" sourceRef="fileReport" targetRef="calcEstimate" />
    <bpmn:sequenceFlow id="f4" sourceRef="calcEstimate" targetRef="createActionPlan" />
    <bpmn:sequenceFlow id="f5" sourceRef="createActionPlan" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f6" sourceRef="negotiate" targetRef="informClaimant" />
    <bpmn:sequenceFlow id="f7" sourceRef="informClaimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
