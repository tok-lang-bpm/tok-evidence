<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="intake-process" />
  </bpmn:collaboration>
  <bpmn:process id="intake-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-secretarial" name="Secretarial office">
        <bpmn:flowNodeRef>start-notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-putthrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-store-is</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-new-patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-create-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-new-patient-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-store-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-add-notices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-store-assignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-pass-cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-parallel-start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-meetings-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-put-status-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-provide-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-send-letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-receive-copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-inform-second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-add-copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-type-tapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-add-typed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-nursing" name="Nursing officer">
        <bpmn:flowNodeRef>task-inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-record-form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-hand-in</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-first" name="First intaker (social-medical worker)">
        <bpmn:flowNodeRef>task-plan-first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-observe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-notes-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-checklist-file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-second" name="Second intaker (physician)">
        <bpmn:flowNodeRef>task-plan-second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-dictaphone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-team" name="Team-leader">
        <bpmn:flowNodeRef>task-assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-record-assignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-determine-file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-add-file-req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task-hand-list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-file-required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-file-handled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-psychiatrist" name="Attending psychiatrist">
        <bpmn:flowNodeRef>task-formulate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-intake</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start-notice" name="Notice by telephone from family doctor" />

    <bpmn:task id="task-inquire" name="Inquire name and residence of patient" />
    <bpmn:task id="task-putthrough" name="Put doctor through to nursing officer" />
    <bpmn:task id="task-inquiry" name="Make full inquiry into mental, health and social state" />
    <bpmn:task id="task-record-form" name="Record information on registration form" />
    <bpmn:task id="task-hand-in" name="Hand in registration form at secretarial office" />
    <bpmn:task id="task-store-is" name="Store information on form in information system" />
    <bpmn:task id="task-print" name="Print information" />
    <bpmn:exclusiveGateway id="gw-new-patient" name="New patient?" />
    <bpmn:task id="task-create-file" name="Create patient file" />
    <bpmn:exclusiveGateway id="gw-new-patient-join" />
    <bpmn:task id="task-store-file" name="Store registration form and print in patient file" />
    <bpmn:task id="task-cards" name="Produce two registration cards" />
    <bpmn:task id="task-add-notices" name="Add new patient to list of new notices" />

    <bpmn:task id="task-assign" name="Assign new patients to team members" />
    <bpmn:task id="task-record-assignments" name="Record assignments on assignment list" />
    <bpmn:task id="task-determine-file" name="Determine whether medical file is required" />
    <bpmn:task id="task-add-file-req" name="Add medical file requirement to assignment list" />
    <bpmn:task id="task-hand-list" name="Hand assignment list to secretarial office" />
    <bpmn:task id="task-store-assignments" name="Store assignments in information system" />
    <bpmn:task id="task-pass-cards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="gw-parallel-start" />
    <bpmn:parallelGateway id="gw-meetings-join" />

    <bpmn:task id="task-plan-first" name="Plan meeting with patient" />
    <bpmn:task id="task-examine" name="Examine patient using standard checklist" />
    <bpmn:task id="task-observe" name="Register additional observations in personal notebook" />
    <bpmn:task id="task-notes-file" name="Put copy of notes in patient file" />
    <bpmn:task id="task-checklist-file" name="Add standard checklist to patient file" />

    <bpmn:exclusiveGateway id="gw-file-required" name="Medical file required?" />
    <bpmn:task id="task-send-letter" name="Prepare and send letter requesting medical file" />
    <bpmn:task id="task-receive-copy" name="Receive copy of medical file" />
    <bpmn:task id="task-inform-second" name="Inform second intaker of received copy" />
    <bpmn:task id="task-add-copy" name="Add copy to patient file" />
    <bpmn:exclusiveGateway id="gw-file-handled" />

    <bpmn:task id="task-plan-second" name="Plan first meeting with patient" />
    <bpmn:task id="task-dictaphone" name="Record observations with dictaphone" />
    <bpmn:task id="task-type-tapes" name="Type out dictaphone tapes" />
    <bpmn:task id="task-add-typed" name="Add typed information to patient file" />

    <bpmn:task id="task-put-status-list" name="Put patient on list of patients that reach status" />
    <bpmn:task id="task-provide-list" name="Provide list to team-leader" />
    <bpmn:task id="task-formulate" name="Formulate treatment plan" />

    <bpmn:endEvent id="end-intake" name="Intake procedure ended" />

    <bpmn:sequenceFlow id="f1" sourceRef="start-notice" targetRef="task-inquire" />
    <bpmn:sequenceFlow id="f2" sourceRef="task-inquire" targetRef="task-putthrough" />
    <bpmn:sequenceFlow id="f3" sourceRef="task-putthrough" targetRef="task-inquiry" />
    <bpmn:sequenceFlow id="f4" sourceRef="task-inquiry" targetRef="task-record-form" />
    <bpmn:sequenceFlow id="f5" sourceRef="task-record-form" targetRef="task-hand-in" />
    <bpmn:sequenceFlow id="f6" sourceRef="task-hand-in" targetRef="task-store-is" />
    <bpmn:sequenceFlow id="f7" sourceRef="task-store-is" targetRef="task-print" />
    <bpmn:sequenceFlow id="f8" sourceRef="task-print" targetRef="gw-new-patient" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gw-new-patient" targetRef="task-create-file" />
    <bpmn:sequenceFlow id="f10" sourceRef="task-create-file" targetRef="gw-new-patient-join" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="gw-new-patient" targetRef="gw-new-patient-join" />
    <bpmn:sequenceFlow id="f12" sourceRef="gw-new-patient-join" targetRef="task-store-file" />
    <bpmn:sequenceFlow id="f13" sourceRef="task-store-file" targetRef="task-cards" />
    <bpmn:sequenceFlow id="f14" sourceRef="task-cards" targetRef="task-add-notices" />
    <bpmn:sequenceFlow id="f15" sourceRef="task-add-notices" targetRef="task-assign" />
    <bpmn:sequenceFlow id="f16" sourceRef="task-assign" targetRef="task-record-assignments" />
    <bpmn:sequenceFlow id="f17" sourceRef="task-record-assignments" targetRef="task-determine-file" />
    <bpmn:sequenceFlow id="f18" sourceRef="task-determine-file" targetRef="task-add-file-req" />
    <bpmn:sequenceFlow id="f19" sourceRef="task-add-file-req" targetRef="task-hand-list" />
    <bpmn:sequenceFlow id="f20" sourceRef="task-hand-list" targetRef="task-store-assignments" />
    <bpmn:sequenceFlow id="f21" sourceRef="task-store-assignments" targetRef="task-pass-cards" />
    <bpmn:sequenceFlow id="f22" sourceRef="task-pass-cards" targetRef="gw-parallel-start" />
    <bpmn:sequenceFlow id="f23" sourceRef="gw-parallel-start" targetRef="task-plan-first" />
    <bpmn:sequenceFlow id="f24" sourceRef="task-plan-first" targetRef="task-examine" />
    <bpmn:sequenceFlow id="f25" sourceRef="task-examine" targetRef="task-observe" />
    <bpmn:sequenceFlow id="f26" sourceRef="task-observe" targetRef="task-notes-file" />
    <bpmn:sequenceFlow id="f27" sourceRef="task-notes-file" targetRef="task-checklist-file" />
    <bpmn:sequenceFlow id="f28" sourceRef="task-checklist-file" targetRef="gw-meetings-join" />
    <bpmn:sequenceFlow id="f29" sourceRef="gw-parallel-start" targetRef="gw-file-required" />
    <bpmn:sequenceFlow id="f30" name="yes" sourceRef="gw-file-required" targetRef="task-send-letter" />
    <bpmn:sequenceFlow id="f31" sourceRef="task-send-letter" targetRef="task-receive-copy" />
    <bpmn:sequenceFlow id="f32" sourceRef="task-receive-copy" targetRef="task-inform-second" />
    <bpmn:sequenceFlow id="f33" sourceRef="task-inform-second" targetRef="task-add-copy" />
    <bpmn:sequenceFlow id="f34" sourceRef="task-add-copy" targetRef="gw-file-handled" />
    <bpmn:sequenceFlow id="f35" name="no" sourceRef="gw-file-required" targetRef="gw-file-handled" />
    <bpmn:sequenceFlow id="f36" sourceRef="gw-file-handled" targetRef="task-plan-second" />
    <bpmn:sequenceFlow id="f37" sourceRef="task-plan-second" targetRef="task-dictaphone" />
    <bpmn:sequenceFlow id="f38" sourceRef="task-dictaphone" targetRef="task-type-tapes" />
    <bpmn:sequenceFlow id="f39" sourceRef="task-type-tapes" targetRef="task-add-typed" />
    <bpmn:sequenceFlow id="f40" sourceRef="task-add-typed" targetRef="gw-meetings-join" />
    <bpmn:sequenceFlow id="f41" sourceRef="gw-meetings-join" targetRef="task-put-status-list" />
    <bpmn:sequenceFlow id="f42" sourceRef="task-put-status-list" targetRef="task-provide-list" />
    <bpmn:sequenceFlow id="f43" sourceRef="task-provide-list" targetRef="task-formulate" />
    <bpmn:sequenceFlow id="f44" sourceRef="task-formulate" targetRef="end-intake" />
  </bpmn:process>
</bpmn:definitions>
