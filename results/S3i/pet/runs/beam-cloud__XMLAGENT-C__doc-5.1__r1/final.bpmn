<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="loan-process" />
  </bpmn:collaboration>
  <bpmn:process id="loan-process" isExecutable="false">
    <bpmn:laneSet id="loan-lanes">
      <bpmn:lane id="customer-lane" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assessor-lane" name="Risk Assessment Web Service">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>risk-gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="approver-lane" name="Approver Web Service">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer request for loan amount received" />
    <bpmn:task id="assess" name="Invoke risk assessment Web service" />
    <bpmn:exclusiveGateway id="risk-gateway" name="Risk and loan assessment" />
    <bpmn:task id="approve" name="Approve the loan" />
    <bpmn:task id="deny" name="Deny the loan" />
    <bpmn:task id="forward" name="Send request to approver Web service" />
    <bpmn:task id="review" name="Review the request" />
    <bpmn:exclusiveGateway id="merge" name="Processing complete" />
    <bpmn:task id="feedback" name="Receive feedback" />
    <bpmn:endEvent id="end" name="Loan process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="assess" />
    <bpmn:sequenceFlow id="f2" sourceRef="assess" targetRef="risk-gateway" />
    <bpmn:sequenceFlow id="f3" name="Small and low risk" sourceRef="risk-gateway" targetRef="approve" />
    <bpmn:sequenceFlow id="f4" name="High risk" sourceRef="risk-gateway" targetRef="deny" />
    <bpmn:sequenceFlow id="f5" name="Needs further review or amount is $10,000 or more" sourceRef="risk-gateway" targetRef="forward" />
    <bpmn:sequenceFlow id="f6" sourceRef="approve" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="deny" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="forward" targetRef="review" />
    <bpmn:sequenceFlow id="f9" sourceRef="review" targetRef="merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="merge" targetRef="feedback" />
    <bpmn:sequenceFlow id="f11" sourceRef="feedback" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
