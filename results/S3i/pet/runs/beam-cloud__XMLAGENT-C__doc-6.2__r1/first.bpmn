<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROC" />
  </bpmn:collaboration>
  <bpmn:process id="PROC" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_ASM" name="Assembler AG">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SUP" name="Supplier">
        <bpmn:flowNodeRef>processOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start of month" />
    <bpmn:task id="sendOrder" name="Send the order to the supplier" />
    <bpmn:task id="processOrder" name="Process the order" />
    <bpmn:task id="sendInvoice" name="Send an invoice to Assembler AG" />
    <bpmn:task id="receiveInvoice" name="Receive the invoice" />
    <bpmn:endEvent id="end" name="Invoice received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendOrder" targetRef="processOrder" />
    <bpmn:sequenceFlow id="f3" sourceRef="processOrder" targetRef="sendInvoice" />
    <bpmn:sequenceFlow id="f4" sourceRef="sendInvoice" targetRef="receiveInvoice" />
    <bpmn:sequenceFlow id="f5" sourceRef="receiveInvoice" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>