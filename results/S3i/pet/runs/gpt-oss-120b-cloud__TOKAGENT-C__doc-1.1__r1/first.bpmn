<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Custom Bicycle Manufacturing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Custom Bicycle Manufacturing" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales Department">
        <bpmn:flowNodeRef>order_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_storehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_engineering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>and_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship_bicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="storehouse" name="Storehouse">
        <bpmn:flowNodeRef>process_part_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>part_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve_part</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder_part</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>part_processing_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="engineering" name="Engineering Department">
        <bpmn:flowNodeRef>prepare_assembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble_bicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="order_received" name="Order received" />
    <bpmn:exclusiveGateway id="decide_accept" name="Order accepted?" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:parallelGateway id="and_split" />
    <bpmn:task id="inform_storehouse" name="Inform storehouse" />
    <bpmn:task id="inform_engineering" name="Inform engineering" />
    <bpmn:parallelGateway id="and_join" />
    <bpmn:task id="ship_bicycle" name="Ship bicycle" />
    <bpmn:endEvent id="finished" name="Process finished" />
    <bpmn:task id="process_part_list" name="Process part list" />
    <bpmn:exclusiveGateway id="part_available" name="Part available?" />
    <bpmn:task id="reserve_part" name="Reserve part" />
    <bpmn:task id="backorder_part" name="Back-order part" />
    <bpmn:task id="part_processing_done" name="Part processing completed" />
    <bpmn:task id="prepare_assembly" name="Prepare assembly" />
    <bpmn:task id="assemble_bicycle" name="Assemble bicycle" />
    <bpmn:sequenceFlow id="f-order_received-decide_accept" sourceRef="order_received" targetRef="decide_accept" />
    <bpmn:sequenceFlow id="f-decide_accept-rejected" name="no" sourceRef="decide_accept" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-decide_accept-and_split" sourceRef="decide_accept" targetRef="and_split" />
    <bpmn:sequenceFlow id="f-and_split-inform_storehouse" sourceRef="and_split" targetRef="inform_storehouse" />
    <bpmn:sequenceFlow id="f-and_split-inform_engineering" sourceRef="and_split" targetRef="inform_engineering" />
    <bpmn:sequenceFlow id="f-inform_storehouse-process_part_list" sourceRef="inform_storehouse" targetRef="process_part_list" />
    <bpmn:sequenceFlow id="f-process_part_list-part_available" sourceRef="process_part_list" targetRef="part_available" />
    <bpmn:sequenceFlow id="f-part_available-reserve_part" name="yes" sourceRef="part_available" targetRef="reserve_part" />
    <bpmn:sequenceFlow id="f-part_available-backorder_part" name="no" sourceRef="part_available" targetRef="backorder_part" />
    <bpmn:sequenceFlow id="f-reserve_part-part_processing_done" sourceRef="reserve_part" targetRef="part_processing_done" />
    <bpmn:sequenceFlow id="f-backorder_part-part_processing_done" sourceRef="backorder_part" targetRef="part_processing_done" />
    <bpmn:sequenceFlow id="f-part_processing_done-and_join" sourceRef="part_processing_done" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-inform_engineering-prepare_assembly" sourceRef="inform_engineering" targetRef="prepare_assembly" />
    <bpmn:sequenceFlow id="f-prepare_assembly-and_join" sourceRef="prepare_assembly" targetRef="and_join" />
    <bpmn:sequenceFlow id="f-and_join-assemble_bicycle" sourceRef="and_join" targetRef="assemble_bicycle" />
    <bpmn:sequenceFlow id="f-assemble_bicycle-ship_bicycle" sourceRef="assemble_bicycle" targetRef="ship_bicycle" />
    <bpmn:sequenceFlow id="f-ship_bicycle-finished" sourceRef="ship_bicycle" targetRef="finished" />
  </bpmn:process>
</bpmn:definitions>
