tok 1.0 "Custom Bicycle Manufacturing"

pool company "Company"
  lane sales "Sales Department"
    start order_received "Order received"
    xor decide_accept "Order accepted?"
    end rejected "Order rejected"
    and and_split
    task inform_storehouse "Inform storehouse"
    task inform_engineering "Inform engineering"
    and and_join
    task ship_bicycle "Ship bicycle"
    end finished "Process finished"
  lane storehouse "Storehouse"
    task process_part_list "Process part list"
    xor part_available "Part available?"
    task reserve_part "Reserve part"
    task backorder_part "Back-order part"
    task part_processing_done "Part processing completed"
  lane engineering "Engineering Department"
    task prepare_assembly "Prepare assembly"
    task assemble_bicycle "Assemble bicycle"

flow order_received -> decide_accept
flow decide_accept -> rejected "no"
flow decide_accept -> and_split
flow and_split -> inform_storehouse
flow and_split -> inform_engineering
flow inform_storehouse -> process_part_list
flow process_part_list -> part_available
flow part_available -> reserve_part "yes"
flow part_available -> backorder_part "no"
flow reserve_part -> part_processing_done
flow backorder_part -> part_processing_done
flow part_processing_done -> and_join
flow inform_engineering -> prepare_assembly
flow prepare_assembly -> and_join
flow and_join -> assemble_bicycle
flow assemble_bicycle -> ship_bicycle
flow ship_bicycle -> finished