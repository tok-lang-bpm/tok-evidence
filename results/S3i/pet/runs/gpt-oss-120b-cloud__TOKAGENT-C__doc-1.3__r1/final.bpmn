<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room Service Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room Service Process" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>W1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Guest calls room service" />
    <bpmn:task id="T1" name="Take down the order" />
    <bpmn:task id="T2" name="Submit order ticket to kitchen" />
    <bpmn:task id="T3" name="Give order to sommelier" />
    <bpmn:task id="T4" name="Assign order to waiter" />
    <bpmn:parallelGateway id="AND1" name="Parallel start" />
    <bpmn:exclusiveGateway id="X1" name="Alcoholic beverage needed?" />
    <bpmn:parallelGateway id="AND2" name="Parallel end" />
    <bpmn:task id="D1" name="Deliver order to guest's room" />
    <bpmn:task id="B1" name="Debit guest's account" />
    <bpmn:endEvent id="E" name="Room service completed" />
    <bpmn:task id="K1" name="Prepare food" />
    <bpmn:task id="S1" name="Fetch wine and prepare alcoholic beverages" />
    <bpmn:task id="W1" name="Ready cart and prepare nonalcoholic drinks" />
    <bpmn:sequenceFlow id="f-S-T1" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="f-T1-T2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="f-T2-T3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="f-T3-T4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="f-T4-AND1" sourceRef="T4" targetRef="AND1" />
    <bpmn:sequenceFlow id="f-AND1-K1" sourceRef="AND1" targetRef="K1" />
    <bpmn:sequenceFlow id="f-AND1-X1" sourceRef="AND1" targetRef="X1" />
    <bpmn:sequenceFlow id="f-AND1-W1" sourceRef="AND1" targetRef="W1" />
    <bpmn:sequenceFlow id="f-X1-S1" name="yes" sourceRef="X1" targetRef="S1" />
    <bpmn:sequenceFlow id="f-X1-AND2" name="no" sourceRef="X1" targetRef="AND2" />
    <bpmn:sequenceFlow id="f-S1-AND2" sourceRef="S1" targetRef="AND2" />
    <bpmn:sequenceFlow id="f-K1-AND2" sourceRef="K1" targetRef="AND2" />
    <bpmn:sequenceFlow id="f-W1-AND2" sourceRef="W1" targetRef="AND2" />
    <bpmn:sequenceFlow id="f-AND2-D1" sourceRef="AND2" targetRef="D1" />
    <bpmn:sequenceFlow id="f-D1-B1" sourceRef="D1" targetRef="B1" />
    <bpmn:sequenceFlow id="f-B1-E" sourceRef="B1" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
