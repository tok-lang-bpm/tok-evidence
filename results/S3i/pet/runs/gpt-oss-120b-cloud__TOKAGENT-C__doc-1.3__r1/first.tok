tok 1.0 "Room Service Process" [executable]

pool hotel "The Evanstonian"
  lane manager "Room-service manager"
    start S "Guest calls room service"
    task T1 "Take down the order"
    task T2 "Submit order ticket to kitchen"
    task T3 "Give order to sommelier"
    task T4 "Assign order to waiter"
    and AND1 "Parallel start"
    xor X1 "Alcoholic beverage needed?"
    and AND2 "Parallel end"
    task D1 "Deliver order to guest's room"
    task B1 "Debit guest's account"
    end E "Room service completed"

  lane kitchen "Kitchen"
    task K1 "Prepare food"

  lane sommelier "Sommelier"
    task S1 "Fetch wine and prepare alcoholic beverages"

  lane waiter "Waiter"
    task W1 "Ready cart and prepare nonalcoholic drinks"

flow S -> T1 -> T2 -> T3 -> T4 -> AND1
flow AND1 -> K1
flow AND1 -> X1
flow AND1 -> W1
flow X1 -> S1 "yes"
flow X1 -> AND2 "no"
flow S1 -> AND2
flow K1 -> AND2
flow W1 -> AND2
flow AND2 -> D1 -> B1 -> E