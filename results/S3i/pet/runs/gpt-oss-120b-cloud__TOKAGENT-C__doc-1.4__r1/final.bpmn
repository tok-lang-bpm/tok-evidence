<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="IPO Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Company" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="IPO Process" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="c" name="Company">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="u" name="Underwriters">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="s" name="SEC">
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Decision to go public" />
    <bpmn:task id="t1" name="Select underwriters" />
    <bpmn:exclusiveGateway id="g1" name="Underwriters accept issue?" />
    <bpmn:task id="t2" name="Give seal of approval" />
    <bpmn:task id="t3" name="Provide procedural and financial advice" />
    <bpmn:task id="t4" name="Prepare registration statement for SEC" />
    <bpmn:task id="t5" name="Check compliance with blue-sky laws" />
    <bpmn:parallelGateway id="a1" />
    <bpmn:task id="t6" name="Arrange road show" />
    <bpmn:task id="t7" name="Firm up issue price" />
    <bpmn:parallelGateway id="a2" />
    <bpmn:task id="t8" name="Fix issue price" />
    <bpmn:task id="t9" name="Enter firm commitment to buy stock" />
    <bpmn:task id="t10" name="Offer stock to public" />
    <bpmn:endEvent id="e1" name="IPO completed" />
    <bpmn:endEvent id="e2" name="Issue not handled" />
    <bpmn:task id="t11" name="Approve registration statement" />
    <bpmn:sequenceFlow id="f-s1-t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t2" name="yes" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-g1-e2" name="no" sourceRef="g1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-a1" sourceRef="t5" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-t11" sourceRef="a1" targetRef="t11" />
    <bpmn:sequenceFlow id="f-a1-t6" sourceRef="a1" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t11-a2" sourceRef="t11" targetRef="a2" />
    <bpmn:sequenceFlow id="f-t7-a2" sourceRef="t7" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-t8" sourceRef="a2" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-e1" sourceRef="t10" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
