tok 1.0 "IPO Process"

pool p "Company"
  lane c "Company"
    start s1 "Decision to go public"
    task t1 "Select underwriters"
  lane u "Underwriters"
    xor g1 "Underwriters accept issue?"
    task t2 "Give seal of approval"
    task t3 "Provide procedural and financial advice"
    task t4 "Prepare registration statement for SEC"
    task t5 "Check compliance with blue-sky laws"
    and a1
    task t6 "Arrange road show"
    task t7 "Firm up issue price"
    and a2
    task t8 "Fix issue price"
    task t9 "Enter firm commitment to buy stock"
    task t10 "Offer stock to public"
    end e1 "IPO completed"
    end e2 "Issue not handled"
  lane s "SEC"
    task t11 "Approve registration statement"

flow s1 -> t1 -> g1
flow g1 -> t2 "yes"
flow g1 -> e2 "no"
flow t2 -> t3 -> t4 -> t5 -> a1
flow a1 -> t11
flow a1 -> t6
flow t6 -> t7
flow t11 -> a2
flow t7 -> a2
flow a2 -> t8 -> t9 -> t10 -> e1
