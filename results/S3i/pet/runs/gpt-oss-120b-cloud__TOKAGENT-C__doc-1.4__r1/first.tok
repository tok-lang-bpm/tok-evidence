tok 1.0 "IPO Process"

pool company "Company" [executable]
  lane company "Company"
    start start1 "Decision to go public"
    task select "Select underwriters"
  lane underwriters "Underwriters"
    xor accept "Underwriters accept issue?"
    task seal "Give seal of approval"
    task advice "Provide procedural and financial advice"
    task prepare "Prepare registration statement for SEC"
    task check "Check compliance with blue-sky laws"
    and parallel1
    task roadshow "Arrange road show"
    task firmprice "Firm up issue price"
    and joined
    task fixprice "Fix issue price"
    task commit "Enter firm commitment to buy stock"
    task offer "Offer stock to public"
    end end1 "IPO completed"
    end reject "Issue not handled"
  lane sec "SEC"
    task approve "Approve registration statement"

flow start1 -> select -> accept
flow accept -> seal "yes"
flow accept -> reject "no"
flow seal -> advice -> prepare -> check -> parallel1
flow parallel1 -> approve
flow parallel1 -> roadshow
flow roadshow -> firmprice
flow approve -> joined
flow firmprice -> joined
flow joined -> fixprice -> commit -> offer -> end1