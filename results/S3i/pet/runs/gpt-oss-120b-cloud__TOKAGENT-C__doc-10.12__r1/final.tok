tok 1.0 "Master data change"

pool org "Organisation"
  lane ec "EC"
    start s1 "Start"
    task tell_inq "Tell INQ about the change of his master data"
  lane inq "INQ"
    task notify_ip "Notify IP of the change"
  lane ip "IP"
    task check_time "Check whether the master data can be changed at the desired time"
    xor can_change "Can the master data be changed at the desired time?"
    task confirm "Confirm the changes of the INQ"
    task reject "Reject the changes of the INQ"
    end e_confirm "Changes confirmed"
    end e_reject "Changes rejected"

flow s1 -> tell_inq -> notify_ip -> check_time -> can_change
flow can_change -> confirm "yes"
flow confirm -> e_confirm
flow can_change -> reject "no"
flow reject -> e_reject
