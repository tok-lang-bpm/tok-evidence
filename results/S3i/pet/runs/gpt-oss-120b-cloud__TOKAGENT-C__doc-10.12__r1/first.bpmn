<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Master data change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Master data change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell_inq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>notify_ip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>can_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Start" />
    <bpmn:task id="tell_inq" name="Tell INQ about the change of his master data" />
    <bpmn:task id="notify_ip" name="Notify IP of the change" />
    <bpmn:task id="check_time" name="Check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="can_change" name="Can the master data be changed at the desired time?" />
    <bpmn:task id="confirm" name="Confirm the changes of the INQ" />
    <bpmn:task id="reject" name="Reject the changes of the INQ" />
    <bpmn:endEvent id="e_confirm" name="Changes confirmed" />
    <bpmn:endEvent id="e_reject" name="Changes rejected" />
    <bpmn:sequenceFlow id="f-s1-tell_inq" sourceRef="s1" targetRef="tell_inq" />
    <bpmn:sequenceFlow id="f-tell_inq-notify_ip" sourceRef="tell_inq" targetRef="notify_ip" />
    <bpmn:sequenceFlow id="f-notify_ip-check_time" sourceRef="notify_ip" targetRef="check_time" />
    <bpmn:sequenceFlow id="f-check_time-can_change" sourceRef="check_time" targetRef="can_change" />
    <bpmn:sequenceFlow id="f-can_change-confirm" name="yes" sourceRef="can_change" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-e_confirm" sourceRef="confirm" targetRef="e_confirm" />
    <bpmn:sequenceFlow id="f-can_change-reject" name="no" sourceRef="can_change" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-e_reject" sourceRef="reject" targetRef="e_reject" />
  </bpmn:process>
</bpmn:definitions>
