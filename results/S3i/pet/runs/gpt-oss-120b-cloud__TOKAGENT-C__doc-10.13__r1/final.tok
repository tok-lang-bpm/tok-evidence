tok 1.0 "INQ to IP transaction"

pool organization "Organization"
  lane INQ "INQ"
    start start "Start"
    task sendRequest "Transmit transaction data request"
  lane IP "IP"
    task checkRequest "Check request"
    xor decision "Outcome?"
    task transmitData "Transmit data"
    task rejectRequest "Reject request"
    end endData "Data transmitted"
    end endReject "Request rejected"

flow start -> sendRequest -> checkRequest -> decision
flow decision -> transmitData "data"
flow decision -> rejectRequest "rejection"
flow transmitData -> endData
flow rejectRequest -> endReject
