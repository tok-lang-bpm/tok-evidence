<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="INQ to IP transaction" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organization" name="Organization" processRef="organization-process" />
  </bpmn:collaboration>
  <bpmn:process id="organization-process" name="INQ to IP transaction" isExecutable="false">
    <bpmn:laneSet id="organization-lanes">
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>checkRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="sendRequest" name="Transmit transaction data request" />
    <bpmn:task id="checkRequest" name="Check request" />
    <bpmn:exclusiveGateway id="decision" name="Outcome?" />
    <bpmn:task id="transmitData" name="Transmit data" />
    <bpmn:task id="rejectRequest" name="Reject request" />
    <bpmn:endEvent id="endData" name="Data transmitted" />
    <bpmn:endEvent id="endReject" name="Request rejected" />
    <bpmn:sequenceFlow id="f-start-sendRequest" sourceRef="start" targetRef="sendRequest" />
    <bpmn:sequenceFlow id="f-sendRequest-checkRequest" sourceRef="sendRequest" targetRef="checkRequest" />
    <bpmn:sequenceFlow id="f-checkRequest-decision" sourceRef="checkRequest" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-transmitData" name="data" sourceRef="decision" targetRef="transmitData" />
    <bpmn:sequenceFlow id="f-decision-rejectRequest" name="rejection" sourceRef="decision" targetRef="rejectRequest" />
    <bpmn:sequenceFlow id="f-transmitData-endData" sourceRef="transmitData" targetRef="endData" />
    <bpmn:sequenceFlow id="f-rejectRequest-endReject" sourceRef="rejectRequest" targetRef="endReject" />
  </bpmn:process>
</bpmn:definitions>
