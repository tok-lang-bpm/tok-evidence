<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Billing Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Billing Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MPOO" name="MPOO">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_temp_cont_mpoon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equipment_acq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>send_temp_cont_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_additional_readings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GO" name="GO">
        <bpmn:flowNodeRef>bill_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine_bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPON" name="MPON">
        <bpmn:flowNodeRef>examine_equipment_bill_mp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="send_temp_cont_mpoon" name="Send bill for temporary continuation of metering point operations" />
    <bpmn:task id="send_equipment_acq" name="Send bill for equipment acquisition" />
    <bpmn:task id="send_temp_cont_mspo" name="Send bill for temporary continuation of the measurement" />
    <bpmn:task id="send_additional_readings" name="Send bill for additional readings" />
    <bpmn:exclusiveGateway id="bill_type" name="Bill type?" />
    <bpmn:exclusiveGateway id="examine_choice" name="Examiner?" />
    <bpmn:task id="examine_bill" name="Examine the bill" />
    <bpmn:exclusiveGateway id="confirm_decision" name="Confirm or reject?" />
    <bpmn:task id="confirm_invoice" name="Confirm invoice with payment advice" />
    <bpmn:task id="reject_invoice" name="Reject invoice" />
    <bpmn:endEvent id="end_confirm" name="End" />
    <bpmn:endEvent id="end_reject" name="End" />
    <bpmn:task id="examine_equipment_bill_mp" name="Examine the bill" />
    <bpmn:sequenceFlow id="f-start1-bill_type" sourceRef="start1" targetRef="bill_type" />
    <bpmn:sequenceFlow id="f-bill_type-send_temp_cont_mpoon" name="MPOO temp" sourceRef="bill_type" targetRef="send_temp_cont_mpoon" />
    <bpmn:sequenceFlow id="f-bill_type-send_temp_cont_mspo" name="MSPO temp" sourceRef="bill_type" targetRef="send_temp_cont_mspo" />
    <bpmn:sequenceFlow id="f-bill_type-send_additional_readings" name="MSPO additional" sourceRef="bill_type" targetRef="send_additional_readings" />
    <bpmn:sequenceFlow id="f-bill_type-send_equipment_acq" name="equipment" sourceRef="bill_type" targetRef="send_equipment_acq" />
    <bpmn:sequenceFlow id="f-send_temp_cont_mpoon-examine_bill" sourceRef="send_temp_cont_mpoon" targetRef="examine_bill" />
    <bpmn:sequenceFlow id="f-send_temp_cont_mspo-examine_bill" sourceRef="send_temp_cont_mspo" targetRef="examine_bill" />
    <bpmn:sequenceFlow id="f-send_additional_readings-examine_bill" sourceRef="send_additional_readings" targetRef="examine_bill" />
    <bpmn:sequenceFlow id="f-send_equipment_acq-examine_choice" sourceRef="send_equipment_acq" targetRef="examine_choice" />
    <bpmn:sequenceFlow id="f-examine_choice-examine_bill" name="GO" sourceRef="examine_choice" targetRef="examine_bill" />
    <bpmn:sequenceFlow id="f-examine_choice-examine_equipment_bill_mp" name="MPON" sourceRef="examine_choice" targetRef="examine_equipment_bill_mp" />
    <bpmn:sequenceFlow id="f-examine_bill-confirm_decision" sourceRef="examine_bill" targetRef="confirm_decision" />
    <bpmn:sequenceFlow id="f-examine_equipment_bill_mp-confirm_decision" sourceRef="examine_equipment_bill_mp" targetRef="confirm_decision" />
    <bpmn:sequenceFlow id="f-confirm_decision-confirm_invoice" name="confirm" sourceRef="confirm_decision" targetRef="confirm_invoice" />
    <bpmn:sequenceFlow id="f-confirm_decision-reject_invoice" name="reject" sourceRef="confirm_decision" targetRef="reject_invoice" />
    <bpmn:sequenceFlow id="f-confirm_invoice-end_confirm" sourceRef="confirm_invoice" targetRef="end_confirm" />
    <bpmn:sequenceFlow id="f-reject_invoice-end_reject" sourceRef="reject_invoice" targetRef="end_reject" />
  </bpmn:process>
</bpmn:definitions>
