tok 1.0 "Dismissal Process"

pool org "Organization"
  lane mpon "MPON"
    start s "Start"
    task send "MPON sends the dismissal to the MPOO"
  lane mpoo "MPOO"
    task review "MPOO reviews the dismissal"
    xor decision "MPOO opposes dismissal?"
    task oppose "MPOO opposes the dismissal of MPON"
    task confirm "MPOO confirms the dismissal of MPON"
    end opposed "Dismissal opposed"
    end confirmed "Dismissal confirmed"

flow s -> send -> review -> decision
flow decision -> oppose "oppose"
flow decision -> confirm "confirm"
flow oppose -> opposed
flow confirm -> confirmed
