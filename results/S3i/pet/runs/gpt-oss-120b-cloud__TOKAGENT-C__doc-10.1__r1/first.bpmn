<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Dismissal Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Dismissal Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="send" name="MPON sends the dismissal to the MPOO" />
    <bpmn:task id="review" name="MPOO reviews the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="MPOO opposes dismissal?" />
    <bpmn:task id="oppose" name="MPOO opposes the dismissal of MPON" />
    <bpmn:task id="confirm" name="MPOO confirms the dismissal of MPON" />
    <bpmn:endEvent id="opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-s-send" sourceRef="s" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-oppose" name="oppose" sourceRef="decision" targetRef="oppose" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="confirm" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-oppose-opposed" sourceRef="oppose" targetRef="opposed" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
