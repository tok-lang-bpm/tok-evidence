<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="MPON process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MPON process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_acq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>imr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cfa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>imfa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isfa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>asplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ajoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_timeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>p_acq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msppo" name="MSPO" />
      <bpmn:lane id="sp" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="r" name="MPON reports the meter operation to the GO" />
    <bpmn:task id="mf" name="MPON informs the GO about the failure of the entire process" />
    <bpmn:task id="ms" name="MPON informs the GO about the successful completion of the entire process" />
    <bpmn:task id="m_acq" name="MPON performs the equipment acquisition and/or equipment changes" />
    <bpmn:task id="e" name="GO examines the application of the MPON" />
    <bpmn:exclusiveGateway id="d1" name="Application approved?" />
    <bpmn:task id="rej" name="GO rejects the application of the MPON" />
    <bpmn:task id="conf" name="GO confirms the application of the MPON" />
    <bpmn:parallelGateway id="g1" name="Inform registration split" />
    <bpmn:task id="imr" name="GO informs the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="isr" name="GO informs the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="g2" name="Inform registration join" />
    <bpmn:parallelGateway id="a1" name="Acquisition split" />
    <bpmn:parallelGateway id="a2" name="Acquisition join" />
    <bpmn:exclusiveGateway id="d2" name="MPON informs GO outcome" />
    <bpmn:task id="cfa" name="GO confirms the failure of the assignment to the MPON" />
    <bpmn:parallelGateway id="fsplit" name="Failure inform split" />
    <bpmn:task id="imfa" name="GO informs the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="isfa" name="GO informs the MSPO about the failure of the assignment of the MPON" />
    <bpmn:parallelGateway id="fjoin" name="Failure inform join" />
    <bpmn:task id="assign" name="GO assigns the MPON" />
    <bpmn:task id="cassign" name="GO confirms the assignment to the MPON" />
    <bpmn:parallelGateway id="asplit" name="Assignment inform split" />
    <bpmn:task id="ima" name="GO informs the MPOO about the assignment of the MPON" />
    <bpmn:task id="isa" name="GO informs the MSPO about the assignment of the MPON" />
    <bpmn:task id="isp" name="GO informs the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="ajoin" name="Assignment inform join" />
    <bpmn:endEvent id="end_success" name="Process completed successfully" />
    <bpmn:endEvent id="end_failure" name="Process failed" />
    <bpmn:endEvent id="end_reject" name="Application rejected" />
    <bpmn:startEvent id="timeout" name="Timeout waiting for MPON">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="tinfo" name="GO informs the MPON about the failure of the overall transaction" />
    <bpmn:endEvent id="end_timeout" name="Overall transaction timed out" />
    <bpmn:task id="p_acq" name="MPOO performs the equipment acquisition and/or equipment changes" />
    <bpmn:sequenceFlow id="f-s-r" sourceRef="s" targetRef="r" />
    <bpmn:sequenceFlow id="f-r-e" sourceRef="r" targetRef="e" />
    <bpmn:sequenceFlow id="f-e-d1" sourceRef="e" targetRef="d1" />
    <bpmn:sequenceFlow id="f-d1-rej" sourceRef="d1" targetRef="rej" />
    <bpmn:sequenceFlow id="f-d1-conf" sourceRef="d1" targetRef="conf" />
    <bpmn:sequenceFlow id="f-rej-end_reject" sourceRef="rej" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f-conf-g1" sourceRef="conf" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-imr" sourceRef="g1" targetRef="imr" />
    <bpmn:sequenceFlow id="f-g1-isr" sourceRef="g1" targetRef="isr" />
    <bpmn:sequenceFlow id="f-imr-g2" sourceRef="imr" targetRef="g2" />
    <bpmn:sequenceFlow id="f-isr-g2" sourceRef="isr" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-a1" sourceRef="g2" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-m_acq" sourceRef="a1" targetRef="m_acq" />
    <bpmn:sequenceFlow id="f-a1-p_acq" sourceRef="a1" targetRef="p_acq" />
    <bpmn:sequenceFlow id="f-m_acq-a2" sourceRef="m_acq" targetRef="a2" />
    <bpmn:sequenceFlow id="f-p_acq-a2" sourceRef="p_acq" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-d2" sourceRef="a2" targetRef="d2" />
    <bpmn:sequenceFlow id="f-d2-mf" sourceRef="d2" targetRef="mf" />
    <bpmn:sequenceFlow id="f-d2-ms" sourceRef="d2" targetRef="ms" />
    <bpmn:sequenceFlow id="f-mf-cfa" sourceRef="mf" targetRef="cfa" />
    <bpmn:sequenceFlow id="f-cfa-fsplit" sourceRef="cfa" targetRef="fsplit" />
    <bpmn:sequenceFlow id="f-fsplit-imfa" sourceRef="fsplit" targetRef="imfa" />
    <bpmn:sequenceFlow id="f-fsplit-isfa" sourceRef="fsplit" targetRef="isfa" />
    <bpmn:sequenceFlow id="f-imfa-fjoin" sourceRef="imfa" targetRef="fjoin" />
    <bpmn:sequenceFlow id="f-isfa-fjoin" sourceRef="isfa" targetRef="fjoin" />
    <bpmn:sequenceFlow id="f-fjoin-end_failure" sourceRef="fjoin" targetRef="end_failure" />
    <bpmn:sequenceFlow id="f-ms-assign" sourceRef="ms" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-cassign" sourceRef="assign" targetRef="cassign" />
    <bpmn:sequenceFlow id="f-cassign-asplit" sourceRef="cassign" targetRef="asplit" />
    <bpmn:sequenceFlow id="f-asplit-ima" sourceRef="asplit" targetRef="ima" />
    <bpmn:sequenceFlow id="f-asplit-isa" sourceRef="asplit" targetRef="isa" />
    <bpmn:sequenceFlow id="f-asplit-isp" sourceRef="asplit" targetRef="isp" />
    <bpmn:sequenceFlow id="f-ima-ajoin" sourceRef="ima" targetRef="ajoin" />
    <bpmn:sequenceFlow id="f-isa-ajoin" sourceRef="isa" targetRef="ajoin" />
    <bpmn:sequenceFlow id="f-isp-ajoin" sourceRef="isp" targetRef="ajoin" />
    <bpmn:sequenceFlow id="f-ajoin-end_success" sourceRef="ajoin" targetRef="end_success" />
    <bpmn:sequenceFlow id="f-timeout-tinfo" sourceRef="timeout" targetRef="tinfo" />
    <bpmn:sequenceFlow id="f-tinfo-end_timeout" sourceRef="tinfo" targetRef="end_timeout" />
  </bpmn:process>
</bpmn:definitions>
