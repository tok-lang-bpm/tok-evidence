<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MPOO deregistration and assignment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MPOO deregistration and assignment" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO" />
      <bpmn:lane id="go" name="GO" />
      <bpmn:lane id="mspo" name="MSPO" />
      <bpmn:lane id="sp" name="SP">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DEC1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PREP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DEC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BIND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONF_CONT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CHG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ASSIGN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFO1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFO2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFO3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_REJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:task id="D1" name="MPOO deregisters at the GO" />
    <bpmn:task id="V1" name="GO verifies the deregistration" />
    <bpmn:exclusiveGateway id="DEC1" name="Reject or preliminarily confirm" />
    <bpmn:task id="REJ" name="GO rejects the deregistration" />
    <bpmn:task id="CONF" name="GO preliminarily confirms the deregistration" />
    <bpmn:task id="PREP" name="GO prepares the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="DEC2" name="GO binds MPOO to continue operations?" />
    <bpmn:task id="BIND" name="GO obliges MPOO to continue operations" />
    <bpmn:task id="CONF_CONT" name="MPOO confirms continuation to GO" />
    <bpmn:parallelGateway id="A" name="Equipment actions" />
    <bpmn:task id="ACQ" name="GO performs equipment acquisition" />
    <bpmn:task id="CHG" name="GO performs equipment changes" />
    <bpmn:parallelGateway id="JOIN" name="Equipment join" />
    <bpmn:task id="ASSIGN" name="GO assigns the GO as MPO" />
    <bpmn:task id="INFO1" name="GO informs MPOO about assignment change" />
    <bpmn:task id="INFO2" name="GO informs MSPO about assignment of GO" />
    <bpmn:task id="INFO3" name="GO informs SP about assignment of GO" />
    <bpmn:endEvent id="E_REJ" name="Deregistration rejected" />
    <bpmn:endEvent id="E_END" name="Process completed" />
    <bpmn:sequenceFlow id="f-S-D1" sourceRef="S" targetRef="D1" />
    <bpmn:sequenceFlow id="f-D1-V1" sourceRef="D1" targetRef="V1" />
    <bpmn:sequenceFlow id="f-V1-DEC1" sourceRef="V1" targetRef="DEC1" />
    <bpmn:sequenceFlow id="f-DEC1-REJ" name="reject" sourceRef="DEC1" targetRef="REJ" />
    <bpmn:sequenceFlow id="f-DEC1-CONF" name="confirm" sourceRef="DEC1" targetRef="CONF" />
    <bpmn:sequenceFlow id="f-REJ-E_REJ" sourceRef="REJ" targetRef="E_REJ" />
    <bpmn:sequenceFlow id="f-CONF-PREP" sourceRef="CONF" targetRef="PREP" />
    <bpmn:sequenceFlow id="f-PREP-DEC2" sourceRef="PREP" targetRef="DEC2" />
    <bpmn:sequenceFlow id="f-DEC2-BIND" name="yes" sourceRef="DEC2" targetRef="BIND" />
    <bpmn:sequenceFlow id="f-DEC2-A" name="no" sourceRef="DEC2" targetRef="A" />
    <bpmn:sequenceFlow id="f-BIND-CONF_CONT" sourceRef="BIND" targetRef="CONF_CONT" />
    <bpmn:sequenceFlow id="f-CONF_CONT-A" sourceRef="CONF_CONT" targetRef="A" />
    <bpmn:sequenceFlow id="f-A-ACQ" sourceRef="A" targetRef="ACQ" />
    <bpmn:sequenceFlow id="f-A-CHG" sourceRef="A" targetRef="CHG" />
    <bpmn:sequenceFlow id="f-ACQ-JOIN" sourceRef="ACQ" targetRef="JOIN" />
    <bpmn:sequenceFlow id="f-CHG-JOIN" sourceRef="CHG" targetRef="JOIN" />
    <bpmn:sequenceFlow id="f-JOIN-ASSIGN" sourceRef="JOIN" targetRef="ASSIGN" />
    <bpmn:sequenceFlow id="f-ASSIGN-INFO1" sourceRef="ASSIGN" targetRef="INFO1" />
    <bpmn:sequenceFlow id="f-INFO1-INFO2" sourceRef="INFO1" targetRef="INFO2" />
    <bpmn:sequenceFlow id="f-INFO2-INFO3" sourceRef="INFO2" targetRef="INFO3" />
    <bpmn:sequenceFlow id="f-INFO3-E_END" sourceRef="INFO3" targetRef="E_END" />
  </bpmn:process>
</bpmn:definitions>
