tok 1.0 "MPOO deregistration and assignment"
    pool org "Organisation"
      lane mpoo "MPOO"
      lane go "GO"
      lane mspo "MSPO"
      lane sp "SP"
        start S "Start"
        task D1 "MPOO deregisters at the GO"
        task V1 "GO verifies the deregistration"
        xor DEC1 "Reject or preliminarily confirm"
        task REJ "GO rejects the deregistration"
        task CONF "GO preliminarily confirms the deregistration"
        task PREP "GO prepares the readmission of the measuring point"
        xor DEC2 "GO binds MPOO to continue operations?"
        task BIND "GO obliges MPOO to continue operations"
        task CONF_CONT "MPOO confirms continuation to GO"
        and A "Equipment actions"
        task ACQ "GO performs equipment acquisition"
        task CHG "GO performs equipment changes"
        and JOIN "Equipment join"
        task ASSIGN "GO assigns the GO as MPO"
        task INFO1 "GO informs MPOO about assignment change"
        task INFO2 "GO informs MSPO about assignment of GO"
        task INFO3 "GO informs SP about assignment of GO"
        end E_REJ "Deregistration rejected"
        end E_END "Process completed"
        flow S -> D1 -> V1 -> DEC1
        flow DEC1 -> REJ "reject"
        flow DEC1 -> CONF "confirm"
        flow REJ -> E_REJ
        flow CONF -> PREP
        flow PREP -> DEC2
        flow DEC2 -> BIND "yes"
        flow DEC2 -> A "no"
        flow BIND -> CONF_CONT
        flow CONF_CONT -> A
        flow A -> ACQ
        flow A -> CHG
        flow ACQ -> JOIN
        flow CHG -> JOIN
        flow JOIN -> ASSIGN
        flow ASSIGN -> INFO1 -> INFO2 -> INFO3 -> E_END