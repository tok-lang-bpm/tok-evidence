<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN dismissal process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN dismissal process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="MSPN" name="MSPN">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MSPO" name="MSPO">
        <bpmn:flowNodeRef>review_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="send_dismissal" name="Send dismissal" />
    <bpmn:task id="review_dismissal" name="Review dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal decision?" />
    <bpmn:task id="reject_dismissal" name="Reject dismissal" />
    <bpmn:task id="confirm_dismissal" name="Confirm dismissal" />
    <bpmn:endEvent id="rejected" name="Dismissal rejected" />
    <bpmn:endEvent id="confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f-start1-send_dismissal" sourceRef="start1" targetRef="send_dismissal" />
    <bpmn:sequenceFlow id="f-send_dismissal-review_dismissal" sourceRef="send_dismissal" targetRef="review_dismissal" />
    <bpmn:sequenceFlow id="f-review_dismissal-decision" sourceRef="review_dismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject_dismissal" name="reject" sourceRef="decision" targetRef="reject_dismissal" />
    <bpmn:sequenceFlow id="f-decision-confirm_dismissal" name="confirm" sourceRef="decision" targetRef="confirm_dismissal" />
    <bpmn:sequenceFlow id="f-reject_dismissal-rejected" sourceRef="reject_dismissal" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm_dismissal-confirmed" sourceRef="confirm_dismissal" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
