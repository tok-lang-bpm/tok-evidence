tok 1.0 "MSPN dismissal process"

pool org "Organisation"
  lane MSPN "MSPN"
    start start1 "Start"
    task send_dismissal "Send dismissal"
  lane MSPO "MSPO"
    task review_dismissal "Review dismissal"
    xor decision "Dismissal decision?"
    task reject_dismissal "Reject dismissal"
    task confirm_dismissal "Confirm dismissal"
    end rejected "Dismissal rejected"
    end confirmed "Dismissal confirmed"

flow start1 -> send_dismissal -> review_dismissal -> decision
flow decision -> reject_dismissal "reject"
flow decision -> confirm_dismissal "confirm"
flow reject_dismissal -> rejected
flow confirm_dismissal -> confirmed
