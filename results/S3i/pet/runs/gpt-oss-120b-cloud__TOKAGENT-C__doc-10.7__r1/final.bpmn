<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="MSPN registration process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="MSPN registration process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Start" />
    <bpmn:task id="reg" name="register measurement at GO" />
    <bpmn:task id="exam" name="examine application of MSPN" />
    <bpmn:exclusiveGateway id="decision" name="application of MSPN rejected?" />
    <bpmn:task id="reject" name="reject application of MSPN" />
    <bpmn:endEvent id="e_reject" name="application rejected" />
    <bpmn:task id="assign" name="assign MSPN" />
    <bpmn:parallelGateway id="split" name="notify parties" />
    <bpmn:task id="inform_mspos" name="inform MSPO about assignment of MSPN" />
    <bpmn:task id="inform_mpo" name="inform MPO about assignment of MSPN" />
    <bpmn:task id="inform_sp" name="inform SP about assignment of MSPN" />
    <bpmn:parallelGateway id="join" name="notifications done" />
    <bpmn:endEvent id="e_done" name="process completed" />
    <bpmn:sequenceFlow id="f-s1-reg" sourceRef="s1" targetRef="reg" />
    <bpmn:sequenceFlow id="f-reg-exam" sourceRef="reg" targetRef="exam" />
    <bpmn:sequenceFlow id="f-exam-decision" sourceRef="exam" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reject" name="yes" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-e_reject" name="application rejected" sourceRef="reject" targetRef="e_reject" />
    <bpmn:sequenceFlow id="f-decision-assign" name="no" sourceRef="decision" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-split" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-inform_mspos" sourceRef="split" targetRef="inform_mspos" />
    <bpmn:sequenceFlow id="f-split-inform_mpo" sourceRef="split" targetRef="inform_mpo" />
    <bpmn:sequenceFlow id="f-split-inform_sp" sourceRef="split" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f-inform_mspos-join" sourceRef="inform_mspos" targetRef="join" />
    <bpmn:sequenceFlow id="f-inform_mpo-join" sourceRef="inform_mpo" targetRef="join" />
    <bpmn:sequenceFlow id="f-inform_sp-join" sourceRef="inform_sp" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-e_done" sourceRef="join" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>
