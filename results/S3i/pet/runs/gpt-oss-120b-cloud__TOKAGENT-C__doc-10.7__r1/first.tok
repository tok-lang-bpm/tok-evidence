tok 1.0 "MSPN registration process"

pool org "Organisation"
  lane mspn "MSPN"
    start s1 "Start"
    task reg "register measurement at GO"
  lane go "GO"
    task exam "examine application of MSPN"
    xor decision "application of MSPN rejected?"
    task reject "reject application of MSPN"
    task assign "assign MSPN"
    and split "notify parties"
    task inform_mspos "inform MSPO about assignment of MSPN"
    task inform_mpo "inform MPO about assignment of MSPN"
    task inform_sp "inform SP about assignment of MSPN"
    and join "notifications done"
    end e_done "process completed"
  lane mspo "MSPO"
    end e_mspo ""
  lane mpo "MPO"
    end e_mpo ""
  lane sp "SP"
    end e_sp ""

flow s1 -> reg -> exam -> decision
flow decision -> reject "yes"
flow reject -> e_reject "application rejected"
flow decision -> assign "no"
flow assign -> split
flow split -> inform_mspos
flow split -> inform_mpo
flow split -> inform_sp
flow inform_mspos -> join
flow inform_mpo -> join
flow inform_sp -> join
flow join -> e_done
