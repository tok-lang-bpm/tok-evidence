<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Change Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Change Request Process" isExecutable="true">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="requester" name="SP / PU / GO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>startDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>causeChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requestJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>performChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFailure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:exclusiveGateway id="startDecision" name="Start decision?" />
    <bpmn:task id="requestChange" name="SP / PU / GO request changes to the MPO" />
    <bpmn:task id="causeChange" name="MPO causes a change" />
    <bpmn:exclusiveGateway id="requestJoin" name="Join request" />
    <bpmn:task id="review" name="MPO reviews the change request" />
    <bpmn:exclusiveGateway id="decision" name="Change request decision?" />
    <bpmn:task id="performChange" name="MPO performs the measuring point change" />
    <bpmn:exclusiveGateway id="outcome" name="Change outcome?" />
    <bpmn:task id="reportSuccess" name="MPO reports the implementation to the SP / PU / GO" />
    <bpmn:task id="reportFailure" name="MPO notifies the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="endSuccess" name="Process completed successfully" />
    <bpmn:endEvent id="endFailure" name="Process completed with failure" />
    <bpmn:sequenceFlow id="f-s-startDecision" sourceRef="s" targetRef="startDecision" />
    <bpmn:sequenceFlow id="f-startDecision-requestChange" name="request" sourceRef="startDecision" targetRef="requestChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-startDecision-causeChange" name="cause" sourceRef="startDecision" targetRef="causeChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-requestChange-requestJoin" sourceRef="requestChange" targetRef="requestJoin" />
    <bpmn:sequenceFlow id="f-causeChange-requestJoin" sourceRef="causeChange" targetRef="requestJoin" />
    <bpmn:sequenceFlow id="f-requestJoin-review" sourceRef="requestJoin" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-reportFailure" name="reject" sourceRef="decision" targetRef="reportFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decision-performChange" name="confirm" sourceRef="decision" targetRef="performChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-performChange-outcome" sourceRef="performChange" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-reportSuccess" name="success" sourceRef="outcome" targetRef="reportSuccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-outcome-reportFailure" name="failure" sourceRef="outcome" targetRef="reportFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-reportSuccess-endSuccess" sourceRef="reportSuccess" targetRef="endSuccess" />
    <bpmn:sequenceFlow id="f-reportFailure-endFailure" sourceRef="reportFailure" targetRef="endFailure" />
  </bpmn:process>
</bpmn:definitions>
