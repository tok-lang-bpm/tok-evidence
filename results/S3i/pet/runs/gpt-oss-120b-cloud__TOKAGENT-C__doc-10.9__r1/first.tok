tok 1.0 "Change Request Process" executable
    pool org "Organisation"
      lane requester "SP / PU / GO"
        start s "Start"
        task requestChange "SP / PU / GO request changes to the MPO"
      lane mpo "MPO"
        task causeChange "MPO causes a change"
        xor requestJoin "Join request"
        task review "MPO reviews the change request"
        xor decision "Change request decision?"
        task performChange "MPO performs the measuring point change"
        xor outcome "Change outcome?"
        task reportSuccess "MPO reports the implementation to the SP / PU / GO"
        task reportFailure "MPO notifies the SP / PU / GO about the failure of the changes"
        end endSuccess "Process completed successfully"
        end endFailure "Process completed with failure"
    flow s -> requestChange -> requestJoin
    flow s -> causeChange -> requestJoin
    flow requestJoin -> review
    flow review -> decision
    flow decision -> reportFailure "reject"
    flow decision -> performChange "confirm"
    flow performChange -> outcome
    flow outcome -> reportSuccess "success"
    flow outcome -> reportFailure "failure"
    flow reportSuccess -> endSuccess
    flow reportFailure -> endFailure