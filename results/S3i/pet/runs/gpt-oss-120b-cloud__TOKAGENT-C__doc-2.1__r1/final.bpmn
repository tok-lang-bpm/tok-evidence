<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Service Degradation Handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="TELECO" name="TELECO" processRef="TELECO-process" />
  </bpmn:collaboration>
  <bpmn:process id="TELECO-process" name="Service Degradation Handling" isExecutable="false">
    <bpmn:laneSet id="TELECO-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start_degradation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_parameters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer_service" name="Customer Service">
        <bpmn:flowNodeRef>enter_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>significance_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_detailed_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_to_service_mgmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_report_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>main_parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_sla_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adjust_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cust_service</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service_management" name="Service Management">
        <bpmn:flowNodeRef>receive_detailed_report_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_trouble_report_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_to_resource_prov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_status_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_final_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final_decision_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_actual_performance_to_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertake_corrections_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_troubleshooting_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_resolution_report_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_resolution_report_to_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_sm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="resource_provisioning" name="Resource Provisioning">
        <bpmn:flowNodeRef>receive_detailed_report_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>problems_detected_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_normal_notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_trouble_report_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_status_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_status_report_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status_report_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalize_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_for_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undertake_corrections_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_troubleshooting_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_troubleshooting_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="extra_process" name="Extra Process">
        <bpmn:flowNodeRef>end_extra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_degradation" name="Service degradation perceived" />
    <bpmn:task id="send_parameters" name="Send problem parameters to Customer Service" />
    <bpmn:task id="enter_report" name="Enter problem report into system T" />
    <bpmn:task id="compare_sla" name="Compare problem report to SLA" />
    <bpmn:task id="determine_measures" name="Determine counter measures and priorities" />
    <bpmn:task id="determine_significance" name="Determine customer significance" />
    <bpmn:exclusiveGateway id="premium_gateway" name="Is customer premium?" />
    <bpmn:exclusiveGateway id="significance_gateway" name="Does significance affect measures?" />
    <bpmn:task id="create_detailed_report" name="Create detailed problem report" />
    <bpmn:task id="send_to_service_mgmt" name="Send detailed problem report to Service Management" />
    <bpmn:task id="receive_report_cs" name="Receive report from Service Management" />
    <bpmn:parallelGateway id="main_parallel" name="Parallel reporting" />
    <bpmn:task id="create_customer_report" name="Create customer report" />
    <bpmn:task id="send_customer_report" name="Send customer report" />
    <bpmn:task id="report_sla_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:task id="adjust_billing" name="Adjust billing for SLA violation" />
    <bpmn:parallelGateway id="parallel_join" name="Parallel join" />
    <bpmn:endEvent id="end_cust_service" name="Customer Service process end" />
    <bpmn:task id="receive_detailed_report_sm" name="Receive detailed problem report" />
    <bpmn:exclusiveGateway id="analyzable_gateway" name="Is problem analyzable by Service Management?" />
    <bpmn:task id="perform_analysis" name="Perform analysis" />
    <bpmn:task id="create_trouble_report_sm" name="Create trouble report (SM)" />
    <bpmn:task id="send_to_resource_prov" name="Send detailed report to Resource Provisioning" />
    <bpmn:task id="receive_status_report" name="Receive status report" />
    <bpmn:task id="prepare_final_status" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="final_decision_gateway" name="Determine counter measures?" />
    <bpmn:task id="send_actual_performance_to_cs" name="Send actual service performance to Customer Service" />
    <bpmn:task id="undertake_corrections_sm" name="Undertake minor corrective actions" />
    <bpmn:task id="create_restoration_request" name="Create restoration request" />
    <bpmn:task id="send_restoration_request" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="receive_troubleshooting_report" name="Receive trouble-shooting report" />
    <bpmn:task id="create_resolution_report_sm" name="Create problem resolution report" />
    <bpmn:task id="send_resolution_report_to_cs" name="Send problem resolution report to Customer Service" />
    <bpmn:endEvent id="end_sm" name="Service Management end" />
    <bpmn:task id="receive_detailed_report_rp" name="Receive detailed problem report" />
    <bpmn:exclusiveGateway id="problems_detected_gateway" name="Are problems detected?" />
    <bpmn:task id="create_normal_notification" name="Create normal execution notification" />
    <bpmn:task id="analyze_problem" name="Analyze problem" />
    <bpmn:task id="create_trouble_report_rp" name="Create trouble report" />
    <bpmn:task id="create_status_report" name="Create status report" />
    <bpmn:task id="send_status_report_rp" name="Send status report" />
    <bpmn:parallelGateway id="status_report_split" name="Status report split" />
    <bpmn:task id="finalize_rp" name="Finalize Resource Provisioning" />
    <bpmn:task id="wait_for_restoration_request" name="Wait for restoration request (within 2 days)" />
    <bpmn:task id="receive_restoration_request" name="Receive restoration request" />
    <bpmn:task id="track_errors" name="Track all possible errors" />
    <bpmn:task id="undertake_corrections_rp" name="Undertake corrective actions" />
    <bpmn:task id="create_troubleshooting_report" name="Create trouble-shooting report" />
    <bpmn:task id="send_troubleshooting_report" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="end_rp" name="Resource Provisioning end" />
    <bpmn:endEvent id="end_extra" name="Extra problem fix process" />
    <bpmn:sequenceFlow id="f-start_degradation-send_parameters" sourceRef="start_degradation" targetRef="send_parameters" />
    <bpmn:sequenceFlow id="f-send_parameters-enter_report" sourceRef="send_parameters" targetRef="enter_report" />
    <bpmn:sequenceFlow id="f-enter_report-compare_sla" sourceRef="enter_report" targetRef="compare_sla" />
    <bpmn:sequenceFlow id="f-compare_sla-determine_measures" sourceRef="compare_sla" targetRef="determine_measures" />
    <bpmn:sequenceFlow id="f-determine_measures-determine_significance" sourceRef="determine_measures" targetRef="determine_significance" />
    <bpmn:sequenceFlow id="f-determine_significance-premium_gateway" sourceRef="determine_significance" targetRef="premium_gateway" />
    <bpmn:sequenceFlow id="f-premium_gateway-end_extra" name="yes" sourceRef="premium_gateway" targetRef="end_extra" />
    <bpmn:sequenceFlow id="f-premium_gateway-significance_gateway" name="no" sourceRef="premium_gateway" targetRef="significance_gateway" />
    <bpmn:sequenceFlow id="f-significance_gateway-determine_measures" name="yes" sourceRef="significance_gateway" targetRef="determine_measures" />
    <bpmn:sequenceFlow id="f-significance_gateway-create_detailed_report" name="no" sourceRef="significance_gateway" targetRef="create_detailed_report" />
    <bpmn:sequenceFlow id="f-create_detailed_report-send_to_service_mgmt" sourceRef="create_detailed_report" targetRef="send_to_service_mgmt" />
    <bpmn:sequenceFlow id="f-send_to_service_mgmt-receive_detailed_report_sm" sourceRef="send_to_service_mgmt" targetRef="receive_detailed_report_sm" />
    <bpmn:sequenceFlow id="f-receive_detailed_report_sm-analyzable_gateway" sourceRef="receive_detailed_report_sm" targetRef="analyzable_gateway" />
    <bpmn:sequenceFlow id="f-analyzable_gateway-perform_analysis" name="yes" sourceRef="analyzable_gateway" targetRef="perform_analysis" />
    <bpmn:sequenceFlow id="f-perform_analysis-create_trouble_report_sm" sourceRef="perform_analysis" targetRef="create_trouble_report_sm" />
    <bpmn:sequenceFlow id="f-create_trouble_report_sm-prepare_final_status" sourceRef="create_trouble_report_sm" targetRef="prepare_final_status" />
    <bpmn:sequenceFlow id="f-analyzable_gateway-send_to_resource_prov" name="no" sourceRef="analyzable_gateway" targetRef="send_to_resource_prov" />
    <bpmn:sequenceFlow id="f-send_to_resource_prov-receive_detailed_report_rp" sourceRef="send_to_resource_prov" targetRef="receive_detailed_report_rp" />
    <bpmn:sequenceFlow id="f-receive_detailed_report_rp-problems_detected_gateway" sourceRef="receive_detailed_report_rp" targetRef="problems_detected_gateway" />
    <bpmn:sequenceFlow id="f-problems_detected_gateway-create_normal_notification" name="no" sourceRef="problems_detected_gateway" targetRef="create_normal_notification" />
    <bpmn:sequenceFlow id="f-problems_detected_gateway-analyze_problem" name="yes" sourceRef="problems_detected_gateway" targetRef="analyze_problem" />
    <bpmn:sequenceFlow id="f-analyze_problem-create_trouble_report_rp" sourceRef="analyze_problem" targetRef="create_trouble_report_rp" />
    <bpmn:sequenceFlow id="f-create_trouble_report_rp-create_status_report" sourceRef="create_trouble_report_rp" targetRef="create_status_report" />
    <bpmn:sequenceFlow id="f-create_normal_notification-create_status_report" sourceRef="create_normal_notification" targetRef="create_status_report" />
    <bpmn:sequenceFlow id="f-create_status_report-send_status_report_rp" sourceRef="create_status_report" targetRef="send_status_report_rp" />
    <bpmn:sequenceFlow id="f-send_status_report_rp-status_report_split" sourceRef="send_status_report_rp" targetRef="status_report_split" />
    <bpmn:sequenceFlow id="f-status_report_split-finalize_rp" sourceRef="status_report_split" targetRef="finalize_rp" />
    <bpmn:sequenceFlow id="f-finalize_rp-end_rp" sourceRef="finalize_rp" targetRef="end_rp" />
    <bpmn:sequenceFlow id="f-status_report_split-receive_status_report" sourceRef="status_report_split" targetRef="receive_status_report" />
    <bpmn:sequenceFlow id="f-receive_status_report-prepare_final_status" sourceRef="receive_status_report" targetRef="prepare_final_status" />
    <bpmn:sequenceFlow id="f-prepare_final_status-final_decision_gateway" sourceRef="prepare_final_status" targetRef="final_decision_gateway" />
    <bpmn:sequenceFlow id="f-final_decision_gateway-send_actual_performance_to_cs" name="no_problem" sourceRef="final_decision_gateway" targetRef="send_actual_performance_to_cs" />
    <bpmn:sequenceFlow id="f-final_decision_gateway-undertake_corrections_sm" name="minor_actions" sourceRef="final_decision_gateway" targetRef="undertake_corrections_sm" />
    <bpmn:sequenceFlow id="f-final_decision_gateway-create_restoration_request" name="auto_restoration" sourceRef="final_decision_gateway" targetRef="create_restoration_request" />
    <bpmn:sequenceFlow id="f-send_actual_performance_to_cs-receive_report_cs" sourceRef="send_actual_performance_to_cs" targetRef="receive_report_cs" />
    <bpmn:sequenceFlow id="f-undertake_corrections_sm-create_resolution_report_sm" sourceRef="undertake_corrections_sm" targetRef="create_resolution_report_sm" />
    <bpmn:sequenceFlow id="f-create_resolution_report_sm-send_resolution_report_to_cs" sourceRef="create_resolution_report_sm" targetRef="send_resolution_report_to_cs" />
    <bpmn:sequenceFlow id="f-send_resolution_report_to_cs-end_sm" sourceRef="send_resolution_report_to_cs" targetRef="end_sm" />
    <bpmn:sequenceFlow id="f-create_restoration_request-send_restoration_request" sourceRef="create_restoration_request" targetRef="send_restoration_request" />
    <bpmn:sequenceFlow id="f-send_restoration_request-wait_for_restoration_request" sourceRef="send_restoration_request" targetRef="wait_for_restoration_request" />
    <bpmn:sequenceFlow id="f-wait_for_restoration_request-receive_restoration_request" sourceRef="wait_for_restoration_request" targetRef="receive_restoration_request" />
    <bpmn:sequenceFlow id="f-receive_restoration_request-track_errors" sourceRef="receive_restoration_request" targetRef="track_errors" />
    <bpmn:sequenceFlow id="f-track_errors-undertake_corrections_rp" sourceRef="track_errors" targetRef="undertake_corrections_rp" />
    <bpmn:sequenceFlow id="f-undertake_corrections_rp-create_troubleshooting_report" sourceRef="undertake_corrections_rp" targetRef="create_troubleshooting_report" />
    <bpmn:sequenceFlow id="f-create_troubleshooting_report-send_troubleshooting_report" sourceRef="create_troubleshooting_report" targetRef="send_troubleshooting_report" />
    <bpmn:sequenceFlow id="f-send_troubleshooting_report-receive_troubleshooting_report" sourceRef="send_troubleshooting_report" targetRef="receive_troubleshooting_report" />
    <bpmn:sequenceFlow id="f-receive_troubleshooting_report-create_resolution_report_sm" sourceRef="receive_troubleshooting_report" targetRef="create_resolution_report_sm" />
    <bpmn:sequenceFlow id="f-receive_report_cs-main_parallel" sourceRef="receive_report_cs" targetRef="main_parallel" />
    <bpmn:sequenceFlow id="f-main_parallel-create_customer_report" sourceRef="main_parallel" targetRef="create_customer_report" />
    <bpmn:sequenceFlow id="f-create_customer_report-send_customer_report" sourceRef="create_customer_report" targetRef="send_customer_report" />
    <bpmn:sequenceFlow id="f-send_customer_report-parallel_join" sourceRef="send_customer_report" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-main_parallel-report_sla_rebate" sourceRef="main_parallel" targetRef="report_sla_rebate" />
    <bpmn:sequenceFlow id="f-report_sla_rebate-adjust_billing" sourceRef="report_sla_rebate" targetRef="adjust_billing" />
    <bpmn:sequenceFlow id="f-adjust_billing-parallel_join" sourceRef="adjust_billing" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="f-parallel_join-end_cust_service" sourceRef="parallel_join" targetRef="end_cust_service" />
  </bpmn:process>
</bpmn:definitions>
