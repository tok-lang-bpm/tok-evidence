<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Switch-over Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Switch-over Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_withdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="customer_service" name="Customer Service">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cs_import</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cis</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid_operator" name="Grid Operator">
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_grid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old_supplier" name="Old Supplier">
        <bpmn:flowNodeRef>t20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_old</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Switch-over request" />
    <bpmn:task id="t1" name="Transmit customer data" />
    <bpmn:task id="t16" name="Customer checks contract details" />
    <bpmn:exclusiveGateway id="g5" name="Customer withdraws?" />
    <bpmn:task id="t17" name="Withdraw from switch contract" />
    <bpmn:task id="t26" name="Receive final billing" />
    <bpmn:endEvent id="e_customer" name="Customer process ends" />
    <bpmn:endEvent id="e_withdraw" name="Process ends after withdrawal" />
    <bpmn:task id="t2" name="Receive customer data" />
    <bpmn:task id="t3" name="Enter customer data into CRM" />
    <bpmn:task id="t4" name="Compare customer data with internal database and check completeness" />
    <bpmn:exclusiveGateway id="g1" name="Data errors?" />
    <bpmn:task id="t5" name="Correct errors based on error list" />
    <bpmn:exclusiveGateway id="g2" name="Customer exists?" />
    <bpmn:task id="t6" name="Create new customer object" />
    <bpmn:task id="t7" name="Prepare contract documents for power supplier switch" />
    <bpmn:task id="t21" name="Import meter data to systems" />
    <bpmn:endEvent id="e_cs_import" name="Customer Service process ends" />
    <bpmn:task id="t8" name="Automated contract check" />
    <bpmn:exclusiveGateway id="g3" name="Contract check positive?" />
    <bpmn:task id="t9" name="Analyze and resolve contract issues" />
    <bpmn:task id="t10" name="Send confirmation document to customer" />
    <bpmn:task id="t11" name="Send request to Grid Operator" />
    <bpmn:parallelGateway id="g9" name="CIS split to Grid Operator and end" />
    <bpmn:endEvent id="e_cis" name="CIS process ends" />
    <bpmn:task id="t12" name="Check supplier concurrence" />
    <bpmn:exclusiveGateway id="g4" name="Supplier concurrence?" />
    <bpmn:task id="t13" name="Inform all involved suppliers and demand resolution of conflict" />
    <bpmn:task id="t14" name="Communicate with old supplier and terminate sales agreement" />
    <bpmn:task id="t15" name="Create CIS contract" />
    <bpmn:task id="t19" name="Send meter data to Customer Service" />
    <bpmn:parallelGateway id="g8" name="Split meter data to Customer Service and Old Supplier" />
    <bpmn:task id="t22" name="Compute final billing" />
    <bpmn:task id="t23" name="Send final billing to Old Supplier" />
    <bpmn:parallelGateway id="g6" name="Parallel split for post‑acceptance activities" />
    <bpmn:parallelGateway id="g7" name="Parallel join before final ends" />
    <bpmn:endEvent id="e_grid" name="Grid Operator process ends" />
    <bpmn:task id="t20" name="Receive meter data" />
    <bpmn:task id="t24" name="Create final billing for customer" />
    <bpmn:task id="t25" name="Send final billing to customer" />
    <bpmn:endEvent id="e_old" name="Old Supplier process ends" />
    <bpmn:sequenceFlow id="f-s-t1" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-g1" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t5" name="yes" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t4" sourceRef="t5" targetRef="t4" />
    <bpmn:sequenceFlow id="f-g1-g2" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t7" name="yes" sourceRef="g2" targetRef="t7" />
    <bpmn:sequenceFlow id="f-g2-t6" name="no" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-g3" sourceRef="t8" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t10" name="yes" sourceRef="g3" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-t11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-g9" sourceRef="t11" targetRef="g9" />
    <bpmn:sequenceFlow id="f-g9-t12" sourceRef="g9" targetRef="t12" />
    <bpmn:sequenceFlow id="f-g9-e_cis" sourceRef="g9" targetRef="e_cis" />
    <bpmn:sequenceFlow id="f-g3-t9" name="no" sourceRef="g3" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t7" sourceRef="t9" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t12-g4" sourceRef="t12" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-t13" name="yes" sourceRef="g4" targetRef="t13" />
    <bpmn:sequenceFlow id="f-t13-t14" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t14-t16" sourceRef="t14" targetRef="t16" />
    <bpmn:sequenceFlow id="f-g4-t15" name="no" sourceRef="g4" targetRef="t15" />
    <bpmn:sequenceFlow id="f-t15-t16" sourceRef="t15" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t16-g5" sourceRef="t16" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-t17" name="yes" sourceRef="g5" targetRef="t17" />
    <bpmn:sequenceFlow id="f-t17-e_withdraw" sourceRef="t17" targetRef="e_withdraw" />
    <bpmn:sequenceFlow id="f-g5-g6" name="no" sourceRef="g5" targetRef="g6" />
    <bpmn:sequenceFlow id="f-g6-t19" sourceRef="g6" targetRef="t19" />
    <bpmn:sequenceFlow id="f-t19-g8" sourceRef="t19" targetRef="g8" />
    <bpmn:sequenceFlow id="f-g8-t21" sourceRef="g8" targetRef="t21" />
    <bpmn:sequenceFlow id="f-g8-t20" sourceRef="g8" targetRef="t20" />
    <bpmn:sequenceFlow id="f-t21-g7" sourceRef="t21" targetRef="g7" />
    <bpmn:sequenceFlow id="f-t20-e_old" sourceRef="t20" targetRef="e_old" />
    <bpmn:sequenceFlow id="f-g6-t22" sourceRef="g6" targetRef="t22" />
    <bpmn:sequenceFlow id="f-t22-t23" sourceRef="t22" targetRef="t23" />
    <bpmn:sequenceFlow id="f-t23-t24" sourceRef="t23" targetRef="t24" />
    <bpmn:sequenceFlow id="f-t24-t25" sourceRef="t24" targetRef="t25" />
    <bpmn:sequenceFlow id="f-t25-t26" sourceRef="t25" targetRef="t26" />
    <bpmn:sequenceFlow id="f-t26-g7" sourceRef="t26" targetRef="g7" />
    <bpmn:sequenceFlow id="f-g7-e_cs_import" sourceRef="g7" targetRef="e_cs_import" />
    <bpmn:sequenceFlow id="f-g7-e_customer" sourceRef="g7" targetRef="e_customer" />
    <bpmn:sequenceFlow id="f-g7-e_grid" sourceRef="g7" targetRef="e_grid" />
  </bpmn:process>
</bpmn:definitions>
