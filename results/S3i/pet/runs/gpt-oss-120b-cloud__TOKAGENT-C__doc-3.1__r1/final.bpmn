<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant Possession Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Warrant Possession Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_expanded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>send_report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send" name="Send warrant possession request" />
    <bpmn:task id="receive" name="Receive warrant possession request" />
    <bpmn:task id="retrieve1" name="Retrieve SCT file" />
    <bpmn:task id="forward" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store_await" name="Store SCT physical file awaiting report" />
    <bpmn:task id="receive_report" name="Receive police report" />
    <bpmn:task id="retrieve2" name="Retrieve SCT file" />
    <bpmn:task id="attach" name="Attach new SCT document" />
    <bpmn:task id="store_expanded" name="Store expanded SCT physical file" />
    <bpmn:endEvent id="done" name="Process completed" />
    <bpmn:task id="send_report" name="Send police report" />
    <bpmn:sequenceFlow id="f-start-send" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-receive" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-retrieve1" sourceRef="receive" targetRef="retrieve1" />
    <bpmn:sequenceFlow id="f-retrieve1-forward" sourceRef="retrieve1" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-store_await" sourceRef="forward" targetRef="store_await" />
    <bpmn:sequenceFlow id="f-store_await-send_report" sourceRef="store_await" targetRef="send_report" />
    <bpmn:sequenceFlow id="f-send_report-receive_report" sourceRef="send_report" targetRef="receive_report" />
    <bpmn:sequenceFlow id="f-receive_report-retrieve2" sourceRef="receive_report" targetRef="retrieve2" />
    <bpmn:sequenceFlow id="f-retrieve2-attach" sourceRef="retrieve2" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-store_expanded" sourceRef="attach" targetRef="store_expanded" />
    <bpmn:sequenceFlow id="f-store_expanded-done" sourceRef="store_expanded" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
