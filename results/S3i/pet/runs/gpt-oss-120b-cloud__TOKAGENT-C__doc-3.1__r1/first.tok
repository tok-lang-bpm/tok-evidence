tok 1.0 "Warrant Possession Process" [executable]

pool org "Organisation"
  lane party "Party"
    start start "Start"
    task send "Send warrant possession request"
  lane backoffice "Client Service Back Office"
    task receive "Receive warrant possession request"
    task retrieve1 "Retrieve SCT file"
    task forward "Forward SCT Warrant Possession to Queensland Police"
    task store_await "Store SCT physical file awaiting report"
    task receive_report "Receive police report"
    task retrieve2 "Retrieve SCT file"
    task attach "Attach new SCT document"
    task store_expanded "Store expanded SCT physical file"
    end done "Process completed"
  lane police "Queensland Police"
    task send_report "Send police report"

flow start -> send -> receive -> retrieve1 -> forward -> store_await -> send_report -> receive_report -> retrieve2 -> attach -> store_expanded -> done
