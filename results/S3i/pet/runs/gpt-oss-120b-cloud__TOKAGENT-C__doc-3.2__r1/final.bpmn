<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Morning file preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Morning file preparation" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="staff" name="Staff">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="check" name="Check files" />
    <bpmn:exclusiveGateway id="missing" name="Files missing?" />
    <bpmn:task id="search" name="Initiate search" />
    <bpmn:task id="track" name="Track files to intended location" />
    <bpmn:exclusiveGateway id="ready" name="Ready for parallel tasks" />
    <bpmn:parallelGateway id="split" name="Prepare files" />
    <bpmn:task id="hand" name="Hand files to Associate" />
    <bpmn:task id="distribute" name="Distribute Judgeis Lawlist" />
    <bpmn:parallelGateway id="join" name="Ready for hearing" />
    <bpmn:task id="conduct" name="Conduct directions hearings" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-check" sourceRef="s" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-split" sourceRef="ready" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-hand" sourceRef="split" targetRef="hand" />
    <bpmn:sequenceFlow id="f-split-distribute" sourceRef="split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-join" sourceRef="hand" targetRef="join" />
    <bpmn:sequenceFlow id="f-distribute-join" sourceRef="distribute" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-conduct" sourceRef="join" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-e" sourceRef="conduct" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
