tok 1.0 "Morning file preparation"

pool court "Court"
  lane staff "Staff"
    start s "Start"
    task check "Check files"
    xor missing "Files missing?"
    task search "Initiate search"
    task track "Track files to intended location"
    xor ready "Ready for parallel tasks"
    and split "Prepare files"
    task hand "Hand files to Associate"
    task distribute "Distribute Judgeis Lawlist"
    and join "Ready for hearing"
    task conduct "Conduct directions hearings"
    end e "End"

    flow s -> check -> missing
    flow missing -> search "yes"
    flow missing -> track "no"
    flow search -> ready
    flow track -> ready
    flow ready -> split
    flow split -> hand
    flow split -> distribute
    flow hand -> join
    flow distribute -> join
    flow join -> conduct -> e
