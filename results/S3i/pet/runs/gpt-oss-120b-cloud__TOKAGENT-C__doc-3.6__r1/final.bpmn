<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims Notification Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claims Notification Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="claims" name="Claims Department">
        <bpmn:flowNodeRef>claim_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_insurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_simple_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_complex_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forms_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_updated_forms</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim_received" name="Claim received" />
    <bpmn:task id="check_insurance" name="Check insurance" />
    <bpmn:exclusiveGateway id="insured" name="Insured?" />
    <bpmn:task id="inform_rejection" name="Inform claimant of rejection" />
    <bpmn:endEvent id="rejected" name="Process ended" />
    <bpmn:task id="evaluate_severity" name="Evaluate claim severity" />
    <bpmn:exclusiveGateway id="severity" name="Claim severity?" />
    <bpmn:task id="send_simple_form" name="Send simple claim form" />
    <bpmn:task id="send_complex_form" name="Send complex claim form" />
    <bpmn:task id="receive_forms" name="Receive returned forms" />
    <bpmn:task id="check_forms" name="Check forms completeness" />
    <bpmn:exclusiveGateway id="forms_complete" name="Forms complete?" />
    <bpmn:task id="register_claim" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="completed" name="Claims Notification process ended" />
    <bpmn:task id="inform_update" name="Inform claimant to update forms" />
    <bpmn:task id="receive_updated_forms" name="Receive updated forms" />
    <bpmn:sequenceFlow id="f-claim_received-check_insurance" sourceRef="claim_received" targetRef="check_insurance" />
    <bpmn:sequenceFlow id="f-check_insurance-insured" sourceRef="check_insurance" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-inform_rejection" name="no" sourceRef="insured" targetRef="inform_rejection" />
    <bpmn:sequenceFlow id="f-inform_rejection-rejected" sourceRef="inform_rejection" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-insured-evaluate_severity" name="yes" sourceRef="insured" targetRef="evaluate_severity" />
    <bpmn:sequenceFlow id="f-evaluate_severity-severity" sourceRef="evaluate_severity" targetRef="severity" />
    <bpmn:sequenceFlow id="f-severity-send_simple_form" name="simple" sourceRef="severity" targetRef="send_simple_form" />
    <bpmn:sequenceFlow id="f-severity-send_complex_form" name="complex" sourceRef="severity" targetRef="send_complex_form" />
    <bpmn:sequenceFlow id="f-send_simple_form-receive_forms" sourceRef="send_simple_form" targetRef="receive_forms" />
    <bpmn:sequenceFlow id="f-send_complex_form-receive_forms" sourceRef="send_complex_form" targetRef="receive_forms" />
    <bpmn:sequenceFlow id="f-receive_forms-check_forms" sourceRef="receive_forms" targetRef="check_forms" />
    <bpmn:sequenceFlow id="f-check_forms-forms_complete" sourceRef="check_forms" targetRef="forms_complete" />
    <bpmn:sequenceFlow id="f-forms_complete-register_claim" name="yes" sourceRef="forms_complete" targetRef="register_claim" />
    <bpmn:sequenceFlow id="f-register_claim-completed" sourceRef="register_claim" targetRef="completed" />
    <bpmn:sequenceFlow id="f-forms_complete-inform_update" name="no" sourceRef="forms_complete" targetRef="inform_update" />
    <bpmn:sequenceFlow id="f-inform_update-receive_updated_forms" sourceRef="inform_update" targetRef="receive_updated_forms" />
    <bpmn:sequenceFlow id="f-receive_updated_forms-check_forms" sourceRef="receive_updated_forms" targetRef="check_forms" />
  </bpmn:process>
</bpmn:definitions>
