tok 1.0 "Claims Notification Process"

pool org "Organization"
  lane claims "Claims Department"
    start claim_received "Claim received"
    task check_insurance "Check insurance"
    xor insured "Insured?"
    task inform_rejection "Inform claimant of rejection"
    end rejected "Process ended"
    task evaluate_severity "Evaluate claim severity"
    xor severity "Claim severity?"
    task send_simple_form "Send simple claim form"
    task send_complex_form "Send complex claim form"
    task receive_forms "Receive returned forms"
    task check_forms "Check forms completeness"
    xor forms_complete "Forms complete?"
    task register_claim "Register claim in Claims Management system"
    end completed "Claims Notification process ended"
    task inform_update "Inform claimant to update forms"
    task receive_updated_forms "Receive updated forms"

    flow claim_received -> check_insurance -> insured
    flow insured -> inform_rejection "no"
    flow inform_rejection -> rejected
    flow insured -> evaluate_severity "yes"
    flow evaluate_severity -> severity
    flow severity -> send_simple_form "simple"
    flow severity -> send_complex_form "complex"
    flow send_simple_form -> receive_forms
    flow send_complex_form -> receive_forms
    flow receive_forms -> check_forms
    flow check_forms -> forms_complete
    flow forms_complete -> register_claim "yes"
    flow register_claim -> completed
    flow forms_complete -> inform_update "no"
    flow inform_update -> receive_updated_forms
    flow receive_updated_forms -> check_forms
