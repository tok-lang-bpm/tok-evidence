<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims settlement process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurance" name="Insurance Company" processRef="insurance-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurance-process" name="Claims settlement process" isExecutable="false">
    <bpmn:laneSet id="insurance-lanes">
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handler" name="Claims Handler">
        <bpmn:flowNodeRef>estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims Manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="claimant" name="Claimant">
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:task id="search" name="Search Police Report and file with Claim Documentation" />
    <bpmn:task id="estimate" name="Calculate initial claim estimate" />
    <bpmn:task id="plan" name="Create Action Plan" />
    <bpmn:task id="negotiate" name="Negotiate settlement" />
    <bpmn:task id="inform" name="Inform claimant" />
    <bpmn:endEvent id="e" name="End" />
    <bpmn:sequenceFlow id="f-s-search" sourceRef="s" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-estimate" sourceRef="search" targetRef="estimate" />
    <bpmn:sequenceFlow id="f-estimate-plan" sourceRef="estimate" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-negotiate" sourceRef="plan" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-inform" sourceRef="negotiate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-e" sourceRef="inform" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
