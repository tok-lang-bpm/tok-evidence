tok 1.0 "Claims settlement process"

pool insurance "Insurance Company"
  lane system "System"
    start s "Start"
    task search "Search Police Report and file with Claim Documentation"
  lane handler "Claims Handler"
    task estimate "Calculate initial claim estimate"
    task plan "Create Action Plan"
  lane manager "Claims Manager"
    task negotiate "Negotiate settlement"
  lane claimant "Claimant"
    task inform "Inform claimant"
    end e "End"

flow s -> search -> estimate -> plan -> negotiate -> inform -> e