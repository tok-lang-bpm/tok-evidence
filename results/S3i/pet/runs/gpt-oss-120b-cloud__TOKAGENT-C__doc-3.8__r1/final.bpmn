<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling process" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>start_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit_claim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification Department">
        <bpmn:flowNodeRef>check_register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling Department">
        <bpmn:flowNodeRef>pick_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone_garage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_claim" name="Customer submits claim" />
    <bpmn:task id="submit_claim" name="Submit claim and send documentation" />
    <bpmn:task id="check_register" name="Check documents and register claim" />
    <bpmn:task id="pick_check" name="Pick up claim and check insurance" />
    <bpmn:task id="perform_assessment" name="Perform assessment" />
    <bpmn:exclusiveGateway id="assess_gateway" name="Assessment positive?" />
    <bpmn:task id="phone_garage" name="Phone garage to authorise repairs" />
    <bpmn:task id="schedule_payment" name="Schedule payment" />
    <bpmn:task id="reject_claim" name="Reject claim" />
    <bpmn:exclusiveGateway id="merge_assess" name="Merge assessment outcomes" />
    <bpmn:task id="send_letter" name="Send letter to customer" />
    <bpmn:endEvent id="end_process" name="Process complete" />
    <bpmn:sequenceFlow id="f-start_claim-submit_claim" sourceRef="start_claim" targetRef="submit_claim" />
    <bpmn:sequenceFlow id="f-submit_claim-check_register" sourceRef="submit_claim" targetRef="check_register" />
    <bpmn:sequenceFlow id="f-check_register-pick_check" sourceRef="check_register" targetRef="pick_check" />
    <bpmn:sequenceFlow id="f-pick_check-perform_assessment" sourceRef="pick_check" targetRef="perform_assessment" />
    <bpmn:sequenceFlow id="f-perform_assessment-assess_gateway" sourceRef="perform_assessment" targetRef="assess_gateway" />
    <bpmn:sequenceFlow id="f-assess_gateway-phone_garage" name="yes" sourceRef="assess_gateway" targetRef="phone_garage" />
    <bpmn:sequenceFlow id="f-phone_garage-schedule_payment" sourceRef="phone_garage" targetRef="schedule_payment" />
    <bpmn:sequenceFlow id="f-schedule_payment-merge_assess" sourceRef="schedule_payment" targetRef="merge_assess" />
    <bpmn:sequenceFlow id="f-assess_gateway-reject_claim" name="no" sourceRef="assess_gateway" targetRef="reject_claim" />
    <bpmn:sequenceFlow id="f-reject_claim-merge_assess" sourceRef="reject_claim" targetRef="merge_assess" />
    <bpmn:sequenceFlow id="f-merge_assess-send_letter" sourceRef="merge_assess" targetRef="send_letter" />
    <bpmn:sequenceFlow id="f-send_letter-end_process" sourceRef="send_letter" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
