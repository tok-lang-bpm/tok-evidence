tok 1.0 "Claim handling process"

pool insurer "Car Insurer"
  lane customer "Customer"
    start start_claim "Customer submits claim"
    task submit_claim "Submit claim and send documentation"
  lane notification "Notification Department"
    task check_register "Check documents and register claim"
  lane handling "Handling Department"
    task pick_check "Pick up claim and check insurance"
    task perform_assessment "Perform assessment"
    xor assess_gateway "Assessment positive?"
    task phone_garage "Phone garage to authorise repairs"
    task schedule_payment "Schedule payment"
    task reject_claim "Reject claim"
    xor merge_assess "Merge assessment outcomes"
    task send_letter "Send letter to customer"
    end end_process "Process complete"

flow start_claim -> submit_claim -> check_register -> pick_check -> perform_assessment -> assess_gateway
flow assess_gateway -> phone_garage "yes"
flow phone_garage -> schedule_payment -> merge_assess
flow assess_gateway -> reject_claim "no"
flow reject_claim -> merge_assess
flow merge_assess -> send_letter -> end_process
