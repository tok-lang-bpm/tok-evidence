tok 1.0 "Intake workflow"

pool institute "Mental Health Care Institute"
  lane family_doctor "Family Doctor"
    start s0 "Intake notice by telephone"
    task t1 "Make notice by telephone"
  lane secretarial "Secretarial Office"
    task t2 "Inquire name and residence of patient"
    task t3 "Refer doctor to nursing officer"
    task t4 "Hand registration form to secretarial office"
    task t5 "Store information in information system"
    task t6 "Print information"
    task t7 "Create patient file (if new)"
    task t8 "Store registration form and print in patient file"
    task t9 "Produce registration cards for first and second intaker"
    task t10 "Add new patient to list of new notices"
    task t11 "Staff meeting (Wednesday) of medical team"
    task t12 "Assign new patients to intakers"
    task t13 "Record assignments on assignment list"
    task t14 "Hand assignment list to secretarial office"
    task t15 "Store assignment in information system"
    task t16 "Pass registration cards to first and second intaker"
    xor g1 "Medical file required?"
    task t17 "Prepare and send letter to family doctor"
    task t18 "Receive medical file copy"
    task t19 "Inform second intaker of received file"
    task t20 "Add medical file copy to patient file"
    and g2 "Parallel split"
    and g3 "Parallel join"
    task t21 "Add patient to status list"
    task t22 "Provide status list to team leader"
    task t23 "Formulate treatment plan"
    end e0 "Intake procedure completed"
  lane nursing_officer "Nursing Officer"
    task n1 "Make full inquiry into mental, health, and social state"
    task n2 "Record information on registration form"
  lane team_leader "Team Leader"
    # tasks already in secretarial lane (t11, t12, t23) – no extra tasks needed
  lane first_intaker "First Intaker"
    task f1 "Plan first meeting"
    task f2 "Conduct first meeting"
    task f3 "Fill out standard checklist"
    task f4 "Register additional observations in notebook"
    task f5 "Store notes in patient file"
    task f6 "Store checklist in patient file"
  lane second_intaker "Second Intaker"
    task s1 "Plan second meeting"
    task s2 "Conduct second meeting"
    task s3 "Record observations with dictaphone"
    task s4 "Type out dictaphone recordings"
    task s5 "Store typed information in patient file"
  lane psychiatrist "Psychiatrist"
    # No specific tasks defined

flow s0 -> t1 -> t2
flow t2 -> t3
flow t3 -> n1
flow n1 -> n2 -> t4
flow t4 -> t5 -> t6 -> t7 -> t8 -> t9 -> t10 -> t11 -> t12 -> t13 -> t14 -> t15 -> t16
flow t16 -> g2
flow g2 -> f1
flow g2 -> g1
flow g1 -> t17 "yes"
flow g1 -> s1 "no"
flow t17 -> t18 -> t19 -> t20 -> s1
flow s1 -> s2 -> s3 -> s4 -> s5 -> g3
flow f1 -> f2 -> f3 -> f4 -> f5 -> f6 -> g3
flow g3 -> t21 -> t22 -> t23 -> e0
