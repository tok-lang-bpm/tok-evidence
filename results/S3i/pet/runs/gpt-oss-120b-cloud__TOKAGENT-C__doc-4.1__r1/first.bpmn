<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental Health Care Institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="family_doctor" name="Family Doctor">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secretarial" name="Secretarial Office">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing_officer" name="Nursing Officer">
        <bpmn:flowNodeRef>n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team_leader" name="Team Leader" />
      <bpmn:lane id="first_intaker" name="First Intaker">
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second_intaker" name="Second Intaker">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="psychiatrist" name="Psychiatrist" />
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Intake notice by telephone" />
    <bpmn:task id="t1" name="Make notice by telephone" />
    <bpmn:task id="t2" name="Inquire name and residence of patient" />
    <bpmn:task id="t3" name="Refer doctor to nursing officer" />
    <bpmn:task id="t4" name="Hand registration form to secretarial office" />
    <bpmn:task id="t5" name="Store information in information system" />
    <bpmn:task id="t6" name="Print information" />
    <bpmn:task id="t7" name="Create patient file (if new)" />
    <bpmn:task id="t8" name="Store registration form and print in patient file" />
    <bpmn:task id="t9" name="Produce registration cards for first and second intaker" />
    <bpmn:task id="t10" name="Add new patient to list of new notices" />
    <bpmn:task id="t11" name="Staff meeting (Wednesday) of medical team" />
    <bpmn:task id="t12" name="Assign new patients to intakers" />
    <bpmn:task id="t13" name="Record assignments on assignment list" />
    <bpmn:task id="t14" name="Hand assignment list to secretarial office" />
    <bpmn:task id="t15" name="Store assignment in information system" />
    <bpmn:task id="t16" name="Pass registration cards to first and second intaker" />
    <bpmn:exclusiveGateway id="g1" name="Medical file required?" />
    <bpmn:task id="t17" name="Prepare and send letter to family doctor" />
    <bpmn:task id="t18" name="Receive medical file copy" />
    <bpmn:task id="t19" name="Inform second intaker of received file" />
    <bpmn:task id="t20" name="Add medical file copy to patient file" />
    <bpmn:parallelGateway id="g2" name="Parallel split" />
    <bpmn:parallelGateway id="g3" name="Parallel join" />
    <bpmn:task id="t21" name="Add patient to status list" />
    <bpmn:task id="t22" name="Provide status list to team leader" />
    <bpmn:task id="t23" name="Formulate treatment plan" />
    <bpmn:endEvent id="e0" name="Intake procedure completed" />
    <bpmn:task id="n1" name="Make full inquiry into mental, health, and social state" />
    <bpmn:task id="n2" name="Record information on registration form" />
    <bpmn:task id="f1" name="Plan first meeting" />
    <bpmn:task id="f2" name="Conduct first meeting" />
    <bpmn:task id="f3" name="Fill out standard checklist" />
    <bpmn:task id="f4" name="Register additional observations in notebook" />
    <bpmn:task id="f5" name="Store notes in patient file" />
    <bpmn:task id="f6" name="Store checklist in patient file" />
    <bpmn:task id="s1" name="Plan second meeting" />
    <bpmn:task id="s2" name="Conduct second meeting" />
    <bpmn:task id="s3" name="Record observations with dictaphone" />
    <bpmn:task id="s4" name="Type out dictaphone recordings" />
    <bpmn:task id="s5" name="Store typed information in patient file" />
    <bpmn:sequenceFlow id="f-s0-t1" sourceRef="s0" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-n1" sourceRef="t3" targetRef="n1" />
    <bpmn:sequenceFlow id="f-n1-n2" sourceRef="n1" targetRef="n2" />
    <bpmn:sequenceFlow id="f-n2-t4" sourceRef="n2" targetRef="t4" />
    <bpmn:sequenceFlow id="f-t4-t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f-t7-t8" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t8-t9" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f-t9-t10" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f-t10-t11" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f-t11-t12" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f-t12-t13" sourceRef="t12" targetRef="t13" />
    <bpmn:sequenceFlow id="f-t13-t14" sourceRef="t13" targetRef="t14" />
    <bpmn:sequenceFlow id="f-t14-t15" sourceRef="t14" targetRef="t15" />
    <bpmn:sequenceFlow id="f-t15-t16" sourceRef="t15" targetRef="t16" />
    <bpmn:sequenceFlow id="f-t16-g2" sourceRef="t16" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-f1" sourceRef="g2" targetRef="f1" />
    <bpmn:sequenceFlow id="f-g2-g1" sourceRef="g2" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t17" name="yes" sourceRef="g1" targetRef="t17" />
    <bpmn:sequenceFlow id="f-g1-s1" name="no" sourceRef="g1" targetRef="s1" />
    <bpmn:sequenceFlow id="f-t17-t18" sourceRef="t17" targetRef="t18" />
    <bpmn:sequenceFlow id="f-t18-t19" sourceRef="t18" targetRef="t19" />
    <bpmn:sequenceFlow id="f-t19-t20" sourceRef="t19" targetRef="t20" />
    <bpmn:sequenceFlow id="f-t20-s1" sourceRef="t20" targetRef="s1" />
    <bpmn:sequenceFlow id="f-s1-s2" sourceRef="s1" targetRef="s2" />
    <bpmn:sequenceFlow id="f-s2-s3" sourceRef="s2" targetRef="s3" />
    <bpmn:sequenceFlow id="f-s3-s4" sourceRef="s3" targetRef="s4" />
    <bpmn:sequenceFlow id="f-s4-s5" sourceRef="s4" targetRef="s5" />
    <bpmn:sequenceFlow id="f-s5-g3" sourceRef="s5" targetRef="g3" />
    <bpmn:sequenceFlow id="f-f1-f2" sourceRef="f1" targetRef="f2" />
    <bpmn:sequenceFlow id="f-f2-f3" sourceRef="f2" targetRef="f3" />
    <bpmn:sequenceFlow id="f-f3-f4" sourceRef="f3" targetRef="f4" />
    <bpmn:sequenceFlow id="f-f4-f5" sourceRef="f4" targetRef="f5" />
    <bpmn:sequenceFlow id="f-f5-f6" sourceRef="f5" targetRef="f6" />
    <bpmn:sequenceFlow id="f-f6-g3" sourceRef="f6" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t21" sourceRef="g3" targetRef="t21" />
    <bpmn:sequenceFlow id="f-t21-t22" sourceRef="t21" targetRef="t22" />
    <bpmn:sequenceFlow id="f-t22-t23" sourceRef="t22" targetRef="t23" />
    <bpmn:sequenceFlow id="f-t23-e0" sourceRef="t23" targetRef="e0" />
  </bpmn:process>
</bpmn:definitions>
