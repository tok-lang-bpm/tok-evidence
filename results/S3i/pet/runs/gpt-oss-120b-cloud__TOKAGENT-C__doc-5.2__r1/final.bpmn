<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Vacation Request Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacation Request Process" isExecutable="true">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_generate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Human Resources Representative">
        <bpmn:flowNodeRef>t_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Vacation request submitted" />
    <bpmn:task id="t_submit" name="Submit vacation request" />
    <bpmn:task id="t_register" name="Register vacation request" />
    <bpmn:task id="t_review" name="Review rejection reasons" />
    <bpmn:endEvent id="e_rejected" name="Request rejected" />
    <bpmn:task id="t_receive" name="Receive vacation request" />
    <bpmn:exclusiveGateway id="xor1" name="Approve vacation request?" />
    <bpmn:task id="t_generate" name="Generate notification to HR" />
    <bpmn:task id="t_complete" name="Complete management procedures" />
    <bpmn:endEvent id="e_approved" name="Request approved" />
    <bpmn:sequenceFlow id="f-s1-t_submit" sourceRef="s1" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f-t_submit-t_register" sourceRef="t_submit" targetRef="t_register" />
    <bpmn:sequenceFlow id="f-t_register-t_receive" sourceRef="t_register" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f-t_receive-xor1" sourceRef="t_receive" targetRef="xor1" />
    <bpmn:sequenceFlow id="f-xor1-t_generate" name="approved" sourceRef="xor1" targetRef="t_generate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-xor1-t_review" name="rejected" sourceRef="xor1" targetRef="t_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-t_generate-t_complete" sourceRef="t_generate" targetRef="t_complete" />
    <bpmn:sequenceFlow id="f-t_complete-e_approved" sourceRef="t_complete" targetRef="e_approved" />
    <bpmn:sequenceFlow id="f-t_review-e_rejected" sourceRef="t_review" targetRef="e_rejected" />
  </bpmn:process>
</bpmn:definitions>
