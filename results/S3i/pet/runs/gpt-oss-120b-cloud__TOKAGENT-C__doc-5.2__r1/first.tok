tok 1.0 "Vacation Request Process" executable
    pool org "Organization"
      lane employee "Employee"
        start s1 "Vacation request submitted"
        task t_submit "Submit vacation request"
        task t_register "Register vacation request"
        task t_review "Review rejection reasons"
        end e_rejected "Request rejected"
      lane supervisor "Supervisor"
        task t_receive "Receive vacation request"
        xor xor1 "Approve vacation request?"
        task t_generate "Generate notification to HR"
      lane hr "Human Resources Representative"
        task t_complete "Complete management procedures"
        end e_approved "Request approved"

flow s1 -> t_submit -> t_register -> t_receive -> xor1
flow xor1 -> t_generate "approved"
flow xor1 -> t_review "rejected"
flow t_generate -> t_complete
flow t_complete -> e_approved
flow t_review -> e_rejected
