<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Office Supply Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Office Supply Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_supervisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="purchase" name="Purchase Department">
        <bpmn:flowNodeRef>t_quot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_choose</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>t_notif_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_genpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notif_res</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Office supply request started" />
    <bpmn:task id="t_submit" name="Submit office supply request" />
    <bpmn:task id="t_review" name="Review change comments" />
    <bpmn:endEvent id="e_reject" name="Request rejected" />
    <bpmn:endEvent id="e_done" name="Request completed" />
    <bpmn:task id="t_receive" name="Receive office supply request" />
    <bpmn:exclusiveGateway id="d_supervisor" name="Supervisor decision" />
    <bpmn:task id="t_quot" name="Make quotations and select vendor" />
    <bpmn:exclusiveGateway id="g_vendor" name="Vendor valid?" />
    <bpmn:task id="t_choose" name="Choose different vendor" />
    <bpmn:task id="t_notif_rej" name="Send rejection notification" />
    <bpmn:task id="t_genpo" name="Generate and send purchase order" />
    <bpmn:task id="t_wait" name="Wait for product delivery and invoice" />
    <bpmn:task id="t_notif_res" name="Send result notification" />
    <bpmn:sequenceFlow id="f-s-t_submit" sourceRef="s" targetRef="t_submit" />
    <bpmn:sequenceFlow id="f-t_submit-t_receive" sourceRef="t_submit" targetRef="t_receive" />
    <bpmn:sequenceFlow id="f-t_receive-d_supervisor" sourceRef="t_receive" targetRef="d_supervisor" />
    <bpmn:sequenceFlow id="f-d_supervisor-t_notif_rej" name="Reject" sourceRef="d_supervisor" targetRef="t_notif_rej" />
    <bpmn:sequenceFlow id="f-t_notif_rej-e_reject" sourceRef="t_notif_rej" targetRef="e_reject" />
    <bpmn:sequenceFlow id="f-d_supervisor-t_review" name="Change" sourceRef="d_supervisor" targetRef="t_review" />
    <bpmn:sequenceFlow id="f-t_review-d_supervisor" sourceRef="t_review" targetRef="d_supervisor" />
    <bpmn:sequenceFlow id="f-d_supervisor-t_quot" name="Approve" sourceRef="d_supervisor" targetRef="t_quot" />
    <bpmn:sequenceFlow id="f-t_quot-g_vendor" sourceRef="t_quot" targetRef="g_vendor" />
    <bpmn:sequenceFlow id="f-g_vendor-t_genpo" name="Valid" sourceRef="g_vendor" targetRef="t_genpo" />
    <bpmn:sequenceFlow id="f-g_vendor-t_choose" name="Invalid" sourceRef="g_vendor" targetRef="t_choose" />
    <bpmn:sequenceFlow id="f-t_choose-g_vendor" sourceRef="t_choose" targetRef="g_vendor" />
    <bpmn:sequenceFlow id="f-t_genpo-t_wait" sourceRef="t_genpo" targetRef="t_wait" />
    <bpmn:sequenceFlow id="f-t_wait-t_notif_res" sourceRef="t_wait" targetRef="t_notif_res" />
    <bpmn:sequenceFlow id="f-t_notif_res-e_done" sourceRef="t_notif_res" targetRef="e_done" />
  </bpmn:process>
</bpmn:definitions>
