<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense Report Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense Report Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipts_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_back</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="purchase" name="Purchases a product or service" />
    <bpmn:task id="submit" name="Submits expense report with receipts" />
    <bpmn:task id="edit" name="Edits expense report" />
    <bpmn:task id="review" name="Reviews expense report" />
    <bpmn:exclusiveGateway id="approval" name="Supervisor approves?" />
    <bpmn:task id="check" name="Checks receipts" />
    <bpmn:exclusiveGateway id="receipts_ok" name="Receipts in order?" />
    <bpmn:task id="accept" name="Accepts expenses for processing" />
    <bpmn:task id="send_back" name="Sends report back to employee" />
    <bpmn:task id="link" name="Links to payment system" />
    <bpmn:task id="wait" name="Waits for payment confirmation" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-purchase" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approval" sourceRef="review" targetRef="approval" />
    <bpmn:sequenceFlow id="f-approval-check" name="approve" sourceRef="approval" targetRef="check" />
    <bpmn:sequenceFlow id="f-approval-edit" name="reject" sourceRef="approval" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-review" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f-check-receipts_ok" sourceRef="check" targetRef="receipts_ok" />
    <bpmn:sequenceFlow id="f-receipts_ok-accept" name="yes" sourceRef="receipts_ok" targetRef="accept" />
    <bpmn:sequenceFlow id="f-receipts_ok-send_back" name="no" sourceRef="receipts_ok" targetRef="send_back" />
    <bpmn:sequenceFlow id="f-accept-link" sourceRef="accept" targetRef="link" />
    <bpmn:sequenceFlow id="f-link-wait" sourceRef="link" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-end" sourceRef="wait" targetRef="end" />
    <bpmn:sequenceFlow id="f-send_back-edit" sourceRef="send_back" targetRef="edit" />
  </bpmn:process>
</bpmn:definitions>
