tok 1.0 "Expense Report Process"

pool org "Organisation"
  lane employee "Employee"
    start start "Start"
    task purchase "Purchases a product or service"
    task submit "Submits expense report with receipts"
    task edit "Edits expense report"
  lane supervisor "Supervisor"
    task review "Reviews expense report"
    xor approval "Supervisor approves?"
  lane treasurer "Treasurer"
    task check "Checks receipts"
    xor receipts_ok "Receipts in order?"
    task accept "Accepts expenses for processing"
    task send_back "Sends report back to employee"
  lane system "System"
    task link "Links to payment system"
    task wait "Waits for payment confirmation"
    end end "Process completed"

flow start -> purchase -> submit -> review -> approval
flow approval -> check "approve"
flow approval -> edit "reject"
flow edit -> review
flow check -> receipts_ok
flow receipts_ok -> accept "yes"
flow receipts_ok -> send_back "no"
flow accept -> link
flow link -> wait
flow wait -> end
flow send_back -> edit
