<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice processing" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="secretariat" name="Secretariat">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="accounting" name="Accounting Employee">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Cost Center Manager">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>snext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="commercial" name="Commercial Manager">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Start" />
    <bpmn:task id="r1" name="Receive invoice on paper or fax" />
    <bpmn:task id="i1" name="Visual inspection" />
    <bpmn:task id="f1" name="Forward invoice to accounting employee" />
    <bpmn:task id="a1" name="Identify charging suppliers and create invoice instance" />
    <bpmn:task id="a2" name="Check invoice items and note cost centers on docket" />
    <bpmn:task id="a3" name="Send docket and copy of invoice to internal mail" />
    <bpmn:task id="a4" name="Clarify with vendor" />
    <bpmn:task id="a5" name="Consult cost center managers" />
    <bpmn:task id="a6" name="Forward copy to commercial manager" />
    <bpmn:task id="resolve" name="Resolve complaint with supplier" />
    <bpmn:task id="a7" name="Give payment instructions and close invoice" />
    <bpmn:endEvent id="e1" name="End" />
    <bpmn:exclusiveGateway id="g1" name="Is position accurate?" />
    <bpmn:task id="n1" name="Note AP on docket" />
    <bpmn:exclusiveGateway id="g2" name="All items marked accurate?" />
    <bpmn:task id="snext" name="Send copy to next cost center manager" />
    <bpmn:task id="sback" name="Send copy back to accounting" />
    <bpmn:task id="r2" name="Reject AP with note" />
    <bpmn:task id="c1" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="g4" name="Complaint?" />
    <bpmn:exclusiveGateway id="g3" name="Amount &gt; EUR 20?" />
    <bpmn:task id="b1" name="Board review" />
    <bpmn:sequenceFlow id="f-s0-r1" sourceRef="s0" targetRef="r1" />
    <bpmn:sequenceFlow id="f-r1-i1" sourceRef="r1" targetRef="i1" />
    <bpmn:sequenceFlow id="f-i1-f1" sourceRef="i1" targetRef="f1" />
    <bpmn:sequenceFlow id="f-f1-a1" sourceRef="f1" targetRef="a1" />
    <bpmn:sequenceFlow id="f-a1-a2" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="f-a2-a3" sourceRef="a2" targetRef="a3" />
    <bpmn:sequenceFlow id="f-a3-g1" sourceRef="a3" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-n1" name="yes" sourceRef="g1" targetRef="n1" />
    <bpmn:sequenceFlow id="f-g1-r2" name="no" sourceRef="g1" targetRef="r2" />
    <bpmn:sequenceFlow id="f-n1-g2" sourceRef="n1" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-sback" name="yes" sourceRef="g2" targetRef="sback" />
    <bpmn:sequenceFlow id="f-g2-snext" name="no" sourceRef="g2" targetRef="snext" />
    <bpmn:sequenceFlow id="f-snext-a3" sourceRef="snext" targetRef="a3" />
    <bpmn:sequenceFlow id="f-r2-a4" sourceRef="r2" targetRef="a4" />
    <bpmn:sequenceFlow id="f-a4-a5" sourceRef="a4" targetRef="a5" />
    <bpmn:sequenceFlow id="f-a5-a3" sourceRef="a5" targetRef="a3" />
    <bpmn:sequenceFlow id="f-sback-a6" sourceRef="sback" targetRef="a6" />
    <bpmn:sequenceFlow id="f-a6-c1" sourceRef="a6" targetRef="c1" />
    <bpmn:sequenceFlow id="f-c1-g4" sourceRef="c1" targetRef="g4" />
    <bpmn:sequenceFlow id="f-g4-resolve" name="yes" sourceRef="g4" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-a7" sourceRef="resolve" targetRef="a7" />
    <bpmn:sequenceFlow id="f-g4-g3" name="no" sourceRef="g4" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-b1" name="yes" sourceRef="g3" targetRef="b1" />
    <bpmn:sequenceFlow id="f-g3-a7" name="no" sourceRef="g3" targetRef="a7" />
    <bpmn:sequenceFlow id="f-b1-a7" sourceRef="b1" targetRef="a7" />
    <bpmn:sequenceFlow id="f-a7-e1" sourceRef="a7" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>
