<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Monthly parts ordering" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Monthly parts ordering" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Monthly order start">
      <bpmn:timerEventDefinition id="start-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="send_order" name="Send order to supplier" />
    <bpmn:task id="receive_invoice" name="Receive invoice" />
    <bpmn:endEvent id="end_process" name="Process completed" />
    <bpmn:task id="process_order" name="Process order" />
    <bpmn:task id="send_invoice" name="Send invoice to Assembler AG" />
    <bpmn:sequenceFlow id="f-start-send_order" sourceRef="start" targetRef="send_order" />
    <bpmn:sequenceFlow id="f-send_order-process_order" sourceRef="send_order" targetRef="process_order" />
    <bpmn:sequenceFlow id="f-process_order-send_invoice" sourceRef="process_order" targetRef="send_invoice" />
    <bpmn:sequenceFlow id="f-send_invoice-receive_invoice" sourceRef="send_invoice" targetRef="receive_invoice" />
    <bpmn:sequenceFlow id="f-receive_invoice-end_process" sourceRef="receive_invoice" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
