tok 1.0 "Monthly parts ordering"

pool company "Company"
  lane assembler "Assembler AG"
    start start "Monthly order start" timer="R/P1M"
    task send_order "Send order to supplier"
    task receive_invoice "Receive invoice"
    end end_process "Process completed"
  lane supplier "Supplier"
    task process_order "Process order"
    task send_invoice "Send invoice to Assembler AG"

flow start -> send_order -> process_order -> send_invoice -> receive_invoice -> end_process
