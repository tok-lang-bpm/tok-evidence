<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Customer acquisition process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="research" name="Research">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_details</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="call_center" name="Call Center">
        <bpmn:flowNodeRef>call_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budget_huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave_alone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head_dev" name="Head of Development">
        <bpmn:flowNodeRef>head_acquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales">
        <bpmn:flowNodeRef>presenter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sales_presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>responded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sales_call_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_quotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join_presentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pre_sales" name="Pre-sales">
        <bpmn:flowNodeRef>presales_presentation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="decide_method" name="Determine method?" />
    <bpmn:task id="buy_details" name="Buy details for cold calls" />
    <bpmn:task id="exhibition" name="Participate in exhibitions" />
    <bpmn:task id="referral" name="Know somebody interested" />
    <bpmn:task id="determine_details" name="Determine contact details" />
    <bpmn:task id="call_customer" name="Start calling the customer" />
    <bpmn:task id="determine_contact" name="Determine contact person, budget and ask interest" />
    <bpmn:exclusiveGateway id="interested" name="Customer interested?" />
    <bpmn:exclusiveGateway id="budget_huge" name="Budget huge?" />
    <bpmn:endEvent id="leave_alone" name="Leave alone" />
    <bpmn:task id="head_acquire" name="Head of development tries to acquire the customer" />
    <bpmn:exclusiveGateway id="presenter" name="Presenter?" />
    <bpmn:task id="sales_presentation" name="Give detailed online presentation (sales)" />
    <bpmn:task id="wait_response" name="Wait for customer response" />
    <bpmn:exclusiveGateway id="responded" name="Customer responded?" />
    <bpmn:task id="sales_call_back" name="Sales representative calls the customer" />
    <bpmn:task id="create_quotation" name="Create quotation" />
    <bpmn:endEvent id="end_process" name="Process completed" />
    <bpmn:exclusiveGateway id="join_presentation" name="Presentation done?" />
    <bpmn:task id="presales_presentation" name="Give detailed online presentation (pre-sales)" />
    <bpmn:sequenceFlow id="f-start-decide_method" sourceRef="start" targetRef="decide_method" />
    <bpmn:sequenceFlow id="f-decide_method-buy_details" name="buy" sourceRef="decide_method" targetRef="buy_details" />
    <bpmn:sequenceFlow id="f-decide_method-exhibition" name="exhibit" sourceRef="decide_method" targetRef="exhibition" />
    <bpmn:sequenceFlow id="f-decide_method-referral" name="referral" sourceRef="decide_method" targetRef="referral" />
    <bpmn:sequenceFlow id="f-buy_details-determine_details" sourceRef="buy_details" targetRef="determine_details" />
    <bpmn:sequenceFlow id="f-exhibition-determine_details" sourceRef="exhibition" targetRef="determine_details" />
    <bpmn:sequenceFlow id="f-referral-determine_details" sourceRef="referral" targetRef="determine_details" />
    <bpmn:sequenceFlow id="f-determine_details-call_customer" sourceRef="determine_details" targetRef="call_customer" />
    <bpmn:sequenceFlow id="f-call_customer-determine_contact" sourceRef="call_customer" targetRef="determine_contact" />
    <bpmn:sequenceFlow id="f-determine_contact-interested" sourceRef="determine_contact" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-presenter" name="yes" sourceRef="interested" targetRef="presenter" />
    <bpmn:sequenceFlow id="f-interested-budget_huge" name="no" sourceRef="interested" targetRef="budget_huge" />
    <bpmn:sequenceFlow id="f-budget_huge-head_acquire" name="yes" sourceRef="budget_huge" targetRef="head_acquire" />
    <bpmn:sequenceFlow id="f-budget_huge-leave_alone" name="no" sourceRef="budget_huge" targetRef="leave_alone" />
    <bpmn:sequenceFlow id="f-head_acquire-end_process" sourceRef="head_acquire" targetRef="end_process" />
    <bpmn:sequenceFlow id="f-presenter-sales_presentation" name="sales" sourceRef="presenter" targetRef="sales_presentation" />
    <bpmn:sequenceFlow id="f-presenter-presales_presentation" name="pre-sales" sourceRef="presenter" targetRef="presales_presentation" />
    <bpmn:sequenceFlow id="f-sales_presentation-join_presentation" sourceRef="sales_presentation" targetRef="join_presentation" />
    <bpmn:sequenceFlow id="f-presales_presentation-join_presentation" sourceRef="presales_presentation" targetRef="join_presentation" />
    <bpmn:sequenceFlow id="f-join_presentation-wait_response" sourceRef="join_presentation" targetRef="wait_response" />
    <bpmn:sequenceFlow id="f-wait_response-responded" sourceRef="wait_response" targetRef="responded" />
    <bpmn:sequenceFlow id="f-responded-create_quotation" name="yes" sourceRef="responded" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-responded-sales_call_back" name="no" sourceRef="responded" targetRef="sales_call_back" />
    <bpmn:sequenceFlow id="f-sales_call_back-create_quotation" sourceRef="sales_call_back" targetRef="create_quotation" />
    <bpmn:sequenceFlow id="f-create_quotation-end_process" sourceRef="create_quotation" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>
