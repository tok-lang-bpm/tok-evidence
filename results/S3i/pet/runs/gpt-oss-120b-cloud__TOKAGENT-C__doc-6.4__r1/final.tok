tok 1.0 "Customer acquisition process"

pool org "Organization"
  lane research "Research"
    start start "Start"
    xor decide_method "Determine method?"
    task buy_details "Buy details for cold calls"
    task exhibition "Participate in exhibitions"
    task referral "Know somebody interested"
    task determine_details "Determine contact details"

  lane call_center "Call Center"
    task call_customer "Start calling the customer"
    task determine_contact "Determine contact person, budget and ask interest"
    xor interested "Customer interested?"
    xor budget_huge "Budget huge?"
    end leave_alone "Leave alone"

  lane head_dev "Head of Development"
    task head_acquire "Head of development tries to acquire the customer"

  lane sales "Sales"
    xor presenter "Presenter?"
    task sales_presentation "Give detailed online presentation (sales)"
    task wait_response "Wait for customer response"
    xor responded "Customer responded?"
    task sales_call_back "Sales representative calls the customer"
    task create_quotation "Create quotation"
    end end_process "Process completed"
    xor join_presentation "Presentation done?"

  lane pre_sales "Pre-sales"
    task presales_presentation "Give detailed online presentation (pre-sales)"

  flow start -> decide_method
  flow decide_method -> buy_details "buy"
  flow decide_method -> exhibition "exhibit"
  flow decide_method -> referral "referral"
  flow buy_details -> determine_details
  flow exhibition -> determine_details
  flow referral -> determine_details
  flow determine_details -> call_customer
  flow call_customer -> determine_contact
  flow determine_contact -> interested
  flow interested -> presenter "yes"
  flow interested -> budget_huge "no"
  flow budget_huge -> head_acquire "yes"
  flow budget_huge -> leave_alone "no"
  flow head_acquire -> end_process
  flow presenter -> sales_presentation "sales"
  flow presenter -> presales_presentation "pre-sales"
  flow sales_presentation -> join_presentation
  flow presales_presentation -> join_presentation
  flow join_presentation -> wait_response
  flow wait_response -> responded
  flow responded -> create_quotation "yes"
  flow responded -> sales_call_back "no"
  flow sales_call_back -> create_quotation
  flow create_quotation -> end_process
