tok 1.0 "Lead processing"

pool org "Organization"
  lane manager "Manager"
    start s "Start"
    task check "Check open leads"
    task select "Select top five leads"
    task tell "Tell Sales Assistant to call contacts"
    task process "Process lead"
    end e "Lead processed"
  lane assistant "Sales Assistant"
    task call "Call each customer"
    task note "Send note to Manager"

xor decision "Is the customer interested?" 

flow s -> check -> select -> tell -> call
flow call -> decision
flow decision -> note "yes"
flow decision -> call "no"
flow note -> process -> e