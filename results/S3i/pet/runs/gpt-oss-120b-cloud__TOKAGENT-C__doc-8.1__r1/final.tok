tok 1.0 "Post filling process"

pool org "Organisation"
  lane functional "Functional Department"
    start demand "Demand for post"

  lane hr "HR"
    task advertise "Advertise the post"
    task check "Check the applications"
    task conclude "Conclude employment contract"
    end filled "Post filled"

  lane applicant "Applicant"
    task apply "Apply for the post"

flow demand -> advertise -> apply -> check -> conclude -> filled
