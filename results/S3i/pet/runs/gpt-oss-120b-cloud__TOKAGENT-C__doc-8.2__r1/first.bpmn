<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job posting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job posting process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="hr" name="HR Clerk">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ASK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONF_JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUBMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CORR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>APPROV</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Vacancy reported" />
    <bpmn:task id="CJD" name="Create job description from the information" />
    <bpmn:exclusiveGateway id="CONF" name="Confusion in the message?" />
    <bpmn:task id="ASK" name="Ask the Department again" />
    <bpmn:exclusiveGateway id="CONF_JOIN" name="Confusion join" />
    <bpmn:task id="SUBMIT" name="Submit the job description for consideration" />
    <bpmn:task id="CORR" name="Correct the description" />
    <bpmn:task id="POST" name="Post the job" />
    <bpmn:endEvent id="END" name="Job posted" />
    <bpmn:exclusiveGateway id="APPROV" name="Department approves?" />
    <bpmn:sequenceFlow id="f-S-CJD" sourceRef="S" targetRef="CJD" />
    <bpmn:sequenceFlow id="f-CJD-CONF" sourceRef="CJD" targetRef="CONF" />
    <bpmn:sequenceFlow id="f-CONF-ASK" name="yes" sourceRef="CONF" targetRef="ASK" />
    <bpmn:sequenceFlow id="f-CONF-CONF_JOIN" name="no" sourceRef="CONF" targetRef="CONF_JOIN" />
    <bpmn:sequenceFlow id="f-ASK-CONF_JOIN" sourceRef="ASK" targetRef="CONF_JOIN" />
    <bpmn:sequenceFlow id="f-CONF_JOIN-SUBMIT" sourceRef="CONF_JOIN" targetRef="SUBMIT" />
    <bpmn:sequenceFlow id="f-SUBMIT-APPROV" sourceRef="SUBMIT" targetRef="APPROV" />
    <bpmn:sequenceFlow id="f-APPROV-POST" name="yes" sourceRef="APPROV" targetRef="POST" />
    <bpmn:sequenceFlow id="f-APPROV-CORR" name="no" sourceRef="APPROV" targetRef="CORR" />
    <bpmn:sequenceFlow id="f-CORR-SUBMIT" sourceRef="CORR" targetRef="SUBMIT" />
    <bpmn:sequenceFlow id="f-POST-END" sourceRef="POST" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
