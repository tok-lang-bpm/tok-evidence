tok 1.0 "Job posting process"

pool org "Organisation"
  lane hr "HR Clerk"
    start S "Vacancy reported"
    task CJD "Create job description from the information"
    xor CONF "Confusion in the message?"
    task ASK "Ask the Department again"
    xor CONF_JOIN "Confusion join"
    task SUBMIT "Submit the job description for consideration"
    task CORR "Correct the description"
    task POST "Post the job"
    end END "Job posted"
  lane dept "Department"
    xor APPROV "Department approves?"

flow S -> CJD -> CONF
flow CONF -> ASK "yes"
flow CONF -> CONF_JOIN "no"
flow ASK -> CONF_JOIN
flow CONF_JOIN -> SUBMIT
flow SUBMIT -> APPROV
flow APPROV -> POST "yes"
flow APPROV -> CORR "no"
flow CORR -> SUBMIT
flow POST -> END