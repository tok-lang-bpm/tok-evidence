<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Vacancy handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Vacancy handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of functional department">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec_corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ask_corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="personnel" name="Personnel Department">
        <bpmn:flowNodeRef>t_prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR Department">
        <bpmn:flowNodeRef>dec_hr_questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ask_questions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Need detected" />
    <bpmn:task id="t_detect" name="detect personnel requirements" />
    <bpmn:task id="t_report" name="report vacancy to Personnel Department" />
    <bpmn:task id="t_review" name="review job description" />
    <bpmn:exclusiveGateway id="dec_corrections" name="Job description needs corrections?" />
    <bpmn:task id="t_ask_corrections" name="ask for corrections" />
    <bpmn:task id="t_approve" name="approve job description" />
    <bpmn:task id="t_clarify" name="provide clarifications" />
    <bpmn:endEvent id="e_end" name="Process completed" />
    <bpmn:task id="t_prepare" name="prepare job description" />
    <bpmn:task id="t_revise" name="revise job description" />
    <bpmn:exclusiveGateway id="dec_hr_questions" name="HR has questions?" />
    <bpmn:task id="t_ask_questions" name="ask questions" />
    <bpmn:sequenceFlow id="f-s_start-t_detect" sourceRef="s_start" targetRef="t_detect" />
    <bpmn:sequenceFlow id="f-t_detect-t_report" sourceRef="t_detect" targetRef="t_report" />
    <bpmn:sequenceFlow id="f-t_report-t_prepare" sourceRef="t_report" targetRef="t_prepare" />
    <bpmn:sequenceFlow id="f-t_prepare-dec_hr_questions" sourceRef="t_prepare" targetRef="dec_hr_questions" />
    <bpmn:sequenceFlow id="f-dec_hr_questions-t_review" name="no" sourceRef="dec_hr_questions" targetRef="t_review" />
    <bpmn:sequenceFlow id="f-dec_hr_questions-t_ask_questions" name="yes" sourceRef="dec_hr_questions" targetRef="t_ask_questions" />
    <bpmn:sequenceFlow id="f-t_ask_questions-t_clarify" sourceRef="t_ask_questions" targetRef="t_clarify" />
    <bpmn:sequenceFlow id="f-t_clarify-t_revise" sourceRef="t_clarify" targetRef="t_revise" />
    <bpmn:sequenceFlow id="f-t_revise-t_review" sourceRef="t_revise" targetRef="t_review" />
    <bpmn:sequenceFlow id="f-t_review-dec_corrections" sourceRef="t_review" targetRef="dec_corrections" />
    <bpmn:sequenceFlow id="f-dec_corrections-t_ask_corrections" name="yes" sourceRef="dec_corrections" targetRef="t_ask_corrections" />
    <bpmn:sequenceFlow id="f-dec_corrections-t_approve" name="no" sourceRef="dec_corrections" targetRef="t_approve" />
    <bpmn:sequenceFlow id="f-t_ask_corrections-t_revise" sourceRef="t_ask_corrections" targetRef="t_revise" />
    <bpmn:sequenceFlow id="f-t_approve-e_end" sourceRef="t_approve" targetRef="e_end" />
  </bpmn:process>
</bpmn:definitions>
