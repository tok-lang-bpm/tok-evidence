tok 1.0 "Vacancy handling"

pool org "Organization"
  lane head "Head of functional department"
    start s_start "Need detected"
    task t_detect "detect personnel requirements"
    task t_report "report vacancy to Personnel Department"
    # after report, flow to personnel
    # will be connected via flows later
    task t_review "review job description"
    xor dec_corrections "Job description needs corrections?"
    task t_ask_corrections "ask for corrections"
    task t_approve "approve job description"
    task t_clarify "provide clarifications"
    end e_end "Process completed"
  lane personnel "Personnel Department"
    task t_prepare "prepare job description"
    task t_revise "revise job description"
  lane hr "HR Department"
    xor dec_hr_questions "HR has questions?"
    task t_ask_questions "ask questions"

flow s_start -> t_detect -> t_report -> t_prepare
flow t_prepare -> dec_hr_questions
flow dec_hr_questions -> t_review "no"
flow dec_hr_questions -> t_ask_questions "yes"
flow t_ask_questions -> t_clarify
flow t_clarify -> t_revise
flow t_revise -> t_review
flow t_review -> dec_corrections
flow dec_corrections -> t_ask_corrections "yes"
flow dec_corrections -> t_approve "no"
flow t_ask_corrections -> t_revise
flow t_approve -> e_end