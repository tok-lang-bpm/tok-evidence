<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Daily Defaulting Account Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Daily Defaulting Account Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="process" name="Process">
        <bpmn:flowNodeRef>s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s0" name="Weekday morning start" />
    <bpmn:task id="t1" name="Back up the database" />
    <bpmn:task id="t2" name="Check Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="g1" name="New records found?" />
    <bpmn:task id="t3" name="Check CRM system for new returns" />
    <bpmn:exclusiveGateway id="g2" name="New returns exist?" />
    <bpmn:task id="t4" name="Register defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="g3" name="Defaulting client codes previously advised?" />
    <bpmn:task id="t5" name="Produce another table of defaulting accounts" />
    <bpmn:task id="t6" name="Send table to account management" />
    <bpmn:exclusiveGateway id="j4" name="Join for deadline check" />
    <bpmn:exclusiveGateway id="d4" name="Completed by 2:30 pm?" />
    <bpmn:task id="t7" name="Send alert to supervisor" />
    <bpmn:task id="t8" name="Check CRM system for new returns" />
    <bpmn:exclusiveGateway id="g5" name="New returns filed?" />
    <bpmn:task id="t9" name="Reconcile with existing account defaulters table" />
    <bpmn:exclusiveGateway id="g6" name="Completed by 4:00 pm?" />
    <bpmn:task id="t10" name="Send alert to supervisor" />
    <bpmn:endEvent id="e2" name="Process ended early" />
    <bpmn:endEvent id="e3" name="Process completed after reconciliation" />
    <bpmn:endEvent id="e4" name="Process ended after deadline alert" />
    <bpmn:sequenceFlow id="f-s0-t1" sourceRef="s0" targetRef="t1" />
    <bpmn:sequenceFlow id="f-t1-t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f-t2-g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f-g1-t4" name="yes" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f-g1-t3" name="no" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f-t3-g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f-g2-t4" name="yes" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="f-g2-e2" name="no" sourceRef="g2" targetRef="e2" />
    <bpmn:sequenceFlow id="f-t4-g3" sourceRef="t4" targetRef="g3" />
    <bpmn:sequenceFlow id="f-g3-t5" name="no" sourceRef="g3" targetRef="t5" />
    <bpmn:sequenceFlow id="f-g3-j4" name="yes" sourceRef="g3" targetRef="j4" />
    <bpmn:sequenceFlow id="f-t5-t6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f-t6-j4" sourceRef="t6" targetRef="j4" />
    <bpmn:sequenceFlow id="f-j4-d4" sourceRef="j4" targetRef="d4" />
    <bpmn:sequenceFlow id="f-d4-t7" name="no" sourceRef="d4" targetRef="t7" />
    <bpmn:sequenceFlow id="f-d4-t8" name="yes" sourceRef="d4" targetRef="t8" />
    <bpmn:sequenceFlow id="f-t7-e4" sourceRef="t7" targetRef="e4" />
    <bpmn:sequenceFlow id="f-t8-g5" sourceRef="t8" targetRef="g5" />
    <bpmn:sequenceFlow id="f-g5-t9" name="yes" sourceRef="g5" targetRef="t9" />
    <bpmn:sequenceFlow id="f-g5-e3" name="no" sourceRef="g5" targetRef="e3" />
    <bpmn:sequenceFlow id="f-t9-g6" sourceRef="t9" targetRef="g6" />
    <bpmn:sequenceFlow id="f-g6-t10" name="no" sourceRef="g6" targetRef="t10" />
    <bpmn:sequenceFlow id="f-g6-e3" name="yes" sourceRef="g6" targetRef="e3" />
    <bpmn:sequenceFlow id="f-t10-e4" sourceRef="t10" targetRef="e4" />
  </bpmn:process>
</bpmn:definitions>
