tok 1.0 "Daily Defaulting Account Process"

pool org "Organisation"
  lane process "Process"
    start s0 "Weekday morning start"
    task t1 "Back up the database"
    task t2 "Check Account Defaulter table for new records"
    xor g1 "New records found?"
    task t3 "Check CRM system for new returns"
    xor g2 "New returns exist?"
    task t4 "Register defaulting accounts and customers"
    xor g3 "Defaulting client codes previously advised?"
    task t5 "Produce another table of defaulting accounts"
    task t6 "Send table to account management"
    xor j4 "Join for deadline check"
    xor d4 "Completed by 2:30 pm?"
    task t7 "Send alert to supervisor"
    task t8 "Check CRM system for new returns"
    xor g5 "New returns filed?"
    task t9 "Reconcile with existing account defaulters table"
    xor g6 "Completed by 4:00 pm?"
    task t10 "Send alert to supervisor"
    end e2 "Process ended early"
    end e3 "Process completed after reconciliation"
    end e4 "Process ended after deadline alert"

    flow s0 -> t1 -> t2 -> g1
    flow g1 -> t4 "yes"
    flow g1 -> t3 "no"
    flow t3 -> g2
    flow g2 -> t4 "yes"
    flow g2 -> e2 "no"
    flow t4 -> g3
    flow g3 -> t5 "no"
    flow g3 -> j4 "yes"
    flow t5 -> t6 -> j4
    flow j4 -> d4
    flow d4 -> t7 "no"
    flow d4 -> t8 "yes"
    flow t7 -> e4
    flow t8 -> g5
    flow g5 -> t9 "yes"
    flow g5 -> e3 "no"
    flow t9 -> g6
    flow g6 -> t10 "no"
    flow g6 -> e3 "yes"
    flow t10 -> e4
