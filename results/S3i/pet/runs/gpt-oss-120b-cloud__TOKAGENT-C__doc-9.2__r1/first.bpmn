<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mortgage Offer Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Mortgage Offer Process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reply_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move_to_admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>generate_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_message</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Start" />
    <bpmn:task id="send_offer" name="Send Mortgage offer" />
    <bpmn:receiveTask id="receive_reply" name="Receive customer reply" />
    <bpmn:boundaryEvent id="timeout" name="No reply timeout" attachedToRef="receive_reply">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2W</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="reply_decision" name="Customer reply?" />
    <bpmn:task id="update_details" name="Update case details" />
    <bpmn:task id="archive_work" name="Archive work" />
    <bpmn:task id="cancel_case" name="Cancel case" />
    <bpmn:task id="move_to_admin" name="Move case to administration" />
    <bpmn:task id="generate_message" name="Generate message requesting outstanding documents" />
    <bpmn:endEvent id="end_completed" name="Case completed" />
    <bpmn:endEvent id="end_cancelled" name="Case cancelled" />
    <bpmn:endEvent id="end_message" name="Message sent" />
    <bpmn:sequenceFlow id="f-start1-send_offer" sourceRef="start1" targetRef="send_offer" />
    <bpmn:sequenceFlow id="f-send_offer-receive_reply" sourceRef="send_offer" targetRef="receive_reply" />
    <bpmn:sequenceFlow id="f-receive_reply-reply_decision" sourceRef="receive_reply" targetRef="reply_decision" />
    <bpmn:sequenceFlow id="f-reply_decision-update_details" name="decline" sourceRef="reply_decision" targetRef="update_details" />
    <bpmn:sequenceFlow id="f-reply_decision-move_to_admin" name="complete all" sourceRef="reply_decision" targetRef="move_to_admin" />
    <bpmn:sequenceFlow id="f-reply_decision-generate_message" name="missing docs" sourceRef="reply_decision" targetRef="generate_message" />
    <bpmn:sequenceFlow id="f-update_details-archive_work" sourceRef="update_details" targetRef="archive_work" />
    <bpmn:sequenceFlow id="f-archive_work-cancel_case" sourceRef="archive_work" targetRef="cancel_case" />
    <bpmn:sequenceFlow id="f-cancel_case-end_cancelled" sourceRef="cancel_case" targetRef="end_cancelled" />
    <bpmn:sequenceFlow id="f-move_to_admin-end_completed" sourceRef="move_to_admin" targetRef="end_completed" />
    <bpmn:sequenceFlow id="f-generate_message-end_message" sourceRef="generate_message" targetRef="end_message" />
    <bpmn:sequenceFlow id="f-timeout-update_details" name="timeout" sourceRef="timeout" targetRef="update_details" />
  </bpmn:process>
</bpmn:definitions>
