<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Annual Meeting Schedule Drafting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="tpa" name="Town Planning Authority" processRef="tpa-process" />
  </bpmn:collaboration>
  <bpmn:process id="tpa-process" name="Annual Meeting Schedule Drafting" isExecutable="false">
    <bpmn:laneSet id="tpa-lanes">
      <bpmn:lane id="coordination" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start November scheduling" />
    <bpmn:task id="draft" name="Draft schedule of meetings and add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck dates and look for potential conflicts" />
    <bpmn:task id="send" name="Send final schedule of meeting dates to Committee Members" />
    <bpmn:task id="check" name="Check dates and suggest modifications" />
    <bpmn:task id="advise" name="Check diaries and advise Coordination Unit of conflicts" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f-start-draft" sourceRef="start" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-check" sourceRef="draft" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-recheck" sourceRef="check" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-send" sourceRef="recheck" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-advise" sourceRef="send" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-end" sourceRef="advise" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
