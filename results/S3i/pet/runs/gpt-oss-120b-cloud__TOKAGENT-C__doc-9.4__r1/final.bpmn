<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Committee meeting process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Committee meeting process" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Dates finalized" />
    <bpmn:task id="qa" name="QA check minutes" />
    <bpmn:task id="update" name="Update calendars, create meeting folders and upload documents" />
    <bpmn:task id="advise" name="Advise Committee Members" />
    <bpmn:task id="produce" name="Produce minutes with action points" />
    <bpmn:task id="send" name="Send minutes to Committee Members" />
    <bpmn:task id="record" name="Update departmental records" />
    <bpmn:endEvent id="end1" name="Process completed" />
    <bpmn:task id="hold" name="Hold meeting" />
    <bpmn:sequenceFlow id="f-s1-update" sourceRef="s1" targetRef="update" />
    <bpmn:sequenceFlow id="f-update-advise" sourceRef="update" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-hold" sourceRef="advise" targetRef="hold" />
    <bpmn:sequenceFlow id="f-hold-produce" sourceRef="hold" targetRef="produce" />
    <bpmn:sequenceFlow id="f-produce-qa" sourceRef="produce" targetRef="qa" />
    <bpmn:sequenceFlow id="f-qa-send" sourceRef="qa" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-record" sourceRef="send" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-end1" sourceRef="record" targetRef="end1" />
  </bpmn:process>
</bpmn:definitions>
