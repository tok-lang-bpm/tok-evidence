<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="The Evanstonian" processRef="process" />
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_manager" name="Room‑service manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeDownOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitOrderTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveOrderToSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignOrderToWaiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lane_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lane_sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="lane_waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_ReadyCartAndDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="StartEvent_1" name="Guest calls room service" />

    <bpmn:task id="Task_TakeDownOrder" name="Take down order" />
    <bpmn:task id="Task_SubmitOrderTicket" name="Submit order ticket to kitchen" />
    <bpmn:task id="Task_GiveOrderToSommelier" name="Give order to sommelier" />
    <bpmn:task id="Task_AssignOrderToWaiter" name="Assign order to waiter" />

    <bpmn:parallelGateway id="Gateway_Split" name="Parallel split" />

    <bpmn:task id="Task_PrepareFood" name="Prepare food" />
    <bpmn:task id="Task_FetchWine" name="Fetch wine and prepare alcoholic beverages" />
    <bpmn:task id="Task_ReadyCartAndDrinks" name="Ready cart and prepare non‑alcoholic drinks" />

    <bpmn:parallelGateway id="Gateway_Join" name="Parallel join" />

    <bpmn:task id="Task_DeliverOrder" name="Deliver order to guest's room" />
    <bpmn:task id="Task_DebitAccount" name="Debit guest's account" />

    <bpmn:endEvent id="EndEvent_1" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_TakeDownOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TakeDownOrder" targetRef="Task_SubmitOrderTicket" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SubmitOrderTicket" targetRef="Task_GiveOrderToSommelier" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GiveOrderToSommelier" targetRef="Task_AssignOrderToWaiter" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AssignOrderToWaiter" targetRef="Gateway_Split" />

    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Split" targetRef="Task_PrepareFood" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Split" targetRef="Task_FetchWine" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Split" targetRef="Task_ReadyCartAndDrinks" />

    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_PrepareFood" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_FetchWine" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReadyCartAndDrinks" targetRef="Gateway_Join" />

    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Join" targetRef="Task_DeliverOrder" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DeliverOrder" targetRef="Task_DebitAccount" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_DebitAccount" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
