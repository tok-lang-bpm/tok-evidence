<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="companyPool" name="Company" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_company" name="Company Management">
        <bpmn:flowNodeRef>StartDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SECReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_underwriters" name="Underwriters">
        <bpmn:flowNodeRef>Gateway_FactsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideAdvice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResellIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SealApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckBlueSky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel_FirmRoad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FirmPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeRoadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveSEC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SECCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCommitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferPublic</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartDecision" name="Decision to go public" />
    <bpmn:task id="Task_MakeDecision" name="Make decision to go public" />
    <bpmn:task id="Task_SelectUnderwriters" name="Select the underwriters" />
    <bpmn:exclusiveGateway id="Gateway_FactsCheck" name="Facts presented fairly?" />
    <bpmn:task id="Task_ProvideAdvice" name="Provide procedural and financial advice" />
    <bpmn:task id="Task_BuyIssue" name="Buy the issue" />
    <bpmn:task id="Task_ResellIssue" name="Resell the issue to the public" />
    <bpmn:task id="Task_SealApproval" name="Give seal of approval" />
    <bpmn:task id="Task_PrepareReg" name="Prepare registration statement" />
    <bpmn:task id="Task_CheckBlueSky" name="Check compliance with blue-sky laws" />
    <bpmn:parallelGateway id="Parallel_FirmRoad" />
    <bpmn:task id="Task_FirmPrice" name="Firm up issue price" />
    <bpmn:task id="Task_ArrangeRoadShow" name="Arrange road show" />
    <bpmn:parallelGateway id="Parallel_Join" />
    <bpmn:task id="Task_ReceiveSEC" name="Receive SEC clearance" />
    <bpmn:exclusiveGateway id="Gateway_SECCheck" name="SEC clearance?" />
    <bpmn:task id="Task_FixIssuePrice" name="Fix issue price" />
    <bpmn:task id="Task_EnterCommitment" name="Enter firm commitment to buy stock" />
    <bpmn:task id="Task_OfferPublic" name="Offer the issue to the public" />
    <bpmn:endEvent id="End_Decline" name="Underwriters decline" />
    <bpmn:endEvent id="End_SECReject" name="SEC not approved" />
    <bpmn:endEvent id="End_Process" name="Process completed" />

    <bpmn:sequenceFlow id="flow1" sourceRef="StartDecision" targetRef="Task_MakeDecision" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_MakeDecision" targetRef="Task_SelectUnderwriters" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_SelectUnderwriters" targetRef="Gateway_FactsCheck" />
    <bpmn:sequenceFlow id="flow4_yes" name="yes" sourceRef="Gateway_FactsCheck" targetRef="Task_ProvideAdvice" />
    <bpmn:sequenceFlow id="flow4_no" name="no" sourceRef="Gateway_FactsCheck" targetRef="End_Decline" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Task_ProvideAdvice" targetRef="Task_BuyIssue" />
    <bpmn:sequenceFlow id="flow6" sourceRef="Task_BuyIssue" targetRef="Task_ResellIssue" />
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_ResellIssue" targetRef="Task_SealApproval" />
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_SealApproval" targetRef="Task_PrepareReg" />
    <bpmn:sequenceFlow id="flow9" sourceRef="Task_PrepareReg" targetRef="Task_CheckBlueSky" />
    <bpmn:sequenceFlow id="flow10" sourceRef="Task_CheckBlueSky" targetRef="Parallel_FirmRoad" />
    <bpmn:sequenceFlow id="flow11a" sourceRef="Parallel_FirmRoad" targetRef="Task_FirmPrice" />
    <bpmn:sequenceFlow id="flow11b" sourceRef="Parallel_FirmRoad" targetRef="Task_ArrangeRoadShow" />
    <bpmn:sequenceFlow id="flow12a" sourceRef="Task_FirmPrice" targetRef="Parallel_Join" />
    <bpmn:sequenceFlow id="flow12b" sourceRef="Task_ArrangeRoadShow" targetRef="Parallel_Join" />
    <bpmn:sequenceFlow id="flow13" sourceRef="Parallel_Join" targetRef="Task_ReceiveSEC" />
    <bpmn:sequenceFlow id="flow14" sourceRef="Task_ReceiveSEC" targetRef="Gateway_SECCheck" />
    <bpmn:sequenceFlow id="flow15_yes" name="yes" sourceRef="Gateway_SECCheck" targetRef="Task_FixIssuePrice" />
    <bpmn:sequenceFlow id="flow15_no" name="no" sourceRef="Gateway_SECCheck" targetRef="End_SECReject" />
    <bpmn:sequenceFlow id="flow16" sourceRef="Task_FixIssuePrice" targetRef="Task_EnterCommitment" />
    <bpmn:sequenceFlow id="flow17" sourceRef="Task_EnterCommitment" targetRef="Task_OfferPublic" />
    <bpmn:sequenceFlow id="flow18" sourceRef="Task_OfferPublic" targetRef="End_Process" />
  </bpmn:process>
</bpmn:definitions>
