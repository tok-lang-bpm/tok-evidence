<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneSet_1">
      <bpmn:lane id="lane_FAULT_DETECTOR" name="Fault Detector"/>
      <bpmn:lane id="lane_MPO" name="MPO">
        <bpmn:flowNodeRef>start_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_inform_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_inform_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_fix_fault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_share_results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_resolve_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_resolve_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_GO" name="GO">
        <bpmn:flowNodeRef>task_inform_go_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_go_resolution</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_MSP" name="MSP">
        <bpmn:flowNodeRef>task_inform_msp_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_msp_resolution</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_event" name="Failure reported or suspicion" />
    <bpmn:task id="task_examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="gateway_decision" name="Failure confirmed?" />
    <bpmn:task id="task_reject" name="Reject the failure of the fault detector" />
    <bpmn:task id="task_confirm" name="Confirm the failure of the fault detector" />
    <bpmn:parallelGateway id="gateway_inform_split" />
    <bpmn:task id="task_inform_go_failure" name="Inform GO about the failure" />
    <bpmn:task id="task_inform_msp_failure" name="Inform MSP about the failure" />
    <bpmn:parallelGateway id="gateway_inform_join" />
    <bpmn:task id="task_fix_fault" name="Fix the fault at the measuring device" />
    <bpmn:task id="task_share_results" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="gateway_resolve_split" />
    <bpmn:task id="task_inform_go_resolution" name="Inform GO about the resolution" />
    <bpmn:task id="task_inform_msp_resolution" name="Inform MSP about the resolution" />
    <bpmn:parallelGateway id="gateway_resolve_join" />
    <bpmn:endEvent id="end_final" name="Process completed" />
    <bpmn:endEvent id="end_reject" name="Process rejected" />

    <bpmn:sequenceFlow id="flow_start_examine" sourceRef="start_event" targetRef="task_examine" />
    <bpmn:sequenceFlow id="flow_examine_decision" sourceRef="task_examine" targetRef="gateway_decision" />
    <bpmn:sequenceFlow id="flow_decision_reject" name="reject" sourceRef="gateway_decision" targetRef="task_reject" />
    <bpmn:sequenceFlow id="flow_decision_confirm" name="confirm" sourceRef="gateway_decision" targetRef="task_confirm" />
    <bpmn:sequenceFlow id="flow_reject_end" sourceRef="task_reject" targetRef="end_reject" />
    <bpmn:sequenceFlow id="flow_confirm_inform_split" sourceRef="task_confirm" targetRef="gateway_inform_split" />
    <bpmn:sequenceFlow id="flow_inform_split_go" sourceRef="gateway_inform_split" targetRef="task_inform_go_failure" />
    <bpmn:sequenceFlow id="flow_inform_split_msp" sourceRef="gateway_inform_split" targetRef="task_inform_msp_failure" />
    <bpmn:sequenceFlow id="flow_inform_go_join" sourceRef="task_inform_go_failure" targetRef="gateway_inform_join" />
    <bpmn:sequenceFlow id="flow_inform_msp_join" sourceRef="task_inform_msp_failure" targetRef="gateway_inform_join" />
    <bpmn:sequenceFlow id="flow_inform_join_fix" sourceRef="gateway_inform_join" targetRef="task_fix_fault" />
    <bpmn:sequenceFlow id="flow_fix_share" sourceRef="task_fix_fault" targetRef="task_share_results" />
    <bpmn:sequenceFlow id="flow_share_resolve_split" sourceRef="task_share_results" targetRef="gateway_resolve_split" />
    <bpmn:sequenceFlow id="flow_resolve_split_go" sourceRef="gateway_resolve_split" targetRef="task_inform_go_resolution" />
    <bpmn:sequenceFlow id="flow_resolve_split_msp" sourceRef="gateway_resolve_split" targetRef="task_inform_msp_resolution" />
    <bpmn:sequenceFlow id="flow_resolve_go_join" sourceRef="task_inform_go_resolution" targetRef="gateway_resolve_join" />
    <bpmn:sequenceFlow id="flow_resolve_msp_join" sourceRef="task_inform_msp_resolution" targetRef="gateway_resolve_join" />
    <bpmn:sequenceFlow id="flow_resolve_join_end" sourceRef="gateway_resolve_join" targetRef="end_final" />
  </bpmn:process>
</bpmn:definitions>
