<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Org" name="Organisation"
                      processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_RequestMeasurements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessMeasuredValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendChangedValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitReadings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Event</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSP" name="MSP">
        <bpmn:flowNodeRef>Task_CheckRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP" name="SP">
        <bpmn:flowNodeRef>Task_TransmitReadings</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="Start_Event" name="Start"/>

    <bpmn:task id="Task_RequestMeasurements"
               name="GO requests the measurements to the MSP"/>

    <bpmn:task id="Task_CheckRequest"
               name="MSP checks the received request"/>

    <bpmn:exclusiveGateway id="Gateway_Decision"
                           name="Request denied?"/>

    <bpmn:task id="Task_InformFailure"
               name="MSP informs the GO about the failure of the reading"/>

    <bpmn:task id="Task_TransmitValues"
               name="MSP transmits the measured values to the GO"/>

    <bpmn:exclusiveGateway id="Gateway_Merge"
                           name="Merge paths"/>

    <bpmn:task id="Task_ProcessMeasuredValues"
               name="GO processes the measured values"/>

    <bpmn:task id="Task_SendChangedValues"
               name="GO sends the changed values to the MSP"/>

    <bpmn:task id="Task_TransmitReadings"
               name="GO transmits the readings to the SP"/>

    <bpmn:endEvent id="End_Event" name="End"/>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1"
                       sourceRef="Start_Event"
                       targetRef="Task_RequestMeasurements"/>

    <bpmn:sequenceFlow id="Flow_2"
                       sourceRef="Task_RequestMeasurements"
                       targetRef="Task_CheckRequest"/>

    <bpmn:sequenceFlow id="Flow_3"
                       sourceRef="Task_CheckRequest"
                       targetRef="Gateway_Decision"/>

    <bpmn:sequenceFlow id="Flow_4"
                       sourceRef="Gateway_Decision"
                       targetRef="Task_InformFailure"
                       name="yes"/>

    <bpmn:sequenceFlow id="Flow_5"
                       sourceRef="Gateway_Decision"
                       targetRef="Task_TransmitValues"
                       name="no"/>

    <bpmn:sequenceFlow id="Flow_6"
                       sourceRef="Task_InformFailure"
                       targetRef="Gateway_Merge"/>

    <bpmn:sequenceFlow id="Flow_7"
                       sourceRef="Task_TransmitValues"
                       targetRef="Gateway_Merge"/>

    <bpmn:sequenceFlow id="Flow_8"
                       sourceRef="Gateway_Merge"
                       targetRef="Task_ProcessMeasuredValues"/>

    <bpmn:sequenceFlow id="Flow_9"
                       sourceRef="Task_ProcessMeasuredValues"
                       targetRef="Task_SendChangedValues"/>

    <bpmn:sequenceFlow id="Flow_10"
                       sourceRef="Task_SendChangedValues"
                       targetRef="Task_TransmitReadings"/>

    <bpmn:sequenceFlow id="Flow_11"
                       sourceRef="Task_TransmitReadings"
                       targetRef="End_Event"/>
  </bpmn:process>
</bpmn:definitions>
