<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                id="definitions"
                targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL"
                      name="Organisation"
                      processRef="process_main" />
  </bpmn:collaboration>

  <bpmn:process id="process_main" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_inq" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ip" name="IP">
        <bpmn:flowNodeRef>checkRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectRequest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="transmitRequest" name="Transmit transaction data request" />
    <bpmn:task id="checkRequest" name="Check the request" />
    <bpmn:exclusiveGateway id="decision" name="Outcome decision" />
    <bpmn:task id="transmitData" name="Transmit data" />
    <bpmn:task id="rejectRequest" name="Reject request" />
    <bpmn:endEvent id="endData" name="Data transmitted" />
    <bpmn:endEvent id="endReject" name="Request rejected" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow_start_to_transmit"
                       sourceRef="start"
                       targetRef="transmitRequest" />
    <bpmn:sequenceFlow id="flow_transmit_to_check"
                       sourceRef="transmitRequest"
                       targetRef="checkRequest" />
    <bpmn:sequenceFlow id="flow_check_to_decision"
                       sourceRef="checkRequest"
                       targetRef="decision" />
    <bpmn:sequenceFlow id="flow_decision_to_data"
                       name="data"
                       sourceRef="decision"
                       targetRef="transmitData" />
    <bpmn:sequenceFlow id="flow_decision_to_reject"
                       name="reject"
                       sourceRef="decision"
                       targetRef="rejectRequest" />
    <bpmn:sequenceFlow id="flow_data_to_end"
                       sourceRef="transmitData"
                       targetRef="endData" />
    <bpmn:sequenceFlow id="flow_reject_to_end"
                       sourceRef="rejectRequest"
                       targetRef="endReject" />
  </bpmn:process>
</bpmn:definitions>
