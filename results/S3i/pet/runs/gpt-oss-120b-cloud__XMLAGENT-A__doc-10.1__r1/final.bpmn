<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="ORG_PROCESS" />
  </bpmn:collaboration>

  <bpmn:process id="ORG_PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANESET_ORG">
      <bpmn:lane id="LANE_MPNON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1_SendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_2_ReviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3_OpposeDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_ConfirmDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="StartEvent_1" name="Process start" />

    <bpmn:task id="Task_1_SendDismissal" name="Send dismissal to MPOO" />

    <bpmn:task id="Task_2_ReviewDismissal" name="Review dismissal" />

    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Dismissal outcome?" />

    <bpmn:task id="Task_3_OpposeDismissal" name="Oppose dismissal of MPON" />

    <bpmn:task id="Task_4_ConfirmDismissal" name="Confirm dismissal of MPON" />

    <bpmn:endEvent id="EndEvent_Oppose" name="Dismissal opposed" />

    <bpmn:endEvent id="EndEvent_Confirm" name="Dismissal confirmed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_To_Send" sourceRef="StartEvent_1" targetRef="Task_1_SendDismissal" />
    <bpmn:sequenceFlow id="Flow_Send_To_Review" sourceRef="Task_1_SendDismissal" targetRef="Task_2_ReviewDismissal" />
    <bpmn:sequenceFlow id="Flow_Review_To_Gateway" sourceRef="Task_2_ReviewDismissal" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="Flow_Gateway_To_Oppose" name="oppose" sourceRef="Gateway_ReviewDecision" targetRef="Task_3_OpposeDismissal" />
    <bpmn:sequenceFlow id="Flow_Gateway_To_Confirm" name="confirm" sourceRef="Gateway_ReviewDecision" targetRef="Task_4_ConfirmDismissal" />
    <bpmn:sequenceFlow id="Flow_Oppose_To_End" sourceRef="Task_3_OpposeDismissal" targetRef="EndEvent_Oppose" />
    <bpmn:sequenceFlow id="Flow_Confirm_To_End" sourceRef="Task_4_ConfirmDismissal" targetRef="EndEvent_Confirm" />
  </bpmn:process>
</bpmn:definitions>
