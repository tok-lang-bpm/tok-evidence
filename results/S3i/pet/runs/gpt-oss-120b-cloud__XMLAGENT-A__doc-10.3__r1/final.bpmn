<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_GO" name="GO">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G10_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_MSPO" name="MSPO"/>
      <bpmn:lane id="lane_SP" name="SP"/>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="S1" name="Start" />
    
    <bpmn:task id="T1" name="MPOO deregisters at the GO" />
    <bpmn:task id="T2" name="GO verifies the deregistration" />
    
    <bpmn:exclusiveGateway id="G3" name="Deregistration decision" />
    
    <bpmn:task id="T4" name="GO rejects the deregistration" />
    <bpmn:task id="T5" name="GO preliminarily confirms the deregistration" />
    
    <bpmn:task id="T6" name="GO prepares the readmission of the measuring point" />
    
    <bpmn:exclusiveGateway id="G7" name="Oblige continuation?" />
    <bpmn:task id="T8" name="GO obliges MPOO to continue operations" />
    <bpmn:task id="T9" name="MPOO confirms the continuation" />
    <bpmn:exclusiveGateway id="G7_join" name="Obligation merge" />
    
    <bpmn:inclusiveGateway id="G10" name="Equipment actions" />
    <bpmn:task id="T11" name="GO performs equipment acquisition" />
    <bpmn:task id="T12" name="GO performs equipment changes" />
    <bpmn:inclusiveGateway id="G10_join" name="Equipment actions merge" />
    
    <bpmn:task id="T13" name="GO assigns the GO as MPO" />
    <bpmn:task id="T14" name="GO informs MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="T15" name="GO informs MSPO about the assignment of the GO" />
    <bpmn:task id="T16" name="GO informs SP about the assignment of the GO" />
    
    <bpmn:endEvent id="E2" name="Process completed" />
    <bpmn:endEvent id="E1" name="Deregistration rejected" />
    
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="G3"/>
    
    <bpmn:sequenceFlow id="F4" sourceRef="G3" targetRef="T4" name="reject"/>
    <bpmn:sequenceFlow id="F5" sourceRef="G3" targetRef="T5" name="confirm"/>
    
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="E1"/>
    
    <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="T6"/>
    
    <bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="G7"/>
    
    <bpmn:sequenceFlow id="F9" sourceRef="G7" targetRef="T8" name="yes"/>
    <bpmn:sequenceFlow id="F10" sourceRef="G7" targetRef="G7_join" name="no"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="T9"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T9" targetRef="G7_join"/>
    
    <bpmn:sequenceFlow id="F13" sourceRef="G7_join" targetRef="G10"/>
    
    <bpmn:sequenceFlow id="F14" sourceRef="G10" targetRef="T11" name="acquisition"/>
    <bpmn:sequenceFlow id="F15" sourceRef="G10" targetRef="T12" name="changes"/>
    
    <bpmn:sequenceFlow id="F16" sourceRef="T11" targetRef="G10_join"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T12" targetRef="G10_join"/>
    
    <bpmn:sequenceFlow id="F18" sourceRef="G10_join" targetRef="T13"/>
    
    <bpmn:sequenceFlow id="F19" sourceRef="T13" targetRef="T14"/>
    <bpmn:sequenceFlow id="F20" sourceRef="T14" targetRef="T15"/>
    <bpmn:sequenceFlow id="F21" sourceRef="T15" targetRef="T16"/>
    <bpmn:sequenceFlow id="F22" sourceRef="T16" targetRef="E2"/>
  </bpmn:process>
</bpmn:definitions>
