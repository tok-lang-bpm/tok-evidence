<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL"
                      name="Organisation"
                      processRef="process" />
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Mpon" name="MPON">
        <bpmn:flowNodeRef>Task_RequestBid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mpoo" name="MPOO">
        <bpmn:flowNodeRef>Task_SendTender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmAndSendData</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_RequestBid"
               name="MPON requests a device takeover bid of the MPOO" />
    <bpmn:task id="Task_SendTender"
               name="MPOO sends a tender for the equipment takeover to the MPON" />
    <bpmn:task id="Task_PlaceOrder"
               name="MPON places an order at the MPOO" />
    <bpmn:task id="Task_ConfirmAndSendData"
               name="MPOO confirms the order of the MPON and sends the master data" />
    <bpmn:endEvent id="EndEvent_1" name="End" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1"
                       sourceRef="StartEvent_1"
                       targetRef="Task_RequestBid" />
    <bpmn:sequenceFlow id="Flow_2"
                       sourceRef="Task_RequestBid"
                       targetRef="Task_SendTender" />
    <bpmn:sequenceFlow id="Flow_3"
                       sourceRef="Task_SendTender"
                       targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_4"
                       sourceRef="Task_PlaceOrder"
                       targetRef="Task_ConfirmAndSendData" />
    <bpmn:sequenceFlow id="Flow_5"
                       sourceRef="Task_ConfirmAndSendData"
                       targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
