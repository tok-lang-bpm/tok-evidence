<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>

  <bpmn:process id="process_1" isExecutable="false">

    <!-- Lanes -->
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_mspn" name="MSPN">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mspo" name="MSPO">
        <bpmn:flowNodeRef>Task_ReviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="StartEvent_1" name="Start" />

    <bpmn:task id="Task_SendDismissal" name="Send dismissal" />

    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal" />

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Dismissal approved?" />

    <bpmn:task id="Task_RejectDismissal" name="Reject dismissal" />

    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal" />

    <bpmn:endEvent id="EndEvent_Reject" name="Dismissal rejected" />
    <bpmn:endEvent id="EndEvent_Confirm" name="Dismissal confirmed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow_1"
                        sourceRef="StartEvent_1"
                        targetRef="Task_SendDismissal" />
    <bpmn:sequenceFlow id="flow_2"
                        sourceRef="Task_SendDismissal"
                        targetRef="Task_ReviewDismissal" />
    <bpmn:sequenceFlow id="flow_3"
                        sourceRef="Task_ReviewDismissal"
                        targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="flow_4"
                        name="reject"
                        sourceRef="Gateway_Decision"
                        targetRef="Task_RejectDismissal" />
    <bpmn:sequenceFlow id="flow_5"
                        name="confirm"
                        sourceRef="Gateway_Decision"
                        targetRef="Task_ConfirmDismissal" />
    <bpmn:sequenceFlow id="flow_6"
                        sourceRef="Task_RejectDismissal"
                        targetRef="EndEvent_Reject" />
    <bpmn:sequenceFlow id="flow_7"
                        sourceRef="Task_ConfirmDismissal"
                        targetRef="EndEvent_Confirm" />

  </bpmn:process>
</bpmn:definitions>
