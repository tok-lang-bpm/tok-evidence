<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LANESET_1">
      <bpmn:lane id="LANE_MSPN" name="MSPN">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Inform_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform_MSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform_MPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Inform_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MSPO" name="MSPO" />
      <bpmn:lane id="LANE_MPO" name="MPO" />
      <bpmn:lane id="LANE_SP" name="SP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start" />
    <bpmn:task id="Task_Register" name="Register measurement" />
    <bpmn:task id="Task_Examine" name="Examine application" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Application approved?" />
    <bpmn:task id="Task_Reject" name="Reject application" />
    <bpmn:task id="Task_Confirm" name="Confirm application" />
    <bpmn:task id="Task_Assign" name="Assign MSPN" />
    <bpmn:parallelGateway id="Gateway_Inform_Split" />
    <bpmn:task id="Task_Inform_MSPO" name="Inform MSPO" />
    <bpmn:task id="Task_Inform_MPO" name="Inform MPO" />
    <bpmn:task id="Task_Inform_SP" name="Inform SP" />
    <bpmn:parallelGateway id="Gateway_Inform_Join" />
    <bpmn:endEvent id="End_Process" name="End" />
    <bpmn:endEvent id="End_Reject" name="End (rejected)" />
    <bpmn:sequenceFlow id="Flow1" sourceRef="Start_1" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="Task_Register" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="Flow3" sourceRef="Task_Examine" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow4" name="reject" sourceRef="Gateway_Decision" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow5" name="confirm" sourceRef="Gateway_Decision" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow6" sourceRef="Task_Reject" targetRef="End_Reject" />
    <bpmn:sequenceFlow id="Flow7" sourceRef="Task_Confirm" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="Flow8" sourceRef="Task_Assign" targetRef="Gateway_Inform_Split" />
    <bpmn:sequenceFlow id="Flow9" sourceRef="Gateway_Inform_Split" targetRef="Task_Inform_MSPO" />
    <bpmn:sequenceFlow id="Flow10" sourceRef="Gateway_Inform_Split" targetRef="Task_Inform_MPO" />
    <bpmn:sequenceFlow id="Flow11" sourceRef="Gateway_Inform_Split" targetRef="Task_Inform_SP" />
    <bpmn:sequenceFlow id="Flow12" sourceRef="Task_Inform_MSPO" targetRef="Gateway_Inform_Join" />
    <bpmn:sequenceFlow id="Flow13" sourceRef="Task_Inform_MPO" targetRef="Gateway_Inform_Join" />
    <bpmn:sequenceFlow id="Flow14" sourceRef="Task_Inform_SP" targetRef="Gateway_Inform_Join" />
    <bpmn:sequenceFlow id="Flow15" sourceRef="Gateway_Inform_Join" targetRef="End_Process" />
  </bpmn:process>
</bpmn:definitions>