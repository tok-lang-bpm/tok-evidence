<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <!-- Collaboration with a single participant (the organisation) -->
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="PARTICIPANT_TELECO"
                      name="TELECO"
                      processRef="Process_1"/>
  </bpmn:collaboration>

  <!-- Process -->
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCustomerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCustomerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Process</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CS" name="Customer Service">
        <bpmn:flowNodeRef>Task_EnterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineMeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineSignificance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LinkExtraFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reprioritize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDetailedReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPerformanceToCS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendResolutionReportToCS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendResolutionReportToCS2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SM" name="Service Management">
        <bpmn:flowNodeRef>Task_ReceiveDetailedSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CanAnalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeProblemSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTroubleReportSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFinalStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CounterMeasures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformCorrectiveSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateProblemResolutionReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRestorationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRestorationRequestToRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveTroubleshootingReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateProblemResolutionReport2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendResolutionReportToCS2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_RP" name="Resource Provisioning">
        <bpmn:flowNodeRef>Task_ReceiveDetailedRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ProblemDetected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNormalNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeProblemRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTroubleReportRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateStatusReportToSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRestorationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Within2Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UndertakeCorrectiveRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTroubleshootingReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTroubleshootingReportToSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Terminate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_BC" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>Task_ReportSLARebate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow elements -->
    <bpmn:startEvent id="Start_1" name="Service degradation perceived"/>
    <bpmn:task id="Task_SendList" name="Send problem parameters list to Customer Service"/>
    <bpmn:task id="Task_EnterReport" name="Enter problem report into system T.."/>
    <bpmn:task id="Task_CompareSLA" name="Compare problem report to SLA"/>
    <bpmn:task id="Task_DetermineMeasures" name="Determine counter measures and priorities"/>
    <bpmn:task id="Task_DetermineSignificance" name="Determine customer significance (electronic service)"/>
    <bpmn:exclusiveGateway id="GW_Premium" name="Customer premium?"/>
    <bpmn:task id="Task_LinkExtraFix" name="Link to extra problem fix process"/>
    <bpmn:exclusiveGateway id="GW_Significance" name="Customer significance affects measures?"/>
    <bpmn:task id="Task_Reprioritize" name="Re‑prioritize counter measures"/>
    <bpmn:task id="Task_CreateDetailedReport" name="Create detailed problem report"/>
    <bpmn:task id="Task_SendToSM" name="Send detailed problem report to Service Management"/>

    <!-- Service Management -->
    <bpmn:task id="Task_ReceiveDetailedSM" name="Receive detailed problem report"/>
    <bpmn:exclusiveGateway id="GW_CanAnalyze" name="Can Service Management analyze?"/>
    <bpmn:task id="Task_AnalyzeProblemSM" name="Analyze problem (Service Management)"/>
    <bpmn:task id="Task_CreateTroubleReportSM" name="Create trouble report (Service Management)"/>
    <bpmn:task id="Task_SendToRP" name="Send detailed problem report to Resource Provisioning"/>
    <bpmn:task id="Task_ReceiveStatusReport" name="Receive status report from Resource Provisioning"/>
    <bpmn:task id="Task_PrepareFinalStatusReport" name="Prepare final status report"/>
    <bpmn:exclusiveGateway id="GW_CounterMeasures" name="Determine counter measures (final)"/>

    <bpmn:task id="Task_SendPerformanceToCS" name="Send actual service performance to Customer Service"/>
    <bpmn:task id="Task_PerformCorrectiveSM" name="Perform minor corrective actions (Service Management)"/>
    <bpmn:task id="Task_CreateProblemResolutionReport" name="Create problem resolution report"/>
    <bpmn:task id="Task_SendResolutionReportToCS" name="Send problem resolution report to Customer Service"/>

    <bpmn:task id="Task_CreateRestorationRequest" name="Create request for automatic resource restoration"/>
    <bpmn:task id="Task_SendRestorationRequestToRP" name="Send restoration request to Resource Provisioning"/>

    <bpmn:task id="Task_ReceiveTroubleshootingReport" name="Receive troubleshooting report"/>
    <bpmn:task id="Task_CreateProblemResolutionReport2" name="Create problem resolution report (after troubleshooting)"/>
    <bpmn:task id="Task_SendResolutionReportToCS2" name="Send problem resolution report to Customer Service"/>

    <!-- Resource Provisioning -->
    <bpmn:task id="Task_ReceiveDetailedRP" name="Receive detailed problem report"/>
    <bpmn:exclusiveGateway id="GW_ProblemDetected" name="Problems detected?"/>
    <bpmn:task id="Task_CreateNormalNotification" name="Create normal service execution notification"/>
    <bpmn:task id="Task_AnalyzeProblemRP" name="Analyze problem (Resource Provisioning)"/>
    <bpmn:task id="Task_CreateTroubleReportRP" name="Create trouble report (Resource Provisioning)"/>
    <bpmn:task id="Task_CreateStatusReportToSM" name="Include report/notification in status report and send to Service Management"/>
    <bpmn:task id="Task_ReceiveRestorationRequest" name="Receive restoration request"/>
    <bpmn:exclusiveGateway id="GW_Within2Days" name="Request received within 2 days?"/>
    <bpmn:task id="Task_TrackErrors" name="Track all possible errors"/>
    <bpmn:task id="Task_UndertakeCorrectiveRP" name="Undertake corrective actions (Resource Provisioning)"/>
    <bpmn:task id="Task_CreateTroubleshootingReport" name="Create troubleshooting report"/>
    <bpmn:task id="Task_SendTroubleshootingReportToSM" name="Send troubleshooting report to Service Management"/>
    <bpmn:endEvent id="End_Terminate" name="Process terminated (timeout)"/>

    <!-- Customer Service after receiving reports -->
    <bpmn:task id="Task_ReceiveReport" name="Receive report (performance or resolution)"/>
    <bpmn:parallelGateway id="GW_ParallelStart" name="Parallel activities start"/>
    <bpmn:task id="Task_CreateCustomerReport" name="Create customer report (service performance & resolution)"/>
    <bpmn:task id="Task_SendCustomerReport" name="Send customer report to Customer"/>
    <bpmn:task id="Task_ReportSLARebate" name="Report SLA violation rebate to Billing &amp; Collections"/>
    <bpmn:parallelGateway id="GW_ParallelEnd" name="Parallel activities end"/>
    <bpmn:endEvent id="End_Process" name="Process end"/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_SendList"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_SendList" targetRef="Task_EnterReport"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_EnterReport" targetRef="Task_CompareSLA"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_CompareSLA" targetRef="Task_DetermineMeasures"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_DetermineMeasures" targetRef="Task_DetermineSignificance"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_DetermineSignificance" targetRef="GW_Premium"/>
    <bpmn:sequenceFlow id="F7_yes" name="yes" sourceRef="GW_Premium" targetRef="Task_LinkExtraFix"/>
    <bpmn:sequenceFlow id="F8_no" name="no" sourceRef="GW_Premium" targetRef="GW_Significance"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_LinkExtraFix" targetRef="GW_Significance"/>
    <bpmn:sequenceFlow id="F10_yes" name="yes" sourceRef="GW_Significance" targetRef="Task_Reprioritize"/>
    <bpmn:sequenceFlow id="F11_no" name="no" sourceRef="GW_Significance" targetRef="Task_CreateDetailedReport"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Reprioritize" targetRef="Task_CreateDetailedReport"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_CreateDetailedReport" targetRef="Task_SendToSM"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_SendToSM" targetRef="Task_ReceiveDetailedSM"/>

    <bpmn:sequenceFlow id="F15_yes" name="yes" sourceRef="GW_CanAnalyze" targetRef="Task_AnalyzeProblemSM"/>
    <bpmn:sequenceFlow id="F16_no" name="no" sourceRef="GW_CanAnalyze" targetRef="Task_SendToRP"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_AnalyzeProblemSM" targetRef="Task_CreateTroubleReportSM"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_CreateTroubleReportSM" targetRef="Task_ReceiveStatusReport"/>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_SendToRP" targetRef="Task_ReceiveDetailedRP"/>

    <bpmn:sequenceFlow id="F20" sourceRef="Task_ReceiveDetailedRP" targetRef="GW_ProblemDetected"/>
    <bpmn:sequenceFlow id="F21_yes" name="yes" sourceRef="GW_ProblemDetected" targetRef="Task_CreateNormalNotification"/>
    <bpmn:sequenceFlow id="F22_no" name="no" sourceRef="GW_ProblemDetected" targetRef="Task_AnalyzeProblemRP"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Task_AnalyzeProblemRP" targetRef="Task_CreateTroubleReportRP"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Task_CreateNormalNotification" targetRef="Task_CreateStatusReportToSM"/>
    <bpmn:sequenceFlow id="F25" sourceRef="Task_CreateTroubleReportRP" targetRef="Task_CreateStatusReportToSM"/>

    <bpmn:sequenceFlow id="F26" sourceRef="Task_CreateStatusReportToSM" targetRef="Task_ReceiveStatusReport"/>

    <bpmn:sequenceFlow id="F27" sourceRef="Task_ReceiveStatusReport" targetRef="Task_PrepareFinalStatusReport"/>
    <bpmn:sequenceFlow id="F28" sourceRef="Task_PrepareFinalStatusReport" targetRef="GW_CounterMeasures"/>

    <bpmn:sequenceFlow id="F29_noProblem" name="no problem" sourceRef="GW_CounterMeasures" targetRef="Task_SendPerformanceToCS"/>
    <bpmn:sequenceFlow id="F30_minor" name="minor corrective" sourceRef="GW_CounterMeasures" targetRef="Task_PerformCorrectiveSM"/>
    <bpmn:sequenceFlow id="F31_auto" name="automatic restoration" sourceRef="GW_CounterMeasures" targetRef="Task_CreateRestorationRequest"/>

    <bpmn:sequenceFlow id="F32" sourceRef="Task_PerformCorrectiveSM" targetRef="Task_CreateProblemResolutionReport"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Task_CreateProblemResolutionReport" targetRef="Task_SendResolutionReportToCS"/>

    <bpmn:sequenceFlow id="F34" sourceRef="Task_CreateRestorationRequest" targetRef="Task_SendRestorationRequestToRP"/>
    <bpmn:sequenceFlow id="F35" sourceRef="Task_SendRestorationRequestToRP" targetRef="Task_ReceiveRestorationRequest"/>

    <bpmn:sequenceFlow id="F36_yes" name="within 2 days" sourceRef="GW_Within2Days" targetRef="Task_TrackErrors"/>
    <bpmn:sequenceFlow id="F37_no" name="timeout" sourceRef="GW_Within2Days" targetRef="End_Terminate"/>
    <bpmn:sequenceFlow id="F38" sourceRef="Task_TrackErrors" targetRef="Task_UndertakeCorrectiveRP"/>
    <bpmn:sequenceFlow id="F39" sourceRef="Task_UndertakeCorrectiveRP" targetRef="Task_CreateTroubleshootingReport"/>
    <bpmn:sequenceFlow id="F40" sourceRef="Task_CreateTroubleshootingReport" targetRef="Task_SendTroubleshootingReportToSM"/>
    <bpmn:sequenceFlow id="F41" sourceRef="Task_SendTroubleshootingReportToSM" targetRef="Task_ReceiveTroubleshootingReport"/>

    <bpmn:sequenceFlow id="F42" sourceRef="Task_ReceiveTroubleshootingReport" targetRef="Task_CreateProblemResolutionReport2"/>
    <bpmn:sequenceFlow id="F43" sourceRef="Task_CreateProblemResolutionReport2" targetRef="Task_SendResolutionReportToCS2"/>

    <!-- Merge reports to Customer Service -->
    <bpmn:sequenceFlow id="F44_perf" sourceRef="Task_SendPerformanceToCS" targetRef="Task_ReceiveReport"/>
    <bpmn:sequenceFlow id="F45_res1" sourceRef="Task_SendResolutionReportToCS" targetRef="Task_ReceiveReport"/>
    <bpmn:sequenceFlow id="F46_res2" sourceRef="Task_SendResolutionReportToCS2" targetRef="Task_ReceiveReport"/>

    <bpmn:sequenceFlow id="F47" sourceRef="Task_ReceiveReport" targetRef="GW_ParallelStart"/>
    <bpmn:sequenceFlow id="F48" sourceRef="GW_ParallelStart" targetRef="Task_CreateCustomerReport"/>
    <bpmn:sequenceFlow id="F49" sourceRef="GW_ParallelStart" targetRef="Task_SendCustomerReport"/>
    <bpmn:sequenceFlow id="F50" sourceRef="GW_ParallelStart" targetRef="Task_ReportSLARebate"/>
    <bpmn:sequenceFlow id="F51" sourceRef="Task_CreateCustomerReport" targetRef="GW_ParallelEnd"/>
    <bpmn:sequenceFlow id="F52" sourceRef="Task_SendCustomerReport" targetRef="GW_ParallelEnd"/>
    <bpmn:sequenceFlow id="F53" sourceRef="Task_ReportSLARebate" targetRef="GW_ParallelEnd"/>
    <bpmn:sequenceFlow id="F54" sourceRef="GW_ParallelEnd" targetRef="End_Process"/>

    <!-- Gateways default flows -->
    <bpmn:sequenceFlow id="F_default_Premium" sourceRef="GW_Premium" targetRef="GW_Significance"/>
    <bpmn:sequenceFlow id="F_default_Significance" sourceRef="GW_Significance" targetRef="Task_CreateDetailedReport"/>
    <bpmn:sequenceFlow id="F_default_ProblemDetected" sourceRef="GW_ProblemDetected" targetRef="Task_CreateNormalNotification"/>
    <bpmn:sequenceFlow id="F_default_Within2Days" sourceRef="GW_Within2Days" targetRef="End_Terminate"/>
  </bpmn:process>
</bpmn:definitions>
