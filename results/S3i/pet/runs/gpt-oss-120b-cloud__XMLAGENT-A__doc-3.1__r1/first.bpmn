<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg_WarrantRequest" name="WarrantPossessionRequest"/>
  <bpmn:message id="msg_SCTWarrant" name="SCTWarrantPossession"/>
  <bpmn:message id="msg_Report" name="Report"/>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Participant_Party" name="Party" processRef="party-process" />
    <bpmn:participant id="Participant_Organisation" name="Organisation" processRef="org-process" />
    <bpmn:participant id="Participant_Police" name="Queensland Police" processRef="police-process" />
    <bpmn:messageFlow id="mf1" sourceRef="Send_Request" targetRef="Receive_Request" messageRef="msg_WarrantRequest" />
    <bpmn:messageFlow id="mf2" sourceRef="Forward_to_Police" targetRef="Police_Receive" messageRef="msg_SCTWarrant" />
    <bpmn:messageFlow id="mf3" sourceRef="Police_SendReport" targetRef="Receive_Report" messageRef="msg_Report" />
  </bpmn:collaboration>

  <!-- Party Process -->
  <bpmn:process id="party-process" isExecutable="false">
    <bpmn:startEvent id="Start_Party" name="Start" />
    <bpmn:task id="Send_Request" name="Send warrant possession request" />
    <bpmn:endEvent id="End_Party" name="End" />
    <bpmn:sequenceFlow id="sf_P1" sourceRef="Start_Party" targetRef="Send_Request" />
    <bpmn:sequenceFlow id="sf_P2" sourceRef="Send_Request" targetRef="End_Party" />
  </bpmn:process>

  <!-- Organisation Process -->
  <bpmn:process id="org-process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Org">
      <bpmn:lane id="Lane_BackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>Start_Org</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retrieve_SCT_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Forward_to_Police</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_SCT_waiting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retrieve_Respective_SCT_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Attach_New_SCT_Document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_Expanded_SCT_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Org</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Org" name="Start" />
    <bpmn:task id="Receive_Request" name="Receive warrant possession request" />
    <bpmn:task id="Retrieve_SCT_File" name="Retrieve SCT file" />
    <bpmn:task id="Forward_to_Police" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="Store_SCT_waiting" name="Store SCT physical file awaiting report" />
    <bpmn:task id="Receive_Report" name="Receive report" />
    <bpmn:task id="Retrieve_Respective_SCT_File" name="Retrieve respective SCT file" />
    <bpmn:task id="Attach_New_SCT_Document" name="Attach new SCT document" />
    <bpmn:task id="Store_Expanded_SCT_File" name="Store expanded SCT physical file" />
    <bpmn:endEvent id="End_Org" name="End" />
    <bpmn:sequenceFlow id="sf_O1" sourceRef="Start_Org" targetRef="Receive_Request" />
    <bpmn:sequenceFlow id="sf_O2" sourceRef="Receive_Request" targetRef="Retrieve_SCT_File" />
    <bpmn:sequenceFlow id="sf_O3" sourceRef="Retrieve_SCT_File" targetRef="Forward_to_Police" />
    <bpmn:sequenceFlow id="sf_O4" sourceRef="Forward_to_Police" targetRef="Store_SCT_waiting" />
    <bpmn:sequenceFlow id="sf_O5" sourceRef="Store_SCT_waiting" targetRef="Receive_Report" />
    <bpmn:sequenceFlow id="sf_O6" sourceRef="Receive_Report" targetRef="Retrieve_Respective_SCT_File" />
    <bpmn:sequenceFlow id="sf_O7" sourceRef="Retrieve_Respective_SCT_File" targetRef="Attach_New_SCT_Document" />
    <bpmn:sequenceFlow id="sf_O8" sourceRef="Attach_New_SCT_Document" targetRef="Store_Expanded_SCT_File" />
    <bpmn:sequenceFlow id="sf_O9" sourceRef="Store_Expanded_SCT_File" targetRef="End_Org" />
  </bpmn:process>

  <!-- Police Process -->
  <bpmn:process id="police-process" isExecutable="false">
    <bpmn:startEvent id="Start_Police" name="Start" />
    <bpmn:task id="Police_Receive" name="Receive SCT Warrant Possession" />
    <bpmn:task id="Police_SendReport" name="Send report" />
    <bpmn:endEvent id="End_Police" name="End" />
    <bpmn:sequenceFlow id="sf_Police1" sourceRef="Start_Police" targetRef="Police_Receive" />
    <bpmn:sequenceFlow id="sf_Police2" sourceRef="Police_Receive" targetRef="Police_SendReport" />
    <bpmn:sequenceFlow id="sf_Police3" sourceRef="Police_SendReport" targetRef="End_Police" />
  </bpmn:process>
</bpmn:definitions>