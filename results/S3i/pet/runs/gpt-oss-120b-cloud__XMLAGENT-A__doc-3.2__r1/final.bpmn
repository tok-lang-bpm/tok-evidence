<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process1"/>
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="LaneSet1">
      <bpmn:lane id="laneClerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AndSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandToAssociate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AndJoin2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneJudge" name="Judge">
        <bpmn:flowNodeRef>Task_ConductHearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Morning start"/>
    <bpmn:task id="Task_CheckFiles" name="Check files for court hearing"/>
    <bpmn:exclusiveGateway id="Gateway_Missing" name="Missing files?"/>
    <bpmn:task id="Task_InitiateSearch" name="Initiate search for missing files"/>
    <bpmn:task id="Task_TrackFiles" name="Physically track files to intended location"/>
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Merge paths"/>
    <bpmn:parallelGateway id="Gateway_AndSplit"/>
    <bpmn:task id="Task_HandToAssociate" name="Hand files to Associate"/>
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judge's Lawlist to relevant people"/>
    <bpmn:parallelGateway id="Gateway_AndJoin2"/>
    <bpmn:task id="Task_ConductHearings" name="Conduct directions hearings"/>
    <bpmn:endEvent id="EndEvent_1" name="Process completed"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckFiles"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckFiles" targetRef="Gateway_Missing"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Missing" targetRef="Task_InitiateSearch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Missing" targetRef="Task_TrackFiles">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_InitiateSearch" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_TrackFiles" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Merge" targetRef="Gateway_AndSplit"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_AndSplit" targetRef="Task_HandToAssociate"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_AndSplit" targetRef="Task_DistributeLawlist"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_HandToAssociate" targetRef="Gateway_AndJoin2"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_DistributeLawlist" targetRef="Gateway_AndJoin2"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_AndJoin2" targetRef="Task_ConductHearings"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConductHearings" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>
