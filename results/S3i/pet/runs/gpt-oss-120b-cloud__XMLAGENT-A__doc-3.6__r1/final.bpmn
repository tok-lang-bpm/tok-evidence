<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="OrgPool" name="Organisation" processRef="ClaimsProcess" />
  </bpmn:collaboration>

  <bpmn:process id="ClaimsProcess" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Org" name="Claims Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="StartEvent_1" name="Claim received" />
    
    <bpmn:task id="Task_2" name="2. Check insurance" />
    
    <bpmn:exclusiveGateway id="Gateway_3" name="3. Insured?" />
    
    <bpmn:task id="Task_4" name="4. Inform claimant of rejection" />
    
    <bpmn:endEvent id="End_5" name="Process ended (rejected)" />
    
    <bpmn:task id="Task_6" name="6. Evaluate claim severity" />
    
    <bpmn:task id="Task_7" name="7. Send relevant forms" />
    
    <bpmn:intermediateCatchEvent id="Catch_8" name="8. Forms returned">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    
    <bpmn:task id="Task_9" name="9. Check forms for completeness" />
    
    <bpmn:exclusiveGateway id="Gateway_10" name="10. Forms complete?" />
    
    <bpmn:task id="Task_11" name="11. Register claim in Claims Management system" />
    
    <bpmn:endEvent id="End_12" name="Claims Notification process ends" />
    
    <bpmn:task id="Task_13" name="13. Inform claimant to update forms" />
    
    <bpmn:intermediateCatchEvent id="Catch_14" name="14. Updated forms received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_3" name="no" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="End_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_3" name="yes" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_7" targetRef="Catch_8" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Catch_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_9" targetRef="Gateway_10" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_10" name="yes" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_11" targetRef="End_12" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_10" name="no" targetRef="Task_13" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_13" targetRef="Catch_14" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Catch_14" targetRef="Task_9" />
  </bpmn:process>
</bpmn:definitions>
