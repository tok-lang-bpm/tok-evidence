<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="ORG_PROCESS" />
    <bpmn:participant id="CLAIMANT_POOL" name="Claimant" />
  </bpmn:collaboration>

  <bpmn:process id="ORG_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET_ORG">
      <bpmn:lane id="LANE_HANDLER" name="Claims Handler">
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MANAGER" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_INFORM" name="Claimant Inform">
        <bpmn:flowNodeRef>Task_InformClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start and End -->
    <bpmn:startEvent id="StartEvent" name="Process Start" />
    <bpmn:endEvent id="EndEvent" name="Process End" />

    <!-- Tasks -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report in database" />
    <bpmn:task id="Task_PutInFile" name="Put Police Report together with Claim Documentation in a file" />
    <bpmn:task id="Task_CalculateEstimate" name="Calculate initial claim estimate" />
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan based on Action Plan Checklist" />
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="Task_InformClaimant" name="Inform claimant of the outcome" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent" targetRef="Task_SearchPoliceReport" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_SearchPoliceReport" targetRef="Task_PutInFile" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_PutInFile" targetRef="Task_CalculateEstimate" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement" />
    <bpmn:sequenceFlow id="flow6" sourceRef="Task_NegotiateSettlement" targetRef="Task_InformClaimant" />
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_InformClaimant" targetRef="EndEvent" />
  </bpmn:process>
</bpmn:definitions>
