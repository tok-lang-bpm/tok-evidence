<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Mental Health Care Institute"
                     processRef="process_intake" />
  </bpmn:collaboration>

  <bpmn:process id="process_intake" isExecutable="false">

    <!-- Lanes -->
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_FAMILY_DOC" name="Family Doctor">
        <bpmn:flowNodeRef>Task_FamilyNotice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="LANE_SECRETARY" name="Secretarial Office">
        <bpmn:flowNodeRef>Task_InquireName</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutNurseCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreFormPrint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddNewNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSecondIntaker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddCopyToFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PassCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TypeDictaphone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddStatusList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideStatus</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="LANE_NURSE" name="Nursing Officer">
        <bpmn:flowNodeRef>Task_NurseInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordForm</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="LANE_FIRST_INT" name="First Intaker (Social‑Medical Worker)">
        <bpmn:flowNodeRef>Task_FirstPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FirstMeet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillChecklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterNotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreNotes</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="LANE_SECOND_INT" name="Second Intaker (Physician)">
        <bpmn:flowNodeRef>Task_SecondPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SecondMeet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordDictaphone</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="LANE_TEAM_LEAD" name="Team Leader">
        <bpmn:flowNodeRef>Task_StaffMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignPatients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordAssignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MedReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinFile</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="LANE_PSYCHIATRIST" name="Psychiatrist">
        <bpmn:flowNodeRef>Task_FormulateTreatment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="Start1" name="Intake workflow starts" />

    <bpmn:task id="Task_FamilyNotice" name="Give notice by telephone" />
    <bpmn:task id="Task_InquireName" name="Inquire name and residence of patient" />
    <bpmn:task id="Task_PutNurseCall" name="Put nursing officer on call" />
    <bpmn:task id="Task_NurseInquiry" name="Make full inquiry into mental, health and social state" />
    <bpmn:task id="Task_RecordForm" name="Record information on registration form" />
    <bpmn:task id="Task_HandForm" name="Hand in registration form" />
    <bpmn:task id="Task_StoreInfo" name="Store information in information system" />
    <bpmn:task id="Task_Print" name="Print registration" />
    <bpmn:task id="Task_CreateFile" name="Create patient file (new patient)" />
    <bpmn:task id="Task_StoreFormPrint" name="Store form and print in patient file" />
    <bpmn:task id="Task_ProduceCards" name="Produce registration cards for first and second intaker" />
    <bpmn:task id="Task_AddNewNotice" name="Add patient to list of new notices" />
    <bpmn:task id="Task_StaffMeeting" name="Hold staff meeting (Wednesday)" />
    <bpmn:task id="Task_AssignPatients" name="Assign patients to first and second intakers" />
    <bpmn:task id="Task_RecordAssignments" name="Record assignments on assignment list" />
    <bpmn:task id="Task_HandAssignment" name="Hand assignment list to secretarial office" />

    <bpmn:exclusiveGateway id="Gateway_MedReq" name="Medical file required?" default="Flow_NoFile" />
    <bpmn:task id="Task_PrepareLetter" name="Prepare and send letter to family doctor" />
    <bpmn:task id="Task_ReceiveCopy" name="Receive medical file copy from family doctor" />
    <bpmn:task id="Task_InformSecondIntaker" name="Inform second intaker of received copy" />
    <bpmn:task id="Task_AddCopyToFile" name="Add copy to patient file" />
    <bpmn:parallelGateway id="Gateway_JoinFile" name="Join after file handling" />

    <bpmn:task id="Task_PassCards" name="Pass registration cards to intakers" />

    <bpmn:parallelGateway id="Gateway_SplitMeetings" name="Split to first & second intaker meetings" />
    <!-- First intaker path -->
    <bpmn:task id="Task_FirstPlan" name="Plan first intaker meeting" />
    <bpmn:task id="Task_FirstMeet" name="First intaker conducts meeting with patient" />
    <bpmn:task id="Task_FillChecklist" name="Fill standard checklist" />
    <bpmn:task id="Task_RegisterNotes" name="Register observations in personal notebook" />
    <bpmn:task id="Task_StoreNotes" name="Store notes and checklist in patient file" />
    <!-- Second intaker path -->
    <bpmn:task id="Task_SecondPlan" name="Plan second intaker meeting" />
    <bpmn:task id="Task_SecondMeet" name="Second intaker conducts meeting with patient" />
    <bpmn:task id="Task_RecordDictaphone" name="Record observations with dictaphone" />
    <bpmn:task id="Task_TypeDictaphone" name="Type out dictaphone recordings" />
    <bpmn:task id="Task_StorePhysNotes" name="Store physician notes in patient file" />

    <bpmn:parallelGateway id="Gateway_JoinMeetings" name="Join after both meetings" />

    <bpmn:task id="Task_AddStatusList" name="Add patient to status list" />
    <bpmn:task id="Task_ProvideStatus" name="Provide status list to team‑leader" />
    <bpmn:task id="Task_FormulateTreatment" name="Formulate treatment plan" />

    <bpmn:endEvent id="End1" name="End of intake procedure" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start1" targetRef="Task_FamilyNotice" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FamilyNotice" targetRef="Task_InquireName" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_InquireName" targetRef="Task_PutNurseCall" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PutNurseCall" targetRef="Task_NurseInquiry" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NurseInquiry" targetRef="Task_RecordForm" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RecordForm" targetRef="Task_HandForm" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_HandForm" targetRef="Task_StoreInfo" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_StoreInfo" targetRef="Task_Print" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Print" targetRef="Task_CreateFile" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CreateFile" targetRef="Task_StoreFormPrint" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_StoreFormPrint" targetRef="Task_ProduceCards" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProduceCards" targetRef="Task_AddNewNotice" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AddNewNotice" targetRef="Task_StaffMeeting" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_StaffMeeting" targetRef="Task_AssignPatients" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AssignPatients" targetRef="Task_RecordAssignments" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RecordAssignments" targetRef="Task_HandAssignment" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_HandAssignment" targetRef="Gateway_MedReq" />

    <!-- Branches from exclusive gateway -->
    <bpmn:sequenceFlow id="Flow_YesFile" name="yes" sourceRef="Gateway_MedReq" targetRef="Task_PrepareLetter" />
    <bpmn:sequenceFlow id="Flow_NoFile" name="no" sourceRef="Gateway_MedReq" targetRef="Gateway_JoinFile" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PrepareLetter" targetRef="Task_ReceiveCopy" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ReceiveCopy" targetRef="Task_InformSecondIntaker" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_InformSecondIntaker" targetRef="Task_AddCopyToFile" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_AddCopyToFile" targetRef="Gateway_JoinFile" />

    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_JoinFile" targetRef="Task_PassCards" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_PassCards" targetRef="Gateway_SplitMeetings" />

    <!-- Parallel split to intaker paths -->
    <bpmn:sequenceFlow id="Flow_24" name="first" sourceRef="Gateway_SplitMeetings" targetRef="Task_FirstPlan" />
    <bpmn:sequenceFlow id="Flow_25" name="second" sourceRef="Gateway_SplitMeetings" targetRef="Task_SecondPlan" />

    <!-- First intaker path -->
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_FirstPlan" targetRef="Task_FirstMeet" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_FirstMeet" targetRef="Task_FillChecklist" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_FillChecklist" targetRef="Task_RegisterNotes" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_RegisterNotes" targetRef="Task_StoreNotes" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_StoreNotes" targetRef="Gateway_JoinMeetings" />

    <!-- Second intaker path -->
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_SecondPlan" targetRef="Task_SecondMeet" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_SecondMeet" targetRef="Task_RecordDictaphone" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_RecordDictaphone" targetRef="Task_TypeDictaphone" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_TypeDictaphone" targetRef="Task_StorePhysNotes" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_StorePhysNotes" targetRef="Gateway_JoinMeetings" />

    <bpmn:sequenceFlow id="Flow_36" sourceRef="Gateway_JoinMeetings" targetRef="Task_AddStatusList" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_AddStatusList" targetRef="Task_ProvideStatus" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_ProvideStatus" targetRef="Task_FormulateTreatment" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_FormulateTreatment" targetRef="End1" />

  </bpmn:process>
</bpmn:definitions>
