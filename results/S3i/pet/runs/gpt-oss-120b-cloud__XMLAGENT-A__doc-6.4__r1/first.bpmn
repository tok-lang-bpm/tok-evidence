<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process_1" />
  </bpmn:collaboration>
  <bpmn:process id="process_1" isExecutable="false">
    <bpmn:laneSet id="laneSet_1">
      <bpmn:lane id="lane_marketing" name="Marketing">
        <bpmn:flowNodeRef>task_determine_contact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_callcenter" name="Call Center">
        <bpmn:flowNodeRef>task_start_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_determine_person_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_ask_interest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_headdev" name="Head of Development">
        <bpmn:flowNodeRef>task_head_try</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales" name="Sales Representative">
        <bpmn:flowNodeRef>task_presentation_sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_wait_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sales_call_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_create_quotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_presales" name="Pre-sales">
        <bpmn:flowNodeRef>task_presentation_presales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start Process" />
    <bpmn:task id="task_determine_contact" name="Determine contact details of potential customers" />
    <bpmn:task id="task_start_call" name="Start calling the customer" />
    <bpmn:task id="task_determine_person_budget" name="Determine contact person and budget" />
    <bpmn:task id="task_ask_interest" name="Ask the customer whether he is generally interested" />
    <bpmn:exclusiveGateway id="gw_interest" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="gw_budget_huge" name="Is project budget huge?" />
    <bpmn:task id="task_head_try" name="Head of development tries to acquire the customer" />
    <bpmn:exclusiveGateway id="gw_interest2" name="Customer interested after head attempt?" />
    <bpmn:exclusiveGateway id="gw_presentation_type" name="Presentation type?" />
    <bpmn:task id="task_presentation_sales" name="Detailed online presentation by sales representative" />
    <bpmn:task id="task_presentation_presales" name="Detailed online presentation by pre‑sales employee" />
    <bpmn:task id="task_wait_response" name="Wait for customer response (max 2 weeks)" />
    <bpmn:exclusiveGateway id="gw_response" name="Customer responded within 2 weeks?" />
    <bpmn:task id="task_sales_call_back" name="Sales representative calls customer" />
    <bpmn:task id="task_create_quotation" name="Create quotation" />
    <bpmn:endEvent id="end_process" name="End Process" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="task_determine_contact" />
    <bpmn:sequenceFlow id="flow2" sourceRef="task_determine_contact" targetRef="task_start_call" />
    <bpmn:sequenceFlow id="flow3" sourceRef="task_start_call" targetRef="task_determine_person_budget" />
    <bpmn:sequenceFlow id="flow4" sourceRef="task_determine_person_budget" targetRef="task_ask_interest" />
    <bpmn:sequenceFlow id="flow5" sourceRef="task_ask_interest" targetRef="gw_interest" />
    <bpmn:sequenceFlow id="flow6_yes" name="yes" sourceRef="gw_interest" targetRef="gw_presentation_type" />
    <bpmn:sequenceFlow id="flow6_no" name="no" sourceRef="gw_interest" targetRef="gw_budget_huge" />
    <bpmn:sequenceFlow id="flow7_yes" name="yes" sourceRef="gw_budget_huge" targetRef="task_head_try" />
    <bpmn:sequenceFlow id="flow7_no" name="no" sourceRef="gw_budget_huge" targetRef="end_process" />
    <bpmn:sequenceFlow id="flow8" sourceRef="task_head_try" targetRef="gw_interest2" />
    <bpmn:sequenceFlow id="flow9_yes" name="yes" sourceRef="gw_interest2" targetRef="gw_presentation_type" />
    <bpmn:sequenceFlow id="flow9_no" name="no" sourceRef="gw_interest2" targetRef="end_process" />
    <bpmn:sequenceFlow id="flow10_sales" name="sales" sourceRef="gw_presentation_type" targetRef="task_presentation_sales" />
    <bpmn:sequenceFlow id="flow10_presales" name="technical" sourceRef="gw_presentation_type" targetRef="task_presentation_presales" />
    <bpmn:sequenceFlow id="flow11" sourceRef="task_presentation_sales" targetRef="task_wait_response" />
    <bpmn:sequenceFlow id="flow12" sourceRef="task_presentation_presales" targetRef="task_wait_response" />
    <bpmn:sequenceFlow id="flow13" sourceRef="task_wait_response" targetRef="gw_response" />
    <bpmn:sequenceFlow id="flow14_yes" name="yes" sourceRef="gw_response" targetRef="task_create_quotation" />
    <bpmn:sequenceFlow id="flow14_no" name="no" sourceRef="gw_response" targetRef="task_sales_call_back" />
    <bpmn:sequenceFlow id="flow15" sourceRef="task_sales_call_back" targetRef="task_create_quotation" />
    <bpmn:sequenceFlow id="flow16" sourceRef="task_create_quotation" targetRef="end_process" />
  </bpmn:process>
</bpmn:definitions>