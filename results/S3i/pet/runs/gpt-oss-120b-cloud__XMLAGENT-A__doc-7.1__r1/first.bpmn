<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_Manager" name="Manager">
        <bpmn:flowNodeRef>Task_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessLead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNote</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start" />
    <bpmn:task id="Task_CheckLeads" name="Check open leads" />
    <bpmn:task id="Task_SelectLeads" name="Select top five leads" />
    <bpmn:task id="Task_TellAssistant" name="Tell Sales Assistant to call contacts" />
    <bpmn:task id="Task_CallCustomer" name="Call customer" />
    <bpmn:exclusiveGateway id="Gw_Interest" name="Customer interested?" />
    <bpmn:task id="Task_SendNote" name="Send note to Manager" />
    <bpmn:task id="Task_ProcessLead" name="Process lead" />
    <bpmn:endEvent id="End" name="End" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_CheckLeads" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckLeads" targetRef="Task_SelectLeads" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_SelectLeads" targetRef="Task_TellAssistant" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_TellAssistant" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_CallCustomer" targetRef="Gw_Interest" />
    <bpmn:sequenceFlow id="F6" name="interested" sourceRef="Gw_Interest" targetRef="Task_SendNote" />
    <bpmn:sequenceFlow id="F7" name="not interested" sourceRef="Gw_Interest" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_SendNote" targetRef="Task_ProcessLead" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_ProcessLead" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>