<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="HR Clerk">
        <bpmn:flowNodeRef>StartEvent_VacancyReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Confusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskDepartmentAgain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_VacancyReported" name="Vacancy reported" />
    <bpmn:task id="Task_CreateJobDescription" name="Create job description" />
    <bpmn:exclusiveGateway id="Gateway_Confusion" name="Confusion?" />
    <bpmn:task id="Task_AskDepartmentAgain" name="Ask Department again" />
    <bpmn:exclusiveGateway id="Gateway_MergeConfusion" name="" />
    <bpmn:task id="Task_SubmitJobDescription" name="Submit job description for consideration" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" />
    <bpmn:task id="Task_CorrectDescription" name="Correct description" />
    <bpmn:task id="Task_PostJob" name="Post job" />
    <bpmn:endEvent id="EndEvent_ProcessEnd" name="End" />
    <bpmn:sequenceFlow id="Flow1" sourceRef="StartEvent_VacancyReported" targetRef="Task_CreateJobDescription" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="Task_CreateJobDescription" targetRef="Gateway_Confusion" />
    <bpmn:sequenceFlow id="Flow3_yes" name="yes" sourceRef="Gateway_Confusion" targetRef="Task_AskDepartmentAgain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">confusion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow3_no" name="no" sourceRef="Gateway_Confusion" targetRef="Gateway_MergeConfusion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!confusion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow4" sourceRef="Task_AskDepartmentAgain" targetRef="Gateway_MergeConfusion" />
    <bpmn:sequenceFlow id="Flow5" sourceRef="Gateway_MergeConfusion" targetRef="Task_SubmitJobDescription" />
    <bpmn:sequenceFlow id="Flow6" sourceRef="Task_SubmitJobDescription" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow7_yes" name="yes" sourceRef="Gateway_Approved" targetRef="Task_PostJob">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow7_no" name="no" sourceRef="Gateway_Approved" targetRef="Task_CorrectDescription">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">!approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow8" sourceRef="Task_CorrectDescription" targetRef="Task_SubmitJobDescription" />
    <bpmn:sequenceFlow id="Flow9" sourceRef="Task_PostJob" targetRef="EndEvent_ProcessEnd" />
  </bpmn:process>
</bpmn:definitions>