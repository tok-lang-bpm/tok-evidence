<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="laneset1">
      <bpmn:lane id="lane_head" name="Head of Functional Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitDesc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askCorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveCorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hr" name="HR Department">
        <bpmn:flowNodeRef>hrGw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="detect" name="Detect personnel requirements" />
    <bpmn:task id="report" name="Report vacancy to Personnel Department" />
    <bpmn:task id="waitDesc" name="Wait for job description" />
    <bpmn:parallelGateway id="split" name="Parallel Split" />
    <bpmn:exclusiveGateway id="hrGw" name="HR has questions?" default="f8" />
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:exclusiveGateway id="corrGw" name="Corrections needed?" default="f13" />
    <bpmn:task id="askCorr" name="Ask for corrections" />
    <bpmn:task id="receiveCorr" name="Receive corrected job description" />
    <bpmn:parallelGateway id="join" name="Parallel Join" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:endEvent id="end" name="End" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="detect" />
    <bpmn:sequenceFlow id="f2" sourceRef="detect" targetRef="report" />
    <bpmn:sequenceFlow id="f3" sourceRef="report" targetRef="waitDesc" />
    <bpmn:sequenceFlow id="f4" sourceRef="waitDesc" targetRef="split" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="hrGw" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="corrGw" />

    <bpmn:sequenceFlow id="f7" sourceRef="hrGw" targetRef="clarify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" sourceRef="hrGw" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="clarify" targetRef="join" />

    <bpmn:sequenceFlow id="f10" sourceRef="corrGw" targetRef="askCorr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="askCorr" targetRef="receiveCorr" />
    <bpmn:sequenceFlow id="f12" sourceRef="receiveCorr" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="corrGw" targetRef="join" />
    <bpmn:sequenceFlow id="f14" sourceRef="join" targetRef="approve" />
    <bpmn:sequenceFlow id="f15" sourceRef="approve" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
