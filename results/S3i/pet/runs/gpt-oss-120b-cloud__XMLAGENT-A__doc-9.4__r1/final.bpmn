<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">

  <!-- Collaboration with a single pool representing the organisation -->
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>

  <!-- Process -->
  <bpmn:process id="PROCESS" isExecutable="false">

    <!-- Lanes -->
    <bpmn:laneSet id="LANESET_ORG">
      <bpmn:lane id="LANE_COORD" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_DatesFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QACheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SUPPORT" name="Support Officer">
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_COMMITTEE" name="Committee Members">
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="Start_DatesFinalized" name="Dates finalized" />
    
    <!-- Support Officer tasks -->
    <bpmn:task id="Task_UpdateCalendars" name="Update group calendars" />
    <bpmn:task id="Task_CreateFolders" name="Create meeting folders" />
    <bpmn:task id="Task_UploadDocuments" name="Upload documents to system" />
    <bpmn:task id="Task_AdviseMembers" name="Advise Committee Members to read documents" />
    <bpmn:task id="Task_ProduceMinutes" name="Produce minutes with Action Points" />
    <bpmn:task id="Task_UpdateRecords" name="Update departmental records" />

    <!-- Committee Member task -->
    <bpmn:task id="Task_HoldMeeting" name="Hold meeting" />

    <!-- Coordination Unit tasks -->
    <bpmn:task id="Task_QACheck" name="Conduct QA check on minutes" />
    <bpmn:task id="Task_SendMinutes" name="Send minutes to Committee Members" />

    <bpmn:endEvent id="End_ProcessCompleted" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="Start_DatesFinalized" targetRef="Task_UpdateCalendars" />
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateFolders" />
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_CreateFolders" targetRef="Task_UploadDocuments" />
    <bpmn:sequenceFlow id="flow4" sourceRef="Task_UploadDocuments" targetRef="Task_AdviseMembers" />
    <bpmn:sequenceFlow id="flow5" sourceRef="Task_AdviseMembers" targetRef="Task_HoldMeeting" />
    <bpmn:sequenceFlow id="flow6" sourceRef="Task_HoldMeeting" targetRef="Task_ProduceMinutes" />
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheck" />
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_QACheck" targetRef="Task_SendMinutes" />
    <bpmn:sequenceFlow id="flow9" sourceRef="Task_SendMinutes" targetRef="Task_UpdateRecords" />
    <bpmn:sequenceFlow id="flow10" sourceRef="Task_UpdateRecords" targetRef="End_ProcessCompleted" />

  </bpmn:process>
</bpmn:definitions>
