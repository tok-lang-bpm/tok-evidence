<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Small Company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_SALES" name="Sales Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_inform_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informEng</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_STORE" name="Storehouse">
        <bpmn:flowNodeRef>processParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_part</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ENG" name="Engineering Department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_storehouse_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Receive order" />
    <bpmn:task id="review" name="Review order" />
    <bpmn:exclusiveGateway id="gw_decide" name="Order accepted?" />
    <bpmn:endEvent id="rejectedEnd" name="Order rejected" />
    <bpmn:parallelGateway id="gw_inform_split" />
    <bpmn:task id="informStore" name="Inform storehouse" />
    <bpmn:task id="informEng" name="Inform engineering department" />
    <bpmn:task id="processParts" name="Process part list" />
    <bpmn:exclusiveGateway id="gw_part" name="Part available?" />
    <bpmn:task id="reserve" name="Reserve part" />
    <bpmn:task id="backorder" name="Back-order part" />
    <bpmn:parallelGateway id="gw_storehouse_join" />
    <bpmn:task id="prepare" name="Prepare assembly" />
    <bpmn:task id="assemble" name="Assemble bicycle" />
    <bpmn:task id="ship" name="Ship bicycle" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="f2" sourceRef="review" targetRef="gw_decide" />
    <bpmn:sequenceFlow id="f3" name="no" sourceRef="gw_decide" targetRef="rejectedEnd" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gw_decide" targetRef="gw_inform_split" />
    <bpmn:sequenceFlow id="f5" sourceRef="gw_inform_split" targetRef="informStore" />
    <bpmn:sequenceFlow id="f6" sourceRef="gw_inform_split" targetRef="informEng" />
    <bpmn:sequenceFlow id="f7" sourceRef="informStore" targetRef="processParts" />
    <bpmn:sequenceFlow id="f8" sourceRef="processParts" targetRef="gw_part" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gw_part" targetRef="reserve" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gw_part" targetRef="backorder" />
    <bpmn:sequenceFlow id="f11" sourceRef="reserve" targetRef="gw_storehouse_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="backorder" targetRef="gw_storehouse_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="informEng" targetRef="prepare" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepare" targetRef="gw_storehouse_join" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_storehouse_join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f16" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f17" sourceRef="ship" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
