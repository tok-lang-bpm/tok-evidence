<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="The Evanstonian" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MANAGER" name="Room-service Manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>managerTakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveOrderSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignWaiter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_KITCHEN" name="Kitchen">
        <bpmn:flowNodeRef>prepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SOMMELIER" name="Sommelier">
        <bpmn:flowNodeRef>fetchWine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_WAITER" name="Waiter">
        <bpmn:flowNodeRef>readyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Room service request received" />
    <bpmn:task id="managerTakeOrder" name="Take down the order" />
    <bpmn:task id="submitTicket" name="Submit order ticket to kitchen" />
    <bpmn:task id="giveOrderSommelier" name="Give order to sommelier" />
    <bpmn:task id="assignWaiter" name="Assign order to waiter" />
    <bpmn:parallelGateway id="fork1" name="Parallel start" />
    <bpmn:task id="prepareFood" name="Prepare food" />
    <bpmn:task id="readyCart" name="Ready cart and prepare non‑alcoholic drinks" />
    <bpmn:exclusiveGateway id="alcoholDec" name="Alcoholic beverage required?" />
    <bpmn:task id="fetchWine" name="Fetch wine and prepare alcoholic beverages" />
    <bpmn:parallelGateway id="join1" name="Parallel join" />
    <bpmn:task id="deliver" name="Deliver food and drinks to guest's room" />
    <bpmn:task id="return" name="Return to room‑service station" />
    <bpmn:task id="debit" name="Debit guest's account" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="managerTakeOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="managerTakeOrder" targetRef="submitTicket" />
    <bpmn:sequenceFlow id="f3" sourceRef="submitTicket" targetRef="giveOrderSommelier" />
    <bpmn:sequenceFlow id="f4" sourceRef="giveOrderSommelier" targetRef="assignWaiter" />
    <bpmn:sequenceFlow id="f5" sourceRef="assignWaiter" targetRef="fork1" />
    <bpmn:sequenceFlow id="f6" sourceRef="fork1" targetRef="prepareFood" />
    <bpmn:sequenceFlow id="f7" sourceRef="fork1" targetRef="readyCart" />
    <bpmn:sequenceFlow id="f8" sourceRef="fork1" targetRef="alcoholDec" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="alcoholDec" targetRef="fetchWine" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="alcoholDec" targetRef="join1" />
    <bpmn:sequenceFlow id="f11" sourceRef="fetchWine" targetRef="join1" />
    <bpmn:sequenceFlow id="f12" sourceRef="prepareFood" targetRef="join1" />
    <bpmn:sequenceFlow id="f13" sourceRef="readyCart" targetRef="join1" />
    <bpmn:sequenceFlow id="f14" sourceRef="join1" targetRef="deliver" />
    <bpmn:sequenceFlow id="f15" sourceRef="deliver" targetRef="return" />
    <bpmn:sequenceFlow id="f16" sourceRef="return" targetRef="debit" />
    <bpmn:sequenceFlow id="f17" sourceRef="debit" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>