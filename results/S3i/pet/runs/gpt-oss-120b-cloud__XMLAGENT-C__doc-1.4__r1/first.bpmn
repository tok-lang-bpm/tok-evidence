<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select_underwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_handled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_underwriters" name="Underwriters">
        <bpmn:flowNodeRef>gw_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide_advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_blue_sky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_parallel_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>road_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg_parallel_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commitment_buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer_public</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_not_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_offered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Decision to go public" />
    <bpmn:task id="select_underwriters" name="Select the underwriters" />
    <bpmn:exclusiveGateway id="gw_handle" name="Facts presented fairly?" />
    <bpmn:task id="provide_advice" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare_registration" name="Prepare registration statement for SEC approval" />
    <bpmn:task id="check_blue_sky" name="Check compliance with blue‑sky laws" />
    <bpmn:parallelGateway id="pg_parallel_start" />
    <bpmn:task id="firm_price" name="Firm up the issue price" />
    <bpmn:task id="road_show" name="Arrange a road show for potential investors" />
    <bpmn:parallelGateway id="pg_parallel_end" />
    <bpmn:exclusiveGateway id="gw_sec" name="SEC clearance?" />
    <bpmn:task id="fix_price" name="Fix the issue price" />
    <bpmn:task id="commitment_buy" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="buy_issue" name="Buy the issue" />
    <bpmn:task id="offer_public" name="Offer the issue to the public" />
    <bpmn:endEvent id="end_not_handled" name="Underwriters do not handle the issue" />
    <bpmn:endEvent id="end_not_approved" name="SEC does not approve" />
    <bpmn:endEvent id="end_offered" name="Issue offered to public" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="select_underwriters" />
    <bpmn:sequenceFlow id="f2" sourceRef="select_underwriters" targetRef="gw_handle" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gw_handle" targetRef="provide_advice" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gw_handle" targetRef="end_not_handled" />
    <bpmn:sequenceFlow id="f5" sourceRef="provide_advice" targetRef="prepare_registration" />
    <bpmn:sequenceFlow id="f6" sourceRef="prepare_registration" targetRef="check_blue_sky" />
    <bpmn:sequenceFlow id="f7" sourceRef="check_blue_sky" targetRef="pg_parallel_start" />
    <bpmn:sequenceFlow id="f8" sourceRef="pg_parallel_start" targetRef="firm_price" />
    <bpmn:sequenceFlow id="f9" sourceRef="pg_parallel_start" targetRef="road_show" />
    <bpmn:sequenceFlow id="f10" sourceRef="firm_price" targetRef="pg_parallel_end" />
    <bpmn:sequenceFlow id="f11" sourceRef="road_show" targetRef="pg_parallel_end" />
    <bpmn:sequenceFlow id="f12" sourceRef="pg_parallel_end" targetRef="gw_sec" />
    <bpmn:sequenceFlow id="f13" name="approved" sourceRef="gw_sec" targetRef="fix_price" />
    <bpmn:sequenceFlow id="f14" name="rejected" sourceRef="gw_sec" targetRef="end_not_approved" />
    <bpmn:sequenceFlow id="f15" sourceRef="fix_price" targetRef="commitment_buy" />
    <bpmn:sequenceFlow id="f16" sourceRef="commitment_buy" targetRef="buy_issue" />
    <bpmn:sequenceFlow id="f17" sourceRef="buy_issue" targetRef="offer_public" />
    <bpmn:sequenceFlow id="f18" sourceRef="offer_public" targetRef="end_offered" />
  </bpmn:process>
</bpmn:definitions>