<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneGO" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskProcessValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskSendChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskTransmitReadings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMSP" name="MSP">
        <bpmn:flowNodeRef>taskCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskInformFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskPerformMeasurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskTransmitValues</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="taskRequest" name="Requests the measurements to the MSP" />
    <bpmn:task id="taskCheck" name="Checks the received request" />
    <bpmn:exclusiveGateway id="gatewayDecision" name="Request denied?" />
    <bpmn:task id="taskInformFailure" name="Informs the GO about the failure of the reading" />
    <bpmn:endEvent id="endFailure" name="Process ends after failure" />
    <bpmn:task id="taskPerformMeasurement" name="Performs the measurement" />
    <bpmn:task id="taskTransmitValues" name="Transmits the measured values to the GO" />
    <bpmn:task id="taskProcessValues" name="Processes the measured values" />
    <bpmn:task id="taskSendChanged" name="Sends the changed values to the MSP" />
    <bpmn:task id="taskTransmitReadings" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="endSuccess" name="Process ends after success" />
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="taskRequest" />
    <bpmn:sequenceFlow id="flow2" sourceRef="taskRequest" targetRef="taskCheck" />
    <bpmn:sequenceFlow id="flow3" sourceRef="taskCheck" targetRef="gatewayDecision" />
    <bpmn:sequenceFlow id="flow4" name="deny" sourceRef="gatewayDecision" targetRef="taskInformFailure" />
    <bpmn:sequenceFlow id="flow5" name="accept" sourceRef="gatewayDecision" targetRef="taskPerformMeasurement" />
    <bpmn:sequenceFlow id="flow6" sourceRef="taskInformFailure" targetRef="endFailure" />
    <bpmn:sequenceFlow id="flow7" sourceRef="taskPerformMeasurement" targetRef="taskTransmitValues" />
    <bpmn:sequenceFlow id="flow8" sourceRef="taskTransmitValues" targetRef="taskProcessValues" />
    <bpmn:sequenceFlow id="flow9" sourceRef="taskProcessValues" targetRef="taskSendChanged" />
    <bpmn:sequenceFlow id="flow10" sourceRef="taskSendChanged" targetRef="taskTransmitReadings" />
    <bpmn:sequenceFlow id="flow11" sourceRef="taskTransmitReadings" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>
