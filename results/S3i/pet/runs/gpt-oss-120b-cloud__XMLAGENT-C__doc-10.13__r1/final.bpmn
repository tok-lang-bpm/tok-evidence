<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_INQ" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_IP" name="IP">
        <bpmn:flowNodeRef>checkRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTransmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="transmitRequest" name="INQ transmits the transaction data request to the IP" />
    <bpmn:task id="checkRequest" name="IP checks the request of the INQ" />
    <bpmn:exclusiveGateway id="gatewayDecision" name="Outcome of examination" />
    <bpmn:task id="transmitData" name="IP transmits data" />
    <bpmn:task id="rejectRequest" name="IP rejects the request" />
    <bpmn:endEvent id="endTransmit" name="Data transmitted" />
    <bpmn:endEvent id="endReject" name="Request rejected" />

    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="transmitRequest" />
    <bpmn:sequenceFlow id="flow2" sourceRef="transmitRequest" targetRef="checkRequest" />
    <bpmn:sequenceFlow id="flow3" sourceRef="checkRequest" targetRef="gatewayDecision" />
    <bpmn:sequenceFlow id="flow4" name="Transmit data" sourceRef="gatewayDecision" targetRef="transmitData" />
    <bpmn:sequenceFlow id="flow5" name="Reject" sourceRef="gatewayDecision" targetRef="rejectRequest" />
    <bpmn:sequenceFlow id="flow6" sourceRef="transmitData" targetRef="endTransmit" />
    <bpmn:sequenceFlow id="flow7" sourceRef="rejectRequest" targetRef="endReject" />
  </bpmn:process>
</bpmn:definitions>
