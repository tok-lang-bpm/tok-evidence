<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneStart" name="Start">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayStart</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>t1_sendMPOOtempToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4_sendMPOOequipToMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5_sendMPOOequipToGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMSPO" name="MSPO">
        <bpmn:flowNodeRef>t2_sendMSPOtempToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3_sendMSPOaddReadingsToGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneGO" name="GO">
        <bpmn:flowNodeRef>examineGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayDecisionGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmGOtoMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmGOtoMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectGO_MPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectGO_MSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPON" name="MPON">
        <bpmn:flowNodeRef>examineMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayDecisionMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmMPONtoMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmMPONtoMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectMPON_MPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectMPON_MSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="gatewayStart" name="Which bill is sent?" />
    <bpmn:task id="t1_sendMPOOtempToGO" name="MPOO sends the bill for the temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="t2_sendMSPOtempToGO" name="MSPO sends the bill for the temporary continuation of the measurement to the GO" />
    <bpmn:task id="t3_sendMSPOaddReadingsToGO" name="MSPO sends the bill for additional readings to the GO" />
    <bpmn:task id="t4_sendMPOOequipToMPON" name="MPOO sends the bill for the equipment acquisition to the MPON" />
    <bpmn:task id="t5_sendMPOOequipToGO" name="MPOO sends the bill for the equipment acquisition to the GO" />
    <bpmn:task id="examineGO" name="GO examines the bill" />
    <bpmn:task id="examineMPON" name="MPON examines the bill" />
    <bpmn:exclusiveGateway id="gatewayDecisionGO" name="Does GO confirm?" />
    <bpmn:exclusiveGateway id="gatewayDecisionMPON" name="Does MPON confirm?" />
    <bpmn:task id="confirmGOtoMPOO" name="GO confirms the invoice with payment advice to the MPOO" />
    <bpmn:task id="confirmGOtoMSPO" name="GO confirms the invoice with payment advice to the MSPO" />
    <bpmn:task id="confirmMPONtoMPOO" name="MPON confirms the invoice with payment advice to the MPOO" />
    <bpmn:task id="confirmMPONtoMSPO" name="MPON confirms the invoice with payment advice to the MSPO" />
    <bpmn:task id="rejectGO_MPOO" name="GO rejects the invoice of the MPOO" />
    <bpmn:task id="rejectGO_MSPO" name="GO rejects the invoice of the MSPO" />
    <bpmn:task id="rejectMPON_MPOO" name="MPON rejects the invoice of the MPOO" />
    <bpmn:task id="rejectMPON_MSPO" name="MPON rejects the invoice of the MSPO" />
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:endEvent id="end2" name="End" />
    <bpmn:endEvent id="end3" name="End" />
    <bpmn:endEvent id="end4" name="End" />
    <bpmn:endEvent id="end5" name="End" />
    <bpmn:endEvent id="end6" name="End" />
    <bpmn:endEvent id="end7" name="End" />
    <bpmn:endEvent id="end8" name="End" />
    <bpmn:sequenceFlow id="sf_start" sourceRef="start" targetRef="gatewayStart" />
    <bpmn:sequenceFlow id="sf1" sourceRef="gatewayStart" targetRef="t1_sendMPOOtempToGO" name="temp continuation (MPOO)" />
    <bpmn:sequenceFlow id="sf2" sourceRef="gatewayStart" targetRef="t2_sendMSPOtempToGO" name="temp continuation (MSPO)" />
    <bpmn:sequenceFlow id="sf3" sourceRef="gatewayStart" targetRef="t3_sendMSPOaddReadingsToGO" name="additional readings (MSPO)" />
    <bpmn:sequenceFlow id="sf4" sourceRef="gatewayStart" targetRef="t4_sendMPOOequipToMPON" name="equipment acquisition to MPON" />
    <bpmn:sequenceFlow id="sf5" sourceRef="gatewayStart" targetRef="t5_sendMPOOequipToGO" name="equipment acquisition to GO" />
    <bpmn:sequenceFlow id="sf6" sourceRef="t1_sendMPOOtempToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="sf7" sourceRef="t2_sendMSPOtempToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="sf8" sourceRef="t3_sendMSPOaddReadingsToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="sf9" sourceRef="t5_sendMPOOequipToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="sf10" sourceRef="t4_sendMPOOequipToMPON" targetRef="examineMPON" />
    <bpmn:sequenceFlow id="sf11" sourceRef="examineGO" targetRef="gatewayDecisionGO" />
    <bpmn:sequenceFlow id="sf12" sourceRef="examineMPON" targetRef="gatewayDecisionMPON" />
    <bpmn:sequenceFlow id="sf13_confirmGO_MPOO" name="confirm" sourceRef="gatewayDecisionGO" targetRef="confirmGOtoMPOO" />
    <bpmn:sequenceFlow id="sf14_confirmGO_MSPO" name="confirm" sourceRef="gatewayDecisionGO" targetRef="confirmGOtoMSPO" />
    <bpmn:sequenceFlow id="sf15_rejectGO_MPOO" name="reject" sourceRef="gatewayDecisionGO" targetRef="rejectGO_MPOO" />
    <bpmn:sequenceFlow id="sf16_rejectGO_MSPO" name="reject" sourceRef="gatewayDecisionGO" targetRef="rejectGO_MSPO" />
    <bpmn:sequenceFlow id="sf17_confirmMPON_MPOO" name="confirm" sourceRef="gatewayDecisionMPON" targetRef="confirmMPONtoMPOO" />
    <bpmn:sequenceFlow id="sf18_confirmMPON_MSPO" name="confirm" sourceRef="gatewayDecisionMPON" targetRef="confirmMPONtoMSPO" />
    <bpmn:sequenceFlow id="sf19_rejectMPON_MPOO" name="reject" sourceRef="gatewayDecisionMPON" targetRef="rejectMPON_MPOO" />
    <bpmn:sequenceFlow id="sf20_rejectMPON_MSPO" name="reject" sourceRef="gatewayDecisionMPON" targetRef="rejectMPON_MSPO" />
    <bpmn:sequenceFlow id="sf21" sourceRef="confirmGOtoMPOO" targetRef="end1" />
    <bpmn:sequenceFlow id="sf22" sourceRef="confirmGOtoMSPO" targetRef="end2" />
    <bpmn:sequenceFlow id="sf23" sourceRef="rejectGO_MPOO" targetRef="end3" />
    <bpmn:sequenceFlow id="sf24" sourceRef="rejectGO_MSPO" targetRef="end4" />
    <bpmn:sequenceFlow id="sf25" sourceRef="confirmMPONtoMPOO" targetRef="end5" />
    <bpmn:sequenceFlow id="sf26" sourceRef="confirmMPONtoMSPO" targetRef="end6" />
    <bpmn:sequenceFlow id="sf27" sourceRef="rejectMPON_MPOO" targetRef="end7" />
    <bpmn:sequenceFlow id="sf28" sourceRef="rejectMPON_MSPO" targetRef="end8" />
  </bpmn:process>
</bpmn:definitions>
