<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>t1_sendMPOOtempToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4_sendMPOOequipToMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5_sendMPOOequipToGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMSPO" name="MSPO">
        <bpmn:flowNodeRef>t2_sendMSPOtempToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3_sendMSPOaddReadingsToGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneGO" name="GO">
        <bpmn:flowNodeRef>examineGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayDecisionGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmGOtoMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmGOtoMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectGO_MPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectGO_MSPO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPON" name="MPON">
        <bpmn:flowNodeRef>examineMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayDecisionMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmMPONtoMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmMPONtoMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectMPON_MPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectMPON_MSPO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <!-- Send tasks -->
    <bpmn:task id="t1_sendMPOOtempToGO" name="MPOO sends the bill for the temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="t2_sendMSPOtempToGO" name="MSPO sends the bill for the temporary continuation of the measurement to the GO" />
    <bpmn:task id="t3_sendMSPOaddReadingsToGO" name="MSPO sends the bill for additional readings to the GO" />
    <bpmn:task id="t4_sendMPOOequipToMPON" name="MPOO sends the bill for the equipment acquisition to the MPON" />
    <bpmn:task id="t5_sendMPOOequipToGO" name="MPOO sends the bill for the equipment acquisition to the GO" />
    <!-- Examination tasks -->
    <bpmn:task id="examineGO" name="GO examines the bill" />
    <bpmn:task id="examineMPON" name="MPON examines the bill" />
    <!-- Decision gateways after examination -->
    <bpmn:exclusiveGateway id="gatewayDecisionGO" name="GO decision" />
    <bpmn:exclusiveGateway id="gatewayDecisionMPON" name="MPON decision" />
    <!-- Confirmation and rejection tasks -->
    <bpmn:task id="confirmGOtoMPOO" name="GO confirms the invoice with payment advice to the MPOO" />
    <bpmn:task id="confirmGOtoMSPO" name="GO confirms the invoice with payment advice to the MSPO" />
    <bpmn:task id="confirmMPONtoMPOO" name="MPON confirms the invoice with payment advice to the MPOO" />
    <bpmn:task id="confirmMPONtoMSPO" name="MPON confirms the invoice with payment advice to the MSPO" />
    <bpmn:task id="rejectGO_MPOO" name="GO rejects the invoice of the MPOO" />
    <bpmn:task id="rejectGO_MSPO" name="GO rejects the invoice of the MSPO" />
    <bpmn:task id="rejectMPON_MPOO" name="MPON rejects the invoice of the MPOO" />
    <bpmn:task id="rejectMPON_MSPO" name="MPON rejects the invoice of the MSPO" />
    <!-- End events -->
    <bpmn:endEvent id="end1" name="End" />
    <bpmn:endEvent id="end2" name="End" />
    <bpmn:endEvent id="end3" name="End" />
    <bpmn:endEvent id="end4" name="End" />
    <bpmn:endEvent id="end5" name="End" />
    <bpmn:endEvent id="end6" name="End" />
    <bpmn:endEvent id="end7" name="End" />
    <bpmn:endEvent id="end8" name="End" />
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f_start_to_t1" sourceRef="start" targetRef="t1_sendMPOOtempToGO" />
    <bpmn:sequenceFlow id="f_start_to_t2" sourceRef="start" targetRef="t2_sendMSPOtempToGO" />
    <bpmn:sequenceFlow id="f_start_to_t3" sourceRef="start" targetRef="t3_sendMSPOaddReadingsToGO" />
    <bpmn:sequenceFlow id="f_start_to_t4" sourceRef="start" targetRef="t4_sendMPOOequipToMPON" />
    <bpmn:sequenceFlow id="f_start_to_t5" sourceRef="start" targetRef="t5_sendMPOOequipToGO" />
    <!-- Paths to GO examination -->
    <bpmn:sequenceFlow id="f1" sourceRef="t1_sendMPOOtempToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="f2" sourceRef="t2_sendMSPOtempToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="f3" sourceRef="t3_sendMSPOaddReadingsToGO" targetRef="examineGO" />
    <bpmn:sequenceFlow id="f5" sourceRef="t5_sendMPOOequipToGO" targetRef="examineGO" />
    <!-- Path to MPON examination -->
    <bpmn:sequenceFlow id="f4" sourceRef="t4_sendMPOOequipToMPON" targetRef="examineMPON" />
    <!-- Decision after GO examination -->
    <bpmn:sequenceFlow id="f6" sourceRef="examineGO" targetRef="gatewayDecisionGO" />
    <bpmn:sequenceFlow id="f7_confirmGO_MPOO" name="confirm" sourceRef="gatewayDecisionGO" targetRef="confirmGOtoMPOO" />
    <bpmn:sequenceFlow id="f8_confirmGO_MSPO" name="confirm" sourceRef="gatewayDecisionGO" targetRef="confirmGOtoMSPO" />
    <bpmn:sequenceFlow id="f9_rejectGO_MPOO" name="reject" sourceRef="gatewayDecisionGO" targetRef="rejectGO_MPOO" />
    <bpmn:sequenceFlow id="f10_rejectGO_MSPO" name="reject" sourceRef="gatewayDecisionGO" targetRef="rejectGO_MSPO" />
    <!-- Decision after MPON examination -->
    <bpmn:sequenceFlow id="f11" sourceRef="examineMPON" targetRef="gatewayDecisionMPON" />
    <bpmn:sequenceFlow id="f12_confirmMPON_MPOO" name="confirm" sourceRef="gatewayDecisionMPON" targetRef="confirmMPONtoMPOO" />
    <bpmn:sequenceFlow id="f13_confirmMPON_MSPO" name="confirm" sourceRef="gatewayDecisionMPON" targetRef="confirmMPONtoMSPO" />
    <bpmn:sequenceFlow id="f14_rejectMPON_MPOO" name="reject" sourceRef="gatewayDecisionMPON" targetRef="rejectMPON_MPOO" />
    <bpmn:sequenceFlow id="f15_rejectMPON_MSPO" name="reject" sourceRef="gatewayDecisionMPON" targetRef="rejectMPON_MSPO" />
    <!-- End flows -->
    <bpmn:sequenceFlow id="f_end1" sourceRef="confirmGOtoMPOO" targetRef="end1" />
    <bpmn:sequenceFlow id="f_end2" sourceRef="confirmGOtoMSPO" targetRef="end2" />
    <bpmn:sequenceFlow id="f_end3" sourceRef="rejectGO_MPOO" targetRef="end3" />
    <bpmn:sequenceFlow id="f_end4" sourceRef="rejectGO_MSPO" targetRef="end4" />
    <bpmn:sequenceFlow id="f_end5" sourceRef="confirmMPONtoMPOO" targetRef="end5" />
    <bpmn:sequenceFlow id="f_end6" sourceRef="confirmMPONtoMSPO" targetRef="end6" />
    <bpmn:sequenceFlow id="f_end7" sourceRef="rejectMPON_MPOO" targetRef="end7" />
    <bpmn:sequenceFlow id="f_end8" sourceRef="rejectMPON_MSPO" targetRef="end8" />
  </bpmn:process>
</bpmn:definitions>