<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MPN" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPOO" name="MPOO">
        <bpmn:flowNodeRef>reviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposeDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="sendDismissal" name="MPON sends the dismissal to the MPOO" />
    <bpmn:task id="reviewDismissal" name="MPOO reviews the dismissal" />
    <bpmn:exclusiveGateway id="decision" name="Dismissal opposed or confirmed?" />
    <bpmn:task id="opposeDismissal" name="MPOO opposes the dismissal of MPON" />
    <bpmn:task id="confirmDismissal" name="MPOO confirms the dismissal of the MPON" />
    <bpmn:endEvent id="endOppose" name="Opposition end" />
    <bpmn:endEvent id="endConfirm" name="Confirmation end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendDismissal" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendDismissal" targetRef="reviewDismissal" />
    <bpmn:sequenceFlow id="f3" sourceRef="reviewDismissal" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="oppose" sourceRef="decision" targetRef="opposeDismissal" />
    <bpmn:sequenceFlow id="f5" name="confirm" sourceRef="decision" targetRef="confirmDismissal" />
    <bpmn:sequenceFlow id="f6" sourceRef="opposeDismissal" targetRef="endOppose" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirmDismissal" targetRef="endConfirm" />
  </bpmn:process>
</bpmn:definitions>
