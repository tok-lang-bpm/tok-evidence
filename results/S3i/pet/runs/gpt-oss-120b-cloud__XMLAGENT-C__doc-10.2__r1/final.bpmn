<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_timeout_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_inform_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_equip_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign_mpon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_outcome_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_parallel_failure_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout_inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpoo" name="MPOO">
        <bpmn:flowNodeRef>perform_mpoo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mspo" name="MSPO">
        <!-- No dedicated tasks; communications are performed by GO -->
      </bpmn:lane>
      <bpmn:lane id="lane_sp" name="SP">
        <!-- No dedicated tasks; communications are performed by GO -->
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="gateway_decision" name="Application decision" />
    <bpmn:task id="reject_app" name="Reject the application of the MPON" />
    <bpmn:task id="confirm_app" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="gateway_parallel_inform" />
    <bpmn:task id="inform_mpoo_reg" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="inform_mspo_reg" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="gateway_parallel_inform_join" />
    <bpmn:parallelGateway id="gateway_parallel_equip" />
    <bpmn:task id="perform_mpon" name="Perform equipment acquisition and/or equipment changes" />
    <bpmn:task id="perform_mpoo" name="Perform equipment acquisition and/or equipment changes" />
    <bpmn:parallelGateway id="gateway_parallel_equip_join" />
    <bpmn:exclusiveGateway id="gateway_outcome" name="Outcome decision" />
    <bpmn:task id="inform_success" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="inform_failure" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="receive_timeout_failure" name="Receive timeout failure notification" />
    <bpmn:task id="assign_mpon" name="Assign the MPON" />
    <bpmn:task id="confirm_assignment" name="Confirm the assignment to the MPON" />
    <bpmn:parallelGateway id="gateway_parallel_outcome" />
    <bpmn:task id="inform_mpoo_assign" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="inform_mspo_assign" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="inform_sp_assign" name="Inform the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="gateway_parallel_outcome_join" />
    <bpmn:endEvent id="end_success" name="Process successful end" />
    <bpmn:task id="confirm_failure" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:parallelGateway id="gateway_parallel_failure" />
    <bpmn:task id="inform_mpoo_failure" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="inform_mspo_failure" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:parallelGateway id="gateway_parallel_failure_join" />
    <bpmn:task id="timeout_inform" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="end_failure" name="Process failure end" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="sf1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="sf2" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="sf3" sourceRef="examine" targetRef="gateway_decision" />
    <bpmn:sequenceFlow id="sf4" name="reject" sourceRef="gateway_decision" targetRef="reject_app" />
    <bpmn:sequenceFlow id="sf5" name="confirm" sourceRef="gateway_decision" targetRef="confirm_app" />
    <bpmn:sequenceFlow id="sf6" sourceRef="reject_app" targetRef="end_failure" />
    <bpmn:sequenceFlow id="sf7" sourceRef="confirm_app" targetRef="gateway_parallel_inform" />
    <bpmn:sequenceFlow id="sf8" sourceRef="gateway_parallel_inform" targetRef="inform_mpoo_reg" />
    <bpmn:sequenceFlow id="sf9" sourceRef="gateway_parallel_inform" targetRef="inform_mspo_reg" />
    <bpmn:sequenceFlow id="sf10" sourceRef="inform_mpoo_reg" targetRef="gateway_parallel_inform_join" />
    <bpmn:sequenceFlow id="sf11" sourceRef="inform_mspo_reg" targetRef="gateway_parallel_inform_join" />
    <bpmn:sequenceFlow id="sf12" sourceRef="gateway_parallel_inform_join" targetRef="gateway_parallel_equip" />
    <bpmn:sequenceFlow id="sf13" sourceRef="gateway_parallel_equip" targetRef="perform_mpon" />
    <bpmn:sequenceFlow id="sf14" sourceRef="gateway_parallel_equip" targetRef="perform_mpoo" />
    <bpmn:sequenceFlow id="sf15" sourceRef="perform_mpon" targetRef="gateway_parallel_equip_join" />
    <bpmn:sequenceFlow id="sf16" sourceRef="perform_mpoo" targetRef="gateway_parallel_equip_join" />
    <bpmn:sequenceFlow id="sf17" sourceRef="gateway_parallel_equip_join" targetRef="gateway_outcome" />
    <bpmn:sequenceFlow id="sf18" name="success" sourceRef="gateway_outcome" targetRef="inform_success" />
    <bpmn:sequenceFlow id="sf19" name="failure" sourceRef="gateway_outcome" targetRef="inform_failure" />
    <bpmn:sequenceFlow id="sf20" name="timeout" sourceRef="gateway_outcome" targetRef="receive_timeout_failure" />
    <bpmn:sequenceFlow id="sf21" sourceRef="inform_success" targetRef="assign_mpon" />
    <bpmn:sequenceFlow id="sf22" sourceRef="assign_mpon" targetRef="confirm_assignment" />
    <bpmn:sequenceFlow id="sf23" sourceRef="confirm_assignment" targetRef="gateway_parallel_outcome" />
    <bpmn:sequenceFlow id="sf24" sourceRef="gateway_parallel_outcome" targetRef="inform_mpoo_assign" />
    <bpmn:sequenceFlow id="sf25" sourceRef="gateway_parallel_outcome" targetRef="inform_mspo_assign" />
    <bpmn:sequenceFlow id="sf26" sourceRef="gateway_parallel_outcome" targetRef="inform_sp_assign" />
    <bpmn:sequenceFlow id="sf27" sourceRef="inform_mpoo_assign" targetRef="gateway_parallel_outcome_join" />
    <bpmn:sequenceFlow id="sf28" sourceRef="inform_mspo_assign" targetRef="gateway_parallel_outcome_join" />
    <bpmn:sequenceFlow id="sf29" sourceRef="inform_sp_assign" targetRef="gateway_parallel_outcome_join" />
    <bpmn:sequenceFlow id="sf30" sourceRef="gateway_parallel_outcome_join" targetRef="end_success" />
    <bpmn:sequenceFlow id="sf31" sourceRef="inform_failure" targetRef="confirm_failure" />
    <bpmn:sequenceFlow id="sf32" sourceRef="receive_timeout_failure" targetRef="timeout_inform" />
    <bpmn:sequenceFlow id="sf33" sourceRef="timeout_inform" targetRef="confirm_failure" />
    <bpmn:sequenceFlow id="sf34" sourceRef="confirm_failure" targetRef="gateway_parallel_failure" />
    <bpmn:sequenceFlow id="sf35" sourceRef="gateway_parallel_failure" targetRef="inform_mpoo_failure" />
    <bpmn:sequenceFlow id="sf36" sourceRef="gateway_parallel_failure" targetRef="inform_mspo_failure" />
    <bpmn:sequenceFlow id="sf37" sourceRef="inform_mpoo_failure" targetRef="gateway_parallel_failure_join" />
    <bpmn:sequenceFlow id="sf38" sourceRef="inform_mspo_failure" targetRef="gateway_parallel_failure_join" />
    <bpmn:sequenceFlow id="sf39" sourceRef="gateway_parallel_failure_join" targetRef="end_failure" />
  </bpmn:process>
</bpmn:definitions>
