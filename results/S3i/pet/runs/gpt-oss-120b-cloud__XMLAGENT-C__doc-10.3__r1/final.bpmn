<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneGO" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>egMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pgJoin2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t1" name="MPOO deregisters at the GO" />
    <bpmn:task id="t2" name="GO verifies the deregistration" />
    <bpmn:exclusiveGateway id="g1" name="Reject or preliminarily confirm?" />
    <bpmn:endEvent id="endReject" name="Deregistration rejected" />
    <bpmn:task id="t3" name="GO prepares the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="g2" name="Oblige continuation?" />
    <bpmn:task id="t4" name="MPOO confirms the continuation" />
    <bpmn:exclusiveGateway id="egMerge" name="Optional continuation merge" />
    <bpmn:parallelGateway id="pgSplit" name="Equipment activities split" />
    <bpmn:task id="t5" name="GO performs equipment acquisition" />
    <bpmn:task id="t6" name="GO performs equipment changes" />
    <bpmn:parallelGateway id="pgJoin2" name="Equipment activities join" />
    <bpmn:task id="t7" name="GO assigns the GO as MPO" />
    <bpmn:task id="t8" name="GO informs the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="t9" name="GO informs the MSPO about the assignment of the GO" />
    <bpmn:task id="t10" name="GO informs the SP about the assignment of the GO" />
    <bpmn:endEvent id="end" name="Process completed" />
    <bpmn:sequenceFlow id="f_start_t1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f1_t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f2_g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f_g1_reject" name="reject" sourceRef="g1" targetRef="endReject" />
    <bpmn:sequenceFlow id="f_g1_confirm" name="confirm" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f3_g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f_g2_yes" name="oblige" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="f_g2_no" name="no oblige" sourceRef="g2" targetRef="egMerge" />
    <bpmn:sequenceFlow id="f4_continue" sourceRef="t4" targetRef="egMerge" />
    <bpmn:sequenceFlow id="f5_to_split" sourceRef="egMerge" targetRef="pgSplit" />
    <bpmn:sequenceFlow id="f6_acq" sourceRef="pgSplit" targetRef="t5" />
    <bpmn:sequenceFlow id="f7_change" sourceRef="pgSplit" targetRef="t6" />
    <bpmn:sequenceFlow id="f8_join2" sourceRef="t5" targetRef="pgJoin2" />
    <bpmn:sequenceFlow id="f9_join2" sourceRef="t6" targetRef="pgJoin2" />
    <bpmn:sequenceFlow id="f10_assign" sourceRef="pgJoin2" targetRef="t7" />
    <bpmn:sequenceFlow id="f11_informMPOO" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f12_informMSPO" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f13_informSP" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f14_end" sourceRef="t10" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
