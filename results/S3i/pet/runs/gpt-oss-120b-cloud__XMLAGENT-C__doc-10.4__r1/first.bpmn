<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="laneMPON" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalReadingMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountOldMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mountNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMPOO" name="MPOO">
        <bpmn:flowNodeRef>announceSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyNoSelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalReadingMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismountOldMPOO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneGO" name="GO">
        <bpmn:flowNodeRef>notifyMSP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneMSP" name="MSP" />
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="notifyMPOO" name="MPON notifies MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="gwSelf" name="Self dismounting?" />
    <bpmn:task id="announceSelf" name="MPOO announces self dismounting to MPON" />
    <bpmn:task id="notifyNoSelf" name="MPOO notifies MPON about no self-dismounting" />
    <bpmn:exclusiveGateway id="gwFinalReading" name="Who performs final reading?" />
    <bpmn:task id="finalReadingMPON" name="MPON performs the final reading" />
    <bpmn:task id="finalReadingMPOO" name="MPOO performs the final reading" />
    <bpmn:exclusiveGateway id="gwDismount" name="Who dismounts old equipment?" />
    <bpmn:task id="dismountOldMPON" name="MPON dismounts the old equipment" />
    <bpmn:task id="dismountOldMPOO" name="MPOO dismounts the old equipment" />
    <bpmn:task id="mountNew" name="MPON mounts the new device" />
    <bpmn:task id="readMeter" name="MPON reads the meter count from the installed meter" />
    <bpmn:task id="sendValues" name="MPON sends the values of the final reading to GO" />
    <bpmn:task id="tellGO" name="MPON tells GO about device changes, master data and meter count at installation" />
    <bpmn:task id="notifyMSP" name="GO notifies MSP about device changes, master data, meter count at dismounting and installation" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="notifyMPOO" />
    <bpmn:sequenceFlow id="f2" sourceRef="notifyMPOO" targetRef="gwSelf" />
    <bpmn:sequenceFlow id="f3" sourceRef="gwSelf" targetRef="announceSelf" name="yes" />
    <bpmn:sequenceFlow id="f4" sourceRef="gwSelf" targetRef="notifyNoSelf" name="no" />
    <bpmn:sequenceFlow id="f5" sourceRef="announceSelf" targetRef="gwFinalReading" />
    <bpmn:sequenceFlow id="f6" sourceRef="notifyNoSelf" targetRef="gwFinalReading" />
    <bpmn:sequenceFlow id="f7" sourceRef="gwFinalReading" targetRef="finalReadingMPON" name="MPON" />
    <bpmn:sequenceFlow id="f8" sourceRef="gwFinalReading" targetRef="finalReadingMPOO" name="MPOO" />
    <bpmn:sequenceFlow id="f9" sourceRef="finalReadingMPON" targetRef="gwDismount" />
    <bpmn:sequenceFlow id="f10" sourceRef="finalReadingMPOO" targetRef="gwDismount" />
    <bpmn:sequenceFlow id="f11" sourceRef="gwDismount" targetRef="dismountOldMPON" name="MPON" />
    <bpmn:sequenceFlow id="f12" sourceRef="gwDismount" targetRef="dismountOldMPOO" name="MPOO" />
    <bpmn:sequenceFlow id="f13" sourceRef="dismountOldMPON" targetRef="mountNew" />
    <bpmn:sequenceFlow id="f14" sourceRef="dismountOldMPOO" targetRef="mountNew" />
    <bpmn:sequenceFlow id="f15" sourceRef="mountNew" targetRef="readMeter" />
    <bpmn:sequenceFlow id="f16" sourceRef="readMeter" targetRef="sendValues" />
    <bpmn:sequenceFlow id="f17" sourceRef="sendValues" targetRef="tellGO" />
    <bpmn:sequenceFlow id="f18" sourceRef="tellGO" targetRef="notifyMSP" />
    <bpmn:sequenceFlow id="f19" sourceRef="notifyMSP" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>