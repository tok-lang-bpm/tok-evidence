<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MSPN" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MSPO" name="MSPO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="send" name="Send dismissal to MSPO" />
    <bpmn:task id="review" name="Review dismissal" />
    <bpmn:exclusiveGateway id="gateway" name="Dismissal decision?" />
    <bpmn:task id="reject" name="Reject dismissal" />
    <bpmn:task id="confirm" name="Confirm dismissal" />
    <bpmn:endEvent id="endReject" name="Dismissal rejected" />
    <bpmn:endEvent id="endConfirm" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f2" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f3" sourceRef="review" targetRef="gateway" />
    <bpmn:sequenceFlow id="f4" name="reject" sourceRef="gateway" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="confirm" sourceRef="gateway" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="endReject" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="endConfirm" />
  </bpmn:process>
</bpmn:definitions>
