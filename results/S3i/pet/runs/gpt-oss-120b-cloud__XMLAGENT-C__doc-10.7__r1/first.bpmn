<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="lane_MSPN" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_GO" name="GO">
        <bpmn:flowNodeRef>t_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_inform_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_inform_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_MSPO" name="MSPO">
        <bpmn:flowNodeRef>t_inform_mspo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_MPO" name="MPO">
        <bpmn:flowNodeRef>t_inform_mpo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_SP" name="SP">
        <bpmn:flowNodeRef>t_inform_sp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="t_register" name="Register the measurement at the GO" />
    <bpmn:task id="t_examine" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="gw_decide" name="Application decision" />
    <bpmn:task id="t_reject" name="Reject the application of the MSPN" />
    <bpmn:endEvent id="end_reject" name="Application rejected" />
    <bpmn:task id="t_assign" name="Assign the MSPN" />
    <bpmn:parallelGateway id="g_inform_split" />
    <bpmn:task id="t_inform_mspo" name="Inform the MSPO about the assignment of MSPN" />
    <bpmn:task id="t_inform_mpo" name="Inform the MPO about the assignment of MSPN" />
    <bpmn:task id="t_inform_sp" name="Inform the SP about the assignment of MSPN" />
    <bpmn:parallelGateway id="g_inform_join" />
    <bpmn:endEvent id="end_success" name="Process completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_register" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_register" targetRef="t_examine" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_examine" targetRef="gw_decide" />
    <bpmn:sequenceFlow id="f4" name="reject" sourceRef="gw_decide" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f5" name="confirm" sourceRef="gw_decide" targetRef="t_assign" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_reject" targetRef="end_reject" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_assign" targetRef="g_inform_split" />
    <bpmn:sequenceFlow id="f8" sourceRef="g_inform_split" targetRef="t_inform_mspo" />
    <bpmn:sequenceFlow id="f9" sourceRef="g_inform_split" targetRef="t_inform_mpo" />
    <bpmn:sequenceFlow id="f10" sourceRef="g_inform_split" targetRef="t_inform_sp" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_inform_mspo" targetRef="g_inform_join" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_inform_mpo" targetRef="g_inform_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_inform_sp" targetRef="g_inform_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="g_inform_join" targetRef="end_success" />
  </bpmn:process>
</bpmn:definitions>