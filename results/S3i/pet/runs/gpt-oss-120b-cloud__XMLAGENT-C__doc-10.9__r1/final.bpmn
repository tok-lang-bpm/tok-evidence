<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="lane_sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mpo" name="MPO">
        <bpmn:flowNodeRef>gw_origin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cause_mpo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_origin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:exclusiveGateway id="gw_origin" name="Change initiator?" />
    <bpmn:task id="req_sp" name="SP / PU / GO request changes to the MPO" />
    <bpmn:task id="cause_mpo" name="MPO causes a change" />
    <bpmn:exclusiveGateway id="gw_merge_origin" name="Merge origin" />
    <bpmn:task id="review" name="MPO reviews the change request" />
    <bpmn:exclusiveGateway id="gw_decision" name="Reject or confirm change?" />
    <bpmn:task id="reject" name="MPO rejects the change of the measuring point" />
    <bpmn:task id="confirm" name="MPO confirms the request of the SP / PU / GO" />
    <bpmn:task id="perform" name="MPO performs the measuring point change" />
    <bpmn:exclusiveGateway id="gw_outcome" name="Implementation successful?" />
    <bpmn:task id="report" name="MPO reports the implementation to the SP / PU / GO" />
    <bpmn:task id="notify_failure" name="MPO notifies the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="end_reject" name="Change rejected" />
    <bpmn:endEvent id="end_success" name="Implementation reported" />
    <bpmn:endEvent id="end_failure" name="Failure notified" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="sf1" sourceRef="start" targetRef="gw_origin" />
    <bpmn:sequenceFlow id="sf2" sourceRef="gw_origin" targetRef="req_sp" name="SP request" />
    <bpmn:sequenceFlow id="sf3" sourceRef="gw_origin" targetRef="cause_mpo" name="MPO initiates" />
    <bpmn:sequenceFlow id="sf4" sourceRef="req_sp" targetRef="gw_merge_origin" />
    <bpmn:sequenceFlow id="sf5" sourceRef="cause_mpo" targetRef="gw_merge_origin" />
    <bpmn:sequenceFlow id="sf6" sourceRef="gw_merge_origin" targetRef="review" />
    <bpmn:sequenceFlow id="sf7" sourceRef="review" targetRef="gw_decision" />
    <bpmn:sequenceFlow id="sf8" sourceRef="gw_decision" targetRef="reject" name="reject" />
    <bpmn:sequenceFlow id="sf9" sourceRef="gw_decision" targetRef="confirm" name="confirm" />
    <bpmn:sequenceFlow id="sf10" sourceRef="reject" targetRef="end_reject" />
    <bpmn:sequenceFlow id="sf11" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="sf12" sourceRef="perform" targetRef="gw_outcome" />
    <bpmn:sequenceFlow id="sf13" sourceRef="gw_outcome" targetRef="report" name="success" />
    <bpmn:sequenceFlow id="sf14" sourceRef="gw_outcome" targetRef="notify_failure" name="failure" />
    <bpmn:sequenceFlow id="sf15" sourceRef="report" targetRef="end_success" />
    <bpmn:sequenceFlow id="sf16" sourceRef="notify_failure" targetRef="end_failure" />
  </bpmn:process>
</bpmn:definitions>
