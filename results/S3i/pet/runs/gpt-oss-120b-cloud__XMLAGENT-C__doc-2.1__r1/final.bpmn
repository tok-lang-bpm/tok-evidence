<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="TELECO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>E_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_customer_received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CS" name="Customer Service">
        <bpmn:flowNodeRef>T_receive_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_enter_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_compare_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_determine_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_detailed_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_detailed_to_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receive_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receive_resolution_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_customer_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ELECTRONIC" name="Electronic Service">
        <bpmn:flowNodeRef>T_determine_significance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SM" name="Service Management">
        <bpmn:flowNodeRef>T_receive_detailed_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_analyze_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_trouble_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_to_RP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_prepare_final_status_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_perf_to_CS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_minor_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_resolution_report_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_resolution_to_CS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receive_troubleshooting_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_extra_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_extra_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_RP" name="Resource Provisioning">
        <bpmn:flowNodeRef>T_receive_detailed_RP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_any_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_normal_notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_analyze_problem_RP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_trouble_report_RP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_status_report_to_SM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receive_restoration_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_track_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_undertake_corrective_RP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create_troubleshooting_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_troubleshooting_report_to_SM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BILLING" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>T_report_sla_rebate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow Nodes -->
    <bpmn:startEvent id="E_start" name="Customer perceives service degradation" />
    <bpmn:task id="T_send_params" name="Send problem parameters list to Customer Service" />
    <bpmn:task id="T_receive_params" name="Receive problem parameters list" />
    <bpmn:task id="T_enter_report" name="Enter problem report into system T" />
    <bpmn:task id="T_compare_sla" name="Compare problem report to SLA" />
    <bpmn:task id="T_determine_measures" name="Determine necessary counter measures and priorities" />
    <bpmn:task id="T_determine_significance" name="Determine significance of the customer" />
    <bpmn:exclusiveGateway id="G_premium" name="Customer premium?" />
    <bpmn:task id="T_extra_fix" name="Link to extra problem fix process" />
    <bpmn:endEvent id="E_extra_end" name="Extra problem fix process end" />
    <bpmn:exclusiveGateway id="G_significance" name="Significance affects counter measures?" />
    <bpmn:task id="T_create_detailed_report" name="Create detailed problem report" />
    <bpmn:task id="T_send_detailed_to_SM" name="Send detailed problem report to Service Management" />
    <bpmn:task id="T_receive_detailed_SM" name="Receive detailed problem report" />
    <bpmn:exclusiveGateway id="G_analyzable" name="Problem analyzable by Service Management?" />
    <bpmn:task id="T_analyze_SM" name="Analyze problem" />
    <bpmn:task id="T_create_trouble_SM" name="Create trouble report" />
    <bpmn:task id="T_send_to_RP" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="T_receive_detailed_RP" name="Receive detailed problem report" />
    <bpmn:exclusiveGateway id="G_any_problems" name="Any problems detected?" />
    <bpmn:task id="T_create_normal_notification" name="Create normal service execution notification" />
    <bpmn:task id="T_analyze_problem_RP" name="Analyze problem" />
    <bpmn:task id="T_create_trouble_report_RP" name="Create trouble report" />
    <bpmn:task id="T_send_status_report_to_SM" name="Send status report to Service Management" />
    <bpmn:task id="T_prepare_final_status_report" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="G_outcome" name="Determine next action" />
    <bpmn:task id="T_send_perf_to_CS" name="Send actual service performance to Customer Service" />
    <bpmn:task id="T_minor_corrective" name="Undertake corrective actions" />
    <bpmn:task id="T_create_resolution_report_SM" name="Create problem resolution report" />
    <bpmn:task id="T_send_resolution_to_CS" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="T_create_restoration_request" name="Create request for automatic resource restoration" />
    <bpmn:task id="T_send_restoration_request" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="T_receive_restoration_request" name="Receive restoration request" />
    <bpmn:task id="T_track_errors" name="Track all possible errors" />
    <bpmn:task id="T_undertake_corrective_RP" name="Undertake necessary corrective actions" />
    <bpmn:task id="T_create_troubleshooting_report" name="Create trouble-shooting report" />
    <bpmn:task id="T_send_troubleshooting_report_to_SM" name="Send trouble-shooting report to Service Management" />
    <bpmn:task id="T_receive_troubleshooting_report" name="Receive trouble-shooting report" />
    <bpmn:task id="T_receive_perf" name="Receive actual service performance" />
    <bpmn:task id="T_receive_resolution_report" name="Receive problem resolution report" />
    <bpmn:task id="T_create_customer_report" name="Create report for the customer" />
    <bpmn:task id="T_send_customer_report" name="Send report to customer" />
    <bpmn:task id="T_report_sla_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="PG_split" name="Parallel split for final activities" />
    <bpmn:parallelGateway id="PG_join" name="Parallel join after final activities" />
    <bpmn:endEvent id="E_customer_received" name="Customer receives report" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="F1" sourceRef="E_start" targetRef="T_send_params" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_send_params" targetRef="T_receive_params" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_receive_params" targetRef="T_enter_report" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_enter_report" targetRef="T_compare_sla" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_compare_sla" targetRef="T_determine_measures" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_determine_measures" targetRef="T_determine_significance" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_determine_significance" targetRef="G_premium" />
    <bpmn:sequenceFlow id="F8" sourceRef="G_premium" name="yes" targetRef="T_extra_fix" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_extra_fix" targetRef="E_extra_end" />
    <bpmn:sequenceFlow id="F10" sourceRef="G_premium" name="no" targetRef="G_significance" />
    <bpmn:sequenceFlow id="F11" sourceRef="G_significance" name="yes" targetRef="T_determine_measures" />
    <bpmn:sequenceFlow id="F12" sourceRef="G_significance" name="no" targetRef="T_create_detailed_report" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_create_detailed_report" targetRef="T_send_detailed_to_SM" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_send_detailed_to_SM" targetRef="T_receive_detailed_SM" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_receive_detailed_SM" targetRef="G_analyzable" />
    <bpmn:sequenceFlow id="F16" sourceRef="G_analyzable" name="yes" targetRef="T_analyze_SM" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_analyze_SM" targetRef="T_create_trouble_SM" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_create_trouble_SM" targetRef="T_prepare_final_status_report" />
    <bpmn:sequenceFlow id="F19" sourceRef="G_analyzable" name="no" targetRef="T_send_to_RP" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_send_to_RP" targetRef="T_receive_detailed_RP" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_receive_detailed_RP" targetRef="G_any_problems" />
    <bpmn:sequenceFlow id="F22" sourceRef="G_any_problems" name="no" targetRef="T_create_normal_notification" />
    <bpmn:sequenceFlow id="F23" sourceRef="G_any_problems" name="yes" targetRef="T_analyze_problem_RP" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_analyze_problem_RP" targetRef="T_create_trouble_report_RP" />
    <bpmn:sequenceFlow id="F25" sourceRef="T_create_trouble_report_RP" targetRef="T_send_status_report_to_SM" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_create_normal_notification" targetRef="T_send_status_report_to_SM" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_send_status_report_to_SM" targetRef="T_prepare_final_status_report" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_prepare_final_status_report" targetRef="G_outcome" />
    <bpmn:sequenceFlow id="F29" sourceRef="G_outcome" name="no problem" targetRef="T_send_perf_to_CS" />
    <bpmn:sequenceFlow id="F30" sourceRef="G_outcome" name="minor corrective" targetRef="T_minor_corrective" />
    <bpmn:sequenceFlow id="F31" sourceRef="G_outcome" name="auto restoration" targetRef="T_create_restoration_request" />
    <bpmn:sequenceFlow id="F32" sourceRef="T_send_perf_to_CS" targetRef="T_receive_perf" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_minor_corrective" targetRef="T_create_resolution_report_SM" />
    <bpmn:sequenceFlow id="F34" sourceRef="T_create_resolution_report_SM" targetRef="T_send_resolution_to_CS" />
    <bpmn:sequenceFlow id="F35" sourceRef="T_send_resolution_to_CS" targetRef="T_receive_resolution_report" />
    <bpmn:sequenceFlow id="F36" sourceRef="T_create_restoration_request" targetRef="T_send_restoration_request" />
    <bpmn:sequenceFlow id="F37" sourceRef="T_send_restoration_request" targetRef="T_receive_restoration_request" />
    <bpmn:sequenceFlow id="F38" sourceRef="T_receive_restoration_request" targetRef="T_track_errors" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_track_errors" targetRef="T_undertake_corrective_RP" />
    <bpmn:sequenceFlow id="F40" sourceRef="T_undertake_corrective_RP" targetRef="T_create_troubleshooting_report" />
    <bpmn:sequenceFlow id="F41" sourceRef="T_create_troubleshooting_report" targetRef="T_send_troubleshooting_report_to_SM" />
    <bpmn:sequenceFlow id="F42" sourceRef="T_send_troubleshooting_report_to_SM" targetRef="T_receive_troubleshooting_report" />
    <bpmn:sequenceFlow id="F43" sourceRef="T_receive_troubleshooting_report" targetRef="T_create_resolution_report_SM" />
    <bpmn:sequenceFlow id="F44" sourceRef="T_receive_perf" targetRef="T_create_customer_report" />
    <bpmn:sequenceFlow id="F45" sourceRef="T_receive_resolution_report" targetRef="T_create_customer_report" />
    <bpmn:sequenceFlow id="F46" sourceRef="T_create_customer_report" targetRef="PG_split" />
    <bpmn:sequenceFlow id="F47" sourceRef="PG_split" targetRef="T_report_sla_rebate" />
    <bpmn:sequenceFlow id="F48" sourceRef="PG_split" targetRef="T_send_customer_report" />
    <bpmn:sequenceFlow id="F49" sourceRef="T_send_customer_report" targetRef="PG_join" />
    <bpmn:sequenceFlow id="F50" sourceRef="T_report_sla_rebate" targetRef="PG_join" />
    <bpmn:sequenceFlow id="F51" sourceRef="PG_join" targetRef="E_customer_received" />
  </bpmn:process>
</bpmn:definitions>
