<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_PARTY" name="Party">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BACKOFFICE" name="Client Service Back Office (Small Claims Registry Operations)">
        <bpmn:flowNodeRef>receiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieveSCT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardToPolice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeAwaiting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieveAfterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attachAndStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="sendRequest" name="Send warrant possession request asking a warrant to be released" />
    <bpmn:task id="receiveRequest" name="Receive warrant possession request" />
    <bpmn:task id="retrieveSCT" name="Retrieve the SCT file" />
    <bpmn:task id="forwardToPolice" name="Forward SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="storeAwaiting" name="Store SCT physical file awaiting police report" />
    <bpmn:task id="receiveReport" name="Receive police report" />
    <bpmn:task id="retrieveAfterReport" name="Retrieve SCT file after report" />
    <bpmn:task id="attachAndStore" name="Attach new SCT document and store expanded SCT physical file" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendRequest" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendRequest" targetRef="receiveRequest" />
    <bpmn:sequenceFlow id="f3" sourceRef="receiveRequest" targetRef="retrieveSCT" />
    <bpmn:sequenceFlow id="f4" sourceRef="retrieveSCT" targetRef="forwardToPolice" />
    <bpmn:sequenceFlow id="f5" sourceRef="forwardToPolice" targetRef="storeAwaiting" />
    <bpmn:sequenceFlow id="f6" sourceRef="storeAwaiting" targetRef="receiveReport" />
    <bpmn:sequenceFlow id="f7" sourceRef="receiveReport" targetRef="retrieveAfterReport" />
    <bpmn:sequenceFlow id="f8" sourceRef="retrieveAfterReport" targetRef="attachAndStore" />
    <bpmn:sequenceFlow id="f9" sourceRef="attachAndStore" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>