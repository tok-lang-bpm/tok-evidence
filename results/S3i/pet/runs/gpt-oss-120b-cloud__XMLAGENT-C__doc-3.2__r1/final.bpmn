<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneStaff" name="Staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneJudge" name="Judge">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pg2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start morning process" />
    <bpmn:task id="t1" name="Check files which have yet to be processed" />
    <bpmn:exclusiveGateway id="gw1" name="Files missing?" />
    <bpmn:task id="t2" name="Initiate search for missing files" />
    <bpmn:task id="t3" name="Physically track files to intended location" />
    <bpmn:task id="t4" name="Hand files to Associate" />
    <bpmn:parallelGateway id="pg1" />
    <bpmn:task id="t5" name="Distribute Judgeis Lawlist to relevant people" />
    <bpmn:parallelGateway id="pg2" />
    <bpmn:task id="t6" name="Conduct directions hearings" />
    <bpmn:endEvent id="end" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="gw1" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="gw1" targetRef="t2" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="gw1" targetRef="t3" />
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="pg1" />
    <bpmn:sequenceFlow id="f8" sourceRef="pg1" targetRef="t5" />
    <bpmn:sequenceFlow id="f9" sourceRef="pg1" targetRef="pg2" />
    <bpmn:sequenceFlow id="f10" sourceRef="t5" targetRef="pg2" />
    <bpmn:sequenceFlow id="f11" sourceRef="pg2" targetRef="t6" />
    <bpmn:sequenceFlow id="f12" sourceRef="t6" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
