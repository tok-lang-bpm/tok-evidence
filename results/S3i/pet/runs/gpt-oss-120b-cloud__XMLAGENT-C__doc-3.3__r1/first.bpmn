<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="CLAIMS_OFFICER" name="Claims Officer">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SENIOR_OFFICER" name="Senior Claims Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Claim registered" />
    <bpmn:task id="examine" name="Examine claim" />
    <bpmn:task id="recommend" name="Write settlement recommendation" />
    <bpmn:task id="check" name="Check settlement recommendation" />
    <bpmn:exclusiveGateway id="decision" name="Recommendation OK?" />
    <bpmn:endEvent id="end" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="examine" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f3" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f4" sourceRef="check" targetRef="decision" />
    <bpmn:sequenceFlow id="f5" name="OK" sourceRef="decision" targetRef="end" />
    <bpmn:sequenceFlow id="f6" name="Not OK" sourceRef="decision" targetRef="recommend" />
  </bpmn:process>
</bpmn:definitions>