<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneMail" name="Mail Processing Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sortMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distributeMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneRegistry" name="Registry">
        <bpmn:flowNodeRef>openRegister</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneAssistant" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>qualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compileRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>captureDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>postEnvelope</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCashier" name="Cashier">
        <bpmn:flowNodeRef>takeFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capturePartyPrint</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Mail collected daily" />
    <bpmn:task id="collect" name="Collect mail on a daily basis" />
    <bpmn:task id="sortMail" name="Sort the unopened mail into the various business areas" />
    <bpmn:task id="distributeMail" name="Distribute the mail" />
    <bpmn:task id="openRegister" name="Open mail, sort into groups, register in manual incoming Mail Register" />
    <bpmn:task id="qualityCheck" name="Perform a quality check" />
    <bpmn:exclusiveGateway id="gatewayDecision" name="Mail compliant?" />
    <bpmn:task id="compileRejection" name="Compile list of requisition and send back to the party" />
    <bpmn:task id="captureDetails" name="Capture matter details and provide to Cashier" />
    <bpmn:task id="takeFees" name="Take applicable fees" />
    <bpmn:parallelGateway id="parallelSplit" />
    <bpmn:task id="postEnvelope" name="Put receipt and copied documents into envelope and post to party" />
    <bpmn:task id="capturePartyPrint" name="Capture Party Details and print Physical Court File" />
    <bpmn:parallelGateway id="parallelJoin" />
    <bpmn:endEvent id="endSuccess" name="Process completed successfully" />
    <bpmn:endEvent id="endRejection" name="Mail rejected" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collect" />
    <bpmn:sequenceFlow id="f2" sourceRef="collect" targetRef="sortMail" />
    <bpmn:sequenceFlow id="f3" sourceRef="sortMail" targetRef="distributeMail" />
    <bpmn:sequenceFlow id="f4" sourceRef="distributeMail" targetRef="openRegister" />
    <bpmn:sequenceFlow id="f5" sourceRef="openRegister" targetRef="qualityCheck" />
    <bpmn:sequenceFlow id="f6" sourceRef="qualityCheck" targetRef="gatewayDecision" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="gatewayDecision" targetRef="compileRejection" />
    <bpmn:sequenceFlow id="f8" sourceRef="compileRejection" targetRef="endRejection" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="gatewayDecision" targetRef="captureDetails" />
    <bpmn:sequenceFlow id="f10" sourceRef="captureDetails" targetRef="takeFees" />
    <bpmn:sequenceFlow id="f11" sourceRef="takeFees" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="f12" sourceRef="parallelSplit" targetRef="postEnvelope" />
    <bpmn:sequenceFlow id="f13" sourceRef="parallelSplit" targetRef="capturePartyPrint" />
    <bpmn:sequenceFlow id="f14" sourceRef="postEnvelope" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f15" sourceRef="capturePartyPrint" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="f16" sourceRef="parallelJoin" targetRef="endSuccess" />
  </bpmn:process>
</bpmn:definitions>