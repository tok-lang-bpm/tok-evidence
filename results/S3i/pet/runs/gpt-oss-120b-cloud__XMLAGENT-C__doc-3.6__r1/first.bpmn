<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organization" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_claimant" name="Claimant">
        <bpmn:flowNodeRef>informReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informUpdate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_officer" name="Claims Officer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveUpdatedForms</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="System">
        <bpmn:flowNodeRef>sendForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerClaim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Claim received" />
    <bpmn:task id="checkInsured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="gwInsured" name="Insured?" />
    <bpmn:task id="informReject" name="Inform claimant that claim must be rejected" />
    <bpmn:endEvent id="endReject" name="Claim rejected" />
    <bpmn:task id="evaluateSeverity" name="Evaluate claim severity" />
    <bpmn:exclusiveGateway id="gwSeverity" name="Simple or complex?" />
    <bpmn:task id="sendForms" name="Send relevant forms to claimant" />
    <bpmn:task id="receiveForms" name="Receive returned forms" />
    <bpmn:task id="checkForms" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="gwComplete" name="Forms complete?" />
    <bpmn:task id="registerClaim" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="endRegistered" name="Claims Notification process completed" />
    <bpmn:task id="informUpdate" name="Inform claimant to update the forms" />
    <bpmn:task id="receiveUpdatedForms" name="Receive updated forms" />
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkInsured" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkInsured" targetRef="gwInsured" />
    <bpmn:sequenceFlow id="f3" sourceRef="gwInsured" targetRef="informReject" name="no" />
    <bpmn:sequenceFlow id="f4" sourceRef="informReject" targetRef="endReject" />
    <bpmn:sequenceFlow id="f5" sourceRef="gwInsured" targetRef="evaluateSeverity" name="yes" />
    <bpmn:sequenceFlow id="f6" sourceRef="evaluateSeverity" targetRef="gwSeverity" />
    <bpmn:sequenceFlow id="f7" sourceRef="gwSeverity" targetRef="sendForms" name="simple" />
    <bpmn:sequenceFlow id="f8" sourceRef="gwSeverity" targetRef="sendForms" name="complex" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendForms" targetRef="receiveForms" />
    <bpmn:sequenceFlow id="f10" sourceRef="receiveForms" targetRef="checkForms" />
    <bpmn:sequenceFlow id="f11" sourceRef="checkForms" targetRef="gwComplete" />
    <bpmn:sequenceFlow id="f12" sourceRef="gwComplete" targetRef="registerClaim" name="yes" />
    <bpmn:sequenceFlow id="f13" sourceRef="registerClaim" targetRef="endRegistered" />
    <bpmn:sequenceFlow id="f14" sourceRef="gwComplete" targetRef="informUpdate" name="no" />
    <bpmn:sequenceFlow id="f15" sourceRef="informUpdate" targetRef="receiveUpdatedForms" />
    <bpmn:sequenceFlow id="f16" sourceRef="receiveUpdatedForms" targetRef="checkForms" />
  </bpmn:process>
</bpmn:definitions>