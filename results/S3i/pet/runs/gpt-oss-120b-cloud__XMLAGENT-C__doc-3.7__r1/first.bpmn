<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneHandler" name="Claims Handler">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>searchAndFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneManager" name="Claims Manager">
        <bpmn:flowNodeRef>negotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="searchAndFile" name="Search Police Report and put in file with Claim Documentation" />
    <bpmn:task id="calculateEstimate" name="Calculate initial claim estimate" />
    <bpmn:task id="createActionPlan" name="Create Action Plan" />
    <bpmn:task id="negotiateSettlement" name="Negotiate settlement on claim estimate" />
    <bpmn:task id="informClaimant" name="Inform claimant of outcome" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="searchAndFile" />
    <bpmn:sequenceFlow id="flow2" sourceRef="searchAndFile" targetRef="calculateEstimate" />
    <bpmn:sequenceFlow id="flow3" sourceRef="calculateEstimate" targetRef="createActionPlan" />
    <bpmn:sequenceFlow id="flow4" sourceRef="createActionPlan" targetRef="negotiateSettlement" />
    <bpmn:sequenceFlow id="flow5" sourceRef="negotiateSettlement" targetRef="informClaimant" />
    <bpmn:sequenceFlow id="flow6" sourceRef="informClaimant" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>