<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Car Insurer" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneCustomer" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneNotification" name="Notification Department">
        <bpmn:flowNodeRef>checkDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendLetter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneHandling" name="Handling Department">
        <bpmn:flowNodeRef>pickCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gatewayAssess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer submits a claim" />
    <bpmn:task id="checkDocs" name="Check documents for completeness and register claim" />
    <bpmn:task id="pickCheck" name="Pick up claim and check insurance" />
    <bpmn:task id="assess" name="Perform assessment" />
    <bpmn:exclusiveGateway id="gatewayAssess" name="Assessment positive?" />
    <bpmn:task id="phoneGarage" name="Phone garage to authorise repairs" />
    <bpmn:task id="schedulePayment" name="Schedule payment" />
    <bpmn:task id="reject" name="Reject claim" />
    <bpmn:task id="sendLetter" name="Send letter to customer" />
    <bpmn:endEvent id="end" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkDocs" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkDocs" targetRef="pickCheck" />
    <bpmn:sequenceFlow id="f3" sourceRef="pickCheck" targetRef="assess" />
    <bpmn:sequenceFlow id="f4" sourceRef="assess" targetRef="gatewayAssess" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="gatewayAssess" targetRef="phoneGarage" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="gatewayAssess" targetRef="reject" />
    <bpmn:sequenceFlow id="f7" sourceRef="phoneGarage" targetRef="schedulePayment" />
    <bpmn:sequenceFlow id="f8" sourceRef="schedulePayment" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f9" sourceRef="reject" targetRef="sendLetter" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendLetter" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
