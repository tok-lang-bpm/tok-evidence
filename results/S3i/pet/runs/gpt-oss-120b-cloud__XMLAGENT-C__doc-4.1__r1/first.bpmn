<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Mental Health Care Institute" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_FD" name="Family Doctor">
        <bpmn:flowNodeRef>fd_notice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SEC" name="Secretarial Office">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_receive_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_patient_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_store_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_produce_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_new_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>team_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_record_assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_medfile_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_send_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_receive_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_inform_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_add_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_pass_card_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_pass_card_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_type_recordings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_put_on_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec_provide_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_NURSE" name="Nursing Officer">
        <bpmn:flowNodeRef>nurse_inquiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_FIRST" name="First Intaker (Social‑Medical Worker)">
        <bpmn:flowNodeRef>first_plan_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>first_add_to_file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SECOND" name="Second Intaker (Physician)">
        <bpmn:flowNodeRef>second_plan_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_add_to_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>second_record_dictaphone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TEAM" name="Team Leader">
        <bpmn:flowNodeRef>meeting_staff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>team_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>team_formulate_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PSY" name="Psychiatrist">
        <bpmn:flowNodeRef>team_formulate_plan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Intake workflow start" />
    <bpmn:task id="fd_notice" name="Family doctor gives notice by telephone" />
    <bpmn:task id="sec_inquire" name="Secretarial worker inquires name and residence" />
    <bpmn:task id="nurse_inquiry" name="Nursing officer makes full inquiry and records registration form" />
    <bpmn:task id="sec_receive_form" name="Secretarial office receives registration form" />
    <bpmn:task id="sec_store_info" name="Store information in information system" />
    <bpmn:task id="sec_print" name="Print registration form" />
    <bpmn:task id="create_patient_file" name="Create patient file" />
    <bpmn:task id="sec_store_form" name="Store form and print in patient file" />
    <bpmn:task id="sec_produce_cards" name="Produce registration cards for first and second intaker" />
    <bpmn:task id="sec_add_new_notice" name="Add patient to list of new notices" />
    <bpmn:task id="meeting_staff" name="Staff meeting of medical team on Wednesday" />
    <bpmn:task id="team_assign" name="Team leader assigns new patients to intakers" />
    <bpmn:task id="sec_record_assignment" name="Record assignments on assignment list" />
    <bpmn:exclusiveGateway id="g_medfile_req" name="Medical file required?" />
    <bpmn:task id="sec_send_letter" name="Prepare and send letter to family doctor requesting medical file" />
    <bpmn:task id="sec_receive_file" name="Receive medical file copy" />
    <bpmn:task id="sec_inform_second" name="Inform second intaker of received file" />
    <bpmn:task id="sec_add_copy" name="Add medical file copy to patient file" />
    <bpmn:task id="sec_pass_card_first" name="Pass registration card to first intaker" />
    <bpmn:task id="sec_pass_card_second" name="Pass registration card to second intaker" />
    <bpmn:task id="first_plan_meeting" name="First intaker plans meeting with patient" />
    <bpmn:task id="first_meeting" name="First intaker conducts first meeting and fills checklist" />
    <bpmn:task id="first_add_to_file" name="Add notes and checklist to patient file" />
    <bpmn:task id="second_plan_meeting" name="Second intaker plans meeting with patient" />
    <bpmn:task id="second_meeting" name="Second intaker conducts meeting" />
    <bpmn:task id="second_record_dictaphone" name="Second intaker records observations on dictaphone" />
    <bpmn:task id="second_add_to_file" name="Add second intaker observations to patient file" />
    <bpmn:task id="sec_type_recordings" name="Secretarial office types dictaphone recordings and adds to file" />
    <bpmn:parallelGateway id="join_intaker" name="Join after intaker activities" />
    <bpmn:task id="sec_put_on_status" name="Put patient on status list" />
    <bpmn:task id="sec_provide_list" name="Provide list of patients to team leader" />
    <bpmn:task id="team_formulate_plan" name="Formulate treatment plan" />
    <bpmn:endEvent id="end" name="Intake procedure completed" />
    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="fd_notice" />
    <bpmn:sequenceFlow id="f2" sourceRef="fd_notice" targetRef="sec_inquire" />
    <bpmn:sequenceFlow id="f3" sourceRef="sec_inquire" targetRef="nurse_inquiry" />
    <bpmn:sequenceFlow id="f4" sourceRef="nurse_inquiry" targetRef="sec_receive_form" />
    <bpmn:sequenceFlow id="f5" sourceRef="sec_receive_form" targetRef="sec_store_info" />
    <bpmn:sequenceFlow id="f6" sourceRef="sec_store_info" targetRef="sec_print" />
    <bpmn:sequenceFlow id="f7" sourceRef="sec_print" targetRef="create_patient_file" />
    <bpmn:sequenceFlow id="f8" sourceRef="create_patient_file" targetRef="sec_store_form" />
    <bpmn:sequenceFlow id="f9" sourceRef="sec_store_form" targetRef="sec_produce_cards" />
    <bpmn:sequenceFlow id="f10" sourceRef="sec_produce_cards" targetRef="sec_add_new_notice" />
    <bpmn:sequenceFlow id="f11" sourceRef="sec_add_new_notice" targetRef="meeting_staff" />
    <bpmn:sequenceFlow id="f12" sourceRef="meeting_staff" targetRef="team_assign" />
    <bpmn:sequenceFlow id="f13" sourceRef="team_assign" targetRef="sec_record_assignment" />
    <bpmn:sequenceFlow id="f14" sourceRef="sec_record_assignment" targetRef="g_medfile_req" />
    <bpmn:sequenceFlow id="f15" sourceRef="g_medfile_req" targetRef="sec_send_letter" name="yes" />
    <bpmn:sequenceFlow id="f16" sourceRef="g_medfile_req" targetRef="sec_pass_card_first" name="no" />
    <bpmn:sequenceFlow id="f17" sourceRef="sec_send_letter" targetRef="sec_receive_file" />
    <bpmn:sequenceFlow id="f18" sourceRef="sec_receive_file" targetRef="sec_inform_second" />
    <bpmn:sequenceFlow id="f19" sourceRef="sec_inform_second" targetRef="sec_add_copy" />
    <bpmn:sequenceFlow id="f20" sourceRef="sec_add_copy" targetRef="sec_pass_card_first" />
    <!-- after handling both branches reach pass cards -->
    <bpmn:sequenceFlow id="f21" sourceRef="sec_pass_card_first" targetRef="first_plan_meeting" />
    <bpmn:sequenceFlow id="f22" sourceRef="sec_pass_card_second" targetRef="second_plan_meeting" />
    <bpmn:sequenceFlow id="f23" sourceRef="first_plan_meeting" targetRef="first_meeting" />
    <bpmn:sequenceFlow id="f24" sourceRef="first_meeting" targetRef="first_add_to_file" />
    <bpmn:sequenceFlow id="f25" sourceRef="first_add_to_file" targetRef="join_intaker" />
    <bpmn:sequenceFlow id="f26" sourceRef="second_plan_meeting" targetRef="second_meeting" />
    <bpmn:sequenceFlow id="f27" sourceRef="second_meeting" targetRef="second_record_dictaphone" />
    <bpmn:sequenceFlow id="f28" sourceRef="second_record_dictaphone" targetRef="second_add_to_file" />
    <bpmn:sequenceFlow id="f29" sourceRef="second_add_to_file" targetRef="sec_type_recordings" />
    <bpmn:sequenceFlow id="f30" sourceRef="sec_type_recordings" targetRef="join_intaker" />
    <bpmn:sequenceFlow id="f31" sourceRef="join_intaker" targetRef="sec_put_on_status" />
    <bpmn:sequenceFlow id="f32" sourceRef="sec_put_on_status" targetRef="sec_provide_list" />
    <bpmn:sequenceFlow id="f33" sourceRef="sec_provide_list" targetRef="team_formulate_plan" />
    <bpmn:sequenceFlow id="f34" sourceRef="team_formulate_plan" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>