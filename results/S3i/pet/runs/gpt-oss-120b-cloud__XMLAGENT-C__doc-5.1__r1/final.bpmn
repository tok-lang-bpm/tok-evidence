<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUSTOMER" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_RISK" name="Risk Assessment Service">
        <bpmn:flowNodeRef>invokeRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_APPROVER" name="Approver Service">
        <bpmn:flowNodeRef>sendApprover</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Loan approval process start" />
    <bpmn:task id="receive" name="Receive customer request for a loan amount" />
    <bpmn:task id="invokeRisk" name="Invoke risk assessment Web service" />
    <bpmn:exclusiveGateway id="gateway1" name="Risk assessment decision?" />
    <bpmn:task id="approve" name="Approve loan" />
    <bpmn:task id="deny" name="Deny loan" />
    <bpmn:task id="sendApprover" name="Send request to approver Web service" />
    <bpmn:exclusiveGateway id="merge" name="Merge feedback paths" />
    <bpmn:task id="feedback" name="Customer receives feedback" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="invokeRisk" />
    <bpmn:sequenceFlow id="f3" sourceRef="invokeRisk" targetRef="gateway1" />
    <bpmn:sequenceFlow id="f4" name="small and low risk" sourceRef="gateway1" targetRef="approve" />
    <bpmn:sequenceFlow id="f5" name="high risk" sourceRef="gateway1" targetRef="deny" />
    <bpmn:sequenceFlow id="f6" name="needs review or amount >= 10k" sourceRef="gateway1" targetRef="sendApprover" />
    <bpmn:sequenceFlow id="f7" sourceRef="approve" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="deny" targetRef="merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendApprover" targetRef="merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="merge" targetRef="feedback" />
    <bpmn:sequenceFlow id="f11" sourceRef="feedback" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
