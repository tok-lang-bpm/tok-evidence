<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organization" processRef="vacation-process" />
  </bpmn:collaboration>
  <bpmn:process id="vacation-process" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneEmployee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSupervisor" name="Supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyHR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneHR" name="Human Resources Representative">
        <bpmn:flowNodeRef>hrProcedure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endApprove</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Vacation request process start" />
    <bpmn:task id="submit" name="Submit vacation request" />
    <bpmn:task id="receive" name="Receive the vacation request" />
    <bpmn:exclusiveGateway id="decision" name="Supervisor approves?" />
    <bpmn:task id="notifyHR" name="Generate notification to HR Representative" />
    <bpmn:task id="hrProcedure" name="Complete the respective management procedures" />
    <bpmn:task id="reviewReject" name="Review rejection reasons" />
    <bpmn:endEvent id="endReject" name="Request rejected" />
    <bpmn:endEvent id="endApprove" name="Vacation request processed" />

    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="flow2" sourceRef="submit" targetRef="receive" />
    <bpmn:sequenceFlow id="flow3" sourceRef="receive" targetRef="decision" />
    <bpmn:sequenceFlow id="flow4" name="yes" sourceRef="decision" targetRef="notifyHR" />
    <bpmn:sequenceFlow id="flow5" name="no" sourceRef="decision" targetRef="reviewReject" />
    <bpmn:sequenceFlow id="flow6" sourceRef="notifyHR" targetRef="hrProcedure" />
    <bpmn:sequenceFlow id="flow7" sourceRef="hrProcedure" targetRef="endApprove" />
    <bpmn:sequenceFlow id="flow8" sourceRef="reviewReject" targetRef="endReject" />
  </bpmn:process>
</bpmn:definitions>
