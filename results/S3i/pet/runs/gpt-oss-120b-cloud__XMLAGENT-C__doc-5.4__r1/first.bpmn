<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_EMPLOYEE" name="Employee">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EditReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SUPERVISOR" name="Supervisor">
        <bpmn:flowNodeRef>SupervisorReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_TREASURER" name="Treasurer">
        <bpmn:flowNodeRef>TreasurerCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllReceiptsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AcceptExpenses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendBackToEmployee</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SYSTEM" name="System">
        <bpmn:flowNodeRef>LinkToPaymentSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitForPaymentConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Start" />
    <bpmn:task id="Purchase" name="Purchase product or service" />
    <bpmn:task id="SubmitReport" name="Submit expense report with items and receipts" />
    <bpmn:exclusiveGateway id="SupervisorReview" name="Supervisor approves?" />
    <bpmn:task id="EditReport" name="Edit expense report" />
    <bpmn:task id="TreasurerCheck" name="Treasurer checks receipts match items" />
    <bpmn:exclusiveGateway id="AllReceiptsOk" name="All receipts present and match?" />
    <bpmn:task id="AcceptExpenses" name="Accept expenses for processing" />
    <bpmn:task id="SendBackToEmployee" name="Send report back to employee" />
    <bpmn:task id="LinkToPaymentSystem" name="Link to payment system" />
    <bpmn:task id="WaitForPaymentConfirmation" name="Wait for payment confirmation" />
    <bpmn:endEvent id="EndEvent" name="End" />
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent" targetRef="Purchase" />
    <bpmn:sequenceFlow id="F2" sourceRef="Purchase" targetRef="SubmitReport" />
    <bpmn:sequenceFlow id="F3" sourceRef="SubmitReport" targetRef="SupervisorReview" />
    <bpmn:sequenceFlow id="F4" name="reject" sourceRef="SupervisorReview" targetRef="EditReport" />
    <bpmn:sequenceFlow id="F5" name="approve" sourceRef="SupervisorReview" targetRef="TreasurerCheck" />
    <bpmn:sequenceFlow id="F6" sourceRef="EditReport" targetRef="SupervisorReview" />
    <bpmn:sequenceFlow id="F7" sourceRef="TreasurerCheck" targetRef="AllReceiptsOk" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="AllReceiptsOk" targetRef="AcceptExpenses" />
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="AllReceiptsOk" targetRef="SendBackToEmployee" />
    <bpmn:sequenceFlow id="F10" sourceRef="SendBackToEmployee" targetRef="EditReport" />
    <bpmn:sequenceFlow id="F11" sourceRef="AcceptExpenses" targetRef="LinkToPaymentSystem" />
    <bpmn:sequenceFlow id="F12" sourceRef="LinkToPaymentSystem" targetRef="WaitForPaymentConfirmation" />
    <bpmn:sequenceFlow id="F13" sourceRef="WaitForPaymentConfirmation" targetRef="EndEvent" />
  </bpmn:process>
</bpmn:definitions>