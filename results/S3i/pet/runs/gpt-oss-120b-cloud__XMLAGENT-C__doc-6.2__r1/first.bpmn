<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_ASSEMBLER" name="Assembler AG">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_ORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RECEIVE_INVOICE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SUPPLIER" name="Supplier">
        <bpmn:flowNodeRef>PROCESS_ORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_INVOICE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="First of each month" />
    <bpmn:task id="SEND_ORDER" name="Assembler AG sends the order to the supplier" />
    <bpmn:task id="PROCESS_ORDER" name="Supplier processes the order" />
    <bpmn:task id="SEND_INVOICE" name="Supplier sends an invoice to Assembler AG" />
    <bpmn:task id="RECEIVE_INVOICE" name="Assembler AG receives the invoice" />
    <bpmn:endEvent id="END" name="Process completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="SEND_ORDER" />
    <bpmn:sequenceFlow id="F2" sourceRef="SEND_ORDER" targetRef="PROCESS_ORDER" />
    <bpmn:sequenceFlow id="F3" sourceRef="PROCESS_ORDER" targetRef="SEND_INVOICE" />
    <bpmn:sequenceFlow id="F4" sourceRef="SEND_INVOICE" targetRef="RECEIVE_INVOICE" />
    <bpmn:sequenceFlow id="F5" sourceRef="RECEIVE_INVOICE" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>