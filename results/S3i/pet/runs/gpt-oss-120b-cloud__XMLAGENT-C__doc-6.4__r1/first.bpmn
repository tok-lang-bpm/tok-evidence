<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="Marketing" name="Marketing">
        <bpmn:flowNodeRef>buyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibitParticipation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>personalNetwork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CallCenter" name="Call Center">
        <bpmn:flowNodeRef>startCalling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineContactPersonAndBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askGeneralInterest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="HeadDev" name="Head of Development">
        <bpmn:flowNodeRef>headTriesAcquisition</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SalesRep" name="Sales Representative">
        <bpmn:flowNodeRef>salesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesCallBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createQuotation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PreSales" name="Pre‑Sales Employee">
        <bpmn:flowNodeRef>preSalesPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="System">
        <bpmn:flowNodeRef>waitCustomerResponse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Determine contact details of potential customers" />
    <bpmn:task id="buyDetails" name="Buy details for cold calls" />
    <bpmn:task id="exhibitParticipation" name="Marketing staff participates in exhibitions" />
    <bpmn:task id="personalNetwork" name="Know somebody interested in the product" />
    <bpmn:exclusiveGateway id="gwSourceMerge" name="Contact source merge" />
    <bpmn:task id="startCalling" name="Start calling the customer" />
    <bpmn:task id="determineContactPersonAndBudget" name="Determine contact person and budget" />
    <bpmn:task id="askGeneralInterest" name="Ask if customer is generally interested" />
    <bpmn:exclusiveGateway id="gwInterest" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="gwBudget" name="Project budget huge?" />
    <bpmn:task id="headTriesAcquisition" name="Head of development tries to acquire the customer" />
    <bpmn:exclusiveGateway id="gwPresentSplit" name="Presentation type" />
    <bpmn:task id="salesPresentation" name="Give detailed online presentation (sales representative)" />
    <bpmn:task id="preSalesPresentation" name="Give detailed online presentation (pre‑sales employee)" />
    <bpmn:exclusiveGateway id="gwPresentJoin" name="Presentation join" />
    <bpmn:task id="waitCustomerResponse" name="Wait for customer to come back" />
    <bpmn:exclusiveGateway id="gwResponse" name="Customer responded?" />
    <bpmn:task id="salesCallBack" name="Sales representative calls the customer (after 2 weeks)" />
    <bpmn:task id="createQuotation" name="Create quotation" />
    <bpmn:endEvent id="endLeave" name="Leave customer alone" />
    <bpmn:endEvent id="endQuotation" name="Quotation created" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="f_start_buy" sourceRef="start" targetRef="buyDetails" />
    <bpmn:sequenceFlow id="f_start_exhibit" sourceRef="start" targetRef="exhibitParticipation" />
    <bpmn:sequenceFlow id="f_start_network" sourceRef="start" targetRef="personalNetwork" />
    <bpmn:sequenceFlow id="f_buy_merge" sourceRef="buyDetails" targetRef="gwSourceMerge" />
    <bpmn:sequenceFlow id="f_exhibit_merge" sourceRef="exhibitParticipation" targetRef="gwSourceMerge" />
    <bpmn:sequenceFlow id="f_network_merge" sourceRef="personalNetwork" targetRef="gwSourceMerge" />
    <bpmn:sequenceFlow id="f_merge_call" sourceRef="gwSourceMerge" targetRef="startCalling" />
    <bpmn:sequenceFlow id="f_call_determine" sourceRef="startCalling" targetRef="determineContactPersonAndBudget" />
    <bpmn:sequenceFlow id="f_determine_ask" sourceRef="determineContactPersonAndBudget" targetRef="askGeneralInterest" />
    <bpmn:sequenceFlow id="f_ask_interest" sourceRef="askGeneralInterest" targetRef="gwInterest" />
    <bpmn:sequenceFlow id="f_interest_yes" name="yes" sourceRef="gwInterest" targetRef="gwPresentSplit" />
    <bpmn:sequenceFlow id="f_interest_no" name="no" sourceRef="gwInterest" targetRef="gwBudget" />
    <bpmn:sequenceFlow id="f_budget_yes" name="yes" sourceRef="gwBudget" targetRef="headTriesAcquisition" />
    <bpmn:sequenceFlow id="f_budget_no" name="no" sourceRef="gwBudget" targetRef="endLeave" />
    <bpmn:sequenceFlow id="f_head_to_present" sourceRef="headTriesAcquisition" targetRef="gwPresentSplit" />
    <bpmn:sequenceFlow id="f_present_sales" name="sales" sourceRef="gwPresentSplit" targetRef="salesPresentation" />
    <bpmn:sequenceFlow id="f_present_pre" name="pre‑sales" sourceRef="gwPresentSplit" targetRef="preSalesPresentation" />
    <bpmn:sequenceFlow id="f_sales_join" sourceRef="salesPresentation" targetRef="gwPresentJoin" />
    <bpmn:sequenceFlow id="f_pre_join" sourceRef="preSalesPresentation" targetRef="gwPresentJoin" />
    <bpmn:sequenceFlow id="f_join_wait" sourceRef="gwPresentJoin" targetRef="waitCustomerResponse" />
    <bpmn:sequenceFlow id="f_wait_response" sourceRef="waitCustomerResponse" targetRef="gwResponse" />
    <bpmn:sequenceFlow id="f_response_yes" name="responded" sourceRef="gwResponse" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f_response_no" name="no response" sourceRef="gwResponse" targetRef="salesCallBack" />
    <bpmn:sequenceFlow id="f_callBack_to_quotation" sourceRef="salesCallBack" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f_quotation_end" sourceRef="createQuotation" targetRef="endQuotation" />
  </bpmn:process>
</bpmn:definitions>