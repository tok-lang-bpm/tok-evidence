<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="process1" />
  </bpmn:collaboration>
  <bpmn:process id="process1" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="ManagerLane" name="Manager">
        <bpmn:flowNodeRef>checkLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tellAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endProcess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AssistantLane" name="Sales Assistant">
        <bpmn:flowNodeRef>callCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoInterest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="checkLeads" name="checks the open leads" />
    <bpmn:task id="selectTopFive" name="selects the top five leads" />
    <bpmn:task id="tellAssistant" name="tells Sales Assistant to call the contact person of the leads" />
    <bpmn:task id="callCustomer" name="calls each customer" />
    <bpmn:exclusiveGateway id="gwInterest" name="Customer interested?" />
    <bpmn:task id="sendNote" name="sends a note to the Manager" />
    <bpmn:task id="processLead" name="processes the lead" />
    <bpmn:task id="callNext" name="calls the next customer" />
    <bpmn:endEvent id="endProcess" name="Lead processed" />
    <bpmn:endEvent id="endNoInterest" name="No interest path ends" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="checkLeads" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkLeads" targetRef="selectTopFive" />
    <bpmn:sequenceFlow id="f3" sourceRef="selectTopFive" targetRef="tellAssistant" />
    <bpmn:sequenceFlow id="f4" sourceRef="tellAssistant" targetRef="callCustomer" />
    <bpmn:sequenceFlow id="f5" sourceRef="callCustomer" targetRef="gwInterest" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="gwInterest" targetRef="sendNote" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="gwInterest" targetRef="callNext" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendNote" targetRef="processLead" />
    <bpmn:sequenceFlow id="f9" sourceRef="processLead" targetRef="endProcess" />
    <bpmn:sequenceFlow id="f10" sourceRef="callNext" targetRef="endNoInterest" />
  </bpmn:process>
</bpmn:definitions>