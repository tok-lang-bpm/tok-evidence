<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_FUNC" name="Functional Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_HR" name="HR">
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contract</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Process start" />
    <bpmn:task id="demand" name="Demand to fill a post" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="apply" name="Applicants apply" />
    <bpmn:task id="check" name="Check applications" />
    <bpmn:task id="fill" name="Fill the post" />
    <bpmn:task id="contract" name="Conclude contract of employment" />
    <bpmn:endEvent id="end" name="Process end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="demand" />
    <bpmn:sequenceFlow id="f2" sourceRef="demand" targetRef="advertise" />
    <bpmn:sequenceFlow id="f3" sourceRef="advertise" targetRef="apply" />
    <bpmn:sequenceFlow id="f4" sourceRef="apply" targetRef="check" />
    <bpmn:sequenceFlow id="f5" sourceRef="check" targetRef="fill" />
    <bpmn:sequenceFlow id="f6" sourceRef="fill" targetRef="contract" />
    <bpmn:sequenceFlow id="f7" sourceRef="contract" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
