<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions"
                  targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG_POOL" name="Organisation" processRef="HR_PROCESS" />
  </bpmn:collaboration>

  <bpmn:process id="HR_PROCESS" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="LANE_HR" name="HR Clerk">
        <bpmn:flowNodeRef>startEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askDepartment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>postJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_DEPT" name="Department">
        <bpmn:flowNodeRef>clarityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvalCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flow nodes -->
    <bpmn:startEvent id="startEvent" name="Vacancy reported" />
    <bpmn:task id="createDescription" name="Create job description from the information" />
    <bpmn:exclusiveGateway id="clarityCheck" name="Message clear?" />
    <bpmn:task id="askDepartment" name="Ask Department again" />
    <bpmn:task id="submitDescription" name="Submit job description for consideration" />
    <bpmn:exclusiveGateway id="approvalCheck" name="Description approved?" />
    <bpmn:task id="correctDescription" name="Correct the description" />
    <bpmn:task id="postJob" name="Post the job" />
    <bpmn:endEvent id="endEvent" name="Process completed" />

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="startEvent" targetRef="createDescription" />
    <bpmn:sequenceFlow id="flow2" sourceRef="createDescription" targetRef="clarityCheck" />
    <bpmn:sequenceFlow id="flow3" sourceRef="clarityCheck" targetRef="askDepartment" name="no" />
    <bpmn:sequenceFlow id="flow4" sourceRef="clarityCheck" targetRef="submitDescription" name="yes" />
    <bpmn:sequenceFlow id="flow5" sourceRef="askDepartment" targetRef="createDescription" />
    <bpmn:sequenceFlow id="flow6" sourceRef="submitDescription" targetRef="approvalCheck" />
    <bpmn:sequenceFlow id="flow7" sourceRef="approvalCheck" targetRef="postJob" name="approved" />
    <bpmn:sequenceFlow id="flow8" sourceRef="approvalCheck" targetRef="correctDescription" name="rejected" />
    <bpmn:sequenceFlow id="flow9" sourceRef="correctDescription" targetRef="submitDescription" />
    <bpmn:sequenceFlow id="flow10" sourceRef="postJob" targetRef="endEvent" />
  </bpmn:process>
</bpmn:definitions>
