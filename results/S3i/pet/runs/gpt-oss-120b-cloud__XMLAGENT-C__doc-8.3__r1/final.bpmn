<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="HEAD" name="Head of Functional Department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="HR" name="Personnel Department">
        <bpmn:flowNodeRef>sendJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctJD</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Detected personnel requirements" />
    <bpmn:task id="report" name="Report vacancy to Personnel Department" />
    <bpmn:task id="sendJD" name="Send job description to Head for review" />
    <bpmn:task id="receiveJD" name="Receive job description for review" />
    <bpmn:exclusiveGateway id="gateway" name="Is job description ready?" />
    <bpmn:task id="askCorrections" name="Ask for corrections" />
    <bpmn:task id="correctJD" name="Correct job description" />
    <bpmn:task id="provideClarifications" name="Provide clarifications" />
    <bpmn:task id="approve" name="Approve job description" />
    <bpmn:endEvent id="end" name="Process completed" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="sendJD" />
    <bpmn:sequenceFlow id="f3" sourceRef="sendJD" targetRef="receiveJD" />
    <bpmn:sequenceFlow id="f4" sourceRef="receiveJD" targetRef="gateway" />
    <bpmn:sequenceFlow id="f5" name="needs corrections" sourceRef="gateway" targetRef="askCorrections" />
    <bpmn:sequenceFlow id="f6" name="has questions" sourceRef="gateway" targetRef="provideClarifications" />
    <bpmn:sequenceFlow id="f7" name="approve" sourceRef="gateway" targetRef="approve" />
    <bpmn:sequenceFlow id="f8" sourceRef="askCorrections" targetRef="correctJD" />
    <bpmn:sequenceFlow id="f9" sourceRef="correctJD" targetRef="sendJD" />
    <bpmn:sequenceFlow id="f10" sourceRef="provideClarifications" targetRef="sendJD" />
    <bpmn:sequenceFlow id="f11" sourceRef="approve" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
