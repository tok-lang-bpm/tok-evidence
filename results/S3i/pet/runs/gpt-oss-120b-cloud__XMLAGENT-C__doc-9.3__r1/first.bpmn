<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Town Planning Authority" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="laneCoord" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheckConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFinalSchedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSupport" name="Support Officer">
        <bpmn:flowNodeRef>checkSuggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCommittee" name="Committee Members">
        <bpmn:flowNodeRef>checkAdvise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start November scheduling" />
    <bpmn:task id="draftSchedule" name="Draft schedule of meetings for next calendar year and add draft dates to all calendars" />
    <bpmn:task id="checkSuggest" name="Check dates and suggest modifications" />
    <bpmn:task id="recheckConflicts" name="Recheck all dates and look for potential conflicts" />
    <bpmn:task id="sendFinalSchedule" name="Send final schedule of meeting dates to all independent Committee Members" />
    <bpmn:task id="checkAdvise" name="Check diaries and advise Coordination Unit of any conflicts" />
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="draftSchedule" />
    <bpmn:sequenceFlow id="f2" sourceRef="draftSchedule" targetRef="checkSuggest" />
    <bpmn:sequenceFlow id="f3" sourceRef="checkSuggest" targetRef="recheckConflicts" />
    <bpmn:sequenceFlow id="f4" sourceRef="recheckConflicts" targetRef="sendFinalSchedule" />
    <bpmn:sequenceFlow id="f5" sourceRef="sendFinalSchedule" targetRef="checkAdvise" />
    <bpmn:sequenceFlow id="f6" sourceRef="checkAdvise" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>