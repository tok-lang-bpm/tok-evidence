<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANESET">
      <bpmn:lane id="laneCoordination" name="Coordination Unit">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qaCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneSupport" name="Support Officer">
        <bpmn:flowNodeRef>updateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adviseCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>produceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneCommittee" name="Committee Members">
        <bpmn:flowNodeRef>holdMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Dates finalized" />
    <bpmn:task id="updateCalendars" name="Update group calendars, create meeting folders and upload documents" />
    <bpmn:task id="adviseCommittee" name="Advise Committee Members" />
    <bpmn:task id="holdMeeting" name="Hold meeting" />
    <bpmn:task id="produceMinutes" name="Produce meeting minutes with action points" />
    <bpmn:task id="qaCheck" name="QA check minutes" />
    <bpmn:task id="sendMinutes" name="Send minutes to Committee Members" />
    <bpmn:task id="updateRecords" name="Update departmental records" />
    <bpmn:endEvent id="end" name="Process complete" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="updateCalendars" />
    <bpmn:sequenceFlow id="f2" sourceRef="updateCalendars" targetRef="adviseCommittee" />
    <bpmn:sequenceFlow id="f3" sourceRef="adviseCommittee" targetRef="holdMeeting" />
    <bpmn:sequenceFlow id="f4" sourceRef="holdMeeting" targetRef="produceMinutes" />
    <bpmn:sequenceFlow id="f5" sourceRef="produceMinutes" targetRef="qaCheck" />
    <bpmn:sequenceFlow id="f6" sourceRef="qaCheck" targetRef="sendMinutes" />
    <bpmn:sequenceFlow id="f7" sourceRef="sendMinutes" targetRef="updateRecords" />
    <bpmn:sequenceFlow id="f8" sourceRef="updateRecords" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
