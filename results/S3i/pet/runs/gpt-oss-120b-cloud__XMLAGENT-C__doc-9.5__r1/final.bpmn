<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="SystemLane" name="System">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>autoApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>progressEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SupervisorLane" name="Supervisor">
        <bpmn:flowNodeRef>supervisorApprove</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="EmployeeLane" name="Employee">
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Expense report received" />
    <bpmn:task id="receive" name="Receive expense report" />
    <bpmn:exclusiveGateway id="accountCheck" name="Employee has account?" />
    <bpmn:task id="createAccount" name="Create new account" />
    <bpmn:task id="reviewReport" name="Review expense report" />
    <bpmn:boundaryEvent id="timer7d" attachedToRef="reviewReport" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="progressEmail" name="Send approval in progress email" />
    <bpmn:endEvent id="endProgress" name="Progress email sent" />
    <bpmn:boundaryEvent id="timer30d" attachedToRef="reviewReport" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="cancelEmail" name="Send cancellation email" />
    <bpmn:task id="resubmit" name="Employee resubmits expense report" />
    <bpmn:endEvent id="endCancel" name="Process cancelled" />
    <bpmn:exclusiveGateway id="amountCheck" name="Amount under $200?" />
    <bpmn:task id="autoApprove" name="Automatically approve expense report" />
    <bpmn:task id="supervisorApprove" name="Supervisor approves expense report" />
    <bpmn:exclusiveGateway id="approvalDecision" name="Expense approved?" />
    <bpmn:task id="rejectEmail" name="Send rejection email" />
    <bpmn:endEvent id="endReject" name="Process rejected" />
    <bpmn:task id="reimburse" name="Reimburse employee to direct deposit bank account" />
    <bpmn:endEvent id="endSuccess" name="Process completed" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="accountCheck" />
    <bpmn:sequenceFlow id="f3_yes" sourceRef="accountCheck" targetRef="reviewReport" name="yes" />
    <bpmn:sequenceFlow id="f3_no" sourceRef="accountCheck" targetRef="createAccount" name="no" />
    <bpmn:sequenceFlow id="f4" sourceRef="createAccount" targetRef="reviewReport" />
    <bpmn:sequenceFlow id="f5" sourceRef="reviewReport" targetRef="amountCheck" />
    <bpmn:sequenceFlow id="f6_under" sourceRef="amountCheck" targetRef="autoApprove" name="under $200" />
    <bpmn:sequenceFlow id="f7_over" sourceRef="amountCheck" targetRef="supervisorApprove" name="over $200" />
    <bpmn:sequenceFlow id="f8_auto" sourceRef="autoApprove" targetRef="reimburse" />
    <bpmn:sequenceFlow id="f9_super" sourceRef="supervisorApprove" targetRef="approvalDecision" />
    <bpmn:sequenceFlow id="f10_yes" sourceRef="approvalDecision" targetRef="reimburse" name="approved" />
    <bpmn:sequenceFlow id="f11_no" sourceRef="approvalDecision" targetRef="rejectEmail" name="rejected" />
    <bpmn:sequenceFlow id="f12_reject" sourceRef="rejectEmail" targetRef="endReject" />
    <bpmn:sequenceFlow id="f13_reimburse" sourceRef="reimburse" targetRef="endSuccess" />
    <!-- Boundary event flows -->
    <bpmn:sequenceFlow id="f14_progress" sourceRef="timer7d" targetRef="progressEmail" />
    <bpmn:sequenceFlow id="f15_progressEnd" sourceRef="progressEmail" targetRef="endProgress" />
    <bpmn:sequenceFlow id="f16_cancel" sourceRef="timer30d" targetRef="cancelEmail" />
    <bpmn:sequenceFlow id="f17_resubmit" sourceRef="cancelEmail" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f18_cancelEnd" sourceRef="resubmit" targetRef="endCancel" />
  </bpmn:process>
</bpmn:definitions>
