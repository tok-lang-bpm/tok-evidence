<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room service at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room service at The Evanstonian" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveSom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>wine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>holdbill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Room service call received" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:task id="submit" name="Submit the order ticket to the kitchen" />
    <bpmn:exclusiveGateway id="alc" name="Order includes wine or other alcoholic beverage?" />
    <bpmn:task id="giveSom" name="Give the order to the sommelier" />
    <bpmn:exclusiveGateway id="merged" name="Order passed on" />
    <bpmn:task id="assign" name="Assign the order to the waiter" />
    <bpmn:parallelGateway id="fork" name="Split work" />
    <bpmn:task id="prep" name="Prepare the food" />
    <bpmn:task id="wine" name="Fetch wine from the cellar and prepare other alcoholic beverages" />
    <bpmn:task id="cart" name="Ready the cart" />
    <bpmn:task id="drinks" name="Prepare the nonalcoholic drinks" />
    <bpmn:parallelGateway id="joined" name="Work ready" />
    <bpmn:task id="deliver" name="Deliver the food, wine and cart to the guest's room" />
    <bpmn:task id="back" name="Return to the room-service station" />
    <bpmn:exclusiveGateway id="bill" name="Another order to prepare or deliver?" />
    <bpmn:task id="holdbill" name="Wait to do the billing" />
    <bpmn:exclusiveGateway id="billed" name="Billing due" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="done" name="Guest account debited" />
    <bpmn:sequenceFlow id="f-received-take" sourceRef="received" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-submit" sourceRef="take" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-alc" sourceRef="submit" targetRef="alc" />
    <bpmn:sequenceFlow id="f-alc-giveSom" name="yes" sourceRef="alc" targetRef="giveSom" />
    <bpmn:sequenceFlow id="f-alc-merged" name="no" sourceRef="alc" targetRef="merged" />
    <bpmn:sequenceFlow id="f-giveSom-wine" sourceRef="giveSom" targetRef="wine" />
    <bpmn:sequenceFlow id="f-wine-merged" sourceRef="wine" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-assign" sourceRef="merged" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-fork" sourceRef="assign" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-prep" sourceRef="fork" targetRef="prep" />
    <bpmn:sequenceFlow id="f-prep-joined" sourceRef="prep" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-cart" sourceRef="fork" targetRef="cart" />
    <bpmn:sequenceFlow id="f-cart-joined" sourceRef="cart" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-drinks" sourceRef="fork" targetRef="drinks" />
    <bpmn:sequenceFlow id="f-drinks-joined" sourceRef="drinks" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-deliver" sourceRef="joined" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-back" sourceRef="deliver" targetRef="back" />
    <bpmn:sequenceFlow id="f-back-bill" sourceRef="back" targetRef="bill" />
    <bpmn:sequenceFlow id="f-bill-holdbill" name="yes" sourceRef="bill" targetRef="holdbill" />
    <bpmn:sequenceFlow id="f-bill-billed" name="no" sourceRef="bill" targetRef="billed" />
    <bpmn:sequenceFlow id="f-holdbill-billed" sourceRef="holdbill" targetRef="billed" />
    <bpmn:sequenceFlow id="f-billed-debit" sourceRef="billed" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-done" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
