tok 1.0 "Room service at The Evanstonian"

pool hotel "The Evanstonian"
  lane manager "Room-service manager"
    start received "Room service call received"
    task take "Take down the order"
    task submit "Submit the order ticket to the kitchen"
    xor alc "Order includes wine or other alcoholic beverage?"
    task giveSom "Give the order to the sommelier"
    xor merged "Order passed on"
    task assign "Assign the order to the waiter"
    and fork "Split work"
  lane kitchen "Kitchen"
    task prep "Prepare the food"
  lane sommelier "Sommelier"
    task wine "Fetch wine from the cellar and prepare other alcoholic beverages"
  lane waiter "Waiter"
    task cart "Ready the cart"
    task drinks "Prepare the nonalcoholic drinks"
    and joined "Work ready"
    task deliver "Deliver the food, wine and cart to the guest's room"
    task back "Return to the room-service station"
    xor bill "Another order to prepare or deliver?"
    task holdbill "Wait to do the billing"
    xor billed "Billing due"
    task debit "Debit the guest's account"
    end done "Guest account debited"

flow received -> take -> submit -> alc
flow alc -> giveSom "yes"
flow alc -> merged "no"
flow giveSom -> wine -> merged
flow merged -> assign -> fork
flow fork -> prep -> joined
flow fork -> cart -> joined
flow fork -> drinks -> joined
flow joined -> deliver -> back -> bill
flow bill -> holdbill "yes"
flow bill -> billed "no"
flow holdbill -> billed
flow billed -> debit -> done
