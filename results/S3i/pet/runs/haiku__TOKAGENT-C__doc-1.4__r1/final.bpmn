<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Going public" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_SEC_clearance" name="SEC clearance" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="issuer" name="Company" processRef="issuer-process" />
  </bpmn:collaboration>
  <bpmn:process id="issuer-process" name="Going public" isExecutable="false">
    <bpmn:laneSet id="issuer-lanes">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bluesky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="decided" name="Company decides to go public" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="bluesky" name="Check the issue against the blue-sky laws" />
    <bpmn:task id="roadshow" name="Arrange a road show for potential investors" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:intermediateCatchEvent id="clearance" name="SEC clearance received">
      <bpmn:messageEventDefinition id="clearance-def" messageRef="Message_SEC_clearance" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="reason" name="Any reason not to offer it?" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="offered" name="Stock offered to the public" />
    <bpmn:endEvent id="stopped" name="Offering not made" />
    <bpmn:sequenceFlow id="f-decided-select" sourceRef="decided" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-advise" sourceRef="select" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-prepare" sourceRef="advise" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-split" sourceRef="prepare" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-register" sourceRef="split" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-joined" sourceRef="register" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-bluesky" sourceRef="split" targetRef="bluesky" />
    <bpmn:sequenceFlow id="f-bluesky-joined" sourceRef="bluesky" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-roadshow" sourceRef="split" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f-roadshow-joined" sourceRef="roadshow" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-firm" sourceRef="split" targetRef="firm" />
    <bpmn:sequenceFlow id="f-firm-joined" sourceRef="firm" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-clearance" sourceRef="joined" targetRef="clearance" />
    <bpmn:sequenceFlow id="f-clearance-fix" sourceRef="clearance" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-commit" sourceRef="fix" targetRef="commit" />
    <bpmn:sequenceFlow id="f-commit-reason" sourceRef="commit" targetRef="reason" />
    <bpmn:sequenceFlow id="f-reason-stopped" name="yes" sourceRef="reason" targetRef="stopped" />
    <bpmn:sequenceFlow id="f-reason-offer" name="no" sourceRef="reason" targetRef="offer" />
    <bpmn:sequenceFlow id="f-offer-offered" sourceRef="offer" targetRef="offered" />
  </bpmn:process>
</bpmn:definitions>
