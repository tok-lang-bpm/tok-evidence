tok 1.0 "Going public"

pool issuer "Company"
  lane company "Company"
    start decided "Company decides to go public"
    task select "Select the underwriters"
  lane underwriters "Underwriters"
    task advise "Provide procedural and financial advice"
    task prepare "Prepare the registration statement"
    and split
    task register "Register the issue with the SEC"
    task bluesky "Check the issue against the blue-sky laws"
    task roadshow "Arrange a road show for potential investors"
    task firm "Firm up the issue price"
    and joined
    catch clearance "SEC clearance received" message="SEC clearance"
    task fix "Fix the issue price"
    task commit "Enter into a firm commitment to buy the stock"
    xor reason "Any reason not to offer it?"
    task offer "Offer the stock to the public"
    end offered "Stock offered to the public"
    end stopped "Offering not made"

flow decided -> select -> advise -> prepare -> split
flow split -> register -> joined
flow split -> bluesky -> joined
flow split -> roadshow -> joined
flow split -> firm -> joined
flow joined -> clearance -> fix -> commit -> reason
flow reason -> stopped "yes"
flow reason -> offer "no"
flow offer -> offered