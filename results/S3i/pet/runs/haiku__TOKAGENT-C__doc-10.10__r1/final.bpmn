<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Fault handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Fault handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="detector" name="Fault detector">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>suspected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolveGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolveMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Failure reported" />
    <bpmn:task id="report" name="Report the failure to the MPO" />
    <bpmn:startEvent id="suspected" name="Suspicion of own fault" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="confirmed" name="Failure confirmed?" />
    <bpmn:task id="reject" name="Reject the failure of the fault detector" />
    <bpmn:endEvent id="rejected" name="Failure rejected" />
    <bpmn:task id="confirm" name="Confirm the failure of the fault detector" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="informGO" name="Inform the GO about the failure" />
    <bpmn:task id="informMSP" name="Inform the MSP about the failure" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="share" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="resolveGO" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="resolveMSP" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="join2" />
    <bpmn:endEvent id="resolved" name="Interference resolved" />
    <bpmn:sequenceFlow id="f-reported-report" sourceRef="reported" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-merged" sourceRef="report" targetRef="merged" />
    <bpmn:sequenceFlow id="f-suspected-merged" sourceRef="suspected" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-examine" sourceRef="merged" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-confirmed" sourceRef="examine" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-reject" name="no" sourceRef="confirmed" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirmed-confirm" name="yes" sourceRef="confirmed" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-split1" sourceRef="confirm" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-informGO" sourceRef="split1" targetRef="informGO" />
    <bpmn:sequenceFlow id="f-split1-informMSP" sourceRef="split1" targetRef="informMSP" />
    <bpmn:sequenceFlow id="f-informGO-join1" sourceRef="informGO" targetRef="join1" />
    <bpmn:sequenceFlow id="f-informMSP-join1" sourceRef="informMSP" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-fix" sourceRef="join1" targetRef="fix" />
    <bpmn:sequenceFlow id="f-fix-share" sourceRef="fix" targetRef="share" />
    <bpmn:sequenceFlow id="f-share-split2" sourceRef="share" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-resolveGO" sourceRef="split2" targetRef="resolveGO" />
    <bpmn:sequenceFlow id="f-split2-resolveMSP" sourceRef="split2" targetRef="resolveMSP" />
    <bpmn:sequenceFlow id="f-resolveGO-join2" sourceRef="resolveGO" targetRef="join2" />
    <bpmn:sequenceFlow id="f-resolveMSP-join2" sourceRef="resolveMSP" targetRef="join2" />
    <bpmn:sequenceFlow id="f-join2-resolved" sourceRef="join2" targetRef="resolved" />
  </bpmn:process>
</bpmn:definitions>
