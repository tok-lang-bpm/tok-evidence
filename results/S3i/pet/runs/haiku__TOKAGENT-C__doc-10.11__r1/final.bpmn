<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement exchange" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Readings" name="Readings" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
    <bpmn:participant id="sp" name="SP" />
    <bpmn:messageFlow id="m-transmit-sp" name="Readings" sourceRef="transmit" targetRef="sp" messageRef="Message_Readings" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measurement exchange" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendchg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>readok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failinf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendvals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Measurements needed" />
    <bpmn:task id="request" name="Request the measurements from the MSP" />
    <bpmn:task id="processv" name="Process the measured values" />
    <bpmn:task id="sendchg" name="Send the changed values to the MSP" />
    <bpmn:task id="transmit" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="done" name="Readings transmitted" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="accepted" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny the request of the GO" />
    <bpmn:task id="perform" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="readok" name="Reading successful?" />
    <bpmn:task id="failinf" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="sendvals" name="Transmit the measured values to the GO" />
    <bpmn:endEvent id="failed" name="Failure reported" />
    <bpmn:sequenceFlow id="f-requested-request" sourceRef="requested" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-check" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-accepted" sourceRef="check" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-perform" name="yes" sourceRef="accepted" targetRef="perform" />
    <bpmn:sequenceFlow id="f-accepted-deny" name="no" sourceRef="accepted" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-failinf" sourceRef="deny" targetRef="failinf" />
    <bpmn:sequenceFlow id="f-perform-readok" sourceRef="perform" targetRef="readok" />
    <bpmn:sequenceFlow id="f-readok-sendvals" name="yes" sourceRef="readok" targetRef="sendvals" />
    <bpmn:sequenceFlow id="f-readok-failinf" name="no" sourceRef="readok" targetRef="failinf" />
    <bpmn:sequenceFlow id="f-failinf-failed" sourceRef="failinf" targetRef="failed" />
    <bpmn:sequenceFlow id="f-sendvals-processv" sourceRef="sendvals" targetRef="processv" />
    <bpmn:sequenceFlow id="f-processv-sendchg" sourceRef="processv" targetRef="sendchg" />
    <bpmn:sequenceFlow id="f-sendchg-transmit" sourceRef="sendchg" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-done" sourceRef="transmit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
