tok 1.0 "Transaction data request"

pool org "Organisation"
  lane inq "INQ"
    start needed "Transaction data request needed"
    task transmit "Transmit the transaction data request"
  lane ip "IP"
    task check "Check the request of the INQ"
    xor outcome "Request examined?"
    task send "Transmit the data"
    task reject "Reject the request"
    end answered "Question of the INQ answered with data"
    end rejected "Question of the INQ answered with rejection"

flow needed -> transmit -> check -> outcome
flow outcome -> send "yes"
flow outcome -> reject "no"
flow send -> answered
flow reject -> rejected
