<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill examination and invoice confirmation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Bill examination and invoice confirmation" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>send_temp_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_equip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>send_temp_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_read</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>which</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ex_temp_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ex_temp_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ex_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ex_equip_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>ex_equip_mpon</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="send_temp_mpoo" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="send_equip" name="Send the bill for the equipment acquisition" />
    <bpmn:task id="send_temp_mspo" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="send_read" name="Send the bill for additional readings" />
    <bpmn:startEvent id="bill" name="Bill received" />
    <bpmn:exclusiveGateway id="which" name="Which bill is sent?" />
    <bpmn:task id="ex_temp_mpoo" name="Examine the bill" />
    <bpmn:task id="ex_temp_mspo" name="Examine the bill" />
    <bpmn:task id="ex_read" name="Examine the bill" />
    <bpmn:exclusiveGateway id="equip_to" name="Examined by MPON or GO?" />
    <bpmn:task id="ex_equip_go" name="Examine the bill" />
    <bpmn:exclusiveGateway id="examined" />
    <bpmn:exclusiveGateway id="decide" name="Confirm or reject the invoice?" />
    <bpmn:task id="confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject" name="Reject the invoice" />
    <bpmn:endEvent id="paid" name="Invoice confirmed with payment advice" />
    <bpmn:endEvent id="rejected" name="Invoice rejected" />
    <bpmn:task id="ex_equip_mpon" name="Examine the bill" />
    <bpmn:sequenceFlow id="f-bill-which" sourceRef="bill" targetRef="which" />
    <bpmn:sequenceFlow id="f-which-send_temp_mpoo" name="MPOO: temporary continuation" sourceRef="which" targetRef="send_temp_mpoo" />
    <bpmn:sequenceFlow id="f-which-send_temp_mspo" name="MSPO: temporary continuation" sourceRef="which" targetRef="send_temp_mspo" />
    <bpmn:sequenceFlow id="f-which-send_read" name="MSPO: additional readings" sourceRef="which" targetRef="send_read" />
    <bpmn:sequenceFlow id="f-which-send_equip" name="MPOO: equipment acquisition" sourceRef="which" targetRef="send_equip" />
    <bpmn:sequenceFlow id="f-send_temp_mpoo-ex_temp_mpoo" sourceRef="send_temp_mpoo" targetRef="ex_temp_mpoo" />
    <bpmn:sequenceFlow id="f-ex_temp_mpoo-examined" sourceRef="ex_temp_mpoo" targetRef="examined" />
    <bpmn:sequenceFlow id="f-send_temp_mspo-ex_temp_mspo" sourceRef="send_temp_mspo" targetRef="ex_temp_mspo" />
    <bpmn:sequenceFlow id="f-ex_temp_mspo-examined" sourceRef="ex_temp_mspo" targetRef="examined" />
    <bpmn:sequenceFlow id="f-send_read-ex_read" sourceRef="send_read" targetRef="ex_read" />
    <bpmn:sequenceFlow id="f-ex_read-examined" sourceRef="ex_read" targetRef="examined" />
    <bpmn:sequenceFlow id="f-send_equip-equip_to" sourceRef="send_equip" targetRef="equip_to" />
    <bpmn:sequenceFlow id="f-equip_to-ex_equip_mpon" name="MPON" sourceRef="equip_to" targetRef="ex_equip_mpon" />
    <bpmn:sequenceFlow id="f-equip_to-ex_equip_go" name="GO" sourceRef="equip_to" targetRef="ex_equip_go" />
    <bpmn:sequenceFlow id="f-ex_equip_mpon-examined" sourceRef="ex_equip_mpon" targetRef="examined" />
    <bpmn:sequenceFlow id="f-ex_equip_go-examined" sourceRef="ex_equip_go" targetRef="examined" />
    <bpmn:sequenceFlow id="f-examined-decide" sourceRef="examined" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="confirmed" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decide-reject" name="rejected" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-paid" sourceRef="confirm" targetRef="paid" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
