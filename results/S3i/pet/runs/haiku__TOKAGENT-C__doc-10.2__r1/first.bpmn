<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Meter operation registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Failure_of_the_entire_process" name="Failure of the entire process" />
  <bpmn:message id="Message_Successful_completion_of_the_entire_process" name="Successful completion of the entire process" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="market" name="Metering market" processRef="market-process" />
  </bpmn:collaboration>
  <bpmn:process id="market-process" name="Meter operation registration" isExecutable="false">
    <bpmn:laneSet id="market-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpooReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMsposReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doneRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpooFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMsposFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpooOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMsposOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lateEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>changes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Meter operation" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="accepted" name="Application accepted?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:task id="informMpooReg" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="informMsposReg" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:inclusiveGateway id="equipSplit" name="Equipment acquisition and / or changes?" />
    <bpmn:inclusiveGateway id="equipJoin" />
    <bpmn:eventBasedGateway id="wait" name="Report of the MPON received?" />
    <bpmn:intermediateCatchEvent id="failRep" name="Failure of the entire process reported">
      <bpmn:messageEventDefinition id="failRep-def" messageRef="Message_Failure_of_the_entire_process" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="doneRep" name="Successful completion reported">
      <bpmn:messageEventDefinition id="doneRep-def" messageRef="Message_Successful_completion_of_the_entire_process" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="late" name="Maximum time limit passed">
      <bpmn:timerEventDefinition id="late-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="confirmFail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="informMpooFail" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="informMsposFail" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:endEvent id="failed" name="Failure of the assignment confirmed" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confirmAssign" name="Confirm the assignment to the MPON" />
    <bpmn:task id="informMpooOk" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="informMsposOk" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="informSp" name="Inform the SP about the assignment of the MPON" />
    <bpmn:endEvent id="done" name="Assignment completed" />
    <bpmn:task id="informLate" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="lateEnd" name="Failure by deadline reported" />
    <bpmn:task id="changes" name="Perform the equipment changes" />
    <bpmn:sequenceFlow id="f-begin-report" sourceRef="begin" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-examine" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-accepted" sourceRef="examine" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accepted-confirm" name="yes" sourceRef="accepted" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-informMpooReg" sourceRef="confirm" targetRef="informMpooReg" />
    <bpmn:sequenceFlow id="f-informMpooReg-informMsposReg" sourceRef="informMpooReg" targetRef="informMsposReg" />
    <bpmn:sequenceFlow id="f-informMsposReg-equipSplit" sourceRef="informMsposReg" targetRef="equipSplit" />
    <bpmn:sequenceFlow id="f-equipSplit-acquire" name="acquisition" sourceRef="equipSplit" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-equipSplit-changes" name="changes" sourceRef="equipSplit" targetRef="changes" />
    <bpmn:sequenceFlow id="f-acquire-equipJoin" sourceRef="acquire" targetRef="equipJoin" />
    <bpmn:sequenceFlow id="f-changes-equipJoin" sourceRef="changes" targetRef="equipJoin" />
    <bpmn:sequenceFlow id="f-equipJoin-wait" sourceRef="equipJoin" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-failRep" sourceRef="wait" targetRef="failRep" />
    <bpmn:sequenceFlow id="f-wait-doneRep" sourceRef="wait" targetRef="doneRep" />
    <bpmn:sequenceFlow id="f-wait-late" sourceRef="wait" targetRef="late" />
    <bpmn:sequenceFlow id="f-failRep-confirmFail" sourceRef="failRep" targetRef="confirmFail" />
    <bpmn:sequenceFlow id="f-confirmFail-informMpooFail" sourceRef="confirmFail" targetRef="informMpooFail" />
    <bpmn:sequenceFlow id="f-informMpooFail-informMsposFail" sourceRef="informMpooFail" targetRef="informMsposFail" />
    <bpmn:sequenceFlow id="f-informMsposFail-failed" sourceRef="informMsposFail" targetRef="failed" />
    <bpmn:sequenceFlow id="f-doneRep-assign" sourceRef="doneRep" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-confirmAssign" sourceRef="assign" targetRef="confirmAssign" />
    <bpmn:sequenceFlow id="f-confirmAssign-informMpooOk" sourceRef="confirmAssign" targetRef="informMpooOk" />
    <bpmn:sequenceFlow id="f-informMpooOk-informMsposOk" sourceRef="informMpooOk" targetRef="informMsposOk" />
    <bpmn:sequenceFlow id="f-informMsposOk-informSp" sourceRef="informMsposOk" targetRef="informSp" />
    <bpmn:sequenceFlow id="f-informSp-done" sourceRef="informSp" targetRef="done" />
    <bpmn:sequenceFlow id="f-late-informLate" sourceRef="late" targetRef="informLate" />
    <bpmn:sequenceFlow id="f-informLate-lateEnd" sourceRef="informLate" targetRef="lateEnd" />
  </bpmn:process>
</bpmn:definitions>
