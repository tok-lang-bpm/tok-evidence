<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Deregistration of the MPOO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Deregistration of the MPOO" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="lmpoo" name="MPOO">
        <bpmn:flowNodeRef>dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmCont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lgo" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmPrelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>obligeMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinOblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="dereg" name="Deregistration needed" />
    <bpmn:task id="deregister" name="Deregister the MPOO at the GO" />
    <bpmn:task id="confirmCont" name="Confirm the continuation to the MPOO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="accepted" name="Deregistration accepted?" />
    <bpmn:task id="confirmPrelim" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige" name="Oblige the MPOO to continue the operations?" />
    <bpmn:task id="obligeMpoo" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="joinOblige" />
    <bpmn:task id="acquire" name="Perform the equipment acquisition and/or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="informMpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="informMspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informSp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="done" name="Assignment of the GO as MPO completed" />
    <bpmn:sequenceFlow id="f-dereg-deregister" sourceRef="dereg" targetRef="deregister" />
    <bpmn:sequenceFlow id="f-deregister-verify" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-accepted" sourceRef="verify" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-confirmPrelim" name="yes" sourceRef="accepted" targetRef="confirmPrelim" />
    <bpmn:sequenceFlow id="f-accepted-reject" name="no" sourceRef="accepted" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirmPrelim-prepare" sourceRef="confirmPrelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige" sourceRef="prepare" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige-obligeMpoo" name="yes" sourceRef="oblige" targetRef="obligeMpoo" />
    <bpmn:sequenceFlow id="f-oblige-joinOblige" name="no" sourceRef="oblige" targetRef="joinOblige" />
    <bpmn:sequenceFlow id="f-obligeMpoo-confirmCont" sourceRef="obligeMpoo" targetRef="confirmCont" />
    <bpmn:sequenceFlow id="f-confirmCont-joinOblige" sourceRef="confirmCont" targetRef="joinOblige" />
    <bpmn:sequenceFlow id="f-joinOblige-acquire" sourceRef="joinOblige" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-acquire-assign" sourceRef="acquire" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-informMpoo" sourceRef="assign" targetRef="informMpoo" />
    <bpmn:sequenceFlow id="f-informMpoo-informMspo" sourceRef="informMpoo" targetRef="informMspo" />
    <bpmn:sequenceFlow id="f-informMspo-informSp" sourceRef="informMspo" targetRef="informSp" />
    <bpmn:sequenceFlow id="f-informSp-done" sourceRef="informSp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
