tok 1.0 "Deregistration of the MPOO"

pool org "Organisation"
  lane lmpoo "MPOO"
    start dereg "Deregistration needed"
    task deregister "Deregister the MPOO at the GO"
    task confirmCont "Confirm the continuation to the MPOO"
  lane lgo "GO"
    task verify "Verify the deregistration"
    xor accepted "Deregistration accepted?"
    task confirmPrelim "Preliminarily confirm the deregistration of the MPOO"
    task reject "Reject the deregistration of the MPOO"
    end rejected "Deregistration rejected"
    task prepare "Prepare the readmission of the measuring point"
    xor oblige "Oblige the MPOO to continue the operations?"
    task obligeMpoo "Oblige the MPOO to continue the operations"
    xor joinOblige
    task acquire "Perform the equipment acquisition and/or equipment changes"
    task assign "Assign the GO as MPO"
    task informMpoo "Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO"
    task informMspo "Inform the MSPO about the assignment of the GO"
    task informSp "Inform the SP about the assignment of the GO"
    end done "Assignment of the GO as MPO completed"

flow dereg -> deregister -> verify -> accepted
flow accepted -> confirmPrelim "yes"
flow accepted -> reject "no"
flow reject -> rejected
flow confirmPrelim -> prepare -> oblige
flow oblige -> obligeMpoo "yes"
flow oblige -> joinOblige "no"
flow obligeMpoo -> confirmCont -> joinOblige
flow joinOblige -> acquire -> assign -> informMpoo -> informMspo -> informSp -> done
