<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Measuring point operator" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="requester" name="SP / PU / GO">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>caused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implemented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Change requested" />
    <bpmn:startEvent id="caused" name="Change caused by the MPO" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="confirmed" name="Request confirmed?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="implemented" name="Change implemented?" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notify" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="done" name="Change implemented and reported" />
    <bpmn:endEvent id="failed" name="Changes failed" />
    <bpmn:sequenceFlow id="f-requested-review" sourceRef="requested" targetRef="review" />
    <bpmn:sequenceFlow id="f-caused-review" sourceRef="caused" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-confirmed" sourceRef="review" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-reject" name="rejected" sourceRef="confirmed" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirmed-perform" name="confirmed" sourceRef="confirmed" targetRef="perform" />
    <bpmn:sequenceFlow id="f-perform-implemented" sourceRef="perform" targetRef="implemented" />
    <bpmn:sequenceFlow id="f-implemented-report" name="yes" sourceRef="implemented" targetRef="report" />
    <bpmn:sequenceFlow id="f-implemented-notify" name="no" sourceRef="implemented" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-done" sourceRef="report" targetRef="done" />
    <bpmn:sequenceFlow id="f-notify-failed" sourceRef="notify" targetRef="failed" />
  </bpmn:process>
</bpmn:definitions>
