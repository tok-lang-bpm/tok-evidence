tok 1.0 "Measuring point change"

pool office "Measuring point operator"
  lane requester "SP / PU / GO"
    start requested "Change requested"
  lane mpo "MPO"
    start caused "Change caused by the MPO"
    task review "Review the change request"
    xor confirmed "Request confirmed?"
    task reject "Reject the change of the measuring point"
    end rejected "Change rejected"
    task perform "Perform the measuring point change"
    xor implemented "Change implemented?"
    task report "Report the implementation to the SP / PU / GO"
    task notify "Notify the SP / PU / GO about the failure of the changes"
    end done "Change implemented and reported"
    end failed "Changes failed"

flow requested -> review
flow caused -> review
flow review -> confirmed
flow confirmed -> reject "rejected"
flow reject -> rejected
flow confirmed -> perform "confirmed"
flow perform -> implemented
flow implemented -> report "yes"
flow implemented -> notify "no"
flow report -> done
flow notify -> failed
