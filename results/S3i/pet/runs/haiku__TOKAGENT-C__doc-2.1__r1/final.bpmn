<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Restoration_request" name="Restoration request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="Service degradation handling" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>enterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compareSla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineCm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>linkFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handedOver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>significant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reprio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeCs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendDetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>andCs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createCust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendCust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reportRebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinCs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="billing" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjustBilling</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>receiveDetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzeSm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createTroubleSm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendToRp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeSm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineSmCm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cmChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendPerf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perfSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smEnd1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createRestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>andR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveTsr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smEnd2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>receiveRp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>problemCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normalNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzeRp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createTroubleRp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeRp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>includeStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitRp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitRestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trackErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>troubleShoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendTsr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tsrSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="perceive" name="Customer perceives degraded service" />
    <bpmn:task id="sendList" name="Send list of problem parameters" />
    <bpmn:task id="receiveReport" name="Receive service performance and problem resolution report" />
    <bpmn:endEvent id="custEnd" name="Customer process ends" />
    <bpmn:task id="enterReport" name="Enter problem report into system T" />
    <bpmn:task id="compareSla" name="Compare problem report with customer SLA" />
    <bpmn:task id="determineCm" name="Determine counter measures and their priorities" />
    <bpmn:task id="signif" name="Determine customer significance" />
    <bpmn:exclusiveGateway id="premium" name="Customer premium?" default="f-premium-significant" />
    <bpmn:task id="linkFix" name="Link to extra problem fix process" />
    <bpmn:endEvent id="handedOver" name="Problem handed over to fix process" />
    <bpmn:exclusiveGateway id="significant" name="Significance affects counter measures?" default="f-significant-mergeCs" />
    <bpmn:task id="reprio" name="Re-prioritize counter measures" />
    <bpmn:exclusiveGateway id="mergeCs" />
    <bpmn:task id="detailed" name="Create detailed problem report" />
    <bpmn:task id="sendDetailed" name="Send detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="mergeResp" />
    <bpmn:task id="receiveResp" name="Receive actual service performance or problem resolution report" />
    <bpmn:parallelGateway id="andCs" />
    <bpmn:task id="createCust" name="Create report for the customer" />
    <bpmn:task id="sendCust" name="Send report to the customer" />
    <bpmn:parallelGateway id="custSplit" />
    <bpmn:task id="reportRebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="joinCs" />
    <bpmn:endEvent id="csEnd" name="Customer Service process ends" />
    <bpmn:task id="adjustBilling" name="Adjust billing" />
    <bpmn:task id="receiveDetailed" name="Receive detailed problem report" />
    <bpmn:task id="investigate" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="analyzable" name="Analyzable by Service Management?" default="f-analyzable-sendToRp" />
    <bpmn:task id="analyzeSm" name="Analyze the problem" />
    <bpmn:task id="createTroubleSm" name="Create trouble report" />
    <bpmn:task id="sendToRp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="receiveStatus" name="Receive status report" />
    <bpmn:exclusiveGateway id="mergeSm" />
    <bpmn:task id="prepareFinal" name="Prepare final status report" />
    <bpmn:task id="determineSmCm" name="Determine counter measures from final status report" />
    <bpmn:exclusiveGateway id="cmChoice" name="Which counter measures are required?" />
    <bpmn:task id="sendPerf" name="Send actual service performance to Customer Service" />
    <bpmn:parallelGateway id="perfSplit" />
    <bpmn:endEvent id="smEnd1" name="Service Management path ends" />
    <bpmn:task id="correct" name="Undertake minor corrective actions" />
    <bpmn:task id="createRestore" name="Create request for automatic resource restoration" />
    <bpmn:task id="sendRestore" name="Send request for automatic resource restoration" />
    <bpmn:parallelGateway id="andR" />
    <bpmn:task id="receiveTsr" name="Receive trouble-shooting report" />
    <bpmn:exclusiveGateway id="mergeRes" />
    <bpmn:task id="createResolution" name="Create problem resolution report" />
    <bpmn:task id="sendResolution" name="Send problem resolution report to Customer Service" />
    <bpmn:parallelGateway id="resSplit" />
    <bpmn:endEvent id="smEnd2" name="Service Management path ends" />
    <bpmn:task id="receiveRp" name="Receive detailed problem report" />
    <bpmn:exclusiveGateway id="problemCheck" name="Problem detected?" default="f-problemCheck-normalNotice" />
    <bpmn:task id="normalNotice" name="Create notification of normal service execution" />
    <bpmn:task id="analyzeRp" name="Analyze the problem" />
    <bpmn:task id="createTroubleRp" name="Create trouble report" />
    <bpmn:exclusiveGateway id="mergeRp" />
    <bpmn:task id="includeStatus" name="Include trouble report or notification in status report" />
    <bpmn:parallelGateway id="splitRp" />
    <bpmn:task id="sendStatus" name="Send status report to Service Management" />
    <bpmn:exclusiveGateway id="mergeWait" />
    <bpmn:receiveTask id="waitRestore" name="Wait for restoration request" messageRef="Message_Restoration_request" />
    <bpmn:boundaryEvent id="timeout" attachedToRef="waitRestore">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="rpTimeout" name="Resource Provisioning terminates process" />
    <bpmn:task id="trackErrors" name="Track all possible errors" />
    <bpmn:task id="correctAll" name="Undertake all necessary corrective actions" />
    <bpmn:task id="troubleShoot" name="Create trouble-shooting report" />
    <bpmn:task id="sendTsr" name="Send trouble-shooting report to Service Management" />
    <bpmn:parallelGateway id="tsrSplit" />
    <bpmn:endEvent id="rpEnd" name="Resource Provisioning process ends" />
    <bpmn:sequenceFlow id="f-perceive-sendList" sourceRef="perceive" targetRef="sendList" />
    <bpmn:sequenceFlow id="f-sendList-enterReport" sourceRef="sendList" targetRef="enterReport" />
    <bpmn:sequenceFlow id="f-enterReport-compareSla" sourceRef="enterReport" targetRef="compareSla" />
    <bpmn:sequenceFlow id="f-compareSla-determineCm" sourceRef="compareSla" targetRef="determineCm" />
    <bpmn:sequenceFlow id="f-determineCm-signif" sourceRef="determineCm" targetRef="signif" />
    <bpmn:sequenceFlow id="f-signif-premium" sourceRef="signif" targetRef="premium" />
    <bpmn:sequenceFlow id="f-premium-linkFix" name="yes" sourceRef="premium" targetRef="linkFix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isPremium = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-linkFix-handedOver" sourceRef="linkFix" targetRef="handedOver" />
    <bpmn:sequenceFlow id="f-premium-significant" name="no" sourceRef="premium" targetRef="significant" />
    <bpmn:sequenceFlow id="f-significant-reprio" name="yes" sourceRef="significant" targetRef="reprio">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isSignificant = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-significant-mergeCs" name="no" sourceRef="significant" targetRef="mergeCs" />
    <bpmn:sequenceFlow id="f-reprio-mergeCs" sourceRef="reprio" targetRef="mergeCs" />
    <bpmn:sequenceFlow id="f-mergeCs-detailed" sourceRef="mergeCs" targetRef="detailed" />
    <bpmn:sequenceFlow id="f-detailed-sendDetailed" sourceRef="detailed" targetRef="sendDetailed" />
    <bpmn:sequenceFlow id="f-sendDetailed-receiveDetailed" sourceRef="sendDetailed" targetRef="receiveDetailed" />
    <bpmn:sequenceFlow id="f-receiveDetailed-investigate" sourceRef="receiveDetailed" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-analyzable" sourceRef="investigate" targetRef="analyzable" />
    <bpmn:sequenceFlow id="f-analyzable-analyzeSm" name="yes" sourceRef="analyzable" targetRef="analyzeSm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isAnalyzable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-analyzable-sendToRp" name="no" sourceRef="analyzable" targetRef="sendToRp" />
    <bpmn:sequenceFlow id="f-analyzeSm-createTroubleSm" sourceRef="analyzeSm" targetRef="createTroubleSm" />
    <bpmn:sequenceFlow id="f-createTroubleSm-mergeSm" sourceRef="createTroubleSm" targetRef="mergeSm" />
    <bpmn:sequenceFlow id="f-sendToRp-receiveRp" sourceRef="sendToRp" targetRef="receiveRp" />
    <bpmn:sequenceFlow id="f-receiveRp-problemCheck" sourceRef="receiveRp" targetRef="problemCheck" />
    <bpmn:sequenceFlow id="f-problemCheck-analyzeRp" name="yes" sourceRef="problemCheck" targetRef="analyzeRp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">problemDetected = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-problemCheck-normalNotice" name="no" sourceRef="problemCheck" targetRef="normalNotice" />
    <bpmn:sequenceFlow id="f-analyzeRp-createTroubleRp" sourceRef="analyzeRp" targetRef="createTroubleRp" />
    <bpmn:sequenceFlow id="f-createTroubleRp-mergeRp" sourceRef="createTroubleRp" targetRef="mergeRp" />
    <bpmn:sequenceFlow id="f-normalNotice-mergeRp" sourceRef="normalNotice" targetRef="mergeRp" />
    <bpmn:sequenceFlow id="f-mergeRp-includeStatus" sourceRef="mergeRp" targetRef="includeStatus" />
    <bpmn:sequenceFlow id="f-includeStatus-splitRp" sourceRef="includeStatus" targetRef="splitRp" />
    <bpmn:sequenceFlow id="f-splitRp-sendStatus" sourceRef="splitRp" targetRef="sendStatus" />
    <bpmn:sequenceFlow id="f-sendStatus-receiveStatus" sourceRef="sendStatus" targetRef="receiveStatus" />
    <bpmn:sequenceFlow id="f-receiveStatus-mergeSm" sourceRef="receiveStatus" targetRef="mergeSm" />
    <bpmn:sequenceFlow id="f-splitRp-mergeWait" sourceRef="splitRp" targetRef="mergeWait" />
    <bpmn:sequenceFlow id="f-mergeWait-waitRestore" sourceRef="mergeWait" targetRef="waitRestore" />
    <bpmn:sequenceFlow id="f-waitRestore-trackErrors" sourceRef="waitRestore" targetRef="trackErrors" />
    <bpmn:sequenceFlow id="f-trackErrors-correctAll" sourceRef="trackErrors" targetRef="correctAll" />
    <bpmn:sequenceFlow id="f-correctAll-troubleShoot" sourceRef="correctAll" targetRef="troubleShoot" />
    <bpmn:sequenceFlow id="f-troubleShoot-sendTsr" sourceRef="troubleShoot" targetRef="sendTsr" />
    <bpmn:sequenceFlow id="f-sendTsr-tsrSplit" sourceRef="sendTsr" targetRef="tsrSplit" />
    <bpmn:sequenceFlow id="f-tsrSplit-rpEnd" sourceRef="tsrSplit" targetRef="rpEnd" />
    <bpmn:sequenceFlow id="f-tsrSplit-receiveTsr" sourceRef="tsrSplit" targetRef="receiveTsr" />
    <bpmn:sequenceFlow id="f-timeout-rpTimeout" sourceRef="timeout" targetRef="rpTimeout" />
    <bpmn:sequenceFlow id="f-mergeSm-prepareFinal" sourceRef="mergeSm" targetRef="prepareFinal" />
    <bpmn:sequenceFlow id="f-prepareFinal-determineSmCm" sourceRef="prepareFinal" targetRef="determineSmCm" />
    <bpmn:sequenceFlow id="f-determineSmCm-cmChoice" sourceRef="determineSmCm" targetRef="cmChoice" />
    <bpmn:sequenceFlow id="f-cmChoice-sendPerf" name="no problem" sourceRef="cmChoice" targetRef="sendPerf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">counterMeasure = "none"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-sendPerf-perfSplit" sourceRef="sendPerf" targetRef="perfSplit" />
    <bpmn:sequenceFlow id="f-perfSplit-smEnd1" sourceRef="perfSplit" targetRef="smEnd1" />
    <bpmn:sequenceFlow id="f-perfSplit-mergeResp" sourceRef="perfSplit" targetRef="mergeResp" />
    <bpmn:sequenceFlow id="f-cmChoice-correct" name="minor" sourceRef="cmChoice" targetRef="correct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">counterMeasure = "minor"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-correct-mergeRes" sourceRef="correct" targetRef="mergeRes" />
    <bpmn:sequenceFlow id="f-cmChoice-createRestore" name="restoration" sourceRef="cmChoice" targetRef="createRestore">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">counterMeasure = "restoration"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-createRestore-sendRestore" sourceRef="createRestore" targetRef="sendRestore" />
    <bpmn:sequenceFlow id="f-sendRestore-andR" sourceRef="sendRestore" targetRef="andR" />
    <bpmn:sequenceFlow id="f-andR-mergeWait" sourceRef="andR" targetRef="mergeWait" />
    <bpmn:sequenceFlow id="f-andR-receiveTsr" sourceRef="andR" targetRef="receiveTsr" />
    <bpmn:sequenceFlow id="f-receiveTsr-mergeRes" sourceRef="receiveTsr" targetRef="mergeRes" />
    <bpmn:sequenceFlow id="f-mergeRes-createResolution" sourceRef="mergeRes" targetRef="createResolution" />
    <bpmn:sequenceFlow id="f-createResolution-sendResolution" sourceRef="createResolution" targetRef="sendResolution" />
    <bpmn:sequenceFlow id="f-sendResolution-resSplit" sourceRef="sendResolution" targetRef="resSplit" />
    <bpmn:sequenceFlow id="f-resSplit-smEnd2" sourceRef="resSplit" targetRef="smEnd2" />
    <bpmn:sequenceFlow id="f-resSplit-mergeResp" sourceRef="resSplit" targetRef="mergeResp" />
    <bpmn:sequenceFlow id="f-mergeResp-receiveResp" sourceRef="mergeResp" targetRef="receiveResp" />
    <bpmn:sequenceFlow id="f-receiveResp-andCs" sourceRef="receiveResp" targetRef="andCs" />
    <bpmn:sequenceFlow id="f-andCs-createCust" sourceRef="andCs" targetRef="createCust" />
    <bpmn:sequenceFlow id="f-createCust-sendCust" sourceRef="createCust" targetRef="sendCust" />
    <bpmn:sequenceFlow id="f-sendCust-custSplit" sourceRef="sendCust" targetRef="custSplit" />
    <bpmn:sequenceFlow id="f-custSplit-joinCs" sourceRef="custSplit" targetRef="joinCs" />
    <bpmn:sequenceFlow id="f-custSplit-receiveReport" sourceRef="custSplit" targetRef="receiveReport" />
    <bpmn:sequenceFlow id="f-receiveReport-custEnd" sourceRef="receiveReport" targetRef="custEnd" />
    <bpmn:sequenceFlow id="f-andCs-reportRebate" sourceRef="andCs" targetRef="reportRebate" />
    <bpmn:sequenceFlow id="f-reportRebate-adjustBilling" sourceRef="reportRebate" targetRef="adjustBilling" />
    <bpmn:sequenceFlow id="f-adjustBilling-joinCs" sourceRef="adjustBilling" targetRef="joinCs" />
    <bpmn:sequenceFlow id="f-joinCs-csEnd" sourceRef="joinCs" targetRef="csEnd" />
  </bpmn:process>
</bpmn:definitions>
