<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Power supplier switch-over" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="New power supplier" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Power supplier switch-over" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_crm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>new_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_service</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS (customer information system)">
        <bpmn:flowNodeRef>cis_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid operator">
        <bpmn:flowNodeRef>go_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute_bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_bill_old</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_go</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old" name="Old supplier">
        <bpmn:flowNodeRef>create_bill_old</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="request" name="Switch-over request" />
    <bpmn:task id="transmit" name="Transmit the customer data to customer service" />
    <bpmn:task id="check_contract" name="Check the contract details" />
    <bpmn:exclusiveGateway id="decide" name="Withdraw from the switch contract within 7 days?" default="f-decide-accepted" />
    <bpmn:task id="withdraw" name="Withdraw from the switch contract" />
    <bpmn:task id="confirm" name="Confirm the switch contract" />
    <bpmn:exclusiveGateway id="accepted" />
    <bpmn:endEvent id="end_customer" name="Process ended for the customer" />
    <bpmn:task id="receive" name="Receive the customer data" />
    <bpmn:task id="enter_crm" name="Enter the customer data object into the CRM system" />
    <bpmn:task id="compare" name="Compare the customer data with the internal customer database" />
    <bpmn:exclusiveGateway id="exists" name="Customer exists in the customer database?" />
    <bpmn:task id="new_customer" name="Create a new customer object" />
    <bpmn:exclusiveGateway id="merge_customer" />
    <bpmn:task id="check_data" name="Check completeness and plausibility" />
    <bpmn:exclusiveGateway id="errors" name="Errors found?" />
    <bpmn:task id="correct" name="Correct the errors using the error list" />
    <bpmn:task id="prepare" name="Prepare the contract documents for the power supplier switch" />
    <bpmn:task id="send_conf" name="Send the confirmation document to the customer" />
    <bpmn:task id="create_contract" name="Create the CIS contract" />
    <bpmn:task id="import_meter" name="Import the meter data into the systems that require it" />
    <bpmn:endEvent id="end_withdrawn" name="Switch contract withdrawn" />
    <bpmn:endEvent id="end_service" name="Process of winning a new customer ended" />
    <bpmn:task id="cis_check" name="Check the contract documents automatically in the CIS" />
    <bpmn:exclusiveGateway id="docs_ok" name="Contract documents generated?" />
    <bpmn:task id="analyze" name="Analyze and resolve the causing issues" />
    <bpmn:task id="send_request" name="Send the request to the grid operator automatically" />
    <bpmn:task id="go_check" name="Check the switch-over request for supplier concurrence and send response comment" />
    <bpmn:exclusiveGateway id="concurrence" name="Supplier concurrence?" />
    <bpmn:task id="inform" name="Inform all involved suppliers and demand the resolution of the conflict" />
    <bpmn:task id="terminate" name="Terminate the sales agreement with the old supplier" />
    <bpmn:parallelGateway id="split_meter" />
    <bpmn:task id="transmit_meter" name="Transmit the meter data to customer service and the old supplier" />
    <bpmn:task id="compute_bill" name="Compute the final billing based on the meter data" />
    <bpmn:task id="send_bill_old" name="Send the final billing to the old supplier" />
    <bpmn:parallelGateway id="bill_split" />
    <bpmn:endEvent id="end_go" name="Process ended for the grid operator" />
    <bpmn:task id="create_bill_old" name="Create and send the final billing to the customer" />
    <bpmn:sequenceFlow id="f-request-transmit" sourceRef="request" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-receive" sourceRef="transmit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-enter_crm" sourceRef="receive" targetRef="enter_crm" />
    <bpmn:sequenceFlow id="f-enter_crm-compare" sourceRef="enter_crm" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-exists" sourceRef="compare" targetRef="exists" />
    <bpmn:sequenceFlow id="f-exists-merge_customer" name="yes" sourceRef="exists" targetRef="merge_customer" />
    <bpmn:sequenceFlow id="f-exists-new_customer" name="no" sourceRef="exists" targetRef="new_customer" />
    <bpmn:sequenceFlow id="f-new_customer-merge_customer" sourceRef="new_customer" targetRef="merge_customer" />
    <bpmn:sequenceFlow id="f-merge_customer-check_data" sourceRef="merge_customer" targetRef="check_data" />
    <bpmn:sequenceFlow id="f-check_data-errors" sourceRef="check_data" targetRef="errors" />
    <bpmn:sequenceFlow id="f-errors-correct" name="yes" sourceRef="errors" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-check_data" sourceRef="correct" targetRef="check_data" />
    <bpmn:sequenceFlow id="f-errors-prepare" name="no" sourceRef="errors" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-cis_check" sourceRef="prepare" targetRef="cis_check" />
    <bpmn:sequenceFlow id="f-cis_check-docs_ok" sourceRef="cis_check" targetRef="docs_ok" />
    <bpmn:sequenceFlow id="f-docs_ok-analyze" name="no" sourceRef="docs_ok" targetRef="analyze" />
    <bpmn:sequenceFlow id="f-analyze-prepare" sourceRef="analyze" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-docs_ok-send_conf" name="yes" sourceRef="docs_ok" targetRef="send_conf" />
    <bpmn:sequenceFlow id="f-send_conf-send_request" sourceRef="send_conf" targetRef="send_request" />
    <bpmn:sequenceFlow id="f-send_request-go_check" sourceRef="send_request" targetRef="go_check" />
    <bpmn:sequenceFlow id="f-go_check-concurrence" sourceRef="go_check" targetRef="concurrence" />
    <bpmn:sequenceFlow id="f-concurrence-inform" name="yes" sourceRef="concurrence" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-go_check" sourceRef="inform" targetRef="go_check" />
    <bpmn:sequenceFlow id="f-concurrence-terminate" name="no" sourceRef="concurrence" targetRef="terminate" />
    <bpmn:sequenceFlow id="f-terminate-create_contract" sourceRef="terminate" targetRef="create_contract" />
    <bpmn:sequenceFlow id="f-create_contract-check_contract" sourceRef="create_contract" targetRef="check_contract" />
    <bpmn:sequenceFlow id="f-check_contract-decide" sourceRef="check_contract" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-withdraw" name="yes, within 7 days" sourceRef="decide" targetRef="withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">withdrawn_within_7_days = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-withdraw-end_withdrawn" sourceRef="withdraw" targetRef="end_withdrawn" />
    <bpmn:sequenceFlow id="f-decide-confirm" name="confirms" sourceRef="decide" targetRef="confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-confirm-accepted" sourceRef="confirm" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-decide-accepted" name="no withdrawal (accepted after 7 days)" sourceRef="decide" targetRef="accepted" />
    <bpmn:sequenceFlow id="f-accepted-split_meter" sourceRef="accepted" targetRef="split_meter" />
    <bpmn:sequenceFlow id="f-split_meter-transmit_meter" sourceRef="split_meter" targetRef="transmit_meter" />
    <bpmn:sequenceFlow id="f-transmit_meter-import_meter" sourceRef="transmit_meter" targetRef="import_meter" />
    <bpmn:sequenceFlow id="f-import_meter-end_service" sourceRef="import_meter" targetRef="end_service" />
    <bpmn:sequenceFlow id="f-split_meter-compute_bill" sourceRef="split_meter" targetRef="compute_bill" />
    <bpmn:sequenceFlow id="f-compute_bill-send_bill_old" sourceRef="compute_bill" targetRef="send_bill_old" />
    <bpmn:sequenceFlow id="f-send_bill_old-bill_split" sourceRef="send_bill_old" targetRef="bill_split" />
    <bpmn:sequenceFlow id="f-bill_split-create_bill_old" sourceRef="bill_split" targetRef="create_bill_old" />
    <bpmn:sequenceFlow id="f-create_bill_old-end_customer" sourceRef="create_bill_old" targetRef="end_customer" />
    <bpmn:sequenceFlow id="f-bill_split-end_go" sourceRef="bill_split" targetRef="end_go" />
  </bpmn:process>
</bpmn:definitions>
