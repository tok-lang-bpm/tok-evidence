<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession request handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Police_report" name="Police report" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="registry" name="Small Claims Registry Operations" processRef="registry-process" />
  </bpmn:collaboration>
  <bpmn:process id="registry-process" name="Warrant possession request handling" isExecutable="false">
    <bpmn:laneSet id="registry-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>asked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fwd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>keep2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="police" name="Queensland Police">
        <bpmn:flowNodeRef>sendrep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="other" name="Other MC internal staff">
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="asked" name="Warrant release needed" />
    <bpmn:task id="sendreq" name="Send the warrant possession request" />
    <bpmn:task id="recv" name="Receive the warrant possession request" />
    <bpmn:task id="fetch" name="Retrieve the SCT file" />
    <bpmn:task id="fwd" name="Forward the SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="hold" name="Store the SCT physical file awaiting the report" />
    <bpmn:intermediateCatchEvent id="report_in" name="Report received">
      <bpmn:messageEventDefinition id="report_in-def" messageRef="Message_Police_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="fetch2" name="Retrieve the respective SCT file" />
    <bpmn:task id="attach" name="Attach the new SCT document" />
    <bpmn:task id="keep2" name="Store the expanded SCT physical file" />
    <bpmn:task id="sendrep" name="Send the report" />
    <bpmn:task id="hand" name="Receive the physical SCT file" />
    <bpmn:endEvent id="done" name="SCT file handed over" />
    <bpmn:sequenceFlow id="f-asked-sendreq" sourceRef="asked" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-recv" sourceRef="sendreq" targetRef="recv" />
    <bpmn:sequenceFlow id="f-recv-fetch" sourceRef="recv" targetRef="fetch" />
    <bpmn:sequenceFlow id="f-fetch-fwd" sourceRef="fetch" targetRef="fwd" />
    <bpmn:sequenceFlow id="f-fwd-hold" sourceRef="fwd" targetRef="hold" />
    <bpmn:sequenceFlow id="f-hold-sendrep" sourceRef="hold" targetRef="sendrep" />
    <bpmn:sequenceFlow id="f-sendrep-report_in" sourceRef="sendrep" targetRef="report_in" />
    <bpmn:sequenceFlow id="f-report_in-fetch2" sourceRef="report_in" targetRef="fetch2" />
    <bpmn:sequenceFlow id="f-fetch2-attach" sourceRef="fetch2" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-keep2" sourceRef="attach" targetRef="keep2" />
    <bpmn:sequenceFlow id="f-keep2-hand" sourceRef="keep2" targetRef="hand" />
    <bpmn:sequenceFlow id="f-hand-done" sourceRef="hand" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
