tok 1.0 "Warrant possession request handling"

pool registry "Small Claims Registry Operations"
  lane party "Party"
    start asked "Warrant release needed"
    task sendreq "Send the warrant possession request"
  lane backoffice "Client Service Back Office"
    task recv "Receive the warrant possession request"
    task fetch "Retrieve the SCT file"
    task fwd "Forward the SCT Warrant Possession to Queensland Police"
    task hold "Store the SCT physical file awaiting the report"
    catch report_in "Report received" message="Police report"
    task fetch2 "Retrieve the respective SCT file"
    task attach "Attach the new SCT document"
    task keep2 "Store the expanded SCT physical file"
  lane police "Queensland Police"
    task sendrep "Send the report"
  lane other "Other MC internal staff"
    task hand "Receive the physical SCT file"
    end done "SCT file handed over"

flow asked -> sendreq -> recv -> fetch -> fwd -> hold -> sendrep -> report_in -> fetch2 -> attach -> keep2 -> hand -> done
