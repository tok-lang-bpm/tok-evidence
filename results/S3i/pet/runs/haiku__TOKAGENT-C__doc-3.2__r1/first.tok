tok 1.0 "Daily court file preparation"

pool court "Court"
  lane staff "Court staff"
    start morning "Morning: files yet to be processed"
    task check "Check the files yet to be processed"
    xor missing "Files missing?"
    task search "Initiate a search for the missing files"
    task track "Physically track the files to the intended location"
    xor ready
    and split
    task handover "Hand the files over to the Associate"
    task lawlist "Distribute the Judge's Lawlist to the relevant people"
    and joined
    task hearings "Conduct the directions hearings"
    end done "Hearings conducted"

flow morning -> check -> missing
flow missing -> search "yes"
flow missing -> track "no"
flow search -> ready
flow track -> ready
flow ready -> split
flow split -> handover -> joined
flow split -> lawlist -> joined
flow joined -> hearings -> done
