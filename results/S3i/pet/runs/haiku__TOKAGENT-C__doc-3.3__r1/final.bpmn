<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim settlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim settlement" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="officer" name="Claims officer">
        <bpmn:flowNodeRef>registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="senior" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="registered" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="recommend" name="Write the settlement recommendation" />
    <bpmn:task id="check" name="Check the settlement recommendation" />
    <bpmn:exclusiveGateway id="ok" name="Claim OK?" />
    <bpmn:task id="return" name="Send the claim back to the claims officer" />
    <bpmn:endEvent id="proceeds" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f-registered-examine" sourceRef="registered" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-recommend" sourceRef="examine" targetRef="recommend" />
    <bpmn:sequenceFlow id="f-recommend-check" sourceRef="recommend" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-proceeds" name="OK" sourceRef="ok" targetRef="proceeds" />
    <bpmn:sequenceFlow id="f-ok-return" name="Not OK" sourceRef="ok" targetRef="return" />
    <bpmn:sequenceFlow id="f-return-recommend" sourceRef="return" targetRef="recommend" />
  </bpmn:process>
</bpmn:definitions>
