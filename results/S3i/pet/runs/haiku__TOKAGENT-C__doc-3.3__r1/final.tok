tok 1.0 "Claim settlement"

pool insurer "Insurer"
  lane officer "Claims officer"
    start registered "Claim registered"
    task examine "Examine the claim"
    task recommend "Write the settlement recommendation"
  lane senior "Senior claims officer"
    task check "Check the settlement recommendation"
    xor ok "Claim OK?"
    task return "Send the claim back to the claims officer"
    end proceeds "Claim handling proceeds"

flow registered -> examine -> recommend -> check -> ok
flow ok -> proceeds "OK"
flow ok -> return "Not OK"
flow return -> recommend
