<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court file mail handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Court Office" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Court file mail handling" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="mpu" name="Mail Processing Unit">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sortbiz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry">
        <bpmn:flowNodeRef>openmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sortgroups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registermail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qcheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>partydet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printfile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Mail from the party collected" />
    <bpmn:task id="collect" name="Collect the mail from the party" />
    <bpmn:task id="sortbiz" name="Sort the unopened mail into business areas" />
    <bpmn:task id="distribute" name="Distribute the mail" />
    <bpmn:task id="openmail" name="Open the mail" />
    <bpmn:task id="sortgroups" name="Sort the mail into groups for distribution" />
    <bpmn:task id="registermail" name="Register the mail in the manual incoming Mail Register" />
    <bpmn:task id="qcheck" name="Perform the quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="requisition" name="Compile a list of requisition explaining the reason for rejection" />
    <bpmn:task id="sendback" name="Send the list of requisition back to the party" />
    <bpmn:endEvent id="rejected" name="Requisition returned to the party" />
    <bpmn:task id="capture" name="Capture the matter details (types of action)" />
    <bpmn:task id="provide" name="Provide the matter details to the Cashier" />
    <bpmn:task id="envelope" name="Put the receipt and copied documents into an envelope" />
    <bpmn:task id="post" name="Post the envelope to the party" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:endEvent id="processed" name="Mail processed" />
    <bpmn:task id="fees" name="Take the applicable fees attached to the mail" />
    <bpmn:parallelGateway id="fork" />
    <bpmn:task id="partydet" name="Capture the Party Details" />
    <bpmn:task id="printfile" name="Print the Physical Court File" />
    <bpmn:sequenceFlow id="f-received-collect" sourceRef="received" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-sortbiz" sourceRef="collect" targetRef="sortbiz" />
    <bpmn:sequenceFlow id="f-sortbiz-distribute" sourceRef="sortbiz" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-distribute-openmail" sourceRef="distribute" targetRef="openmail" />
    <bpmn:sequenceFlow id="f-openmail-sortgroups" sourceRef="openmail" targetRef="sortgroups" />
    <bpmn:sequenceFlow id="f-sortgroups-registermail" sourceRef="sortgroups" targetRef="registermail" />
    <bpmn:sequenceFlow id="f-registermail-qcheck" sourceRef="registermail" targetRef="qcheck" />
    <bpmn:sequenceFlow id="f-qcheck-compliant" sourceRef="qcheck" targetRef="compliant" />
    <bpmn:sequenceFlow id="f-compliant-requisition" name="no" sourceRef="compliant" targetRef="requisition" />
    <bpmn:sequenceFlow id="f-compliant-capture" name="yes" sourceRef="compliant" targetRef="capture" />
    <bpmn:sequenceFlow id="f-requisition-sendback" sourceRef="requisition" targetRef="sendback" />
    <bpmn:sequenceFlow id="f-sendback-rejected" sourceRef="sendback" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-capture-provide" sourceRef="capture" targetRef="provide" />
    <bpmn:sequenceFlow id="f-provide-fees" sourceRef="provide" targetRef="fees" />
    <bpmn:sequenceFlow id="f-fees-fork" sourceRef="fees" targetRef="fork" />
    <bpmn:sequenceFlow id="f-fork-envelope" sourceRef="fork" targetRef="envelope" />
    <bpmn:sequenceFlow id="f-envelope-post" sourceRef="envelope" targetRef="post" />
    <bpmn:sequenceFlow id="f-post-joined" sourceRef="post" targetRef="joined" />
    <bpmn:sequenceFlow id="f-fork-partydet" sourceRef="fork" targetRef="partydet" />
    <bpmn:sequenceFlow id="f-partydet-printfile" sourceRef="partydet" targetRef="printfile" />
    <bpmn:sequenceFlow id="f-printfile-joined" sourceRef="printfile" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-processed" sourceRef="joined" targetRef="processed" />
  </bpmn:process>
</bpmn:definitions>
