tok 1.0 "Claims notification"

pool org "Insurance organization"
  lane claimant "Claimant"
    task returnForms "Return the completed forms"
    task updateForms "Update the forms"
  lane handler "Claims handler"
    start received "Claim received"
    task checkInsured "Check whether the claimant is insured"
    xor insured "Claimant insured?"
    task informReject "Inform the claimant that the claim must be rejected"
    end rejected "Claim rejected"
    task evaluate "Evaluate the severity of the claim"
    xor severity "Simple or complex claim?"
    task sendSimple "Send the simple claim forms"
    task sendComplex "Send the complex claim forms"
    xor sent
    task checkForms "Check the forms for completeness"
    xor complete "Forms provide all relevant details?"
    task informUpdate "Inform the claimant to update the forms"
    task receiveUpdated "Receive the updated forms"
  lane system "Claims Management system"
    task register "Register the claim in the Claims Management system"
    end done "Claims Notification process ended"

flow received -> checkInsured -> insured
flow insured -> informReject "no"
flow insured -> evaluate "yes"
flow informReject -> rejected
flow evaluate -> severity
flow severity -> sendSimple "simple"
flow severity -> sendComplex "complex"
flow sendSimple -> sent
flow sendComplex -> sent
flow sent -> returnForms -> checkForms -> complete
flow complete -> register "yes"
flow complete -> informUpdate "no"
flow informUpdate -> updateForms -> receiveUpdated -> checkForms
flow register -> done
