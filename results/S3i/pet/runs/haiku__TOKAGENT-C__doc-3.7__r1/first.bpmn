<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car accident claim settlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:dataStore id="police-store" name="Police Report database" />
  <bpmn:dataStore id="checklist-store" name="Action Plan Checklist in the Document Management system" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Insurance company" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car accident claim settlement" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="handler" name="Claims handler">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Claims manager">
        <bpmn:flowNodeRef>negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Car accident claim received" />
    <bpmn:task id="search" name="Search the Police Report database">
      <bpmn:ioSpecification id="search-io">
        <bpmn:dataInput id="search-in-1" name="Police Report database" />
        <bpmn:inputSet id="search-inputs">
          <bpmn:dataInputRefs>search-in-1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="search-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="search-dia-1">
        <bpmn:sourceRef>police</bpmn:sourceRef>
        <bpmn:targetRef>search-in-1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="file" name="Put the Police Report and the Claim Documentation in a file" />
    <bpmn:task id="estimate" name="Calculate the initial claim estimate" />
    <bpmn:task id="plan" name="Create the Action Plan">
      <bpmn:ioSpecification id="plan-io">
        <bpmn:dataInput id="plan-in-2" name="Action Plan Checklist in the Document Management system" />
        <bpmn:inputSet id="plan-inputs">
          <bpmn:dataInputRefs>plan-in-2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="plan-outputs" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="plan-dia-2">
        <bpmn:sourceRef>checklist</bpmn:sourceRef>
        <bpmn:targetRef>plan-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="negotiate" name="Negotiate a settlement on the claim estimate" />
    <bpmn:task id="inform" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="done" name="Claim process ended" />
    <bpmn:sequenceFlow id="f-received-search" sourceRef="received" targetRef="search" />
    <bpmn:sequenceFlow id="f-search-file" sourceRef="search" targetRef="file" />
    <bpmn:sequenceFlow id="f-file-estimate" sourceRef="file" targetRef="estimate" />
    <bpmn:sequenceFlow id="f-estimate-plan" sourceRef="estimate" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-negotiate" sourceRef="plan" targetRef="negotiate" />
    <bpmn:sequenceFlow id="f-negotiate-inform" sourceRef="negotiate" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-done" sourceRef="inform" targetRef="done" />
    <bpmn:dataStoreReference id="police" name="Police Report database" dataStoreRef="police-store" />
    <bpmn:dataStoreReference id="checklist" name="Action Plan Checklist in the Document Management system" dataStoreRef="checklist-store" />
  </bpmn:process>
</bpmn:definitions>
