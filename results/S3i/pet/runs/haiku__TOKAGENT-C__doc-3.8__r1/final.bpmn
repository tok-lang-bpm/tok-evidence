<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Car insurance claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Car insurance claim" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>garage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claim" name="Customer has a claim" />
    <bpmn:task id="submit" name="Submit the claim with relevant documentation" />
    <bpmn:task id="check" name="Check the documents for completeness" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="pickup" name="Pick up the claim" />
    <bpmn:task id="checkins" name="Check the insurance" />
    <bpmn:task id="assess" name="Perform the assessment" />
    <bpmn:exclusiveGateway id="positive" name="Assessment positive?" />
    <bpmn:task id="garage" name="Phone the garage to authorise the repairs" />
    <bpmn:task id="pay" name="Schedule the payment" />
    <bpmn:task id="reject" name="Reject the claim" />
    <bpmn:exclusiveGateway id="merged" />
    <bpmn:task id="letter" name="Send a letter to the customer" />
    <bpmn:endEvent id="done" name="Claim process complete" />
    <bpmn:sequenceFlow id="f-claim-submit" sourceRef="claim" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-check" sourceRef="submit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-register" sourceRef="check" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-pickup" sourceRef="register" targetRef="pickup" />
    <bpmn:sequenceFlow id="f-pickup-checkins" sourceRef="pickup" targetRef="checkins" />
    <bpmn:sequenceFlow id="f-checkins-assess" sourceRef="checkins" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-positive" sourceRef="assess" targetRef="positive" />
    <bpmn:sequenceFlow id="f-positive-garage" name="yes" sourceRef="positive" targetRef="garage" />
    <bpmn:sequenceFlow id="f-garage-pay" sourceRef="garage" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-merged" sourceRef="pay" targetRef="merged" />
    <bpmn:sequenceFlow id="f-positive-reject" name="no" sourceRef="positive" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-merged" sourceRef="reject" targetRef="merged" />
    <bpmn:sequenceFlow id="f-merged-letter" sourceRef="merged" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-done" sourceRef="letter" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
