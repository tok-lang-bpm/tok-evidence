tok 1.0 "Car insurance claim"

pool insurer "Car insurer"
  lane customer "Customer"
    start claim "Customer has a claim"
    task submit "Submit the claim with relevant documentation"
  lane notification "Notification department"
    task check "Check the documents for completeness"
    task register "Register the claim"
  lane handling "Handling department"
    task pickup "Pick up the claim"
    task checkins "Check the insurance"
    task assess "Perform the assessment"
    xor positive "Assessment positive?"
    task garage "Phone the garage to authorise the repairs"
    task pay "Schedule the payment"
    task reject "Reject the claim"
    xor merged
    task letter "Send a letter to the customer"
    end done "Claim process complete"

flow claim -> submit -> check -> register -> pickup -> checkins -> assess -> positive
flow positive -> garage "yes"
flow garage -> pay -> merged
flow positive -> reject "no"
flow reject -> merged
flow merged -> letter -> done
