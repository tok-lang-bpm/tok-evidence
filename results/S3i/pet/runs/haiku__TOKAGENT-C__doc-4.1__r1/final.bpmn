<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake procedure" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Mental health care institute" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Intake procedure" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="family" name="Family doctor">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendCopy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="secretariat" name="Secretarial office">
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>connect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fileForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addNotices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fileReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiveCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fileJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>typeTapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addTapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meetJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>provideList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nursing" name="Nursing officer">
        <bpmn:flowNodeRef>inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handIn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="team" name="Team-leader">
        <bpmn:flowNodeRef>staffMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recordList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first" name="First intaker (social-medical worker)">
        <bpmn:flowNodeRef>planMeet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notebook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notesFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checklistFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second" name="Second intaker (physician)">
        <bpmn:flowNodeRef>planMeet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dictate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="notice" name="Need for mental treatment noticed" />
    <bpmn:task id="notify" name="Notify the institute by telephone" />
    <bpmn:task id="sendCopy" name="Send a copy of the medical file" />
    <bpmn:task id="inquire" name="Inquire after the name and residence of the patient" />
    <bpmn:task id="connect" name="Put the doctor through to the nursing officer" />
    <bpmn:task id="storeInfo" name="Store the information of the form in the information system" />
    <bpmn:task id="printInfo" name="Print the information from the information system" />
    <bpmn:exclusiveGateway id="newPatient" name="New patient?" />
    <bpmn:task id="createFile" name="Create a patient file" />
    <bpmn:exclusiveGateway id="newJoin" />
    <bpmn:task id="fileForms" name="Store the registration form and the print in the patient file" />
    <bpmn:task id="cards" name="Produce two registration cards" />
    <bpmn:task id="addNotices" name="Add the new patient to the list of new notices" />
    <bpmn:task id="storeAssign" name="Store the assignment of each patient in the information system" />
    <bpmn:parallelGateway id="splitA" />
    <bpmn:task id="passCards" name="Pass the registration cards to the first and second intaker" />
    <bpmn:exclusiveGateway id="fileReq" name="Medical file required?" />
    <bpmn:task id="letter" name="Prepare and send a letter requesting a copy of the medical file" />
    <bpmn:task id="receiveCopy" name="Receive the copy of the medical file" />
    <bpmn:task id="informSecond" name="Inform the second intaker" />
    <bpmn:task id="addCopy" name="Add the copy to the patient file" />
    <bpmn:exclusiveGateway id="fileJoin" />
    <bpmn:task id="typeTapes" name="Type out the dictaphone tapes" />
    <bpmn:task id="addTapes" name="Add the typed information to the patient file" />
    <bpmn:parallelGateway id="meetJoin" />
    <bpmn:task id="putList" name="Put the patient on the list of patients that reach this status" />
    <bpmn:task id="provideList" name="Provide the team-leader with a list of these patients" />
    <bpmn:task id="inquiry" name="Make a full inquiry into the mental, health and social state of the patient" />
    <bpmn:task id="regForm" name="Record the information on a registration form" />
    <bpmn:task id="handIn" name="Hand in the registration form at the secretarial office" />
    <bpmn:task id="staffMeeting" name="Hold the staff meeting of the medical team on Wednesday" />
    <bpmn:task id="assign" name="Assign each new patient to a first and a second intaker" />
    <bpmn:task id="determine" name="Determine whether the medical file is required" />
    <bpmn:task id="recordList" name="Record the assignments on the assignment list" />
    <bpmn:task id="treatment" name="Formulate the treatment plan with the intakers and the psychiatrist" />
    <bpmn:endEvent id="done" name="Intake procedure ended" />
    <bpmn:task id="planMeet1" name="Plan a meeting with the patient" />
    <bpmn:task id="examine" name="Examine the patient using the standard checklist" />
    <bpmn:task id="notebook" name="Register additional observations in a personal notebook" />
    <bpmn:task id="notesFile" name="Put a copy of the notes in the patient file" />
    <bpmn:task id="checklistFile" name="Add the standard checklist to the patient file" />
    <bpmn:task id="planMeet2" name="Plan the first meeting with the patient" />
    <bpmn:task id="meet2" name="Meet the patient" />
    <bpmn:task id="dictate" name="Record observations on a dictaphone" />
    <bpmn:sequenceFlow id="f-notice-notify" sourceRef="notice" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-inquire" sourceRef="notify" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-connect" sourceRef="inquire" targetRef="connect" />
    <bpmn:sequenceFlow id="f-connect-inquiry" sourceRef="connect" targetRef="inquiry" />
    <bpmn:sequenceFlow id="f-inquiry-regForm" sourceRef="inquiry" targetRef="regForm" />
    <bpmn:sequenceFlow id="f-regForm-handIn" sourceRef="regForm" targetRef="handIn" />
    <bpmn:sequenceFlow id="f-handIn-storeInfo" sourceRef="handIn" targetRef="storeInfo" />
    <bpmn:sequenceFlow id="f-storeInfo-printInfo" sourceRef="storeInfo" targetRef="printInfo" />
    <bpmn:sequenceFlow id="f-printInfo-newPatient" sourceRef="printInfo" targetRef="newPatient" />
    <bpmn:sequenceFlow id="f-newPatient-createFile" name="yes" sourceRef="newPatient" targetRef="createFile" />
    <bpmn:sequenceFlow id="f-newPatient-newJoin" name="no" sourceRef="newPatient" targetRef="newJoin" />
    <bpmn:sequenceFlow id="f-createFile-newJoin" sourceRef="createFile" targetRef="newJoin" />
    <bpmn:sequenceFlow id="f-newJoin-fileForms" sourceRef="newJoin" targetRef="fileForms" />
    <bpmn:sequenceFlow id="f-fileForms-cards" sourceRef="fileForms" targetRef="cards" />
    <bpmn:sequenceFlow id="f-cards-addNotices" sourceRef="cards" targetRef="addNotices" />
    <bpmn:sequenceFlow id="f-addNotices-staffMeeting" sourceRef="addNotices" targetRef="staffMeeting" />
    <bpmn:sequenceFlow id="f-staffMeeting-assign" sourceRef="staffMeeting" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-determine" sourceRef="assign" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-recordList" sourceRef="determine" targetRef="recordList" />
    <bpmn:sequenceFlow id="f-recordList-storeAssign" sourceRef="recordList" targetRef="storeAssign" />
    <bpmn:sequenceFlow id="f-storeAssign-splitA" sourceRef="storeAssign" targetRef="splitA" />
    <bpmn:sequenceFlow id="f-splitA-passCards" sourceRef="splitA" targetRef="passCards" />
    <bpmn:sequenceFlow id="f-passCards-planMeet1" sourceRef="passCards" targetRef="planMeet1" />
    <bpmn:sequenceFlow id="f-planMeet1-examine" sourceRef="planMeet1" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-notebook" sourceRef="examine" targetRef="notebook" />
    <bpmn:sequenceFlow id="f-notebook-notesFile" sourceRef="notebook" targetRef="notesFile" />
    <bpmn:sequenceFlow id="f-notesFile-checklistFile" sourceRef="notesFile" targetRef="checklistFile" />
    <bpmn:sequenceFlow id="f-checklistFile-meetJoin" sourceRef="checklistFile" targetRef="meetJoin" />
    <bpmn:sequenceFlow id="f-splitA-fileReq" sourceRef="splitA" targetRef="fileReq" />
    <bpmn:sequenceFlow id="f-fileReq-letter" name="yes" sourceRef="fileReq" targetRef="letter" />
    <bpmn:sequenceFlow id="f-fileReq-fileJoin" name="no" sourceRef="fileReq" targetRef="fileJoin" />
    <bpmn:sequenceFlow id="f-letter-sendCopy" sourceRef="letter" targetRef="sendCopy" />
    <bpmn:sequenceFlow id="f-sendCopy-receiveCopy" sourceRef="sendCopy" targetRef="receiveCopy" />
    <bpmn:sequenceFlow id="f-receiveCopy-informSecond" sourceRef="receiveCopy" targetRef="informSecond" />
    <bpmn:sequenceFlow id="f-informSecond-addCopy" sourceRef="informSecond" targetRef="addCopy" />
    <bpmn:sequenceFlow id="f-addCopy-fileJoin" sourceRef="addCopy" targetRef="fileJoin" />
    <bpmn:sequenceFlow id="f-fileJoin-planMeet2" sourceRef="fileJoin" targetRef="planMeet2" />
    <bpmn:sequenceFlow id="f-planMeet2-meet2" sourceRef="planMeet2" targetRef="meet2" />
    <bpmn:sequenceFlow id="f-meet2-dictate" sourceRef="meet2" targetRef="dictate" />
    <bpmn:sequenceFlow id="f-dictate-typeTapes" sourceRef="dictate" targetRef="typeTapes" />
    <bpmn:sequenceFlow id="f-typeTapes-addTapes" sourceRef="typeTapes" targetRef="addTapes" />
    <bpmn:sequenceFlow id="f-addTapes-meetJoin" sourceRef="addTapes" targetRef="meetJoin" />
    <bpmn:sequenceFlow id="f-meetJoin-putList" sourceRef="meetJoin" targetRef="putList" />
    <bpmn:sequenceFlow id="f-putList-provideList" sourceRef="putList" targetRef="provideList" />
    <bpmn:sequenceFlow id="f-provideList-treatment" sourceRef="provideList" targetRef="treatment" />
    <bpmn:sequenceFlow id="f-treatment-done" sourceRef="treatment" targetRef="done" />
    <bpmn:textAnnotation id="nFiles">
      <bpmn:text>Patient files are kept at the secretarial office and may not leave the building</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="nFiles-assoc" sourceRef="nFiles" targetRef="createFile" />
    <bpmn:textAnnotation id="nCard">
      <bpmn:text>An intaker keeps the registration card with him during visits and at the office</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="nCard-assoc" sourceRef="nCard" targetRef="passCards" />
  </bpmn:process>
</bpmn:definitions>
