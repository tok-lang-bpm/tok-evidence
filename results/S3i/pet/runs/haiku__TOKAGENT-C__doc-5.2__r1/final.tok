tok 1.0 "Vacations Request"

pool org "Organization"
  lane employee "Employee"
    start needed "Vacation request needed"
    task submit "Submit the vacation request"
    task review "Review the rejection reasons"
    end returned "Application returned to the employee"
  lane supervisor "Immediate supervisor"
    task receive "Receive the vacation request"
    task decide "Approve or reject the vacation request"
    xor approved "Request approved?"
    task notify "Generate a notification to the Human Resources Representative"
  lane hr "Human Resources Representative"
    task manage "Complete the respective management procedures"
    end done "Vacation request processed"

flow needed -> submit -> receive -> decide -> approved
flow approved -> notify "yes"
flow approved -> review "no"
flow notify -> manage -> done
flow review -> returned
