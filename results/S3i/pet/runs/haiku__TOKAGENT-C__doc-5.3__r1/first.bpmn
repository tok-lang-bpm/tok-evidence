<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Office supply request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Office supply request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Immediate supervisor">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askchange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyrej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifychg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="purchase" name="Purchase department">
        <bpmn:flowNodeRef>quotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="submitted" name="Office supplies needed" />
    <bpmn:task id="submit" name="Submit the office supply request" />
    <bpmn:task id="review" name="Review the comments for the change request" />
    <bpmn:endEvent id="changed" name="Change request reviewed" />
    <bpmn:task id="receive" name="Receive the request" />
    <bpmn:exclusiveGateway id="decide" name="Supervisor decision?" />
    <bpmn:task id="reject" name="Reject the request" />
    <bpmn:task id="askchange" name="Ask for a change" />
    <bpmn:task id="approve" name="Approve the request" />
    <bpmn:task id="register" name="Register the requirement" />
    <bpmn:task id="notifyrej" name="Send the notification of the rejection" />
    <bpmn:task id="notifychg" name="Send the notification of the change request" />
    <bpmn:task id="order" name="Generate and send the purchase order" />
    <bpmn:task id="invoice" name="Receive the invoice" />
    <bpmn:task id="notifyres" name="Send the notification of the result" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="completed" name="Request completed" />
    <bpmn:subProcess id="quotes" name="Make quotations">
      <bpmn:startEvent id="qs" name="Quotations needed" />
      <bpmn:task id="quote" name="Make the quotations" />
      <bpmn:endEvent id="qe" name="Quotations made" />
      <bpmn:sequenceFlow id="f-qs-quote" sourceRef="qs" targetRef="quote" />
      <bpmn:sequenceFlow id="f-quote-qe" sourceRef="quote" targetRef="qe" />
    </bpmn:subProcess>
    <bpmn:task id="select" name="Select a vendor" />
    <bpmn:exclusiveGateway id="valid" name="Vendor valid in the system?" />
    <bpmn:task id="choose" name="Choose a different vendor" />
    <bpmn:task id="confirm" name="Confirm the selected vendor" />
    <bpmn:parallelGateway id="split" name="Split" />
    <bpmn:task id="deliver" name="Receive the product delivery" />
    <bpmn:parallelGateway id="joined" name="Join" />
    <bpmn:sequenceFlow id="f-submitted-submit" sourceRef="submitted" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-receive" sourceRef="register" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-decide" sourceRef="receive" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="rejected" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-askchange" name="change required" sourceRef="decide" targetRef="askchange" />
    <bpmn:sequenceFlow id="f-decide-approve" name="approved" sourceRef="decide" targetRef="approve" />
    <bpmn:sequenceFlow id="f-reject-notifyrej" sourceRef="reject" targetRef="notifyrej" />
    <bpmn:sequenceFlow id="f-notifyrej-rejected" sourceRef="notifyrej" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-askchange-notifychg" sourceRef="askchange" targetRef="notifychg" />
    <bpmn:sequenceFlow id="f-notifychg-review" sourceRef="notifychg" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-changed" sourceRef="review" targetRef="changed" />
    <bpmn:sequenceFlow id="f-approve-quotes" sourceRef="approve" targetRef="quotes" />
    <bpmn:sequenceFlow id="f-quotes-select" sourceRef="quotes" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-valid" sourceRef="select" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-confirm" name="yes" sourceRef="valid" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-valid-choose" name="no" sourceRef="valid" targetRef="choose" />
    <bpmn:sequenceFlow id="f-choose-select" sourceRef="choose" targetRef="select" />
    <bpmn:sequenceFlow id="f-confirm-order" sourceRef="confirm" targetRef="order" />
    <bpmn:sequenceFlow id="f-order-split" sourceRef="order" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-deliver" sourceRef="split" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-joined" sourceRef="deliver" targetRef="joined" />
    <bpmn:sequenceFlow id="f-split-invoice" sourceRef="split" targetRef="invoice" />
    <bpmn:sequenceFlow id="f-invoice-joined" sourceRef="invoice" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-notifyres" sourceRef="joined" targetRef="notifyres" />
    <bpmn:sequenceFlow id="f-notifyres-completed" sourceRef="notifyres" targetRef="completed" />
  </bpmn:process>
</bpmn:definitions>
