tok 1.0 "Office supply request"

pool org "Organization"
  lane employee "Employee"
    start submitted "Office supplies needed"
    task submit "Submit the office supply request"
    task review "Review the comments for the change request"
    end changed "Change request reviewed"
  lane supervisor "Immediate supervisor"
    task receive "Receive the request"
    xor decide "Supervisor decision?"
    task reject "Reject the request"
    task askchange "Ask for a change"
    task approve "Approve the request"
  lane system "System"
    task register "Register the requirement"
    task notifyrej "Send the notification of the rejection"
    task notifychg "Send the notification of the change request"
    task order "Generate and send the purchase order"
    task invoice "Receive the invoice"
    task notifyres "Send the notification of the result"
    end rejected "Request rejected"
    end completed "Request completed"
  lane purchase "Purchase department"
    sub quotes "Make quotations"
      start qs "Quotations needed"
      task quote "Make the quotations"
      end qe "Quotations made"
    task select "Select a vendor"
    xor valid "Vendor valid in the system?"
    task choose "Choose a different vendor"
    task confirm "Confirm the selected vendor"
    and split "Split"
    task deliver "Receive the product delivery"
    and joined "Join"

flow submitted -> submit -> register -> receive -> decide
flow decide -> reject "rejected"
flow decide -> askchange "change required"
flow decide -> approve "approved"
flow reject -> notifyrej -> rejected
flow askchange -> notifychg -> review -> changed
flow approve -> quotes -> select -> valid
flow valid -> confirm "yes"
flow valid -> choose "no"
flow choose -> select
flow confirm -> order -> split
flow split -> deliver -> joined
flow split -> invoice -> joined
flow joined -> notifyres -> completed
flow qs -> quote -> qe
