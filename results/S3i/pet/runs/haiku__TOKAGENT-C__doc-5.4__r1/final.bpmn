<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense report handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Payment_confirmed" name="Payment confirmed" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Expense report handling" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payments" name="Payment system">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase the product or service" />
    <bpmn:task id="submit" name="Submit the expense report with receipts" />
    <bpmn:task id="correct" name="Correct the expense report" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:task id="verify" name="Check the receipts against the items" />
    <bpmn:exclusiveGateway id="complete" name="Receipts complete and matching?" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:serviceTask id="pay" name="Pay the expenses in the payment system" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Wait for payment confirmation">
      <bpmn:messageEventDefinition id="confirmed-def" messageRef="Message_Payment_confirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="done" name="Process ended" />
    <bpmn:sequenceFlow id="f-needed-purchase" sourceRef="needed" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approved" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-verify" name="yes" sourceRef="approved" targetRef="verify" />
    <bpmn:sequenceFlow id="f-approved-correct" name="no" sourceRef="approved" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-review" sourceRef="correct" targetRef="review" />
    <bpmn:sequenceFlow id="f-verify-complete" sourceRef="verify" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-accept" name="yes" sourceRef="complete" targetRef="accept" />
    <bpmn:sequenceFlow id="f-complete-correct" name="no" sourceRef="complete" targetRef="correct" />
    <bpmn:sequenceFlow id="f-accept-pay" sourceRef="accept" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-confirmed" sourceRef="pay" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-done" sourceRef="confirmed" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
