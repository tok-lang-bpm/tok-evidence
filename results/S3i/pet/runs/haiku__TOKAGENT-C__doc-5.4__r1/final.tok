tok 1.0 "Expense report handling"

pool company "Company"
  lane employee "Employee"
    start needed "Product or service required"
    task purchase "Purchase the product or service"
    task submit "Submit the expense report with receipts"
    task correct "Correct the expense report"
  lane supervisor "Supervisor"
    task review "Review the expense report"
    xor approved "Report approved?"
  lane treasurer "Treasurer"
    task verify "Check the receipts against the items"
    xor complete "Receipts complete and matching?"
    task accept "Accept the expenses for processing"
  lane payments "Payment system"
    service pay "Pay the expenses in the payment system"
    catch confirmed "Wait for payment confirmation" message="Payment confirmed"
    end done "Process ended"

flow needed -> purchase -> submit -> review -> approved
flow approved -> verify "yes"
flow approved -> correct "no"
flow correct -> review
flow verify -> complete
flow complete -> accept "yes"
flow complete -> correct "no"
flow accept -> pay -> confirmed -> done
