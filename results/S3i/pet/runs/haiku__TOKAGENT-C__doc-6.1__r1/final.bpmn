<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice verification at ACME AG" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice verification at ACME AG" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="sec" name="Secretariat">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Accounting employee">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consultNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardCM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payInstr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cc" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accurate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>markAP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cm" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>over20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnCopy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>boardCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Invoice received on paper or by fax" />
    <bpmn:task id="inspect" name="Inspect the invoice visually" />
    <bpmn:task id="forward" name="Forward the invoice to accounting" />
    <bpmn:task id="create" name="Create the invoice instance in ACME Financial Accounting" />
    <bpmn:task id="checkItems" name="Check the invoice items" />
    <bpmn:task id="docket" name="Note the cost centers and cost center managers on the docket" />
    <bpmn:task id="sendFirst" name="Send the docket and the copy of the invoice to the first cost center manager" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:task id="clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:exclusiveGateway id="consultNeeded" name="Consultation with the cost center managers needed?" />
    <bpmn:task id="consult" name="Consult the cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:task id="resend" name="Send the copy of the invoice to the cost center managers again" />
    <bpmn:task id="forwardCM" name="Forward the copy of the invoice to the commercial manager" />
    <bpmn:task id="resolve" name="Resolve the complaint with the supplier" />
    <bpmn:task id="payInstr" name="Give the payment instructions" />
    <bpmn:task id="close" name="Close the instance in ACME Financial Accounting" />
    <bpmn:endEvent id="done" name="Invoice paid and instance closed" />
    <bpmn:task id="review" name="Review the invoice items for accuracy" />
    <bpmn:exclusiveGateway id="accurate" name="Position accurate?" />
    <bpmn:task id="markAP" name="Mark the position AP on the docket" />
    <bpmn:task id="reject" name="Reject the position with a note and explanation on the docket" />
    <bpmn:exclusiveGateway id="more" name="More cost center managers on the docket?" />
    <bpmn:task id="audit" name="Perform the commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint during the commercial audit?" />
    <bpmn:task id="approve" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="over20" name="Amount above EUR 20?" />
    <bpmn:exclusiveGateway id="merge3" />
    <bpmn:task id="returnCopy" name="Return the copy of the invoice and the docket to accounting in the signature file" />
    <bpmn:task id="boardCheck" name="Check the invoice again (four-eyes principle)" />
    <bpmn:sequenceFlow id="f-received-inspect" sourceRef="received" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-create" sourceRef="forward" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-checkItems" sourceRef="create" targetRef="checkItems" />
    <bpmn:sequenceFlow id="f-checkItems-docket" sourceRef="checkItems" targetRef="docket" />
    <bpmn:sequenceFlow id="f-docket-sendFirst" sourceRef="docket" targetRef="sendFirst" />
    <bpmn:sequenceFlow id="f-sendFirst-merge1" sourceRef="sendFirst" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-review" sourceRef="merge1" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-accurate" sourceRef="review" targetRef="accurate" />
    <bpmn:sequenceFlow id="f-accurate-markAP" name="yes" sourceRef="accurate" targetRef="markAP" />
    <bpmn:sequenceFlow id="f-accurate-reject" name="no" sourceRef="accurate" targetRef="reject" />
    <bpmn:sequenceFlow id="f-markAP-more" sourceRef="markAP" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-merge1" name="yes" sourceRef="more" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-more-forwardCM" name="no" sourceRef="more" targetRef="forwardCM" />
    <bpmn:sequenceFlow id="f-reject-clarify" sourceRef="reject" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-consultNeeded" sourceRef="clarify" targetRef="consultNeeded" />
    <bpmn:sequenceFlow id="f-consultNeeded-consult" name="yes" sourceRef="consultNeeded" targetRef="consult" />
    <bpmn:sequenceFlow id="f-consultNeeded-merge2" name="no" sourceRef="consultNeeded" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-consult-merge2" sourceRef="consult" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-merge2-resend" sourceRef="merge2" targetRef="resend" />
    <bpmn:sequenceFlow id="f-resend-merge1" sourceRef="resend" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-forwardCM-audit" sourceRef="forwardCM" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve" name="yes" sourceRef="complaint" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-audit" sourceRef="resolve" targetRef="audit" />
    <bpmn:sequenceFlow id="f-complaint-approve" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-over20" sourceRef="approve" targetRef="over20" />
    <bpmn:sequenceFlow id="f-over20-boardCheck" name="yes" sourceRef="over20" targetRef="boardCheck" />
    <bpmn:sequenceFlow id="f-over20-merge3" name="no" sourceRef="over20" targetRef="merge3" />
    <bpmn:sequenceFlow id="f-boardCheck-merge3" sourceRef="boardCheck" targetRef="merge3" />
    <bpmn:sequenceFlow id="f-merge3-returnCopy" sourceRef="merge3" targetRef="returnCopy" />
    <bpmn:sequenceFlow id="f-returnCopy-payInstr" sourceRef="returnCopy" targetRef="payInstr" />
    <bpmn:sequenceFlow id="f-payInstr-close" sourceRef="payInstr" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-done" sourceRef="close" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
