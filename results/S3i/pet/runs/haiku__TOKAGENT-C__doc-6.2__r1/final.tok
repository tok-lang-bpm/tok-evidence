tok 1.0 "Monthly supplier order"

pool org "Assembler AG"
  lane assembler "Assembler AG"
    start monthly "Start of the month" timer=P1M doc="Starts periodically on the first day of each month"
    task place "Place an order with the supplier"
    send sendorder "Send the order to the supplier" message="Order"
    receive getinvoice "Receive the invoice" message="Invoice"
    end done "Invoice received"
  lane supplier "Supplier"
    receive getorder "Receive the order" message="Order"
    task process "Process the order"
    send sendinvoice "Send the invoice to Assembler AG" message="Invoice"

flow monthly -> place -> sendorder -> getorder -> process -> sendinvoice -> getinvoice -> done
