<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Monthly supplier order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Order" name="Order" />
  <bpmn:message id="Message_Invoice" name="Invoice" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Assembler AG" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Monthly supplier order" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>monthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getinvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>getorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendinvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="monthly" name="Start of the month">
      <bpmn:documentation>Starts periodically on the first day of each month</bpmn:documentation>
      <bpmn:timerEventDefinition id="monthly-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="place" name="Place an order with the supplier" />
    <bpmn:sendTask id="sendorder" name="Send the order to the supplier" messageRef="Message_Order" />
    <bpmn:receiveTask id="getinvoice" name="Receive the invoice" messageRef="Message_Invoice" />
    <bpmn:endEvent id="done" name="Invoice received" />
    <bpmn:receiveTask id="getorder" name="Receive the order" messageRef="Message_Order" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:sendTask id="sendinvoice" name="Send the invoice to Assembler AG" messageRef="Message_Invoice" />
    <bpmn:sequenceFlow id="f-monthly-place" sourceRef="monthly" targetRef="place" />
    <bpmn:sequenceFlow id="f-place-sendorder" sourceRef="place" targetRef="sendorder" />
    <bpmn:sequenceFlow id="f-sendorder-getorder" sourceRef="sendorder" targetRef="getorder" />
    <bpmn:sequenceFlow id="f-getorder-process" sourceRef="getorder" targetRef="process" />
    <bpmn:sequenceFlow id="f-process-sendinvoice" sourceRef="process" targetRef="sendinvoice" />
    <bpmn:sequenceFlow id="f-sendinvoice-getinvoice" sourceRef="sendinvoice" targetRef="getinvoice" />
    <bpmn:sequenceFlow id="f-getinvoice-done" sourceRef="getinvoice" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
