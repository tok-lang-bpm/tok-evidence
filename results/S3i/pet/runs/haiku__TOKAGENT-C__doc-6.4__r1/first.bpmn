<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Acquisition of potential customers" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_contact" name="Customer contact" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Sales company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Acquisition of potential customers" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="marketing" name="Marketing staff">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquaintance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sourced</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center staff">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>left</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>presType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contacted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="preSales" name="Pre-sales employee">
        <bpmn:flowNodeRef>techPres</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Contact details needed" />
    <bpmn:exclusiveGateway id="source" name="Where do the contact details come from?" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="acquaintance" name="Learn of a customer through an acquaintance" />
    <bpmn:exclusiveGateway id="sourced" name="Contact details obtained" />
    <bpmn:task id="call" name="Call the customer" />
    <bpmn:task id="determine" name="Determine the contact person and the budget" />
    <bpmn:task id="ask" name="Ask whether the customer is generally interested" />
    <bpmn:exclusiveGateway id="interested" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="huge" name="Potential project budget huge?" />
    <bpmn:endEvent id="left" name="Customer left alone" />
    <bpmn:task id="acquire" name="Personally acquire the customer" />
    <bpmn:exclusiveGateway id="endInterest" name="Customer interested in the end?" />
    <bpmn:exclusiveGateway id="ready" name="Customer ready for presentation" />
    <bpmn:exclusiveGateway id="presType" name="Presentation type?" />
    <bpmn:task id="detailed" name="Give detailed online presentation" />
    <bpmn:exclusiveGateway id="presMerge" name="Presentation given" />
    <bpmn:eventBasedGateway id="wait" name="Customer comes back within 2 weeks?" />
    <bpmn:intermediateCatchEvent id="contacted" name="Customer contacts us">
      <bpmn:messageEventDefinition id="contacted-def" messageRef="Message_Customer_contact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="2 weeks passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callBack" name="Call the customer back" />
    <bpmn:exclusiveGateway id="joined" name="Customer reached" />
    <bpmn:task id="quote" name="Create a quotation" />
    <bpmn:endEvent id="done" name="Quotation created" />
    <bpmn:task id="techPres" name="Give technical online presentation" />
    <bpmn:sequenceFlow id="f-begin-source" sourceRef="begin" targetRef="source" />
    <bpmn:sequenceFlow id="f-source-buy" sourceRef="source" targetRef="buy" />
    <bpmn:sequenceFlow id="f-buy-sourced" sourceRef="buy" targetRef="sourced" />
    <bpmn:sequenceFlow id="f-source-exhibit" sourceRef="source" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-exhibit-sourced" sourceRef="exhibit" targetRef="sourced" />
    <bpmn:sequenceFlow id="f-source-acquaintance" sourceRef="source" targetRef="acquaintance" />
    <bpmn:sequenceFlow id="f-acquaintance-sourced" sourceRef="acquaintance" targetRef="sourced" />
    <bpmn:sequenceFlow id="f-sourced-call" sourceRef="sourced" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-determine" sourceRef="call" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-ask" sourceRef="determine" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-interested" sourceRef="ask" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-ready" name="yes" sourceRef="interested" targetRef="ready" />
    <bpmn:sequenceFlow id="f-interested-huge" name="no" sourceRef="interested" targetRef="huge" />
    <bpmn:sequenceFlow id="f-huge-acquire" name="yes" sourceRef="huge" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-huge-left" name="no" sourceRef="huge" targetRef="left" />
    <bpmn:sequenceFlow id="f-acquire-endInterest" sourceRef="acquire" targetRef="endInterest" />
    <bpmn:sequenceFlow id="f-endInterest-ready" name="yes" sourceRef="endInterest" targetRef="ready" />
    <bpmn:sequenceFlow id="f-endInterest-left" name="no" sourceRef="endInterest" targetRef="left" />
    <bpmn:sequenceFlow id="f-ready-presType" sourceRef="ready" targetRef="presType" />
    <bpmn:sequenceFlow id="f-presType-detailed" name="detailed" sourceRef="presType" targetRef="detailed" />
    <bpmn:sequenceFlow id="f-presType-techPres" name="technical" sourceRef="presType" targetRef="techPres" />
    <bpmn:sequenceFlow id="f-detailed-presMerge" sourceRef="detailed" targetRef="presMerge" />
    <bpmn:sequenceFlow id="f-techPres-presMerge" sourceRef="techPres" targetRef="presMerge" />
    <bpmn:sequenceFlow id="f-presMerge-wait" sourceRef="presMerge" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-contacted" sourceRef="wait" targetRef="contacted" />
    <bpmn:sequenceFlow id="f-wait-timeout" sourceRef="wait" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-contacted-joined" sourceRef="contacted" targetRef="joined" />
    <bpmn:sequenceFlow id="f-timeout-callBack" sourceRef="timeout" targetRef="callBack" />
    <bpmn:sequenceFlow id="f-callBack-joined" sourceRef="callBack" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-quote" sourceRef="joined" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-done" sourceRef="quote" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
