<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Filling a post" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Filling a post" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Functional department">
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR department">
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="applicant" name="Applicant">
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="demand" name="Demand to fill a post" />
    <bpmn:task id="submit" name="Submit the demand to fill the post" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="check" name="Check the applications" />
    <bpmn:task id="fill" name="Fill the post by concluding a contract of employment" />
    <bpmn:endEvent id="filled" name="Post filled" />
    <bpmn:task id="apply" name="Apply for the post" />
    <bpmn:sequenceFlow id="f-demand-submit" sourceRef="demand" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-advertise" sourceRef="submit" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-apply" sourceRef="advertise" targetRef="apply" />
    <bpmn:sequenceFlow id="f-apply-check" sourceRef="apply" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-fill" sourceRef="check" targetRef="fill" />
    <bpmn:sequenceFlow id="f-fill-filled" sourceRef="fill" targetRef="filled" />
  </bpmn:process>
</bpmn:definitions>
