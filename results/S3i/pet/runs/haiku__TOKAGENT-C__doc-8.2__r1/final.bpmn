<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job posting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job posting" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Department">
        <bpmn:flowNodeRef>vacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>consider</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="HR clerk">
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>posted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="vacancy" name="Vacancy reported" />
    <bpmn:task id="answer" name="Answer the question" />
    <bpmn:exclusiveGateway id="approved" name="Description approved?" />
    <bpmn:task id="reject" name="Reject the description and request a correction" />
    <bpmn:task id="consider" name="Consider the job description" />
    <bpmn:task id="create" name="Create the job description" />
    <bpmn:exclusiveGateway id="confused" name="Message still confusing?" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:task id="submit" name="Submit the job description for consideration" />
    <bpmn:task id="correct" name="Correct the job description" />
    <bpmn:task id="post" name="Post the job" />
    <bpmn:endEvent id="posted" name="Job posted" />
    <bpmn:sequenceFlow id="f-vacancy-create" sourceRef="vacancy" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-confused" sourceRef="create" targetRef="confused" />
    <bpmn:sequenceFlow id="f-confused-ask" name="yes" sourceRef="confused" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-answer" sourceRef="ask" targetRef="answer" />
    <bpmn:sequenceFlow id="f-answer-create" sourceRef="answer" targetRef="create" />
    <bpmn:sequenceFlow id="f-confused-submit" name="no" sourceRef="confused" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-consider" sourceRef="submit" targetRef="consider" />
    <bpmn:sequenceFlow id="f-consider-approved" sourceRef="consider" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-post" name="yes" sourceRef="approved" targetRef="post" />
    <bpmn:sequenceFlow id="f-approved-reject" name="no" sourceRef="approved" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-correct" sourceRef="reject" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-submit" sourceRef="correct" targetRef="submit" />
    <bpmn:sequenceFlow id="f-post-posted" sourceRef="post" targetRef="posted" />
  </bpmn:process>
</bpmn:definitions>
