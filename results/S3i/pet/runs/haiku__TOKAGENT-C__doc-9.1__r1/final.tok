tok 1.0 "Account defaulter report"

pool office "Organisation"
  lane sys "System"
    start morning "Weekday morning"
    task backup "Back up the database"
    task checkTable "Check the Account Defaulter table for new records"
    xor newRec "New records found?"
    task checkCRM "Check the CRM system for new returns"
    xor newRet "New returns filed?"
    task alert "Send an alert to the supervisor"
    task checkCRM2 "Check the CRM system for new returns"
    xor newRet2 "New returns filed?"
    task msg "Send a message to the supervisor"
    end noReturn "No new returns"
    end done "Defaulter accounts reconciled"
    end late "Supervisor messaged"
  lane acc "Accounts"
    task register "Register all defaulting accounts and customers"
    xor advised "Defaulting client codes previously advised?"
    task table "Produce another table of defaulting accounts"
    task sendAM "Send the table to account management"
    xor merge2
    xor timely "Report completed by 2:30 pm?"
    xor merge3
    task reconcile "Reconcile with the existing Account Defaulter table"
    xor timely2 "Completed by 4:00 pm?"

flow morning -> backup -> checkTable -> newRec
flow newRec -> checkCRM "no"
flow newRec -> register "yes"
flow checkCRM -> newRet
flow newRet -> register "yes"
flow newRet -> noReturn "no"
flow register -> advised
flow advised -> table "no"
flow advised -> merge2 "yes"
flow table -> sendAM -> merge2
flow merge2 -> timely
flow timely -> merge3 "yes"
flow timely -> alert "no"
flow alert -> merge3
flow merge3 -> checkCRM2 -> newRet2
flow newRet2 -> reconcile "yes"
flow newRet2 -> noReturn "no"
flow reconcile -> timely2
flow timely2 -> done "yes"
flow timely2 -> msg "no"
flow msg -> late
