<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Account defaulter report" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="office" name="Organisation" processRef="office-process" />
  </bpmn:collaboration>
  <bpmn:process id="office-process" name="Account defaulter report" isExecutable="false">
    <bpmn:laneSet id="office-lanes">
      <bpmn:lane id="sys" name="System">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newRet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkCRM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newRet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Accounts">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>table</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendAM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timely</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timely2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Weekday morning" />
    <bpmn:task id="backup" name="Back up the database" />
    <bpmn:task id="checkTable" name="Check the Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="newRec" name="New records found?" />
    <bpmn:task id="checkCRM" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="newRet" name="New returns filed?" />
    <bpmn:task id="alert" name="Send an alert to the supervisor" />
    <bpmn:task id="checkCRM2" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="newRet2" name="New returns filed?" />
    <bpmn:task id="msg" name="Send a message to the supervisor" />
    <bpmn:endEvent id="noReturn" name="No new returns" />
    <bpmn:endEvent id="done" name="Defaulter accounts reconciled" />
    <bpmn:endEvent id="late" name="Supervisor messaged" />
    <bpmn:task id="register" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="advised" name="Defaulting client codes previously advised?" />
    <bpmn:task id="table" name="Produce another table of defaulting accounts" />
    <bpmn:task id="sendAM" name="Send the table to account management" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:exclusiveGateway id="timely" name="Report completed by 2:30 pm?" />
    <bpmn:exclusiveGateway id="merge3" />
    <bpmn:task id="reconcile" name="Reconcile with the existing Account Defaulter table" />
    <bpmn:exclusiveGateway id="timely2" name="Completed by 4:00 pm?" />
    <bpmn:sequenceFlow id="f-morning-backup" sourceRef="morning" targetRef="backup" />
    <bpmn:sequenceFlow id="f-backup-checkTable" sourceRef="backup" targetRef="checkTable" />
    <bpmn:sequenceFlow id="f-checkTable-newRec" sourceRef="checkTable" targetRef="newRec" />
    <bpmn:sequenceFlow id="f-newRec-checkCRM" name="no" sourceRef="newRec" targetRef="checkCRM" />
    <bpmn:sequenceFlow id="f-newRec-register" name="yes" sourceRef="newRec" targetRef="register" />
    <bpmn:sequenceFlow id="f-checkCRM-newRet" sourceRef="checkCRM" targetRef="newRet" />
    <bpmn:sequenceFlow id="f-newRet-register" name="yes" sourceRef="newRet" targetRef="register" />
    <bpmn:sequenceFlow id="f-newRet-noReturn" name="no" sourceRef="newRet" targetRef="noReturn" />
    <bpmn:sequenceFlow id="f-register-advised" sourceRef="register" targetRef="advised" />
    <bpmn:sequenceFlow id="f-advised-table" name="no" sourceRef="advised" targetRef="table" />
    <bpmn:sequenceFlow id="f-advised-merge2" name="yes" sourceRef="advised" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-table-sendAM" sourceRef="table" targetRef="sendAM" />
    <bpmn:sequenceFlow id="f-sendAM-merge2" sourceRef="sendAM" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-merge2-timely" sourceRef="merge2" targetRef="timely" />
    <bpmn:sequenceFlow id="f-timely-merge3" name="yes" sourceRef="timely" targetRef="merge3" />
    <bpmn:sequenceFlow id="f-timely-alert" name="no" sourceRef="timely" targetRef="alert" />
    <bpmn:sequenceFlow id="f-alert-merge3" sourceRef="alert" targetRef="merge3" />
    <bpmn:sequenceFlow id="f-merge3-checkCRM2" sourceRef="merge3" targetRef="checkCRM2" />
    <bpmn:sequenceFlow id="f-checkCRM2-newRet2" sourceRef="checkCRM2" targetRef="newRet2" />
    <bpmn:sequenceFlow id="f-newRet2-reconcile" name="yes" sourceRef="newRet2" targetRef="reconcile" />
    <bpmn:sequenceFlow id="f-newRet2-noReturn" name="no" sourceRef="newRet2" targetRef="noReturn" />
    <bpmn:sequenceFlow id="f-reconcile-timely2" sourceRef="reconcile" targetRef="timely2" />
    <bpmn:sequenceFlow id="f-timely2-done" name="yes" sourceRef="timely2" targetRef="done" />
    <bpmn:sequenceFlow id="f-timely2-msg" name="no" sourceRef="timely2" targetRef="msg" />
    <bpmn:sequenceFlow id="f-msg-late" sourceRef="msg" targetRef="late" />
  </bpmn:process>
</bpmn:definitions>
