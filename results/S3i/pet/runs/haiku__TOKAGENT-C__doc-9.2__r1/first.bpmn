<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Mortgage offer handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Decline" name="Decline" />
  <bpmn:message id="Message_Offer_returned" name="Offer returned" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Mortgage bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Mortgage offer handling" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="csr" name="Customer Service Representative">
        <bpmn:flowNodeRef>opened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>silence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="admin" name="Administration">
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="opened" name="Case opened" />
    <bpmn:task id="send" name="Send the mortgage offer" />
    <bpmn:eventBasedGateway id="wait" name="Reply received?" />
    <bpmn:intermediateCatchEvent id="declined" name="Customer declines the mortgage">
      <bpmn:messageEventDefinition id="declined-def" messageRef="Message_Decline" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="returned" name="Completed offer documents returned">
      <bpmn:messageEventDefinition id="returned-def" messageRef="Message_Offer_returned" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="silence" name="No answer after 2 weeks">
      <bpmn:timerEventDefinition id="silence-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="docs" name="All pre-requisite documents provided?" />
    <bpmn:task id="move" name="Move the case to administration" />
    <bpmn:task id="request" name="Generate a message requesting the outstanding documents" />
    <bpmn:task id="update1" name="Update the case details" />
    <bpmn:task id="archive1" name="Archive the work" />
    <bpmn:task id="cancel1" name="Cancel the case" />
    <bpmn:task id="update2" name="Update the case details" />
    <bpmn:task id="archive2" name="Archive the work" />
    <bpmn:task id="cancel2" name="Cancel the case" />
    <bpmn:endEvent id="requested" name="Outstanding documents requested" />
    <bpmn:endEvent id="cancelled" name="Mortgage cancelled" />
    <bpmn:task id="complete" name="Complete the case" />
    <bpmn:endEvent id="completed" name="Case completed" />
    <bpmn:sequenceFlow id="f-opened-send" sourceRef="opened" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-wait" sourceRef="send" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-declined" sourceRef="wait" targetRef="declined" />
    <bpmn:sequenceFlow id="f-wait-returned" sourceRef="wait" targetRef="returned" />
    <bpmn:sequenceFlow id="f-wait-silence" sourceRef="wait" targetRef="silence" />
    <bpmn:sequenceFlow id="f-declined-update1" sourceRef="declined" targetRef="update1" />
    <bpmn:sequenceFlow id="f-update1-archive1" sourceRef="update1" targetRef="archive1" />
    <bpmn:sequenceFlow id="f-archive1-cancel1" sourceRef="archive1" targetRef="cancel1" />
    <bpmn:sequenceFlow id="f-cancel1-cancelled" sourceRef="cancel1" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-silence-update2" sourceRef="silence" targetRef="update2" />
    <bpmn:sequenceFlow id="f-update2-archive2" sourceRef="update2" targetRef="archive2" />
    <bpmn:sequenceFlow id="f-archive2-cancel2" sourceRef="archive2" targetRef="cancel2" />
    <bpmn:sequenceFlow id="f-cancel2-cancelled" sourceRef="cancel2" targetRef="cancelled" />
    <bpmn:sequenceFlow id="f-returned-docs" sourceRef="returned" targetRef="docs" />
    <bpmn:sequenceFlow id="f-docs-move" name="yes" sourceRef="docs" targetRef="move" />
    <bpmn:sequenceFlow id="f-docs-request" name="no" sourceRef="docs" targetRef="request" />
    <bpmn:sequenceFlow id="f-move-complete" sourceRef="move" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-completed" sourceRef="complete" targetRef="completed" />
    <bpmn:sequenceFlow id="f-request-requested" sourceRef="request" targetRef="requested" />
  </bpmn:process>
</bpmn:definitions>
