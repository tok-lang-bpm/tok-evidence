<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meeting schedule drafting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="town" name="Town Planning Authority" processRef="town-process" />
  </bpmn:collaboration>
  <bpmn:process id="town-process" name="Meeting schedule drafting" isExecutable="false">
    <bpmn:laneSet id="town-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>nov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>adddates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Committee Members">
        <bpmn:flowNodeRef>diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="nov" name="November of each year" />
    <bpmn:task id="draft" name="Draft a schedule of meetings for the next calendar year" />
    <bpmn:task id="adddates" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="conflicts" name="Look for potential conflicts" />
    <bpmn:task id="send" name="Send the final schedule of meeting dates by email" />
    <bpmn:task id="check" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="diaries" name="Check their diaries" />
    <bpmn:exclusiveGateway id="conflict" name="Conflicts found?" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of the conflicts" />
    <bpmn:endEvent id="confirmed" name="Schedule confirmed" />
    <bpmn:endEvent id="reported" name="Conflicts reported" />
    <bpmn:sequenceFlow id="f-nov-draft" sourceRef="nov" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-adddates" sourceRef="draft" targetRef="adddates" />
    <bpmn:sequenceFlow id="f-adddates-check" sourceRef="adddates" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-suggest" sourceRef="check" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-conflicts" sourceRef="recheck" targetRef="conflicts" />
    <bpmn:sequenceFlow id="f-conflicts-send" sourceRef="conflicts" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-diaries" sourceRef="send" targetRef="diaries" />
    <bpmn:sequenceFlow id="f-diaries-conflict" sourceRef="diaries" targetRef="conflict" />
    <bpmn:sequenceFlow id="f-conflict-advise" name="yes" sourceRef="conflict" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-reported" sourceRef="advise" targetRef="reported" />
    <bpmn:sequenceFlow id="f-conflict-confirmed" name="no" sourceRef="conflict" targetRef="confirmed" />
  </bpmn:process>
</bpmn:definitions>
