tok 1.0 "Committee meeting support"

pool org "Organisation"
  lane coord "Coordination Unit"
    start dates "Dates to be finalised"
    task finalise "Finalise the dates"
    task qa "Conduct a QA check on the minutes"
  lane support "Support Officer"
    task calendars "Update all group calendars"
    task folders "Create meeting folders for each meeting"
    task upload "Upload all appropriate documents to the system"
    task advise "Advise Committee Members to read all related documents a week before each meeting"
    task minutes "Produce the minutes including any Action Points for each Committee Member"
    task distribute "Send the minutes to all Committee Members"
    task records "Update all departmental records"
    end done "Records updated"
  lane members "Committee Members"
    task meet "Hold the meeting"

flow dates -> finalise -> calendars -> folders -> upload -> advise -> meet -> minutes -> qa -> distribute -> records -> done
