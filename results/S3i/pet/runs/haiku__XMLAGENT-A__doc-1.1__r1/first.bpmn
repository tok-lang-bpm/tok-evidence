<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Company" name="Bicycle manufacturer" processRef="Process_CustomBike" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CustomBike" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sales" name="Sales department">
        <bpmn:flowNodeRef>Start_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptOrReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ForkInform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformStorehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformEngineering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipBicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>Task_ProcessPartList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservePart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackOrderPart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergePart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MoreParts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineering" name="Engineering department">
        <bpmn:flowNodeRef>Task_PrepareAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OrderReceived" name="Order received" />
    <bpmn:task id="Task_AcceptOrReject" name="Accept or reject the order" />
    <bpmn:exclusiveGateway id="Gw_Accepted" name="Order accepted?" />
    <bpmn:task id="Task_RejectOrder" name="Reject the order" />
    <bpmn:endEvent id="End_Rejected" name="Process instance finished (order rejected)" />
    <bpmn:parallelGateway id="Gw_ForkInform" name="Inform storehouse and engineering" />
    <bpmn:task id="Task_InformStorehouse" name="Inform the storehouse" />
    <bpmn:task id="Task_InformEngineering" name="Inform the engineering department" />
    <bpmn:task id="Task_ProcessPartList" name="Process the part list of the order" />
    <bpmn:task id="Task_CheckQuantity" name="Check the required quantity of the part" />
    <bpmn:exclusiveGateway id="Gw_Available" name="Part available in-house?" />
    <bpmn:task id="Task_ReservePart" name="Reserve the part" />
    <bpmn:task id="Task_BackOrderPart" name="Back-order the part" />
    <bpmn:exclusiveGateway id="Gw_MergePart" name="Part processed" />
    <bpmn:exclusiveGateway id="Gw_MoreParts" name="More items on the part list?" />
    <bpmn:task id="Task_PrepareAssembly" name="Prepare everything for the assembly of the bicycle" />
    <bpmn:parallelGateway id="Gw_JoinAll" name="Part list processed and preparation finished" />
    <bpmn:task id="Task_AssembleBicycle" name="Assemble the bicycle" />
    <bpmn:task id="Task_ShipBicycle" name="Ship the bicycle to the customer" />
    <bpmn:endEvent id="End_Shipped" name="Process instance finished (bicycle shipped)" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_OrderReceived" targetRef="Task_AcceptOrReject" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AcceptOrReject" targetRef="Gw_Accepted" />
    <bpmn:sequenceFlow id="Flow_03" name="no" sourceRef="Gw_Accepted" targetRef="Task_RejectOrder" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_RejectOrder" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_05" name="yes" sourceRef="Gw_Accepted" targetRef="Gw_ForkInform" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gw_ForkInform" targetRef="Task_InformStorehouse" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gw_ForkInform" targetRef="Task_InformEngineering" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_InformStorehouse" targetRef="Task_ProcessPartList" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_InformEngineering" targetRef="Task_PrepareAssembly" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ProcessPartList" targetRef="Task_CheckQuantity" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CheckQuantity" targetRef="Gw_Available" />
    <bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gw_Available" targetRef="Task_ReservePart" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_Available" targetRef="Task_BackOrderPart" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReservePart" targetRef="Gw_MergePart" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_BackOrderPart" targetRef="Gw_MergePart" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_MergePart" targetRef="Gw_MoreParts" />
    <bpmn:sequenceFlow id="Flow_17" name="yes" sourceRef="Gw_MoreParts" targetRef="Task_CheckQuantity" />
    <bpmn:sequenceFlow id="Flow_18" name="no" sourceRef="Gw_MoreParts" targetRef="Gw_JoinAll" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PrepareAssembly" targetRef="Gw_JoinAll" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gw_JoinAll" targetRef="Task_AssembleBicycle" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_AssembleBicycle" targetRef="Task_ShipBicycle" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ShipBicycle" targetRef="End_Shipped" />
  </bpmn:process>
</bpmn:definitions>
