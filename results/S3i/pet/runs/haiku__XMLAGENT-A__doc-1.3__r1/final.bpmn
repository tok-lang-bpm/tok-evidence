<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Hotel" name="The Evanstonian" processRef="Process_RoomService" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RoomService" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manager" name="Room-service manager">
        <bpmn:flowNodeRef>Start_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveToSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignWaiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ForkWork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NonalcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MoreOrders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostponeBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Call" name="Guest calls room service" />
    <bpmn:task id="Task_TakeOrder" name="Take down the order" />
    <bpmn:task id="Task_SubmitTicket" name="Submit the order ticket to the kitchen" />
    <bpmn:task id="Task_GiveToSommelier" name="Give the order to the sommelier" />
    <bpmn:task id="Task_AssignWaiter" name="Assign the order to the waiter" />
    <bpmn:parallelGateway id="Gw_ForkWork" />
    <bpmn:task id="Task_PrepareFood" name="Prepare the food" />
    <bpmn:task id="Task_FetchWine" name="Fetch wine from the cellar and prepare other alcoholic beverages" />
    <bpmn:task id="Task_ReadyCart" name="Ready the cart" />
    <bpmn:task id="Task_NonalcoholicDrinks" name="Prepare the nonalcoholic drinks" />
    <bpmn:parallelGateway id="Gw_JoinReady" name="Food, wine and cart ready" />
    <bpmn:task id="Task_Deliver" name="Deliver the food, wine and cart to the guest's room" />
    <bpmn:task id="Task_ReturnToStation" name="Return to the room-service station" />
    <bpmn:exclusiveGateway id="Gw_MoreOrders" name="Another order to prepare or deliver?" default="Flow_MoreNo" />
    <bpmn:task id="Task_PostponeBilling" name="Postpone the billing" />
    <bpmn:exclusiveGateway id="Gw_MergeBilling" />
    <bpmn:task id="Task_DebitAccount" name="Debit the guest's account" />
    <bpmn:endEvent id="End_Completed" name="Order completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Call" targetRef="Task_TakeOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TakeOrder" targetRef="Task_SubmitTicket" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SubmitTicket" targetRef="Task_GiveToSommelier" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GiveToSommelier" targetRef="Task_AssignWaiter" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AssignWaiter" targetRef="Gw_ForkWork" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_ForkWork" targetRef="Task_PrepareFood" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_ForkWork" targetRef="Task_FetchWine" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_ForkWork" targetRef="Task_ReadyCart" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ReadyCart" targetRef="Task_NonalcoholicDrinks" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PrepareFood" targetRef="Gw_JoinReady" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_FetchWine" targetRef="Gw_JoinReady" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_NonalcoholicDrinks" targetRef="Gw_JoinReady" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_JoinReady" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Deliver" targetRef="Task_ReturnToStation" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ReturnToStation" targetRef="Gw_MoreOrders" />
    <bpmn:sequenceFlow id="Flow_MoreYes" name="yes" sourceRef="Gw_MoreOrders" targetRef="Task_PostponeBilling">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">another order is waiting</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MoreNo" name="no" sourceRef="Gw_MoreOrders" targetRef="Gw_MergeBilling" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PostponeBilling" targetRef="Gw_MergeBilling" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_MergeBilling" targetRef="Task_DebitAccount" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DebitAccount" targetRef="End_Completed" />
  </bpmn:process>
</bpmn:definitions>
