<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Company" name="Company going public" processRef="IPO_Process" />
  </bpmn:collaboration>
  <bpmn:process id="IPO_Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriters" name="Underwriters">
        <bpmn:flowNodeRef>Gw_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SEC" name="Securities and Exchange Commission">
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Decision to go public made" />
    <bpmn:task id="Task_2" name="Select the underwriters" />
    <bpmn:exclusiveGateway id="Gw_3" name="Facts presented fairly?" />
    <bpmn:endEvent id="End_4" name="Underwriters decline the issue" />
    <bpmn:task id="Task_5" name="Provide procedural and financial advice" />
    <bpmn:task id="Task_6" name="Prepare the registration statement" />
    <bpmn:task id="Task_7" name="Submit the registration statement to the SEC" />
    <bpmn:parallelGateway id="Gw_8" name="Split while awaiting approval" />
    <bpmn:task id="Task_9" name="Approve the registration statement" />
    <bpmn:task id="Task_10" name="Check compliance with blue-sky laws" />
    <bpmn:task id="Task_11" name="Arrange a road show for potential investors" />
    <bpmn:task id="Task_12" name="Firm up the issue price" />
    <bpmn:parallelGateway id="Gw_13" name="Join after clearance" />
    <bpmn:task id="Task_14" name="Fix the issue price" />
    <bpmn:task id="Task_15" name="Enter a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="Gw_16" name="Reason not to offer found?" />
    <bpmn:task id="Task_17" name="Offer the stock to the public" />
    <bpmn:endEvent id="End_18" name="Stock offered to the public" />
    <bpmn:endEvent id="End_19" name="Offering withdrawn" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_3" name="no" sourceRef="Gw_3" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_3" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_7" targetRef="Gw_8" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_8" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_8" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_11" targetRef="Task_12" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_9" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_10" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_12" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_13" targetRef="Task_14" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_14" targetRef="Task_15" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_15" targetRef="Gw_16" />
    <bpmn:sequenceFlow id="Flow_18" name="no" sourceRef="Gw_16" targetRef="Task_17" />
    <bpmn:sequenceFlow id="Flow_19" name="yes" sourceRef="Gw_16" targetRef="End_19" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_17" targetRef="End_18" />
  </bpmn:process>
</bpmn:definitions>