<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Organisation" name="Organisation" processRef="FaultProcess" />
  </bpmn:collaboration>
  <bpmn:process id="FaultProcess" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_Detector" name="Fault detector">
        <bpmn:flowNodeRef>Start_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPO" name="MPO">
        <bpmn:flowNodeRef>Start_Suspicion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformGO_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSP_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformGO_Res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSP_Res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Failure" name="Failure detected" />
    <bpmn:task id="Task_Report" name="Report the failure to the MPO" />
    <bpmn:startEvent id="Start_Suspicion" name="Suspicion of own fault" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="Gw_Confirmed" name="Failure confirmed?" />
    <bpmn:endEvent id="End_Rejected" name="Failure rejected" />
    <bpmn:parallelGateway id="Split_Inform" />
    <bpmn:task id="Task_InformGO_Fail" name="Inform the GO about the failure" />
    <bpmn:task id="Task_InformMSP_Fail" name="Inform the MSP about the failure" />
    <bpmn:parallelGateway id="Join_Inform" />
    <bpmn:task id="Task_Fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="Task_Share" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="Split_Resolution" />
    <bpmn:task id="Task_InformGO_Res" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="Task_InformMSP_Res" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="Join_Resolution" />
    <bpmn:endEvent id="End_Resolved" name="Interference resolved" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Failure" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Report" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F3" sourceRef="Start_Suspicion" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Merge" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Examine" targetRef="Gw_Confirmed" />
    <bpmn:sequenceFlow id="F6" name="rejected" sourceRef="Gw_Confirmed" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F7" name="confirmed" sourceRef="Gw_Confirmed" targetRef="Split_Inform" />
    <bpmn:sequenceFlow id="F8" sourceRef="Split_Inform" targetRef="Task_InformGO_Fail" />
    <bpmn:sequenceFlow id="F9" sourceRef="Split_Inform" targetRef="Task_InformMSP_Fail" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_InformGO_Fail" targetRef="Join_Inform" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_InformMSP_Fail" targetRef="Join_Inform" />
    <bpmn:sequenceFlow id="F12" sourceRef="Join_Inform" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Fix" targetRef="Task_Share" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Share" targetRef="Split_Resolution" />
    <bpmn:sequenceFlow id="F15" sourceRef="Split_Resolution" targetRef="Task_InformGO_Res" />
    <bpmn:sequenceFlow id="F16" sourceRef="Split_Resolution" targetRef="Task_InformMSP_Res" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_InformGO_Res" targetRef="Join_Resolution" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_InformMSP_Res" targetRef="Join_Resolution" />
    <bpmn:sequenceFlow id="F19" sourceRef="Join_Resolution" targetRef="End_Resolved" />
  </bpmn:process>
</bpmn:definitions>
