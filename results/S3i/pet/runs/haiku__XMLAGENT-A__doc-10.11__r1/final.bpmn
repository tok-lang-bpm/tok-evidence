<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Organisation" name="Organisation" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSP" name="MSP">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reading</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Measurements needed" />
    <bpmn:task id="Task_Request" name="Request the measurements" />
    <bpmn:task id="Task_Check" name="Check the received request" />
    <bpmn:exclusiveGateway id="Gw_Accepted" name="Request accepted?" />
    <bpmn:task id="Task_Deny" name="Deny the request" />
    <bpmn:task id="Task_Measure" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="Gw_Reading" name="Reading successful?" />
    <bpmn:task id="Task_Transmit" name="Transmit the measured values to the GO" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Inform" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="Task_Process" name="Process the measured values" />
    <bpmn:task id="Task_SendChanged" name="Send the changed values to the MSP" />
    <bpmn:task id="Task_TransmitSP" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="End_Failure" name="Failure reported" />
    <bpmn:endEvent id="End_Done" name="Readings transmitted" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Request" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Check" targetRef="Gw_Accepted" />
    <bpmn:sequenceFlow id="F4" name="yes" sourceRef="Gw_Accepted" targetRef="Task_Measure" />
    <bpmn:sequenceFlow id="F5" name="no" sourceRef="Gw_Accepted" targetRef="Task_Deny" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Measure" targetRef="Gw_Reading" />
    <bpmn:sequenceFlow id="F7" name="yes" sourceRef="Gw_Reading" targetRef="Task_Transmit" />
    <bpmn:sequenceFlow id="F8" name="no" sourceRef="Gw_Reading" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Deny" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Merge" targetRef="Task_Inform" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Inform" targetRef="End_Failure" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Transmit" targetRef="Task_Process" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Process" targetRef="Task_SendChanged" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_SendChanged" targetRef="Task_TransmitSP" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_TransmitSP" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>
