<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Org" name="Organisation" processRef="MasterDataChange" />
  </bpmn:collaboration>
  <bpmn:process id="MasterDataChange" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_EC" name="EC">
        <bpmn:flowNodeRef>Start_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellINQ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_INQ" name="INQ">
        <bpmn:flowNodeRef>Task_NotifyIP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IP" name="IP">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Possible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Change" name="Change of master data" />
    <bpmn:task id="Task_TellINQ" name="Tell the INQ about the change of master data" />
    <bpmn:task id="Task_NotifyIP" name="Notify the IP of the change" />
    <bpmn:task id="Task_Check" name="Check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="Gw_Possible" name="Change possible at the desired time?" />
    <bpmn:task id="Task_Confirm" name="Confirm the changes of the INQ" />
    <bpmn:task id="Task_Reject" name="Reject the changes of the INQ" />
    <bpmn:endEvent id="End_Confirmed" name="Changes confirmed" />
    <bpmn:endEvent id="End_Rejected" name="Changes rejected" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Change" targetRef="Task_TellINQ" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TellINQ" targetRef="Task_NotifyIP" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_NotifyIP" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Check" targetRef="Gw_Possible" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_Possible" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_Possible" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Confirm" targetRef="End_Confirmed" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Reject" targetRef="End_Rejected" />
  </bpmn:process>
</bpmn:definitions>