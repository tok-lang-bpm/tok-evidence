<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_org" name="Organisation" processRef="process_inq_ip" />
  </bpmn:collaboration>
  <bpmn:process id="process_inq_ip" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_inq" name="INQ">
        <bpmn:flowNodeRef>start_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ip" name="IP">
        <bpmn:flowNodeRef>check_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer_transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_transmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_request" name="Transaction data request needed" />
    <bpmn:task id="transmit_request" name="Transmit transaction data request" />
    <bpmn:task id="check_request" name="Check the request" />
    <bpmn:exclusiveGateway id="outcome_gw" name="Outcome of the examination?" default="flow_reject" />
    <bpmn:task id="answer_transmit" name="Answer question by transmission of data" />
    <bpmn:task id="answer_reject" name="Answer question by rejection" />
    <bpmn:endEvent id="end_transmitted" name="Data transmitted" />
    <bpmn:endEvent id="end_rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_request" targetRef="transmit_request" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="transmit_request" targetRef="check_request" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="check_request" targetRef="outcome_gw" />
    <bpmn:sequenceFlow id="flow_accept" name="accepted" sourceRef="outcome_gw" targetRef="answer_transmit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">examination passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reject" name="rejected" sourceRef="outcome_gw" targetRef="answer_reject" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="answer_transmit" targetRef="end_transmitted" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="answer_reject" targetRef="end_rejected" />
  </bpmn:process>
</bpmn:definitions>
