<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Organisation" name="Metering point operations" processRef="Process_Billing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Billing" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Billing">
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_SendTemp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MPONorGO_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSPO" name="MSPO">
        <bpmn:flowNodeRef>Task_SendMeas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReadings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Start_Billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BillType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineTemp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineMeas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineReadings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineEquipGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeExamined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_InvoiceDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WhoConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PaymentAdviceSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WhoReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvoiceRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Task_ExamineEquipMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmMPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectMPON</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Billing" name="Bill received" />
    <bpmn:exclusiveGateway id="Gw_BillType" name="Which bill is sent?" />
    <bpmn:task id="Task_SendTemp" name="Send bill for temporary continuation of the metering point operations to the GO" />
    <bpmn:task id="Task_ExamineTemp" name="Examine the bill for temporary continuation of the metering point operations" />
    <bpmn:task id="Task_SendMeas" name="Send bill for temporary continuation of the measurement to the GO" />
    <bpmn:task id="Task_ExamineMeas" name="Examine the bill for temporary continuation of the measurement" />
    <bpmn:task id="Task_SendReadings" name="Send bill for additional readings to the GO" />
    <bpmn:task id="Task_ExamineReadings" name="Examine the bill for additional readings" />
    <bpmn:task id="Task_SendEquip" name="Send bill for equipment acquisition to the MPON or the GO" />
    <bpmn:exclusiveGateway id="Gw_MPONorGO_Send" name="MPON or GO?" />
    <bpmn:task id="Task_ExamineEquipMPON" name="Examine the bill for equipment acquisition" />
    <bpmn:task id="Task_ExamineEquipGO" name="Examine the bill for equipment acquisition" />
    <bpmn:exclusiveGateway id="Gw_MergeEquip" />
    <bpmn:exclusiveGateway id="Gw_MergeExamined" />
    <bpmn:exclusiveGateway id="Gw_InvoiceDecision" name="Invoice confirmed or rejected?" />
    <bpmn:exclusiveGateway id="Gw_WhoConfirm" name="GO or MPON?" />
    <bpmn:task id="Task_ConfirmGO" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:task id="Task_ConfirmMPON" name="Confirm the invoice with payment advice to the MPOO or the MSPO" />
    <bpmn:exclusiveGateway id="Gw_MergeConfirm" />
    <bpmn:endEvent id="End_PaymentAdviceSent" name="Payment advice sent" />
    <bpmn:exclusiveGateway id="Gw_WhoReject" name="GO or MPON?" />
    <bpmn:task id="Task_RejectGO" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:task id="Task_RejectMPON" name="Reject the invoice of the MPOO or the MSPO" />
    <bpmn:exclusiveGateway id="Gw_MergeReject" />
    <bpmn:endEvent id="End_InvoiceRejected" name="Invoice rejected" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Billing" targetRef="Gw_BillType" />
    <bpmn:sequenceFlow id="Flow_02" name="temporary continuation of metering point operations" sourceRef="Gw_BillType" targetRef="Task_SendTemp" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SendTemp" targetRef="Task_ExamineTemp" />
    <bpmn:sequenceFlow id="Flow_04" name="temporary continuation of measurement" sourceRef="Gw_BillType" targetRef="Task_SendMeas" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SendMeas" targetRef="Task_ExamineMeas" />
    <bpmn:sequenceFlow id="Flow_06" name="additional readings" sourceRef="Gw_BillType" targetRef="Task_SendReadings" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SendReadings" targetRef="Task_ExamineReadings" />
    <bpmn:sequenceFlow id="Flow_08" name="equipment acquisition" sourceRef="Gw_BillType" targetRef="Task_SendEquip" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SendEquip" targetRef="Gw_MPONorGO_Send" />
    <bpmn:sequenceFlow id="Flow_10" name="MPON" sourceRef="Gw_MPONorGO_Send" targetRef="Task_ExamineEquipMPON" />
    <bpmn:sequenceFlow id="Flow_11" name="GO" sourceRef="Gw_MPONorGO_Send" targetRef="Task_ExamineEquipGO" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ExamineEquipMPON" targetRef="Gw_MergeEquip" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ExamineEquipGO" targetRef="Gw_MergeEquip" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_MergeEquip" targetRef="Gw_MergeExamined" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ExamineTemp" targetRef="Gw_MergeExamined" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExamineMeas" targetRef="Gw_MergeExamined" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ExamineReadings" targetRef="Gw_MergeExamined" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gw_MergeExamined" targetRef="Gw_InvoiceDecision" />
    <bpmn:sequenceFlow id="Flow_19" name="confirmed" sourceRef="Gw_InvoiceDecision" targetRef="Gw_WhoConfirm" />
    <bpmn:sequenceFlow id="Flow_20" name="rejected" sourceRef="Gw_InvoiceDecision" targetRef="Gw_WhoReject" />
    <bpmn:sequenceFlow id="Flow_21" name="GO" sourceRef="Gw_WhoConfirm" targetRef="Task_ConfirmGO" />
    <bpmn:sequenceFlow id="Flow_22" name="MPON" sourceRef="Gw_WhoConfirm" targetRef="Task_ConfirmMPON" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ConfirmGO" targetRef="Gw_MergeConfirm" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ConfirmMPON" targetRef="Gw_MergeConfirm" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gw_MergeConfirm" targetRef="End_PaymentAdviceSent" />
    <bpmn:sequenceFlow id="Flow_26" name="GO" sourceRef="Gw_WhoReject" targetRef="Task_RejectGO" />
    <bpmn:sequenceFlow id="Flow_27" name="MPON" sourceRef="Gw_WhoReject" targetRef="Task_RejectMPON" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_RejectGO" targetRef="Gw_MergeReject" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_RejectMPON" targetRef="Gw_MergeReject" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gw_MergeReject" targetRef="End_InvoiceRejected" />
  </bpmn:process>
</bpmn:definitions>