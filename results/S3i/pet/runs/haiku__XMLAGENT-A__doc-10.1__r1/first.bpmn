<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="organisation" name="Organisation" processRef="dismissal-process" />
  </bpmn:collaboration>
  <bpmn:process id="dismissal-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane-mpon" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send-dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-mpoo" name="MPOO">
        <bpmn:flowNodeRef>review-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opposes-or-confirms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oppose-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm-dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Dismissal needed" />
    <bpmn:task id="send-dismissal" name="Send the dismissal to the MPOO" />
    <bpmn:task id="review-dismissal" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="opposes-or-confirms" name="Opposes or confirms the dismissal?" />
    <bpmn:task id="oppose-dismissal" name="Oppose the dismissal of MPON" />
    <bpmn:task id="confirm-dismissal" name="Confirm the dismissal of the MPON" />
    <bpmn:endEvent id="end-opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="end-confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send-dismissal" />
    <bpmn:sequenceFlow id="f2" sourceRef="send-dismissal" targetRef="review-dismissal" />
    <bpmn:sequenceFlow id="f3" sourceRef="review-dismissal" targetRef="opposes-or-confirms" />
    <bpmn:sequenceFlow id="f4" name="opposes" sourceRef="opposes-or-confirms" targetRef="oppose-dismissal" />
    <bpmn:sequenceFlow id="f5" name="confirms" sourceRef="opposes-or-confirms" targetRef="confirm-dismissal" />
    <bpmn:sequenceFlow id="f6" sourceRef="oppose-dismissal" targetRef="end-opposed" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm-dismissal" targetRef="end-confirmed" />
  </bpmn:process>
</bpmn:definitions>