<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="GO_POOL" name="GO" processRef="deregistration-process" />
  </bpmn:collaboration>
  <bpmn:process id="deregistration-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deregister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_continuation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_GO" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_readmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continuation_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continuation_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_mspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reassigned</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Deregistration started" />
    <bpmn:task id="deregister" name="Deregister at the GO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="valid_gw" name="Deregistration valid?" />
    <bpmn:task id="reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="end_rejected" name="Deregistration rejected" />
    <bpmn:task id="prelim_confirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="prepare_readmission" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="continuation_gw" name="Oblige the MPOO to continue the operations?" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:task id="confirm_continuation" name="Confirm the continuation to the MPOO" />
    <bpmn:exclusiveGateway id="continuation_merge" />
    <bpmn:task id="equipment" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="inform_mpoo" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="inform_mspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="inform_sp" name="Inform the SP about the assignment of the GO" />
    <bpmn:endEvent id="end_reassigned" name="Measuring point reassigned" />
    <bpmn:sequenceFlow id="f01" sourceRef="start" targetRef="deregister" />
    <bpmn:sequenceFlow id="f02" sourceRef="deregister" targetRef="verify" />
    <bpmn:sequenceFlow id="f03" sourceRef="verify" targetRef="valid_gw" />
    <bpmn:sequenceFlow id="f04" name="no" sourceRef="valid_gw" targetRef="reject" />
    <bpmn:sequenceFlow id="f05" sourceRef="reject" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f06" name="yes" sourceRef="valid_gw" targetRef="prelim_confirm" />
    <bpmn:sequenceFlow id="f07" sourceRef="prelim_confirm" targetRef="prepare_readmission" />
    <bpmn:sequenceFlow id="f08" sourceRef="prepare_readmission" targetRef="continuation_gw" />
    <bpmn:sequenceFlow id="f09" name="yes" sourceRef="continuation_gw" targetRef="oblige" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="continuation_gw" targetRef="continuation_merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="oblige" targetRef="confirm_continuation" />
    <bpmn:sequenceFlow id="f12" sourceRef="confirm_continuation" targetRef="continuation_merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="continuation_merge" targetRef="equipment" />
    <bpmn:sequenceFlow id="f14" sourceRef="equipment" targetRef="assign" />
    <bpmn:sequenceFlow id="f15" sourceRef="assign" targetRef="inform_mpoo" />
    <bpmn:sequenceFlow id="f16" sourceRef="inform_mpoo" targetRef="inform_mspo" />
    <bpmn:sequenceFlow id="f17" sourceRef="inform_mspo" targetRef="inform_sp" />
    <bpmn:sequenceFlow id="f18" sourceRef="inform_sp" targetRef="end_reassigned" />
  </bpmn:process>
</bpmn:definitions>
