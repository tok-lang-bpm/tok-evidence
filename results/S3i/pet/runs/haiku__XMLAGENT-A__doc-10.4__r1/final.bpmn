<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Equipment change process" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MPON" name="MPON">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyIntention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalReading_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dismount_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFinalReading</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Gw_SelfDismounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceSelfDismounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyNoSelfDismounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalReading_MPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dismount_MPOO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>Task_NotifyMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Equipment change intention" />
    <bpmn:task id="Task_NotifyIntention" name="Notify the MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="Gw_SelfDismounting" name="Self-dismounting?" />
    <bpmn:task id="Task_AnnounceSelfDismounting" name="Announce self dismounting to the MPON" />
    <bpmn:task id="Task_NotifyNoSelfDismounting" name="Notify the MPON about no self-dismounting" />
    <bpmn:task id="Task_FinalReading_MPOO" name="Perform the final reading" />
    <bpmn:task id="Task_Dismount_MPOO" name="Dismount the old equipment" />
    <bpmn:task id="Task_FinalReading_MPON" name="Perform the final reading" />
    <bpmn:task id="Task_Dismount_MPON" name="Dismount the old equipment" />
    <bpmn:exclusiveGateway id="Gw_Merge" name="Equipment dismounted" />
    <bpmn:task id="Task_Mount" name="Mount the new device" />
    <bpmn:task id="Task_ReadMeter" name="Read the meter count from the installed meter" />
    <bpmn:task id="Task_SendFinalReading" name="Send the values of the final reading to the GO" />
    <bpmn:task id="Task_TellGO" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:task id="Task_NotifyMSP" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="End" name="Equipment change notified" />
    <bpmn:sequenceFlow id="F_01" sourceRef="Start" targetRef="Task_NotifyIntention" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_NotifyIntention" targetRef="Gw_SelfDismounting" />
    <bpmn:sequenceFlow id="F_03" name="yes" sourceRef="Gw_SelfDismounting" targetRef="Task_AnnounceSelfDismounting" />
    <bpmn:sequenceFlow id="F_04" name="no" sourceRef="Gw_SelfDismounting" targetRef="Task_NotifyNoSelfDismounting" />
    <bpmn:sequenceFlow id="F_05" sourceRef="Task_AnnounceSelfDismounting" targetRef="Task_FinalReading_MPOO" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Task_FinalReading_MPOO" targetRef="Task_Dismount_MPOO" />
    <bpmn:sequenceFlow id="F_07" sourceRef="Task_Dismount_MPOO" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_08" sourceRef="Task_NotifyNoSelfDismounting" targetRef="Task_FinalReading_MPON" />
    <bpmn:sequenceFlow id="F_09" sourceRef="Task_FinalReading_MPON" targetRef="Task_Dismount_MPON" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_Dismount_MPON" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Gw_Merge" targetRef="Task_Mount" />
    <bpmn:sequenceFlow id="F_12" sourceRef="Task_Mount" targetRef="Task_ReadMeter" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_ReadMeter" targetRef="Task_SendFinalReading" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_SendFinalReading" targetRef="Task_TellGO" />
    <bpmn:sequenceFlow id="F_15" sourceRef="Task_TellGO" targetRef="Task_NotifyMSP" />
    <bpmn:sequenceFlow id="F_16" sourceRef="Task_NotifyMSP" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
