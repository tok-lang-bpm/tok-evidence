<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Organisation" name="Organisation" processRef="Process_DeviceTakeover" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DeviceTakeover" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestBid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_SendTender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMasterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Device takeover needed" />
    <bpmn:task id="Task_RequestBid" name="Request device takeover bid" />
    <bpmn:task id="Task_SendTender" name="Send tender for equipment takeover" />
    <bpmn:task id="Task_PlaceOrder" name="Place order" />
    <bpmn:task id="Task_ConfirmOrder" name="Confirm order" />
    <bpmn:task id="Task_SendMasterData" name="Send master data" />
    <bpmn:endEvent id="End_1" name="Order confirmed and master data sent" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_RequestBid" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RequestBid" targetRef="Task_SendTender" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SendTender" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PlaceOrder" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ConfirmOrder" targetRef="Task_SendMasterData" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SendMasterData" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
