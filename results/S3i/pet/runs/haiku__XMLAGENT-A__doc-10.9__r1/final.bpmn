<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_SP" name="SP / PU / GO">
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPO" name="MPO">
        <bpmn:flowNodeRef>Start_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Initiator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Change" name="Change of measuring point needed" />
    <bpmn:exclusiveGateway id="Gw_Initiator" name="Change requested by SP / PU / GO?" />
    <bpmn:task id="Task_Request" name="Request change of measuring point" />
    <bpmn:task id="Task_Cause" name="Cause change of measuring point" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Review" name="Review change request" />
    <bpmn:exclusiveGateway id="Gw_Decision" name="Request confirmed?" />
    <bpmn:task id="Task_Reject" name="Reject change request" />
    <bpmn:task id="Task_Confirm" name="Confirm change request" />
    <bpmn:endEvent id="End_Rejected" name="Change request rejected" />
    <bpmn:task id="Task_Perform" name="Perform measuring point change" />
    <bpmn:exclusiveGateway id="Gw_Result" name="Change implemented?" />
    <bpmn:task id="Task_Report" name="Report implementation to SP / PU / GO" />
    <bpmn:task id="Task_Notify" name="Notify SP / PU / GO about failure of change" />
    <bpmn:endEvent id="End_Done" name="Change implemented" />
    <bpmn:endEvent id="End_Failed" name="Change failed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Change" targetRef="Gw_Initiator" />
    <bpmn:sequenceFlow id="F2" name="yes" sourceRef="Gw_Initiator" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F3" name="no" sourceRef="Gw_Initiator" targetRef="Task_Cause" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Request" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Cause" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Merge" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Review" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F8" name="rejected" sourceRef="Gw_Decision" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F9" name="confirmed" sourceRef="Gw_Decision" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Confirm" targetRef="Task_Perform" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Perform" targetRef="Gw_Result" />
    <bpmn:sequenceFlow id="F13" name="yes" sourceRef="Gw_Result" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="F14" name="no" sourceRef="Gw_Result" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Report" targetRef="End_Done" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Notify" targetRef="End_Failed" />
  </bpmn:process>
</bpmn:definitions>
