<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="msg_CustReport" name="Report on service performance and problem resolution" />
  <bpmn:message id="msg_Status" name="Status report" />
  <bpmn:message id="msg_Restore" name="Request for automatic resource restoration" />
  <bpmn:message id="msg_TS" name="Trouble-shooting report" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_Teco" name="TELECO" processRef="process_Teco" />
  </bpmn:collaboration>
  <bpmn:process id="process_Teco" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_Customer" name="Customer">
        <bpmn:flowNodeRef>start_Cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rec_CustReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_Cust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_CS" name="Customer Service">
        <bpmn:flowNodeRef>task_EnterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_CompareSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_DetermineCM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>svc_Signif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_Premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>call_ExtraFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_Significant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_Reprior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_CreateDetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendDetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_CS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_CreateCustRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendCustRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_RebateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_CS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_SM" name="Service Management">
        <bpmn:flowNodeRef>task_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_Analysable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_Analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_TroubleRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendToRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_StatusRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_FS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_FinalStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_CM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendPerf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_Corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_Res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_ResolutionRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendResRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_RestoreReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendRestore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_TS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_SM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_SM2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_RP" name="Resource Provisioning">
        <bpmn:flowNodeRef>task_CheckProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ProbDet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_AnalyseRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_TroubleRepRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_Notif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_RP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_StatusRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_Restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_2d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_RPterm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_CorrRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_TSReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_SendTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>psplit_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_RP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_BC" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>task_AdjustBilling</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_Cust" name="Customer perceives service degradation" />
    <bpmn:task id="task_SendList" name="Send list of problem parameters to Customer Service" />
    <bpmn:receiveTask id="rec_CustReport" name="Receive report on service performance and problem resolution" messageRef="msg_CustReport" />
    <bpmn:endEvent id="end_Cust" name="Customer process ends" />

    <bpmn:task id="task_EnterReport" name="Enter problem report into system T" />
    <bpmn:task id="task_CompareSLA" name="Compare problem report with customer SLA" />
    <bpmn:task id="task_DetermineCM" name="Determine counter measures and their priorities" />
    <bpmn:serviceTask id="svc_Signif" name="Determine customer significance (electronic service)" />
    <bpmn:exclusiveGateway id="gw_Premium" name="Premium customer?" />
    <bpmn:callActivity id="call_ExtraFix" name="Link to extra problem fix process" calledElement="ExtraProblemFixProcess" />
    <bpmn:exclusiveGateway id="gw_Significant" name="Significance affects counter measures?" />
    <bpmn:task id="task_Reprior" name="Re-prioritise counter measures" />
    <bpmn:exclusiveGateway id="merge_A" />
    <bpmn:task id="task_CreateDetailed" name="Create detailed problem report" />
    <bpmn:task id="task_SendDetailed" name="Send detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="merge_CS" />
    <bpmn:parallelGateway id="par_Split" />
    <bpmn:task id="task_CreateCustRep" name="Create report for customer on service performance and problem resolution" />
    <bpmn:task id="task_SendCustRep" name="Send report to customer" />
    <bpmn:parallelGateway id="psplit_1" />
    <bpmn:task id="task_RebateReport" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="par_Join" />
    <bpmn:endEvent id="end_CS" name="Customer Service process ends" />

    <bpmn:task id="task_Investigate" name="Investigate whether problem is analysable by Service Management" />
    <bpmn:exclusiveGateway id="gw_Analysable" name="Problem analysable by Service Management?" />
    <bpmn:task id="task_Analyse" name="Analyse problem" />
    <bpmn:task id="task_TroubleRep" name="Create trouble report indicating type of problem" />
    <bpmn:task id="task_SendToRP" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:intermediateCatchEvent id="catch_StatusRep" name="Receive status report from Resource Provisioning">
      <bpmn:messageEventDefinition messageRef="msg_Status" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="merge_FS" />
    <bpmn:task id="task_FinalStatus" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="gw_CM" name="Counter measures required?" />
    <bpmn:task id="task_SendPerf" name="Send actual service performance to Customer Service" />
    <bpmn:parallelGateway id="psplit_2" />
    <bpmn:task id="task_Corrective" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="merge_Res" />
    <bpmn:task id="task_ResolutionRep" name="Create problem resolution report" />
    <bpmn:task id="task_SendResRep" name="Send problem resolution report to Customer Service" />
    <bpmn:parallelGateway id="psplit_3" />
    <bpmn:task id="task_RestoreReq" name="Create request for automatic resource restoration" />
    <bpmn:task id="task_SendRestore" name="Send request for automatic resource restoration to Resource Provisioning" />
    <bpmn:parallelGateway id="psplit_4" />
    <bpmn:intermediateCatchEvent id="catch_TS" name="Receive trouble-shooting report from Resource Provisioning">
      <bpmn:messageEventDefinition messageRef="msg_TS" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_SM1" name="Service Management path ends" />
    <bpmn:endEvent id="end_SM2" name="Service Management path ends" />

    <bpmn:task id="task_CheckProblems" name="Check whether there are any possible problems" />
    <bpmn:exclusiveGateway id="gw_ProbDet" name="Problem detected?" />
    <bpmn:task id="task_AnalyseRP" name="Analyse problem" />
    <bpmn:task id="task_TroubleRepRP" name="Create trouble report" />
    <bpmn:task id="task_Notif" name="Create notification about normal service execution" />
    <bpmn:exclusiveGateway id="merge_RP" />
    <bpmn:task id="task_StatusRep" name="Include trouble report or normal execution notification in status report" />
    <bpmn:task id="task_SendStatus" name="Send status report to Service Management" />
    <bpmn:parallelGateway id="psplit_5" />
    <bpmn:eventBasedGateway id="gw_Wait" name="Wait for restoration request" />
    <bpmn:intermediateCatchEvent id="catch_Restore" name="Receive request for automatic resource restoration">
      <bpmn:messageEventDefinition messageRef="msg_Restore" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer_2d" name="Two days after status report">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_RPterm" name="Resource Provisioning terminates process" />
    <bpmn:task id="task_Track" name="Track all possible errors" />
    <bpmn:task id="task_CorrRP" name="Undertake all necessary corrective actions" />
    <bpmn:task id="task_TSReport" name="Create trouble-shooting report" />
    <bpmn:task id="task_SendTS" name="Send trouble-shooting report to Service Management" />
    <bpmn:parallelGateway id="psplit_6" />
    <bpmn:endEvent id="end_RP" name="Resource Provisioning process ends" />

    <bpmn:task id="task_AdjustBilling" name="Adjust billing" />

    <bpmn:sequenceFlow id="f01" sourceRef="start_Cust" targetRef="task_SendList" />
    <bpmn:sequenceFlow id="f02" sourceRef="task_SendList" targetRef="task_EnterReport" />
    <bpmn:sequenceFlow id="f03" sourceRef="task_EnterReport" targetRef="task_CompareSLA" />
    <bpmn:sequenceFlow id="f04" sourceRef="task_CompareSLA" targetRef="task_DetermineCM" />
    <bpmn:sequenceFlow id="f05" sourceRef="task_DetermineCM" targetRef="svc_Signif" />
    <bpmn:sequenceFlow id="f06" sourceRef="svc_Signif" targetRef="gw_Premium" />
    <bpmn:sequenceFlow id="f07" name="yes" sourceRef="gw_Premium" targetRef="call_ExtraFix" />
    <bpmn:sequenceFlow id="f08" name="no" sourceRef="gw_Premium" targetRef="gw_Significant" />
    <bpmn:sequenceFlow id="f09" sourceRef="call_ExtraFix" targetRef="merge_A" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="gw_Significant" targetRef="task_Reprior" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="gw_Significant" targetRef="merge_A" />
    <bpmn:sequenceFlow id="f12" sourceRef="task_Reprior" targetRef="merge_A" />
    <bpmn:sequenceFlow id="f13" sourceRef="merge_A" targetRef="task_CreateDetailed" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_CreateDetailed" targetRef="task_SendDetailed" />
    <bpmn:sequenceFlow id="f15" sourceRef="task_SendDetailed" targetRef="task_Investigate" />
    <bpmn:sequenceFlow id="f16" sourceRef="task_Investigate" targetRef="gw_Analysable" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="gw_Analysable" targetRef="task_Analyse" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="gw_Analysable" targetRef="task_SendToRP" />
    <bpmn:sequenceFlow id="f19" sourceRef="task_Analyse" targetRef="task_TroubleRep" />
    <bpmn:sequenceFlow id="f20" sourceRef="task_TroubleRep" targetRef="merge_FS" />
    <bpmn:sequenceFlow id="f21" sourceRef="task_SendToRP" targetRef="task_CheckProblems" />
    <bpmn:sequenceFlow id="f22" sourceRef="task_SendStatus" targetRef="psplit_5" />
    <bpmn:sequenceFlow id="f23" sourceRef="psplit_5" targetRef="catch_StatusRep" />
    <bpmn:sequenceFlow id="f24" sourceRef="psplit_5" targetRef="gw_Wait" />
    <bpmn:sequenceFlow id="f25" sourceRef="catch_StatusRep" targetRef="merge_FS" />
    <bpmn:sequenceFlow id="f26" sourceRef="merge_FS" targetRef="task_FinalStatus" />
    <bpmn:sequenceFlow id="f27" sourceRef="task_FinalStatus" targetRef="gw_CM" />
    <bpmn:sequenceFlow id="f28" name="No problem detected" sourceRef="gw_CM" targetRef="task_SendPerf" />
    <bpmn:sequenceFlow id="f29" name="Minor corrective actions required" sourceRef="gw_CM" targetRef="task_Corrective" />
    <bpmn:sequenceFlow id="f30" name="Automatic resource restoration required" sourceRef="gw_CM" targetRef="task_RestoreReq" />
    <bpmn:sequenceFlow id="f31" sourceRef="task_SendPerf" targetRef="psplit_2" />
    <bpmn:sequenceFlow id="f32" sourceRef="psplit_2" targetRef="merge_CS" />
    <bpmn:sequenceFlow id="f33" sourceRef="psplit_2" targetRef="end_SM1" />
    <bpmn:sequenceFlow id="f34" sourceRef="task_Corrective" targetRef="merge_Res" />
    <bpmn:sequenceFlow id="f35" sourceRef="merge_Res" targetRef="task_ResolutionRep" />
    <bpmn:sequenceFlow id="f36" sourceRef="task_ResolutionRep" targetRef="task_SendResRep" />
    <bpmn:sequenceFlow id="f37" sourceRef="task_SendResRep" targetRef="psplit_3" />
    <bpmn:sequenceFlow id="f38" sourceRef="psplit_3" targetRef="merge_CS" />
    <bpmn:sequenceFlow id="f39" sourceRef="psplit_3" targetRef="end_SM2" />
    <bpmn:sequenceFlow id="f40" sourceRef="task_RestoreReq" targetRef="task_SendRestore" />
    <bpmn:sequenceFlow id="f41" sourceRef="task_SendRestore" targetRef="psplit_4" />
    <bpmn:sequenceFlow id="f42" sourceRef="psplit_4" targetRef="catch_Restore" />
    <bpmn:sequenceFlow id="f43" sourceRef="psplit_4" targetRef="catch_TS" />
    <bpmn:sequenceFlow id="f44" sourceRef="catch_TS" targetRef="merge_Res" />
    <bpmn:sequenceFlow id="f45" sourceRef="merge_CS" targetRef="par_Split" />
    <bpmn:sequenceFlow id="f46" sourceRef="par_Split" targetRef="task_CreateCustRep" />
    <bpmn:sequenceFlow id="f47" sourceRef="par_Split" targetRef="task_RebateReport" />
    <bpmn:sequenceFlow id="f48" sourceRef="task_CreateCustRep" targetRef="task_SendCustRep" />
    <bpmn:sequenceFlow id="f49" sourceRef="task_SendCustRep" targetRef="psplit_1" />
    <bpmn:sequenceFlow id="f50" sourceRef="psplit_1" targetRef="par_Join" />
    <bpmn:sequenceFlow id="f51" sourceRef="psplit_1" targetRef="rec_CustReport" />
    <bpmn:sequenceFlow id="f52" sourceRef="task_RebateReport" targetRef="task_AdjustBilling" />
    <bpmn:sequenceFlow id="f53" sourceRef="task_AdjustBilling" targetRef="par_Join" />
    <bpmn:sequenceFlow id="f54" sourceRef="par_Join" targetRef="end_CS" />
    <bpmn:sequenceFlow id="f55" sourceRef="rec_CustReport" targetRef="end_Cust" />

    <bpmn:sequenceFlow id="f56" sourceRef="task_CheckProblems" targetRef="gw_ProbDet" />
    <bpmn:sequenceFlow id="f57" name="yes" sourceRef="gw_ProbDet" targetRef="task_AnalyseRP" />
    <bpmn:sequenceFlow id="f58" name="no" sourceRef="gw_ProbDet" targetRef="task_Notif" />
    <bpmn:sequenceFlow id="f59" sourceRef="task_AnalyseRP" targetRef="task_TroubleRepRP" />
    <bpmn:sequenceFlow id="f60" sourceRef="task_TroubleRepRP" targetRef="merge_RP" />
    <bpmn:sequenceFlow id="f61" sourceRef="task_Notif" targetRef="merge_RP" />
    <bpmn:sequenceFlow id="f62" sourceRef="merge_RP" targetRef="task_StatusRep" />
    <bpmn:sequenceFlow id="f63" sourceRef="task_StatusRep" targetRef="task_SendStatus" />
    <bpmn:sequenceFlow id="f64" sourceRef="gw_Wait" targetRef="catch_Restore" />
    <bpmn:sequenceFlow id="f65" sourceRef="gw_Wait" targetRef="timer_2d" />
    <bpmn:sequenceFlow id="f66" sourceRef="timer_2d" targetRef="end_RPterm" />
    <bpmn:sequenceFlow id="f67" sourceRef="catch_Restore" targetRef="task_Track" />
    <bpmn:sequenceFlow id="f68" sourceRef="task_Track" targetRef="task_CorrRP" />
    <bpmn:sequenceFlow id="f69" sourceRef="task_CorrRP" targetRef="task_TSReport" />
    <bpmn:sequenceFlow id="f70" sourceRef="task_TSReport" targetRef="task_SendTS" />
    <bpmn:sequenceFlow id="f71" sourceRef="task_SendTS" targetRef="psplit_6" />
    <bpmn:sequenceFlow id="f72" sourceRef="psplit_6" targetRef="catch_TS" />
    <bpmn:sequenceFlow id="f73" sourceRef="psplit_6" targetRef="end_RP" />
  </bpmn:process>
</bpmn:definitions>
