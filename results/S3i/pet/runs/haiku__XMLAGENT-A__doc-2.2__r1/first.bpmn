<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_supplier" name="New power supplier" processRef="switch_process" />
  </bpmn:collaboration>
  <bpmn:process id="switch_process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_customer" name="Customer">
        <bpmn:flowNodeRef>start_switch_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_transmit_customer_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_check_contract_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_7_days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_withdraw_or_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_withdraw_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_final_billing_received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_customer_service" name="Customer service">
        <bpmn:flowNodeRef>task_receive_customer_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_enter_crm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_compare_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_check_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_errors_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_correct_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_customer_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_create_customer_object</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_customer_object</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_prepare_contract_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_analyse_issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_confirmation_sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_create_cis_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_contract_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_import_meter_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_customer_won</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cis" name="CIS (customer information system)">
        <bpmn:flowNodeRef>task_check_documents_cis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_documents_generated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_regenerate_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_parallel_after_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_grid_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_grid" name="Grid operator">
        <bpmn:flowNodeRef>task_check_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_supplier_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_conflict_demanded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_parallel_no_objection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_terminate_sales_agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_termination_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_parallel_meter_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_transmit_meter_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_parallel_meter_recipients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_compute_final_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_billing_to_old_supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_grid_operator</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_old_supplier" name="Old supplier">
        <bpmn:flowNodeRef>task_create_final_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_final_billing_to_customer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_switch_request" name="Switch-over request" />
    <bpmn:task id="task_transmit_customer_data" name="Transmit customer data to customer service" />
    <bpmn:task id="task_receive_customer_data" name="Receive customer data" />
    <bpmn:task id="task_enter_crm" name="Enter customer data object into CRM system" />
    <bpmn:task id="task_compare_data" name="Compare customer data with internal customer database" />
    <bpmn:task id="task_check_data" name="Check customer data for completeness and plausibility" />
    <bpmn:exclusiveGateway id="gw_errors_found" name="Errors found?" />
    <bpmn:task id="task_correct_errors" name="Correct errors based on error list" />
    <bpmn:exclusiveGateway id="gw_customer_exists" name="Customer exists in customer database?" />
    <bpmn:task id="task_create_customer_object" name="Create new customer object" />
    <bpmn:exclusiveGateway id="gw_merge_customer_object" />
    <bpmn:task id="task_prepare_contract_documents" name="Prepare contract documents for supplier switch" />
    <bpmn:task id="task_check_documents_cis" name="Check contract documents automatically in CIS" />
    <bpmn:exclusiveGateway id="gw_documents_generated" name="Contract documents generated successfully?" />
    <bpmn:task id="task_analyse_issues" name="Analyse and resolve causing issues" />
    <bpmn:task id="task_regenerate_documents" name="Generate contract documents again" />
    <bpmn:parallelGateway id="gw_parallel_after_documents" />
    <bpmn:task id="task_send_confirmation" name="Send confirmation document to customer" />
    <bpmn:endEvent id="end_confirmation_sent" name="Confirmation document sent" />
    <bpmn:task id="task_send_grid_request" name="Send request to grid operator automatically" />
    <bpmn:task id="task_check_concurrence" name="Check switch-over request for supplier concurrence and transmit response comment" />
    <bpmn:exclusiveGateway id="gw_supplier_concurrence" name="Supplier concurrence?" />
    <bpmn:task id="task_inform_suppliers" name="Inform all involved suppliers and demand resolution of conflict" />
    <bpmn:endEvent id="end_conflict_demanded" name="Conflict resolution demanded" />
    <bpmn:parallelGateway id="gw_parallel_no_objection" />
    <bpmn:task id="task_terminate_sales_agreement" name="Communicate with old supplier and terminate sales agreement" />
    <bpmn:endEvent id="end_termination_done" name="Sales agreement terminated" />
    <bpmn:task id="task_create_cis_contract" name="Create CIS contract" />
    <bpmn:task id="task_check_contract_details" name="Check contract details" />
    <bpmn:boundaryEvent id="timer_7_days" name="7 days elapsed: contract regarded as accepted" attachedToRef="task_check_contract_details" cancelActivity="true">
      <bpmn:timerEventDefinition id="timer_7_days_def">
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gw_withdraw_or_confirm" name="Withdraw or confirm?" />
    <bpmn:task id="task_withdraw_contract" name="Withdraw from switch contract" />
    <bpmn:endEvent id="end_withdrawn" name="Switch contract withdrawn" />
    <bpmn:task id="task_confirm_contract" name="Confirm switch contract" />
    <bpmn:exclusiveGateway id="gw_merge_contract_accepted" />
    <bpmn:parallelGateway id="gw_parallel_meter_data" />
    <bpmn:task id="task_transmit_meter_data" name="Transmit power meter data to customer service and old supplier" />
    <bpmn:parallelGateway id="gw_parallel_meter_recipients" />
    <bpmn:task id="task_import_meter_data" name="Import meter data into systems that require the information" />
    <bpmn:endEvent id="end_customer_won" name="Customer won" />
    <bpmn:task id="task_create_final_billing" name="Create final billing" />
    <bpmn:task id="task_send_final_billing_to_customer" name="Send final billing to customer" />
    <bpmn:endEvent id="end_final_billing_received" name="Final billing received" />
    <bpmn:task id="task_compute_final_billing" name="Compute final billing based on meter data" />
    <bpmn:task id="task_send_billing_to_old_supplier" name="Send final billing to old supplier" />
    <bpmn:endEvent id="end_grid_operator" name="Grid operator process ends" />

    <bpmn:sequenceFlow id="f01" sourceRef="start_switch_request" targetRef="task_transmit_customer_data" />
    <bpmn:sequenceFlow id="f02" sourceRef="task_transmit_customer_data" targetRef="task_receive_customer_data" />
    <bpmn:sequenceFlow id="f03" sourceRef="task_receive_customer_data" targetRef="task_enter_crm" />
    <bpmn:sequenceFlow id="f04" sourceRef="task_enter_crm" targetRef="task_compare_data" />
    <bpmn:sequenceFlow id="f05" sourceRef="task_compare_data" targetRef="task_check_data" />
    <bpmn:sequenceFlow id="f06" sourceRef="task_check_data" targetRef="gw_errors_found" />
    <bpmn:sequenceFlow id="f07" name="yes" sourceRef="gw_errors_found" targetRef="task_correct_errors" />
    <bpmn:sequenceFlow id="f08" name="no" sourceRef="gw_errors_found" targetRef="gw_customer_exists" />
    <bpmn:sequenceFlow id="f09" sourceRef="task_correct_errors" targetRef="task_check_data" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="gw_customer_exists" targetRef="task_create_customer_object" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gw_customer_exists" targetRef="gw_merge_customer_object" />
    <bpmn:sequenceFlow id="f12" sourceRef="task_create_customer_object" targetRef="gw_merge_customer_object" />
    <bpmn:sequenceFlow id="f13" sourceRef="gw_merge_customer_object" targetRef="task_prepare_contract_documents" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_prepare_contract_documents" targetRef="task_check_documents_cis" />
    <bpmn:sequenceFlow id="f15" sourceRef="task_check_documents_cis" targetRef="gw_documents_generated" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gw_documents_generated" targetRef="task_analyse_issues" />
    <bpmn:sequenceFlow id="f17" sourceRef="task_analyse_issues" targetRef="task_regenerate_documents" />
    <bpmn:sequenceFlow id="f18" sourceRef="task_regenerate_documents" targetRef="task_check_documents_cis" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="gw_documents_generated" targetRef="gw_parallel_after_documents" />
    <bpmn:sequenceFlow id="f20" sourceRef="gw_parallel_after_documents" targetRef="task_send_confirmation" />
    <bpmn:sequenceFlow id="f21" sourceRef="gw_parallel_after_documents" targetRef="task_send_grid_request" />
    <bpmn:sequenceFlow id="f22" sourceRef="task_send_confirmation" targetRef="end_confirmation_sent" />
    <bpmn:sequenceFlow id="f23" sourceRef="task_send_grid_request" targetRef="task_check_concurrence" />
    <bpmn:sequenceFlow id="f24" sourceRef="task_check_concurrence" targetRef="gw_supplier_concurrence" />
    <bpmn:sequenceFlow id="f25" name="yes" sourceRef="gw_supplier_concurrence" targetRef="task_inform_suppliers" />
    <bpmn:sequenceFlow id="f26" sourceRef="task_inform_suppliers" targetRef="end_conflict_demanded" />
    <bpmn:sequenceFlow id="f27" name="no" sourceRef="gw_supplier_concurrence" targetRef="gw_parallel_no_objection" />
    <bpmn:sequenceFlow id="f28" sourceRef="gw_parallel_no_objection" targetRef="task_terminate_sales_agreement" />
    <bpmn:sequenceFlow id="f29" sourceRef="gw_parallel_no_objection" targetRef="task_create_cis_contract" />
    <bpmn:sequenceFlow id="f30" sourceRef="task_terminate_sales_agreement" targetRef="end_termination_done" />
    <bpmn:sequenceFlow id="f31" sourceRef="task_create_cis_contract" targetRef="task_check_contract_details" />
    <bpmn:sequenceFlow id="f32" sourceRef="task_check_contract_details" targetRef="gw_withdraw_or_confirm" />
    <bpmn:sequenceFlow id="f33" name="withdraw" sourceRef="gw_withdraw_or_confirm" targetRef="task_withdraw_contract" />
    <bpmn:sequenceFlow id="f34" sourceRef="task_withdraw_contract" targetRef="end_withdrawn" />
    <bpmn:sequenceFlow id="f35" name="confirm" sourceRef="gw_withdraw_or_confirm" targetRef="task_confirm_contract" />
    <bpmn:sequenceFlow id="f36" sourceRef="task_confirm_contract" targetRef="gw_merge_contract_accepted" />
    <bpmn:sequenceFlow id="f37" sourceRef="timer_7_days" targetRef="gw_merge_contract_accepted" />
    <bpmn:sequenceFlow id="f38" sourceRef="gw_merge_contract_accepted" targetRef="gw_parallel_meter_data" />
    <bpmn:sequenceFlow id="f39" sourceRef="gw_parallel_meter_data" targetRef="task_transmit_meter_data" />
    <bpmn:sequenceFlow id="f40" sourceRef="gw_parallel_meter_data" targetRef="task_compute_final_billing" />
    <bpmn:sequenceFlow id="f41" sourceRef="task_compute_final_billing" targetRef="task_send_billing_to_old_supplier" />
    <bpmn:sequenceFlow id="f42" sourceRef="task_send_billing_to_old_supplier" targetRef="end_grid_operator" />
    <bpmn:sequenceFlow id="f43" sourceRef="task_transmit_meter_data" targetRef="gw_parallel_meter_recipients" />
    <bpmn:sequenceFlow id="f44" sourceRef="gw_parallel_meter_recipients" targetRef="task_import_meter_data" />
    <bpmn:sequenceFlow id="f45" sourceRef="gw_parallel_meter_recipients" targetRef="task_create_final_billing" />
    <bpmn:sequenceFlow id="f46" sourceRef="task_import_meter_data" targetRef="end_customer_won" />
    <bpmn:sequenceFlow id="f47" sourceRef="task_create_final_billing" targetRef="task_send_final_billing_to_customer" />
    <bpmn:sequenceFlow id="f48" sourceRef="task_send_final_billing_to_customer" targetRef="end_final_billing_received" />
  </bpmn:process>
</bpmn:definitions>
