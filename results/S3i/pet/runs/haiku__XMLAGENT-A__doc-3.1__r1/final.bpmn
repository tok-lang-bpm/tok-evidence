<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Small Claims Registry Operations" processRef="warrant-process" />
  </bpmn:collaboration>
  <bpmn:process id="warrant-process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_party" name="Party">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_backoffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_sct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward_police</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_physical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach_document</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store_expanded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_police" name="Queensland Police">
        <bpmn:flowNodeRef>prepare_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_other" name="Other MC internal staff">
        <bpmn:flowNodeRef>receive_physical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Warrant possession request needed" />
    <bpmn:task id="send_request" name="Send warrant possession request" />
    <bpmn:task id="receive_request" name="Receive warrant possession request" />
    <bpmn:task id="retrieve_sct" name="Retrieve SCT file" />
    <bpmn:task id="forward_police" name="Forward SCT warrant possession to Queensland Police" />
    <bpmn:parallelGateway id="split" name="Split" />
    <bpmn:task id="store_physical" name="Store SCT physical file awaiting report" />
    <bpmn:task id="prepare_report" name="Prepare report" />
    <bpmn:task id="send_report" name="Send report" />
    <bpmn:parallelGateway id="join" name="Report received" />
    <bpmn:task id="retrieve_file" name="Retrieve respective SCT file" />
    <bpmn:task id="attach_document" name="Attach new SCT document" />
    <bpmn:task id="store_expanded" name="Store expanded SCT physical file" />
    <bpmn:task id="receive_physical" name="Receive physical SCT file" />
    <bpmn:endEvent id="end" name="SCT file handed over" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send_request" />
    <bpmn:sequenceFlow id="f2" sourceRef="send_request" targetRef="receive_request" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive_request" targetRef="retrieve_sct" />
    <bpmn:sequenceFlow id="f4" sourceRef="retrieve_sct" targetRef="forward_police" />
    <bpmn:sequenceFlow id="f5" sourceRef="forward_police" targetRef="split" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="store_physical" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="prepare_report" />
    <bpmn:sequenceFlow id="f8" sourceRef="prepare_report" targetRef="send_report" />
    <bpmn:sequenceFlow id="f9" sourceRef="send_report" targetRef="join" />
    <bpmn:sequenceFlow id="f10" sourceRef="store_physical" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="join" targetRef="retrieve_file" />
    <bpmn:sequenceFlow id="f12" sourceRef="retrieve_file" targetRef="attach_document" />
    <bpmn:sequenceFlow id="f13" sourceRef="attach_document" targetRef="store_expanded" />
    <bpmn:sequenceFlow id="f14" sourceRef="store_expanded" targetRef="receive_physical" />
    <bpmn:sequenceFlow id="f15" sourceRef="receive_physical" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
