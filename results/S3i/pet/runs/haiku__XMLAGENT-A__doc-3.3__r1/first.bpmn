<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Insurance organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_Officer" name="Claims officer">
        <bpmn:flowNodeRef>Start_Registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_Senior" name="Senior claims officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Marked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkNotOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Proceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Registered" name="Claim registered" />
    <bpmn:task id="Task_Examine" name="Examine the claim" />
    <bpmn:task id="Task_WriteRecommendation" name="Write the settlement recommendation" />
    <bpmn:task id="Task_CheckRecommendation" name="Check the settlement recommendation" />
    <bpmn:exclusiveGateway id="Gw_Marked" name="Claim marked as OK?" />
    <bpmn:task id="Task_MarkOK" name="Mark the claim as OK" />
    <bpmn:task id="Task_MarkNotOK" name="Mark the claim as Not OK" />
    <bpmn:task id="Task_SendBack" name="Send the claim back to the claims officer" />
    <bpmn:endEvent id="End_Proceeds" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Registered" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Examine" targetRef="Task_WriteRecommendation" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckRecommendation" targetRef="Gw_Marked" />
    <bpmn:sequenceFlow id="Flow_5" name="OK" sourceRef="Gw_Marked" targetRef="Task_MarkOK" />
    <bpmn:sequenceFlow id="Flow_6" name="Not OK" sourceRef="Gw_Marked" targetRef="Task_MarkNotOK" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_MarkNotOK" targetRef="Task_SendBack" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SendBack" targetRef="Task_WriteRecommendation" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_MarkOK" targetRef="End_Proceeds" />
  </bpmn:process>
</bpmn:definitions>