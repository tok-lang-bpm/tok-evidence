<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool_court" name="Court" processRef="court_process" />
  </bpmn:collaboration>
  <bpmn:process id="court_process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_mailclerk" name="Mail Clerk (Mail Processing Unit)">
        <bpmn:flowNodeRef>start_daily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sortBusinessAreas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_registry" name="Registry">
        <bpmn:flowNodeRef>task_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sortGroups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_arm" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>task_qualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_compileRequisitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sendRequisitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_captureMatter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_provideMatter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_processed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cashier" name="Cashier">
        <bpmn:flowNodeRef>task_fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_partyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_printFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_daily" name="Daily mail collection" />
    <bpmn:task id="task_collect" name="Collect mail from the party" />
    <bpmn:task id="task_sortBusinessAreas" name="Sort unopened mail into business areas" />
    <bpmn:task id="task_distribute" name="Distribute the mail" />
    <bpmn:task id="task_open" name="Open the mail" />
    <bpmn:task id="task_sortGroups" name="Sort the mail into groups for distribution" />
    <bpmn:task id="task_register" name="Register the mail in the manual incoming Mail Register" />
    <bpmn:task id="task_qualityCheck" name="Perform quality check" />
    <bpmn:exclusiveGateway id="gw_compliant" name="Mail compliant?" />
    <bpmn:task id="task_compileRequisitions" name="Compile list of requisitions with reason for rejection" />
    <bpmn:task id="task_sendRequisitions" name="Send list of requisitions to the party" />
    <bpmn:endEvent id="end_rejected" name="Mail rejected" />
    <bpmn:task id="task_captureMatter" name="Capture matter details (types of action)" />
    <bpmn:task id="task_provideMatter" name="Provide matter details to the Cashier" />
    <bpmn:parallelGateway id="gw_split" name="Split" />
    <bpmn:task id="task_fees" name="Take applicable fees attached to the mail" />
    <bpmn:task id="task_envelope" name="Put receipt and copied documents into an envelope" />
    <bpmn:task id="task_post" name="Post the envelope to the party" />
    <bpmn:task id="task_partyDetails" name="Capture party details" />
    <bpmn:task id="task_printFile" name="Print physical court file" />
    <bpmn:parallelGateway id="gw_join" name="Join" />
    <bpmn:endEvent id="end_processed" name="Mail processed" />

    <bpmn:sequenceFlow id="f01" sourceRef="start_daily" targetRef="task_collect" />
    <bpmn:sequenceFlow id="f02" sourceRef="task_collect" targetRef="task_sortBusinessAreas" />
    <bpmn:sequenceFlow id="f03" sourceRef="task_sortBusinessAreas" targetRef="task_distribute" />
    <bpmn:sequenceFlow id="f04" sourceRef="task_distribute" targetRef="task_open" />
    <bpmn:sequenceFlow id="f05" sourceRef="task_open" targetRef="task_sortGroups" />
    <bpmn:sequenceFlow id="f06" sourceRef="task_sortGroups" targetRef="task_register" />
    <bpmn:sequenceFlow id="f07" sourceRef="task_register" targetRef="task_qualityCheck" />
    <bpmn:sequenceFlow id="f08" sourceRef="task_qualityCheck" targetRef="gw_compliant" />
    <bpmn:sequenceFlow id="f09" name="no" sourceRef="gw_compliant" targetRef="task_compileRequisitions" />
    <bpmn:sequenceFlow id="f10" sourceRef="task_compileRequisitions" targetRef="task_sendRequisitions" />
    <bpmn:sequenceFlow id="f11" sourceRef="task_sendRequisitions" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="gw_compliant" targetRef="task_captureMatter" />
    <bpmn:sequenceFlow id="f13" sourceRef="task_captureMatter" targetRef="task_provideMatter" />
    <bpmn:sequenceFlow id="f14" sourceRef="task_provideMatter" targetRef="gw_split" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_split" targetRef="task_fees" />
    <bpmn:sequenceFlow id="f16" sourceRef="gw_split" targetRef="task_partyDetails" />
    <bpmn:sequenceFlow id="f17" sourceRef="task_fees" targetRef="task_envelope" />
    <bpmn:sequenceFlow id="f18" sourceRef="task_envelope" targetRef="task_post" />
    <bpmn:sequenceFlow id="f19" sourceRef="task_post" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="task_partyDetails" targetRef="task_printFile" />
    <bpmn:sequenceFlow id="f21" sourceRef="task_printFile" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f22" sourceRef="gw_join" targetRef="end_processed" />
  </bpmn:process>
</bpmn:definitions>
