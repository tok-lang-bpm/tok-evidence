<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Insurer" name="Insurance organisation" processRef="Process_Claim" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Claim" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Handler" name="Claims handler">
        <bpmn:flowNodeRef>Start_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Claims manager">
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Claim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Claim" name="Car accident claim received" />
    <bpmn:task id="Task_SearchReport" name="Search the Police Report in the Police Report database" />
    <bpmn:task id="Task_CompileFile" name="Put the Police Report and the Claim Documentation in a file" />
    <bpmn:task id="Task_CalculateEstimate" name="Calculate the initial claim estimate" />
    <bpmn:task id="Task_CreateActionPlan" name="Create the Action Plan based on the Action Plan Checklist" />
    <bpmn:task id="Task_Negotiate" name="Negotiate a settlement on the claim estimate" />
    <bpmn:task id="Task_InformClaimant" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="End_Claim" name="Claim process ended" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Claim" targetRef="Task_SearchReport" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SearchReport" targetRef="Task_CompileFile" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CompileFile" targetRef="Task_CalculateEstimate" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CreateActionPlan" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Negotiate" targetRef="Task_InformClaimant" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_InformClaimant" targetRef="End_Claim" />
  </bpmn:process>
</bpmn:definitions>