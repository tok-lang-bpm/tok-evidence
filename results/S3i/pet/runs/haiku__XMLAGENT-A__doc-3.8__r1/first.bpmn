<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Insurer" name="Car insurer" processRef="Process_Claim" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Claim" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Notification" name="Notification department">
        <bpmn:flowNodeRef>Task_CheckDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterClaim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Handling" name="Handling department">
        <bpmn:flowNodeRef>Task_PickUpClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AssessmentPositive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneGarage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Claim" name="Claim process started" />
    <bpmn:task id="Task_SubmitClaim" name="Submit claim with documentation" />
    <bpmn:task id="Task_CheckDocuments" name="Check documents for completeness" />
    <bpmn:task id="Task_RegisterClaim" name="Register claim" />
    <bpmn:task id="Task_PickUpClaim" name="Pick up claim" />
    <bpmn:task id="Task_CheckInsurance" name="Check insurance" />
    <bpmn:task id="Task_PerformAssessment" name="Perform assessment" />
    <bpmn:exclusiveGateway id="Gw_AssessmentPositive" name="Assessment positive?" />
    <bpmn:task id="Task_PhoneGarage" name="Phone garage to authorise repairs" />
    <bpmn:task id="Task_SchedulePayment" name="Schedule payment" />
    <bpmn:task id="Task_RejectClaim" name="Reject claim" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_SendLetter" name="Send letter to customer" />
    <bpmn:endEvent id="End_Complete" name="Process complete" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Claim" targetRef="Task_SubmitClaim" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitClaim" targetRef="Task_CheckDocuments" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckDocuments" targetRef="Task_RegisterClaim" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_RegisterClaim" targetRef="Task_PickUpClaim" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_PickUpClaim" targetRef="Task_CheckInsurance" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CheckInsurance" targetRef="Task_PerformAssessment" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_PerformAssessment" targetRef="Gw_AssessmentPositive" />
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_AssessmentPositive" targetRef="Task_PhoneGarage" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_PhoneGarage" targetRef="Task_SchedulePayment" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SchedulePayment" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_AssessmentPositive" targetRef="Task_RejectClaim" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RejectClaim" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_Merge" targetRef="Task_SendLetter" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SendLetter" targetRef="End_Complete" />
  </bpmn:process>
</bpmn:definitions>
