<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Mental health care institute" processRef="intake" />
  </bpmn:collaboration>
  <bpmn:process id="intake" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_fd" name="Family doctor">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCopy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sec" name="Secretarial office">
        <bpmn:flowNodeRef>Task_Inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutThrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_New</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PassCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Medical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SplitCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinCopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeMed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TypeTapes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddTyped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_nurse" name="Nursing officer">
        <bpmn:flowNodeRef>Task_Inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandIn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_tl" name="Team leader">
        <bpmn:flowNodeRef>Task_Staff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineMed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_fi" name="First intaker (social-medical worker)">
        <bpmn:flowNodeRef>Task_PlanFirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notebook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CopyNotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddChecklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_si" name="Second intaker (physician)">
        <bpmn:flowNodeRef>Task_PlanSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldSecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dictaphone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Need" name="Patient in need of mental treatment" />
    <bpmn:task id="Task_Notice" name="Give notice by telephone" />
    <bpmn:task id="Task_Inquire" name="Inquire name and residence of patient" />
    <bpmn:task id="Task_PutThrough" name="Put doctor through to responsible nursing officer" />
    <bpmn:task id="Task_Inquiry" name="Make full inquiry into mental, health and social state of patient" />
    <bpmn:task id="Task_RecordForm" name="Record information on registration form" />
    <bpmn:task id="Task_HandIn" name="Hand in registration form at secretarial office" />
    <bpmn:task id="Task_StoreInfo" name="Store information in information system" />
    <bpmn:task id="Task_Print" name="Print information from information system" />
    <bpmn:exclusiveGateway id="Gw_New" name="New patient?" />
    <bpmn:task id="Task_CreateFile" name="Create patient file" />
    <bpmn:exclusiveGateway id="Gw_MergeNew" />
    <bpmn:task id="Task_StoreFile" name="Store registration form and print in patient file" />
    <bpmn:task id="Task_Cards" name="Produce two registration cards" />
    <bpmn:task id="Task_AddList" name="Add new patient to list of new notices" />
    <bpmn:task id="Task_Staff" name="Hold staff meeting of medical team" />
    <bpmn:task id="Task_Assign" name="Assign first and second intaker to each new patient" />
    <bpmn:task id="Task_RecordAssign" name="Record assignments on assignment list" />
    <bpmn:task id="Task_DetermineMed" name="Determine whether medical file is required" />
    <bpmn:task id="Task_HandList" name="Hand assignment list to secretarial office" />
    <bpmn:task id="Task_StoreAssign" name="Store assignment of each patient in information system" />
    <bpmn:task id="Task_PassCards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="Gw_Split1" />

    <bpmn:task id="Task_PlanFirst" name="Plan first meeting with patient" />
    <bpmn:task id="Task_Examine" name="Examine patient using standard checklist" />
    <bpmn:task id="Task_Notebook" name="Record additional observations in personal notebook" />
    <bpmn:task id="Task_CopyNotes" name="Put copy of notes in patient file" />
    <bpmn:task id="Task_AddChecklist" name="Add standard checklist to patient file" />

    <bpmn:exclusiveGateway id="Gw_Medical" name="Medical file required?" />
    <bpmn:task id="Task_SendLetter" name="Prepare and send letter requesting copy of medical file" />
    <bpmn:task id="Task_SendCopy" name="Send copy of medical file" />
    <bpmn:receiveTask id="Task_ReceiveCopy" name="Receive copy of medical file" />
    <bpmn:parallelGateway id="Gw_SplitCopy" />
    <bpmn:task id="Task_InformSecond" name="Inform second intaker" />
    <bpmn:task id="Task_AddCopy" name="Add copy to patient file" />
    <bpmn:parallelGateway id="Gw_JoinCopy" />
    <bpmn:exclusiveGateway id="Gw_MergeMed" />

    <bpmn:task id="Task_PlanSecond" name="Plan first meeting with patient after medical information received" />
    <bpmn:task id="Task_HoldSecond" name="Hold first meeting with patient" />
    <bpmn:task id="Task_Dictaphone" name="Record observations on dictaphone" />
    <bpmn:task id="Task_TypeTapes" name="Type out dictaphone tapes" />
    <bpmn:task id="Task_AddTyped" name="Add typed information to patient file" />
    <bpmn:parallelGateway id="Gw_JoinAll" />

    <bpmn:task id="Task_PutList" name="Put patient on list of patients that reach this status" />
    <bpmn:task id="Task_ProvideList" name="Provide team leader with list of these patients" />
    <bpmn:task id="Task_Treatment" name="Formulate treatment plan with first and second intaker, team leader and psychiatrist" />
    <bpmn:endEvent id="End_Done" name="Intake procedure ended" />

    <bpmn:sequenceFlow id="F01" sourceRef="Start_Need" targetRef="Task_Notice" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Notice" targetRef="Task_Inquire" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Inquire" targetRef="Task_PutThrough" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_PutThrough" targetRef="Task_Inquiry" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_Inquiry" targetRef="Task_RecordForm" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_RecordForm" targetRef="Task_HandIn" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_HandIn" targetRef="Task_StoreInfo" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_StoreInfo" targetRef="Task_Print" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Print" targetRef="Gw_New" />
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="Gw_New" targetRef="Task_CreateFile" />
    <bpmn:sequenceFlow id="F11" name="no" sourceRef="Gw_New" targetRef="Gw_MergeNew" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_CreateFile" targetRef="Gw_MergeNew" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_MergeNew" targetRef="Task_StoreFile" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_StoreFile" targetRef="Task_Cards" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Cards" targetRef="Task_AddList" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_AddList" targetRef="Task_Staff" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Staff" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Assign" targetRef="Task_RecordAssign" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_RecordAssign" targetRef="Task_DetermineMed" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_DetermineMed" targetRef="Task_HandList" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_HandList" targetRef="Task_StoreAssign" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_StoreAssign" targetRef="Task_PassCards" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_PassCards" targetRef="Gw_Split1" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_Split1" targetRef="Task_PlanFirst" />
    <bpmn:sequenceFlow id="F25" sourceRef="Gw_Split1" targetRef="Gw_Medical" />
    <bpmn:sequenceFlow id="F26" name="yes" sourceRef="Gw_Medical" targetRef="Task_SendLetter" />
    <bpmn:sequenceFlow id="F27" name="no" sourceRef="Gw_Medical" targetRef="Gw_MergeMed" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_SendLetter" targetRef="Task_SendCopy" />
    <bpmn:sequenceFlow id="F29" sourceRef="Task_SendCopy" targetRef="Task_ReceiveCopy" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_ReceiveCopy" targetRef="Gw_SplitCopy" />
    <bpmn:sequenceFlow id="F31" sourceRef="Gw_SplitCopy" targetRef="Task_InformSecond" />
    <bpmn:sequenceFlow id="F32" sourceRef="Gw_SplitCopy" targetRef="Task_AddCopy" />
    <bpmn:sequenceFlow id="F33" sourceRef="Task_InformSecond" targetRef="Gw_JoinCopy" />
    <bpmn:sequenceFlow id="F34" sourceRef="Task_AddCopy" targetRef="Gw_JoinCopy" />
    <bpmn:sequenceFlow id="F35" sourceRef="Gw_JoinCopy" targetRef="Gw_MergeMed" />
    <bpmn:sequenceFlow id="F36" sourceRef="Gw_MergeMed" targetRef="Task_PlanSecond" />
    <bpmn:sequenceFlow id="F37" sourceRef="Task_PlanSecond" targetRef="Task_HoldSecond" />
    <bpmn:sequenceFlow id="F38" sourceRef="Task_HoldSecond" targetRef="Task_Dictaphone" />
    <bpmn:sequenceFlow id="F39" sourceRef="Task_Dictaphone" targetRef="Task_TypeTapes" />
    <bpmn:sequenceFlow id="F40" sourceRef="Task_TypeTapes" targetRef="Task_AddTyped" />
    <bpmn:sequenceFlow id="F41" sourceRef="Task_AddTyped" targetRef="Gw_JoinAll" />
    <bpmn:sequenceFlow id="F42" sourceRef="Task_PlanFirst" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="F43" sourceRef="Task_Examine" targetRef="Task_Notebook" />
    <bpmn:sequenceFlow id="F44" sourceRef="Task_Notebook" targetRef="Task_CopyNotes" />
    <bpmn:sequenceFlow id="F45" sourceRef="Task_CopyNotes" targetRef="Task_AddChecklist" />
    <bpmn:sequenceFlow id="F46" sourceRef="Task_AddChecklist" targetRef="Gw_JoinAll" />
    <bpmn:sequenceFlow id="F47" sourceRef="Gw_JoinAll" targetRef="Task_PutList" />
    <bpmn:sequenceFlow id="F48" sourceRef="Task_PutList" targetRef="Task_ProvideList" />
    <bpmn:sequenceFlow id="F49" sourceRef="Task_ProvideList" targetRef="Task_Treatment" />
    <bpmn:sequenceFlow id="F50" sourceRef="Task_Treatment" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>
