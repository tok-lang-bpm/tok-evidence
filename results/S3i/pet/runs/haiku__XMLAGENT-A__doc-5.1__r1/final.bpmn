<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Loan" name="Loan approval" processRef="Process_Loan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Loan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Office" name="Loan office">
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendApprover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFeedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assessor" name="Risk assessment Web service">
        <bpmn:flowNodeRef>Svc_Assess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Approver Web service">
        <bpmn:flowNodeRef>Svc_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Loan request needed" />
    <bpmn:task id="Task_Submit" name="Submit loan request for loan amount" />
    <bpmn:task id="Task_Receive" name="Receive customer request for loan amount" />
    <bpmn:task id="Task_Invoke" name="Invoke risk assessment Web service" />
    <bpmn:serviceTask id="Svc_Assess" name="Assess loan request" />
    <bpmn:exclusiveGateway id="Gw_Review" name="Further review needed or loan amount 10,000 or more?" />
    <bpmn:task id="Task_SendApprover" name="Send request to approver Web service" />
    <bpmn:serviceTask id="Svc_Approve" name="Approve request" />
    <bpmn:exclusiveGateway id="Gw_Risk" name="Customer high risk?" />
    <bpmn:task id="Task_Deny" name="Deny loan" />
    <bpmn:task id="Task_Approve" name="Approve loan" />
    <bpmn:exclusiveGateway id="Gw_Decided" name="Decision made" />
    <bpmn:task id="Task_SendFeedback" name="Send feedback to customer" />
    <bpmn:task id="Task_ReceiveFeedback" name="Receive feedback on loan decision" />
    <bpmn:endEvent id="End_Done" name="Loan request handled" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Request" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submit" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Receive" targetRef="Task_Invoke" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Invoke" targetRef="Svc_Assess" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Svc_Assess" targetRef="Gw_Review" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_Review" targetRef="Task_SendApprover" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_Review" targetRef="Gw_Risk" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SendApprover" targetRef="Svc_Approve" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Svc_Approve" targetRef="Gw_Decided" />
    <bpmn:sequenceFlow id="Flow_10" name="yes" sourceRef="Gw_Risk" targetRef="Task_Deny" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_Risk" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Deny" targetRef="Gw_Decided" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Approve" targetRef="Gw_Decided" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_Decided" targetRef="Task_SendFeedback" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendFeedback" targetRef="Task_ReceiveFeedback" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReceiveFeedback" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>
