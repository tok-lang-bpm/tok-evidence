<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_paid" name="Payment confirmed" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_org" name="Organisation" processRef="Process_expense" />
  </bpmn:collaboration>
  <bpmn:process id="Process_expense" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_employee" name="Employee">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_submit_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Gw_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_firstinsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_review_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_treasurer" name="Treasurer">
        <bpmn:flowNodeRef>Task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_payment" name="Payment system">
        <bpmn:flowNodeRef>Task_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Product or service required" />
    <bpmn:task id="Task_purchase" name="Purchase product or service" />
    <bpmn:exclusiveGateway id="Gw_submit_merge" name="Report to submit?" />
    <bpmn:task id="Task_submit" name="Submit expense report with list of items and receipts" />
    <bpmn:task id="Task_edit" name="Edit expense report" />

    <bpmn:exclusiveGateway id="Gw_rules" name="Decidable on first inspection by expense rules?" />
    <bpmn:task id="Task_firstinsp" name="Accept or reject report on first inspection" />
    <bpmn:task id="Task_review" name="Review expense report" />
    <bpmn:exclusiveGateway id="Gw_review_merge" />
    <bpmn:exclusiveGateway id="Gw_approved" name="Report approved?" />

    <bpmn:task id="Task_check" name="Check receipts against items on the list" />
    <bpmn:exclusiveGateway id="Gw_complete" name="Receipts submitted and matching?" />
    <bpmn:task id="Task_accept" name="Accept expenses for processing" />
    <bpmn:task id="Task_return" name="Return report to employee" />

    <bpmn:serviceTask id="Task_pay" name="Link to payment system for payment or refund and accounting" />
    <bpmn:intermediateCatchEvent id="Event_wait" name="Wait for payment confirmation">
      <bpmn:messageEventDefinition id="MED_paid" messageRef="Msg_paid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_1" name="Expenses paid" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_purchase" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_purchase" targetRef="Gw_submit_merge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_edit" targetRef="Gw_submit_merge" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_submit_merge" targetRef="Task_submit" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_submit" targetRef="Gw_rules" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_rules" targetRef="Task_firstinsp" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_rules" targetRef="Task_review" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_firstinsp" targetRef="Gw_review_merge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_review" targetRef="Gw_review_merge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_review_merge" targetRef="Gw_approved" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_approved" targetRef="Task_check" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gw_approved" targetRef="Task_edit" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_check" targetRef="Gw_complete" />
    <bpmn:sequenceFlow id="Flow_14" name="yes" sourceRef="Gw_complete" targetRef="Task_accept" />
    <bpmn:sequenceFlow id="Flow_15" name="no" sourceRef="Gw_complete" targetRef="Task_return" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_return" targetRef="Task_edit" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_accept" targetRef="Task_pay" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_pay" targetRef="Event_wait" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_wait" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
