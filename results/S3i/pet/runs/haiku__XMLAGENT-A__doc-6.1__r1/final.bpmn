<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL_ACME" name="ACME AG" processRef="PROCESS_INVOICE" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS_INVOICE" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_SEC" name="Secretariat">
        <bpmn:flowNodeRef>S_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_forward_acc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ACC" name="Accounting employee">
        <bpmn:flowNodeRef>T_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_note_docket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_send_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_merge_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_merge_clar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_forward_commercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resolve_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_file_sig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pay_instr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CCM" name="Cost center managers">
        <bpmn:flowNodeRef>G_merge_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mark_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pass_next</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CM" name="Commercial manager">
        <bpmn:flowNodeRef>G_merge_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_merge_amt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BOARD" name="Board">
        <bpmn:flowNodeRef>T_board</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="S_start" name="Invoice received on paper or by fax" />
    <bpmn:task id="T_receive" name="Receive invoice in central inbox" />
    <bpmn:task id="T_inspect" name="Inspect invoice visually" />
    <bpmn:task id="T_forward_acc" name="Forward invoice to accounting employee" />
    <bpmn:task id="T_identify" name="Identify charging suppliers" />
    <bpmn:task id="T_create" name="Create new invoice instance in ACME Financial Accounting" />
    <bpmn:task id="T_check_items" name="Check invoice items" />
    <bpmn:task id="T_note_docket" name="Note cost center and cost center managers for each position on docket" />
    <bpmn:task id="T_send_first" name="Send docket and copy of invoice to first cost center manager" />
    <bpmn:exclusiveGateway id="G_merge_review" />
    <bpmn:task id="T_review" name="Review invoice items for accuracy" />
    <bpmn:exclusiveGateway id="G_ok" name="Everything in order?" />
    <bpmn:task id="T_mark_ap" name="Mark position AP on docket" />
    <bpmn:task id="T_reject" name="Reject AP with note and explanatory statement on docket" />
    <bpmn:exclusiveGateway id="G_more" name="More cost center managers on the docket?" />
    <bpmn:task id="T_pass_next" name="Pass copy of invoice to next cost center manager" />
    <bpmn:exclusiveGateway id="G_merge_clar" />
    <bpmn:task id="T_clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="G_consult" name="Consult cost center managers again?" />
    <bpmn:task id="T_consult" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="G_merge_consult" />
    <bpmn:exclusiveGateway id="G_resolved" name="All inconsistencies resolved?" />
    <bpmn:task id="T_resend" name="Send copy of invoice to cost center managers again" />
    <bpmn:task id="T_forward_commercial" name="Forward copy of invoice to commercial manager" />
    <bpmn:exclusiveGateway id="G_merge_audit" />
    <bpmn:task id="T_audit" name="Perform commercial audit" />
    <bpmn:exclusiveGateway id="G_complaint" name="Complaint during commercial audit?" />
    <bpmn:task id="T_resolve_complaint" name="Resolve complaint with supplier" />
    <bpmn:task id="T_approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="G_amount" name="Bill amount exceeds EUR 20?" />
    <bpmn:task id="T_board" name="Check invoice again (four-eyes principle)" />
    <bpmn:exclusiveGateway id="G_merge_amt" />
    <bpmn:task id="T_file_sig" name="Return copy of invoice and docket to accounting in signature file" />
    <bpmn:task id="T_pay_instr" name="Give payment instructions" />
    <bpmn:task id="T_close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="E_end" name="Invoice processed" />

    <bpmn:sequenceFlow id="F01" sourceRef="S_start" targetRef="T_receive" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_receive" targetRef="T_inspect" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_inspect" targetRef="T_forward_acc" />
    <bpmn:sequenceFlow id="F04" sourceRef="T_forward_acc" targetRef="T_identify" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_identify" targetRef="T_create" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_create" targetRef="T_check_items" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_check_items" targetRef="T_note_docket" />
    <bpmn:sequenceFlow id="F08" sourceRef="T_note_docket" targetRef="T_send_first" />
    <bpmn:sequenceFlow id="F09" sourceRef="T_send_first" targetRef="G_merge_review" />
    <bpmn:sequenceFlow id="F10" sourceRef="G_merge_review" targetRef="T_review" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_review" targetRef="G_ok" />
    <bpmn:sequenceFlow id="F12" name="yes" sourceRef="G_ok" targetRef="T_mark_ap" />
    <bpmn:sequenceFlow id="F13" name="no" sourceRef="G_ok" targetRef="T_reject" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_mark_ap" targetRef="G_more" />
    <bpmn:sequenceFlow id="F15" name="yes" sourceRef="G_more" targetRef="T_pass_next" />
    <bpmn:sequenceFlow id="F16" name="no" sourceRef="G_more" targetRef="T_forward_commercial" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_pass_next" targetRef="G_merge_review" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_reject" targetRef="G_merge_clar" />
    <bpmn:sequenceFlow id="F19" sourceRef="G_merge_clar" targetRef="T_clarify" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_clarify" targetRef="G_consult" />
    <bpmn:sequenceFlow id="F21" name="yes" sourceRef="G_consult" targetRef="T_consult" />
    <bpmn:sequenceFlow id="F22" name="no" sourceRef="G_consult" targetRef="G_merge_consult" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_consult" targetRef="G_merge_consult" />
    <bpmn:sequenceFlow id="F24" sourceRef="G_merge_consult" targetRef="G_resolved" />
    <bpmn:sequenceFlow id="F25" name="yes" sourceRef="G_resolved" targetRef="T_resend" />
    <bpmn:sequenceFlow id="F26" name="no" sourceRef="G_resolved" targetRef="G_merge_clar" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_resend" targetRef="G_merge_review" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_forward_commercial" targetRef="G_merge_audit" />
    <bpmn:sequenceFlow id="F29" sourceRef="G_merge_audit" targetRef="T_audit" />
    <bpmn:sequenceFlow id="F30" sourceRef="T_audit" targetRef="G_complaint" />
    <bpmn:sequenceFlow id="F31" name="yes" sourceRef="G_complaint" targetRef="T_resolve_complaint" />
    <bpmn:sequenceFlow id="F32" name="no" sourceRef="G_complaint" targetRef="T_approve" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_resolve_complaint" targetRef="G_merge_audit" />
    <bpmn:sequenceFlow id="F34" sourceRef="T_approve" targetRef="G_amount" />
    <bpmn:sequenceFlow id="F35" name="yes" sourceRef="G_amount" targetRef="T_board" />
    <bpmn:sequenceFlow id="F36" name="no" sourceRef="G_amount" targetRef="G_merge_amt" />
    <bpmn:sequenceFlow id="F37" sourceRef="T_board" targetRef="G_merge_amt" />
    <bpmn:sequenceFlow id="F38" sourceRef="G_merge_amt" targetRef="T_file_sig" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_file_sig" targetRef="T_pay_instr" />
    <bpmn:sequenceFlow id="F40" sourceRef="T_pay_instr" targetRef="T_close" />
    <bpmn:sequenceFlow id="F41" sourceRef="T_close" targetRef="E_end" />
  </bpmn:process>
</bpmn:definitions>
