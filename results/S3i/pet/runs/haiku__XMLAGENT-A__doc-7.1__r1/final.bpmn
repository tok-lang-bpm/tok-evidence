<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Sales" name="Sales Organisation" processRef="Process_Leads" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Leads" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sales">
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallNext</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Leads to work on" />
    <bpmn:task id="Task_CheckLeads" name="Check the open leads" />
    <bpmn:task id="Task_SelectLeads" name="Select the top five leads" />
    <bpmn:task id="Task_TellAssistant" name="Tell the Sales Assistant to call the contact persons of the leads" />
    <bpmn:exclusiveGateway id="Gw_Merge" name="Next customer?" />
    <bpmn:task id="Task_CallCustomer" name="Call each customer" />
    <bpmn:exclusiveGateway id="Gw_Interested" name="Someone interested?" />
    <bpmn:task id="Task_SendNote" name="Send a note to the Manager" />
    <bpmn:task id="Task_ProcessLead" name="Process the lead" />
    <bpmn:task id="Task_CallNext" name="Call the next customer" />
    <bpmn:endEvent id="End_1" name="Lead processed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_CheckLeads" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckLeads" targetRef="Task_SelectLeads" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectLeads" targetRef="Task_TellAssistant" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_TellAssistant" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_Merge" targetRef="Task_CallCustomer" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CallCustomer" targetRef="Gw_Interested" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_Interested" targetRef="Task_SendNote" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_Interested" targetRef="Task_CallNext" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SendNote" targetRef="Task_ProcessLead" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ProcessLead" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CallNext" targetRef="Gw_Merge" />
  </bpmn:process>
</bpmn:definitions>
