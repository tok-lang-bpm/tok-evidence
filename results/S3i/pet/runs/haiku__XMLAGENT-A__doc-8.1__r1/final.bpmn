<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Post" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="Collaboration_Post">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Post" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Post" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Post">
      <bpmn:lane id="Lane_Dept" name="Functional department">
        <bpmn:flowNodeRef>Start_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human resources">
        <bpmn:flowNodeRef>Task_Advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Filled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Demand" name="Demand to fill a post received" />
    <bpmn:task id="Task_Advertise" name="Advertise the post" />
    <bpmn:task id="Task_Apply" name="Apply for the post" />
    <bpmn:task id="Task_Check" name="Check the applications" />
    <bpmn:task id="Task_Conclude" name="Conclude a contract of employment" />
    <bpmn:endEvent id="End_Filled" name="Post filled" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Demand" targetRef="Task_Advertise" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Advertise" targetRef="Task_Apply" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Apply" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Check" targetRef="Task_Conclude" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Conclude" targetRef="End_Filled" />
  </bpmn:process>
</bpmn:definitions>
