<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Vacancy" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Vacancy" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="HR clerk">
        <bpmn:flowNodeRef>Merge_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Unclear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskDept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Posted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dept" name="Department">
        <bpmn:flowNodeRef>Start_Vacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Vacancy" name="Vacancy reported" />
    <bpmn:task id="Task_Report" name="Report the vacancy" />
    <bpmn:exclusiveGateway id="Merge_Info" />
    <bpmn:task id="Task_Create" name="Create the job description" />
    <bpmn:exclusiveGateway id="Gw_Unclear" name="Information unclear?" />
    <bpmn:task id="Task_AskDept" name="Ask the Department again" />
    <bpmn:task id="Task_Answer" name="Answer the questions" />
    <bpmn:task id="Task_Submit" name="Submit the job description for consideration" />
    <bpmn:exclusiveGateway id="Merge_Review" />
    <bpmn:task id="Task_Review" name="Review the job description" />
    <bpmn:exclusiveGateway id="Gw_Approved" name="Approved?" />
    <bpmn:task id="Task_Post" name="Post the job" />
    <bpmn:task id="Task_Correct" name="Correct the job description" />
    <bpmn:task id="Task_Resubmit" name="Submit the corrected job description for consideration" />
    <bpmn:endEvent id="End_Posted" name="Job posted" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Vacancy" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Report" targetRef="Merge_Info" />
    <bpmn:sequenceFlow id="F3" sourceRef="Merge_Info" targetRef="Task_Create" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Create" targetRef="Gw_Unclear" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="Gw_Unclear" targetRef="Task_AskDept" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_AskDept" targetRef="Task_Answer" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Answer" targetRef="Merge_Info" />
    <bpmn:sequenceFlow id="F8" name="no" sourceRef="Gw_Unclear" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Submit" targetRef="Merge_Review" />
    <bpmn:sequenceFlow id="F10" sourceRef="Merge_Review" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Review" targetRef="Gw_Approved" />
    <bpmn:sequenceFlow id="F12" name="yes" sourceRef="Gw_Approved" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="F13" name="no" sourceRef="Gw_Approved" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Correct" targetRef="Task_Resubmit" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Resubmit" targetRef="Merge_Review" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Post" targetRef="End_Posted" />
  </bpmn:process>
</bpmn:definitions>
