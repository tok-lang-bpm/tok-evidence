<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Vacancy" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Vacancy" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Head" name="Head of the functional department">
        <bpmn:flowNodeRef>Start_Requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Personnel Department">
        <bpmn:flowNodeRef>Gw_Join_Questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Advertised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Requirements" name="Personnel requirements detected" />
    <bpmn:task id="Task_Report" name="Report the vacancy to the Personnel Department" />
    <bpmn:exclusiveGateway id="Gw_Join_Questions" />
    <bpmn:exclusiveGateway id="Gw_Questions" name="Questions about tasks and requirements?" />
    <bpmn:task id="Task_Clarify" name="Clarify the tasks and requirements" />
    <bpmn:task id="Task_Describe" name="Describe the job" />
    <bpmn:exclusiveGateway id="Gw_Join_Review" />
    <bpmn:task id="Task_Review" name="Review the job description" />
    <bpmn:exclusiveGateway id="Gw_Corrections" name="Corrections necessary?" />
    <bpmn:task id="Task_RequestCorrections" name="Request corrections to the job description" />
    <bpmn:task id="Task_Correct" name="Correct the job description" />
    <bpmn:task id="Task_Approve" name="Approve the job description" />
    <bpmn:task id="Task_Advertise" name="Advertise the job description" />
    <bpmn:endEvent id="End_Advertised" name="Job advertised" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Requirements" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Report" targetRef="Gw_Join_Questions" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_Join_Questions" targetRef="Gw_Questions" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_Questions" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_Questions" targetRef="Task_Describe" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Clarify" targetRef="Gw_Join_Questions" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Describe" targetRef="Gw_Join_Review" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_Join_Review" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Review" targetRef="Gw_Corrections" />
    <bpmn:sequenceFlow id="Flow_10" name="yes" sourceRef="Gw_Corrections" targetRef="Task_RequestCorrections" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_Corrections" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RequestCorrections" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Correct" targetRef="Gw_Join_Review" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Approve" targetRef="Task_Advertise" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Advertise" targetRef="End_Advertised" />
  </bpmn:process>
</bpmn:definitions>
