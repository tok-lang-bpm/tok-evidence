<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_TPA" name="Town Planning Authority" processRef="Process_MeetingSchedule" />
  </bpmn:collaboration>
  <bpmn:process id="Process_MeetingSchedule" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TPA">
      <bpmn:lane id="Lane_CU" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_November</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SO" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Modifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM" name="Committee Members">
        <bpmn:flowNodeRef>Task_Diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Advised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_November" name="November of each year" />
    <bpmn:task id="Task_Draft" name="Draft schedule of meetings for next calendar year" />
    <bpmn:task id="Task_AddDates" name="Add draft dates to all calendars" />
    <bpmn:task id="Task_CheckDates" name="Check the dates" />
    <bpmn:exclusiveGateway id="Gw_Modifications" name="Modifications suggested?" />
    <bpmn:task id="Task_Suggest" name="Suggest modifications" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Recheck" name="Recheck all dates" />
    <bpmn:task id="Task_Conflicts" name="Look for potential conflicts" />
    <bpmn:task id="Task_Send" name="Send final schedule of meeting dates by email" />
    <bpmn:task id="Task_Diaries" name="Check diaries" />
    <bpmn:task id="Task_Advise" name="Advise the Coordination Unit of any conflicts" />
    <bpmn:endEvent id="End_Advised" name="Conflicts advised" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_November" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Draft" targetRef="Task_AddDates" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AddDates" targetRef="Task_CheckDates" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckDates" targetRef="Gw_Modifications" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_Modifications" targetRef="Task_Suggest" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_Modifications" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Suggest" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_Merge" targetRef="Task_Recheck" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Recheck" targetRef="Task_Conflicts" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Conflicts" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Send" targetRef="Task_Diaries" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Diaries" targetRef="Task_Advise" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Advise" targetRef="End_Advised" />
  </bpmn:process>
</bpmn:definitions>
