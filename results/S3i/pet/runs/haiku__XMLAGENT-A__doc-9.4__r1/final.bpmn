<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Organisation" name="Organisation" processRef="Process_Committee" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Committee" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Committee">
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_DatesToBeFinalised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinaliseDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QACheckMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMeetingFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdviseCommitteeMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDepartmentalRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RecordsUpdated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CommitteeMembers" name="Committee Members">
        <bpmn:flowNodeRef>Task_ReadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_DatesToBeFinalised" name="Dates to be finalised" />
    <bpmn:task id="Task_FinaliseDates" name="Finalise the dates" />
    <bpmn:task id="Task_UpdateCalendars" name="Update all group calendars" />
    <bpmn:task id="Task_CreateMeetingFolders" name="Create meeting folders for each meeting" />
    <bpmn:task id="Task_UploadDocuments" name="Upload all appropriate documents to the system" />
    <bpmn:task id="Task_AdviseCommitteeMembers" name="Advise Committee Members a week before each meeting" />
    <bpmn:task id="Task_ReadDocuments" name="Read all related documents" />
    <bpmn:task id="Task_HoldMeeting" name="Hold the meeting" />
    <bpmn:task id="Task_ProduceMinutes" name="Produce minutes including action points for each Committee Member" />
    <bpmn:task id="Task_QACheckMinutes" name="Conduct QA check on the minutes" />
    <bpmn:task id="Task_SendMinutes" name="Send minutes to all Committee Members" />
    <bpmn:task id="Task_UpdateDepartmentalRecords" name="Update all departmental records" />
    <bpmn:endEvent id="End_RecordsUpdated" name="Departmental records updated" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_DatesToBeFinalised" targetRef="Task_FinaliseDates" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FinaliseDates" targetRef="Task_UpdateCalendars" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateMeetingFolders" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CreateMeetingFolders" targetRef="Task_UploadDocuments" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_UploadDocuments" targetRef="Task_AdviseCommitteeMembers" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AdviseCommitteeMembers" targetRef="Task_ReadDocuments" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ReadDocuments" targetRef="Task_HoldMeeting" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_HoldMeeting" targetRef="Task_ProduceMinutes" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheckMinutes" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_QACheckMinutes" targetRef="Task_SendMinutes" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendMinutes" targetRef="Task_UpdateDepartmentalRecords" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_UpdateDepartmentalRecords" targetRef="End_RecordsUpdated" />
  </bpmn:process>
</bpmn:definitions>
