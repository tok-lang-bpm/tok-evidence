<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="The Evanstonian hotel" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_GUEST" name="Guest">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MANAGER" name="Room-service manager">
        <bpmn:flowNodeRef>takeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fork1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcoholGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignWaiter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_KITCHEN" name="Kitchen">
        <bpmn:flowNodeRef>prepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SOMMELIER" name="Sommelier">
        <bpmn:flowNodeRef>fetchWine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_WAITER" name="Waiter">
        <bpmn:flowNodeRef>readyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nonalcDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Guest calls room service" />
    <bpmn:task id="takeOrder" name="Take down the order" />
    <bpmn:parallelGateway id="fork1" name="Split work" />
    <bpmn:task id="submitTicket" name="Submit the order ticket to the kitchen" />
    <bpmn:task id="prepareFood" name="Prepare the food" />
    <bpmn:exclusiveGateway id="alcoholGw" name="Order includes alcohol?" />
    <bpmn:task id="giveSommelier" name="Give the order to the sommelier" />
    <bpmn:task id="fetchWine" name="Fetch the wine and prepare other alcoholic beverages" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:task id="assignWaiter" name="Assign the order to the waiter" />
    <bpmn:task id="readyCart" name="Ready the cart" />
    <bpmn:task id="nonalcDrinks" name="Prepare the nonalcoholic drinks" />
    <bpmn:parallelGateway id="join2" name="Food, wine and cart ready" />
    <bpmn:task id="deliver" name="Deliver the food, wine and cart to the guest's room" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="end" name="Order handled" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="takeOrder" />
    <bpmn:sequenceFlow id="f2" sourceRef="takeOrder" targetRef="fork1" />
    <bpmn:sequenceFlow id="f3" sourceRef="fork1" targetRef="submitTicket" />
    <bpmn:sequenceFlow id="f4" sourceRef="submitTicket" targetRef="prepareFood" />
    <bpmn:sequenceFlow id="f5" sourceRef="prepareFood" targetRef="join2" />
    <bpmn:sequenceFlow id="f6" sourceRef="fork1" targetRef="alcoholGw" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="alcoholGw" targetRef="giveSommelier" />
    <bpmn:sequenceFlow id="f8" sourceRef="giveSommelier" targetRef="fetchWine" />
    <bpmn:sequenceFlow id="f9" sourceRef="fetchWine" targetRef="merge1" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="alcoholGw" targetRef="merge1" />
    <bpmn:sequenceFlow id="f11" sourceRef="merge1" targetRef="join2" />
    <bpmn:sequenceFlow id="f12" sourceRef="fork1" targetRef="assignWaiter" />
    <bpmn:sequenceFlow id="f13" sourceRef="assignWaiter" targetRef="readyCart" />
    <bpmn:sequenceFlow id="f14" sourceRef="readyCart" targetRef="nonalcDrinks" />
    <bpmn:sequenceFlow id="f15" sourceRef="nonalcDrinks" targetRef="join2" />
    <bpmn:sequenceFlow id="f16" sourceRef="join2" targetRef="deliver" />
    <bpmn:sequenceFlow id="f17" sourceRef="deliver" targetRef="debit" />
    <bpmn:sequenceFlow id="f18" sourceRef="debit" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
