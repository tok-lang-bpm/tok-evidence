<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Company going public" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_COMPANY" name="Company">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SELECT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_UNDERWRITERS" name="Underwriters">
        <bpmn:flowNodeRef>ADVISE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PREPARE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REGISTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BLUESKY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIRM_PRICE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ROADSHOW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CLEARANCE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIX_PRICE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>COMMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REASON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OFFER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ABANDON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DONE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Company decides to go public" />
    <bpmn:task id="SELECT" name="Select the underwriters" />
    <bpmn:task id="ADVISE" name="Provide procedural and financial advice" />
    <bpmn:parallelGateway id="SPLIT" name="Split work" />
    <bpmn:task id="PREPARE" name="Prepare the registration statement" />
    <bpmn:task id="REGISTER" name="Register the issue with the SEC" />
    <bpmn:task id="BLUESKY" name="Check compliance with blue-sky laws" />
    <bpmn:task id="FIRM_PRICE" name="Firm up the issue price" />
    <bpmn:task id="ROADSHOW" name="Arrange a road show for potential investors" />
    <bpmn:parallelGateway id="JOIN" name="Work joined" />
    <bpmn:intermediateCatchEvent id="CLEARANCE" name="SEC clearance received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="FIX_PRICE" name="Fix the issue price" />
    <bpmn:task id="COMMIT" name="Enter a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="REASON" name="Reason not to offer found?" />
    <bpmn:task id="OFFER" name="Offer the stock to the public" />
    <bpmn:endEvent id="ABANDON" name="Offering abandoned" />
    <bpmn:endEvent id="DONE" name="Stock offered to the public" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="SELECT" />
    <bpmn:sequenceFlow id="F2" sourceRef="SELECT" targetRef="ADVISE" />
    <bpmn:sequenceFlow id="F3" sourceRef="ADVISE" targetRef="SPLIT" />
    <bpmn:sequenceFlow id="F4" sourceRef="SPLIT" targetRef="PREPARE" />
    <bpmn:sequenceFlow id="F5" sourceRef="SPLIT" targetRef="FIRM_PRICE" />
    <bpmn:sequenceFlow id="F6" sourceRef="PREPARE" targetRef="REGISTER" />
    <bpmn:sequenceFlow id="F7" sourceRef="REGISTER" targetRef="BLUESKY" />
    <bpmn:sequenceFlow id="F8" sourceRef="BLUESKY" targetRef="JOIN" />
    <bpmn:sequenceFlow id="F9" sourceRef="FIRM_PRICE" targetRef="ROADSHOW" />
    <bpmn:sequenceFlow id="F10" sourceRef="ROADSHOW" targetRef="JOIN" />
    <bpmn:sequenceFlow id="F11" sourceRef="JOIN" targetRef="CLEARANCE" />
    <bpmn:sequenceFlow id="F12" sourceRef="CLEARANCE" targetRef="FIX_PRICE" />
    <bpmn:sequenceFlow id="F13" sourceRef="FIX_PRICE" targetRef="COMMIT" />
    <bpmn:sequenceFlow id="F14" sourceRef="COMMIT" targetRef="REASON" />
    <bpmn:sequenceFlow id="F15" name="yes" sourceRef="REASON" targetRef="ABANDON" />
    <bpmn:sequenceFlow id="F16" name="no" sourceRef="REASON" targetRef="OFFER" />
    <bpmn:sequenceFlow id="F17" sourceRef="OFFER" targetRef="DONE" />
  </bpmn:process>
</bpmn:definitions>