<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_FD" name="Fault detector">
        <bpmn:flowNodeRef>START_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REPORT_FAILURE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPO" name="MPO">
        <bpmn:flowNodeRef>START_SUSPICION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MERGE_START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EXAMINE_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CONFIRMED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJECT_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_REJECTED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SPLIT_CONFIRMED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFORM_GO_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFORM_MSP_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FIX_FAULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN_REPAIR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SHARE_RESULTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SPLIT_RESOLUTION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFORM_GO_RESOLUTION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFORM_MSP_RESOLUTION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN_RESOLUTION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_RESOLVED</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START_FAILURE" name="Failure detected" />
    <bpmn:task id="REPORT_FAILURE" name="Report the failure to the MPO" />
    <bpmn:startEvent id="START_SUSPICION" name="MPO suspects own fault" />
    <bpmn:exclusiveGateway id="MERGE_START" />
    <bpmn:task id="EXAMINE_FAILURE" name="Examine the failure" />
    <bpmn:exclusiveGateway id="GW_CONFIRMED" name="Failure confirmed?" />
    <bpmn:task id="REJECT_FAILURE" name="Reject the failure of the fault detector" />
    <bpmn:endEvent id="END_REJECTED" name="Failure rejected" />
    <bpmn:parallelGateway id="SPLIT_CONFIRMED" />
    <bpmn:task id="INFORM_GO_FAILURE" name="Inform the GO about the failure" />
    <bpmn:task id="INFORM_MSP_FAILURE" name="Inform the MSP about the failure" />
    <bpmn:task id="FIX_FAULT" name="Fix the fault at the measuring device" />
    <bpmn:parallelGateway id="JOIN_REPAIR" />
    <bpmn:task id="SHARE_RESULTS" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="SPLIT_RESOLUTION" />
    <bpmn:task id="INFORM_GO_RESOLUTION" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="INFORM_MSP_RESOLUTION" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="JOIN_RESOLUTION" />
    <bpmn:endEvent id="END_RESOLVED" name="Interference resolved" />
    <bpmn:sequenceFlow id="F1" sourceRef="START_FAILURE" targetRef="REPORT_FAILURE" />
    <bpmn:sequenceFlow id="F2" sourceRef="REPORT_FAILURE" targetRef="MERGE_START" />
    <bpmn:sequenceFlow id="F3" sourceRef="START_SUSPICION" targetRef="MERGE_START" />
    <bpmn:sequenceFlow id="F4" sourceRef="MERGE_START" targetRef="EXAMINE_FAILURE" />
    <bpmn:sequenceFlow id="F5" sourceRef="EXAMINE_FAILURE" targetRef="GW_CONFIRMED" />
    <bpmn:sequenceFlow id="F6" name="rejected" sourceRef="GW_CONFIRMED" targetRef="REJECT_FAILURE" />
    <bpmn:sequenceFlow id="F7" name="confirmed" sourceRef="GW_CONFIRMED" targetRef="SPLIT_CONFIRMED" />
    <bpmn:sequenceFlow id="F8" sourceRef="REJECT_FAILURE" targetRef="END_REJECTED" />
    <bpmn:sequenceFlow id="F9" sourceRef="SPLIT_CONFIRMED" targetRef="INFORM_GO_FAILURE" />
    <bpmn:sequenceFlow id="F10" sourceRef="SPLIT_CONFIRMED" targetRef="INFORM_MSP_FAILURE" />
    <bpmn:sequenceFlow id="F11" sourceRef="SPLIT_CONFIRMED" targetRef="FIX_FAULT" />
    <bpmn:sequenceFlow id="F12" sourceRef="INFORM_GO_FAILURE" targetRef="JOIN_REPAIR" />
    <bpmn:sequenceFlow id="F13" sourceRef="INFORM_MSP_FAILURE" targetRef="JOIN_REPAIR" />
    <bpmn:sequenceFlow id="F14" sourceRef="FIX_FAULT" targetRef="JOIN_REPAIR" />
    <bpmn:sequenceFlow id="F15" sourceRef="JOIN_REPAIR" targetRef="SHARE_RESULTS" />
    <bpmn:sequenceFlow id="F16" sourceRef="SHARE_RESULTS" targetRef="SPLIT_RESOLUTION" />
    <bpmn:sequenceFlow id="F17" sourceRef="SPLIT_RESOLUTION" targetRef="INFORM_GO_RESOLUTION" />
    <bpmn:sequenceFlow id="F18" sourceRef="SPLIT_RESOLUTION" targetRef="INFORM_MSP_RESOLUTION" />
    <bpmn:sequenceFlow id="F19" sourceRef="INFORM_GO_RESOLUTION" targetRef="JOIN_RESOLUTION" />
    <bpmn:sequenceFlow id="F20" sourceRef="INFORM_MSP_RESOLUTION" targetRef="JOIN_RESOLUTION" />
    <bpmn:sequenceFlow id="F21" sourceRef="JOIN_RESOLUTION" targetRef="END_RESOLVED" />
  </bpmn:process>
</bpmn:definitions>