<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PROCESS_VALUES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_CHANGED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRANSMIT_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_SP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MSP" name="MSP">
        <bpmn:flowNodeRef>CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ACCEPTED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DENY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MEASURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FAILED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INFORM_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TRANSMIT_VALUES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_FAILURE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Measurements required" />
    <bpmn:task id="REQUEST" name="Request the measurements" />
    <bpmn:task id="CHECK" name="Check the received request" />
    <bpmn:exclusiveGateway id="GW_ACCEPTED" name="Request accepted?" />
    <bpmn:task id="DENY" name="Deny the request of the GO" />
    <bpmn:task id="MEASURE" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="GW_FAILED" name="Reading failed?" />
    <bpmn:exclusiveGateway id="GW_MERGE" />
    <bpmn:task id="INFORM_FAILURE" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="TRANSMIT_VALUES" name="Transmit the measured values to the GO" />
    <bpmn:task id="PROCESS_VALUES" name="Process the measured values" />
    <bpmn:task id="SEND_CHANGED" name="Send the changed values to the MSP" />
    <bpmn:task id="TRANSMIT_SP" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="END_FAILURE" name="Failure reported" />
    <bpmn:endEvent id="END_SP" name="Readings transmitted" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="REQUEST" />
    <bpmn:sequenceFlow id="F2" sourceRef="REQUEST" targetRef="CHECK" />
    <bpmn:sequenceFlow id="F3" sourceRef="CHECK" targetRef="GW_ACCEPTED" />
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="GW_ACCEPTED" targetRef="DENY" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="GW_ACCEPTED" targetRef="MEASURE" />
    <bpmn:sequenceFlow id="F6" sourceRef="DENY" targetRef="GW_MERGE" />
    <bpmn:sequenceFlow id="F7" sourceRef="MEASURE" targetRef="GW_FAILED" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="GW_FAILED" targetRef="GW_MERGE" />
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="GW_FAILED" targetRef="TRANSMIT_VALUES" />
    <bpmn:sequenceFlow id="F10" sourceRef="GW_MERGE" targetRef="INFORM_FAILURE" />
    <bpmn:sequenceFlow id="F11" sourceRef="INFORM_FAILURE" targetRef="END_FAILURE" />
    <bpmn:sequenceFlow id="F12" sourceRef="TRANSMIT_VALUES" targetRef="PROCESS_VALUES" />
    <bpmn:sequenceFlow id="F13" sourceRef="PROCESS_VALUES" targetRef="SEND_CHANGED" />
    <bpmn:sequenceFlow id="F14" sourceRef="SEND_CHANGED" targetRef="TRANSMIT_SP" />
    <bpmn:sequenceFlow id="F15" sourceRef="TRANSMIT_SP" targetRef="END_SP" />
  </bpmn:process>
</bpmn:definitions>