<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MPOO" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwBill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MSPO" name="MSPO">
        <bpmn:flowNodeRef>sendB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>examA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examD_GO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gwCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPON" name="MPON">
        <bpmn:flowNodeRef>examD_MPON</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Bill to be sent" />
    <bpmn:exclusiveGateway id="gwBill" name="Which bill?" />
    <bpmn:task id="sendA" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="sendB" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="sendC" name="Send the bill for additional readings" />
    <bpmn:task id="sendD" name="Send the bill for the equipment acquisition" />
    <bpmn:exclusiveGateway id="gwD" name="MPON or GO?" />
    <bpmn:task id="examA" name="Examine the bill" />
    <bpmn:task id="examB" name="Examine the bill" />
    <bpmn:task id="examC" name="Examine the bill" />
    <bpmn:task id="examD_GO" name="Examine the bill" />
    <bpmn:task id="examD_MPON" name="Examine the bill" />
    <bpmn:exclusiveGateway id="gwMerge" />
    <bpmn:exclusiveGateway id="gwCheck" name="Invoice correct?" />
    <bpmn:task id="confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject" name="Reject the invoice" />
    <bpmn:endEvent id="endOK" name="Invoice confirmed" />
    <bpmn:endEvent id="endNo" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gwBill" />
    <bpmn:sequenceFlow id="f2" name="temporary continuation of metering point operations" sourceRef="gwBill" targetRef="sendA" />
    <bpmn:sequenceFlow id="f3" name="temporary continuation of measurement" sourceRef="gwBill" targetRef="sendB" />
    <bpmn:sequenceFlow id="f4" name="additional readings" sourceRef="gwBill" targetRef="sendC" />
    <bpmn:sequenceFlow id="f5" name="equipment acquisition" sourceRef="gwBill" targetRef="sendD" />
    <bpmn:sequenceFlow id="f6" sourceRef="sendA" targetRef="examA" />
    <bpmn:sequenceFlow id="f7" sourceRef="sendB" targetRef="examB" />
    <bpmn:sequenceFlow id="f8" sourceRef="sendC" targetRef="examC" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendD" targetRef="gwD" />
    <bpmn:sequenceFlow id="f10" name="GO" sourceRef="gwD" targetRef="examD_GO" />
    <bpmn:sequenceFlow id="f11" name="MPON" sourceRef="gwD" targetRef="examD_MPON" />
    <bpmn:sequenceFlow id="f12" sourceRef="examA" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f13" sourceRef="examB" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f14" sourceRef="examC" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f15" sourceRef="examD_GO" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f16" sourceRef="examD_MPON" targetRef="gwMerge" />
    <bpmn:sequenceFlow id="f17" sourceRef="gwMerge" targetRef="gwCheck" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="gwCheck" targetRef="confirm" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="gwCheck" targetRef="reject" />
    <bpmn:sequenceFlow id="f20" sourceRef="confirm" targetRef="endOK" />
    <bpmn:sequenceFlow id="f21" sourceRef="reject" targetRef="endNo" />
  </bpmn:process>
</bpmn:definitions>