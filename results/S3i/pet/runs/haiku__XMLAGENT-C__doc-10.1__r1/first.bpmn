<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="DISMISSAL_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="DISMISSAL_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MPON" name="MPON">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_DISMISSAL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPOO" name="MPOO">
        <bpmn:flowNodeRef>REVIEW_DISMISSAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DECIDE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OPPOSE_DISMISSAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_DISMISSAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_OPPOSED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_CONFIRMED</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Dismissal of MPON" />
    <bpmn:task id="SEND_DISMISSAL" name="Send the dismissal to the MPOO" />
    <bpmn:task id="REVIEW_DISMISSAL" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="DECIDE" name="Decision on the dismissal" />
    <bpmn:task id="OPPOSE_DISMISSAL" name="Oppose the dismissal of MPON" />
    <bpmn:task id="CONFIRM_DISMISSAL" name="Confirm the dismissal of MPON" />
    <bpmn:endEvent id="END_OPPOSED" name="Dismissal opposed" />
    <bpmn:endEvent id="END_CONFIRMED" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="SEND_DISMISSAL" />
    <bpmn:sequenceFlow id="F2" sourceRef="SEND_DISMISSAL" targetRef="REVIEW_DISMISSAL" />
    <bpmn:sequenceFlow id="F3" sourceRef="REVIEW_DISMISSAL" targetRef="DECIDE" />
    <bpmn:sequenceFlow id="F4" name="opposes" sourceRef="DECIDE" targetRef="OPPOSE_DISMISSAL" />
    <bpmn:sequenceFlow id="F5" name="confirms" sourceRef="DECIDE" targetRef="CONFIRM_DISMISSAL" />
    <bpmn:sequenceFlow id="F6" sourceRef="OPPOSE_DISMISSAL" targetRef="END_OPPOSED" />
    <bpmn:sequenceFlow id="F7" sourceRef="CONFIRM_DISMISSAL" targetRef="END_CONFIRMED" />
  </bpmn:process>
</bpmn:definitions>