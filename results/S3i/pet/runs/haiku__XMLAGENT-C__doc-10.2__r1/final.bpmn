<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MPON" name="MPON">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_REJECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_FAIL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DEADLINE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ASSIGNED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ASSIGNFAIL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPOO" name="MPOO">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="START" name="Meter operation" />
    <bpmn:task id="T1" name="Report the meter operation to the GO" />
    <bpmn:task id="T2" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="X1" name="Application accepted?" />
    <bpmn:task id="T3" name="Reject the application of the MPON" />
    <bpmn:task id="T4" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="P1" />
    <bpmn:task id="T5" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="T6" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:task id="T7" name="Perform the equipment acquisition and/or equipment changes" />
    <bpmn:task id="T8" name="Perform the equipment acquisition and/or equipment changes" />
    <bpmn:parallelGateway id="J1" />
    <bpmn:exclusiveGateway id="X2" name="Entire process completed?" />
    <bpmn:task id="T9" name="Report the failure of the entire process to the GO" />
    <bpmn:task id="T10" name="Report the successful completion of the entire process to the GO" />
    <bpmn:exclusiveGateway id="X3" />
    <bpmn:receiveTask id="R1" name="Receive the report of the MPON" />
    <bpmn:boundaryEvent id="B1" name="Deadline" attachedToRef="R1" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="T17" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:exclusiveGateway id="X4" name="Entire process successful?" />
    <bpmn:task id="T11" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="T12" name="Assign the MPON" />
    <bpmn:exclusiveGateway id="X5" name="Assignment successful?" />
    <bpmn:task id="T13" name="Confirm the assignment to the MPON" />
    <bpmn:parallelGateway id="P2" />
    <bpmn:task id="T14" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="T15" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="T16" name="Inform the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="J2" />
    <bpmn:task id="T18" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="T19" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:endEvent id="E_REJECT" name="Application rejected" />
    <bpmn:endEvent id="E_FAIL" name="Assignment failed" />
    <bpmn:endEvent id="E_DEADLINE" name="Transaction failed by deadline" />
    <bpmn:endEvent id="E_ASSIGNED" name="MPON assigned" />
    <bpmn:endEvent id="E_ASSIGNFAIL" name="Assignment failed" />

    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="X1" />
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="X1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="X1" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="E_REJECT" />
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="P1" />
    <bpmn:sequenceFlow id="F8" sourceRef="P1" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" sourceRef="P1" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" sourceRef="P1" targetRef="T7" />
    <bpmn:sequenceFlow id="F11" sourceRef="P1" targetRef="T8" />
    <bpmn:sequenceFlow id="F12" sourceRef="T5" targetRef="J1" />
    <bpmn:sequenceFlow id="F13" sourceRef="T6" targetRef="J1" />
    <bpmn:sequenceFlow id="F14" sourceRef="T7" targetRef="J1" />
    <bpmn:sequenceFlow id="F15" sourceRef="T8" targetRef="J1" />
    <bpmn:sequenceFlow id="F16" sourceRef="J1" targetRef="X2" />
    <bpmn:sequenceFlow id="F17" name="failure" sourceRef="X2" targetRef="T9" />
    <bpmn:sequenceFlow id="F18" name="success" sourceRef="X2" targetRef="T10" />
    <bpmn:sequenceFlow id="F19" sourceRef="T9" targetRef="X3" />
    <bpmn:sequenceFlow id="F20" sourceRef="T10" targetRef="X3" />
    <bpmn:sequenceFlow id="F21" sourceRef="X3" targetRef="R1" />
    <bpmn:sequenceFlow id="F22" sourceRef="R1" targetRef="X4" />
    <bpmn:sequenceFlow id="F23" name="no" sourceRef="X4" targetRef="T11" />
    <bpmn:sequenceFlow id="F24" name="yes" sourceRef="X4" targetRef="T12" />
    <bpmn:sequenceFlow id="F25" sourceRef="T11" targetRef="E_FAIL" />
    <bpmn:sequenceFlow id="F26" sourceRef="T12" targetRef="X5" />
    <bpmn:sequenceFlow id="F27" name="no" sourceRef="X5" targetRef="T18" />
    <bpmn:sequenceFlow id="F28" name="yes" sourceRef="X5" targetRef="T13" />
    <bpmn:sequenceFlow id="F29" sourceRef="T13" targetRef="P2" />
    <bpmn:sequenceFlow id="F30" sourceRef="P2" targetRef="T14" />
    <bpmn:sequenceFlow id="F31" sourceRef="P2" targetRef="T15" />
    <bpmn:sequenceFlow id="F32" sourceRef="P2" targetRef="T16" />
    <bpmn:sequenceFlow id="F33" sourceRef="T14" targetRef="J2" />
    <bpmn:sequenceFlow id="F34" sourceRef="T15" targetRef="J2" />
    <bpmn:sequenceFlow id="F35" sourceRef="T16" targetRef="J2" />
    <bpmn:sequenceFlow id="F36" sourceRef="J2" targetRef="E_ASSIGNED" />
    <bpmn:sequenceFlow id="F37" sourceRef="T18" targetRef="T19" />
    <bpmn:sequenceFlow id="F38" sourceRef="T19" targetRef="E_ASSIGNFAIL" />
    <bpmn:sequenceFlow id="F39" sourceRef="B1" targetRef="T17" />
    <bpmn:sequenceFlow id="F40" sourceRef="T17" targetRef="E_DEADLINE" />
  </bpmn:process>
</bpmn:definitions>
