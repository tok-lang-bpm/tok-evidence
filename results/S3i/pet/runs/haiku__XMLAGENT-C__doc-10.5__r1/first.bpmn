<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="MPON_LANE" name="MPON">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REQUEST_BID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PLACE_ORDER</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MPOO_LANE" name="MPOO">
        <bpmn:flowNodeRef>SEND_TENDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_ORDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_MASTER_DATA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Device takeover needed" />
    <bpmn:task id="REQUEST_BID" name="Request device takeover bid" />
    <bpmn:task id="SEND_TENDER" name="Send tender for equipment takeover" />
    <bpmn:task id="PLACE_ORDER" name="Place order" />
    <bpmn:task id="CONFIRM_ORDER" name="Confirm order" />
    <bpmn:task id="SEND_MASTER_DATA" name="Send master data" />
    <bpmn:endEvent id="END" name="Master data sent" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="REQUEST_BID" />
    <bpmn:sequenceFlow id="F2" sourceRef="REQUEST_BID" targetRef="SEND_TENDER" />
    <bpmn:sequenceFlow id="F3" sourceRef="SEND_TENDER" targetRef="PLACE_ORDER" />
    <bpmn:sequenceFlow id="F4" sourceRef="PLACE_ORDER" targetRef="CONFIRM_ORDER" />
    <bpmn:sequenceFlow id="F5" sourceRef="CONFIRM_ORDER" targetRef="SEND_MASTER_DATA" />
    <bpmn:sequenceFlow id="F6" sourceRef="SEND_MASTER_DATA" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>