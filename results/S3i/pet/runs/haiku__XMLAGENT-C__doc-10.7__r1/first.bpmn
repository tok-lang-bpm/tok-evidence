<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="GO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MSPN" name="MSPN">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GO" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Measurement to register" />
    <bpmn:task id="register" name="Register the measurement at the GO" />
    <bpmn:task id="examine" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="decide" name="Application accepted?" />
    <bpmn:task id="reject" name="Reject the application of the MSPN" />
    <bpmn:task id="confirm" name="Confirm the application of the MSPN" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:task id="informMSPO" name="Inform the MSPO about the assignment of the MSPN" />
    <bpmn:task id="informMPO" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="informSP" name="Inform the SP about the assignment of the MSPN" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="done" name="Assignment communicated" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="register" />
    <bpmn:sequenceFlow id="f2" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f3" sourceRef="examine" targetRef="decide" />
    <bpmn:sequenceFlow id="f4" name="rejected" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="confirmed" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="assign" />
    <bpmn:sequenceFlow id="f8" sourceRef="assign" targetRef="informMSPO" />
    <bpmn:sequenceFlow id="f9" sourceRef="informMSPO" targetRef="informMPO" />
    <bpmn:sequenceFlow id="f10" sourceRef="informMPO" targetRef="informSP" />
    <bpmn:sequenceFlow id="f11" sourceRef="informSP" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>