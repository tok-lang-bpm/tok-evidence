<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="MPO-PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="MPO-PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_SP" name="SP / PU / GO">
        <bpmn:flowNodeRef>START_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REQUEST_CHANGE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_MPO" name="MPO">
        <bpmn:flowNodeRef>START_MPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CAUSE_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MERGE_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REVIEW_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DECIDE_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJECT_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONFIRM_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PERFORM_CHANGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DECIDE_RESULT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REPORT_IMPLEMENTATION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NOTIFY_FAILURE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_REJECTED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_REPORTED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_FAILED</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="START_SP" name="Change of the measuring point needed" />
    <bpmn:task id="REQUEST_CHANGE" name="Request changes to the measuring point" />
    <bpmn:startEvent id="START_MPO" name="MPO causes a change" />
    <bpmn:task id="CAUSE_CHANGE" name="Cause a change of the measuring point" />
    <bpmn:exclusiveGateway id="MERGE_CHANGE" />
    <bpmn:task id="REVIEW_REQUEST" name="Review the change request" />
    <bpmn:exclusiveGateway id="DECIDE_REQUEST" name="Request confirmed?" />
    <bpmn:task id="REJECT_CHANGE" name="Reject the change of the measuring point" />
    <bpmn:task id="CONFIRM_REQUEST" name="Confirm the request of the SP / PU / GO" />
    <bpmn:task id="PERFORM_CHANGE" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="DECIDE_RESULT" name="Change implemented?" />
    <bpmn:task id="REPORT_IMPLEMENTATION" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="NOTIFY_FAILURE" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="END_REJECTED" name="Change rejected" />
    <bpmn:endEvent id="END_REPORTED" name="Change implemented" />
    <bpmn:endEvent id="END_FAILED" name="Change failed" />

    <bpmn:sequenceFlow id="F1" sourceRef="START_SP" targetRef="REQUEST_CHANGE" />
    <bpmn:sequenceFlow id="F2" sourceRef="REQUEST_CHANGE" targetRef="MERGE_CHANGE" />
    <bpmn:sequenceFlow id="F3" sourceRef="START_MPO" targetRef="CAUSE_CHANGE" />
    <bpmn:sequenceFlow id="F4" sourceRef="CAUSE_CHANGE" targetRef="MERGE_CHANGE" />
    <bpmn:sequenceFlow id="F5" sourceRef="MERGE_CHANGE" targetRef="REVIEW_REQUEST" />
    <bpmn:sequenceFlow id="F6" sourceRef="REVIEW_REQUEST" targetRef="DECIDE_REQUEST" />
    <bpmn:sequenceFlow id="F7" name="rejected" sourceRef="DECIDE_REQUEST" targetRef="REJECT_CHANGE" />
    <bpmn:sequenceFlow id="F8" name="confirmed" sourceRef="DECIDE_REQUEST" targetRef="CONFIRM_REQUEST" />
    <bpmn:sequenceFlow id="F9" sourceRef="REJECT_CHANGE" targetRef="END_REJECTED" />
    <bpmn:sequenceFlow id="F10" sourceRef="CONFIRM_REQUEST" targetRef="PERFORM_CHANGE" />
    <bpmn:sequenceFlow id="F11" sourceRef="PERFORM_CHANGE" targetRef="DECIDE_RESULT" />
    <bpmn:sequenceFlow id="F12" name="implemented" sourceRef="DECIDE_RESULT" targetRef="REPORT_IMPLEMENTATION" />
    <bpmn:sequenceFlow id="F13" name="failed" sourceRef="DECIDE_RESULT" targetRef="NOTIFY_FAILURE" />
    <bpmn:sequenceFlow id="F14" sourceRef="REPORT_IMPLEMENTATION" targetRef="END_REPORTED" />
    <bpmn:sequenceFlow id="F15" sourceRef="NOTIFY_FAILURE" targetRef="END_FAILED" />
  </bpmn:process>
</bpmn:definitions>