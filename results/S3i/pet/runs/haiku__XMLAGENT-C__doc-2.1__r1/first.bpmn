<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="TELECO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_CUST" name="Customer">
        <bpmn:flowNodeRef>s_perceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CS" name="Customer Service">
        <bpmn:flowNodeRef>t_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_determine_cm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ca_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_extra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reprio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_sig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive_perf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_customer_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ES" name="Electronic service">
        <bpmn:flowNodeRef>t_significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SM" name="Service Management">
        <bpmn:flowNodeRef>t_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analyze_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trouble_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_sm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_final_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_actual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corrective</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prr_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_prr_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive_ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prr_restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_prr_restore</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_RP" name="Resource Provisioning">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_analyze_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trouble_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_include</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_rp_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rp_term</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corrective_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ts_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send_ts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_BC" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>t_adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="s_perceive" name="Service degradation perceived" />
    <bpmn:task id="t_send_params" name="Send list of problem parameters" />
    <bpmn:task id="t_receive_report" name="Receive report on service performance and problem resolution" />
    <bpmn:endEvent id="e_customer" name="Customer process ended" />

    <bpmn:task id="t_enter" name="Enter problem report into system T" />
    <bpmn:task id="t_compare" name="Compare problem report with customer SLA" />
    <bpmn:task id="t_determine_cm" name="Determine counter measures and priorities" />
    <bpmn:exclusiveGateway id="g_premium" name="Customer premium?" />
    <bpmn:callActivity id="ca_extra" name="Link to extra problem fix process" calledElement="ExtraProblemFixProcess" />
    <bpmn:endEvent id="e_extra" name="Linked to extra problem fix process" />
    <bpmn:exclusiveGateway id="g_sig" name="Customer of significance affecting counter measures?" />
    <bpmn:task id="t_reprio" name="Re-prioritize counter measures" />
    <bpmn:exclusiveGateway id="m_sig" />
    <bpmn:task id="t_detailed" name="Create detailed problem report" />
    <bpmn:task id="t_send_detailed" name="Send detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="m_cs" />
    <bpmn:task id="t_receive_perf" name="Receive actual service performance or problem resolution report" />
    <bpmn:parallelGateway id="p_split" />
    <bpmn:task id="t_customer_report" name="Create report for the customer" />
    <bpmn:task id="t_send_customer" name="Send report to the customer" />
    <bpmn:task id="t_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:parallelGateway id="p_join" />
    <bpmn:endEvent id="e_cs" name="Customer Service process ended" />

    <bpmn:serviceTask id="t_significance" name="Determine customer significance" />

    <bpmn:task id="t_investigate" name="Investigate whether the problem is analyzable by Service Management" />
    <bpmn:exclusiveGateway id="g_analyzable" name="Analyzable by Service Management?" />
    <bpmn:task id="t_analyze_sm" name="Analyze the problem" />
    <bpmn:task id="t_trouble_sm" name="Create trouble report" />
    <bpmn:task id="t_send_rp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="t_receive_status" name="Receive status report" />
    <bpmn:exclusiveGateway id="m_sm" />
    <bpmn:task id="t_final_status" name="Prepare final status report" />
    <bpmn:exclusiveGateway id="g_counter" name="Counter measures required?" />
    <bpmn:task id="t_send_actual" name="Send actual service performance to Customer Service" />
    <bpmn:task id="t_corrective" name="Perform corrective actions" />
    <bpmn:task id="t_prr_minor" name="Create problem resolution report" />
    <bpmn:task id="t_send_prr_minor" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="t_request" name="Create request for automatic resource restoration" />
    <bpmn:task id="t_send_request" name="Send restoration request to Resource Provisioning" />
    <bpmn:task id="t_receive_ts" name="Receive trouble-shooting report" />
    <bpmn:task id="t_prr_restore" name="Create problem resolution report" />
    <bpmn:task id="t_send_prr_restore" name="Send problem resolution report to Customer Service" />

    <bpmn:task id="t_check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="g_problem" name="Problem detected?" />
    <bpmn:task id="t_normal" name="Create normal service execution notification" />
    <bpmn:task id="t_analyze_rp" name="Analyze the problem" />
    <bpmn:task id="t_trouble_rp" name="Create trouble report" />
    <bpmn:exclusiveGateway id="m_rp" />
    <bpmn:task id="t_include" name="Include report in status report" />
    <bpmn:task id="t_send_status" name="Send status report to Service Management" />
    <bpmn:parallelGateway id="p_rp_split" />
    <bpmn:eventBasedGateway id="ev_wait" name="Restoration request awaited" />
    <bpmn:intermediateCatchEvent id="c_request" name="Restoration request received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_timeout" name="2 days elapsed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_rp_term" name="Resource Provisioning process terminated" />
    <bpmn:task id="t_track" name="Track all possible errors" />
    <bpmn:task id="t_corrective_rp" name="Perform necessary corrective actions" />
    <bpmn:task id="t_ts_report" name="Create trouble-shooting report" />
    <bpmn:task id="t_send_ts" name="Send trouble-shooting report to Service Management" />

    <bpmn:task id="t_adjust" name="Adjust the billing" />

    <bpmn:sequenceFlow id="f1" sourceRef="s_perceive" targetRef="t_send_params" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_send_params" targetRef="t_enter" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_enter" targetRef="t_compare" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_compare" targetRef="t_determine_cm" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_determine_cm" targetRef="t_significance" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_significance" targetRef="g_premium" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="g_premium" targetRef="ca_extra" />
    <bpmn:sequenceFlow id="f8" sourceRef="ca_extra" targetRef="e_extra" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="g_premium" targetRef="g_sig" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="g_sig" targetRef="t_reprio" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="g_sig" targetRef="m_sig" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_reprio" targetRef="m_sig" />
    <bpmn:sequenceFlow id="f13" sourceRef="m_sig" targetRef="t_detailed" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_detailed" targetRef="t_send_detailed" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_send_detailed" targetRef="t_investigate" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_investigate" targetRef="g_analyzable" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="g_analyzable" targetRef="t_analyze_sm" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="g_analyzable" targetRef="t_send_rp" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_analyze_sm" targetRef="t_trouble_sm" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_trouble_sm" targetRef="m_sm" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_send_rp" targetRef="t_check" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_check" targetRef="g_problem" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="g_problem" targetRef="t_normal" />
    <bpmn:sequenceFlow id="f24" name="yes" sourceRef="g_problem" targetRef="t_analyze_rp" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_analyze_rp" targetRef="t_trouble_rp" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_trouble_rp" targetRef="m_rp" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_normal" targetRef="m_rp" />
    <bpmn:sequenceFlow id="f28" sourceRef="m_rp" targetRef="t_include" />
    <bpmn:sequenceFlow id="f29" sourceRef="t_include" targetRef="t_send_status" />
    <bpmn:sequenceFlow id="f30" sourceRef="t_send_status" targetRef="p_rp_split" />
    <bpmn:sequenceFlow id="f31" sourceRef="p_rp_split" targetRef="t_receive_status" />
    <bpmn:sequenceFlow id="f32" sourceRef="p_rp_split" targetRef="ev_wait" />
    <bpmn:sequenceFlow id="f33" sourceRef="ev_wait" targetRef="c_request" />
    <bpmn:sequenceFlow id="f34" sourceRef="ev_wait" targetRef="c_timeout" />
    <bpmn:sequenceFlow id="f35" sourceRef="c_timeout" targetRef="e_rp_term" />
    <bpmn:sequenceFlow id="f36" sourceRef="c_request" targetRef="t_track" />
    <bpmn:sequenceFlow id="f37" sourceRef="t_track" targetRef="t_corrective_rp" />
    <bpmn:sequenceFlow id="f38" sourceRef="t_corrective_rp" targetRef="t_ts_report" />
    <bpmn:sequenceFlow id="f39" sourceRef="t_ts_report" targetRef="t_send_ts" />
    <bpmn:sequenceFlow id="f40" sourceRef="t_send_ts" targetRef="t_receive_ts" />
    <bpmn:sequenceFlow id="f41" sourceRef="t_receive_status" targetRef="m_sm" />
    <bpmn:sequenceFlow id="f42" sourceRef="m_sm" targetRef="t_final_status" />
    <bpmn:sequenceFlow id="f43" sourceRef="t_final_status" targetRef="g_counter" />
    <bpmn:sequenceFlow id="f44" name="No problem detected" sourceRef="g_counter" targetRef="t_send_actual" />
    <bpmn:sequenceFlow id="f45" name="Minor corrective actions required" sourceRef="g_counter" targetRef="t_corrective" />
    <bpmn:sequenceFlow id="f46" name="Automatic resource restoration required" sourceRef="g_counter" targetRef="t_request" />
    <bpmn:sequenceFlow id="f47" sourceRef="t_corrective" targetRef="t_prr_minor" />
    <bpmn:sequenceFlow id="f48" sourceRef="t_prr_minor" targetRef="t_send_prr_minor" />
    <bpmn:sequenceFlow id="f49" sourceRef="t_send_prr_minor" targetRef="m_cs" />
    <bpmn:sequenceFlow id="f50" sourceRef="t_request" targetRef="t_send_request" />
    <bpmn:sequenceFlow id="f51" sourceRef="t_send_request" targetRef="c_request" />
    <bpmn:sequenceFlow id="f52" sourceRef="t_receive_ts" targetRef="t_prr_restore" />
    <bpmn:sequenceFlow id="f53" sourceRef="t_prr_restore" targetRef="t_send_prr_restore" />
    <bpmn:sequenceFlow id="f54" sourceRef="t_send_prr_restore" targetRef="m_cs" />
    <bpmn:sequenceFlow id="f55" sourceRef="t_send_actual" targetRef="m_cs" />
    <bpmn:sequenceFlow id="f56" sourceRef="m_cs" targetRef="t_receive_perf" />
    <bpmn:sequenceFlow id="f57" sourceRef="t_receive_perf" targetRef="p_split" />
    <bpmn:sequenceFlow id="f58" sourceRef="p_split" targetRef="t_customer_report" />
    <bpmn:sequenceFlow id="f59" sourceRef="p_split" targetRef="t_rebate" />
    <bpmn:sequenceFlow id="f60" sourceRef="t_customer_report" targetRef="t_send_customer" />
    <bpmn:sequenceFlow id="f61" sourceRef="t_send_customer" targetRef="t_receive_report" />
    <bpmn:sequenceFlow id="f62" sourceRef="t_send_customer" targetRef="p_join" />
    <bpmn:sequenceFlow id="f63" sourceRef="t_rebate" targetRef="t_adjust" />
    <bpmn:sequenceFlow id="f64" sourceRef="t_adjust" targetRef="p_join" />
    <bpmn:sequenceFlow id="f65" sourceRef="t_receive_report" targetRef="e_customer" />
    <bpmn:sequenceFlow id="f66" sourceRef="p_join" targetRef="e_cs" />
  </bpmn:process>
</bpmn:definitions>