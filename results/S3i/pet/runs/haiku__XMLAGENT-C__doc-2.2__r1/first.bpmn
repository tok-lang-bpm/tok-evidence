<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="New power supplier" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_CUST" name="Customer">
        <bpmn:flowNodeRef>start_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_customer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CS" name="Customer service">
        <bpmn:flowNodeRef>receive_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter_crm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyze_errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_won</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CIS" name="CIS">
        <bpmn:flowNodeRef>check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_GRID" name="Grid operator">
        <bpmn:flowNodeRef>check_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform_suppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate_agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split_meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute_billing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_billing_old</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_grid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_OLD" name="Old supplier">
        <bpmn:flowNodeRef>create_final_billing</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start_request" name="Switch-over requested" />
    <bpmn:task id="transmit_data" name="Transmit customer data to customer service" />
    <bpmn:task id="receive_data" name="Receive customer data" />
    <bpmn:task id="enter_crm" name="Enter customer data object into CRM system" />
    <bpmn:task id="compare_data" name="Compare customer data with internal customer database" />
    <bpmn:task id="check_data" name="Check completeness and plausibility of customer data" />
    <bpmn:exclusiveGateway id="g_errors" name="Errors found?" />
    <bpmn:task id="correct_errors" name="Correct errors using error list" />
    <bpmn:exclusiveGateway id="g_exists" name="Customer exists in customer database?" />
    <bpmn:task id="create_customer" name="Create customer object" />
    <bpmn:exclusiveGateway id="merge_customer" />
    <bpmn:task id="prepare_docs" name="Prepare contract documents" />
    <bpmn:task id="check_docs" name="Check contract documents automatically in CIS" />
    <bpmn:exclusiveGateway id="g_docs" name="Contract documents generated successfully?" />
    <bpmn:task id="analyze_errors" name="Analyze and resolve causes of errors" />
    <bpmn:task id="send_confirmation" name="Send confirmation document to customer" />
    <bpmn:task id="send_request" name="Send switch-over request to grid operator" />
    <bpmn:task id="check_concurrence" name="Check switch-over request for supplier concurrence" />
    <bpmn:exclusiveGateway id="g_concurrence" name="Supplier concurrence?" />
    <bpmn:task id="inform_suppliers" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:endEvent id="end_blocked" name="Switch-over not possible" />
    <bpmn:task id="terminate_agreement" name="Terminate sales agreement with old supplier" />
    <bpmn:task id="create_contract" name="Create CIS contract" />
    <bpmn:task id="check_contract" name="Check contract details" />
    <bpmn:eventBasedGateway id="g_event" name="Customer decides within 7 days?" />
    <bpmn:intermediateCatchEvent id="catch_withdraw" name="Withdrawal received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_confirm" name="Confirmation received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer_7" name="7 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="merge_accept" name="Contract accepted" />
    <bpmn:endEvent id="end_withdrawn" name="Switch contract withdrawn" />
    <bpmn:task id="transmit_meter" name="Transmit meter data in services consumption report" />
    <bpmn:parallelGateway id="split_meter" />
    <bpmn:task id="import_meter" name="Import meter data into systems" />
    <bpmn:endEvent id="end_won" name="New customer won" />
    <bpmn:task id="compute_billing" name="Compute final billing based on meter data" />
    <bpmn:task id="send_billing_old" name="Send final billing to old supplier" />
    <bpmn:endEvent id="end_grid" name="Grid operator process ended" />
    <bpmn:task id="create_final_billing" name="Create and send final billing to customer" />
    <bpmn:endEvent id="end_customer" name="Final billing received" />

    <bpmn:sequenceFlow id="f01" sourceRef="start_request" targetRef="transmit_data" />
    <bpmn:sequenceFlow id="f02" sourceRef="transmit_data" targetRef="receive_data" />
    <bpmn:sequenceFlow id="f03" sourceRef="receive_data" targetRef="enter_crm" />
    <bpmn:sequenceFlow id="f04" sourceRef="enter_crm" targetRef="compare_data" />
    <bpmn:sequenceFlow id="f05" sourceRef="compare_data" targetRef="check_data" />
    <bpmn:sequenceFlow id="f06" sourceRef="check_data" targetRef="g_errors" />
    <bpmn:sequenceFlow id="f07" name="yes" sourceRef="g_errors" targetRef="correct_errors" />
    <bpmn:sequenceFlow id="f08" sourceRef="correct_errors" targetRef="check_data" />
    <bpmn:sequenceFlow id="f09" name="no" sourceRef="g_errors" targetRef="g_exists" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="g_exists" targetRef="create_customer" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="g_exists" targetRef="merge_customer" />
    <bpmn:sequenceFlow id="f12" sourceRef="create_customer" targetRef="merge_customer" />
    <bpmn:sequenceFlow id="f13" sourceRef="merge_customer" targetRef="prepare_docs" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepare_docs" targetRef="check_docs" />
    <bpmn:sequenceFlow id="f15" sourceRef="check_docs" targetRef="g_docs" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="g_docs" targetRef="analyze_errors" />
    <bpmn:sequenceFlow id="f17" sourceRef="analyze_errors" targetRef="prepare_docs" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="g_docs" targetRef="send_confirmation" />
    <bpmn:sequenceFlow id="f19" sourceRef="send_confirmation" targetRef="send_request" />
    <bpmn:sequenceFlow id="f20" sourceRef="send_request" targetRef="check_concurrence" />
    <bpmn:sequenceFlow id="f21" sourceRef="check_concurrence" targetRef="g_concurrence" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="g_concurrence" targetRef="inform_suppliers" />
    <bpmn:sequenceFlow id="f23" sourceRef="inform_suppliers" targetRef="end_blocked" />
    <bpmn:sequenceFlow id="f24" name="no" sourceRef="g_concurrence" targetRef="terminate_agreement" />
    <bpmn:sequenceFlow id="f25" sourceRef="terminate_agreement" targetRef="create_contract" />
    <bpmn:sequenceFlow id="f26" sourceRef="create_contract" targetRef="check_contract" />
    <bpmn:sequenceFlow id="f27" sourceRef="check_contract" targetRef="g_event" />
    <bpmn:sequenceFlow id="f28" sourceRef="g_event" targetRef="catch_withdraw" />
    <bpmn:sequenceFlow id="f29" sourceRef="g_event" targetRef="catch_confirm" />
    <bpmn:sequenceFlow id="f30" sourceRef="g_event" targetRef="timer_7" />
    <bpmn:sequenceFlow id="f31" sourceRef="catch_withdraw" targetRef="end_withdrawn" />
    <bpmn:sequenceFlow id="f32" sourceRef="catch_confirm" targetRef="merge_accept" />
    <bpmn:sequenceFlow id="f33" sourceRef="timer_7" targetRef="merge_accept" />
    <bpmn:sequenceFlow id="f34" sourceRef="merge_accept" targetRef="transmit_meter" />
    <bpmn:sequenceFlow id="f35" sourceRef="transmit_meter" targetRef="split_meter" />
    <bpmn:sequenceFlow id="f36" sourceRef="split_meter" targetRef="import_meter" />
    <bpmn:sequenceFlow id="f37" sourceRef="import_meter" targetRef="end_won" />
    <bpmn:sequenceFlow id="f38" sourceRef="split_meter" targetRef="compute_billing" />
    <bpmn:sequenceFlow id="f39" sourceRef="compute_billing" targetRef="send_billing_old" />
    <bpmn:sequenceFlow id="f40" sourceRef="send_billing_old" targetRef="end_grid" />
    <bpmn:sequenceFlow id="f41" sourceRef="split_meter" targetRef="create_final_billing" />
    <bpmn:sequenceFlow id="f42" sourceRef="create_final_billing" targetRef="end_customer" />
  </bpmn:process>
</bpmn:definitions>