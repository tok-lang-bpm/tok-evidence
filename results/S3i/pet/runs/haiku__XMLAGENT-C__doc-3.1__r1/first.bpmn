<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Small Claims Registry Operations" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_PARTY" name="Party">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEND_REQUEST</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_BACKOFFICE" name="Client Service Back Office">
        <bpmn:flowNodeRef>RECEIVE_REQUEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RETRIEVE_SCT_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FORWARD_TO_POLICE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>STORE_PHYSICAL_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RECEIVE_REPORT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RETRIEVE_SCT_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ATTACH_DOCUMENT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>STORE_PHYSICAL_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HAND_OVER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_POLICE" name="Queensland Police">
        <bpmn:flowNodeRef>SEND_REPORT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Warrant release needed" />
    <bpmn:task id="SEND_REQUEST" name="Send the warrant possession request" />
    <bpmn:task id="RECEIVE_REQUEST" name="Receive the warrant possession request" />
    <bpmn:task id="RETRIEVE_SCT_1" name="Retrieve the SCT file" />
    <bpmn:task id="FORWARD_TO_POLICE" name="Forward the SCT warrant possession to Queensland Police" />
    <bpmn:task id="STORE_PHYSICAL_1" name="Store the SCT physical file awaiting report" />
    <bpmn:task id="SEND_REPORT" name="Send the report" />
    <bpmn:task id="RECEIVE_REPORT" name="Receive the report" />
    <bpmn:task id="RETRIEVE_SCT_2" name="Retrieve the respective SCT file" />
    <bpmn:task id="ATTACH_DOCUMENT" name="Attach the new SCT document" />
    <bpmn:task id="STORE_PHYSICAL_2" name="Store the expanded SCT physical file" />
    <bpmn:task id="HAND_OVER" name="Hand over the physical SCT file to other MC internal staff" />
    <bpmn:endEvent id="END" name="SCT file handed over" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="SEND_REQUEST" />
    <bpmn:sequenceFlow id="F2" sourceRef="SEND_REQUEST" targetRef="RECEIVE_REQUEST" />
    <bpmn:sequenceFlow id="F3" sourceRef="RECEIVE_REQUEST" targetRef="RETRIEVE_SCT_1" />
    <bpmn:sequenceFlow id="F4" sourceRef="RETRIEVE_SCT_1" targetRef="FORWARD_TO_POLICE" />
    <bpmn:sequenceFlow id="F5" sourceRef="FORWARD_TO_POLICE" targetRef="STORE_PHYSICAL_1" />
    <bpmn:sequenceFlow id="F6" sourceRef="STORE_PHYSICAL_1" targetRef="SEND_REPORT" />
    <bpmn:sequenceFlow id="F7" sourceRef="SEND_REPORT" targetRef="RECEIVE_REPORT" />
    <bpmn:sequenceFlow id="F8" sourceRef="RECEIVE_REPORT" targetRef="RETRIEVE_SCT_2" />
    <bpmn:sequenceFlow id="F9" sourceRef="RETRIEVE_SCT_2" targetRef="ATTACH_DOCUMENT" />
    <bpmn:sequenceFlow id="F10" sourceRef="ATTACH_DOCUMENT" targetRef="STORE_PHYSICAL_2" />
    <bpmn:sequenceFlow id="F11" sourceRef="STORE_PHYSICAL_2" targetRef="HAND_OVER" />
    <bpmn:sequenceFlow id="F12" sourceRef="HAND_OVER" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>