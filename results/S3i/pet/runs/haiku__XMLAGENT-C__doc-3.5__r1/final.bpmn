<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="mailUnit" name="Mail Processing Unit (Mail Clerk)">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collectMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sortUnopened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distributeMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="registry" name="Registry (Assistant Registry Manager)">
        <bpmn:flowNodeRef>openMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sortGroups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compileRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>captureMatter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>splitWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareEnvelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>postEnvelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joinWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cashier" name="Cashier">
        <bpmn:flowNodeRef>takeFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capturePartyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>printCourtFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Daily mail collection" />
    <bpmn:task id="collectMail" name="Collect the mail from the party" />
    <bpmn:task id="sortUnopened" name="Sort the unopened mail into business areas" />
    <bpmn:task id="distributeMail" name="Distribute the mail" />
    <bpmn:task id="openMail" name="Open the mail" />
    <bpmn:task id="sortGroups" name="Sort the mail into groups for distribution" />
    <bpmn:task id="registerMail" name="Register the mail in the manual incoming Mail Register" />
    <bpmn:task id="qualityCheck" name="Perform the quality check" />
    <bpmn:exclusiveGateway id="compliant" name="Mail compliant?" />
    <bpmn:task id="compileRequisition" name="Compile a list of requisition with the reason for rejection" />
    <bpmn:task id="sendRequisition" name="Send the list of requisition to the party" />
    <bpmn:endEvent id="rejected" name="Mail rejected" />
    <bpmn:task id="captureMatter" name="Capture the matter details (types of action)" />
    <bpmn:task id="takeFees" name="Take the applicable fees" />
    <bpmn:parallelGateway id="splitWork" />
    <bpmn:task id="prepareEnvelope" name="Put the receipt and copied documents into an envelope" />
    <bpmn:task id="postEnvelope" name="Post the envelope to the party" />
    <bpmn:task id="capturePartyDetails" name="Capture the Party Details" />
    <bpmn:task id="printCourtFile" name="Print the Physical Court File" />
    <bpmn:parallelGateway id="joinWork" />
    <bpmn:endEvent id="filed" name="Court file opened" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="collectMail" />
    <bpmn:sequenceFlow id="f2" sourceRef="collectMail" targetRef="sortUnopened" />
    <bpmn:sequenceFlow id="f3" sourceRef="sortUnopened" targetRef="distributeMail" />
    <bpmn:sequenceFlow id="f4" sourceRef="distributeMail" targetRef="openMail" />
    <bpmn:sequenceFlow id="f5" sourceRef="openMail" targetRef="sortGroups" />
    <bpmn:sequenceFlow id="f6" sourceRef="sortGroups" targetRef="registerMail" />
    <bpmn:sequenceFlow id="f7" sourceRef="registerMail" targetRef="qualityCheck" />
    <bpmn:sequenceFlow id="f8" sourceRef="qualityCheck" targetRef="compliant" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="compliant" targetRef="compileRequisition" />
    <bpmn:sequenceFlow id="f10" sourceRef="compileRequisition" targetRef="sendRequisition" />
    <bpmn:sequenceFlow id="f11" sourceRef="sendRequisition" targetRef="rejected" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="compliant" targetRef="captureMatter" />
    <bpmn:sequenceFlow id="f13" sourceRef="captureMatter" targetRef="takeFees" />
    <bpmn:sequenceFlow id="f14" sourceRef="takeFees" targetRef="splitWork" />
    <bpmn:sequenceFlow id="f15" sourceRef="splitWork" targetRef="prepareEnvelope" />
    <bpmn:sequenceFlow id="f16" sourceRef="splitWork" targetRef="capturePartyDetails" />
    <bpmn:sequenceFlow id="f17" sourceRef="prepareEnvelope" targetRef="postEnvelope" />
    <bpmn:sequenceFlow id="f18" sourceRef="postEnvelope" targetRef="joinWork" />
    <bpmn:sequenceFlow id="f19" sourceRef="capturePartyDetails" targetRef="printCourtFile" />
    <bpmn:sequenceFlow id="f20" sourceRef="printCourtFile" targetRef="joinWork" />
    <bpmn:sequenceFlow id="f21" sourceRef="joinWork" targetRef="filed" />
  </bpmn:process>
</bpmn:definitions>
