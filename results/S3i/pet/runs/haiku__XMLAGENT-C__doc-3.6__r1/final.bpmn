<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Insurance Organization" processRef="CLAIMS_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="CLAIMS_PROCESS" name="Claims Notification" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_ORG" name="Organization">
        <bpmn:flowNodeRef>claimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkInsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insuredGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluateSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complexGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendSimple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registeredEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informUpdate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CLAIMANT" name="Claimant">
        <bpmn:flowNodeRef>returnForms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateForms</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claimReceived" name="Claim received" />
    <bpmn:task id="checkInsured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="insuredGw" name="Claimant insured?" />
    <bpmn:task id="informReject" name="Inform claimant that claim must be rejected" />
    <bpmn:endEvent id="rejectEnd" name="Claim rejected" />
    <bpmn:task id="evaluateSeverity" name="Evaluate severity of claim" />
    <bpmn:exclusiveGateway id="complexGw" name="Simple or complex claim?" />
    <bpmn:task id="sendSimple" name="Send forms for simple claim" />
    <bpmn:task id="sendComplex" name="Send forms for complex claim" />
    <bpmn:exclusiveGateway id="sendMerge" />
    <bpmn:task id="returnForms" name="Return the forms" />
    <bpmn:task id="checkForms" name="Check the forms for completeness" />
    <bpmn:exclusiveGateway id="completeGw" name="Forms complete?" />
    <bpmn:task id="register" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="registeredEnd" name="Claims Notification process ended" />
    <bpmn:task id="informUpdate" name="Inform claimant to update the forms" />
    <bpmn:task id="updateForms" name="Update the forms" />
    <bpmn:sequenceFlow id="f1" sourceRef="claimReceived" targetRef="checkInsured" />
    <bpmn:sequenceFlow id="f2" sourceRef="checkInsured" targetRef="insuredGw" />
    <bpmn:sequenceFlow id="f3" name="No" sourceRef="insuredGw" targetRef="informReject" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="insuredGw" targetRef="evaluateSeverity" />
    <bpmn:sequenceFlow id="f5" sourceRef="informReject" targetRef="rejectEnd" />
    <bpmn:sequenceFlow id="f6" sourceRef="evaluateSeverity" targetRef="complexGw" />
    <bpmn:sequenceFlow id="f7" name="Simple" sourceRef="complexGw" targetRef="sendSimple" />
    <bpmn:sequenceFlow id="f8" name="Complex" sourceRef="complexGw" targetRef="sendComplex" />
    <bpmn:sequenceFlow id="f9" sourceRef="sendSimple" targetRef="sendMerge" />
    <bpmn:sequenceFlow id="f10" sourceRef="sendComplex" targetRef="sendMerge" />
    <bpmn:sequenceFlow id="f11" sourceRef="sendMerge" targetRef="returnForms" />
    <bpmn:sequenceFlow id="f12" sourceRef="returnForms" targetRef="checkForms" />
    <bpmn:sequenceFlow id="f13" sourceRef="checkForms" targetRef="completeGw" />
    <bpmn:sequenceFlow id="f14" name="Yes" sourceRef="completeGw" targetRef="register" />
    <bpmn:sequenceFlow id="f15" name="No" sourceRef="completeGw" targetRef="informUpdate" />
    <bpmn:sequenceFlow id="f16" sourceRef="register" targetRef="registeredEnd" />
    <bpmn:sequenceFlow id="f17" sourceRef="informUpdate" targetRef="updateForms" />
    <bpmn:sequenceFlow id="f18" sourceRef="updateForms" targetRef="checkForms" />
  </bpmn:process>
</bpmn:definitions>
