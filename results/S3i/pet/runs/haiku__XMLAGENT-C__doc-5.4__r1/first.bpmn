<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="ORG" name="Organisation" processRef="expense-process" />
  </bpmn:collaboration>
  <bpmn:process id="expense-process" isExecutable="false">
    <bpmn:laneSet id="expense-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiptsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returnReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="paymentSystem" name="Payment system">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Purchase needed" />
    <bpmn:task id="purchase" name="Purchase the product or service" />
    <bpmn:task id="submit" name="Submit the expense report with items and receipts" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:task id="check" name="Check the receipts against the items" />
    <bpmn:exclusiveGateway id="receiptsOk" name="Receipts complete and matching?" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:task id="returnReport" name="Send the report back to the employee" />
    <bpmn:task id="edit" name="Edit the expense report" />
    <bpmn:task id="resubmit" name="Resubmit the expense report" />
    <bpmn:serviceTask id="pay" name="Link the report to the payment system" />
    <bpmn:intermediateCatchEvent id="confirm" name="Payment confirmed">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" name="Expense report paid" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="purchase" />
    <bpmn:sequenceFlow id="f2" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f3" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f4" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="approved" targetRef="check" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="approved" targetRef="edit" />
    <bpmn:sequenceFlow id="f7" sourceRef="check" targetRef="receiptsOk" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="receiptsOk" targetRef="accept" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="receiptsOk" targetRef="returnReport" />
    <bpmn:sequenceFlow id="f10" sourceRef="returnReport" targetRef="edit" />
    <bpmn:sequenceFlow id="f11" sourceRef="edit" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f12" sourceRef="resubmit" targetRef="review" />
    <bpmn:sequenceFlow id="f13" sourceRef="accept" targetRef="pay" />
    <bpmn:sequenceFlow id="f14" sourceRef="pay" targetRef="confirm" />
    <bpmn:sequenceFlow id="f15" sourceRef="confirm" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>