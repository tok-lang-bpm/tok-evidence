<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="contactMessage" name="Customer contacts us" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="SALES_PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="SALES_PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_MARKETING" name="Marketing staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sourceGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquaintance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sourceMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_CALL" name="Call center staff">
        <bpmn:flowNodeRef>callCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determineContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askInterest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestedGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>budgetGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notPursued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_HEAD" name="Head of development">
        <bpmn:flowNodeRef>acquirePersonally</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interestEndGw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_SALES" name="Sales representative">
        <bpmn:flowNodeRef>techGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentSales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitEventGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>customerContacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>twoWeeksPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salesCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quoteMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createQuotation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quotationCreated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_PRESALES" name="Pre-sales employee">
        <bpmn:flowNodeRef>presentTech</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Potential customer identified" />
    <bpmn:exclusiveGateway id="sourceGw" name="Way of obtaining contact details?" />
    <bpmn:task id="buyDetails" name="Buy details for cold calls" />
    <bpmn:task id="exhibitions" name="Participate in exhibitions" />
    <bpmn:task id="acquaintance" name="Note interested contact known through an acquaintance" />
    <bpmn:exclusiveGateway id="sourceMerge" />
    <bpmn:task id="callCustomer" name="Call the customer" />
    <bpmn:task id="determineContact" name="Determine contact person and budget" />
    <bpmn:task id="askInterest" name="Ask whether customer is generally interested" />
    <bpmn:exclusiveGateway id="interestedGw" name="Customer generally interested?" />
    <bpmn:exclusiveGateway id="budgetGw" name="Potential project budget huge?" />
    <bpmn:task id="acquirePersonally" name="Acquire the customer personally" />
    <bpmn:exclusiveGateway id="interestEndGw" name="Customer interested in the end?" />
    <bpmn:exclusiveGateway id="interestMerge" />
    <bpmn:endEvent id="notPursued" name="Customer left alone" />
    <bpmn:exclusiveGateway id="techGw" name="Technical presentation?" />
    <bpmn:task id="presentSales" name="Give detailed online presentation" />
    <bpmn:task id="presentTech" name="Give detailed technical online presentation" />
    <bpmn:exclusiveGateway id="presentMerge" />
    <bpmn:eventBasedGateway id="waitEventGw" name="Wait for customer to come back" />
    <bpmn:intermediateCatchEvent id="customerContacts" name="Customer contacts us">
      <bpmn:messageEventDefinition messageRef="contactMessage" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="twoWeeksPassed" name="No contact within 2 weeks">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="salesCall" name="Call the customer back" />
    <bpmn:exclusiveGateway id="quoteMerge" />
    <bpmn:task id="createQuotation" name="Create a quotation" />
    <bpmn:endEvent id="quotationCreated" name="Quotation created" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sourceGw" />
    <bpmn:sequenceFlow id="f2" name="bought details" sourceRef="sourceGw" targetRef="buyDetails" />
    <bpmn:sequenceFlow id="f3" name="exhibition" sourceRef="sourceGw" targetRef="exhibitions" />
    <bpmn:sequenceFlow id="f4" name="acquaintance" sourceRef="sourceGw" targetRef="acquaintance" />
    <bpmn:sequenceFlow id="f5" sourceRef="buyDetails" targetRef="sourceMerge" />
    <bpmn:sequenceFlow id="f6" sourceRef="exhibitions" targetRef="sourceMerge" />
    <bpmn:sequenceFlow id="f7" sourceRef="acquaintance" targetRef="sourceMerge" />
    <bpmn:sequenceFlow id="f8" sourceRef="sourceMerge" targetRef="callCustomer" />
    <bpmn:sequenceFlow id="f9" sourceRef="callCustomer" targetRef="determineContact" />
    <bpmn:sequenceFlow id="f10" sourceRef="determineContact" targetRef="askInterest" />
    <bpmn:sequenceFlow id="f11" sourceRef="askInterest" targetRef="interestedGw" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="interestedGw" targetRef="interestMerge" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="interestedGw" targetRef="budgetGw" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="budgetGw" targetRef="acquirePersonally" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="budgetGw" targetRef="notPursued" />
    <bpmn:sequenceFlow id="f16" sourceRef="acquirePersonally" targetRef="interestEndGw" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="interestEndGw" targetRef="interestMerge" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="interestEndGw" targetRef="notPursued" />
    <bpmn:sequenceFlow id="f19" sourceRef="interestMerge" targetRef="techGw" />
    <bpmn:sequenceFlow id="f20" name="no" sourceRef="techGw" targetRef="presentSales" />
    <bpmn:sequenceFlow id="f21" name="yes" sourceRef="techGw" targetRef="presentTech" />
    <bpmn:sequenceFlow id="f22" sourceRef="presentSales" targetRef="presentMerge" />
    <bpmn:sequenceFlow id="f23" sourceRef="presentTech" targetRef="presentMerge" />
    <bpmn:sequenceFlow id="f24" sourceRef="presentMerge" targetRef="waitEventGw" />
    <bpmn:sequenceFlow id="f25" sourceRef="waitEventGw" targetRef="customerContacts" />
    <bpmn:sequenceFlow id="f26" sourceRef="waitEventGw" targetRef="twoWeeksPassed" />
    <bpmn:sequenceFlow id="f27" sourceRef="customerContacts" targetRef="quoteMerge" />
    <bpmn:sequenceFlow id="f28" sourceRef="twoWeeksPassed" targetRef="salesCall" />
    <bpmn:sequenceFlow id="f29" sourceRef="salesCall" targetRef="quoteMerge" />
    <bpmn:sequenceFlow id="f30" sourceRef="quoteMerge" targetRef="createQuotation" />
    <bpmn:sequenceFlow id="f31" sourceRef="createQuotation" targetRef="quotationCreated" />
  </bpmn:process>
</bpmn:definitions>