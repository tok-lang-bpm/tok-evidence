<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_DEPT" name="Functional department">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_ORG" name="Organisation">
        <bpmn:flowNodeRef>ADVERTISE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FILL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONTRACT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_APP" name="Applicant">
        <bpmn:flowNodeRef>APPLY</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Demand to fill a post received" />
    <bpmn:task id="ADVERTISE" name="Advertise the post" />
    <bpmn:task id="APPLY" name="Apply for the post" />
    <bpmn:task id="CHECK" name="Check the applications" />
    <bpmn:task id="FILL" name="Fill the post" />
    <bpmn:task id="CONTRACT" name="Conclude a contract of employment" />
    <bpmn:endEvent id="END" name="Post filled" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="ADVERTISE" />
    <bpmn:sequenceFlow id="F2" sourceRef="ADVERTISE" targetRef="APPLY" />
    <bpmn:sequenceFlow id="F3" sourceRef="APPLY" targetRef="CHECK" />
    <bpmn:sequenceFlow id="F4" sourceRef="CHECK" targetRef="FILL" />
    <bpmn:sequenceFlow id="F5" sourceRef="FILL" targetRef="CONTRACT" />
    <bpmn:sequenceFlow id="F6" sourceRef="CONTRACT" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>
