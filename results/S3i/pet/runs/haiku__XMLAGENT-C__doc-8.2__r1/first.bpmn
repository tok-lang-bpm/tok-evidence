<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_DEPT" name="Department">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CONSIDER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_APPROVED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>REJECT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LANE_HR" name="HR clerk">
        <bpmn:flowNodeRef>CREATE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CONFUSION</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ASK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUBMIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CORRECT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START" name="Vacancy reported" />
    <bpmn:task id="CREATE" name="Create the job description" />
    <bpmn:exclusiveGateway id="G_CONFUSION" name="Message still confused?" />
    <bpmn:task id="ASK" name="Ask the Department again" />
    <bpmn:exclusiveGateway id="G_MERGE" />
    <bpmn:task id="SUBMIT" name="Submit the job description for consideration" />
    <bpmn:task id="CONSIDER" name="Consider the job description" />
    <bpmn:exclusiveGateway id="G_APPROVED" name="Job description approved?" />
    <bpmn:task id="REJECT" name="Reject the job description and request a correction" />
    <bpmn:task id="CORRECT" name="Correct the job description" />
    <bpmn:task id="POST" name="Post the job" />
    <bpmn:endEvent id="END" name="Job posted" />
    <bpmn:sequenceFlow id="F1" sourceRef="START" targetRef="CREATE" />
    <bpmn:sequenceFlow id="F2" sourceRef="CREATE" targetRef="G_CONFUSION" />
    <bpmn:sequenceFlow id="F3" name="yes" sourceRef="G_CONFUSION" targetRef="ASK" />
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="G_CONFUSION" targetRef="G_MERGE" />
    <bpmn:sequenceFlow id="F5" sourceRef="ASK" targetRef="G_MERGE" />
    <bpmn:sequenceFlow id="F6" sourceRef="G_MERGE" targetRef="SUBMIT" />
    <bpmn:sequenceFlow id="F7" sourceRef="SUBMIT" targetRef="CONSIDER" />
    <bpmn:sequenceFlow id="F8" sourceRef="CONSIDER" targetRef="G_APPROVED" />
    <bpmn:sequenceFlow id="F9" name="yes" sourceRef="G_APPROVED" targetRef="POST" />
    <bpmn:sequenceFlow id="F10" name="no" sourceRef="G_APPROVED" targetRef="REJECT" />
    <bpmn:sequenceFlow id="F11" sourceRef="REJECT" targetRef="CORRECT" />
    <bpmn:sequenceFlow id="F12" sourceRef="CORRECT" targetRef="SUBMIT" />
    <bpmn:sequenceFlow id="F13" sourceRef="POST" targetRef="END" />
  </bpmn:process>
</bpmn:definitions>