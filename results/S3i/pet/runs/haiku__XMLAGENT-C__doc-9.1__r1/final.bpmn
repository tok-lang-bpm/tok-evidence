<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_SYS" name="Backup and reporting system">
        <bpmn:flowNodeRef>START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_BACKUP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CHECK_TABLE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_NEW_RECORDS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CHECK_CRM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_NEW_RETURNS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_REGISTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_REGISTER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ADVISED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PRODUCE_TABLE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SEND_TABLE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_REPORT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DEADLINE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ALERT_SUPERVISOR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_DEADLINE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CHECK_CRM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_NEW_RETURNS2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RECONCILE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DEADLINE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_MESSAGE_SUPERVISOR2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_NO_RETURNS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_ESCALATED</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="START" name="Weekday morning" />
    <bpmn:task id="T_BACKUP" name="Back up the database" />
    <bpmn:task id="T_CHECK_TABLE" name="Check the Account Defaulter table for new records" />
    <bpmn:exclusiveGateway id="G_NEW_RECORDS" name="New records found?" />
    <bpmn:task id="T_CHECK_CRM1" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="G_NEW_RETURNS1" name="New returns filed?" />
    <bpmn:exclusiveGateway id="M_REGISTER" />
    <bpmn:task id="T_REGISTER" name="Register all defaulting accounts and customers" />
    <bpmn:exclusiveGateway id="G_ADVISED" name="Client codes previously advised?" />
    <bpmn:task id="T_PRODUCE_TABLE" name="Produce a table of defaulting accounts" />
    <bpmn:task id="T_SEND_TABLE" name="Send the table to account management" />
    <bpmn:exclusiveGateway id="M_REPORT" />
    <bpmn:exclusiveGateway id="G_DEADLINE1" name="Report completed by 2:30 pm?" />
    <bpmn:task id="T_ALERT_SUPERVISOR1" name="Send an alert to the supervisor" />
    <bpmn:exclusiveGateway id="M_DEADLINE1" />
    <bpmn:task id="T_CHECK_CRM2" name="Check the CRM system for new returns" />
    <bpmn:exclusiveGateway id="G_NEW_RETURNS2" name="New returns filed?" />
    <bpmn:task id="T_RECONCILE" name="Reconcile with the existing account defaulters table" />
    <bpmn:exclusiveGateway id="G_DEADLINE2" name="Reconciliation completed by 4:00 pm?" />
    <bpmn:task id="T_MESSAGE_SUPERVISOR2" name="Send a message to the supervisor" />
    <bpmn:endEvent id="END_NO_RETURNS" name="No new returns" />
    <bpmn:endEvent id="END_DONE" name="Reconciliation completed" />
    <bpmn:endEvent id="END_ESCALATED" name="Supervisor informed" />

    <bpmn:sequenceFlow id="F01" sourceRef="START" targetRef="T_BACKUP" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_BACKUP" targetRef="T_CHECK_TABLE" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_CHECK_TABLE" targetRef="G_NEW_RECORDS" />
    <bpmn:sequenceFlow id="F04" name="no" sourceRef="G_NEW_RECORDS" targetRef="T_CHECK_CRM1" />
    <bpmn:sequenceFlow id="F05" name="yes" sourceRef="G_NEW_RECORDS" targetRef="M_REGISTER" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_CHECK_CRM1" targetRef="G_NEW_RETURNS1" />
    <bpmn:sequenceFlow id="F07" name="yes" sourceRef="G_NEW_RETURNS1" targetRef="M_REGISTER" />
    <bpmn:sequenceFlow id="F08" name="no" sourceRef="G_NEW_RETURNS1" targetRef="END_NO_RETURNS" />
    <bpmn:sequenceFlow id="F09" sourceRef="M_REGISTER" targetRef="T_REGISTER" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_REGISTER" targetRef="G_ADVISED" />
    <bpmn:sequenceFlow id="F11" name="no" sourceRef="G_ADVISED" targetRef="T_PRODUCE_TABLE" />
    <bpmn:sequenceFlow id="F12" name="yes" sourceRef="G_ADVISED" targetRef="M_REPORT" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_PRODUCE_TABLE" targetRef="T_SEND_TABLE" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_SEND_TABLE" targetRef="M_REPORT" />
    <bpmn:sequenceFlow id="F15" sourceRef="M_REPORT" targetRef="G_DEADLINE1" />
    <bpmn:sequenceFlow id="F16" name="yes" sourceRef="G_DEADLINE1" targetRef="M_DEADLINE1" />
    <bpmn:sequenceFlow id="F17" name="no" sourceRef="G_DEADLINE1" targetRef="T_ALERT_SUPERVISOR1" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_ALERT_SUPERVISOR1" targetRef="M_DEADLINE1" />
    <bpmn:sequenceFlow id="F19" sourceRef="M_DEADLINE1" targetRef="T_CHECK_CRM2" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_CHECK_CRM2" targetRef="G_NEW_RETURNS2" />
    <bpmn:sequenceFlow id="F21" name="yes" sourceRef="G_NEW_RETURNS2" targetRef="T_RECONCILE" />
    <bpmn:sequenceFlow id="F22" name="no" sourceRef="G_NEW_RETURNS2" targetRef="END_NO_RETURNS" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_RECONCILE" targetRef="G_DEADLINE2" />
    <bpmn:sequenceFlow id="F24" name="yes" sourceRef="G_DEADLINE2" targetRef="END_DONE" />
    <bpmn:sequenceFlow id="F25" name="no" sourceRef="G_DEADLINE2" targetRef="T_MESSAGE_SUPERVISOR2" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_MESSAGE_SUPERVISOR2" targetRef="END_ESCALATED" />
  </bpmn:process>
</bpmn:definitions>
