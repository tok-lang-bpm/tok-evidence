<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bicycle order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Bicycle company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Bicycle order" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store" name="Storehouse">
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="eng" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Order received" />
    <bpmn:exclusiveGateway id="decide" name="Order accepted?" />
    <bpmn:task id="reject" name="Reject the order" />
    <bpmn:task id="accept" name="Accept the order" />
    <bpmn:parallelGateway id="inform" />
    <bpmn:task id="ship" name="Ship the bicycle" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:endEvent id="shipped" name="Bicycle shipped" />
    <bpmn:subProcess id="parts" name="Process the part list">
      <bpmn:startEvent id="item" name="Part to process" />
      <bpmn:task id="check" name="Check the required quantity" />
      <bpmn:exclusiveGateway id="avail" name="Part available?" />
      <bpmn:task id="reserve" name="Reserve the part" />
      <bpmn:task id="backorder" name="Back-order the part" />
      <bpmn:exclusiveGateway id="merge" />
      <bpmn:endEvent id="done" name="Part processed" />
      <bpmn:sequenceFlow id="f-item-check" sourceRef="item" targetRef="check" />
      <bpmn:sequenceFlow id="f-check-avail" sourceRef="check" targetRef="avail" />
      <bpmn:sequenceFlow id="f-avail-reserve" name="yes" sourceRef="avail" targetRef="reserve" />
      <bpmn:sequenceFlow id="f-avail-backorder" name="no" sourceRef="avail" targetRef="backorder" />
      <bpmn:sequenceFlow id="f-reserve-merge" sourceRef="reserve" targetRef="merge" />
      <bpmn:sequenceFlow id="f-backorder-merge" sourceRef="backorder" targetRef="merge" />
      <bpmn:sequenceFlow id="f-merge-done" sourceRef="merge" targetRef="done" />
    </bpmn:subProcess>
    <bpmn:task id="prepare" name="Prepare the assembling" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:sequenceFlow id="f-received-decide" sourceRef="received" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-reject" name="no" sourceRef="decide" targetRef="reject" />
    <bpmn:sequenceFlow id="f-decide-accept" name="yes" sourceRef="decide" targetRef="accept" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-accept-inform" sourceRef="accept" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-parts" sourceRef="inform" targetRef="parts" />
    <bpmn:sequenceFlow id="f-inform-prepare" sourceRef="inform" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-parts-joined" sourceRef="parts" targetRef="joined" />
    <bpmn:sequenceFlow id="f-prepare-joined" sourceRef="prepare" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-assemble" sourceRef="joined" targetRef="assemble" />
    <bpmn:sequenceFlow id="f-assemble-ship" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f-ship-shipped" sourceRef="ship" targetRef="shipped" />
  </bpmn:process>
</bpmn:definitions>
