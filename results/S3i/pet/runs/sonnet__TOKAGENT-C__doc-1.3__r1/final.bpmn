<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Room service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hotel" name="The Evanstonian" processRef="hotel-process" />
  </bpmn:collaboration>
  <bpmn:process id="hotel-process" name="Room service" isExecutable="false">
    <bpmn:laneSet id="hotel-lanes">
      <bpmn:lane id="manager" name="Room-service manager">
        <bpmn:flowNodeRef>called</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>giveorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>altmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kitchen" name="Kitchen">
        <bpmn:flowNodeRef>food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sommelier" name="Sommelier">
        <bpmn:flowNodeRef>wine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="waiter" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="called" name="Guest calls room service" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="ticket" name="Submit the order ticket to the kitchen" />
    <bpmn:exclusiveGateway id="alc" name="Order includes alcohol?" />
    <bpmn:task id="giveorder" name="Give the order to the sommelier" />
    <bpmn:exclusiveGateway id="altmerge" />
    <bpmn:task id="assign" name="Assign the order to the waiter" />
    <bpmn:task id="food" name="Prepare the food" />
    <bpmn:task id="wine" name="Fetch wine from the cellar" />
    <bpmn:task id="bev" name="Prepare other alcoholic beverages" />
    <bpmn:task id="cart" name="Ready the cart" />
    <bpmn:task id="drinks" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="ret" name="Return to the room-service station" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="done" name="Order completed" />
    <bpmn:sequenceFlow id="f-called-take" sourceRef="called" targetRef="take" />
    <bpmn:sequenceFlow id="f-take-split" sourceRef="take" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-ticket" sourceRef="split" targetRef="ticket" />
    <bpmn:sequenceFlow id="f-split-alc" sourceRef="split" targetRef="alc" />
    <bpmn:sequenceFlow id="f-split-assign" sourceRef="split" targetRef="assign" />
    <bpmn:sequenceFlow id="f-ticket-food" sourceRef="ticket" targetRef="food" />
    <bpmn:sequenceFlow id="f-food-join" sourceRef="food" targetRef="join" />
    <bpmn:sequenceFlow id="f-alc-giveorder" name="yes" sourceRef="alc" targetRef="giveorder" />
    <bpmn:sequenceFlow id="f-alc-altmerge" name="no" sourceRef="alc" targetRef="altmerge" />
    <bpmn:sequenceFlow id="f-giveorder-wine" sourceRef="giveorder" targetRef="wine" />
    <bpmn:sequenceFlow id="f-wine-bev" sourceRef="wine" targetRef="bev" />
    <bpmn:sequenceFlow id="f-bev-altmerge" sourceRef="bev" targetRef="altmerge" />
    <bpmn:sequenceFlow id="f-altmerge-join" sourceRef="altmerge" targetRef="join" />
    <bpmn:sequenceFlow id="f-assign-cart" sourceRef="assign" targetRef="cart" />
    <bpmn:sequenceFlow id="f-cart-drinks" sourceRef="cart" targetRef="drinks" />
    <bpmn:sequenceFlow id="f-drinks-join" sourceRef="drinks" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-deliver" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-ret" sourceRef="deliver" targetRef="ret" />
    <bpmn:sequenceFlow id="f-ret-debit" sourceRef="ret" targetRef="debit" />
    <bpmn:sequenceFlow id="f-debit-done" sourceRef="debit" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
