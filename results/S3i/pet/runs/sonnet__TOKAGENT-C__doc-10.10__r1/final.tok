tok 1.0 "Fault handling"

pool org "Measuring organisation"
  lane detector "Fault detector"
    start begin "Failure detected or suspected"
    task report "Report the failure"
  lane mpo "MPO"
    task examine "Examine the failure"
    xor confirmed "Failure confirmed?"
    task reject "Reject the failure"
    and inform1
    task informgo "Inform the GO"
    task informmsp "Inform the MSP"
    and informed1
    task fix "Fix the fault at the measuring device"
    task share "Share the results of the repairs with the fault detector"
    and inform2
    task resgo "Inform the GO about the resolution"
    task resmsp "Inform the MSP about the resolution"
    and informed2
    end done "Fault resolved"
    end rejected "Failure rejected"

flow begin -> report -> examine -> confirmed
flow confirmed -> reject "no"
flow confirmed -> inform1 "yes"
flow reject -> rejected
flow inform1 -> informgo -> informed1
flow inform1 -> informmsp -> informed1
flow informed1 -> fix -> share -> inform2
flow inform2 -> resgo -> informed2
flow inform2 -> resmsp -> informed2
flow informed2 -> done
