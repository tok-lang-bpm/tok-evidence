<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Measurement process" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Measurement" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Measurements needed" />
    <bpmn:task id="req" name="Request the measurements" />
    <bpmn:task id="proc" name="Process the measured values" />
    <bpmn:task id="send" name="Send the changed values to the MSP" />
    <bpmn:task id="trans" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="done" name="Readings transmitted" />
    <bpmn:endEvent id="failed" name="Failure received" />
    <bpmn:endEvent id="denied" name="Request denied" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="ok" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny the request" />
    <bpmn:task id="meas" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="read" name="Reading successful?" />
    <bpmn:task id="inform" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="tv" name="Transmit the measured values to the GO" />
    <bpmn:sequenceFlow id="f-s-req" sourceRef="s" targetRef="req" />
    <bpmn:sequenceFlow id="f-req-check" sourceRef="req" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-ok" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-meas" name="yes" sourceRef="ok" targetRef="meas" />
    <bpmn:sequenceFlow id="f-ok-deny" name="no" sourceRef="ok" targetRef="deny" />
    <bpmn:sequenceFlow id="f-deny-denied" sourceRef="deny" targetRef="denied" />
    <bpmn:sequenceFlow id="f-meas-read" sourceRef="meas" targetRef="read" />
    <bpmn:sequenceFlow id="f-read-tv" name="yes" sourceRef="read" targetRef="tv" />
    <bpmn:sequenceFlow id="f-read-inform" name="no" sourceRef="read" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-failed" sourceRef="inform" targetRef="failed" />
    <bpmn:sequenceFlow id="f-tv-proc" sourceRef="tv" targetRef="proc" />
    <bpmn:sequenceFlow id="f-proc-send" sourceRef="proc" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-trans" sourceRef="send" targetRef="trans" />
    <bpmn:sequenceFlow id="f-trans-done" sourceRef="trans" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
