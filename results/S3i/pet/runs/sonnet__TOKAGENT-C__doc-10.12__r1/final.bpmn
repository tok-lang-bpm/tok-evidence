<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Master data change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Master data change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="ec" name="EC">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Change needed" />
    <bpmn:task id="tell" name="Tell the INQ about the change of master data" />
    <bpmn:task id="notify" name="Notify the IP of the change" />
    <bpmn:task id="check" name="Check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="d" name="Change possible?" />
    <bpmn:task id="confirm" name="Confirm the changes of the INQ" />
    <bpmn:task id="reject" name="Reject the changes of the INQ" />
    <bpmn:exclusiveGateway id="m" />
    <bpmn:endEvent id="e" name="Request handled" />
    <bpmn:sequenceFlow id="f-s-tell" sourceRef="s" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-notify" sourceRef="tell" targetRef="notify" />
    <bpmn:sequenceFlow id="f-notify-check" sourceRef="notify" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-d" sourceRef="check" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-confirm" name="yes" sourceRef="d" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-d-reject" name="no" sourceRef="d" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-m" sourceRef="confirm" targetRef="m" />
    <bpmn:sequenceFlow id="f-reject-m" sourceRef="reject" targetRef="m" />
    <bpmn:sequenceFlow id="f-m-e" sourceRef="m" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
