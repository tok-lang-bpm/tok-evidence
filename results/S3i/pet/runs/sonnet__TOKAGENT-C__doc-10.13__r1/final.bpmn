<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Transaction data request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Transaction data request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="inq" name="INQ">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ip" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Request needed" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request" />
    <bpmn:exclusiveGateway id="outcome" name="Request acceptable?" />
    <bpmn:task id="data" name="Transmit the data" />
    <bpmn:task id="reject" name="Reject the request" />
    <bpmn:endEvent id="done" name="Data transmitted" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f-s-transmit" sourceRef="s" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-check" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-outcome" sourceRef="check" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-data" name="yes" sourceRef="outcome" targetRef="data" />
    <bpmn:sequenceFlow id="f-outcome-reject" name="no" sourceRef="outcome" targetRef="reject" />
    <bpmn:sequenceFlow id="f-data-done" sourceRef="data" targetRef="done" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
