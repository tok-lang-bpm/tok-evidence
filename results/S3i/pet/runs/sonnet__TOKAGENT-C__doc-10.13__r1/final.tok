tok 1.0 "Transaction data request"

pool org "Organisation"
  lane inq "INQ"
    start s "Request needed"
    task transmit "Transmit the transaction data request"
  lane ip "IP"
    task check "Check the request"
    xor outcome "Request acceptable?"
    task data "Transmit the data"
    task reject "Reject the request"
    end done "Data transmitted"
    end rejected "Request rejected"

flow s -> transmit -> check -> outcome
flow outcome -> data "yes"
flow outcome -> reject "no"
flow data -> done
flow reject -> rejected
