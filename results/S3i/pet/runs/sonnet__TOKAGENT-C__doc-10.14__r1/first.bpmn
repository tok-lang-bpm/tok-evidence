<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Bill handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Market" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Bill handling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sender" name="MPOO or MSPO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO or MPON">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Bill to send" />
    <bpmn:task id="send" name="Send the bill" />
    <bpmn:task id="examine" name="Examine the bill" />
    <bpmn:exclusiveGateway id="ok" name="Invoice correct?" />
    <bpmn:task id="confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject" name="Reject the invoice" />
    <bpmn:endEvent id="confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="rejected" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f-begin-send" sourceRef="begin" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-examine" sourceRef="send" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-ok" sourceRef="examine" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-confirm" name="yes" sourceRef="ok" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-confirm-confirmed" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
