tok 1.0 "Bill handling"

pool org "Market"
  lane sender "MPOO or MSPO"
    start begin "Bill to send"
    task send "Send the bill"
  lane go "GO or MPON"
    task examine "Examine the bill"
    xor ok "Invoice correct?"
    task confirm "Confirm the invoice with payment advice"
    task reject "Reject the invoice"
    end confirmed "Invoice confirmed"
    end rejected "Invoice rejected"

flow begin -> send -> examine -> ok
flow ok -> confirm "yes"
flow ok -> reject "no"
flow confirm -> confirmed
flow reject -> rejected
