<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meter registration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Meter operation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Meter registration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>regd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ffork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sfork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ssp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timedout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assigned</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Meter operation to report" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="equip" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:exclusiveGateway id="outcome" name="Outcome?" />
    <bpmn:task id="fail" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="success" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="ok" name="Application acceptable?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="reg" name="Registration confirmed" />
    <bpmn:task id="regmpoo" name="Inform the MPOO about the registration confirmation" />
    <bpmn:task id="regmspo" name="Inform the MSPO about the registration confirmation" />
    <bpmn:parallelGateway id="regd" />
    <bpmn:task id="late" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:task id="cfail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:parallelGateway id="ffork" />
    <bpmn:task id="fmpoo" name="Inform the MPOO about the failure of the assignment" />
    <bpmn:task id="fmspo" name="Inform the MSPO about the failure of the assignment" />
    <bpmn:parallelGateway id="fjoin" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="cassign" name="Confirm the assignment to the MPON" />
    <bpmn:parallelGateway id="sfork" />
    <bpmn:task id="smpoo" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="smspo" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="ssp" name="Inform the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="sjoin" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:endEvent id="timedout" name="Transaction failed by deadline" />
    <bpmn:endEvent id="failed" name="Assignment failed" />
    <bpmn:endEvent id="assigned" name="MPON assigned" />
    <bpmn:sequenceFlow id="f-begin-report" sourceRef="begin" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-examine" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-ok" sourceRef="examine" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-ok-confirm" name="yes" sourceRef="ok" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-reg" sourceRef="confirm" targetRef="reg" />
    <bpmn:sequenceFlow id="f-reg-regmpoo" sourceRef="reg" targetRef="regmpoo" />
    <bpmn:sequenceFlow id="f-regmpoo-regd" sourceRef="regmpoo" targetRef="regd" />
    <bpmn:sequenceFlow id="f-reg-regmspo" sourceRef="reg" targetRef="regmspo" />
    <bpmn:sequenceFlow id="f-regmspo-regd" sourceRef="regmspo" targetRef="regd" />
    <bpmn:sequenceFlow id="f-regd-equip" sourceRef="regd" targetRef="equip" />
    <bpmn:sequenceFlow id="f-equip-outcome" sourceRef="equip" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-fail" name="failure" sourceRef="outcome" targetRef="fail" />
    <bpmn:sequenceFlow id="f-outcome-success" name="success" sourceRef="outcome" targetRef="success" />
    <bpmn:sequenceFlow id="f-outcome-late" name="no message by deadline" sourceRef="outcome" targetRef="late" />
    <bpmn:sequenceFlow id="f-late-timedout" sourceRef="late" targetRef="timedout" />
    <bpmn:sequenceFlow id="f-fail-cfail" sourceRef="fail" targetRef="cfail" />
    <bpmn:sequenceFlow id="f-cfail-ffork" sourceRef="cfail" targetRef="ffork" />
    <bpmn:sequenceFlow id="f-ffork-fmpoo" sourceRef="ffork" targetRef="fmpoo" />
    <bpmn:sequenceFlow id="f-fmpoo-fjoin" sourceRef="fmpoo" targetRef="fjoin" />
    <bpmn:sequenceFlow id="f-ffork-fmspo" sourceRef="ffork" targetRef="fmspo" />
    <bpmn:sequenceFlow id="f-fmspo-fjoin" sourceRef="fmspo" targetRef="fjoin" />
    <bpmn:sequenceFlow id="f-fjoin-failed" sourceRef="fjoin" targetRef="failed" />
    <bpmn:sequenceFlow id="f-success-assign" sourceRef="success" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-cassign" sourceRef="assign" targetRef="cassign" />
    <bpmn:sequenceFlow id="f-cassign-sfork" sourceRef="cassign" targetRef="sfork" />
    <bpmn:sequenceFlow id="f-sfork-smpoo" sourceRef="sfork" targetRef="smpoo" />
    <bpmn:sequenceFlow id="f-smpoo-sjoin" sourceRef="smpoo" targetRef="sjoin" />
    <bpmn:sequenceFlow id="f-sfork-smspo" sourceRef="sfork" targetRef="smspo" />
    <bpmn:sequenceFlow id="f-smspo-sjoin" sourceRef="smspo" targetRef="sjoin" />
    <bpmn:sequenceFlow id="f-sfork-ssp" sourceRef="sfork" targetRef="ssp" />
    <bpmn:sequenceFlow id="f-ssp-sjoin" sourceRef="ssp" targetRef="sjoin" />
    <bpmn:sequenceFlow id="f-sjoin-assigned" sourceRef="sjoin" targetRef="assigned" />
  </bpmn:process>
</bpmn:definitions>
