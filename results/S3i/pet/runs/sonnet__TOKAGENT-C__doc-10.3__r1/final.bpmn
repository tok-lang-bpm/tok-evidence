<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Deregistration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Metering" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Deregistration" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prelim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informmspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Deregistration needed" />
    <bpmn:task id="dereg" name="Deregister at the GO" />
    <bpmn:task id="confirm" name="Confirm the continuation" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="ok" name="Deregistration confirmed?" />
    <bpmn:task id="reject" name="Reject the deregistration" />
    <bpmn:task id="prelim" name="Preliminarily confirm the deregistration" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="oblige" name="Oblige MPOO to continue?" />
    <bpmn:task id="bind" name="Oblige the MPOO to continue the operations" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="equip" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="informmpoo" name="Inform the MPOO about the end and the beginning of the assignment" />
    <bpmn:task id="informmspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informsp" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="done" name="Assignment completed" />
    <bpmn:endEvent id="rejected" name="Deregistration rejected" />
    <bpmn:sequenceFlow id="f-begin-dereg" sourceRef="begin" targetRef="dereg" />
    <bpmn:sequenceFlow id="f-dereg-verify" sourceRef="dereg" targetRef="verify" />
    <bpmn:sequenceFlow id="f-verify-ok" sourceRef="verify" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-ok-prelim" name="yes" sourceRef="ok" targetRef="prelim" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-prelim-prepare" sourceRef="prelim" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-oblige" sourceRef="prepare" targetRef="oblige" />
    <bpmn:sequenceFlow id="f-oblige-bind" name="yes" sourceRef="oblige" targetRef="bind" />
    <bpmn:sequenceFlow id="f-oblige-merge" name="no" sourceRef="oblige" targetRef="merge" />
    <bpmn:sequenceFlow id="f-bind-confirm" sourceRef="bind" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-confirm-merge" sourceRef="confirm" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-equip" sourceRef="merge" targetRef="equip" />
    <bpmn:sequenceFlow id="f-equip-assign" sourceRef="equip" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-split" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-informmpoo" sourceRef="split" targetRef="informmpoo" />
    <bpmn:sequenceFlow id="f-informmpoo-join" sourceRef="informmpoo" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-informmspo" sourceRef="split" targetRef="informmspo" />
    <bpmn:sequenceFlow id="f-informmspo-join" sourceRef="informmspo" targetRef="join" />
    <bpmn:sequenceFlow id="f-split-informsp" sourceRef="split" targetRef="informsp" />
    <bpmn:sequenceFlow id="f-informsp-join" sourceRef="informsp" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-done" sourceRef="join" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
