tok 1.0 "Equipment change"

pool p "Metering"
  lane mpon "MPON"
    start s "Equipment change planned"
    task intent "Notify the MPOO about equipment change intentions"
    task final "Perform the final reading"
    task dismount "Dismount the old equipment"
    task mount "Mount the new device"
    task read "Read the meter count from the installed meter"
    task sendvals "Send the values of the final reading to the GO"
    task tell "Tell the GO about the device changes, the master data and the meter count at installation"
  lane mpoo "MPOO"
    xor d "Self dismounting?"
    task announce "Announce self dismounting to the MPON"
    task nonotify "Notify the MPON about no self-dismounting"
    xor j
  lane go "GO"
    task notifymsp "Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation"
    end e "MSP notified"

flow s -> intent -> d
flow d -> announce "yes"
flow d -> nonotify "no"
flow announce -> j
flow nonotify -> j
flow j -> final -> dismount -> mount -> read -> sendvals -> tell -> notifymsp -> e
