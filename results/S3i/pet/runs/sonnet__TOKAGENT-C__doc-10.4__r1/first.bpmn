<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Equipment change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="p" name="Metering" processRef="p-process" />
  </bpmn:collaboration>
  <bpmn:process id="p-process" name="Equipment change" isExecutable="false">
    <bpmn:laneSet id="p-lanes">
      <bpmn:lane id="mpon" name="MPON">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendvals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>announce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nonotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>notifymsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Equipment change planned" />
    <bpmn:task id="intent" name="Notify the MPOO about equipment change intentions" />
    <bpmn:task id="final" name="Perform the final reading" />
    <bpmn:task id="dismount" name="Dismount the old equipment" />
    <bpmn:task id="mount" name="Mount the new device" />
    <bpmn:task id="read" name="Read the meter count from the installed meter" />
    <bpmn:task id="sendvals" name="Send the values of the final reading to the GO" />
    <bpmn:task id="tell" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:exclusiveGateway id="d" name="Self dismounting?" />
    <bpmn:task id="announce" name="Announce self dismounting to the MPON" />
    <bpmn:task id="nonotify" name="Notify the MPON about no self-dismounting" />
    <bpmn:exclusiveGateway id="j" />
    <bpmn:task id="notifymsp" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="e" name="MSP notified" />
    <bpmn:sequenceFlow id="f-s-intent" sourceRef="s" targetRef="intent" />
    <bpmn:sequenceFlow id="f-intent-d" sourceRef="intent" targetRef="d" />
    <bpmn:sequenceFlow id="f-d-announce" name="yes" sourceRef="d" targetRef="announce" />
    <bpmn:sequenceFlow id="f-d-nonotify" name="no" sourceRef="d" targetRef="nonotify" />
    <bpmn:sequenceFlow id="f-announce-j" sourceRef="announce" targetRef="j" />
    <bpmn:sequenceFlow id="f-nonotify-j" sourceRef="nonotify" targetRef="j" />
    <bpmn:sequenceFlow id="f-j-final" sourceRef="j" targetRef="final" />
    <bpmn:sequenceFlow id="f-final-dismount" sourceRef="final" targetRef="dismount" />
    <bpmn:sequenceFlow id="f-dismount-mount" sourceRef="dismount" targetRef="mount" />
    <bpmn:sequenceFlow id="f-mount-read" sourceRef="mount" targetRef="read" />
    <bpmn:sequenceFlow id="f-read-sendvals" sourceRef="read" targetRef="sendvals" />
    <bpmn:sequenceFlow id="f-sendvals-tell" sourceRef="sendvals" targetRef="tell" />
    <bpmn:sequenceFlow id="f-tell-notifymsp" sourceRef="tell" targetRef="notifymsp" />
    <bpmn:sequenceFlow id="f-notifymsp-e" sourceRef="notifymsp" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
