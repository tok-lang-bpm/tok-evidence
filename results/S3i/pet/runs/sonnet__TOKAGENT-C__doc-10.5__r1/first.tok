tok 1.0 "Device takeover"

pool org "Energy market"
  lane mpon "MPON"
    start begin "Takeover needed"
    task request "Request a device takeover bid"
    task order "Place an order"
    end done "Order placed and confirmed"
  lane mpoo "MPOO"
    task tender "Send a tender for the equipment takeover"
    task confirm "Confirm the order"
    task master "Send the master data"

flow begin -> request -> tender -> order -> confirm -> master -> done
