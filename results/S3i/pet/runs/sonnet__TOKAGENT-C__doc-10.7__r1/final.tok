tok 1.0 "Measurement application"

pool org "Organisation"
  lane mspn "MSPN"
    start begin "Measurement to register"
    task register "Register the measurement"
  lane go "GO"
    task examine "Examine the application"
    xor decision "Application confirmed?"
    task reject "Reject the application"
    task confirm "Confirm the application"
    task assign "Assign the MSPN"
    and split
    task informo "Inform the MSPO about the assignment"
    task informm "Inform the MPO about the assignment"
    task informs "Inform the SP about the assignment"
    and join
    end done "MSPN assigned"
    end rejected "Application rejected"

flow begin -> register -> examine -> decision
flow decision -> confirm "yes"
flow decision -> reject "no"
flow reject -> rejected
flow confirm -> assign -> split
flow split -> informo
flow split -> informm
flow split -> informs
flow informo -> join
flow informm -> join
flow informs -> join
flow join -> done
