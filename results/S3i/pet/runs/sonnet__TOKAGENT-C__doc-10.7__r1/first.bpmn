<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measurement application" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measurement application" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="mspn" name="MSPN">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Measurement to register" />
    <bpmn:task id="register" name="Register the measurement" />
    <bpmn:task id="examine" name="Examine the application" />
    <bpmn:exclusiveGateway id="decision" name="Application confirmed?" />
    <bpmn:task id="reject" name="Reject the application" />
    <bpmn:task id="confirm" name="Confirm the application" />
    <bpmn:task id="assign" name="Assign the MSPN" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="informo" name="Inform the MSPO about the assignment" />
    <bpmn:task id="informm" name="Inform the MPO about the assignment" />
    <bpmn:task id="informs" name="Inform the SP about the assignment" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="done" name="MSPN assigned" />
    <bpmn:endEvent id="rejected" name="Application rejected" />
    <bpmn:sequenceFlow id="f-begin-register" sourceRef="begin" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-examine" sourceRef="register" targetRef="examine" />
    <bpmn:sequenceFlow id="f-examine-decision" sourceRef="examine" targetRef="decision" />
    <bpmn:sequenceFlow id="f-decision-confirm" name="yes" sourceRef="decision" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decision-reject" name="no" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-assign" sourceRef="confirm" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-split" sourceRef="assign" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-informo" sourceRef="split" targetRef="informo" />
    <bpmn:sequenceFlow id="f-split-informm" sourceRef="split" targetRef="informm" />
    <bpmn:sequenceFlow id="f-split-informs" sourceRef="split" targetRef="informs" />
    <bpmn:sequenceFlow id="f-informo-join" sourceRef="informo" targetRef="join" />
    <bpmn:sequenceFlow id="f-informm-join" sourceRef="informm" targetRef="join" />
    <bpmn:sequenceFlow id="f-informs-join" sourceRef="informs" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-done" sourceRef="join" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
