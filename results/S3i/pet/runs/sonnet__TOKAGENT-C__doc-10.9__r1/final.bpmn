<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Measuring point change" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Market" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Measuring point change" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="sp" name="SP / PU / GO">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mpo" name="MPO">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implemented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Change needed" />
    <bpmn:task id="request" name="Request the change" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="ok" name="Request accepted?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:task id="confirm" name="Confirm the request" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="done" name="Change successful?" />
    <bpmn:task id="report" name="Report the implementation" />
    <bpmn:task id="notify" name="Notify about the failure of the changes" />
    <bpmn:endEvent id="rejected" name="Change rejected" />
    <bpmn:endEvent id="implemented" name="Change implemented" />
    <bpmn:endEvent id="failed" name="Change failed" />
    <bpmn:sequenceFlow id="f-needed-request" sourceRef="needed" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-review" sourceRef="request" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-ok" sourceRef="review" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-confirm" name="yes" sourceRef="ok" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-confirm-perform" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f-perform-done" sourceRef="perform" targetRef="done" />
    <bpmn:sequenceFlow id="f-done-report" name="yes" sourceRef="done" targetRef="report" />
    <bpmn:sequenceFlow id="f-done-notify" name="no" sourceRef="done" targetRef="notify" />
    <bpmn:sequenceFlow id="f-report-implemented" sourceRef="report" targetRef="implemented" />
    <bpmn:sequenceFlow id="f-notify-failed" sourceRef="notify" targetRef="failed" />
  </bpmn:process>
</bpmn:definitions>
