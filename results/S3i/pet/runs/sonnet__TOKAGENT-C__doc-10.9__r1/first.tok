tok 1.0 "Measuring point change"

pool org "Market"
  lane sp "SP / PU / GO"
    start needed "Change needed"
    task request "Request the change"
  lane mpo "MPO"
    task review "Review the change request"
    xor ok "Request accepted?"
    task reject "Reject the change of the measuring point"
    task confirm "Confirm the request"
    task perform "Perform the measuring point change"
    xor done "Change successful?"
    task report "Report the implementation"
    task notify "Notify about the failure of the changes"
    end rejected "Change rejected"
    end implemented "Change implemented"
    end failed "Change failed"

flow needed -> request -> review -> ok
flow ok -> confirm "yes"
flow ok -> reject "no"
flow reject -> rejected
flow confirm -> perform -> done
flow done -> report "yes"
flow done -> notify "no"
flow report -> implemented
flow notify -> failed
