<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Service degradation handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Restoration_request" name="Restoration request" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="teleco" name="TELECO and customer" processRef="teleco-process" />
  </bpmn:collaboration>
  <bpmn:process id="teleco-process" name="Service degradation handling" isExecutable="false">
    <bpmn:laneSet id="teleco-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>perceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivereport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cs" name="Customer Service">
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extrafix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>premiumjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>affects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendsm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendcust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sentsplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="esvc" name="Electronic service">
        <bpmn:flowNodeRef>significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sm" name="Service Management">
        <bpmn:flowNodeRef>investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analyzable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendrp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smtrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finalstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendperf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recvts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>checkprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rptrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>statussplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>restreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpcorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tsreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpdone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="bc" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="perceived" name="Service degradation perceived" />
    <bpmn:task id="sendlist" name="Send the list of problem parameters" />
    <bpmn:task id="receivereport" name="Receive the report" />
    <bpmn:endEvent id="custdone" name="Customer process ended" />
    <bpmn:task id="enter" name="Enter the problem report into system T" />
    <bpmn:task id="compare" name="Compare the problem report to the customer SLA" />
    <bpmn:task id="measures" name="Determine the counter measures and priorities" />
    <bpmn:exclusiveGateway id="premium" name="Customer premium?" />
    <bpmn:callActivity id="extrafix" name="Run the extra problem fix process" calledElement="extrafix" />
    <bpmn:exclusiveGateway id="premiumjoin" />
    <bpmn:exclusiveGateway id="affects" name="Significance affects counter measures?" />
    <bpmn:task id="detailed" name="Create the detailed problem report" />
    <bpmn:task id="sendsm" name="Send the detailed problem report to Service Management" />
    <bpmn:exclusiveGateway id="csmerge" />
    <bpmn:parallelGateway id="csplit" />
    <bpmn:task id="custreport" name="Create the report for the customer" />
    <bpmn:task id="sendcust" name="Send the report to the customer" />
    <bpmn:parallelGateway id="sentsplit" />
    <bpmn:task id="rebate" name="Report the SLA violation rebate" />
    <bpmn:parallelGateway id="cjoin" />
    <bpmn:endEvent id="csdone" name="Customer Service ended" />
    <bpmn:task id="significance" name="Determine the significance of the customer" />
    <bpmn:task id="investigate" name="Investigate whether the problem is analyzable" />
    <bpmn:exclusiveGateway id="analyzable" name="Analyzable by Service Management?" />
    <bpmn:task id="sendrp" name="Send the detailed problem report to Resource Provisioning" />
    <bpmn:task id="analysis" name="Perform the analysis" />
    <bpmn:task id="smtrouble" name="Create the trouble report" />
    <bpmn:exclusiveGateway id="smmerge" />
    <bpmn:task id="waitstatus" name="Receive the status report" />
    <bpmn:task id="finalstatus" name="Prepare the final status report" />
    <bpmn:exclusiveGateway id="decide" name="Which counter measures?" />
    <bpmn:task id="sendperf" name="Send the actual service performance to Customer Service" />
    <bpmn:task id="minor" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="resmerge" />
    <bpmn:task id="resolution" name="Create the problem resolution report" />
    <bpmn:task id="sendres" name="Send the problem resolution report to Customer Service" />
    <bpmn:task id="request" name="Create the request for automatic resource restoration" />
    <bpmn:task id="sendreq" name="Send the restoration request to Resource Provisioning" />
    <bpmn:task id="recvts" name="Receive the trouble-shooting report" />
    <bpmn:task id="checkprob" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="problem" name="Problem detected?" />
    <bpmn:task id="notification" name="Create the normal execution notification" />
    <bpmn:task id="rpanalyze" name="Analyze the problem" />
    <bpmn:task id="rptrouble" name="Create the trouble report" />
    <bpmn:exclusiveGateway id="rpmerge" />
    <bpmn:task id="status" name="Create the status report" />
    <bpmn:task id="sendstatus" name="Send the status report to Service Management" />
    <bpmn:parallelGateway id="statussplit" />
    <bpmn:eventBasedGateway id="hold" />
    <bpmn:intermediateCatchEvent id="restreq" name="Restoration request received">
      <bpmn:messageEventDefinition id="restreq-def" messageRef="Message_Restoration_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="2 days passed">
      <bpmn:timerEventDefinition id="timeout-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="terminated" name="Process terminated">
      <bpmn:terminateEventDefinition id="terminated-def" />
    </bpmn:endEvent>
    <bpmn:task id="track" name="Track all possible errors" />
    <bpmn:task id="rpcorrect" name="Undertake the necessary corrective actions" />
    <bpmn:task id="tsreport" name="Create the trouble-shooting report" />
    <bpmn:task id="sendts" name="Send the trouble-shooting report to Service Management" />
    <bpmn:endEvent id="rpdone" name="Resource Provisioning ended" />
    <bpmn:task id="adjust" name="Adjust the billing" />
    <bpmn:sequenceFlow id="f-perceived-sendlist" sourceRef="perceived" targetRef="sendlist" />
    <bpmn:sequenceFlow id="f-sendlist-enter" sourceRef="sendlist" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-compare" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-measures" sourceRef="compare" targetRef="measures" />
    <bpmn:sequenceFlow id="f-measures-significance" sourceRef="measures" targetRef="significance" />
    <bpmn:sequenceFlow id="f-significance-premium" sourceRef="significance" targetRef="premium" />
    <bpmn:sequenceFlow id="f-premium-extrafix" name="yes" sourceRef="premium" targetRef="extrafix" />
    <bpmn:sequenceFlow id="f-premium-premiumjoin" name="no" sourceRef="premium" targetRef="premiumjoin" />
    <bpmn:sequenceFlow id="f-extrafix-premiumjoin" sourceRef="extrafix" targetRef="premiumjoin" />
    <bpmn:sequenceFlow id="f-premiumjoin-affects" sourceRef="premiumjoin" targetRef="affects" />
    <bpmn:sequenceFlow id="f-affects-measures" name="yes" sourceRef="affects" targetRef="measures" />
    <bpmn:sequenceFlow id="f-affects-detailed" name="no" sourceRef="affects" targetRef="detailed" />
    <bpmn:sequenceFlow id="f-detailed-sendsm" sourceRef="detailed" targetRef="sendsm" />
    <bpmn:sequenceFlow id="f-sendsm-investigate" sourceRef="sendsm" targetRef="investigate" />
    <bpmn:sequenceFlow id="f-investigate-analyzable" sourceRef="investigate" targetRef="analyzable" />
    <bpmn:sequenceFlow id="f-analyzable-sendrp" name="no" sourceRef="analyzable" targetRef="sendrp" />
    <bpmn:sequenceFlow id="f-analyzable-analysis" name="yes" sourceRef="analyzable" targetRef="analysis" />
    <bpmn:sequenceFlow id="f-analysis-smtrouble" sourceRef="analysis" targetRef="smtrouble" />
    <bpmn:sequenceFlow id="f-smtrouble-smmerge" sourceRef="smtrouble" targetRef="smmerge" />
    <bpmn:sequenceFlow id="f-sendrp-checkprob" sourceRef="sendrp" targetRef="checkprob" />
    <bpmn:sequenceFlow id="f-checkprob-problem" sourceRef="checkprob" targetRef="problem" />
    <bpmn:sequenceFlow id="f-problem-notification" name="no" sourceRef="problem" targetRef="notification" />
    <bpmn:sequenceFlow id="f-problem-rpanalyze" name="yes" sourceRef="problem" targetRef="rpanalyze" />
    <bpmn:sequenceFlow id="f-rpanalyze-rptrouble" sourceRef="rpanalyze" targetRef="rptrouble" />
    <bpmn:sequenceFlow id="f-rptrouble-rpmerge" sourceRef="rptrouble" targetRef="rpmerge" />
    <bpmn:sequenceFlow id="f-notification-rpmerge" sourceRef="notification" targetRef="rpmerge" />
    <bpmn:sequenceFlow id="f-rpmerge-status" sourceRef="rpmerge" targetRef="status" />
    <bpmn:sequenceFlow id="f-status-sendstatus" sourceRef="status" targetRef="sendstatus" />
    <bpmn:sequenceFlow id="f-sendstatus-statussplit" sourceRef="sendstatus" targetRef="statussplit" />
    <bpmn:sequenceFlow id="f-statussplit-hold" sourceRef="statussplit" targetRef="hold" />
    <bpmn:sequenceFlow id="f-statussplit-waitstatus" sourceRef="statussplit" targetRef="waitstatus" />
    <bpmn:sequenceFlow id="f-waitstatus-smmerge" sourceRef="waitstatus" targetRef="smmerge" />
    <bpmn:sequenceFlow id="f-smmerge-finalstatus" sourceRef="smmerge" targetRef="finalstatus" />
    <bpmn:sequenceFlow id="f-finalstatus-decide" sourceRef="finalstatus" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-sendperf" name="no problem" sourceRef="decide" targetRef="sendperf" />
    <bpmn:sequenceFlow id="f-decide-minor" name="minor actions" sourceRef="decide" targetRef="minor" />
    <bpmn:sequenceFlow id="f-decide-request" name="restoration required" sourceRef="decide" targetRef="request" />
    <bpmn:sequenceFlow id="f-sendperf-csmerge" sourceRef="sendperf" targetRef="csmerge" />
    <bpmn:sequenceFlow id="f-minor-resmerge" sourceRef="minor" targetRef="resmerge" />
    <bpmn:sequenceFlow id="f-request-sendreq" sourceRef="request" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-sendreq-recvts" sourceRef="sendreq" targetRef="recvts" />
    <bpmn:sequenceFlow id="f-recvts-resmerge" sourceRef="recvts" targetRef="resmerge" />
    <bpmn:sequenceFlow id="f-resmerge-resolution" sourceRef="resmerge" targetRef="resolution" />
    <bpmn:sequenceFlow id="f-resolution-sendres" sourceRef="resolution" targetRef="sendres" />
    <bpmn:sequenceFlow id="f-sendres-csmerge" sourceRef="sendres" targetRef="csmerge" />
    <bpmn:sequenceFlow id="f-hold-restreq" sourceRef="hold" targetRef="restreq" />
    <bpmn:sequenceFlow id="f-hold-timeout" sourceRef="hold" targetRef="timeout" />
    <bpmn:sequenceFlow id="f-restreq-track" sourceRef="restreq" targetRef="track" />
    <bpmn:sequenceFlow id="f-track-rpcorrect" sourceRef="track" targetRef="rpcorrect" />
    <bpmn:sequenceFlow id="f-rpcorrect-tsreport" sourceRef="rpcorrect" targetRef="tsreport" />
    <bpmn:sequenceFlow id="f-tsreport-sendts" sourceRef="tsreport" targetRef="sendts" />
    <bpmn:sequenceFlow id="f-sendts-rpdone" sourceRef="sendts" targetRef="rpdone" />
    <bpmn:sequenceFlow id="f-timeout-terminated" sourceRef="timeout" targetRef="terminated" />
    <bpmn:sequenceFlow id="f-csmerge-csplit" sourceRef="csmerge" targetRef="csplit" />
    <bpmn:sequenceFlow id="f-csplit-custreport" sourceRef="csplit" targetRef="custreport" />
    <bpmn:sequenceFlow id="f-custreport-sendcust" sourceRef="custreport" targetRef="sendcust" />
    <bpmn:sequenceFlow id="f-sendcust-sentsplit" sourceRef="sendcust" targetRef="sentsplit" />
    <bpmn:sequenceFlow id="f-sentsplit-cjoin" sourceRef="sentsplit" targetRef="cjoin" />
    <bpmn:sequenceFlow id="f-sentsplit-receivereport" sourceRef="sentsplit" targetRef="receivereport" />
    <bpmn:sequenceFlow id="f-receivereport-custdone" sourceRef="receivereport" targetRef="custdone" />
    <bpmn:sequenceFlow id="f-csplit-rebate" sourceRef="csplit" targetRef="rebate" />
    <bpmn:sequenceFlow id="f-rebate-adjust" sourceRef="rebate" targetRef="adjust" />
    <bpmn:sequenceFlow id="f-adjust-cjoin" sourceRef="adjust" targetRef="cjoin" />
    <bpmn:sequenceFlow id="f-cjoin-csdone" sourceRef="cjoin" targetRef="csdone" />
  </bpmn:process>
</bpmn:definitions>
