<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Power supplier switch-over" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Confirmation" name="Confirmation" />
  <bpmn:message id="Message_Withdrawal" name="Withdrawal" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Power supplier switch-over" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Power supplier switch-over" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkcontract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>billed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivebill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="service" name="Customer service">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>errors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ciscontract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>imported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="cis" name="CIS">
        <bpmn:flowNodeRef>checkdocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="grid" name="Grid operator">
        <bpmn:flowNodeRef>checkreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concurrence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>meter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendbill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="old" name="Old supplier">
        <bpmn:flowNodeRef>createbill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="requested" name="Switch-over requested" />
    <bpmn:task id="transmit" name="Transmit customer data" />
    <bpmn:task id="checkcontract" name="Check the contract details" />
    <bpmn:eventBasedGateway id="decide" name="Customer decision" />
    <bpmn:intermediateCatchEvent id="confirm" name="Contract confirmed">
      <bpmn:messageEventDefinition id="confirm-def" messageRef="Message_Confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="withdraw" name="Contract withdrawn">
      <bpmn:messageEventDefinition id="withdraw-def" messageRef="Message_Withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="wait" name="7 days passed">
      <bpmn:timerEventDefinition id="wait-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="withdrawn" name="Switch withdrawn" />
    <bpmn:endEvent id="billed" name="Final billing received" />
    <bpmn:task id="receivebill" name="Receive the final billing" />
    <bpmn:task id="receive" name="Receive the customer data" />
    <bpmn:task id="enter" name="Enter customer data object into CRM" />
    <bpmn:task id="compare" name="Compare data with customer data base" />
    <bpmn:exclusiveGateway id="errors" name="Errors found?" />
    <bpmn:task id="correct" name="Correct the errors" />
    <bpmn:exclusiveGateway id="mergeerr" />
    <bpmn:exclusiveGateway id="exists" name="Customer exists?" />
    <bpmn:task id="create" name="Create a new customer object" />
    <bpmn:task id="prepare" name="Prepare the contract documents" />
    <bpmn:task id="ciscontract" name="Create CIS contract" />
    <bpmn:exclusiveGateway id="merge1" />
    <bpmn:task id="import" name="Import the meter data" />
    <bpmn:endEvent id="imported" name="Meter data imported" />
    <bpmn:exclusiveGateway id="merge2" />
    <bpmn:task id="checkdocs" name="Check the contract documents" />
    <bpmn:exclusiveGateway id="docsok" name="Documents generated correctly?" />
    <bpmn:task id="resolve" name="Analyze and resolve the issues" />
    <bpmn:parallelGateway id="split1" />
    <bpmn:task id="confirmation" name="Send the confirmation document" />
    <bpmn:task id="sendreq" name="Send the request to the grid operator" />
    <bpmn:parallelGateway id="join1" />
    <bpmn:task id="checkreq" name="Check the switch-over request" />
    <bpmn:task id="comment" name="Transmit the response comment" />
    <bpmn:exclusiveGateway id="concurrence" name="Supplier concurrence?" />
    <bpmn:task id="inform" name="Inform the suppliers and demand conflict resolution" />
    <bpmn:task id="terminate" name="Terminate the sales agreement with the old supplier" />
    <bpmn:endEvent id="conflict" name="Conflict handed over" />
    <bpmn:task id="meter" name="Transmit the meter data" />
    <bpmn:parallelGateway id="split2" />
    <bpmn:task id="compute" name="Compute the final billing" />
    <bpmn:task id="sendbill" name="Send the final billing to the old supplier" />
    <bpmn:task id="createbill" name="Create the final billing" />
    <bpmn:task id="sendfinal" name="Send the final billing to the customer" />
    <bpmn:sequenceFlow id="f-requested-transmit" sourceRef="requested" targetRef="transmit" />
    <bpmn:sequenceFlow id="f-transmit-receive" sourceRef="transmit" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-enter" sourceRef="receive" targetRef="enter" />
    <bpmn:sequenceFlow id="f-enter-compare" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f-compare-errors" sourceRef="compare" targetRef="errors" />
    <bpmn:sequenceFlow id="f-errors-correct" name="yes" sourceRef="errors" targetRef="correct" />
    <bpmn:sequenceFlow id="f-errors-mergeerr" name="no" sourceRef="errors" targetRef="mergeerr" />
    <bpmn:sequenceFlow id="f-correct-mergeerr" sourceRef="correct" targetRef="mergeerr" />
    <bpmn:sequenceFlow id="f-mergeerr-exists" sourceRef="mergeerr" targetRef="exists" />
    <bpmn:sequenceFlow id="f-exists-create" name="no" sourceRef="exists" targetRef="create" />
    <bpmn:sequenceFlow id="f-exists-merge2" name="yes" sourceRef="exists" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-create-merge2" sourceRef="create" targetRef="merge2" />
    <bpmn:sequenceFlow id="f-merge2-prepare" sourceRef="merge2" targetRef="prepare" />
    <bpmn:sequenceFlow id="f-prepare-merge1" sourceRef="prepare" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-merge1-checkdocs" sourceRef="merge1" targetRef="checkdocs" />
    <bpmn:sequenceFlow id="f-checkdocs-docsok" sourceRef="checkdocs" targetRef="docsok" />
    <bpmn:sequenceFlow id="f-docsok-resolve" name="no" sourceRef="docsok" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-merge1" sourceRef="resolve" targetRef="merge1" />
    <bpmn:sequenceFlow id="f-docsok-split1" name="yes" sourceRef="docsok" targetRef="split1" />
    <bpmn:sequenceFlow id="f-split1-confirmation" sourceRef="split1" targetRef="confirmation" />
    <bpmn:sequenceFlow id="f-split1-sendreq" sourceRef="split1" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f-confirmation-join1" sourceRef="confirmation" targetRef="join1" />
    <bpmn:sequenceFlow id="f-sendreq-join1" sourceRef="sendreq" targetRef="join1" />
    <bpmn:sequenceFlow id="f-join1-checkreq" sourceRef="join1" targetRef="checkreq" />
    <bpmn:sequenceFlow id="f-checkreq-comment" sourceRef="checkreq" targetRef="comment" />
    <bpmn:sequenceFlow id="f-comment-concurrence" sourceRef="comment" targetRef="concurrence" />
    <bpmn:sequenceFlow id="f-concurrence-inform" name="yes" sourceRef="concurrence" targetRef="inform" />
    <bpmn:sequenceFlow id="f-inform-terminate" sourceRef="inform" targetRef="terminate" />
    <bpmn:sequenceFlow id="f-terminate-conflict" sourceRef="terminate" targetRef="conflict" />
    <bpmn:sequenceFlow id="f-concurrence-ciscontract" name="no" sourceRef="concurrence" targetRef="ciscontract" />
    <bpmn:sequenceFlow id="f-ciscontract-checkcontract" sourceRef="ciscontract" targetRef="checkcontract" />
    <bpmn:sequenceFlow id="f-checkcontract-decide" sourceRef="checkcontract" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-confirm" sourceRef="decide" targetRef="confirm" />
    <bpmn:sequenceFlow id="f-decide-withdraw" sourceRef="decide" targetRef="withdraw" />
    <bpmn:sequenceFlow id="f-decide-wait" sourceRef="decide" targetRef="wait" />
    <bpmn:sequenceFlow id="f-withdraw-withdrawn" sourceRef="withdraw" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f-confirm-meter" sourceRef="confirm" targetRef="meter" />
    <bpmn:sequenceFlow id="f-wait-meter" sourceRef="wait" targetRef="meter" />
    <bpmn:sequenceFlow id="f-meter-split2" sourceRef="meter" targetRef="split2" />
    <bpmn:sequenceFlow id="f-split2-import" sourceRef="split2" targetRef="import" />
    <bpmn:sequenceFlow id="f-import-imported" sourceRef="import" targetRef="imported" />
    <bpmn:sequenceFlow id="f-split2-compute" sourceRef="split2" targetRef="compute" />
    <bpmn:sequenceFlow id="f-compute-sendbill" sourceRef="compute" targetRef="sendbill" />
    <bpmn:sequenceFlow id="f-sendbill-createbill" sourceRef="sendbill" targetRef="createbill" />
    <bpmn:sequenceFlow id="f-createbill-sendfinal" sourceRef="createbill" targetRef="sendfinal" />
    <bpmn:sequenceFlow id="f-sendfinal-receivebill" sourceRef="sendfinal" targetRef="receivebill" />
    <bpmn:sequenceFlow id="f-receivebill-billed" sourceRef="receivebill" targetRef="billed" />
  </bpmn:process>
</bpmn:definitions>
