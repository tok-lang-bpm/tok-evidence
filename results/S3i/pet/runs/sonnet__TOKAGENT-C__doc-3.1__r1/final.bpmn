<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Warrant possession" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="registry" name="Small Claims Registry Operations" processRef="registry-process" />
  </bpmn:collaboration>
  <bpmn:process id="registry-process" name="Warrant possession" isExecutable="false">
    <bpmn:laneSet id="registry-lanes">
      <bpmn:lane id="party" name="Party">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="office" name="Client Service Back Office">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>getreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrieve2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Warrant release needed" />
    <bpmn:task id="send" name="Send the warrant possession request" />
    <bpmn:task id="receive" name="Receive the request" />
    <bpmn:task id="retrieve" name="Retrieve the SCT file" />
    <bpmn:task id="forward" name="Forward the SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="store" name="Store the SCT physical file" />
    <bpmn:task id="getreport" name="Receive the report from the Police" />
    <bpmn:task id="retrieve2" name="Retrieve the SCT file" />
    <bpmn:task id="attach" name="Attach the new SCT document" />
    <bpmn:task id="store2" name="Store the expanded SCT physical file" />
    <bpmn:endEvent id="done" name="Physical file passed on" />
    <bpmn:sequenceFlow id="f-needed-send" sourceRef="needed" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-receive" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-retrieve" sourceRef="receive" targetRef="retrieve" />
    <bpmn:sequenceFlow id="f-retrieve-forward" sourceRef="retrieve" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-store" sourceRef="forward" targetRef="store" />
    <bpmn:sequenceFlow id="f-store-getreport" sourceRef="store" targetRef="getreport" />
    <bpmn:sequenceFlow id="f-getreport-retrieve2" sourceRef="getreport" targetRef="retrieve2" />
    <bpmn:sequenceFlow id="f-retrieve2-attach" sourceRef="retrieve2" targetRef="attach" />
    <bpmn:sequenceFlow id="f-attach-store2" sourceRef="attach" targetRef="store2" />
    <bpmn:sequenceFlow id="f-store2-done" sourceRef="store2" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
