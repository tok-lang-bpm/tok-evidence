tok 1.0 "Warrant possession"

pool registry "Small Claims Registry Operations"
  lane party "Party"
    start needed "Warrant release needed"
    task send "Send the warrant possession request"
  lane office "Client Service Back Office"
    task receive "Receive the request"
    task retrieve "Retrieve the SCT file"
    task forward "Forward the SCT Warrant Possession to Queensland Police"
    task store "Store the SCT physical file"
    task getreport "Receive the report from the Police"
    task retrieve2 "Retrieve the SCT file"
    task attach "Attach the new SCT document"
    task store2 "Store the expanded SCT physical file"
    end done "Physical file passed on"

flow needed -> send -> receive -> retrieve -> forward -> store -> getreport -> retrieve2 -> attach -> store2 -> done
