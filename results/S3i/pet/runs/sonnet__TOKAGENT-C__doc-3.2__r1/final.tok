tok 1.0 "Court file preparation"

pool court "Court"
  lane staff "Court staff"
    start morning "Court morning begins"
    task check "Check the files"
    xor missing "Files missing?"
    task search "Initiate a search"
    task track "Track the files to the intended location"
    xor ready
    and split
    task hand "Hand the files to the Associate"
    task distribute "Distribute the Judge's Lawlist"
    and joined
    task conduct "Conduct the directions hearings"
    end done "Hearings conducted"

flow morning -> check -> missing
flow missing -> search "yes"
flow missing -> track "no"
flow search -> ready
flow track -> ready
flow ready -> split
flow split -> hand
flow split -> distribute
flow hand -> joined
flow distribute -> joined
flow joined -> conduct -> done
