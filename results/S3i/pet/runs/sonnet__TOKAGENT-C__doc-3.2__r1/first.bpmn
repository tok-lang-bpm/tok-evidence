<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Court file preparation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="court" name="Court" processRef="court-process" />
  </bpmn:collaboration>
  <bpmn:process id="court-process" name="Court file preparation" isExecutable="false">
    <bpmn:laneSet id="court-lanes">
      <bpmn:lane id="staff" name="Court staff">
        <bpmn:flowNodeRef>morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="morning" name="Court morning begins" />
    <bpmn:task id="check" name="Check the files" />
    <bpmn:exclusiveGateway id="missing" name="Files missing?" />
    <bpmn:task id="search" name="Initiate a search" />
    <bpmn:task id="track" name="Track the files to the intended location" />
    <bpmn:exclusiveGateway id="ready" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="hand" name="Hand the files to the Associate" />
    <bpmn:task id="distribute" name="Distribute the Judge's Lawlist" />
    <bpmn:parallelGateway id="joined" />
    <bpmn:task id="conduct" name="Conduct the directions hearings" />
    <bpmn:endEvent id="done" name="Hearings conducted" />
    <bpmn:sequenceFlow id="f-morning-check" sourceRef="morning" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-missing" sourceRef="check" targetRef="missing" />
    <bpmn:sequenceFlow id="f-missing-search" name="yes" sourceRef="missing" targetRef="search" />
    <bpmn:sequenceFlow id="f-missing-track" name="no" sourceRef="missing" targetRef="track" />
    <bpmn:sequenceFlow id="f-search-ready" sourceRef="search" targetRef="ready" />
    <bpmn:sequenceFlow id="f-track-ready" sourceRef="track" targetRef="ready" />
    <bpmn:sequenceFlow id="f-ready-split" sourceRef="ready" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-hand" sourceRef="split" targetRef="hand" />
    <bpmn:sequenceFlow id="f-split-distribute" sourceRef="split" targetRef="distribute" />
    <bpmn:sequenceFlow id="f-hand-joined" sourceRef="hand" targetRef="joined" />
    <bpmn:sequenceFlow id="f-distribute-joined" sourceRef="distribute" targetRef="joined" />
    <bpmn:sequenceFlow id="f-joined-conduct" sourceRef="joined" targetRef="conduct" />
    <bpmn:sequenceFlow id="f-conduct-done" sourceRef="conduct" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
