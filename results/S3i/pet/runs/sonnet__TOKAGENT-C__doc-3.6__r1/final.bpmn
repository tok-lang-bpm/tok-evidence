<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claims notification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organization" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Claims notification" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="clerk" name="Claims handler">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendforms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkforms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Claim received" />
    <bpmn:task id="checkins" name="Check whether the claimant is insured" />
    <bpmn:exclusiveGateway id="insured" name="Claimant insured?" />
    <bpmn:task id="reject" name="Inform the claimant that the claim is rejected" />
    <bpmn:endEvent id="rejected" name="Claim rejected" />
    <bpmn:task id="evaluate" name="Evaluate the severity of the claim" />
    <bpmn:task id="sendforms" name="Send relevant forms to the claimant" />
    <bpmn:task id="checkforms" name="Check the forms for completeness" />
    <bpmn:exclusiveGateway id="complete" name="Forms complete?" />
    <bpmn:task id="register" name="Register the claim in the Claims Management system" />
    <bpmn:endEvent id="done" name="Claim registered" />
    <bpmn:task id="update" name="Inform the claimant to update the forms" />
    <bpmn:task id="receive" name="Receive the updated forms" />
    <bpmn:sequenceFlow id="f-received-checkins" sourceRef="received" targetRef="checkins" />
    <bpmn:sequenceFlow id="f-checkins-insured" sourceRef="checkins" targetRef="insured" />
    <bpmn:sequenceFlow id="f-insured-reject" name="no" sourceRef="insured" targetRef="reject" />
    <bpmn:sequenceFlow id="f-insured-evaluate" name="yes" sourceRef="insured" targetRef="evaluate" />
    <bpmn:sequenceFlow id="f-reject-rejected" sourceRef="reject" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-evaluate-sendforms" sourceRef="evaluate" targetRef="sendforms" />
    <bpmn:sequenceFlow id="f-sendforms-checkforms" sourceRef="sendforms" targetRef="checkforms" />
    <bpmn:sequenceFlow id="f-checkforms-complete" sourceRef="checkforms" targetRef="complete" />
    <bpmn:sequenceFlow id="f-complete-register" name="yes" sourceRef="complete" targetRef="register" />
    <bpmn:sequenceFlow id="f-complete-update" name="no" sourceRef="complete" targetRef="update" />
    <bpmn:sequenceFlow id="f-register-done" sourceRef="register" targetRef="done" />
    <bpmn:sequenceFlow id="f-update-receive" sourceRef="update" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-checkforms" sourceRef="receive" targetRef="checkforms" />
  </bpmn:process>
</bpmn:definitions>
