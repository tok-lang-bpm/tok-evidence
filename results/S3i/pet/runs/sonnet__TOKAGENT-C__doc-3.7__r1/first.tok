tok 1.0 "Claim handling"

pool insurer "Insurer"
  lane clerk "Claims handler"
    start begin "Accident claim received"
    task search "Search the Police Report in the database"
    task file "Put the Police Report in a file with the Claim Documentation"
    task estimate "Calculate the initial claim estimate"
    task plan "Create the Action Plan"
  lane manager "Claims manager"
    task negotiate "Negotiate a settlement on the claim estimate"
    task inform "Inform the claimant of the outcome"
    end done "Process ended"

flow begin -> search -> file -> estimate -> plan -> negotiate -> inform -> done
