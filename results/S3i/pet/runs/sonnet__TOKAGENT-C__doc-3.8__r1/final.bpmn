<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Claim handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="insurer" name="Car insurer" processRef="insurer-process" />
  </bpmn:collaboration>
  <bpmn:process id="insurer-process" name="Claim handling" isExecutable="false">
    <bpmn:laneSet id="insurer-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="notification" name="Notification department">
        <bpmn:flowNodeRef>checkdocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="handling" name="Handling department">
        <bpmn:flowNodeRef>checkins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Claim needed" />
    <bpmn:task id="submit" name="Submit the claim" />
    <bpmn:task id="checkdocs" name="Check the documents for completeness" />
    <bpmn:task id="register" name="Register the claim" />
    <bpmn:task id="checkins" name="Check the insurance" />
    <bpmn:task id="assess" name="Perform the assessment" />
    <bpmn:exclusiveGateway id="positive" name="Assessment positive?" />
    <bpmn:task id="phone" name="Phone the garage to authorise the repairs" />
    <bpmn:task id="schedule" name="Schedule the payment" />
    <bpmn:task id="reject" name="Reject the claim" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="letter" name="Send a letter to the customer" />
    <bpmn:endEvent id="done" name="Claim completed" />
    <bpmn:sequenceFlow id="f-started-submit" sourceRef="started" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-checkdocs" sourceRef="submit" targetRef="checkdocs" />
    <bpmn:sequenceFlow id="f-checkdocs-register" sourceRef="checkdocs" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-checkins" sourceRef="register" targetRef="checkins" />
    <bpmn:sequenceFlow id="f-checkins-assess" sourceRef="checkins" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-positive" sourceRef="assess" targetRef="positive" />
    <bpmn:sequenceFlow id="f-positive-phone" name="yes" sourceRef="positive" targetRef="phone" />
    <bpmn:sequenceFlow id="f-positive-reject" name="no" sourceRef="positive" targetRef="reject" />
    <bpmn:sequenceFlow id="f-phone-schedule" sourceRef="phone" targetRef="schedule" />
    <bpmn:sequenceFlow id="f-schedule-merge" sourceRef="schedule" targetRef="merge" />
    <bpmn:sequenceFlow id="f-reject-merge" sourceRef="reject" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-letter" sourceRef="merge" targetRef="letter" />
    <bpmn:sequenceFlow id="f-letter-done" sourceRef="letter" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
