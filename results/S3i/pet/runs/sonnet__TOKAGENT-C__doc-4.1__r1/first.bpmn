<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Intake workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="institute" name="Mental health care institute" processRef="institute-process" />
  </bpmn:collaboration>
  <bpmn:process id="institute-process" name="Intake workflow" isExecutable="false">
    <bpmn:laneSet id="institute-lanes">
      <bpmn:lane id="sec" name="Secretarial office">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>putthrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isnew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>storeassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passcards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receivecopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informsecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addcopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>puton</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>providelist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="nurse" name="Nursing officer">
        <bpmn:flowNodeRef>fullinq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lead" name="Team-leader">
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assignlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="first" name="First intaker">
        <bpmn:flowNodeRef>plan1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>copynotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>addcheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="second" name="Second intaker">
        <bpmn:flowNodeRef>plan2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exam2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dictate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="notice" name="Notice by telephone received" />
    <bpmn:task id="inquire" name="Inquire after name and residence of the patient" />
    <bpmn:task id="putthrough" name="Put the doctor through to the nursing officer" />
    <bpmn:task id="store" name="Store the form information in the information system" />
    <bpmn:task id="print" name="Print the information" />
    <bpmn:exclusiveGateway id="isnew" name="New patient?" />
    <bpmn:task id="createfile" name="Create a patient file" />
    <bpmn:exclusiveGateway id="newm" />
    <bpmn:task id="storeform" name="Store the registration form and print in the patient file" />
    <bpmn:task id="cards" name="Produce two registration cards" />
    <bpmn:task id="addlist" name="Add the patient to the list of new notices" />
    <bpmn:task id="storeassign" name="Store the assignments in the information system" />
    <bpmn:task id="passcards" name="Pass the registration cards to the first and second intaker" />
    <bpmn:exclusiveGateway id="reqfile" name="Medical file required?" />
    <bpmn:task id="letter" name="Prepare and send a letter requesting a copy of the medical file" />
    <bpmn:task id="receivecopy" name="Receive the copy of the medical file" />
    <bpmn:task id="informsecond" name="Inform the second intaker" />
    <bpmn:task id="addcopy" name="Add the copy to the patient file" />
    <bpmn:exclusiveGateway id="reqm" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="type" name="Type out the dictaphone tapes" />
    <bpmn:task id="addinfo" name="Add the typed information to the patient file" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="puton" name="Put the patient on the list of patients with both meetings done" />
    <bpmn:task id="providelist" name="Provide the team-leader with the list of patients" />
    <bpmn:task id="fullinq" name="Make a full inquiry into the state of the patient" />
    <bpmn:task id="record" name="Record the information on a registration form" />
    <bpmn:task id="handin" name="Hand in the form at the secretarial office" />
    <bpmn:task id="assign" name="Assign new patients to a first and second intaker" />
    <bpmn:task id="assignlist" name="Record the assignments on the assignment list" />
    <bpmn:task id="determine" name="Determine whether the medical file is required" />
    <bpmn:task id="handlist" name="Hand the assignment list to the secretarial office" />
    <bpmn:task id="plan" name="Formulate the treatment plan" />
    <bpmn:endEvent id="done" name="Intake procedure ended" />
    <bpmn:task id="plan1" name="Plan the meeting with the patient" />
    <bpmn:task id="exam1" name="Examine the patient using the standard checklist" />
    <bpmn:task id="notes" name="Register additional observations in the notebook" />
    <bpmn:task id="copynotes" name="Put a copy of the notes in the patient file" />
    <bpmn:task id="addcheck" name="Add the checklist to the patient file" />
    <bpmn:task id="plan2" name="Plan the first meeting with the patient" />
    <bpmn:task id="exam2" name="Examine the patient" />
    <bpmn:task id="dictate" name="Record observations on the dictaphone" />
    <bpmn:sequenceFlow id="f-notice-inquire" sourceRef="notice" targetRef="inquire" />
    <bpmn:sequenceFlow id="f-inquire-putthrough" sourceRef="inquire" targetRef="putthrough" />
    <bpmn:sequenceFlow id="f-putthrough-fullinq" sourceRef="putthrough" targetRef="fullinq" />
    <bpmn:sequenceFlow id="f-fullinq-record" sourceRef="fullinq" targetRef="record" />
    <bpmn:sequenceFlow id="f-record-handin" sourceRef="record" targetRef="handin" />
    <bpmn:sequenceFlow id="f-handin-store" sourceRef="handin" targetRef="store" />
    <bpmn:sequenceFlow id="f-store-print" sourceRef="store" targetRef="print" />
    <bpmn:sequenceFlow id="f-print-isnew" sourceRef="print" targetRef="isnew" />
    <bpmn:sequenceFlow id="f-isnew-createfile" name="yes" sourceRef="isnew" targetRef="createfile" />
    <bpmn:sequenceFlow id="f-isnew-newm" name="no" sourceRef="isnew" targetRef="newm" />
    <bpmn:sequenceFlow id="f-createfile-storeform" sourceRef="createfile" targetRef="storeform" />
    <bpmn:sequenceFlow id="f-storeform-newm" sourceRef="storeform" targetRef="newm" />
    <bpmn:sequenceFlow id="f-newm-cards" sourceRef="newm" targetRef="cards" />
    <bpmn:sequenceFlow id="f-cards-addlist" sourceRef="cards" targetRef="addlist" />
    <bpmn:sequenceFlow id="f-addlist-assign" sourceRef="addlist" targetRef="assign" />
    <bpmn:sequenceFlow id="f-assign-assignlist" sourceRef="assign" targetRef="assignlist" />
    <bpmn:sequenceFlow id="f-assignlist-determine" sourceRef="assignlist" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-handlist" sourceRef="determine" targetRef="handlist" />
    <bpmn:sequenceFlow id="f-handlist-storeassign" sourceRef="handlist" targetRef="storeassign" />
    <bpmn:sequenceFlow id="f-storeassign-passcards" sourceRef="storeassign" targetRef="passcards" />
    <bpmn:sequenceFlow id="f-passcards-reqfile" sourceRef="passcards" targetRef="reqfile" />
    <bpmn:sequenceFlow id="f-reqfile-letter" name="yes" sourceRef="reqfile" targetRef="letter" />
    <bpmn:sequenceFlow id="f-reqfile-reqm" name="no" sourceRef="reqfile" targetRef="reqm" />
    <bpmn:sequenceFlow id="f-letter-receivecopy" sourceRef="letter" targetRef="receivecopy" />
    <bpmn:sequenceFlow id="f-receivecopy-informsecond" sourceRef="receivecopy" targetRef="informsecond" />
    <bpmn:sequenceFlow id="f-informsecond-addcopy" sourceRef="informsecond" targetRef="addcopy" />
    <bpmn:sequenceFlow id="f-addcopy-reqm" sourceRef="addcopy" targetRef="reqm" />
    <bpmn:sequenceFlow id="f-reqm-split" sourceRef="reqm" targetRef="split" />
    <bpmn:sequenceFlow id="f-split-plan1" sourceRef="split" targetRef="plan1" />
    <bpmn:sequenceFlow id="f-split-plan2" sourceRef="split" targetRef="plan2" />
    <bpmn:sequenceFlow id="f-plan1-exam1" sourceRef="plan1" targetRef="exam1" />
    <bpmn:sequenceFlow id="f-exam1-notes" sourceRef="exam1" targetRef="notes" />
    <bpmn:sequenceFlow id="f-notes-copynotes" sourceRef="notes" targetRef="copynotes" />
    <bpmn:sequenceFlow id="f-copynotes-addcheck" sourceRef="copynotes" targetRef="addcheck" />
    <bpmn:sequenceFlow id="f-addcheck-join" sourceRef="addcheck" targetRef="join" />
    <bpmn:sequenceFlow id="f-plan2-exam2" sourceRef="plan2" targetRef="exam2" />
    <bpmn:sequenceFlow id="f-exam2-dictate" sourceRef="exam2" targetRef="dictate" />
    <bpmn:sequenceFlow id="f-dictate-type" sourceRef="dictate" targetRef="type" />
    <bpmn:sequenceFlow id="f-type-addinfo" sourceRef="type" targetRef="addinfo" />
    <bpmn:sequenceFlow id="f-addinfo-join" sourceRef="addinfo" targetRef="join" />
    <bpmn:sequenceFlow id="f-join-puton" sourceRef="join" targetRef="puton" />
    <bpmn:sequenceFlow id="f-puton-providelist" sourceRef="puton" targetRef="providelist" />
    <bpmn:sequenceFlow id="f-providelist-plan" sourceRef="providelist" targetRef="plan" />
    <bpmn:sequenceFlow id="f-plan-done" sourceRef="plan" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
