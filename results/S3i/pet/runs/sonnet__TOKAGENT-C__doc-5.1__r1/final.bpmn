<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Loan approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="bank-process" />
  </bpmn:collaboration>
  <bpmn:process id="bank-process" name="Loan approval" isExecutable="false">
    <bpmn:laneSet id="bank-lanes">
      <bpmn:lane id="customer" name="Customer">
        <bpmn:flowNodeRef>started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="assessor" name="Risk assessment service">
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="approverlane" name="Approver service">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="started" name="Loan request needed" />
    <bpmn:task id="request" name="Submit the loan request" />
    <bpmn:task id="feedback" name="Receive the feedback" />
    <bpmn:endEvent id="done" name="Customer informed" />
    <bpmn:serviceTask id="assess" name="Assess the request" />
    <bpmn:exclusiveGateway id="decide" name="Assessment result?" default="f-decide-review" />
    <bpmn:task id="approve" name="Approve the loan" />
    <bpmn:task id="deny" name="Deny the loan" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:serviceTask id="review" name="Review the request" />
    <bpmn:sequenceFlow id="f-started-request" sourceRef="started" targetRef="request" />
    <bpmn:sequenceFlow id="f-request-assess" sourceRef="request" targetRef="assess" />
    <bpmn:sequenceFlow id="f-assess-decide" sourceRef="assess" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-approve" name="small loan, low risk" sourceRef="decide" targetRef="approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &lt; 10000 and risk = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decide-deny" name="high risk" sourceRef="decide" targetRef="deny">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">risk = "high"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-decide-review" name="further review or 10,000 or more" sourceRef="decide" targetRef="review" />
    <bpmn:sequenceFlow id="f-approve-merge" sourceRef="approve" targetRef="merge" />
    <bpmn:sequenceFlow id="f-deny-merge" sourceRef="deny" targetRef="merge" />
    <bpmn:sequenceFlow id="f-review-merge" sourceRef="review" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-feedback" sourceRef="merge" targetRef="feedback" />
    <bpmn:sequenceFlow id="f-feedback-done" sourceRef="feedback" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
