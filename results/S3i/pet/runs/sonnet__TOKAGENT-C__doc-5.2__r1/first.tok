tok 1.0 "Vacations Request"

pool org "Organization"
  lane emp "Employee"
    start needed "Vacation needed"
    task submit "Submit the vacation request"
    task review "Review the rejection reasons"
    end closed "Request returned"
  lane sup "Supervisor"
    task receive "Receive the request"
    xor ok "Request approved?"
  lane hr "Human Resources Representative"
    task complete "Complete the management procedures"
    end done "Vacation managed"

flow needed -> submit -> receive -> ok
flow ok -> complete "yes"
flow ok -> review "no"
flow complete -> done
flow review -> closed
