<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Office Supply Request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Office Supply Request" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="emp" name="Employee">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sup" name="Supervisor">
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="pur" name="Purchase department">
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="System">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nrej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>nchg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>napp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Office supply request needed" />
    <bpmn:task id="submit" name="Submit the office supply request" />
    <bpmn:task id="review" name="Review the change comments" />
    <bpmn:task id="decide" name="Evaluate the request" />
    <bpmn:exclusiveGateway id="outcome" name="Decision?" />
    <bpmn:subProcess id="quote" name="Make quotations">
      <bpmn:startEvent id="qs" name="Start quotations" />
      <bpmn:task id="collect" name="Collect the quotations" />
      <bpmn:endEvent id="qe" name="Quotations made" />
      <bpmn:sequenceFlow id="f-qs-collect" sourceRef="qs" targetRef="collect" />
      <bpmn:sequenceFlow id="f-collect-qe" sourceRef="collect" targetRef="qe" />
    </bpmn:subProcess>
    <bpmn:task id="select" name="Select a vendor" />
    <bpmn:exclusiveGateway id="valid" name="Vendor valid in the system?" />
    <bpmn:task id="register" name="Register the request" />
    <bpmn:task id="nrej" name="Send the rejection notification" />
    <bpmn:task id="nchg" name="Send the change notification" />
    <bpmn:task id="napp" name="Send the approval notification" />
    <bpmn:task id="gen" name="Generate the purchase order" />
    <bpmn:task id="send" name="Send the purchase order" />
    <bpmn:task id="deliver" name="Receive the product and the invoice" />
    <bpmn:endEvent id="rejected" name="Request rejected" />
    <bpmn:endEvent id="done" name="Request completed" />
    <bpmn:sequenceFlow id="f-begin-submit" sourceRef="begin" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-register" sourceRef="submit" targetRef="register" />
    <bpmn:sequenceFlow id="f-register-decide" sourceRef="register" targetRef="decide" />
    <bpmn:sequenceFlow id="f-decide-outcome" sourceRef="decide" targetRef="outcome" />
    <bpmn:sequenceFlow id="f-outcome-nrej" name="rejected" sourceRef="outcome" targetRef="nrej" />
    <bpmn:sequenceFlow id="f-outcome-nchg" name="change required" sourceRef="outcome" targetRef="nchg" />
    <bpmn:sequenceFlow id="f-outcome-napp" name="approved" sourceRef="outcome" targetRef="napp" />
    <bpmn:sequenceFlow id="f-nrej-rejected" sourceRef="nrej" targetRef="rejected" />
    <bpmn:sequenceFlow id="f-nchg-review" sourceRef="nchg" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-submit" sourceRef="review" targetRef="submit" />
    <bpmn:sequenceFlow id="f-napp-quote" sourceRef="napp" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-select" sourceRef="quote" targetRef="select" />
    <bpmn:sequenceFlow id="f-select-valid" sourceRef="select" targetRef="valid" />
    <bpmn:sequenceFlow id="f-valid-select" name="no" sourceRef="valid" targetRef="select" />
    <bpmn:sequenceFlow id="f-valid-gen" name="yes" sourceRef="valid" targetRef="gen" />
    <bpmn:sequenceFlow id="f-gen-send" sourceRef="gen" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-deliver" sourceRef="send" targetRef="deliver" />
    <bpmn:sequenceFlow id="f-deliver-done" sourceRef="deliver" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
