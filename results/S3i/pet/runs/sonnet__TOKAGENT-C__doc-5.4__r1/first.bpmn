<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Expense reports" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Payment_confirmation" name="Payment confirmation" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="company" name="Company" processRef="company-process" />
  </bpmn:collaboration>
  <bpmn:process id="company-process" name="Expense reports" isExecutable="false">
    <bpmn:laneSet id="company-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Supervisor">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="treasurer" name="Treasurer">
        <bpmn:flowNodeRef>checkr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payment" name="Payment system">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="needed" name="Product or service required" />
    <bpmn:task id="purchase" name="Purchase the product or service" />
    <bpmn:task id="submit" name="Submit the expense report" />
    <bpmn:task id="edit" name="Edit the expense report" />
    <bpmn:task id="review" name="Review the expense report" />
    <bpmn:exclusiveGateway id="approved" name="Report approved?" />
    <bpmn:task id="checkr" name="Check the receipts" />
    <bpmn:exclusiveGateway id="inorder" name="All in order?" />
    <bpmn:task id="accept" name="Accept the expenses for processing" />
    <bpmn:serviceTask id="pay" name="Link to the payment system" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Payment confirmed">
      <bpmn:messageEventDefinition id="confirmed-def" messageRef="Message_Payment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="done" name="Expenses processed" />
    <bpmn:sequenceFlow id="f-needed-purchase" sourceRef="needed" targetRef="purchase" />
    <bpmn:sequenceFlow id="f-purchase-submit" sourceRef="purchase" targetRef="submit" />
    <bpmn:sequenceFlow id="f-submit-review" sourceRef="submit" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-approved" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-checkr" name="yes" sourceRef="approved" targetRef="checkr" />
    <bpmn:sequenceFlow id="f-approved-edit" name="no" sourceRef="approved" targetRef="edit" />
    <bpmn:sequenceFlow id="f-edit-review" sourceRef="edit" targetRef="review" />
    <bpmn:sequenceFlow id="f-checkr-inorder" sourceRef="checkr" targetRef="inorder" />
    <bpmn:sequenceFlow id="f-inorder-accept" name="yes" sourceRef="inorder" targetRef="accept" />
    <bpmn:sequenceFlow id="f-inorder-edit" name="no" sourceRef="inorder" targetRef="edit" />
    <bpmn:sequenceFlow id="f-accept-pay" sourceRef="accept" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-confirmed" sourceRef="pay" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f-confirmed-done" sourceRef="confirmed" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
