<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Invoice approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="acme" name="ACME AG" processRef="acme-process" />
  </bpmn:collaboration>
  <bpmn:process id="acme-process" name="Invoice approval" isExecutable="false">
    <bpmn:laneSet id="acme-lanes">
      <bpmn:lane id="sec" name="Secretariat">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Accounting employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forwardcm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auditm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ccm" name="Cost center manager">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="com" name="Commercial manager">
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>big</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="board" name="Board">
        <bpmn:flowNodeRef>boardcheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Invoice received" />
    <bpmn:task id="receive" name="Receive the invoice" />
    <bpmn:task id="inspect" name="Inspect the invoice visually" />
    <bpmn:task id="forward" name="Forward the invoice to the accounting employee" />
    <bpmn:task id="identify" name="Identify the supplier and create the invoice instance" />
    <bpmn:task id="checkitems" name="Check the invoice items and note cost centers on the docket" />
    <bpmn:exclusiveGateway id="sendm" />
    <bpmn:task id="send" name="Send the docket and invoice copy to the cost center manager" />
    <bpmn:task id="clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:task id="forwardcm" name="Forward the invoice copy to the commercial manager" />
    <bpmn:exclusiveGateway id="payjoin" />
    <bpmn:task id="resolve" name="Resolve the complaint with the supplier" />
    <bpmn:exclusiveGateway id="auditm" />
    <bpmn:task id="pay" name="Give payment instructions" />
    <bpmn:task id="close" name="Close the instance" />
    <bpmn:endEvent id="e" name="Invoice processed" />
    <bpmn:task id="review" name="Review the invoice content" />
    <bpmn:exclusiveGateway id="ok" name="Everything in order?" />
    <bpmn:task id="ap" name="Note the AP code on the docket" />
    <bpmn:exclusiveGateway id="more" name="All positions marked AP?" />
    <bpmn:task id="reject" name="Reject the AP with a note and statement" />
    <bpmn:task id="audit" name="Make the commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint?" />
    <bpmn:task id="approve" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="big" name="Amount exceeds EUR 20?" default="f-big-payjoin" />
    <bpmn:task id="boardcheck" name="Check the invoice again" />
    <bpmn:sequenceFlow id="f-s-receive" sourceRef="s" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-inspect" sourceRef="receive" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-forward" sourceRef="inspect" targetRef="forward" />
    <bpmn:sequenceFlow id="f-forward-identify" sourceRef="forward" targetRef="identify" />
    <bpmn:sequenceFlow id="f-identify-checkitems" sourceRef="identify" targetRef="checkitems" />
    <bpmn:sequenceFlow id="f-checkitems-sendm" sourceRef="checkitems" targetRef="sendm" />
    <bpmn:sequenceFlow id="f-sendm-send" sourceRef="sendm" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-review" sourceRef="send" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-ok" sourceRef="review" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-ap" name="yes" sourceRef="ok" targetRef="ap" />
    <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f-ap-more" sourceRef="ap" targetRef="more" />
    <bpmn:sequenceFlow id="f-more-review" name="no" sourceRef="more" targetRef="review" />
    <bpmn:sequenceFlow id="f-more-forwardcm" name="yes" sourceRef="more" targetRef="forwardcm" />
    <bpmn:sequenceFlow id="f-reject-clarify" sourceRef="reject" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-sendm" sourceRef="clarify" targetRef="sendm" />
    <bpmn:sequenceFlow id="f-forwardcm-auditm" sourceRef="forwardcm" targetRef="auditm" />
    <bpmn:sequenceFlow id="f-auditm-audit" sourceRef="auditm" targetRef="audit" />
    <bpmn:sequenceFlow id="f-audit-complaint" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f-complaint-resolve" name="yes" sourceRef="complaint" targetRef="resolve" />
    <bpmn:sequenceFlow id="f-resolve-auditm" sourceRef="resolve" targetRef="auditm" />
    <bpmn:sequenceFlow id="f-complaint-approve" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f-approve-big" sourceRef="approve" targetRef="big" />
    <bpmn:sequenceFlow id="f-big-boardcheck" name="yes" sourceRef="big" targetRef="boardcheck" />
    <bpmn:sequenceFlow id="f-big-payjoin" name="no" sourceRef="big" targetRef="payjoin" />
    <bpmn:sequenceFlow id="f-boardcheck-payjoin" sourceRef="boardcheck" targetRef="payjoin" />
    <bpmn:sequenceFlow id="f-payjoin-pay" sourceRef="payjoin" targetRef="pay" />
    <bpmn:sequenceFlow id="f-pay-close" sourceRef="pay" targetRef="close" />
    <bpmn:sequenceFlow id="f-close-e" sourceRef="close" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
