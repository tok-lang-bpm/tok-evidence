tok 1.0 "Monthly order"

pool org "Organisation"
  lane assembler "Assembler AG"
    start monthly "First of each month" timer=P1M
    task send "Send the order to the supplier"
    task receive "Receive the invoice"
    end done "Invoice received"
  lane supplier "Supplier"
    task process "Process the order"
    task invoice "Send an invoice to Assembler AG"

flow monthly -> send -> process -> invoice -> receive -> done
