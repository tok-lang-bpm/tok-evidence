<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Customer acquisition" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Customer_contact" name="Customer contact" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Company" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Customer acquisition" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="marketing" name="Marketing">
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>how</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhibit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>got</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="callcenter" name="Call center">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>huge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Head of development">
        <bpmn:flowNodeRef>acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acquired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="presales" name="Pre-sales">
        <bpmn:flowNodeRef>technical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sales" name="Sales representative">
        <bpmn:flowNodeRef>kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>presented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="begin" name="Customer details needed" />
    <bpmn:exclusiveGateway id="how" name="How are details obtained?" />
    <bpmn:task id="buy" name="Buy details for cold calls" />
    <bpmn:task id="exhibit" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Use personal acquaintance" />
    <bpmn:exclusiveGateway id="got" />
    <bpmn:task id="call" name="Call the customer" />
    <bpmn:task id="determine" name="Determine contact person and budget" />
    <bpmn:task id="ask" name="Ask whether customer is interested" />
    <bpmn:exclusiveGateway id="interested" name="Interested?" />
    <bpmn:exclusiveGateway id="huge" name="Budget huge?" />
    <bpmn:endEvent id="leave" name="Customer left alone" />
    <bpmn:task id="acquire" name="Acquire the customer personally" />
    <bpmn:endEvent id="acquired" name="Customer acquisition attempted" />
    <bpmn:task id="technical" name="Give technical online presentation" />
    <bpmn:exclusiveGateway id="kind" name="Technical presentation?" />
    <bpmn:task id="present" name="Give online presentation" />
    <bpmn:exclusiveGateway id="presented" />
    <bpmn:eventBasedGateway id="wait" name="Wait for customer" />
    <bpmn:intermediateCatchEvent id="back" name="Customer contacts us">
      <bpmn:messageEventDefinition id="back-def" messageRef="Message_Customer_contact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="late" name="2 weeks passed">
      <bpmn:timerEventDefinition id="late-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="remind" name="Call the customer again" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="quote" name="Create quotation" />
    <bpmn:endEvent id="done" name="Quotation created" />
    <bpmn:sequenceFlow id="f-begin-how" sourceRef="begin" targetRef="how" />
    <bpmn:sequenceFlow id="f-how-buy" name="bought" sourceRef="how" targetRef="buy" />
    <bpmn:sequenceFlow id="f-how-exhibit" name="exhibition" sourceRef="how" targetRef="exhibit" />
    <bpmn:sequenceFlow id="f-how-know" name="acquaintance" sourceRef="how" targetRef="know" />
    <bpmn:sequenceFlow id="f-buy-got" sourceRef="buy" targetRef="got" />
    <bpmn:sequenceFlow id="f-exhibit-got" sourceRef="exhibit" targetRef="got" />
    <bpmn:sequenceFlow id="f-know-got" sourceRef="know" targetRef="got" />
    <bpmn:sequenceFlow id="f-got-call" sourceRef="got" targetRef="call" />
    <bpmn:sequenceFlow id="f-call-determine" sourceRef="call" targetRef="determine" />
    <bpmn:sequenceFlow id="f-determine-ask" sourceRef="determine" targetRef="ask" />
    <bpmn:sequenceFlow id="f-ask-interested" sourceRef="ask" targetRef="interested" />
    <bpmn:sequenceFlow id="f-interested-kind" name="yes" sourceRef="interested" targetRef="kind" />
    <bpmn:sequenceFlow id="f-interested-huge" name="no" sourceRef="interested" targetRef="huge" />
    <bpmn:sequenceFlow id="f-huge-acquire" name="yes" sourceRef="huge" targetRef="acquire" />
    <bpmn:sequenceFlow id="f-huge-leave" name="no" sourceRef="huge" targetRef="leave" />
    <bpmn:sequenceFlow id="f-acquire-acquired" sourceRef="acquire" targetRef="acquired" />
    <bpmn:sequenceFlow id="f-kind-technical" name="yes" sourceRef="kind" targetRef="technical" />
    <bpmn:sequenceFlow id="f-kind-present" name="no" sourceRef="kind" targetRef="present" />
    <bpmn:sequenceFlow id="f-technical-presented" sourceRef="technical" targetRef="presented" />
    <bpmn:sequenceFlow id="f-present-presented" sourceRef="present" targetRef="presented" />
    <bpmn:sequenceFlow id="f-presented-wait" sourceRef="presented" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-back" sourceRef="wait" targetRef="back" />
    <bpmn:sequenceFlow id="f-wait-late" sourceRef="wait" targetRef="late" />
    <bpmn:sequenceFlow id="f-back-merge" sourceRef="back" targetRef="merge" />
    <bpmn:sequenceFlow id="f-late-remind" sourceRef="late" targetRef="remind" />
    <bpmn:sequenceFlow id="f-remind-merge" sourceRef="remind" targetRef="merge" />
    <bpmn:sequenceFlow id="f-merge-quote" sourceRef="merge" targetRef="quote" />
    <bpmn:sequenceFlow id="f-quote-done" sourceRef="quote" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
