<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Post filling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Post filling" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="dept" name="Functional department">
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel department">
        <bpmn:flowNodeRef>advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="demand" name="Demand to fill a post" />
    <bpmn:task id="advertise" name="Advertise the post" />
    <bpmn:task id="receive" name="Receive the applications" />
    <bpmn:task id="check" name="Check the applications" />
    <bpmn:task id="conclude" name="Conclude the contract of employment" />
    <bpmn:endEvent id="filled" name="Post filled" />
    <bpmn:sequenceFlow id="f-demand-advertise" sourceRef="demand" targetRef="advertise" />
    <bpmn:sequenceFlow id="f-advertise-receive" sourceRef="advertise" targetRef="receive" />
    <bpmn:sequenceFlow id="f-receive-check" sourceRef="receive" targetRef="check" />
    <bpmn:sequenceFlow id="f-check-conclude" sourceRef="check" targetRef="conclude" />
    <bpmn:sequenceFlow id="f-conclude-filled" sourceRef="conclude" targetRef="filled" />
  </bpmn:process>
</bpmn:definitions>
