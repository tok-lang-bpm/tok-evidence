<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job posting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="hr" name="HR" processRef="hr-process" />
  </bpmn:collaboration>
  <bpmn:process id="hr-process" name="Job posting" isExecutable="false">
    <bpmn:laneSet id="hr-lanes">
      <bpmn:lane id="clerk" name="HR clerk">
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confusing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="reported" name="Vacancy reported" />
    <bpmn:task id="create" name="Create the job description" />
    <bpmn:exclusiveGateway id="confusing" name="Information confusing?" />
    <bpmn:task id="ask" name="Ask the Department again" />
    <bpmn:task id="submit" name="Submit the job description for consideration" />
    <bpmn:exclusiveGateway id="approved" name="Approved?" />
    <bpmn:task id="correct" name="Correct the description" />
    <bpmn:task id="post" name="Post the job" />
    <bpmn:endEvent id="done" name="Job posted" />
    <bpmn:sequenceFlow id="f-reported-create" sourceRef="reported" targetRef="create" />
    <bpmn:sequenceFlow id="f-create-confusing" sourceRef="create" targetRef="confusing" />
    <bpmn:sequenceFlow id="f-confusing-ask" name="yes" sourceRef="confusing" targetRef="ask" />
    <bpmn:sequenceFlow id="f-confusing-submit" name="no" sourceRef="confusing" targetRef="submit" />
    <bpmn:sequenceFlow id="f-ask-create" sourceRef="ask" targetRef="create" />
    <bpmn:sequenceFlow id="f-submit-approved" sourceRef="submit" targetRef="approved" />
    <bpmn:sequenceFlow id="f-approved-post" name="yes" sourceRef="approved" targetRef="post" />
    <bpmn:sequenceFlow id="f-approved-correct" name="no" sourceRef="approved" targetRef="correct" />
    <bpmn:sequenceFlow id="f-correct-submit" sourceRef="correct" targetRef="submit" />
    <bpmn:sequenceFlow id="f-post-done" sourceRef="post" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
