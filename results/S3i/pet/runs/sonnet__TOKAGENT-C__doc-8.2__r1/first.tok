tok 1.0 "Job posting"

pool hr "HR"
  lane clerk "HR clerk"
    start reported "Vacancy reported"
    task create "Create the job description"
    xor confusing "Information confusing?"
    task ask "Ask the Department again"
    task submit "Submit the job description for consideration"
    xor approved "Approved?"
    task correct "Correct the description"
    task post "Post the job"
    end done "Job posted"

flow reported -> create
flow create -> confusing
flow confusing -> ask "yes"
flow confusing -> submit "no"
flow ask -> create
flow submit -> approved
flow approved -> post "yes"
flow approved -> correct "no"
flow correct -> submit
flow post -> done
