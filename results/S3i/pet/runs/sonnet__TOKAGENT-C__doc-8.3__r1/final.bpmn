<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Job vacancy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:message id="Message_Job_description" name="Job description" />
  <bpmn:message id="Message_Questions" name="Questions" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Job vacancy" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report the vacancy to the Personnel Department" />
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="jd" name="Job description received">
      <bpmn:messageEventDefinition id="jd-def" messageRef="Message_Job_description" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="q" name="Questions received">
      <bpmn:messageEventDefinition id="q-def" messageRef="Message_Questions" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="clarify" name="Provide clarifications" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="ok" name="Corrections needed?" />
    <bpmn:task id="corr" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:endEvent id="e" name="Job description approved" />
    <bpmn:sequenceFlow id="f-s-report" sourceRef="s" targetRef="report" />
    <bpmn:sequenceFlow id="f-report-wait" sourceRef="report" targetRef="wait" />
    <bpmn:sequenceFlow id="f-wait-jd" sourceRef="wait" targetRef="jd" />
    <bpmn:sequenceFlow id="f-wait-q" sourceRef="wait" targetRef="q" />
    <bpmn:sequenceFlow id="f-q-clarify" sourceRef="q" targetRef="clarify" />
    <bpmn:sequenceFlow id="f-clarify-wait" sourceRef="clarify" targetRef="wait" />
    <bpmn:sequenceFlow id="f-jd-review" sourceRef="jd" targetRef="review" />
    <bpmn:sequenceFlow id="f-review-ok" sourceRef="review" targetRef="ok" />
    <bpmn:sequenceFlow id="f-ok-corr" name="yes" sourceRef="ok" targetRef="corr" />
    <bpmn:sequenceFlow id="f-ok-approve" name="no" sourceRef="ok" targetRef="approve" />
    <bpmn:sequenceFlow id="f-corr-wait" sourceRef="corr" targetRef="wait" />
    <bpmn:sequenceFlow id="f-approve-e" sourceRef="approve" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
