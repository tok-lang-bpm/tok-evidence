tok 1.0 "Job vacancy"

pool org "Organisation"
  lane head "Head of the functional department"
    start s "Personnel requirements detected"
    task report "Report the vacancy to the Personnel Department"
    eventgw wait
    catch jd "Job description received" message="Job description"
    catch q "Questions received" message="Questions"
    task clarify "Provide clarifications"
    task review "Review the job description"
    xor ok "Corrections needed?"
    task corr "Ask for corrections"
    task approve "Approve the job description"
    end e "Job description approved"

flow s -> report -> wait
flow wait -> jd
flow wait -> q
flow q -> clarify -> wait
flow jd -> review -> ok
flow ok -> corr "yes"
flow ok -> approve "no"
flow corr -> wait
flow approve -> e
