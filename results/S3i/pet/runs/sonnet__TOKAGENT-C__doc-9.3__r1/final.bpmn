<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" name="Meeting schedule" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="authority" name="Town Planning Authority" processRef="authority-process" />
  </bpmn:collaboration>
  <bpmn:process id="authority-process" name="Meeting schedule" isExecutable="false">
    <bpmn:laneSet id="authority-lanes">
      <bpmn:lane id="coord" name="Coordination Unit">
        <bpmn:flowNodeRef>nov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="support" name="Support Officer">
        <bpmn:flowNodeRef>checkd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="members" name="Committee Members">
        <bpmn:flowNodeRef>diary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="nov" name="November" />
    <bpmn:task id="draft" name="Draft the schedule of meetings" />
    <bpmn:task id="add" name="Add draft dates to all calendars" />
    <bpmn:task id="recheck" name="Recheck all dates" />
    <bpmn:task id="conflicts" name="Look for potential conflicts" />
    <bpmn:task id="send" name="Send the final schedule by email" />
    <bpmn:task id="collect" name="Receive conflicts from Committee Members" />
    <bpmn:endEvent id="done" name="Schedule finalised" />
    <bpmn:task id="checkd" name="Check the dates" />
    <bpmn:task id="suggest" name="Suggest modifications" />
    <bpmn:task id="diary" name="Check diaries" />
    <bpmn:task id="advise" name="Advise the Coordination Unit of conflicts" />
    <bpmn:sequenceFlow id="f-nov-draft" sourceRef="nov" targetRef="draft" />
    <bpmn:sequenceFlow id="f-draft-add" sourceRef="draft" targetRef="add" />
    <bpmn:sequenceFlow id="f-add-checkd" sourceRef="add" targetRef="checkd" />
    <bpmn:sequenceFlow id="f-checkd-suggest" sourceRef="checkd" targetRef="suggest" />
    <bpmn:sequenceFlow id="f-suggest-recheck" sourceRef="suggest" targetRef="recheck" />
    <bpmn:sequenceFlow id="f-recheck-conflicts" sourceRef="recheck" targetRef="conflicts" />
    <bpmn:sequenceFlow id="f-conflicts-send" sourceRef="conflicts" targetRef="send" />
    <bpmn:sequenceFlow id="f-send-diary" sourceRef="send" targetRef="diary" />
    <bpmn:sequenceFlow id="f-diary-advise" sourceRef="diary" targetRef="advise" />
    <bpmn:sequenceFlow id="f-advise-collect" sourceRef="advise" targetRef="collect" />
    <bpmn:sequenceFlow id="f-collect-done" sourceRef="collect" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
