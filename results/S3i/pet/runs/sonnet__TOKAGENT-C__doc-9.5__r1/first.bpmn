<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Expense report" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="org" name="Organisation" processRef="org-process" />
  </bpmn:collaboration>
  <bpmn:process id="org-process" name="Expense report" isExecutable="false">
    <bpmn:laneSet id="org-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmitted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Finance system">
        <bpmn:flowNodeRef>handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inprog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="received" name="Expense report received" />
    <bpmn:task id="resubmit" name="Re-submit the expense report" />
    <bpmn:endEvent id="resubmitted" name="Report re-submitted" />
    <bpmn:subProcess id="handle" name="Process the expense report">
      <bpmn:startEvent id="s" name="Start" />
      <bpmn:exclusiveGateway id="hasacc" name="Employee has an account?" />
      <bpmn:task id="create" name="Create a new account" />
      <bpmn:exclusiveGateway id="m1" />
      <bpmn:task id="review" name="Review the report for automatic approval" />
      <bpmn:exclusiveGateway id="small" name="Amount under $200?" />
      <bpmn:task id="approve" name="Approve the report by supervisor" />
      <bpmn:exclusiveGateway id="m2" />
      <bpmn:exclusiveGateway id="ok" name="Approved?" />
      <bpmn:task id="reject" name="Send the rejection notice by email" />
      <bpmn:task id="pay" name="Transfer the reimbursement to the direct deposit account" />
      <bpmn:endEvent id="e1" name="Report rejected" />
      <bpmn:endEvent id="e2" name="Reimbursement paid" />
      <bpmn:sequenceFlow id="f-s-hasacc" sourceRef="s" targetRef="hasacc" />
      <bpmn:sequenceFlow id="f-hasacc-create" name="no" sourceRef="hasacc" targetRef="create" />
      <bpmn:sequenceFlow id="f-hasacc-m1" name="yes" sourceRef="hasacc" targetRef="m1" />
      <bpmn:sequenceFlow id="f-create-m1" sourceRef="create" targetRef="m1" />
      <bpmn:sequenceFlow id="f-m1-review" sourceRef="m1" targetRef="review" />
      <bpmn:sequenceFlow id="f-review-small" sourceRef="review" targetRef="small" />
      <bpmn:sequenceFlow id="f-small-m2" name="yes" sourceRef="small" targetRef="m2" />
      <bpmn:sequenceFlow id="f-small-approve" name="no" sourceRef="small" targetRef="approve" />
      <bpmn:sequenceFlow id="f-approve-m2" sourceRef="approve" targetRef="m2" />
      <bpmn:sequenceFlow id="f-m2-ok" sourceRef="m2" targetRef="ok" />
      <bpmn:sequenceFlow id="f-ok-reject" name="no" sourceRef="ok" targetRef="reject" />
      <bpmn:sequenceFlow id="f-ok-pay" name="yes" sourceRef="ok" targetRef="pay" />
      <bpmn:sequenceFlow id="f-reject-e1" sourceRef="reject" targetRef="e1" />
      <bpmn:sequenceFlow id="f-pay-e2" sourceRef="pay" targetRef="e2" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="t7" name="7 days" attachedToRef="handle" cancelActivity="false">
      <bpmn:timerEventDefinition id="t7-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="t30" name="30 days" attachedToRef="handle">
      <bpmn:timerEventDefinition id="t30-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="progress" name="Send the approval in progress email" />
    <bpmn:task id="cancel" name="Send the cancellation notice by email" />
    <bpmn:endEvent id="done" name="Report processed" />
    <bpmn:endEvent id="inprog" name="Reminder sent" />
    <bpmn:endEvent id="cancelled" name="Process stopped" />
    <bpmn:sequenceFlow id="f-received-handle" sourceRef="received" targetRef="handle" />
    <bpmn:sequenceFlow id="f-handle-done" sourceRef="handle" targetRef="done" />
    <bpmn:sequenceFlow id="f-t7-progress" sourceRef="t7" targetRef="progress" />
    <bpmn:sequenceFlow id="f-progress-inprog" sourceRef="progress" targetRef="inprog" />
    <bpmn:sequenceFlow id="f-t30-cancel" sourceRef="t30" targetRef="cancel" />
    <bpmn:sequenceFlow id="f-cancel-resubmit" sourceRef="cancel" targetRef="resubmit" />
    <bpmn:sequenceFlow id="f-resubmit-resubmitted" sourceRef="resubmit" targetRef="resubmitted" />
  </bpmn:process>
</bpmn:definitions>
