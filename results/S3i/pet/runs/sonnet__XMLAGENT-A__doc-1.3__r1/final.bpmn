<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="The Evanstonian" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Manager" name="Room-service manager">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Alc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveSomm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AlcMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_Food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_Wine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_Cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Guest calls room service" />
    <bpmn:task id="Task_Take" name="Take down the order" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Submit" name="Submit order ticket to the kitchen" />
    <bpmn:task id="Task_Food" name="Prepare the food" />
    <bpmn:exclusiveGateway id="Gw_Alc" name="Order includes alcoholic beverage?" default="F_no" />
    <bpmn:task id="Task_GiveSomm" name="Give order to the sommelier" />
    <bpmn:task id="Task_Wine" name="Fetch wine from the cellar" />
    <bpmn:task id="Task_Bev" name="Prepare other alcoholic beverages" />
    <bpmn:exclusiveGateway id="Gw_AlcMerge" />
    <bpmn:task id="Task_Assign" name="Assign the order to the waiter" />
    <bpmn:task id="Task_Cart" name="Ready the cart" />
    <bpmn:task id="Task_Drinks" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="Task_Return" name="Return to the room-service station" />
    <bpmn:task id="Task_Debit" name="Debit the guest's account" />
    <bpmn:endEvent id="End_1" name="Order delivered and billed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Take" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Take" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Split" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split" targetRef="Gw_Alc" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Submit" targetRef="Task_Food" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Food" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Alc" targetRef="Task_GiveSomm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alcohol = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Alc" targetRef="Gw_AlcMerge" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_GiveSomm" targetRef="Task_Wine" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Wine" targetRef="Task_Bev" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Bev" targetRef="Gw_AlcMerge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_AlcMerge" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Assign" targetRef="Task_Cart" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Cart" targetRef="Task_Drinks" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Drinks" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Join" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Deliver" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Return" targetRef="Task_Debit" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Debit" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
