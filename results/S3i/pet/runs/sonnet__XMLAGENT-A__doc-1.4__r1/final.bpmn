<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Going public" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UW" name="Underwriters">
        <bpmn:flowNodeRef>Task_Advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Road</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Offered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Not</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Decision to go public made" />
    <bpmn:task id="Task_Select" name="Select the underwriters" />
    <bpmn:task id="Task_Advice" name="Provide the company with procedural and financial advice" />
    <bpmn:task id="Task_Prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Register" name="Register the issue with the SEC" />
    <bpmn:task id="Task_Check" name="Check compliance with the blue-sky laws" />
    <bpmn:task id="Task_Firm" name="Firm up the issue price" />
    <bpmn:task id="Task_Road" name="Arrange a road show" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Clear" name="Receive clearance from the SEC" />
    <bpmn:task id="Task_Fix" name="Fix the issue price" />
    <bpmn:task id="Task_Commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:exclusiveGateway id="Gw_Reason" name="Reason not to offer the stock?" default="F_no" />
    <bpmn:task id="Task_Offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="End_Offered" name="Stock offered" />
    <bpmn:endEvent id="End_Not" name="Stock not offered" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Select" targetRef="Task_Advice" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Advice" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Prepare" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Split" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Split" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Split" targetRef="Task_Firm" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Split" targetRef="Task_Road" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Register" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Check" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Firm" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Road" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_Join" targetRef="Task_Clear" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Clear" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Fix" targetRef="Task_Commit" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Commit" targetRef="Gw_Reason" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Reason" targetRef="Task_Offer" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Reason" targetRef="End_Not">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reasonNotToOffer</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Offer" targetRef="End_Offered" />
  </bpmn:process>
</bpmn:definitions>
