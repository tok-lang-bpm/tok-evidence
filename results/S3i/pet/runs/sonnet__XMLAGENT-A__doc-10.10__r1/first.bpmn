<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Measurement organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_MPO" name="MPO">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Share</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolvedGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolvedMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Resolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Failure reported or suspected" />
    <bpmn:task id="Task_Examine" name="Examine the failure" />
    <bpmn:exclusiveGateway id="Gw_Confirmed" name="Failure confirmed?" default="F_no" />
    <bpmn:task id="Task_Reject" name="Reject the failure of the fault detector" />
    <bpmn:task id="Task_Confirm" name="Confirm the failure of the fault detector" />
    <bpmn:parallelGateway id="Gw_Split1" />
    <bpmn:task id="Task_InformGO" name="Inform the GO" />
    <bpmn:task id="Task_InformMSP" name="Inform the MSP" />
    <bpmn:parallelGateway id="Gw_Join1" />
    <bpmn:task id="Task_Fix" name="Fix the fault at the measuring device" />
    <bpmn:task id="Task_Share" name="Share the results of the repairs with the fault detector" />
    <bpmn:parallelGateway id="Gw_Split2" />
    <bpmn:task id="Task_ResolvedGO" name="Inform the GO about the resolution of the interference" />
    <bpmn:task id="Task_ResolvedMSP" name="Inform the MSP about the resolution of the interference" />
    <bpmn:parallelGateway id="Gw_Join2" />
    <bpmn:endEvent id="End_Rejected" name="Failure rejected" />
    <bpmn:endEvent id="End_Resolved" name="Interference resolved" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Examine" targetRef="Gw_Confirmed" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Confirmed" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Confirmed" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Confirm" targetRef="Gw_Split1" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Split1" targetRef="Task_InformGO" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Split1" targetRef="Task_InformMSP" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_InformGO" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_InformMSP" targetRef="Gw_Join1" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Join1" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Fix" targetRef="Task_Share" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Share" targetRef="Gw_Split2" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Split2" targetRef="Task_ResolvedGO" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Split2" targetRef="Task_ResolvedMSP" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_ResolvedGO" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_ResolvedMSP" targetRef="Gw_Join2" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_Join2" targetRef="End_Resolved" />
  </bpmn:process>
</bpmn:definitions>
