<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_EC" name="EC">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tell</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_INQ" name="INQ">
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IP" name="IP">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Master data change needed" />
    <bpmn:task id="Task_Tell" name="Tell the INQ about the change of master data" />
    <bpmn:task id="Task_Notify" name="Notify the IP of the change" />
    <bpmn:task id="Task_Check" name="Check whether the master data can be changed at the desired time" />
    <bpmn:exclusiveGateway id="Gw_Split" name="Can the master data be changed?" />
    <bpmn:task id="Task_Confirm" name="Confirm the changes of the INQ" />
    <bpmn:task id="Task_Reject" name="Reject the changes of the INQ" />
    <bpmn:exclusiveGateway id="Gw_Join" />
    <bpmn:endEvent id="End_1" name="Change handled" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Tell" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Tell" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Notify" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Check" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F5" name="yes" sourceRef="Gw_Split" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F6" name="no" sourceRef="Gw_Split" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Confirm" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Reject" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Join" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
