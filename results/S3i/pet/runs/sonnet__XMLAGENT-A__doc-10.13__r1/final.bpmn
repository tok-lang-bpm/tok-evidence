<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Transaction data request" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_INQ" name="INQ">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transmit_Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IP" name="IP">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transmit_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Transaction data needed" />
    <bpmn:task id="Task_Transmit_Request" name="Transmit the transaction data request" />
    <bpmn:task id="Task_Check" name="Check the request of the INQ" />
    <bpmn:exclusiveGateway id="Gw_Outcome" name="Request accepted?" />
    <bpmn:task id="Task_Transmit_Data" name="Transmit the data" />
    <bpmn:task id="Task_Reject" name="Reject the request" />
    <bpmn:endEvent id="End_Data" name="Data transmitted" />
    <bpmn:endEvent id="End_Rejected" name="Request rejected" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Transmit_Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Transmit_Request" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Check" targetRef="Gw_Outcome" />
    <bpmn:sequenceFlow id="F4" name="yes" sourceRef="Gw_Outcome" targetRef="Task_Transmit_Data" />
    <bpmn:sequenceFlow id="F5" name="no" sourceRef="Gw_Outcome" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Transmit_Data" targetRef="End_Data" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Reject" targetRef="End_Rejected" />
  </bpmn:process>
</bpmn:definitions>
