<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Metering organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSPO" name="MSPO">
        <bpmn:flowNodeRef>Task_Send2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_Exam1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exam2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exam3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Task_Exam4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Bill to be sent" />
    <bpmn:exclusiveGateway id="Gw_Split" name="Which bill?" />
    <bpmn:task id="Task_Send1" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="Task_Send2" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="Task_Send3" name="Send the bill for additional readings" />
    <bpmn:task id="Task_Send4" name="Send the bill for the equipment acquisition" />
    <bpmn:task id="Task_Exam1" name="Examine the bill" />
    <bpmn:task id="Task_Exam2" name="Examine the bill" />
    <bpmn:task id="Task_Exam3" name="Examine the bill" />
    <bpmn:task id="Task_Exam4" name="Examine the bill" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:exclusiveGateway id="Gw_Ok" name="Invoice confirmed?" default="F_no" />
    <bpmn:task id="Task_Confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="Task_Reject" name="Reject the invoice" />
    <bpmn:endEvent id="End_Confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="End_Rejected" name="Invoice rejected" />
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F1" name="continuation of operations" sourceRef="Gw_Split" targetRef="Task_Send1" />
    <bpmn:sequenceFlow id="F2" name="continuation of measurement" sourceRef="Gw_Split" targetRef="Task_Send2" />
    <bpmn:sequenceFlow id="F3" name="additional readings" sourceRef="Gw_Split" targetRef="Task_Send3" />
    <bpmn:sequenceFlow id="F4" name="equipment acquisition" sourceRef="Gw_Split" targetRef="Task_Send4" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Send1" targetRef="Task_Exam1" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Send2" targetRef="Task_Exam2" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Send3" targetRef="Task_Exam3" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Send4" targetRef="Task_Exam4" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Exam1" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Exam2" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Exam3" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Exam4" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_Merge" targetRef="Gw_Ok" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Ok" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Ok" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Confirm" targetRef="End_Confirmed" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Reject" targetRef="End_Rejected" />
  </bpmn:process>
</bpmn:definitions>