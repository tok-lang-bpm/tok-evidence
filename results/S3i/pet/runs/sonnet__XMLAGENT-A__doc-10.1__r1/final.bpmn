<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Oppose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Dismissal prepared" />
    <bpmn:task id="Task_Send" name="Send the dismissal to the MPOO" />
    <bpmn:task id="Task_Review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="Gw_Decision" name="Dismissal opposed?" default="F_no" />
    <bpmn:task id="Task_Oppose" name="Oppose the dismissal of the MPON" />
    <bpmn:task id="Task_Confirm" name="Confirm the dismissal of the MPON" />
    <bpmn:endEvent id="End_Opposed" name="Dismissal opposed" />
    <bpmn:endEvent id="End_Confirmed" name="Dismissal confirmed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Send" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Review" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Decision" targetRef="Task_Oppose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">opposed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Decision" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Oppose" targetRef="End_Opposed" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Confirm" targetRef="End_Confirmed" />
  </bpmn:process>
</bpmn:definitions>
