<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Meter point registration" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_eqN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_informFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_informSucc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_confirmFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infOOFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infMSFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_confirmAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infOOAss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infMSAss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_infSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_assigned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_eqO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Meter operation to be reported" />
    <bpmn:task id="Task_report" name="Report the meter operation to the GO" />
    <bpmn:task id="Task_examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="Gw_confirmed" name="Application confirmed?" default="F_no" />
    <bpmn:task id="Task_reject" name="Reject the application of the MPON" />
    <bpmn:endEvent id="End_rejected" name="Application rejected" />
    <bpmn:task id="Task_confirm" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="P1" />
    <bpmn:task id="Task_infOO" name="Inform the MPOO about the registration confirmation of the MPON" />
    <bpmn:task id="Task_infMS" name="Inform the MSPO about the registration confirmation of the MPON" />
    <bpmn:parallelGateway id="P2" />
    <bpmn:parallelGateway id="P3" />
    <bpmn:task id="Task_eqN" name="Perform the equipment acquisition and / or equipment changes (MPON)" />
    <bpmn:task id="Task_eqO" name="Perform the equipment acquisition and / or equipment changes (MPOO)" />
    <bpmn:parallelGateway id="P4" />
    <bpmn:exclusiveGateway id="Gw_outcome" name="Outcome of the entire process?" default="F_deadline" />
    <bpmn:task id="Task_informFail" name="Inform the GO about the failure of the entire process" />
    <bpmn:task id="Task_informSucc" name="Inform the GO about the successful completion of the entire process" />
    <bpmn:task id="Task_deadline" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="End_deadline" name="Transaction failed by deadline" />
    <bpmn:task id="Task_confirmFail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:parallelGateway id="P5" />
    <bpmn:task id="Task_infOOFail" name="Inform the MPOO about the failure of the assignment of the MPON" />
    <bpmn:task id="Task_infMSFail" name="Inform the MSPO about the failure of the assignment of the MPON" />
    <bpmn:parallelGateway id="P6" />
    <bpmn:endEvent id="End_failed" name="Assignment failed" />
    <bpmn:task id="Task_assign" name="Assign the MPON" />
    <bpmn:task id="Task_confirmAssign" name="Confirm the assignment to the MPON" />
    <bpmn:parallelGateway id="P7" />
    <bpmn:task id="Task_infOOAss" name="Inform the MPOO about the assignment of the MPON" />
    <bpmn:task id="Task_infMSAss" name="Inform the MSPO about the assignment of the MPON" />
    <bpmn:task id="Task_infSP" name="Inform the SP about the assignment of the MPON" />
    <bpmn:parallelGateway id="P8" />
    <bpmn:endEvent id="End_assigned" name="MPON assigned" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_report" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_report" targetRef="Task_examine" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_examine" targetRef="Gw_confirmed" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_confirmed" targetRef="Task_confirm" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_confirmed" targetRef="Task_reject" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_reject" targetRef="End_rejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_confirm" targetRef="P1" />
    <bpmn:sequenceFlow id="F8" sourceRef="P1" targetRef="Task_infOO" />
    <bpmn:sequenceFlow id="F9" sourceRef="P1" targetRef="Task_infMS" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_infOO" targetRef="P2" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_infMS" targetRef="P2" />
    <bpmn:sequenceFlow id="F12" sourceRef="P2" targetRef="P3" />
    <bpmn:sequenceFlow id="F13" sourceRef="P3" targetRef="Task_eqN" />
    <bpmn:sequenceFlow id="F14" sourceRef="P3" targetRef="Task_eqO" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_eqN" targetRef="P4" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_eqO" targetRef="P4" />
    <bpmn:sequenceFlow id="F17" sourceRef="P4" targetRef="Gw_outcome" />
    <bpmn:sequenceFlow id="F18" name="failure" sourceRef="Gw_outcome" targetRef="Task_informFail" />
    <bpmn:sequenceFlow id="F19" name="success" sourceRef="Gw_outcome" targetRef="Task_informSucc" />
    <bpmn:sequenceFlow id="F_deadline" name="no message by the time limit" sourceRef="Gw_outcome" targetRef="Task_deadline" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_deadline" targetRef="End_deadline" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_informFail" targetRef="Task_confirmFail" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_confirmFail" targetRef="P5" />
    <bpmn:sequenceFlow id="F24" sourceRef="P5" targetRef="Task_infOOFail" />
    <bpmn:sequenceFlow id="F25" sourceRef="P5" targetRef="Task_infMSFail" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_infOOFail" targetRef="P6" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_infMSFail" targetRef="P6" />
    <bpmn:sequenceFlow id="F28" sourceRef="P6" targetRef="End_failed" />
    <bpmn:sequenceFlow id="F29" sourceRef="Task_informSucc" targetRef="Task_assign" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_assign" targetRef="Task_confirmAssign" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_confirmAssign" targetRef="P7" />
    <bpmn:sequenceFlow id="F32" sourceRef="P7" targetRef="Task_infOOAss" />
    <bpmn:sequenceFlow id="F33" sourceRef="P7" targetRef="Task_infMSAss" />
    <bpmn:sequenceFlow id="F34" sourceRef="P7" targetRef="Task_infSP" />
    <bpmn:sequenceFlow id="F35" sourceRef="Task_infOOAss" targetRef="P8" />
    <bpmn:sequenceFlow id="F36" sourceRef="Task_infMSAss" targetRef="P8" />
    <bpmn:sequenceFlow id="F37" sourceRef="Task_infSP" targetRef="P8" />
    <bpmn:sequenceFlow id="F38" sourceRef="P8" targetRef="End_assigned" />
  </bpmn:process>
</bpmn:definitions>
