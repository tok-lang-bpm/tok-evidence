<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Deregistration of the MPOO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrelConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Equipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Deregistration needed" />
    <bpmn:task id="Task_Dereg" name="Deregister at the GO" />
    <bpmn:task id="Task_Verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="Gw_Verify" name="Deregistration confirmed?" default="F_no" />
    <bpmn:task id="Task_Reject" name="Reject the deregistration of the MPOO" />
    <bpmn:endEvent id="End_Rejected" name="Deregistration rejected" />
    <bpmn:task id="Task_PrelConfirm" name="Preliminarily confirm the deregistration of the MPOO" />
    <bpmn:task id="Task_Prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="Gw_Oblige" name="Oblige the MPOO to continue?" default="F_obl_no" />
    <bpmn:task id="Task_Oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:task id="Task_Confirm" name="Confirm the continuation" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Equipment" name="Perform the equipment acquisition and / or equipment changes" />
    <bpmn:task id="Task_Assign" name="Assign the GO as MPO" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_InformMPOO" name="Inform the MPOO about the end of the assignment of the MPOO and the beginning of the assignment of the GO" />
    <bpmn:task id="Task_InformMSPO" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="Task_InformSP" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:endEvent id="End_Done" name="Assignment completed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Dereg" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Dereg" targetRef="Task_Verify" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Verify" targetRef="Gw_Verify" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Verify" targetRef="Task_PrelConfirm" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Verify" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_PrelConfirm" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Prepare" targetRef="Gw_Oblige" />
    <bpmn:sequenceFlow id="F_obl_yes" name="yes" sourceRef="Gw_Oblige" targetRef="Task_Oblige" />
    <bpmn:sequenceFlow id="F_obl_no" name="no" sourceRef="Gw_Oblige" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Oblige" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Confirm" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gw_Merge" targetRef="Task_Equipment" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Equipment" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Assign" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Split" targetRef="Task_InformMPOO" />
    <bpmn:sequenceFlow id="F17" sourceRef="Gw_Split" targetRef="Task_InformMSPO" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_Split" targetRef="Task_InformSP" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_InformMPOO" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_InformMSPO" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_InformSP" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F22" sourceRef="Gw_Join" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>