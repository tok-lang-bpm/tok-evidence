<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Meter change" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Equipment change intended" />
    <bpmn:task id="Task_1" name="Notify the MPOO about equipment change intentions" />
    <bpmn:exclusiveGateway id="Gw_split" name="Self dismounting by the MPOO?" />
    <bpmn:task id="Task_2" name="Announce self dismounting to the MPON" />
    <bpmn:task id="Task_3" name="Notify the MPON about no self-dismounting" />
    <bpmn:exclusiveGateway id="Gw_join" />
    <bpmn:task id="Task_5" name="Perform the final reading" />
    <bpmn:task id="Task_6" name="Dismount the old equipment" />
    <bpmn:task id="Task_7" name="Mount the new device" />
    <bpmn:task id="Task_8" name="Read the meter count from the installed meter" />
    <bpmn:task id="Task_9" name="Send the values of the final reading to the GO" />
    <bpmn:task id="Task_10" name="Tell the GO about the device changes, the master data and the meter count at installation" />
    <bpmn:task id="Task_11" name="Notify the MSP about the device changes, the master data, the meter count at dismounting and the meter count at installation" />
    <bpmn:endEvent id="End_1" name="MSP notified" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_1" targetRef="Gw_split" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_split" targetRef="Task_2" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_split" targetRef="Task_3" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_2" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_3" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_join" targetRef="Task_5" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_10" targetRef="Task_11" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_11" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
