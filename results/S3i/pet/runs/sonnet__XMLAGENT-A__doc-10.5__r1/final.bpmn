<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_1" name="Device takeover" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_Tender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Takeover bid needed" />
    <bpmn:task id="Task_Request" name="Request device takeover bid" />
    <bpmn:task id="Task_Tender" name="Send tender for equipment takeover" />
    <bpmn:task id="Task_Order" name="Place order" />
    <bpmn:task id="Task_Confirm" name="Confirm order" />
    <bpmn:task id="Task_Master" name="Send master data" />
    <bpmn:endEvent id="End_1" name="Order confirmed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Request" targetRef="Task_Tender" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Tender" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Order" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Confirm" targetRef="Task_Master" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Master" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
