<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool" name="Dismissal handling" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_MSPN" name="MSPN">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSPO" name="MSPO">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Dismissal to be sent" />
    <bpmn:task id="Task_Send" name="Send the dismissal to the MSPO" />
    <bpmn:task id="Task_Review" name="Review the dismissal" />
    <bpmn:exclusiveGateway id="Gw_Split" name="Dismissal rejected?" default="F_Confirm" />
    <bpmn:task id="Task_Reject" name="Reject the dismissal of the MSPN" />
    <bpmn:task id="Task_Confirm" name="Confirm the dismissal of the MSPN" />
    <bpmn:exclusiveGateway id="Gw_Join" />
    <bpmn:endEvent id="End" name="Dismissal decided" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Send" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Review" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F_Reject" name="yes" sourceRef="Gw_Split" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F_Confirm" name="no" sourceRef="Gw_Split" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Reject" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Confirm" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Join" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>