<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_MSPN" name="MSPN">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Measurement available" />
    <bpmn:task id="Task_Register" name="Register the measurement at the GO" />
    <bpmn:task id="Task_Examine" name="Examine the application of the MSPN" />
    <bpmn:exclusiveGateway id="Gw_Decision" name="Application confirmed?" default="F_no" />
    <bpmn:task id="Task_Reject" name="Reject the application of the MSPN" />
    <bpmn:task id="Task_Confirm" name="Confirm the application of the MSPN" />
    <bpmn:task id="Task_Assign" name="Assign the MSPN" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_InformMSPO" name="Inform the MSPO about the assignment of MSPN" />
    <bpmn:task id="Task_InformMPO" name="Inform the MPO about the assignment of the MSPN" />
    <bpmn:task id="Task_InformSP" name="Inform the SP about the assignment of MSPN" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:endEvent id="End_Rejected" name="Application rejected" />
    <bpmn:endEvent id="End_Done" name="MSPN assigned" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Register" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Examine" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Decision" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Decision" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Confirm" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Assign" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Split" targetRef="Task_InformMSPO" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Split" targetRef="Task_InformMPO" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Split" targetRef="Task_InformSP" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_InformMSPO" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_InformMPO" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_InformSP" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Join" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>