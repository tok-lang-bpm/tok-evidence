<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Measuring point change" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_SP" name="SP / PU / GO">
        <bpmn:flowNodeRef>Start_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPO" name="MPO">
        <bpmn:flowNodeRef>Start_MPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_SP" name="Change requested" />
    <bpmn:task id="Task_Request" name="Request changes" />
    <bpmn:startEvent id="Start_MPO" name="Change caused by MPO" />
    <bpmn:task id="Task_Cause" name="Cause a change" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Review" name="Review the change request" />
    <bpmn:exclusiveGateway id="Gw_Confirm" name="Request confirmed?" default="F_no" />
    <bpmn:task id="Task_Reject" name="Reject the change of the measuring point" />
    <bpmn:task id="Task_Confirm" name="Confirm the request" />
    <bpmn:task id="Task_Perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="Gw_Success" name="Change implemented?" default="F_fail" />
    <bpmn:task id="Task_Report" name="Report the implementation" />
    <bpmn:task id="Task_Notify" name="Notify about the failure of the changes" />
    <bpmn:exclusiveGateway id="Gw_End" />
    <bpmn:endEvent id="End_Done" name="Change finished" />
    <bpmn:endEvent id="End_Rejected" name="Change rejected" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_SP" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Request" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F3" sourceRef="Start_MPO" targetRef="Task_Cause" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Cause" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Merge" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Review" targetRef="Gw_Confirm" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Confirm" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Confirm" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Confirm" targetRef="Task_Perform" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Perform" targetRef="Gw_Success" />
    <bpmn:sequenceFlow id="F_ok" name="yes" sourceRef="Gw_Success" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="F_fail" name="no" sourceRef="Gw_Success" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Report" targetRef="Gw_End" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Notify" targetRef="Gw_End" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_End" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>