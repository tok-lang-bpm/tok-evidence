<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_req" name="Restoration request" />
  <bpmn:message id="Msg_trouble" name="Trouble-shooting report" />
  <bpmn:message id="Msg_report" name="Report on service performance and problem resolution" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="TELECO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_cust" name="Customer">
        <bpmn:flowNodeRef>Start_cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_cust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cs" name="Customer Service">
        <bpmn:flowNodeRef>T_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_premium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_sig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_detailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendDetailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_csMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_csSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_createCust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendCust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_csJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_cs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_el" name="Electronic Service">
        <bpmn:flowNodeRef>T_significance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sm" name="Service Management">
        <bpmn:flowNodeRef>T_investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_analyz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_troubleSM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_smMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendPerf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_resMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reqCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_trouble</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rp" name="Resource Provisioning">
        <bpmn:flowNodeRef>T_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_problem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_analyzeRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_troubleRP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_rpMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_evt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_term</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_shoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_shoot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bc" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>T_adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_cust" name="Service degradation perceived" />
    <bpmn:task id="T_sendList" name="Send list of problem parameters to Customer Service" />
    <bpmn:parallelGateway id="Gw_c1" />
    <bpmn:intermediateCatchEvent id="Catch_report" name="Report received">
      <bpmn:messageEventDefinition messageRef="Msg_report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_cust" name="Customer process ended" />
    <bpmn:task id="T_enter" name="Enter problem report into system T" />
    <bpmn:task id="T_compare" name="Compare problem report to customer SLA" />
    <bpmn:task id="T_measures" name="Determine counter measures and priorities" />
    <bpmn:task id="T_significance" name="Determine significance of customer" />
    <bpmn:exclusiveGateway id="Gw_premium" name="Customer premium?" default="F_notPremium" />
    <bpmn:callActivity id="Call_fix" name="Link to extra problem fix process" calledElement="ExtraFix" />
    <bpmn:endEvent id="End_premium" name="Extra problem fix started" />
    <bpmn:exclusiveGateway id="Gw_sig" name="Significance affects counter measures?" default="F_sigNo" />
    <bpmn:task id="T_detailed" name="Create detailed problem report" />
    <bpmn:task id="T_sendDetailed" name="Send detailed problem report to Service Management" />
    <bpmn:task id="T_investigate" name="Investigate whether problem is analyzable" />
    <bpmn:exclusiveGateway id="Gw_analyz" name="Analyzable by Service Management?" default="F_analyzNo" />
    <bpmn:task id="T_sendRP" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="T_analyze" name="Perform analysis" />
    <bpmn:task id="T_troubleSM" name="Create trouble report" />
    <bpmn:task id="T_check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="Gw_problem" name="Problem detected?" default="F_probNo" />
    <bpmn:task id="T_analyzeRP" name="Analyze problem" />
    <bpmn:task id="T_troubleRP" name="Create trouble report" />
    <bpmn:task id="T_normal" name="Create notification about normal service execution" />
    <bpmn:exclusiveGateway id="Gw_rpMerge" />
    <bpmn:task id="T_status" name="Include report in status report" />
    <bpmn:task id="T_sendStatus" name="Send status report to Service Management" />
    <bpmn:parallelGateway id="Gw_par" />
    <bpmn:exclusiveGateway id="Gw_smMerge" />
    <bpmn:task id="T_final" name="Prepare final status report" />
    <bpmn:task id="T_decide" name="Determine counter measures" />
    <bpmn:exclusiveGateway id="Gw_alt" name="Which counter measures are required?" default="F_altNone" />
    <bpmn:task id="T_sendPerf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="T_minor" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="Gw_resMerge" />
    <bpmn:task id="T_resReport" name="Create problem resolution report" />
    <bpmn:task id="T_sendRes" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="T_reqCreate" name="Create request for automatic resource restoration" />
    <bpmn:intermediateThrowEvent id="Throw_req" name="Restoration request sent">
      <bpmn:messageEventDefinition messageRef="Msg_req" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_trouble" name="Trouble-shooting report received">
      <bpmn:messageEventDefinition messageRef="Msg_trouble" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gw_evt" />
    <bpmn:intermediateCatchEvent id="Catch_req" name="Restoration request received">
      <bpmn:messageEventDefinition messageRef="Msg_req" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_timer" name="2 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_terminate" name="Terminate the process" />
    <bpmn:endEvent id="End_term" name="Process terminated" />
    <bpmn:task id="T_track" name="Track all possible errors" />
    <bpmn:task id="T_correct" name="Undertake necessary corrective actions" />
    <bpmn:task id="T_shoot" name="Create trouble-shooting report" />
    <bpmn:intermediateThrowEvent id="Throw_shoot" name="Trouble-shooting report sent">
      <bpmn:messageEventDefinition messageRef="Msg_trouble" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_rp" name="Resource Provisioning process ended" />
    <bpmn:exclusiveGateway id="Gw_csMerge" />
    <bpmn:parallelGateway id="Gw_csSplit" />
    <bpmn:task id="T_createCust" name="Create report for the customer" />
    <bpmn:sendTask id="T_sendCust" name="Send report to the customer" messageRef="Msg_report" />
    <bpmn:task id="T_rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:task id="T_adjust" name="Adjust billing" />
    <bpmn:parallelGateway id="Gw_csJoin" />
    <bpmn:endEvent id="End_cs" name="Customer Service process ended" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start_cust" targetRef="T_sendList" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_sendList" targetRef="Gw_c1" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_c1" targetRef="T_enter" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_c1" targetRef="Catch_report" />
    <bpmn:sequenceFlow id="F5" sourceRef="Catch_report" targetRef="End_cust" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_enter" targetRef="T_compare" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_compare" targetRef="T_measures" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_measures" targetRef="T_significance" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_significance" targetRef="Gw_premium" />
    <bpmn:sequenceFlow id="F_premium" name="yes" sourceRef="Gw_premium" targetRef="Call_fix" />
    <bpmn:sequenceFlow id="F_notPremium" name="no" sourceRef="Gw_premium" targetRef="Gw_sig" />
    <bpmn:sequenceFlow id="F10" sourceRef="Call_fix" targetRef="End_premium" />
    <bpmn:sequenceFlow id="F_sigYes" name="yes" sourceRef="Gw_sig" targetRef="T_measures" />
    <bpmn:sequenceFlow id="F_sigNo" name="no" sourceRef="Gw_sig" targetRef="T_detailed" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_detailed" targetRef="T_sendDetailed" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_sendDetailed" targetRef="T_investigate" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_investigate" targetRef="Gw_analyz" />
    <bpmn:sequenceFlow id="F_analyzNo" name="no" sourceRef="Gw_analyz" targetRef="T_sendRP" />
    <bpmn:sequenceFlow id="F_analyzYes" name="yes" sourceRef="Gw_analyz" targetRef="T_analyze" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_analyze" targetRef="T_troubleSM" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_troubleSM" targetRef="Gw_smMerge" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_sendRP" targetRef="T_check" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_check" targetRef="Gw_problem" />
    <bpmn:sequenceFlow id="F_probYes" name="yes" sourceRef="Gw_problem" targetRef="T_analyzeRP" />
    <bpmn:sequenceFlow id="F_probNo" name="no" sourceRef="Gw_problem" targetRef="T_normal" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_analyzeRP" targetRef="T_troubleRP" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_troubleRP" targetRef="Gw_rpMerge" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_normal" targetRef="Gw_rpMerge" />
    <bpmn:sequenceFlow id="F21" sourceRef="Gw_rpMerge" targetRef="T_status" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_status" targetRef="T_sendStatus" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_sendStatus" targetRef="Gw_par" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_par" targetRef="Gw_smMerge" />
    <bpmn:sequenceFlow id="F25" sourceRef="Gw_par" targetRef="Gw_evt" />
    <bpmn:sequenceFlow id="F26" sourceRef="Gw_evt" targetRef="Catch_req" />
    <bpmn:sequenceFlow id="F27" sourceRef="Gw_evt" targetRef="Catch_timer" />
    <bpmn:sequenceFlow id="F28" sourceRef="Catch_timer" targetRef="T_terminate" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_terminate" targetRef="End_term" />
    <bpmn:sequenceFlow id="F30" sourceRef="Catch_req" targetRef="T_track" />
    <bpmn:sequenceFlow id="F31" sourceRef="T_track" targetRef="T_correct" />
    <bpmn:sequenceFlow id="F32" sourceRef="T_correct" targetRef="T_shoot" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_shoot" targetRef="Throw_shoot" />
    <bpmn:sequenceFlow id="F34" sourceRef="Throw_shoot" targetRef="End_rp" />
    <bpmn:sequenceFlow id="F35" sourceRef="Gw_smMerge" targetRef="T_final" />
    <bpmn:sequenceFlow id="F36" sourceRef="T_final" targetRef="T_decide" />
    <bpmn:sequenceFlow id="F37" sourceRef="T_decide" targetRef="Gw_alt" />
    <bpmn:sequenceFlow id="F_altNone" name="no problem" sourceRef="Gw_alt" targetRef="T_sendPerf" />
    <bpmn:sequenceFlow id="F_altMinor" name="minor corrective actions" sourceRef="Gw_alt" targetRef="T_minor" />
    <bpmn:sequenceFlow id="F_altAuto" name="automatic restoration" sourceRef="Gw_alt" targetRef="T_reqCreate" />
    <bpmn:sequenceFlow id="F38" sourceRef="T_sendPerf" targetRef="Gw_csMerge" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_minor" targetRef="Gw_resMerge" />
    <bpmn:sequenceFlow id="F40" sourceRef="T_reqCreate" targetRef="Throw_req" />
    <bpmn:sequenceFlow id="F41" sourceRef="Throw_req" targetRef="Catch_trouble" />
    <bpmn:sequenceFlow id="F42" sourceRef="Catch_trouble" targetRef="Gw_resMerge" />
    <bpmn:sequenceFlow id="F43" sourceRef="Gw_resMerge" targetRef="T_resReport" />
    <bpmn:sequenceFlow id="F44" sourceRef="T_resReport" targetRef="T_sendRes" />
    <bpmn:sequenceFlow id="F45" sourceRef="T_sendRes" targetRef="Gw_csMerge" />
    <bpmn:sequenceFlow id="F46" sourceRef="Gw_csMerge" targetRef="Gw_csSplit" />
    <bpmn:sequenceFlow id="F47" sourceRef="Gw_csSplit" targetRef="T_createCust" />
    <bpmn:sequenceFlow id="F48" sourceRef="Gw_csSplit" targetRef="T_rebate" />
    <bpmn:sequenceFlow id="F49" sourceRef="T_createCust" targetRef="T_sendCust" />
    <bpmn:sequenceFlow id="F50" sourceRef="T_rebate" targetRef="T_adjust" />
    <bpmn:sequenceFlow id="F51" sourceRef="T_sendCust" targetRef="Gw_csJoin" />
    <bpmn:sequenceFlow id="F52" sourceRef="T_adjust" targetRef="Gw_csJoin" />
    <bpmn:sequenceFlow id="F53" sourceRef="Gw_csJoin" targetRef="End_cs" />
  </bpmn:process>
</bpmn:definitions>
