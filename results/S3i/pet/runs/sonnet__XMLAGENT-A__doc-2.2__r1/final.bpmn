<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_confirm" name="Contract confirmed" />
  <bpmn:message id="Msg_withdraw" name="Contract withdrawn" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Power supplier switch-over" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_cs" name="Customer service">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwM1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwM4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_cis" name="CIS">
        <bpmn:flowNodeRef>GwM3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_grid" name="Grid operator">
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_old" name="Old supplier">
        <bpmn:flowNodeRef>T24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T25</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Switch-over request initiated" />
    <bpmn:task id="T1" name="Transmit customer data" />
    <bpmn:task id="T2" name="Receive customer data" />
    <bpmn:task id="T3" name="Enter customer data object into CRM system" />
    <bpmn:exclusiveGateway id="GwM1" />
    <bpmn:task id="T4" name="Compare customer data with internal customer data base" />
    <bpmn:task id="T5" name="Check customer data for completeness and plausibility" />
    <bpmn:exclusiveGateway id="Gw1" name="Errors found?" default="F_gw1_no" />
    <bpmn:task id="T6" name="Correct errors using error list" />
    <bpmn:exclusiveGateway id="Gw2" name="Customer exists in data base?" default="F_gw2_no" />
    <bpmn:task id="T7" name="Create new customer object" />
    <bpmn:exclusiveGateway id="GwM2" />
    <bpmn:task id="T8" name="Prepare contract documents" />
    <bpmn:exclusiveGateway id="GwM3" />
    <bpmn:task id="T9" name="Check contract documents automatically" />
    <bpmn:exclusiveGateway id="Gw3" name="Contract documents generated successfully?" default="F_gw3_no" />
    <bpmn:task id="T10" name="Analyze and resolve issues" />
    <bpmn:task id="T11" name="Generate contract documents again" />
    <bpmn:task id="T12" name="Send confirmation document to customer" />
    <bpmn:task id="T13" name="Send request to grid operator" />
    <bpmn:task id="T14" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="T15" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="Gw4" name="Supplier concurrence?" default="F_gw4_no" />
    <bpmn:task id="T16" name="Inform involved suppliers and demand resolution of conflict" />
    <bpmn:endEvent id="End2" name="Switch-over stopped by supplier concurrence" />
    <bpmn:task id="T17" name="Terminate sales agreement with old supplier" />
    <bpmn:task id="T18" name="Create CIS contract" />
    <bpmn:task id="T19" name="Check contract details" />
    <bpmn:eventBasedGateway id="EG" />
    <bpmn:intermediateCatchEvent id="Catch_timer" name="7 days passed">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_confirm" name="Customer confirms contract">
      <bpmn:messageEventDefinition messageRef="Msg_confirm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_withdraw" name="Customer withdraws from contract">
      <bpmn:messageEventDefinition messageRef="Msg_withdraw" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End3" name="Customer withdrew" />
    <bpmn:exclusiveGateway id="GwM4" />
    <bpmn:parallelGateway id="P1" />
    <bpmn:task id="T20" name="Transmit power meter data" />
    <bpmn:task id="T21" name="Import meter data to systems" />
    <bpmn:task id="T22" name="Compute final billing" />
    <bpmn:task id="T23" name="Send final billing to old supplier" />
    <bpmn:task id="T24" name="Create final billing" />
    <bpmn:task id="T25" name="Send final billing to customer" />
    <bpmn:parallelGateway id="P2" />
    <bpmn:endEvent id="End" name="New customer won" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="GwM1" />
    <bpmn:sequenceFlow id="F5" sourceRef="GwM1" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="Gw1" />
    <bpmn:sequenceFlow id="F_gw1_yes" name="yes" sourceRef="Gw1" targetRef="T6" />
    <bpmn:sequenceFlow id="F_gw1_no" name="no" sourceRef="Gw1" targetRef="Gw2" />
    <bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="GwM1" />
    <bpmn:sequenceFlow id="F_gw2_yes" name="yes" sourceRef="Gw2" targetRef="GwM2" />
    <bpmn:sequenceFlow id="F_gw2_no" name="no" sourceRef="Gw2" targetRef="T7" />
    <bpmn:sequenceFlow id="F9" sourceRef="T7" targetRef="GwM2" />
    <bpmn:sequenceFlow id="F10" sourceRef="GwM2" targetRef="T8" />
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="GwM3" />
    <bpmn:sequenceFlow id="F12" sourceRef="GwM3" targetRef="T9" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="Gw3" />
    <bpmn:sequenceFlow id="F_gw3_yes" name="yes" sourceRef="Gw3" targetRef="T12" />
    <bpmn:sequenceFlow id="F_gw3_no" name="no" sourceRef="Gw3" targetRef="T10" />
    <bpmn:sequenceFlow id="F14" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F15" sourceRef="T11" targetRef="GwM3" />
    <bpmn:sequenceFlow id="F16" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="F17" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F18" sourceRef="T14" targetRef="T15" />
    <bpmn:sequenceFlow id="F19" sourceRef="T15" targetRef="Gw4" />
    <bpmn:sequenceFlow id="F_gw4_yes" name="yes" sourceRef="Gw4" targetRef="T16" />
    <bpmn:sequenceFlow id="F_gw4_no" name="no" sourceRef="Gw4" targetRef="T17" />
    <bpmn:sequenceFlow id="F20" sourceRef="T16" targetRef="End2" />
    <bpmn:sequenceFlow id="F21" sourceRef="T17" targetRef="T18" />
    <bpmn:sequenceFlow id="F22" sourceRef="T18" targetRef="T19" />
    <bpmn:sequenceFlow id="F23" sourceRef="T19" targetRef="EG" />
    <bpmn:sequenceFlow id="F24" sourceRef="EG" targetRef="Catch_timer" />
    <bpmn:sequenceFlow id="F25" sourceRef="EG" targetRef="Catch_confirm" />
    <bpmn:sequenceFlow id="F26" sourceRef="EG" targetRef="Catch_withdraw" />
    <bpmn:sequenceFlow id="F27" sourceRef="Catch_withdraw" targetRef="End3" />
    <bpmn:sequenceFlow id="F28" sourceRef="Catch_timer" targetRef="GwM4" />
    <bpmn:sequenceFlow id="F29" sourceRef="Catch_confirm" targetRef="GwM4" />
    <bpmn:sequenceFlow id="F30" sourceRef="GwM4" targetRef="P1" />
    <bpmn:sequenceFlow id="F31" sourceRef="P1" targetRef="T20" />
    <bpmn:sequenceFlow id="F32" sourceRef="P1" targetRef="T22" />
    <bpmn:sequenceFlow id="F33" sourceRef="T20" targetRef="T21" />
    <bpmn:sequenceFlow id="F34" sourceRef="T22" targetRef="T23" />
    <bpmn:sequenceFlow id="F35" sourceRef="T23" targetRef="T24" />
    <bpmn:sequenceFlow id="F36" sourceRef="T24" targetRef="T25" />
    <bpmn:sequenceFlow id="F37" sourceRef="T21" targetRef="P2" />
    <bpmn:sequenceFlow id="F38" sourceRef="T25" targetRef="P2" />
    <bpmn:sequenceFlow id="F39" sourceRef="P2" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
