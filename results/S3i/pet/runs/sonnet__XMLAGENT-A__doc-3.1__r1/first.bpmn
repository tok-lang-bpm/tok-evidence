<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_Report" name="Police report" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Small Claims Registry Operations" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Party" name="Party">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BO" name="Client Service Back Office">
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Retrieve1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Forward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Store1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Retrieve2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Store2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Warrant release needed" />
    <bpmn:task id="Task_Send" name="Send warrant possession request" />
    <bpmn:task id="Task_Receive" name="Receive the request" />
    <bpmn:task id="Task_Retrieve1" name="Retrieve the SCT file" />
    <bpmn:task id="Task_Forward" name="Forward the SCT Warrant Possession to Queensland Police" />
    <bpmn:task id="Task_Store1" name="Store the SCT physical file" />
    <bpmn:intermediateCatchEvent id="Catch_Report" name="Report received">
      <bpmn:messageEventDefinition messageRef="Msg_Report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Retrieve2" name="Retrieve the SCT file" />
    <bpmn:task id="Task_Attach" name="Attach the new SCT document" />
    <bpmn:task id="Task_Store2" name="Store the expanded SCT physical file" />
    <bpmn:endEvent id="End_1" name="File passed to MC internal staff" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Send" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Receive" targetRef="Task_Retrieve1" />
    <bpmn:sequenceFlow id="f4" sourceRef="Task_Retrieve1" targetRef="Task_Forward" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_Forward" targetRef="Task_Store1" />
    <bpmn:sequenceFlow id="f6" sourceRef="Task_Store1" targetRef="Catch_Report" />
    <bpmn:sequenceFlow id="f7" sourceRef="Catch_Report" targetRef="Task_Retrieve2" />
    <bpmn:sequenceFlow id="f8" sourceRef="Task_Retrieve2" targetRef="Task_Attach" />
    <bpmn:sequenceFlow id="f9" sourceRef="Task_Attach" targetRef="Task_Store2" />
    <bpmn:sequenceFlow id="f10" sourceRef="Task_Store2" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
