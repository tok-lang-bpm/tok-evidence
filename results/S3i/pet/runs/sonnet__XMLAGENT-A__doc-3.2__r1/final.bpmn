<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Court" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Staff" name="Court staff">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Distribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Hearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Morning of court hearing" />
    <bpmn:task id="Task_Check" name="Check the files" />
    <bpmn:exclusiveGateway id="Gw_Missing" name="Some files missing?" />
    <bpmn:task id="Task_Search" name="Initiate a search" />
    <bpmn:task id="Task_Track" name="Track the files to the intended location" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Hand" name="Hand the files to the Associate" />
    <bpmn:task id="Task_Distribute" name="Distribute the Judge's Lawlist to the relevant people" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:task id="Task_Hearings" name="Conduct the directions hearings" />
    <bpmn:endEvent id="End_1" name="Hearings conducted" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Check" targetRef="Gw_Missing" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Missing" targetRef="Task_Search" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Missing" targetRef="Task_Track" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Search" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Track" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Merge" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Split" targetRef="Task_Hand" />
    <bpmn:sequenceFlow id="F9" sourceRef="Gw_Split" targetRef="Task_Distribute" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Hand" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Distribute" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Join" targetRef="Task_Hearings" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Hearings" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
