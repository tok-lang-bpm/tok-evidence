<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Claims handling" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Officer" name="Claims officer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Senior" name="Senior claims officer">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Claim registered" />
    <bpmn:task id="Task_Examine" name="Examine the claim" />
    <bpmn:task id="Task_Write" name="Write a settlement recommendation" />
    <bpmn:task id="Task_Check" name="Check the recommendation" />
    <bpmn:exclusiveGateway id="Gw_OK" name="Claim OK?" />
    <bpmn:endEvent id="End_1" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Examine" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Examine" targetRef="Task_Write" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Write" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Check" targetRef="Gw_OK" />
    <bpmn:sequenceFlow id="F_OK" name="OK" sourceRef="Gw_OK" targetRef="End_1" />
    <bpmn:sequenceFlow id="F_NotOK" name="Not OK" sourceRef="Gw_OK" targetRef="Task_Write" />
  </bpmn:process>
</bpmn:definitions>
