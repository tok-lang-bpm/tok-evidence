<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Court" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Clerk" name="Mail Clerk">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortUnopened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Distribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registry" name="Registry">
        <bpmn:flowNodeRef>Task_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortGroups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ARM" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>Task_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Compliant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Matter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Envelope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cashier" name="Cashier">
        <bpmn:flowNodeRef>Task_Fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Party</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Print</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Daily mail collection" />
    <bpmn:task id="Task_Collect" name="Collect mail from the party" />
    <bpmn:task id="Task_SortUnopened" name="Sort the unopened mail into business areas" />
    <bpmn:task id="Task_Distribute" name="Distribute the mail" />
    <bpmn:task id="Task_Open" name="Open the mail" />
    <bpmn:task id="Task_SortGroups" name="Sort the mail into groups for distribution" />
    <bpmn:task id="Task_Register" name="Register the mail in the manual incoming Mail Register" />
    <bpmn:task id="Task_Quality" name="Perform quality check" />
    <bpmn:exclusiveGateway id="Gw_Compliant" name="Mail compliant?" default="F_Yes" />
    <bpmn:task id="Task_Compile" name="Compile list of requisition explaining the reason for rejection" />
    <bpmn:task id="Task_SendBack" name="Send list of requisition back to the party" />
    <bpmn:endEvent id="End_Rejected" name="Mail rejected" />
    <bpmn:task id="Task_Matter" name="Capture the matter details" />
    <bpmn:task id="Task_Provide" name="Provide the matter details to the Cashier" />
    <bpmn:task id="Task_Fees" name="Take the applicable fees" />
    <bpmn:parallelGateway id="Gw_Split" />
    <bpmn:task id="Task_Envelope" name="Put receipt and copied documents into an envelope" />
    <bpmn:task id="Task_Post" name="Post the envelope to the party" />
    <bpmn:task id="Task_Party" name="Capture the Party Details" />
    <bpmn:task id="Task_Print" name="Print the Physical Court File" />
    <bpmn:parallelGateway id="Gw_Join" />
    <bpmn:endEvent id="End_Done" name="Mail processed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Collect" targetRef="Task_SortUnopened" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_SortUnopened" targetRef="Task_Distribute" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Distribute" targetRef="Task_Open" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Open" targetRef="Task_SortGroups" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_SortGroups" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Register" targetRef="Task_Quality" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Quality" targetRef="Gw_Compliant" />
    <bpmn:sequenceFlow id="F_No" name="no" sourceRef="Gw_Compliant" targetRef="Task_Compile" />
    <bpmn:sequenceFlow id="F_Yes" name="yes" sourceRef="Gw_Compliant" targetRef="Task_Matter" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Compile" targetRef="Task_SendBack" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_SendBack" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Matter" targetRef="Task_Provide" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Provide" targetRef="Task_Fees" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Fees" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Split" targetRef="Task_Envelope" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_Split" targetRef="Task_Party" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Envelope" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Party" targetRef="Task_Print" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Post" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Print" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_Join" targetRef="End_Done" />
  </bpmn:process>
</bpmn:definitions>