<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organization" processRef="Process_Claims" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Claims" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_Org" name="Claims handling">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Simple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Complex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Forms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Claim received" />
    <bpmn:task id="Task_Insured" name="Check whether claimant is insured" />
    <bpmn:exclusiveGateway id="Gw_Insured" name="Claimant insured?" default="F_NotInsured" />
    <bpmn:task id="Task_Reject" name="Inform claimant that claim must be rejected" />
    <bpmn:endEvent id="End_Rejected" name="Claim rejected" />
    <bpmn:task id="Task_Severity" name="Evaluate severity of claim" />
    <bpmn:exclusiveGateway id="Gw_Severity" name="Simple or complex claim?" default="F_Complex" />
    <bpmn:task id="Task_Simple" name="Send simple claim forms to claimant" />
    <bpmn:task id="Task_Complex" name="Send complex claim forms to claimant" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:exclusiveGateway id="Gw_Forms" />
    <bpmn:task id="Task_Receive" name="Receive forms from claimant" />
    <bpmn:task id="Task_Check" name="Check forms for completeness" />
    <bpmn:exclusiveGateway id="Gw_Complete" name="Forms complete?" default="F_Incomplete" />
    <bpmn:task id="Task_Register" name="Register claim in Claims Management system" />
    <bpmn:endEvent id="End_Registered" name="Claims Notification process ended" />
    <bpmn:task id="Task_Update" name="Inform claimant to update forms" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Insured" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Insured" targetRef="Gw_Insured" />
    <bpmn:sequenceFlow id="F_Insured" name="yes" sourceRef="Gw_Insured" targetRef="Task_Severity" />
    <bpmn:sequenceFlow id="F_NotInsured" name="no" sourceRef="Gw_Insured" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Severity" targetRef="Gw_Severity" />
    <bpmn:sequenceFlow id="F_Simple" name="simple" sourceRef="Gw_Severity" targetRef="Task_Simple" />
    <bpmn:sequenceFlow id="F_Complex" name="complex" sourceRef="Gw_Severity" targetRef="Task_Complex" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Simple" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Complex" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Merge" targetRef="Gw_Forms" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Forms" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Receive" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Check" targetRef="Gw_Complete" />
    <bpmn:sequenceFlow id="F_Complete" name="yes" sourceRef="Gw_Complete" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="F_Incomplete" name="no" sourceRef="Gw_Complete" targetRef="Task_Update" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Register" targetRef="End_Registered" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Update" targetRef="Gw_Forms" />
  </bpmn:process>
</bpmn:definitions>