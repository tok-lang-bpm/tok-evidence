<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Claims organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Handler" name="Claims handler">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Claims manager">
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Car accident claim received" />
    <bpmn:task id="Task_Search" name="Search the Police Report in the Police Report database" />
    <bpmn:task id="Task_File" name="Put the Police Report in a file together with the Claim Documentation" />
    <bpmn:task id="Task_Estimate" name="Calculate an initial claim estimate" />
    <bpmn:task id="Task_Plan" name="Create an Action Plan based on the Action Plan Checklist" />
    <bpmn:task id="Task_Negotiate" name="Negotiate a settlement on the claim estimate" />
    <bpmn:task id="Task_Inform" name="Inform the claimant of the outcome" />
    <bpmn:endEvent id="End_1" name="Claim handled" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Search" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Search" targetRef="Task_File" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_File" targetRef="Task_Estimate" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Estimate" targetRef="Task_Plan" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Plan" targetRef="Task_Negotiate" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Negotiate" targetRef="Task_Inform" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Inform" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>