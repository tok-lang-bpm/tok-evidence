<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Car insurer" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Notification" name="Notification department">
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Handling" name="Handling department">
        <bpmn:flowNodeRef>Task_CheckIns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Claim needed" />
    <bpmn:task id="Task_Submit" name="Submit claim with documentation" />
    <bpmn:task id="Task_CheckDocs" name="Check documents for completeness" />
    <bpmn:task id="Task_Register" name="Register claim" />
    <bpmn:task id="Task_CheckIns" name="Check insurance" />
    <bpmn:task id="Task_Assess" name="Perform assessment" />
    <bpmn:exclusiveGateway id="Gw_Positive" name="Assessment positive?" />
    <bpmn:task id="Task_Phone" name="Phone garage to authorise repairs" />
    <bpmn:task id="Task_Schedule" name="Schedule payment" />
    <bpmn:task id="Task_Reject" name="Reject claim" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Letter" name="Send letter to customer" />
    <bpmn:endEvent id="End_1" name="Claim complete" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Submit" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_CheckDocs" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Register" targetRef="Task_CheckIns" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_CheckIns" targetRef="Task_Assess" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Assess" targetRef="Gw_Positive" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gw_Positive" targetRef="Task_Phone" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gw_Positive" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Phone" targetRef="Task_Schedule" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Schedule" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Reject" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Merge" targetRef="Task_Letter" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Letter" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
