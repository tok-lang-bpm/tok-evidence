<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Mental health care institute" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_SEC" name="Secretarial office">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_putthrough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_createfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_newm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_storefile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_addlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_storeassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_passcards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_med</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receivecopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_informsecond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_addcopy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_medm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_addinfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_putlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_providelist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_NO" name="Nursing officer">
        <bpmn:flowNodeRef>T_inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_handin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_TL" name="Team-leader">
        <bpmn:flowNodeRef>Timer_wed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_recassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_handlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_F" name="First intaker">
        <bpmn:flowNodeRef>T_f_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_f_exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_f_obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_f_notes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_f_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_S" name="Second intaker">
        <bpmn:flowNodeRef>T_s_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_s_dict</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Notice by telephone received" />
    <bpmn:task id="T_inquire" name="Inquire after name and residence of patient" />
    <bpmn:task id="T_putthrough" name="Put doctor through to nursing officer" />
    <bpmn:task id="T_inquiry" name="Make full inquiry into mental, health and social state of patient" />
    <bpmn:task id="T_record" name="Record information on registration form" />
    <bpmn:task id="T_handin" name="Hand in registration form at secretarial office" />
    <bpmn:task id="T_store" name="Store information of form in information system" />
    <bpmn:task id="T_print" name="Print information from information system" />
    <bpmn:exclusiveGateway id="Gw_new" name="New patient?" default="F_new_no" />
    <bpmn:task id="T_createfile" name="Create patient file" />
    <bpmn:exclusiveGateway id="Gw_newm" />
    <bpmn:task id="T_storefile" name="Store registration form and print in patient file" />
    <bpmn:task id="T_cards" name="Produce two registration cards" />
    <bpmn:task id="T_addlist" name="Add patient to list of new notices" />
    <bpmn:intermediateCatchEvent id="Timer_wed" name="Wednesday staff meeting">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/P1W</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_assign" name="Assign new patients to first and second intaker" />
    <bpmn:task id="T_recassign" name="Record assignments on assignment list" />
    <bpmn:task id="T_determine" name="Determine whether medical file is required" />
    <bpmn:task id="T_handlist" name="Hand assignment list to secretarial office" />
    <bpmn:task id="T_storeassign" name="Store assignments in information system" />
    <bpmn:task id="T_passcards" name="Pass registration cards to first and second intaker" />
    <bpmn:parallelGateway id="Par_split" />
    <bpmn:task id="T_f_plan" name="Plan first meeting with patient" />
    <bpmn:task id="T_f_exam" name="Examine patient using standard checklist" />
    <bpmn:task id="T_f_obs" name="Register additional observations in personal notebook" />
    <bpmn:task id="T_f_notes" name="Put copy of notes in patient file" />
    <bpmn:task id="T_f_check" name="Add standard checklist to patient file" />
    <bpmn:exclusiveGateway id="Gw_med" name="Medical file required?" default="F_med_no" />
    <bpmn:task id="T_letter" name="Prepare and send letter to family doctor requesting copy of medical file" />
    <bpmn:receiveTask id="T_receivecopy" name="Receive copy of medical file" />
    <bpmn:task id="T_informsecond" name="Inform second intaker" />
    <bpmn:task id="T_addcopy" name="Add copy of medical file to patient file" />
    <bpmn:exclusiveGateway id="Gw_medm" />
    <bpmn:task id="T_s_plan" name="Plan first meeting with patient" />
    <bpmn:task id="T_s_dict" name="Record observations with dictaphone" />
    <bpmn:task id="T_type" name="Type out tapes" />
    <bpmn:task id="T_addinfo" name="Add typed information to patient file" />
    <bpmn:parallelGateway id="Par_join" />
    <bpmn:task id="T_putlist" name="Put patient on list of patients that reached this status" />
    <bpmn:task id="T_providelist" name="Provide team-leader with list of patients" />
    <bpmn:task id="T_plan" name="Formulate treatment plan" />
    <bpmn:endEvent id="End" name="Intake procedure ended" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_inquire" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_inquire" targetRef="T_putthrough" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_putthrough" targetRef="T_inquiry" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_inquiry" targetRef="T_record" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_record" targetRef="T_handin" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_handin" targetRef="T_store" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_store" targetRef="T_print" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_print" targetRef="Gw_new" />
    <bpmn:sequenceFlow id="F_new_yes" name="yes" sourceRef="Gw_new" targetRef="T_createfile" />
    <bpmn:sequenceFlow id="F_new_no" name="no" sourceRef="Gw_new" targetRef="Gw_newm" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_createfile" targetRef="Gw_newm" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_newm" targetRef="T_storefile" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_storefile" targetRef="T_cards" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_cards" targetRef="T_addlist" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_addlist" targetRef="Timer_wed" />
    <bpmn:sequenceFlow id="F14" sourceRef="Timer_wed" targetRef="T_assign" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_assign" targetRef="T_recassign" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_recassign" targetRef="T_determine" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_determine" targetRef="T_handlist" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_handlist" targetRef="T_storeassign" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_storeassign" targetRef="T_passcards" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_passcards" targetRef="Par_split" />
    <bpmn:sequenceFlow id="F21" sourceRef="Par_split" targetRef="T_f_plan" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_f_plan" targetRef="T_f_exam" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_f_exam" targetRef="T_f_obs" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_f_obs" targetRef="T_f_notes" />
    <bpmn:sequenceFlow id="F25" sourceRef="T_f_notes" targetRef="T_f_check" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_f_check" targetRef="Par_join" />
    <bpmn:sequenceFlow id="F27" sourceRef="Par_split" targetRef="Gw_med" />
    <bpmn:sequenceFlow id="F_med_yes" name="yes" sourceRef="Gw_med" targetRef="T_letter" />
    <bpmn:sequenceFlow id="F_med_no" name="no" sourceRef="Gw_med" targetRef="Gw_medm" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_letter" targetRef="T_receivecopy" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_receivecopy" targetRef="T_informsecond" />
    <bpmn:sequenceFlow id="F30" sourceRef="T_informsecond" targetRef="T_addcopy" />
    <bpmn:sequenceFlow id="F31" sourceRef="T_addcopy" targetRef="Gw_medm" />
    <bpmn:sequenceFlow id="F32" sourceRef="Gw_medm" targetRef="T_s_plan" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_s_plan" targetRef="T_s_dict" />
    <bpmn:sequenceFlow id="F34" sourceRef="T_s_dict" targetRef="T_type" />
    <bpmn:sequenceFlow id="F35" sourceRef="T_type" targetRef="T_addinfo" />
    <bpmn:sequenceFlow id="F36" sourceRef="T_addinfo" targetRef="Par_join" />
    <bpmn:sequenceFlow id="F37" sourceRef="Par_join" targetRef="T_putlist" />
    <bpmn:sequenceFlow id="F38" sourceRef="T_putlist" targetRef="T_providelist" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_providelist" targetRef="T_plan" />
    <bpmn:sequenceFlow id="F40" sourceRef="T_plan" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
