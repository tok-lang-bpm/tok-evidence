<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Loan approval" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Assessor" name="Risk assessment Web service">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Approver Web service">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Loan request needed" />
    <bpmn:task id="Task_Receive" name="Receive customer request" />
    <bpmn:task id="Task_Assess" name="Assess request" />
    <bpmn:exclusiveGateway id="Gw_Split" name="Outcome of assessment?" default="F_review" />
    <bpmn:task id="Task_Approve" name="Approve loan" />
    <bpmn:task id="Task_Deny" name="Deny loan" />
    <bpmn:task id="Task_Send" name="Send request to approver Web service" />
    <bpmn:task id="Task_Review" name="Review request" />
    <bpmn:exclusiveGateway id="Gw_Join" />
    <bpmn:task id="Task_Feedback" name="Receive feedback" />
    <bpmn:endEvent id="End_1" name="Feedback received" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Receive" targetRef="Task_Assess" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Assess" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="F_small" name="small loan and low risk" sourceRef="Gw_Split" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F_high" name="high risk" sourceRef="Gw_Split" targetRef="Task_Deny" />
    <bpmn:sequenceFlow id="F_review" name="further review or $10,000 or more" sourceRef="Gw_Split" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Send" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Approve" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Deny" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Review" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Join" targetRef="Task_Feedback" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Feedback" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>