<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="ACME AG" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_sec" name="Secretariat">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_acc" name="Accounting employee">
        <bpmn:flowNodeRef>T_identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fwdcomm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_consultm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendagain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ccm" name="Cost center manager">
        <bpmn:flowNodeRef>Gw_mrev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_retmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_com" name="Commercial manager">
        <bpmn:flowNodeRef>Gw_maudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_amountm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_board" name="Board">
        <bpmn:flowNodeRef>T_board</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Invoice received" />
    <bpmn:task id="T_receive" name="Receive invoice in central inbox" />
    <bpmn:task id="T_inspect" name="Inspect invoice visually" />
    <bpmn:task id="T_forward" name="Forward invoice to accounting employee" />
    <bpmn:task id="T_identify" name="Identify charging supplier" />
    <bpmn:task id="T_create" name="Create invoice instance" />
    <bpmn:task id="T_checkitems" name="Check invoice items" />
    <bpmn:task id="T_note" name="Note cost center and cost center manager for each position on docket" />
    <bpmn:task id="T_sendfirst" name="Send docket and copy of invoice to first cost center manager" />
    <bpmn:exclusiveGateway id="Gw_mrev" />
    <bpmn:task id="T_review" name="Review content for accuracy" />
    <bpmn:exclusiveGateway id="Gw_ok" name="Everything in order?" />
    <bpmn:task id="T_ap" name="Note code AP on docket" />
    <bpmn:task id="T_retmail" name="Return copy of invoice to internal mail" />
    <bpmn:exclusiveGateway id="Gw_all" name="All positions marked AP?" />
    <bpmn:task id="T_next" name="Pass copy of invoice to next cost center manager" />
    <bpmn:task id="T_reject" name="Reject AP with note and statement on docket" />
    <bpmn:task id="T_sendback" name="Send copy of invoice back to accounting" />
    <bpmn:task id="T_clarify" name="Clarify inconsistencies with vendor" />
    <bpmn:exclusiveGateway id="Gw_consult" name="Consultation of cost center managers necessary?" />
    <bpmn:task id="T_consult" name="Consult cost center managers by telephone or e-mail" />
    <bpmn:exclusiveGateway id="Gw_consultm" />
    <bpmn:task id="T_sendagain" name="Send copy of invoice to cost center managers again" />
    <bpmn:task id="T_fwdcomm" name="Forward copy of invoice to commercial manager" />
    <bpmn:exclusiveGateway id="Gw_maudit" />
    <bpmn:task id="T_audit" name="Make commercial audit" />
    <bpmn:exclusiveGateway id="Gw_complaint" name="Complaint?" />
    <bpmn:task id="T_resolve" name="Resolve complaint with supplier" />
    <bpmn:task id="T_approve" name="Issue approval for payment" />
    <bpmn:exclusiveGateway id="Gw_amount" name="Bill amount exceeds EUR 20?" />
    <bpmn:task id="T_board" name="Check invoice again (4-eyes-principle)" />
    <bpmn:exclusiveGateway id="Gw_amountm" />
    <bpmn:task id="T_return" name="Return copy of invoice and docket to accounting employee in signature file" />
    <bpmn:task id="T_pay" name="Give payment instructions" />
    <bpmn:task id="T_close" name="Close instance in ACME Financial Accounting" />
    <bpmn:endEvent id="End" name="Invoice processed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_receive" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_receive" targetRef="T_inspect" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_inspect" targetRef="T_forward" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_forward" targetRef="T_identify" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_identify" targetRef="T_create" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_create" targetRef="T_checkitems" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_checkitems" targetRef="T_note" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_note" targetRef="T_sendfirst" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_sendfirst" targetRef="Gw_mrev" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_mrev" targetRef="T_review" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_review" targetRef="Gw_ok" />
    <bpmn:sequenceFlow id="F_ok_yes" name="yes" sourceRef="Gw_ok" targetRef="T_ap" />
    <bpmn:sequenceFlow id="F_ok_no" name="no" sourceRef="Gw_ok" targetRef="T_reject" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_ap" targetRef="T_retmail" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_retmail" targetRef="Gw_all" />
    <bpmn:sequenceFlow id="F_all_yes" name="yes" sourceRef="Gw_all" targetRef="T_fwdcomm" />
    <bpmn:sequenceFlow id="F_all_no" name="no" sourceRef="Gw_all" targetRef="T_next" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_next" targetRef="Gw_mrev" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_reject" targetRef="T_sendback" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_sendback" targetRef="T_clarify" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_clarify" targetRef="Gw_consult" />
    <bpmn:sequenceFlow id="F_cons_yes" name="yes" sourceRef="Gw_consult" targetRef="T_consult" />
    <bpmn:sequenceFlow id="F_cons_no" name="no" sourceRef="Gw_consult" targetRef="Gw_consultm" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_consult" targetRef="Gw_consultm" />
    <bpmn:sequenceFlow id="F25" sourceRef="Gw_consultm" targetRef="T_sendagain" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_sendagain" targetRef="Gw_mrev" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_fwdcomm" targetRef="Gw_maudit" />
    <bpmn:sequenceFlow id="F29" sourceRef="Gw_maudit" targetRef="T_audit" />
    <bpmn:sequenceFlow id="F30" sourceRef="T_audit" targetRef="Gw_complaint" />
    <bpmn:sequenceFlow id="F_comp_yes" name="yes" sourceRef="Gw_complaint" targetRef="T_resolve" />
    <bpmn:sequenceFlow id="F_comp_no" name="no" sourceRef="Gw_complaint" targetRef="T_approve" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_resolve" targetRef="Gw_maudit" />
    <bpmn:sequenceFlow id="F34" sourceRef="T_approve" targetRef="Gw_amount" />
    <bpmn:sequenceFlow id="F_amt_yes" name="yes" sourceRef="Gw_amount" targetRef="T_board" />
    <bpmn:sequenceFlow id="F_amt_no" name="no" sourceRef="Gw_amount" targetRef="Gw_amountm" />
    <bpmn:sequenceFlow id="F37" sourceRef="T_board" targetRef="Gw_amountm" />
    <bpmn:sequenceFlow id="F38" sourceRef="Gw_amountm" targetRef="T_return" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_return" targetRef="T_pay" />
    <bpmn:sequenceFlow id="F40" sourceRef="T_pay" targetRef="T_close" />
    <bpmn:sequenceFlow id="F41" sourceRef="T_close" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
