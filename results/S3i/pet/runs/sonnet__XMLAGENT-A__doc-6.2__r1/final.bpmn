<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Order handling" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Assembler" name="Assembler AG">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supplier" name="Supplier">
        <bpmn:flowNodeRef>Task_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_c</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="First of each month">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Task_a" name="Send the order to the supplier" />
    <bpmn:task id="Task_b" name="Process the order" />
    <bpmn:task id="Task_c" name="Send the invoice to Assembler AG" />
    <bpmn:task id="Task_d" name="Receive the invoice" />
    <bpmn:endEvent id="End_1" name="Invoice received" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_a" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_a" targetRef="Task_b" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_b" targetRef="Task_c" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_c" targetRef="Task_d" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_d" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
