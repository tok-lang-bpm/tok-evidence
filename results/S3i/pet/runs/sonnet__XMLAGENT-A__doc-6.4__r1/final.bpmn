<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:message id="Msg_back" name="Customer comes back" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Sales organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_mkt" name="Marketing staff">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_src</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_exh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_srcm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_cc" name="Call center staff">
        <bpmn:flowNodeRef>Task_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_interest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_left</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_head" name="Head of development">
        <bpmn:flowNodeRef>Task_acq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_acq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sales" name="Sales representative">
        <bpmn:flowNodeRef>Gw_tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_presm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_2w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_recall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_waitm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_quote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_pre" name="Pre-sales employee">
        <bpmn:flowNodeRef>Task_techpres</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Contact details needed" />
    <bpmn:exclusiveGateway id="Gw_src" name="How are contact details determined?" />
    <bpmn:task id="Task_buy" name="Buy details for cold calls" />
    <bpmn:task id="Task_exh" name="Participate in exhibitions" />
    <bpmn:task id="Task_know" name="Get to know somebody interested" />
    <bpmn:exclusiveGateway id="Gw_srcm" />
    <bpmn:task id="Task_call" name="Call the customer" />
    <bpmn:parallelGateway id="Gw_split" />
    <bpmn:task id="Task_contact" name="Determine the contact person and the budget" />
    <bpmn:task id="Task_interest" name="Ask whether the customer is interested" />
    <bpmn:parallelGateway id="Gw_join" />
    <bpmn:exclusiveGateway id="Gw_int" name="Customer interested?" />
    <bpmn:exclusiveGateway id="Gw_budget" name="Project budget huge?" />
    <bpmn:endEvent id="End_left" name="Customer left alone" />
    <bpmn:task id="Task_acq" name="Acquire the customer personally" />
    <bpmn:endEvent id="End_acq" name="Customer approached by head of development" />
    <bpmn:exclusiveGateway id="Gw_tech" name="More technical presentation?" />
    <bpmn:task id="Task_pres" name="Give a detailed online presentation" />
    <bpmn:task id="Task_techpres" name="Give a technical online presentation" />
    <bpmn:exclusiveGateway id="Gw_presm" />
    <bpmn:eventBasedGateway id="Gw_wait" name="Customer comes back?" />
    <bpmn:intermediateCatchEvent id="Catch_back" name="Customer comes back">
      <bpmn:messageEventDefinition messageRef="Msg_back" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_2w" name="2 weeks without contact">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_recall" name="Call the customer" />
    <bpmn:exclusiveGateway id="Gw_waitm" />
    <bpmn:task id="Task_quote" name="Create a quotation" />
    <bpmn:endEvent id="End_quote" name="Quotation created" />
    <bpmn:sequenceFlow id="F_1" sourceRef="Start_1" targetRef="Gw_src" />
    <bpmn:sequenceFlow id="F_s1" name="buy details" sourceRef="Gw_src" targetRef="Task_buy" />
    <bpmn:sequenceFlow id="F_s2" name="exhibition" sourceRef="Gw_src" targetRef="Task_exh" />
    <bpmn:sequenceFlow id="F_s3" name="personal acquaintance" sourceRef="Gw_src" targetRef="Task_know" />
    <bpmn:sequenceFlow id="F_2" sourceRef="Task_buy" targetRef="Gw_srcm" />
    <bpmn:sequenceFlow id="F_3" sourceRef="Task_exh" targetRef="Gw_srcm" />
    <bpmn:sequenceFlow id="F_4" sourceRef="Task_know" targetRef="Gw_srcm" />
    <bpmn:sequenceFlow id="F_5" sourceRef="Gw_srcm" targetRef="Task_call" />
    <bpmn:sequenceFlow id="F_6" sourceRef="Task_call" targetRef="Gw_split" />
    <bpmn:sequenceFlow id="F_7" sourceRef="Gw_split" targetRef="Task_contact" />
    <bpmn:sequenceFlow id="F_8" sourceRef="Gw_split" targetRef="Task_interest" />
    <bpmn:sequenceFlow id="F_9" sourceRef="Task_contact" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_interest" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Gw_join" targetRef="Gw_int" />
    <bpmn:sequenceFlow id="F_i1" name="yes" sourceRef="Gw_int" targetRef="Gw_tech" />
    <bpmn:sequenceFlow id="F_i2" name="no" sourceRef="Gw_int" targetRef="Gw_budget" />
    <bpmn:sequenceFlow id="F_b1" name="yes" sourceRef="Gw_budget" targetRef="Task_acq" />
    <bpmn:sequenceFlow id="F_b2" name="no" sourceRef="Gw_budget" targetRef="End_left" />
    <bpmn:sequenceFlow id="F_12" sourceRef="Task_acq" targetRef="End_acq" />
    <bpmn:sequenceFlow id="F_t1" name="yes" sourceRef="Gw_tech" targetRef="Task_techpres" />
    <bpmn:sequenceFlow id="F_t2" name="no" sourceRef="Gw_tech" targetRef="Task_pres" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_pres" targetRef="Gw_presm" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_techpres" targetRef="Gw_presm" />
    <bpmn:sequenceFlow id="F_15" sourceRef="Gw_presm" targetRef="Gw_wait" />
    <bpmn:sequenceFlow id="F_16" sourceRef="Gw_wait" targetRef="Catch_back" />
    <bpmn:sequenceFlow id="F_17" sourceRef="Gw_wait" targetRef="Catch_2w" />
    <bpmn:sequenceFlow id="F_18" sourceRef="Catch_2w" targetRef="Task_recall" />
    <bpmn:sequenceFlow id="F_19" sourceRef="Catch_back" targetRef="Gw_waitm" />
    <bpmn:sequenceFlow id="F_20" sourceRef="Task_recall" targetRef="Gw_waitm" />
    <bpmn:sequenceFlow id="F_21" sourceRef="Gw_waitm" targetRef="Task_quote" />
    <bpmn:sequenceFlow id="F_22" sourceRef="Task_quote" targetRef="End_quote" />
  </bpmn:process>
</bpmn:definitions>
