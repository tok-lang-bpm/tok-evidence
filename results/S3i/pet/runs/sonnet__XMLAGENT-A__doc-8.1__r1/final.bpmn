<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE" name="Organisation">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Demand to fill a post received" />
    <bpmn:task id="Task_Advertise" name="Advertise the post" />
    <bpmn:task id="Task_Apply" name="Apply for the post" />
    <bpmn:task id="Task_Check" name="Check the applications" />
    <bpmn:task id="Task_Fill" name="Conclude the contract of employment" />
    <bpmn:endEvent id="End_1" name="Post filled" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Advertise" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Advertise" targetRef="Task_Apply" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Apply" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Check" targetRef="Task_Fill" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Fill" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
