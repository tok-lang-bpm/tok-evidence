<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE_HR" name="HR clerk">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_confusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Vacancy reported" />
    <bpmn:exclusiveGateway id="Gw_m1" />
    <bpmn:task id="Task_create" name="Create job description" />
    <bpmn:exclusiveGateway id="Gw_confusion" name="Confusion in the message?" />
    <bpmn:task id="Task_ask" name="Ask the Department again" />
    <bpmn:exclusiveGateway id="Gw_m2" />
    <bpmn:task id="Task_submit" name="Submit job description for consideration" />
    <bpmn:task id="Task_wait" name="Wait for the approval" />
    <bpmn:exclusiveGateway id="Gw_approved" name="Approved?" />
    <bpmn:task id="Task_correct" name="Correct the description" />
    <bpmn:task id="Task_post" name="Post the job" />
    <bpmn:endEvent id="End_1" name="Job posted" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Gw_m1" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gw_m1" targetRef="Task_create" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_create" targetRef="Gw_confusion" />
    <bpmn:sequenceFlow id="F_yes1" name="yes" sourceRef="Gw_confusion" targetRef="Task_ask" />
    <bpmn:sequenceFlow id="F_no1" name="no" sourceRef="Gw_confusion" targetRef="Gw_m2" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_ask" targetRef="Gw_m1" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_m2" targetRef="Task_submit" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_submit" targetRef="Task_wait" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_wait" targetRef="Gw_approved" />
    <bpmn:sequenceFlow id="F_yes2" name="yes" sourceRef="Gw_approved" targetRef="Task_post" />
    <bpmn:sequenceFlow id="F_no2" name="no" sourceRef="Gw_approved" targetRef="Task_correct" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_correct" targetRef="Gw_m2" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_post" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
