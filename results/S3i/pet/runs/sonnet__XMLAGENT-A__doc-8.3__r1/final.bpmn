<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Head" name="Head of the functional department">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskCorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Personnel Department">
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Quest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Personnel requirements detected" />
    <bpmn:task id="Task_Detect" name="Detect personnel requirements" />
    <bpmn:task id="Task_Report" name="Report the vacancy to the Personnel Department" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:task id="Task_Describe" name="Describe the job" />
    <bpmn:exclusiveGateway id="Gw_Quest" name="Questions about tasks and requirements?" />
    <bpmn:task id="Task_Clarify" name="Clarify tasks and requirements" />
    <bpmn:task id="Task_Review" name="Review the job description" />
    <bpmn:exclusiveGateway id="Gw_Corr" name="Corrections needed?" />
    <bpmn:task id="Task_AskCorr" name="Ask for corrections" />
    <bpmn:task id="Task_Approve" name="Approve the job description" />
    <bpmn:endEvent id="End_1" name="Job description approved" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_Detect" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Detect" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Report" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="Gw_Merge" targetRef="Task_Describe" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_Describe" targetRef="Gw_Quest" />
    <bpmn:sequenceFlow id="f6" name="yes" sourceRef="Gw_Quest" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="f7" name="no" sourceRef="Gw_Quest" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="f8" sourceRef="Task_Clarify" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="f9" sourceRef="Task_Review" targetRef="Gw_Corr" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="Gw_Corr" targetRef="Task_AskCorr" />
    <bpmn:sequenceFlow id="f11" name="no" sourceRef="Gw_Corr" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="f12" sourceRef="Task_AskCorr" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="Task_Approve" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
