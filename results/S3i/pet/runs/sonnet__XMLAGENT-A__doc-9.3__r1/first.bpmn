<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Town Planning Authority" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="Lane_Coord" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support Officer">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Suggest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Members" name="Committee Members">
        <bpmn:flowNodeRef>Task_Diaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Advise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="November" />
    <bpmn:task id="Task_Draft" name="Draft schedule of meetings" />
    <bpmn:task id="Task_Add" name="Add draft dates to all calendars" />
    <bpmn:task id="Task_Check" name="Check the dates" />
    <bpmn:task id="Task_Suggest" name="Suggest modifications" />
    <bpmn:task id="Task_Recheck" name="Recheck all dates and look for potential conflicts" />
    <bpmn:task id="Task_Send" name="Send final schedule of meeting dates by email" />
    <bpmn:task id="Task_Diaries" name="Check diaries" />
    <bpmn:task id="Task_Advise" name="Advise Coordination Unit of any conflicts" />
    <bpmn:endEvent id="End_1" name="Schedule agreed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Draft" targetRef="Task_Add" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Add" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Check" targetRef="Task_Suggest" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Suggest" targetRef="Task_Recheck" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Recheck" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Send" targetRef="Task_Diaries" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Diaries" targetRef="Task_Advise" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Advise" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>