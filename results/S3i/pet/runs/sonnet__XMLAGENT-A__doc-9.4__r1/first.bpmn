<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Pool_Org" name="Organisation" processRef="Process_Meetings" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Meetings" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_CU" name="Coordination Unit">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SO" name="Support Officer">
        <bpmn:flowNodeRef>Task_Calendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Folders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Minutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Records</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM" name="Committee Members">
        <bpmn:flowNodeRef>Task_Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Hold</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Meeting dates to be set" />
    <bpmn:task id="Task_Finalize" name="Finalize the dates" />
    <bpmn:task id="Task_Calendars" name="Update all group calendars" />
    <bpmn:task id="Task_Folders" name="Create meeting folders for each meeting" />
    <bpmn:task id="Task_Upload" name="Upload all appropriate documents to system" />
    <bpmn:task id="Task_Advise" name="Advise Committee Members a week before each meeting" />
    <bpmn:task id="Task_Read" name="Read all related documents" />
    <bpmn:task id="Task_Hold" name="Hold the meeting" />
    <bpmn:task id="Task_Minutes" name="Produce minutes including Action Points" />
    <bpmn:task id="Task_QA" name="Conduct QA check on the minutes within 5 working days" />
    <bpmn:task id="Task_Send" name="Send minutes to all Committee Members" />
    <bpmn:task id="Task_Records" name="Update all departmental records" />
    <bpmn:endEvent id="End_1" name="Records updated" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Finalize" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Finalize" targetRef="Task_Calendars" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Calendars" targetRef="Task_Folders" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Folders" targetRef="Task_Upload" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Upload" targetRef="Task_Advise" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Advise" targetRef="Task_Read" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Read" targetRef="Task_Hold" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Hold" targetRef="Task_Minutes" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Minutes" targetRef="Task_QA" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_QA" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Send" targetRef="Task_Records" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Records" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
