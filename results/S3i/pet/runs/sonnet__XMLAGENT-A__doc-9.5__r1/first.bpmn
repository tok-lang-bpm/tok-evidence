<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Expense reimbursement" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="LANE" name="Expense reimbursement">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AccountMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bd_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bd_30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Expense report received" />
    <bpmn:exclusiveGateway id="Gw_Account" name="Does the employee have an account?" default="F3" />
    <bpmn:task id="Task_Account" name="Create new account" />
    <bpmn:exclusiveGateway id="Gw_AccountMerge" />
    <bpmn:subProcess id="Sub_Process" name="Process expense report">
      <bpmn:startEvent id="S_Start" />
      <bpmn:task id="S_Review" name="Review expense report for automatic approval" />
      <bpmn:exclusiveGateway id="S_GwAmount" name="Amount under $200?" default="S_F5" />
      <bpmn:task id="S_Supervisor" name="Approve expense report by supervisor" />
      <bpmn:exclusiveGateway id="S_GwApproved" name="Approved?" default="S_F8" />
      <bpmn:exclusiveGateway id="S_Merge" />
      <bpmn:task id="S_Deposit" name="Deposit reimbursement to direct deposit bank account" />
      <bpmn:task id="S_Reject" name="Send rejection notice by email" />
      <bpmn:endEvent id="S_EndPaid" name="Reimbursement paid" />
      <bpmn:endEvent id="S_EndRejected" name="Report rejected" />
      <bpmn:sequenceFlow id="S_F1" sourceRef="S_Start" targetRef="S_Review" />
      <bpmn:sequenceFlow id="S_F2" sourceRef="S_Review" targetRef="S_GwAmount" />
      <bpmn:sequenceFlow id="S_F3" name="yes" sourceRef="S_GwAmount" targetRef="S_Merge" />
      <bpmn:sequenceFlow id="S_F5" name="no" sourceRef="S_GwAmount" targetRef="S_Supervisor" />
      <bpmn:sequenceFlow id="S_F6" sourceRef="S_Supervisor" targetRef="S_GwApproved" />
      <bpmn:sequenceFlow id="S_F7" name="yes" sourceRef="S_GwApproved" targetRef="S_Merge" />
      <bpmn:sequenceFlow id="S_F8" name="no" sourceRef="S_GwApproved" targetRef="S_Reject" />
      <bpmn:sequenceFlow id="S_F9" sourceRef="S_Merge" targetRef="S_Deposit" />
      <bpmn:sequenceFlow id="S_F10" sourceRef="S_Deposit" targetRef="S_EndPaid" />
      <bpmn:sequenceFlow id="S_F11" sourceRef="S_Reject" targetRef="S_EndRejected" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Bd_7" name="7 days" cancelActivity="false" attachedToRef="Sub_Process">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bd_30" name="30 days" attachedToRef="Sub_Process">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P30D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Progress" name="Send approval in progress email" />
    <bpmn:endEvent id="End_Progress" name="Reminder sent" />
    <bpmn:task id="Task_Cancel" name="Send cancellation notice by email" />
    <bpmn:task id="Task_Resubmit" name="Re-submit expense report" />
    <bpmn:endEvent id="End_Cancel" name="Process cancelled" />
    <bpmn:endEvent id="End_Done" name="Expense report handled" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Gw_Account" />
    <bpmn:sequenceFlow id="F2" name="no" sourceRef="Gw_Account" targetRef="Task_Account" />
    <bpmn:sequenceFlow id="F3" name="yes" sourceRef="Gw_Account" targetRef="Gw_AccountMerge" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Account" targetRef="Gw_AccountMerge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_AccountMerge" targetRef="Sub_Process" />
    <bpmn:sequenceFlow id="F6" sourceRef="Sub_Process" targetRef="End_Done" />
    <bpmn:sequenceFlow id="F7" sourceRef="Bd_7" targetRef="Task_Progress" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Progress" targetRef="End_Progress" />
    <bpmn:sequenceFlow id="F9" sourceRef="Bd_30" targetRef="Task_Cancel" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Cancel" targetRef="Task_Resubmit" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Resubmit" targetRef="End_Cancel" />
  </bpmn:process>
</bpmn:definitions>