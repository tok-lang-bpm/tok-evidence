<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Bicycle company" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="sales" name="Sales department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="store" name="Storehouse">
        <bpmn:flowNodeRef>parts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="eng" name="Engineering department">
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assemble</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order received" />
    <bpmn:exclusiveGateway id="decide" name="Accept the order?" />
    <bpmn:endEvent id="rejected" name="Order rejected" />
    <bpmn:task id="inform" name="Inform the storehouse and the engineering department" />
    <bpmn:parallelGateway id="split" />
    <bpmn:subProcess id="parts" name="Process the part list">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
      <bpmn:startEvent id="pstart" name="Item on part list" />
      <bpmn:task id="check" name="Check the required quantity of the part" />
      <bpmn:exclusiveGateway id="avail" name="Part available in-house?" />
      <bpmn:task id="reserve" name="Reserve the part" />
      <bpmn:task id="backorder" name="Back-order the part" />
      <bpmn:exclusiveGateway id="pmerge" />
      <bpmn:endEvent id="pend" name="Item handled" />
      <bpmn:sequenceFlow id="p1" sourceRef="pstart" targetRef="check" />
      <bpmn:sequenceFlow id="p2" sourceRef="check" targetRef="avail" />
      <bpmn:sequenceFlow id="p3" name="yes" sourceRef="avail" targetRef="reserve" />
      <bpmn:sequenceFlow id="p4" name="no" sourceRef="avail" targetRef="backorder" />
      <bpmn:sequenceFlow id="p5" sourceRef="reserve" targetRef="pmerge" />
      <bpmn:sequenceFlow id="p6" sourceRef="backorder" targetRef="pmerge" />
      <bpmn:sequenceFlow id="p7" sourceRef="pmerge" targetRef="pend" />
    </bpmn:subProcess>
    <bpmn:task id="prepare" name="Prepare the assembling of the bicycle" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="assemble" name="Assemble the bicycle" />
    <bpmn:task id="ship" name="Ship the bicycle to the customer" />
    <bpmn:endEvent id="shipped" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="decide" />
    <bpmn:sequenceFlow id="f2" name="reject" sourceRef="decide" targetRef="rejected" />
    <bpmn:sequenceFlow id="f3" name="accept" sourceRef="decide" targetRef="inform" />
    <bpmn:sequenceFlow id="f4" sourceRef="inform" targetRef="split" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="parts" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="prepare" />
    <bpmn:sequenceFlow id="f7" sourceRef="parts" targetRef="join" />
    <bpmn:sequenceFlow id="f8" sourceRef="prepare" targetRef="join" />
    <bpmn:sequenceFlow id="f9" sourceRef="join" targetRef="assemble" />
    <bpmn:sequenceFlow id="f10" sourceRef="assemble" targetRef="ship" />
    <bpmn:sequenceFlow id="f11" sourceRef="ship" targetRef="shipped" />
  </bpmn:process>
</bpmn:definitions>
