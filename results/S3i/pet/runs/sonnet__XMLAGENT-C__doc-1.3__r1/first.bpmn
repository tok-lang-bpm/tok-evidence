<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="The Evanstonian" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_MGR" name="Room-service manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>give</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alcMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_KIT" name="Kitchen">
        <bpmn:flowNodeRef>food</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SOM" name="Sommelier">
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_WAI" name="Waiter">
        <bpmn:flowNodeRef>cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Guest calls room service" />
    <bpmn:task id="take" name="Take down the order" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="submit" name="Submit the order ticket to the kitchen" />
    <bpmn:task id="food" name="Prepare the food" />
    <bpmn:exclusiveGateway id="alc" name="Order includes alcoholic beverage?" />
    <bpmn:task id="give" name="Give the order to the sommelier" />
    <bpmn:task id="fetch" name="Fetch wine from the cellar" />
    <bpmn:task id="bev" name="Prepare other alcoholic beverages" />
    <bpmn:exclusiveGateway id="alcMerge" />
    <bpmn:task id="assign" name="Assign the order to the waiter" />
    <bpmn:task id="cart" name="Ready the cart" />
    <bpmn:task id="drinks" name="Prepare nonalcoholic drinks" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="deliver" name="Deliver the order to the guest's room" />
    <bpmn:task id="back" name="Return to the room-service station" />
    <bpmn:task id="debit" name="Debit the guest's account" />
    <bpmn:endEvent id="end" name="Order completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="take" />
    <bpmn:sequenceFlow id="f2" sourceRef="take" targetRef="split" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="submit" />
    <bpmn:sequenceFlow id="f4" sourceRef="submit" targetRef="food" />
    <bpmn:sequenceFlow id="f5" sourceRef="food" targetRef="join" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="alc" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="alc" targetRef="give" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="alc" targetRef="alcMerge" />
    <bpmn:sequenceFlow id="f9" sourceRef="give" targetRef="fetch" />
    <bpmn:sequenceFlow id="f10" sourceRef="fetch" targetRef="bev" />
    <bpmn:sequenceFlow id="f11" sourceRef="bev" targetRef="alcMerge" />
    <bpmn:sequenceFlow id="f12" sourceRef="alcMerge" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="split" targetRef="assign" />
    <bpmn:sequenceFlow id="f14" sourceRef="assign" targetRef="cart" />
    <bpmn:sequenceFlow id="f15" sourceRef="cart" targetRef="drinks" />
    <bpmn:sequenceFlow id="f16" sourceRef="drinks" targetRef="join" />
    <bpmn:sequenceFlow id="f17" sourceRef="join" targetRef="deliver" />
    <bpmn:sequenceFlow id="f18" sourceRef="deliver" targetRef="back" />
    <bpmn:sequenceFlow id="f19" sourceRef="back" targetRef="debit" />
    <bpmn:sequenceFlow id="f20" sourceRef="debit" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>