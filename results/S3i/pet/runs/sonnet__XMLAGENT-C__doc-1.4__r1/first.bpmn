<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Going public" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="company" name="Company">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="uw" name="Underwriters">
        <bpmn:flowNodeRef>advise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bluesky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>roadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>stopped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="SEC">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Decision to go public made" />
    <bpmn:task id="select" name="Select the underwriters" />
    <bpmn:task id="advise" name="Provide procedural and financial advice" />
    <bpmn:task id="prepare" name="Prepare the registration statement" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="register" name="Register the issue with the SEC" />
    <bpmn:task id="approve" name="Approve the registration statement" />
    <bpmn:task id="bluesky" name="Check compliance with the blue-sky laws" />
    <bpmn:task id="firm" name="Firm up the issue price" />
    <bpmn:task id="roadshow" name="Arrange a road show" />
    <bpmn:parallelGateway id="join" />
    <bpmn:task id="fix" name="Fix the issue price" />
    <bpmn:exclusiveGateway id="reason" name="Reason not to offer the stock found?" />
    <bpmn:task id="commit" name="Enter into a firm commitment to buy the stock" />
    <bpmn:task id="offer" name="Offer the stock to the public" />
    <bpmn:endEvent id="sold" name="Stock offered" />
    <bpmn:endEvent id="stopped" name="Issue not offered" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="select" />
    <bpmn:sequenceFlow id="f2" sourceRef="select" targetRef="advise" />
    <bpmn:sequenceFlow id="f3" sourceRef="advise" targetRef="prepare" />
    <bpmn:sequenceFlow id="f4" sourceRef="prepare" targetRef="split" />
    <bpmn:sequenceFlow id="f5" sourceRef="split" targetRef="register" />
    <bpmn:sequenceFlow id="f6" sourceRef="split" targetRef="bluesky" />
    <bpmn:sequenceFlow id="f7" sourceRef="split" targetRef="firm" />
    <bpmn:sequenceFlow id="f8" sourceRef="register" targetRef="approve" />
    <bpmn:sequenceFlow id="f9" sourceRef="firm" targetRef="roadshow" />
    <bpmn:sequenceFlow id="f10" sourceRef="approve" targetRef="join" />
    <bpmn:sequenceFlow id="f11" sourceRef="bluesky" targetRef="join" />
    <bpmn:sequenceFlow id="f12" sourceRef="roadshow" targetRef="join" />
    <bpmn:sequenceFlow id="f13" sourceRef="join" targetRef="fix" />
    <bpmn:sequenceFlow id="f14" sourceRef="fix" targetRef="reason" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="reason" targetRef="commit" />
    <bpmn:sequenceFlow id="f16" name="yes" sourceRef="reason" targetRef="stopped" />
    <bpmn:sequenceFlow id="f17" sourceRef="commit" targetRef="offer" />
    <bpmn:sequenceFlow id="f18" sourceRef="offer" targetRef="sold" />
  </bpmn:process>
</bpmn:definitions>