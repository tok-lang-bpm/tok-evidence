<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Measurement process" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="go" name="GO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitSp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="msp" name="MSP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Measurements needed" />
    <bpmn:task id="request" name="Request the measurements" />
    <bpmn:task id="check" name="Check the received request" />
    <bpmn:exclusiveGateway id="accepted" name="Request accepted?" />
    <bpmn:task id="deny" name="Deny the request" />
    <bpmn:task id="measure" name="Perform the measurement" />
    <bpmn:exclusiveGateway id="success" name="Reading successful?" />
    <bpmn:task id="inform" name="Inform the GO about the failure of the reading" />
    <bpmn:task id="transmit" name="Transmit the measured values to the GO" />
    <bpmn:task id="process" name="Process the measured values" />
    <bpmn:task id="sendChanged" name="Send the changed values to the MSP" />
    <bpmn:task id="transmitSp" name="Transmit the readings to the SP" />
    <bpmn:endEvent id="done" name="Readings transmitted" />
    <bpmn:endEvent id="denied" name="Request denied" />
    <bpmn:endEvent id="failed" name="Failure reported" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="request" />
    <bpmn:sequenceFlow id="f2" sourceRef="request" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="accepted" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="accepted" targetRef="deny" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="accepted" targetRef="measure" />
    <bpmn:sequenceFlow id="f6" sourceRef="deny" targetRef="denied" />
    <bpmn:sequenceFlow id="f7" sourceRef="measure" targetRef="success" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="success" targetRef="inform" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="success" targetRef="transmit" />
    <bpmn:sequenceFlow id="f10" sourceRef="inform" targetRef="failed" />
    <bpmn:sequenceFlow id="f11" sourceRef="transmit" targetRef="process" />
    <bpmn:sequenceFlow id="f12" sourceRef="process" targetRef="sendChanged" />
    <bpmn:sequenceFlow id="f13" sourceRef="sendChanged" targetRef="transmitSp" />
    <bpmn:sequenceFlow id="f14" sourceRef="transmitSp" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>