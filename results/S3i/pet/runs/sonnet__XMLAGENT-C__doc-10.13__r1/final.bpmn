<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Transaction data exchange" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="INQ" name="INQ">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IP" name="IP">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Data needed" />
    <bpmn:task id="transmit" name="Transmit the transaction data request" />
    <bpmn:task id="check" name="Check the request" />
    <bpmn:exclusiveGateway id="gw" name="Request accepted?" />
    <bpmn:task id="send" name="Transmit the data" />
    <bpmn:task id="reject" name="Reject the request" />
    <bpmn:endEvent id="endSent" name="Data transmitted" />
    <bpmn:endEvent id="endRejected" name="Request rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="transmit" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmit" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="gw" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="gw" targetRef="send" />
    <bpmn:sequenceFlow id="f5" name="no" sourceRef="gw" targetRef="reject" />
    <bpmn:sequenceFlow id="f6" sourceRef="send" targetRef="endSent" />
    <bpmn:sequenceFlow id="f7" sourceRef="reject" targetRef="endRejected" />
  </bpmn:process>
</bpmn:definitions>
