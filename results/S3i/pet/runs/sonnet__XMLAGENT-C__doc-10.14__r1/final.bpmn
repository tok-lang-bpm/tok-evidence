<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Metering organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="mpoo" name="MPOO">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="mspo" name="MSPO">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="go" name="GO or MPON">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Continuation of metering point operations billed" />
    <bpmn:startEvent id="s2" name="Continuation of measurement billed" />
    <bpmn:startEvent id="s3" name="Additional readings billed" />
    <bpmn:startEvent id="s4" name="Equipment acquisition billed" />
    <bpmn:task id="t1" name="Send the bill for the temporary continuation of the metering point operations" />
    <bpmn:task id="t2" name="Send the bill for the temporary continuation of the measurement" />
    <bpmn:task id="t3" name="Send the bill for additional readings" />
    <bpmn:task id="t4" name="Send the bill for the equipment acquisition" />
    <bpmn:task id="e1" name="Examine the bill for the continuation of operations" />
    <bpmn:task id="e2" name="Examine the bill for the continuation of measurement" />
    <bpmn:task id="e3" name="Examine the bill for additional readings" />
    <bpmn:task id="e4" name="Examine the bill for the equipment acquisition" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:exclusiveGateway id="ok" name="Invoice accepted?" />
    <bpmn:task id="confirm" name="Confirm the invoice with payment advice" />
    <bpmn:task id="reject" name="Reject the invoice" />
    <bpmn:endEvent id="confirmed" name="Invoice confirmed" />
    <bpmn:endEvent id="rejected" name="Invoice rejected" />
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="s2" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="s3" targetRef="t3" />
    <bpmn:sequenceFlow id="f4" sourceRef="s4" targetRef="t4" />
    <bpmn:sequenceFlow id="f5" sourceRef="t1" targetRef="e1" />
    <bpmn:sequenceFlow id="f6" sourceRef="t2" targetRef="e2" />
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="e3" />
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="e4" />
    <bpmn:sequenceFlow id="f9" sourceRef="e1" targetRef="merge" />
    <bpmn:sequenceFlow id="f10" sourceRef="e2" targetRef="merge" />
    <bpmn:sequenceFlow id="f11" sourceRef="e3" targetRef="merge" />
    <bpmn:sequenceFlow id="f12" sourceRef="e4" targetRef="merge" />
    <bpmn:sequenceFlow id="f13" sourceRef="merge" targetRef="ok" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="ok" targetRef="confirm" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f16" sourceRef="confirm" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f17" sourceRef="reject" targetRef="rejected" />
  </bpmn:process>
</bpmn:definitions>
