<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Meter operation registration" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_MPON" name="MPON">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acqN</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GO" name="GO">
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endRej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>infTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confAss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MPOO" name="MPOO">
        <bpmn:flowNodeRef>acqO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Meter operation started" />
    <bpmn:task id="report" name="Report the meter operation to the GO" />
    <bpmn:task id="examine" name="Examine the application of the MPON" />
    <bpmn:exclusiveGateway id="dec" name="Application confirmed?" />
    <bpmn:task id="reject" name="Reject the application of the MPON" />
    <bpmn:endEvent id="endRej" name="Application rejected" />
    <bpmn:task id="confirm" name="Confirm the application of the MPON" />
    <bpmn:parallelGateway id="sp1" />
    <bpmn:task id="infOO" name="Inform the MPOO about the registration confirmation" />
    <bpmn:task id="infSO" name="Inform the MSPO about the registration confirmation" />
    <bpmn:parallelGateway id="j1" />
    <bpmn:parallelGateway id="sp2" />
    <bpmn:task id="acqN" name="Perform the equipment acquisition and changes of the MPON" />
    <bpmn:task id="acqO" name="Perform the equipment acquisition and changes of the MPOO" />
    <bpmn:parallelGateway id="j2" />
    <bpmn:eventBasedGateway id="evg" />
    <bpmn:intermediateCatchEvent id="evFail" name="Failure of the entire process reported">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="evOk" name="Successful completion reported">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="evTime" name="Maximum time limit passed">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P30D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="infTimeout" name="Inform the MPON about the failure of the overall transaction by deadline" />
    <bpmn:endEvent id="endTimeout" name="Transaction failed by deadline" />
    <bpmn:task id="confFail" name="Confirm the failure of the assignment to the MPON" />
    <bpmn:task id="failOO" name="Inform the MPOO about the failure of the assignment" />
    <bpmn:task id="failSO" name="Inform the MSPO about the failure of the assignment" />
    <bpmn:endEvent id="endFail" name="Assignment failed" />
    <bpmn:task id="assign" name="Assign the MPON" />
    <bpmn:task id="confAss" name="Confirm the assignment to the MPON" />
    <bpmn:task id="assOO" name="Inform the MPOO about the assignment" />
    <bpmn:task id="assSO" name="Inform the MSPO about the assignment" />
    <bpmn:task id="assSP" name="Inform the SP about the assignment" />
    <bpmn:endEvent id="endOk" name="MPON assigned" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="examine" />
    <bpmn:sequenceFlow id="f3" sourceRef="examine" targetRef="dec" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="dec" targetRef="reject" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="dec" targetRef="confirm" />
    <bpmn:sequenceFlow id="f6" sourceRef="reject" targetRef="endRej" />
    <bpmn:sequenceFlow id="f7" sourceRef="confirm" targetRef="sp1" />
    <bpmn:sequenceFlow id="f8" sourceRef="sp1" targetRef="infOO" />
    <bpmn:sequenceFlow id="f9" sourceRef="sp1" targetRef="infSO" />
    <bpmn:sequenceFlow id="f10" sourceRef="infOO" targetRef="j1" />
    <bpmn:sequenceFlow id="f11" sourceRef="infSO" targetRef="j1" />
    <bpmn:sequenceFlow id="f12" sourceRef="j1" targetRef="sp2" />
    <bpmn:sequenceFlow id="f13" sourceRef="sp2" targetRef="acqN" />
    <bpmn:sequenceFlow id="f14" sourceRef="sp2" targetRef="acqO" />
    <bpmn:sequenceFlow id="f15" sourceRef="acqN" targetRef="j2" />
    <bpmn:sequenceFlow id="f16" sourceRef="acqO" targetRef="j2" />
    <bpmn:sequenceFlow id="f17" sourceRef="j2" targetRef="evg" />
    <bpmn:sequenceFlow id="f18" sourceRef="evg" targetRef="evFail" />
    <bpmn:sequenceFlow id="f19" sourceRef="evg" targetRef="evOk" />
    <bpmn:sequenceFlow id="f20" sourceRef="evg" targetRef="evTime" />
    <bpmn:sequenceFlow id="f21" sourceRef="evTime" targetRef="infTimeout" />
    <bpmn:sequenceFlow id="f22" sourceRef="infTimeout" targetRef="endTimeout" />
    <bpmn:sequenceFlow id="f23" sourceRef="evFail" targetRef="confFail" />
    <bpmn:sequenceFlow id="f24" sourceRef="confFail" targetRef="failOO" />
    <bpmn:sequenceFlow id="f25" sourceRef="failOO" targetRef="failSO" />
    <bpmn:sequenceFlow id="f26" sourceRef="failSO" targetRef="endFail" />
    <bpmn:sequenceFlow id="f27" sourceRef="evOk" targetRef="assign" />
    <bpmn:sequenceFlow id="f28" sourceRef="assign" targetRef="confAss" />
    <bpmn:sequenceFlow id="f29" sourceRef="confAss" targetRef="assOO" />
    <bpmn:sequenceFlow id="f30" sourceRef="assOO" targetRef="assSO" />
    <bpmn:sequenceFlow id="f31" sourceRef="assSO" targetRef="assSP" />
    <bpmn:sequenceFlow id="f32" sourceRef="assSP" targetRef="endOk" />
  </bpmn:process>
</bpmn:definitions>
