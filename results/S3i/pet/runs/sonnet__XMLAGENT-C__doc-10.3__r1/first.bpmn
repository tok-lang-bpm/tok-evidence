<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Measuring point operation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_MPOO" name="MPOO">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dereg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmCont</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GO" name="GO">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>oblige</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>equip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMpoo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informMspo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>doneEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Deregistration needed" />
    <bpmn:task id="dereg" name="Deregister at the GO" />
    <bpmn:task id="verify" name="Verify the deregistration" />
    <bpmn:exclusiveGateway id="g1" name="Deregistration confirmed?" />
    <bpmn:endEvent id="rejectEnd" name="Deregistration rejected" />
    <bpmn:task id="prepare" name="Prepare the readmission of the measuring point" />
    <bpmn:exclusiveGateway id="g2" name="Continuation of operations required?" />
    <bpmn:task id="oblige" name="Oblige the MPOO to continue the operations" />
    <bpmn:task id="confirmCont" name="Confirm the continuation" />
    <bpmn:exclusiveGateway id="g3" />
    <bpmn:task id="equip" name="Perform the equipment acquisition and equipment changes" />
    <bpmn:task id="assign" name="Assign the GO as MPO" />
    <bpmn:task id="informMpoo" name="Inform the MPOO about the end and the beginning of the assignment" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="informMspo" name="Inform the MSPO about the assignment of the GO" />
    <bpmn:task id="informSp" name="Inform the SP about the assignment of the GO" />
    <bpmn:parallelGateway id="join" />
    <bpmn:endEvent id="doneEnd" name="Assignment completed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="dereg" />
    <bpmn:sequenceFlow id="f2" sourceRef="dereg" targetRef="verify" />
    <bpmn:sequenceFlow id="f3" sourceRef="verify" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="g1" targetRef="rejectEnd" />
    <bpmn:sequenceFlow id="f5" name="yes" sourceRef="g1" targetRef="prepare" />
    <bpmn:sequenceFlow id="f6" sourceRef="prepare" targetRef="g2" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="g2" targetRef="oblige" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f9" sourceRef="oblige" targetRef="confirmCont" />
    <bpmn:sequenceFlow id="f10" sourceRef="confirmCont" targetRef="g3" />
    <bpmn:sequenceFlow id="f11" sourceRef="g3" targetRef="equip" />
    <bpmn:sequenceFlow id="f12" sourceRef="equip" targetRef="assign" />
    <bpmn:sequenceFlow id="f13" sourceRef="assign" targetRef="informMpoo" />
    <bpmn:sequenceFlow id="f14" sourceRef="informMpoo" targetRef="split" />
    <bpmn:sequenceFlow id="f15" sourceRef="split" targetRef="informMspo" />
    <bpmn:sequenceFlow id="f16" sourceRef="split" targetRef="informSp" />
    <bpmn:sequenceFlow id="f17" sourceRef="informMspo" targetRef="join" />
    <bpmn:sequenceFlow id="f18" sourceRef="informSp" targetRef="join" />
    <bpmn:sequenceFlow id="f19" sourceRef="join" targetRef="doneEnd" />
  </bpmn:process>
</bpmn:definitions>