<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Measuring point administration" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L1" name="SP / PU / GO">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="MPO">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Change requested" />
    <bpmn:startEvent id="s2" name="Change caused by MPO" />
    <bpmn:task id="request" name="Request changes to the MPO" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="review" name="Review the change request" />
    <bpmn:exclusiveGateway id="g1" name="Request confirmed?" />
    <bpmn:task id="reject" name="Reject the change of the measuring point" />
    <bpmn:task id="confirm" name="Confirm the request" />
    <bpmn:task id="perform" name="Perform the measuring point change" />
    <bpmn:exclusiveGateway id="g2" name="Change successful?" />
    <bpmn:task id="report" name="Report the implementation to the SP / PU / GO" />
    <bpmn:task id="notify" name="Notify the SP / PU / GO about the failure of the changes" />
    <bpmn:endEvent id="e1" name="Change rejected" />
    <bpmn:endEvent id="e2" name="Implementation reported" />
    <bpmn:endEvent id="e3" name="Failure notified" />
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="request" />
    <bpmn:sequenceFlow id="f2" sourceRef="request" targetRef="merge" />
    <bpmn:sequenceFlow id="f3" sourceRef="s2" targetRef="merge" />
    <bpmn:sequenceFlow id="f4" sourceRef="merge" targetRef="review" />
    <bpmn:sequenceFlow id="f5" sourceRef="review" targetRef="g1" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="g1" targetRef="reject" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="g1" targetRef="confirm" />
    <bpmn:sequenceFlow id="f8" sourceRef="reject" targetRef="e1" />
    <bpmn:sequenceFlow id="f9" sourceRef="confirm" targetRef="perform" />
    <bpmn:sequenceFlow id="f10" sourceRef="perform" targetRef="g2" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="g2" targetRef="report" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="g2" targetRef="notify" />
    <bpmn:sequenceFlow id="f13" sourceRef="report" targetRef="e2" />
    <bpmn:sequenceFlow id="f14" sourceRef="notify" targetRef="e3" />
  </bpmn:process>
</bpmn:definitions>