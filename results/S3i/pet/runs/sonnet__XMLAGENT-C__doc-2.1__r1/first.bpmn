<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="TELECO" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_CUST" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custrecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>custend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CS" name="Customer Service">
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>measures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gprem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mprem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gsig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mreprio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>senddetail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>creport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rebate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>csend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ES" name="Electronic Service">
        <bpmn:flowNodeRef>signif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SM" name="Service Management">
        <bpmn:flowNodeRef>invest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendrp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smtrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gpath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendperf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>minor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendresol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mkreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recvts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_RP" name="Resource Provisioning">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpanalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rptrouble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendstatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reqrecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tsreport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_BC" name="Billing &amp; Collections">
        <bpmn:flowNodeRef>adjust</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Service degradation perceived" />
    <bpmn:task id="sendlist" name="Send list of problem parameters to Customer Service" />
    <bpmn:task id="enter" name="Enter problem report into system T" />
    <bpmn:task id="compare" name="Compare problem report to customer SLA" />
    <bpmn:task id="measures" name="Determine counter measures and priorities" />
    <bpmn:task id="signif" name="Determine significance of customer" />
    <bpmn:exclusiveGateway id="gprem" name="Customer premium?" />
    <bpmn:task id="fix" name="Link to extra problem fix process" />
    <bpmn:exclusiveGateway id="mprem" />
    <bpmn:exclusiveGateway id="gsig" name="Significance affects counter measures?" />
    <bpmn:exclusiveGateway id="mreprio" />
    <bpmn:task id="detail" name="Create detailed problem report" />
    <bpmn:task id="senddetail" name="Send detailed problem report to Service Management" />
    <bpmn:task id="invest" name="Investigate whether problem is analyzable by Service Management" />
    <bpmn:exclusiveGateway id="gana" name="Analyzable by Service Management?" />
    <bpmn:task id="sendrp" name="Send detailed problem report to Resource Provisioning" />
    <bpmn:task id="smanalyze" name="Perform analysis" />
    <bpmn:task id="smtrouble" name="Create trouble report" />
    <bpmn:task id="check" name="Check for possible problems" />
    <bpmn:exclusiveGateway id="gprob" name="Problem detected?" />
    <bpmn:task id="normal" name="Create normal service execution notification" />
    <bpmn:task id="rpanalyze" name="Analyze problem" />
    <bpmn:task id="rptrouble" name="Create trouble report" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="status" name="Include report in status report" />
    <bpmn:task id="sendstatus" name="Send status report to Service Management" />
    <bpmn:exclusiveGateway id="m3" />
    <bpmn:task id="final" name="Prepare final status report" />
    <bpmn:task id="decide" name="Determine counter measures to take" />
    <bpmn:exclusiveGateway id="gpath" name="Which counter measure is required?" />
    <bpmn:task id="sendperf" name="Send actual service performance to Customer Service" />
    <bpmn:task id="minor" name="Undertake corrective actions" />
    <bpmn:exclusiveGateway id="m4" />
    <bpmn:task id="resol" name="Create problem resolution report" />
    <bpmn:task id="sendresol" name="Send problem resolution report to Customer Service" />
    <bpmn:task id="mkreq" name="Create request for automatic resource restoration" />
    <bpmn:task id="sendreq" name="Send request to Resource Provisioning" />
    <bpmn:intermediateCatchEvent id="recvts" name="Trouble-shooting report received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="reqrecv" name="Restoration request received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timeout" name="2 days passed">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="terminate" name="Terminate process" />
    <bpmn:task id="track" name="Track all possible errors" />
    <bpmn:task id="correct" name="Undertake necessary corrective actions" />
    <bpmn:task id="tsreport" name="Create trouble-shooting report" />
    <bpmn:task id="sendts" name="Send trouble-shooting report to Service Management" />
    <bpmn:endEvent id="rpend" name="Resource Provisioning finished" />
    <bpmn:exclusiveGateway id="m5" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:task id="creport" name="Create report for customer" />
    <bpmn:task id="sendreport" name="Send report to customer" />
    <bpmn:parallelGateway id="p3" />
    <bpmn:task id="rebate" name="Report SLA violation rebate to Billing &amp; Collections" />
    <bpmn:task id="adjust" name="Adjust billing" />
    <bpmn:parallelGateway id="p2" />
    <bpmn:endEvent id="csend" name="Customer Service finished" />
    <bpmn:intermediateCatchEvent id="custrecv" name="Report received">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="custend" name="Customer finished" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sendlist" />
    <bpmn:sequenceFlow id="f2" sourceRef="sendlist" targetRef="enter" />
    <bpmn:sequenceFlow id="f3" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f4" sourceRef="compare" targetRef="mreprio" />
    <bpmn:sequenceFlow id="f4b" sourceRef="mreprio" targetRef="measures" />
    <bpmn:sequenceFlow id="f5" sourceRef="measures" targetRef="signif" />
    <bpmn:sequenceFlow id="f6" sourceRef="signif" targetRef="gprem" />
    <bpmn:sequenceFlow id="f7" name="yes" sourceRef="gprem" targetRef="fix" />
    <bpmn:sequenceFlow id="f8" name="no" sourceRef="gprem" targetRef="mprem" />
    <bpmn:sequenceFlow id="f9" sourceRef="fix" targetRef="mprem" />
    <bpmn:sequenceFlow id="f10" sourceRef="mprem" targetRef="gsig" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="gsig" targetRef="mreprio" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="gsig" targetRef="detail" />
    <bpmn:sequenceFlow id="f13" sourceRef="detail" targetRef="senddetail" />
    <bpmn:sequenceFlow id="f14" sourceRef="senddetail" targetRef="invest" />
    <bpmn:sequenceFlow id="f15" sourceRef="invest" targetRef="gana" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="gana" targetRef="sendrp" />
    <bpmn:sequenceFlow id="f17" name="yes" sourceRef="gana" targetRef="smanalyze" />
    <bpmn:sequenceFlow id="f18" sourceRef="smanalyze" targetRef="smtrouble" />
    <bpmn:sequenceFlow id="f19" sourceRef="smtrouble" targetRef="m3" />
    <bpmn:sequenceFlow id="f20" sourceRef="sendrp" targetRef="check" />
    <bpmn:sequenceFlow id="f21" sourceRef="check" targetRef="gprob" />
    <bpmn:sequenceFlow id="f22" name="no" sourceRef="gprob" targetRef="normal" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="gprob" targetRef="rpanalyze" />
    <bpmn:sequenceFlow id="f24" sourceRef="rpanalyze" targetRef="rptrouble" />
    <bpmn:sequenceFlow id="f25" sourceRef="normal" targetRef="m2" />
    <bpmn:sequenceFlow id="f26" sourceRef="rptrouble" targetRef="m2" />
    <bpmn:sequenceFlow id="f27" sourceRef="m2" targetRef="status" />
    <bpmn:sequenceFlow id="f28" sourceRef="status" targetRef="sendstatus" />
    <bpmn:sequenceFlow id="f29" sourceRef="sendstatus" targetRef="m3" />
    <bpmn:sequenceFlow id="f30" sourceRef="m3" targetRef="final" />
    <bpmn:sequenceFlow id="f31" sourceRef="final" targetRef="decide" />
    <bpmn:sequenceFlow id="f32" sourceRef="decide" targetRef="gpath" />
    <bpmn:sequenceFlow id="f33" name="no problem detected" sourceRef="gpath" targetRef="sendperf" />
    <bpmn:sequenceFlow id="f34" name="minor corrective actions" sourceRef="gpath" targetRef="minor" />
    <bpmn:sequenceFlow id="f35" name="automatic resource restoration" sourceRef="gpath" targetRef="mkreq" />
    <bpmn:sequenceFlow id="f36" sourceRef="minor" targetRef="m4" />
    <bpmn:sequenceFlow id="f37" sourceRef="recvts" targetRef="m4" />
    <bpmn:sequenceFlow id="f38" sourceRef="m4" targetRef="resol" />
    <bpmn:sequenceFlow id="f39" sourceRef="resol" targetRef="sendresol" />
    <bpmn:sequenceFlow id="f40" sourceRef="sendresol" targetRef="m5" />
    <bpmn:sequenceFlow id="f41" sourceRef="sendperf" targetRef="m5" />
    <bpmn:sequenceFlow id="f42" sourceRef="mkreq" targetRef="sendreq" />
    <bpmn:sequenceFlow id="f43" sourceRef="sendreq" targetRef="wait" />
    <bpmn:sequenceFlow id="f43b" sourceRef="sendstatus" targetRef="wait" />
    <bpmn:sequenceFlow id="f44" sourceRef="wait" targetRef="reqrecv" />
    <bpmn:sequenceFlow id="f45" sourceRef="wait" targetRef="timeout" />
    <bpmn:sequenceFlow id="f46" sourceRef="timeout" targetRef="terminate" />
    <bpmn:sequenceFlow id="f47" sourceRef="terminate" targetRef="rpend" />
    <bpmn:sequenceFlow id="f48" sourceRef="reqrecv" targetRef="track" />
    <bpmn:sequenceFlow id="f49" sourceRef="track" targetRef="correct" />
    <bpmn:sequenceFlow id="f50" sourceRef="correct" targetRef="tsreport" />
    <bpmn:sequenceFlow id="f51" sourceRef="tsreport" targetRef="sendts" />
    <bpmn:sequenceFlow id="f52" sourceRef="sendts" targetRef="recvts" />
    <bpmn:sequenceFlow id="f53" sourceRef="m5" targetRef="p1" />
    <bpmn:sequenceFlow id="f54" sourceRef="p1" targetRef="creport" />
    <bpmn:sequenceFlow id="f55" sourceRef="p1" targetRef="rebate" />
    <bpmn:sequenceFlow id="f56" sourceRef="creport" targetRef="sendreport" />
    <bpmn:sequenceFlow id="f57" sourceRef="sendreport" targetRef="p3" />
    <bpmn:sequenceFlow id="f58" sourceRef="p3" targetRef="p2" />
    <bpmn:sequenceFlow id="f59" sourceRef="p3" targetRef="custrecv" />
    <bpmn:sequenceFlow id="f60" sourceRef="rebate" targetRef="adjust" />
    <bpmn:sequenceFlow id="f61" sourceRef="adjust" targetRef="p2" />
    <bpmn:sequenceFlow id="f62" sourceRef="p2" targetRef="csend" />
    <bpmn:sequenceFlow id="f63" sourceRef="custrecv" targetRef="custend" />
  </bpmn:process>
</bpmn:definitions>