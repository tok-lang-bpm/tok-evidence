<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Power supplier" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_CUS" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>days7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endWithdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CS" name="Customer Service">
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>okGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>existsGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeCust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergePrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendConf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mergeAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>importData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endCS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CIS" name="CIS">
        <bpmn:flowNodeRef>checkDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>docsGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendReq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GO" name="Grid Operator">
        <bpmn:flowNodeRef>checkReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>respond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>concGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endConflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transmitMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>computeBill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBillOld</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OLD" name="Old Supplier">
        <bpmn:flowNodeRef>createBill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendBillCus</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Switch-over requested" />
    <bpmn:task id="transmit" name="Transmit customer data" />
    <bpmn:task id="receive" name="Receive customer data" />
    <bpmn:task id="enter" name="Enter customer data object into CRM system" />
    <bpmn:task id="compare" name="Compare customer data with customer data base" />
    <bpmn:exclusiveGateway id="okGw" name="Data complete and plausible?" />
    <bpmn:task id="correct" name="Correct errors using error list" />
    <bpmn:exclusiveGateway id="existsGw" name="Customer exists?" />
    <bpmn:task id="create" name="Create new customer object" />
    <bpmn:exclusiveGateway id="mergeCust" />
    <bpmn:exclusiveGateway id="mergePrep" />
    <bpmn:task id="prepare" name="Prepare contract documents" />
    <bpmn:task id="checkDocs" name="Check contract documents" />
    <bpmn:exclusiveGateway id="docsGw" name="Contract documents generated correctly?" />
    <bpmn:task id="resolve" name="Analyze and resolve issues" />
    <bpmn:task id="sendConf" name="Send confirmation document to customer" />
    <bpmn:task id="sendReq" name="Send request to grid operator" />
    <bpmn:task id="checkReq" name="Check switch-over request for supplier concurrence" />
    <bpmn:task id="respond" name="Transmit response comment" />
    <bpmn:exclusiveGateway id="concGw" name="Supplier concurrence?" />
    <bpmn:task id="informSup" name="Inform involved suppliers and demand conflict resolution" />
    <bpmn:endEvent id="endConflict" name="Conflict handed to suppliers" />
    <bpmn:task id="terminate" name="Terminate sales agreement with old supplier" />
    <bpmn:task id="createContract" name="Create CIS contract" />
    <bpmn:task id="checkContract" name="Check contract details" />
    <bpmn:eventBasedGateway id="evg" />
    <bpmn:intermediateCatchEvent id="confirmed" name="Contract confirmed">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="withdrawn" name="Contract withdrawn">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="days7" name="7 days passed">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endWithdrawn" name="Switch withdrawn" />
    <bpmn:exclusiveGateway id="mergeAcc" />
    <bpmn:parallelGateway id="split" />
    <bpmn:task id="transmitMeter" name="Transmit meter data" />
    <bpmn:task id="importData" name="Import meter data to systems" />
    <bpmn:endEvent id="endCS" name="New customer won" />
    <bpmn:task id="computeBill" name="Compute final billing" />
    <bpmn:task id="sendBillOld" name="Send final billing to old supplier" />
    <bpmn:task id="createBill" name="Create final billing" />
    <bpmn:task id="sendBillCus" name="Send final billing to customer" />
    <bpmn:endEvent id="endCustomer" name="Final billing received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="transmit" />
    <bpmn:sequenceFlow id="f2" sourceRef="transmit" targetRef="receive" />
    <bpmn:sequenceFlow id="f3" sourceRef="receive" targetRef="enter" />
    <bpmn:sequenceFlow id="f4" sourceRef="enter" targetRef="compare" />
    <bpmn:sequenceFlow id="f5" sourceRef="compare" targetRef="okGw" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="okGw" targetRef="correct" />
    <bpmn:sequenceFlow id="f7" sourceRef="correct" targetRef="compare" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="okGw" targetRef="existsGw" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="existsGw" targetRef="create" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="existsGw" targetRef="mergeCust" />
    <bpmn:sequenceFlow id="f11" sourceRef="create" targetRef="mergeCust" />
    <bpmn:sequenceFlow id="f12" sourceRef="mergeCust" targetRef="mergePrep" />
    <bpmn:sequenceFlow id="f13" sourceRef="mergePrep" targetRef="prepare" />
    <bpmn:sequenceFlow id="f14" sourceRef="prepare" targetRef="checkDocs" />
    <bpmn:sequenceFlow id="f15" sourceRef="checkDocs" targetRef="docsGw" />
    <bpmn:sequenceFlow id="f16" name="no" sourceRef="docsGw" targetRef="resolve" />
    <bpmn:sequenceFlow id="f17" sourceRef="resolve" targetRef="mergePrep" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="docsGw" targetRef="sendConf" />
    <bpmn:sequenceFlow id="f19" sourceRef="sendConf" targetRef="sendReq" />
    <bpmn:sequenceFlow id="f20" sourceRef="sendReq" targetRef="checkReq" />
    <bpmn:sequenceFlow id="f21" sourceRef="checkReq" targetRef="respond" />
    <bpmn:sequenceFlow id="f22" sourceRef="respond" targetRef="concGw" />
    <bpmn:sequenceFlow id="f23" name="yes" sourceRef="concGw" targetRef="informSup" />
    <bpmn:sequenceFlow id="f24" sourceRef="informSup" targetRef="endConflict" />
    <bpmn:sequenceFlow id="f25" name="no" sourceRef="concGw" targetRef="terminate" />
    <bpmn:sequenceFlow id="f26" sourceRef="terminate" targetRef="createContract" />
    <bpmn:sequenceFlow id="f27" sourceRef="createContract" targetRef="checkContract" />
    <bpmn:sequenceFlow id="f28" sourceRef="checkContract" targetRef="evg" />
    <bpmn:sequenceFlow id="f29" sourceRef="evg" targetRef="confirmed" />
    <bpmn:sequenceFlow id="f30" sourceRef="evg" targetRef="withdrawn" />
    <bpmn:sequenceFlow id="f31" sourceRef="evg" targetRef="days7" />
    <bpmn:sequenceFlow id="f32" sourceRef="withdrawn" targetRef="endWithdrawn" />
    <bpmn:sequenceFlow id="f33" sourceRef="confirmed" targetRef="mergeAcc" />
    <bpmn:sequenceFlow id="f34" sourceRef="days7" targetRef="mergeAcc" />
    <bpmn:sequenceFlow id="f35" sourceRef="mergeAcc" targetRef="split" />
    <bpmn:sequenceFlow id="f36" sourceRef="split" targetRef="transmitMeter" />
    <bpmn:sequenceFlow id="f37" sourceRef="split" targetRef="computeBill" />
    <bpmn:sequenceFlow id="f38" sourceRef="transmitMeter" targetRef="importData" />
    <bpmn:sequenceFlow id="f39" sourceRef="importData" targetRef="endCS" />
    <bpmn:sequenceFlow id="f40" sourceRef="computeBill" targetRef="sendBillOld" />
    <bpmn:sequenceFlow id="f41" sourceRef="sendBillOld" targetRef="createBill" />
    <bpmn:sequenceFlow id="f42" sourceRef="createBill" targetRef="sendBillCus" />
    <bpmn:sequenceFlow id="f43" sourceRef="sendBillCus" targetRef="endCustomer" />
  </bpmn:process>
</bpmn:definitions>
