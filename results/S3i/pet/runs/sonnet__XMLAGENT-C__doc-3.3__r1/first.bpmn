<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Claims department" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L1" name="Claims officer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>examine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Senior claims officer">
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Claim registered" />
    <bpmn:task id="examine" name="Examine the claim" />
    <bpmn:task id="write" name="Write a settlement recommendation" />
    <bpmn:task id="check" name="Check the recommendation" />
    <bpmn:exclusiveGateway id="ok" name="Claim OK?" />
    <bpmn:endEvent id="end" name="Claim handling proceeds" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="examine" />
    <bpmn:sequenceFlow id="f2" sourceRef="examine" targetRef="write" />
    <bpmn:sequenceFlow id="f3" sourceRef="write" targetRef="check" />
    <bpmn:sequenceFlow id="f4" sourceRef="check" targetRef="ok" />
    <bpmn:sequenceFlow id="f5" name="OK" sourceRef="ok" targetRef="end" />
    <bpmn:sequenceFlow id="f6" name="Not OK" sourceRef="ok" targetRef="write" />
  </bpmn:process>
</bpmn:definitions>