<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Mental health care institute" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="SEC" name="Secretarial office">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="NURSE" name="Nursing officer">
        <bpmn:flowNodeRef>n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="TL" name="Team-leader">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FIRST" name="First intaker">
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SECOND" name="Second intaker">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Notice by telephone received" />
    <bpmn:task id="a1" name="Inquire after the name and residence of the patient" />
    <bpmn:task id="a2" name="Put the doctor through to the nursing officer" />
    <bpmn:task id="n1" name="Make a full inquiry into the mental, health and social state of the patient" />
    <bpmn:task id="n2" name="Record the information on a registration form" />
    <bpmn:task id="n3" name="Hand in the registration form at the secretarial office" />
    <bpmn:task id="a3" name="Store the information in the information system" />
    <bpmn:task id="a4" name="Print the information" />
    <bpmn:exclusiveGateway id="g1" name="New patient?" />
    <bpmn:task id="a5" name="Create a patient file" />
    <bpmn:exclusiveGateway id="g2" />
    <bpmn:task id="a6" name="Store the registration form and the print in the patient file" />
    <bpmn:task id="a7" name="Produce two registration cards" />
    <bpmn:task id="a8" name="Add the patient to the list of new notices" />
    <bpmn:intermediateCatchEvent id="t1" name="Wednesday staff meeting">
      <bpmn:timerEventDefinition><bpmn:timeCycle>0 0 9 * * WED</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t2" name="Assign new patients to a first and second intaker" />
    <bpmn:task id="t3" name="Determine whether the medical file is required" />
    <bpmn:task id="t4" name="Record the assignments on the assignment list" />
    <bpmn:task id="t5" name="Hand the assignment list to the secretarial office" />
    <bpmn:task id="a9" name="Store the assignments in the information system" />
    <bpmn:task id="a10" name="Pass the registration cards to the first and second intaker" />
    <bpmn:parallelGateway id="p1" />
    <bpmn:task id="f1" name="Plan the first meeting with the patient" />
    <bpmn:task id="f2" name="Examine the patient using the standard checklist" />
    <bpmn:task id="f3" name="Register additional observations in a personal notebook" />
    <bpmn:task id="f4" name="Put a copy of the notes in the patient file" />
    <bpmn:task id="f5" name="Add the standard checklist to the patient file" />
    <bpmn:exclusiveGateway id="g3" name="Medical file required?" />
    <bpmn:task id="a11" name="Prepare and send a letter requesting a copy of the medical file" />
    <bpmn:receiveTask id="a12" name="Receive the copy of the medical file" />
    <bpmn:task id="a13" name="Inform the second intaker" />
    <bpmn:task id="a14" name="Add the copy to the patient file" />
    <bpmn:exclusiveGateway id="g4" />
    <bpmn:task id="c1" name="Plan the first meeting with the patient after the medical information" />
    <bpmn:task id="c2" name="Record observations with a dictaphone" />
    <bpmn:task id="c3" name="Examine the patient" />
    <bpmn:task id="a15" name="Type out the tapes" />
    <bpmn:task id="a16" name="Add the information to the patient file" />
    <bpmn:parallelGateway id="p2" />
    <bpmn:task id="a17" name="Put the patient on the list of patients with both meetings held" />
    <bpmn:task id="a18" name="Provide the team-leader with the list of patients" />
    <bpmn:task id="t6" name="Formulate a treatment plan" />
    <bpmn:endEvent id="e1" name="Intake procedure ended" />
    <bpmn:sequenceFlow id="q1" sourceRef="s1" targetRef="a1" />
    <bpmn:sequenceFlow id="q2" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="q3" sourceRef="a2" targetRef="n1" />
    <bpmn:sequenceFlow id="q4" sourceRef="n1" targetRef="n2" />
    <bpmn:sequenceFlow id="q5" sourceRef="n2" targetRef="n3" />
    <bpmn:sequenceFlow id="q6" sourceRef="n3" targetRef="a3" />
    <bpmn:sequenceFlow id="q7" sourceRef="a3" targetRef="a4" />
    <bpmn:sequenceFlow id="q8" sourceRef="a4" targetRef="g1" />
    <bpmn:sequenceFlow id="q9" name="yes" sourceRef="g1" targetRef="a5" />
    <bpmn:sequenceFlow id="q10" name="no" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="q11" sourceRef="a5" targetRef="g2" />
    <bpmn:sequenceFlow id="q12" sourceRef="g2" targetRef="a6" />
    <bpmn:sequenceFlow id="q13" sourceRef="a6" targetRef="a7" />
    <bpmn:sequenceFlow id="q14" sourceRef="a7" targetRef="a8" />
    <bpmn:sequenceFlow id="q15" sourceRef="a8" targetRef="t1" />
    <bpmn:sequenceFlow id="q16" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="q17" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="q18" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="q19" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="q20" sourceRef="t5" targetRef="a9" />
    <bpmn:sequenceFlow id="q21" sourceRef="a9" targetRef="a10" />
    <bpmn:sequenceFlow id="q22" sourceRef="a10" targetRef="p1" />
    <bpmn:sequenceFlow id="q23" sourceRef="p1" targetRef="f1" />
    <bpmn:sequenceFlow id="q24" sourceRef="f1" targetRef="f2" />
    <bpmn:sequenceFlow id="q25" sourceRef="f2" targetRef="f3" />
    <bpmn:sequenceFlow id="q26" sourceRef="f3" targetRef="f4" />
    <bpmn:sequenceFlow id="q27" sourceRef="f4" targetRef="f5" />
    <bpmn:sequenceFlow id="q28" sourceRef="f5" targetRef="p2" />
    <bpmn:sequenceFlow id="q29" sourceRef="p1" targetRef="g3" />
    <bpmn:sequenceFlow id="q30" name="yes" sourceRef="g3" targetRef="a11" />
    <bpmn:sequenceFlow id="q31" name="no" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="q32" sourceRef="a11" targetRef="a12" />
    <bpmn:sequenceFlow id="q33" sourceRef="a12" targetRef="a13" />
    <bpmn:sequenceFlow id="q34" sourceRef="a13" targetRef="a14" />
    <bpmn:sequenceFlow id="q35" sourceRef="a14" targetRef="g4" />
    <bpmn:sequenceFlow id="q36" sourceRef="g4" targetRef="c1" />
    <bpmn:sequenceFlow id="q37" sourceRef="c1" targetRef="c3" />
    <bpmn:sequenceFlow id="q38" sourceRef="c3" targetRef="c2" />
    <bpmn:sequenceFlow id="q39" sourceRef="c2" targetRef="a15" />
    <bpmn:sequenceFlow id="q40" sourceRef="a15" targetRef="a16" />
    <bpmn:sequenceFlow id="q41" sourceRef="a16" targetRef="p2" />
    <bpmn:sequenceFlow id="q42" sourceRef="p2" targetRef="a17" />
    <bpmn:sequenceFlow id="q43" sourceRef="a17" targetRef="a18" />
    <bpmn:sequenceFlow id="q44" sourceRef="a18" targetRef="t6" />
    <bpmn:sequenceFlow id="q45" sourceRef="t6" targetRef="e1" />
  </bpmn:process>
</bpmn:definitions>