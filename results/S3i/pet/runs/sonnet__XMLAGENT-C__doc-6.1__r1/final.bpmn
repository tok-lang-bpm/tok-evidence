<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="ACME AG" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="L_sec" name="Secretariat">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_acc" name="Accounting Employee">
        <bpmn:flowNodeRef>identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkitems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>forward2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ccm" name="Cost Center Manager">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_com" name="Commercial Manager">
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amount</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_board" name="Board">
        <bpmn:flowNodeRef>checkb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Invoice received" />
    <bpmn:task id="receive" name="Receive the invoice in the central inbox" />
    <bpmn:task id="forward" name="Forward the invoice to an accounting employee" />
    <bpmn:task id="identify" name="Identify the charging supplier and create the invoice instance" />
    <bpmn:task id="checkitems" name="Check the invoice items and note the cost centers and managers on the docket" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:task id="review" name="Review the invoice items for accuracy" />
    <bpmn:exclusiveGateway id="ok" name="Everything in order?" />
    <bpmn:task id="note" name="Note the AP on the docket" />
    <bpmn:exclusiveGateway id="more" name="More cost center managers on the docket?" />
    <bpmn:task id="reject" name="Reject the AP with a note and statement on the docket" />
    <bpmn:task id="clarify" name="Clarify the inconsistencies with the vendor" />
    <bpmn:task id="forward2" name="Forward the invoice copy to the commercial manager" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="audit" name="Make the commercial audit" />
    <bpmn:exclusiveGateway id="complaint" name="Complaint?" />
    <bpmn:task id="resolve" name="Resolve the complaint with the supplier" />
    <bpmn:task id="approve" name="Issue the approval for payment" />
    <bpmn:exclusiveGateway id="amount" name="Amount exceeds EUR 20?" />
    <bpmn:task id="checkb" name="Check the invoice again" />
    <bpmn:exclusiveGateway id="m3" />
    <bpmn:task id="pay" name="Give the payment instructions" />
    <bpmn:task id="close" name="Close the instance in ACME Financial Accounting" />
    <bpmn:endEvent id="end" name="Invoice processed" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="forward" />
    <bpmn:sequenceFlow id="f3" sourceRef="forward" targetRef="identify" />
    <bpmn:sequenceFlow id="f4" sourceRef="identify" targetRef="checkitems" />
    <bpmn:sequenceFlow id="f5" sourceRef="checkitems" targetRef="m1" />
    <bpmn:sequenceFlow id="f6" sourceRef="m1" targetRef="review" />
    <bpmn:sequenceFlow id="f7" sourceRef="review" targetRef="ok" />
    <bpmn:sequenceFlow id="f8" name="yes" sourceRef="ok" targetRef="note" />
    <bpmn:sequenceFlow id="f9" name="no" sourceRef="ok" targetRef="reject" />
    <bpmn:sequenceFlow id="f10" sourceRef="note" targetRef="more" />
    <bpmn:sequenceFlow id="f11" name="yes" sourceRef="more" targetRef="m1" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="more" targetRef="forward2" />
    <bpmn:sequenceFlow id="f13" sourceRef="reject" targetRef="clarify" />
    <bpmn:sequenceFlow id="f14" sourceRef="clarify" targetRef="m1" />
    <bpmn:sequenceFlow id="f15" sourceRef="forward2" targetRef="m2" />
    <bpmn:sequenceFlow id="f16" sourceRef="m2" targetRef="audit" />
    <bpmn:sequenceFlow id="f17" sourceRef="audit" targetRef="complaint" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="complaint" targetRef="resolve" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="complaint" targetRef="approve" />
    <bpmn:sequenceFlow id="f20" sourceRef="resolve" targetRef="m2" />
    <bpmn:sequenceFlow id="f21" sourceRef="approve" targetRef="amount" />
    <bpmn:sequenceFlow id="f22" name="yes" sourceRef="amount" targetRef="checkb" />
    <bpmn:sequenceFlow id="f23" name="no" sourceRef="amount" targetRef="m3" />
    <bpmn:sequenceFlow id="f24" sourceRef="checkb" targetRef="m3" />
    <bpmn:sequenceFlow id="f25" sourceRef="m3" targetRef="pay" />
    <bpmn:sequenceFlow id="f26" sourceRef="pay" targetRef="close" />
    <bpmn:sequenceFlow id="f27" sourceRef="close" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
