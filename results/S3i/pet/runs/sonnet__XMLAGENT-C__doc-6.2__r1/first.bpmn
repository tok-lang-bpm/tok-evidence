<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Order handling" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="assembler" name="Assembler AG">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supplier" name="Supplier">
        <bpmn:flowNodeRef>process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="First of each month">
      <bpmn:timerEventDefinition><bpmn:timeCycle>0 0 0 1 * ?</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="send" name="Send the order to the supplier" />
    <bpmn:task id="process" name="Process the order" />
    <bpmn:task id="invoice" name="Send an invoice to Assembler AG" />
    <bpmn:task id="receive" name="Receive the invoice" />
    <bpmn:endEvent id="end" name="Invoice received" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f2" sourceRef="send" targetRef="process" />
    <bpmn:sequenceFlow id="f3" sourceRef="process" targetRef="invoice" />
    <bpmn:sequenceFlow id="f4" sourceRef="invoice" targetRef="receive" />
    <bpmn:sequenceFlow id="f5" sourceRef="receive" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>