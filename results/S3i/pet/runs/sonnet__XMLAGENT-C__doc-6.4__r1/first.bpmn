<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Company" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="l_mkt" name="Marketing staff">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_src</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>buy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exhib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>know</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_srcm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_cc" name="Call center staff">
        <bpmn:flowNodeRef>call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>det</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_bud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_left</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_head" name="Head of development">
        <bpmn:flowNodeRef>acq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_acq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_sales" name="Sales representative">
        <bpmn:flowNodeRef>g_tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_presm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>weeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>callback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_waitm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_quote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_pre" name="Pre-sales employee">
        <bpmn:flowNodeRef>techpres</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Customer needed" />
    <bpmn:exclusiveGateway id="g_src" name="How are details obtained?" />
    <bpmn:task id="buy" name="Buy contact details" />
    <bpmn:task id="exhib" name="Participate in exhibitions" />
    <bpmn:task id="know" name="Use personal contact" />
    <bpmn:exclusiveGateway id="g_srcm" />
    <bpmn:task id="call" name="Call the customer" />
    <bpmn:task id="det" name="Determine contact person and budget" />
    <bpmn:task id="ask" name="Ask whether customer is interested" />
    <bpmn:exclusiveGateway id="g_int" name="Customer interested?" />
    <bpmn:exclusiveGateway id="g_bud" name="Budget huge?" />
    <bpmn:task id="leave" name="Leave the customer alone" />
    <bpmn:endEvent id="end_left" name="Customer left alone" />
    <bpmn:task id="acq" name="Acquire the customer personally" />
    <bpmn:endEvent id="end_acq" name="Customer acquisition tried" />
    <bpmn:exclusiveGateway id="g_tech" name="Technical presentation?" />
    <bpmn:task id="pres" name="Give online presentation" />
    <bpmn:task id="techpres" name="Give technical online presentation" />
    <bpmn:exclusiveGateway id="g_presm" />
    <bpmn:eventBasedGateway id="g_wait" />
    <bpmn:intermediateCatchEvent id="back" name="Customer contacts us">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="weeks" name="2 weeks passed">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P14D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="callback" name="Call the customer again" />
    <bpmn:exclusiveGateway id="g_waitm" />
    <bpmn:task id="quote" name="Create quotation" />
    <bpmn:endEvent id="end_quote" name="Quotation created" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="g_src" />
    <bpmn:sequenceFlow id="f2" name="bought" sourceRef="g_src" targetRef="buy" />
    <bpmn:sequenceFlow id="f3" name="exhibition" sourceRef="g_src" targetRef="exhib" />
    <bpmn:sequenceFlow id="f4" name="personal contact" sourceRef="g_src" targetRef="know" />
    <bpmn:sequenceFlow id="f5" sourceRef="buy" targetRef="g_srcm" />
    <bpmn:sequenceFlow id="f6" sourceRef="exhib" targetRef="g_srcm" />
    <bpmn:sequenceFlow id="f7" sourceRef="know" targetRef="g_srcm" />
    <bpmn:sequenceFlow id="f8" sourceRef="g_srcm" targetRef="call" />
    <bpmn:sequenceFlow id="f9" sourceRef="call" targetRef="det" />
    <bpmn:sequenceFlow id="f10" sourceRef="det" targetRef="ask" />
    <bpmn:sequenceFlow id="f11" sourceRef="ask" targetRef="g_int" />
    <bpmn:sequenceFlow id="f12" name="yes" sourceRef="g_int" targetRef="g_tech" />
    <bpmn:sequenceFlow id="f13" name="no" sourceRef="g_int" targetRef="g_bud" />
    <bpmn:sequenceFlow id="f14" name="yes" sourceRef="g_bud" targetRef="acq" />
    <bpmn:sequenceFlow id="f15" name="no" sourceRef="g_bud" targetRef="leave" />
    <bpmn:sequenceFlow id="f16" sourceRef="leave" targetRef="end_left" />
    <bpmn:sequenceFlow id="f17" sourceRef="acq" targetRef="end_acq" />
    <bpmn:sequenceFlow id="f18" name="no" sourceRef="g_tech" targetRef="pres" />
    <bpmn:sequenceFlow id="f19" name="yes" sourceRef="g_tech" targetRef="techpres" />
    <bpmn:sequenceFlow id="f20" sourceRef="pres" targetRef="g_presm" />
    <bpmn:sequenceFlow id="f21" sourceRef="techpres" targetRef="g_presm" />
    <bpmn:sequenceFlow id="f22" sourceRef="g_presm" targetRef="g_wait" />
    <bpmn:sequenceFlow id="f23" sourceRef="g_wait" targetRef="back" />
    <bpmn:sequenceFlow id="f24" sourceRef="g_wait" targetRef="weeks" />
    <bpmn:sequenceFlow id="f25" sourceRef="weeks" targetRef="callback" />
    <bpmn:sequenceFlow id="f26" sourceRef="back" targetRef="g_waitm" />
    <bpmn:sequenceFlow id="f27" sourceRef="callback" targetRef="g_waitm" />
    <bpmn:sequenceFlow id="f28" sourceRef="g_waitm" targetRef="quote" />
    <bpmn:sequenceFlow id="f29" sourceRef="quote" targetRef="end_quote" />
  </bpmn:process>
</bpmn:definitions>