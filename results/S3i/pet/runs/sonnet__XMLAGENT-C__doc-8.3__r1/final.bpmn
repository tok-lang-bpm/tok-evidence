<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="pool" name="Organisation" processRef="proc" />
  </bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="head" name="Head of the functional department">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="hr" name="Personnel Department">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>describe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Personnel requirements detected" />
    <bpmn:task id="report" name="Report the vacancy" />
    <bpmn:exclusiveGateway id="m1" />
    <bpmn:exclusiveGateway id="q" name="Questions about tasks and requirements?" />
    <bpmn:task id="clarify" name="Clarify the tasks and requirements" />
    <bpmn:exclusiveGateway id="m2" />
    <bpmn:task id="describe" name="Describe the job" />
    <bpmn:task id="review" name="Review the job description" />
    <bpmn:exclusiveGateway id="corr" name="Corrections needed?" />
    <bpmn:task id="corrections" name="Ask for corrections" />
    <bpmn:task id="approve" name="Approve the job description" />
    <bpmn:endEvent id="end" name="Job description approved" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="report" />
    <bpmn:sequenceFlow id="f2" sourceRef="report" targetRef="m1" />
    <bpmn:sequenceFlow id="f3" sourceRef="m1" targetRef="q" />
    <bpmn:sequenceFlow id="f4" name="yes" sourceRef="q" targetRef="clarify" />
    <bpmn:sequenceFlow id="f5" sourceRef="clarify" targetRef="m1" />
    <bpmn:sequenceFlow id="f6" name="no" sourceRef="q" targetRef="m2" />
    <bpmn:sequenceFlow id="f7" sourceRef="m2" targetRef="describe" />
    <bpmn:sequenceFlow id="f8" sourceRef="describe" targetRef="review" />
    <bpmn:sequenceFlow id="f9" sourceRef="review" targetRef="corr" />
    <bpmn:sequenceFlow id="f10" name="yes" sourceRef="corr" targetRef="corrections" />
    <bpmn:sequenceFlow id="f11" sourceRef="corrections" targetRef="m2" />
    <bpmn:sequenceFlow id="f12" name="no" sourceRef="corr" targetRef="approve" />
    <bpmn:sequenceFlow id="f13" sourceRef="approve" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
