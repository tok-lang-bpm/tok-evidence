<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="definitions" targetNamespace="http://example.org/bpmn">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="POOL" name="Mortgage organisation" processRef="PROCESS" />
  </bpmn:collaboration>
  <bpmn:process id="PROCESS" isExecutable="false">
    <bpmn:laneSet id="LANES">
      <bpmn:lane id="CSR" name="Customer Service Representative">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noanswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>move</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>moved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Mortgage offer ready" />
    <bpmn:task id="send" name="Send the Mortgage offer to the customer" />
    <bpmn:eventBasedGateway id="wait" />
    <bpmn:intermediateCatchEvent id="declined" name="Customer declines the mortgage">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="returned" name="Customer sends back the offer documents">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="noanswer" name="2 weeks without answer">
      <bpmn:timerEventDefinition><bpmn:timeDuration>P14D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="complete" name="All prerequisite documents provided?" />
    <bpmn:task id="move" name="Move the case to administration" />
    <bpmn:task id="request" name="Request outstanding documents from the customer" />
    <bpmn:exclusiveGateway id="merge" />
    <bpmn:task id="update" name="Update the case details" />
    <bpmn:task id="archive" name="Archive the work" />
    <bpmn:endEvent id="cancelled" name="Case cancelled" />
    <bpmn:endEvent id="moved" name="Case moved to administration" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="send" />
    <bpmn:sequenceFlow id="f2" sourceRef="send" targetRef="wait" />
    <bpmn:sequenceFlow id="f3" sourceRef="wait" targetRef="declined" />
    <bpmn:sequenceFlow id="f4" sourceRef="wait" targetRef="returned" />
    <bpmn:sequenceFlow id="f5" sourceRef="wait" targetRef="noanswer" />
    <bpmn:sequenceFlow id="f6" sourceRef="declined" targetRef="merge" />
    <bpmn:sequenceFlow id="f7" sourceRef="noanswer" targetRef="merge" />
    <bpmn:sequenceFlow id="f8" sourceRef="returned" targetRef="complete" />
    <bpmn:sequenceFlow id="f9" name="yes" sourceRef="complete" targetRef="move" />
    <bpmn:sequenceFlow id="f10" name="no" sourceRef="complete" targetRef="request" />
    <bpmn:sequenceFlow id="f11" sourceRef="request" targetRef="wait" />
    <bpmn:sequenceFlow id="f12" sourceRef="move" targetRef="moved" />
    <bpmn:sequenceFlow id="f13" sourceRef="merge" targetRef="update" />
    <bpmn:sequenceFlow id="f14" sourceRef="update" targetRef="archive" />
    <bpmn:sequenceFlow id="f15" sourceRef="archive" targetRef="cancelled" />
  </bpmn:process>
</bpmn:definitions>