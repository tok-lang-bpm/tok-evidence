tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Record order in system"
task Task_2 "Collect customer information"
task Task_3 "Guide customer in selecting product/service"
task Task_4 "Provide quote"
task Task_5 "Receive customer inquiry"
task Task_6 "Place order"
task Task_7 "Address customer concerns or questions"
task Task_8 "Send order confirmation to customer"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "start"
end EndEvent_1 "end"

flow Task_8 -> ExclusiveGateway_1 id=SequenceFlow_1
flow ExclusiveGateway_3 -> EndEvent_1 id=SequenceFlow_2
flow ParallelGateway_2 -> Task_7 id=SequenceFlow_3
flow Task_1 -> Task_8 id=SequenceFlow_4
flow Task_7 -> ParallelGateway_1 id=SequenceFlow_5
flow ParallelGateway_1 -> ExclusiveGateway_4 id=SequenceFlow_6
flow ExclusiveGateway_1 -> ExclusiveGateway_3 id=SequenceFlow_7
flow Task_2 -> ParallelGateway_1 id=SequenceFlow_8
flow StartEvent_1 -> Task_5 id=SequenceFlow_9
flow ParallelGateway_2 -> Task_2 id=SequenceFlow_10
flow ExclusiveGateway_4 -> ExclusiveGateway_3 id=SequenceFlow_11
flow ExclusiveGateway_2 -> ExclusiveGateway_1 id=SequenceFlow_12
flow Task_6 -> Task_1 id=SequenceFlow_13
flow ExclusiveGateway_4 -> Task_3 id=SequenceFlow_14
flow Task_4 -> ExclusiveGateway_2 id=SequenceFlow_15
flow ExclusiveGateway_2 -> Task_6 id=SequenceFlow_16
flow Task_5 -> ParallelGateway_2 id=SequenceFlow_17
flow Task_3 -> Task_4 id=SequenceFlow_18
