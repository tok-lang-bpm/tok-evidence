tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Sign contract" duration="exp(10m)"
task Task_2 "Conduct site visit" duration="exp(10m)"
task Task_3 "Execute contract" duration="exp(10m)"
task Task_4 "Identify need for new supplier or vendor" duration="exp(10m)"
task Task_5 "Evaluate proposal" duration="exp(10m)"
task Task_6 "Receive supplier proposals" duration="exp(10m)"
task Task_7 "Begin contract negotiations" duration="exp(10m)"
task Task_8 "Select supplier" duration="exp(10m)"
task Task_9 "Conduct interview" duration="exp(10m)"
task Task_10 "Issue request for proposals (RFP)" duration="exp(10m)"
task Task_11 "Onboard supplier" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
start StartEvent_1 "start"
end EndEvent_1 "end"

flow Task_2 -> ExclusiveGateway_1 id=SequenceFlow_1
flow ExclusiveGateway_4 -> ExclusiveGateway_1 id=SequenceFlow_2 p=0.333
flow ExclusiveGateway_4 -> Task_9 id=SequenceFlow_3 p=0.333
flow ExclusiveGateway_2 -> Task_8 id=SequenceFlow_4 p=0.500
flow Task_3 -> EndEvent_1 id=SequenceFlow_5
flow Task_6 -> ExclusiveGateway_3 id=SequenceFlow_6
flow StartEvent_1 -> Task_4 id=SequenceFlow_7
flow ExclusiveGateway_3 -> Task_5 id=SequenceFlow_8
flow Task_9 -> ExclusiveGateway_1 id=SequenceFlow_9
flow Task_7 -> Task_1 id=SequenceFlow_10
flow ExclusiveGateway_4 -> Task_2 id=SequenceFlow_11 p=0.334
flow ExclusiveGateway_1 -> ExclusiveGateway_2 id=SequenceFlow_12
flow Task_1 -> Task_11 id=SequenceFlow_13
flow Task_10 -> Task_6 id=SequenceFlow_14
flow Task_5 -> ExclusiveGateway_4 id=SequenceFlow_15
flow Task_11 -> Task_3 id=SequenceFlow_16
flow ExclusiveGateway_2 -> ExclusiveGateway_3 id=SequenceFlow_17 p=0.500
flow Task_8 -> Task_7 id=SequenceFlow_18
flow Task_4 -> Task_10 id=SequenceFlow_19

simulate cases=500 seed=20261031 arrival="exp(1h)"
