tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Successful delivery"
task Task_2 "Customer places order online"
task Task_3 "Hand over order to logistics provider"
task Task_4 "Customer places order over the phone"
task Task_5 "Monitor shipment"
task Task_6 "Pick and pack items"
task Task_7 "Generate and send order confirmation"
task Task_8 "Process customer feedback or returns"
task Task_9 "Generate shipping label"
task Task_10 "Send tracking information to customer"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "start"
end EndEvent_1 "end"

flow ParallelGateway_1 -> Task_9 id=SequenceFlow_1
flow ExclusiveGateway_1 -> Task_2 id=SequenceFlow_2
flow Task_2 -> ExclusiveGateway_2 id=SequenceFlow_3
flow StartEvent_1 -> ExclusiveGateway_1 id=SequenceFlow_4
flow Task_1 -> ExclusiveGateway_3 id=SequenceFlow_5
flow Task_10 -> ExclusiveGateway_4 id=SequenceFlow_6
flow ExclusiveGateway_2 -> Task_7 id=SequenceFlow_7
flow Task_4 -> ExclusiveGateway_2 id=SequenceFlow_8
flow Task_7 -> ParallelGateway_1 id=SequenceFlow_9
flow Task_8 -> ExclusiveGateway_5 id=SequenceFlow_10
flow ParallelGateway_1 -> Task_6 id=SequenceFlow_11
flow Task_5 -> ExclusiveGateway_6 id=SequenceFlow_12
flow Task_9 -> ParallelGateway_2 id=SequenceFlow_13
flow Task_6 -> ParallelGateway_2 id=SequenceFlow_14
flow ExclusiveGateway_1 -> Task_4 id=SequenceFlow_15
flow ExclusiveGateway_3 -> Task_8 id=SequenceFlow_16
flow ExclusiveGateway_6 -> Task_1 id=SequenceFlow_17
flow ExclusiveGateway_6 -> ExclusiveGateway_4 id=SequenceFlow_18
flow ExclusiveGateway_5 -> EndEvent_1 id=SequenceFlow_19
flow ExclusiveGateway_3 -> ExclusiveGateway_5 id=SequenceFlow_20
flow ParallelGateway_2 -> Task_3 id=SequenceFlow_21
flow ExclusiveGateway_4 -> Task_5 id=SequenceFlow_22
flow Task_3 -> Task_10 id=SequenceFlow_23
