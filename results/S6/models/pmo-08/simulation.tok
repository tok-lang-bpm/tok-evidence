tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Propose corrective actions" duration="exp(10m)"
task Task_2 "Log report into tracking system" duration="exp(10m)"
task Task_3 "Close incident report" duration="exp(10m)"
task Task_4 "Change policy" duration="exp(10m)"
task Task_5 "Assign report to appropriate team" duration="exp(10m)"
task Task_6 "Report incident" duration="exp(10m)"
task Task_7 "Conduct training" duration="exp(10m)"
task Task_8 "Gather necessary information" duration="exp(10m)"
task Task_9 "Identify cause of incident" duration="exp(10m)"
task Task_10 "Notify all stakeholders" duration="exp(10m)"
task Task_11 "Implement fix" duration="exp(10m)"
task Task_12 "Conduct follow-up" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "start"
end EndEvent_1 "end"

flow Task_4 -> ExclusiveGateway_1 id=SequenceFlow_1
flow ExclusiveGateway_2 -> Task_11 id=SequenceFlow_2 p=0.333
flow ExclusiveGateway_1 -> Task_12 id=SequenceFlow_3
flow StartEvent_1 -> Task_6 id=SequenceFlow_4
flow ParallelGateway_1 -> Task_1 id=SequenceFlow_5
flow Task_8 -> ParallelGateway_1 id=SequenceFlow_6
flow Task_2 -> Task_5 id=SequenceFlow_7
flow ParallelGateway_2 -> Task_8 id=SequenceFlow_8
flow Task_12 -> Task_3 id=SequenceFlow_9
flow Task_10 -> EndEvent_1 id=SequenceFlow_10
flow ExclusiveGateway_2 -> Task_4 id=SequenceFlow_11 p=0.333
flow Task_9 -> ParallelGateway_1 id=SequenceFlow_12
flow Task_3 -> Task_10 id=SequenceFlow_13
flow Task_11 -> ExclusiveGateway_1 id=SequenceFlow_14
flow Task_6 -> Task_2 id=SequenceFlow_15
flow Task_1 -> ExclusiveGateway_2 id=SequenceFlow_16
flow Task_7 -> ExclusiveGateway_1 id=SequenceFlow_17
flow Task_5 -> ParallelGateway_2 id=SequenceFlow_18
flow ParallelGateway_2 -> Task_9 id=SequenceFlow_19
flow ExclusiveGateway_2 -> Task_7 id=SequenceFlow_20 p=0.334

simulate cases=500 seed=20261031 arrival="exp(1h)"
