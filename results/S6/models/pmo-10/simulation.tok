tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Install the solution" duration="exp(10m)"
task Task_2 "Assess compatibility" duration="exp(10m)"
task Task_3 "Evaluate cost and resource needs" duration="exp(10m)"
task Task_4 "Procure necessary tools or licenses" duration="exp(10m)"
task Task_5 "Submit IT solution request" duration="exp(10m)"
task Task_6 "Test solution" duration="exp(10m)"
task Task_7 "Roll out solution to requesting department" duration="exp(10m)"
task Task_8 "Provide training" duration="exp(10m)"
task Task_9 "Provide support for troubleshooting" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6
xor ExclusiveGateway_7
xor ExclusiveGateway_8
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "start"
end EndEvent_1 "end"

flow Task_9 -> ExclusiveGateway_3 id=SequenceFlow_1
flow ParallelGateway_2 -> ExclusiveGateway_6 id=SequenceFlow_2
flow Task_4 -> Task_1 id=SequenceFlow_3
flow ParallelGateway_4 -> ExclusiveGateway_5 id=SequenceFlow_4
flow ExclusiveGateway_4 -> ParallelGateway_4 id=SequenceFlow_5
flow ParallelGateway_1 -> Task_2 id=SequenceFlow_6
flow ParallelGateway_2 -> ExclusiveGateway_7 id=SequenceFlow_7
flow Task_6 -> Task_7 id=SequenceFlow_8
flow ExclusiveGateway_2 -> Task_9 id=SequenceFlow_9
flow ExclusiveGateway_1 -> ExclusiveGateway_5 id=SequenceFlow_10 p=0.500
flow Task_2 -> ParallelGateway_3 id=SequenceFlow_11
flow Task_3 -> ParallelGateway_3 id=SequenceFlow_12
flow ExclusiveGateway_1 -> Task_4 id=SequenceFlow_13 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_8 id=SequenceFlow_14 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_2 id=SequenceFlow_15 p=0.500
flow ExclusiveGateway_7 -> Task_8 id=SequenceFlow_16 p=0.500
flow Task_5 -> ParallelGateway_1 id=SequenceFlow_17
flow ParallelGateway_3 -> ExclusiveGateway_1 id=SequenceFlow_18
flow ExclusiveGateway_5 -> EndEvent_1 id=SequenceFlow_19
flow StartEvent_1 -> Task_5 id=SequenceFlow_20
flow Task_1 -> Task_6 id=SequenceFlow_21
flow Task_7 -> ParallelGateway_2 id=SequenceFlow_22
flow Task_8 -> ExclusiveGateway_4 id=SequenceFlow_23
flow ExclusiveGateway_7 -> ExclusiveGateway_4 id=SequenceFlow_24 p=0.500
flow ExclusiveGateway_6 -> ExclusiveGateway_2 id=SequenceFlow_25 p=0.500
flow ExclusiveGateway_8 -> ParallelGateway_4 id=SequenceFlow_26
flow ParallelGateway_1 -> Task_3 id=SequenceFlow_27
flow ExclusiveGateway_6 -> ExclusiveGateway_8 id=SequenceFlow_28 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
