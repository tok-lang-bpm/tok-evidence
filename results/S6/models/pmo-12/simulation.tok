tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Transition into new role" duration="exp(10m)"
task Task_2 "Create personal development plan" duration="exp(10m)"
task Task_3 "Consider employee for promotion or new role" duration="exp(10m)"
task Task_4 "Conducts formal performance review" duration="exp(10m)"
task Task_5 "Identify development needs or career aspirations" duration="exp(10m)"
task Task_6 "Work on skill enhancement" duration="exp(10m)"
task Task_7 "Adjust compensation" duration="exp(10m)"
task Task_8 "Receive feedback and evaluation from supervisors" duration="exp(10m)"
task Task_9 "Approve promotion" duration="exp(10m)"
task Task_10 "Set new responsibilities" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "start"
end EndEvent_1 "end"

flow Task_7 -> ParallelGateway_3 id=SequenceFlow_1
flow ExclusiveGateway_2 -> ExclusiveGateway_5 id=SequenceFlow_2 p=0.500
flow ParallelGateway_4 -> ExclusiveGateway_4 id=SequenceFlow_3
flow ParallelGateway_2 -> Task_10 id=SequenceFlow_4
flow Task_10 -> ParallelGateway_3 id=SequenceFlow_5
flow ExclusiveGateway_4 -> Task_6 id=SequenceFlow_6
flow StartEvent_1 -> Task_5 id=SequenceFlow_7
flow ExclusiveGateway_6 -> ParallelGateway_1 id=SequenceFlow_8 p=0.500
flow ExclusiveGateway_5 -> Task_8 id=SequenceFlow_9
flow Task_1 -> ExclusiveGateway_3 id=SequenceFlow_10
flow ParallelGateway_3 -> Task_1 id=SequenceFlow_11
flow Task_4 -> ExclusiveGateway_1 id=SequenceFlow_12
flow ParallelGateway_2 -> Task_7 id=SequenceFlow_13
flow ExclusiveGateway_3 -> EndEvent_1 id=SequenceFlow_14
flow Task_6 -> ExclusiveGateway_6 id=SequenceFlow_15
flow ExclusiveGateway_1 -> Task_9 id=SequenceFlow_16 p=0.500
flow Task_9 -> ParallelGateway_2 id=SequenceFlow_17
flow ParallelGateway_4 -> ExclusiveGateway_5 id=SequenceFlow_18
flow ExclusiveGateway_6 -> ExclusiveGateway_4 id=SequenceFlow_19 p=0.500
flow ExclusiveGateway_1 -> ExclusiveGateway_3 id=SequenceFlow_20 p=0.500
flow Task_3 -> Task_4 id=SequenceFlow_21
flow Task_8 -> ExclusiveGateway_2 id=SequenceFlow_22
flow Task_2 -> ParallelGateway_4 id=SequenceFlow_23
flow ExclusiveGateway_2 -> ParallelGateway_1 id=SequenceFlow_24 p=0.500
flow Task_5 -> Task_2 id=SequenceFlow_25
flow ParallelGateway_1 -> Task_3 id=SequenceFlow_26

simulate cases=500 seed=20261031 arrival="exp(1h)"
