tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Resolve complaint"
task Task_2 "Approve and notify customer"
task Task_3 "Process reimbursement"
task Task_4 "Provide feedback"
task Task_5 "Log complaint"
task Task_6 "Assign complaint to relevant department"
task Task_7 "File complaint"
task Task_8 "Reject and notify customer"
task Task_9 "Review complaint details"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
start StartEvent_1 "start"
end EndEvent_1 "end"

flow StartEvent_1 -> Task_7 id=SequenceFlow_1
flow ExclusiveGateway_3 -> Task_1 id=SequenceFlow_2
flow Task_1 -> ExclusiveGateway_4 id=SequenceFlow_3
flow ExclusiveGateway_4 -> Task_4 id=SequenceFlow_4
flow ExclusiveGateway_1 -> EndEvent_1 id=SequenceFlow_5
flow ExclusiveGateway_4 -> ExclusiveGateway_1 id=SequenceFlow_6
flow ExclusiveGateway_2 -> Task_2 id=SequenceFlow_7
flow Task_8 -> ExclusiveGateway_3 id=SequenceFlow_8
flow Task_5 -> Task_6 id=SequenceFlow_9
flow Task_9 -> ExclusiveGateway_2 id=SequenceFlow_10
flow Task_4 -> ExclusiveGateway_1 id=SequenceFlow_11
flow Task_7 -> Task_5 id=SequenceFlow_12
flow ExclusiveGateway_2 -> Task_8 id=SequenceFlow_13
flow Task_3 -> ExclusiveGateway_3 id=SequenceFlow_14
flow Task_2 -> Task_3 id=SequenceFlow_15
flow Task_6 -> Task_9 id=SequenceFlow_16
