tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Conduct self-assessment" duration="exp(10m)"
task Task_2 "Make necessary corrections or improvements" duration="exp(10m)"
task Task_3 "Issue official documents" duration="exp(10m)"
task Task_4 "Conduct external audit" duration="exp(10m)"
task Task_5 "Award certification" duration="exp(10m)"
task Task_6 "Schedule compliance audit" duration="exp(10m)"
task Task_7 "Identify gaps or issues" duration="exp(10m)"
task Task_8 "Prepare documentation" duration="exp(10m)"
task Task_9 "Gather evidence" duration="exp(10m)"
task Task_10 "Conduct final audit" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "start"
end EndEvent_1 "end"

flow Task_9 -> ParallelGateway_2 id=SequenceFlow_1
flow ParallelGateway_1 -> Task_1 id=SequenceFlow_2
flow Task_3 -> ExclusiveGateway_2 id=SequenceFlow_3
flow ParallelGateway_2 -> Task_4 id=SequenceFlow_4
flow ExclusiveGateway_2 -> EndEvent_1 id=SequenceFlow_5
flow ExclusiveGateway_1 -> Task_5 id=SequenceFlow_6 p=0.500
flow Task_7 -> Task_2 id=SequenceFlow_7
flow Task_4 -> Task_7 id=SequenceFlow_8
flow Task_6 -> ParallelGateway_1 id=SequenceFlow_9
flow Task_8 -> ParallelGateway_2 id=SequenceFlow_10
flow Task_1 -> ParallelGateway_2 id=SequenceFlow_11
flow Task_5 -> Task_3 id=SequenceFlow_12
flow StartEvent_1 -> Task_6 id=SequenceFlow_13
flow Task_2 -> Task_10 id=SequenceFlow_14
flow ParallelGateway_1 -> Task_9 id=SequenceFlow_15
flow ExclusiveGateway_1 -> ExclusiveGateway_2 id=SequenceFlow_16 p=0.500
flow ParallelGateway_1 -> Task_8 id=SequenceFlow_17
flow Task_10 -> ExclusiveGateway_1 id=SequenceFlow_18

simulate cases=500 seed=20261031 arrival="exp(1h)"
