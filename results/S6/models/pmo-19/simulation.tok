tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "Select items" duration="exp(10m)"
task Task_2 "Set payment method" duration="exp(10m)"
task Task_3 "Select free reward" duration="exp(10m)"
task Task_4 "Deliver items" duration="exp(10m)"
task Task_5 "Pay" duration="exp(10m)"
task Task_6 "Login" duration="exp(10m)"
task Task_7 "Return items" duration="exp(10m)"
task Task_8 "Complete installment agreement" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "start"
end EndEvent_1 "end"

flow ExclusiveGateway_2 -> Task_7 id=SequenceFlow_1 p=0.500
flow StartEvent_1 -> Task_6 id=SequenceFlow_2
flow Task_3 -> ParallelGateway_3 id=SequenceFlow_3
flow Task_8 -> ExclusiveGateway_1 id=SequenceFlow_4
flow ExclusiveGateway_1 -> ParallelGateway_3 id=SequenceFlow_5
flow ParallelGateway_2 -> Task_3 id=SequenceFlow_6
flow Task_1 -> ParallelGateway_2 id=SequenceFlow_7
flow ParallelGateway_3 -> ExclusiveGateway_3 id=SequenceFlow_8
flow Task_2 -> ParallelGateway_1 id=SequenceFlow_9
flow ParallelGateway_4 -> Task_1 id=SequenceFlow_10
flow Task_7 -> ExclusiveGateway_3 id=SequenceFlow_11
flow ExclusiveGateway_3 -> Task_4 id=SequenceFlow_12
flow ExclusiveGateway_4 -> Task_8 id=SequenceFlow_13 p=0.500
flow Task_6 -> ParallelGateway_4 id=SequenceFlow_14
flow ParallelGateway_1 -> ExclusiveGateway_4 id=SequenceFlow_15
flow ExclusiveGateway_2 -> EndEvent_1 id=SequenceFlow_16 p=0.500
flow Task_5 -> ExclusiveGateway_1 id=SequenceFlow_17
flow ParallelGateway_2 -> ParallelGateway_1 id=SequenceFlow_18
flow ExclusiveGateway_4 -> Task_5 id=SequenceFlow_19 p=0.500
flow Task_4 -> ExclusiveGateway_2 id=SequenceFlow_20
flow ParallelGateway_4 -> Task_2 id=SequenceFlow_21

simulate cases=500 seed=20261031 arrival="exp(1h)"
