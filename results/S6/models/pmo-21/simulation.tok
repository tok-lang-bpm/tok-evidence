tok 0.5 id=Definitions_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL collaboration=Collaboration_1

pool Participant_1 "Dispatch of goods Computer Hardware Shop" process=Process_1 process-name=""
  lane Lane_1 "Logistics"
    task Task_1 "Insure parcel" duration="exp(10m)"
  lane Lane_2 "Secretary"
    task Task_2 "Write package label" duration="exp(10m)"
    task Task_3 "Clarify shipment method" duration="exp(10m)"
    task Task_4 "Get 3 offers from logistic companies" duration="exp(10m)"
    task Task_5 "Select logistic company and place order" duration="exp(10m)"
    xor ExclusiveGateway_1 "Special sandling?"
    xor ExclusiveGateway_2
    and ParallelGateway_1
    or InclusiveGateway_1
    or InclusiveGateway_2
    start StartEvent_1 "Ship goods"
  lane Lane_3 "Warehouse"
    task Task_6 "Package goods" duration="exp(10m)"
    task Task_7 "Prepare for picking up goods" duration="exp(10m)"
    xor ExclusiveGateway_3
    end EndEvent_1 "Shipment prepared"

flow ExclusiveGateway_1 -> InclusiveGateway_1 "no" id=SequenceFlow_1 p=0.500
flow InclusiveGateway_1 -> Task_1 "If insurance necessary" id=SequenceFlow_2 p=0.5
flow InclusiveGateway_1 -> Task_2 "always" id=SequenceFlow_3 p=0.5
flow Task_2 -> InclusiveGateway_2 id=SequenceFlow_4
flow Task_1 -> InclusiveGateway_2 id=SequenceFlow_5
flow StartEvent_1 -> ParallelGateway_1 id=SequenceFlow_6
flow ParallelGateway_1 -> Task_3 id=SequenceFlow_7
flow Task_3 -> ExclusiveGateway_1 id=SequenceFlow_8
flow ExclusiveGateway_1 -> Task_4 "yes" id=SequenceFlow_9 p=0.500
flow Task_4 -> Task_5 id=SequenceFlow_10
flow Task_5 -> ExclusiveGateway_2 id=SequenceFlow_11
flow InclusiveGateway_2 -> ExclusiveGateway_2 id=SequenceFlow_12
flow ExclusiveGateway_2 -> ExclusiveGateway_3 id=SequenceFlow_13
flow Task_6 -> ExclusiveGateway_3 id=SequenceFlow_14
flow ExclusiveGateway_3 -> Task_7 id=SequenceFlow_15
flow Task_7 -> EndEvent_1 id=SequenceFlow_16
flow ParallelGateway_1 -> Task_6 id=SequenceFlow_17

simulate cases=500 seed=20261031 arrival="exp(1h)"
