tok 0.5 id=Definitions_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL collaboration=Collaboration_1

pool Participant_1 "Recourse Clerk" process=Process_1 process-name=""
  task Task_1 "check case"
  task Task_2 "send request for payment"
  task Task_3 "close case"
  task Task_4 "send reminder"
  task Task_5 "check reasoning"
  task Task_6 "close case"
  task Task_7 "hand over to collection agency"
  task Task_8 "make booking"
  task Task_9 "close case"
  xor ExclusiveGateway_1 "recourse possible?"
  xor ExclusiveGateway_2 "OK?"
  eventgw EventBasedGateway_1
  start StartEvent_1 "probable recourse detected" message
  end EndEvent_1 "case closed"
  end EndEvent_2 "case closed"
  end EndEvent_3 "case open"
  end EndEvent_4 "case closed"
  catch IntermediateCatchEvent_1 "disagreement letter received" message
  catch IntermediateCatchEvent_2 "Reminder is due" timer
  catch IntermediateCatchEvent_3 "Money received" message

flow StartEvent_1 -> Task_1 id=SequenceFlow_1
flow Task_1 -> ExclusiveGateway_1 id=SequenceFlow_2
flow ExclusiveGateway_1 -> Task_2 "yes" id=SequenceFlow_3
flow ExclusiveGateway_1 -> Task_3 "no" id=SequenceFlow_4
flow Task_3 -> EndEvent_1 id=SequenceFlow_5
flow Task_2 -> Task_4 id=SequenceFlow_6
flow Task_4 -> EventBasedGateway_1 id=SequenceFlow_7
flow EventBasedGateway_1 -> IntermediateCatchEvent_1 id=SequenceFlow_8
flow IntermediateCatchEvent_1 -> Task_5 id=SequenceFlow_9
flow Task_5 -> ExclusiveGateway_2 id=SequenceFlow_10
flow ExclusiveGateway_2 -> Task_6 "yes" id=SequenceFlow_11
flow Task_6 -> EndEvent_2 id=SequenceFlow_12
flow EventBasedGateway_1 -> IntermediateCatchEvent_2 id=SequenceFlow_13
flow IntermediateCatchEvent_2 -> Task_7 id=SequenceFlow_14
flow ExclusiveGateway_2 -> Task_7 "no" id=SequenceFlow_15
flow Task_7 -> EndEvent_3 id=SequenceFlow_16
flow EventBasedGateway_1 -> IntermediateCatchEvent_3 id=SequenceFlow_17
flow IntermediateCatchEvent_3 -> Task_8 id=SequenceFlow_18
flow Task_8 -> Task_9 id=SequenceFlow_19
flow Task_9 -> EndEvent_4 id=SequenceFlow_20
