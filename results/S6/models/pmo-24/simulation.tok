tok 0.5 id=Definitions_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL collaboration=Collaboration_1

pool Participant_1 "Guest food consumption" process=Process_1 process-name=""
  task Task_1 "Enter restaurant" duration="exp(10m)"
  task Task_2 "Choose dish" duration="exp(10m)"
  task Task_3 "Place order" duration="exp(10m)"
  task Task_4 "Pay money" duration="exp(10m)"
  task Task_5 "Take buzzer" duration="exp(10m)"
  task Task_6 "Get meal" duration="exp(10m)"
  task Task_7 "Eat meal" duration="exp(10m)"
  start StartEvent_1 "Hunger noticed" condition
  end EndEvent_1 "Not hungry anymore"
  catch IntermediateCatchEvent_1 "wait for turn" condition
  catch IntermediateCatchEvent_2 "Meal ready" message

pool Participant_2 "Employee order processing" process=Process_2 process-name=""
  task Task_8 "Enter order" duration="exp(10m)"
  task Task_9 "Collect money" duration="exp(10m)"
  task Task_10 "Set up buzzer" duration="exp(10m)"
  task Task_11 "Hand over buzzer" duration="exp(10m)"
  task Task_12 "Inform chef" duration="exp(10m)"
  task Task_13 "Set off buzzer" duration="exp(10m)"
  task Task_14 "Hand over meal" duration="exp(10m)"
  task Task_15 "Call guest" duration="exp(10m)"
  eventgw EventBasedGateway_1
  start StartEvent_2 "Order received" message
  end EndEvent_2 "Order processed"
  catch IntermediateCatchEvent_3 "Meal ready" message
  catch IntermediateCatchEvent_4 "Guest appears" message
  catch IntermediateCatchEvent_5 "5 minutes" timer

pool Participant_3 "Chef meal preparation" process=Process_3 process-name=""
  task Task_16 "Prepare meal" duration="exp(10m)"
  task Task_17 "Place meal in hatch" duration="exp(10m)"
  task Task_18 "Inform employee" duration="exp(10m)"
  start StartEvent_3 "Meal needed" message
  end EndEvent_3 "Meal prepared"

flow StartEvent_1 -> Task_1 id=SequenceFlow_1
flow Task_1 -> Task_2 id=SequenceFlow_2
flow Task_2 -> IntermediateCatchEvent_1 id=SequenceFlow_3
flow IntermediateCatchEvent_1 -> Task_3 id=SequenceFlow_4
flow Task_3 -> Task_4 id=SequenceFlow_5
flow Task_4 -> Task_5 id=SequenceFlow_6
flow Task_5 -> IntermediateCatchEvent_2 id=SequenceFlow_7
flow IntermediateCatchEvent_2 -> Task_6 id=SequenceFlow_8
flow Task_6 -> Task_7 id=SequenceFlow_9
flow Task_7 -> EndEvent_1 id=SequenceFlow_10
flow StartEvent_2 -> Task_8 id=SequenceFlow_11
flow Task_8 -> Task_9 id=SequenceFlow_12
flow Task_9 -> Task_10 id=SequenceFlow_13
flow Task_10 -> Task_11 id=SequenceFlow_14
flow Task_11 -> Task_12 id=SequenceFlow_15
flow Task_12 -> IntermediateCatchEvent_3 id=SequenceFlow_16
flow IntermediateCatchEvent_3 -> Task_13 id=SequenceFlow_17
flow Task_13 -> EventBasedGateway_1 id=SequenceFlow_18
flow EventBasedGateway_1 -> IntermediateCatchEvent_4 id=SequenceFlow_19
flow IntermediateCatchEvent_4 -> Task_14 id=SequenceFlow_20
flow Task_14 -> EndEvent_2 id=SequenceFlow_21
flow EventBasedGateway_1 -> IntermediateCatchEvent_5 id=SequenceFlow_22
flow IntermediateCatchEvent_5 -> Task_15 id=SequenceFlow_23
flow Task_15 -> EventBasedGateway_1 id=SequenceFlow_24
flow StartEvent_3 -> Task_16 id=SequenceFlow_25
flow Task_16 -> Task_17 id=SequenceFlow_26
flow Task_17 -> Task_18 id=SequenceFlow_27
flow Task_18 -> EndEvent_3 id=SequenceFlow_28

message Task_3 -> StartEvent_2 id=MessageFlow_1
message Task_9 -> Task_4 id=MessageFlow_2
message Task_4 -> Task_9 id=MessageFlow_3
message Task_11 -> Task_5 id=MessageFlow_4
message Task_13 -> IntermediateCatchEvent_2 id=MessageFlow_5
message Task_6 -> IntermediateCatchEvent_4 id=MessageFlow_6
message Task_14 -> Task_6 id=MessageFlow_7
message Task_12 -> StartEvent_3 id=MessageFlow_8
message Task_18 -> IntermediateCatchEvent_3 id=MessageFlow_9
message Task_15 -> Participant_1 id=MessageFlow_10

simulate cases=500 seed=20261031 arrival="exp(1h)"
