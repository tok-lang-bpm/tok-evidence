tok 0.5 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Submit job application" duration="exp(10m)"
user UserTask_2 "Report" duration="exp(10m)"
user UserTask_3 "Interview candidate" duration="exp(10m)"
user UserTask_4 "Evaluate job application" duration="exp(10m)"
user UserTask_5 "Enter probation phase" duration="exp(10m)"
user UserTask_6 "Evaluate company" duration="exp(10m)"
user UserTask_7 "Evaluate employee" duration="exp(10m)"
user UserTask_8 "Do temp-to-perm" duration="exp(10m)"
user UserTask_9 "Send rejection Email" duration="exp(10m)"
service ServiceTask_1 "Confirm job application" duration="exp(10m)"
service ServiceTask_2 "Process job application" duration="exp(10m)"
service ServiceTask_3 "Send autogenerated rejection Email" duration="exp(10m)"
service ServiceTask_4 "Publish applicant's review" duration="exp(10m)"
xor ExclusiveGateway_1 "Is job application accepted?"
xor ExclusiveGateway_2 "Is job application accepted?"
xor ExclusiveGateway_3 "Is candidate selected?"
xor ExclusiveGateway_4 "Is one of the rating results C or less?"
xor ExclusiveGateway_5
xor ExclusiveGateway_6
xor ExclusiveGateway_7
xor ExclusiveGateway_8
xor ExclusiveGateway_9 "Report Required?"
xor ExclusiveGateway_10
xor ExclusiveGateway_11 "Is any job offer received?"
xor ExclusiveGateway_12
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "Job needed"
end EndEvent_1 "Job found"
catch IntermediateCatchEvent_1 "One year" timer

flow ParallelGateway_1 -> ServiceTask_1 id=SequenceFlow_1
flow ParallelGateway_1 -> ServiceTask_2 id=SequenceFlow_2
flow ServiceTask_1 -> ParallelGateway_2 id=SequenceFlow_3
flow ServiceTask_2 -> ParallelGateway_2 id=SequenceFlow_4
flow ExclusiveGateway_1 -> UserTask_4 "Yes" id=SequenceFlow_5 p=0.500
flow UserTask_4 -> ExclusiveGateway_2 id=SequenceFlow_6
flow ExclusiveGateway_2 -> ExclusiveGateway_12 "Yes" id=SequenceFlow_7 p=0.500
flow UserTask_3 -> ExclusiveGateway_3 id=SequenceFlow_8
flow ExclusiveGateway_3 -> UserTask_5 "Yes" id=SequenceFlow_9 p=0.500
flow UserTask_5 -> ParallelGateway_3 id=SequenceFlow_10
flow ParallelGateway_3 -> UserTask_6 id=SequenceFlow_11
flow UserTask_6 -> ParallelGateway_4 id=SequenceFlow_12
flow ParallelGateway_3 -> UserTask_7 id=SequenceFlow_13
flow ExclusiveGateway_4 -> UserTask_8 "No" id=SequenceFlow_14 p=0.500
flow UserTask_7 -> ParallelGateway_4 id=SequenceFlow_15
flow ServiceTask_3 -> ExclusiveGateway_6 id=SequenceFlow_16
flow ExclusiveGateway_2 -> UserTask_9 "No" id=SequenceFlow_17 p=0.500
flow ExclusiveGateway_1 -> ServiceTask_3 "No" id=SequenceFlow_18 p=0.500
flow ExclusiveGateway_7 -> ExclusiveGateway_6 id=SequenceFlow_19
flow UserTask_9 -> ExclusiveGateway_7 id=SequenceFlow_20
flow ExclusiveGateway_8 -> ExclusiveGateway_7 id=SequenceFlow_21
flow UserTask_8 -> IntermediateCatchEvent_1 id=SequenceFlow_22
flow ParallelGateway_2 -> ExclusiveGateway_1 id=SequenceFlow_23
flow UserTask_1 -> ExclusiveGateway_9 id=SequenceFlow_24
flow StartEvent_1 -> ExclusiveGateway_5 id=SequenceFlow_25
flow UserTask_2 -> ExclusiveGateway_10 id=SequenceFlow_26
flow ExclusiveGateway_9 -> ExclusiveGateway_10 "No" id=SequenceFlow_27 p=0.500
flow ExclusiveGateway_9 -> UserTask_2 "Yes" id=SequenceFlow_28 p=0.500
flow ExclusiveGateway_10 -> ParallelGateway_1 id=SequenceFlow_29
flow ExclusiveGateway_5 -> ExclusiveGateway_8 id=SequenceFlow_30
flow ExclusiveGateway_12 -> UserTask_3 id=SequenceFlow_31
flow ExclusiveGateway_6 -> ExclusiveGateway_11 id=SequenceFlow_32
flow ExclusiveGateway_11 -> UserTask_1 "No" id=SequenceFlow_33 p=0.500
flow ExclusiveGateway_11 -> ExclusiveGateway_12 "Yes" id=SequenceFlow_34 p=0.500
flow ExclusiveGateway_4 -> ExclusiveGateway_5 "Yes" id=SequenceFlow_35 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_8 "No" id=SequenceFlow_36 p=0.500
flow ParallelGateway_4 -> ExclusiveGateway_4 id=SequenceFlow_37
flow IntermediateCatchEvent_1 -> ServiceTask_4 id=SequenceFlow_38
flow ServiceTask_4 -> EndEvent_1 id=SequenceFlow_39

simulate cases=500 seed=20261031 arrival="exp(1h)"
