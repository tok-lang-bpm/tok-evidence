tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

service ServiceTask_1 "receive confirmation from employer" duration="exp(10m)"
service ServiceTask_2 "fetch information about leave models" duration="exp(10m)"
service ServiceTask_3 "fetch information about financial support" duration="exp(10m)"
service ServiceTask_4 "check if all necessary documents gathered" duration="exp(10m)"
manual ManualTask_1 "select appropriate model" duration="exp(10m)"
manual ManualTask_2 "notify employer" duration="exp(10m)"
manual ManualTask_3 "notify social security" duration="exp(10m)"
manual ManualTask_4 "prepare necessary documents for leave" duration="exp(10m)"
manual ManualTask_5 "do maternity/paternity leave" duration="exp(10m)"
manual ManualTask_6 "decide if extend leave or return to work" duration="exp(10m)"
manual ManualTask_7 "apply for financial support" duration="exp(10m)"
manual ManualTask_8 "decide if apply for financial support" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2
xor ExclusiveGateway_3
xor ExclusiveGateway_4
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1
end EndEvent_1 "return to job"

flow ManualTask_3 -> ParallelGateway_2 id=SequenceFlow_1
flow ManualTask_2 -> ParallelGateway_2 id=SequenceFlow_2
flow ParallelGateway_2 -> ServiceTask_1 id=SequenceFlow_3
flow ManualTask_5 -> ManualTask_6 id=SequenceFlow_4
flow ManualTask_6 -> ExclusiveGateway_1 id=SequenceFlow_5
flow ExclusiveGateway_1 -> EndEvent_1 id=SequenceFlow_6 p=0.500
flow StartEvent_1 -> ParallelGateway_3 id=SequenceFlow_7
flow ParallelGateway_3 -> ServiceTask_3 id=SequenceFlow_8
flow ParallelGateway_3 -> ServiceTask_2 id=SequenceFlow_9
flow ServiceTask_3 -> ParallelGateway_4 id=SequenceFlow_10
flow ServiceTask_2 -> ParallelGateway_4 id=SequenceFlow_11
flow ParallelGateway_4 -> ManualTask_1 id=SequenceFlow_12
flow ExclusiveGateway_2 -> ManualTask_7 id=SequenceFlow_13 p=0.500
flow ManualTask_7 -> ExclusiveGateway_3 id=SequenceFlow_14
flow ManualTask_8 -> ExclusiveGateway_2 id=SequenceFlow_15
flow ExclusiveGateway_2 -> ExclusiveGateway_3 id=SequenceFlow_16 p=0.500
flow ServiceTask_1 -> ServiceTask_4 id=SequenceFlow_17
flow ServiceTask_4 -> ExclusiveGateway_4 id=SequenceFlow_18
flow ExclusiveGateway_4 -> ManualTask_5 id=SequenceFlow_19 p=0.500
flow ParallelGateway_1 -> ManualTask_2 id=SequenceFlow_20
flow ParallelGateway_1 -> ManualTask_3 id=SequenceFlow_21
flow ExclusiveGateway_4 -> ManualTask_4 id=SequenceFlow_22 p=0.500
flow ExclusiveGateway_3 -> ManualTask_4 id=SequenceFlow_23
flow ManualTask_4 -> ParallelGateway_1 id=SequenceFlow_24
flow ManualTask_1 -> ManualTask_8 id=SequenceFlow_25
flow ExclusiveGateway_1 -> ManualTask_4 id=SequenceFlow_26 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
