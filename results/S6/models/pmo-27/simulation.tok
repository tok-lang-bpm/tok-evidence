tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

service ServiceTask_1 "Run diagnostics/find problems" duration="exp(10m)"
service ServiceTask_2 "Notify labor inspectorate" duration="exp(10m)"
service ServiceTask_3 "Notify insurance" duration="exp(10m)"
service ServiceTask_4 "Notify insurance about the death" duration="exp(10m)"
manual ManualTask_1 "Schedule safety training" duration="exp(10m)"
manual ManualTask_2 "Inform employer" duration="exp(10m)"
manual ManualTask_3 "Stay informed about the person's condition" duration="exp(10m)"
manual ManualTask_4 "Fix the problem" duration="exp(10m)"
manual ManualTask_5 "Identify potential issues" duration="exp(10m)"
manual ManualTask_6 "Inform relatives" duration="exp(10m)"
manual ManualTask_7 "Fix the threat" duration="exp(10m)"
xor ExclusiveGateway_1 "Type of event?"
xor ExclusiveGateway_2 "Death or serious injury?"
xor ExclusiveGateway_3 "Safety authorities informed?"
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6 "Person insured?"
xor ExclusiveGateway_7
xor ExclusiveGateway_8
xor ExclusiveGateway_9 "Is the person dead? (Death as a result of an accident)"
xor ExclusiveGateway_10
xor ExclusiveGateway_11 "Did the person die and was insured?"
xor ExclusiveGateway_12
xor ExclusiveGateway_13 "Employee training reqired?"
xor ExclusiveGateway_14
xor ExclusiveGateway_15
xor ExclusiveGateway_16 "More issues?"
xor ExclusiveGateway_17
xor ExclusiveGateway_18 "More issues?"
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "Issue occurs"
end EndEvent_1 "Issue resolved"

flow StartEvent_1 -> ManualTask_2 id=SequenceFlow_1
flow ExclusiveGateway_2 -> ExclusiveGateway_5 "No" id=SequenceFlow_2 p=0.500
flow ExclusiveGateway_2 -> ManualTask_6 "Yes" id=SequenceFlow_3 p=0.500
flow ServiceTask_2 -> ExclusiveGateway_4 id=SequenceFlow_4
flow ExclusiveGateway_3 -> ServiceTask_2 "No" id=SequenceFlow_5 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "Yes" id=SequenceFlow_6 p=0.500
flow ParallelGateway_1 -> ExclusiveGateway_6 id=SequenceFlow_7
flow ServiceTask_3 -> ExclusiveGateway_7 id=SequenceFlow_8
flow ParallelGateway_1 -> ExclusiveGateway_3 id=SequenceFlow_9
flow ExclusiveGateway_4 -> ParallelGateway_2 id=SequenceFlow_10
flow ExclusiveGateway_7 -> ParallelGateway_2 id=SequenceFlow_11
flow ExclusiveGateway_6 -> ServiceTask_3 "Yes" id=SequenceFlow_12 p=0.500
flow ManualTask_2 -> ExclusiveGateway_1 id=SequenceFlow_13
flow ExclusiveGateway_8 -> EndEvent_1 id=SequenceFlow_14
flow ExclusiveGateway_5 -> ExclusiveGateway_8 id=SequenceFlow_15
flow ParallelGateway_2 -> ExclusiveGateway_9 id=SequenceFlow_16
flow ExclusiveGateway_10 -> ExclusiveGateway_5 id=SequenceFlow_17
flow ExclusiveGateway_9 -> ExclusiveGateway_10 "Yes" id=SequenceFlow_18 p=0.500
flow ManualTask_3 -> ExclusiveGateway_11 id=SequenceFlow_19
flow ExclusiveGateway_12 -> ExclusiveGateway_10 id=SequenceFlow_20
flow ServiceTask_4 -> ExclusiveGateway_12 id=SequenceFlow_21
flow ExclusiveGateway_11 -> ServiceTask_4 "Yes" id=SequenceFlow_22 p=0.500
flow ManualTask_1 -> ExclusiveGateway_14 id=SequenceFlow_23
flow ExclusiveGateway_13 -> ExclusiveGateway_14 "No" id=SequenceFlow_24 p=0.500
flow ExclusiveGateway_13 -> ManualTask_1 "Yes" id=SequenceFlow_25 p=0.500
flow ExclusiveGateway_1 -> ExclusiveGateway_2 "Event that almost led to an accident" id=SequenceFlow_26 p=0.250
flow ExclusiveGateway_14 -> ExclusiveGateway_8 id=SequenceFlow_27
flow ServiceTask_1 -> ExclusiveGateway_15 id=SequenceFlow_28
flow ExclusiveGateway_15 -> ManualTask_4 id=SequenceFlow_29
flow ManualTask_4 -> ExclusiveGateway_16 id=SequenceFlow_30
flow ExclusiveGateway_16 -> ExclusiveGateway_8 "No" id=SequenceFlow_31 p=0.500
flow ExclusiveGateway_16 -> ExclusiveGateway_15 "Yes" id=SequenceFlow_32 p=0.500
flow ExclusiveGateway_17 -> ManualTask_7 id=SequenceFlow_33
flow ManualTask_7 -> ExclusiveGateway_18 id=SequenceFlow_34
flow ExclusiveGateway_18 -> ExclusiveGateway_17 "Yes" id=SequenceFlow_35 p=0.500
flow ManualTask_5 -> ExclusiveGateway_17 id=SequenceFlow_36
flow ExclusiveGateway_9 -> ManualTask_3 "No" id=SequenceFlow_37 p=0.500
flow ExclusiveGateway_1 -> ExclusiveGateway_13 "Defect in protective system" id=SequenceFlow_38 p=0.250
flow ExclusiveGateway_6 -> ExclusiveGateway_7 "No" id=SequenceFlow_39 p=0.500
flow ExclusiveGateway_1 -> ServiceTask_1 "Accident at work" id=SequenceFlow_40 p=0.250
flow ExclusiveGateway_1 -> ManualTask_5 "Serious/imminent threat to safety" id=SequenceFlow_41 p=0.250
flow ManualTask_6 -> ParallelGateway_1 id=SequenceFlow_42
flow ExclusiveGateway_18 -> ExclusiveGateway_8 id=SequenceFlow_43 p=0.500
flow ExclusiveGateway_11 -> ExclusiveGateway_12 "No" id=SequenceFlow_44 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
