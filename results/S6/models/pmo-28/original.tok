tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Register for internship"
user UserTask_2 "Enter topic"
user UserTask_3 "Enter expected income"
user UserTask_4 "Enter experience"
user UserTask_5 "Enter hobbies"
user UserTask_6 "Accept offer"
user UserTask_7 "Deny offer"
user UserTask_8 "Publish your application"
user UserTask_9 "Begin internship"
user UserTask_10 "Write at least 3 status updates every week"
user UserTask_11 "End internship"
service ServiceTask_1 "Recieve offer"
service ServiceTask_2 "Invalidate all other offers"
service ServiceTask_3 "Recommend company to a list of friends via twitter api"
service ServiceTask_4 "Recieve 3 status updates from the company"
xor ExclusiveGateway_1 "Accept offer?"
xor ExclusiveGateway_2
xor ExclusiveGateway_3 "Recommend company?"
xor ExclusiveGateway_4
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
and ParallelGateway_5
and ParallelGateway_6
or InclusiveGateway_1
or InclusiveGateway_2
start StartEvent_1 "Internship process is started"
end EndEvent_1 "Internship succesful"

flow StartEvent_1 -> UserTask_1 id=SequenceFlow_1
flow InclusiveGateway_1 -> UserTask_5 id=SequenceFlow_2
flow UserTask_5 -> InclusiveGateway_2 id=SequenceFlow_3
flow ServiceTask_1 -> ExclusiveGateway_1 id=SequenceFlow_4
flow ExclusiveGateway_2 -> ServiceTask_1 id=SequenceFlow_5
flow UserTask_7 -> ExclusiveGateway_2 id=SequenceFlow_6
flow UserTask_8 -> ExclusiveGateway_2 id=SequenceFlow_7
flow ParallelGateway_2 -> UserTask_6 id=SequenceFlow_8
flow ParallelGateway_2 -> ServiceTask_2 id=SequenceFlow_9
flow UserTask_6 -> ParallelGateway_1 id=SequenceFlow_10
flow ServiceTask_2 -> ParallelGateway_1 id=SequenceFlow_11
flow UserTask_9 -> ParallelGateway_3 id=SequenceFlow_12
flow InclusiveGateway_1 -> UserTask_4 id=SequenceFlow_13
flow InclusiveGateway_1 -> UserTask_3 id=SequenceFlow_14
flow UserTask_4 -> InclusiveGateway_2 id=SequenceFlow_15
flow UserTask_3 -> InclusiveGateway_2 id=SequenceFlow_16
flow ParallelGateway_3 -> UserTask_10 id=SequenceFlow_17
flow ParallelGateway_3 -> ServiceTask_4 id=SequenceFlow_18
flow ServiceTask_4 -> ParallelGateway_4 id=SequenceFlow_19
flow UserTask_10 -> ParallelGateway_4 id=SequenceFlow_20
flow ExclusiveGateway_3 -> ServiceTask_3 "Yes" id=SequenceFlow_21
flow ParallelGateway_1 -> UserTask_9 id=SequenceFlow_22
flow UserTask_11 -> ExclusiveGateway_3 id=SequenceFlow_23
flow UserTask_1 -> ParallelGateway_5 id=SequenceFlow_24
flow ParallelGateway_4 -> UserTask_11 id=SequenceFlow_25
flow ParallelGateway_5 -> UserTask_2 id=SequenceFlow_26
flow InclusiveGateway_2 -> ParallelGateway_6 id=SequenceFlow_27
flow UserTask_2 -> ParallelGateway_6 id=SequenceFlow_28
flow ParallelGateway_5 -> InclusiveGateway_1 id=SequenceFlow_29
flow ParallelGateway_6 -> UserTask_8 id=SequenceFlow_30
flow ExclusiveGateway_1 -> UserTask_7 "No" id=SequenceFlow_31
flow ExclusiveGateway_1 -> ParallelGateway_2 "Yes" id=SequenceFlow_32
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "No" id=SequenceFlow_33
flow ExclusiveGateway_4 -> EndEvent_1 id=SequenceFlow_34
flow ServiceTask_3 -> ExclusiveGateway_4 id=SequenceFlow_35
