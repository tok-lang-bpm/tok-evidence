xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6 "Negotitation successful?"
xor ExclusiveGateway_7
xor ExclusiveGateway_8 "Additional documentation needed?"
xor ExclusiveGateway_9
xor ExclusiveGateway_10 "Agency approves right to stay?"
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1
end EndEvent_1

