tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Check if passport is up to date"
user UserTask_2 "Prepare Documents for r-w-r card"
service ServiceTask_1 "Send documentation to relevant agency"
service ServiceTask_2 "Rules engine automaticly checks if documentations fullfilles requirements"
service ServiceTask_3 "Bank Systems creates bank account and sends E-Mail confirmation"
manual ManualTask_1 "Check requirements and point for particularly highly qualified people"
manual ManualTask_2 "Check requirements for independent key employees"
manual ManualTask_3 "Check requirements and point for start-up founders"
manual ManualTask_4 "Check requirements for Graduates of an Austrian higher education institution"
manual ManualTask_5 "Check requirements and point for other key employees"
manual ManualTask_6 "Check requirements and point for skilled workers in shortage occupations"
manual ManualTask_7 "Request new passport"
manual ManualTask_8 "Make passport photo"
manual ManualTask_9 "Prepare birth certificate"
manual ManualTask_10 "Search and find suited apartment"
manual ManualTask_11 "Negotiate rent with landlord"
manual ManualTask_12 "Sign contract"
manual ManualTask_13 "Request Austrian health insurance coverage incl. documentation"
manual ManualTask_14 "Gather documentation to prove financial indepence"
manual ManualTask_15 "Application for a residence permit"
manual ManualTask_16 "Request Bank Account on Bank website"
xor ExclusiveGateway_1
xor ExclusiveGateway_2 "Fullfiles the requirements or point?"
