tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Check if passport is up to date" duration="exp(10m)"
user UserTask_2 "Prepare Documents for r-w-r card" duration="exp(10m)"
service ServiceTask_1 "Send documentation to relevant agency" duration="exp(10m)"
service ServiceTask_2 "Rules engine automaticly checks if documentations fullfilles requirements" duration="exp(10m)"
service ServiceTask_3 "Bank Systems creates bank account and sends E-Mail confirmation" duration="exp(10m)"
manual ManualTask_1 "Check requirements and point for particularly highly qualified people" duration="exp(10m)"
manual ManualTask_2 "Check requirements for independent key employees" duration="exp(10m)"
manual ManualTask_3 "Check requirements and point for start-up founders" duration="exp(10m)"
manual ManualTask_4 "Check requirements for Graduates of an Austrian higher education institution" duration="exp(10m)"
manual ManualTask_5 "Check requirements and point for other key employees" duration="exp(10m)"
manual ManualTask_6 "Check requirements and point for skilled workers in shortage occupations" duration="exp(10m)"
manual ManualTask_7 "Request new passport" duration="exp(10m)"
manual ManualTask_8 "Make passport photo" duration="exp(10m)"
manual ManualTask_9 "Prepare birth certificate" duration="exp(10m)"
manual ManualTask_10 "Search and find suited apartment" duration="exp(10m)"
manual ManualTask_11 "Negotiate rent with landlord" duration="exp(10m)"
manual ManualTask_12 "Sign contract" duration="exp(10m)"
manual ManualTask_13 "Request Austrian health insurance coverage incl. documentation" duration="exp(10m)"
manual ManualTask_14 "Gather documentation to prove financial indepence" duration="exp(10m)"
manual ManualTask_15 "Application for a residence permit" duration="exp(10m)"
manual ManualTask_16 "Request Bank Account on Bank website" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2 "Fullfiles the requirements or point?"
xor ExclusiveGateway_3
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6 "Negotitation successful?"
xor ExclusiveGateway_7
xor ExclusiveGateway_8 "Additional documentation needed?"
xor ExclusiveGateway_9
xor ExclusiveGateway_10 "Agency approves right to stay?"
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1
end EndEvent_1

flow StartEvent_1 -> ExclusiveGateway_1 id=SequenceFlow_1
flow ExclusiveGateway_1 -> ManualTask_6 id=SequenceFlow_2 p=0.167
flow ExclusiveGateway_1 -> ManualTask_1 id=SequenceFlow_3 p=0.167
flow ExclusiveGateway_1 -> ManualTask_5 id=SequenceFlow_4 p=0.167
flow ExclusiveGateway_1 -> ManualTask_3 id=SequenceFlow_5 p=0.167
flow ManualTask_6 -> ExclusiveGateway_2 id=SequenceFlow_6
flow ManualTask_1 -> ExclusiveGateway_2 id=SequenceFlow_7
flow ManualTask_5 -> ExclusiveGateway_2 id=SequenceFlow_8
flow ManualTask_3 -> ExclusiveGateway_2 id=SequenceFlow_9
flow ManualTask_2 -> ExclusiveGateway_2 id=SequenceFlow_10
flow ExclusiveGateway_2 -> ExclusiveGateway_1 "No" id=SequenceFlow_11 p=0.500
flow UserTask_1 -> ExclusiveGateway_3 id=SequenceFlow_12
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "Yes" id=SequenceFlow_13 p=0.500
flow ManualTask_7 -> ExclusiveGateway_4 id=SequenceFlow_14
flow UserTask_2 -> ParallelGateway_1 id=SequenceFlow_15
flow ParallelGateway_1 -> UserTask_1 id=SequenceFlow_16
flow ParallelGateway_1 -> ManualTask_8 id=SequenceFlow_17
flow ParallelGateway_1 -> ManualTask_9 id=SequenceFlow_18
flow ManualTask_10 -> ManualTask_11 id=SequenceFlow_19
flow ExclusiveGateway_5 -> ManualTask_10 id=SequenceFlow_20
flow ParallelGateway_1 -> ExclusiveGateway_5 id=SequenceFlow_21
flow ManualTask_11 -> ExclusiveGateway_6 id=SequenceFlow_22
flow ExclusiveGateway_6 -> ExclusiveGateway_5 "No" id=SequenceFlow_23 p=0.500
flow ExclusiveGateway_6 -> ManualTask_12 "Yes" id=SequenceFlow_24 p=0.500
flow ParallelGateway_1 -> ManualTask_14 id=SequenceFlow_25
flow ParallelGateway_1 -> ManualTask_15 id=SequenceFlow_26
flow ManualTask_8 -> ParallelGateway_2 id=SequenceFlow_27
flow ExclusiveGateway_4 -> ParallelGateway_2 id=SequenceFlow_28
flow ManualTask_9 -> ParallelGateway_2 id=SequenceFlow_29
flow ManualTask_14 -> ParallelGateway_2 id=SequenceFlow_30
flow ManualTask_15 -> ParallelGateway_2 id=SequenceFlow_31
flow ManualTask_12 -> ParallelGateway_2 id=SequenceFlow_32
flow ExclusiveGateway_7 -> UserTask_2 id=SequenceFlow_33
flow ExclusiveGateway_3 -> ManualTask_7 "No" id=SequenceFlow_34 p=0.500
flow ParallelGateway_1 -> ManualTask_13 id=SequenceFlow_35
flow ManualTask_13 -> ParallelGateway_2 id=SequenceFlow_36
flow ServiceTask_1 -> ServiceTask_2 id=SequenceFlow_37
flow ServiceTask_2 -> ExclusiveGateway_8 id=SequenceFlow_38
flow ServiceTask_3 -> ExclusiveGateway_9 id=SequenceFlow_39
flow ExclusiveGateway_9 -> EndEvent_1 id=SequenceFlow_40
flow ParallelGateway_2 -> ServiceTask_1 id=SequenceFlow_41
flow ExclusiveGateway_8 -> ExclusiveGateway_10 "No" id=SequenceFlow_42 p=0.500
flow ExclusiveGateway_8 -> ExclusiveGateway_7 "Yes" id=SequenceFlow_43 p=0.500
flow ManualTask_16 -> ServiceTask_3 id=SequenceFlow_44
flow ExclusiveGateway_10 -> ManualTask_16 "Yes" id=SequenceFlow_45 p=0.500
flow ExclusiveGateway_10 -> ExclusiveGateway_9 "No" id=SequenceFlow_46 p=0.500
flow ExclusiveGateway_2 -> ExclusiveGateway_7 "Yes" id=SequenceFlow_47 p=0.500
flow ExclusiveGateway_1 -> ManualTask_2 id=SequenceFlow_48 p=0.167
flow ExclusiveGateway_1 -> ManualTask_4 id=SequenceFlow_49 p=0.165
flow ManualTask_4 -> ExclusiveGateway_2 id=SequenceFlow_50

simulate cases=500 seed=20261031 arrival="exp(1h)"
