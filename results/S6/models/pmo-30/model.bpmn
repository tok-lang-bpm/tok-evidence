    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_2" targetRef="ExclusiveGateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_9" name="Less then 8 people can play on that date" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3" />
