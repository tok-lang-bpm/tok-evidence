  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:userTask id="UserTask_1" name="Send invites to 10 people" />
    <bpmn:userTask id="UserTask_2" name="Ask which games do they want to play" />
    <bpmn:userTask id="UserTask_3" name="Appoint a date" />
    <bpmn:userTask id="UserTask_4" name="Ask friends how much beer they would like" />
    <bpmn:userTask id="UserTask_5" name="Order beer for that date" />
    <bpmn:userTask id="UserTask_6" name="Find where can you download the games" />
    <bpmn:serviceTask id="ServiceTask_1" name="Reserve that day" />
    <bpmn:serviceTask id="ServiceTask_2" name="Download the missing games" />
    <bpmn:serviceTask id="ServiceTask_3" name="Send a notification that the LAN party will be held on that date" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="How many people can play on that date?" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Do we have all the games?" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="Do you have enough beer?" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_5" />
    <bpmn:exclusiveGateway id="ExclusiveGateway_6" name="Download successful?" />
    <bpmn:parallelGateway id="ParallelGateway_1" />
    <bpmn:parallelGateway id="ParallelGateway_2" />
    <bpmn:startEvent id="StartEvent_1" name="Wish for a LAN gameparty" />
    <bpmn:endEvent id="EndEvent_1" name="LAN party done" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="Few hours, until the user has all the games that they want to play">
      <bpmn:timerEventDefinition id="IntermediateCatchEvent_1-def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2" name="Few hours, until all people reply if they can play on that date">
      <bpmn:timerEventDefinition id="IntermediateCatchEvent_2-def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_3" name="Few hours, until all people reply with t he amount of beer">
      <bpmn:timerEventDefinition id="IntermediateCatchEvent_3-def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="UserTask_2" />
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_2" targetRef="IntermediateCatchEvent_1" />
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_1" targetRef="ParallelGateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="UserTask_3" />
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_2" />
