tok 0.5 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Send invites to 10 people" duration="exp(10m)"
user UserTask_2 "Ask which games do they want to play" duration="exp(10m)"
user UserTask_3 "Appoint a date" duration="exp(10m)"
user UserTask_4 "Ask friends how much beer they would like" duration="exp(10m)"
user UserTask_5 "Order beer for that date" duration="exp(10m)"
user UserTask_6 "Find where can you download the games" duration="exp(10m)"
service ServiceTask_1 "Reserve that day" duration="exp(10m)"
service ServiceTask_2 "Download the missing games" duration="exp(10m)"
service ServiceTask_3 "Send a notification that the LAN party will be held on that date" duration="exp(10m)"
xor ExclusiveGateway_1 "How many people can play on that date?"
xor ExclusiveGateway_2 "Do we have all the games?"
xor ExclusiveGateway_3
xor ExclusiveGateway_4 "Do you have enough beer?"
xor ExclusiveGateway_5
xor ExclusiveGateway_6 "Download successful?"
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "Wish for a LAN gameparty"
end EndEvent_1 "LAN party done"
catch IntermediateCatchEvent_1 "Few hours, until the user has all the games that they want to play" timer
catch IntermediateCatchEvent_2 "Few hours, until all people reply if they can play on that date" timer
catch IntermediateCatchEvent_3 "Few hours, until all people reply with t he amount of beer" timer

flow StartEvent_1 -> UserTask_1 id=SequenceFlow_1
flow UserTask_1 -> UserTask_2 id=SequenceFlow_2
flow UserTask_2 -> IntermediateCatchEvent_1 id=SequenceFlow_3
flow IntermediateCatchEvent_1 -> ParallelGateway_1 id=SequenceFlow_4
flow ParallelGateway_1 -> UserTask_3 id=SequenceFlow_5
flow ParallelGateway_1 -> ExclusiveGateway_2 id=SequenceFlow_6
flow UserTask_3 -> IntermediateCatchEvent_2 id=SequenceFlow_7
flow IntermediateCatchEvent_2 -> ExclusiveGateway_1 id=SequenceFlow_8
flow ExclusiveGateway_1 -> UserTask_3 "Less then 8 people can play on that date" id=SequenceFlow_9 p=0.500
flow ExclusiveGateway_1 -> ServiceTask_1 "8 or more people can play on that date" id=SequenceFlow_10 p=0.500
flow ParallelGateway_2 -> UserTask_4 id=SequenceFlow_11
flow UserTask_4 -> IntermediateCatchEvent_3 id=SequenceFlow_12
flow ExclusiveGateway_4 -> UserTask_5 "No" id=SequenceFlow_13 p=0.500
flow UserTask_5 -> ExclusiveGateway_5 id=SequenceFlow_14
flow ExclusiveGateway_2 -> UserTask_6 "No" id=SequenceFlow_15 p=0.500
flow UserTask_6 -> ServiceTask_2 id=SequenceFlow_16
flow ServiceTask_3 -> EndEvent_1 id=SequenceFlow_17
flow ServiceTask_1 -> ParallelGateway_2 id=SequenceFlow_18
flow ExclusiveGateway_6 -> ExclusiveGateway_3 "Yes" id=SequenceFlow_19 p=0.500
flow ExclusiveGateway_6 -> ServiceTask_2 "No" id=SequenceFlow_20 p=0.500
flow ExclusiveGateway_5 -> ServiceTask_3 id=SequenceFlow_21
flow IntermediateCatchEvent_3 -> ExclusiveGateway_4 id=SequenceFlow_22
flow ExclusiveGateway_4 -> ExclusiveGateway_5 "Yes" id=SequenceFlow_23 p=0.500
flow ExclusiveGateway_3 -> ParallelGateway_2 id=SequenceFlow_24
flow ExclusiveGateway_2 -> ExclusiveGateway_3 "Yes" id=SequenceFlow_25 p=0.500
flow ServiceTask_2 -> ExclusiveGateway_6 id=SequenceFlow_26

simulate cases=500 seed=20261031 arrival="exp(1h)"
