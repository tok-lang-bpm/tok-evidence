tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Create character names" duration="exp(10m)"
user UserTask_2 "Create battle.net account" duration="exp(10m)"
user UserTask_3 "Confirm registration via email link" duration="exp(10m)"
user UserTask_4 "Enter credit card information" duration="exp(10m)"
