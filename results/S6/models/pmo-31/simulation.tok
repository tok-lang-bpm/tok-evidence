xor ExclusiveGateway_3 "Does a subscription exist?"
xor ExclusiveGateway_4 "Select payment method"
xor ExclusiveGateway_5
xor ExclusiveGateway_6 "Name available?"
xor ExclusiveGateway_7
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
and ParallelGateway_5
and ParallelGateway_6
and ParallelGateway_7
and ParallelGateway_8
start StartEvent_1 "Account is set up"
end EndEvent_1 "Character created"

