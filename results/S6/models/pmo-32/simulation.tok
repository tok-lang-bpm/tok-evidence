tok 0.5 id=Definitions_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL collaboration=Collaboration_1

pool Participant_1 "Farming Bot Game" process=Process_1 process-name=""
  lane Lane_1 "Player"
    task Task_1 "Collect urgently needed resources" duration="exp(10m)"
    task Task_2 "Collect the remained resources" duration="exp(10m)"
    task Task_3 "Check repo for already available resources" duration="exp(10m)"
    task Task_4 "Build tools" duration="exp(10m)"
    user UserTask_1 "Find out wanted resources" duration="exp(10m)"
    user UserTask_2 "Read message" duration="exp(10m)"
    xor ExclusiveGateway_1 "New tools needed?"
    xor ExclusiveGateway_2
    and ParallelGateway_1
    and ParallelGateway_2
    start StartEvent_1 "Farming bot creation desire"
  lane Lane_2 "Farming Bot"
    task Task_5 "Start farming" duration="exp(10m)"
    task Task_6 "Continue farming" duration="exp(10m)"
    task Task_7 "Update list of resources" duration="exp(10m)"
    task Task_8 "Wait for random natural event for some time" duration="exp(10m)"
    user UserTask_3 "Brag to friends" duration="exp(10m)"
    user UserTask_4 "Help with materials" duration="exp(10m)"
    service ServiceTask_1 "Reset bot" duration="exp(10m)"
    service ServiceTask_2 "Notify player" duration="exp(10m)"
    service ServiceTask_3 "Give bot a sleeping break" duration="exp(10m)"
    xor ExclusiveGateway_3 "New milestone achieved?"
    xor ExclusiveGateway_4
    xor ExclusiveGateway_5 "Bot finished?"
    xor ExclusiveGateway_6
    xor ExclusiveGateway_7 "RNE happened?"
    xor ExclusiveGateway_8
    and ParallelGateway_3
    and ParallelGateway_4
    or InclusiveGateway_1
    or InclusiveGateway_2
    end EndEvent_1

flow StartEvent_1 -> UserTask_1 id=SequenceFlow_1
flow ExclusiveGateway_3 -> ServiceTask_2 "Yes" id=SequenceFlow_2 p=0.500
flow UserTask_4 -> InclusiveGateway_2 id=SequenceFlow_3
flow UserTask_3 -> InclusiveGateway_2 id=SequenceFlow_4
flow ParallelGateway_1 -> Task_3 id=SequenceFlow_5
flow Task_3 -> ParallelGateway_2 id=SequenceFlow_6
flow ParallelGateway_2 -> ExclusiveGateway_1 id=SequenceFlow_7
flow Task_4 -> ExclusiveGateway_2 id=SequenceFlow_8
flow ParallelGateway_1 -> Task_1 id=SequenceFlow_9
flow Task_1 -> ParallelGateway_2 id=SequenceFlow_10
flow ExclusiveGateway_1 -> Task_4 "Yes" id=SequenceFlow_11 p=0.500
flow ExclusiveGateway_2 -> Task_2 id=SequenceFlow_12
flow ExclusiveGateway_1 -> ExclusiveGateway_2 "No" id=SequenceFlow_13 p=0.500
flow UserTask_2 -> ExclusiveGateway_4 id=SequenceFlow_14
flow ExclusiveGateway_4 -> ExclusiveGateway_5 id=SequenceFlow_15
flow ServiceTask_1 -> Task_6 id=SequenceFlow_16
flow Task_5 -> ExclusiveGateway_6 id=SequenceFlow_17
flow UserTask_1 -> ParallelGateway_1 id=SequenceFlow_18
flow ServiceTask_2 -> UserTask_2 id=SequenceFlow_19
flow ExclusiveGateway_6 -> ExclusiveGateway_3 id=SequenceFlow_20
flow Task_6 -> ExclusiveGateway_6 id=SequenceFlow_21
flow Task_8 -> ExclusiveGateway_7 id=SequenceFlow_22
flow ExclusiveGateway_7 -> ServiceTask_1 "Yes" id=SequenceFlow_23 p=0.500
flow ParallelGateway_3 -> ExclusiveGateway_8 id=SequenceFlow_24
flow ExclusiveGateway_8 -> Task_8 id=SequenceFlow_25
flow Task_2 -> ParallelGateway_3 id=SequenceFlow_26
flow ExclusiveGateway_7 -> Task_5 "No" id=SequenceFlow_27 p=0.500
flow ParallelGateway_3 -> Task_7 id=SequenceFlow_28
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "No" id=SequenceFlow_29 p=0.500
flow ServiceTask_3 -> ExclusiveGateway_8 id=SequenceFlow_30
flow ExclusiveGateway_5 -> InclusiveGateway_1 "Yes" id=SequenceFlow_31 p=0.500
flow InclusiveGateway_2 -> ParallelGateway_4 id=SequenceFlow_32
flow Task_7 -> ParallelGateway_4 id=SequenceFlow_33
flow ParallelGateway_4 -> EndEvent_1 id=SequenceFlow_34
flow ExclusiveGateway_5 -> ServiceTask_3 "No" id=SequenceFlow_35 p=0.500
flow InclusiveGateway_1 -> UserTask_3 "brag" id=SequenceFlow_36 p=0.5
flow InclusiveGateway_1 -> UserTask_4 "help" id=SequenceFlow_37 p=0.5

simulate cases=500 seed=20261031 arrival="exp(1h)"
