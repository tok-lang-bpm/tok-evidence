tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Send sketches to an artist" duration="exp(10m)"
user UserTask_2 "Tell artist to change" duration="exp(10m)"
user UserTask_3 "Choose the color" duration="exp(10m)"
user UserTask_4 "Check color level" duration="exp(10m)"
user UserTask_5 "Order color" duration="exp(10m)"
user UserTask_6 "Turn on the printer" duration="exp(10m)"
user UserTask_7 "Generate gcode file" duration="exp(10m)"
user UserTask_8 "Print the model" duration="exp(10m)"
receive ReceiveTask_1 "Receive result" duration="exp(10m)"
receive ReceiveTask_2 "Receive status" duration="exp(10m)"
receive ReceiveTask_3 "Receive order confirmation" duration="exp(10m)"
manual ManualTask_1 "Put it on shopping list" duration="exp(10m)"
manual ManualTask_2 "Color received" duration="exp(10m)"
xor ExclusiveGateway_1 "Satisfied with result?"
xor ExclusiveGateway_2
xor ExclusiveGateway_3 "In stock?"
xor ExclusiveGateway_4 "Under 100g?"
xor ExclusiveGateway_5
xor ExclusiveGateway_6
xor ExclusiveGateway_7 "Heated?"
xor ExclusiveGateway_8
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "Create a 3D model"
end EndEvent_1 "Model printed"

flow UserTask_1 -> ReceiveTask_1 id=SequenceFlow_1
flow ReceiveTask_1 -> ExclusiveGateway_1 id=SequenceFlow_2
flow UserTask_2 -> ExclusiveGateway_2 id=SequenceFlow_3
flow ExclusiveGateway_2 -> UserTask_1 id=SequenceFlow_4
flow StartEvent_1 -> ExclusiveGateway_2 id=SequenceFlow_5
flow ExclusiveGateway_1 -> UserTask_3 "Yes" id=SequenceFlow_6 p=0.500
flow UserTask_3 -> ExclusiveGateway_3 id=SequenceFlow_7
flow ExclusiveGateway_3 -> UserTask_4 "Yes" id=SequenceFlow_8 p=0.500
flow UserTask_4 -> ExclusiveGateway_4 id=SequenceFlow_9
flow ExclusiveGateway_4 -> ManualTask_1 "Yes" id=SequenceFlow_10 p=0.500
flow ExclusiveGateway_4 -> ExclusiveGateway_5 "No" id=SequenceFlow_11 p=0.500
flow ManualTask_1 -> ExclusiveGateway_5 id=SequenceFlow_12
flow ExclusiveGateway_3 -> UserTask_5 "No" id=SequenceFlow_13 p=0.500
flow ExclusiveGateway_5 -> ExclusiveGateway_6 id=SequenceFlow_14
flow UserTask_5 -> ReceiveTask_3 id=SequenceFlow_15
flow ExclusiveGateway_6 -> UserTask_6 id=SequenceFlow_16
flow UserTask_6 -> ParallelGateway_1 id=SequenceFlow_17
flow ParallelGateway_1 -> UserTask_7 id=SequenceFlow_18
flow ReceiveTask_2 -> ExclusiveGateway_7 id=SequenceFlow_19
flow ParallelGateway_1 -> ExclusiveGateway_8 id=SequenceFlow_20
flow ExclusiveGateway_8 -> ReceiveTask_2 id=SequenceFlow_21
flow ExclusiveGateway_7 -> ParallelGateway_2 "Yes" id=SequenceFlow_22 p=0.500
flow UserTask_7 -> ParallelGateway_2 id=SequenceFlow_23
flow ParallelGateway_2 -> UserTask_8 id=SequenceFlow_24
flow UserTask_8 -> EndEvent_1 id=SequenceFlow_25
flow ExclusiveGateway_7 -> ExclusiveGateway_8 "No" id=SequenceFlow_26 p=0.500
flow ReceiveTask_3 -> ManualTask_2 id=SequenceFlow_27
flow ManualTask_2 -> ExclusiveGateway_6 id=SequenceFlow_28
flow ExclusiveGateway_1 -> UserTask_2 "No" id=SequenceFlow_29 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
