tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Develop basic design"
user UserTask_2 "Order Lego brick sets"
service ServiceTask_1 "Test subcomponent 1"
service ServiceTask_2 "Test subcomponent 2"
service ServiceTask_3 "Test subcomponent 3"
service ServiceTask_4 "Test subcomponent 4"
manual ManualTask_1 "Give the lego sets to the children"
manual ManualTask_2 "Sort the parts into containers"
manual ManualTask_3 "Build the next subcomponent"
manual ManualTask_4 "Reorder parts"
manual ManualTask_5 "Assemble subcomponents"
xor ExclusiveGateway_1
xor ExclusiveGateway_2 "Parts remained?"
xor ExclusiveGateway_3 "Container empty?"
xor ExclusiveGateway_4
xor ExclusiveGateway_5 "All tests successfull?"
xor ExclusiveGateway_6
xor ExclusiveGateway_7 "Brick sets already ordered?"
xor ExclusiveGateway_8
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "New order received"
end EndEvent_1 "Machine assembled"

flow StartEvent_1 -> ExclusiveGateway_6 id=SequenceFlow_1
flow UserTask_2 -> ManualTask_1 id=SequenceFlow_2
flow ManualTask_1 -> ManualTask_2 id=SequenceFlow_3
flow ExclusiveGateway_2 -> ExclusiveGateway_1 "Yes" id=SequenceFlow_4
flow ExclusiveGateway_1 -> ExclusiveGateway_3 id=SequenceFlow_5
flow ExclusiveGateway_4 -> ManualTask_3 id=SequenceFlow_6
flow ManualTask_3 -> ExclusiveGateway_2 id=SequenceFlow_7
flow ExclusiveGateway_3 -> ManualTask_4 "Yes" id=SequenceFlow_8
flow ManualTask_4 -> ExclusiveGateway_4 id=SequenceFlow_9
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "No" id=SequenceFlow_10
flow ParallelGateway_1 -> ServiceTask_1 id=SequenceFlow_11
flow ParallelGateway_1 -> ServiceTask_4 id=SequenceFlow_12
flow ServiceTask_4 -> ParallelGateway_2 id=SequenceFlow_13
flow ServiceTask_3 -> ParallelGateway_2 id=SequenceFlow_14
flow ServiceTask_1 -> ParallelGateway_2 id=SequenceFlow_15
flow ParallelGateway_2 -> ExclusiveGateway_5 id=SequenceFlow_16
flow ManualTask_5 -> EndEvent_1 id=SequenceFlow_17
flow ServiceTask_2 -> ParallelGateway_2 id=SequenceFlow_18
flow ExclusiveGateway_6 -> UserTask_1 id=SequenceFlow_19
flow ExclusiveGateway_5 -> ExclusiveGateway_6 "No" id=SequenceFlow_20
flow ExclusiveGateway_5 -> ManualTask_5 "Yes" id=SequenceFlow_21
flow ExclusiveGateway_2 -> ParallelGateway_1 "No" id=SequenceFlow_22
flow UserTask_1 -> ExclusiveGateway_7 id=SequenceFlow_23
flow ExclusiveGateway_7 -> UserTask_2 "No" id=SequenceFlow_24
flow ManualTask_2 -> ExclusiveGateway_8 id=SequenceFlow_25
flow ExclusiveGateway_8 -> ExclusiveGateway_1 id=SequenceFlow_26
flow ExclusiveGateway_7 -> ExclusiveGateway_8 "Yes" id=SequenceFlow_27
flow ParallelGateway_1 -> ServiceTask_2 id=SequenceFlow_28
flow ParallelGateway_1 -> ServiceTask_3 id=SequenceFlow_29
