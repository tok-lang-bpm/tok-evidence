tok 0.5 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Check desired airplane type" duration="exp(10m)"
user UserTask_2 "Select number of seats" duration="exp(10m)"
user UserTask_3 "Select seat color" duration="exp(10m)"
user UserTask_4 "Introduce amount of water in the toilets" duration="exp(10m)"
user UserTask_5 "Update flight protocol" duration="exp(10m)"
service ServiceTask_1 "Display bar type" duration="exp(10m)"
send SendTask_1 "Send customizing options" duration="exp(10m)"
send SendTask_2 "Send requirements to the russian team" duration="exp(10m)"
send SendTask_3 "Send requirements to the irish team" duration="exp(10m)"
send SendTask_4 "Send requirements to french team" duration="exp(10m)"
send SendTask_5 "Send requirements to the american team" duration="exp(10m)"
send SendTask_6 "Send requirements to the italian team" duration="exp(10m)"
send SendTask_7 "Send protocol to customer" duration="exp(10m)"
receive ReceiveTask_1 "Receive customizing requirements" duration="exp(10m)"
receive ReceiveTask_2 "Receive customer confirmation" duration="exp(10m)"
manual ManualTask_1 "Receive bar components" duration="exp(10m)"
manual ManualTask_2 "Assemble interior" duration="exp(10m)"
manual ManualTask_3 "Flight test" duration="exp(10m)"
manual ManualTask_4 "Sent plane to customer" duration="exp(10m)"
manual ManualTask_5 "Ajdust errors" duration="exp(10m)"
xor ExclusiveGateway_1 "Individual customizing?"
xor ExclusiveGateway_2 "Bar type"
xor ExclusiveGateway_3
xor ExclusiveGateway_4 "Test succesful"
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "Get airplane request" message
end EndEvent_1

flow StartEvent_1 -> UserTask_1 id=SequenceFlow_1
flow UserTask_1 -> ExclusiveGateway_1 id=SequenceFlow_2
flow ParallelGateway_1 -> ServiceTask_1 id=SequenceFlow_3
flow ParallelGateway_1 -> UserTask_2 id=SequenceFlow_4
flow ParallelGateway_1 -> UserTask_3 id=SequenceFlow_5
flow ParallelGateway_1 -> UserTask_4 id=SequenceFlow_6
flow ServiceTask_1 -> ExclusiveGateway_2 id=SequenceFlow_7
flow UserTask_2 -> ParallelGateway_2 id=SequenceFlow_8
flow UserTask_3 -> ParallelGateway_2 id=SequenceFlow_9
flow UserTask_4 -> ParallelGateway_2 id=SequenceFlow_10
flow SendTask_1 -> ReceiveTask_1 id=SequenceFlow_11
flow ReceiveTask_1 -> ParallelGateway_1 id=SequenceFlow_12
flow SendTask_2 -> ExclusiveGateway_3 id=SequenceFlow_13
flow SendTask_3 -> ExclusiveGateway_3 id=SequenceFlow_14
flow ExclusiveGateway_3 -> ManualTask_1 id=SequenceFlow_15
flow ManualTask_1 -> ParallelGateway_2 id=SequenceFlow_16
flow ParallelGateway_2 -> ManualTask_2 id=SequenceFlow_17
flow ManualTask_4 -> ReceiveTask_2 id=SequenceFlow_18
flow ReceiveTask_2 -> EndEvent_1 id=SequenceFlow_19
flow ExclusiveGateway_4 -> ManualTask_5 "No" id=SequenceFlow_20 p=0.500
flow ParallelGateway_3 -> ManualTask_3 id=SequenceFlow_21
flow ManualTask_3 -> ExclusiveGateway_4 id=SequenceFlow_22
flow ParallelGateway_3 -> UserTask_5 id=SequenceFlow_23
flow UserTask_5 -> SendTask_7 id=SequenceFlow_24
flow SendTask_7 -> ParallelGateway_4 id=SequenceFlow_25
flow ExclusiveGateway_4 -> ParallelGateway_4 "Yes" id=SequenceFlow_26 p=0.500
flow ParallelGateway_4 -> ManualTask_4 id=SequenceFlow_27
flow SendTask_4 -> ExclusiveGateway_3 id=SequenceFlow_28
flow SendTask_5 -> ExclusiveGateway_3 id=SequenceFlow_29
flow SendTask_6 -> ExclusiveGateway_3 id=SequenceFlow_30
flow ManualTask_2 -> ParallelGateway_3 id=SequenceFlow_31
flow ManualTask_5 -> ManualTask_3 id=SequenceFlow_32
flow ExclusiveGateway_1 -> SendTask_1 "Yes" id=SequenceFlow_33 p=0.500
flow ExclusiveGateway_1 -> ManualTask_2 "No" id=SequenceFlow_34 p=0.500
flow ExclusiveGateway_2 -> SendTask_2 "Vodka bar" id=SequenceFlow_35 p=0.200
flow ExclusiveGateway_2 -> SendTask_3 "Whiskey bar" id=SequenceFlow_36 p=0.200
flow ExclusiveGateway_2 -> SendTask_4 "Wine bar" id=SequenceFlow_37 p=0.200
flow ExclusiveGateway_2 -> SendTask_5 "Cocktail bar" id=SequenceFlow_38 p=0.200
flow ExclusiveGateway_2 -> SendTask_6 "Aperol bar" id=SequenceFlow_39 p=0.200

simulate cases=500 seed=20261031 arrival="exp(1h)"
