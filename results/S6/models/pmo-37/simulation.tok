tok 0.5 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Query the next shop" duration="exp(10m)"
user UserTask_2 "Ask about quantity, price and deadline" duration="exp(10m)"
service ServiceTask_1 "Create a list of the parts" duration="exp(10m)"
service ServiceTask_2 "Reorder the cheapest part" duration="exp(10m)"
service ServiceTask_3 "Reorder the part as fast as possible" duration="exp(10m)"
manual ManualTask_1 "Receive first batch of parts" duration="exp(10m)"
manual ManualTask_2 "Receive second batch of parts" duration="exp(10m)"
manual ManualTask_3 "Receive third batch of parts" duration="exp(10m)"
manual ManualTask_4 "Start/Continue building" duration="exp(10m)"
manual ManualTask_5 "Complain to the friends" duration="exp(10m)"
xor ExclusiveGateway_1
xor ExclusiveGateway_2 "Terms acceptable?"
xor ExclusiveGateway_3
xor ExclusiveGateway_4 "More parts needed?"
xor ExclusiveGateway_5 "Any stock falls?"
xor ExclusiveGateway_6
xor ExclusiveGateway_7 "How much is the stock fall?"
xor ExclusiveGateway_8
xor ExclusiveGateway_9 "Contract fullfilled?"
and ParallelGateway_1
complex ComplexGateway_1 "First parts arrived"
start StartEvent_1 "Contract project received"
end EndEvent_1 "Project completed"

flow StartEvent_1 -> ExclusiveGateway_1 id=SequenceFlow_1
flow ExclusiveGateway_1 -> UserTask_1 id=SequenceFlow_2
flow ServiceTask_1 -> ExclusiveGateway_3 id=SequenceFlow_3
flow UserTask_1 -> UserTask_2 id=SequenceFlow_4
flow UserTask_2 -> ExclusiveGateway_2 id=SequenceFlow_5
flow ExclusiveGateway_2 -> ExclusiveGateway_3 "No" id=SequenceFlow_6 p=0.500
flow ExclusiveGateway_2 -> ServiceTask_1 "Yes" id=SequenceFlow_7 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_4 id=SequenceFlow_8
flow ExclusiveGateway_4 -> ExclusiveGateway_1 "Yes" id=SequenceFlow_9 p=0.500
flow ExclusiveGateway_4 -> ParallelGateway_1 "No" id=SequenceFlow_10 p=0.500
flow ParallelGateway_1 -> ManualTask_1 id=SequenceFlow_11
flow ParallelGateway_1 -> ManualTask_2 id=SequenceFlow_12
flow ParallelGateway_1 -> ManualTask_3 id=SequenceFlow_13
flow ManualTask_1 -> ComplexGateway_1 id=SequenceFlow_14
flow ManualTask_2 -> ComplexGateway_1 id=SequenceFlow_15
flow ManualTask_3 -> ComplexGateway_1 id=SequenceFlow_16
flow ComplexGateway_1 -> ManualTask_4 id=SequenceFlow_17
flow ManualTask_4 -> ExclusiveGateway_5 id=SequenceFlow_18
flow ExclusiveGateway_5 -> ExclusiveGateway_7 "Yes" id=SequenceFlow_19 p=0.500
flow ServiceTask_3 -> ExclusiveGateway_8 id=SequenceFlow_20
flow ServiceTask_2 -> ExclusiveGateway_8 id=SequenceFlow_21
flow ManualTask_5 -> ExclusiveGateway_8 id=SequenceFlow_22
flow ExclusiveGateway_8 -> ExclusiveGateway_6 id=SequenceFlow_23
flow ExclusiveGateway_5 -> ExclusiveGateway_6 "No" id=SequenceFlow_24 p=0.500
flow ExclusiveGateway_7 -> ServiceTask_2 "Below 5" id=SequenceFlow_25 p=0.333
flow ExclusiveGateway_7 -> ServiceTask_3 "Below 3" id=SequenceFlow_26 p=0.333
flow ExclusiveGateway_7 -> ManualTask_5 "Zero" id=SequenceFlow_27 p=0.334
flow ExclusiveGateway_6 -> ExclusiveGateway_9 id=SequenceFlow_28
flow ExclusiveGateway_9 -> ManualTask_4 "No" id=SequenceFlow_29 p=0.500
flow ExclusiveGateway_9 -> EndEvent_1 "Yes" id=SequenceFlow_30 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
