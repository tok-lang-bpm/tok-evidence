tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Select type of hardware Issue" duration="exp(10m)"
user UserTask_2 "Select device model" duration="exp(10m)"
user UserTask_3 "Write review" duration="exp(10m)"
user UserTask_4 "Upload video of reparation steps" duration="exp(10m)"
user UserTask_5 "Get second-hand tools and materials from friends" duration="exp(10m)"
user UserTask_6 "purchase online" duration="exp(10m)"
user UserTask_7 "Log into account" duration="exp(10m)"
user UserTask_8 "Create account" duration="exp(10m)"
user UserTask_9 "Contact friends" duration="exp(10m)"
service ServiceTask_1 "List required materials" duration="exp(10m)"
service ServiceTask_2 "List required tools" duration="exp(10m)"
service ServiceTask_3 "Offer ordering choices" duration="exp(10m)"
service ServiceTask_4 "Display repair instructions" duration="exp(10m)"
manual ManualTask_1 "Repair device" duration="exp(10m)"
manual ManualTask_2 "Send device to an expert" duration="exp(10m)"
xor ExclusiveGateway_1 "Is issue fixed?"
xor ExclusiveGateway_2
xor ExclusiveGateway_3 "Have all required items?"
xor ExclusiveGateway_4
xor ExclusiveGateway_5 "Have intention to write a review?"
xor ExclusiveGateway_6
xor ExclusiveGateway_7 "Have intention to upload a video of repair steps?"
xor ExclusiveGateway_8
xor ExclusiveGateway_9 "Have an account?"
xor ExclusiveGateway_10
xor ExclusiveGateway_11 "Is login Successful?"
xor ExclusiveGateway_12
xor ExclusiveGateway_13 "Have intention to get second-hand items?"
xor ExclusiveGateway_14
xor ExclusiveGateway_15 "Have intention to purchase new items?"
xor ExclusiveGateway_16
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "Hardware issue detected"
end EndEvent_1 "Hardware issue fixed"

flow ParallelGateway_1 -> ServiceTask_1 id=SequenceFlow_1
flow ParallelGateway_1 -> ServiceTask_2 id=SequenceFlow_2
flow ParallelGateway_1 -> ServiceTask_3 id=SequenceFlow_3
flow ServiceTask_1 -> ParallelGateway_2 id=SequenceFlow_4
flow ServiceTask_2 -> ParallelGateway_2 id=SequenceFlow_5
flow ServiceTask_3 -> ParallelGateway_2 id=SequenceFlow_6
flow UserTask_2 -> UserTask_1 id=SequenceFlow_7
flow UserTask_1 -> ParallelGateway_1 id=SequenceFlow_8
flow ServiceTask_4 -> ManualTask_1 id=SequenceFlow_9
flow ManualTask_1 -> ExclusiveGateway_1 id=SequenceFlow_10
flow ManualTask_2 -> ExclusiveGateway_2 id=SequenceFlow_11
flow ExclusiveGateway_2 -> EndEvent_1 id=SequenceFlow_12
flow ExclusiveGateway_4 -> ServiceTask_4 id=SequenceFlow_13
flow UserTask_3 -> ExclusiveGateway_6 id=SequenceFlow_14
flow ExclusiveGateway_6 -> ExclusiveGateway_7 id=SequenceFlow_15
flow UserTask_4 -> ExclusiveGateway_8 id=SequenceFlow_16
flow ExclusiveGateway_7 -> ExclusiveGateway_8 "No" id=SequenceFlow_17 p=0.500
flow ExclusiveGateway_7 -> UserTask_4 "Yes" id=SequenceFlow_18 p=0.500
flow ExclusiveGateway_5 -> UserTask_3 "Yes" id=SequenceFlow_19 p=0.500
flow ExclusiveGateway_5 -> ExclusiveGateway_6 "No" id=SequenceFlow_20 p=0.500
flow ExclusiveGateway_8 -> ExclusiveGateway_2 id=SequenceFlow_21
flow ExclusiveGateway_10 -> UserTask_7 id=SequenceFlow_22
flow UserTask_7 -> ExclusiveGateway_11 id=SequenceFlow_23
flow ExclusiveGateway_11 -> UserTask_2 "Yes" id=SequenceFlow_24 p=0.500
flow ExclusiveGateway_11 -> ExclusiveGateway_10 "No" id=SequenceFlow_25 p=0.500
flow ExclusiveGateway_12 -> ExclusiveGateway_10 id=SequenceFlow_26
flow UserTask_5 -> ExclusiveGateway_14 id=SequenceFlow_27
flow ExclusiveGateway_15 -> UserTask_6 "Yes" id=SequenceFlow_28 p=0.500
flow UserTask_6 -> ExclusiveGateway_16 id=SequenceFlow_29
flow ExclusiveGateway_13 -> ExclusiveGateway_14 "No" id=SequenceFlow_30 p=0.500
flow ExclusiveGateway_15 -> ExclusiveGateway_16 "No" id=SequenceFlow_31 p=0.500
flow UserTask_8 -> ExclusiveGateway_12 id=SequenceFlow_32
flow StartEvent_1 -> ExclusiveGateway_9 id=SequenceFlow_33
flow ExclusiveGateway_9 -> UserTask_8 "No" id=SequenceFlow_34 p=0.500
flow ExclusiveGateway_9 -> ExclusiveGateway_12 "Yes" id=SequenceFlow_35 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_13 "No" id=SequenceFlow_36 p=0.500
flow ExclusiveGateway_16 -> ExclusiveGateway_4 id=SequenceFlow_37
flow ExclusiveGateway_1 -> ManualTask_2 "No" id=SequenceFlow_38 p=0.500
flow ExclusiveGateway_1 -> ExclusiveGateway_5 "Yes" id=SequenceFlow_39 p=0.500
flow ExclusiveGateway_13 -> UserTask_9 "Yes" id=SequenceFlow_40 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "Yes" id=SequenceFlow_41 p=0.500
flow UserTask_9 -> UserTask_5 id=SequenceFlow_42
flow ExclusiveGateway_14 -> ExclusiveGateway_15 id=SequenceFlow_43
flow ParallelGateway_2 -> ExclusiveGateway_3 id=SequenceFlow_44

simulate cases=500 seed=20261031 arrival="exp(1h)"
