tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

service ServiceTask_1 "Stop the machine" duration="exp(10m)"
service ServiceTask_2 "Send email to an engineer" duration="exp(10m)"
service ServiceTask_3 "Get availability data" duration="exp(10m)"
service ServiceTask_4 "Get quality data" duration="exp(10m)"
service ServiceTask_5 "Get performance data" duration="exp(10m)"
service ServiceTask_6 "Calculate OEE" duration="exp(10m)"
manual ManualTask_1 "Continue measuring" duration="exp(10m)"
manual ManualTask_2 "Repair the issue" duration="exp(10m)"
manual ManualTask_3 "Restart the machine" duration="exp(10m)"
manual ManualTask_4 "Disconnect the machine" duration="exp(10m)"
xor ExclusiveGateway_1 "OEE below 50%?"
xor ExclusiveGateway_2
xor ExclusiveGateway_3 "Machine worth repairing?"
xor ExclusiveGateway_4
xor ExclusiveGateway_5 "Remaining issues?"
xor ExclusiveGateway_6
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "OEE data required"
end EndEvent_1 "Machine operating normally / Machine disconnected"

flow ParallelGateway_1 -> ServiceTask_4 id=SequenceFlow_1
flow ParallelGateway_1 -> ServiceTask_3 id=SequenceFlow_2
flow ParallelGateway_1 -> ServiceTask_5 id=SequenceFlow_3
flow ServiceTask_4 -> ParallelGateway_2 id=SequenceFlow_4
flow ServiceTask_3 -> ParallelGateway_2 id=SequenceFlow_5
flow ServiceTask_5 -> ParallelGateway_2 id=SequenceFlow_6
flow ParallelGateway_2 -> ServiceTask_6 id=SequenceFlow_7
flow ExclusiveGateway_1 -> ServiceTask_1 "Yes" id=SequenceFlow_8 p=0.500
flow ServiceTask_1 -> ServiceTask_2 id=SequenceFlow_9
flow StartEvent_1 -> ParallelGateway_1 id=SequenceFlow_10
flow ServiceTask_2 -> ExclusiveGateway_3 id=SequenceFlow_11
flow ManualTask_2 -> ExclusiveGateway_5 id=SequenceFlow_12
flow ManualTask_3 -> ManualTask_1 id=SequenceFlow_13
flow ExclusiveGateway_2 -> EndEvent_1 id=SequenceFlow_14
flow ServiceTask_6 -> ExclusiveGateway_1 id=SequenceFlow_15
flow ExclusiveGateway_3 -> ManualTask_4 "No" id=SequenceFlow_16 p=0.500
flow ExclusiveGateway_4 -> ExclusiveGateway_2 id=SequenceFlow_17
flow ManualTask_4 -> ExclusiveGateway_4 id=SequenceFlow_18
flow ManualTask_1 -> ExclusiveGateway_4 id=SequenceFlow_19
flow ExclusiveGateway_3 -> ExclusiveGateway_6 "Yes" id=SequenceFlow_20 p=0.500
flow ExclusiveGateway_5 -> ManualTask_3 "No" id=SequenceFlow_21 p=0.500
flow ExclusiveGateway_6 -> ManualTask_2 id=SequenceFlow_22
flow ExclusiveGateway_5 -> ExclusiveGateway_6 "Yes" id=SequenceFlow_23 p=0.500
flow ExclusiveGateway_1 -> ExclusiveGateway_2 "No" id=SequenceFlow_24 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
