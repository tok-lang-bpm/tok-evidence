tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Turn on bluetooth" duration="exp(10m)"
user UserTask_2 "Enter type of Machine" duration="exp(10m)"
user UserTask_3 "Enter serial number of machine" duration="exp(10m)"
user UserTask_4 "Run 'Inspect-App'" duration="exp(10m)"
user UserTask_5 "Check the fill capacity" duration="exp(10m)"
user UserTask_6 "Leave short Feedback" duration="exp(10m)"
user UserTask_7 "Press 'Produce' button" duration="exp(10m)"
user UserTask_8 "Press button 'Abort process'" duration="exp(10m)"
service ServiceTask_1 "Connecting to device" duration="exp(10m)"
service ServiceTask_2 "Save Answers" duration="exp(10m)"
service ServiceTask_3 "Auto collect values" duration="exp(10m)"
service ServiceTask_4 "Show data" duration="exp(10m)"
service ServiceTask_5 "Present results" duration="exp(10m)"
xor ExclusiveGateway_1 "Connected?"
xor ExclusiveGateway_2 "Is the fill level in the bootle ok?"
xor ExclusiveGateway_3 "Is the cap position straight?"
xor ExclusiveGateway_4 "Are the right bottles in the pack?"
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1
end EndEvent_1

flow UserTask_2 -> UserTask_3 id=SequenceFlow_1
flow UserTask_3 -> ServiceTask_1 id=SequenceFlow_2
flow StartEvent_1 -> UserTask_1 id=SequenceFlow_3
flow UserTask_1 -> UserTask_4 id=SequenceFlow_4
flow UserTask_4 -> UserTask_2 id=SequenceFlow_5
flow ServiceTask_1 -> ExclusiveGateway_1 id=SequenceFlow_6
flow ExclusiveGateway_1 -> UserTask_5 "yes" id=SequenceFlow_7 p=0.500
flow UserTask_5 -> ExclusiveGateway_2 id=SequenceFlow_8
flow ServiceTask_2 -> UserTask_7 id=SequenceFlow_9
flow UserTask_7 -> ExclusiveGateway_4 id=SequenceFlow_10
flow UserTask_8 -> ParallelGateway_1 id=SequenceFlow_11
flow ParallelGateway_1 -> ServiceTask_3 id=SequenceFlow_12
flow ParallelGateway_1 -> ServiceTask_4 id=SequenceFlow_13
flow ServiceTask_4 -> ParallelGateway_2 id=SequenceFlow_14
flow ServiceTask_3 -> ParallelGateway_2 id=SequenceFlow_15
flow ParallelGateway_2 -> ServiceTask_5 id=SequenceFlow_16
flow ServiceTask_5 -> EndEvent_1 id=SequenceFlow_17
flow ExclusiveGateway_1 -> UserTask_4 "no" id=SequenceFlow_18 p=0.500
flow ExclusiveGateway_3 -> UserTask_6 "no" id=SequenceFlow_19 p=0.500
flow ExclusiveGateway_4 -> UserTask_8 "no" id=SequenceFlow_20 p=0.500
flow ExclusiveGateway_2 -> UserTask_6 "no" id=SequenceFlow_21 p=0.500
flow UserTask_6 -> UserTask_8 id=SequenceFlow_22
flow ExclusiveGateway_2 -> ExclusiveGateway_3 "yes" id=SequenceFlow_23 p=0.500
flow ExclusiveGateway_3 -> ServiceTask_2 "yes" id=SequenceFlow_24 p=0.500
flow ExclusiveGateway_4 -> ServiceTask_5 "yes" id=SequenceFlow_25 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
