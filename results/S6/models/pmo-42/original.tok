tok 0.5 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Send a report to the fridge service center"
user UserTask_2 "Rate Service Facility"
user UserTask_3 "Describe the symptoms"
service ServiceTask_1 "Schedule an appointment for fridge repair"
service ServiceTask_2 "Select local service facility"
manual ManualTask_1 "Confirm that fridge is okay"
manual ManualTask_2 "Repair the fridge"
manual ManualTask_3 "Collect fridge type data"
xor ExclusiveGateway_1 "Submit a rating?"
xor ExclusiveGateway_2 "Additional parts needed?"
xor ExclusiveGateway_3
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "Fridge makes strange noises"
end EndEvent_1 "Repair process over"
catch IntermediateCatchEvent_1 "Wait until service facility arrives" timer

flow UserTask_2 -> EndEvent_1 id=SequenceFlow_1
flow ManualTask_1 -> ExclusiveGateway_1 id=SequenceFlow_2
flow UserTask_1 -> ServiceTask_2 id=SequenceFlow_3
flow ServiceTask_1 -> IntermediateCatchEvent_1 id=SequenceFlow_4
flow IntermediateCatchEvent_1 -> ManualTask_2 id=SequenceFlow_5
flow ManualTask_2 -> ExclusiveGateway_2 id=SequenceFlow_6
flow ServiceTask_2 -> ExclusiveGateway_3 id=SequenceFlow_7
flow ExclusiveGateway_3 -> ServiceTask_1 id=SequenceFlow_8
flow ParallelGateway_1 -> UserTask_3 id=SequenceFlow_9
flow ParallelGateway_1 -> ManualTask_3 id=SequenceFlow_10
flow ExclusiveGateway_2 -> ManualTask_1 "No. Fridge is repaired" id=SequenceFlow_11
flow ExclusiveGateway_1 -> UserTask_2 "Yes" id=SequenceFlow_12
flow ManualTask_3 -> ParallelGateway_2 id=SequenceFlow_13
flow ParallelGateway_2 -> UserTask_1 id=SequenceFlow_14
flow UserTask_3 -> ParallelGateway_2 id=SequenceFlow_15
flow StartEvent_1 -> ParallelGateway_1 id=SequenceFlow_16
flow ExclusiveGateway_1 -> EndEvent_1 "No" id=SequenceFlow_17
flow ExclusiveGateway_2 -> ExclusiveGateway_3 "Yes. Fridge is not repaired" id=SequenceFlow_18
