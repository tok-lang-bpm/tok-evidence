tok 0.5 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "Select type of order" duration="exp(10m)"
user UserTask_2 "Select burger" duration="exp(10m)"
user UserTask_3 "Select type of beverage" duration="exp(10m)"
user UserTask_4 "Select side" duration="exp(10m)"
user UserTask_5 "Select menu" duration="exp(10m)"
user UserTask_6 "Make payment" duration="exp(10m)"
user UserTask_7 "Enter customer's name" duration="exp(10m)"
service ServiceTask_1 "Prepare beverage" duration="exp(10m)"
service ServiceTask_2 "Prepare potato wedges" duration="exp(10m)"
service ServiceTask_3 "Prepare French fries" duration="exp(10m)"
service ServiceTask_4 "Prepare burger" duration="exp(10m)"
service ServiceTask_5 "Check status" duration="exp(10m)"
service ServiceTask_6 "Update status" duration="exp(10m)"
service ServiceTask_7 "Deliver via conveyor belt" duration="exp(10m)"
service ServiceTask_8 "Notify customer" duration="exp(10m)"
xor ExclusiveGateway_1 "Menu or just the burger ?"
xor ExclusiveGateway_2 "Fries or wedges ?"
xor ExclusiveGateway_3
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6 "Is burger ready ?"
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "Food order decided"
end EndEvent_1 "Food delivered"
catch IntermediateCatchEvent_1 "30 seconds" timer

flow StartEvent_1 -> UserTask_1 id=SequenceFlow_1
flow UserTask_1 -> ExclusiveGateway_1 id=SequenceFlow_2
flow UserTask_3 -> ParallelGateway_1 id=SequenceFlow_3
flow ParallelGateway_1 -> ServiceTask_1 id=SequenceFlow_4
flow ParallelGateway_1 -> UserTask_4 id=SequenceFlow_5
flow ServiceTask_1 -> ParallelGateway_2 id=SequenceFlow_6
flow UserTask_4 -> ParallelGateway_2 id=SequenceFlow_7
flow ServiceTask_2 -> ExclusiveGateway_3 id=SequenceFlow_8
flow ServiceTask_3 -> ExclusiveGateway_3 id=SequenceFlow_9
flow ExclusiveGateway_2 -> ServiceTask_2 "Potato wedges" id=SequenceFlow_10 p=0.500
flow ExclusiveGateway_2 -> ServiceTask_3 "French fries" id=SequenceFlow_11 p=0.500
flow ParallelGateway_2 -> ExclusiveGateway_2 id=SequenceFlow_12
flow UserTask_5 -> UserTask_3 id=SequenceFlow_13
flow UserTask_2 -> ExclusiveGateway_4 id=SequenceFlow_14
flow ExclusiveGateway_1 -> UserTask_5 "With menu" id=SequenceFlow_15 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_4 id=SequenceFlow_16
flow ParallelGateway_3 -> ExclusiveGateway_5 id=SequenceFlow_17
flow IntermediateCatchEvent_1 -> ServiceTask_5 id=SequenceFlow_18
flow ServiceTask_5 -> ExclusiveGateway_6 id=SequenceFlow_19
flow ServiceTask_4 -> ParallelGateway_4 id=SequenceFlow_20
flow ServiceTask_7 -> EndEvent_1 id=SequenceFlow_21
flow ExclusiveGateway_5 -> ServiceTask_6 id=SequenceFlow_22
flow ServiceTask_6 -> IntermediateCatchEvent_1 id=SequenceFlow_23
flow ParallelGateway_4 -> ServiceTask_8 id=SequenceFlow_24
flow ServiceTask_8 -> ServiceTask_7 id=SequenceFlow_25
flow ExclusiveGateway_1 -> UserTask_2 "Burger only" id=SequenceFlow_26 p=0.500
flow ExclusiveGateway_6 -> ExclusiveGateway_5 "No" id=SequenceFlow_27 p=0.500
flow ExclusiveGateway_6 -> ParallelGateway_4 "Yes" id=SequenceFlow_28 p=0.500
flow ParallelGateway_3 -> ServiceTask_4 id=SequenceFlow_29
flow UserTask_6 -> UserTask_7 id=SequenceFlow_30
flow UserTask_7 -> ParallelGateway_3 id=SequenceFlow_31
flow ExclusiveGateway_4 -> UserTask_6 id=SequenceFlow_32

simulate cases=500 seed=20261031 arrival="exp(1h)"
