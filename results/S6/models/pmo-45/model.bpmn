  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:task id="Task_1" name="customer waits until bank confirms payment" />
    <bpmn:serviceTask id="ServiceTask_1" name="customer credentials being checked by system" />
    <bpmn:serviceTask id="ServiceTask_2" name="Payment is prepared by system" />
    <bpmn:serviceTask id="ServiceTask_3" name="Shipment is prepared by system" />
    <bpmn:serviceTask id="ServiceTask_4" name="order is being finished by system" />
    <bpmn:manualTask id="ManualTask_1" name="customer logs into E-Shop" />
    <bpmn:manualTask id="ManualTask_2" name="customer selects a product" />
    <bpmn:manualTask id="ManualTask_3" name="customer adds product to shopping cart" />
    <bpmn:manualTask id="ManualTask_4" name="customer saves product" />
    <bpmn:manualTask id="ManualTask_5" name="customer checks if product was already selected" />
