tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

task Task_1 "customer waits until bank confirms payment" duration="exp(10m)"
service ServiceTask_1 "customer credentials being checked by system" duration="exp(10m)"
service ServiceTask_2 "Payment is prepared by system" duration="exp(10m)"
service ServiceTask_3 "Shipment is prepared by system" duration="exp(10m)"
service ServiceTask_4 "order is being finished by system" duration="exp(10m)"
manual ManualTask_1 "customer logs into E-Shop" duration="exp(10m)"
manual ManualTask_2 "customer selects a product" duration="exp(10m)"
manual ManualTask_3 "customer adds product to shopping cart" duration="exp(10m)"
manual ManualTask_4 "customer saves product" duration="exp(10m)"
manual ManualTask_5 "customer checks if product was already selected" duration="exp(10m)"
manual ManualTask_6 "customer enters payment data" duration="exp(10m)"
manual ManualTask_7 "customer enters shipping address" duration="exp(10m)"
manual ManualTask_8 "customer enters an independent billing adress" duration="exp(10m)"
xor ExclusiveGateway_1 "succesful login?"
xor ExclusiveGateway_2 "has customer selected all desired products?"
xor ExclusiveGateway_3 "if shipping adress == billing adress?"
xor ExclusiveGateway_4
xor ExclusiveGateway_5
xor ExclusiveGateway_6
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1 "Open E-Shop Homepage"
end EndEvent_1 "Close E-Shop Homepage"

flow StartEvent_1 -> ManualTask_1 id=SequenceFlow_1
flow ManualTask_1 -> ServiceTask_1 id=SequenceFlow_2
flow ServiceTask_1 -> ExclusiveGateway_1 id=SequenceFlow_3
flow ManualTask_2 -> ManualTask_3 id=SequenceFlow_4
flow ManualTask_3 -> ManualTask_4 id=SequenceFlow_5
flow ManualTask_4 -> ManualTask_5 id=SequenceFlow_6
flow ManualTask_5 -> ExclusiveGateway_2 id=SequenceFlow_7
flow ParallelGateway_1 -> ServiceTask_2 id=SequenceFlow_8
flow ParallelGateway_1 -> ServiceTask_3 id=SequenceFlow_9
flow ParallelGateway_2 -> ServiceTask_4 id=SequenceFlow_10
flow ManualTask_6 -> ParallelGateway_3 id=SequenceFlow_11
flow ServiceTask_2 -> ParallelGateway_4 id=SequenceFlow_12
flow ServiceTask_3 -> ParallelGateway_4 id=SequenceFlow_13
flow ParallelGateway_4 -> ManualTask_6 id=SequenceFlow_14
flow ParallelGateway_3 -> ManualTask_7 id=SequenceFlow_15
flow ManualTask_7 -> ExclusiveGateway_3 id=SequenceFlow_16
flow ManualTask_8 -> ExclusiveGateway_4 id=SequenceFlow_17
flow ExclusiveGateway_4 -> ParallelGateway_2 id=SequenceFlow_18
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "Yes" id=SequenceFlow_19 p=0.500
flow ExclusiveGateway_3 -> ManualTask_8 "No" id=SequenceFlow_20 p=0.500
flow ExclusiveGateway_2 -> ParallelGateway_1 "Yes" id=SequenceFlow_21 p=0.500
flow ServiceTask_4 -> ExclusiveGateway_5 id=SequenceFlow_22
flow ExclusiveGateway_5 -> EndEvent_1 id=SequenceFlow_23
flow ExclusiveGateway_6 -> ManualTask_2 id=SequenceFlow_24
flow ExclusiveGateway_1 -> ExclusiveGateway_6 "Yes" id=SequenceFlow_25 p=0.500
flow ParallelGateway_3 -> Task_1 id=SequenceFlow_26
flow Task_1 -> ParallelGateway_2 id=SequenceFlow_27
flow ExclusiveGateway_2 -> ExclusiveGateway_6 "No" id=SequenceFlow_28 p=0.500
flow ExclusiveGateway_1 -> ExclusiveGateway_5 "No" id=SequenceFlow_29 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
