tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "select course" duration="exp(10m)"
user UserTask_2 "select specific course" duration="exp(10m)"
user UserTask_3 "check if registered at eligible university" duration="exp(10m)"
user UserTask_4 "log into account" duration="exp(10m)"
user UserTask_5 "register account" duration="exp(10m)"
user UserTask_6 "request activation" duration="exp(10m)"
user UserTask_7 "connect to twitter account" duration="exp(10m)"
user UserTask_8 "invite friends to course" duration="exp(10m)"
user UserTask_9 "provide payment info" duration="exp(10m)"
user UserTask_10 "check if another course is interesting" duration="exp(10m)"
service ServiceTask_1 "system shows parallel courses and dates" duration="exp(10m)"
service ServiceTask_2 "system checks eligibility" duration="exp(10m)"
service ServiceTask_3 "system issues course tickets" duration="exp(10m)"
xor ExclusiveGateway_1 "free spots?"
xor ExclusiveGateway_2 "already registered?"
xor ExclusiveGateway_3 "eligible university?"
xor ExclusiveGateway_4 "person eligible?"
xor ExclusiveGateway_5
xor ExclusiveGateway_6
xor ExclusiveGateway_7
xor ExclusiveGateway_8
xor ExclusiveGateway_9
xor ExclusiveGateway_10
and ParallelGateway_1
and ParallelGateway_2
start StartEvent_1 "wish to enroll in course"
end EndEvent_1 "end process"

flow UserTask_1 -> ExclusiveGateway_1 id=SequenceFlow_1
flow ServiceTask_1 -> UserTask_2 id=SequenceFlow_2
flow UserTask_3 -> ExclusiveGateway_3 id=SequenceFlow_3
flow ExclusiveGateway_3 -> UserTask_6 "no" id=SequenceFlow_4 p=0.500
flow UserTask_6 -> ServiceTask_2 id=SequenceFlow_5
flow ServiceTask_2 -> ExclusiveGateway_4 id=SequenceFlow_6
flow UserTask_7 -> UserTask_8 id=SequenceFlow_7
flow ExclusiveGateway_1 -> ServiceTask_1 "yes" id=SequenceFlow_8 p=0.500
flow ExclusiveGateway_2 -> UserTask_3 "no" id=SequenceFlow_9 p=0.500
flow UserTask_4 -> ParallelGateway_1 id=SequenceFlow_10
flow ParallelGateway_1 -> UserTask_7 id=SequenceFlow_11
flow UserTask_10 -> ExclusiveGateway_5 id=SequenceFlow_12
flow ParallelGateway_2 -> ServiceTask_3 id=SequenceFlow_13
flow UserTask_8 -> ParallelGateway_2 id=SequenceFlow_14
flow UserTask_9 -> ParallelGateway_2 id=SequenceFlow_15
flow ExclusiveGateway_1 -> UserTask_10 "no" id=SequenceFlow_16 p=0.500
flow UserTask_2 -> ExclusiveGateway_2 id=SequenceFlow_17
flow StartEvent_1 -> ExclusiveGateway_6 id=SequenceFlow_18
flow ExclusiveGateway_6 -> UserTask_1 id=SequenceFlow_19
flow ExclusiveGateway_5 -> ExclusiveGateway_6 "yes" id=SequenceFlow_20 p=0.500
flow ServiceTask_3 -> ExclusiveGateway_7 id=SequenceFlow_21
flow ExclusiveGateway_7 -> ExclusiveGateway_8 id=SequenceFlow_22
flow ExclusiveGateway_8 -> EndEvent_1 id=SequenceFlow_23
flow ExclusiveGateway_5 -> ExclusiveGateway_7 "no" id=SequenceFlow_24 p=0.500
flow ExclusiveGateway_4 -> ExclusiveGateway_8 "no" id=SequenceFlow_25 p=0.500
flow ParallelGateway_1 -> UserTask_9 id=SequenceFlow_26
flow ExclusiveGateway_9 -> UserTask_5 id=SequenceFlow_27
flow ExclusiveGateway_2 -> ExclusiveGateway_10 "yes" id=SequenceFlow_28 p=0.500
flow ExclusiveGateway_10 -> UserTask_4 id=SequenceFlow_29
flow UserTask_5 -> ExclusiveGateway_10 id=SequenceFlow_30
flow ExclusiveGateway_4 -> ExclusiveGateway_9 "yes" id=SequenceFlow_31 p=0.500
flow ExclusiveGateway_3 -> ExclusiveGateway_9 "yes" id=SequenceFlow_32 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
