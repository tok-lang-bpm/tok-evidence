tok 0.1 id=Definitions_1 process=Process_1 namespace=http://www.omg.org/spec/BPMN/20100524/MODEL

user UserTask_1 "select a starting block" duration="exp(10m)"
user UserTask_2 "get your starting number" duration="exp(10m)"
service ServiceTask_1 "measure the time" duration="exp(10m)"
service ServiceTask_2 "receive your final running time" duration="exp(10m)"
service ServiceTask_3 "calculate time between starting time and the end of workday" duration="exp(10m)"
service ServiceTask_4 "measure the time" duration="exp(10m)"
manual ManualTask_1 "run for 5km" duration="exp(10m)"
manual ManualTask_2 "train" duration="exp(10m)"
manual ManualTask_3 "go to home" duration="exp(10m)"
manual ManualTask_4 "run" duration="exp(10m)"
manual ManualTask_5 "drink" duration="exp(10m)"
xor ExclusiveGateway_1 "time less than 25 minutes?"
xor ExclusiveGateway_2
xor ExclusiveGateway_3 "time more than 1 hour?"
xor ExclusiveGateway_4
and ParallelGateway_1
and ParallelGateway_2
and ParallelGateway_3
and ParallelGateway_4
start StartEvent_1
end EndEvent_1

flow StartEvent_1 -> UserTask_1 id=SequenceFlow_1
flow ParallelGateway_1 -> ManualTask_1 id=SequenceFlow_2
flow ParallelGateway_1 -> ServiceTask_1 id=SequenceFlow_3
flow ManualTask_1 -> ParallelGateway_2 id=SequenceFlow_4
flow ServiceTask_1 -> ParallelGateway_2 id=SequenceFlow_5
flow ParallelGateway_2 -> ExclusiveGateway_1 id=SequenceFlow_6
flow ManualTask_2 -> ExclusiveGateway_2 id=SequenceFlow_7
flow ExclusiveGateway_1 -> ManualTask_2 "No" id=SequenceFlow_8 p=0.500
flow UserTask_2 -> ServiceTask_3 id=SequenceFlow_9
flow ExclusiveGateway_4 -> ParallelGateway_3 id=SequenceFlow_10
flow ParallelGateway_3 -> ManualTask_4 id=SequenceFlow_11
flow ParallelGateway_4 -> ServiceTask_2 id=SequenceFlow_12
flow ServiceTask_2 -> EndEvent_1 id=SequenceFlow_13
flow ExclusiveGateway_3 -> ExclusiveGateway_4 "No" id=SequenceFlow_14 p=0.500
flow ServiceTask_3 -> ExclusiveGateway_3 id=SequenceFlow_15
flow ManualTask_4 -> ParallelGateway_4 id=SequenceFlow_16
flow ManualTask_5 -> ParallelGateway_4 id=SequenceFlow_17
flow ExclusiveGateway_1 -> UserTask_2 "Yes" id=SequenceFlow_18 p=0.500
flow UserTask_1 -> ExclusiveGateway_2 id=SequenceFlow_19
flow ExclusiveGateway_2 -> ParallelGateway_1 id=SequenceFlow_20
flow ParallelGateway_3 -> ManualTask_5 id=SequenceFlow_21
flow ParallelGateway_3 -> ServiceTask_4 id=SequenceFlow_22
flow ServiceTask_4 -> ParallelGateway_4 id=SequenceFlow_23
flow ManualTask_3 -> ExclusiveGateway_4 id=SequenceFlow_24
flow ExclusiveGateway_3 -> ManualTask_3 "Yes" id=SequenceFlow_25 p=0.500

simulate cases=500 seed=20261031 arrival="exp(1h)"
